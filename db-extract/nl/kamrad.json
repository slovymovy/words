                                        "glosses": [
                                            "Stuff."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c818cd4-efe7-4a76-9964-75f587792674",
                                                "sense_id": "5b783db5-a0d1-343d-ae75-069729e40520",
                                                "text": "When he was digged up, which was in the presence of the Magistracy of the Town, his body was found entire, not at all putrid, no ill smell about him, saving the mustiness of the grave-Clothes, his joynts limber and flexible, as in those that are alive, his skin only flaccid, but a more fresh grown in the room of it, the wound of his throat gaping, but no gear nor corruption in it; there was also observed a Magical mark in the great toe of his right foot, viz. an Excrescency in the form of a Rose."
                                            }
                                        ]
                                    },
