                "senses": [
                    {
                        "sense_id": "af7b27d7-4cf6-375f-bf28-7f403f885453",
                        "entry_id": "7c121dae-a5d4-336b-af6e-99796f4d5ef2",
                        "glosses": [
                            "in Flöckchen herunterfallen, leicht schneien"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "e7cc5ca0-9b35-49b6-accd-b50e19546e53",
                                "sense_id": "af7b27d7-4cf6-375f-bf28-7f403f885453",
                                "text": "„Auch Schnee-Nachschub wird es geben: ‚Zwischendurch wird es vor allem an der Ostseeküste immer mal wieder flöckeln‘, kann die Meteorologin ihren Karten entnehmen.“"
                            },
                            {
                                "example_id": "c13b343d-beda-4365-960c-17297f90d09e",
                                "sense_id": "af7b27d7-4cf6-375f-bf28-7f403f885453",
                                "text": "„Zwischen einem Tief über Osteuropa und einem Hoch über dem Ostatlantik floss feuchtkalte und labile Polarluft von der Nordsee zum Alpenraum und staute sich dort. Dementsprechend blieb es heute vielerorts wolkenverhangen und es flöckelte zeitweise vor sich hin.“"
                            },
                            {
                                "example_id": "f38ca8ca-7680-49ab-b36d-780758845a98",
                                "sense_id": "af7b27d7-4cf6-375f-bf28-7f403f885453",
                                "text": "„Draussen auf dem Schwyzer Hauptplatz flöckelt die weisse Pracht vom verhangenen Dezemberhimmel. Drinnen im Forum Schweizer Geschichte liegt auch Schnee, allerdings bloss künstlicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
