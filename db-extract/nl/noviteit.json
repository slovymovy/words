                    },
                    {
                        "translation_id": "5ebcb6af-d860-40a7-b086-87694e836ac0",
                        "source_entry_id": "93402c51-ee41-3a34-be88-ab58553acd01",
                        "source_sense_id": "9f53708d-e46c-3567-9b39-be51eac843ff",
                        "target_lang_word": "novelty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "novelty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9545da33-2eac-322f-b56b-8681a0f698d3",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "The state of being new or novel; newness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950359cb-aaed-4459-8343-c94c911c33ea",
                                                "sense_id": "9545da33-2eac-322f-b56b-8681a0f698d3",
                                                "text": "Men In Black 3 lacks the novelty of the first film, and its take on the late ’60s feels an awful lot like a psychedelic dress-up party, all broad caricatures and groovy vibes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e43e7e7-8d7e-3e95-a31a-8b8742ae1fbf",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "A new product; an innovation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926ee183-18bb-4014-b94f-97ec4da2631a",
                                                "sense_id": "4e43e7e7-8d7e-3e95-a31a-8b8742ae1fbf",
                                                "text": "Reconciling profound enquiry with clearness, and truth with novelty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b63b5454-bcc7-34c2-814a-dabfa8802f6b",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "A small mass-produced trinket."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2de17473-3a7c-3edb-8101-5bed1864ed0d",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "In novelty theory, newness, density of complexification, and dynamic change as opposed to static habituation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "An opening move played for the first time ever (in high-level chess)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e01089-2461-489b-be62-3d6cc9149dc2",
                                                "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                                "text": "Topalov has unveiled some interesting novelties lately, but there was nothing unusual in his opening here. Sasikiran played the Nimzo-Indian, and Topalov replied with probably the most classical continuation."
                                            },
                                            {
                                                "example_id": "43648ded-cb47-4765-b8d2-d9dcc110cc5b",
                                                "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                                "text": "It's not often a novelty comes as early as move seven nowadays, but in the latest round of the German Bundesliga, a recently discovered seventh move was employed to win a lovely game."
                                            },
                                            {
                                                "example_id": "47a616fb-08e3-4516-ab83-a3c9e0007111",
                                                "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                                "text": "The Russian champion still did very well. Nepomniachtchi was only a wildcard, yet played with full force including an interesting novelty in the much analysed Berlin Wall Ruy Lopez."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "novelty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "176834df-f123-3561-8f6b-32246a3c45b1",
                                        "entry_id": "5da372b5-5eed-3cc2-91d7-d6e02d6ecd34",
                                        "glosses": [
                                            "In the design of a common household item, often impractically large, and meant primarily for display rather than functional use."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1bd8ee-9564-46f3-bd6c-b2849306cad4",
                                                "sense_id": "176834df-f123-3561-8f6b-32246a3c45b1",
                                                "text": "My novelty calculator works fine but it hurts my hands to press the keys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7b30b76-c26e-4a73-8259-b5e999d71659",
                        "source_entry_id": "93402c51-ee41-3a34-be88-ab58553acd01",
                        "source_sense_id": "9f53708d-e46c-3567-9b39-be51eac843ff",
                        "target_lang_word": "nouveauté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nouveauté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Caractère de ce qui n'existait pas auparavant ou qui était inconnu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ee216d-e2e0-4688-92d5-9af56b04481f",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "La nouveauté nous fait toujours un peu peur, parce que nous nous sentons plus rassurés si nous avons tout sous contrôle. Et cela arrive aussi avec Dieu. Mais quand Dieu se révèle, il apporte la nouveauté - Dieu apporte toujours la nouveauté. Ce n’est pas la nouveauté pour la nouveauté, la recherche du nouveau pour dépasser l’ennui, comme il arrive souvent de nos jours. La nouveauté que Dieu apporte dans notre vie est ce qui vraiment nous réalise, ce qui nous donne la vraie joie, la vraie sérénité."
                                            },
                                            {
                                                "example_id": "ebbb814e-30fa-48ac-bea7-ec850c2fb5a1",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "Toutes les lois [sur les brevets] demandent la nouveauté. On trouve si évident qu'une invention soit nouvelle par nature, ou doive l'être pour mériter un brevet, que l'on n'analyse pas les raisons qui ont poussé le législateur à faire de la nouveauté une condition légale de la brevetabilité. […] La nouveauté est la caractère essentiel de l'invention."
                                            },
                                            {
                                                "example_id": "e1ecd60f-427b-48fc-89b9-1597dc2db1cd",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "Les habitudes freinent notre capacité à apprécier positivement la nouveauté. La nouveauté est la qualité de ce que nous percevons pour la première fois. Il s'agit donc d'un phénomène nécessairement inédit, original. La perception de la nouveauté nécessite que notre esprit soit capable de briser les rapports anciens et de se libérer des liaisons préétablies"
                                            },
                                            {
                                                "example_id": "7c8773d6-0777-459a-b468-bd6e77423945",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "La révolution implique une certaine conception du temps historique ordonnée à l'idée de commencement entendu au sens fort d'une nouveauté radicale. « [Un] élément de nouveauté (novelty), écrit-elle, [est] inhérent à toutes les révolutions"
                                            },
                                            {
                                                "example_id": "6c3e63d6-4f0b-4e8e-bfdd-d2f1f4b0cb38",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "La première émotion que nous découvrons dans l'esprit humain est la curiosité. Par là, j'entends tout désir éprouvé pour la nouveauté ou tout plaisir qu'elle procure. Regardons les enfants courir de côté et d'autre à l'affut d'un objet nouveau et saisir avec avidité, sans véritable choix, tout ce qui s'offre à eux; il n'est rien qui n'engage leur attention parce qu'à ce stade de la vie, il n'est rien qui ne se pare du charme de la nouveauté. Mais ce qui nous attire seulement par sa nouveauté ne saurait nous attacher durablement. […] Une certaine nouveauté doit entrer dans la composition de tout ce qui agit sur l'esprit."
                                            },
                                            {
                                                "example_id": "1e7dca94-cde6-49db-86c7-082787c26c5d",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "Nul mérite ne s’acquiert et se perd aussi facilement que celui de la nouveauté."
                                            },
                                            {
                                                "example_id": "db564a9e-5156-4fbd-8980-37ecde8b1f29",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "L’innovateur en termes de développement de la nouveauté est une source d’innovation. Il innove toujours plus."
                                            },
                                            {
                                                "example_id": "8b1fc8c3-0abd-4912-8b16-4402b6501736",
                                                "sense_id": "55251c8f-4a92-346d-9ba7-e6161d165ba0",
                                                "text": "PHILAMINTE\nCes titres ont toujours quelque chose de rare.\nARMANDE\nÀ cent beaux traits d’esprit leur nouveauté prépare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92199614-7d2d-35cb-8fe7-98916b69e23a",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Caractère de ce qui est récent, de création récente, qui date de peu, qui existe depuis peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e111ce21-736a-418e-b4a3-4989b310c46e",
                                                "sense_id": "92199614-7d2d-35cb-8fe7-98916b69e23a",
                                                "text": "On risquait d'oublier que les aspirations contemporaines doivent s'adapter aux exigences de l'esprit chrétien. N'allait-on pas substituer un mirage moderne à une vérité éternelle et confondre la récence d'une doctrine avec sa nouveauté véritable ?"
                                            },
                                            {
                                                "example_id": "813c6057-e1d2-4ad7-9531-495e2220e583",
                                                "sense_id": "92199614-7d2d-35cb-8fe7-98916b69e23a",
                                                "text": "La notion de nouveauté regroupe deux critères : la récence, c'est-à-dire le fait qu'un produit soit disponible depuis peu de temps ; et la différence par rapport aux produits existants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ef2cde9-0d32-37a7-bfd0-a0acd4980781",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Caractère de ce qui vient de remplacer ou succéder à quelque chose"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "908e505d-e984-48df-a9cb-13cbb0d595c2",
                                                "sense_id": "8ef2cde9-0d32-37a7-bfd0-a0acd4980781",
                                                "text": "D’autres auteurs proposent de définir la nouveauté comme ce qui est perçu comme récent (temps perçu depuis la découverte ou la première utilisation de l’innovation, ou durée perçue de la disponibilité de l’innovation sur le marché) et différent (caractéristiques de l’innovation perçues différemment de celles des produits typiques de la catégorie de produits, existants déjà sur le marché)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960dcd69-c0b7-33bf-917e-c793d65be15f",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Caractéristique innovante, ce qu’il y a d’unique dans un nouveau produit ou un service ; différence avantageuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3657448e-63c1-433f-b171-eaa140e4bd23",
                                                "sense_id": "960dcd69-c0b7-33bf-917e-c793d65be15f",
                                                "text": "Nous proposions lundi un résumé des principales nouveautés de la huitième itération d’iOS, revenons dessus en détail aujourd’hui avec ses 10 nouveautés marquantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97242821-804d-3128-8b6f-5c0d6517fbb9",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Situation inédite et inattendue engendrant le sentiment de merveilleux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a598c341-ced5-49ef-a749-cd9cbccd3e9c",
                                                "sense_id": "97242821-804d-3128-8b6f-5c0d6517fbb9",
                                                "text": "L'émotion de l'étonnement est plus que la simple nouveauté. Le degré au-dessus de la nouveauté est la surprise ou choc produit par ce qui est à la fois nouveau et inattendu"
                                            },
                                            {
                                                "example_id": "d0a497c6-857b-4927-9e2e-7703bd2ad8a6",
                                                "sense_id": "97242821-804d-3128-8b6f-5c0d6517fbb9",
                                                "text": "De toutes les circonstances qui éveillent le sentiment de merveilleux, la nouveauté est celle dont l'influence est la plus puissante. ; l'aspect d'un objet nouveau produit, à l'instant, une vive impression de surprise qui s'empare de l'esprit pour un temps, à l'exclusion de toute autre idée,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07ebd7e3-1db4-3bf6-afc4-12fff746a57f",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Caractère, qualité éphémère de ce qui est nouveau, récent, présenté pour la première fois ; récence."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135dfcad-5988-4c06-9c01-72d8cb9bebae",
                                                "sense_id": "07ebd7e3-1db4-3bf6-afc4-12fff746a57f",
                                                "text": "Par définition, toute innovation doit comporter un élément de nouveauté. La notion de nouveauté se décline sous trois formes […] : nouveauté pour l’entreprise, nouveauté pour le marché, nouveauté pour le monde entier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bdbcff2-e743-33bc-8b8e-995e028b37ad",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Phénomène inédit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98045aab-b8be-4c22-a25c-7777fe7541b4",
                                                "sense_id": "4bdbcff2-e743-33bc-8b8e-995e028b37ad",
                                                "text": "La science le permet enfin ! Car la nouveauté de ce temps « hiroshimesque » est que l'humanité est capable de suicide par désespoir, comme jadis seulement l’homme individuel."
                                            },
                                            {
                                                "example_id": "1684f4da-bb6a-4a0f-bb84-1b492027cd97",
                                                "sense_id": "4bdbcff2-e743-33bc-8b8e-995e028b37ad",
                                                "text": "L'apparition de l'automobile dans les années 1870-1880 fut la nouveauté de cette décennie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5903c4e5-1d43-34e6-a64b-cdf5eac5dd33",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Dernier produit présenté ou exposé par une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a95e65-a4fa-4e86-b97b-e6c0c8820992",
                                                "sense_id": "5903c4e5-1d43-34e6-a64b-cdf5eac5dd33",
                                                "text": "La tablette du 21ème siècle est déjà une nouveauté obsolète telle qu'elle est à l’heure actuelle.\""
                                            },
                                            {
                                                "example_id": "193aac7d-2c48-48c7-a9c0-fab5e797509c",
                                                "sense_id": "5903c4e5-1d43-34e6-a64b-cdf5eac5dd33",
                                                "text": "Les dernières nouveautés du Salon de l'électronique de Las Vegas."
                                            },
                                            {
                                                "example_id": "5cfb9da1-c2ae-4bbf-ab1e-c6ea8cbf233c",
                                                "sense_id": "5903c4e5-1d43-34e6-a64b-cdf5eac5dd33",
                                                "text": "La Golf 7 a été une des grandes nouveautés de l'année automobile 2013"
                                            },
                                            {
                                                "example_id": "75b19465-48ee-4153-a1e2-8651b98461c1",
                                                "sense_id": "5903c4e5-1d43-34e6-a64b-cdf5eac5dd33",
                                                "text": "Les nouveautés du Salon de l'Agriculture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cf2870d-026b-3f0f-86b2-2009ccaa8d6f",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Livres qui viennent de paraître, pièces de théâtre qu’on vient de monter pour la première fois, films qui viennent de sortir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e8d45d-6a85-4f7f-993a-8a596836b2f6",
                                                "sense_id": "9cf2870d-026b-3f0f-86b2-2009ccaa8d6f",
                                                "text": "Mon libraire m’envoie toutes les nouveautés."
                                            },
                                            {
                                                "example_id": "054bbaea-c1cc-4c5b-a51f-a5607c9193f2",
                                                "sense_id": "9cf2870d-026b-3f0f-86b2-2009ccaa8d6f",
                                                "text": "Elle va au théâtre voir toutes les nouveautés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4baf8c6a-9a06-3174-b511-12a404c938a4",
                                        "entry_id": "7e018057-02e8-3b1d-b290-911eeef3f688",
                                        "glosses": [
                                            "Doctrine nouvelle, en contradiction avec les idées, le régime, la tradition établis."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c875bcb-2551-4ea2-9292-2bede3acd867",
                                                "sense_id": "4baf8c6a-9a06-3174-b511-12a404c938a4",
                                                "text": "Celui qui gagne au changement remercie la fortune et le temps; mais celui qui perd, s'en prend à l'auteur de la nouveauté. Il est bon de ne pas faire de nouvelles expériences pour raccommoder un état sans une extrême nécessité et un avantage visible."
                                            },
                                            {
                                                "example_id": "38167af7-d118-42bf-be95-b396a6957e4a",
                                                "sense_id": "4baf8c6a-9a06-3174-b511-12a404c938a4",
                                                "text": "Rappelez-vous le moment terrible qu'elle [l'Église] a passé, au temps du concile de Trente [1545-1563]. La Réforme venait de l'ébranler d'une façon profonde (...) partout, c'était un flot montant de nouveautés, d'idées soufflées par l'esprit du mal, de projets malsains qu'enfantait l'orgueil de l'homme, lâché en pleine licence. ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
