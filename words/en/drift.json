{
    "word_family": [
        "drifter",
        "drifting",
        "adrift",
        "driftwood"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9860836-ea4e-3edf-bb1c-c5c6790c854f",
                    "sense_definition": "To move slowly, especially as a result of outside forces such as water or air currents, with no control over direction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The empty boat began to <w>drift</w> down the river.",
                            "target_lang_translations": {
                                "ru": "Пустая лодка начала <w>дрейфовать</w> вниз по реке.",
                                "zh": "空船开始顺着河流<w>漂流</w>。"
                            }
                        },
                        {
                            "text": "Clouds <w>drift</w> across the sky on a windy day.",
                            "target_lang_translations": {
                                "ru": "Облака <w>плывут</w> по небу в ветреный день.",
                                "zh": "有风的日子里，云朵在天空中<w>飘荡</w>。"
                            }
                        },
                        {
                            "text": "We let the canoe <w>drift</w> along while we ate lunch.",
                            "target_lang_translations": {
                                "ru": "Мы позволили каноэ <w>плыть по течению</w>, пока обедали.",
                                "zh": "我们吃午饭时让独木舟<w>随波逐流</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "steer",
                        "anchor"
                    ],
                    "common_phrases": [
                        "drift away",
                        "drift apart",
                        "drift along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться медленно, особенно под воздействием внешних сил, таких как течение воды или воздуха, не контролируя направление.",
                        "zh": "指缓慢地移动，尤指受水流或气流等外力影响，且无法控制方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрейфовать",
                                "target_lang_sense_clarification": "перемещаться под действием ветра или течения (о судне, льдине)"
                            },
                            {
                                "target_lang_word": "плыть по течению",
                                "target_lang_sense_clarification": "двигаться вместе с потоком воды"
                            },
                            {
                                "target_lang_word": "сноситься",
                                "target_lang_sense_clarification": "смещаться в сторону под действием внешних сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂流",
                                "target_lang_sense_clarification": "随水流或风向缓慢移动"
                            },
                            {
                                "target_lang_word": "随波逐流",
                                "target_lang_sense_clarification": "比喻没有主见或受环境影响而移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a0f71f0-feaa-3eb8-9a65-6bbdb2bea0f4",
                    "sense_definition": "To move or change one's position, lifestyle, or focus without a specific goal or purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tends to <w>drift</w> from one job to another without settling down.",
                            "target_lang_translations": {
                                "ru": "Он склонен <w>скитаться</w> с одной работы на другую, нигде не задерживаясь.",
                                "zh": "他总是从一份工作<w>跳槽</w>到另一份，无法安定下来。"
                            }
                        },
                        {
                            "text": "My thoughts began to <w>drift</w> during the long lecture.",
                            "target_lang_translations": {
                                "ru": "Мои мысли начали <w>блуждать</w> во время длинной лекции.",
                                "zh": "漫长的讲座中，我的思绪开始<w>游离</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "focus"
                    ],
                    "common_phrases": [
                        "drift off to sleep",
                        "drift from town to town"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться или менять положение, образ жизни или направление мыслей без определенной цели.",
                        "zh": "指没有明确目标或目的而改变位置、生活方式或注意力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плыть по течению",
                                "target_lang_sense_clarification": "перен. жить без цели, пассивно подчиняясь обстоятельствам"
                            },
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "о мыслях или взгляде"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "переходить с места на место без цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游离",
                                "target_lang_sense_clarification": "指思想或状态脱离中心"
                            },
                            {
                                "target_lang_word": "漂泊",
                                "target_lang_sense_clarification": "指生活不稳定，四处流浪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "683352ca-d259-363d-a4c0-6980ddc1f30f",
                    "sense_definition": "To be driven into heaps or piles by the force of the wind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snow began to <w>drift</w> against the garage door during the blizzard.",
                            "target_lang_translations": {
                                "ru": "Снег начал <w>наметаться</w> на дверь гаража во время метели.",
                                "zh": "暴风雪期间，雪开始在车库门前<w>堆积</w>。"
                            }
                        },
                        {
                            "text": "Sand tends to <w>drift</w> over the road in the desert.",
                            "target_lang_translations": {
                                "ru": "Песок имеет обыкновение <w>наноситься</w> на дорогу в пустыне.",
                                "zh": "在沙漠中，沙子往往会<w>覆盖</w>在道路上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drift into piles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбиваться в кучи или наносы под действием ветра.",
                        "zh": "指受风力影响而堆积成堆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наметаться",
                                "target_lang_sense_clarification": "образовывать сугробы или кучи (о снеге, песке)"
                            },
                            {
                                "target_lang_word": "наноситься",
                                "target_lang_sense_clarification": "скапливаться под действием ветра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堆积",
                                "target_lang_sense_clarification": "指物质聚集成堆"
                            },
                            {
                                "target_lang_word": "积聚",
                                "target_lang_sense_clarification": "指风吹使沙雪聚拢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc7139ab-a6f3-30fe-8971-2b548b82ff20",
                    "sense_definition": "To steer a vehicle so that it slides sideways while maintaining control, or to deviate gently from a straight path.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The race car driver knows how to <w>drift</w> around tight corners.",
                            "target_lang_translations": {
                                "ru": "Гонщик знает, как <w>дрифтовать</w> на крутых поворотах.",
                                "zh": "赛车手知道如何在急转弯处进行<w>漂移</w>。"
                            }
                        },
                        {
                            "text": "Be careful not to let the car <w>drift</w> into the other lane.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, не дайте машине <w>сместиться</w> на встречную полосу.",
                                "zh": "小心别让车<w>偏离</w>到另一条车道上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drift a car"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять автомобилем в управляемом заносе или плавно отклоняться от прямой траектории.",
                        "zh": "指驾驶车辆时在保持控制的情况下侧滑，或轻微偏离直线路径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрифтовать",
                                "target_lang_sense_clarification": "автоспорт. проходить повороты в управляемом заносе"
                            },
                            {
                                "target_lang_word": "смещаться",
                                "target_lang_sense_clarification": "плавно отклоняться от полосы движения"
                            },
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "уходить в сторону от курса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂移",
                                "target_lang_sense_clarification": "汽车运动中通过侧滑过弯"
                            },
                            {
                                "target_lang_word": "偏离",
                                "target_lang_sense_clarification": "指离开原定的路线或方向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb29c55a-6414-3b5a-8a84-9139131485b9",
                    "sense_definition": "A large pile of snow, sand, or other material formed by the wind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was stuck in a deep <w>drift</w> of snow.",
                            "target_lang_translations": {
                                "ru": "Машина застряла в глубоком снежном <w>сугробе</w>.",
                                "zh": "车陷在深厚的雪<w>堆</w>里了。"
                            }
                        },
                        {
                            "text": "We had to dig through a huge <w>drift</w> to reach the front door.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось прокапывать путь через огромный <w>нанос</w>, чтобы добраться до входной двери.",
                                "zh": "我们不得不挖开巨大的雪<w>堆</w>才能到达前门。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "snow drift",
                        "drift of sand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая куча снега или песка, наметенная ветром.",
                        "zh": "由风吹积而成的雪堆、沙堆或其他物质堆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сугроб",
                                "target_lang_sense_clarification": "снежная куча"
                            },
                            {
                                "target_lang_word": "нанос",
                                "target_lang_sense_clarification": "скопление песка или снега"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堆",
                                "target_lang_sense_clarification": "量词或名词，指聚集成堆的物质"
                            },
                            {
                                "target_lang_word": "积雪",
                                "target_lang_sense_clarification": "特指堆积的雪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c03ea5dd-56cd-303f-ba86-4654757765b5",
                    "sense_definition": "The general intention, meaning, or direction of an argument or speech.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not catch his <w>drift</w> when he explained the complex plan.",
                            "target_lang_translations": {
                                "ru": "Я не уловил <w>суть</w>, когда он объяснял этот сложный план.",
                                "zh": "他解释那个复杂计划时，我没听懂他的<w>大意</w>。"
                            }
                        },
                        {
                            "text": "Do you get my <w>drift</w>, or should I be more clear?",
                            "target_lang_translations": {
                                "ru": "Ты улавливаешь <w>суть</w> или мне выразиться яснее?",
                                "zh": "你明白我的<w>意思</w>了吗，还是需要我讲得更清楚些？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "catch my drift",
                        "get the drift"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in phrases like 'catch my drift'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий смысл, направление мысли или намерение в речи.",
                        "zh": "指论点或谈话的总体意图、含义或方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суть",
                                "target_lang_sense_clarification": "основной смысл сказанного"
                            },
                            {
                                "target_lang_word": "направление мыслей",
                                "target_lang_sense_clarification": "общий ход рассуждений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大意",
                                "target_lang_sense_clarification": "指文章或谈话的主要内容"
                            },
                            {
                                "target_lang_word": "要旨",
                                "target_lang_sense_clarification": "指核心意思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baf0c443-395c-3d2a-8541-e348e48b2a2b",
                    "sense_definition": "A slow and gradual movement or change from one place, state, or opinion to another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There has been a noticeable <w>drift</w> towards remote work in recent years.",
                            "target_lang_translations": {
                                "ru": "В последние годы наблюдается заметная <w>тенденция</w> к удаленной работе.",
                                "zh": "近年来，远程办公出现了明显的<w>趋势</w>。"
                            }
                        },
                        {
                            "text": "Scientists study the <w>drift</w> of continents over millions of years.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>дрейф</w> континентов на протяжении миллионов лет.",
                                "zh": "科学家们研究数百万年来大陆的<w>漂移</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "continental drift",
                        "genetic drift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленное и постепенное изменение или движение от одного состояния к другому.",
                        "zh": "指从一个地方、状态或观点向另一个地方、状态或观点的缓慢且渐进的移动或变化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрейф",
                                "target_lang_sense_clarification": "научн. медленное смещение (напр. континентов)"
                            },
                            {
                                "target_lang_word": "тенденция",
                                "target_lang_sense_clarification": "направление развития или изменений"
                            },
                            {
                                "target_lang_word": "смещение",
                                "target_lang_sense_clarification": "сдвиг в определенную сторону"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漂移",
                                "target_lang_sense_clarification": "科学术语，如大陆漂移"
                            },
                            {
                                "target_lang_word": "趋势",
                                "target_lang_sense_clarification": "指事物发展的动向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ff28646-b1f4-3929-b471-c4d5e53834ad",
                    "sense_definition": "A horizontal passage driven underground in a mine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners dug a long <w>drift</w> to reach the coal seam.",
                            "target_lang_translations": {
                                "ru": "Шахтеры прорыли длинный <w>штрек</w>, чтобы добраться до угольного пласта.",
                                "zh": "矿工们挖了一条长长的<w>平巷</w>以到达煤层。"
                            }
                        },
                        {
                            "text": "Ventilation in the old <w>drift</w> was very poor.",
                            "target_lang_translations": {
                                "ru": "Вентиляция в старом <w>штреке</w> была очень плохой.",
                                "zh": "旧<w>平巷</w>里的通风状况很差。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mining context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Горизонтальная подземная выработка в шахте.",
                        "zh": "矿井中开凿的水平通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штрек",
                                "target_lang_sense_clarification": "горное дело"
                            },
                            {
                                "target_lang_word": "горизонтальная выработка",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平巷",
                                "target_lang_sense_clarification": "矿山工程中的水平巷道"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}