                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "565fa7bb-0ec7-430d-a322-6c71b234dae9",
                                                "sense_id": "a1cfd260-d78f-3696-85e0-e262032c324b",
                                                "text": "Peter, der Frechdachs, schoss den Ball in die Fensterscheibe."
                                            },
                                            {
                                                "example_id": "3f5e051b-e6fb-4723-83bc-2fd269a3dcdf",
                                                "sense_id": "a1cfd260-d78f-3696-85e0-e262032c324b",
                                                "text": "Moni, der kleine Frechdachs, stibitzte ihrer Oma sonntags immer Schokolade aus dem Nachttischchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
