                    {
                        "translation_id": "dc7c7bb7-68a5-44d4-a9f8-e86eb4e93664",
                        "source_entry_id": "3d729c37-58d4-3893-bc18-ff7b6cb16742",
                        "source_sense_description": "of or pertaining to the ancient nation(s) of Israel, their inhabitants, or the descendants of the patriarch Jacob",
                        "target_lang_word": "israélite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "israélite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa92619f-f542-358c-8ca8-8cfca166e0ed",
                                        "entry_id": "142e7584-2307-33ad-9816-a5ed8ca99277",
                                        "glosses": [
                                            "Relatif au royaume d’Israël (rois Saul, David et Salomon) et plus tard, au royaume de Samarie, par rapport au royaume de Judée ayant pour capitale Jérusalem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33f14985-73e8-3db7-929a-b6d262dcb4b8",
                                        "entry_id": "142e7584-2307-33ad-9816-a5ed8ca99277",
                                        "glosses": [
                                            "Relatif aux juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0ff636-4a9d-445c-a7aa-07d6d06f26c0",
                                                "sense_id": "33f14985-73e8-3db7-929a-b6d262dcb4b8",
                                                "text": "La lumière de la lampe posée sur cette cheminée tombait sur son visage, la faisant encore plus pâle et plus brune et rendant aussi plus éclatants encore ses yeux pleins d’une douceur israélite."
                                            },
                                            {
                                                "example_id": "bac8f167-b6d5-445e-be96-33825f09b591",
                                                "sense_id": "33f14985-73e8-3db7-929a-b6d262dcb4b8",
                                                "text": "À la même occasion je fus témoin de la réception d'une délégation de la communauté israélite de Settat."
                                            },
                                            {
                                                "example_id": "61cea34f-2493-4f6e-8945-f49375794b23",
                                                "sense_id": "33f14985-73e8-3db7-929a-b6d262dcb4b8",
                                                "text": "Pendant ce temps, le visage de Rivaud était sans cesse très près de celui de Maigret, qui remarqua soudain :\n— Vous n’avez pas le type israélite très prononcé !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "israélite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                        "entry_id": "fe223da1-e307-3478-b66d-a253f0f68371",
                                        "glosses": [
                                            "Juif ; juive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2cd4e46-75dd-461c-a923-30063274ae45",
                                                "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                                "text": "Il était coiffé d’un bonnet jaune, long et carré, d’une mode singulière et assignée à sa nation pour distinguer les israélites des chrétiens."
                                            },
                                            {
                                                "example_id": "58b664ab-0b36-4dc6-a129-3540414abc26",
                                                "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                                "text": "D’après Stanislas Plater, la Pologne, en 1765, sur 20 millions d’habitants, possédait environ 8 million de catholiques romains, près de 4 millions de catholiques grecs, 3 millions de catholiques schismatiques, 2 millions de protestants, 2 millions d’israélites, près de 200.000 raskolniks ou espèces de bohémiens et de missionnaires russes, et 56 000 mahométans."
                                            },
                                            {
                                                "example_id": "674959ce-02bf-4a91-9748-382e275d939f",
                                                "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                                "text": "Casablanca toute entière tenait alors dans l’enceinte de ses murailles. Elle comptait environ 25.000 indigènes dont un cinquième d’israélites et une colonie européenne, femmes et enfants compris, d’approximativement 500 têtes, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
