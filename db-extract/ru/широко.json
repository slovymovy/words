                        "sense_id": "a446d411-0845-3e2b-85db-c6644d921585",
                        "entry_id": "03411b5c-c5a7-38d4-bf10-17c8c2587afd",
                        "glosses": [
                            "свободно, без ограничений, с большим размахом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "636d4961-ccc8-40f7-b0da-78601c2ac442",
                                "sense_id": "a446d411-0845-3e2b-85db-c6644d921585",
                                "text": "Потом он широко расставил локти на кафедре, подпер подбородок ладонями и, запустив ногти в рот, начал нараспев и сквозь зубы: ― Ну-с, орлы заморские… ученички развращенные… Что вы знаете?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26c5d7cd-e6a6-4057-9180-ed24ba4625e6",
                        "source_entry_id": "03411b5c-c5a7-38d4-bf10-17c8c2587afd",
                        "target_lang_word": "widely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widely",
