                        "entry_id": "5863ddf3-5785-3aa3-9e74-f22ec17cea4e",
                        "glosses": [
                            "Conjuring, legerdemain or magic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "28cda7c0-52e4-408a-8fbd-5460a091abcb",
                                "sense_id": "fe945123-b36a-3500-a01e-cfb28f34541d",
                                "text": "Pretended conjurations and prophecies of that event."
                            },
                            {
                                "example_id": "f9450161-e7ef-456a-ad97-fe880ebdde91",
                                "sense_id": "fe945123-b36a-3500-a01e-cfb28f34541d",
                                "text": "How nicely we could manage without the said railway, now the great hobby of our Teviotdale lairds, if we could by any process of conjuration waft to Abbotsford some of the coal and lime from Lochore..."
                            }
                        ]
                    },
                    {
                        "sense_id": "682c59e9-3cc5-3553-a84b-8f2794c5a853",
                        "entry_id": "5863ddf3-5785-3aa3-9e74-f22ec17cea4e",
                        "glosses": [
                            "A magic trick."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cd205cc4-7a3d-3820-b151-0e47dfc75ff8",
                        "entry_id": "5863ddf3-5785-3aa3-9e74-f22ec17cea4e",
                        "glosses": [
                            "The act of calling or summoning by a sacred name, or in solemn manner, or binding by an oath; an earnest entreaty; adjuration."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "550d7ed9-9675-480d-a83e-992f763e9883",
                                "sense_id": "cd205cc4-7a3d-3820-b151-0e47dfc75ff8",
                                "text": "We charge you, in the name of God, take heed; […] Under this conjuration speak, my lord."
                            },
                            {
                                "example_id": "1345eef3-91ae-43f4-b579-bf3d7d9302de",
                                "sense_id": "cd205cc4-7a3d-3820-b151-0e47dfc75ff8",
                                "text": "An earneſt Coniuration from the King, / As England was his faithfull Tributary"
                            }
                        ]
                    },
                    {
                        "sense_id": "81213efc-f32b-3fd8-9c59-db62170e0271",
                        "entry_id": "5863ddf3-5785-3aa3-9e74-f22ec17cea4e",
                        "glosses": [
                            "A league for a criminal purpose; conspiracy."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "156a4e35-4dc8-44b2-8516-d1d1d500dcee",
                                "sense_id": "81213efc-f32b-3fd8-9c59-db62170e0271",
                                "text": "The conjuration of Catiline."
                            }
                        ]
                    }
