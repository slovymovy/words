                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98084793-080f-4d63-88ad-7ca943cb8251",
                        "source_entry_id": "5a96f59e-7d9e-3044-915a-bfe831822a63",
                        "source_sense_id": "2bc29836-38ef-3a21-9d38-f76103efe73a",
                        "target_lang_word": "pimpant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pimpant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3a52b5-bd04-3c85-89cc-5b7180dbe759",
                                        "entry_id": "9ea51021-cfca-3266-8df7-49119c31fade",
                                        "glosses": [
                                            "Qui est élégant, gracieux, qui a un extérieur riant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb5f1e0-fc22-400e-9df1-32868f14fd28",
                                                "sense_id": "9d3a52b5-bd04-3c85-89cc-5b7180dbe759",
                                                "text": "L'été passé, (…) un faucheur qui avait acheté une faux toute pimpante neuve, affilée & tranchante comme un bec de Paris pour l'essayer marchanda à faucher une pièce d'avoine contenant sept arpents trois quartiers & demy deux perches ou environ."
                                            },
                                            {
                                                "example_id": "cbbafac2-a8d6-4b47-b086-140887d492ba",
                                                "sense_id": "9d3a52b5-bd04-3c85-89cc-5b7180dbe759",
                                                "text": "Mais que je te voie reprendre le costume de tes ancêtres anglais ; pas de manteau court, pas de bonnet pimpant, pas de plumage fantasque dans ma modeste maison."
                                            },
                                            {
                                                "example_id": "6bffaecf-3b6f-4807-8275-887f77e9eed8",
                                                "sense_id": "9d3a52b5-bd04-3c85-89cc-5b7180dbe759",
                                                "text": "S’imaginerait-on jamais, à voir ma pimpante dégaîne, que la faim, logée dans mon ventre, y tire — la bourelle ! — une corde qui m’étrangle comme un pendu !"
                                            },
                                            {
                                                "example_id": "c30377e7-24fb-450f-bb83-1b36d50b83e0",
                                                "sense_id": "9d3a52b5-bd04-3c85-89cc-5b7180dbe759",
                                                "text": "Quant au marquis, plus pimpant et plus souriant que de coutume, il causait dans un coin avec Félicité, qui paraissait fort gaie."
                                            },
                                            {
                                                "example_id": "049913ec-20b7-441a-9908-168c7924ee39",
                                                "sense_id": "9d3a52b5-bd04-3c85-89cc-5b7180dbe759",
                                                "text": "Et sur ses quarante ans elle retrouvait une manière de jeunesse paysanne, les joues pimpantes quand il faisait chaud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e80a12-5826-3bae-b46d-c0a2a2d82e21",
                                        "entry_id": "9ea51021-cfca-3266-8df7-49119c31fade",
                                        "glosses": [
                                            "Gai, joyeux, animé, coloré."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57572406-0aee-4a0a-8c9c-15e27491431c",
                                                "sense_id": "96e80a12-5826-3bae-b46d-c0a2a2d82e21",
                                                "text": "Au deux millième coup, Mony rendit l’âme, Le soleil était radieux. Les chants des oiseaux mandchous rendaient plus gaie la matinée pimpante."
                                            },
                                            {
                                                "example_id": "c23fafd1-f2f8-4570-b1de-004cf16ad5f0",
                                                "sense_id": "96e80a12-5826-3bae-b46d-c0a2a2d82e21",
                                                "text": "La nature, pimpante et piquante comme une brune au printemps, devient mélancolique et douce comme une blonde, les gazons se dorent, les fleurs d’automne poussent leurs pâles corolles, ce n’est plus les marguerites qui percent les pelouses de leurs yeux blancs, mais de rares calices violâtres."
                                            }
                                        ]
                                    }
                                ]
