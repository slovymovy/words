{
    "word_family": [
        "Johnny",
        "Johnson"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c14428fe-d1ab-3add-97f4-beb30361dc5f",
                    "sense_definition": "A very common male given name.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My brother's name is <w>John</w>.",
                            "target_lang_translations": {
                                "ru": "Моего брата зовут <w>Джон</w>.",
                                "zh": "我哥哥的名字叫<w>约翰</w>。"
                            }
                        },
                        {
                            "text": "Is <w>John</w> coming to the party tonight?",
                            "target_lang_translations": {
                                "ru": "<w>Джон</w> придет сегодня на вечеринку?",
                                "zh": "<w>约翰</w>今晚会来参加派对吗？"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень распространенное мужское имя.",
                        "zh": "非常常见的男性英文名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джон",
                                "target_lang_sense_clarification": "мужское имя"
                            },
                            {
                                "target_lang_word": "Иван",
                                "target_lang_sense_clarification": "русский аналог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "约翰",
                                "target_lang_sense_clarification": "男性人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e87460b-5486-32ed-a331-b1d7a1ea1b30",
                    "sense_definition": "Referring to important figures in the Christian Bible, such as <w>John</w> the Baptist or <w>John</w> the Apostle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biblical_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Saint <w>John</w> baptized people in the river Jordan.",
                            "target_lang_translations": {
                                "ru": "Святой <w>Иоанн</w> крестил людей в реке Иордан.",
                                "zh": "圣<w>约翰</w>在约旦河为人们施洗。"
                            }
                        },
                        {
                            "text": "Many churches are named after <w>John</w> the Evangelist.",
                            "target_lang_translations": {
                                "ru": "Многие церкви названы в честь <w>Иоанна</w> Богослова.",
                                "zh": "许多教堂是以圣<w>约翰</w>的名字命名的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "John the Baptist",
                        "John the Apostle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относится к важным фигурам в христианской Библии, таким как Иоанн Креститель или Иоанн Богослов.",
                        "zh": "指基督教圣经中的重要人物，如施洗约翰或使徒约翰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Иоанн",
                                "target_lang_sense_clarification": "библейское имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "约翰",
                                "target_lang_sense_clarification": "圣经人物名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "373c9d17-70c5-3601-b51c-1bdc908312ea",
                    "sense_definition": "The Gospel of St. John, the fourth book of the New Testament in the Bible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biblical_group",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The pastor read a verse from the Gospel of <w>John</w>.",
                            "target_lang_translations": {
                                "ru": "Пастор прочитал стих из Евангелия от <w>Иоанна</w>.",
                                "zh": "牧师诵读了一段《<w>约翰</w>福音》中的经文。"
                            }
                        },
                        {
                            "text": "In the book of <w>John</w>, there are many stories about the life of Jesus.",
                            "target_lang_translations": {
                                "ru": "В книге <w>Иоанна</w> много историй о жизни Иисуса.",
                                "zh": "在《<w>约翰</w>福音》中，记载了许多关于耶稣生平的故事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Gospel of John"
                    ],
                    "target_lang_definitions": {
                        "ru": "Евангелие от Иоанна, четвертая книга Нового Завета в Библии.",
                        "zh": "《约翰福音》，圣经新约的第四卷书。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Иоанн",
                                "target_lang_sense_clarification": "Евангелие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "约翰福音",
                                "target_lang_sense_clarification": "圣经书卷名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f81639bb-19d7-3864-8a2b-9ebf8739ee8b",
                    "sense_definition": "Used as a generic placeholder name for a man whose actual name is unknown or withheld.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "generic_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unidentified victim was listed as a <w>John</w> Doe in the police report.",
                            "target_lang_translations": {
                                "ru": "Неопознанная жертва была записана в полицейском отчете как <w>Джон</w> Доу.",
                                "zh": "在警方报告中，这名身份不明的受害者被登记为<w>无名氏</w>。"
                            }
                        },
                        {
                            "text": "Politicians often try to appeal to the average <w>John</w> Q. Public.",
                            "target_lang_translations": {
                                "ru": "Политики часто пытаются понравиться среднестатистическому <w>Джону</w> Кью Паблику.",
                                "zh": "政客们经常试图争取普通<w>大众</w>的支持。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "John Doe",
                        "John Q. Public",
                        "Dear John letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как условное имя для мужчины, чье настоящее имя неизвестно или не разглашается.",
                        "zh": "用作男性名字的代称，当真实姓名未知或不便透露时使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джон",
                                "target_lang_sense_clarification": "в именах типа John Doe"
                            },
                            {
                                "target_lang_word": "неизвестный",
                                "target_lang_sense_clarification": "значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无名氏",
                                "target_lang_sense_clarification": "指代身份不明的男性"
                            },
                            {
                                "target_lang_word": "约翰·多伊",
                                "target_lang_sense_clarification": "法律或警务用语中的代称"
                            }
                        ]
                    }
                }
            ]
        },
