            {
                "entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
                "word": "pillard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ae73f611-2dc3-4a48-8519-c32928dbf7b0",
                        "entry_id": "f04a5454-ceda-324e-82a2-1b5f5f815b1c",
                        "tags": [
