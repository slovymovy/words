                {
                    "sense_id": "6fd606d9-b5fc-3c78-a031-c5f42430835e",
                    "sense_definition": "Iets op een verborgen plek leggen of bewaren zodat het niet gevonden wordt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij had de kostbare spullen veilig <w>verstoken</w> onder de oude vloerplanken.",
                            "target_lang_translations": {
                                "fr": "Elle avait <w>caché</w> les objets précieux en sécurité sous les vieilles lattes du plancher."
                            }
                        },
                        {
                            "text": "De vluchtelingen werden door de boer <w>verstoken</w> in de schuur.",
                            "target_lang_translations": {
                                "fr": "Les réfugiés étaient <w>dissimulés</w> par le fermier dans la grange."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbergen",
                        "verstoppen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Placer ou conserver quelque chose dans un endroit caché pour qu'il ne soit pas trouvé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cacher",
                                "target_lang_sense_clarification": "dissimuler un objet"
                            },
                            {
                                "target_lang_word": "dissimuler",
                                "target_lang_sense_clarification": "cacher quelque chose avec soin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dae54906-967c-389e-b9ba-e6f2efdee188",
                    "sense_definition": "Zichzelf op een verborgen plek begeven om niet gezien te worden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>verstaken</w> zich achter de grote boom tijdens het spel.",
                            "target_lang_translations": {
