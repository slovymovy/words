                                "sense_id": "1c70ba19-fab9-3494-91c2-14fed06f210e",
                                "text": "Sie fahren in den Osterferien an die Ostsee."
                            },
                            {
                                "example_id": "b8801ac4-1025-453f-a3b2-e37145a160d4",
                                "sense_id": "1c70ba19-fab9-3494-91c2-14fed06f210e",
                                "text": "„Am ersten Schultag nach den Osterferien hatte ich mein Lesebuch nicht dabei.“"
                            },
                            {
                                "example_id": "91755b9f-fb08-4fad-84fc-aa9766ec726c",
                                "sense_id": "1c70ba19-fab9-3494-91c2-14fed06f210e",
                                "text": "„An diesem Gründonnerstag hatte er noch Dienst, danach begannen seine Osterferien.“"
                            }
                        ],
