                "senses": [
                    {
                        "sense_id": "78debfa2-4f4f-37ec-8b86-ae443579532f",
                        "entry_id": "0ec7af47-6541-3040-aef6-d0470df035ed",
                        "glosses": [
                            "plötzlich auftretender, erheblicher Blutverlust aus einer Körperöffnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6a454a-747f-4f1f-9f6c-111fc3d36a67",
                                "sense_id": "78debfa2-4f4f-37ec-8b86-ae443579532f",
                                "text": "„Erstens langweilt mich der Kram, und zweitens hätten meine Eltern dann jeweils ungefähr zwei Blutstürze, wenn ich was ziemlich Persönliches über sie erzählen würde.“"
                            },
                            {
                                "example_id": "bcfa0d39-e427-4dc5-bac5-12c628df9f7f",
                                "sense_id": "78debfa2-4f4f-37ec-8b86-ae443579532f",
                                "text": "„In der Tat erfuhr ich, daß mein Vater an einem plötzlichen Blutsturz gestorben war.“"
                            },
                            {
                                "example_id": "3674f8fa-efdb-45f1-9277-85cbd0491c4d",
                                "sense_id": "78debfa2-4f4f-37ec-8b86-ae443579532f",
                                "text": "„Woche um Woche saß er brav am Kaminfeuer, schrieb und las, schrieb und las; und als er trotzdem einen Blutsturz erlitt, untersagte ihm der Arzt, in der ersten Tageshälfte überhaupt noch ein Wort zu sprechen.“"
                            },
                            {
                                "example_id": "1b3de1aa-8c5d-4c4d-b526-3cb5a0c48529",
                                "sense_id": "78debfa2-4f4f-37ec-8b86-ae443579532f",
                                "text": "„Klabund erleidet einen Blutsturz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85c866d1-f793-4a9c-9ca4-d37a4bab2a10",
                        "source_entry_id": "0ec7af47-6541-3040-aef6-d0470df035ed",
                        "source_sense_id": "78debfa2-4f4f-37ec-8b86-ae443579532f",
                        "source_sense_description": "plötzlich auftretender, erheblicher Blutverlust aus einer Körperöffnung",
                        "target_lang_word": "haemorrhage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haemorrhage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                        "entry_id": "def3b0d5-932b-3833-a509-4e84153e521b",
                                        "glosses": [
                                            "British standard spelling of hemorrhage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c05893-ed9d-49de-98b0-c2da703814ad",
                                                "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                                "text": "It’s haemorrhaging now!"
                                            },
                                            {
                                                "example_id": "ee93facd-78cc-472b-9f58-903d7b685309",
                                                "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                                "text": "The company haemorrhaged money until eventually it went bankrupt."
                                            },
                                            {
                                                "example_id": "fad0ab49-0bd2-4cab-bcf4-adb4bc245521",
                                                "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                                                "text": "In the early 1980s, the UK was gripped by a recession. A newly elected Conservative government was never going to let BR haemorrhage money if it could help it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haemorrhage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                        "entry_id": "99decab1-c94b-3e56-b193-d7b18571028d",
                                        "glosses": [
                                            "British standard spelling of hemorrhage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4825c894-5055-4fe4-9350-4ea5971e5f02",
                                                "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                                "text": "We got news that he died of a haemorrhage!"
                                            },
                                            {
                                                "example_id": "3c1da454-b760-405c-92a5-ea56533d1c9b",
                                                "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                                "text": "Lan Chengzhang, who worked for the China Trade News, died of an apparent brain haemorrhage after over 20 thugs set upon him and his taxi driver on January 10 at a mine in Hunyuan county, in the northern province of Shanxi."
                                            },
                                            {
                                                "example_id": "6943b771-3866-4abe-a9a4-1ac7e48f7fdc",
                                                "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                                                "text": "Relics of the British empire now mostly survive in the interstices of the global economy. They are the major winners from the fiscal haemorrhage that has resulted from financial globalisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
