        "fr-extract.jsonl": [
            {
                "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                "word": "relevage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2b44a23b-a52a-48c5-a758-3524f3351d1e",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "tags": [
                            "plural"
                        ],
                        "form": "relevages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3de4fa3d-4bef-3003-82bb-067c5b3a94c5",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Action de relever ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1899c8bc-9578-4c8f-8154-31eef107d019",
                                "sense_id": "3de4fa3d-4bef-3003-82bb-067c5b3a94c5",
                                "text": "Dans les anciens modèles, la manœuvre de relevage des dents était faite par le conducteur lui-même qui, se déplaçant à pied derrière la machine, agissait sur un grand levier à portée de sa main."
                            },
                            {
                                "example_id": "2248e66c-8809-49b0-96aa-25d8ccaef57f",
                                "sense_id": "3de4fa3d-4bef-3003-82bb-067c5b3a94c5",
                                "text": "Sélectionnez l'option Activée pour que le déclenchement n'ait lieu qu'après un délai d'environ 0,4 seconde après le relevage du miroir."
                            }
                        ]
                    },
                    {
                        "sense_id": "d668e5a9-6d0d-3094-b5aa-8592501b2eb8",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Action de transférer une victime du sol sur un brancard."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "18b36800-7419-4ade-9055-9c26c1d8a3b4",
                                "sense_id": "d668e5a9-6d0d-3094-b5aa-8592501b2eb8",
                                "text": "Le soignant peut être amené à participer au relevage d’un patient, voire à son brancardage par des ambulanciers ou des secouristes, lors de son transfert du sol vers un brancard, voire de son lit vers un brancard."
                            },
                            {
                                "example_id": "95c0823f-4ae0-466c-986b-ded6ae78d50a",
                                "sense_id": "d668e5a9-6d0d-3094-b5aa-8592501b2eb8",
                                "text": "Lors du brancardage, réalisé après l'installation de la victime sur le brancard par des techniques de relevage adaptées et son arrimage ([…]), le brancard doit être maintenu le plus à l'horizontale possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "838276be-0e10-32da-a371-f2420a15cc8d",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Action de ramener les filets, chargés de la pêche, à bord."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0f9fe02a-5d07-4827-8378-8b2e3eacd05f",
                                "sense_id": "838276be-0e10-32da-a371-f2420a15cc8d",
                                "text": "Pendant toute la nuit, il louvoie autour de ses filets ou, restant en panne sous le vent, se laisse dériver à côté d'eux. Au petit jour, le relevage se fait à bras. Le poisson est rangé en cale dans des caissettes avec une couche de glace pilée, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "93cbfd6f-9558-3697-a38c-25d005cccc26",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Pompage."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "note": "Se dit surtout pour l'eau pure ou chargée",
                        "examples": [
                            {
                                "example_id": "f4beb14a-c339-49e5-854f-3498b73abbba",
                                "sense_id": "93cbfd6f-9558-3697-a38c-25d005cccc26",
                                "text": "Une usine de relevage des eaux était toutefois nécessaire sur ce long trajet pour permettre aux eaux le franchissement de la Seine et des collines d’Argenteuil."
                            },
                            {
                                "example_id": "bf1be750-ee3e-4cb4-a20d-cfa49d8d0c52",
                                "sense_id": "93cbfd6f-9558-3697-a38c-25d005cccc26",
                                "text": "Un biolaveur a été mis en œuvre sur un poste de relevage des eaux usées d'une station balnéaire de l'Ouest de la France."
                            },
                            {
                                "example_id": "bd62cd6e-cf2e-471e-bb61-054a997272b4",
                                "sense_id": "93cbfd6f-9558-3697-a38c-25d005cccc26",
                                "text": "Il faut creuser un regard dans le sol de la cave, qui reçoit l'eau et l'évacue grâce à une petite pompe de relevage immergée."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc6bb9ae-756f-3227-a5e1-d2f6d17ddd5c",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Manœuvre d'introduire les sarments sortis du palissage, ou poussées récemment, dans les fils de fer de palissage."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5a74c931-f480-4dc5-9042-53429c7b85b0",
                                "sense_id": "dc6bb9ae-756f-3227-a5e1-d2f6d17ddd5c",
                                "text": "Les temps de relevage manuel varient en fonction du type de palissage, de l'écartement des vignes et de leur vigueur, de la date d'exécution et du soin apporté à ce travail."
                            }
                        ]
                    },
                    {
                        "sense_id": "5704f0b0-40aa-3db0-a7de-a211df194861",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Action, pour un facteur d’orgue, de réviser un orgue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d420192-4f42-4db2-9239-a309664e0773",
                                "sense_id": "5704f0b0-40aa-3db0-a7de-a211df194861",
                                "text": "Entrepris dès cette époque, l’indispensable relevage de cet instrument ne sera achevé, après bien des vicissitudes, qu'en 1989."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6387b06-f460-38b2-a420-b19d2eba1669",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Deuxième labour pour implanter une culture de printemps."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9c6fe810-159d-413a-b59b-33695fc23e81",
                                "sense_id": "e6387b06-f460-38b2-a420-b19d2eba1669",
                                "text": "Dans l'arrondissement de Dunkerque, on prépare la terre par trois labours : le premier, esquivelage, est donné pour déchaumer ; le deuxième, relevage, a lieu après les semailles de grains d'hiver; on fume alors lorsqu'on doit faire succéder une céréale aux pommes de terre."
                            },
                            {
                                "example_id": "d36bad59-3815-495d-9da9-948c238d8127",
                                "sense_id": "e6387b06-f460-38b2-a420-b19d2eba1669",
                                "text": "Le premier est dit esquivelage; le deuxième, relevage, et le troisième, labour de semailles."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4a7e428-cc21-327c-a279-e41d74aa97aa",
                        "entry_id": "e17eeca3-3561-316d-90c9-d20a5cf1c589",
                        "glosses": [
                            "Mécanisme d'un tracteur agricole qui permet de porter, et de relever ou d'abaisser, des instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52f9bed-cb72-496c-b797-2b513decdb17",
                                "sense_id": "e4a7e428-cc21-327c-a279-e41d74aa97aa",
                                "text": "Plusieurs modèles de sous-soleuses existent sur le marché, tant sous forme d’instruments traînés que d’instruments portés pour les principales marques de tracteurs à relevage hydraulique ou mécanique."
                            },
                            {
                                "example_id": "40e80f46-bcf6-4717-9895-44a8a245b19e",
                                "sense_id": "e4a7e428-cc21-327c-a279-e41d74aa97aa",
                                "text": "La machine dispose également d’un système de régulation de report de charge sur le relevage arrière. Ce système augmente la traction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "115e20c6-d506-4598-bac7-008a8938c3fa",
