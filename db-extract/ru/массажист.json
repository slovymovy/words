                                        "entry_id": "69f0c952-c238-3001-9365-f11a0f2a63a0",
                                        "glosses": [
                                            "Celui qui masse les membres du corps pour les assouplir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6869a316-9164-4ad0-aec3-d20d11eab8d4",
                                                "sense_id": "0edf8484-2c83-35e2-ba3b-4aa18e1248ac",
                                                "text": "Le masseur insiste davantage sur les régions musculaires qui ont été sollicitées au cours des efforts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "masseur",
