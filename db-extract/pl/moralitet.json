                                "target_senses": [
                                    {
                                        "sense_id": "6eeaaf1b-3062-336f-9ffc-7bf2ad1e5beb",
                                        "entry_id": "1fab5676-69e0-3ac9-8603-8663e536ff01",
                                        "glosses": [
                                            "a type of allegorical drama towards the end of the Middle Ages that demonstrates a moral theme such as a character's inner struggle to attain moral enlightenment or salvation"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa501d6a-a140-43d2-ae79-15c8a3ec3348",
                        "source_entry_id": "dbf2fa2b-e365-3930-a849-bd3da12a1cf9",
                        "source_sense_id": "832104cc-3160-33ee-8fae-bc538b00bf99",
                        "target_lang_word": "moralité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moralité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d2e667-c3c3-3a58-bf6f-9efafda34286",
                                        "entry_id": "5a0ab6b8-3dfe-3117-9904-dd27d2a71310",
                                        "glosses": [
                                            "Réflexion morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9552022f-528d-4c1b-9a76-1930e3e31952",
                                                "sense_id": "b0d2e667-c3c3-3a58-bf6f-9efafda34286",
                                                "text": "Il y a de belles moralités à tirer de cette histoire."
                                            },
                                            {
                                                "example_id": "f838a7f5-672d-4cc4-8534-eb4fb14729fc",
                                                "sense_id": "b0d2e667-c3c3-3a58-bf6f-9efafda34286",
                                                "text": "Un recueil de moralités. Dans ce sens, il vieillit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e94a742-a64f-3d44-9f14-eee6167c0c17",
                                        "entry_id": "5a0ab6b8-3dfe-3117-9904-dd27d2a71310",
                                        "glosses": [
                                            "Sens moral que renferme un discours fabuleux ou allégorique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c57acca-eb68-4b65-8bec-f783599cf2ab",
                                                "sense_id": "6e94a742-a64f-3d44-9f14-eee6167c0c17",
                                                "text": "La moralité d’une fable, d’un apologue."
                                            },
                                            {
                                                "example_id": "6608c8b6-d25f-4409-9171-4d357eab8e13",
                                                "sense_id": "6e94a742-a64f-3d44-9f14-eee6167c0c17",
                                                "text": "Chez la plupart des fabulistes, la moralité est indifféremment placée avant ou après le récit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91798f37-48ea-366e-943c-d327fbeb3bac",
                                        "entry_id": "5a0ab6b8-3dfe-3117-9904-dd27d2a71310",
                                        "glosses": [
                                            "Poèmes dramatiques qui représentaient une action morale à l’aide de personnages allégoriques."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d050bba-8301-43b0-bf74-5add3789e1f2",
                                                "sense_id": "91798f37-48ea-366e-943c-d327fbeb3bac",
                                                "text": "Au moyen âge, la comédie comprenait les farces, les soties et les moralités."
                                            },
                                            {
                                                "example_id": "4fcef7fc-0d5c-4a53-ad4a-b79ece2781d4",
                                                "sense_id": "91798f37-48ea-366e-943c-d327fbeb3bac",
                                                "text": "La Condamnation de Banquet est une de nos plus fameuses moralités."
                                            },
                                            {
                                                "example_id": "44009ede-0755-444b-aa60-a433f6d2afb1",
                                                "sense_id": "91798f37-48ea-366e-943c-d327fbeb3bac",
                                                "text": "Nous devons avoir l’honneur de déclamer et représenter devant son éminence Monsieur le cardinal une très belle moralité, qui a nom : Le bon jugement de madame la vierge Marie."
                                            },
                                            {
                                                "example_id": "05be535c-3853-4d02-9ccf-7687668afc61",
                                                "sense_id": "91798f37-48ea-366e-943c-d327fbeb3bac",
                                                "text": "Souvent, les étudiants [suédois] jouent devant leurs camarades des pièces de leur composition : esquisses légères d’ordinaire où l’actualité forme l'attrait principal du spectacle. Il serait curieux de comparer ces essais dramatiques aux soties et moralités débitées jadis par nos \"escholiers\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "497f57fc-1bd5-30e5-802b-f84017548110",
                                        "entry_id": "5a0ab6b8-3dfe-3117-9904-dd27d2a71310",
                                        "glosses": [
                                            "Discernement moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba4c4d5-1622-4b63-bae5-29ff37807113",
                                                "sense_id": "497f57fc-1bd5-30e5-802b-f84017548110",
                                                "text": "On concédera aux partisans de la douceur que la violence peut gêner le progrès économique et même qu'elle peut être dangereuse pour la moralité, lorsqu'elle dépasse une certaine limite."
                                            },
                                            {
                                                "example_id": "28b81c35-d2bf-48c0-b735-308c62849200",
                                                "sense_id": "497f57fc-1bd5-30e5-802b-f84017548110",
                                                "text": "La moralité des actions humaines, le rapport de ces actions avec les principes de la morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a15dae-08d4-3e9f-b202-36bddbec8384",
                                        "entry_id": "5a0ab6b8-3dfe-3117-9904-dd27d2a71310",
                                        "glosses": [
                                            "Caractère moral, principes, mœurs d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0590f574-a26a-44d9-afe8-20184726c67d",
                                                "sense_id": "95a15dae-08d4-3e9f-b202-36bddbec8384",
                                                "text": "On voit que la moralité des armateurs et des gros négociants n'était pas toujours irréprochable et que l'amour ancillaire avait, à Saint-Malo, de chauds pratiquants."
                                            },
                                            {
                                                "example_id": "115dccb6-e224-44fa-aa0d-53cc464d2071",
                                                "sense_id": "95a15dae-08d4-3e9f-b202-36bddbec8384",
                                                "text": "Sa moralité a toujours été tenue pour douteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9412fefb-1447-306b-997c-fbf6cffd442a",
                                        "entry_id": "5a0ab6b8-3dfe-3117-9904-dd27d2a71310",
                                        "glosses": [
                                            "Conclusion d'ordre moral, sentencieux ou ironique."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9208ce-93ac-4efb-9851-bf399e162ec5",
                                                "sense_id": "9412fefb-1447-306b-997c-fbf6cffd442a",
                                                "text": "Moralité, tu aurais dû continuer à courir pour ta patrie d'origine au lieu de changer de nationalité en 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1857bd2d-83c9-4de7-b216-0edad22292c0",
                        "source_entry_id": "dbf2fa2b-e365-3930-a849-bd3da12a1cf9",
                        "source_sense_id": "832104cc-3160-33ee-8fae-bc538b00bf99",
