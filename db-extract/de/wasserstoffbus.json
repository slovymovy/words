                "senses": [
                    {
                        "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                        "entry_id": "4949a3fe-7054-3359-8479-256e143a29a9",
                        "glosses": [
                            "elektrisch angetriebener Autobus, bei dem die für den Antrieb benötigte elektrische Energie mit Hilfe einer Brennstoffzelle aus Wasserstoff erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee195141-7b16-4c11-9890-eea82f955949",
                                "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                                "text": "„Ab Herbst 2021 könnten dann 14 Wasserstoffbusse zwischen Neusiedl und Eisenstadt unterwegs sein.“"
                            },
                            {
                                "example_id": "b11f1ab6-b6b8-4d14-9ba6-97aa4a0bffa2",
                                "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                                "text": "„Die Busse mit Elektroantrieb haben noch Schwächen, die Entwicklung hänge noch den Anforderungen hinterher, argumentieren die Wiener Linien. Und Wasserstoffbusse seien überhaupt noch nicht in Serienreife erhältlich.“"
                            },
                            {
                                "example_id": "da780c7e-9393-457f-8510-dfe73f93f18f",
                                "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                                "text": "„Die Buslinie soll ab 2023 oder 2024 komplett mit Wasserstoffbussen betrieben werden.“"
                            },
                            {
                                "example_id": "409dd374-383c-4a10-ba55-c5ebacae28ea",
                                "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                                "text": "„ÖBB-Postbus und Graz Linien testen eine Woche lang einen emissionsfreien Wasserstoffbus in Graz und Graz-Umgebung.“"
                            },
                            {
                                "example_id": "46540b82-1f04-4082-bd0c-5196469bce2f",
                                "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                                "text": "„Die Zukunft wird dem Elektrobus gehören. Fragt sich nur: welchem? Dem Batteriebus, dem Oberleitungsbus oder dem Wasserstoffbus, der seinen Strom aus einer Brennstoffzelle bezieht?“"
                            },
                            {
                                "example_id": "dc3acb15-55ca-4bca-931a-98d7cbdd1421",
                                "sense_id": "e3fb86b7-909a-3fe1-8e8f-f3b484005967",
                                "text": "„Die Hamburger Hochbahn hat den Testbetrieb mit Wasserstoffbussen beendet. Die Technik sei noch nicht so weit, und Hersteller Daimler konnte zuletzt nicht liefern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
