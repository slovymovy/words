                "senses": [
                    {
                        "sense_id": "464a5e28-755a-3a9f-b8e7-dae704ce41cd",
                        "entry_id": "4d1dbfb2-f424-37a5-8bd8-9cbf0795d399",
                        "glosses": [
                            "an einem Bade- und Kurort ansässiger Arzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a543c361-d55a-4217-bb4e-31ae748714be",
                                "sense_id": "464a5e28-755a-3a9f-b8e7-dae704ce41cd",
                                "text": "„Von einem Gesundheitsurlaub ist auch dann auszugehen, wenn von einem Haus- oder Badearzt verschriebene Heilmittelanwendungen statt am Wohnort im Kurort in Anspruch genommenen werden.“"
                            },
                            {
                                "example_id": "9491c037-a261-49e9-9540-448c27b6ba87",
                                "sense_id": "464a5e28-755a-3a9f-b8e7-dae704ce41cd",
                                "text": "„Der Naturforscher, Arzt und Philosoph weilte nämlich 1535 als erster Badearzt in der Taminaschlucht; am Ort, wo nun das frühere Kurgebäude, das Alte Bad Pfäfers, steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
