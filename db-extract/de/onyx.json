                                        "glosses": [
                                            "een siersteen vervaardigd van [1]"
                                        ],
                                        "tags": [
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49539e23-f0fe-4686-9d48-98837639e65f",
                                                "sense_id": "660b6b1b-9c47-3981-895c-16d07808eaf7",
                                                "text": "Hij droeg een ring met een zwarte onyx."
                                            }
