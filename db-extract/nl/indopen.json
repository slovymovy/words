                                    }
                                ]
                            },
                            {
                                "target_word": "soak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2648112e-5e1e-39ba-b5b7-f4abdfc6c88a",
                                        "entry_id": "9287715b-9e11-3826-bf1a-b05b6c4dd7c8",
                                        "glosses": [
                                            "(slang, boxing) To hit or strike."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a5e8784-820e-4d69-b85e-eedad1ac6eed",
                                                "sense_id": "2648112e-5e1e-39ba-b5b7-f4abdfc6c88a",
                                                "text": "Wasn't Mr. Sipperley pretty shirty when he came to and found that you had been soaking him with putters?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f012b0-a471-352e-93e3-ca1c7f2b0d73",
                                        "entry_id": "13a73efb-6f13-3b23-8907-3618c47acb2b",
                                        "glosses": [
                                            "An immersion in water etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa657a0-b1d2-44c2-b8cf-195f7aa3c556",
                                                "sense_id": "25f012b0-a471-352e-93e3-ca1c7f2b0d73",
                                                "text": "After the strenuous climb, I had a nice long soak in a bath."
                                            },
                                            {
                                                "example_id": "8d81ded9-e308-4e62-b1d2-46b0efb4a6c4",
                                                "sense_id": "25f012b0-a471-352e-93e3-ca1c7f2b0d73",
                                                "text": "wildlife tourism has turned Knepp into a successful business that employs more people than it did when it was a farm. Springtime overnighters snuggling down in a luxury treehouse after a soak in the open-air, wood-fired Swedish Hikki bathtub may hear nightingales serenading their consorts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e554a9d9-b6c6-377e-a4be-1af6af1a8dac",
                                        "entry_id": "13a73efb-6f13-3b23-8907-3618c47acb2b",
                                        "glosses": [
                                            "A drunkard."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "757e5001-faa2-3a5a-b94a-55b8e912964b",
                                        "entry_id": "13a73efb-6f13-3b23-8907-3618c47acb2b",
                                        "glosses": [
                                            "A carouse; a drinking session."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a73f34b7-9d3f-33cc-88b8-eaaa793c06cf",
                                        "entry_id": "13a73efb-6f13-3b23-8907-3618c47acb2b",
                                        "glosses": [
                                            "A low-lying depression that fills with water after rain."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48141f97-0104-4cf2-aef4-f9b7e5067b3b",
                                                "sense_id": "a73f34b7-9d3f-33cc-88b8-eaaa793c06cf",
                                                "text": "I set off early to walk along the Melbourne Road where, one of the punters had told me, there was a soak with plenty of frogs in it."
                                            },
                                            {
                                                "example_id": "d01fc82b-8c4c-4673-9f38-5b716530b6db",
                                                "sense_id": "a73f34b7-9d3f-33cc-88b8-eaaa793c06cf",
                                                "text": "Molly and Daisy finished their breakfast and decided to take all their dirty clothes and wash them in the soak further down the river."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7803c7ea-2c30-438d-bca6-7ba479d8e050",
                        "source_entry_id": "f3a92c39-de21-3687-9e12-995f5355f503",
                        "source_sense_id": "11798501-5ea0-3882-a998-10df868e3375",
