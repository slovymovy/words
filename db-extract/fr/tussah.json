                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "29035275-9588-45dd-a201-4f64dfdaef39",
                                "sense_id": "524d6682-52f8-3a62-9bc2-f4500e9d2e35",
                                "text": "Celui [le ver à soie du chêne] de l’Inde donne la soie tussah, à laquelle les foulards de l’Inde doivent, dit-on, le mérite d’être inusables."
                            }
                        ]
                    }
