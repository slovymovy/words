                ],
                "senses": [
                    {
                        "sense_id": "87792938-4f78-39ef-a95b-a4d7ded0beaf",
                        "entry_id": "9201bc44-f272-3442-a505-79312cd841d7",
                        "glosses": [
                            "in der Regel frei aufstellbarer Behälter, offen oder schließbar, zum zeitweisen Lagern von Gebrauchsgegenständen und Dokumenten"
                        ],
                        "tags": [
                            "Behälter",
                            "Arbeitsorganisation"
                        ],
                        "examples": [
                            {
                                "example_id": "f6ecab9c-6ba8-4e4d-896a-65ac66d2b933",
                                "sense_id": "87792938-4f78-39ef-a95b-a4d7ded0beaf",
                                "text": "„Die Arbeitsblätter sollten in Ablagekästen […] platziert werden. Werden zwei Differenzierungsstufen angeboten, können die Ablagekästen übereinander gestellt werden.“"
                            },
                            {
                                "example_id": "d10b72c8-9b49-47e7-a20a-9261e50eebc3",
                                "sense_id": "87792938-4f78-39ef-a95b-a4d7ded0beaf",
                                "text": "„Auf dem Schreibtisch hatte Albert sein Büro eingerichtet. Mit Karteikästen, Ablagekästen und später dann mit der elektrischen Schreibmaschine der Mutter […].“"
                            },
                            {
                                "example_id": "17aa6b4d-6b3d-44ef-abf5-8a549fa0fd44",
                                "sense_id": "87792938-4f78-39ef-a95b-a4d7ded0beaf",
                                "text": "„Links befanden sich vier sauber beschriftete Ablagekästen: Eingang, Wiedervorlege, Ablage und Verzeichnisse.“"
                            },
                            {
                                "example_id": "82756b4a-6d18-4f25-8a81-1fef593e1256",
                                "sense_id": "87792938-4f78-39ef-a95b-a4d7ded0beaf",
                                "text": "„Alles andere verschwindet in Hängemappen, Regalen, Ablagekästen, Stehordern oder sogar im Computer und wartet auf seinen Auftritt.“"
                            },
                            {
                                "example_id": "bf99316a-0a85-4baa-8902-6b2ce425f860",
                                "sense_id": "87792938-4f78-39ef-a95b-a4d7ded0beaf",
                                "text": "„Frau P. hatte dieses Mal an jede Station einen Ablagekasten gestellt, damit die Schüler ihre Arbeitsblätter und Stifte dort ablegen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "555f1d98-061b-32b5-85ba-e30bd5a6877d",
                        "entry_id": "9201bc44-f272-3442-a505-79312cd841d7",
                        "glosses": [
                            "draußen stehender, verschließbarer Metallschrank (älter: aus Kunststoff) zur zeitweisen Unterbringung von Briefpost und Paketen; gehört Unternehmen/Institution, welche(s) diese befördert und zustellt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "2e6595a4-f501-4c74-9a93-d400b4857db4",
                                "sense_id": "555f1d98-061b-32b5-85ba-e30bd5a6877d",
                                "text": "„Weil aus demselben Ablagekasten in jüngster Zeit immer wieder Einschreiben entwendet worden waren, hatte der Sicherheitsdienst den Ort überwacht.“"
                            },
                            {
                                "example_id": "18d57b21-5f31-4291-8107-912ccceed61a",
                                "sense_id": "555f1d98-061b-32b5-85ba-e30bd5a6877d",
                                "text": "„In den grauen Ablagekasten passen nur zwei Boxen. Der Fahrer, der die Depots befüllt, stellte den dritten gerade daneben. Das hätte er nicht tun sollen, sondern ihn entweder im nächsten Ablagekasten deponieren und dem Zusteller eine entsprechende Nachricht hinterlassen […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8cf37560-afdb-3a94-8719-e03052367883",
                        "entry_id": "9201bc44-f272-3442-a505-79312cd841d7",
                        "glosses": [
                            "frei zugängliches zusätzliches Fach eines persönlichen Briefkastens für größere Postsendungen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "a11c3147-e9d1-44ab-a197-3ebb4fd75739",
                                "sense_id": "8cf37560-afdb-3a94-8719-e03052367883",
                                "text": "„Die Post stellt Sendungen schweizweit in allen ganzjährig bewohnten Siedlungen zu: Briefe und kleine Pakete in Brief- bzw. Ablagekasten, grössere Sendungen am Hauseingang.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
