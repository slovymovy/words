                                    {
                                        "sense_id": "e8d51029-cd7a-3118-bcbb-70815184f305",
                                        "entry_id": "ff0e91b8-fd50-3991-b27c-b4ba1bcdbdfe",
                                        "glosses": [
                                            "Petite voiture monoplace à quatre roues, équipée d’un moteur de petite cylindrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83253ca-6f38-4743-87ec-ffcfc16c29fd",
                                                "sense_id": "e8d51029-cd7a-3118-bcbb-70815184f305",
                                                "text": "Jacques Villeneuve, qui ne courait plus en karting, me prêta à nouveau son kart de F125 pour toute la saison 1990."
                                            },
                                            {
                                                "example_id": "d079f763-f75d-4351-b5f3-9a4999a8c536",
                                                "sense_id": "e8d51029-cd7a-3118-bcbb-70815184f305",
                                                "text": "« Tu n'as que ta bite et ton couteau » était une phrase fétiche de son frangin quand il « mécaniquait » ses Mobylettes et ensuite ses karts dans le garage."
                                            },
                                            {
                                                "example_id": "be494755-d678-4719-b2c9-fc64bf78ddbb",
                                                "sense_id": "e8d51029-cd7a-3118-bcbb-70815184f305",
                                                "text": "Cent pilotes amateurs étaient conviés sur la ligne de départ, répartis en neuf catégories de véhicules, dont des karts, buggys et autres super tourisme propulsion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eef48c4-3a16-33df-b805-5c9224f2ed7b",
                                        "entry_id": "ff0e91b8-fd50-3991-b27c-b4ba1bcdbdfe",
                                        "glosses": [
                                            "Discipline de sport automobile utilisant ce genre de véhicules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
