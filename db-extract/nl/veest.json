                                    {
                                        "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                        "entry_id": "f4a81e80-b16a-3bfa-8fa2-ef84ff656d54",
                                        "glosses": [
                                            "aus dem Anus entwichenes (menschliches oder tierisches) Abgas"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5cdecb-f533-4427-8565-f208c7b72fee",
                                                "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                                "text": "Während der Veranstaltung ließ er einen grandiosen Furz los."
                                            },
                                            {
                                                "example_id": "4001a205-8074-4a2f-bd04-184ff33d6c1b",
                                                "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                                "text": "Ihr regt euch aber auch über jeden Furz auf!"
                                            },
                                            {
                                                "example_id": "5da7b101-9cee-4271-9992-af4fc9763cef",
                                                "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                                "text": "„Als Nettie ihn ansah, glaubte sie, er habe vielleicht gerade einen Furz gelassen.“"
                                            },
                                            {
                                                "example_id": "d51a990b-2e23-4e87-aa4b-f8b259587cb4",
                                                "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                                "text": "„Und ihr grüner Tee stinkt schlimmer als Fürze.“"
                                            },
                                            {
                                                "example_id": "058cd810-040f-4357-980d-0d9417292074",
                                                "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                                "text": "„In seiner freudigen Erregung entfuhr dem Mönch ein Furz und er näßte sich die Hose.“"
                                            },
                                            {
                                                "example_id": "420799f1-bae6-46d7-ae28-4806ce8327a2",
                                                "sense_id": "9da790e9-9596-34b1-bb3f-aaf84740be16",
                                                "text": "„Er hebt ein Bein etwas an und lässt einen gewaltigen Furz losheulen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2dab201-818e-4f77-a3a5-855eeaad1ce3",
                        "source_entry_id": "1c04a9c2-555d-35ae-b38c-f793727bb823",
                        "source_sense_id": "3f1456c9-b5f2-3e16-bb1f-1c86af1930d8",
