                        "glosses": [
                            "größere Anzahl von dicht beieinander wachsenden, etwas umrankenden (Kletter-)Pflanzen (an einem bestimmten Ort)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287520e2-4098-42b9-bf49-adaf817a7302",
                                "sense_id": "70a592c1-3813-3d1a-8974-92694ac94b8a",
                                "text": "Der Fink legt das Nest niedrig über dem Boden, in kleinen, dichten Büschen, im Rankenwerk verschiedener Schlingpflanzen oder auch direkt im Grase an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
