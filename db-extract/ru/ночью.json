        "ru-extract.jsonl": [
            {
                "entry_id": "4e5133b9-4db0-3c08-abba-91ec04761998",
                "word": "ночью",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                        "entry_id": "4e5133b9-4db0-3c08-abba-91ec04761998",
                        "glosses": [
                            "в ночное, тёмное время суток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2fac53-a16b-4022-b566-aafd0dd46a46",
                                "sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                                "text": "Он у них прислуживает, ночью сторожит, а днём тетеревей ходит стрелять, да тем и живёт."
                            },
                            {
                                "example_id": "ec98e0bb-ce82-4464-8bc8-e8fe69da5e6d",
                                "sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                                "text": "— А страшно, так встану на колени, помолюсь — и всё как рукой снимет! Да и чего бояться? днём ― светло, а ночью у меня везде, во всех комнатах, лампадки горят!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77a38003-065f-4225-ab69-ff327cd2409c",
                        "source_entry_id": "4e5133b9-4db0-3c08-abba-91ec04761998",
                        "source_sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                        "target_lang_word": "at night",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at night",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e12957-5031-361d-85e0-40b8f8415d7d",
                                        "entry_id": "0bc9ad7f-5043-32b4-9aa3-bb271e69a319",
                                        "glosses": [
                                            "During the night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb9ffc5-4843-4fc1-81e6-ead5a4bf7c13",
                                                "sense_id": "a9e12957-5031-361d-85e0-40b8f8415d7d",
                                                "text": "Owls usually hunt at night."
                                            },
                                            {
                                                "example_id": "95b584e2-074f-494d-8b9e-25d8de7cd444",
                                                "sense_id": "a9e12957-5031-361d-85e0-40b8f8415d7d",
                                                "text": "Movement was then observed in a part of the wall which had been quiescent, and another group of struts was therefore constructed, again during traffic hours as well as at night."
                                            },
                                            {
                                                "example_id": "d89dc356-7fc2-4388-bbbf-a4639fea4adc",
                                                "sense_id": "a9e12957-5031-361d-85e0-40b8f8415d7d",
                                                "text": "As these [diesel] trains have to be shedded under cover at night, four additional outdoor standage roads are being provided for stabling of electric rolling stock after inspection in the shed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6546f277-433e-49b1-a5e2-482cb49a48b7",
                        "source_entry_id": "4e5133b9-4db0-3c08-abba-91ec04761998",
                        "source_sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                        "target_lang_word": "by night",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by night",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c12589c7-e089-3a12-8eb6-c2d73eda2f72",
                                        "entry_id": "4d869fae-ef90-30f1-a9ab-57d6458b26e2",
                                        "glosses": [
                                            "During the night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdcc760-5e50-4d7c-85ff-6579fbd39d1b",
                                                "sense_id": "c12589c7-e089-3a12-8eb6-c2d73eda2f72",
                                                "text": "He is a policeman by day and a thief by night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b824b292-08de-4af6-939c-f8060d413df7",
                        "source_entry_id": "4e5133b9-4db0-3c08-abba-91ec04761998",
                        "source_sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                        "target_lang_word": "during",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "during",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e5f24d-1abe-39a7-8964-c503f0e5dd53",
                                        "entry_id": "70d4009d-1c01-323b-996a-b9c6499c80a7",
                                        "glosses": [
                                            "For all of a given time interval; throughout; in; pending."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d706aae8-a947-4070-921c-e2256b8d5eee",
                                                "sense_id": "c1e5f24d-1abe-39a7-8964-c503f0e5dd53",
                                                "text": "I lived with my parents during the 1970s."
                                            },
                                            {
                                                "example_id": "f0a3ea52-847f-42a1-9179-00058b877712",
                                                "sense_id": "c1e5f24d-1abe-39a7-8964-c503f0e5dd53",
                                                "text": "This shop, which was among the few able to stay open during the war, is closed during the whole of August."
                                            },
                                            {
                                                "example_id": "517c1a75-4e43-4745-9c8d-822cbf08c846",
                                                "sense_id": "c1e5f24d-1abe-39a7-8964-c503f0e5dd53",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "b9381f42-c888-4396-a724-75eb7fa3a27d",
                                                "sense_id": "c1e5f24d-1abe-39a7-8964-c503f0e5dd53",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            },
                                            {
                                                "example_id": "58b54d8a-9901-4e47-95d8-9c0660df73f9",
                                                "sense_id": "c1e5f24d-1abe-39a7-8964-c503f0e5dd53",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6193bcdc-2d52-3822-91b1-a884863f0e01",
                                        "entry_id": "70d4009d-1c01-323b-996a-b9c6499c80a7",
                                        "glosses": [
                                            "At any time or period within a given time interval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c120c7c-0623-4ff7-840f-6533d6615aec",
                                                "sense_id": "6193bcdc-2d52-3822-91b1-a884863f0e01",
                                                "text": "I lived with my parents at several points during the 1980s."
                                            },
                                            {
                                                "example_id": "106d5afe-d088-46b3-910e-efb118365bb5",
                                                "sense_id": "6193bcdc-2d52-3822-91b1-a884863f0e01",
                                                "text": "Many of the best examples were produced during the Restoration."
                                            },
                                            {
                                                "example_id": "3dbbbd28-f785-4aef-878a-4d8727d6b26b",
                                                "sense_id": "6193bcdc-2d52-3822-91b1-a884863f0e01",
                                                "text": "I told him about everything I could think of; and what I couldn't think of he did. He asked about six questions during my yarn, but every question had a point to it. At the end he bowed and thanked me once more. As a thanker he was main-truck high; I never see anybody so polite."
                                            },
                                            {
                                                "example_id": "22452911-8fe7-4730-a29a-3ca6972961c0",
                                                "sense_id": "6193bcdc-2d52-3822-91b1-a884863f0e01",
                                                "text": "These infamous little green men appeared during the decisive seizures or buildings and facilities, only to disappear when associated militias and local troops arrived to consolidate the gains. In this way they provided a measure of deniability—however superficial or implausible—for Moscow.⁴⁰"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "during",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "253ac590-1a5f-3d94-b91d-31a1e36acec1",
