                "senses": [
                    {
                        "sense_id": "2d99490f-6f07-387b-8793-9b32f6e1b97a",
                        "entry_id": "948a1b9c-9673-31c9-a0d5-d0574660122e",
                        "glosses": [
                            "Beamter, der nach seiner Amtszeit als Konsul als Statthalter einer römischen Provinz fungiert"
                        ],
                        "tags": [
                            "im antiken Rom"
                        ],
                        "examples": [
                            {
                                "example_id": "d12d21d5-cd5f-4233-9f87-a66235b11336",
                                "sense_id": "2d99490f-6f07-387b-8793-9b32f6e1b97a",
                                "text": "„Auf ihrer ersten Missionsreise begegneten Barnabas und Paulus in Zypern dem Prokonsul Sergius Paulus.“"
                            },
                            {
                                "example_id": "f8bdc133-b963-4db8-9ace-a2f9c4d1d0fd",
                                "sense_id": "2d99490f-6f07-387b-8793-9b32f6e1b97a",
                                "text": "„Fällt der Prokonsul, so erhebt sich das Volk, die Wache der Barbaren erschrickt und die Empörung greift um sich mit Windeseile.“"
                            },
                            {
                                "example_id": "076d9b9d-685d-4698-aacf-2fba7f9242d9",
                                "sense_id": "2d99490f-6f07-387b-8793-9b32f6e1b97a",
                                "text": "„Victorinus hatte die angebotene Hilfe des Prokonsuls angenommen und sich einige Männer abstellen lassen.“"
                            },
                            {
                                "example_id": "7be18c7b-d7c0-4580-bd64-5c511fcac58e",
                                "sense_id": "2d99490f-6f07-387b-8793-9b32f6e1b97a",
                                "text": "„Er hieß Barjesus und gehörte zum Gefolge von Sergius Paulus, dem Prokonsul der Insel, einem klugen und vernünftigen Mann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
