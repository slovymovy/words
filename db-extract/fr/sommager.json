                        "glosses": [
                            "Placer sur une futaille des cercles appelés sommiers."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b9acfd9d-2324-4e95-9217-e31a4520218a",
                                "sense_id": "ed80b943-1a91-3ec5-bcc8-2102ef355dc4",
                                "text": "On donne le nom de sommier à deux cercles posés l’un dans l’autre, liés chacun comme tous les cercles avec l’osier, & qui, après avoir été doublés, sont encore liés ensemble. … Sommager, c’est donc placer les sommiers."
                            }
