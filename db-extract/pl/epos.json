                        "sense_id": "327d21de-d417-38cf-889b-6a9038db6669",
                        "entry_id": "3df75bc3-247b-346b-88ad-048c43af4fec",
                        "glosses": [
                            "poemat epicki pisany wierszem lub rzadziej prozą, w którym dzieje legendarnych lub rzeczywistych bohaterów są przedstawione na tle wydarzeń historycznych"
                        ],
