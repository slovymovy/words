                "forms": [],
                "senses": [
                    {
                        "sense_id": "d467fc13-7812-3cd2-a1c3-5c4cb59ccf00",
                        "entry_id": "6650916c-368c-354f-b500-4782d0375fcd",
                        "glosses": [
                            "Nom de famille anglophone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5fa5ad-b2ed-484b-9666-87ca893f8300",
                                "sense_id": "d467fc13-7812-3cd2-a1c3-5c4cb59ccf00",
                                "text": "Mais qu’avaient donc dans sa tête Vincent Lindon et son jury pour laisser repartir bredouille Armageddon Time, de James Gray ?"
                            },
                            {
                                "example_id": "1837729d-5d37-4a68-8224-a0ab13aa8c49",
                                "sense_id": "d467fc13-7812-3cd2-a1c3-5c4cb59ccf00",
                                "text": "Un an et puis un jour de ce départ, mon père\nIl se cassait le bras ; malade était ma mère,\nNotre vache volée,—et lui mon Jacque, en mer,\nEt le vieux Robin Gray vint qui me dit m’aimer."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
