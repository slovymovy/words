            {
                "entry_id": "4c9a679f-8132-3b7f-bcb5-1ae1c6b5f791",
                "word": "frostiness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d00e3699-73e9-3726-a3a1-94c881288919",
                        "entry_id": "4c9a679f-8132-3b7f-bcb5-1ae1c6b5f791",
                        "glosses": [
                            "Frost, eisige Kälte"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ceb67bb-9259-4979-858d-f76dba663d3c",
                        "source_entry_id": "4c9a679f-8132-3b7f-bcb5-1ae1c6b5f791",
                        "source_sense_id": "d00e3699-73e9-3726-a3a1-94c881288919",
                        "source_sense_description": "Frost, eisige Kälte",
                        "target_lang_word": "Frost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                        "entry_id": "b67683bd-4e73-353e-b58d-c38a2aa8d5b8",
                                        "glosses": [
                                            "äußere, sowohl strenge als auch milde Kälte, die bei Temperaturen im Bereich unter null Grad Celsius, also unterhalb des Gefrierpunktes von Wasser, eintritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "622b5d29-0a18-4fb1-9e91-64c58c69706a",
                                                "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                                "text": "In diesem Winter bleibt der Frost meist aus."
                                            },
                                            {
                                                "example_id": "ec9a0868-d789-410b-8405-c35ab8849662",
                                                "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                                "text": "„Nachdem John sein Frühstück wortlos verzehrt hatte, ging er, den Frost und das bläulich flimmernde Mondlicht verfluchend, fort.“"
                                            },
                                            {
                                                "example_id": "c5c6d3ec-e31e-44ec-a040-4ac6391711c7",
                                                "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                                "text": "„Die Gesichter waren verschlafen, Unwille lag auf ihnen, der Unwille, aus dem wenigstens animalisch erwärmten Bett in den Frost der Straße, aus der Ruhe in harte Fron zu müssen.“"
                                            },
                                            {
                                                "example_id": "a4a1d886-f4dd-46a7-9e55-87b2210f6327",
                                                "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                                "text": "„Nach ein paar Frösten war es wieder warm geworden.“"
                                            },
                                            {
                                                "example_id": "5f72c805-8c75-4a14-81ef-1f6c579b76c9",
                                                "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                                "text": "„Lange vor Weihnachten kam der erste Frost, es fiel der erste Schnee.“"
                                            },
                                            {
                                                "example_id": "63ee6803-eed8-47bf-9c70-7e33737e93be",
                                                "sense_id": "d46142bd-0705-3f22-af2b-c0c91519f74b",
                                                "text": "„Im Winter bietet Laub vielen Tieren Schutz vor Kälte und Frost: Igeln, aber auch Würmern, Spinnen, Asseln und Insekten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2482f0e-e325-3a62-ba55-3d2fe5903ea8",
                                        "entry_id": "b67683bd-4e73-353e-b58d-c38a2aa8d5b8",
                                        "glosses": [
                                            "gefrorene Scholle, gefrorener Acker, gefrorener Boden, gefrorene Erde"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e477cf5-ad0a-43e2-b77b-50c4087cafa4",
                                                "sense_id": "f2482f0e-e325-3a62-ba55-3d2fe5903ea8",
                                                "text": "Um den Toten zu bestatten, mussten sie in den Frost graben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2237c930-a976-352a-915b-b1c7a79ff703",
                                        "entry_id": "b67683bd-4e73-353e-b58d-c38a2aa8d5b8",
                                        "glosses": [
                                            "inneres menschliches Empfinden von Kälte"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed84f7d7-f476-4357-ae9b-db95a24e3cfc",
                                                "sense_id": "2237c930-a976-352a-915b-b1c7a79ff703",
                                                "text": "Von seinem Blick geht ein eisiger Frost aus."
                                            },
                                            {
                                                "example_id": "32da41ff-4ab8-4954-b4c4-ee5aebca91f9",
                                                "sense_id": "2237c930-a976-352a-915b-b1c7a79ff703",
                                                "text": "Nach dem Fieber wurde er von Frösten geschüttelt."
                                            },
                                            {
                                                "example_id": "4eb3f575-eb03-40c7-bfdf-049b2b9bb9d7",
                                                "sense_id": "2237c930-a976-352a-915b-b1c7a79ff703",
                                                "text": "„Victoirens Lippen flogen, ihre Sicherheit verließ sie, und ein Frost schüttelte sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cf8b119-f5b1-42b0-ade4-d98f49e5aaae",
                        "source_entry_id": "4c9a679f-8132-3b7f-bcb5-1ae1c6b5f791",
                        "source_sense_id": "d00e3699-73e9-3726-a3a1-94c881288919",
                        "source_sense_description": "Frost, eisige Kälte",
                        "target_lang_word": "Kälte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kälte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                        "entry_id": "16bd47d2-02e4-3fcc-94a2-f0ce0a3076b7",
                                        "glosses": [
                                            "niedrige Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3adec9ec-adbc-4898-8a7f-968664bec2c4",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "Der Januar 2006 wurde berüchtigt durch seine Kälte."
                                            },
                                            {
                                                "example_id": "9e307d64-d096-4693-b0ad-fe5027d38e7e",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "Du kannst ihn doch nicht in der Kälte warten lassen."
                                            },
                                            {
                                                "example_id": "7ff3483f-67dd-4b9a-b1b7-2f77a984fea3",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "Mir steckt die Kälte immer noch in den Knochen."
                                            },
                                            {
                                                "example_id": "fd134881-d2ee-4509-b5e3-2e25341a499d",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "Die winterliche Kälte sorgte in den letzten Tagen in Europa für über 100 Tote. Besonders hart trifft die Kälte die Menschen in Osteuropa. Vor allem Obdachlose werden Opfer der Kälte."
                                            },
                                            {
                                                "example_id": "0288da5f-a7a5-4da7-aad2-b0b28a3153e6",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "»Ich bitte um Verzeihung, hochwürdiger Herr Doktor Martine,« sagte er, »daß ich Euch in Eurem schönen Liede gestört habe. Ich stand schon eine gute Weile draußen und habe mit herzlicher Andacht zugehört, mochte auch während des Gesangs nicht anklopfen, aber es ist eine grimmige Kälte, die mir bei meinem Alter schwer zu ertragen fällt.«"
                                            },
                                            {
                                                "example_id": "02be3705-45f8-45aa-99f9-b5242ce45b60",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "„Es herrschte bittere Kälte, als die junge Gräfin ihren Fuchswallach Alarich bestieg und im Mondlicht losritt.“"
                                            },
                                            {
                                                "example_id": "25570bb5-7e26-4739-a161-49b35962f6d0",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "Unter meinen Füßen knirscht das Holzwerk in der scharfen Kälte."
                                            },
                                            {
                                                "example_id": "a296ba7b-ff05-4ed5-a2aa-209040789dd4",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "„Im Winter bietet Laub vielen Tieren Schutz vor Kälte und Frost: Igeln, aber auch Würmern, Spinnen, Asseln und Insekten.“"
                                            },
                                            {
                                                "example_id": "30466545-7dac-4c61-b12c-f1d5aeb5eb67",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "„In Skandinavien herrscht extreme Kälte. In Schweden etwa sanken die Temperaturen unter minus 40 Grad. So kalt war es dort seit 25 Jahren nicht mehr.“"
                                            },
                                            {
                                                "example_id": "19c7788b-7cf8-4ac2-9786-9f46dd40e4d7",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "„Da sich die Blutgefäße bei Kälte verengen, kann nicht mehr genügend Blut durch die Gefäße transportiert werden.“"
                                            },
                                            {
                                                "example_id": "6be917bc-c45d-4842-98e0-ac6931e2d367",
                                                "sense_id": "e54a002d-680d-3ef0-8319-1de228140a02",
                                                "text": "„Ist klar, dass wir uns über längere Zeit extremer Kälte aussetzen, ist es ratsam, eine Notausrüstung mitzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c12f7fe-cafc-313c-9100-34870d30e587",
                                        "entry_id": "16bd47d2-02e4-3fcc-94a2-f0ce0a3076b7",
                                        "glosses": [
                                            "Unfreundlichkeit, Gefühlskälte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6487ed8e-ccab-454e-9ce3-17de6b76988f",
                                                "sense_id": "5c12f7fe-cafc-313c-9100-34870d30e587",
                                                "text": "Zuerst nennen wir Buffon, der obgleich großartig in seinen Ansichten, doch mehr pomphaft malt, als individuell, u. dessen Schilderungen eine gewisse Kälte haben, weil ihn die eigne Ansicht der exotischen Natur abgeht."
                                            },
                                            {
                                                "example_id": "9bf4d20e-ee1f-4dbc-97f0-fe6530b2bd11",
                                                "sense_id": "5c12f7fe-cafc-313c-9100-34870d30e587",
                                                "text": "Er ging hinab in den Saal und wünschte seiner Gemahlin mit erkünstelter Gleichgültigkeit und Kälte einen schönen guten Morgen."
                                            },
                                            {
                                                "example_id": "e0069ea7-dc67-4774-8656-1451330273d6",
                                                "sense_id": "5c12f7fe-cafc-313c-9100-34870d30e587",
                                                "text": "Mit teuflischer Bosheit hatte er ihr das verderbliche Wort aus dem Munde gezwungen, und hätte sie feige geschwiegen und ihn beschimpfen lassen, der Arge hätte bald eine andre Gelegenheit gefunden, die spröde Kälte des Mädchens an ihm, dem völlig Unbeteiligten, den der Zurückgewiesene bevorzugt glaubte, satanisch zu rächen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
