                "senses": [
                    {
                        "sense_id": "7d779ce9-9bac-3c33-aea5-bcb8efc958bb",
                        "entry_id": "828b05ec-39e7-3e4c-b381-bad1939f2026",
                        "glosses": [
                            "veraltet: Menschen, die auf dem Land leben, die das Land bearbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e71fc7f-8d27-42c5-88e3-e58f76283367",
                                "sense_id": "7d779ce9-9bac-3c33-aea5-bcb8efc958bb",
                                "text": "„Die Einschildritter sind Landleute, Landvolk, und darin den übrigen Unterschichten zugeordnet.“"
                            },
                            {
                                "example_id": "72b35a85-307b-4988-8947-00c052ebd047",
                                "sense_id": "7d779ce9-9bac-3c33-aea5-bcb8efc958bb",
                                "text": "„Endlich war auch noch eine dritte Ursache, welche die Zahl der freien Landleute außerordentlich verringerte und die der unfreien, die von einem adligen Herrn oder einem Kloster abhängig waren, vermehrte; das war der beschwerliche Kriegsdienst im Heerbanne.“"
                            },
                            {
                                "example_id": "3df77c36-2b0d-45fa-9203-843f3835d7ab",
                                "sense_id": "7d779ce9-9bac-3c33-aea5-bcb8efc958bb",
                                "text": "„…andererseits ist nicht wohl einzusehen, warum den Landleuten verwehrt werden soll, ihre Producte schon vor der Stadt, vielleicht um etwas billiger sogar, zu verkaufen, um eher nach Hause zu kommen und nicht so viel Zeit in der Stadt unnütz zuzubringen.“"
                            },
                            {
                                "example_id": "26476762-d397-476b-b835-065ee968bebb",
                                "sense_id": "7d779ce9-9bac-3c33-aea5-bcb8efc958bb",
                                "text": "„Die Soldaten, welche bei einem feindlichen Angriffe davon laufen, fliehen; die Landleute und Bürger, die bei dem Anrücken eines feindlichen Heeres ihre Habe zu retten suchen, flüchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
