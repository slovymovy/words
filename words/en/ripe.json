                },
                {
                    "sense_id": "0360130a-d42a-373f-9745-88480b355b0d",
                    "sense_definition": "Abundantly supplied with or full of something (usually something negative).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was <w>ripe</w> with rumors about the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Город был <w>по́лон</w> слухов о предстоящих выборах.",
                                "de": "Die Stadt war <w>voll</w> von Gerüchten über die bevorstehende Wahl."
                            }
                        },
                        {
                            "text": "The situation is <w>ripe</w> with danger for anyone who interferes.",
                            "target_lang_translations": {
                                "ru": "Ситуация <w>чрева́та</w> опасностью для любого, кто вмешается.",
                                "de": "Die Situation ist <w>voller</w> Gefahren für jeden, der sich einmischt."
                            }
                        }
