                        "sense_id": "d0cc5f2f-0986-3a7c-aae1-71bebace8740",
                        "entry_id": "0ba44cae-e8a3-38ed-81b1-b7eb543e985e",
                        "glosses": [
                            "een plaats waar treinen stoppen en vertrekken en de reizigers kunnen in-, uit- en overstappen en/of goederen kunnen worden verladen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466dc396-351b-43cd-8c63-53f85f391dee",
                                "sense_id": "d0cc5f2f-0986-3a7c-aae1-71bebace8740",
                                "text": "Dertig middelgrote treinstations worden komend jaar uitgerust met beveiligingscamera’s. Ook krijgen conducteurs en beveiligers camera’s op hun kleding, zo meldt het ministerie van Infrastructuur en Milieu."
                            },
                            {
                                "example_id": "6087b1e6-4167-46b3-b07b-b71daabea497",
                                "sense_id": "d0cc5f2f-0986-3a7c-aae1-71bebace8740",
                                "text": "Verschillende treinstations in Nederland krijgen vanaf eind dit jaar nieuwe banken, wachtruimten en windschermen. Reizigers kunnen dan onder meer zittend op een poef wachten, meldt ProRail vanochtend."
                            }
                        ]
                    }
