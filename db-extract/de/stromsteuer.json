                ],
                "senses": [
                    {
                        "sense_id": "1f2de9e4-a397-3bc4-9f2a-d8fbe5b9ce2d",
                        "entry_id": "c4b3fc4d-0307-3f05-adfe-7a6875f81190",
                        "glosses": [
                            "Abgabe an den Staat, die den Stromverbraucher trifft"
                        ],
                        "tags": [
                            "ökologische Steuerart"
                        ],
                        "examples": [
                            {
                                "example_id": "8aaf863f-1211-4203-bb9a-8f851a800a39",
                                "sense_id": "1f2de9e4-a397-3bc4-9f2a-d8fbe5b9ce2d",
                                "text": "„Elektrischer Strom (Strom) der Position 2716 der Kombinierten Nomenklatur unterliegt im Steuergebiet der Stromsteuer.“"
                            },
                            {
                                "example_id": "ee63a531-9633-4f68-a07f-7baa4560e969",
                                "sense_id": "1f2de9e4-a397-3bc4-9f2a-d8fbe5b9ce2d",
                                "text": "„Im Rahmen des Gesetzes zum Einstieg in die ökologische Steuerreform wurde die Stromsteuer am 1. April 1999 in Deutschland eingeführt.“"
                            },
                            {
                                "example_id": "5dd162de-cb5c-4335-899d-8ff49eefdf09",
                                "sense_id": "1f2de9e4-a397-3bc4-9f2a-d8fbe5b9ce2d",
                                "text": "„Die Ökosteuer besteht aus zwei Steuern: der Stromsteuer und einem Aufschlag zur Energiesteuer.“"
                            },
                            {
                                "example_id": "0ddc490b-a05d-4652-8ca4-9dae46b054bb",
                                "sense_id": "1f2de9e4-a397-3bc4-9f2a-d8fbe5b9ce2d",
                                "text": "„Der Gesetzgeber verlangt seit dem 1. Januar 2013 von Unternehmen des produzierenden Gewerbes in Zukunft Gegenleistungen zum Erhalt der Entlastungen von der Stromsteuer (Spitzenausgleich nach §10 StromStG).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
