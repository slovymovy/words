                ],
                "senses": [
                    {
                        "sense_id": "789a2b60-e412-3ec3-9f46-2ee1d1e5137a",
                        "entry_id": "2a2461a2-83cc-34f6-b6ea-e073269885be",
                        "glosses": [
                            "Rendre conditionnel (sur des critères écologiques)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8441d8b5-ba1f-4dfa-a5e4-88ba86b7dee4",
                                "sense_id": "789a2b60-e412-3ec3-9f46-2ee1d1e5137a",
                                "text": "Nous exigerons d’éco-conditionnaliser les aides régionales en soumettant leur attribution aux collectivités, entreprises et associations à des critères environnementaux, sociaux ou de création d’emplois afin de réduire les gaspillages d’argent public et de ne plus financer des entreprises polluantes ou qui licencient pour délocaliser leurs activités dans d’autres pays."
                            },
                            {
                                "example_id": "cd67ecae-d654-44f6-9739-8a9dd67be0bc",
                                "sense_id": "789a2b60-e412-3ec3-9f46-2ee1d1e5137a",
                                "text": "Le 14 décembre 2009, la CTC a voté à l’unanimité le principe d’éco-conditionnaliser progressivement l’ensemble de ses dispositifs de soutien."
                            },
                            {
                                "example_id": "1949f9e8-3179-4dc9-bbbe-fd2218060c67",
                                "sense_id": "789a2b60-e412-3ec3-9f46-2ee1d1e5137a",
                                "text": "Cette charte précise également que l’ADEME s’engage à éco-conditionnaliser ses aides, ainsi les études devront être réalisées par un professionnel bénéficiant d’un signe de qualité « RGE » sur le domaine concerné."
                            }
                        ]
                    }
