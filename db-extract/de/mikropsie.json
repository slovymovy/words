                "senses": [
                    {
                        "sense_id": "48bebed3-d3ea-335f-b142-0dd86a9f4b2d",
                        "entry_id": "a2ce78be-cd82-39f0-b220-2389b49ee8ea",
                        "glosses": [
                            "Sehstörung, bei der die Umgebung beziehungsweise Dinge kleiner wahrgenommen werden als sie wirklich sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d3b28c-1ba1-4c99-a76e-a20519d9efba",
                                "sense_id": "48bebed3-d3ea-335f-b142-0dd86a9f4b2d",
                                "text": "„Die Gegenstände erscheinen dann abnorm klein (Mikropsie) oder riesengroß (Makropsie), ganz nahe oder weit weg; im Meskalinrausch tritt ein Gefühl der Raumunendlichkeit auf.“"
                            },
                            {
                                "example_id": "87a49566-dccf-4fda-a46e-f8c50b7f4e4c",
                                "sense_id": "48bebed3-d3ea-335f-b142-0dd86a9f4b2d",
                                "text": "„Als Kind hatte ich bei Eisenbahnfahrten fast regelmäßig die Erscheinung der Mikropsie.“"
                            },
                            {
                                "example_id": "7f2b32a8-2f0d-4b79-a64f-d1cd0bdf74a8",
                                "sense_id": "48bebed3-d3ea-335f-b142-0dd86a9f4b2d",
                                "text": "„Eine weitere spezielle Auravariante ist das ‚Alice-im-Wunderland-Syndrom‘ mit Mikropsie und Makropsie sowie eventuell halluzinatorisch anmutenden Verkennungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
