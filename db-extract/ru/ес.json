                    {
                        "translation_id": "30247b18-2e11-4f4b-8272-7a950821660b",
                        "source_entry_id": "c40c8349-d2cf-3186-b5ec-8f727a0a233d",
                        "source_sense_id": "31c0a6d7-7d67-3079-b400-6a62557ef2c6",
                        "target_lang_word": "European Union",
