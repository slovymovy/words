                        "target_lang_word": "bachelière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bachelière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdbfe9bc-f11d-3483-9f1c-72dc856fd328",
                                        "entry_id": "1eb59614-3f8d-3a83-a473-c6b34543d840",
                                        "glosses": [
                                            "Élève diplômée au baccalauréat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ede727-0d66-45ae-b306-9e3b8f95fba8",
                                                "sense_id": "bdbfe9bc-f11d-3483-9f1c-72dc856fd328",
                                                "text": "A 15 ans, elle est la plus jeune bachelière de La Réunion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe2ff74-d4ce-3fad-8d5e-514b4ed873f9",
                                        "entry_id": "1eb59614-3f8d-3a83-a473-c6b34543d840",
                                        "glosses": [
                                            "Maitresse d’un bachelier (au xixᵉ siècle)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bachelière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e419b1ed-a630-3a93-9e6d-f561638351de",
                                        "entry_id": "845090de-4b6d-33b0-b41f-53b1805dfe4b",
                                        "glosses": [
                                            "Féminin singulier de bachelier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16dd57e3-091c-4248-b50a-e25072a6c79b",
                                                "sense_id": "e419b1ed-a630-3a93-9e6d-f561638351de",
                                                "text": "Ce fut ensuite à la fin du xixᵉ siècle, trente ans après sa mort, quand Lamartine n’émergeait encore que péniblement de l’oubli, que Hugo restait pris dans les vulgarités de l’apothéose officielle, que les délicats trouvaient, selon le mot de Jules Lemaître, que le premier faisait trop gnan-gnan et le second boum-boum, que Sully-Prudhomme, quelque peu héritier de Vigny, devenait le poète de la « jeunesse pensive » et bachelière"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d5d7e02-c23c-4893-bb04-415eab3ae219",
                        "source_entry_id": "5a087b5f-8697-398b-af06-7f71797d7736",
                        "source_sense_id": "f8c1d19a-05fa-3b7d-ba8f-1e86dfb789e6",
                        "target_lang_word": "Abiturientin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abiturientin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                        "entry_id": "ba4d48cd-0702-398f-9147-e424495a1b2f",
                                        "glosses": [
                                            "Schülerin, die ihr Abitur ablegt oder bereits abgelegt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8021543f-5ce7-477d-902b-2a51ab5d0540",
                                                "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                                "text": "„Uns fehlen auch Frauen in den technischen Studiengängen und Berufen. Das liegt unter anderem daran, dass den Abiturientinnen Vorbilder fehlen, die sie für einen solchen Weg begeistern.“"
                                            },
                                            {
                                                "example_id": "5ccb45e1-993c-41dd-90b2-898c52facc34",
                                                "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                                "text": "„Eine Abiturientin aus Lyck hat ihre bitteren Erlebnisse auf der Flucht beschrieben, das Leid, den Hunger, die Entbehrungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
