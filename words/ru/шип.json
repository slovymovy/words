                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из старого радио доносилось неприятное <w>шипение</w>.",
                            "target_lang_translations": {
                                "en": "An unpleasant <w>hissing</w> sound was coming from the old radio."
                            }
                        },
                        {
                            "text": "Змеиное <w>шипение</w> напугало туристов в лесу.",
                            "target_lang_translations": {
