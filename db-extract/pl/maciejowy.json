                        "examples": [
                            {
                                "example_id": "3c102b9c-0d4e-425d-8626-d8fe6bcc0a7c",
                                "sense_id": "8431137f-0507-3b96-bf39-b90983fd6e74",
                                "text": "Przed Maciejowym domem rosną dwa rosochate orzechy."
                            },
                            {
                                "example_id": "c9abb846-386b-4afe-a100-7c861aff4078",
                                "sense_id": "8431137f-0507-3b96-bf39-b90983fd6e74",
                                "text": "Sąsiadował z Maciejową zagrodą z jednej strony i z Jakubowym polem z drugiej."
                            },
                            {
                                "example_id": "cfb5993f-99af-478a-b5e7-972e8e7c69bb",
                                "sense_id": "8431137f-0507-3b96-bf39-b90983fd6e74",
                                "text": "Maciejowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
