                ],
                "senses": [
                    {
                        "sense_id": "75b9cf8a-1d62-3c59-be52-c2ce8d7daad1",
                        "entry_id": "5125e57a-dd2d-3709-8471-7b6a8a2657b7",
                        "glosses": [
                            "Person, die an einem Bungeeseil befestigt aus großer Höhe in die Tiefe springt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fda9d6cc-abd7-46a1-b6da-7d34a2bc64ad",
                                "sense_id": "75b9cf8a-1d62-3c59-be52-c2ce8d7daad1",
                                "text": "„Das ist Rekord: 149 Bungeespringer haben sich in Brasilien von einer 30 Meter hohen Brücke in die Tiefe gestürzt - und damit eindrucksvolle Bilder produziert.“"
                            },
                            {
                                "example_id": "218c50d9-aadd-40ff-894e-0dd331535be5",
                                "sense_id": "75b9cf8a-1d62-3c59-be52-c2ce8d7daad1",
                                "text": "„Herr Wirz, das Guinness-Buch der Rekorde führt Sie als den ältesten Bungeespringer der Welt. Wann und wie kamen sie zum Bungeejumping?“"
                            },
                            {
                                "example_id": "a2416400-308d-4d1c-a46f-59f9f7e1625c",
                                "sense_id": "75b9cf8a-1d62-3c59-be52-c2ce8d7daad1",
                                "text": "„Dem Bungeespringer oder dem Free-Fall-Abenteurer droht höchstens der Vorstellungstod des ängstlichen Zuschauers, der die Sicherungen nicht wahrnimmt.“"
                            },
                            {
                                "example_id": "5c2431f7-b51b-4a12-a4b0-25829efe5cc8",
                                "sense_id": "75b9cf8a-1d62-3c59-be52-c2ce8d7daad1",
                                "text": "„Erste Standorte waren die Kawarau-Bridge und die Skippers Canyon Bridge. Seitdem entwickelte sich Neuseeland zum Mekka der Bungeespringer und des Abenteuer-Tourismus schlechthin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
