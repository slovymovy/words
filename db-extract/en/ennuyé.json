                        "examples": [
                            {
                                "example_id": "17d38658-1727-4ec1-9bf9-eeff266643c9",
                                "sense_id": "e0f9ae6a-231a-3f38-bdd9-51e9c3b09cc5",
                                "text": "Upon my entrance, Usher arose from a sofa on which he had been lying at full length, and greeted me with a vivacious warmth which had much in it, I at first thought, of an overdone cordiality—of the constrained effort of the ennuyé man of the world."
                            },
                            {
                                "example_id": "080a07c8-516f-4f5b-b003-b47b3be66fa4",
                                "sense_id": "e0f9ae6a-231a-3f38-bdd9-51e9c3b09cc5",
                                "text": "You must open your doors to your friend at all hours; if when inside it suit him to sing, sing he will; and until you learn solitude in a crowd, or the art of concentration, you are apt to become ennuyé and irritable."
                            }
                        ]
