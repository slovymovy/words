                "senses": [
                    {
                        "sense_id": "64080dfe-b079-379a-a446-dfb168d7abb7",
                        "entry_id": "9acd143c-cf43-3a03-b6b6-5005d52569ff",
                        "glosses": [
                            "Parkplatz, der für Kunden einer Firma reserviert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "764fddf7-9975-4403-9e6b-e4fdd10af890",
                                "sense_id": "64080dfe-b079-379a-a446-dfb168d7abb7",
                                "text": "Sie parkte am Wochenende auf dem Kundenparkplatz des Supermarkts, weil überall Parkplatznot herrschte."
                            },
                            {
                                "example_id": "c4b86d59-9f22-4220-b062-14d1a9d42b2e",
                                "sense_id": "64080dfe-b079-379a-a446-dfb168d7abb7",
                                "text": "„Dort heißt es: „Die zusätzliche Beschilderung ‘Kundenparkplatz Lidl ausschließlich für Lidl-Kunden‘ ist nach Paragraph 33, Absatz 2, der Straßenverkehrsordnung unzulässig und stellt eine Ordnungswidrigkeit dar, die geahndet werden kann.““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
