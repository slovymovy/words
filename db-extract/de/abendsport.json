                "senses": [
                    {
                        "sense_id": "271033e3-d44c-32e7-8e0c-6b179e69fbd7",
                        "entry_id": "fec40604-cd88-3ff6-a6cc-bb1ed0bd510d",
                        "glosses": [
                            "sportliche Aktivität zur Abendzeit"
