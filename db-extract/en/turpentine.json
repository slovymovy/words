                        ]
                    },
                    {
                        "translation_id": "e0cd56d3-0d8e-4bf1-bce4-94776d28a990",
                        "source_entry_id": "0d99bd76-abb0-3b83-92fe-99a9cecc7da2",
                        "source_sense_description": "volatile essential oil",
                        "target_lang_word": "essence de térébenthine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essence de térébenthine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a0bc7f8-659e-362f-8016-7aee846d4ecd",
                                        "entry_id": "e44a341a-04ef-3f69-8bb7-8624f24da2b0",
                                        "glosses": [
                                            "Huile essentielle obtenue par purification puis par distillation de térébenthine."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9fe556c-3485-45ce-8731-7636be492562",
                                                "sense_id": "5a0bc7f8-659e-362f-8016-7aee846d4ecd",
                                                "text": "La térébenthine est composée de résine et d’une huile essentielle nommée essence de térébenthine ; la substance résineuse constitue la colophane."
                                            },
                                            {
                                                "example_id": "36586bb8-bbce-443b-a045-bc3969e18e68",
                                                "sense_id": "5a0bc7f8-659e-362f-8016-7aee846d4ecd",
                                                "text": "Séris dit que les savants américains n’ont plus besoin de notre résine pour en extraire l’essence de térébenthine et qu’on aura de moins en moins recours à nos pins pour les poteaux de mine et pour les traverses de chemin de fer."
                                            },
                                            {
                                                "example_id": "3af63e00-6471-470e-853e-5d836fa9719c",
                                                "sense_id": "5a0bc7f8-659e-362f-8016-7aee846d4ecd",
                                                "text": "Les industriels utilisent les résidus de papeterie ou importent de l’essence de térébenthine de pays producteurs de résine comme le Brésil, le Portugal ou la Chine. L’essence de térébenthine entre dans la composition de nombreux produits d'entretien et d'hygiène : cosmétiques, cires, vernis, etc."
                                            },
                                            {
                                                "example_id": "024281da-32a4-4424-9f21-f4200ad7fbc0",
                                                "sense_id": "5a0bc7f8-659e-362f-8016-7aee846d4ecd",
                                                "text": "Proposant des Nécropoles (1978-1980), R. Passeron travaille, pour sa part, le polystyrène désexpansé à l’aide de l’essence de térébenthine."
                                            },
                                            {
                                                "example_id": "7a260bcf-1297-4d3f-93fa-be75244775ed",
                                                "sense_id": "5a0bc7f8-659e-362f-8016-7aee846d4ecd",
                                                "text": "Ainsi, le toxaphène ou le polychlorocamphane, insecticides du groupe des camphènes chlorés dérivés de l’essence de térébenthine, homologués dans les années 1970 à la dose moyenne de 3 350 g/ha ont été supplantés dans les années 80 par des organophosphorés comme le parathion-méthyl et les oléo-parathions, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "892c6c41-a009-432a-a707-88a92508c704",
                        "source_entry_id": "0d99bd76-abb0-3b83-92fe-99a9cecc7da2",
                        "source_sense_description": "volatile essential oil",
                        "target_lang_word": "térébenthine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "térébenthine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc863d8-33e6-3b6d-a43c-d3f724e3ee6f",
                                        "entry_id": "2ba873d5-0e52-381a-8d5c-74932d95b3bb",
                                        "glosses": [
                                            "Oléorésine qui coule du térébinthe et d’autres arbres résineux comme le pin maritime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1212ceee-0554-49ed-ad5e-3be0ba113238",
                                                "sense_id": "dfc863d8-33e6-3b6d-a43c-d3f724e3ee6f",
                                                "text": "La térébenthine de Chio, d’un blanc verdâtre, découle du pistachier térébinthe, qui croît dans les régions chaudes de l’Asie et surtout aux environs de Chio. La térébenthine de Venise, qui est plus odorante et plus transparente, est extraite du pin larix. La térébenthine de Strasbourg ou térébenthine de sapin est très-transparente et presque incolore. La térébenthine commune provient du pin sylvestre et du pin maritime; on la recueille surtout dans la Dordogne et les Landes."
                                            },
                                            {
                                                "example_id": "57be49da-39a1-4f04-9385-c43ac4f6d9d8",
                                                "sense_id": "dfc863d8-33e6-3b6d-a43c-d3f724e3ee6f",
                                                "text": "C'est sur quoi on ne peut rien statuer parfaitement, quoiqu'on sache, en général, que la térébenthine et le soufre sont antipathiques aux insectes : cependant l'expérience contre les ravets doit faire croire avec fondement que le ricin y a la meilleure part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e202cc47-34be-3e67-87d8-8668b392e8c7",
                                        "entry_id": "2ba873d5-0e52-381a-8d5c-74932d95b3bb",
                                        "glosses": [
                                            "Essence de térébenthine ; huile essentielle obtenue après fusion et décantation de la gemme qui coule directement de l’arbre."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d715a5-4e85-4391-adf8-afd1a8007514",
                                                "sense_id": "e202cc47-34be-3e67-87d8-8668b392e8c7",
                                                "text": "La térébenthine seule est un baume simple très-convenable pour la guérison des plaies."
                                            },
                                            {
                                                "example_id": "5330148f-2dfb-4412-af8e-d0a91fa92f3f",
                                                "sense_id": "e202cc47-34be-3e67-87d8-8668b392e8c7",
                                                "text": "La rue déserte, une torpeur à mon retour de classe, […], l'odeur de térébenthine qu'exhalait, au soir, le manguier du jardin, me laissent aujourd'hui le regret de n'avoir retenu de ces impressions que ce qu'il reste."
                                            },
                                            {
                                                "example_id": "ed2c0f0d-4299-466a-9c92-f868510f22e8",
                                                "sense_id": "e202cc47-34be-3e67-87d8-8668b392e8c7",
                                                "text": "Les deux de cette nuit grelottaient, paraît-il. Il a fallu qu’on les frotte à la térébenthine."
                                            },
                                            {
                                                "example_id": "a07732db-9087-4b35-a9c8-7ccae37253d6",
                                                "sense_id": "e202cc47-34be-3e67-87d8-8668b392e8c7",
                                                "text": "Combien de pigments, d’huile de lin et de térébenthine a-t-il liés pour trouver la couleur, celle qui viendrait exprimer, imprégner le plus justement possible son dessin intérieur?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "térébenthine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fee0efd-3834-3782-98c2-7b72ae8b272c",
                                        "entry_id": "6215f360-9966-3226-9ba5-a65f31a0b228",
                                        "glosses": [
