                        "entry_id": "b31960b3-e37f-3fec-81fc-5f27567bcc16",
                        "glosses": [
                            "Affected by hypothermia; having an abnormally low body temperature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eecb48cb-6232-456d-a5ac-8a1df4c5927f",
                                "sense_id": "7a225600-cbd3-39b4-b96c-e52f54aabe84",
                                "text": "The survivors of the shipwreck quickly became hypothermic."
                            },
                            {
                                "example_id": "df1f4909-aef5-4c8a-afce-ab03e74f2acb",
                                "sense_id": "7a225600-cbd3-39b4-b96c-e52f54aabe84",
                                "text": "It was found that brief hypothermic oxygenated machine perfusion (HMP) prior to organ transplantation significantly improves organ integrity and leads to decreased numbers of cases of post-transplantation graft dys- and nonfunction.^(7,8)"
                            },
                            {
                                "example_id": "15c0aabd-38cd-472f-9f65-748a877ca6ca",
                                "sense_id": "7a225600-cbd3-39b4-b96c-e52f54aabe84",
                                "text": "He [Dean Karnazes] has been hypothermic and watched his fingers turn blue, and said he will not let that happen anymore."
                            }
                        ]
                    }
                ],
