            {
                "entry_id": "67b985fa-7a89-3b80-b8ad-0c3cf7a4f8c3",
                "word": "aanvoerlijn",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c546171d-1fe5-49a4-b9dc-5c2ec5040644",
                        "entry_id": "67b985fa-7a89-3b80-b8ad-0c3cf7a4f8c3",
                        "tags": [
                            "plural"
                        ],
                        "form": "aanvoerlijnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab27a84a-b165-37c7-8436-e3aa7749e378",
                        "entry_id": "67b985fa-7a89-3b80-b8ad-0c3cf7a4f8c3",
                        "glosses": [
                            "route of bron die zorgt voor de aanvoer van mensen of goederen naar een bepaalde plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d81c8f7a-1e19-4012-a534-5ec4ad2f88ab",
                                "sense_id": "ab27a84a-b165-37c7-8436-e3aa7749e378",
                                "text": "De rebellen kunnen in de provincie nog net een corridor van Aleppo naar Turks grondgebied openhouden, waardoor een belangrijke aanvoerlijn in stand blijft."
                            },
                            {
                                "example_id": "6b649c92-dc2e-4f0f-b88b-3897faedbd1a",
                                "sense_id": "ab27a84a-b165-37c7-8436-e3aa7749e378",
                                "text": "Nog steeds gaat de discussie dus over herverdelen en opnemen. Het sleutelwoord dat ik mis is: tegenhouden. Daar moet nu juist eens de nadruk op gelegd worden. De aanvoerlijnen uit Noord-Afrika moeten volledig opdrogen. Libië is daar al een goed voorbeeld van. Dat het tegenhouden heel veel geld kost is duidelijk. Maar het opnemen en voorgoed huisvesten kost een veelvoud daarvan. Die vier Oost-Europese dissidenten kunnen daar mooi aan bijdragen."
                            },
                            {
                                "example_id": "a724eb71-220a-4b99-867e-679024fe6a55",
                                "sense_id": "ab27a84a-b165-37c7-8436-e3aa7749e378",
                                "text": "Vanaf de eerste uitvoering (Jesus Christ Superstar)zette de organisatie Winterswijk landelijk op de kaart. Volgens voorzitter Dirk Willink bezochten 75.000 bezoekers de voorstellingen. Een steeds groter deel van het publiek komt van buiten de Achterhoek, met Twente als belangrijkste aanvoerlijn."
                            },
                            {
                                "example_id": "73598665-2c66-4cb8-87bb-626b8268bdc6",
                                "sense_id": "ab27a84a-b165-37c7-8436-e3aa7749e378",
                                "text": "Het was een kwestie van dagen geweest voordat de Engelsen aan de noordzijde van de brug waren omsingeld, afgesneden van hun aanvoerlijnen die uit de richting van Wolfheze en Oosterbeek hadden moeten komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c518bda-12cf-469b-9c33-b49bb720c750",
                        "source_entry_id": "67b985fa-7a89-3b80-b8ad-0c3cf7a4f8c3",
                        "source_sense_id": "ab27a84a-b165-37c7-8436-e3aa7749e378",
                        "target_lang_word": "supply line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supply line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a1160d4-62f5-366a-95ea-1731a9b2b57c",
                                        "entry_id": "5352b1d8-cf22-37dd-a862-ab69699bfe31",
                                        "glosses": [
                                            "The chain of transportation mechanisms supplying food and materiel to an army in battle, or other field operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa75501-444f-4539-810f-a38aa52ae1df",
                                                "sense_id": "4a1160d4-62f5-366a-95ea-1731a9b2b57c",
                                                "text": "Having cracked the Germans' Enigma traffic, the Allies were able to devastate Rommel's supply lines across the Mediterranean."
                                            },
                                            {
                                                "example_id": "fdb20ea4-4222-45f1-991e-bd0be37b0d21",
                                                "sense_id": "4a1160d4-62f5-366a-95ea-1731a9b2b57c",
                                                "text": "Hostile forces are putting pressure on our people. Take out their supply line to give our troops room to breathe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13707b87-c526-3d4a-9c3a-c4df4222b6c5",
                                        "entry_id": "5352b1d8-cf22-37dd-a862-ab69699bfe31",
                                        "glosses": [
                                            "Any system in place to provide resources to a group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8bc2687-8fc8-4a92-9ac2-035218938012",
                                                "sense_id": "13707b87-c526-3d4a-9c3a-c4df4222b6c5",
                                                "text": "John Barclay and [Stuart] McInally controlled the tackle area, denying England quick possession and fracturing the champions’ supply line, Simon Berghan anchored the scrum and behind Finn Russell, missing in action in the opening two rounds, fulfilled his captain Barclay’s prediction on the eve of the game that he would be the man of the match."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
