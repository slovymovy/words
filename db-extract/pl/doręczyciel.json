                "senses": [
                    {
                        "sense_id": "bcf91dab-56ea-391a-841c-2e5962cfa7ee",
                        "entry_id": "1b26086b-b57b-34d3-91bb-29d4711bf855",
                        "glosses": [
                            "osoba doręczająca przesyłkę"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "84470e6d-d77b-4919-918e-da2e031180b2",
                                "sense_id": "bcf91dab-56ea-391a-841c-2e5962cfa7ee",
                                "text": "Ten doręczyciel jest godny zaufania."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "45494021-de50-3708-889e-ba149fe9ba73",
                        "entry_id": "1b26086b-b57b-34d3-91bb-29d4711bf855",
                        "glosses": [
                            "listonosz"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "fdc2b872-fec1-4952-af1a-1e4e2c36cdb4",
                                "sense_id": "45494021-de50-3708-889e-ba149fe9ba73",
                                "text": "Pracował na stanowisku doręczyciela, ale awansował i teraz pracuje w kadrach."
                            },
                            {
                                "example_id": "817fb314-cb5a-418e-8bc6-7eae09f1ee2e",
                                "sense_id": "45494021-de50-3708-889e-ba149fe9ba73",
                                "text": "Jest to dziwne, ale przesyłkę, którą doręczyciel ma prawo wydać tej osobie, którą zastanie w mieszkaniu, urzędniczka w okienku pocztowym może oddać jedynie osobie wskazanej na kopercie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b85d604-614f-400a-baf4-15686c526554",
                        "source_entry_id": "1b26086b-b57b-34d3-91bb-29d4711bf855",
                        "source_sense_id": "bcf91dab-56ea-391a-841c-2e5962cfa7ee",
                        "target_lang_word": "deliverer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deliverer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f853d487-3f22-3210-b292-586144fd05da",
                                        "entry_id": "990c16b2-47a8-30ab-b295-2241aa29338d",
                                        "glosses": [
                                            "One who delivers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eac8395a-39ba-37c6-94d6-1fc3ffdaaf6f",
                                        "entry_id": "990c16b2-47a8-30ab-b295-2241aa29338d",
                                        "glosses": [
                                            "One who brings deliverance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6f2567-36da-4c50-a32e-b3c3b3c12304",
                                                "sense_id": "eac8395a-39ba-37c6-94d6-1fc3ffdaaf6f",
                                                "text": "\"Thus, even thus, have I lived for full two thousand years [...] tormented by the memory of a crime, tortured day and night with an unfulfilled desire - without companionship, without comfort, without death, and led on only down my dreary road by the marsh lights of Hope, which, though they flickered here and there, and now glowed strong, and now were not, yet, as my skill told me, would one day lead unto my deliverer.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e59b8048-773d-459b-bd7c-d864d222fdc5",
                        "source_entry_id": "1b26086b-b57b-34d3-91bb-29d4711bf855",
                        "source_sense_id": "bcf91dab-56ea-391a-841c-2e5962cfa7ee",
                        "target_lang_word": "doručovatel",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doručovatel",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "560d4c7d-999a-3596-be38-4a2539de8f60",
                                        "entry_id": "6f274027-c9f0-3ff4-a218-1fa30678981b",
                                        "glosses": [
                                            "ten, kdo něco doručuje nebo doručil"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "266acd4f-e66f-4e4d-851e-7b4d00181a1a",
                        "source_entry_id": "1b26086b-b57b-34d3-91bb-29d4711bf855",
                        "source_sense_id": "bcf91dab-56ea-391a-841c-2e5962cfa7ee",
                        "target_lang_word": "податель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "податель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "380c2024-5d7f-3c75-947c-d609be6d3261",
                                        "entry_id": "91e44e0e-2ce6-3433-8461-a11f9d2cb5d8",
                                        "glosses": [
                                            "разг. тот, кто дает, жертвует, преподносит что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea589dd-4f3c-48b3-8f31-6cffc50f4d47",
                                                "sense_id": "380c2024-5d7f-3c75-947c-d609be6d3261",
                                                "text": "Они друг друга ненавидят и властию господина своего влекутся на казнь, к алтарю отца всех благ, подателя нежных чувствований и веселий, зиждителя истинного блаженства, творца вселенный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf86b02-3e8a-3bbf-b911-56862615b858",
                                        "entry_id": "91e44e0e-2ce6-3433-8461-a11f9d2cb5d8",
                                        "glosses": [
                                            "разг. тот, кто собственноручно предъявляет по назначению письмо, документ и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a727eb7-d3a8-4485-b6c4-709d3c2ca0c7",
                                                "sense_id": "bdf86b02-3e8a-3bbf-b911-56862615b858",
                                                "text": "Англичане сначала не поняли, в чём дело, но, увидев потом, что это был вексель на значительную сумму, адресованный к их банкиру в Севилье, с требованием немедленно заплатить по нём подателю его, они рассердились и вздумали угрозами запугать разбойника."
                                            },
                                            {
                                                "example_id": "c5479c14-ce27-4d79-baa5-5e6ef3888d2d",
                                                "sense_id": "bdf86b02-3e8a-3bbf-b911-56862615b858",
                                                "text": "Посылаю тебе подателя сей записки для принятия твоего чемодана и ожидаю вас для распития русского чаю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
