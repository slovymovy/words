                                "example_id": "878b3c7e-ef25-4185-bc8a-eed9d476acf7",
                                "sense_id": "544396f2-a601-32db-bfff-900fc70ec4f9",
                                "text": "„Ortsklassenabschläge werden danach im Bankgewerbe allgemein nicht mehr vorgenOmmen.“"
                            },
