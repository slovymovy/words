                ],
                "senses": [
                    {
                        "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                        "entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
                        "glosses": [
                            "das Verblüfftsein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0403c31-c752-48a0-b339-3d001ad4f91f",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "Die Verblüffung stand ihm ins Gesicht geschrieben."
                            },
                            {
                                "example_id": "6562d9b7-2fd2-477b-873e-984916cc22cd",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "Sie schien die Verblüffung ihres Angestellten nicht zu verstehen."
                            },
                            {
                                "example_id": "b973adfb-e8b1-40b6-b0c3-60953aa0a2e2",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "Weil er von der Feier bereits wusste, musste er seine Verblüffung vorheucheln."
                            },
                            {
                                "example_id": "158271fb-c364-4b4f-8d91-98b0a9a320f9",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "Zu ihrer großen Verblüffung stellte sie fest, dass zu diesem Begriff kein Eintrag im Wörterbuch existierte."
                            },
                            {
                                "example_id": "d71fdd03-8cda-4ea1-86d4-0d6479d9eff9",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "„Es fiel mir nicht schwer, ihr Freude zu machen durch eine große Verblüffung über die völlige Auffrischung ihres Haushalts.“"
                            },
                            {
                                "example_id": "ef427031-dff6-46b9-b440-55449c833fd7",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "„Milde Verblüffung steht in Lampes Gesicht, als er den Digestor gründlich mustert.“"
                            },
                            {
                                "example_id": "41160c7a-85d5-4001-b3d8-11653d15bed2",
                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                "text": "„Eine Minute verging in allgemeiner Verblüffung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ad140a2-4f71-4689-a5a0-401222f4adf8",
                        "source_entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
                        "source_sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                        "source_sense_description": "das Verblüfftsein",
                        "target_lang_word": "amazement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amazement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1a4ddb-5f60-3980-b5c6-054d00b9bb79",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "The condition of being amazed; a state of overwhelming wonder, as from surprise or sudden fear, horror, or admiration; astonishment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1aca18-e6fd-4cd8-af91-dd355900b4af",
                                                "sense_id": "1a1a4ddb-5f60-3980-b5c6-054d00b9bb79",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "A particular feeling of wonder, surprise, fear, or horror."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6ad3701-74f3-41f1-abbb-4234044da53d",
                                                "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                                "text": "Were believers thoroughly persuaded of what God meaneth, by these things, they would not be so liable to those frights and amazements which distract and disturb them."
                                            },
                                            {
                                                "example_id": "3baf89c6-b8d9-410e-8985-ab84bc6e9065",
                                                "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                                "text": "In the midst of ill rumours and amazements, his countenance changeth not."
                                            },
                                            {
                                                "example_id": "efcbe5e6-a8d5-404d-935c-d47c75ffe983",
                                                "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                                "text": "Certain points, crises, certain feelings, joys, griefs and amazements, when reviewed, must strike us as things wildered and whirling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "Something which amazes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2197393a-2afd-4a86-af34-39c710ea4bde",
                                                "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                                                "text": "So impossible did it seem that such an amazement of horse-flesh could ever be hers."
                                            },
                                            {
                                                "example_id": "42c2f54d-b899-4fb3-8d36-23da177274a0",
                                                "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                                                "text": "I believe the Urchin showed more enthusiasm over the stone and the robin than over any of the amazements that succeeded them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "580dcd62-5fba-3cbc-a91f-a0e0f5bf8013",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "Madness, frenzy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf73614e-e1d5-4d8e-8652-b879e3ec83cf",
                        "source_entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
