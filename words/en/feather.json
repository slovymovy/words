{
    "word_family": [
        "feathery",
        "featherless",
        "featherweight",
        "featherbed",
        "featherbrain"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c79298e2-8de0-3432-a681-0d0355ebf3f9",
                    "sense_definition": "A light, branching structure that grows on the skin of birds, used for flight, warmth, and protection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bird_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle dropped a large <w>feather</w> from its wing.",
                            "target_lang_translations": {
                                "ru": "Орел уронил большое <w>перо</w> из своего крыла."
                            }
                        },
                        {
                            "text": "She found a beautiful blue <w>feather</w> on the grass.",
                            "target_lang_translations": {
                                "ru": "Она нашла красивое синее <w>перо</w> на траве."
                            }
                        }
                    ],
                    "synonyms": [
                        "plume",
                        "quill",
                        "down"
                    ],
                    "common_phrases": [
                        "light as a feather",
                        "ruffle feathers",
                        "birds of a feather",
                        "in fine feather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое разветвленное образование на коже птиц, используемое для полета, сохранения тепла и защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перо",
                                "target_lang_sense_clarification": "птичье перо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "312ca9d5-392e-3190-8446-eed02752fcd5",
                    "sense_definition": "Kind, nature, or character; used almost exclusively in the phrase \"birds of a feather\".",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Those two are birds of a <w>feather</w> and always agree.",
                            "target_lang_translations": {
                                "ru": "Эти двое — <w>одного поля ягоды</w> и всегда соглашаются друг с другом."
                            }
                        },
                        {
                            "text": "I am not of that <w>feather</w> to abandon my friends.",
                            "target_lang_translations": {
                                "ru": "Я не из <w>тех</w>, кто бросает своих друзей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "birds of a feather"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "idiomatic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип, характер или порода; используется почти исключительно в идиоматических выражениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порода",
                                "target_lang_sense_clarification": "о типе характера или склада людей"
                            },
                            {
                                "target_lang_word": "пошиб",
                                "target_lang_sense_clarification": "о манере или сорте людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d2183e6-f75a-3f9b-85c6-50a5cf40b9de",
                    "sense_definition": "One of the fins or wings attached to the end of an arrow to help it fly straight.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "projectile_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archer glued a new <w>feather</w> onto the arrow shaft.",
                            "target_lang_translations": {
                                "ru": "Лучник приклеил новое <w>перо</w> на древко стрелы."
                            }
                        },
                        {
                            "text": "A damaged <w>feather</w> will cause the arrow to miss the target.",
                            "target_lang_translations": {
                                "ru": "Поврежденное <w>оперение</w> приведет к тому, что стрела пролетит мимо цели."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно из крылышек или лопастей на конце стрелы, помогающее ей лететь прямо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перо",
                                "target_lang_sense_clarification": "оперение стрелы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c1c480-dc8e-32cb-b2f0-f78adc6b5c0c",
                    "sense_definition": "Long hair growing on the lower legs of certain breeds of horses or dogs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Clydesdale horse is famous for the white <w>feather</w> on its legs.",
                            "target_lang_translations": {
                                "ru": "Лошадь породы клейдесдаль знаменита белыми <w>щетками</w> на ногах."
                            }
                        },
                        {
                            "text": "You must brush the <w>feather</w> carefully to keep it clean.",
                            "target_lang_translations": {
                                "ru": "Нужно тщательно расчесывать <w>шерсть</w> на ногах, чтобы она оставалась чистой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "equestrian/specialized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная шерсть на нижней части ног у некоторых пород лошадей или собак."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щетки",
                                "target_lang_sense_clarification": "шерсть на ногах лошадей или собак"
                            },
                            {
                                "target_lang_word": "очесы",
                                "target_lang_sense_clarification": "длинная шерсть на лапах животных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "deecae36-d9d5-3f22-990f-41beea290e63",
                    "sense_definition": "To touch, move, or brush against something very lightly and softly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "soft_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A soft breeze <w>feathered</w> her face as she walked.",
                            "target_lang_translations": {
                                "ru": "Легкий ветерок нежно <w>коснулся</w> ее лица во время прогулки."
                            }
                        },
                        {
                            "text": "She <w>feathered</w> her fingers through the soft fabric.",
                            "target_lang_translations": {
                                "ru": "Она едва <w>провела</w> пальцами по мягкой ткани."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень легко и нежно касаться, проводить или гладить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слегка касаться",
                                "target_lang_sense_clarification": "нежно проводить по поверхности"
                            },
                            {
                                "target_lang_word": "ласкать",
                                "target_lang_sense_clarification": "о легком дуновении ветра или прикосновении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7131b729-8d90-31fd-bca2-98c43e486b2b",
                    "sense_definition": "To cut or style hair so that it is layered and soft at the edges.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "styling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stylist <w>feathered</w> her hair to frame her face.",
                            "target_lang_translations": {
                                "ru": "Стилист подстриг ее волосы <w>перышками</w>, чтобы они обрамляли лицо."
                            }
                        },
                        {
                            "text": "He wants his hair <w>feathered</w> for a lighter look.",
                            "target_lang_translations": {
                                "ru": "Он хочет сделать <w>филировку</w> волос, чтобы прическа выглядела более легкой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feathered hair",
                        "feather the ends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стричь или укладывать волосы слоями, делая края мягкими и тонкими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстригать перышками",
                                "target_lang_sense_clarification": "о стрижке волос"
                            },
                            {
                                "target_lang_word": "филировать",
                                "target_lang_sense_clarification": "делать края волос более тонкими и легкими"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceeec7c7-afd2-37ba-93a4-06fd4944d1b1",
                    "sense_definition": "To rotate an oar or propeller blade so that its edge faces the direction of motion to reduce air or water resistance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanics_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rower learned to <w>feather</w> his oars to gain speed.",
                            "target_lang_translations": {
                                "ru": "Гребец научился <w>разворачивать</w> весла плашмя, чтобы увеличить скорость."
                            }
                        },
                        {
                            "text": "The pilot had to <w>feather</w> the engine propeller after it failed.",
                            "target_lang_translations": {
                                "ru": "Пилоту пришлось <w>зафлюгировать</w> воздушный винт двигателя после его отказа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feather the oars",
                        "feather the prop"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical/aviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворачивать лопасть весла или винта ребром к направлению движения для уменьшения сопротивления воздуха или воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флюгировать",
                                "target_lang_sense_clarification": "поворачивать лопасти винта самолета"
                            },
                            {
                                "target_lang_word": "разворачивать плашмя",
                                "target_lang_sense_clarification": "о веслах при гребле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79dbab1-ee5a-3f99-bf4d-0abbe576c679",
                    "sense_definition": "To soften or blend the edges of an image or digital selection into the background.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "digital_editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>feather</w> the edges of the photo to make it look natural.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>растушевать</w> края фотографии, чтобы она выглядела естественно."
                            }
                        },
                        {
                            "text": "The graphic designer <w>feathered</w> the selection to hide the cut.",
                            "target_lang_translations": {
                                "ru": "Графический дизайнер <w>размыл</w> края выделенной области, чтобы скрыть срез."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feather the edges",
                        "feather selection"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical/digital art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смягчать или размывать края изображения или цифрового выделения для плавного перехода в фон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растушевывать",
                                "target_lang_sense_clarification": "размывать края в графических редакторах"
                            },
                            {
                                "target_lang_word": "размывать",
                                "target_lang_sense_clarification": "делать границы выделения мягкими"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d561fb1-4461-3215-b960-6af8b7238d45",
                    "sense_definition": "To cover with feathers or to attach feathers to an arrow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "furnish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter <w>feathered</w> his arrows with care.",
                            "target_lang_translations": {
                                "ru": "Охотник бережно <w>оперил</w> свои стрелы."
                            }
                        },
                        {
                            "text": "The bird is fully <w>feathered</w> and ready to fly.",
                            "target_lang_translations": {
                                "ru": "Птица полностью <w>оперилась</w> и готова к полету."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tar and feather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать перьями или прикреплять перья к стреле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперять",
                                "target_lang_sense_clarification": "снабжать перьями стрелу или покрывать перьями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c3056b3e-f9c9-3594-b56b-958598215ae3",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Feather</w> arrived at the meeting early.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Фезер</w> пришел на встречу пораньше."
                            }
                        },
                        {
                            "text": "I spoke with a woman named Sarah <w>Feather</w>.",
                            "target_lang_translations": {
                                "ru": "Я поговорил с женщиной по имени Сара <w>Фезер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фезер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}