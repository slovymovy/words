                "senses": [
                    {
                        "sense_id": "6be9c2cf-53a7-325c-b21a-6b121f2baa4d",
                        "entry_id": "0f90773b-954c-3968-978b-1f5bc78389b4",
                        "glosses": [
                            "Eigenschaft, in ein Umfeld, einen Zusammenhang (Kontext) eingebunden zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb5f7609-9b63-4f8d-af00-5b37563b4f94",
                                "sense_id": "6be9c2cf-53a7-325c-b21a-6b121f2baa4d",
                                "text": "„Einsicht in diese Annahme erschließt sich, sofern man die Kontextualität des Handelns in den Augenschein nimmt, die Giddens ja stets betont: Soziales Handeln erfolgt unter kontextspezifischen strukturellen Bedingungen.“"
                            },
                            {
                                "example_id": "7987d1da-2c5c-47f8-b665-27461ec0f9ee",
                                "sense_id": "6be9c2cf-53a7-325c-b21a-6b121f2baa4d",
                                "text": "„Weder durch einen gesinnungsethischen Rigorismus noch durch materielle oder moralische Sanktionen können diese infrastrukturellen Kontextualitäten alltäglicher Handlungsräume einfach außer Kraft gesetzt werden“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
