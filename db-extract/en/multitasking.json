                                        "sense_id": "3c319b08-878f-35ff-851d-fbcd6d3a8d43",
                                        "entry_id": "53de0e3d-6312-30b3-9c49-ecbc647a1726",
                                        "glosses": [
                                            "das gleichzeitige Erledigen mehrerer Aufgaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2108628-599e-44d4-9971-a9f9757afdd5",
                                                "sense_id": "3c319b08-878f-35ff-851d-fbcd6d3a8d43",
                                                "text": "„Nein, für Multitasking ist weder die Intelligenz noch das Geschlecht verantwortlich, sondern die Kultur, in der man aufwächst.“"
                                            },
                                            {
                                                "example_id": "1378e338-de6a-4897-92f1-50c593572f5b",
                                                "sense_id": "3c319b08-878f-35ff-851d-fbcd6d3a8d43",
                                                "text": "„Ihr selbstloses Multitasking war hoch geschätzt.“"
                                            },
                                            {
                                                "example_id": "2f3b2e65-948e-442a-97ad-6ddb0049ee36",
                                                "sense_id": "3c319b08-878f-35ff-851d-fbcd6d3a8d43",
                                                "text": "„Da Männer aber nicht zum Multitasking geboren sind, stellen sie im Moment des Abcheckens alle anderen Tätigkeiten ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
