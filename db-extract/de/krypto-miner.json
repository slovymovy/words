                "senses": [
                    {
                        "sense_id": "93b55302-f36c-3413-8666-5ff12c533cd7",
                        "entry_id": "46c44b87-28e3-3eef-b0b1-5349228fd035",
                        "glosses": [
                            "Person, die Vermögenswerte in einer digitalen Währung schafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ca2b5e-d4fe-4157-97f1-83d3be43030e",
                                "sense_id": "93b55302-f36c-3413-8666-5ff12c533cd7",
                                "text": "„Geld war nicht der einzige Grund für den Krypto-Miner, denn akute Geldprobleme haben die Entwickler nicht.“"
                            },
                            {
                                "example_id": "921d6e63-ff58-4ddc-88ea-e7df9572257a",
                                "sense_id": "93b55302-f36c-3413-8666-5ff12c533cd7",
                                "text": "„Im Herbst ging die Anlage in Betrieb, seither fahren die Krypto-Miner ihre Kapazität kontinuierlich hoch und jagen Kilowattstunde um Kilowattstunde durch die Rechner, derzeit zwischen 62 000 und 68 000 Kilowattstunden pro Monat.“"
                            },
                            {
                                "example_id": "5dd61c13-ef96-4c3a-8963-a3386bc1e6c8",
                                "sense_id": "93b55302-f36c-3413-8666-5ff12c533cd7",
                                "text": "„Kasachstan wurde in diesem Jahr von Krypto-Minern überlaufen – diese sorgen für eine zunehmende Stromknappheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
