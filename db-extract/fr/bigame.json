                "senses": [
                    {
                        "sense_id": "eb11978c-75b3-3d58-9e55-b9528e2a2356",
                        "entry_id": "82831548-8573-347d-951c-67a3d4aac95e",
                        "glosses": [
                            "Qui est marié à deux personnes à la fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a76a1f4-851e-43bd-902a-1115ceb126fe",
                                "sense_id": "eb11978c-75b3-3d58-9e55-b9528e2a2356",
                                "text": "[…]: ils prétendent que Tyndare oublia Vénus dans un sacrifice qu'il offrit à tous les dieux , et qu'en punition de ce mépris, Vénus fit en sorte que les filles de ce prince fussent bigames , trigames, et désertrices de leurs maris."
                            },
                            {
                                "example_id": "7447b978-a903-4d71-ac28-b6df67ffecbf",
                                "sense_id": "eb11978c-75b3-3d58-9e55-b9528e2a2356",
                                "text": "Un veuf remarié, au fond, se sent toujours bigame."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b92afd0-9602-3a8b-983b-aa3e28a563ac",
                        "entry_id": "82831548-8573-347d-951c-67a3d4aac95e",
                        "glosses": [
                            "Relatif à la bigamie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d2629826-49d8-327f-a019-818d4766af7e",
                        "entry_id": "82831548-8573-347d-951c-67a3d4aac95e",
                        "glosses": [
                            "Qui ont été mariés deux fois."
                        ],
                        "tags": [
                            "Droit canon"
                        ],
                        "examples": [
                            {
                                "example_id": "36b75381-6fc6-4ebb-8e8c-3e9a865f5313",
                                "sense_id": "d2629826-49d8-327f-a019-818d4766af7e",
                                "text": "Les canonistes ont aussi qualifié de bigames ceux qui, ne s’étant mariés qu’une fois, avaient épousé une veuve."
                            }
                        ]
                    }
