    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7eeae21d-5ea3-3d5c-8630-57603b090e13",
                "word": "maceration",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f5e25f5f-c5cf-454c-9eac-79cc619055d6",
                        "entry_id": "7eeae21d-5ea3-3d5c-8630-57603b090e13",
                        "tags": [
                            "plural"
                        ],
                        "form": "macerations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "093a1f7f-d1a3-3b6c-8a8f-0a3948f5a32a",
                        "entry_id": "7eeae21d-5ea3-3d5c-8630-57603b090e13",
                        "glosses": [
                            "The act or process of macerating."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d1967db-246f-4a07-b093-6f0187a301c8",
                                "sense_id": "093a1f7f-d1a3-3b6c-8a8f-0a3948f5a32a",
                                "text": "[…] proposed that the small size of the teeth […] implied that most of the maceration of the food occurred after swallowing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea42e943-e3cc-4d6e-b23f-5b4651308afc",
                        "source_entry_id": "7eeae21d-5ea3-3d5c-8630-57603b090e13",
                        "source_sense_id": "093a1f7f-d1a3-3b6c-8a8f-0a3948f5a32a",
                        "source_sense_description": "act or process of macerating",
                        "target_lang_word": "macération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a8cb7cd-89a2-3cf6-89bf-ac211fdbc331",
                                        "entry_id": "57d03167-9229-3890-b46f-4282ba79c409",
                                        "glosses": [
                                            "Opération chimique qui consiste à laisser séjourner dans un liquide, à la température ambiante, une substance dont on veut extraire les principes solubles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03558bae-ed3e-4e18-80bc-7d415d174a6d",
                                                "sense_id": "0a8cb7cd-89a2-3cf6-89bf-ac211fdbc331",
                                                "text": "On préparera, par exemple, par macération au bain-marie, une huile benzoïnée en fondant dans 10 kilos d’huile végétale 0 k.500 à 1 kilo de benjoin ou d’acide benzoïque."
                                            },
                                            {
                                                "example_id": "cae96d78-8bff-424f-9022-b4b0796bb911",
                                                "sense_id": "0a8cb7cd-89a2-3cf6-89bf-ac211fdbc331",
                                                "text": "Cette plante est en macération."
                                            },
                                            {
                                                "example_id": "27f177ba-11ca-4924-a9b4-e58d73c163f9",
                                                "sense_id": "0a8cb7cd-89a2-3cf6-89bf-ac211fdbc331",
                                                "text": "Mettre en macération de l’écorce de quinquina."
                                            },
                                            {
                                                "example_id": "6ca12334-4240-403a-9a74-621bbaf1bd5d",
                                                "sense_id": "0a8cb7cd-89a2-3cf6-89bf-ac211fdbc331",
                                                "text": "Il gardait en mémoire ces imposants pressoirs en bois dans leur cuvage, la macération du moût, son odeur âcre et vinaigrée, la cave humide à laquelle on accédait par un large escalier en pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dac9466-ca5c-34e4-b5be-f9fdf84450b6",
                                        "entry_id": "57d03167-9229-3890-b46f-4282ba79c409",
                                        "glosses": [
                                            "Liquide obtenu par cette opération."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63db20f3-8658-4b26-add9-cf756c08d8cd",
                                                "sense_id": "0dac9466-ca5c-34e4-b5be-f9fdf84450b6",
                                                "text": "Le cryptocoque est cultivable à 38°, en ensemençant, avec du pus aseptique d’abcès, de la gélose au crottin de cheval recouverte d’une macération de ganglions du même animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                        "entry_id": "57d03167-9229-3890-b46f-4282ba79c409",
                                        "glosses": [
                                            "Mortification par jeûnes, disciplines et autres austérités."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6429e89c-5a0e-4ce7-894e-516003ef992f",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "La macération de la chair."
                                            },
                                            {
                                                "example_id": "64e72aa3-dd43-4908-8292-eb25825a189c",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "Ses grandes macérations ont abrégé ses jours."
                                            },
                                            {
                                                "example_id": "58be60b9-513b-44c7-abb0-036ccbac30c0",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "Cet ecclésiastique était un saint homme, de belle taille, admirablement bien proportionné, ayant de beaux yeux noirs, une tête à la Tibère, fatiguée par les jeûnes, blanche de macération, et journellement tenté comme le sont tous les solitaires."
                                            },
                                            {
                                                "example_id": "b9f7c86b-a967-48ee-8fd1-f3cc782c5737",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "Pourtant mes scrupules de prêtre me tourmentaient plus que jamais, et je ne savais quelle macération nouvelle inventer pour mater et mortifier ma chair."
                                            },
                                            {
                                                "example_id": "2031cbf2-e501-4a54-b444-5b3473ed9dc1",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "Il monta sur les deux genoux toutes les collines ayant une chapelle à leur sommet. Mais l’impitoyable pensée obscurcissait la splendeur des tabernacles, le torturait à travers les macérations de la pénitence."
                                            },
                                            {
                                                "example_id": "cc5636b4-f69d-4525-8577-0621d733ee5b",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "Par-delà toute macération, toute tristesse, j’imaginais, je pressentais une autre joie pure, mystique, séraphique et dont mon âme déjà s’assoiffait."
                                            },
                                            {
                                                "example_id": "344f7f87-9b15-4bb5-a5f9-1cea924f223c",
                                                "sense_id": "eed5c0fa-9df4-332b-8a5b-512dc7842016",
                                                "text": "Puis, de temps en temps, elle disparaît pendant des mois ; on raconte qu’elle se retire dans un couvent, pour vivre dans la pénitence et les macérations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
