                ],
                "senses": [
                    {
                        "sense_id": "ed8735fd-6168-3f75-9435-c727114e2c9a",
                        "entry_id": "d17e83ad-9a6a-3974-b502-2751171c1767",
                        "glosses": [
                            "Consonne nasale, c’est-à-dire dont le son passe par les fosses nasales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0425bef6-0148-4079-9ea3-7da88dce610b",
                                "sense_id": "ed8735fd-6168-3f75-9435-c727114e2c9a",
                                "text": "Le consonantisme français contient, en particulier, la nasale palatale, la fricative ou vibrante uvulaire, l'articulation dentale des [t d n]. L'anglais a des fricatives dentales, la nasale vélaire, les affriquées, les [p t k] aspirés sous accent, l'assibilation des [s z t d]."
                            }
                        ]
                    },
                    {
                        "sense_id": "56fa1627-1bf5-3040-aa6f-94f951a88f1c",
                        "entry_id": "d17e83ad-9a6a-3974-b502-2751171c1767",
                        "glosses": [
                            "Voyelle nasale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd59b40a-02cb-46d0-9adc-90775b60ae79",
                                "sense_id": "56fa1627-1bf5-3040-aa6f-94f951a88f1c",
                                "text": "Lorsqu'il parle le français, l’Hautevillois distingue sans difficulté la nasale un de in, on ou an, bien qu'il ne connaisse en patois que les trois phonèmes nasals ẽ, õ et ã."
                            },
                            {
                                "example_id": "8ffd2f6b-cfdd-4ea1-95c9-f5792c0fb650",
                                "sense_id": "56fa1627-1bf5-3040-aa6f-94f951a88f1c",
                                "text": "an, in, on, et un sont des nasales transcrites en phonétique par [ɑ̃], [ɛ̃], [ɔ̃], et [œ̃]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea3d6d42-3543-4ffb-9980-16ea1e025e54",
                        "source_entry_id": "d17e83ad-9a6a-3974-b502-2751171c1767",
                        "target_lang_word": "Nasal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nasal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e9a3be4-1660-390c-9a41-4fc35faf7ea9",
                                        "entry_id": "6f44a665-0f94-3b34-81a5-40d050c95523",
                                        "glosses": [
                                            "nasaler Konsonant oder Vokal, bei dem der Luftstrom ganz oder teilweise über den Nasenraum entweicht"
                                        ],
                                        "tags": [
                                            "speziell Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c0e37a4-18c8-4f21-87ea-d803858a8128",
                                                "sense_id": "4e9a3be4-1660-390c-9a41-4fc35faf7ea9",
                                                "text": "Im Deutschen sind alle Nasale Nasalkonsonanten; Nasalvokale kommen nur in Fremdwörtern vor (z.B.: \"Balkon\" [balkɔ̃]). Die deutschen Nasale sind: [m], [n] und [ŋ] (wie in \"sang\" [zaŋ])."
                                            },
                                            {
                                                "example_id": "9474a93c-56fa-4dd0-818f-2a07fc1d4efd",
                                                "sense_id": "4e9a3be4-1660-390c-9a41-4fc35faf7ea9",
                                                "text": "„Schließlich können die Nasale und Liquiden die Rolle eines Vokals übernehmen und silben tragen; man bezeichnet sie in dieser Funktion durch den indogermanischen Ablaut bestimmten Funktion als nasales beziehungsweise liquidae sonantes oder kurz als Sonanten (geschrieben m̩, n̩, r̩, l̩).“"
                                            },
                                            {
                                                "example_id": "53f721a2-0976-4def-8b78-f45140f2c6b3",
                                                "sense_id": "4e9a3be4-1660-390c-9a41-4fc35faf7ea9",
                                                "text": "„Von den grundsprachlich-indogermanischen Vorgängen ist die Tatsache hervorzuheben, daß auslautende Langdiphthonge, wozu auch Verbindungen mit Liquida oder Nasal an zweiter Stelle zu rechnen sind, ihren zweiten Bestandteil verlieren konnten.“"
                                            },
                                            {
                                                "example_id": "65c54570-25f3-43ce-baef-3cd9e47f1947",
                                                "sense_id": "4e9a3be4-1660-390c-9a41-4fc35faf7ea9",
                                                "text": "„Die Nasale sind eine Lautgruppe, bei der die untersuchten Kinder den relativ geringsten Teil an Fehlrealisierungen produzieren.“"
                                            },
                                            {
                                                "example_id": "010cd865-80e5-419a-b807-463201d3d8c4",
                                                "sense_id": "4e9a3be4-1660-390c-9a41-4fc35faf7ea9",
                                                "text": "„Sie bietet dem Leser einen Einblick in den Erwerb einzelner deutscher Plosive, Frikative, Laterale, Glides, Nasale und Konsonantenverbindungen, die zum Teil über den Rahmen dieser Arbeit hinausgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
