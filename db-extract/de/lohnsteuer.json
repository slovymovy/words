                ],
                "senses": [
                    {
                        "sense_id": "afe56937-c85b-3f96-9a2a-09820f8b0a50",
                        "entry_id": "f67fecbf-ef44-3fdd-9a31-ed635ab69e79",
                        "glosses": [
                            "eine Erhebungsform von Steuer auf den zu zahlenden Monatslohn; Lohnabzug vom Bruttolohn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "845bb0bb-0239-4717-8bc9-b51e454a97fa",
                                "sense_id": "afe56937-c85b-3f96-9a2a-09820f8b0a50",
                                "text": "Die Lohnsteuer wird auf Einkünfte aus nichtselbständiger Arbeit (§ 19 EStG) erhoben und direkt vom vereinbarten Bruttolohn durch den Arbeitgeber berechnet und an das Finanzamt abgeführt."
                            },
                            {
                                "example_id": "b218b68d-a2f9-4e1d-b97c-e116b4953e32",
                                "sense_id": "afe56937-c85b-3f96-9a2a-09820f8b0a50",
                                "text": "Die zu viel gezahlte Lohnsteuer kann im Rahmen einer Einkommensteuererklärung zurückgefordert werden."
                            },
                            {
                                "example_id": "ba10d215-3dbb-4889-9fa9-245736289d41",
                                "sense_id": "afe56937-c85b-3f96-9a2a-09820f8b0a50",
                                "text": "Unterjährig lässt sich die Lohnsteuer mindern, wenn der Arbeitnehmer beim Finanzamt beantragt, einen Freibetrag in seine Lohnsteuerabzugsmerkmale einzutragen."
                            },
                            {
                                "example_id": "b43e8a59-94e3-49c6-842f-975ae1683a5b",
                                "sense_id": "afe56937-c85b-3f96-9a2a-09820f8b0a50",
                                "text": "Die Lohnsteuer ist nur eine Steuerart von vielen."
                            },
                            {
                                "example_id": "956de0b0-cc34-4b49-b27f-faa7299045cf",
                                "sense_id": "afe56937-c85b-3f96-9a2a-09820f8b0a50",
                                "text": "„Die Lohnsteuer, die er zahlt, wurde kapitalistisch erwirtschaftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
