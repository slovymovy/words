                "senses": [
                    {
                        "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                        "entry_id": "e272e19d-1e70-30d4-a573-44fc2a0206b4",
                        "glosses": [
                            "die Eigenschaft von Abbildungen und Funktionen, in beiden Richtungen eindeutig zu sein"
                        ],
                        "tags": [
                            "Mengenlehre"
                        ],
                        "examples": [
                            {
                                "example_id": "0c3b3957-56a9-478a-aff4-ef86e10781a0",
                                "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                                "text": "„Wir führen die Einzelheiten nicht aus und nehmen an, die Bijektivität von h sei bewiesen.“"
                            },
                            {
                                "example_id": "54a84a32-5677-401f-aaa6-ed487bb2c3b5",
                                "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                                "text": "„Anhand des nebenstehenden Graphen der Funktion Φ kann man sich auch geometrisch sehr schnell von deren Bijektivität überzeugen.“"
                            },
                            {
                                "example_id": "55612793-ab0a-47e8-8eb0-c69a01cd8e27",
                                "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                                "text": "„Eine zentrale Frage bei jeder Transformation eines Gebietsintegrals vermittels einer Variablensubstitution betrifft die Regularität oder Bijektivität der Abbildung.“"
                            },
                            {
                                "example_id": "ed0287f2-cd60-4e83-8e5d-fea75821e185",
                                "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                                "text": "„Die Bijektivität bedeutet also, dass es zu jedem y ∈ Q genau ein x ∈ P mit (A.4) gibt.“"
                            },
                            {
                                "example_id": "f9d6780e-75a6-4c0b-9008-102eeca905f9",
                                "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                                "text": "„Bijektivität bedeutet: Jeder einzelnen symbolischen Adresse wird exakt ein konkret benannter physischer Speicher zugeordnet.“"
                            },
                            {
                                "example_id": "9e4685f9-6b30-4468-b27e-55082cbecd00",
                                "sense_id": "15d1f8fd-17c7-3b7a-ac31-50b290025177",
                                "text": "„Soll ich jetzt einen Vortrag über Bijektivität halten oder den Safe öffnen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
