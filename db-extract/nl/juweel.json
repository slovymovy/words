                                                "example_id": "54a025bf-ade8-4c5a-9bf6-f7cc3e11257b",
                                                "sense_id": "384f2032-1126-30de-a3eb-a4b526e4dcdb",
                                                "text": "Iachimo: 'Tis plate of rare device, and jewels / Of rich and exquisite form, their values great."
                                            }
