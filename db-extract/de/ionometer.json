                "senses": [
                    {
                        "sense_id": "25c4b9e5-b7f0-3bba-9513-e7dd4a2d1344",
                        "entry_id": "febb2838-5efb-3437-b75e-cea719767bff",
                        "glosses": [
                            "Ionen-Messgerät zur Bestimmung der Ionenkonzentration in der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a5340e-ffc5-46d5-b60b-c4dfeaa196c5",
                                "sense_id": "25c4b9e5-b7f0-3bba-9513-e7dd4a2d1344",
                                "text": "Mit einem Ionometer lassen sich positiv und negativ geladen Ionenkonzentrationen in der Luft bestimmen."
                            },
                            {
                                "example_id": "4e237d5b-a651-447a-9363-7a0ca7af5143",
                                "sense_id": "25c4b9e5-b7f0-3bba-9513-e7dd4a2d1344",
                                "text": "„Im Vergleich zur Außenluft ließ sich in der Stollenluft ein höherer Ionisationsgrad, gemessen mit Ionometer, nachweisen.“"
                            },
                            {
                                "example_id": "7ddbf500-ff99-405d-8bcb-918853e23ef5",
                                "sense_id": "25c4b9e5-b7f0-3bba-9513-e7dd4a2d1344",
                                "text": "„Luftionen stellen aufgrund Ihrer geringen elektrischen Ladung hohe technische Anforderungen an das Ionometer, dem Messgerät zur Messung der Ionenkonzentration.“"
                            },
                            {
                                "example_id": "2998fe75-0ccb-4cf4-aa66-bc2fd717020a",
                                "sense_id": "25c4b9e5-b7f0-3bba-9513-e7dd4a2d1344",
                                "text": "„Ionometer sind für die Detektion von Radon-Auffälligkeiten ebenfalls geeignet: Hohe Kleinionenzahlen in der Raumluft korrelieren oft mit radioaktiver Strahlung und vor allem mit der Radonkonzentration und der Anzahl der Zerfallsnuklide.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
