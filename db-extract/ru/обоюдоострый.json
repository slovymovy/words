                    },
                    {
                        "translation_id": "c555c334-d9f4-42c5-a44c-f861b4e0703b",
                        "source_entry_id": "47781bb1-9b21-385a-9608-dd6a08b5ca7f",
                        "target_lang_word": "a due tagli",
