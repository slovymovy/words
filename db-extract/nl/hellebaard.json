                    {
                        "translation_id": "691aea4b-0d4a-41a2-9e26-92c89ce686d9",
                        "source_entry_id": "a53695f9-8a82-321e-b915-54a00ea8798a",
                        "source_sense_id": "b54021b0-f051-3aed-8c25-889ff9301b83",
