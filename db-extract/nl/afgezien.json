                "senses": [
                    {
                        "sense_id": "34c7c4fa-5a08-3b5c-9688-0763c166079f",
                        "entry_id": "51b53dad-5a78-370c-aaae-8d18b1c59c37",
                        "glosses": [
                            "buiten beschouwing latend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "495761b5-eaf7-481f-ad39-9d2dbbd085a7",
                                "sense_id": "34c7c4fa-5a08-3b5c-9688-0763c166079f",
                                "text": "Afgezien van een enkele vechtpartij deden zich nergens grote problemen voor."
                            },
                            {
                                "example_id": "dedea088-ffea-4960-9e6e-5f9ad6740f1a",
                                "sense_id": "34c7c4fa-5a08-3b5c-9688-0763c166079f",
                                "text": "Afgezien van de auto-ongelukken is de eerste vakantiedag goed verlopen."
                            },
                            {
                                "example_id": "8371dc21-bea0-4a73-a5b1-6b1862c08037",
                                "sense_id": "34c7c4fa-5a08-3b5c-9688-0763c166079f",
                                "text": "Maar nu, een week later, heb ik, afgezien van wat bedankjes op mijn mail, nog geen enkele serieuze reactie ontvangen. Mijn telefoon is zo stil dat ik hem van zeshoog uit mijn raam zou willen smijten. Het enige appje dat ik krijg is van mijn acteursclubje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8f7861e-f658-4815-8a60-735292b27994",
                        "source_entry_id": "51b53dad-5a78-370c-aaae-8d18b1c59c37",
                        "source_sense_id": "34c7c4fa-5a08-3b5c-9688-0763c166079f",
