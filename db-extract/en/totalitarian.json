                        "source_entry_id": "02592f38-2e22-3a51-bc15-92b52bbf89b3",
                        "source_sense_id": "15747750-39d3-35bc-9835-6c1d63de8da0",
                        "source_sense_description": "related to the system of government",
                        "target_lang_word": "totalitair",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalitair",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d842758d-3f5e-33d1-a18f-48e33525e490",
                                        "entry_id": "b5ff1731-4200-3461-94a3-dead351a439f",
                                        "glosses": [
                                            "waarbij alles ondergeschikt is aan de staat, die meestal als dictatuur is ingericht, en de politiek de gehele samenleving tot in de diepste geledingen doordringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6704a29-566a-4e38-9aae-e8ac7c25fa44",
                                                "sense_id": "d842758d-3f5e-33d1-a18f-48e33525e490",
                                                "text": "Toen Franco in 1975 op 82-jarige leeftijd overleed, kwam een einde aan het laatste niet-communistische totalitair regime in Europa."
                                            },
                                            {
                                                "example_id": "f1bf1a8d-77e5-4fa4-b8f2-2b85d2af8cae",
                                                "sense_id": "d842758d-3f5e-33d1-a18f-48e33525e490",
                                                "text": "“Rusland is totalitair, Amerika is het aan het worden. Mensen hebben zin in fascisme, opnieuw beginnen. Fascisme is lente, alleen volgt daar niet de zomer op, maar de winter.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28818c5a-33bb-4c9a-afcf-e55a89eec09e",
                        "source_entry_id": "02592f38-2e22-3a51-bc15-92b52bbf89b3",
