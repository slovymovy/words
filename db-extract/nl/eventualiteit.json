                        "glosses": [
                            "iets dat onwaarschijnlijk is maar mogelijk toch zou kunnen gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78348c8b-f22e-4a9b-82c3-68b8cde29d4f",
                                "sense_id": "138bc139-00dc-30a2-bbf3-e3b3ee73c5e2",
                                "text": "Volgens Tuomioja bereiden Finse ambtenaren zich voor op de ontbinding van de gemeenschappelijke munt 'voor elke eventualiteit'."
                            },
                            {
                                "example_id": "ac65e0e4-5131-4709-b47f-1b06a648fb5b",
                                "sense_id": "138bc139-00dc-30a2-bbf3-e3b3ee73c5e2",
                                "text": "KPN heeft geen enkele indicatie dat het doelwit van cyberspionage is geweest, maar toch neemt het bedrijf zijn netwerk nog eens onder de loep. 'We willen iedere eventualiteit kunnen uitsluiten', zei een woordvoerder. De 'extra check' is maandag begonnen. Het is niet bekend hoe lang die duurt en wanneer de uitkomsten bekend worden."
                            },
                            {
                                "example_id": "a6663d69-5beb-4764-8c96-8d3e5d4dc0eb",
                                "sense_id": "138bc139-00dc-30a2-bbf3-e3b3ee73c5e2",
                                "text": ",,We willen dit niet, maar premier May vindt het goed beleid om op alle scenario’s voorbereid te zijn”, aldus vanmiddag de Britse toponderhandelaar David Davis. Europees toponderhandelaar Barnier: ,,Geen deal is een slechte deal, maar we zijn klaar voor elke eventualiteit.”"
                            }
                        ]
                    }
