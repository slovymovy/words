                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional agricultural usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец индейки; индюк (диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индюк",
                                "target_lang_sense_clarification": "самец индейки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4321f3d-5986-307f-ac1f-3b7be1734628",
                    "sense_definition": "A boisterous, romping girl; a tomboy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was considered a wild <w>stag</w> who preferred climbing trees to needlework.",
                            "target_lang_translations": {
                                "ru": "Её считали диким <w>сорванцом</w>, предпочитавшим рукоделию лазание по деревьям."
                            }
