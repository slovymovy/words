                                    {
                                        "sense_id": "be249c5e-9f42-39f3-8d75-7a75c0210c88",
                                        "entry_id": "99bdaacd-7bc3-3f5c-a311-f246e6ad91a0",
                                        "glosses": [
                                            "Variété allotropique de fer présente dans des alliages ferreux et contenant une infime partie de carbone."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba927a88-66ae-4b2d-99ab-3f41e83f649a",
                                                "sense_id": "be249c5e-9f42-39f3-8d75-7a75c0210c88",
                                                "text": "Depuis le début des années 2000, les chercheurs étudient cet effet au sein d’un oxyde, la ferrite de bismuth BiFeO₃, un matériau antiferromagnétique et ferroélectrique à température ambiante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
