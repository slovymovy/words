                    {
                        "sense_id": "aaa107c2-f359-3859-a30c-b37afdb5079b",
                        "entry_id": "70272502-aa83-37cd-80b1-fba26fc76c2b",
                        "glosses": [
                            "Cri de la cigogne, de la grue, de la cigale, du grillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a1cdef3-52e5-427d-b528-eee370a837fc",
                                "sense_id": "aaa107c2-f359-3859-a30c-b37afdb5079b",
                                "text": "Les bruits de la brousse —craquements, caquètements, craquètements, cliquètements, coassements, croassements, criaillements, couinements, chuchotements— forment un langage secret."
                            },
                            {
                                "example_id": "43354040-6d18-4ab7-a002-b16979677f2e",
                                "sense_id": "aaa107c2-f359-3859-a30c-b37afdb5079b",
                                "text": "La forêt alentour bruit de multiples sons sur fond du sourd bourdonnement des ruches ; frémissements des feuillages, froissements des herbes, craquètements ténus d’insectes, clapotis d’un ruisseau, craquements de brindilles sèches, petits cris perçants ou appels flûtés lancés par des oiseaux, chuchotis et sifflements du vent, et par instants, des aboiements de chiens et des échos de voix humaines dans le lointain."
                            }
                        ]
                    },
