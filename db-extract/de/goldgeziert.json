                ],
                "senses": [
                    {
                        "sense_id": "2bd1503b-da3b-3724-8db8-36a4f5ec395b",
                        "entry_id": "fea0cfea-4260-330f-9b77-33353fd2a701",
                        "glosses": [
                            "(zur Verschönerung) mit Gold, Goldschmuck oder etwas Goldfarbenem versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540faa72-c7f5-4282-8fb4-073390c2f535",
                                "sense_id": "2bd1503b-da3b-3724-8db8-36a4f5ec395b",
                                "text": "„Emir Abd el Kader zog seinen goldgezierten Mekkasäbel und schwur, er werde damit Djemal Pascha den Kopf abschlagen.“"
                            },
                            {
                                "example_id": "d21d86e6-d58b-4d0d-bb05-317085d581a6",
                                "sense_id": "2bd1503b-da3b-3724-8db8-36a4f5ec395b",
                                "text": "„Dieſer reiche Mann, welcher Baron von Weißborn hieß und von dem lieben Gott mit zwei geſunden Füßen beſchenkt worden war, ließ ſich gewöhnlich von 16 Pferdebeinen und in einer goldgezierten Kutſche fortbewegen.“"
                            },
                            {
                                "example_id": "559ecc87-2b72-4787-8fcd-2e211fd339ba",
                                "sense_id": "2bd1503b-da3b-3724-8db8-36a4f5ec395b",
                                "text": "Vor dem purpurnen, scharlachbespannten, goldgezierten Hochsitz knien sechs schwarze Träger nieder und aus der purpurnen, scharlachbespannten, goldgezierten Sänfte steigt mühsam, von hohen Herren gestützt, stöhnend und seufzend der König; Südlands Wein und Südlands Weiber machten seine Glieder lahm."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
