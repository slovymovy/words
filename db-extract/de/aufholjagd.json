                                        "sense_id": "d7da2ee3-516e-35a2-ba68-cbd2eee8da4f",
                                        "entry_id": "9bef7cd9-cecc-324a-bbdd-2af48b9ac2ca",
                                        "glosses": [
                                            "An act of catching up or attempting to catch up."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633269e0-a5f8-4488-86c3-8a457e4f2eb8",
                                                "sense_id": "d7da2ee3-516e-35a2-ba68-cbd2eee8da4f",
                                                "text": "Rapid expansion of Britain's transport network during the 'railway mania' of the 19th century meant that the testing of engineering principles often played catch-up to the ambitions of progress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1ef03c-47f0-3a05-9ac7-e628e9198cfb",
                                        "entry_id": "9bef7cd9-cecc-324a-bbdd-2af48b9ac2ca",
                                        "glosses": [
                                            "An amount, a thing, or a receipt or repetition of information that enables one to catch up."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ed10ac-c844-4d81-812d-5725d7bc7124",
                                                "sense_id": "ff1ef03c-47f0-3a05-9ac7-e628e9198cfb",
                                                "text": "Catch-up is also available on the TV set using Digitial^([sic]) TV Services: BT Vision offers BBC, ITV, 40D and Demand 5 via the TV Replay service."
                                            },
                                            {
                                                "example_id": "db133115-6560-4d79-a424-e25513f74918",
                                                "sense_id": "ff1ef03c-47f0-3a05-9ac7-e628e9198cfb",
                                                "text": "They have shown their staying power before and it would be daft to write them off but it must be disturbing, nonetheless, for Mourinho that his team are five points behind already and locked in a game of catch-up against the side that has just subjected them to a rare, old-fashioned beating."
                                            }
                                        ]
                                    }
                                ]
                            }
