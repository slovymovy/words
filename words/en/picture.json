    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e0e0f1c-d889-3f86-96bd-b67b3ff720b2",
                    "sense_definition": "A photograph taken with a camera.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used my new smartphone to take a <w>picture</w> of the beautiful sunset.",
                            "target_lang_translations": {
                                "ru": "Я использовал свой новый смартфон, чтобы сделать <w>снимок</w> прекрасного заката."
                            }
                        },
                        {
                            "text": "Could you please take a <w>picture</w> of us standing in front of the monument?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы, пожалуйста, <w>сфотографировать</w> нас на фоне памятника?"
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "take a picture",
                        "digital picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фотография, сделанная с помощью камеры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотография",
                                "target_lang_sense_clarification": "снимок"
                            },
                            {
                                "target_lang_word": "снимок",
                                "target_lang_sense_clarification": "фотографический"
                            },
                            {
                                "target_lang_word": "фото",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c530bfd4-1f49-3475-98f3-8c0c184cc708",
                    "sense_definition": "A visual representation of something, such as a person or landscape, created by drawing, painting, or printing.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child drew a colorful <w>picture</w> of his family and hung it on the fridge.",
                            "target_lang_translations": {
                                "ru": "Ребенок нарисовал яркий <w>рисунок</w> своей семьи и повесил его на холодильник."
                            }
                        },
                        {
                            "text": "The book includes a <w>picture</w> of a Greek warrior to help explain the history.",
                            "target_lang_translations": {
                                "ru": "В книге есть <w>изображение</w> греческого воина, помогающее объяснить историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "draw a picture",
                        "paint a picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуальное изображение чего-либо (человека, пейзажа), созданное путем рисования, живописи или печати."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "произведение живописи"
                            },
                            {
                                "target_lang_word": "рисунок",
                                "target_lang_sense_clarification": "графическое изображение"
                            },
                            {
                                "target_lang_word": "изображение",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "картинка",
                                "target_lang_sense_clarification": "иллюстрация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09bb187f-5fe5-348b-9058-4b1595446654",
                    "sense_definition": "The cinema or a movie theater, especially as a form of entertainment.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to the <w>pictures</w> on Saturday night to see the new comedy.",
                            "target_lang_translations": {
                                "ru": "Мы решили пойти в <w>кино</w> в субботу вечером, чтобы посмотреть новую комедию."
                            }
                        },
                        {
                            "text": "Is there anything good playing at the <w>pictures</w> this weekend?",
                            "target_lang_translations": {
                                "ru": "Идет ли что-нибудь стоящее в <w>кинотеатрах</w> в эти выходные?"
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "go to the pictures"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кинотеатр или киносеанс как вид развлечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "кинотеатр"
                            },
                            {
                                "target_lang_word": "кинотеатр",
                                "target_lang_sense_clarification": "место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0f8221-3bf8-3e81-9e0c-93e6633969cb",
                    "sense_definition": "A motion picture or movie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That classic film is my all-time favorite <w>picture</w> because of its great acting.",
                            "target_lang_translations": {
                                "ru": "Этот классический фильм — моя самая любимая <w>картина</w> из-за великолепной актерской игры."
                            }
                        },
                        {
                            "text": "The director is currently filming his next big <w>picture</w> in the jungle.",
                            "target_lang_translations": {
                                "ru": "Режиссер сейчас снимает свой следующий большой <w>фильм</w> в джунглях."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "motion picture",
                        "moving picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кинофильм или художественный фильм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фильм",
                                "target_lang_sense_clarification": "кинопроизведение"
                            },
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "кинокартина"
                            },
                            {
                                "target_lang_word": "кинолента",
                                "target_lang_sense_clarification": "фильм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca384c74-da35-3578-9284-a8a11a354bac",
                    "sense_definition": "A mental image or representation formed in the imagination.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a clear <w>picture</w> of my future home in my mind before I even saw it.",
                            "target_lang_translations": {
                                "ru": "У меня в голове был четкий <w>образ</w> моего будущего дома еще до того, как я его увидел."
                            }
                        },
                        {
                            "text": "His description helped me form a <w>picture</w> of the events that took place.",
                            "target_lang_translations": {
                                "ru": "Его описание помогло мне составить <w>представление</w> о произошедших событиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "mental picture",
                        "conjure up a picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мысленный образ или представление, сформированное в воображении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образ",
                                "target_lang_sense_clarification": "внутреннее видение"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "мысленное"
                            },
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "в воображении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d4d87e7-7006-321d-9e3f-d85f71a23cc0",
                    "sense_definition": "The overall situation or set of circumstances regarding a particular matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To understand the economy, you have to look at the big <w>picture</w> rather than small details.",
                            "target_lang_translations": {
                                "ru": "Чтобы понять экономику, нужно смотреть на общую <w>картину</w>, а не на мелкие детали."
                            }
                        },
                        {
                            "text": "The employment <w>picture</w> for young graduates is starting to improve this year.",
                            "target_lang_translations": {
                                "ru": "В этом году <w>ситуация</w> с трудоустройством молодых выпускников начинает улучшаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "big picture",
                        "overall picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая ситуация или совокупность обстоятельств, касающихся конкретного вопроса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "положение дел"
                            },
                            {
                                "target_lang_word": "ситуация",
                                "target_lang_sense_clarification": "общая обстановка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79cbfb31-d0c7-36dc-aad0-1d6282f38677",
                    "sense_definition": "A perfect example or specimen of a specific quality or state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "example",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After her vacation in the mountains, she looked like the very <w>picture</w> of health.",
                            "target_lang_translations": {
                                "ru": "После отпуска в горах она выглядела как само <w>воплощение</w> здоровья."
                            }
                        },
                        {
                            "text": "The little cottage by the lake was the <w>picture</w> of peace and quiet.",
                            "target_lang_translations": {
                                "ru": "Маленький коттедж у озера был <w>образцом</w> тишины и покоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "picture of health",
                        "picture of misery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идеальный пример или образец определенного качества или состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воплощение",
                                "target_lang_sense_clarification": "идеальный пример"
                            },
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "пример"
                            },
                            {
                                "target_lang_word": "олицетворение",
                                "target_lang_sense_clarification": "качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f7c0ca5-373c-3332-b5e7-b13a5e551cc5",
                    "sense_definition": "An exceptionally attractive or beautiful sight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden is a real <w>picture</w> when all the roses are in full bloom.",
                            "target_lang_translations": {
                                "ru": "Сад — это просто <w>загляденье</w>, когда все розы в полном цвету."
                            }
                        },
                        {
                            "text": "She looked a total <w>picture</w> in her elegant white wedding dress.",
                            "target_lang_translations": {
                                "ru": "В своем элегантном белом свадебном платье она выглядела как <w>картинка</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "look a picture",
                        "real picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно привлекательное или красивое зрелище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картинка",
                                "target_lang_sense_clarification": "очень красивый вид"
                            },
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "прекрасное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d149e94e-12f9-3979-b531-d7e15443aa63",
                    "sense_definition": "A format string used in the COBOL programming language to define data types.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer defined the variable using a <w>picture</w> string to ensure correct formatting.",
                            "target_lang_translations": {
                                "ru": "Программист определил переменную, используя <w>строку формата</w>, чтобы обеспечить правильное форматирование."
                            }
                        },
                        {
                            "text": "In COBOL, the <w>picture</w> clause determines how numeric data is displayed on the screen.",
                            "target_lang_translations": {
                                "ru": "В COBOL <w>оператор picture</w> определяет, как числовые данные отображаются на экране."
                            }
                        }
                    ],
                    "synonyms": [
                        "image",
                        "picture"
                    ],
                    "common_phrases": [
                        "picture string",
                        "picture clause"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical computing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строка формата, используемая в языке программирования COBOL для определения типов данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблон",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "формата"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91ce4147-17f8-3844-957e-64d9e76a6eb4",
                    "sense_definition": "To imagine or envision something in one's mind.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>picture</w> yourself living in a different country ten years from now?",
                            "target_lang_translations": {
                                "ru": "Можешь ли ты <w>представить</w> себя живущим в другой стране через десять лет?"
                            }
                        },
                        {
                            "text": "It is hard to <w>picture</w> this busy street as it was a hundred years ago.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>вообразить</w> эту оживленную улицу такой, какой она была сто лет назад."
                            }
                        }
                    ],
                    "common_phrases": [
                        "picture yourself",
                        "hard to picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять или воображать что-либо в уме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "воображать"
                            },
                            {
                                "target_lang_word": "воображать",
                                "target_lang_sense_clarification": "мысленно видеть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc51a846-e589-3da1-a5b6-f5be237f6b7b",
                    "sense_definition": "To represent or show something in a drawing, painting, or photograph.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>pictured</w> the historical event with great attention to detail.",
                            "target_lang_translations": {
                                "ru": "Художник <w>изобразил</w> историческое событие с большим вниманием к деталям."
                            }
                        },
                        {
                            "text": "The brochure <w>pictures</w> the hotel as being right on the sandy beach.",
                            "target_lang_translations": {
                                "ru": "В брошюре отель <w>показан</w> расположенным прямо на песчаном пляже."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pictured here",
                        "vividly pictured"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображать или показывать что-либо на рисунке, картине или фотографии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "на картине или фото"
                            },
                            {
                                "target_lang_word": "запечатлеть",
                                "target_lang_sense_clarification": "на снимке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                    "sense_definition": "To describe or depict something very vividly in words.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>pictured</w> the scene so well that I felt like I was there.",
                            "target_lang_translations": {
                                "ru": "Автор так хорошо <w>описал</w> сцену, что я почувствовал себя там."
                            }
                        },
                        {
                            "text": "He <w>pictured</w> his future in a dark prison to try and gain sympathy.",
                            "target_lang_translations": {
                                "ru": "Он <w>рисовал</w> свое будущее в мрачной тюрьме, чтобы попытаться вызвать сочувствие."
                            }
                        }
                    ],
                    "common_phrases": [
                        "picture the scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень живо описывать или обрисовывать что-либо словами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "описывать",
                                "target_lang_sense_clarification": "живо"
                            },
                            {
                                "target_lang_word": "рисовать",
                                "target_lang_sense_clarification": "словами"
                            },
                            {
                                "target_lang_word": "обрисовывать",
                                "target_lang_sense_clarification": "ситуацию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
