                        "glosses": [
                            "Action de brûler ou état de ce qui brûle."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "829ac50d-6d5a-43a0-88e3-c59fff9e5961",
                                "sense_id": "6f7a76d1-1987-3409-8cd7-075c8e47215d",
                                "text": "Le brûlement des marchandises prohibées, des titres, des papiers."
                            },
                            {
                                "example_id": "f25dee0a-3ebb-4651-a24d-94dae28775f1",
                                "sense_id": "6f7a76d1-1987-3409-8cd7-075c8e47215d",
                                "text": "Or nous savons qu’aucun de ces épisodes, sauf le brûlement du cadavre, n’a eu lieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3b40c27-b360-3e49-ace8-1b183b91a7ac",
                        "entry_id": "81c0bcbc-17c5-3724-b718-d048ce0b6e86",
                        "glosses": [
                            "Douleur physique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
