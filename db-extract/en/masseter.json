                                        "entry_id": "0d9d298b-b148-3447-86cd-5b7a18f2d4c4",
                                        "glosses": [
                                            "Muskel des Kauapparats, der den Unterkiefer bewegt und gegen den Oberkiefer presst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0c8baf-5e64-40bd-8447-deb0c775d619",
                                                "sense_id": "f5bf5377-dc5e-3f34-9b2c-f8e82f77093e",
                                                "text": "„Sie schnappte zu, indem sie die volle Kraft ihrer Kaumuskeln einsetzte, um den Unterkiefer ruckartig hochzuklappen.“"
                                            },
                                            {
                                                "example_id": "7bd4db82-584e-481f-9639-8b7a0ee7f098",
                                                "sense_id": "f5bf5377-dc5e-3f34-9b2c-f8e82f77093e",
                                                "text": "„Sein schwerer Daumen drückt ebenso sinnlos stark und ausgiebig auf den Klingelknopf wie sein Kaumuskel kaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
