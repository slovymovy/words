                "senses": [
                    {
                        "sense_id": "14783dd0-f466-3ca8-b337-d399095a6ce9",
                        "entry_id": "4010f6b0-11ee-3491-b557-80c65791a81e",
                        "glosses": [
                            "bak waar het afval in wordt gedeponeerd totdat de vuilnisdienst het ophaalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5408da90-b437-4f59-b007-7b2337280ddb",
                                "sense_id": "14783dd0-f466-3ca8-b337-d399095a6ce9",
                                "text": "Een dakloze zoekt in de afvalbakken naar statiegeldflessen, aan één stuk door hoestend."
                            },
                            {
                                "example_id": "389bb4dd-e1ce-44d9-bf67-5e15b364b688",
                                "sense_id": "14783dd0-f466-3ca8-b337-d399095a6ce9",
                                "text": "Doordat ik vaak dagenlang geen afvalbak tegenkwam, droeg ik altijd een zak vol gebruikte wc-papiertjes bij me. Het was altijd weer een enorme opluchting om in een dorpje mijn wc-papier en ander afval weg te kunnen gooien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d864efef-c7dd-402f-9079-a068959cb325",
                        "source_entry_id": "4010f6b0-11ee-3491-b557-80c65791a81e",
                        "source_sense_id": "14783dd0-f466-3ca8-b337-d399095a6ce9",
                        "source_sense_description": "bak waar het afval in wordt gedeponeerd totdat de vuilnisdienst het ophaalt",
                        "target_lang_word": "dustbin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
