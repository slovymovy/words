                "senses": [
                    {
                        "sense_id": "64e387ed-cd78-3172-b879-a94f4efd7fa3",
                        "entry_id": "c1181dbe-c580-3adf-8faf-5ba66c65e461",
                        "glosses": [
                            "Alternative form of sammie."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "2fabcdad-8f7b-42d6-894a-302ccd5ae4b9",
                                "sense_id": "64e387ed-cd78-3172-b879-a94f4efd7fa3",
                                "text": "The quintessential Toronto treat is a peameal bacon sammy (try one at the St. Lawrence Market’s Carousel Bakery), and you ought to sample an ooey-gooey butter tart, too."
                            },
                            {
                                "example_id": "c1a25e80-f949-43ca-92c4-51124a347100",
                                "sense_id": "64e387ed-cd78-3172-b879-a94f4efd7fa3",
                                "text": "We were quite taken with the inspired “Artisan” breakfast sammy, with egg, bacon, melty Havarti, arugula, rosemary butter, and apple mustard, a worthy treat at $8."
                            },
                            {
                                "example_id": "f5004ba0-b5b0-49d2-bd90-0e1a174a33e0",
                                "sense_id": "64e387ed-cd78-3172-b879-a94f4efd7fa3",
                                "text": "Enjoy with the two slices of toast smashed together to make a sammy, or leave separate and enjoy as an open-faced sandwich."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
