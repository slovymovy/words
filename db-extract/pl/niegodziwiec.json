                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c7dbbd5-32e5-4597-a97c-ac2ecd28b5b3",
                        "source_entry_id": "c1079911-ef7e-3c33-8833-62395678d334",
                        "source_sense_id": "93f2ad63-b74d-3a19-8e1d-f7c9fd320288",
                        "target_lang_word": "rascal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rascal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "A dishonest person; a rogue, a scoundrel, a trickster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89202b7f-76a0-405a-9fb8-9f03aa6a4c69",
                                                "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            },
                                            {
                                                "example_id": "41761047-b687-44d3-98ac-f14a440092bc",
                                                "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                                "text": "And he smote Corinius on his shaven jowl with the dice box, calling him cheat and mangy rascal, whereupon Corinius drew forth a bodkin to smite him in the neck withal; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "Sometimes diminutive: a cheeky person or creature; a troublemaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60571d97-fa9d-4f53-9682-36cf991a001c",
                                                "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                                "text": "That little rascal bit me!"
                                            },
                                            {
                                                "example_id": "4c0693cd-3d0b-427f-ad82-c8749c037c6e",
                                                "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                                "text": "If you have deer in the area, you may have to put a fence around your garden to keep the rascals out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35bb5b80-7d40-3e04-aa65-a505b35e2cce",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "A member of a criminal gang."
                                        ],
                                        "tags": [
                                            "Papua-New-Guinea"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rascal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5ed836a-5e67-393b-9840-818301b472af",
                                        "entry_id": "c4ae8784-5fb2-39a0-afa7-54a91514aa1d",
                                        "glosses": [
                                            "Low; lowly, part of or belonging to the common rabble."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d7f5e5d-106c-4611-a354-a83ba690d629",
                        "source_entry_id": "c1079911-ef7e-3c33-8833-62395678d334",
                        "source_sense_id": "93f2ad63-b74d-3a19-8e1d-f7c9fd320288",
                        "target_lang_word": "knave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae09574-631f-3ec6-a2a0-52eb37994fbe",
                                        "entry_id": "7ea0fb41-ee8f-3c34-8642-0370434c2a39",
                                        "glosses": [
                                            "A boy; especially, a boy servant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d6a4ebd-e658-3852-bf60-9f4163015d0f",
                                        "entry_id": "7ea0fb41-ee8f-3c34-8642-0370434c2a39",
                                        "glosses": [
                                            "Any male servant; a menial."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e096df02-fde4-463d-98b6-06d8235a7c77",
                                                "sense_id": "6d6a4ebd-e658-3852-bf60-9f4163015d0f",
                                                "text": "Many a duteous and knee-crooking knave that, doting on his own obsequious bondage, wears out his time, much like his master's ass, For naught but provender, and when he's old – cashier'd! Whip me such honest knaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fb4a1d-bb48-36f1-b348-7e93be0433c6",
                                        "entry_id": "7ea0fb41-ee8f-3c34-8642-0370434c2a39",
                                        "glosses": [
                                            "A tricky, deceitful fellow; a dishonest person."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84a3f62-65b0-4e87-8119-a91fbbe37fb7",
                                                "sense_id": "61fb4a1d-bb48-36f1-b348-7e93be0433c6",
                                                "text": "I could plainly diſcover from whence one Family derives a long Chin; why a ſecond hath abounded with Knaves for two Generations, and Fools for two more; why a third happened to be crack-brained, and a fourth to be Sharpers."
                                            },
                                            {
                                                "example_id": "1be28d14-6a51-41a8-b856-c09ce9a09945",
                                                "sense_id": "61fb4a1d-bb48-36f1-b348-7e93be0433c6",
                                                "text": "He was a man whom scarcely any amount of fortune could have benefited permanently, and who was made to be ruined, to cheat small tradesmen, to be the victim of astuter sharpers: to be niggardly and reckless, and as destitute of honesty as the people who cheated him, and a dupe, chiefly because he was too mean to be a successful knave."
                                            },
                                            {
                                                "example_id": "952f5e94-cc5f-469f-8726-e745a7755d46",
                                                "sense_id": "61fb4a1d-bb48-36f1-b348-7e93be0433c6",
                                                "text": "I had never defrauded a man of a farthing, nor called him knave behind his back. But now the last rag that covered my nakedness had been torn from me. I was branded a blackleg, card-sharper, and murderer."
                                            },
                                            {
                                                "example_id": "23b2d488-6567-4ea0-94a5-1ae2c88c9812",
                                                "sense_id": "61fb4a1d-bb48-36f1-b348-7e93be0433c6",
                                                "text": "God's bones! Whenever I go to beat those knaves / my tapsters, out she [my wife] comes with clubs and staves, / \"Go on!\" she screams — and it's a caterwaul — / \"You kill those dogs! Break back and bones and all!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b235e7d7-c615-3d8b-90ad-687d237f46c3",
                                        "entry_id": "7ea0fb41-ee8f-3c34-8642-0370434c2a39",
                                        "glosses": [
                                            "A playing card marked with the figure of a servant or a soldier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46a694d4-e848-4fd4-8d0a-a7c0b3038c91",
                        "source_entry_id": "c1079911-ef7e-3c33-8833-62395678d334",
                        "source_sense_id": "93f2ad63-b74d-3a19-8e1d-f7c9fd320288",
                        "target_lang_word": "негодяй",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "негодяй",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                        "entry_id": "5d9ecab8-9011-3ce0-bb03-2bd4c4abac56",
                                        "glosses": [
                                            "бран. негодный, подлый, низкий человек, внушающий негодование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a9dd10-5e37-4f89-a046-a6eccd26afef",
                                                "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                                "text": "Впрочем, ей нечего говорить, скажу её мужу, что я негодяй, обманывал его."
                                            },
                                            {
                                                "example_id": "0295f382-1448-4a78-a998-f32eb3c4cfab",
                                                "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                                "text": "— Телегин негодяй и преступник, военным судом он будет расстрелян."
                                            },
                                            {
                                                "example_id": "275753a8-7b50-469e-8431-02853d1d716f",
                                                "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                                "text": "Так у этого негодяя ещё и жена — коммунистка?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fc562c4-0f2a-49c2-9927-7238b5d2bae2",
                        "source_entry_id": "c1079911-ef7e-3c33-8833-62395678d334",
                        "source_sense_id": "93f2ad63-b74d-3a19-8e1d-f7c9fd320288",
                        "target_lang_word": "подлец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подлец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb0e6f5-3e8e-37e7-ad6f-89d4ee1eb89c",
                                        "entry_id": "13f10a2d-455d-3f13-aa8d-337b1a4f6b86",
                                        "glosses": [
                                            "неодобр. низкий в нравственном отношении человек, тот, кто совершает подлость; негодяй || разг. употребляется как бранное слово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233d5441-a4e3-446b-a594-0e490d826cf0",
                                                "sense_id": "7fb0e6f5-3e8e-37e7-ad6f-89d4ee1eb89c",
                                                "text": "Где логика? Отцы ― злодеи, // Низкопоклонники, лакеи, // А в детях видя подлецов, // И негодуют и дивятся, // Как будто от таких отцов // Герои где-нибудь родятся?"
                                            },
                                            {
                                                "example_id": "c39e3808-7ebd-4252-aa09-1b098e186c83",
                                                "sense_id": "7fb0e6f5-3e8e-37e7-ad6f-89d4ee1eb89c",
                                                "text": "— Разве я это сюда говорил ставить тебе, подлец? разве я не говорил тебе наперёд разогреть курицу, мошенник?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
