                ],
                "senses": [
                    {
                        "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                        "entry_id": "2e60add5-dea7-3a8e-9b89-13408ec42772",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die Rüstungen und Waffen herstellen oder Dienstleistungen zur Herstellung dieser Produkte anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4253f996-f5c1-4ca8-8142-bc38f7840433",
                                "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                                "text": "Die Rüstungsindustrie ist ein wichtiger Wirtschaftszweig des Landes."
                            },
                            {
                                "example_id": "bc8627ef-c2bb-4587-ab13-5880ae19073e",
                                "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                                "text": "„Die Rüstungsindustrie Chinas hat in den vergangen Jahren große Fortschritte gemacht, sodass das Land seine Abhängigkeit von Rüstungsimporten aus dem Ausland deutlich verringern konnte.“"
                            },
                            {
                                "example_id": "f871385b-871e-42be-a309-7ba112e11e41",
                                "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                                "text": "„Unter dem flottenbegeisterten Kaiser Wilhelm II. (1888-1918) gewann die Marine an Bedeutung, und eine große maritime Rüstungsindustrie entstand.“"
                            },
                            {
                                "example_id": "7d388a80-3547-427d-a60a-ac50099676e6",
                                "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                                "text": "„Doch weil ihre Tätigkeit kaum als kriegswichtig gelten konnte, hatten sie anders als Facharbeiter in der Rüstungsindustrie kaum Druckmittel, bessere Bezahlung durchzusetzen.“"
                            },
                            {
                                "example_id": "2b0a16fd-e3de-4af7-981f-e3922c56f62f",
                                "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                                "text": "[Russischer Angriffskrieg auf die Ukraine:] „Obwohl der Westen die russische Rüstungsindustrie mit schweren Sanktionen belegt hat, laufen die Maschinen auf Hochtouren.“"
                            },
                            {
                                "example_id": "95db0c4c-e5c5-435e-96a8-cc2973213edf",
                                "sense_id": "961c93bb-7733-305e-aadf-d8999f0f08c3",
                                "text": "„Die russische Rüstungsindustrie wurde bereits nach der völkerrechtswidrigen Annexion der Krim 2014 mit Sanktionen belegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
