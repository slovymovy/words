                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3f3d8296-3e77-430c-bbe0-6de33c6ddbed",
                                "sense_id": "57a560a5-96b8-3cf1-b3eb-f5db02470162",
                                "text": "Guido Gezelle en Gerard Achterberg zijn beroemde dichters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59931b8a-5c11-4163-b243-fcfaca6efb0a",
                        "source_entry_id": "6bb127ff-dc6a-34a3-9268-f179c2b21cb7",
                        "source_sense_id": "57a560a5-96b8-3cf1-b3eb-f5db02470162",
                        "source_sense_description": "iemand die poëtische kunst voortbrengt",
                        "target_lang_word": "Dichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dichter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8396c2a-a92b-31e6-83f9-14344a7d405c",
                                        "entry_id": "ceca132d-bd35-381a-93d3-4c9cc343cc76",
                                        "glosses": [
                                            "Verfasser eines sprachlich kunstvollen Werkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8eb3839-0250-440f-9ac5-3366fd30abcb",
                                                "sense_id": "f8396c2a-a92b-31e6-83f9-14344a7d405c",
                                                "text": "Einer der größten deutschen Dichter ist Johann Wolfgang von Goethe."
                                            },
                                            {
                                                "example_id": "ccf30b87-9ea6-496f-ba27-06af3d58b08d",
                                                "sense_id": "f8396c2a-a92b-31e6-83f9-14344a7d405c",
                                                "text": "„Ja, das Schreiben und das Lesen",
                                                "translation": "poetisch war ich nie!“"
                                            },
                                            {
                                                "example_id": "f95276d7-a712-4010-8820-beca320b537f",
                                                "sense_id": "f8396c2a-a92b-31e6-83f9-14344a7d405c",
                                                "text": "„Die Geschichte der staufischen Herrscher hat nicht nur die deutschen Mittelalterhistoriker im 19. Jahrhundert mächtig bewegt, sondern auch viele Dichter und Schriftsteller.“"
                                            },
                                            {
                                                "example_id": "cc8c59fa-f8d0-463c-b468-4ff0f5d610f8",
                                                "sense_id": "f8396c2a-a92b-31e6-83f9-14344a7d405c",
                                                "text": "„Der sei auch ein Dichter und werde ebenfalls mitkommen.“"
                                            },
                                            {
                                                "example_id": "3e3a1543-3fcd-4bab-a357-6885d6d26409",
                                                "sense_id": "f8396c2a-a92b-31e6-83f9-14344a7d405c",
                                                "text": "„Einer der leidenschaftlichsten Wurstliebhaber war der Bierfreund und Dichter Jean Paul aus Wunsiedel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c753bd26-6621-4748-9299-9afb35e86682",
                        "source_entry_id": "6bb127ff-dc6a-34a3-9268-f179c2b21cb7",
