                "senses": [
                    {
                        "sense_id": "4103bd27-fbea-3dd4-9904-c2c9a6b2efce",
                        "entry_id": "93dfe7ba-2fd1-39c5-b88e-988edca55439",
                        "glosses": [
                            "Diplôme universitaire national délivré en France après deux années d’études supérieures à tout bachelier, diplôme créé en 1973 et supprimé suite à la réforme LMD."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "f1757a28-fe56-4135-b221-31673838ce4c",
                                "sense_id": "4103bd27-fbea-3dd4-9904-c2c9a6b2efce",
                                "text": "Là où la majorité redoublait, elle passait sans encombres en « maths spé ». Admise également en seconde année de DEUG. De quoi se sentir affranchie du contrat moral tacite entre elle et ses parents."
                            },
                            {
                                "example_id": "24f6a12c-ff1e-4dfc-8247-cf41bef5a6ee",
                                "sense_id": "4103bd27-fbea-3dd4-9904-c2c9a6b2efce",
                                "text": "Dans les écoles, des professeurs enseignants pour des classes de BTS, DUT, DEUG, classes préparatoires, etc., sont spécialisés dans l’apprentissage des notions fondamentales de programmation."
                            },
                            {
                                "example_id": "8354ed90-ca51-45fc-815e-2168f0ddaf0c",
                                "sense_id": "4103bd27-fbea-3dd4-9904-c2c9a6b2efce",
                                "text": "Caroline l’avait raccompagnée chez elle, ravie d’avoir retrouvé Mattias — Ça fait vingt ans que je le connais, j’étais maître de conf' quand il est arrivé en première année de DEUG — et Lucy avait été incapable de poser la moindre question, de proférer le moindre commentaire."
                            }
                        ]
                    }
