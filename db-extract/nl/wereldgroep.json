                    {
                        "sense_id": "683590aa-e09c-3708-bbfd-d3a2f79fc976",
                        "entry_id": "95787f3b-8687-390e-82f0-6c6a39baee06",
                        "glosses": [
                            "tennistoernooi met landenteams dat deel uitmaakte van het Davis Cup toernooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd04a9f-be40-4b46-8d62-3b41420b0cfd",
                                "sense_id": "683590aa-e09c-3708-bbfd-d3a2f79fc976",
                                "text": "Nederland verloor vorige maand met 4-0 van Canada, waarmee het werd veroordeeld tot het play-offduel om lijfsbehoud in de Wereldgroep II. Het duel vindt op 21 en 22 april plaats in Osaka."
                            },
                            {
                                "example_id": "ae9ba3a6-73be-49c1-bc78-870ae2b713b7",
                                "sense_id": "683590aa-e09c-3708-bbfd-d3a2f79fc976",
                                "text": "Schuurs bereidt zich momenteel voor op de wedstrijd van het Fed Cup-team op 20 en 21 april in Osaka tegen Japan voor handhaving in wereldgroep II."
                            },
                            {
                                "example_id": "a75c5f4d-78ea-4fc3-9739-7754f08fb14b",
                                "sense_id": "683590aa-e09c-3708-bbfd-d3a2f79fc976",
                                "text": "Er komt een finaletoernooi met achttien landenteams op één locatie. Dat houdt onder meer in dat de wereldgroep verdwijnt."
                            }
                        ]
                    }
