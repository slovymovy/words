                "translations": [
                    {
                        "translation_id": "f9977d7a-2842-4607-a0ba-a9d57ef01bcc",
                        "source_entry_id": "f8607653-d2a9-38b7-9c1c-a005f1fab4c1",
                        "source_sense_id": "08e6630a-e532-338a-b849-6f649537195f",
                        "target_lang_word": "polymath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18522188-4d58-3170-939b-71c3737c089e",
                                        "entry_id": "40ebe7dc-f955-33b9-926d-8c6d1b987db9",
                                        "glosses": [
                                            "A person with extraordinarily broad and comprehensive knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e970edc7-1785-4d07-9bea-8b6648b3d187",
                                                "sense_id": "18522188-4d58-3170-939b-71c3737c089e",
                                                "text": "To be thought and held Polumathes and Polihistors."
                                            },
                                            {
                                                "example_id": "910448d8-c474-4749-b2ac-c6ff4dc33ff1",
                                                "sense_id": "18522188-4d58-3170-939b-71c3737c089e",
                                                "text": "A bit of a polymath, he was crucial in the early development of the railways in this country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dda1af06-fcb1-46f9-a5e8-c32c0f8abb0d",
                        "source_entry_id": "f8607653-d2a9-38b7-9c1c-a005f1fab4c1",
                        "source_sense_id": "08e6630a-e532-338a-b849-6f649537195f",
                        "target_lang_word": "polymathe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymathe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                        "entry_id": "d4446504-3ac9-3f9b-92af-1f08bb43f0bd",
                                        "glosses": [
                                            "Personne aux connaissances variées et approfondies, en particulier des connaissances en art et en science."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76dfc052-fdfb-48df-a0ab-d40146c16308",
                                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                                "text": "Imhotep, Pic de la Mirandole, Léonard de Vinci et Isaac Asimov sont des polymathes célèbres."
                                            },
                                            {
                                                "example_id": "d7950a52-ea21-40da-aefc-4c542f7ab474",
                                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                                "text": "Les polymathes ont parfois été appelés hommes d'esprit universel."
                                            },
                                            {
                                                "example_id": "070883bf-d4a4-44db-b7b8-ed57f728c79b",
                                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                                "text": "Un polymathe, c’est une personne qui a des connaissances approfondies dans des domaines qui n’ont pas de liens apparents (« Math » signifie apprentissage en grec). C’est typiquement un « Homme de la Renaissance », ou un « Homo Universalis », esprit ouvert, curieux de tout."
                                            },
                                            {
                                                "example_id": "8fa14b7a-feea-4253-89c0-6a9274a15317",
                                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                                "text": "Cette maîtrise du réel est renforcée par le fait que Sherlock Holmes est un esprit polymathe, c’est-à-dire curieux de tout, aux connaissances qui s’étendent bien au-delà de son champ d’élection, la détection policière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6165529-4a96-4b5c-b619-1167f5456346",
                        "source_entry_id": "f8607653-d2a9-38b7-9c1c-a005f1fab4c1",
                        "source_sense_id": "08e6630a-e532-338a-b849-6f649537195f",
                        "target_lang_word": "polímata",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polímata",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "36d95821-de2b-34ba-945b-0d2df1f83b32",
                                        "entry_id": "e1edb627-7db1-350c-ba19-e1ef8036f4a4",
                                        "glosses": [
                                            "Persona de conocimientos profundos en diversas disciplinas o artes."
                                        ],
                                        "tags": [
                                            "formal",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00245a24-6b9d-4287-a208-34064b20ce57",
                                                "sense_id": "36d95821-de2b-34ba-945b-0d2df1f83b32",
                                                "text": "A no dudarlo, la historia está en continua revisión y es curioso que yo lo haya recordado respetuosamente a un eminente polímata venezolano, con quien dialogaba por la prensa, justamente a propósito de España y de su obra en América."
                                            },
                                            {
                                                "example_id": "a06b0645-f08c-46f6-8cbf-238f7a70547f",
                                                "sense_id": "36d95821-de2b-34ba-945b-0d2df1f83b32",
                                                "text": "El propio Menéndez y Pelayo la pone a la altura de la mejor obra nacional de su estilo, y otro polímata moderno y contemporáneo llama a Bernal «el más grande de los cronistas."
                                            },
                                            {
                                                "example_id": "7ec32edf-abe9-48f4-acb0-09f12aafd310",
                                                "sense_id": "36d95821-de2b-34ba-945b-0d2df1f83b32",
                                                "text": "El OED, en su forma del siglo XIX, ha sido justamente calificado como nuestra epopeya victoriana y en la tradición johnsoniana fue obra en su mayor parte de un solo hombre. Este hombre era un maestro de escuela escocés, polímata, temeroso de Dios, abstemio, no fumador, con numerosa descendencia, llamado James Murray."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
