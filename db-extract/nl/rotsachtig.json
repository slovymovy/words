                ],
                "senses": [
                    {
                        "sense_id": "af781ace-0d00-3a7f-a6cb-4f4f723d0a89",
                        "entry_id": "188d807e-7fc4-3676-9f01-33deadbaa6af",
                        "glosses": [
                            "waar veel rotsen zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702048cf-f3d0-4f5b-89d8-2876293e989d",
                                "sense_id": "af781ace-0d00-3a7f-a6cb-4f4f723d0a89",
                                "text": "Ten slotte kwam hij in een rotsachtige streek, waar hij plotseling de fluit van een herdersjongen hoorde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be8ad7eb-9f2e-4af1-ad23-b08f6a9cea5a",
                        "source_entry_id": "188d807e-7fc4-3676-9f01-33deadbaa6af",
                        "source_sense_id": "af781ace-0d00-3a7f-a6cb-4f4f723d0a89",
                        "source_sense_description": "waar veel rotsen zijn",
                        "target_lang_word": "felsig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felsig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                        "entry_id": "8fd77e4f-b674-377a-b6b6-091b050fbf39",
                                        "glosses": [
                                            "mit größeren Steinen bedeckt; aus Felsen bestehend (beispielsweise Berge, Hügel, Steilküsten)"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292343f7-f540-4dc6-b3d9-37c8980a0c7c",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "Norwegens Atlantikküste ist überwiegend felsig."
                                            },
                                            {
                                                "example_id": "a46fcd67-341f-42c2-9fa3-6646250972d4",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Mehrere, weitgehend felsige Inseln bilden hier eine geschützte Bucht.“"
                                            },
                                            {
                                                "example_id": "6ce4bfa5-b1af-40cf-9f36-307cd53d65ff",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "[Vanuatu:] „Die meisten Inseln sind vulkanischen Ursprungs. Daher sind die Küsten oft felsig und steil abfallend.“"
                                            },
                                            {
                                                "example_id": "5f3bfd98-7dfe-4168-892d-aab4cca8f9d5",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Die Küste der Côtes-d’Armor ist größtenteils felsig und es gibt nur wenige Sandstrände.“"
                                            },
                                            {
                                                "example_id": "01de37c4-a8b5-4673-9950-17ed34be7cd6",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Die markante felsige Insel Mont Saint-Michel liegt in einer weiten Bucht des Ärmelkanals und ist nur bei Flut mit Wasser umgeben.“"
                                            },
                                            {
                                                "example_id": "16b74377-bb32-4a8b-9bc3-31a790eb3aec",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Hässlich-graue Gewächshäuser, in denen vermutlich Tomaten heranreifen, scheinbar endlos lange Lagerhallen, langweilige Gewerbesiedlungen, dazwischen reihenweise wenig attraktive Windräder und Strommasten, karge felsige Landschaft, so stellt man sich eine Ferieninsel nicht vor.“"
                                            },
                                            {
                                                "example_id": "61b53624-43dd-42cc-93db-0b608e6e16cf",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Es gibt Wege und Fahrwege in mehrere Richtungen, die Landschaft ist rauh und felsig.“"
                                            },
                                            {
                                                "example_id": "24b1e8cc-4751-4120-8e18-792490de2562",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Hunderte Besucher pilgern jedes Jahr Anfang Mai die felsigen Pfade hinauf zum Gipfelplateau und genießen von oben den Blick übers Land […].“"
                                            },
                                            {
                                                "example_id": "bab5cacc-5265-40c4-b9d1-d156abf07d7a",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "[…] „mit der Fassung der Niederschläge der Wintermonate und Speicherung des Wassers in zahlreichen in den felsigen Grund gegrabenen Zisternen konnte Landwirtschaft im terrassierten Gelände und Viehzucht betrieben werden.“"
                                            },
                                            {
                                                "example_id": "1994c8ea-4a07-4608-86fb-f3b5dfac96bf",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "[Gletscherschwund:] „Wo einst felsige Aufschlüsse aus einem Meer aus grellem Weiß hervorragten, sind heute nur noch Fetzen von hellem Eis über eine ansonsten dunkle Felsfläche verstreut.“"
                                            },
                                            {
                                                "example_id": "51112c6a-0f1f-4f1e-9a77-0754f8c3ce04",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "[Naturschutz:] „Intensive Land- und Forstwirtschaft verdrängen viele Tier- und Pflanzenarten. Eine Ausbreitung der Siedlungsgebiete zerstört spezielle Lebensräume wie Dünenlandschaften und felsige Gebiete.“"
                                            },
                                            {
                                                "example_id": "f405f82e-c845-4174-955d-6e7164e8118f",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Nur wenige Landflächen können in Südafrika zum Anbau von Pflanzen genutzt werden. Ein Großteil der Bodenflächen ist zu trocken, zu hügelig oder zu felsig, um Ackerbau zu betreiben.“"
                                            },
                                            {
                                                "example_id": "d55be717-f96f-4286-ad93-4e5e90a2211e",
                                                "sense_id": "ef331688-163c-322f-a7be-d316f519d2e5",
                                                "text": "„Größe und Zusammensetzung des Exoplaneten sind zwar unbekannt, aber eine felsige Welt mit entsprechender Masse würde sich zwischen der ein- und zweifachen Größe der Erde bewegen, teilte die Universität Göttingen mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8de0c20c-fcb1-43a8-926e-fe5a61392989",
                        "source_entry_id": "188d807e-7fc4-3676-9f01-33deadbaa6af",
                        "source_sense_id": "af781ace-0d00-3a7f-a6cb-4f4f723d0a89",
