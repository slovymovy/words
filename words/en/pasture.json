{
    "word_family": [
        "pastoral",
        "pasturage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da566e72-e3cb-3ee6-8062-7374e3649648",
                    "sense_definition": "Land, specifically an open field, where livestock is kept for feeding.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "land_for_grazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cows were moved to a new <w>pasture</w> for the summer.",
                            "target_lang_translations": {
                                "zh": "夏天的时候，奶牛被转移到了一个新的<w>牧场</w>。"
                            }
                        },
                        {
                            "text": "The farmer fenced off the <w>pasture</w> to keep the sheep safe.",
                            "target_lang_translations": {
                                "zh": "农夫把<w>牧场</w>围了起来，以保护羊群的安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leasow"
                    ],
                    "common_phrases": [
                        "green pasture"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于放牧牲畜的土地，通常指开阔的草地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "牧场",
                                "target_lang_sense_clarification": "指专门用于放牧牲畜的广阔草地。"
                            },
                            {
                                "target_lang_word": "草场",
                                "target_lang_sense_clarification": "指生长着牧草的土地，常用于放牧。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                    "sense_definition": "Food or nourishment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animals sought <w>pasture</w> in the barren fields.",
                            "target_lang_translations": {
                                "zh": "动物们在贫瘠的田野里寻找<w>草料</w>。"
                            }
                        },
                        {
                            "text": "He found little <w>pasture</w> for his hungry cattle during the drought.",
                            "target_lang_translations": {
                                "zh": "干旱期间，他没能为饥饿的牛群找到多少<w>饲料</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指牲畜的食物或营养来源。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "饲料",
                                "target_lang_sense_clarification": "指喂养牲畜的食物。"
                            },
                            {
                                "target_lang_word": "草料",
                                "target_lang_sense_clarification": "指作为牲畜食物的草。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5f63990-354d-3260-a6da-c51b958bccfc",
                    "sense_definition": "To feed on growing grass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep <w>pasture</w> on the hillside all day long.",
                            "target_lang_translations": {
                                "zh": "羊群整天都在山坡上<w>吃草</w>。"
                            }
                        },
                        {
                            "text": "We watched the horses <w>pasture</w> in the quiet meadow.",
                            "target_lang_translations": {
                                "zh": "我们看着马儿在安静的草地上<w>吃草</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指牲畜在草地上吃草。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吃草",
                                "target_lang_sense_clarification": "指牲畜在草地上进食。"
                            },
                            {
                                "target_lang_word": "放牧",
                                "target_lang_sense_clarification": "指牲畜在草场上觅食。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                    "sense_definition": "To supply grass as food for livestock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer <w>pastures</w> fifty oxen on his land.",
                            "target_lang_translations": {
                                "zh": "农夫在他的土地上<w>放牧</w>着五十头牛。"
                            }
                        },
                        {
                            "text": "This field can <w>pasture</w> forty cows throughout the winter.",
                            "target_lang_translations": {
                                "zh": "这片田地整个冬天可以<w>放牧</w>四十头奶牛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指将牲畜放在草地上喂养。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放牧",
                                "target_lang_sense_clarification": "指将牲畜赶到草场上喂养。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}