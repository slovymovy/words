                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83fdae75-38c0-3fc1-ba0c-f0d0993c19bb",
                                        "entry_id": "3d87cd99-ada8-3ec0-8096-bb5d40cc0283",
                                        "glosses": [
                                            "To spend the summer, as in a particular place on holiday."
