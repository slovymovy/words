                "senses": [
                    {
                        "sense_id": "7b048d4f-f0a5-30d9-9007-199772499ff3",
                        "entry_id": "79a2b917-6029-3893-b095-183d9583a164",
                        "glosses": [
                            "gewerblich oder industriell genutztes Bauwerk, das sich im Besitz oder Eigentum einer Firma befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8566284d-73e3-43df-9208-813831e5403c",
                                "sense_id": "7b048d4f-f0a5-30d9-9007-199772499ff3",
                                "text": "„Derzeit richten immer mehr Unternehmen nur noch einen gewissen Anteil fester Arbeitsplätze im Firmengebäude ein.“"
                            },
                            {
                                "example_id": "1a33cd0a-3245-4379-9882-b5dabdb4a6be",
                                "sense_id": "7b048d4f-f0a5-30d9-9007-199772499ff3",
                                "text": "„Sollte ausgerechnet an Ihrem Vorstellungstag die Straße frei oder die Straßenbahn pünktlich sein, machen Sie nicht den Fehler, das Firmengebäude zu früh zu betreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
