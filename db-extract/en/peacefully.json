                                                "sense_id": "d66ea98a-3e76-3344-becb-e3e7b33c12cb",
                                                "text": "Spokojnie wyjął rewolwer, przyłożył sobie do skroni i nacisnął spust."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "aa0cb4bb-e507-3e26-8988-3813defbf006",
