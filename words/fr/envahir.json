{
    "word_family": [
        "envahissant",
        "envahissement",
        "envahisseur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04a17b6a-bcbf-3a1a-8662-7c4ec4f2458a",
                    "sense_definition": "Entrer par la force et avec des troupes armées dans un pays ou un territoire pour s'en emparer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "guerre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée ennemie a franchi la frontière pour <w>envahir</w> un pays voisin durant la nuit."
                        },
                        {
                            "text": "Les troupes ont <w>envahi</w> un territoire hostile après plusieurs semaines de préparation militaire."
                        }
                    ],
                    "synonyms": [
                        "occuper",
                        "conquérir",
                        "assaillir"
                    ],
                    "antonyms": [
                        "évacuer",
                        "libérer"
                    ],
                    "common_phrases": [
                        "envahir un pays",
                        "envahir un territoire"
                    ]
                },
                {
                    "sense_id": "242b0120-f02d-34ad-b298-941d0959b5bd",
                    "sense_definition": "Occuper un lieu en très grand nombre ou s'y répandre jusqu'à prendre toute la place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers de touristes <w>envahissent</w> les rues du centre historique chaque été."
                        },
                        {
                            "text": "Les mauvaises herbes <w>envahissent</w> rapidement le jardin potager si on ne s'en occupe pas."
                        }
                    ],
                    "synonyms": [
                        "submerger",
                        "inonder"
                    ],
                    "antonyms": [
                        "déserter"
                    ],
                    "common_phrases": [
                        "envahir les rues",
                        "envahir la plage"
                    ]
                },
                {
                    "sense_id": "9fc5cb64-637d-3b2e-a58d-0d7ea0763f1c",
                    "sense_definition": "S'emparer progressivement de l'esprit ou du corps de quelqu'un, en parlant d'une émotion ou d'une sensation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une immense vague de tristesse m'a <w>envahi</w> en apprenant cette terrible nouvelle."
                        },
                        {
                            "text": "Il tente de respirer calmement pour ne pas se laisser <w>envahir</w> par la panique."
                        }
                    ],
                    "synonyms": [
                        "gagner",
                        "submerger"
                    ],
                    "antonyms": [
                        "quitter"
                    ],
                    "common_phrases": [
                        "se laisser envahir",
                        "envahi par le doute"
                    ]
                }
            ]
        }
    ]
}