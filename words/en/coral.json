                                "target_lang_sense_clarification": "带粉橙色的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "be8f1f22-29a1-38c8-8838-cb5d127516e0",
                    "sense_definition": "A female given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My aunt <w>Coral</w> has always loved the sea, fittingly enough.",
                            "target_lang_translations": {
                                "ru": "Моя тетя <w>Корал</w> всегда любила море, что вполне символично.",
                                "zh": "我的姨妈<w>科拉尔</w>一直都很喜欢大海，这还真是贴切。"
                            }
                        },
                        {
                            "text": "The teacher called <w>Coral</w> to the front of the class to present her project.",
                            "target_lang_translations": {
                                "ru": "Учитель вызвал <w>Корал</w> к доске, чтобы она представила свой проект.",
                                "zh": "老师叫<w>科拉尔</w>到教室前面展示她的项目。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "一个女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ко́рал",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科拉尔",
                                "target_lang_sense_clarification": "女性名字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c672e49-effe-350a-bacb-2dc0df0a1c11",
                    "sense_definition": "A place in the United States, specifically a census-designated place in Illinois.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Coral</w> on their way to Chicago.",
                            "target_lang_translations": {
                                "ru": "По дороге в Чикаго они проехали через небольшое поселение <w>Корал</w>.",
                                "zh": "他们在前往芝加哥的路上开车经过了<w>科拉尔</w>这个小社区。"
                            }
                        },
                        {
                            "text": "The population of <w>Coral</w> is quite small compared to the neighboring towns.",
                            "target_lang_translations": {
                                "ru": "Население <w>Корала</w> довольно мало по сравнению с соседними городами.",
                                "zh": "与附近城镇相比，<w>科拉尔</w>的人口相当少。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место в Соединенных Штатах, в частности, статистически обособленная местность в Иллинойсе.",
                        "zh": "美国的一个地名，具体指伊利诺伊州的一个人口普查指定居民点。"
                    },
                    "translations": {
                        "ru": [
