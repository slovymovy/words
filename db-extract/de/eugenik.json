                        ],
                        "form": "die Eugenik"
                    },
                    {
                        "form_id": "5b34f437-88d4-4ee6-bd70-8bd9aa70a785",
                        "entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Eugenik"
                    },
                    {
                        "form_id": "9d38b415-ffa0-4349-a638-fd5db0750312",
                        "entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Eugenik"
                    },
                    {
                        "form_id": "c201a6aa-b694-49ec-979d-28257c449161",
                        "entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Eugenik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                        "entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "glosses": [
                            "Wissenschaft von der Erbgesundheit"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ed45818f-2de3-4f4c-917d-cc9cd828e392",
                                "sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                                "text": "In der modernen Medizin wird der Begriff \"Eugenik\" nicht mehr verwendet."
                            },
                            {
                                "example_id": "2a7d1d14-8bf4-49c1-869b-5d8fb737632b",
                                "sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                                "text": "„Die belegt nämlich, dass Eugenik außer dumpfem Rassismus nichts Verwertbares hervorgebracht hat und dass Prägung und Umgebung den Menschen zum eigenständigen sozialen Wesen machen.“"
                            },
                            {
                                "example_id": "31faf1ac-1cc1-42b4-b16b-419185abb4dc",
                                "sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                                "text": "„In den verschiedenen Sektionen wies der Kongreß eine erstaunliche disziplinäre Vielfalt auf: Physiologie und Pathologie der Sexualität wurden ebenso behandelt wie Psychologie und Pädagogik, Hygiene und Eugenik, Soziologie und Kultur, Kriminologie und Familienrecht.“"
                            },
                            {
                                "example_id": "2b33961f-5b74-4ac8-aa67-6745dc062c05",
                                "sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                                "text": "„Die politische Stoßrichtung der Eugenik war nicht einheitlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83ce9d2a-227e-35b2-840e-631b82e494a4",
                        "entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "glosses": [
                            "Zeugungs- und Geburtenverhinderung, sowie Tötung angeblich \\\"minderwertiger\\\" Menschen zum Zwecke der Verbesserung der allgemeinen Gesundheit; aktive Beeinflussung der menschlichen Evolution auf Grundlage der Rassentheorie und des Sozialdarwinismus (praktische Anwendung von [1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d292b315-8f6e-428b-834f-c167019f6537",
                                "sense_id": "83ce9d2a-227e-35b2-840e-631b82e494a4",
                                "text": "Es ist ein wenig bekannter Fakt, dass der Wissenschaftler Nikola Tesla ein Befürworter der Eugenik war."
                            },
                            {
                                "example_id": "1be4fa6e-7cd8-4d89-826e-ac0caca755bd",
                                "sense_id": "83ce9d2a-227e-35b2-840e-631b82e494a4",
                                "text": "„Im Rahmen dieses Zugriffes steht die Eugenik paradigmatisch für den wissenschaftlichen Ehrgeiz, den gesellschaftlichen Fortschritt, der um 1900 u.a. als \"Höherentwicklung der Menschheit\" konzipiert wird, durch sozial- und biotechnische Eingriffe in die reproduktive Natur und Kultur zu sichern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0666f3d-4218-4ed0-858b-fc9a3ef13363",
                        "source_entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "source_sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                        "target_lang_word": "eugenics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eugenics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7029b561-100d-375a-bae7-5ebb398fc657",
                                        "entry_id": "592ed731-8c81-3c12-9959-69aa052971fc",
                                        "glosses": [
                                            "A social philosophy or practice which advocates the improvement of human hereditary qualities through selective breeding, either by encouraging people with superior genetic qualities to reproduce (positive eugenics), or discouraging people with inferior genetic qualities from reproducing (negative eugenics), or by technological means."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2258008-d279-4daa-b57b-3ccd418ecf8a",
                                                "sense_id": "7029b561-100d-375a-bae7-5ebb398fc657",
                                                "text": "In keeping with the goals of the new eugenics movement, McCulloch was claiming to offer scientific evidence of the incorrigibility of poor rural whites."
                                            },
                                            {
                                                "example_id": "498bf725-3b85-44fa-acd0-954eab0fadb4",
                                                "sense_id": "7029b561-100d-375a-bae7-5ebb398fc657",
                                                "text": "The eugenics mania that swept the country in the late 19th and early 20th centuries led to forced sterilizations and the passage of laws in 27 states designed to limit the numbers of those considered genetically unfit: immigrants, Jews, African-Americans, the mentally ill and those deemed “morally delinquent.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b714e528-fc62-4a3f-960b-8d86fd3dcddc",
                        "source_entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "source_sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                        "target_lang_word": "eugénisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eugénisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c67af9d4-78e6-3fe6-bc5a-222c131ff7b5",
                                        "entry_id": "dca303b8-b5f1-32c2-a36e-687244c99de1",
                                        "glosses": [
                                            "Volonté d’améliorer l’espèce humaine par sélection artificielle notamment à l’aide de la technologie génétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a133784-d703-4f4f-948d-3cc78b74f4a3",
                                                "sense_id": "c67af9d4-78e6-3fe6-bc5a-222c131ff7b5",
                                                "text": "La doctrine officielle réprouve l’eugénisme comme l’euthanasie, ne connaît que l’euh ! des hésitations devant le problème des mesures à prendre pour étouffer dans l’œuf la plus terrible atteinte à la dignité humaine."
                                            },
                                            {
                                                "example_id": "bff1f82b-af63-4d61-bea7-dcd1fec6f573",
                                                "sense_id": "c67af9d4-78e6-3fe6-bc5a-222c131ff7b5",
                                                "text": "Les programmes d’eugénisme visant à éliminer les gènes récessifs défavorables des populations humaines en empêchant la reproduction des personnes atteintes, ne fonctionnent pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd9bd167-1e60-4562-9471-ce8c00927e93",
                        "source_entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "source_sense_id": "dc528a33-3495-3565-be23-a7215d6afa9a",
                        "target_lang_word": "eugenesia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eugenesia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "131e4fe2-580c-3fcb-8d99-fae62fdcee5c",
                                        "entry_id": "4d252c43-b891-3741-9053-8db3ea2093ef",
                                        "glosses": [
                                            "Ideología o movimiento que aboga por el uso de métodos de selección genética para la mejora de las características de una raza o población."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b9748f3-2311-34b8-b225-44255c697c22",
                                        "entry_id": "4d252c43-b891-3741-9053-8db3ea2093ef",
                                        "glosses": [
                                            "Ciencia aplicada que estudia y diseña los métodos para lograr este fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca402eb2-1064-4425-a47a-1e97dcef79e4",
                                                "sense_id": "5b9748f3-2311-34b8-b225-44255c697c22",
                                                "text": "Para evitar la transmisión de las enfermedades que constituyen la preocupación fundamental de la eugenesia, se preconiza la restricción del matrimonio."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
