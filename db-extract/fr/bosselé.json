                        "entry_id": "a0887622-dcf3-3a0c-a50d-396775347eba",
                        "glosses": [
                            "Qualifie certaines feuilles de plantes qui ont des saillies creuses en dessous."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "31bce53d-a729-467d-911d-10dd6d36d1fd",
                                "sense_id": "99911f7a-e494-3406-a6b7-936567e7877b",
                                "text": "Les feuilles des choux sont bosselées."
                            }
                        ]
                    }
