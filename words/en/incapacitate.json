    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5725e271-59a1-3876-88c8-b95dbf853aa0",
                    "sense_definition": "To make someone or something incapable of normal activity or function; to disable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer was <w>incapacitated</w> by a blow to the head."
                        },
                        {
                            "text": "A severe back injury can completely <w>incapacitate</w> an athlete for several months."
                        }
                    ],
                    "synonyms": [
                        "disable",
                        "prostrate"
                    ],
                    "common_phrases": [
                        "completely incapacitate",
                        "incapacitate an opponent"
                    ]
                },
                {
                    "sense_id": "9aade598-dd5f-3fdf-8e4b-cb33a68a4aea",
                    "sense_definition": "To prevent an offender from committing further crimes, typically by imprisonment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "penal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The primary goal of the new sentencing guidelines was to <w>incapacitate</w> habitual offenders."
                        },
                        {
                            "text": "Long prison terms are often intended to <w>incapacitate</w> dangerous criminals and protect society."
                        }
                    ],
                    "common_phrases": [
                        "incapacitate offenders",
                        "incapacitate criminals"
                    ]
                },
                {
                    "sense_id": "6b61645d-1ac6-3a0a-a7f8-df1fcee9fa7e",
                    "sense_definition": "To make someone legally ineligible or disqualified.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disqualify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conviction served to <w>incapacitate</w> him from holding public office."
                        },
                        {
                            "text": "A conflict of interest might legally <w>incapacitate</w> an attorney from taking the case."
                        }
                    ],
                    "common_phrases": [
                        "incapacitate from holding office"
                    ]
                }
            ]
        }
    ]
