                    {
                        "translation_id": "68b48617-27ff-4d93-8f1c-3bec289a4db5",
                        "source_entry_id": "3a8e99d1-f462-37c9-8b84-89fb9ffa5964",
                        "source_sense_id": "6decb258-67d2-308d-9708-0b474edb151e",
                        "target_lang_word": "упоение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "упоение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8f33f719-8bd9-32a7-b9d8-80c7000b6c5f",
                                        "entry_id": "86293bc1-cf96-379b-a7c5-5b67a3989b1c",
                                        "glosses": [
                                            "восторг, восхищение, экстаз"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd8f3d5-3140-478e-9813-de2c38b7ff4d",
                                                "sense_id": "8f33f719-8bd9-32a7-b9d8-80c7000b6c5f",
                                                "text": "Скоро осмотрелись русские, опомнились от упоения победы; настали для них опять скорби, заботы и беды."
                                            },
                                            {
                                                "example_id": "b9d66fce-c99b-429d-bb08-0387c15b359c",
                                                "sense_id": "8f33f719-8bd9-32a7-b9d8-80c7000b6c5f",
                                                "text": "В особенности его пленяла Жорж Занд в своих первых романах. Он зачитывался ими до упоения, находил в них неисчерпаемый источник той анонимной восторженности, которая чаще всего лежит в основании юношеских верований и стремлений."
                                            },
                                            {
                                                "example_id": "5075de81-0c59-43a4-8cb8-16dad3d3354a",
                                                "sense_id": "8f33f719-8bd9-32a7-b9d8-80c7000b6c5f",
                                                "text": "Мишенька прислуживал за столом с упоением."
                                            },
                                            {
                                                "example_id": "57974869-60a7-4e2a-ab68-1bbacdbe75f2",
                                                "sense_id": "8f33f719-8bd9-32a7-b9d8-80c7000b6c5f",
                                                "text": "Её звали Еленой (о, с каким упоением я произносил вслух, оставаясь один, это звучное имя с протяжными и нежными буквами!)."
                                            },
                                            {
                                                "example_id": "17d92a27-a690-4cad-a419-c014d3df3f20",
                                                "sense_id": "8f33f719-8bd9-32a7-b9d8-80c7000b6c5f",
                                                "text": "И я в упоении целовал её душистые руки с колючими перстнями и не знал, что сказать ей, от счастья…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
