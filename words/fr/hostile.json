{
    "word_family": [
        "hostilité",
        "hostilement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "93ee0b5e-95b6-32cd-89ce-7942af1d9450",
                    "sense_definition": "Qui manifeste de l'opposition, du rejet ou de l'animosité envers quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment_opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur s'est montré particulièrement <w>hostile</w> à toutes nos propositions de réforme."
                        },
                        {
                            "text": "Les habitants du quartier se sont montrés <w>hostiles</w> à la construction de l'autoroute."
                        }
                    ],
                    "antonyms": [
                        "favorable",
                        "amical"
                    ],
                    "common_phrases": [
                        "environnement hostile",
                        "hostile au changement",
                        "regard hostile"
                    ]
                },
                {
                    "sense_id": "9f3cc34e-344d-3a7c-a3bc-bc77cfab5a4c",
                    "sense_definition": "Qui appartient à un ennemi, qui provient de lui ou qui le caractérise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guerre_ennemi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont repéré des troupes <w>hostiles</w> qui s'approchaient de la frontière."
                        },
                        {
                            "text": "L'avion de reconnaissance a survolé un territoire <w>hostile</w> sans se faire détecter."
                        }
                    ],
                    "synonyms": [
                        "ennemi"
                    ],
                    "antonyms": [
                        "allié",
                        "ami"
                    ],
                    "common_phrases": [
                        "troupes hostiles",
                        "forces hostiles",
                        "territoire hostile"
                    ]
                },
                {
                    "sense_id": "b66d2504-c8b5-3040-a5ab-8a8e8e58c957",
                    "sense_definition": "Qualifie une offre publique d'achat engagée sans l'accord préalable des dirigeants de l'entreprise ciblée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le groupe bancaire a lancé une OPA <w>hostile</w> pour prendre le contrôle de son concurrent."
                        },
                        {
                            "text": "Face à cette tentative de rachat <w>hostile</w>, les actionnaires ont décidé d'unir leurs forces."
                        }
                    ],
                    "antonyms": [
                        "amicale"
                    ],
                    "common_phrases": [
                        "OPA hostile",
                        "offre hostile"
                    ]
                }
            ]
        }
    ]
}