{
    "word_family": [
        "habit",
        "habituate",
        "habituation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6474c666-1b77-3c34-b816-7aa723a6a3a4",
                    "sense_definition": "Regular or usual.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor took his <w>habitual</w> seat at the conference table.",
                            "target_lang_translations": {
                                "pl": "Profesor zajął swoje <w>zwyczajowe</w> miejsce przy stole konferencyjnym."
                            }
                        },
                        {
                            "text": "She returned to her <w>habitual</w> routine after the long vacation.",
                            "target_lang_translations": {
                                "pl": "Po długich wakacjach wróciła do swojej <w>stałej</w> rutyny."
                            }
                        }
                    ],
                    "synonyms": [
                        "customary"
                    ],
                    "common_phrases": [
                        "habitual seat",
                        "habitual routine"
                    ],
                    "target_lang_definitions": {
                        "pl": "Regularny lub zwyczajowy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwyczajowy",
                                "target_lang_sense_clarification": "odnoszący się do utartych zwyczajów"
                            },
                            {
                                "target_lang_word": "stały",
                                "target_lang_sense_clarification": "odnoszący się do czegoś, co dzieje się regularnie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e156393f-607f-3870-8436-3f8530bfee73",
                    "sense_definition": "Performed repeatedly or established as a habit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>habitual</w> lying was the main reason for the mistrust.",
                            "target_lang_translations": {
                                "pl": "Jej <w>nawykowe</w> kłamstwa były głównym powodem braku zaufania."
                            }
                        },
                        {
                            "text": "The <w>habitual</w> use of tobacco is harmful to your health.",
                            "target_lang_translations": {
                                "pl": "<w>Nałogowe</w> używanie tytoniu jest szkodliwe dla zdrowia."
                            }
                        }
                    ],
                    "synonyms": [
                        "accustomed"
                    ],
                    "common_phrases": [
                        "habitual use",
                        "habitual lying"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykonywany wielokrotnie lub utrwalony jako nawyk."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nałogowy",
                                "target_lang_sense_clarification": "odnoszący się do kompulsywnego powtarzania czynności"
                            },
                            {
                                "target_lang_word": "nawykowy",
                                "target_lang_sense_clarification": "wynikający z wyrobionego nawyku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa58b290-82f7-3e3f-9f0d-0e61d1650236",
                    "sense_definition": "Describing a person who engages in a specific behavior regularly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>habitual</w> chain-smoker who wants to quit.",
                            "target_lang_translations": {
                                "pl": "Jest <w>nałogowym</w> palaczem, który chce rzucić palenie."
                            }
                        },
                        {
                            "text": "The police are looking for the <w>habitual</w> offender who keeps stealing cars.",
                            "target_lang_translations": {
                                "pl": "Policja szuka <w>recydywisty</w>, który ciągle kradnie samochody."
                            }
                        }
                    ],
                    "common_phrases": [
                        "habitual smoker",
                        "habitual offender"
                    ],
                    "target_lang_definitions": {
                        "pl": "Opisujący osobę, która regularnie angażuje się w określone zachowanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nałogowy",
                                "target_lang_sense_clarification": "osoba uzależniona od jakiejś czynności"
                            },
                            {
                                "target_lang_word": "recydywista",
                                "target_lang_sense_clarification": "osoba wielokrotnie popełniająca przestępstwa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "550f5a48-03a8-3d5e-90c5-90f64c228908",
                    "sense_definition": "Relating to a grammatical aspect that expresses an action performed customarily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In linguistics, the <w>habitual</w> aspect describes actions that occur regularly over time.",
                            "target_lang_translations": {
                                "pl": "W językoznawstwie aspekt <w>habitualny</w> opisuje czynności, które zachodzą regularnie w czasie."
                            }
                        },
                        {
                            "text": "The <w>habitual</w> construction in this language uses a specific suffix.",
                            "target_lang_translations": {
                                "pl": "Konstrukcja <w>habitualna</w> w tym języku używa określonego przyrostka."
                            }
                        }
                    ],
                    "synonyms": [
                        "consuetudinal"
                    ],
                    "common_phrases": [
                        "habitual aspect"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dotyczący aspektu gramatycznego wyrażającego czynność wykonywaną zwyczajowo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "habitualny",
                                "target_lang_sense_clarification": "termin językoznawczy określający aspekt czynnościowy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74386175-ebc4-33be-b5c0-38bd6520c2fb",
                    "sense_definition": "A person who does something repeatedly, often used for serial offenders.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prison system struggles to rehabilitate <w>habituals</w> who return after release.",
                            "target_lang_translations": {
                                "pl": "System więziennictwa ma trudności z resocjalizacją <w>recydywistów</w>, którzy wracają po zwolnieniu."
                            }
                        },
                        {
                            "text": "The judge gave a longer sentence to the <w>habituals</w> due to their criminal history.",
                            "target_lang_translations": {
                                "pl": "Sędzia wydał dłuższy wyrok dla <w>recydywistów</w> ze względu na ich historię kryminalną."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba, która robi coś wielokrotnie, często używane w odniesieniu do przestępców."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "recydywista",
                                "target_lang_sense_clarification": "osoba wielokrotnie karana"
                            },
                            {
                                "target_lang_word": "nałogowiec",
                                "target_lang_sense_clarification": "osoba z silnym uzależnieniem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4ad7c26-a7ed-3e7a-b89b-11e7b0895159",
                    "sense_definition": "A grammatical construction representing an action done habitually.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many languages use specific verb forms to mark <w>habituals</w>.",
                            "target_lang_translations": {
                                "pl": "Wiele języków używa określonych form czasownika do oznaczania <w>form habitualnych</w>."
                            }
                        },
                        {
                            "text": "Stative verbs are often excluded from being used as <w>habituals</w> in this context.",
                            "target_lang_translations": {
                                "pl": "Czasowniki stanu są często wykluczone z użycia jako <w>formy habitualne</w> w tym kontekście."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Konstrukcja gramatyczna reprezentująca czynność wykonywaną zwyczajowo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "formy habitualne",
                                "target_lang_sense_clarification": "konstrukcje językowe wyrażające powtarzalność"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}