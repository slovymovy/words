                                        "glosses": [
                                            "The emotion of being happy; joy; elation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "080ba087-9883-41e5-9b74-45fb8187f508",
