                        "entry_id": "3d89b16b-b476-3c9f-b56b-36f1dd8f961b",
                        "glosses": [
                            "An admonisher; a monitor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21df45f6-87f1-4c42-9ffd-d730ab90ac1f",
                                "sense_id": "4e7a3ee3-a6e5-3876-926c-649ca5fac151",
                                "text": "But as a wyckyd person he contemnyd all admonicions, desirid to finishe his treyterons purpose, and after that he had eatyn of that holy supper, he depertyd out of Christes companye, and with all dil[i]gence sowght how to haue his admonitour slaine."
                            },
                            {
                                "example_id": "75b1d056-b9ea-413b-b559-30f6547ade80",
                                "sense_id": "4e7a3ee3-a6e5-3876-926c-649ca5fac151",
                                "text": "[…] mens hearts rise and swell against faithful Admonitors, and they must not be reproved or contradicted."
                            },
                            {
                                "example_id": "d9a0e4a0-6157-49b9-9ef4-5f9674c87dea",
                                "sense_id": "4e7a3ee3-a6e5-3876-926c-649ca5fac151",
                                "text": "Conscience is […] at most times a very faithful and a very prudent admonitor."
                            }
                        ]
                    }
