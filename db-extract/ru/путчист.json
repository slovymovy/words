                        "examples": [
                            {
                                "example_id": "dfd2c856-1fcb-4f18-bd1a-1b49a7e49cd4",
                                "sense_id": "24be5ef8-ec87-3135-a051-de14ed35d967",
                                "text": "Нашлись люди, которые не испугались путчистов и взялись за руки в людской цепи перед зданием Белого дома."
                            }
                        ]
                    }
                ],
