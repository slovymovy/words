                                        "entry_id": "4072bb70-f599-3d4f-b3ae-8d7439c8778b",
                                        "glosses": [
                                            "Tricycle motorisé servant généralement de taxi, en Extrême-Orient ou parfois ailleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41339e7-7a7f-4ee6-be0f-54a507f8318e",
                                                "sense_id": "a1111228-dad5-3729-89ed-cda7f781e2f3",
                                                "text": "De là, j’ai pris un tuk-tuk pour une guesthouse que j’avais choisie dans le Guide du Routard, située entre Dambulla et Sigiriya."
                                            },
                                            {
                                                "example_id": "174cbd15-d21f-4c71-b6fc-d8a3e01db411",
                                                "sense_id": "a1111228-dad5-3729-89ed-cda7f781e2f3",
                                                "text": "Il arrêta un tuk-tuk d’un sifflement."
                                            },
                                            {
                                                "example_id": "1290c831-43ed-4908-aa00-0ad5f48def60",
                                                "sense_id": "a1111228-dad5-3729-89ed-cda7f781e2f3",
                                                "text": "Pendant une semaine, ils voyageront en se servant des moyens de transport à leur disposition : du tuk-tuk en passant par le cheval, la pirogue et la bétaillère."
                                            },
                                            {
                                                "example_id": "11f00a01-fc16-437a-8d05-e0bc0364283c",
                                                "sense_id": "a1111228-dad5-3729-89ed-cda7f781e2f3",
                                                "text": "Ouvert sur le trottoir, le hangar abritait une dizaine de tuk-tuk."
                                            }
                                        ]
