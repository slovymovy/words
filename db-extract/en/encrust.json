                                    {
                                        "sense_id": "ea837616-da62-3537-ad7e-f9af72c946f2",
                                        "entry_id": "9e036479-ce0f-310e-9034-655a97d4a1ec",
                                        "glosses": [
                                            "eine harte, unelastische Oberfläche (Kruste) bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc08fe7b-ec98-4358-a87a-9921a6a3128e",
                                                "sense_id": "ea837616-da62-3537-ad7e-f9af72c946f2",
                                                "text": "Die sich durch die Infektion auf der Haut bildenden Bläschen verkrusten mit der Zeit."
                                            },
                                            {
                                                "example_id": "c50118e6-72a9-4cce-af3c-e09beca820f3",
                                                "sense_id": "ea837616-da62-3537-ad7e-f9af72c946f2",
                                                "text": "Sie schälte sich die vom Schlamm verkrusteten Kleider vom Leibe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "521d22e2-0b4f-32c1-b8fb-1dd747abfaef",
                                        "entry_id": "9e036479-ce0f-310e-9034-655a97d4a1ec",
                                        "glosses": [
                                            "unflexibel werden, sich nicht mehr anpassen oder weiterentwickeln"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69fbe5fc-2174-49b4-bab3-78ce0b288f88",
                                                "sense_id": "521d22e2-0b4f-32c1-b8fb-1dd747abfaef",
                                                "text": "„Familien, die diesen Austausch nicht haben, sich zu sehr »einigeln«, laufen Gefahr zu verkrusten, sich eine eigene Welt aufzubauen, die mit der Realität und der Vielfalt des Lebens nichts mehr zu tun hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
