                        "examples": [
                            {
                                "example_id": "f108d96f-f81e-44ce-8c49-04a4f72d0b47",
                                "sense_id": "f6aecbd6-5b83-3498-bf95-d399b87e13b8",
                                "text": "Artrose: Vaak gaat het om liet kniegewricht (gonartrose), heupgewricht (coxartrose) of wervels (spondylose). Ook aan de vingers komt artrose vaak voor, met name aan de eindkootjes."
                            },
                            {
                                "example_id": "fc287250-d931-4932-a33e-1778fa733b86",
                                "sense_id": "f6aecbd6-5b83-3498-bf95-d399b87e13b8",
                                "text": "Aan de buitenkant van het heupbeen zit de kom voor het heupgewricht op de plaats waar het darmbeen, het schaambeen en het zitbeen met elkaar vergroeid zijn. In deze kom past de kop van het dijbeen. De heupkom heet ook wel acetabulum."
                            }
                        ]
