                "senses": [
                    {
                        "sense_id": "175d2559-444a-3746-a0d4-f98ac6ea1fac",
                        "entry_id": "c4e29244-6ca4-3ebb-b13f-0e7744e7ed95",
                        "glosses": [
                            "eine Umgestaltung eines Objektes, so dass es gegenüber seiner Urform kleiner ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798379b7-5363-4d9a-9767-de92d06d5377",
                                "sense_id": "175d2559-444a-3746-a0d4-f98ac6ea1fac",
                                "text": "Durch die Verkleinerung seines Königreiches hat er nun eine Verkleinerung der Staatseinnahmen zu erwarten."
                            },
                            {
                                "example_id": "7e2b0e76-b454-4cbc-a688-decea22f5353",
                                "sense_id": "175d2559-444a-3746-a0d4-f98ac6ea1fac",
                                "text": "„Eine weitere Verkleinerung des Genpools könnte langfristig das Risiko für Inzucht und damit verbundene Gesundheitsprobleme erhöhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d87d6da3-cf1d-34d0-8125-f25e8e4e11d9",
                        "entry_id": "c4e29244-6ca4-3ebb-b13f-0e7744e7ed95",
                        "glosses": [
                            "eine Kopie eines Objektes, die gegenüber dem Original kleiner ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e805bb3-05e3-4a97-969d-30d75d8da4f3",
                                "sense_id": "d87d6da3-cf1d-34d0-8125-f25e8e4e11d9",
                                "text": "Stellen sie mir eine Verkleinerung des Fotos her."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23ee8b89-f774-4b62-bb9f-33b0992ba878",
                        "source_entry_id": "c4e29244-6ca4-3ebb-b13f-0e7744e7ed95",
                        "source_sense_id": "175d2559-444a-3746-a0d4-f98ac6ea1fac",
                        "source_sense_description": "eine Umgestaltung eines Objektes, so dass es gegenüber seiner Urform kleiner ist",
                        "target_lang_word": "diminishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diminishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bea2775-170c-30f6-8286-076f8ce3c4af",
                                        "entry_id": "26e2754d-33e2-3566-9a10-31c509ffaac9",
                                        "glosses": [
                                            "The act of diminishing; reducing in size, quantity, or quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb0029b8-b72a-41fa-bb32-e38424e6bb97",
                                                "sense_id": "2bea2775-170c-30f6-8286-076f8ce3c4af",
                                                "text": "They also shewed forth the letters which hee had sent to the Duke of Irelande, to leuie an armie vnto theyr destruction. Likewise the letters which the Frenche king had written to him conteyning a safe conducte for him to come into Fraunce, there to confyrme things to the diminishment of his honor, to the decay of his power, and losse of his fame."
                                            },
                                            {
                                                "example_id": "b78b709c-09dd-40cb-9f3d-987f1e84c9d7",
                                                "sense_id": "2bea2775-170c-30f6-8286-076f8ce3c4af",
                                                "text": "1902, G. K. Chesterton, “The Characteristics of Robert Louis Stevenson” in G. K. Chesterton and William Robertson Nicoll, Robert Louis Stevenson, London: Hodder and Stoughton, p. 9,\nAll great men possess in themselves the qualities which will certainly lay them open to censure and diminishment; but these inevitable deficiencies in the greatness of great men vary in the widest degree of variety."
                                            },
                                            {
                                                "example_id": "98ff0be4-1ccc-4475-b283-32953ec8d997",
                                                "sense_id": "2bea2775-170c-30f6-8286-076f8ce3c4af",
                                                "text": "1929, William Faulkner, The Sound and the Fury, New York: Vintage, 1946, Appendix, “Quentin,” p. 424,\n[…] this was Jason’s rage, the red unbearable fury which on that night and at intervals recurring with little or no diminishment for the next five years, made him seriously believe would at some unwarned instant destroy him […]"
                                            },
                                            {
                                                "example_id": "756930bd-2313-4537-9e7e-e4636745144d",
                                                "sense_id": "2bea2775-170c-30f6-8286-076f8ce3c4af",
                                                "text": "I think the Western tradition has been a marvelous, wonderful tradition. But it’s not the only tradition full of great ideas. And I’m not talking about any diminishment of standards. Even by the most conservative notion of what is good and bad, we will find excellence in other cultures, like the great Indian cultures, the great Chinese cultures, the great African cultures."
                                            },
                                            {
                                                "example_id": "00d2faaa-50a3-47dd-a868-edd880c20a98",
                                                "sense_id": "2bea2775-170c-30f6-8286-076f8ce3c4af",
                                                "text": "The impact on rural communities of rail closures was acute, but I would argue that the worst outcome it created was the long-term diminishment of suburban capacity outside London, which has had a far more insidious effect on rail usage nationally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22dd382c-c1b1-4aae-88cd-f3802be146d2",
                        "source_entry_id": "c4e29244-6ca4-3ebb-b13f-0e7744e7ed95",
                        "source_sense_id": "175d2559-444a-3746-a0d4-f98ac6ea1fac",
                        "source_sense_description": "eine Umgestaltung eines Objektes, so dass es gegenüber seiner Urform kleiner ist",
                        "target_lang_word": "diminution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diminution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3608326c-1ade-3266-a7bd-2cd37d4a3eb1",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Action de diminuer, fait de devenir moindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00bc1485-59c4-41e7-8009-0791b4c036be",
                                                "sense_id": "3608326c-1ade-3266-a7bd-2cd37d4a3eb1",
                                                "text": "Le fait le plus remarquable à signaler est la diminution sensible du nombre des voiliers armés. En 1911, les ports de Reykiavik et d’Hafnarfjord envoyaient à la mer 43 dundees ; l'année dernière, ce nombre était réduit à 36; cette année, il est tombé à 22."
                                            },
                                            {
                                                "example_id": "0d2dc2ed-8f8d-4d43-aceb-7e3d26862a8d",
                                                "sense_id": "3608326c-1ade-3266-a7bd-2cd37d4a3eb1",
                                                "text": "La crue de cette rivière est en diminution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3934008-4521-366b-a5bc-a99d0c977071",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Action de diminuer, fait de devenir moindre.",
                                            "Réduction des prix, rabais, remise, ristourne, abattement."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b025e4-f416-48ed-9cee-ab02b5bb9561",
                                                "sense_id": "d3934008-4521-366b-a5bc-a99d0c977071",
                                                "text": "Obtenir une diminution dans le prix de son bail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a11565f-f96c-3f3a-85f4-17256c3a016b",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Action de diminuer, fait de devenir moindre.",
                                            "Rétrécissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21634237-c2d3-45a9-b72e-9f4bdd4b1f74",
                                                "sense_id": "0a11565f-f96c-3f3a-85f4-17256c3a016b",
                                                "text": "Diminution d'une colonne, rétrécissement graduel du fût de la colonne, à partir du bas ou seulement du tiers de la hauteur, jusqu'au chapiteau"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372b291e-07ac-37b7-a1c2-4b461582d903",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Action de diminuer, fait de devenir moindre.",
                                            "Réduction du temps ou de la valeur d'une note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec3dfbde-9867-4fad-98d7-fa114003c58c",
                                                "sense_id": "372b291e-07ac-37b7-a1c2-4b461582d903",
                                                "text": "L'imitation par diminution se fait lorsque le conséquent diminue la valeur des notes qui constituent l'imitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a98abf7-b88a-393e-90d8-abeb9267a76a",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Action de diminuer, fait de devenir moindre.",
                                            "Vitesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b01811c-11af-4f5e-87dd-1a6e0a78e0d8",
                                                "sense_id": "3a98abf7-b88a-393e-90d8-abeb9267a76a",
                                                "text": "La précédente diminution de la vitesse a aussi permis “une baisse de 15%” des accidents “sur les premiers mois” qui ont suivi son introduction, poursuit David Belliard, indiquant se baser sur une étude de l’époque de l’Agence de l’environnement et de la maîtrise de l’énergie (Ademe)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1525394-6cd7-3d2e-85f8-6739d41e29e0",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Réduction du nombre de mailles d’un rang en cours de tricotage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c10642a-0e55-383e-bf7f-1dfb030a819c",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Atténuation, adoucissement, apaisement."
                                        ],
                                        "tags": [
                                            "Au sens abstrait",
                                            "pour une réalité non mesurable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dbeb0ef-9d28-4582-a812-0dc0bd941456",
                                                "sense_id": "9c10642a-0e55-383e-bf7f-1dfb030a819c",
                                                "text": "Son but [à l'héroïsme moderne], qui est la découverte du vrai et la diminution de la misère universelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15367e7-e7e6-3b02-94a3-fd71bdb7cff3",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Atténuation, adoucissement, apaisement.",
                                            "Affaiblissement, déclin."
                                        ],
                                        "tags": [
                                            "Au sens abstrait",
                                            "pour une réalité non mesurable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e785d29-6f1b-4e2a-b010-4a7e6e121705",
                                                "sense_id": "d15367e7-e7e6-3b02-94a3-fd71bdb7cff3",
                                                "text": "cette diminution progressive qui s'appelle vieillir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7acfbc4-4a62-3ba1-84ac-6ac280c21927",
                                        "entry_id": "95bbfba5-42e0-3531-a2eb-bf8b11599823",
                                        "glosses": [
                                            "Ornement, utilisé à la Renaissance et à l’époque baroque, consistant à lier deux notes longues par une succession de notes jouées à un rythme régulier, souvent improvisées, les notes ajoutées ayant donc une durée plus courte que les notes originelles, et représentant en général des intervalles plus petits."
                                        ],
