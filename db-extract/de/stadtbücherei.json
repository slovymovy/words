                "senses": [
                    {
                        "sense_id": "b9d61555-0c56-3fdd-8183-fc6b7b8894f7",
                        "entry_id": "7e1af87a-2ff7-36ba-982a-d4fc1ab886a6",
                        "glosses": [
                            "öffentliche Bibliothek in städtischer Trägerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc951329-3498-4836-a019-9982071ff441",
                                "sense_id": "b9d61555-0c56-3fdd-8183-fc6b7b8894f7",
                                "text": "Die Stadtbücherei veranstaltet am Samstag einen Bücherflohmarkt."
                            },
                            {
                                "example_id": "a7b13d97-2a99-4c45-834b-97f19732357c",
                                "sense_id": "b9d61555-0c56-3fdd-8183-fc6b7b8894f7",
                                "text": "„In der Stadtbücherei in Koblenz konnte man sich über Kopfhörer Platten anhören, aber die fünf Kopfhörer waren immer besetzt.“"
                            },
                            {
                                "example_id": "8a38e653-ca87-4fd4-a3bf-a7ff86cdbcd6",
                                "sense_id": "b9d61555-0c56-3fdd-8183-fc6b7b8894f7",
                                "text": "„Gehen Sie mal in die Stadtbücherei Ihres Bezirks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
