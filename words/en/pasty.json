{
    "word_family": [
        "paste"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97c43826-5818-388c-91bb-6a3d893f576c",
                    "sense_definition": "Having a sticky, thick consistency similar to paste.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sauce became <w>pasty</w> after sitting out for too long.",
                            "target_lang_translations": {
                                "zh": "酱汁放久了变得<w>糊状</w>了。"
                            }
                        },
                        {
                            "text": "These mashed potatoes are <w>pasty</w> because they were overmixed.",
                            "target_lang_translations": {
                                "zh": "这些土豆泥因为搅拌过度变得<w>糊状</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pasty texture"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有像浆糊一样粘稠的质地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "糊状的",
                                "target_lang_sense_clarification": "形容物质粘稠如浆糊。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e488f13a-5cb3-36f1-8646-ddd77866497e",
                    "sense_definition": "Unhealthily pale or lacking color in the face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You look a bit <w>pasty</w> today; are you feeling alright?",
                            "target_lang_translations": {
                                "zh": "你今天看起来脸色有点<w>苍白</w>，身体还好吗？"
                            }
                        },
                        {
                            "text": "He looked <w>pasty</w> after spending the entire winter indoors.",
                            "target_lang_translations": {
                                "zh": "整个冬天都待在室内，他看起来脸色<w>苍白</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pasty-faced"
                    ],
                    "common_phrases": [
                        "pasty complexion"
                    ],
                    "target_lang_definitions": {
                        "zh": "脸色苍白，看起来不健康。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "苍白的",
                                "target_lang_sense_clarification": "形容人脸色因生病或缺乏阳光而显得苍白。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51babfca-f0b3-348a-9939-8e0cfb29b2e9",
                    "sense_definition": "Having white skin, often used in a derogatory or informal context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character was described as a <w>pasty</w> man from the northern regions.",
                            "target_lang_translations": {
                                "zh": "这个角色被描述为一个来自北方、<w>皮肤惨白</w>的男人。"
                            }
                        },
                        {
                            "text": "He felt out of place among the <w>pasty</w> tourists on the beach.",
                            "target_lang_translations": {
                                "zh": "在海滩上那些<w>皮肤惨白</w>的游客中，他感到格格不入。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in a derogatory or informal manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指皮肤白皙，常用于非正式或贬义语境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮肤惨白的",
                                "target_lang_sense_clarification": "形容人皮肤非常白，有时带有贬义。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "688375bc-a4b6-395c-9731-303197d6eba6",
                    "sense_definition": "A baked pastry filled with seasoned meat and vegetables, typically semicircular.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a warm meat <w>pasty</w> from the local bakery.",
                            "target_lang_translations": {
                                "zh": "我们从当地的面包店买了一个热乎乎的<w>肉馅饼</w>。"
                            }
                        },
                        {
                            "text": "The traditional Cornish <w>pasty</w> is a hearty meal for workers.",
                            "target_lang_translations": {
                                "zh": "传统的康沃尔<w>肉馅饼</w>是工人们的一顿饱餐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "meat pasty",
                        "Cornish pasty"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种内馅为肉和蔬菜的烘焙糕点，通常呈半圆形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肉馅饼",
                                "target_lang_sense_clarification": "指英式肉馅饼，通常为半圆形。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14f2f64-632f-30c9-b9bd-bd0a768700f2",
                    "sense_definition": "A small adhesive covering for a woman's nipple, often used by exotic dancers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer carefully applied a <w>pasty</w> before her performance.",
                            "target_lang_translations": {
                                "zh": "舞者在表演前小心地贴上了<w>乳贴</w>。"
                            }
                        },
                        {
                            "text": "She wore a sequined <w>pasty</w> as part of her stage costume.",
                            "target_lang_translations": {
                                "zh": "她戴着一个亮片<w>乳贴</w>作为舞台服装的一部分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nipple pastie",
                        "nipple pasty"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种贴在女性乳头上的小型遮盖物，常用于舞台表演。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乳贴",
                                "target_lang_sense_clarification": "用于遮盖乳头的装饰性贴片。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}