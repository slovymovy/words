                                                "sense_id": "4cc38110-af6d-3088-aeed-6314b4b6b960",
                                                "text": "De brief rook vaag naar een ongewoon parfum en had ezelsoren, alsof Marjorie Quick hem een paar dagen in haar handtas had bewaard, voordat ze uiteindelijk had besloten hem op de bus te doen."
                                            },
                                            {
                                                "example_id": "7fc67acd-3c14-48a1-a3b3-3535e96b7e47",
                                                "sense_id": "4cc38110-af6d-3088-aeed-6314b4b6b960",
                                                "text": "Het is mijn Senegalese buurman met een envelop die per ongeluk in zijn bus was beland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b8af79f-95a8-33b1-a1ac-2a843905a3ff",
                                        "entry_id": "8486efe3-396c-3c9c-ac84-79425c867449",
                                        "glosses": [
                                            "een standaardmethode voor het verbinden van de onderdelen van een computer"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c61185e1-3aef-48fc-8a7c-a310c6682eb8",
                        "source_entry_id": "01698213-c711-336d-8342-40b053b00ece",
