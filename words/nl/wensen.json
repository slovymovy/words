            "senses": [
                {
                    "sense_id": "6f90be7b-96ff-3e8a-8cc5-30a8daf02871",
                    "sense_definition": "De hoop uitspreken dat iemand iets, meestal iets goeds, zal ervaren of ontvangen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wish_someone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wens</w> je een heel fijne verjaardag en veel plezier.",
                            "target_lang_translations": {
                                "en": "I <w>wish</w> you a very happy birthday and lots of fun.",
                                "ru": "Я <w>желаю</w> тебе чудесного дня рождения и хорошо повеселиться.",
                                "pl": "<w>Życzę</w> ci bardzo udanych urodzin i dobrej zabawy.",
                                "de": "Ich <w>wünsche</w> dir einen sehr schönen Geburtstag und viel Spaß.",
                                "fr": "Je te <w>souhaite</w> un très joyeux anniversaire et beaucoup de plaisir.",
                                "it": "Ti <w>auguro</w> un felicissimo compleanno e tanto divertimento.",
                                "cs": "<w>Přeji</w> ti všechno nejlepší k narozeninám a hodně zábavy.",
                                "tr": "Sana çok güzel bir doğum günü ve bol eğlence <w>diliyorum</w>.",
                                "es": "Te <w>deseo</w> un muy feliz cumpleaños y que te diviertas mucho.",
                                "zh": "我<w>祝</w>你生日快乐，玩得开心。"
                            }
                        },
                        {
                            "text": "Wij <w>wensen</w> jullie veel succes met de nieuwe baan.",
                            "target_lang_translations": {
                                "en": "We <w>wish</w> you good luck with the new job.",
                                "ru": "Мы <w>желаем</w> вам больших успехов на новой работе.",
                                "pl": "<w>Życzymy</w> wam powodzenia w nowej pracy.",
                                "de": "Wir <w>wünschen</w> euch viel Erfolg bei der neuen Arbeit.",
                                "fr": "Nous vous <w>souhaitons</w> beaucoup de succès dans votre nouveau travail.",
                                "it": "Vi <w>auguriamo</w> buona fortuna con il nuovo lavoro.",
                                "cs": "<w>Přejeme</w> vám hodně štěstí v nové práci.",
                                "tr": "Yeni işinizde size başarılar <w>diliyoruz</w>.",
                                "es": "Les <w>deseamos</w> mucho éxito en el nuevo trabajo.",
                                "zh": "我们<w>祝</w>你们在新工作中一切顺利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toewensen"
                    ],
                    "common_phrases": [
                        "iemand geluk wensen",
                        "iemand het beste wensen",
                        "beterschap wensen"
                    ],
                    "target_lang_definitions": {
                        "en": "To express the hope that someone will experience or receive something, usually something good",
                        "ru": "Выражать надежду на то, что кто-то испытает или получит что-то, обычно хорошее",
                        "pl": "Wyrażać nadzieję, że ktoś doświadczy lub otrzyma coś, zazwyczaj coś dobrego",
                        "de": "Den Wunsch äußern, dass jemand etwas, meist etwas Gutes, erlebt oder erhält.",
                        "fr": "Exprimer l'espoir que quelqu'un vive ou reçoive quelque chose, généralement quelque chose de positif.",
                        "it": "Esprimere la speranza che qualcuno riceva o sperimenti qualcosa, solitamente di positivo.",
                        "cs": "Vyjádření naděje, že někdo něco zažije nebo obdrží, obvykle něco dobrého.",
                        "tr": "Birinin bir şey, genellikle iyi bir şey, yaşamasını veya almasını umduğunu ifade etmek",
                        "es": "Expresar el deseo de que alguien experimente o reciba algo, generalmente algo bueno.",
                        "zh": "表达希望某人经历或获得某事（通常是好事）的愿望"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wish",
                                "target_lang_sense_clarification": "to hope someone receives something"
                            }
                        ],
