                        "examples": []
                    },
                    {
                        "sense_id": "a9152546-742a-3dbb-a6f1-6c33e5d30378",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "A type of paint that dries with a flat (matt) finish; a coating of such paint."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6ad3daaa-d955-45f6-ac82-f1a3dafb426f",
                                "sense_id": "a9152546-742a-3dbb-a6f1-6c33e5d30378",
                                "text": "Bankart is of opinion that “an important point as regards painters on board ship is to recognize the fact that there is danger of poisoning, whenever quick-drying paints and flattings are being used in inclosed spaces,[…].”"
                            }
                        ]
                    },
                    {
                        "sense_id": "41ed19e5-d105-3ec9-8258-fee5db2dce8a",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "The process of applying a coating of flatting paint."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5cefac27-34b8-3939-98d2-0d1386a304c1",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "A flat part of something, a flattening."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5dc27170-5365-41f1-aae8-d198b32e4ee3",
                                "sense_id": "5cefac27-34b8-3939-98d2-0d1386a304c1",
                                "text": "I have been informed, that there are some tribes in whom the posterior part of the head is flattened instead of the front part, and that these depressions and flattings of the head are produced by such artificial pressure."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdfa5370-908b-3e43-b146-a9892ab502e5",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "The process of becoming flat."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "669e6fda-36f1-3b81-ac72-3cb566f57b28",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "The process of causing something to become flat; the process of flattening something."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8d33b449-e09e-45b0-9337-9a5b6332fe9c",
                                "sense_id": "669e6fda-36f1-3b81-ac72-3cb566f57b28",
                                "text": "flatting-mill"
                            },
                            {
                                "example_id": "00d2301e-7905-42ee-9d4d-352eacb44570",
                                "sense_id": "669e6fda-36f1-3b81-ac72-3cb566f57b28",
                                "text": "Flatting agents reduces gloss by scattering reflected light. The more flatting agent added, the duller the appearance and the greater the loss of film clarity."
                            },
                            {
                                "example_id": "ce686b08-5fdd-4b38-86a7-247df24458e8",
                                "sense_id": "669e6fda-36f1-3b81-ac72-3cb566f57b28",
                                "text": "Recent chemical advances allow significantly increased control of flatting behavior through the utilization of special acidic-functionality copolymeric additives."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6b5a0ba-e578-370f-9868-974bdf21bcd9",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "An instance of a musical note being flatter than intended."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "26a207f5-109e-44cc-a81f-2c4970ae2ece",
                                "sense_id": "b6b5a0ba-e578-370f-9868-974bdf21bcd9",
                                "text": "The bell ropes hang from the outside of the tower, the resultant friction of the ropes over the brick sides producing irresolute sharpings or flattings of the notes."
                            },
                            {
                                "example_id": "911e963f-eb2c-4af4-8a43-5bf9a1f8d9ad",
                                "sense_id": "b6b5a0ba-e578-370f-9868-974bdf21bcd9",
                                "text": "Leland Smith goes so far as to say, “in tonal music the minor mode has no separate existence, but represents merely a fairly consistently applied group of alterations — flattings — of certain parts of the major mode.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "e67783a8-c99a-3765-b858-4aa4f464f35d",
                        "entry_id": "b3fc1597-a606-3ce0-8617-3c7beec10cd1",
                        "glosses": [
                            "A method of preserving gilding unburnished, by touching with size."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "10a8145b-351f-48f3-a28c-00a57b75c339",
                                "sense_id": "e67783a8-c99a-3765-b858-4aa4f464f35d",
                                "text": "The Nottingham white-lead is the most esteemed for what is called flatting, or dead white."
                            }
                        ]
                    },
