                ],
                "senses": [
                    {
                        "sense_id": "d83b56f7-8f10-301f-bca8-29fa958c642e",
                        "entry_id": "3b87a44e-35f6-38cf-a35e-e0aa4225d6bf",
                        "glosses": [
                            "materielle Spielfigur, die einen Soldaten darstellt beziehungsweise Person im Rollenspiel als Soldat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac79df7-326e-47f5-83c3-9b1d1250ae7c",
                                "sense_id": "d83b56f7-8f10-301f-bca8-29fa958c642e",
                                "text": "„Aus unserem Badewannenablauf tauchte mein versunkener Spielsoldat wieder auf, der Kürassier mit dem schwarzweißen Fähnchen.“"
                            },
                            {
                                "example_id": "cde9b4a8-6703-4366-9364-747b00ec48f1",
                                "sense_id": "d83b56f7-8f10-301f-bca8-29fa958c642e",
                                "text": "„Seit dieser Niederlage verfolgten mich die kleinen deutschen Spielsoldaten mit ihrem Haß, standen oft an der Ecke der Austraße noch mit einem Heer verbündeter Jungens, rissen mir den Schulranzen vom Rücken, warfen mich zur Erde und traten und pufften mich.“"
                            },
                            {
                                "example_id": "83c81ad5-b736-4184-971b-f6dad367f74f",
                                "sense_id": "d83b56f7-8f10-301f-bca8-29fa958c642e",
                                "text": "„Selbst der Nobelpreisträger von 1919, Carl Spitteler, paradierte als Kind voller Stolz als Spielsoldat mit Papierhelm und Holzschwert.“"
                            },
                            {
                                "example_id": "5d95bdda-da98-42c7-a220-6a9ad491a4ee",
                                "sense_id": "d83b56f7-8f10-301f-bca8-29fa958c642e",
                                "text": "„Besonders schöne und kostbare Spielsoldaten hatte Ludwig XIV. als Kind: eine ganze Armee aus Silber, alles fein modelliert und ziseliert.“"
                            },
                            {
                                "example_id": "10e62d45-791f-48f3-b6f1-d19ddc9f0301",
                                "sense_id": "d83b56f7-8f10-301f-bca8-29fa958c642e",
                                "text": "„Peter verschmähte sie, kratzte auf der Geige, spielte im Bett mit Puppen, befehligte Heere von Spielsoldaten und richtete in grausamen Schauprozessen Ratten und Hunde hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
