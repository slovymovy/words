                "senses": [
                    {
                        "sense_id": "9ebba7ce-c037-3f8e-bf5c-c51e2a176a0f",
                        "entry_id": "ab074ded-e0ce-3c9f-9dd5-5718e5f62105",
                        "glosses": [
                            "een zachte, fijngeweven stof, waarbij rechtopstaande pluizen, de zg. pool van zijde of katoen met de kettingdraden zijn meegeweven en afgesneden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479bdf89-1dc2-43f6-9697-98c3bc1d9c5e",
                                "sense_id": "9ebba7ce-c037-3f8e-bf5c-c51e2a176a0f",
                                "text": "Het werd opgeborgen in een kistje gevoerd met fluweel."
                            },
                            {
                                "example_id": "577d20b0-ef3a-47a5-acf0-adde0d2c475f",
                                "sense_id": "9ebba7ce-c037-3f8e-bf5c-c51e2a176a0f",
                                "text": "De achterkamer werd gedomineerd door een monsterlijk, ondateerbaar hemelbed met vier vergulde zuilen in Egyptische stijl waarop een baldakijn rustte van donkerrood fluweel, met geborduurde sterren van gouddraad. Wie zou in staat zijn te bevroeden hoeveel zuchten en gefluisterde geheimen er onder die sterrenstof waren blijven hangen?"
                            },
                            {
                                "example_id": "a35bd22d-d37b-4d44-b5fa-6bfaac00b932",
                                "sense_id": "9ebba7ce-c037-3f8e-bf5c-c51e2a176a0f",
                                "text": "'Dat zware fluweel heb je nodig om de mist van de gracht buiten te houden,' merkt Maren op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38ba68bf-104c-444a-abf9-9e388615e632",
                        "source_entry_id": "ab074ded-e0ce-3c9f-9dd5-5718e5f62105",
                        "source_sense_id": "9ebba7ce-c037-3f8e-bf5c-c51e2a176a0f",
                        "source_sense_description": "een zachte, fijngeweven stof, waarbij rechtopstaande pluizen, de zg. pool van zijde...",
                        "target_lang_word": "velvet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "velvet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16388982-d0f5-385a-95fc-ee6f848c6bc4",
                                        "entry_id": "65f4e869-71b5-3463-9789-e40322385022",
                                        "glosses": [
                                            "A closely woven fabric (originally of silk, now also of cotton or man-made fibres) with a thick short pile on one side."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a135cf69-1831-4ffc-ab30-b9e56d3a9a46",
                                                "sense_id": "16388982-d0f5-385a-95fc-ee6f848c6bc4",
                                                "text": "For the first time since her husband's death, she had thrown off her weeds, and put on attire more suited to the occasion. She was richly, yet plainly dressed, in a purple velvet, with a hood of white point lace. Even her silent handmaids were surprised out of their ordinary propriety by her appearance."
                                            },
                                            {
                                                "example_id": "7ac95716-5166-46fb-b537-6d8de9f0c0a1",
                                                "sense_id": "16388982-d0f5-385a-95fc-ee6f848c6bc4",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace,[…]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid, […] all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627bfc43-700d-3d85-89b9-c6a305104cce",
                                        "entry_id": "65f4e869-71b5-3463-9789-e40322385022",
                                        "glosses": [
                                            "Very fine fur, including the skin and fur on a deer's antlers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeedeb1a-42d4-45da-a84b-68941b07549e",
                                                "sense_id": "627bfc43-700d-3d85-89b9-c6a305104cce",
                                                "text": "His [a hart's] head when it commeth firſt out, hath a ruſſet pyll vpon it, the which is called Veluet, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03409d0-ed78-3ca2-9a16-3fdd2dc3c812",
                                        "entry_id": "65f4e869-71b5-3463-9789-e40322385022",
                                        "glosses": [
                                            "A female chinchilla; a sow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c977fcea-7a6d-3c4f-9eeb-c4e36ad7d3ea",
                                        "entry_id": "65f4e869-71b5-3463-9789-e40322385022",
                                        "glosses": [
                                            "The drug dextromethorphan."
                                        ],
