                "translations": [
                    {
                        "translation_id": "37baf857-6050-4248-8774-48c8f5f892ea",
                        "source_entry_id": "79561150-9281-3693-9995-b49206986423",
                        "source_sense_id": "a8eb0a0d-94b6-317e-b9fe-91ce1a4f122c",
                        "target_lang_word": "Iowa",
                        "target_lang_code": "en",
