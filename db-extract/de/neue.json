                "senses": [
                    {
                        "sense_id": "808c93ae-aaa9-37fe-b3d6-edad458f0022",
                        "entry_id": "b87bed3f-2668-3de6-a0ce-3a4ada2e44b2",
                        "glosses": [
                            "weibliche Person, die irgendwo neu ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dcdabc9-bb06-44d7-9028-b1b6837d6698",
                                "sense_id": "808c93ae-aaa9-37fe-b3d6-edad458f0022",
                                "text": "„Rosa hatte trotzdem alles für gefüllte Paprika gekauft, falls die Neue nicht käme, aber die Neue kam, sogar pünktlich […].“"
                            },
                            {
                                "example_id": "6d531cbf-1bb2-4a68-b6c2-085a731c677d",
                                "sense_id": "808c93ae-aaa9-37fe-b3d6-edad458f0022",
                                "text": "„Die Neue kam nicht näher als 40 cm an Jessika heran.“"
                            },
                            {
                                "example_id": "692afb09-8789-45be-93f8-4327b641cd78",
                                "sense_id": "808c93ae-aaa9-37fe-b3d6-edad458f0022",
                                "text": "„Die Neue kam sehr zeitig auf den Hof gefahren und parkte auf Colines angestammten Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
