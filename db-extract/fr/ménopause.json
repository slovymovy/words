                "senses": [
                    {
                        "sense_id": "72ed0e9c-0d64-31d1-bd56-5e5d7725ddbd",
                        "entry_id": "f28efd1f-7633-3ec3-b40d-4d6fc5606ed6",
                        "glosses": [
                            "Cessation définitive de la fonction menstruelle, due à l'âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d74306-846f-4797-8ca8-ad16f1757d54",
                                "sense_id": "72ed0e9c-0d64-31d1-bd56-5e5d7725ddbd",
                                "text": "Les cycles anovulatoires sont fréquents pendant les 12-18 mois qui suivent la ménarche et de nouveau durant la période qui précède la ménopause."
                            },
                            {
                                "example_id": "0ef3ecd2-3dd3-42d2-a686-9b7730ba037b",
                                "sense_id": "72ed0e9c-0d64-31d1-bd56-5e5d7725ddbd",
                                "text": "L’ostéoporose se diagnostique en premier lieu par l’examen d’ostéodensitométrie (ou « densitométrie osseuse » au cours d’un interrogatoire détaillé chez le généraliste ou le gynécologue au moment de la ménopause."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "472d66a9-ced1-473d-9aa0-1d5947824f98",
                        "source_entry_id": "f28efd1f-7633-3ec3-b40d-4d6fc5606ed6",
                        "source_sense_id": "72ed0e9c-0d64-31d1-bd56-5e5d7725ddbd",
                        "target_lang_word": "Menopause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menopause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                        "entry_id": "21822c08-a006-36b9-a615-9de110686a80",
                                        "glosses": [
                                            "Zeitpunkt der letzten spontanen Regelblutung in den Wechseljahren der Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc396170-7761-4899-a9c9-edc8947670a5",
                                                "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                                "text": "Der Zeitpunkt der Menopause lag zwischen 6 und 36 Monaten zurück."
                                            },
                                            {
                                                "example_id": "2edd2bd3-e00b-4457-b396-ae6dc1c6a7c7",
                                                "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                                "text": "Als letzte Regel = Menopause ist diejenige Blutung anzusehen, nach der, retrospektiv betrachtet, ein Jahr lang keine Blutung mehr auftrat."
                                            },
                                            {
                                                "example_id": "df180cd5-af9e-46aa-be3f-be828e588068",
                                                "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                                "text": "Durch die Menopause wird das Klimakterium in einen prä- und einen postmenopausalen Abschnitt untergliedert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
