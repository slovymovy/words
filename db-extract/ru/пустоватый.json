                        "examples": [
                            {
                                "example_id": "3682136e-ff4d-426c-b589-336120d67c4b",
                                "sense_id": "7bb4cb58-373c-3688-868e-e67900fe47fc",
                                "text": "Пото́м, неохо́тно вы́пив ча́шку ко́фе в столо́вой, он прошёл в пустова́тый, холо́дный зал, тяжело́ передвига́я непослу́шные но́ги в меховы́х ту́флях, засу́нув больши́е па́льцы за шнур-по́яс.",
                                "translation": "Maxim Gorky",
                                "english": "Maxim Gorky"
                            }
                        ]
                    }
