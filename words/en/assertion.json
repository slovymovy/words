{
    "word_family": [
        "assert",
        "assertive",
        "assertiveness",
        "reassert"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                    "sense_definition": "A confident and forceful statement of fact or belief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author makes a bold <w>assertion</w> about the future of renewable energy in his latest book.",
                            "target_lang_translations": {
                                "ru": "В своей последней книге автор делает смелое <w>утверждение</w> о будущем возобновляемых источников энергии."
                            }
                        },
                        {
                            "text": "You are a man of strong <w>assertions</w> but you rarely provide the data to back them up.",
                            "target_lang_translations": {
                                "ru": "Вы человек решительных <w>утверждений</w>, но редко приводите данные для их подтверждения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strong assertion",
                        "bold assertion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уверенное и решительное заявление о факте или убеждении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "высказывание, положение"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное или решительное сообщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e7dd9f7-52c5-334c-a5aa-9c2b95653b5c",
                    "sense_definition": "The action of stating something or exercising a right strongly and clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>assertion</w> of one's rights is a fundamental part of any democratic society.",
                            "target_lang_translations": {
                                "ru": "<w>Отстаивание</w> своих прав является фундаментальной частью любого демократического общества."
                            }
                        },
                        {
                            "text": "She spoke with great confidence, ensuring the <w>assertion</w> of her authority over the committee.",
                            "target_lang_translations": {
                                "ru": "Она говорила с большой уверенностью, обеспечивая <w>утверждение</w> своего авторитета в комитете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assertion of rights",
                        "assertion of authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по решительному и четкому заявлению о чем-либо или осуществлению права."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстаивание",
                                "target_lang_sense_clarification": "защита своих прав или позиций"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "проявление власти или авторитета"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "о своих правах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                    "sense_definition": "A statement or declaration that lacks supporting evidence or proof.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without any data to support it, your claim remains a bare <w>assertion</w> that no one will believe.",
                            "target_lang_translations": {
                                "ru": "Без каких-либо подтверждающих данных ваше заявление остается лишь голословным <w>утверждением</w>, в которое никто не поверит."
                            }
                        },
                        {
                            "text": "The company was unable to provide any proof for its <w>assertion</w> when questioned by the reporters.",
                            "target_lang_translations": {
                                "ru": "Компания не смогла предоставить никаких доказательств своего <w>заявления</w>, когда ей задали вопросы репортеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "allegation"
                    ],
                    "common_phrases": [
                        "bare assertion",
                        "unfounded assertion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или декларация, не имеющая подтверждающих доказательств или обоснований."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голословное утверждение",
                                "target_lang_sense_clarification": "бездоказательное заявление"
                            },
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "необоснованное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16bd5c75-fa92-3f50-bbb9-9aae453c36b7",
                    "sense_definition": "A statement in a computer program used to check if a condition is true during execution, primarily for debugging.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer added an <w>assertion</w> failure check to ensure the variable never reached zero.",
                            "target_lang_translations": {
                                "ru": "Программист добавил проверку на ошибку <w>утверждения</w>, чтобы убедиться, что переменная никогда не достигнет нуля."
                            }
                        },
                        {
                            "text": "If the <w>assertion</w> code is correct, any error issued must be a real design flaw.",
                            "target_lang_translations": {
                                "ru": "Если код <w>утверждения</w> верен, любая выданная ошибка должна быть реальным дефектом проектирования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assertion failure",
                        "assertion code"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оператор в компьютерной программе, используемый для проверки истинности условия во время выполнения, в основном для отладки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "в программировании, assert"
                            },
                            {
                                "target_lang_word": "проверка условия",
                                "target_lang_sense_clarification": "логическая проверка в коде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d601b1d-76f4-340b-8275-69202374a3b1",
                    "sense_definition": "The set of information provided by a statement preparer during a financial audit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auditor must verify each financial <w>assertion</w> made by the company's management team.",
                            "target_lang_translations": {
                                "ru": "Аудитор должен проверить каждое финансовое <w>утверждение</w>, сделанное руководством компании."
                            }
                        },
                        {
                            "text": "A management <w>assertion</w> regarding the value of assets is a key part of the audit process.",
                            "target_lang_translations": {
                                "ru": "<w>Утверждение</w> руководства относительно стоимости активов является ключевой частью процесса аудита."
                            }
                        }
                    ],
                    "common_phrases": [
                        "management assertion",
                        "financial assertion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор информации, предоставляемый составителем отчетности в ходе финансового аудита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "в финансовом аудите"
                            },
                            {
                                "target_lang_word": "предпосылка",
                                "target_lang_sense_clarification": "подготовки финансовой отчетности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}