                        "target_lang_word": "松节油",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "acc60ce6-3bf9-40e8-996e-6497fe1b70ba",
                        "source_entry_id": "d9670056-b522-345c-b23f-b726d8c43d27",
                        "source_sense_id": "3560e61c-b7d1-3958-8adf-1c840fbc0601",
                        "target_lang_word": "Terpentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terpentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa276ee-d0c4-32c4-9dbb-fa31b688a32f",
                                        "entry_id": "f1bc1fa3-ab0b-32d3-9332-6e8979e53281",
                                        "glosses": [
                                            "Harz (klebrige Absonderung von Honigkonsistenz) verschiedener Nadelholzbäume"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb01689-6fc5-4e59-8dab-2592484a4e44",
                                                "sense_id": "0aa276ee-d0c4-32c4-9dbb-fa31b688a32f",
                                                "text": "„Den venezianischen Terpentin bewahrt man in Deckelkruken aus Porcellan auf, deren oberer Rand stets sauber gehalten werden muss, denn der Terpentin wirkt beim Eintrocknen wie ein Kitt.“"
                                            },
                                            {
                                                "example_id": "9e05720d-48e0-4c9d-8310-b58580bfeb10",
                                                "sense_id": "0aa276ee-d0c4-32c4-9dbb-fa31b688a32f",
                                                "text": "„Unter diese gehören vorzüglich die Harze und der Terpentin aus den Nadelhölzern und der zuckerhaltige Saft der Birken und Ahorne.“"
                                            },
                                            {
                                                "example_id": "93203a22-e11c-4257-8a8b-2b0300e089eb",
                                                "sense_id": "0aa276ee-d0c4-32c4-9dbb-fa31b688a32f",
                                                "text": "„In einigen Gegenden ist es ungewissen Geschlechts, das Terpentin. Ehemals nannte man den Terpentin im Deutschen auch Pullpech, von pullen, quellen, fließen, und den Baum Pullpechbaum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21da125a-e64c-376e-92e7-51a2e8da34b5",
                                        "entry_id": "f1bc1fa3-ab0b-32d3-9332-6e8979e53281",
                                        "glosses": [
                                            "Kurzwort für Terpentinöl oder Terpentinersatz, einem Destillat aus Erdöl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036a96cc-ef15-48ea-aefd-5cbee2d32bcf",
                                                "sense_id": "21da125a-e64c-376e-92e7-51a2e8da34b5",
                                                "text": "„Himpel erwartete mich in Hemd und Knickerbockern, an seiner Windjacke putzten die beiden Sekretärinnen herum, rieben da, wischten, reinigten mit Terpentin.“"
                                            },
                                            {
                                                "example_id": "e7baa14a-04cb-4b28-8e8f-814413cdb5bd",
                                                "sense_id": "21da125a-e64c-376e-92e7-51a2e8da34b5",
                                                "text": "„Gut, dass ich an das Terpentin gedacht habe, sonst sähe ich bald aus wie ein Soldat in voller Camouflage-Montur.“"
                                            },
                                            {
                                                "example_id": "3306c885-cb40-4135-9d55-c3583e3b692c",
                                                "sense_id": "21da125a-e64c-376e-92e7-51a2e8da34b5",
                                                "text": "„Dann tropfte sie etwas Terpentin auf die Bißwunde, damit sie nicht eiterte, und verband sie mit einem sauberen Tuch, das sie in Streifen riß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
