                    {
                        "sense_id": "f12c79ee-9178-38b1-a566-398d71e4d5d9",
                        "entry_id": "56ed662a-5d2b-39b4-adec-abdada25593a",
                        "glosses": [
                            "Abteilung, Einheit, Verwaltungsabschnitt, für den eine Person zuständig ist"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "77d36f73-5705-463c-aa06-0ac32c54b4d4",
                                "sense_id": "f12c79ee-9178-38b1-a566-398d71e4d5d9",
                                "text": "Der Polizist bestreifte seinen Rayon."
                            },
                            {
                                "example_id": "b0bd7887-f34a-4842-99e5-cbea11ba5fc2",
                                "sense_id": "f12c79ee-9178-38b1-a566-398d71e4d5d9",
                                "text": "„Wer sich aus dem Rayon herauswagte, riskierte schwerste Strafen ...“"
                            },
                            {
                                "example_id": "03886c32-f767-40e8-9168-2f8353f04a3e",
                                "sense_id": "f12c79ee-9178-38b1-a566-398d71e4d5d9",
                                "text": "„Die jeweiligen Rayons I lagen dem Rhein als Grenze am nächsten, die weiteren schlossen sich streifenartig an.“"
                            }
                        ],
