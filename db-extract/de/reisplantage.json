                "senses": [
                    {
                        "sense_id": "3f2030c6-6d7f-39c0-89c6-fce90ca4021f",
                        "entry_id": "86a9919b-b8cb-3d9a-8dc8-0838273fbe9e",
                        "glosses": [
                            "Plantage, auf der Reis angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a73453-813c-4f2b-b593-b08ef3bfe9db",
                                "sense_id": "3f2030c6-6d7f-39c0-89c6-fce90ca4021f",
                                "text": "„Er sagte, es sei den Europäischstämmigen 300 Jahre lang peinlich gewesen, dass sie nicht in der Lage waren, selbst ihre Reisplantagen zu bestellen oder in der drückenden Hitze ihren eigenen Tabak oder ihr Zuckerrohr zu schneiden.“"
                            },
                            {
                                "example_id": "e63dc42f-f914-4829-9dea-d1ebab95c698",
                                "sense_id": "3f2030c6-6d7f-39c0-89c6-fce90ca4021f",
                                "text": "„Zuerst ging es langsam und mühsam zur kambodschanischen Grenze, die sie nach einer endlosen Reihe von matschigen Feldern und überfluteten Reisplantagen, jeweils durch dichte Baumreihen mit dornigem Unterholz und Stolperfallen aus Wurzelwerk voneinander getrennt, irgendwann überquerten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
