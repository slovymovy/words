                "senses": [
                    {
                        "sense_id": "643082e3-50ce-3ec5-abe1-b26c926fd696",
                        "entry_id": "cf8f9cfc-0e80-37be-9888-3b8e9a1065f2",
                        "glosses": [
                            "Eigenschaft/Haltung, die freundlich und ungezwungen bis gönnerhaft und herablassend (jovial) ist oder wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec52ac60-e421-4aba-bb2b-6b29d4df75c0",
                                "sense_id": "643082e3-50ce-3ec5-abe1-b26c926fd696",
                                "text": "„Nicht frei von menschlicher Schwachheit war R.; bei einem lebhaften Temperament ein durchaus redlicher und gediegener Mann; seine Gutmüthigteit, Treuherzigkeit und Jovialität, so wie alle geselligen Tugenden werden in der Erinnerung aller derer, die ihm näherstanden, nie erlöschen.“ (1843)"
                            },
                            {
                                "example_id": "7512c412-3202-494a-ab58-c8a06d9c198e",
                                "sense_id": "643082e3-50ce-3ec5-abe1-b26c926fd696",
                                "text": "„Ein dünnes Lächeln lag auf dem Gesicht des Senators und sollte wohl den Anschein von Jovialität und Ungezwungenheit erwecken.“"
                            },
                            {
                                "example_id": "27cbf226-0b61-40c5-906b-fed492e0e325",
                                "sense_id": "643082e3-50ce-3ec5-abe1-b26c926fd696",
                                "text": "„Solche Formen der Jovialität, die einen herabwürdigenden Beigeschmack haben, können auch eingesetzt werden, um einem vorgegebenen Positionsgefälle Ausdruck zu verleihen und es zu vertiefen.“"
                            },
                            {
                                "example_id": "967dec4d-e5b6-40d4-8ecf-cf1abfb24902",
                                "sense_id": "643082e3-50ce-3ec5-abe1-b26c926fd696",
                                "text": "„Die Jovialität und Bonhomie war verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
