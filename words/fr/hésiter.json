    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46e28639-63fb-35ff-ac03-4f33d393e170",
                    "sense_definition": "Être incertain ou indécis face à un choix, une action ou une résolution à prendre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>hésite</w> encore entre deux robes pour la fête de ce soir."
                        },
                        {
                            "text": "Il a accepté cette offre sans <w>hésiter</w> dès le premier jour."
                        }
                    ],
                    "synonyms": [
                        "balancer"
                    ],
                    "common_phrases": [
                        "hésiter entre",
                        "sans hésiter",
                        "ne pas hésiter"
                    ]
                },
                {
                    "sense_id": "86ac41a6-59bb-3da9-8086-aaed79f200c9",
                    "sense_definition": "Avoir du mal à trouver ses mots ou marquer de l'incertitude dans ce que l'on exprime.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé <w>hésitait</w> dans ses réponses face aux questions précises de la juge."
                        },
                        {
                            "text": "Elle a <w>hésité</w> sur un mot rare avant de poursuivre son explication."
                        }
                    ],
                    "common_phrases": [
                        "hésiter dans ses réponses",
                        "hésiter sur un mot"
                    ]
                },
                {
                    "sense_id": "c6e276f8-e5b6-3e15-95c4-8fbd02d03a38",
                    "sense_definition": "Marquer un temps d'arrêt bref, s'interrompre un instant avant d'agir ou de continuer à parler.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acteur a <w>hésité</w> un instant avant de monter sur la scène principale."
                        },
                        {
                            "text": "Il <w>hésita</w> un moment sur le pas de la porte avant d'entrer."
                        }
                    ],
                    "common_phrases": [
                        "hésiter un instant",
                        "hésiter un moment"
                    ]
                }
            ]
