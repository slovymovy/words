                    }
                ],
                "translations": [
                    {
                        "translation_id": "58cd8459-3907-4d0c-9bd9-cca6158db22a",
                        "source_entry_id": "b55db35b-da0f-37bd-b528-1f3fc10e2bfd",
                        "source_sense_id": "14a4ffc7-8072-3e90-b5cf-3caef2587350",
                        "target_lang_word": "Pyrrhic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyrrhic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10af74fb-044e-3863-91f0-d3d2cb1a58bd",
                                        "entry_id": "212c2f81-dcfe-3479-847f-b45bb83f3d8e",
                                        "glosses": [
                                            "Of or relating to Pyrrhus (319/318–272 BC), Greek general and statesman."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "197ef0b9-5f1a-44ff-acdc-07f9f50c0b12",
                                                "sense_id": "10af74fb-044e-3863-91f0-d3d2cb1a58bd",
                                                "text": "The Pyrrhic army lost the Pyrrhic war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a9ca68f-fbee-3091-a73a-b7569556454d",
                                        "entry_id": "212c2f81-dcfe-3479-847f-b45bb83f3d8e",
                                        "glosses": [
                                            "Achieved at too great a cost or detriment to have been worthwhile (as a victory, accomplishment, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c301cfc1-42f8-4d5f-bca5-069fa72ad24b",
                                                "sense_id": "9a9ca68f-fbee-3091-a73a-b7569556454d",
                                                "text": "Although this syndrome is thought to resemble patterns of Pyrrhic revenge […]"
                                            },
                                            {
                                                "example_id": "5bd304f4-a043-417d-b78a-5cc61702b2bc",
                                                "sense_id": "9a9ca68f-fbee-3091-a73a-b7569556454d",
                                                "text": "I feared a Pyrrhic victory: I had been vindicated intellectually, but I was afraid of being too right and seeing the system crumble under my feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e25b277b-1b7a-4fd1-8f68-6cca1d1fb2a5",
                        "source_entry_id": "b55db35b-da0f-37bd-b528-1f3fc10e2bfd",
                        "source_sense_id": "14a4ffc7-8072-3e90-b5cf-3caef2587350",
                        "target_lang_word": "pyrrhic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrrhic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1596d6-f86c-3b7a-8d3e-224b6420ad1c",
                                        "entry_id": "2655aae7-4bfd-3ad1-8ce5-282372859d05",
                                        "glosses": [
                                            "Of or characterized by pyrrhics (metrical feet with two short syllables)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a85126b6-1338-3878-a885-dcff2572b204",
                                        "entry_id": "2655aae7-4bfd-3ad1-8ce5-282372859d05",
                                        "glosses": [
                                            "Relating to Pyrrhus, a Macedonian king, or some of his costly victories he had while fighting Rome."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30800a2a-caca-3993-b8ac-5f0d328328bf",
                                        "entry_id": "2655aae7-4bfd-3ad1-8ce5-282372859d05",
                                        "glosses": [
                                            "Alternative letter-case form of Pyrrhic (“achieved at too great a cost”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3432aaf4-6616-4186-868a-e830646a6b95",
                                                "sense_id": "30800a2a-caca-3993-b8ac-5f0d328328bf",
                                                "text": "Huwawa is slain; the victors triumph, but the victory is to be a pyrrhic one for Gilgamesh, for the gods have met in counsel and decreed that Enkidu should die."
                                            },
                                            {
                                                "example_id": "f29e51aa-ec95-4786-a983-9ca986d41563",
                                                "sense_id": "30800a2a-caca-3993-b8ac-5f0d328328bf",
                                                "text": "In the ministry, it is important to avoid pyrrhic victories. What really is a pyrrhic victory? A pyrrhic victory is a victory that comes with such devastating cost that ultimately nullifies the victory that has been achieved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pyrrhic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb48843-7186-36a8-95a6-880656957320",
                                        "entry_id": "778215ee-c0c1-3d1e-b399-65be2f5f522f",
                                        "glosses": [
                                            "An Ancient Greek war dance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79a3e6d3-4e5c-3a20-bf2c-5a9f93fc9823",
                                        "entry_id": "778215ee-c0c1-3d1e-b399-65be2f5f522f",
                                        "glosses": [
                                            "A metric foot with two short or unaccented syllables."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "503e2bf4-c75e-46f6-8abe-83c77952b575",
                        "source_entry_id": "b55db35b-da0f-37bd-b528-1f3fc10e2bfd",
                        "source_sense_id": "14a4ffc7-8072-3e90-b5cf-3caef2587350",
                        "target_lang_word": "pyrrhique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrrhique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea6b787-f331-3d0d-8bab-66f0b12495d8",
                                        "entry_id": "50d8bf7f-49ad-3e54-bbdd-6c6495f80928",
                                        "glosses": [
                                            "Qui concerne Pyrrhus et son royaume, et en particulier la danse et le pied de métrique qui s’y rattachent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6705f58-eddc-400e-8f4f-83d8b1e3558a",
                                                "sense_id": "6ea6b787-f331-3d0d-8bab-66f0b12495d8",
                                                "text": "Si l’on est fondé à reconnaître une base pyrrhique dans la seconde portion du refrain, cette particularité doit procéder d’un choix délibéré, sans doute révélateur d’une véritable conscience métrique."
                                            },
                                            {
                                                "example_id": "e910610a-5135-4dce-b5a7-849a76f0418b",
                                                "sense_id": "6ea6b787-f331-3d0d-8bab-66f0b12495d8",
                                                "text": "« Danse pyrrhique », « pied pyrrhique », ajoutés aux dénominations de « mouton pyrrhique », « troupeau pyrrhique » semblent accréditer l’opinion que la pratique de la pyrrhique a été enracinée chez les Molosses."
                                            },
                                            {
                                                "example_id": "693229f8-4c6d-48ab-826b-eb6d0c15f602",
                                                "sense_id": "6ea6b787-f331-3d0d-8bab-66f0b12495d8",
                                                "text": "Il est précédé, soit d’une élision, soit d’un mot pyrrhique avec liaison C(onsonne)-V(oyelle)."
                                            },
                                            {
                                                "example_id": "11090757-5127-415e-a151-ec93e4398329",
                                                "sense_id": "6ea6b787-f331-3d0d-8bab-66f0b12495d8",
                                                "text": "Il avait grand' peine à marquer le pas sur l'air de la pyrrhique …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pyrrhique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a481772-89ce-36eb-81a6-08a61b163da6",
                                        "entry_id": "adc46c4b-f8c5-350c-ab2d-b4d030321d77",
                                        "glosses": [
                                            "Danse guerrière dont on attribuait l’invention à Pyrrhus, fils d’Achille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33964596-5d0b-4c2e-af14-f94365dfb514",
                                                "sense_id": "1a481772-89ce-36eb-81a6-08a61b163da6",
                                                "text": "Lorsque l’aulète Timothée de Milet exécutait devant lui le nome orthien, Alexandre ne pouvait se retenir de saisir ses armes et de danser la pyrrhique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pyrrhique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfec45f3-945b-3762-b6d7-be2bb0245900",
                                        "entry_id": "c42dcd64-c2d0-3764-94a4-4fcfa3ab89d4",
                                        "glosses": [
                                            "Pied composé de deux brèves."
                                        ],
                                        "tags": [
                                            "Métrique ancienne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f5a0b47-4765-4166-ae9d-8b93cc16176e",
                                                "sense_id": "cfec45f3-945b-3762-b6d7-be2bb0245900",
                                                "text": "[…] car le pyrrhique est normalement précédé de monosyllabe long (cf. ex. virgiliens) : une fin de mot au temps fort V ne se rencontre que 13 fois dans toute l’Enéide, dont 7 au livre X, moins achevé que les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
