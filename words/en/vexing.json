                    "sense_id": "2f43d381-fbf8-32f9-b8d9-3292f5234cf0",
                    "sense_definition": "Causing annoyance or irritation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vexing</w> problem of traffic congestion remains unsolved in the city.",
