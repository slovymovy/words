                                "target_senses": [
                                    {
                                        "sense_id": "39e41bcd-a3b3-3980-b40c-3946c1b777c6",
                                        "entry_id": "1bcebf3d-2e4f-3a8f-879b-3c6cdda384f6",
                                        "glosses": [
                                            "A resort visited for holidays/vacations during the summer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0294e7e1-e7f1-4e58-b601-d62f443f787c",
                                                "sense_id": "39e41bcd-a3b3-3980-b40c-3946c1b777c6",
                                                "text": "Hangchow is built around large lakes and gardens. In the days when the emperors used it as a summer resort, it was known as the most beautiful city in China. I know that Mao enjoyed taking vacations there and staying in an exquisite old palace that had been turned into a government guesthouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d827fa-4fff-4d7d-aa7a-ccb9a59eca19",
                        "source_entry_id": "123b6bf3-d35e-32dc-a488-31b8b88a1039",
                        "source_sense_id": "ca81e83a-ea10-383e-b71c-9c90500e0bc7",
