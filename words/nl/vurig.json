                            }
                        },
                        {
                            "text": "Zij is een <w>vurige</w> voorstander van het beschermen van de natuur.",
                            "target_lang_translations": {
                                "en": "She is an <w>ardent</w> supporter of protecting nature."
                            }
                        }
                    ],
                    "synonyms": [
