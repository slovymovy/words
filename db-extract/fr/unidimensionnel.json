                ],
                "senses": [
                    {
                        "sense_id": "95ab6109-003f-3714-b0a1-f817be272651",
                        "entry_id": "7ece70f7-e327-3bb1-acd4-13499c99ceb5",
                        "glosses": [
                            "Relatif à une dimension, qui se produit dans une dimension seulement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a441e99-58be-484c-a938-6245e2bf4845",
                                "sense_id": "95ab6109-003f-3714-b0a1-f817be272651",
                                "text": "Une élongation unidimensionnelle."
                            },
                            {
                                "example_id": "1baef923-1ca7-44d9-bc64-64c1d8e1018c",
                                "sense_id": "95ab6109-003f-3714-b0a1-f817be272651",
                                "text": "Un espace unidimensionnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a90f91d-8618-3a47-b869-05362766dbf9",
                        "entry_id": "7ece70f7-e327-3bb1-acd4-13499c99ceb5",
                        "glosses": [
                            "Dont les capacités ne s’exercent que dans un seul domaine."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "92c3d344-64b9-4722-b07e-d34cfd8257c3",
                                "sense_id": "5a90f91d-8618-3a47-b869-05362766dbf9",
                                "text": "Lui aussi a échappé à la catégorie des hommes unidimensionnels. C’est un romancier aux multiples facettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ee6fa8b-3232-33c3-a7d9-4d88e57a4e90",
                        "entry_id": "7ece70f7-e327-3bb1-acd4-13499c99ceb5",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd7cb9fa-5020-4871-a33a-63340ecc9d4e",
                                "sense_id": "9ee6fa8b-3232-33c3-a7d9-4d88e57a4e90",
                                "text": "La musique byzantine traditionnelle, héritée de la musique grecque antique et ayant connu son apogée au temps de l’Empire théocratique de Byzance, est monotonique et exclusivement vocale. Par conséquent, le chant byzantin est monophonique, unidimensionnel pourrait-on dire, et aussi austère qu’une icône byzantine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f11694d-7177-48b1-bb24-9c63c1c57dce",
                        "source_entry_id": "7ece70f7-e327-3bb1-acd4-13499c99ceb5",
                        "target_lang_word": "eindimensional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindimensional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ac62109-0b0d-339d-81f2-b94d42a3f956",
                                        "entry_id": "af74f999-97c2-3191-8c77-f21490d2bb98",
                                        "glosses": [
                                            "über eine Dimension verfügend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "827e0da5-aa86-4517-aa6f-af81a9d0f218",
                                                "sense_id": "3ac62109-0b0d-339d-81f2-b94d42a3f956",
                                                "text": "„Höhe bezeichnet den Abstand eines Objektpunktes von einer Referenzlinie oder -fläche. Sie ist eine eindimensionale Größe.“"
                                            },
                                            {
                                                "example_id": "0a100bfb-286d-4a87-a279-948b42898cb9",
                                                "sense_id": "3ac62109-0b0d-339d-81f2-b94d42a3f956",
                                                "text": "übertragen: „Doch Elektra denkt eindimensional, für sie gibt es nur die Rache.“"
                                            },
                                            {
                                                "example_id": "d7d58d31-86ab-4bde-80e1-b96f81a65dc5",
                                                "sense_id": "3ac62109-0b0d-339d-81f2-b94d42a3f956",
                                                "text": "übertragen: „Karenina tut es zum Teil, möglicherweise, aber Karenina denkt eindimensional, nur in eine Richtung.“"
                                            },
                                            {
                                                "example_id": "f19978b2-2879-444b-ac00-54557d3a4db1",
                                                "sense_id": "3ac62109-0b0d-339d-81f2-b94d42a3f956",
                                                "text": "übertragen: „Er denkt eindimensional, alternativlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44c38630-50ba-4f2d-9e2f-611828dcb469",
                        "source_entry_id": "7ece70f7-e327-3bb1-acd4-13499c99ceb5",
                        "target_lang_word": "one-dimensional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one-dimensional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "294f3722-58fe-3705-a515-87fd639ed8b7",
                                        "entry_id": "b0997402-31d2-3c64-9e28-d3e66e15b951",
                                        "glosses": [
                                            "Having length, but no width, height or depth."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301f6adb-afe2-4c9d-a0fd-0ee81d0fabf0",
                                                "sense_id": "294f3722-58fe-3705-a515-87fd639ed8b7",
                                                "text": "A straight line is one-dimensional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a996e4-2284-38af-9965-c1af24dbb6bd",
                                        "entry_id": "b0997402-31d2-3c64-9e28-d3e66e15b951",
                                        "glosses": [
                                            "Lacking depth or believability; flat."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a10c54-16a0-4431-a200-14f26750e913",
                                                "sense_id": "79a996e4-2284-38af-9965-c1af24dbb6bd",
                                                "text": "Such one-dimensional characters have always existed in the theatre along with more recognizably human characters."
                                            },
                                            {
                                                "example_id": "9e93262b-45e0-4fe0-9662-5ad63878c5e1",
                                                "sense_id": "79a996e4-2284-38af-9965-c1af24dbb6bd",
                                                "text": "In contrast to this are the flat, one-dimensional characters found in fables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46d1acf3-969d-3923-b1be-64ba5e57238d",
                                        "entry_id": "b0997402-31d2-3c64-9e28-d3e66e15b951",
                                        "glosses": [
                                            "Lacking personal depth and substance; conceited, vain, shallow, superficial."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
