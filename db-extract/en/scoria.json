                "senses": [
                    {
                        "sense_id": "f7b4d8d7-a8c2-392f-b13d-285a162111c0",
                        "entry_id": "4d237219-4eff-3d76-b345-a0bf17471a21",
                        "glosses": [
                            "The slag or dross that remains after the smelting of metal from an ore."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "25ec442e-a88c-4af9-a1da-65ebe3552eaa",
                                "sense_id": "f7b4d8d7-a8c2-392f-b13d-285a162111c0",
                                "text": "The like stuff is in Anacharsis: hot metal; full of scoriae, which should and could have been smelted out, but which will not."
                            }
                        ]
                    },
                    {
                        "sense_id": "88574eb3-a869-383f-82a3-75baeed4f1f4",
                        "entry_id": "4d237219-4eff-3d76-b345-a0bf17471a21",
                        "glosses": [
                            "Rough masses of rock formed by solidified lava, and which can be found around a volcano's crater."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6e1c5d9a-9d28-4e70-befb-7fd03882ad4a",
                                "sense_id": "88574eb3-a869-383f-82a3-75baeed4f1f4",
                                "text": "To the south lay broken shapes of scoria in a lava bed as far as the eye could see."
                            },
                            {
                                "example_id": "a4d8d8cc-aea5-490f-bfc4-0454ed3bf451",
                                "sense_id": "88574eb3-a869-383f-82a3-75baeed4f1f4",
                                "text": "An excellent guidebook by Drs Kilburn and McGuire of University College London reveals that these unpromising pieces of debris are scoria and lithic fragments of the March 1944 eruption."
                            }
                        ]
                    }
                ],
