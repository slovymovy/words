                "senses": [
                    {
                        "sense_id": "8c73d949-db67-3756-a200-1c02ee06c653",
                        "entry_id": "7bc38204-b709-3ee5-97a8-e1cce102c91b",
                        "glosses": [
                            "Prix supplémentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29afab27-811a-4b2e-92af-f28d8ab7460c",
                                "sense_id": "8c73d949-db67-3756-a200-1c02ee06c653",
                                "text": "Il est question de surprix notamment lorsque la valeur d’acquisition d’une participation est supérieure à sa valeur réelle, eu égard à la valeur comptable des éléments du patrimoine de la société en cause (dans laquelle la participation est prise) et aux plus-values latentes dans cette société."
                            },
                            {
                                "example_id": "8cc062e1-3715-45d0-be69-37c412a48b7e",
                                "sense_id": "8c73d949-db67-3756-a200-1c02ee06c653",
                                "text": "Le montant du surprix saisonnier sera plus important dans les pays où le coût de production augmente entre la période de production laitière et la période creuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5158d8dc-fae6-4593-bb7f-cb8824811606",
                        "source_entry_id": "7bc38204-b709-3ee5-97a8-e1cce102c91b",
