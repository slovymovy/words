{
    "word_family": [
        "begin",
        "beginner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55b3a629-3ecb-3ab0-ae0f-67dbab4a2a93",
                    "sense_definition": "The first part or section of something that continues for a period of time or space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author describes the main character’s youth at the <w>beginning</w> of the story.",
                            "target_lang_translations": {
                                "ru": "Автор описывает юность главного героя в <w>начале</w> рассказа.",
                                "zh": "作者在故事的<w>开头</w>描述了主角的青年时代。"
                            }
                        },
                        {
                            "text": "Please sign your name at the <w>beginning</w> of the document.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поставьте свою подпись в <w>начале</w> документа.",
                                "zh": "请在文件的<w>开头</w>处签名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "start",
                        "head",
                        "opening"
                    ],
                    "antonyms": [
                        "end",
                        "conclusion"
                    ],
                    "common_phrases": [
                        "at the beginning",
                        "from the beginning",
                        "in the beginning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первая часть или раздел чего-либо, продолжающийся во времени или пространстве.",
                        "zh": "某事物在时间或空间上持续过程中的第一部分或开头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "первая часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开头",
                                "target_lang_sense_clarification": "第一部分"
                            },
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "起始阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b584d44b-429e-3121-81e6-731b96440399",
                    "sense_definition": "The act or process of starting an action or event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This meeting marks the <w>beginning</w> of our new project.",
                            "target_lang_translations": {
                                "ru": "Эта встреча знаменует <w>начало</w> нашего нового проекта.",
                                "zh": "这次会议标志着我们新项目的<w>开始</w>。"
                            }
                        },
                        {
                            "text": "We are looking forward to the <w>beginning</w> of the school year.",
                            "target_lang_translations": {
                                "ru": "Мы с нетерпением ждем <w>начала</w> учебного года.",
                                "zh": "我们期待着新学年的<w>开始</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "start",
                        "commencement",
                        "launch",
                        "initiation"
                    ],
                    "antonyms": [
                        "end",
                        "finish",
                        "completion"
                    ],
                    "common_phrases": [
                        "a new beginning",
                        "beginning of the end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс начала события.",
                        "zh": "启动某项行动或事件的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "старт, запуск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "动作的启动"
                            },
                            {
                                "target_lang_word": "开端",
                                "target_lang_sense_clarification": "事件的起点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d1d23d3-5fe7-3ca7-bf19-b7e57b21fedd",
                    "sense_definition": "The source, origin, or first cause of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What was the <w>beginning</w> of the dispute between the two neighbors?",
                            "target_lang_translations": {
                                "ru": "Что послужило <w>началом</w> спора между двумя соседями?",
                                "zh": "两位邻居之间争端的<w>起因</w>是什么？"
                            }
                        },
                        {
                            "text": "Scientists are still studying the <w>beginning</w> of the universe.",
                            "target_lang_translations": {
                                "ru": "Ученые до сих пор изучают <w>начало</w> вселенной.",
                                "zh": "科学家们仍在研究宇宙的<w>起源</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "origin",
                        "source",
                        "birth"
                    ],
                    "antonyms": [
                        "end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Источник, происхождение или первопричина чего-либо.",
                        "zh": "某事物的来源、起源或最初的原因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "исток, происхождение"
                            },
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "первопричина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起源",
                                "target_lang_sense_clarification": "事物的来源"
                            },
                            {
                                "target_lang_word": "起因",
                                "target_lang_sense_clarification": "最初的原因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0987f27-469c-36cb-8d72-702a896cf5f9",
                    "sense_definition": "An early element or rudiment of something, often implying potential for growth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many successful global companies had very humble <w>beginnings</w>.",
                            "target_lang_translations": {
                                "ru": "Многие успешные мировые компании имели весьма скромное <w>начало</w>.",
                                "zh": "许多成功的全球性公司都有过非常卑微的<w>起步</w>。"
                            }
                        },
                        {
                            "text": "We can see the <w>beginnings</w> of a recovery in the economy.",
                            "target_lang_translations": {
                                "ru": "Мы видим <w>зачатки</w> восстановления экономики.",
                                "zh": "我们能看到经济复苏的<w>萌芽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rudiment",
                        "embryo"
                    ],
                    "common_phrases": [
                        "humble beginnings",
                        "small beginnings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранний элемент или зачаток чего-либо, часто подразумевающий потенциал для роста.",
                        "zh": "某事物的早期元素或雏形，通常暗示着发展的潜力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачатки",
                                "target_lang_sense_clarification": "первые признаки"
                            },
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "ранняя стадия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "萌芽",
                                "target_lang_sense_clarification": "最初的迹象"
                            },
                            {
                                "target_lang_word": "起步",
                                "target_lang_sense_clarification": "早期的阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b3c3135-cf23-3e15-ade6-c352dbe9600b",
                    "sense_definition": "Present participle and gerund of <w>begin</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>beginning</w> to read a new book about history.",
                            "target_lang_translations": {
                                "ru": "Он <w>начинает</w> читать новую книгу по истории.",
                                "zh": "他<w>开始</w>读一本关于历史的新书了。"
                            }
                        },
                        {
                            "text": "The snow is <w>beginning</w> to fall heavily outside.",
                            "target_lang_translations": {
                                "ru": "На улице <w>начинает</w> сильно идти снег.",
                                "zh": "外面的雪<w>开始</w>下大了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола begin (начинать).",
                        "zh": "动词 begin（开始）的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "начинающий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开始",
                                "target_lang_sense_clarification": "动作进行中"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed481c21-0ab6-344d-90b3-b82812e051ba",
                    "sense_definition": "Describing the first part or stage of something.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students struggled with the <w>beginning</w> section of the course.",
                            "target_lang_translations": {
                                "ru": "Студентам с трудом давалась <w>начальная</w> часть курса.",
                                "zh": "学生们觉得这门课程的<w>初始</w>部分很难。"
                            }
                        },
                        {
                            "text": "Please read the <w>beginning</w> paragraph of the chapter aloud.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте <w>начальный</w> абзац главы вслух.",
                                "zh": "请大声朗读这一章的<w>开头</w>段落。"
                            }
                        }
