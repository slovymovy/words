                                                "example_id": "614a49fa-2132-42e9-a523-0a935e2387e8",
                                                "sense_id": "0a508c31-f5e9-3b37-ae46-4d746a04f0ae",
                                                "text": "Die Maurerkelle ist für den Maurer ein Hauptwerkzeug."
                                            },
                                            {
                                                "example_id": "b939b586-3b38-45e9-a76a-3bdde9d1ba34",
                                                "sense_id": "0a508c31-f5e9-3b37-ae46-4d746a04f0ae",
                                                "text": "„Die ganze Mannschaft des Ingenieurs mauerte tagelang, Smith selbst nahm auch die Maurerkelle in die Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20994159-19b1-4e0b-a0ff-12279cfd061b",
                        "source_entry_id": "f72a46b7-2c75-3097-9ce2-506a6dacb4ae",
