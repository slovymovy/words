                            "comment": "criminal/prison"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to law enforcement agencies or the administration of a correctional facility (in prison slang).",
                        "de": "Im Gefängnisjargon: auf Strafverfolgungsbehörden oder die Verwaltung einer Haftanstalt bezogen."
