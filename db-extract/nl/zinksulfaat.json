                        "examples": [
                            {
                                "example_id": "f6297aa1-7775-40b3-b84d-4cbcb20fed20",
                                "sense_id": "bcd9b1b3-f73d-3f83-850c-bfca43bfb31f",
                                "text": "Op de linkeroever van het kanaal Gent-Terneuzen was tot in de jaren 1960 La Floridienne gevestigd, zo genoemd omdat het bedrijf fosfaten mijnde in Florida. De fabriek produceerde er jarenlang metaalzouten, zoals zinksulfaat en lood, maar ook ferri- en ferrocyaniden. De afvalstoffen werden rond de fabriek gestort, wat leidde tot een van de zwaarste historische vervuilingen in Vlaanderen."
                            },
                            {
                                "example_id": "e9ba8448-7c8a-4693-b053-ebb10d6e8cd0",
                                "sense_id": "bcd9b1b3-f73d-3f83-850c-bfca43bfb31f",
                                "text": "Cadmium stapelt zich op in de nieren van de dieren en niet in het vlees. België werd op de hoogte gebracht van de aanwezigheid van cadmium in zinksulfaat in een lot afkomstig uit China."
                            }
                        ]
                    }
