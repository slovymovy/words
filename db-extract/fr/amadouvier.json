                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f30bb51-bb1f-3e04-9527-c994519a8bf2",
                        "entry_id": "9e8acb0c-ab90-3e71-b755-c74b634ae66f",
                        "glosses": [
                            "Zunderschwamm"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2cc22fe-7e41-402f-8250-d456f658260f",
                        "source_entry_id": "9e8acb0c-ab90-3e71-b755-c74b634ae66f",
                        "source_sense_id": "6f30bb51-bb1f-3e04-9527-c994519a8bf2",
                        "source_sense_description": "Zunderschwamm",
                        "target_lang_word": "Zunderschwamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zunderschwamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                        "entry_id": "7de170aa-519d-3946-8a6f-71640b07d6a1",
                                        "glosses": [
                                            "an Stämmen von Laubbäumen parasitär wachsender Pilz, der früher im getrockneten Zustand als Zunder diente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256ae880-26f5-45c7-9abb-39ff932844b2",
                                                "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                                "text": "Der Zunderschwamm wurde bis ins 20. Jahrhundert hinein, wie der Name schon sagt, als Zunder verwendet und sogar schon im Mittelalter zu Textilien verarbeitet."
                                            },
                                            {
                                                "example_id": "43adefdf-ae68-440d-a329-e613d2ff76d6",
                                                "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                                "text": "Der Zunderschwamm bildet mehrjährige, konsolenförmige Fruchtkörper, die bis zu 30 Jahre alt werden können."
                                            },
                                            {
                                                "example_id": "7f3076d1-5f8f-4dbc-b8d5-da5355a7111e",
                                                "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                                "text": "Erfolgt der erste Angriff zum Beispiel durch den Zunderschwamm (Fomes fomentarius), sind die Jahre des Baumes gezählt."
                                            },
                                            {
                                                "example_id": "7ed738e0-5fc2-4fe8-b6d3-bb6a0c88da18",
                                                "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                                "text": "In Betracht kommt der Echte Zunderschwamm, Polyporus fomentarius Fr., und der Unechte Zunderschwamm, Polyporus igniarius Fr., der einen schlechteren Zunder liefert."
                                            },
                                            {
                                                "example_id": "fd954e3d-b862-469d-bc2a-1b2285dcf92f",
                                                "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                                "text": "Damit der Zunderschwamm Fomes fomentarius auch wie Zunder den Funken fängt und brennt, muss man erstens den richtigen identifizieren und zweitens auch noch Präparieren."
                                            },
                                            {
                                                "example_id": "2ad46e08-b527-4e5d-85db-7cff632b75bc",
                                                "sense_id": "ae929c58-2015-3166-ab43-c93a161ba845",
                                                "text": "Aber auch bei uns leuchten die Schmetterlingsporlinge noch einmal festlich auf: Im Feuer des Kamins verglühen sie wie Zunderschwämme, und es sieht aus, als wäre das Holz mit vielen kleinen Lampen besteckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
