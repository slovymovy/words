                ],
                "senses": [
                    {
                        "sense_id": "1b76352b-67d5-34ef-941e-7f083fef1518",
                        "entry_id": "3b1592b3-f966-3f2c-bad6-018d4e365b99",
                        "glosses": [
                            "Disziplin der Linguistik, die sich mit den Phänomenen befasst, die das Sprechen begleiten und nicht aus den sprachlichen Einheiten wie Lauten, Wörtern, Sätzen unter anderen selbst bestehen, sondern diesen einen zusätzlichen kommunikativen Aspekt hinzufügen. Gemeint sind damit Erscheinungen wie Gestik, Mimik, Lautstärke, Sprechtempo und anderes, die Aufschluss über die Verfassung des Sprechers geben können."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59793e7b-dc7a-403d-8fe3-84d6c26b09f7",
                                "sense_id": "1b76352b-67d5-34ef-941e-7f083fef1518",
                                "text": "Die Paralinguistik versucht, die sprachbegleitenden, nonverbalen Aspekte der Kommunikation, die Parasprache, zu erfassen."
                            },
                            {
                                "example_id": "9be284db-3ac5-40f9-8234-a4cdcbbdbfd0",
                                "sense_id": "1b76352b-67d5-34ef-941e-7f083fef1518",
                                "text": "„Die Ergebnisse der Paralinguistik werden für die Diagnose psychischer Erkrankungen relevant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
