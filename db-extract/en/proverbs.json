                "senses": [
                    {
                        "sense_id": "09387184-6056-3e23-b5c9-c06b73a8602a",
                        "entry_id": "740c71dd-5619-37a6-ac3b-cf7b7360a02b",
                        "glosses": [
                            "A book of the Old Testament of Bible, and of the Tanakh, being a collection of moral maxims."
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "d6bc86e5-bc48-4b0f-b35b-258eb39f50c0",
                                "sense_id": "09387184-6056-3e23-b5c9-c06b73a8602a",
                                "text": "The Proverbs are an excellent springboard for broad-ranging Bible study. If you study Solomon’s pearls of wisdom, you will find the Spirit of God leading you (by chain references or quiet remembrance) all over the Old and New Testaments for confirming, clarifying examples."
                            },
                            {
                                "example_id": "1a126dbb-4a3f-4f89-b967-002c56bf1e19",
                                "sense_id": "09387184-6056-3e23-b5c9-c06b73a8602a",
                                "text": "Erman’s remark (1924) that a decent wisdom book was destroyed when it was absorbed into the book of Proverbs coheres well with the scholarly consensus that Proverbs is a clumsy accretion of ill-digested material."
                            }
                        ]
                    }
                ],
