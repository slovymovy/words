            "senses": [
                {
                    "sense_id": "50e48b7b-95f3-3d98-a429-f8b0d91d8b99",
                    "sense_definition": "État ou attitude d'une personne qui n'éprouve aucun intérêt, aucune émotion ni compassion envers autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son attitude distante et son <w>indifférence</w> envers la souffrance des voisins ont choqué tout le quartier."
                        },
                        {
                            "text": "Face aux nombreuses demandes d'aide, les passants ont réagi avec une totale <w>indifférence</w>."
                        }
                    ],
                    "synonyms": [
                        "insensibilité",
                        "apathie",
                        "détachement"
                    ],
                    "antonyms": [
                        "compassion",
                        "empathie",
                        "sollicitude"
                    ],
                    "common_phrases": [
