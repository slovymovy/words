                                                "sense_id": "7df1e52b-b7b7-390c-b605-1dfd5e8b4f5d",
                                                "text": "Il colore di quel vestito non si adatta molto bene con i tuoi occhi..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0333cb91-2c71-3e70-aa7c-16d00c0b641f",
                                        "entry_id": "e3202ccb-817d-383f-aac6-8554de590d69",
