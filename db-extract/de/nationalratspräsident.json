                        "entry_id": "706fd10f-a76a-3c80-84a1-35bf8f4b9a4e",
                        "glosses": [
                            "Vorsitzender des Nationalrats in Österreich und in der Schweiz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29d394b-f802-442a-98ff-d7d1762ff1c8",
                                "sense_id": "ddf8fa10-9a08-3a81-a225-cb0214ac9235",
                                "text": "„Am Mittwoch, 16. Jänner, hat Metropolit Arsenios den Zweiten Nationalratspräsidenten Fritz Neugebauer empfangen.“"
                            },
                            {
                                "example_id": "922cef47-ea1a-4fc1-86e6-feafbe8234ac",
                                "sense_id": "ddf8fa10-9a08-3a81-a225-cb0214ac9235",
                                "text": "„Sie stoßen sich daran, dass bei der Regierungsklausur in der Steiermark in der Vorwoche auch Nationalratspräsident Wolfgang Sobotka (ÖVP) und die Dritte Präsidentin Anneliese Kitzmüller (FPÖ) anwesend waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
