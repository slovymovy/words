        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27928eb1-ea43-3658-8969-eeee56438740",
                    "sense_definition": "To provide an official document detailing a person's specific needs, especially educational ones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local authority decided to <w>statement</w> the child to ensure he received extra support.",
                            "target_lang_translations": {
                                "ru": "Местные власти решили <w>выдать официальное заключение</w> на ребенка, чтобы обеспечить ему дополнительную поддержку.",
                                "tr": "Yerel yönetim, çocuğun ek destek almasını sağlamak için ona <w>özel eğitim ihtiyacı belgesi düzenlemeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "After the assessment, the student was <w>statemented</w> for special educational needs.",
                            "target_lang_translations": {
                                "ru": "После оценки учащемуся <w>был официально подтвержден статус</w> лица с особыми образовательными потребностями.",
                                "tr": "Değerlendirmenin ardından öğrenciye özel eğitim ihtiyaçları için <w>resmi destek statüsü verildi</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставить официальный документ с подробным описанием особых потребностей человека, особенно образовательных.",
                        "tr": "Bir kişinin özellikle eğitimle ilgili özel ihtiyaçlarını ayrıntılarıyla belirten resmi bir belge düzenlemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать официальное заключение",
                                "target_lang_sense_clarification": "об особых образовательных потребностях"
                            },
