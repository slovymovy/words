                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d037b52f-2e8c-328d-8a1a-2c115051f9b6",
                                        "entry_id": "2e013276-9888-3725-99cb-06134b9837ec",
                                        "glosses": [
                                            "Figuradamente, entorno o ambiente en que se mezclan individuos de distintas extracciones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d5c7af-4f1d-4837-86a2-d7f3c8cf6632",
                                                "sense_id": "d037b52f-2e8c-328d-8a1a-2c115051f9b6",
                                                "text": "Después de todo, aquello era Toledo. Crisol de cultos subterráneos, de misterios iniciáticos, de falsos conversos. Y de herejes."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
