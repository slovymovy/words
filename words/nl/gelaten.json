                        "lijdzaam",
                        "passief"
                    ],
                    "antonyms": [
                        "opstandig",
                        "strijdbaar"
                    ],
                    "common_phrases": [
                        "een gelaten indruk",
                        "gelaten reageren"
                    ],
                    "target_lang_definitions": {
                        "en": "Accepting a situation without resistance; resigned",
                        "ru": "Без сопротивления; смирившийся с ситуацией",
                        "it": "Che accetta una situazione senza opporre resistenza; rassegnato"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resigned",
                                "target_lang_sense_clarification": "accepting something unpleasant"
                            },
                            {
