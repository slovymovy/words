                        "sense_id": "b70fc5f5-4a13-3009-97b7-21985cae487d",
                        "entry_id": "409fb187-6ec3-31b1-a481-b8de99cc31ff",
                        "glosses": [
                            "rodzaj metafory; przedstawianie rzeczy, zwierząt, zjawisk lub pojęć abstrakcyjnych jako postaci ludzkich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5874f8e9-4a75-4ebd-ab83-314912edd592",
                                "sense_id": "b70fc5f5-4a13-3009-97b7-21985cae487d",
                                "text": "Śmierć ze Świata Dysku to postać będąca personifikacją naturalnego zjawiska."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1dd6761f-1eda-3129-ad61-f541ad553abe",
