                    {
                        "translation_id": "ddd39cb3-1105-4d2f-9e9d-a4d17cf68fe3",
                        "source_entry_id": "292be48b-f3f5-3205-9ba4-ca50d7511bf6",
                        "source_sense_id": "b06f0e99-d867-322a-82b1-73c0c281721f",
                        "source_sense_description": "Medizin: Acidose, Azidose",
                        "target_lang_word": "Azidose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Azidose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deabb661-731a-3eec-89a4-f2fbdeed6d21",
                                        "entry_id": "dc9af475-fd25-3dc8-be3e-7367cb52a763",
                                        "glosses": [
                                            "Störung des Säure-Basen-Haushaltes, wobei der pH-Wert des Blutes unter 7,36 sinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79908eb1-5a8a-4f15-8357-473f8f26ae8c",
                                                "sense_id": "deabb661-731a-3eec-89a4-f2fbdeed6d21",
                                                "text": "„Oberste Priorität im Säure-Basen-Haushalt hat allerdings das Blut, dessen pH-Wert mit winzigen Abweichungen um 7,4 schwankt. Sinkt der Wert nur um eine Nuance, unter 7,35, diagnostizieren auch Schulmediziner eine Azidose - eine Übersäuerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab5d6ddb-d959-4dbf-a16a-09eef3001c68",
                        "source_entry_id": "292be48b-f3f5-3205-9ba4-ca50d7511bf6",
                        "source_sense_id": "b06f0e99-d867-322a-82b1-73c0c281721f",
                        "source_sense_description": "Medizin: Acidose, Azidose",
                        "target_lang_word": "Acidose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acidose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40d2fca2-9739-3dde-ab0e-d664b4845839",
                                        "entry_id": "6a0458c4-430b-3536-9b77-a8ad200a127a",
                                        "glosses": [
                                            "Störung des Säure-Basen-Haushaltes, wobei der pH-Wert des Blutes unter 7,36 sinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0204b715-2c1d-4b82-bd91-3fc4c085407c",
                                                "sense_id": "40d2fca2-9739-3dde-ab0e-d664b4845839",
                                                "text": "„Es kommt [bei einer Harnvergiftung] zu einer Überschwemmung des Körpers mit harnpflichtigen Substanzen und damit zu einer Selbstvergiftung mit Acidose und Reststickstofferhöhung, die mit Übelkeit, Appetitlosigkeit, Hautjucken, Kopfschmerzen, Atemnot, urinösem Atemgeruch, Krampfanfällen, Benommenheit bis hin zu Bewusstlosigkeit u. a. einhergeht.“"
                                            },
                                            {
                                                "example_id": "9b050ac9-f0b8-46f2-96e6-92305cbe0e92",
                                                "sense_id": "40d2fca2-9739-3dde-ab0e-d664b4845839",
                                                "text": "„Der Anstieg der Konzentration von Acetoacetat und β-Hydroxybutyrat im Blut führt zu einer pH-Senkung und einer Beeinträchtigung des Kohlensäure-Hydrogencarbonat-Puffersystems, es entsteht eine metabolische Acidose (Ketoacidose).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
