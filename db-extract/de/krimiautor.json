                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e290b0a-1ee4-45d1-a751-99fbec20c0ce",
                                "sense_id": "19ce6047-1357-34fc-97d4-c6d03a0a15b3",
                                "text": "Der Krimiautor von diesem Buch schreibt auch Science-Fiction-Romane."
                            },
                            {
