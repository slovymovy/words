                "senses": [
                    {
                        "sense_id": "9c4802b5-d892-39b3-b519-1755095d9093",
                        "entry_id": "07ebab3c-612e-3f93-8d41-c3da6cf2fc00",
                        "glosses": [
                            "Bouton des fleurs du giroflier qui est à peu près de la figure d’un petit clou à tête et qui est employé comme épice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9914dea-4081-494d-99e6-3e32c18bc5e1",
                                "sense_id": "9c4802b5-d892-39b3-b519-1755095d9093",
                                "text": "De l’huile de girofle."
                            },
                            {
                                "example_id": "10aaeaa3-1208-4e8c-8c20-708b19b1ff16",
                                "sense_id": "9c4802b5-d892-39b3-b519-1755095d9093",
                                "text": "Un clou de girofle."
                            },
                            {
                                "example_id": "8440d426-7a0c-4423-a43d-32dc9b0d49b2",
                                "sense_id": "9c4802b5-d892-39b3-b519-1755095d9093",
                                "text": "Et, au-dessus du fourneau, plus haut que les écumoires, les cuillers, les fourchettes à longs manches, dans une rangée de tiroirs numérotés, s’alignaient les chapelures, la fine et la grosse, les mies de pain pour paner, les épices, le girofle, la muscade, les poivres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f83d3be2-4f5e-4979-b069-446d290bafc5",
                        "source_entry_id": "07ebab3c-612e-3f93-8d41-c3da6cf2fc00",
                        "source_sense_id": "9c4802b5-d892-39b3-b519-1755095d9093",
                        "source_sense_description": "Bouton des fleurs du giroflier",
                        "target_lang_word": "Gewürznelke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewürznelke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b0628a3-5253-393c-80a5-db377f070351",
                                        "entry_id": "f2caf5be-2513-3efa-a241-b02fe3699111",
                                        "glosses": [
                                            "stark duftende und brennend scharf schmeckende, getrocknete Blütenknospe des Gewürznelkenbaums (Syzygium aromaticum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4164a7-8038-4406-a7b4-193d4e2e76cd",
                                                "sense_id": "9b0628a3-5253-393c-80a5-db377f070351",
                                                "text": "Ich würze das Essen gerne mit Gewürznelken."
                                            },
                                            {
                                                "example_id": "5cde8415-b078-4880-9e71-ef0b3a55aa3e",
                                                "sense_id": "9b0628a3-5253-393c-80a5-db377f070351",
                                                "text": "„Die Wirtin stellt den Kessel auf. Mit Gewürznelke oder Zitrone? Ein oder zwei Löffel Zucker?“"
                                            },
                                            {
                                                "example_id": "74d34fea-2cf4-4c59-b79d-1cbb05d1337a",
                                                "sense_id": "9b0628a3-5253-393c-80a5-db377f070351",
                                                "text": "„Schon in der Nase künden Zimt und Gewürznelke von einem opulenten Südfranzosen.“"
                                            },
                                            {
                                                "example_id": "1e8b679c-376d-4f96-876c-9f4c1583f39b",
                                                "sense_id": "9b0628a3-5253-393c-80a5-db377f070351",
                                                "text": "„Pfeffer, Zimt, Muskatnüsse und Gewürznelken waren in Europa überaus begehrt.“"
                                            },
                                            {
                                                "example_id": "930f1743-fca0-4760-a8dd-4c24ea916c70",
                                                "sense_id": "9b0628a3-5253-393c-80a5-db377f070351",
                                                "text": "„Araber führten den Anbau von Gewürznelken aus Mauritius ein und ließen sich in großer Zahl auf Sansibar nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
