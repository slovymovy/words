        "ru-extract.jsonl": [
            {
                "entry_id": "8c1fe141-5cda-38fe-bfe0-9c2015569a14",
                "word": "отроду",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0581925-9c6d-37b2-8b02-f6da6c03994a",
                        "entry_id": "8c1fe141-5cda-38fe-bfe0-9c2015569a14",
                        "glosses": [
                            "разг. с рождения до настоящего времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec62fea2-e6bd-431f-8b94-a3ea34f6b22d",
                                "sense_id": "b0581925-9c6d-37b2-8b02-f6da6c03994a",
                                "text": "Отроду в первый раз такие слышу речи."
                            },
                            {
                                "example_id": "270398fc-9409-4732-85fb-565ba592ca7a",
                                "sense_id": "b0581925-9c6d-37b2-8b02-f6da6c03994a",
                                "text": "Ей отроду около ста лет; но она в полном здравии, и крепка как спартанка."
                            }
                        ]
                    },
                    {
                        "sense_id": "35430150-b2b7-35bd-91a3-5bbe665718b8",
                        "entry_id": "8c1fe141-5cda-38fe-bfe0-9c2015569a14",
                        "glosses": [
                            "разг. перен. никогда"
                        ],
                        "tags": [
                            "в отриц. предложениях"
                        ],
                        "examples": [
                            {
                                "example_id": "bddbd3f4-d93b-45e9-802a-f1d410ab569d",
                                "sense_id": "35430150-b2b7-35bd-91a3-5bbe665718b8",
                                "text": "Начальник карантина (ныне уже покойник), сорок лет служивший в военной службе, отроду не слыхивал свиста пуль, но тут бог привел услышать."
                            },
                            {
                                "example_id": "3028699c-a5d2-4caa-bd52-6c37057db413",
                                "sense_id": "35430150-b2b7-35bd-91a3-5bbe665718b8",
                                "text": "— Этакого дурака я ещё отроду не видывал."
                            }
                        ]
                    }
                ],
                "translations": [],
