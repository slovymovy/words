                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                        "entry_id": "c9293a5c-12f5-34fc-968e-7d248cd1deb5",
                                        "glosses": [
                                            "Elusive; difficult to capture or observe due to constantly outwitting the adversaries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e58d7f-9834-450c-a98a-de252bfedc6b",
                                                "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                                "text": "Catching those thieves will be hard: they're so sneaky!"
                                            },
                                            {
                                                "example_id": "adb65bcb-247e-403d-b1f6-a9d191b21070",
                                                "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                                "text": "Be sneaky. Fish frighten easily."
                                            },
                                            {
                                                "example_id": "a84ade74-3355-4df4-a1e4-662a340ec4c4",
                                                "sense_id": "93f360a9-db03-3b6a-8864-ec964c03fe6a",
                                                "text": "Some fans may have mistaken the album’s floatiness for aimlessness, but Mr. Mercer’s songs have never been sneakier, or prettier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                        "entry_id": "c9293a5c-12f5-34fc-968e-7d248cd1deb5",
                                        "glosses": [
                                            "Dishonest; deceitful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef99175-3c5a-4544-9226-18c09feb4239",
                                                "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                                "text": "They played a sneaky trick on us."
                                            },
                                            {
                                                "example_id": "972a4933-765f-4c0f-8482-bb3d8d1e9e15",
                                                "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                                "text": "A contribution to a wall newspaper of which I was an editor in our sector poked fun at the never-changing menu in the school cafeteria. It centred on the various and devious methods used in serving us hamburger. One time it would be called hamburger, another time bifshtek, then cutlet, and sneakiest of all, schnitzel—the only difference among them was usually only in their shape or whether bread crumbs had been used."
                                            },
                                            {
                                                "example_id": "94c9c1d9-65a6-4150-9747-0317ae056a83",
                                                "sense_id": "9b655ad2-0fbe-368b-be16-f0333f3efd1e",
                                                "text": "Irish car bombs were a sneaky drink—they tasted like a chocolate milk shake, and more than once he'd been seduced into drinking several of them. It was only after he stood up that he realized how much of a wallop they packed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneaky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                                        "entry_id": "5cb24c12-801f-330e-bb7d-aae4b202eb05",
                                        "glosses": [
                                            "Any device used for covert surveillance."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2c6397-e503-452a-bc87-d28c398890e1",
                                                "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                                                "text": "[…] in cooperation with the National Security Agency, installs and maintains \"sneakies\" throughout the U.S.S.R. and Communist China — but increasingly, denied areas are surveyed more simply."
                                            },
                                            {
                                                "example_id": "0d7b748e-f95f-438a-8415-1cb8e8b0f1d0",
                                                "sense_id": "12832282-5676-3b1e-be5f-1a709b2dfc3b",
                                                "text": "[…] has used travellers to plant 'sneakies' - small electronic transmitting devices which form part of a surveillance network."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80068a46-5e83-49ce-9be2-52e4c17a4fa5",
                        "source_entry_id": "8303a254-a236-37af-b819-b1b5ba0e7487",
                        "source_sense_id": "dc324f35-f676-38d7-a43a-146c9e79a06d",
                        "source_sense_description": "stiekem, stom",
                        "target_lang_word": "sournois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sournois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "687bd130-dfe1-395d-8253-39715ec76b4e",
                                        "entry_id": "883722c6-0c40-3ea8-9251-1bb30411d61c",
                                        "glosses": [
                                            "Qui cache ce qu’il pense dans un but malveillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110ffe4c-4b7f-4be1-9a7b-9a289d8f1812",
                                                "sense_id": "687bd130-dfe1-395d-8253-39715ec76b4e",
                                                "text": "Les petits voleurs restaient, les uns debout, les autres accotés contre le lit ou la huche, tous morveux et sales, bien portants d’ailleurs, grugeant leurs prunes sans rien dire, mais regardant l’étranger d’un œil sournois et narquois."
                                            },
                                            {
                                                "example_id": "dc749584-dfcb-47e0-9512-0f957a2b7707",
                                                "sense_id": "687bd130-dfe1-395d-8253-39715ec76b4e",
                                                "text": "Deux hommes sortirent de la cabine. Ils étaient gras et luisants, avec un air de prospérité sournoise sur toute leur personne."
                                            },
                                            {
                                                "example_id": "5019f3ac-ebe4-4675-b672-28c3451ed5f5",
                                                "sense_id": "687bd130-dfe1-395d-8253-39715ec76b4e",
                                                "text": "Et chacun de me plaisanter ; ma jeunesse à son lever, mon parfum de fille fraîche, ma chair toute neuve en son premier éclat éveillaient chez les hommes de sournoises concupiscences, aiguisaient leur regard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a518190-5920-3e24-80f6-fe950f8a23a7",
                                        "entry_id": "883722c6-0c40-3ea8-9251-1bb30411d61c",
                                        "glosses": [
                                            "Qui ne se manifeste pas clairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55d4e63-7f18-42d8-8987-8bde97b8c173",
                                                "sense_id": "5a518190-5920-3e24-80f6-fe950f8a23a7",
                                                "text": "Énorme oiseau de proie, mon avion, désormais hélas ! en pleine lumière, décrit lentement des orbes sournois."
                                            },
                                            {
                                                "example_id": "fe1ba7e5-8e9d-4503-abea-1b5bf62acd4b",
                                                "sense_id": "5a518190-5920-3e24-80f6-fe950f8a23a7",
                                                "text": "C’était un « melon » qui naturellement, subissait toutes les phases du cabossage et de l’aplatissement. Son possesseur avait beau le retaper, l’épousseter, le placer à distance, une fatalité sournoise voulait que, tout à coup, tantôt l’un, tantôt l’autre des acrobates s’élançât à pieds joints sur lui."
                                            },
                                            {
                                                "example_id": "9d4969f4-7120-4c47-9ce6-7a1e570632a0",
                                                "sense_id": "5a518190-5920-3e24-80f6-fe950f8a23a7",
                                                "text": "Le cancer est une maladie sournoise, d’où l’importance des campagnes de dépistage."
                                            },
                                            {
                                                "example_id": "7be2817b-d0bd-419d-a127-1076d5b16af1",
                                                "sense_id": "5a518190-5920-3e24-80f6-fe950f8a23a7",
                                                "text": "Surtout, 2021 nous révélera ses répercussions les plus sournoises, celles qui perdureront pendant des années."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sournois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "003a8078-097e-3d54-95af-353ac98e9eab",
                                        "entry_id": "da9525bb-906e-3660-ae21-7c5205983dcc",
                                        "glosses": [
                                            "Personne sournoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21018cca-26be-46a8-a44c-b6ffb35c2061",
                                                "sense_id": "003a8078-097e-3d54-95af-353ac98e9eab",
                                                "text": "Le drôle voyait bien. Une femme jolie, fraîche, tendre, mécontente d’un mari volage, peu connue, et qui ne faisait point d’enfants ; Sylvina, enfin, au point où le sournois se proposait de l’amener, le friand morceau pour un saint homme !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
