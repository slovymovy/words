                                        "entry_id": "b6fdd3da-c64b-3470-913a-596ff0be3f88",
                                        "glosses": [
                                            "Celui qui s’occupe, qui traite de la cosmologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aee7450-bd4b-439c-b113-40b1cbe2f79d",
                                                "sense_id": "76e4a979-fd0c-37ec-952c-f8e989cb7aa5",
                                                "text": "Cela vous revient maintenant, vous savez qui était Jacques : un cosmologiste de renom."
                                            },
                                            {
                                                "example_id": "0a85c48c-8f95-41b3-9aab-b578fce76ee4",
                                                "sense_id": "76e4a979-fd0c-37ec-952c-f8e989cb7aa5",
                                                "text": "Paralysé par une sclérose latérale amyotrophique, le cosmologiste anglais a accédé à une célébrité mondiale avec son livre Une brève histoire du temps (1989, Flammarion)."
                                            }
