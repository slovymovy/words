                    {
                        "translation_id": "8a7fd1cb-110f-4483-91d8-1664d68f1635",
                        "source_entry_id": "ffb853b8-ec97-3fe2-acdd-532dceab032a",
                        "source_sense_id": "d1c135db-69bd-3167-8d5b-ed9657c215ec",
