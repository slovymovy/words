                    {
                        "sense_id": "50a3d307-6f52-370f-90b3-80d43c535a88",
                        "entry_id": "e07df05a-d65e-397a-9408-e69eae696d97",
                        "glosses": [
                            "Décroissement de la lune."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6a9ee25e-c52b-4588-b042-5e76d47355c7",
                                "sense_id": "50a3d307-6f52-370f-90b3-80d43c535a88",
                                "text": "Pendant le décours de la lune, les bûcherons s’occupent à déhoupper les arbres, à faire des bourrées, scier les tiges dans les longueurs qu’on les veut, former leurs chantiers de bois de chauffage, et fendre les culées ; en même temps, les scieurs de long et les charpentiers débitent les pièces ainsi coupées et préparées par les bûcherons."
                            }
                        ]
                    },
                    {
                        "sense_id": "56d87f93-0a70-3186-a669-713a0bbcba1d",
                        "entry_id": "e07df05a-d65e-397a-9408-e69eae696d97",
                        "glosses": [
                            "Déclin d’une maladie ; fin d’un traitement."
                        ],
                        "tags": [
                            "analogy",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c6cad5a2-8a9e-4c19-9ed3-c019236b8945",
                                "sense_id": "56d87f93-0a70-3186-a669-713a0bbcba1d",
                                "text": "Illustration à l’Institut Bergonié de Bordeaux. Même avant la pandémie, les patientes atteintes d’un cancer du sein pouvaient y bénéficier d’un suivi à distance, que ce soit au décours d’une chimiothérapie (par téléconsultation) ou avant et après une intervention chirurgicale (par une application sur smartphone)."
                            },
                            {
                                "example_id": "2b2c19d6-251a-4cf9-9a85-cb127fd40629",
                                "sense_id": "56d87f93-0a70-3186-a669-713a0bbcba1d",
                                "text": "La fièvre était en son décours."
                            }
                        ]
                    },
                    {
                        "sense_id": "25a56081-a925-3461-8da1-daf232f4434b",
                        "entry_id": "e07df05a-d65e-397a-9408-e69eae696d97",
                        "glosses": [
                            "Déclin, vers la fin."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "78685c2e-d4cb-4d72-b37a-d2ec1fc7389e",
                                "sense_id": "25a56081-a925-3461-8da1-daf232f4434b",
                                "text": "Aujourd’hui, il en est de Versailles comme de certaines stations fastueuses, désertes en automne, au décours de l’année."
                            }
                        ]
                    }
