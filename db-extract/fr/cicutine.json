                                "sense_id": "b9827cd8-d121-3519-a03b-6cdb6b40923e",
                                "text": "La cicutine provoque troubles digestifs, vertiges, céphalées, etc."
                            },
                            {
                                "example_id": "6040b1b1-378e-4cd2-9f52-3dae38afb518",
                                "sense_id": "b9827cd8-d121-3519-a03b-6cdb6b40923e",
                                "text": "La pelletiérine, la cicutine et la pipéridine présentent une action physiologique analogue."
                            }
                        ]
