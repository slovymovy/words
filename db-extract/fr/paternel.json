                            "feminine"
                        ],
                        "form": "paternelle"
                    },
                    {
                        "form_id": "719117dc-4e2c-431d-a80d-64b5b2d0dacd",
                        "entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "paternelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4395b789-9590-3726-9356-4f95241526e8",
                        "entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "glosses": [
                            "Qui a rapport au père, qui appartient au père."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9465936-8a86-4dd6-aa35-11104f398224",
                                "sense_id": "4395b789-9590-3726-9356-4f95241526e8",
                                "text": "Deux minutes après, […], il attendait dans une posture recueillie et digne les ultimes recommandations paternelles."
                            },
                            {
                                "example_id": "47a34491-91b0-4001-b80f-f951c3b95798",
                                "sense_id": "4395b789-9590-3726-9356-4f95241526e8",
                                "text": "Il régnait, en fait, depuis la maladie de son père (1179) et n’avait négligé aucune occasion d’affirmer son autorité, en prenant le contrepied des décisions paternelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "5eddcd26-e8a6-3e67-abf7-943c0c45a896",
                        "entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "glosses": [
                            "Qui vient du père, qui est du côté du père."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c1115c-4858-47d4-8a8d-8471a5ef5256",
                                "sense_id": "5eddcd26-e8a6-3e67-abf7-943c0c45a896",
                                "text": "Succession paternelle."
                            },
                            {
                                "example_id": "2bf8e8ef-1631-4a35-95e1-a72232cc5161",
                                "sense_id": "5eddcd26-e8a6-3e67-abf7-943c0c45a896",
                                "text": "Biens paternels."
                            },
                            {
                                "example_id": "6e1b630d-5501-4c4d-b82b-2d2be27535ac",
                                "sense_id": "5eddcd26-e8a6-3e67-abf7-943c0c45a896",
                                "text": "Grands-parents paternels, du côté paternel."
                            },
                            {
                                "example_id": "e6f9f850-0629-4108-9c89-7c5b36de806d",
                                "sense_id": "5eddcd26-e8a6-3e67-abf7-943c0c45a896",
                                "text": "Ligne paternelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "857b1090-882c-3366-bce0-5697b2d23da1",
                        "entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "glosses": [
                            "Qui est tel qu’il convient à un père, tel qu’il appartient à l’état, à la qualité de père."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d430f0-de86-498f-a480-f6c55e3418d7",
                                "sense_id": "857b1090-882c-3366-bce0-5697b2d23da1",
                                "text": "Julie n’eut pas de peine à croire son père quand elle eut jeté les yeux sur ce visage, auquel de paternelles inquiétudes donnaient un air abattu."
                            },
                            {
                                "example_id": "53d31772-853a-4465-893f-b16d7d3b96ec",
                                "sense_id": "857b1090-882c-3366-bce0-5697b2d23da1",
                                "text": "Il a fait à son élève une remontrance paternelle, toute paternelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1affa81-889c-4314-8b7e-1c4c029f650d",
                        "source_entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "target_lang_word": "väterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "väterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd5d689-1cd9-3f5c-8183-d442ba1a2ccd",
                                        "entry_id": "fa4e11f1-d9cf-3e5d-b1aa-b6c453c67dfb",
                                        "glosses": [
                                            "vom Vater stammend, zum Vater gehörig"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d246fcd-2446-4086-bc82-f904e364853d",
                                                "sense_id": "8fd5d689-1cd9-3f5c-8183-d442ba1a2ccd",
                                                "text": "Im väterlichen Betrieb zu arbeiten kann Freude und Last zugleich sein."
                                            },
                                            {
                                                "example_id": "72e27047-51cc-422c-9d88-f14a7c9b13c8",
                                                "sense_id": "8fd5d689-1cd9-3f5c-8183-d442ba1a2ccd",
                                                "text": "„Die belastenden Erlebnisse meiner mütterlichen und väterlichen Großeltern in Kriegs- und Nachkriegszeit wirken noch heute auf die Familie.“"
                                            },
                                            {
                                                "example_id": "02db8f9e-5d02-4f57-b5e3-4fece500c0ab",
                                                "sense_id": "8fd5d689-1cd9-3f5c-8183-d442ba1a2ccd",
                                                "text": "„Seine Gläubiger waren so anständig gewesen, ihn im Besitz eines kleinen Restes seines väterlichen Vermögens zu lassen, dessen Zinsen bei äußerster Sparsamkeit zu einem sehr bescheidenen Leben hinreichten, ihm jedoch auch nicht den kleinsten Luxus gestatteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c557861-8146-3df2-a457-7b52c30a353f",
                                        "entry_id": "fa4e11f1-d9cf-3e5d-b1aa-b6c453c67dfb",
                                        "glosses": [
                                            "fürsorglich, liebevoll wie ein Vater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba9c681-1685-4d94-b25e-05da02f20e92",
                                                "sense_id": "8c557861-8146-3df2-a457-7b52c30a353f",
                                                "text": "Zu Beginn des Abends hatte Jean-Claude Juncker dem griechischen Ministerpräsidenten [Alexis Tsipras] vor dem Sitzungssaal fast väterlich den Arm um die Schulter gelegt […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60858570-7901-49ed-aba8-b1c82e7acf13",
                        "source_entry_id": "f2b15de1-711e-32f3-8b75-8aca86db3edb",
                        "target_lang_word": "paternal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paternal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                        "entry_id": "dc10194c-d9ad-39d1-b396-053b21079ae3",
                                        "glosses": [
                                            "Of or pertaining to one's father, his genes, his relatives, or his side of a family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175ecaae-f125-4971-be61-2335b7021081",
                                                "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                                "text": "paternal grandfather"
                                            },
                                            {
                                                "example_id": "e222baf8-84ed-4c1e-b450-dc7ca78deddc",
                                                "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                                "text": "It was with a natural touch of pride that Norbourne Courtenaye paced his paternal hall, while waiting for his uncle, with whom he was going to ride."
                                            },
                                            {
                                                "example_id": "62676159-06fc-4967-a6e9-8643b8976216",
                                                "sense_id": "a440d48f-8939-3b65-82f5-d74ba84353fe",
                                                "text": "The eldest son was usually given the name of his paternal grandfather, later children those of other relatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94daffec-039e-3cc6-8c2e-56d639f069dd",
                                        "entry_id": "dc10194c-d9ad-39d1-b396-053b21079ae3",
                                        "glosses": [
                                            "Fatherly; behaving as or characteristic of a father."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f638419a-9c14-3348-b473-4e424b389ad7",
                                        "entry_id": "dc10194c-d9ad-39d1-b396-053b21079ae3",
                                        "glosses": [
                                            "Received or inherited from one's father."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc04400e-8cea-477a-91b3-afd8c5901def",
                                                "sense_id": "f638419a-9c14-3348-b473-4e424b389ad7",
                                                "text": "Thus, ere the ſeeds of vice were ſown, / Liv'd men in better ages born, / Who plow'd with oxen of their own / Their ſmall paternal field of corn."
                                            }
                                        ]
                                    },
                                    {
