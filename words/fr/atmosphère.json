    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c762d62-cd98-3e1b-af03-884b4d273979",
                    "sense_definition": "Couche gazeuse qui entoure un astre, en particulier la Terre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gaz_naturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>atmosphère</w> terrestre protège notre planète des rayonnements nocifs du soleil."
                        },
                        {
                            "text": "La capsule spatiale a commencé à chauffer dès son entrée dans l'<w>atmosphère</w>."
                        }
                    ],
                    "common_phrases": [
                        "atmosphère terrestre",
                        "haute atmosphère"
                    ]
                },
                {
                    "sense_id": "3b432ebd-b4fb-3318-8947-3552646c9908",
                    "sense_definition": "Climat psychologique ou impression générale qui se dégage d'un lieu ou d'une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ambiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>atmosphère</w> chaleureuse et conviviale régnait autour de la table de fête."
                        },
                        {
                            "text": "Le silence soudain a créé une <w>atmosphère</w> pesante dans toute la salle."
                        }
                    ],
                    "common_phrases": [
                        "atmosphère chaleureuse",
                        "atmosphère pesante"
                    ]
                },
                {
                    "sense_id": "306bf06c-4f9b-3d72-8c12-0d283da01e3c",
                    "sense_definition": "Air que l'on respire dans un espace déterminé, souvent clos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "air_respirable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvrez les fenêtres car l'<w>atmosphère</w> de ce bureau est devenue irrespirable."
                        },
                        {
                            "text": "Une <w>atmosphère</w> enfumée empêchait les clients de voir clairement le fond de la pièce."
                        }
                    ],
                    "common_phrases": [
                        "atmosphère confinée",
                        "atmosphère viciée"
                    ]
                },
                {
                    "sense_id": "f60936e4-8ea9-33c1-ae10-20bcf98c656d",
                    "sense_definition": "Unité de mesure de pression équivalant à la pression moyenne de l'air au niveau de la mer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unite_mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce réservoir de gaz comprimé peut supporter une pression de dix <w>atmosphères</w>."
                        },
                        {
                            "text": "À cette profondeur sous l'eau, le sous-marin subit une pression de plusieurs <w>atmosphères</w>."
                        }
                    ],
                    "synonyms": [
                        "bar"
                    ],
                    "common_phrases": [
                        "pression en atmosphères"
                    ]
                }
            ]
        }
    ]
