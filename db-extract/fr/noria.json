                                        "entry_id": "0738979f-7512-329f-8cc6-f020697d102a",
                                        "glosses": [
                                            "Wasserrad mit Zellen, das beim Drehen Wasser aus einem Fluss schöpft und nach oben befördert, ausgießt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a53b87-c4e2-428e-86e4-ed59693623c7",
                                                "sense_id": "702a4d95-2c14-3e9b-b826-15fe9bfc8a38",
