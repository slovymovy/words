                    ]
                },
                {
                    "sense_id": "e0ea763f-59b6-3d94-8efa-da7257a41899",
                    "sense_definition": "Se laisser aller de nouveau à une erreur, un travers ou un piège déjà connu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des mois de modération, il recommence à <w>redonner</w> dans les excès."
                        },
                        {
                            "text": "Malgré nos avertissements, il a fini par <w>redonner</w> dans le même piège grossier."
