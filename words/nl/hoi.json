                {
                    "sense_id": "2a712d03-4e18-3496-b1b9-a14ec6c74533",
                    "sense_definition": "Een uitroep van vreugde of enthousiasme, vaak gebruikt bij verjaardagen of vieringen.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hiep hiep <w>hoi</w>, ze is vandaag jarig!",
                            "target_lang_translations": {
                                "ru": "Гип-гип <w>ура</w>, у нее сегодня день рождения!",
                                "en": "Hip hip <w>hooray</w>, it's her birthday today!",
                                "pl": "Hip hip <w>hura</w>, ona ma dzisiaj urodziny!",
                                "de": "Hip hip <w>hurra</w>, sie hat heute Geburtstag!",
                                "fr": "Hip hip <w>hourra</w>, c'est son anniversaire aujourd'hui !",
                                "it": "Ipp ipp <w>urrà</w>, oggi è il suo compleanno!",
                                "cs": "Hip hip <w>hurá</w>, má dnes narozeniny!",
                                "tr": "Hip hip <w>hurra</w>, bugün onun doğum günü!",
                                "es": "Hip hip <w>hurra</w>, ¡hoy es su cumpleaños!",
                                "zh": "Hip hip <w>万岁</w>，她今天过生日！"
                            }
                        },
                        {
                            "text": "We riepen allemaal hard <w>hoi</w> toen we het goede nieuws hoorden.",
                            "target_lang_translations": {
                                "ru": "Мы все громко закричали <w>ура</w>, когда услышали хорошие новости.",
                                "en": "We all shouted <w>hooray</w> loudly when we heard the good news.",
                                "pl": "Wszyscy głośno krzyknęliśmy <w>hura</w>, kiedy usłyszeliśmy dobre wieści.",
                                "de": "Wir riefen alle laut <w>hurra</w>, als wir die gute Nachricht hörten.",
                                "fr": "Nous avons tous crié <w>hourra</w> quand nous avons appris la bonne nouvelle.",
                                "it": "Abbiamo gridato tutti forte <w>evviva</w> quando abbiamo sentito la buona notizia.",
                                "cs": "Všichni jsme hlasitě vykřikli <w>hurá</w>, když jsme slyšeli tu dobrou zprávu.",
                                "tr": "İyi haberi duyduğumuzda hepimiz yüksek sesle <w>yaşasın</w> diye bağırdık.",
                                "es": "Todos gritamos <w>¡hurra!</w> con fuerza cuando escuchamos las buenas noticias.",
                                "zh": "听到好消息时，我们都大声喊着<w>万岁</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hiep hiep hoi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возглас радости или энтузиазма, часто используемый на днях рождения или праздниках.",
                        "en": "An exclamation of joy or enthusiasm, often used at birthdays or celebrations.",
                        "pl": "Okrzyk radości lub entuzjazmu, często używany podczas urodzin lub świętowania.",
                        "de": "Ein Ausruf der Freude oder Begeisterung, oft bei Feiern verwendet.",
                        "fr": "Une exclamation de joie ou d'enthousiasme, souvent utilisée lors d'anniversaires ou de célébrations.",
                        "it": "Un'esclamazione di gioia o entusiasmo, spesso usata durante compleanni o festeggiamenti.",
                        "cs": "Výkřik radosti nebo nadšení, často používaný při oslavách.",
                        "tr": "Doğum günlerinde veya kutlamalarda kullanılan bir sevinç veya coşku ünlemi.",
                        "es": "Una exclamación de alegría o entusiasmo, usada a menudo en cumpleaños o celebraciones.",
                        "zh": "表示喜悦或兴奋的感叹词，常用于生日或庆祝活动。"
