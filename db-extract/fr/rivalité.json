        "fr-extract.jsonl": [
            {
                "entry_id": "8564b0ef-9d74-3c00-8c97-550e12c7068d",
                "word": "rivalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "568d69f9-a154-42af-9330-e76a869a2e9a",
                        "entry_id": "8564b0ef-9d74-3c00-8c97-550e12c7068d",
                        "tags": [
                            "plural"
                        ],
                        "form": "rivalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a503505f-dabb-3f9c-ad07-746ba42f87dd",
                        "entry_id": "8564b0ef-9d74-3c00-8c97-550e12c7068d",
                        "glosses": [
                            "Concurrence de deux ou de plusieurs personnes qui aspirent, qui prétendent à la même chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c2c0ce7-2243-4c53-9ef9-839931c493bb",
                                "sense_id": "a503505f-dabb-3f9c-ad07-746ba42f87dd",
                                "text": "Une rivalité politique envenimée par les dissentiments religieux préparait depuis longtemps la guerre entre le roi d’Espagne et la reine d’Angleterre."
                            },
                            {
                                "example_id": "cad58258-3d2a-481f-95ea-8940fbe2d862",
                                "sense_id": "a503505f-dabb-3f9c-ad07-746ba42f87dd",
                                "text": "Rivalité dangereuse, funeste. — La rivalité de deux amants. — La rivalité des chefs entraîna la perte de l’armée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae19a3fa-274b-4435-b341-fefa22e2d43c",
                        "source_entry_id": "8564b0ef-9d74-3c00-8c97-550e12c7068d",
                        "source_sense_id": "a503505f-dabb-3f9c-ad07-746ba42f87dd",
                        "target_lang_word": "rivalry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivalry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                                        "glosses": [
                                            "An ongoing relationship between (usually two) rivals who compete for superiority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f20a866-438a-4fd9-ab30-353fc20da423",
                                                "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                                "text": "The Boston Bruins have a longstanding rivalry with the Montreal Canadiens."
                                            },
                                            {
                                                "example_id": "0c564da6-fb01-4b34-b138-5c07225e9449",
                                                "sense_id": "3137b23f-d895-3081-b499-a56e5d1eb469",
                                                "text": "James and Polly have a bitter rivalry due to the latter's inclusion in the Tea Time Teaser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbe3e54-2a9a-3a4c-8093-0e7280c6ef2a",
                                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                                        "glosses": [
                                            "The characteristic of being a rivalrous good, such that it can be consumed or used by only one person at a time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8375f248-3633-4e60-9ab9-12d577f975e5",
                                                "sense_id": "afbe3e54-2a9a-3a4c-8093-0e7280c6ef2a",
                                                "text": "Common goods are those which are rivalrous in consumption but non-excludable"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a494a167-4104-3717-8eec-c2ee1201c8af",
                                        "entry_id": "b60668a8-f631-3024-8a95-97362b4c07fd",
                                        "glosses": [
                                            "Any competition between two or more things or factors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee7c768-4c36-419a-911a-115fc2c4dd27",
                                                "sense_id": "a494a167-4104-3717-8eec-c2ee1201c8af",
                                                "text": "Binocular rivalry is a visual phenomenon in which perception alternates between different images presented to each eye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
