                        "examples": [
                            {
                                "example_id": "9eaa2c5c-4a47-4a2f-b077-3fd67de50fad",
                                "sense_id": "625417f7-82d0-3901-87fa-60f1a9f0eafb",
                                "text": "Two recent books, one by Mr. Grant White on England, one on France by the diabolically clever Mr. Hillebrand, may well have set people thinking on the divisions of races and nations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "037072ce-553c-4eda-b843-72ba4bd7dc8d",
                        "source_entry_id": "bd6c13c5-d2c7-3107-b6a0-8d32bf6db1ac",
                        "source_sense_id": "625417f7-82d0-3901-87fa-60f1a9f0eafb",
