                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ca431219-7a01-4ec4-a9c9-1fa6df824516",
                                "sense_id": "61e966a7-3f3a-3949-a653-c89c76018714",
                                "text": "Da mein Mann keine Einwände dagegen hat, dass in der Regel über mehrere Wochen die Musikauswahl bei den Fahrten am Wochenende zum Wandern keinem Wechsel unterworfen wird, ist hier wieder im Alltag eine gewisse Ordnung vorhanden, die das Gehirn entlastet und mithin beim Einsteigen ins Auto nicht noch Gehirnschmalz für die Liedauswahl aufgewandt werden muss."
                            }
                        ]
                    }
