        "fr-extract.jsonl": [
            {
                "entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                "word": "flingot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e7379f71-633d-4dfd-bd47-1bd46a4fb716",
                        "entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "tags": [
                            "plural"
                        ],
                        "form": "flingots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff5a8d41-7632-3ca1-9cbf-1561850f6110",
                        "entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "glosses": [
                            "Fusil de guerre."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "48b68f95-a6ed-4cdd-aa1d-ee29fafaec5c",
                                "sense_id": "ff5a8d41-7632-3ca1-9cbf-1561850f6110",
                                "text": "Jeunesse héroïque\nArme ton flingot\nPour la République\nEn avant, Moblot !"
                            },
                            {
                                "example_id": "462c2c37-e7eb-44a2-ab0b-e6b9ea16b31e",
                                "sense_id": "ff5a8d41-7632-3ca1-9cbf-1561850f6110",
                                "text": "Allons, conclut-il, passe-moi ton sac et ton flingot, et surtout ne sois pas en retard."
                            },
                            {
                                "example_id": "6da84f5b-1999-40fc-9982-916979abffab",
                                "sense_id": "ff5a8d41-7632-3ca1-9cbf-1561850f6110",
                                "text": "Après un demi-quart d’heure de piétinement au dehors, les hommes de garde rentraient, expirant de froid, exhalant d’épaisses buées, décollant leurs doigts des flingots lancés avec rage, et se laissaient tomber lourdement à la place tiède abandonnée par les camarades."
                            },
                            {
                                "example_id": "e980610d-8eec-4939-94c4-919775c4de41",
                                "sense_id": "ff5a8d41-7632-3ca1-9cbf-1561850f6110",
                                "text": "— Ah ! ce qu’il me scie les pattes, le flingot ! reprit Loubet, en changeant une fois encore son fusil d’épaule. En voilà un mirliton, pour se promener !"
                            },
                            {
                                "example_id": "e709190b-c7a2-4d89-92ff-3b17492ff59a",
                                "sense_id": "ff5a8d41-7632-3ca1-9cbf-1561850f6110",
                                "text": "Tous laisseraient le gobelet d’étain pour prendre l’écuelle à cartouches et piqueraient, non plus dans le petit-salé de faubourg avec leur couteau de treize sous, mais dans le gras-double des bourgeois, avec la fourchette à une dent qui est au bout du flingot."
                            }
                        ]
                    },
                    {
                        "sense_id": "a87692f7-3daa-37b3-9811-f4853e8b7ffb",
                        "entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "glosses": [
                            "Fusil de chasse."
                        ],
                        "tags": [
                            "analogy",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7e1c3b46-cde5-49fe-91a7-de9c0f10fa6b",
                                "sense_id": "a87692f7-3daa-37b3-9811-f4853e8b7ffb",
                                "text": "Il regarda le flingot, un Lefaucheux à deux coups, et constata, circonstance aggravante, que le coup de gauche avait été tiré."
                            },
                            {
                                "example_id": "b53bd6ff-70e2-46f4-b44a-86f3c955a71f",
                                "sense_id": "a87692f7-3daa-37b3-9811-f4853e8b7ffb",
                                "text": "Si cela enlève à la valeur du gibier, ça donne du prix à celle de son coup de flingot, un pigeon étant plus petit qu’un faisan."
                            }
                        ]
                    },
                    {
                        "sense_id": "ceebf415-6532-31f1-b370-0d62fdb8d0dd",
                        "entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "glosses": [
                            "Fusil à aiguiser."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3800156d-ba68-4aee-8568-3d076e2fdf82",
                                "sense_id": "ceebf415-6532-31f1-b370-0d62fdb8d0dd",
                                "text": "Flingot… on sait que l’on nomme ainsi une tige de fer pointue, sur laquelle on aiguise les couteaux et dont se servent particulièrement les bouchers."
                            }
                        ]
                    },
                    {
                        "sense_id": "b009242b-6286-3763-8f09-91d4ed17cfb4",
                        "entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "glosses": [
                            "Le ventre car parfois il fait du bruit comme un fusil de guerre."
                        ],
                        "tags": [
                            "analogy",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1497402d-26c4-4f0a-a9a5-f59040e72e2b",
                        "source_entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "target_lang_word": "Gewehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gewehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b49f09bb-0443-3d0c-a33b-7b98c12394a9",
                                        "entry_id": "d7b7f234-fe4c-3342-9ad6-291b6fb881c6",
                                        "glosses": [
                                            "Schusswaffe ab 30 cm Gesamtlänge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5797c8cc-d360-468c-b4d3-f5d5fe3e5ce6",
                                                "sense_id": "b49f09bb-0443-3d0c-a33b-7b98c12394a9",
                                                "text": "Das Gewehr ist die Braut des Soldaten."
                                            },
                                            {
                                                "example_id": "8afd039f-5892-4fa7-b7e2-84de68c71ea9",
                                                "sense_id": "b49f09bb-0443-3d0c-a33b-7b98c12394a9",
                                                "text": "„Vielleicht hatten sich die feindlichen Heere fürs Erste mit genügend Gewehren, Kugeln und Schießpulver eingedeckt, vielleicht war aber auch Agaja schon zu sehr in die Defensive gedrängt, um sein Heer weiter mit Feuerwaffen versorgen zu können.“"
                                            },
                                            {
                                                "example_id": "5bbf41e7-ea45-40c4-a758-be9e452f88b2",
                                                "sense_id": "b49f09bb-0443-3d0c-a33b-7b98c12394a9",
                                                "text": "„Jetzt sind wir in der Kaserne und geben die Gewehre ab.“"
                                            },
                                            {
                                                "example_id": "5bb47ada-a193-42ed-8697-d40122ef6ffa",
                                                "sense_id": "b49f09bb-0443-3d0c-a33b-7b98c12394a9",
                                                "text": "„Und die kleine Berthe stellte ihm ihr Bein hin, daß er stolperte und mit seinem Gewehr wild in der Luft herumschwenkte und schließlich mit großem Pardauz auf die Nase fiel.“"
                                            },
                                            {
                                                "example_id": "1ca024aa-e44e-4066-af6c-ed19b11a5d31",
                                                "sense_id": "b49f09bb-0443-3d0c-a33b-7b98c12394a9",
                                                "text": "„Ich hielt das Gewehr bereit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9e98dcd-a88f-3d6d-abae-b90dfbcf3475",
                                        "entry_id": "d7b7f234-fe4c-3342-9ad6-291b6fb881c6",
                                        "glosses": [
                                            "jede Waffe jeglicher Art, insbesondere Hieb-, Schlag- und Stichwaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa81bd40-92f8-40e0-976c-ed70fe60b66d",
                                                "sense_id": "d9e98dcd-a88f-3d6d-abae-b90dfbcf3475",
                                                "text": "„Ein rother ahnungsvoller Schein; / Schon blutig blinken die Gewehre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d133cd1-13cd-37f1-9243-8ad421fb7ba4",
                                        "entry_id": "d7b7f234-fe4c-3342-9ad6-291b6fb881c6",
                                        "glosses": [
                                            "Eckzähne des Wildschweins"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e702617d-d979-4892-bf25-c174e67c14b6",
                                                "sense_id": "9d133cd1-13cd-37f1-9243-8ad421fb7ba4",
                                                "text": "Die Gewehre eines alten Keilers sind eine begehrte Trophäe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fba3dd2f-7866-4f94-9133-34e24b83d4ae",
                        "source_entry_id": "6ada76de-d5de-31f0-ad7b-cf42b10ca325",
                        "target_lang_word": "Flinte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flinte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09161e11-9f98-3291-82ff-44942482d959",
                                        "entry_id": "f28b4055-6488-350e-a814-c04cf578666b",
                                        "glosses": [
                                            "Gewehr mit glattem Lauf, zum Verschießen von Schrot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c821fb1-4b3a-4a99-8362-cdf2b3eea249",
                                                "sense_id": "09161e11-9f98-3291-82ff-44942482d959",
                                                "text": "Der Jäger schoss sich mit seiner Flinte versehentlich in den linken Fuß."
                                            },
                                            {
                                                "example_id": "a29979fb-f4c1-4dbf-8606-7dc2e2704c6b",
                                                "sense_id": "09161e11-9f98-3291-82ff-44942482d959",
                                                "text": "„Agaja klagte darüber, dass er nicht im Besitz einer Formel sei, um sein eigenes Schießpulver herzustellen, denn er begriff sehr gut, dass er sich mit der Modernisierung seiner Streitmacht von den europäischen Händlern abhängig gemacht hatte und sich darauf verlassen musste, dass sie ihm regelmäßig Flinten, Kugeln und Pulver lieferten.“"
                                            },
                                            {
                                                "example_id": "75538863-c4e1-4205-a943-1a14d656abb4",
                                                "sense_id": "09161e11-9f98-3291-82ff-44942482d959",
                                                "text": "„Kaba überprüfte eilig seine Flinte.“"
                                            },
                                            {
                                                "example_id": "ce8c44cb-059e-4fee-85e5-f9aa3d8de49d",
                                                "sense_id": "09161e11-9f98-3291-82ff-44942482d959",
                                                "text": "„Den Daumen seiner linken Hand hatte er hinter den Gürtel gehakt, und in seinen linken Arm schmiegte sich eine doppelläufige Flinte.“"
                                            },
                                            {
                                                "example_id": "228195ae-b907-4bbc-adf9-f85d2f6d775b",
                                                "sense_id": "09161e11-9f98-3291-82ff-44942482d959",
                                                "text": "„Es gab Bücherregale mit herrlichen unlesbaren Büchern und – in einem Winkel – eine Flinte, ein Schmetterlingsnetz und einen Bergstock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
