                "senses": [
                    {
                        "sense_id": "bc99baa0-f77b-35f0-947f-5f95bedce350",
                        "entry_id": "f3cc053b-f9e1-3deb-801f-0f636ba60878",
                        "glosses": [
                            "Teilchenbeschleuniger, in dem geladenen Teilchen, im Gegensatz zu einem Linearbeschleuniger, eine mehr oder weniger „runde“ – beispielsweise annähernd spiral- oder kreisförmige – Bahn wiederholt durchlaufen"
                        ],
                        "tags": [
                            "Kernphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "8b315826-3fe6-4caf-a27e-941884b9b0a9",
                                "sense_id": "bc99baa0-f77b-35f0-947f-5f95bedce350",
                                "text": "„Das Zyklotron am Hahn-Meitner-Institut, das zu 90 Prozent vom Bund und zu 10 Prozent vom Land Berlin finanziert wird, ist offenbar eine Art Bauernopfer, das für die Neuordnung der Großforschungseinrichtungen gebracht wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "144c9383-f2a2-44bb-a418-a3b620c745f6",
                        "source_entry_id": "f3cc053b-f9e1-3deb-801f-0f636ba60878",
                        "source_sense_id": "bc99baa0-f77b-35f0-947f-5f95bedce350",
                        "source_sense_description": "Zyklotron",
                        "target_lang_word": "cyclotron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclotron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5245d6c-9406-3b69-b2db-0b1ce5692717",
                                        "entry_id": "458a1bb0-402e-32d1-a069-cc79058637c7",
                                        "glosses": [
                                            "An early particle accelerator in which charged particles were generated at a central source and accelerated spirally outward through a fixed magnetic field and alternating electric fields."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d68ad9-09a5-4960-9163-93ef62922cfc",
                                                "sense_id": "f5245d6c-9406-3b69-b2db-0b1ce5692717",
                                                "text": "The two cyclotrons achieve their biological effects by focusing charged particles on the tumor. However, the mechanisms differ."
                                            },
                                            {
                                                "example_id": "036ceec9-168b-4fff-a896-325d0b4d48b3",
                                                "sense_id": "f5245d6c-9406-3b69-b2db-0b1ce5692717",
                                                "text": "We do not examine the 6 hours surrounding perikron as the ion cyclotron waves in this region have already been extensively discussed [Leisner et al., 2006]. Perikron was close to 2100 on 24 December and the inbound pass cuts through the dayside magnetosphere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
