                                        "sense_id": "b8f8d991-d68e-3db6-ac64-341a2e27b4ae",
                                        "entry_id": "a3d62256-d655-3c54-bc56-a92a734e5a6c",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5982f2b6-7ea2-4841-8dd7-f63f07c4ab30",
                                                "sense_id": "b8f8d991-d68e-3db6-ac64-341a2e27b4ae",
                                                "text": "« En tant que policiers, ils sont là pour interpeller. En tant qu’association, nous sommes présents pour une prise en charge globale de la victime », rappelle Frédérique Martz, co-fondatrice et Directrice Générale de Women Safe & Children."
                                            },
                                            {
                                                "example_id": "57c47ecf-1204-46ed-8363-5d78cee78ad6",
                                                "sense_id": "b8f8d991-d68e-3db6-ac64-341a2e27b4ae",
                                                "text": "La spécialiste de l’évolution climatique et de son histoire dans la littérature Frédérique Rémy reprend et poursuit un de ses thèmes de prédilection : la lutte de femmes, en particulier celles du rude milieu marin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904407ab-3c11-3716-9652-4de3fcfa9f1c",
