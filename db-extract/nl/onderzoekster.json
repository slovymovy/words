                        "entry_id": "6b4f096b-1797-33f6-9d52-beedd423772a",
                        "glosses": [
                            "een vrouwelijk persoon die (al dan niet wetenschappelijke) vraagstukken onderzoekt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "9dfbc7cc-ecdc-462e-a46e-694c5a05368f",
                                "sense_id": "5660d072-2e42-3809-9a4b-b3a4fa9d7285",
                                "text": "Die Amerikaanse onderzoekster heeft een nieuwe bacterie ontdekt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d17b88e-ec55-404a-b75d-7e6f44229550",
                        "source_entry_id": "6b4f096b-1797-33f6-9d52-beedd423772a",
                        "source_sense_id": "5660d072-2e42-3809-9a4b-b3a4fa9d7285",
                        "source_sense_description": "een vrouwelijk persoon die vraagstukken onderzoekt",
                        "target_lang_word": "Forscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                        "entry_id": "37c98f1a-351b-3206-86c9-e34d5ff4aeca",
                                        "glosses": [
                                            "weibliche Person, die wissenschaftliche Zusammenhänge untersucht"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Forschung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7baa4536-e821-4aa5-98f6-262740727a84",
                                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                                "text": "Viele Forscherinnen versuchen herauszufinden, wie das menschliche Gehirn funktioniert."
                                            },
                                            {
                                                "example_id": "09f141a9-2e69-4edf-b879-ffc593d909e2",
                                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                                "text": "„Um die Fortbildung von Polizisten kümmert sich die rührige Forscherin ebenfalls.“"
                                            },
                                            {
                                                "example_id": "c125d222-c7c9-4dd0-94a9-17a105065161",
                                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                                "text": "„An diesem Gespräch waren zwei Forscherinnen beteiligt, die zwischen 20 und 25 Jahre alt sind.“"
                                            },
                                            {
                                                "example_id": "9ff345ca-7100-4df0-aa10-54349b24462d",
                                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                                "text": "„Auf sieben Gebieten orteten die Forscherinnen die Zutaten des langen gesunden Lebens.“"
                                            },
                                            {
                                                "example_id": "84aff0c7-e4a3-460d-8e52-fd51fd9ac200",
                                                "sense_id": "878bbabb-ba19-36a0-8acf-7fa6980f45fa",
                                                "text": "„Es gelang den Forscherinnen und Forschern, von neun der Toten genügend mitochondriale DNA – das Erbgut der weiblichen Linie – für eine Analyse zu extrahieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f61ac984-646d-45fb-92e2-d48efca4485f",
                        "source_entry_id": "6b4f096b-1797-33f6-9d52-beedd423772a",
                        "source_sense_id": "5660d072-2e42-3809-9a4b-b3a4fa9d7285",
                        "source_sense_description": "een vrouwelijk persoon die vraagstukken onderzoekt",
                        "target_lang_word": "researcher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "researcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72dc3ec9-71f6-3ed1-913a-b5629e81f5e1",
                                        "entry_id": "5757c58a-ab04-3d64-8102-957f22dc4046",
                                        "glosses": [
                                            "One who researches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984817fe-06c0-45cb-8ddd-92ab2996a127",
                                                "sense_id": "72dc3ec9-71f6-3ed1-913a-b5629e81f5e1",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            },
                                            {
                                                "example_id": "af3c5209-ce52-4ae2-b4ca-22746b1ee164",
                                                "sense_id": "72dc3ec9-71f6-3ed1-913a-b5629e81f5e1",
                                                "text": "The Amazon is larger than the next two largest rainforests combined, according to Rhett Butler, a rainforest researcher and the CEO of Mongabay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4370f98b-6f65-4e18-83b1-e5f0c1bf35f0",
                        "source_entry_id": "6b4f096b-1797-33f6-9d52-beedd423772a",
                        "source_sense_id": "5660d072-2e42-3809-9a4b-b3a4fa9d7285",
                        "source_sense_description": "een vrouwelijk persoon die vraagstukken onderzoekt",
                        "target_lang_word": "chercheuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chercheuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92b3c043-7209-328b-9460-b08f2e805628",
                                        "entry_id": "8279bafb-fe80-38e5-8d44-2fc5646cf4f8",
                                        "glosses": [
                                            "Celle qui cherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10308cc4-ab41-4144-8783-6067e44c13be",
                                                "sense_id": "92b3c043-7209-328b-9460-b08f2e805628",
                                                "text": "Les titres qui font recettes ? La chercheuse d’esprit de Charles Simon Favart, jouée deux cents fois de suite après sa création en 1741, ou encore Arlequin, roi de Serendib de Lesage, Les troqueurs de Vadé et Dauvergne en 1753…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e5b2f49-f693-35d3-9b1c-dd2e4722e082",
                                        "entry_id": "8279bafb-fe80-38e5-8d44-2fc5646cf4f8",
                                        "glosses": [
                                            "Femme, qui seule ou membre d’une équipe, se consacre à la recherche scientifique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf22be1-86af-42da-8e48-c76f855c74ed",
                                                "sense_id": "3e5b2f49-f693-35d3-9b1c-dd2e4722e082",
                                                "text": "La chercheuse a estimé, en dernier ressort, être la seule personne responsable de la validité des contenus. Ainsi, elle s’est réservée le jugement final quant à la pertinence de l’intégration des éléments d’analyse apportés par le groupe ou les intermédiaires. Tout en valorisant le savoir du groupe, la chercheuse, pendant le processus, a donc gardé la maîtrise de l’interprétation des résultats et des modalités de cette interprétation."
                                            },
                                            {
                                                "example_id": "bde89433-6922-42e2-962f-50ba4ac9ee64",
                                                "sense_id": "3e5b2f49-f693-35d3-9b1c-dd2e4722e082",
                                                "text": "L’épiderme du chef de l’État en danger ? Cette crainte est exprimée par deux très sérieuses docteures en pharmacie, chercheuses et enseignantes au laboratoire de pharmacie industrielle et de cosmétologie de la faculté de Nantes."
                                            },
                                            {
                                                "example_id": "38ed2266-3f49-49d7-8306-a5306c83353e",
                                                "sense_id": "3e5b2f49-f693-35d3-9b1c-dd2e4722e082",
                                                "text": "Il faut laisser le temps au spectateur de reprendre l’habitude de se rendre dans les salles, pondère Stéphanie Pourquier-Jacquin, chercheuse au Conservatoire national des arts et métiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chercheuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bad4b2ff-3a6a-3228-877e-b5f72b2785d3",
                                        "entry_id": "bba59210-b1ea-33a8-b6f1-6f56bbf76975",
                                        "glosses": [
                                            "Féminin singulier de chercheur."
                                        ],
