                        "glosses": [
                            "schulden en rekeningen verrekenen met name met betrekking tot pensioenrechten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b085b99b-c5aa-4ce9-bc86-fe04e3b3bec6",
                                "sense_id": "22036a23-d0b5-39f8-91a7-5be718b7d0ba",
                                "text": "Partijen waren bij huwelijkse voorwaarden recht op pensioenverevening volgens de wet overeengekomen, tenzij schriftelijk anders werd bepaald. Het tijdens het huwelijk opgebouwde pensioen moest dan ook worden verevend."
                            }
                        ]
                    },
                    {
                        "sense_id": "b35a7092-5d37-39bb-af76-bd68047e4993",
                        "entry_id": "08744191-5e15-3cb7-b8ba-b91d8944be09",
                        "glosses": [
                            "conflicten oplossen door uitwisseling van geld, goederen of diensten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ebbb0b4-857a-41b7-991d-e2187222abae",
                                "sense_id": "b35a7092-5d37-39bb-af76-bd68047e4993",
                                "text": "Een zogenoemd vanihuwelijk, waarbij een meisje of vrouw wordt gedwongen te trouwen om een misdaad of ruzie te verevenen, is illegaal in Pakistan. Desalniettemin komt dit soort huwelijk vrij vaak voor."
                            }
                        ]
                    }
