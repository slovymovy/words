                "senses": [
                    {
                        "sense_id": "a33a7845-affd-384f-b8b3-7dcf4041d92e",
                        "entry_id": "3740cd5e-6c96-3073-9550-457816664079",
                        "glosses": [
                            "een basisbegrip dat zonder bewijs aangenomen moet worden"
                        ],
                        "tags": [],
