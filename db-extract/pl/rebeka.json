                "senses": [
                    {
                        "sense_id": "d79c26a9-b867-39fc-9f45-5a94e43b381c",
                        "entry_id": "51ffc25c-ca88-3387-be25-7c12537cb3a9",
                        "glosses": [
                            "postać biblijna, żona patriarchy Izaaka"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "2e191ef8-776d-4f08-916e-2ebaaa83002d",
                                "sense_id": "d79c26a9-b867-39fc-9f45-5a94e43b381c",
                                "text": "Wziąwszy Rebekę za żonę, Izaak miłował ją, bo była mu pociechą po matce"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1b1f3cd8-5c67-3c72-9756-a9db3199127f",
                        "entry_id": "51ffc25c-ca88-3387-be25-7c12537cb3a9",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79ad3d1-d6c3-4367-8092-b6d57a0c7e39",
                                "sense_id": "1b1f3cd8-5c67-3c72-9756-a9db3199127f",
                                "text": "W sierpniu skoczymy z Marzeną i Rebeką w Beskidy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a051bf9a-1417-4a25-b26f-dae23a3f1e9b",
                        "source_entry_id": "51ffc25c-ca88-3387-be25-7c12537cb3a9",
                        "source_sense_id": "1b1f3cd8-5c67-3c72-9756-a9db3199127f",
                        "target_lang_word": "Rebecca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rebecca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "025ad9c0-dc31-373f-ae4d-0194b780af5b",
                                        "entry_id": "5acbebc7-00d3-33b8-b334-3ae5ce357e4d",
                                        "glosses": [
                                            "A female given name originating from the Bible [in turn from Hebrew], in regular use since the Reformation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da6119a5-ca9d-4492-a900-ff83d6ff30aa",
                                                "sense_id": "025ad9c0-dc31-373f-ae4d-0194b780af5b",
                                                "text": "And not only this; but when Rebecca also had conceived by one, even by our father Isaac; (For the children being not yet born, neither having done any good or evil, that the purpose of God according to election might stand, not of works, but of him that calleth;) It was said unto her, The elder shall serve the younger."
                                            },
                                            {
                                                "example_id": "2fb175bc-c3ed-4300-ac85-66820537e1ef",
                                                "sense_id": "025ad9c0-dc31-373f-ae4d-0194b780af5b",
                                                "text": "They would say, if 'twas Rebecca,\nThat she is a little Quaker."
                                            },
                                            {
                                                "example_id": "62026f96-3f06-4987-81ea-82d36b774b7e",
                                                "sense_id": "025ad9c0-dc31-373f-ae4d-0194b780af5b",
                                                "text": "\"What's her name?\" I asked. \"Rebecca. Rebecca Valentine.\" The name Rebecca excited me. I had always wanted to meet a woman called Rebecca—and not Becky. (Rebecca, Ruth, Roxane, Rosalind, Frederika, Ursula, Sheila, Norma, Guinevere, Leonora, Sabina, Malvina, Solange, Deirdre. What wonderful names women had! Like flowers, stars, constellations…)"
                                            },
                                            {
                                                "example_id": "dd7c6b45-f315-4c5c-9ad6-d07ad2a485e2",
                                                "sense_id": "025ad9c0-dc31-373f-ae4d-0194b780af5b",
                                                "text": "Our daughter's name, Rebecca, summons up similar visions. Although our family is not Jewish, both names (David and Rebecca) have a Hebrew ancestry which, in the eyes of many beholders ( i.e. teachers ) invokes a vision of a family that values education."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rebecca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6418af5-937a-319c-8e69-1788f9e95bc9",
                                        "entry_id": "50c74396-cb0c-314d-937f-989e062a1c20",
                                        "glosses": [
                                            "One who protested in the Rebecca Riots; a Rebeccaite."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36239cd-4bc4-4e25-b7c9-31b044b0e81d",
                                                "sense_id": "b6418af5-937a-319c-8e69-1788f9e95bc9",
                                                "text": "Colonel George Rice Trevor testified that the Rebeccas attacked poor-houses as well as tollgates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f0d697b-c129-4e42-9dcb-b4bba2afdf6e",
                        "source_entry_id": "51ffc25c-ca88-3387-be25-7c12537cb3a9",
                        "source_sense_id": "1b1f3cd8-5c67-3c72-9756-a9db3199127f",
                        "target_lang_word": "Rebekah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rebekah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b83b5f97-0ec8-3047-9ddc-4eae38b1b3a2",
                                        "entry_id": "d8675575-b6f1-3170-a885-37f038f44e61",
                                        "glosses": [
                                            "The sister of Laban; Isaac's wife; the mother of Jacob and Esau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "050d4513-7ef2-4b98-ba59-088f3e00ecde",
                                                "sense_id": "b83b5f97-0ec8-3047-9ddc-4eae38b1b3a2",
                                                "text": "And Isaac was fortie yeeres old when hee tooke Rebekah to wife, the daughter of Bethuel the Syrian of Padan Aram, the ſiſter to Laban the Syrian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4333768-b67d-3bac-9235-3329b83029ad",
                                        "entry_id": "d8675575-b6f1-3170-a885-37f038f44e61",
                                        "glosses": [
                                            "A female given name from Hebrew, a less-common variant of Rebecca."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
