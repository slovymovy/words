                "senses": [
                    {
                        "sense_id": "c5ba624d-d6f7-36cc-b470-b7a56ea44673",
                        "entry_id": "e9a0cc15-39af-3a38-9a5b-9af1d1e504e9",
                        "glosses": [
                            "übertriebene, blinde Liebe häufig für die Liebe der Eltern zu ihren Kindern gebraucht"
                        ],
                        "tags": [
                            "Volkssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "713a4174-b664-4f1a-88d7-3bf010179105",
                                "sense_id": "c5ba624d-d6f7-36cc-b470-b7a56ea44673",
                                "text": "Die Eltern brachten ihrem Kleinen eine wahre Affenliebe entgegen."
                            },
                            {
                                "example_id": "c176a087-dfbf-4fb7-9abb-e4507a539302",
                                "sense_id": "c5ba624d-d6f7-36cc-b470-b7a56ea44673",
                                "text": "Ob viel „Affenliebe\" einem Kind schadet? Das dürften Eltern sehr unterschiedlich beurteilen."
                            },
                            {
                                "example_id": "2eab215f-b927-4c21-b24f-af922905b041",
                                "sense_id": "c5ba624d-d6f7-36cc-b470-b7a56ea44673",
                                "text": "[Präsident des NABU] Olaf Tschimpke: „Affenliebe ist für mich eigentlich positiv besetzt, weil Affen sehr soziale Wesen sind und sehr zusammenhalten in Großfamilien. Hier klingt der ja eigentlich, wenn wir ihn benutzen, negativ. …“"
                            },
                            {
                                "example_id": "ea02b9b4-8990-403f-aff4-f87fd08cb779",
                                "sense_id": "c5ba624d-d6f7-36cc-b470-b7a56ea44673",
                                "text": "„Ich konnte auch nichts an ihm entdecken, was einen Anhaltspunkt für Rosas Affenliebe gegeben hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
