            "senses": [
                {
                    "sense_id": "729b4ecb-eb54-3afc-a4ca-6f67cdf4906a",
                    "sense_definition": "pojąć sens, treść lub znaczenie czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pojmowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel wyjaśnił zadanie jeszcze raz, żebym dokładnie wszystko <w>zrozumiał</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил задание ещё раз, чтобы я точно всё <w>понял</w>.",
                                "en": "The teacher explained the task again so that I would completely <w>understand</w> everything.",
                                "zh": "老师又把题目解释了一遍，好让我彻底<w>明白</w>。"
                            }
                        },
                        {
                            "text": "Dopiero po przeczytaniu całej instrukcji wreszcie <w>zrozumiałem</w> ten problem.",
                            "target_lang_translations": {
                                "ru": "Только после прочтения всей инструкции я наконец <w>разобрался в</w> этой проблеме.",
                                "en": "Only after reading the whole manual did I finally <w>understand</w> the problem.",
                                "zh": "读完整个说明书后，我才终于<w>搞懂</w>了这个问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pojąć",
                        "skapować",
                        "skumać"
                    ],
                    "common_phrases": [
                        "zrozumieć problem",
                        "zrozumieć pytanie",
                        "łatwo zrozumieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "уяснить смысл, содержание или значение чего-либо",
                        "en": "to grasp the meaning, content, or significance of something",
                        "zh": "弄懂、领会某事的含义、内容或意义"
                    },
                    "translations": {
