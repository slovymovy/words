                            {
                                "example_id": "829733ac-e046-42ed-bca9-c2fb63c6a0dc",
                                "sense_id": "1232f710-5f31-3a04-8ca3-1bfb1c7de646",
                                "text": "De woningcorporaties mogen vanaf 1 januari 10 procent van hun huizen verhuren aan mensen die meer verdienen dan 33.614 euro. Minister Piet Hein Donner (Binnenlandse Zaken) houdt vol dat die 10 procent genoeg is om mensen te helpen die boven die grens zitten, maar toch in de woonproblemen komen."
                            },
                            {
                                "example_id": "c8449348-648b-43c1-a3ff-ca7231d1ff28",
                                "sense_id": "1232f710-5f31-3a04-8ca3-1bfb1c7de646",
                                "text": "Volgens SBS is Jeroen “de ideale presentator” om “de hectische competitie in goede banen te leiden”. De Topper deelt niet alleen opdrachten uit, hij gaat ook wekelijks het land in op zoek naar “het verhaal achter de ontwerp-opdracht: het woonprobleem”."
                            }
                        ]
