                ],
                "senses": [
                    {
                        "sense_id": "2a491a63-d943-3142-8402-283e348c28de",
                        "entry_id": "00fade55-b121-3898-b790-d4033eb43113",
                        "glosses": [
                            "Sir, as a polite form of address to a Dutchman or Afrikaner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6c6199-50d0-4fb4-92c8-abeead2bda60",
                                "sense_id": "2a491a63-d943-3142-8402-283e348c28de",
                                "text": "My hand, bully; thou shalt have egress and regress; said I well? and\nthy name shall be Brook. It is a merry knight. Will you go, mynheers?"
                            },
                            {
                                "example_id": "ed1a3f11-9f3d-4831-a0a0-adbff260e8e1",
                                "sense_id": "2a491a63-d943-3142-8402-283e348c28de",
                                "text": "But trifling apart, there is one thing certain, mynheeren, and that is, that some extraordinary event is taking place on board the Dutchman."
                            },
                            {
                                "example_id": "e2ec85c2-8278-407e-ae14-172cde4233bc",
                                "sense_id": "2a491a63-d943-3142-8402-283e348c28de",
                                "text": "I do not know, mynheeren, how far I am bound to accede to your request, and to bring forward for the consideration of the Council the document of which you have given me the outline."
                            },
                            {
                                "example_id": "4fb3041a-4795-4018-9eac-43075a55bb65",
                                "sense_id": "2a491a63-d943-3142-8402-283e348c28de",
                                "text": "The Dutch mynheeren and mevrouwen everywhere are busily engaged in decorating their clean cities and no doubt they will all lift their glasses at the same time and drink the health of their good Queen with that famous national drink Holland gin."
                            }
                        ]
                    }
                ],
