                "senses": [
                    {
                        "sense_id": "6581e686-0180-3cfc-94a9-69b96569606e",
                        "entry_id": "c51299c9-706d-3124-a77e-369d0aa3b959",
                        "glosses": [
                            "To not broadcast a medal-winning or otherwise memorable or crucial figure skating performance. This only occurs in a live broadcast because the network has to decide which programs to show and which to cut in the interest of time. If a skater is low in the rankings and several big names are set to skate later, that performance may be cut."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aec3ae7c-fc74-46d9-baf9-50d8cf6c922e",
                                "sense_id": "6581e686-0180-3cfc-94a9-69b96569606e",
                                "text": "Michael Chack pulled WAY up in the standings in his long [skate event]...but was chacked while we saw five guys skate worse!!"
                            },
                            {
                                "example_id": "3e8634de-6bc0-49dc-8b87-652dabde8e5e",
                                "sense_id": "6581e686-0180-3cfc-94a9-69b96569606e",
                                "text": "I'm hoping ABC doesn't chack her performance...how could they??"
                            },
                            {
                                "example_id": "7b03c390-79c8-46c6-9c97-dbb2ba63a9ca",
                                "sense_id": "6581e686-0180-3cfc-94a9-69b96569606e",
                                "text": "Did they chack Kostner's skate because of the fluff piece on the Russian pairs or not? I kind of like her and wanted to see her."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
