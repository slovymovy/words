                                "target_lang_sense_clarification": "becoming mentally unstable or foolish"
                            },
                            {
                                "target_lang_word": "to become foolish",
                                "target_lang_sense_clarification": "losing good judgment"
                            }
                        ]
                    }
                },
                {
