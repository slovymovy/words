        "fr-extract.jsonl": [
            {
                "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                "word": "matérialité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c938d34-d459-4243-9fde-1bdc8f1ea1cb",
                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "matérialités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7b3e60d-a8ff-35f2-bd09-f65b05d058bc",
                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "glosses": [
                            "Qualité de ce qui est matériel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fc6026-2f3a-4123-8c66-31c87a507b9f",
                                "sense_id": "d7b3e60d-a8ff-35f2-bd09-f65b05d058bc",
                                "text": "Ce voyage de leurs noces, non plus dans la chaude Italie, mais au pays des glaces et des neiges, était sans doute d’une élégance rare, qui disait bien la distinction de leur amour, exempt de toute matérialité grossière."
                            },
                            {
                                "example_id": "e798bfed-317c-4eb9-8b12-16aff1952ee8",
                                "sense_id": "d7b3e60d-a8ff-35f2-bd09-f65b05d058bc",
                                "text": "La question du support est notamment celle de la matérialité."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a1972f3-5550-3b1f-bb9b-fb6453527ed1",
                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "glosses": [
                            "Information matérielle, c’est-à-dire dont l’omission, l’inexactitude ou l’occultation est raisonnablement susceptible d’influencer les décisions d’acheter ou de vendre des actions d’une entreprise, ou de lui prêter ou pas des capitaux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1d10194c-ce50-3e71-8bc4-5abd1f09e420",
                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "glosses": [
                            "Réalité d’un fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcdd4946-a27f-4c4e-95e0-e7e91afd9200",
                                "sense_id": "1d10194c-ce50-3e71-8bc4-5abd1f09e420",
                                "text": "Confirmant une information de nos confrères d’Actu Rennes, le procureur de la République adjoint Sébastien Farges nous indique que la décision ne leur « apparaît pas conforme à la matérialité des faits »."
                            }
                        ]
                    },
                    {
                        "sense_id": "205f9d4d-eb84-333c-a492-7a9547b50c16",
                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "glosses": [
                            "Tendance à s’attacher aux choses matérielles, ou à leur donner une importance prééminente."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55b79d8d-a091-4e0b-bdec-264896c214a9",
                        "source_entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "target_lang_word": "materiality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materiality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a22f5d4-0491-3c20-adcd-282f5772654e",
                                        "entry_id": "cd059803-19e5-39df-81b9-43c1a9a69b23",
                                        "glosses": [
                                            "The quality of being material; having a physical existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b9ab4a-ffd5-46ef-bcac-5ba423842e47",
                                                "sense_id": "2a22f5d4-0491-3c20-adcd-282f5772654e",
                                                "text": "This deed accomplished, life no longer suffers hopelessly under the terrible mutilations of ubiquitous disaster, battered by time, hideous throughout space; but with its horror visible still, its cries of anguish still tumultuous, it becomes penetrated by an all-suffusing, all-sustaining love, and a knowledge of its own unconquered power. Something of the light that blazes invisible within the abysses of its normally opaque materiality breaks forth, with an increasing uproar."
                                            },
                                            {
                                                "example_id": "8cf44dcf-c98e-4f5a-a1ef-99d0790f92e8",
                                                "sense_id": "2a22f5d4-0491-3c20-adcd-282f5772654e",
                                                "text": "According to Judd, in his polemical statement of aesthetic purpose \"Specific Objects,\" written the year he created Untitled, the intransigent materiality of his nonallusive objects would provide a \"credible\" experience for viewers, free from any external connotations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cca79e-73f1-32a2-9a92-cde403966294",
                                        "entry_id": "cd059803-19e5-39df-81b9-43c1a9a69b23",
                                        "glosses": [
                                            "The quality of being of consequence to a legal decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e18b4d5-f540-46ca-a7df-c83fbef20fb2",
                        "source_entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "target_lang_word": "materialidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e7f233de-9432-4a45-a1bc-dd4406eca0fd",
                        "source_entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                        "target_lang_word": "materialità",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materialità",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "7051c1c7-0aac-3df6-aa7f-f376ea00bd1f",
                                        "entry_id": "e009d15f-4ab3-3ae9-89cf-53695a61d441",
                                        "glosses": [
                                            "quanto risulta impoverito di interiorità e/o di vigore spirituale"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fb014e4-bdae-46b4-9b90-b6ee73ab549a",
                                                "sense_id": "7051c1c7-0aac-3df6-aa7f-f376ea00bd1f",
                                                "text": "l'etica religiosa insegna soprattutto a non cadere nella materialità"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4ff121-4c3f-3f07-97f5-84145d385fe4",
                                        "entry_id": "e009d15f-4ab3-3ae9-89cf-53695a61d441",
                                        "glosses": [
                                            "velo dietro al quale si cela l'ambito spirituale"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8417b1b-eb0f-4009-b05e-1bce7c467ffa",
                                                "sense_id": "3f4ff121-4c3f-3f07-97f5-84145d385fe4",
                                                "text": "nella materialità è comunque possibile scorgere molti segni veritieri"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe0b3a6-d993-351a-829d-50b596aaa356",
                                        "entry_id": "e009d15f-4ab3-3ae9-89cf-53695a61d441",
                                        "glosses": [
                                            "desiderio e passioni iniqui; indipendenza o autonomia apparenti rispetto alla volontà divina, un'esistenza meramente vana da cui è quasi impossibile liberarsi e da cui spesso è arduo districarsi anche per chi è accanto a chi ne subisce appunto le trappole implacabilmente determinanti l'effimero destino del malcapitato, è la peggiore forma del laicismo pressoché simile ad un lieve ateismo"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99302512-b1a5-4612-aae9-91e40469b2e1",
                                                "sense_id": "2fe0b3a6-d993-351a-829d-50b596aaa356",
                                                "text": "l'opacità della materialità"
                                            },
                                            {
                                                "example_id": "400e1063-6aa3-4615-b9b8-726f1b8c3463",
                                                "sense_id": "2fe0b3a6-d993-351a-829d-50b596aaa356",
                                                "text": "Mao Mino era un filosofo un poco religioso ma attanagliato da una radicale materialità tale al punto di diffonderne quasi una puzza a distanza di dieci metri e più"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26e936f-b879-3d6b-931e-e821527b5d06",
                                        "entry_id": "e009d15f-4ab3-3ae9-89cf-53695a61d441",
                                        "glosses": [
                                            "il perseguimento del solo lavoro, il desiderio quindi per il lusso soltanto o per cose simili ad esso e la passione viscerale per tutto ciò che è opposto alla devozione religiosa"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7085b9a7-a7ee-480b-9095-056c022ec6d4",
                                                "sense_id": "d26e936f-b879-3d6b-931e-e821527b5d06",
                                                "text": "poiché foriera di vizi quali l'alcol o le droghe ed i locali, la materialità è un incubo per chi vive la religione ebraica in modo veramente spirituale"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
