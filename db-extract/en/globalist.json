                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                        "glosses": [
                            "An advocate of globalism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443ed4e3-b161-4ac8-9652-a5af031f1ee5",
                                "sense_id": "ff2f322d-1ed8-3165-ad1c-bdbbbff6aa05",
                                "text": "You are either a globalist or a nationalist; one cannot be both."
                            }
                        ]
                    },
                    {
                        "sense_id": "aac10689-276e-3222-8309-dac97137dd35",
                        "entry_id": "a58c30aa-463e-38c6-8208-8ef2d42234b5",
                        "glosses": [
                            "A Jew, implying that Jews are more loyal to a global conspiracy than the country which they live in."
                        ],
                        "tags": [
                            "ethnic",
                            "offensive",
                            "slur"
