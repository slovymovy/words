                "senses": [
                    {
                        "sense_id": "a310f044-4e4b-393e-9949-9c1a6b7826ef",
                        "entry_id": "84158878-b023-38b3-9876-b67d93f87f61",
                        "glosses": [
                            "L'un l’autre (pronom réciproque)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0fba09-9c2f-4e69-a6ed-ade809e055a4",
                                "sense_id": "a310f044-4e4b-393e-9949-9c1a6b7826ef",
                                "text": "In Paris duzten wir einander, aber am Telefon hatte er »Sie« gesagt, wir bleiben also beim »Sie«.",
                                "translation": "À Paris, nous nous tutoyons l'un l'autre, mais il avait dit « vous » au téléphone et nous en restons donc au vouvoiement."
                            },
                            {
                                "example_id": "b765b16f-290b-459e-a51c-c6763dbb0e4c",
                                "sense_id": "a310f044-4e4b-393e-9949-9c1a6b7826ef",
                                "text": "Wir lernen einander so gut kennen.",
                                "translation": "Nous apprenons à nous connaître l'un l'autre."
                            },
                            {
                                "example_id": "07bf6f02-26c4-4bea-81c7-3fc6675c33eb",
                                "sense_id": "a310f044-4e4b-393e-9949-9c1a6b7826ef",
                                "text": "Assane und ich sind in der Obhut von Tokô Ngor und unserer Mutter aufgewachsen wie zwei kleine Prinzen. Sie liebten uns beide, aber wir liebten einander nicht. Ich jedenfalls nicht meinen Bruder. Ich glaube, die Abneigung beruhte auf Gegenseitigkeit, auch wenn er das Gegenteil behauptete.",
                                "translation": "Assane et moi avons été élevés comme deux petits princes par Tôko Ngor et notre mère. Nous étions tous deux aimés, mais ne nous aimions pas l’un l’autre. Moi, en tout cas, je n’aimais pas mon frère. Je crois que c’était réciproque, quoi qu’il prétendît."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "6c249a7d-6eb5-3848-9d6a-b1fffce8ef50",
                "word": "einander",
                "pos": "pron",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                        "entry_id": "6c249a7d-6eb5-3848-9d6a-b1fffce8ef50",
                        "glosses": [
                            "eine oder einer der oder dem anderen, eine oder einer die oder den anderen, sich oder uns oder euch wechselseitig/gegenseitig"
                        ],
                        "tags": [
                            "zumeist gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "8005d2a8-a2b8-4427-af9f-7334a609c714",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "Hans und Maria sehen einander nur noch selten."
                            },
                            {
                                "example_id": "4dad87b9-1a32-4d83-8215-9feaa5a9be22",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "Wir lieben einander."
                            },
                            {
                                "example_id": "1a39d64f-b7de-4c57-a7e6-e6ae95262af7",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "Die Aussagen des Angeklagten widersprechen einander."
                            },
                            {
                                "example_id": "43e14606-ac55-425b-8f3b-49914fe6b598",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "Eure Nachbarn und ihr leiht einander eure Autos?"
                            },
                            {
                                "example_id": "2b1c87fc-0b3c-4659-809d-6b1e9ece4e90",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "Statt uns dauernd anzufeinden, sollten wir einander lieber die Hand reichen."
                            },
                            {
                                "example_id": "f7e2a2eb-d992-4a6b-9c56-3eab125b4ea7",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "„Er ging neben seinem Schwips her und tat, als kennten sie einander nicht.“"
                            },
                            {
                                "example_id": "98ebf309-f056-46b2-aa47-97d1bcf333a3",
                                "sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                                "text": "„Zwei Schimpansen, die einander nie gesehen, nie mit einander gekämpft und einander nie die Läuse aus dem Pelz gesucht haben, wissen nicht, ob sie einander über den Weg trauen können, ob es sich lohnt, dem anderen zu helfen, oder welcher der beiden in der Rangordnung über dem anderen steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae6faa16-f286-4a67-931c-26bbb1f4c943",
                        "source_entry_id": "6c249a7d-6eb5-3848-9d6a-b1fffce8ef50",
                        "source_sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
                        "source_sense_description": "eine oder einer der oder dem anderen, eine oder einer die oder den anderen",
                        "target_lang_word": "each other",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "each other",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                        "entry_id": "fbff04ee-7061-379c-a3d6-78408300d13a",
                                        "glosses": [
                                            "To one another; one to the other; signifies that a verb applies to two or more entities both as subjects and as direct objects"
                                        ],
                                        "tags": [
                                            "pronoun",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44ea647-a005-4ca6-8777-fe6faaa76631",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "My parents love each other; however, they talk to themselves a lot but not so much to each other."
                                            },
                                            {
                                                "example_id": "f390dbdc-43c2-48ad-ab7a-9744f38081d9",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "I don't think you two know each other, do you?"
                                            },
                                            {
                                                "example_id": "7f783839-0cec-4e31-b074-1af1cfa9dd4c",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet: or anon we shot into a clearing, with a colored glimpse of the lake and its curving shore far below us."
                                            },
                                            {
                                                "example_id": "43362fb9-8f41-45db-846e-d917f2354901",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Passengers wander restlessly about or hurry, with futile energy, from place to place. Pushing men hustle each other at the windows of the purser's office, under pretence of expecting letters or despatching telegrams."
                                            },
                                            {
                                                "example_id": "e5983f92-939f-4572-beea-4ab7193d00f0",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "We've known each other many years, but this is the first time you ever came to me for counsel or for help."
                                            },
                                            {
                                                "example_id": "49bf8472-471e-4447-a346-6366a63411f5",
                                                "sense_id": "2da3c710-7174-3b9c-9abb-00993b43ad51",
                                                "text": "It was the first time United had conceded six goals at Old Trafford since 1930, when Huddersfield won 6-0 and Newcastle 7-4 within four days of each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e76e2cd8-1024-479d-885b-e6be7ac5b3ad",
                        "source_entry_id": "6c249a7d-6eb5-3848-9d6a-b1fffce8ef50",
                        "source_sense_id": "3348ccf3-851f-3cc2-999b-f08a0d299102",
