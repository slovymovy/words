                "senses": [
                    {
                        "sense_id": "af022ff0-ef8a-3716-b21e-529a51bf3a59",
                        "entry_id": "fab96c72-6cab-3f41-99d5-0a327c44b084",
                        "glosses": [
                            "Handlung, etwas nachzuweisen, aufzuzeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d46c1eb5-d63f-408e-80b0-1c5ebd562dc3",
                                "sense_id": "af022ff0-ef8a-3716-b21e-529a51bf3a59",
                                "text": "„Bezweckt wird von Gott aber mit dieser Ausstellung eine Erweisung seiner Gerechtigkeit in zwiefacher Hinsicht.“"
                            },
                            {
                                "example_id": "f520926f-9632-4a98-bf49-a9f70db371bc",
                                "sense_id": "af022ff0-ef8a-3716-b21e-529a51bf3a59",
                                "text": "„Die einzelnen pflichtmäßigen Erweisungen der sittlichen Gesinnung sind die guten Werke.“"
                            },
                            {
                                "example_id": "c2f903fd-6db2-46ed-ab86-647f278315d7",
                                "sense_id": "af022ff0-ef8a-3716-b21e-529a51bf3a59",
                                "text": "„Soll jenes Mittel zu diesem Zweck passen, so muss dieser Zweck, also die Erweisung der Gerechtigkeit Gottes, jenem Mittel entsprechend gedacht werden.“"
                            },
                            {
                                "example_id": "7e38fe85-4d71-4395-9fb4-a77d70531947",
                                "sense_id": "af022ff0-ef8a-3716-b21e-529a51bf3a59",
                                "text": "„Aber auch von dieser höchsten Erweisung menschlichen Liebens leugnet der Apostel, dass in ihr das Wesen der Liebe bestehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
