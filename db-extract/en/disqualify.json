                "senses": [
                    {
                        "sense_id": "0eee11a5-20c7-3d4f-9f6a-de83a8e61754",
                        "entry_id": "30ddcc73-a25e-304b-a95e-2d3e080ce64d",
                        "glosses": [
                            "To make ineligible for something."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f9bb020a-64bb-4bfc-ba41-ae54c619e049",
                                "sense_id": "0eee11a5-20c7-3d4f-9f6a-de83a8e61754",
                                "text": "My age disqualifies me for the position."
                            },
                            {
                                "example_id": "6efeff91-8ccf-424c-ae0b-4f20cd2d4418",
                                "sense_id": "0eee11a5-20c7-3d4f-9f6a-de83a8e61754",
                                "text": "A Kentucky salvage certificate of title may be issued from an out-of-state junking certificate or other ownership document bearing a designation of \"junk,\" \"unrebuildable,” or other similar classification that disqualifies the vehicle from being titled for use on the highway in that state with the following provisions:"
                            },
                            {
                                "example_id": "20ea3427-eea0-4bd4-97a2-532b5e824bc5",
                                "sense_id": "0eee11a5-20c7-3d4f-9f6a-de83a8e61754",
                                "text": "It certainly does not follow that the women’s accusations would disqualify Biden from the presidency; one could point out, fairly, that Biden has behaved this way with men as well. (“Joe Biden doesn’t just meet you, he engulfs you,” Mark Bowden wrote in The Atlantic in 2010, generalizing the notion of Bidenian affection. […])"
                            }
                        ]
                    },
                    {
                        "sense_id": "cf4f7702-5117-34e8-ba24-bd8c6cd67e33",
                        "entry_id": "30ddcc73-a25e-304b-a95e-2d3e080ce64d",
                        "glosses": [
                            "To exclude from consideration by the explicit revocation of a previous qualification."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e37ff570-d330-4b17-87f7-6c92ce6f94e5",
                                "sense_id": "cf4f7702-5117-34e8-ba24-bd8c6cd67e33",
                                "text": "The athlete was disqualified after performance-enhancing drugs were found in his hotel room."
                            },
                            {
                                "example_id": "dbc30961-0ef8-4d9b-a838-e045f9323b29",
                                "sense_id": "cf4f7702-5117-34e8-ba24-bd8c6cd67e33",
                                "text": "If the disqualifications leave a vacancy for the full complement of finalists, swim-offs shall be continued among the disqualified swimmers until a full complement of finalists is assured."
                            },
                            {
                                "example_id": "2d407b49-58e4-43bd-8506-5de1100cfbbf",
                                "sense_id": "cf4f7702-5117-34e8-ba24-bd8c6cd67e33",
                                "text": "A simple majority of 61 MKs will be able to do whatever it wants without any checks and balances; the Supreme Court will not be able to disqualify a law; […]"
                            }
                        ]
                    }
                ],
