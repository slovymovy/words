                                "target_senses": [
                                    {
                                        "sense_id": "fa7e7bb1-6741-3733-b7e8-1c0947f32a06",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "Reverence and devotion to God."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effa3cd2-2877-4185-8f9d-b404b5d94f09",
                                                "sense_id": "fa7e7bb1-6741-3733-b7e8-1c0947f32a06",
                                                "text": "Colleen's piety led her to make sacrifices that most people would not have made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90d4add-40f4-373a-b85f-3555453d4f92",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "Similar reverence to one's parents and family or to one's country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5a3a81-f574-459d-86f3-067303cc63e6",
                                                "sense_id": "d90d4add-40f4-373a-b85f-3555453d4f92",
                                                "text": "patriotism as piety, when done right"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "842debf2-bbe3-321f-bfe4-88c174a2e863",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "A devout or otherwise laudable act, thought, or statement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b643bc6-4260-49db-8e34-33b6f61ea984",
                                                "sense_id": "842debf2-bbe3-321f-bfe4-88c174a2e863",
                                                "text": "Those who dwell outside of Western Establishment bastions are not idiots just because they do not mouth the pieties of GASP. Some of them can write very well. There are other traditions, you know. They could write for Wikipedia, if you let them. But such true openness and genuine tolerance is unacceptable, precisely because those other traditions fail to pay exclusive homage to GASP sources, through which—Wikipedians imagine—all the benefits of global civilization flow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052d8111-17b9-318d-8352-80297cab643f",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "A devout or otherwise laudable act, thought, or statement.",
                                            "A platitude that may be empty or at least facile and undercommitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43912da-79eb-452d-97bc-442cd9154ffb",
                                                "sense_id": "052d8111-17b9-318d-8352-80297cab643f",
                                                "text": "He was quick with the pieties about hard work, honest communication, active listening, and respecting others' viewpoints, but walking the walk is different from talking the talk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
