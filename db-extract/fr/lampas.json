        "fr-extract.jsonl": [
            {
                "entry_id": "fbac9bdc-dd4f-3c72-bc5a-a1eab190bf89",
                "word": "lampas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bbdb80ec-9245-3883-9b1c-c531ecd8f85a",
                        "entry_id": "fbac9bdc-dd4f-3c72-bc5a-a1eab190bf89",
                        "glosses": [
                            "Engorgement ou allongement de la membrane qui tapisse le palais du cheval."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "c945803e-7d73-485a-aa01-e61428e84d58",
                                "sense_id": "bbdb80ec-9245-3883-9b1c-c531ecd8f85a",
                                "text": "Ce cheval ne mangera que quand vous lui aurez ôté le lampas."
                            }
                        ]
                    },
                    {
                        "sense_id": "90ebd614-77e7-3e95-9716-e5b1fa7a9cfb",
                        "entry_id": "fbac9bdc-dd4f-3c72-bc5a-a1eab190bf89",
                        "glosses": [
                            "Gorge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d75dcb-b03b-41b4-92b7-d680e267a9cf",
                                "sense_id": "90ebd614-77e7-3e95-9716-e5b1fa7a9cfb",
                                "text": "…Ah ! ah ! sire Grégoire,\nVous avez soif ! je crois qu'en vos repas\nVous humectez volontiers le lampas."
                            },
                            {
                                "example_id": "793e6c78-c484-4f11-b55e-dd98b1909001",
                                "sense_id": "90ebd614-77e7-3e95-9716-e5b1fa7a9cfb",
                                "text": "Là ne pourrait-on pas, attendant le dîner, humecter le lampas  ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3a0cf255-3071-33e3-a848-7fdd4a2ddcda",
                "word": "lampas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86bd14bf-1e05-4e6c-afa2-99f5222fc5ad",
                        "entry_id": "3a0cf255-3071-33e3-a848-7fdd4a2ddcda",
                        "tags": [],
                        "form": "lampasse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aac232c0-4173-3586-91ba-d588ca649116",
                        "entry_id": "3a0cf255-3071-33e3-a848-7fdd4a2ddcda",
                        "glosses": [
                            "Étoffe de soie qui venait originairement d’Orient et qui est en général à grands dessins d’une couleur différente de celle du fond."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b117d94-b413-40ef-86a7-d63fcc8cc149",
                                "sense_id": "aac232c0-4173-3586-91ba-d588ca649116",
                                "text": "Ils déroulèrent de magnifiques étoffes de soie de la Chine, des lampas découpés à jour."
                            },
                            {
                                "example_id": "7a1dfcaf-cbe9-4762-ae0b-1a394288a6fc",
                                "sense_id": "aac232c0-4173-3586-91ba-d588ca649116",
                                "text": "Et quand Hervé traversa le grand salon, où des panneaux en glaces alternaient avec des tentures de lampas blanc, où des statues de marbre posées sur des socles d’ébène coudoyaient des tableaux de maîtres placés sur des chevalets dorés, où de vastes fauteuils-duchesse entouraient majestueusement la cheminée, Hervé revit par la pensée les sévères boiseries de chêne, les meubles vermoulus et les portraits d’ancêtres de la grande galerie où son père recevait les châtelains des environs."
                            },
                            {
                                "example_id": "f9fb0a93-32f9-40bb-979a-63fa27c2084f",
                                "sense_id": "aac232c0-4173-3586-91ba-d588ca649116",
                                "text": "Avant de lui répondre je la conduisis jusqu’à ma porte. Celle-ci en s’ouvrant fit refluer la lumière rose qui remplissait la chambre et changeait la mousseline blanche des rideaux tendus sur le soir en lampas aurore."
                            }
                        ]
                    }
                ],
