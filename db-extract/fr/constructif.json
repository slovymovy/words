                                                "example_id": "faeb3540-c1fb-4aa3-9422-f5e8cbd29c5c",
                                                "sense_id": "1c3ae6d2-a1bd-3d8b-acdd-f05ae5f920c0",
                                                "text": "Die Schule befindet sich baulich in einem schlechten Zustand."
                                            },
