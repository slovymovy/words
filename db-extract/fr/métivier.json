                        "examples": [
                            {
                                "example_id": "cb0a599c-f232-4d70-add0-4ab8e7dfd8ef",
                                "sense_id": "d1f803f8-eefd-3b28-80aa-5d5830a91626",
                                "text": "Le personnel se compose du père et de la mère, de leurs trois filles, de deux domestiques, d'un métivier et un pâtour."
                            }
                        ]
                    },
                    {
                        "sense_id": "91b32343-6ddd-3a18-a733-c53df47151cf",
                        "entry_id": "4b294613-41c7-3b26-a503-fe8119e3b1bd",
                        "glosses": [
                            "Ouvrier agricole qui se louait à la journée pendant la période des moissons."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "630ac103-1311-42d9-be39-c703a8f85173",
                                "sense_id": "91b32343-6ddd-3a18-a733-c53df47151cf",
                                "text": "Là, sur les marches qui descendent dans la rue, on rencontre, comme vous savez , les gars de ferme sans ouvrage, ceux qui veulent se faire embaucher pour l’année entière, et les métiviers qui ne cherchent que le travail de l’été."
                            }
                        ]
                    }
