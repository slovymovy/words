                    {
                        "form_id": "e15c9934-93c6-423a-b2b3-ce519ad81e7c",
                        "entry_id": "7d5046e5-6bc7-3a0e-814e-c36a84b3c20c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Herzanfälle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                        "entry_id": "7d5046e5-6bc7-3a0e-814e-c36a84b3c20c",
                        "glosses": [
                            "Herzinfarkt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e6175aed-feff-485b-8831-a8e2cac458c6",
                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                "text": "„Kurz nach dieser Dummheit an der Schlucht hatte meine Mutter einen Herzanfall und kam ins Krankenhaus, und um ihr Bett war ein Wandschirm aus Bambus aufgestell.“"
                            },
                            {
                                "example_id": "dfabbfca-eeeb-4ee8-b374-1a0cab8c50a8",
                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                "text": "„Gegen 11 Uhr erlitt Josef S. in Anwesenheit seiner Gattin plötzlich einen akuten Herzanfall, er kollabierte und brach zusamme.“"
                            },
                            {
                                "example_id": "d8c0a538-081e-49c8-b3aa-4739c20a4262",
                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                "text": "„In der ersten Nacht bekam Perlmann einen Herzanfall und wurde mit Blaulicht in die Klinik gefahren.“"
                            },
                            {
                                "example_id": "a5a49a73-2f3e-4fcc-a2ac-693ba7a45c4d",
                                "sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                                "text": "„Für einen Syndikus ist sein Auftreten befremdlich, man muß sich um ihn sorgen, er sieht aus, als stünde er vor einem Herzanfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7316d14-faff-4f00-96b3-70049a1b4436",
                        "source_entry_id": "7d5046e5-6bc7-3a0e-814e-c36a84b3c20c",
                        "source_sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
                        "source_sense_description": "umgangssprachlich: Herzinfarkt",
                        "target_lang_word": "heart attack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heart attack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a135b2ce-02a5-3543-ba67-7cd88efc5fba",
                                        "entry_id": "d3af3485-4f8b-3137-9ada-1ba6908493b0",
                                        "glosses": [
                                            "An acute myocardial infarction, sometimes fatal, caused by the sudden occurrence of coronary thrombosis, which obstructs the blood supply to the heart and leads to necrosis of heart muscle tissue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3dbff06-e73f-4ebd-a513-af989cb122bd",
                                                "sense_id": "a135b2ce-02a5-3543-ba67-7cd88efc5fba",
                                                "text": "Before kick-off, a section of Chelsea's support sadly let themselves and their club down by noisily interrupting the silence held in memory of the Hillsborough disaster and for Livorno midfielder Piermario Morosini, who collapsed and died after suffering a heart attack during a Serie B game on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11124095-df97-3f72-9585-c0695e62e5bc",
                                        "entry_id": "d3af3485-4f8b-3137-9ada-1ba6908493b0",
                                        "glosses": [
                                            "A major fright."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5482f4be-edc0-4925-91b4-92c2c8b2a45d",
                                                "sense_id": "11124095-df97-3f72-9585-c0695e62e5bc",
                                                "text": "She'll have a heart attack when she sees that!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c52c355d-5639-3923-9cc8-972df2a690e0",
                                        "entry_id": "d3af3485-4f8b-3137-9ada-1ba6908493b0",
                                        "glosses": [
                                            "Death or failure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374a1058-ebe7-4bec-89c3-26ed82de140b",
                                                "sense_id": "c52c355d-5639-3923-9cc8-972df2a690e0",
                                                "text": "My computer had a heart attack when I tried to get it to run that program."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b85ec50-9fe4-4f4f-803b-85d474ba9330",
                        "source_entry_id": "7d5046e5-6bc7-3a0e-814e-c36a84b3c20c",
                        "source_sense_id": "0289b072-ea8d-3759-86b1-e3ceb22959a1",
