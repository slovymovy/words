        "nl-extract.jsonl": [
            {
                "entry_id": "4fb2bc40-deba-3852-baf5-fe44c8cfa04f",
                "word": "chloor",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eb2e3e8a-f097-3bb0-89b1-904e790ffa22",
                        "entry_id": "4fb2bc40-deba-3852-baf5-fe44c8cfa04f",
                        "glosses": [
                            "scheikundig element met symbool Cl en atoomnummer 17. Het is een geelgroen halogeen ,dat bij kamertemperatuur gasvormig is"
                        ],
                        "tags": [
                            "element"
                        ],
                        "examples": [
                            {
                                "example_id": "94d29d89-afd8-466a-8e24-566f7118f3ab",
                                "sense_id": "eb2e3e8a-f097-3bb0-89b1-904e790ffa22",
                                "text": "Rode ogen na een middagje zwembad worden veroorzaakt door urine, en niet door chloor, schreef Metro. En inderdaad, uit urine ontstaan chemische, irriterende stofjes. Maar: daarvoor heb je óók chloor nodig. Het eerste deel van de stelling klopt dus, het tweede deel niet. We beoordelen de stelling daarom als half waar."
                            },
                            {
                                "example_id": "b2f5edcb-a870-495b-8820-99349d754d93",
                                "sense_id": "eb2e3e8a-f097-3bb0-89b1-904e790ffa22",
                                "text": "Veel andere hikers gebruikten de Sawyer Squeeze, waarmee je handmatig het vuile water door een filter moest persen. Andere opties voor waterfiltering zijn de Aquamira-chlorine-dioxine-druppels, of simpelweg chloor, waarvan alle bacteriën en microben blijkbaar doodgaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdeb3ff4-89b4-435b-9714-8333b91a13a3",
                        "source_entry_id": "4fb2bc40-deba-3852-baf5-fe44c8cfa04f",
                        "source_sense_id": "eb2e3e8a-f097-3bb0-89b1-904e790ffa22",
                        "target_lang_word": "Chlor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chlor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f85c23-7e26-3d58-8aec-1ddc3b37adc1",
                                        "entry_id": "fb01e4ae-0675-3bd2-9ac5-a210f7041411",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 17"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7933f288-217b-4ba5-8912-bd74c3456e0e",
                                                "sense_id": "c0f85c23-7e26-3d58-8aec-1ddc3b37adc1",
                                                "text": "„Chlor zählt neben Fluor zu den reaktivsten Elementen und reagiert mit fast allen Elementen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d3f9d9c-c11a-3659-a6e2-98976d39e3df",
                                        "entry_id": "fb01e4ae-0675-3bd2-9ac5-a210f7041411",
                                        "glosses": [
                                            "gelbgrünes, giftiges, stechend riechendes Gas, das aus Molekülen zu je zwei Chloratomen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceae284b-d313-4eb2-8328-74041d73d77f",
                                                "sense_id": "7d3f9d9c-c11a-3659-a6e2-98976d39e3df",
                                                "text": "Das Wasser in der Schwimmhalle roch wieder stark nach Chlor."
                                            },
                                            {
                                                "example_id": "acac9322-f944-4134-87f5-cac0b4a8fdd9",
                                                "sense_id": "7d3f9d9c-c11a-3659-a6e2-98976d39e3df",
                                                "text": "„Technisch wird Chlor fast ausschließlich durch verschiedene elektrochemische Verfahren hergestellt, im kleineren Maßstab kann es auch auf chemischen Weg gewonnen werden“."
                                            },
                                            {
                                                "example_id": "8eb7d5b3-edb9-4cc5-ba73-dc90d97c1025",
                                                "sense_id": "7d3f9d9c-c11a-3659-a6e2-98976d39e3df",
                                                "text": "„Das Wasser schmeckte heute stärker nach Chlor als sonst.“"
                                            },
                                            {
                                                "example_id": "f4e0977e-939a-4a03-a39f-7951c0525421",
                                                "sense_id": "7d3f9d9c-c11a-3659-a6e2-98976d39e3df",
                                                "text": "„Der Pool war so stark mit Chlor versetzt worden, dass jetzt zwar alle Algen eliminiert waren, aber auch alle Haare der Badenden sich in Gestrüpp verwandelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16a84382-f3d2-423c-9cab-2c71619c8d56",
                        "source_entry_id": "4fb2bc40-deba-3852-baf5-fe44c8cfa04f",
                        "source_sense_id": "eb2e3e8a-f097-3bb0-89b1-904e790ffa22",
                        "target_lang_word": "chlorine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5b4fd1-fb72-3334-b28e-58b74f7a2393",
                                        "entry_id": "0e2df68d-b0ee-3fe4-9c9e-1271f1d23a77",
                                        "glosses": [
                                            "A toxic, green, gaseous chemical element (symbol Cl) with an atomic number of 17."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8414f651-87da-4e1a-8ccc-f5d192c963a1",
                                                "sense_id": "0c5b4fd1-fb72-3334-b28e-58b74f7a2393",
                                                "text": "When TCCA touches a small amount of water and doesn’t dissolve, “it can experience a chemical reaction, generating heat and causing the decomposition of the chemical, which in turn produces toxic chlorine gas and can produce explosive nitrogen trichloride,” a 2023 report by the CSB said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5daddce8-d1c4-375d-a270-e1b5ca7bff99",
                                        "entry_id": "0e2df68d-b0ee-3fe4-9c9e-1271f1d23a77",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e25ed69b-9833-3827-a6b6-6d396fd629af",
                                        "entry_id": "0e2df68d-b0ee-3fe4-9c9e-1271f1d23a77",
                                        "glosses": [
                                            "A chlorine-based bleach or disinfectant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b775e32f-137f-4f0a-ad53-549f22f1dfa4",
                                                "sense_id": "e25ed69b-9833-3827-a6b6-6d396fd629af",
                                                "text": "The mechanism involved in the explosive reaction between swimming pool chlorine (calcium hypochlorite) and brake fluid (polyethylene glycol), a possible improvised explosive mixture, has been studied by means of the gaseous products produced."
                                            },
                                            {
                                                "example_id": "7a73045e-7ad0-4b27-a1a9-9406d5a49c0b",
                                                "sense_id": "e25ed69b-9833-3827-a6b6-6d396fd629af",
                                                "text": "Chlorines are useful for disinfecting water and for housekeeping disinfectants."
                                            },
                                            {
                                                "example_id": "b60de862-3205-4dad-bb0f-7a465d5ae424",
                                                "sense_id": "e25ed69b-9833-3827-a6b6-6d396fd629af",
                                                "text": "Of the chemical solutions, chlorine tablets will kill many pathogens, but not some parasites like giardia and amoebic cysts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cbd3d79-6a84-4e82-a4c0-9e3011cfda5e",
                        "source_entry_id": "4fb2bc40-deba-3852-baf5-fe44c8cfa04f",
                        "source_sense_id": "eb2e3e8a-f097-3bb0-89b1-904e790ffa22",
                        "target_lang_word": "chlore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62f38bdb-38fd-307c-a6d6-25af1590462e",
                                        "entry_id": "b2596d75-d35e-33f5-b312-36a3e995c5af",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 17 et de symbole Cl qui fait partie des halogènes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf9279f-bdfb-4597-8237-904c61d00cd2",
                                                "sense_id": "62f38bdb-38fd-307c-a6d6-25af1590462e",
                                                "text": "Quelquefois on décape l’argent à l'acide azotique, mais il faut employer de l’acide bien exempt de chlore, qui formerait du chlorure d’argent à la surface de l’objet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e1b45d-e739-3605-ae03-aedd295cda86",
                                        "entry_id": "b2596d75-d35e-33f5-b312-36a3e995c5af",
                                        "glosses": [
                                            "Gaz de dichlore (Cl₂) d’un vert pâle, jaunâtre et d’une odeur désagréable, toxique et irritant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d8f507a-4ace-4d60-a5bb-a3b29fa81b74",
                                                "sense_id": "10e1b45d-e739-3605-ae03-aedd295cda86",
                                                "text": "Le chlore sert à blanchir les toiles."
                                            },
                                            {
                                                "example_id": "f8caf320-3f08-4715-8850-9371763e5f4e",
                                                "sense_id": "10e1b45d-e739-3605-ae03-aedd295cda86",
                                                "text": "La plupart du temps, il est difficile de n’introduire qu'un atome de chlore, que l’intermédiaire de départ contienne ou non une chaîne latérale, surtout dans les chlorations par le chlore gazeux."
                                            },
                                            {
                                                "example_id": "bd67e17e-3afe-4f9f-9805-2b588e569f09",
                                                "sense_id": "10e1b45d-e739-3605-ae03-aedd295cda86",
                                                "text": "Doret, refusé aux examens de passage au seuil abrupt de la rhéto pour n’avoir pas su définir l’odeur du chlore, tomba devant Verdun, asphyxié ; nous apprîmes ainsi que l’existence avait des méthodes plus brutales que le professeur de 2ᵉ D."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94d5e711-82d2-3557-a0a4-4ebe45098d1a",
                                        "entry_id": "b2596d75-d35e-33f5-b312-36a3e995c5af",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de chlore."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9ece51-dda5-4887-b1fb-91cbe3d8ab46",
                                                "sense_id": "94d5e711-82d2-3557-a0a4-4ebe45098d1a",
                                                "text": "Les atomes de cuivre y sont liés par deux chlores agissant comme ponts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b732b4-8964-3293-8b7f-9d4c86291ac4",
                                        "entry_id": "b2596d75-d35e-33f5-b312-36a3e995c5af",
                                        "glosses": [
                                            "Désinfectant à base de produit chloré comme du dichloroisocyanurate de sodium (DCCNa), de l’hypochlorite de sodium ou de l’hypochlorite de calcium."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa2f2de-ddd1-4def-8b02-874c4371491a",
                                                "sense_id": "d5b732b4-8964-3293-8b7f-9d4c86291ac4",
                                                "text": "Chlore de piscine."
                                            },
                                            {
                                                "example_id": "7556ca52-a75d-4427-9f96-108eb080447a",
                                                "sense_id": "d5b732b4-8964-3293-8b7f-9d4c86291ac4",
                                                "text": "Malgré son goût de chlore, l’eau du robinet reste sûre."
                                            }
                                        ]
                                    }
                                ]
                            },
