                ],
                "senses": [
                    {
                        "sense_id": "978fe797-88fc-3967-b463-5edac5c8f5eb",
                        "entry_id": "f74d768a-ec35-3fd7-9b81-c947ddeafa00",
                        "glosses": [
                            "Petit iceberg."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "2fac47e6-1832-4d30-8760-d481cfdfeb05",
                                "sense_id": "978fe797-88fc-3967-b463-5edac5c8f5eb",
                                "text": "Les treize concurrents du Vendée Globe ont été mis en garde contre la présence, dans les parages du Horn, d’icebergs et de growlers, ces blocs de glace pouvant peser plusieurs tonnes et flottant entre deux eaux."
                            },
                            {
                                "example_id": "9b4d6619-21fd-476c-af3c-6907b1f03aeb",
                                "sense_id": "978fe797-88fc-3967-b463-5edac5c8f5eb",
                                "text": "Cette gravure représente une mer arctique, parsemée de grands icebergs et, au premier plan, des glaces éparses, des growlers, au large de petits hummocks qui continuent à se disloquer."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa2fea2f-a91b-31a5-9a8b-40f6a229515b",
                        "entry_id": "f74d768a-ec35-3fd7-9b81-c947ddeafa00",
                        "glosses": [
                            "Véhicule hippomobile."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d6770575-c736-41f1-979f-c101dc9f7de0",
                                "sense_id": "fa2fea2f-a91b-31a5-9a8b-40f6a229515b",
                                "text": "Aussi mit-il au trot le cheval de son « growler», appellation qui s’applique à ces antiques et inconfortables véhicules."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e8b80e0-0dc9-3aef-87c2-2d6275e4e81a",
                        "entry_id": "f74d768a-ec35-3fd7-9b81-c947ddeafa00",
                        "glosses": [
                            "Bouteille, le plus souvent en verre, destinée à contenir de la bière et à être rechargée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3e6ffc9-8a47-49ba-99b0-ef030fa6b479",
                        "source_entry_id": "f74d768a-ec35-3fd7-9b81-c947ddeafa00",
                        "target_lang_word": "growler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "growler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44c27848-fa40-3a08-b8e7-e7586e4cbeea",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A person, creature or thing that growls."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5f1f518-882e-33b7-986b-f1b1189b25e5",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A horse-drawn cab with four wheels."
                                        ],
                                        "tags": [
                                            "historical",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e144403-ddd3-4426-850e-d6b1d46c6ede",
                                                "sense_id": "a5f1f518-882e-33b7-986b-f1b1189b25e5",
                                                "text": "He had evidently studied the driver of a London growler, and produced a good sound readable type of man."
                                            },
                                            {
                                                "example_id": "9c1c3237-d430-4c4b-9980-f7504b432f51",
                                                "sense_id": "a5f1f518-882e-33b7-986b-f1b1189b25e5",
                                                "text": "The ordinary London growler is considerably less wide than a gentleman's brougham."
                                            },
                                            {
                                                "example_id": "86618ac0-3a11-47f9-aae0-01aac8c6216e",
                                                "sense_id": "a5f1f518-882e-33b7-986b-f1b1189b25e5",
                                                "text": "Lew pulled his socks from a jacket pocket, grabbed his own shoes, and together they proceeded to the street and into a growler, and were off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed386b80-8195-3fd5-9bd6-bf40175e74b4",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A small iceberg or ice floe which is barely visible over the surface of the water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952f12cd-ce5d-413d-b30d-cca93bb52636",
                                                "sense_id": "ed386b80-8195-3fd5-9bd6-bf40175e74b4",
                                                "text": "A great ‘growler’ iceberg was sighted this afternoon at a distance of approximately half a mile; the size of a large London house, more or less."
                                            },
                                            {
                                                "example_id": "6c88b65f-e753-49cd-ab51-34d5b87be47f",
                                                "sense_id": "ed386b80-8195-3fd5-9bd6-bf40175e74b4",
                                                "text": "As the cruise ship Explorer was picking its way through the Antarctic sea ice, it hit what experts believe was a \"growler\" - a huge iceberg shorn from the Antarctic ice shelf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27f3ddd-164f-3fe3-9ca0-f087466551c0",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A kind of jug, often with a handle, used to carry beer and preserve carbonation."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba091c18-1abf-4714-ad91-47ecb204f898",
                                                "sense_id": "c27f3ddd-164f-3fe3-9ca0-f087466551c0",
                                                "text": "[…] their favoring breeze has the stink of nickel whiskey on its breath, and their sea is a growler of lager and ale […]"
                                            },
                                            {
                                                "example_id": "530852b4-a436-457f-93ac-16a77a34f755",
                                                "sense_id": "c27f3ddd-164f-3fe3-9ca0-f087466551c0",
                                                "text": "This container was a round lidded tin with a handle and was colloquially called a growler. […] to get daddy or mommy a growler of beer, which was, by the way, approximately a quart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56a9f98-e353-36b6-b3e0-374f9f30185e",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A pork pie."
                                        ],
                                        "tags": [
                                            "UK",
                                            "Yorkshire",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ac4023-3993-43f3-ac36-36a8f99eb9d2",
                                                "sense_id": "d56a9f98-e353-36b6-b3e0-374f9f30185e",
                                                "text": "Now, on first impression, a pork pie - or a ‘growler’ if you're from Yorkshire - looks like a delicious snack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c81b2aaf-848b-314d-93ac-9b61e64e8857",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "The vulva."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1f95470-79ec-4a7c-8ae0-c93b65e31cd1",
                                                "sense_id": "c81b2aaf-848b-314d-93ac-9b61e64e8857",
                                                "text": "On our first meeting he'd asked me if I dyed my hair. I told him I did and his follow up^([sic]) question had been the much under rated^([sic]), \"What colour's your growler then?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ab8aa2b-1f43-39ae-b6fd-0fef4509fb48",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A fish of the perch family, abundant in North American rivers, so named from the sound it emits."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba7258b2-5e52-3a5f-8b09-f0cb03280a85",
                                        "entry_id": "a53ac6b4-781d-356f-8c97-2d8e7a299a5e",
                                        "glosses": [
                                            "A device for checking electrical equipment for short circuits etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed63d79-79e4-4aac-8106-f0dbbfa1a2a5",
                                                "sense_id": "ba7258b2-5e52-3a5f-8b09-f0cb03280a85",
                                                "text": "Includes voltmeters, ammeters, circuit testers, armature tester (external growler), field tester, (internal growler), coil and condenser tester, etc."
                                            },
                                            {
                                                "example_id": "15d2b44b-0e79-419c-88d9-0e0097e9dc87",
                                                "sense_id": "ba7258b2-5e52-3a5f-8b09-f0cb03280a85",
                                                "text": "A Growler is one of the most versatile tools for electric motor service, whether a starter motor or a generator. The growler gets its name because of a growling noise it emits upon finding an electrical short."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
