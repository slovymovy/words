                                        "entry_id": "976ac0c1-26b0-3890-bd02-65b2dc5d1ea9",
                                        "glosses": [
                                            "rauschhaft ausgelassen, trunken, zügellos"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2fb99a6-da63-41e2-9ce2-72cb10c0923f",
                                                "sense_id": "ba427134-0509-3e02-b707-44e2968718df",
                                                "text": "Gerade war er noch der tadellose Gentleman gewesen, bis eine dumme Bemerkung ihn in bacchantische Raserei verfallen ließ."
                                            },
                                            {
                                                "example_id": "6eaf7255-8ab0-47cc-8093-2250ade92a9b",
                                                "sense_id": "ba427134-0509-3e02-b707-44e2968718df",
                                                "text": "Die Studenten feierten am Ende des Prüfungszeitraums, vom Druck befreit, ein bacchantisches Fest."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
