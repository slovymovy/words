    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca12ccee-bba9-38e8-a0d3-89a9d22d372b",
                    "sense_definition": "Avoir la connaissance d'une chose, détenir une information tenue pour certaine.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne <w>sais</w> pas à quelle heure commence la réunion de ce matin."
                        },
                        {
                            "text": "Est-ce que tu <w>sais</w> où Pierre a garé sa nouvelle voiture ?"
                        }
                    ],
                    "synonyms": [
                        "connaître"
                    ],
                    "common_phrases": [
                        "ne rien savoir",
                        "en savoir plus"
                    ]
                },
                {
                    "sense_id": "6b618799-f710-379c-a141-42bb000837e1",
                    "sense_definition": "Avoir la compétence, l'aptitude ou la technique nécessaire pour accomplir une action.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "capacite_possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon petit frère ne <w>sait</w> pas encore nager sans ses brassards."
                        },
                        {
                            "text": "Elle <w>sait</w> parler couramment trois langues étrangères depuis son enfance."
                        }
                    ],
                    "common_phrases": [
                        "savoir nager",
                        "savoir lire"
                    ]
                },
                {
                    "sense_id": "155a2bad-7b6f-363c-a781-7d309c25bb55",
                    "sense_definition": "Avoir présent dans sa mémoire, être capable de restituer fidèlement.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écolier <w>sait</w> son poème par cœur et le récite fièrement."
                        },
                        {
                            "text": "Pour réussir cet examen difficile, vous devez <w>savoir</w> toutes ces règles."
                        }
                    ],
                    "common_phrases": [
                        "savoir par cœur",
                        "savoir sa leçon"
                    ]
                },
                {
                    "sense_id": "c07a1d94-c4d5-3399-bbc5-5f36d58a1585",
                    "sense_definition": "Découvrir ou être informé d'une nouvelle ou d'un fait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous aimerions <w>savoir</w> ce qui s'est réellement passé hier soir."
                        },
                        {
                            "text": "Dès que j'ai <w>su</w> la nouvelle, j'ai tout de suite téléphoné."
                        }
                    ],
                    "common_phrases": [
                        "vouloir savoir",
                        "faire savoir"
                    ]
                },
                {
                    "sense_id": "99f9e5a7-98f7-3b88-a592-bef891eda8ea",
                    "sense_definition": "Être capable de faire quelque chose, avoir la possibilité matérielle de le faire.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "capacite_possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sais</w>-tu me passer le sel qui se trouve sur la table ?"
                        },
                        {
                            "text": "Je ne <w>sais</w> pas venir à ta fête demain car je travaille tard."
                        }
                    ],
                    "synonyms": [
                        "pouvoir"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Régionalisme fréquent en Belgique"
                        }
                    ]
                },
                {
                    "sense_id": "f2d774ad-e164-3982-ab12-4220649cf7ea",
                    "sense_definition": "Pouvoir, être en mesure de (employé surtout au conditionnel négatif pour atténuer ou exprimer une impossibilité formelle).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "capacite_possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle décision ne <w>saurait</w> être prise sans consulter toute l'équipe."
                        },
                        {
                            "text": "Ce train a pris un peu de retard mais il ne <w>saurait</w> tarder."
                        }
                    ],
                    "synonyms": [
                        "pouvoir"
                    ],
                    "common_phrases": [
                        "ne saurait tarder",
                        "ne saurait être"
                    ]
                }
            ]
        },
