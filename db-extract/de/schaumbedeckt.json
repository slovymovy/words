                "senses": [
                    {
                        "sense_id": "4c425517-1712-36b9-822d-ea2ebafb095b",
                        "entry_id": "91c064cb-e144-3469-b5ff-3cec27c07cbb",
                        "glosses": [
                            "mit Schaum bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb361b0e-dafe-4e98-a8f8-cd7fa336dae5",
                                "sense_id": "4c425517-1712-36b9-822d-ea2ebafb095b",
                                "text": "„Dort hatte er stets mit geilen Blicken und hämischem Kichern zugesehen, wie sie nach und nach mit weit aufgerissenen, rot geränderten Augen und anschwellender Zunge im schaumbedeckten Maul ins tödliche Koma fielen.“"
                            },
                            {
                                "example_id": "c659d2af-de7c-40e4-b305-c5be2c990478",
                                "sense_id": "4c425517-1712-36b9-822d-ea2ebafb095b",
                                "text": "„Sein Gesicht war purpurn, seine Lippen schaumbedeckt.“"
