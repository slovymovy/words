                                    },
                                    {
                                        "sense_id": "035e3791-ab52-37b4-83d5-0e82f158b90b",
                                        "entry_id": "37024b3b-ad5e-3fc0-bb7e-cef9c75e73b8",
                                        "glosses": [
                                            "To be or act different from the usual."
