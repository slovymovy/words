                        "entry_id": "b1081846-7a66-38e6-83dc-bf692827661c",
                        "glosses": [
                            "het verschijnsel dat de maan of een ander hemellichaam voor de zon langstrekt, waardoor het zonlicht geblokkeerd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e6065e-5695-42d3-9009-fb04d2981e84",
                                "sense_id": "27b34b75-8ac5-3241-8e9d-f5d520c1e89c",
