                "senses": [
                    {
                        "sense_id": "3e1127c2-7c14-3219-b1fa-0f04374989e2",
                        "entry_id": "b174ba24-347f-3e72-940e-a2e50ec2c5a0",
                        "glosses": [
                            "Qui peut être recyclé."
                        ],
                        "tags": [
                            "Déchets"
                        ],
                        "examples": [
                            {
                                "example_id": "7329233e-8128-496e-b0c2-537aff5161f0",
                                "sense_id": "3e1127c2-7c14-3219-b1fa-0f04374989e2",
                                "text": "Comme ici on ne savait pas manger dans le plat, fût-il de faïence ou de tout autre matériau à l'instar de papier recyclable, plastique ou en métal, la gentille dame avait pris la peine de ramollir à la flamme les jeunes feuilles de bananier qu’on remettait à chacun comme assiette de service."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe66545c-07a4-4966-981a-1e42d77186c4",
                        "source_entry_id": "b174ba24-347f-3e72-940e-a2e50ec2c5a0",
                        "source_sense_id": "3e1127c2-7c14-3219-b1fa-0f04374989e2",
                        "target_lang_word": "recyclable",
