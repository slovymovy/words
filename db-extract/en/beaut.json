                ],
                "senses": [
                    {
                        "sense_id": "a98b709c-8cfb-33d9-9bee-c37099c0897d",
                        "entry_id": "526172ed-e004-3e76-9529-bd9bc8b659c8",
                        "glosses": [
                            "Something or someone that is physically attractive."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "6c000abe-f2a5-4f65-b856-7add608c8d47",
                                "sense_id": "a98b709c-8cfb-33d9-9bee-c37099c0897d",
                                "text": "That new car of yours is a real beaut."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4021e89-b1c7-319a-a112-7756457767e0",
                        "entry_id": "526172ed-e004-3e76-9529-bd9bc8b659c8",
                        "glosses": [
                            "Something that is a remarkable example of its type."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "a937442a-8340-4256-bf41-49cbbe103883",
                                "sense_id": "a4021e89-b1c7-319a-a112-7756457767e0",
                                "text": "Bruno lifted his left hand out of the bucket in order to point out to Catfoot a lump, the size of a darning egg, over his left eye. […] \"Ain't it a beaut, Cat? It's where he butted me.\""
                            },
                            {
                                "example_id": "1785830d-ba6b-443c-8617-21cd49817f9c",
                                "sense_id": "a4021e89-b1c7-319a-a112-7756457767e0",
                                "text": "In his most famous quip, La Guardia once remarked, “When I make a mistake it's a beaut!”"
                            },
                            {
                                "example_id": "075c7044-89a8-488a-b207-de59dfa40444",
                                "sense_id": "a4021e89-b1c7-319a-a112-7756457767e0",
                                "text": "Both of them were used to long surveillance stints. This looked like it might be a beaut."
                            }
                        ]
                    }
                ],
