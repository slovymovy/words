                        "translation_id": "49c048e8-1141-47fe-8cb8-0c192556b882",
                        "source_entry_id": "78f16ca3-7437-3b74-a3d3-c799d8f59d71",
                        "source_sense_id": "f0c59392-fbb1-3bfa-b4c9-63c86cb9a931",
                        "target_lang_word": "shopping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
