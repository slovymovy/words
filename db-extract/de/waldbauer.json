                "senses": [
                    {
                        "sense_id": "fec1207b-d5ec-3c04-9b7d-19f541e38631",
                        "entry_id": "f2876b85-700f-366f-be6c-a02097ab9444",
                        "glosses": [
                            "jemand, der in seinem Besitz befindlichen Wald bewirtschaftet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc124399-0d82-47fa-b155-ee74cc0d5385",
                                "sense_id": "fec1207b-d5ec-3c04-9b7d-19f541e38631",
                                "text": "„Ich bewundere die Haltung von Waldbauern, wenn sie Bäume pflanzen, die erst von späteren Generationen geerntet werden.“"
                            },
                            {
                                "example_id": "637a2556-fdc9-4a4f-8b22-ca72ababba68",
                                "sense_id": "fec1207b-d5ec-3c04-9b7d-19f541e38631",
                                "text": "„Das ist Ásmundur, sagt Sóley amüsiert, der Waldbauer hier im Fjord.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
