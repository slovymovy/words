                                        "glosses": [
                                            "In a mild manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5934aa19-9464-4412-8473-45053e3bb889",
                                                "sense_id": "9ac7b343-5f73-3415-b6c9-8c782ce9c4a0",
                                                "text": "Long before you see the lean, handsome heads peering mildly over the half-doors of the loose boxes, you know that East Ilsley's business is training racehorses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                                        "entry_id": "2c414ab1-ea82-3185-9af6-8f7c0d488e23",
                                        "glosses": [
                                            "To a mild degree; slightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92a70f8-749b-4ed0-b882-325971280456",
                                                "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                                                "text": "a mildly amusing joke"
                                            },
                                            {
                                                "example_id": "f69b9366-1b5e-4e99-8dc8-ed5daa423b8c",
                                                "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                                                "text": "The aroma is mildly sweet and lagery with pleasant hops; very pale gold color; the taste is clean and fresh, mildly malty, with a touch of hops in both the middle and finish; a remarkably thin body and lots of carbonation."
                                            }
                                        ]
                                    }
                                ]
