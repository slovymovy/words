                    "sense_id": "7f99100b-140b-3b1f-863b-5b39a6e4e919",
                    "sense_definition": "Contraction of <w>does</w> not.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>doesn't</w> like to wake up early in the morning.",
                            "target_lang_translations": {
                                "ru": "Он <w>не</w> любит рано просыпаться по утрам.",
                                "cs": "On <w>nerad</w> vstává brzy ráno.",
                                "de": "Er mag es <w>nicht</w>, morgens früh aufzustehen.",
                                "nl": "Hij houdt er <w>niet</w> van om 's ochtends vroeg wakker te worden."
                            }
                        },
                        {
                            "text": "It <w>doesn't</w> matter which color you choose for the walls.",
                            "target_lang_translations": {
                                "ru": "<w>Не</w> имеет значения, какой цвет вы выберете для стен.",
                                "cs": "Je <w>jedno</w>, jakou barvu na stěny vybereš.",
                                "de": "Es spielt keine Rolle (<w>nicht</w>), welche Farbe du für die Wände wählst.",
                                "nl": "Het maakt <w>niet</w> uit welke kleur je kiest voor de muren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "it doesn't matter",
                        "doesn't make sense",
                        "doesn't work",
                        "doesn't look like"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "contraction"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма от \"does not\", используемая для отрицания в настоящем времени с третьим лицом единственного числа.",
                        "cs": "Stažená forma záporu 'does not', používaná ve 3. osobě jednotného čísla v přítomném čase prostém.",
                        "de": "Zusammenziehung von „does not“, verwendet zur Verneinung im Präsens für die dritte Person Singular.",
                        "nl": "Samentrekking van 'does not', gebruikt voor ontkenningen in de tegenwoordige tijd bij de derde persoon enkelvoud."
                    },
