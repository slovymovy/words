                            {
                                "example_id": "f8b1a27e-d7cd-4a22-9cd8-1a8b948bab4f",
                                "sense_id": "e3eaa3f6-4060-3e05-af5d-ceff90901540",
                                "text": "„Die Arbeitsdisziplin ist extrem lax.“"
                            },
                            {
                                "example_id": "90e1bbce-486d-47af-9d5d-2b702fefe764",
                                "sense_id": "e3eaa3f6-4060-3e05-af5d-ceff90901540",
                                "text": "„Es war seine dritte Amtszeit als Bürgermeister, und abgesehen von seiner Intelligenz hatte der Mann eine ganz außergewöhnliche Arbeitsdisziplin.“"
                            },
                            {
                                "example_id": "dc5df134-4b7a-4eb8-a53e-0a87cb1239ef",
                                "sense_id": "e3eaa3f6-4060-3e05-af5d-ceff90901540",
                                "text": "„Hinter diesen Sätzen steht der ihn ständig plagende Selbstvorwurf mangelnder Arbeitsdisziplin.“"
                            }
                        ],
