                "senses": [
                    {
                        "sense_id": "5fed9193-738d-39a2-abd9-df3ee0bac302",
                        "entry_id": "a1e70baa-b9aa-3a09-860b-507949482c46",
                        "glosses": [
                            "Débarrasser de l’arianisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af453b4-e6d7-41c8-9f70-e3c16304df76",
                                "sense_id": "5fed9193-738d-39a2-abd9-df3ee0bac302",
                                "text": "C’est donc seulement au bout d’un demi-millénaire que l’Occident déjà barbarisé mais désarianisé commence à faire mémoire de l’ancien préfet romain de Judée."
                            },
                            {
                                "example_id": "443e916c-eea4-4745-bd43-b9ef3aeb3ec9",
                                "sense_id": "5fed9193-738d-39a2-abd9-df3ee0bac302",
                                "text": "Desiderius immerge du désert VOGESUS ce défilé de l’ombre BERG AUF DER FÜRST dont il s’extirpe de la Dreisam désarianisée le héraut fort du prestige de sa crosse victorieuse fait station réclame de quoi s’abreuver s’adresse d’un promontoire oratorio sec aux quarquevelles qui boivent ses paroles le désert est sans paroles et l’on n’y joue pas aux mots croisés"
                            }
                        ]
                    }
