                                "example_id": "ef5dc1b2-4e34-4164-8533-fa91ec0453b3",
                                "sense_id": "8321fbb8-466f-3e39-85c1-f4aa31d8b8cc",
                                "text": "Uskarżał się na mgłę wokół Orly, która zmusiła go do podróżowania w towarzystwie różnego tałatajstwa i zuchwałej swołoczy."
                            }
