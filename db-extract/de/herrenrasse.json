                                "target_senses": [
                                    {
                                        "sense_id": "524772e6-ce3d-3918-a8e9-deaf8be7b673",
                                        "entry_id": "100b78e3-c412-3c66-bd3c-f6d7d5282071",
                                        "glosses": [
                                            "A race of people who are superior to others."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3292a84d-18f0-48e9-b24c-145ce116d87c",
                                                "sense_id": "524772e6-ce3d-3918-a8e9-deaf8be7b673",
                                                "text": "When the Führer says we is the master race\nWe \"Heil!\" (Bronx cheer), \"Heil!\" (Bronx cheer) right in the Führer's face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
