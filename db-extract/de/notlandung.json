                        "entry_id": "45ca3523-7095-3ccd-81b5-0e17a8322994",
                        "glosses": [
                            "unvorhergesehene vorzeitige Landung eines Luft- oder Raumfahrzeugs (an einem nicht dafür bestimmten Ort) aufgrund einer akuten Notlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2bfa3ca-30fd-4e0a-a278-46dbc51eb089",
                                "sense_id": "b0d747e0-aec7-3146-9c0b-131da0fc157a",
                                "text": "„Nach der spektakulären Notlandung konnten alle 155 Menschen an Bord gerettet werden.“"
                            },
                            {
                                "example_id": "341c8ac0-627f-4e04-88ba-7ad57efa6fdd",
                                "sense_id": "b0d747e0-aec7-3146-9c0b-131da0fc157a",
                                "text": "„Er hatte gerade noch genug Treibstoff für einen einzigen weiteren Zielanflug und eine Notlandung auf Okinawa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
