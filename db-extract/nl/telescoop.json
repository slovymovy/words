            {
                "entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                "word": "telescoop",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a40acfdb-cc41-4d1a-ac5e-f6e09fc43d33",
                        "entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "tags": [
                            "plural"
                        ],
                        "form": "telescopen"
                    },
                    {
                        "form_id": "2f4e59dc-11a9-4492-ae3c-d03af616d4e1",
                        "entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "telescoopje"
                    },
                    {
                        "form_id": "cc785507-1a7b-4cd4-950c-a2c8e9b459b7",
                        "entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "telescoopjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                        "entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "glosses": [
                            "een optisch instrument, waarmee ver verwijderde objecten bekeken kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125e90f0-4ade-4710-b291-ea05c9d77fa2",
                                "sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                                "text": "In 1655 ontdekte Christiaan Huygens met een telescoop de grootste maan van Saturnus."
                            },
                            {
                                "example_id": "69705abb-b67f-4c50-8f79-3e0d6cd980b1",
                                "sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                                "text": "Om ervoor te zorgen dat de waarnemingen niet overstraald zouden worden door de warmtestraling van de satelliet zelf, was de telescoop in een overmaatse thermosfles geplaatst, en werd hij met behulp van zeventig kilo supervloeibaar helium gekoeld tot een temperatuur van 2 graden boven het absolute nulpunt (minus 271 graden Celsius)."
                            },
                            {
                                "example_id": "bf5dcfd6-1a81-4e74-bd97-403dbfde1fc2",
                                "sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                                "text": "Samen met acht (voornamelijk Britse) collega's gebruikte hij daarvoor de grootste telescoop van Europa: de William Herschel Telescope, die een spiegelmiddellijn van 4,2 meter heeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2521222-7506-4a7e-a623-547c2fef0c9d",
                        "source_entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "source_sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                        "source_sense_description": "een optisch instrument, waarmee ver verwijderde objecten bekeken kunnen worden",
                        "target_lang_word": "Teleskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teleskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bfdae61-702f-32c1-9898-f1c56a576955",
                                        "entry_id": "cf76fb4d-feb7-32c1-ab24-53d1db2dfff7",
                                        "glosses": [
                                            "optisches Instrument zur Beobachtung weit entfernter Himmelsobjekte"
                                        ],
                                        "tags": [
                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0846ca-9691-49ff-b8e9-e4c704ef93ef",
                                                "sense_id": "8bfdae61-702f-32c1-9898-f1c56a576955",
                                                "text": "Auf der Rückseite des Mondes wollen Forscher ein Teleskop installieren."
                                            },
                                            {
                                                "example_id": "d5d1db26-c5e8-4192-9b57-790aa19940ae",
                                                "sense_id": "8bfdae61-702f-32c1-9898-f1c56a576955",
                                                "text": "„In Ischim war Humboldt zum Mißfallen der Polizei mit polnischen Strafgefangenen ins Gespräch gekommen, dann hatte er sich davongeschlichen, einen Hügel bestiegen und sein Teleskop aufgebaut.“"
                                            },
                                            {
                                                "example_id": "62b89a7f-dea5-491a-a021-280bc440ec26",
                                                "sense_id": "8bfdae61-702f-32c1-9898-f1c56a576955",
                                                "text": "„So bat sie den Techniker, das Teleskop auf unseren Erdtrabanten auszurichten.“"
                                            },
                                            {
                                                "example_id": "b66f7712-c288-4cc0-bbc5-471ec5873de7",
                                                "sense_id": "8bfdae61-702f-32c1-9898-f1c56a576955",
                                                "text": "„Ausschließlich mit dem Teleskop beschäftigt, betrugen sie sich wie gute Freunde und stellten die ungeduldigen Herausforderungen und Anspielungen der Eroberung zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d047b7c5-f9b4-378a-9bda-bb41d97c16bd",
                                        "entry_id": "cf76fb4d-feb7-32c1-ab24-53d1db2dfff7",
                                        "glosses": [
                                            "optisches Instrument zur Beobachtung ferner Objekte"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f651a53-6d7f-43a0-8c34-51c6ea175df9",
                                                "sense_id": "d047b7c5-f9b4-378a-9bda-bb41d97c16bd",
                                                "text": "„Der durchs Teleskop gerichtete Blick kennt eine ähnliche Diskrepanz von Dabeisein und Entfernung wie die Höhensicht vom Berggipfel.“"
                                            },
                                            {
                                                "example_id": "84d438f1-627a-4121-82f2-24295ff96d03",
                                                "sense_id": "d047b7c5-f9b4-378a-9bda-bb41d97c16bd",
                                                "text": "„Bevor Vanderbrecken uns gehen ließ, suchte er sehr sorgfältig durch sein Teleskop jeden Meter Strand ab.“"
                                            },
                                            {
                                                "example_id": "7244cc53-c3b3-44fd-990c-9bdb58c1e0d3",
                                                "sense_id": "d047b7c5-f9b4-378a-9bda-bb41d97c16bd",
                                                "text": "„Seine Neigung, in diesem Gesprächstone fortzufahren, war unverkennbar; er brach aber ab, weil die, denen diese Bemerkungen galten, mittlerweile ganz in ihrer Nähe Platz genommen hatten, und zwar an einem unmittelbar am Abhange stehenden Tische, neben dem auch ein Teleskop für das schaulustige Publikum aufgestellt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "916d3843-d211-4118-a270-bb079267fce7",
                        "source_entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "source_sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                        "source_sense_description": "een optisch instrument, waarmee ver verwijderde objecten bekeken kunnen worden",
                        "target_lang_word": "telescope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telescope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74ddc09b-6f11-397f-95dc-06f6a148e3f2",
                                        "entry_id": "2b7600a7-6d5d-3688-8803-73258f2cd94f",
                                        "glosses": [
                                            "A monocular optical instrument that magnifies distant objects, especially in astronomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed76294a-80b6-4676-8ab9-0a90fc7dd38d",
                                                "sense_id": "74ddc09b-6f11-397f-95dc-06f6a148e3f2",
                                                "text": "It needs a scientific telescope, it needs to be reinterpreted and artificially brought near us, before we can so much as know that it was a Sun."
                                            },
                                            {
                                                "example_id": "468920d2-b157-41e5-818d-d14d3828eef8",
                                                "sense_id": "74ddc09b-6f11-397f-95dc-06f6a148e3f2",
                                                "text": "It is scarcely possible to avoid comparing the eye to a telescope."
                                            },
                                            {
                                                "example_id": "d06b60c4-c943-4f06-a4f4-08103dba7b6b",
                                                "sense_id": "74ddc09b-6f11-397f-95dc-06f6a148e3f2",
                                                "text": "About ten months ago a report reached my ears that a Dutchman had constructed a telescope, by the aid of which visible objects, although at a great distance from the eye of the observer, were seen distinctly as if near; […]"
                                            },
                                            {
                                                "example_id": "83767f30-10e3-4011-80bd-305ea7fdd196",
                                                "sense_id": "74ddc09b-6f11-397f-95dc-06f6a148e3f2",
                                                "text": "This was one of the great missed opportunities of theoretical physics. If Einstein had stuck with his original equations, he could have predicted that the universe must be either expanding or contracting. As it was, the possibility of a time-dependent universe wasn't taken seriously until observations in the 1920s by the 100-inch telescope on Mount Wilson."
                                            },
                                            {
                                                "example_id": "30015727-ac16-4c75-9aff-130e88d7e3ad",
                                                "sense_id": "74ddc09b-6f11-397f-95dc-06f6a148e3f2",
                                                "text": "The 1.2-meter-diameter (4-foot-diameter) telescope has set off on a monthlong journey to its orbital destination of the sun-Earth Lagrange point L2, which is nearly 1 million miles (1.6 million kilometers) away from Earth and also home to NASA’s James Webb Space Telescope. Euclid will keep pace with Earth as our planet orbits the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "840c9d4d-24c7-3214-8635-6deaf260097a",
                                        "entry_id": "2b7600a7-6d5d-3688-8803-73258f2cd94f",
                                        "glosses": [
                                            "Any instrument used in astronomy for observing distant objects (such as a radio telescope)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cd3f889-7118-3e56-be79-587058c973a9",
                                        "entry_id": "2b7600a7-6d5d-3688-8803-73258f2cd94f",
                                        "glosses": [
                                            "A retractable tubular support for lights."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3f0454-ead9-4850-8ecc-823f20614c4e",
                                                "sense_id": "5cd3f889-7118-3e56-be79-587058c973a9",
                                                "text": "In some studios the telescopes are fixed to the lighting grid […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92fe47bc-87f5-3b16-82c2-9641e3167bc6",
                                        "entry_id": "2b7600a7-6d5d-3688-8803-73258f2cd94f",
                                        "glosses": [
                                            "A kind of goldfish with protruding eyes, first bred in China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48916245-0077-4cab-a0a5-4f38ccee748a",
                                                "sense_id": "92fe47bc-87f5-3b16-82c2-9641e3167bc6",
                                                "text": "Chinese Telescopes are sold by some dealers for young Japanese Fringetails. For this reason it is well to select a reliable dealer when purchasing choice stock."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "telescope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "268a9589-a8b4-3810-aa03-895db6bab9d5",
                                        "entry_id": "f384aded-b701-382e-979d-a94df7118962",
                                        "glosses": [
                                            "To extend or contract in the manner of a telescope."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dead8bb-d9d3-415a-9383-9433d6254db8",
                                                "sense_id": "268a9589-a8b4-3810-aa03-895db6bab9d5",
                                                "text": "Hugo rose to his full height, which was triple that of Grunt Buggely’s, even without his neck telescoped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08333edf-b972-3dd6-b1f9-c3b1cd4bf254",
                                        "entry_id": "f384aded-b701-382e-979d-a94df7118962",
                                        "glosses": [
                                            "To slide or pass one within another, after the manner of the sections of a small telescope or spyglass."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "596fbeb5-9fa8-3894-8117-ef674b471ab5",
                                        "entry_id": "f384aded-b701-382e-979d-a94df7118962",
                                        "glosses": [
                                            "To come into collision, as railway cars, in such a manner that one runs into another."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c11aaa7-fb2f-3cf6-bd73-2288d3872d26",
                                        "entry_id": "f384aded-b701-382e-979d-a94df7118962",
                                        "glosses": [
                                            "To collapse, via cancellation."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a797e684-0a5d-408f-a985-04b1de0c031f",
                        "source_entry_id": "d18fd2a6-9cb2-3dcd-afdb-7bb4f912097f",
                        "source_sense_id": "746280cf-d4ae-370b-a863-bff93f069a19",
                        "source_sense_description": "een optisch instrument, waarmee ver verwijderde objecten bekeken kunnen worden",
                        "target_lang_word": "télescope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "télescope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a144a587-62bb-3517-97ce-f2b00e5ce0f7",
                                        "entry_id": "e29f81a9-ec2a-3a00-a8ec-b65fa4da96bd",
                                        "glosses": [
                                            "Instrument optique à miroir concave servant à observer les astres."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af742ca7-63d2-43fb-90f8-efd1e4d736aa",
                                                "sense_id": "a144a587-62bb-3517-97ce-f2b00e5ce0f7",
                                                "text": "Si, avec un télescope d’une profonde puissance, nous examinons soigneusement le firmament, nous découvrirons une ceinture de groupes faite de ce que nous avons jusqu’à présent nommé des nébuleuses […]"
                                            },
                                            {
                                                "example_id": "49af9a21-e1fa-4f38-bc0f-88e18951b281",
                                                "sense_id": "a144a587-62bb-3517-97ce-f2b00e5ce0f7",
                                                "text": "Le tube du télescope est ouvert à son extrémité supérieure. Les rayons partis de l’objet observé y pénètrent librement et vont frapper un miroir métallique concave, c’est-à-dire convergent. De là, les rayons réfléchis rencontrent un petit miroir qui les renvoie à l’oculaire, disposé de façon à grossir l’image produite."
                                            },
                                            {
                                                "example_id": "2d4b2eaa-2318-4efb-8518-c00152e55e60",
                                                "sense_id": "a144a587-62bb-3517-97ce-f2b00e5ce0f7",
                                                "text": "Les Martiens éprouvaient une joie immense à contempler le paysage de la Terre, qu'ils la parcourussent à l’aide du télescope ou qu'il se déroulât sur leur cinématographe perfectionné ; […]."
                                            },
                                            {
                                                "example_id": "84d06cb5-27c7-4887-9e27-c09f0cf52d5b",
                                                "sense_id": "a144a587-62bb-3517-97ce-f2b00e5ce0f7",
                                                "text": "Finalement, en 1610, des observations faites par Galileo Galilei, à l’aide du tout premier télescope, ont fourni les preuves confirmant la vision de Copernic."
                                            },
                                            {
                                                "example_id": "49960caf-9417-4317-92e9-a3a8e60b026c",
                                                "sense_id": "a144a587-62bb-3517-97ce-f2b00e5ce0f7",
                                                "text": "Au printemps de 1611, Galilée se rendit à Rome où il fut ovationné. Prélats, ecclésiastiques de tout genre et de tout rang, mais aussi grands seigneurs et grandes dames s'empressèrent de regarder à travers la lunette à laquelle un professeur romain donna le nom qui lui est resté : télescope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619c5630-80ac-385e-bf20-a6a9bfb95b3c",
                                        "entry_id": "e29f81a9-ec2a-3a00-a8ec-b65fa4da96bd",
                                        "glosses": [
                                            "Instrument d’optique, soit à réflexion, soit à réfraction, qui servait à observer les objets éloignés."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52b60866-7f3f-38c1-beb3-b7393893cb79",
                                        "entry_id": "e29f81a9-ec2a-3a00-a8ec-b65fa4da96bd",
                                        "glosses": [
                                            "Instrument de détection de particules composé de plusieurs détecteurs."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256ba2af-efd3-49fc-bfa0-55d027abf07b",
                                                "sense_id": "52b60866-7f3f-38c1-beb3-b7393893cb79",
                                                "text": "La Terre constituant un blindage naturel contre toutes les particules sauf les neutrinos, un télescope à neutrino s’intéresse à la détection des muons montants produits par l’interaction des neutrinos de haute énergie dans la matière sous le détecteur."
                                            },
                                            {
                                                "example_id": "394723d3-b70f-4d50-9ce2-2bb1353f1ed9",
                                                "sense_id": "52b60866-7f3f-38c1-beb3-b7393893cb79",
                                                "text": "Afin de détecter les particules chargées issues de la réaction, quatre télescopes sont placés dans la chambre à vide, fixés par paires sur deux bras rotatifs pouvant couvrir des angles de 7° à 90°."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "télescope",
                                "target_lang_code": "fr",
                                "target_senses": [
