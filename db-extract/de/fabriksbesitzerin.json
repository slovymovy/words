                "senses": [
                    {
                        "sense_id": "8c973d0e-d20c-305c-b42b-7a4867799f45",
                        "entry_id": "f4afaa38-6b20-3c9d-a568-8d4b57281ce4",
                        "glosses": [
                            "weibliche Person, die eine Fabrik besitzt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "a98de5d3-8aec-4808-b9c1-7d6e320e0343",
                                "sense_id": "8c973d0e-d20c-305c-b42b-7a4867799f45",
                                "text": "Die Fabriksbesitzerin verhandelte mit den Gewerkschaftsvertretern über die Lohnforderungen."
                            },
                            {
                                "example_id": "fbf2ec15-f221-4539-9922-842606eb26d2",
                                "sense_id": "8c973d0e-d20c-305c-b42b-7a4867799f45",
                                "text": "„Radlmaier lässt seine unnahbaren, kostümierten Figuren - u.a. der russische Trotzki-Darsteller Ljowuschka und die Fabriksbesitzerin Octavia Flambow-Jansen - absurde Dialoge theatral aufsagen und im Jahr 1928 durch Ostsee-Strandlandschaften spazieren.“"
                            },
                            {
                                "example_id": "08373a56-4e3f-4dc7-9295-da0a33f4e5cc",
                                "sense_id": "8c973d0e-d20c-305c-b42b-7a4867799f45",
                                "text": "„Im Jahr 1928, an der Ostsee, gabelt die exzentrische Fabriksbesitzerin Octavia Flambow-Jansen einen Baron auf, der sich bald als falscher Fünfziger herausstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
