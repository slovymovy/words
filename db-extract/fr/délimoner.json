                ],
                "senses": [
                    {
                        "sense_id": "dd1aba04-947d-3f2b-bbec-296897ba681f",
                        "entry_id": "1c71519d-f9fc-3e50-b35f-0e0a35b39a6e",
                        "glosses": [
                            "Enlever le limon accumulé au fond d’un bassin, d’un port."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94332d83-066b-4dee-85eb-b7efac8f3942",
                                "sense_id": "dd1aba04-947d-3f2b-bbec-296897ba681f",
                                "text": "Il faudra veiller à ce que les opérations prévues pour délimoner le bassin de Cadarache n’aggravent pas les dépôts en Basse Durance."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dece487-90b2-3216-aacc-5888cd3c51d1",
                        "entry_id": "1c71519d-f9fc-3e50-b35f-0e0a35b39a6e",
                        "glosses": [
                            "Enlever les algues (le limon) dans les claires qui empêchent les huîtres de pousser."
                        ],
                        "tags": [
                            "Ostréiculture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6cd031ce-497e-34ae-ac17-5ad2d249bd15",
                        "entry_id": "1c71519d-f9fc-3e50-b35f-0e0a35b39a6e",
                        "glosses": [
                            "Débarrasser un poisson à peau visqueuse (lotte, lamproie, etc.) du limon et des mucosités qui le recouvrent à l’aide d’eau chaude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418c98e0-7838-4ce6-8918-0a2f2b57c0b4",
                                "sense_id": "6cd031ce-497e-34ae-ac17-5ad2d249bd15",
                                "text": "Pour délimoner la lamproie, on la met dans une caisse aux parois rugueuses et on l’asperge d’eau chaude; elle se contorsionne et se fait propre elle-même."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2758824-dd08-3063-a176-2b38d7ec1389",
                        "entry_id": "1c71519d-f9fc-3e50-b35f-0e0a35b39a6e",
                        "glosses": [
                            "Nettoyer une viande de son limon en la rinçant à l’eau chaude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59288575-adf1-4dfd-a887-c6d536e43772",
                                "sense_id": "e2758824-dd08-3063-a176-2b38d7ec1389",
                                "text": "Les chaudineuses sont destinées principalement à dégraisser la face externe et délimoner la face interne des chaudins et estomacs de porcs."
                            }
                        ]
                    }
                ],
