                "senses": [
                    {
                        "sense_id": "03b933c8-dff2-3ebe-a028-181adcfe71e9",
                        "entry_id": "fe162b84-25c4-3856-81b1-1413b4012aac",
                        "glosses": [
                            "een oud kunst-, sier- of gebruiksvoorwerp, voorwerp uit de oude tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1df21ca-509a-4152-a2a0-5bfb4047589a",
                                "sense_id": "03b933c8-dff2-3ebe-a028-181adcfe71e9",
                                "text": "Opvallend is het grote aantal deelnemers dat kunst uit vele windstreken en disciplines combineert. Het lijkt erop dat de aanpak van Axel Vervoort school heeft gemaakt. Die Vlaamse kunsthandelaar en woninginrichter van de superrijken laat al jaren zien dat modernistisch design uitstekend samengaat met Egyptische antiquiteiten, Japanse moderne kunst en wat niet al."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca8b33f4-cf3c-38ed-8ffb-bd72fee5b1a4",
                        "entry_id": "fe162b84-25c4-3856-81b1-1413b4012aac",
                        "glosses": [
                            "iets wat ouderwets is en niet meer in de mode"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5399c768-4b62-45c5-ad45-9fe55beb7fbb",
                                "sense_id": "ca8b33f4-cf3c-38ed-8ffb-bd72fee5b1a4",
                                "text": "De komende jaren zal nog enige plastische chirurgie worden nagespeeld ter attentie van zogenaamde normen en waarden: volksverlakkerij. Het morele kapitaal van de FIFA is al jaren veilig opgeborgen in het pakhuis van antiquiteiten."
                            }
                        ]
                    },
                    {
                        "sense_id": "92c54fe2-f41c-36f3-8ca0-7808e9a1f426",
                        "entry_id": "fe162b84-25c4-3856-81b1-1413b4012aac",
                        "glosses": [
                            "oudheid, het tijdperk van de geschiedenis van de prehistorie tot de middeleeuwen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
