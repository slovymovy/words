                                                "sense_id": "d71fa6fd-78a1-3d3c-aa43-f5598db1f894",
                                                "text": "In der Mitte des Raumes befinden sich ein Tisch und vier Stühle."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "600262af-906e-33f2-8c71-6aa0c73c651f",
