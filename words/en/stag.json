                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без спутницы",
                                "target_lang_sense_clarification": "на вечере или балу"
                            },
                            {
                                "target_lang_word": "без пары",
                                "target_lang_sense_clarification": "в одиночку, без дамы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d026c9d0-f0f0-33d0-a114-be4a939bf86c",
                    "sense_definition": "To buy newly issued shares and immediately sell them for a quick profit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many speculators applied for shares intending to <w>stag</w> the initial offering.",
                            "target_lang_translations": {
                                "ru": "Многие спекулянты подавали заявки на акции с намерением <w>сыграть на повышении цен</w> первичного размещения."
                            }
                        },
                        {
                            "text": "He managed to <w>stag</w> several corporate bonds before the prices dropped.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>быстро перепродать с выгодой</w> несколько корпоративных облигаций, пока цены не упали."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спекулировать акциями новой эмиссии, скупая и быстро перепродавая их ради прибыли."
                    },
                    "translations": {
                        "ru": [
