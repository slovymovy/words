                                        "entry_id": "5cde4647-facd-39bc-ba75-8a06ddc44d97",
                                        "glosses": [
                                            "dei Tolomei, antichi sovrani d’Egitto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a05a6c-f014-419a-85ac-3b527810ba65",
                                                "sense_id": "e631f447-9ea7-3bca-a492-b28a6b7a6243",
                                                "text": "Cleopatra fu l'ultima regina dell'Egitto tolemaico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b29c68-79bf-320d-8949-68c2918275a4",
                                        "entry_id": "5cde4647-facd-39bc-ba75-8a06ddc44d97",
                                        "glosses": [
                                            "dell'astronomo e matematico greco Claudio Tolomeo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737d8228-2fc4-46c2-956a-a16bcb49152b",
                                                "sense_id": "18b29c68-79bf-320d-8949-68c2918275a4",
                                                "text": "nel sistema tolemaico vi era una netta distinzione tra mondo celeste e mondo terrestre: il primo simbolo della perfezione, il secondo dell'imperfezione"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
