                        "glosses": [
                            "Befürworter des politischen Konzepts des Neutralismus"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "99920ed0-2ccb-3fbe-b2d4-4a7cade4fd65",
                        "entry_id": "fa9156d6-c17e-3d36-b507-fde09cb3b1bd",
                        "glosses": [
                            "Person, die sich für die Richtigkeit der von Motoo Kimura ^(→ WP) begründeten neutralen Theorie der molekularen Evolution ^(→ WP) ausspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38cfecda-443f-4fe0-ba07-e66a9d521128",
                                "sense_id": "99920ed0-2ccb-3fbe-b2d4-4a7cade4fd65",
                                "text": "„Über diese beiden Sichtweisen ist in der Evolutionsbiologie eine jahrzehntelange kontroverse Debatte zwischen „Selektionisten“ und „Neutralisten“ entbrannt.“"
                            },
                            {
                                "example_id": "2125b99c-6aba-4fa0-91bc-c0c7c33f7be3",
                                "sense_id": "99920ed0-2ccb-3fbe-b2d4-4a7cade4fd65",
                                "text": "„Die Neutralisten haben jahrelang behauptet, daß synonyme Mutationen selektiv neutral sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
