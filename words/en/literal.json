{
    "word_family": [
        "literally",
        "literalness",
        "literalism",
        "literalist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "831c0b68-5c0b-3aac-a393-e796d8865862",
                    "sense_definition": "Exactly as stated; without interpretation or figurative meaning.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>literal</w> translation of the phrase is quite different from its actual meaning.",
                            "target_lang_translations": {
                                "de": "Die <w>wörtliche</w> Übersetzung der Redewendung unterscheidet sich deutlich von ihrer eigentlichen Bedeutung."
                            }
                        },
                        {
                            "text": "He gave a <w>literal</w> interpretation of the rules, which caused some confusion.",
                            "target_lang_translations": {
                                "de": "Er lieferte eine <w>buchstäbliche</w> Auslegung der Regeln, was für Verwirrung sorgte."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbatim",
                        "word-for-word"
                    ],
                    "antonyms": [
                        "figurative",
                        "free",
                        "metaphorical"
                    ],
                    "common_phrases": [
                        "literal translation",
                        "literal meaning"
                    ],
                    "target_lang_definitions": {
                        "de": "Genau wie angegeben; wortwörtlich und ohne übertragene Bedeutung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wörtlich",
                                "target_lang_sense_clarification": "im genauen Wortlaut"
                            },
                            {
                                "target_lang_word": "buchstäblich",
                                "target_lang_sense_clarification": "nach dem genauen Buchstaben"
                            },
                            {
                                "target_lang_word": "wortwörtlich",
                                "target_lang_sense_clarification": "Wort für Wort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f2b827-cc5a-304d-9d2a-32b8ae287a99",
                    "sense_definition": "Actual, real, or physical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm caused a <w>literal</w> disaster for the small coastal town.",
                            "target_lang_translations": {
                                "de": "Der Sturm führte zu einer <w>regelrechten</w> Katastrophe für die kleine Küstenstadt."
                            }
                        },
                        {
                            "text": "When the guide said we would cross a bridge of rope, he meant a <w>literal</w> rope bridge.",
                            "target_lang_translations": {
                                "de": "Als der Führer sagte, wir würden eine Seilbrücke überqueren, meinte er eine <w>echte</w> Seilbrücke."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Tatsächlich, real vorhanden oder greifbar."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "regelrecht",
                                "target_lang_sense_clarification": "in vollem Sinne des Wortes"
                            },
                            {
                                "target_lang_word": "wahrhaftig",
                                "target_lang_sense_clarification": "tatsächlich, echt"
                            },
                            {
                                "target_lang_word": "buchstäblich",
                                "target_lang_sense_clarification": "im eigentlichen Sinne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba1499ae-5a9c-3eef-8b73-1db96c69c4dc",
                    "sense_definition": "Lacking imagination; matter-of-fact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a very <w>literal</w> person who struggles to understand jokes.",
                            "target_lang_translations": {
                                "de": "Er ist ein sehr <w>buchstabengetreuer</w> Mensch, dem es schwerfällt, Witze zu verstehen."
                            }
                        },
                        {
                            "text": "Her <w>literal</w> approach to art made her miss the deeper symbolism.",
                            "target_lang_translations": {
                                "de": "Ihre <w>nüchterne</w> Herangehensweise an die Kunst ließ sie die tiefere Symbolik übersehen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Nüchtern, fantasielos oder stark sachbezogen denkend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "buchstabengetreu",
                                "target_lang_sense_clarification": "streng an Regeln oder Wortlaut festhaltend"
                            },
                            {
                                "target_lang_word": "nüchtern",
                                "target_lang_sense_clarification": "sachlich, ohne Fantasie"
                            },
                            {
                                "target_lang_word": "fantasielos",
                                "target_lang_sense_clarification": "ohne Sinn für bildhafte Sprache"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d6330cf-b6c6-3dfe-a698-7278216bb923",
                    "sense_definition": "Used informally as an intensifier to emphasize a point.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That movie was the <w>literal</w> best thing I have seen all year.",
                            "target_lang_translations": {
                                "de": "Dieser Film war <w>buchstäblich</w> das Beste, was ich das ganze Jahr über gesehen habe."
                            }
                        },
                        {
                            "text": "I was a <w>literal</w> mess before the big presentation started.",
                            "target_lang_translations": {
                                "de": "Ich war ein <w>absolutes</w> Wrack, bevor die große Präsentation anfing."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to emphasize a statement."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachlich als Verstärkungswort verwendet, um eine Aussage zu betonen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "absolut",
                                "target_lang_sense_clarification": "zur starken Verstärkung"
                            },
                            {
                                "target_lang_word": "buchstäblich",
                                "target_lang_sense_clarification": "umgangssprachlich verstärkend"
                            },
                            {
                                "target_lang_word": "regelrecht",
                                "target_lang_sense_clarification": "verstärkend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d623deb-6848-3b69-8c54-bd0b794695ea",
                    "sense_definition": "A fixed value written directly into computer source code.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer used a numeric <w>literal</w> to define the maximum value.",
                            "target_lang_translations": {
                                "de": "Der Programmierer verwendete ein numerisches <w>Literal</w>, um den Maximalwert festzulegen."
                            }
                        },
                        {
                            "text": "Using a string <w>literal</w> makes the code easier to read.",
                            "target_lang_translations": {
                                "de": "Die Verwendung eines Zeichenketten-<w>Literals</w> macht den Code leichter lesbar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "literal constant",
                        "string literal",
                        "numeric literal"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein fester, direkt im Quellcode angegebener Wert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Literal",
                                "target_lang_sense_clarification": "fester Wert im Programmiercode"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2935e4f-4418-30d7-905c-44dd722f8b7c",
                    "sense_definition": "A printing error that involves a single letter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor found a <w>literal</w> in the first paragraph of the book.",
                            "target_lang_translations": {
                                "de": "Der Lektor fand einen <w>Druckfehler</w> im ersten Absatz des Buches."
                            }
                        },
                        {
                            "text": "A small <w>literal</w> changed the meaning of the entire sentence.",
                            "target_lang_translations": {
                                "de": "Ein kleiner <w>Tippfehler</w> veränderte die Bedeutung des gesamten Satzes."
                            }
                        }
                    ],
                    "synonyms": [
                        "typo"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein einzelner Druck- oder Tippfehler bezüglich eines Buchstabens."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Druckfehler",
                                "target_lang_sense_clarification": "Fehler beim Drucken oder Setzen"
                            },
                            {
                                "target_lang_word": "Tippfehler",
                                "target_lang_sense_clarification": "Fehler beim Schreiben einzelner Buchstaben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}