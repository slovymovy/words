                        "glosses": [
                            "прост. скучное, однообразное занятие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4d6646-a064-4c31-9b1b-a649f01e55eb",
                                "sense_id": "9ae09d0d-865d-3404-97e6-5b4fc395cab9",
                                "text": "Ну-да! — бессмысленно, по слогам говорил Тимка. — Жизнь, говорю, здешняя — нуда, — уточнял Ивлентьев. — Нуда, нуда, — повторял Тимка. — Ишь задожжило! Погода — нуда! — Нуда! — терпеливо твердил Тимка. — Все нуда …"
                            }
                        ]
                    }
