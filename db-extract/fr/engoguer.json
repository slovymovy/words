                ],
                "senses": [
                    {
                        "sense_id": "2c942569-952d-3ee0-acbf-5a5d2e5b33f8",
                        "entry_id": "00404762-a0a5-35e8-9708-2b814f1e7d00",
                        "glosses": [
                            "Gaver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd5a2e4-ea1b-409d-827e-f0e53883c084",
                                "sense_id": "2c942569-952d-3ee0-acbf-5a5d2e5b33f8",
                                "text": "N’essaie pas de m’engoguer avec une montagne de nourriture."
                            },
                            {
                                "example_id": "fb5ddb3f-9a58-4b7b-a51c-f2f12bc064b4",
                                "sense_id": "2c942569-952d-3ee0-acbf-5a5d2e5b33f8",
                                "text": "Ensuite, si tu me fais tes excuses pour ce jour-là, nous allons tout près d’ici où nous fêtons une construction à peine terminée, et dans ces cas on met du vin en perce, de celui de derrière les fagots et, comme disaient nos vieux, zou, on se gogue et s’engogue."
                            }
                        ]
                    },
                    {
                        "sense_id": "97892af3-791c-3dee-a813-ca48e55ee015",
                        "entry_id": "00404762-a0a5-35e8-9708-2b814f1e7d00",
                        "glosses": [
                            "Farcir un boyau, embosser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f2743b-582b-429c-84ad-f909af739881",
                                "sense_id": "97892af3-791c-3dee-a813-ca48e55ee015",
                                "text": "La préparation homogène est enfin salée et poivrée avant de garnir ou « d’engoguer » les boyaux à boudin, du menu, sans trop serrer."
                            },
                            {
                                "example_id": "ad1cb0c0-55e8-48d4-8555-39b5e93cb6d1",
                                "sense_id": "97892af3-791c-3dee-a813-ca48e55ee015",
                                "text": "Enbosser (engoguer) avec un poussoir dans les boyaux naturels (ne pas trop serrer, risque d’éclatement)."
                            }
                        ]
                    }
                ],
