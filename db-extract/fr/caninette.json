                "senses": [
                    {
                        "sense_id": "f4c2ff95-993f-360e-8ff1-64192e65c6ff",
                        "entry_id": "ffd8cd2c-020d-3cb0-9823-b359b7db3077",
                        "glosses": [
                            "Sorte d'engin motorisé à deux roues qui servait à ramasser les crottes de chiens sur les trottoirs de Paris."
                        ],
                        "tags": [
                            "Paris"
                        ],
                        "examples": [
                            {
                                "example_id": "f06d2107-1b43-4726-9b7d-510d4c6fec1c",
                                "sense_id": "f4c2ff95-993f-360e-8ff1-64192e65c6ff",
                                "text": "Ils ont reconnu Fabienne et sa « caninette », qu'ils saluent d'un rituel « bonjour ». Depuis qu'elle roule sur les trottoirs parisiens avec son engin blanc et vert aux couleurs de « La Propreté de Paris », Fabienne fait déjà partie du paysage quotidien pour les habitants du quartier."
                            },
                            {
                                "example_id": "d341be22-228d-42d3-816f-ba0c204cd7dd",
                                "sense_id": "f4c2ff95-993f-360e-8ff1-64192e65c6ff",
                                "text": "En 1998, 150 engins de chaussée, 200 engins de trottoir et 60 « caninettes » (motos pour ramasser les déjections canines) sont employés. Le nombre d'heures d'utilisation de ce type de machines a presque doublé entre 1990 et aujourd'hui."
                            },
                            {
                                "example_id": "2eb65450-f9c1-4bde-a420-2a7403722bfe",
                                "sense_id": "f4c2ff95-993f-360e-8ff1-64192e65c6ff",
                                "text": "Pétarade. Ils se tournent vers la rue. Devant la porte trépigne une caninette.\n— Chiraquette, rectifie le patron.\nLe gars, casqué, sur sa moto réservoir à crottes blanche et verte, vise soigneusement avant de faire descendre son aspirateur."
                            }
                        ]
                    }
