            {
                "entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                "word": "sorbier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2cc44792-2b62-4983-890a-3c0a4324e195",
                        "entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                        "tags": [
                            "plural"
                        ],
                        "form": "sorbiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                        "entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                        "glosses": [
                            "Genre de rosacées, arbres ou arbustes ornementaux à feuilles composées, et aux petits fruits globuleux, rouge, orange ou bruns, appréciés des oiseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93840a57-1ec2-4c4e-b075-3e0cc5ea1ac8",
                                "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                "text": "Je m’efforçais d’imaginer les sorbiers sans leurs feuilles vertes d’une part, argentées de l’autre, sans leurs ombelles de fruits rouges."
                            },
                            {
                                "example_id": "b7347303-9fa7-488f-8441-4928c135e98e",
                                "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                "text": "Le bois des sorbiers, au grain serré, est utilisé en ébénisterie."
                            },
                            {
                                "example_id": "228584da-358d-44ed-8516-3176580b3547",
                                "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                "text": "Il semble même, par l’exemple des fruits des diospyros, du sorbier et du néflier, qu’on ne peut manger que blets, que plus l’acerbité a été grande, plus le fruit est susceptible de blessir régulièrement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b179d798-7f88-3801-afce-62b33609c395",
                        "entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                        "glosses": [
                            "Sorbus subg. Sorbus, un des sous-genres de Sorbus (par opposition aux alisiers)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4d04e8f1-d429-44c0-8dac-c965abee330b",
                                "sense_id": "b179d798-7f88-3801-afce-62b33609c395",
                                "text": "Soudain, sans raison valable, elle se réveillait chez un tel parce que les sorbiers croulaient de fleurs musquées, chez un autre parce qu’un gel tardif avait rôti leurs blancs corymbes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a2a693-5094-485c-9e8a-a07360672bfc",
                        "source_entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                        "target_lang_word": "Vogelbeerbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7d173bf4-019b-4dff-bd80-c7d78f4553d0",
                        "source_entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                        "target_lang_word": "Eberesche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eberesche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4459b45-1d30-33e1-bb16-500a94aa2873",
                                        "entry_id": "6ad6e1da-511f-3cba-939c-ee4c84d8ab1b",
                                        "glosses": [
                                            "kleiner Laubbaum mit gefiederten Blättern und leuchtend orangeroten Früchten (Sorbus aucuparia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8345108f-67fc-499f-be9e-ba6dbfe5eecb",
                                                "sense_id": "f4459b45-1d30-33e1-bb16-500a94aa2873",
                                                "text": "Am Rand des Gartens standen mehrere Ebereschen."
                                            },
                                            {
                                                "example_id": "f920a775-2d88-43d6-990f-b56c46045e25",
                                                "sense_id": "f4459b45-1d30-33e1-bb16-500a94aa2873",
                                                "text": "„Die Ahornbäume und die Ebereschen hatten keine Blätter mehr.“"
                                            },
                                            {
                                                "example_id": "884709a2-09ff-46b6-927d-a1fa9c774663",
                                                "sense_id": "f4459b45-1d30-33e1-bb16-500a94aa2873",
                                                "text": "„Sie kannte die Plätze der knorrigen Moorbirken und die Buschgruppen aus Weiden und Ebereschen, wo Birkhühner und Wiesenpieper nisteten.“"
                                            },
                                            {
                                                "example_id": "d9393cfd-dba8-406c-bc77-da4ca257509f",
                                                "sense_id": "f4459b45-1d30-33e1-bb16-500a94aa2873",
                                                "text": "„Sie vermisste die große Eberesche vor dem Fenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fd0b6a4-e010-41ab-bc38-a074de8916a7",
                        "source_entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
