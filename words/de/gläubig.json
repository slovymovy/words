                    "sense_definition": "eine religiöse Anschauung vertretend; an eine höhere Macht oder an Gott glaubend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Obwohl seine Eltern sehr <w>gläubig</w> sind, geht er selbst nur selten in die Kirche."
                        },
                        {
                            "text": "Nach den schweren Schicksalsschlägen fand sie zum Glauben und wurde wieder <w>gläubig</w>."
                        }
                    ],
                    "synonyms": [
                        "religiös",
                        "fromm"
                    ],
                    "antonyms": [
                        "ungläubig",
                        "agnostisch"
                    ],
                    "common_phrases": [
                        "streng gläubig",
                        "tief gläubig"
                    ]
                },
                {
                    "sense_id": "f72fbff6-2d07-311e-b445-7edb878d5f7a",
                    "sense_definition": "voller Vertrauen auf jemanden oder etwas blickend; bereitwillig alles glaubend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vertrauen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Schulkinder blickten <w>gläubig</w> zu ihrem neuen Lehrer auf und lauschten jeder Geschichte."
                        },
                        {
                            "text": "Der Politiker hatte eine Schar treuer und <w>gläubiger</w> Anhänger um sich geschart."
                        }
                    ],
                    "synonyms": [
