                                        "glosses": [
                                            "wyraz, zwrot, forma gramatyczna zapożyczona do jakiegoś języka z jidysz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "993341dc-1858-4c71-9560-bcd7d29057b7",
                                                "sense_id": "54b34673-d7cb-3398-9c5f-c1a6c1d3e75f",
                                                "text": "W tym słowniku jest wiele jidyszyzmów."
                                            },
                                            {
                                                "example_id": "253292c6-8065-4596-814c-b1a7345ea203",
                                                "sense_id": "54b34673-d7cb-3398-9c5f-c1a6c1d3e75f",
                                                "text": "Jak podkreśla wielu znanych badaczy, Frank była zasymilowana i nie była syjonistką. Pisała po niderlandzku, bez śladu naleciałości hebrajskich czy jidyszyzmów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "8c3c93af-229a-3e53-8de2-c364d0d761c1",
                                        "entry_id": "af5170d1-606d-35ca-8f64-dbb415cdb740",
                                        "glosses": [
                                            "nurt kulturowy uznający jidysz za język narodowy Żydów i dążący do rozwoju świeckiej kultury żydowskiej w oparciu o ten język"
                                        ],
                                        "tags": [
                                            "Jewish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfefb4ad-982a-480f-b072-48634d0496ef",
                                                "sense_id": "8c3c93af-229a-3e53-8de2-c364d0d761c1",
                                                "text": "Od niedzieli odbywać się będzie w Warszawie dwudniowa konferencja „Jidyszyzm: Mitologie i Ikonografie”. Dotyczy ona jidyszyzmu, który był konkurencyjnym względem syjonizmu nurtem żydowskiej kultury"
                                            }
