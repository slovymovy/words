                        ]
                    },
                    {
                        "translation_id": "68700a1a-3827-4b76-8710-265f25886f42",
                        "source_entry_id": "78d341c8-e56b-3a47-9bbe-f492b61b0428",
                        "source_sense_description": "Agent chargé, depuis le poste d’aiguillage, de la surveillance et de la manœuvre des signaux et des appareils de voie (aiguilles, taquets, verrous, etc.).",
                        "target_lang_word": "signalman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signalman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "313bbbd2-a159-337d-bc3d-bb4969bb7545",
                                        "entry_id": "14e83433-ec86-3671-b3ff-c09c7d68b136",
                                        "glosses": [
                                            "Somebody employed to operate the signals and points of a railway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128f3807-2932-4e8e-8c39-58b97367b5e4",
                                                "sense_id": "313bbbd2-a159-337d-bc3d-bb4969bb7545",
                                                "text": "With extra traffic, numerous boat trains to and from Southampton Docks, and working of empty stock, his job, like that of most signalmen, is no sinecure."
                                            },
                                            {
                                                "example_id": "3d95df40-7c67-4f6f-8628-525c0252d981",
                                                "sense_id": "313bbbd2-a159-337d-bc3d-bb4969bb7545",
                                                "text": "The length ganger saw the train passing with the van derailed and promptly telephoned the Sandbach signalman, who restored his signals to danger, but not in time to stop the train before the final derailment occurred."
                                            },
                                            {
                                                "example_id": "23d6f035-5be5-41e4-914d-43279f8ba817",
                                                "sense_id": "313bbbd2-a159-337d-bc3d-bb4969bb7545",
                                                "text": "As he passed though the station, he slowed to yell to the signalman, Frank 'Sailor' Bridges: \"Sailor - have you anything between here and Fordham? Where's the mail?\" Gimbert knew the mail train was due, and he didn't want to endanger another train with his burning bomb wagon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6c8bfcd-0a88-397d-833c-c609db04bc05",
                                        "entry_id": "14e83433-ec86-3671-b3ff-c09c7d68b136",
                                        "glosses": [
                                            "A member of the armed forces responsible for signalling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "331856d2-d16e-30e5-96c0-9fef7a921ab5",
                                        "entry_id": "14e83433-ec86-3671-b3ff-c09c7d68b136",
                                        "glosses": [
                                            "Somebody employed to direct rigging or crane operations by providing a different point of view."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "047be880-907f-49ec-8119-47dd593038fb",
                        "source_entry_id": "78d341c8-e56b-3a47-9bbe-f492b61b0428",
                        "source_sense_description": "Agent chargé, depuis le poste d’aiguillage, de la surveillance et de la manœuvre des signaux et des appareils de voie (aiguilles, taquets, verrous, etc.).",
                        "target_lang_word": "pointsman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pointsman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a1066e2-e801-3f78-b168-6d6f46441526",
                                        "entry_id": "2825da61-9166-332b-bd9d-3b45f386b22a",
                                        "glosses": [
                                            "A man in charge of railroad points (switches)."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd36bbe-3ed0-4325-8373-1f5a728140d4",
                                                "sense_id": "8a1066e2-e801-3f78-b168-6d6f46441526",
                                                "text": "The signalman, as such, was unknown at first. At junctions, or for shunting, the pointsman was responsible both for setting the points and working the appropriate signals, the two being independent. As a result, accidents were comparatively frequent, and the pointsman's job was, at best, a hazardous one."
                                            },
                                            {
                                                "example_id": "3b31b2c8-7046-4365-bc09-08b517a8e421",
                                                "sense_id": "8a1066e2-e801-3f78-b168-6d6f46441526",
                                                "text": "At their point of origin, constructing these boxes presented railway companies with an attractive proposition: to remove the need for pointsmen and flagmen operating at several ground-level locations around a railway site by housing one or two men in a signal structure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
