                    },
                    {
                        "translation_id": "d62c46ce-6daf-4631-93dd-b0b828a0f483",
                        "source_entry_id": "398fb13d-3c29-3abf-ae73-d52b6faf3aef",
                        "source_sense_description": "stained, spotted or otherwise discolored with blood",
                        "target_lang_word": "blutbefleckt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blutbefleckt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                        "entry_id": "e1480f4d-f418-3453-8e7e-77c20e3f0a26",
                                        "glosses": [
                                            "mit Blut befleckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae471f23-df7b-48b7-bef3-658c4b9dcc82",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Lon Melchor lag auf dem Fußboden und war offenbar bewusstlos; sein Hemd war blutbefleckt!“"
                                            },
                                            {
                                                "example_id": "25e5ec3e-756f-4053-b7f2-7aa9c4c30441",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Chigurh sah, wie sich angesichts der blutbefleckten Gestalt vor ihm Zweifel in seinen Blick stahlen, aber es war zu spät.“"
                                            },
                                            {
                                                "example_id": "793adc82-df85-4814-98b9-6a2e8863cd05",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Anhand eines blutbefleckten Sweatshirts, einer Hose, in der sich ein Schlüssel zum Apartment befand, und eines blutbefleckten Metallgegenstandes, der in der Nähe des Tatorts gefunden worden sei, habe die Spurensicherung die Identität des Verdächtigen ermittelt.“"
                                            },
                                            {
                                                "example_id": "23cc4b1b-80ae-4dd0-ae66-1b760acc5771",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Allem Anschein nach hatte die säuerliche Matrone recht; denn gegen drei Uhr morgens wurde das ganze Haus von Schreien aus Wests Zimmer geweckt, wo man, nachdem man die Tür eingeschlagen hatte, uns beide bewusstlos auf dem blutbefleckten Teppich fand, zerschunden, zerkratzt und übel zugerichtet, umgeben von den zerbrochenen Überresten der Flaschen und Instrumente Wests.“"
                                            },
                                            {
                                                "example_id": "04caf61f-afe4-4d18-987f-245910baad49",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Im abnehmenden Licht der schmalen Mondsichel glitzert die blutbefleckte Klinge so seltsam.“"
                                            },
                                            {
                                                "example_id": "8de9b259-27f8-44d5-b4bd-1fd14c77265b",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Ich benötige nur einen Ort, um diese blutbefleckten Fetzen loszuwerden.“"
                                            },
                                            {
                                                "example_id": "85a6b104-fc42-45c1-9af1-9a1a40fbdfc6",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Neben ihm befand sich die blutbefleckte Axt, offenbar achtlos weggeworfen.“"
                                            },
                                            {
                                                "example_id": "54b09394-288d-4670-ab3f-078d93f54596",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Nichts für mich, denkt sie und wirft das blutbefleckte Laken in den Wäschekorb.“"
                                            },
                                            {
                                                "example_id": "5e9e3ca2-a511-42f7-9d93-6f946e17bc56",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Zur gleichen Zeit sitzen Edgerton und Ceruti im Nebenbüro, inmitten einer Ansammlung brauner Tüten der Spurensicherung, in denen die Ausbeute der morgendlichen Autopsie gesammelt ist: Schuhe, blutbefleckte Kleidungsstücke, Abstriche von den Fingernägeln des Opfers, die auf mögliche Spuren von DNA oder die Blutgruppe untersucht werden, Haare, die am Opfer gefunden wurden, die teils von einer schwarzen, teils von einer weißen Person stammen und von denen völlig unklar ist, ob sie etwas mit dem Verbrechen zu tun haben.“"
                                            },
                                            {
                                                "example_id": "0f9f3061-63a8-4fbe-a9b3-ab14b7e248e4",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Er strauchelte in den Trümmern und kam wieder hoch, blutbefleckt, um nach dem Fuß zu greifen, bevor der angehoben wurde und er allein zurückblieb.“"
                                            },
                                            {
                                                "example_id": "0019b4cf-721a-487b-b27f-baeec642e93a",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Seine Augen blinzelten und sein Blick schweifte auf den blutbefleckten Betonboden.“"
                                            },
                                            {
                                                "example_id": "f3801e84-e59d-4dd3-b6b2-b66554b61ee6",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Sein Mund war blutbefleckt, und es kaute.“"
                                            },
                                            {
                                                "example_id": "162faf03-cdaa-4704-bb38-3762ed3e39f4",
                                                "sense_id": "6b6a36c5-b691-391b-bdfb-eb35a2d49d56",
                                                "text": "„Der große Koch packt sie und zwingt sie, sich auf einen blutbefleckten Stuhl mitten im Raum zu setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
