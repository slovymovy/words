                ],
                "senses": [
                    {
                        "sense_id": "df410f1b-1c95-34f0-b269-1dd325642ccb",
                        "entry_id": "ebcbd4c7-e5b4-384e-a392-439ccc34cc8e",
                        "glosses": [
                            "Qui est résolu, ferme, qui a des principes dont il ne s’écarte pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1124e893-dc6a-4cd4-9de3-5eb4cf21cbd8",
                                "sense_id": "df410f1b-1c95-34f0-b269-1dd325642ccb",
                                "text": "C’est un homme décidé."
                            },
                            {
                                "example_id": "96aa35f3-31db-4faf-a5c6-6a0d5786be9a",
                                "sense_id": "df410f1b-1c95-34f0-b269-1dd325642ccb",
                                "text": "Il a un caractère très décidé, un ton décidé."
                            },
                            {
                                "example_id": "634d7d23-de45-4bc0-ac46-e7b317e1dd99",
                                "sense_id": "df410f1b-1c95-34f0-b269-1dd325642ccb",
                                "text": "Une jeune personne ne jette jamais les yeux sur son propre corps ; enlever sa chemise en présence d’une amie ou d’une parente serait aussi monstrueux que les plus décidées privautés charnelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce7335ed-55c8-3d85-ba93-0d73a7d26389",
                        "entry_id": "ebcbd4c7-e5b4-384e-a392-439ccc34cc8e",
                        "glosses": [
                            "Qui n’a rien de vague, d’incertain, qui ne marque point d’hésitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2deb959-8bfb-47a1-8656-6e46a0e3ed7a",
                                "sense_id": "ce7335ed-55c8-3d85-ba93-0d73a7d26389",
                                "text": "Ce jeune homme a l’allure décidée."
                            },
                            {
                                "example_id": "28123f63-3d18-4b92-95ae-383bba5f6729",
                                "sense_id": "ce7335ed-55c8-3d85-ba93-0d73a7d26389",
                                "text": "Le gouvernement prit une marche plus décidée."
                            }
                        ]
                    },
                    {
                        "sense_id": "335a4297-f400-332a-856a-561c9ea6cb59",
                        "entry_id": "ebcbd4c7-e5b4-384e-a392-439ccc34cc8e",
                        "glosses": [
                            "Qui a été résolu, dont le parti a été pris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cf672a-847e-4d23-a9ab-31e43a19ffaa",
                                "sense_id": "335a4297-f400-332a-856a-561c9ea6cb59",
                                "text": "C’est chose décidée."
                            },
                            {
                                "example_id": "3d405914-63d5-413f-88b6-bc7d9213b4a1",
                                "sense_id": "335a4297-f400-332a-856a-561c9ea6cb59",
                                "text": "Sa perte était chose décidée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4366bc86-250e-47f1-b0b1-ef3570b47c3d",
                        "source_entry_id": "ebcbd4c7-e5b4-384e-a392-439ccc34cc8e",
