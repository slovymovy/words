                            },
                            {
                                "target_word": "mutton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f94778c-dc98-3312-997e-94954f3bf3d2",
                                        "entry_id": "515bee2a-d5d1-39ee-ab21-29ed5ab9edd2",
                                        "glosses": [
                                            "deaf."
                                        ],
                                        "tags": [
                                            "Cockney",
