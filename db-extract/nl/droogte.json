                ],
                "senses": [
                    {
                        "sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
                        "entry_id": "0d88b953-6eef-320e-81fd-c9676d5a2eaa",
                        "glosses": [
                            "lange periode zonder of met minder neerslag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47062f9-b2d3-4f1f-ba4c-d8e56beb74df",
                                "sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
                                "text": "In het land heerst grote droogte."
                            },
                            {
                                "example_id": "d3ee0fac-a014-46c6-9cbf-62ff2aec9272",
                                "sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
                                "text": "Door de droogte verspreiden de branden zich heel snel. '"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd192a80-f406-4cb9-8bcb-ec79faa23a74",
                        "source_entry_id": "0d88b953-6eef-320e-81fd-c9676d5a2eaa",
                        "source_sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
                        "source_sense_description": "lange periode zonder of met minder neerslag",
                        "target_lang_word": "Dürre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dürre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                        "entry_id": "4549d096-bc6c-32d7-b88a-bf93a6e28a37",
                                        "glosses": [
                                            "Periode des Wassermangels, die zu Schäden in der Landwirtschaft führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6df89c9d-3cba-42e5-a25d-85c59d690ecb",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "Die Dürre macht dem Land schwer zu schaffen."
                                            },
                                            {
                                                "example_id": "f7396fa3-90c6-406f-9aaf-d6c240db3c6e",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„In Wüsten erweckt erst der Regen einige Pflanzen zum Leben. Andere überleben die Dürre, indem sie Wasser in ihren Stängeln oder Wurzeln speichern.“"
                                            },
                                            {
                                                "example_id": "2c3d613d-ed6b-4256-994e-95dbb0f0aa89",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "Und der Herr schickte eine große Dürre."
                                            },
                                            {
                                                "example_id": "21e803b0-4f0e-4c4e-8ac2-b1f1110f3b62",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Im Osten Afrikas hat es im Frühjahr 2017 eine große Dürre gegeben.“"
                                            },
                                            {
                                                "example_id": "8e6771f2-5154-457c-addd-d48f1bec4740",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Die Dürre ist lebensbedrohlich.“"
                                            },
                                            {
                                                "example_id": "7ac5faf8-c30b-4847-b941-8b897977b6a8",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Der Frühling ist noch nicht mal richtig da, und doch herrscht vor allem im Süden Europas bereits Dürre.“"
                                            },
                                            {
                                                "example_id": "2503ae20-0073-47eb-8112-dcfd59a003d8",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "[Dust bowl 1935-1938:] „Die klimatische Ursache für die langjährige Dürre lag in außergewöhnlichen Wassertemperaturen des Pazifiks und Atlantiks.“"
                                            },
                                            {
                                                "example_id": "4c54bc1f-946d-40a8-8eda-dd75905a277e",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Italien litt im vorigen Sommer unter einer außergewöhnliche Dürre, die große Schäden vor allem in der Landwirtschaft verursachte.“"
                                            },
                                            {
                                                "example_id": "f6d0fb9c-6df9-47e5-9a47-acdcb6aa497a",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Somalia und seine Nachbarländer leiden unter der schlimmsten Dürre seit Jahren.“"
                                            },
                                            {
                                                "example_id": "09ff489b-7bb3-4ff5-b1bf-dc54eaaca88b",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Auf seinem Hof bei Detmold in Nordrhein-Westfalen leidet die Ernte Jahr für Jahr unter Dürren und Starkregen.“"
                                            },
                                            {
                                                "example_id": "d5d15e2c-9d5d-46c8-aa74-08357a34f591",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Der Klimawandel wird aber in Zukunft wohl nicht nur mehr Gewitter und Regen bringen, sondern auch das Gegenteil, mehr Trockenheit und Dürre.“"
                                            },
                                            {
                                                "example_id": "e293dc75-8c42-4f8f-a3f1-d2ee474087a7",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„»Die Dürre hat bereits drei Punkte des geschätzten argentinischen Bruttoinlandsprodukts gekostet«, so die Getreidebörse von Rosario (BCR) in einem Bericht heute.“"
                                            },
                                            {
                                                "example_id": "fc36d90e-cd27-4b6d-b625-5b6eeccb07b6",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Derzeit stecken Länder im europäischen Süden, die besonders stark von Dürren betroffen sind, wie etwa Spanien, Italien oder Bulgarien, pro Einwohner am wenigsten Geld in bessere Leitungen.“"
                                            },
                                            {
                                                "example_id": "33940b6c-beb3-4dc7-9095-fc2b15ea40b0",
                                                "sense_id": "ac8c4497-fda6-352a-9288-b35d8f171ec7",
                                                "text": "„Der Tod nimmt weg die da sündigen, wie die Hitze und Dürre das Schneewasser verzehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f91c3c1d-761b-3dee-bc4d-147f1cd8db3c",
                                        "entry_id": "4549d096-bc6c-32d7-b88a-bf93a6e28a37",
                                        "glosses": [
                                            "sprachliche Gehaltlosigkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aeec2b4c-1861-405e-b2da-1b146e9b4436",
                        "source_entry_id": "0d88b953-6eef-320e-81fd-c9676d5a2eaa",
                        "source_sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
                        "source_sense_description": "lange periode zonder of met minder neerslag",
                        "target_lang_word": "drought",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drought",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32b6ac65-2fa5-3855-8381-9d6f7ef1b717",
                                        "entry_id": "a91c4f11-9e4e-3e76-a3f3-7acb3e2eb913",
                                        "glosses": [
                                            "A period of unusually low rainfall, longer and more severe than a dry spell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0bb696-57b9-4ddc-a7f1-bf8665eaf80f",
                                                "sense_id": "32b6ac65-2fa5-3855-8381-9d6f7ef1b717",
                                                "text": "His village had faced a drought twice."
                                            },
                                            {
                                                "example_id": "957a22c5-5937-40ac-8ab2-c378a78a0a51",
                                                "sense_id": "32b6ac65-2fa5-3855-8381-9d6f7ef1b717",
                                                "text": "The weather looked like drought―a thoroughly wicked drought; if the rain did not come before long, their crops would be burnt up."
                                            },
                                            {
                                                "example_id": "33bea511-c65d-4459-9c93-b949d5d3778f",
                                                "sense_id": "32b6ac65-2fa5-3855-8381-9d6f7ef1b717",
                                                "text": "Phoenix and Lubbock are both caught in severe drought, and it is going to get much worse. We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water. Welcome to the Anthropocene, the epoch when humans have become a major geological and climatic force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8aa6bd5-cfed-389e-ab5f-80075defa7fd",
                                        "entry_id": "a91c4f11-9e4e-3e76-a3f3-7acb3e2eb913",
                                        "glosses": [
                                            "A longer than expected term without success, particularly in sport."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e1a58fb-9777-4286-a536-43e109f981cc",
                                                "sense_id": "a8aa6bd5-cfed-389e-ab5f-80075defa7fd",
                                                "text": "Sri Lanka ended their ten-game drought with a consolation win over Bangladesh."
                                            },
                                            {
                                                "example_id": "4701c0c1-f818-4032-a88f-3cd713d03ef6",
                                                "sense_id": "a8aa6bd5-cfed-389e-ab5f-80075defa7fd",
                                                "text": "Kane had been going through something of a drought by his own standards. His previous England goal came 500 days ago, in a Euro 2020 qualifier against Kosovo, and his header in Tirana ended a run of 496 minutes without scoring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0973ec0c-0bb0-3984-8f03-2e7ac8fedc86",
                                        "entry_id": "a91c4f11-9e4e-3e76-a3f3-7acb3e2eb913",
                                        "glosses": [
                                            "dryness, aridness, dry heat"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a09b063-2fc4-4915-83aa-5d982a47c8af",
                                                "sense_id": "0973ec0c-0bb0-3984-8f03-2e7ac8fedc86",
                                                "text": "Thus I was; in the day the drought consumed me, and the frost by night; and my sleep departed from mine eyes."
                                            },
                                            {
                                                "example_id": "d044372c-a9b0-4bc2-a5d4-7141f2963678",
                                                "sense_id": "0973ec0c-0bb0-3984-8f03-2e7ac8fedc86",
                                                "text": "The consequences are, that a few days of severe drought, in the early parts of summer, or even when the grain is ripening, is sometimes fatal to the crop on moss."
                                            },
                                            {
                                                "example_id": "b9c01c10-6768-4e0f-8e8a-9dead60f1b11",
                                                "sense_id": "0973ec0c-0bb0-3984-8f03-2e7ac8fedc86",
                                                "text": "The seasons most unfavourable to the crop are those of excessive drought or excessive rain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e02c62b8-0f01-476b-98f4-be53a6e04590",
                        "source_entry_id": "0d88b953-6eef-320e-81fd-c9676d5a2eaa",
                        "source_sense_id": "f792ca21-be6b-3782-9113-6cc89c3c94cb",
