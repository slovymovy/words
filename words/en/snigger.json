{
    "word_family": [
        "sniggering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54686d90-bff5-37cd-8a91-86ffccc41c3f",
                    "sense_definition": "A partly suppressed or broken laugh.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student tried to hide a <w>snigger</w> when the teacher tripped over the rug.",
                            "target_lang_translations": {
                                "zh": "当老师被地毯绊倒时，那个学生试图掩饰自己的<w>窃笑</w>。",
                                "it": "Lo studente cercò di nascondere una <w>risatina</w> quando l'insegnante inciampò nel tappeto."
                            }
                        },
                        {
                            "text": "A quiet <w>snigger</w> broke the silence in the back of the classroom.",
                            "target_lang_translations": {
                                "zh": "一声安静的<w>窃笑</w>打破了教室后排的寂静。",
                                "it": "Una sommessa <w>risatina</w> interruppe il silenzio in fondo alla classe."
                            }
                        }
                    ],
                    "synonyms": [
                        "chuckle",
                        "giggle"
                    ],
                    "common_phrases": [
                        "suppressed snigger",
                        "quiet snigger"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种压抑的或断断续续的轻笑。",
                        "it": "Una risata parzialmente trattenuta o soffocata."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "窃笑",
                                "target_lang_sense_clarification": "指偷偷地、压抑地笑。"
                            },
                            {
                                "target_lang_word": "暗笑",
                                "target_lang_sense_clarification": "指在心里或背地里偷偷发笑。"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "risatina",
                                "target_lang_sense_clarification": "risata breve, spesso trattenuta"
                            },
                            {
                                "target_lang_word": "risatina soffocata",
                                "target_lang_sense_clarification": "risata trattenuta a stento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5337206d-4c4c-32e2-8050-21ab97f036b2",
                    "sense_definition": "A sly or snide laugh.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He let out a <w>snigger</w> at his rival's failure.",
                            "target_lang_translations": {
                                "zh": "他对着竞争对手的失败发出了一声<w>讥笑</w>。",
                                "it": "Ha fatto un <w>ghigno</w> di fronte al fallimento del suo rivale."
                            }
                        },
                        {
                            "text": "The group shared a <w>snigger</w> behind her back.",
                            "target_lang_translations": {
                                "zh": "那群人在她背后<w>讥笑</w>。",
                                "it": "Il gruppo si è scambiato una <w>risatina</w> alle sue spalle."
                            }
                        }
                    ],
                    "synonyms": [
                        "sneer"
                    ],
                    "common_phrases": [
                        "sly snigger"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种带有嘲讽或恶意的笑。",
                        "it": "Una risata beffarda, sarcastica o maliziosa."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讥笑",
                                "target_lang_sense_clarification": "指带有嘲讽意味的笑。"
                            },
                            {
                                "target_lang_word": "冷笑",
                                "target_lang_sense_clarification": "指带有轻蔑或恶意意味的笑。"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ghigno",
                                "target_lang_sense_clarification": "risata derisoria o beffarda"
                            },
                            {
                                "target_lang_word": "risatina",
                                "target_lang_sense_clarification": "risata con intento beffardo o sarcastico"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9110c26f-69c5-34df-8bdc-7be0e3a830a3",
                    "sense_definition": "To emit a partly suppressed or sly laugh.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "laughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children began to <w>snigger</w> when they saw the funny hat.",
                            "target_lang_translations": {
                                "zh": "孩子们看到那顶滑稽的帽子时开始<w>窃笑</w>。",
                                "it": "I bambini hanno iniziato a <w>ridacchiare</w> quando hanno visto il cappello buffo."
                            }
                        },
                        {
                            "text": "It is rude to <w>snigger</w> at someone during a serious presentation.",
                            "target_lang_translations": {
                                "zh": "在严肃的演讲过程中对着别人<w>讥笑</w>是很无礼的。",
                                "it": "È maleducato <w>sghignazzare</w> alle spalle di qualcuno durante una presentazione seria."
                            }
                        }
                    ],
                    "synonyms": [
                        "giggle",
                        "chuckle"
                    ],
                    "common_phrases": [
                        "snigger at"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出压抑的或带有嘲讽意味的笑声。",
                        "it": "Ridere sotto i baffi, trattenendo a stento la risata o ridendo con malizia."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "窃笑",
                                "target_lang_sense_clarification": "指发出偷偷的、压抑的笑声。"
                            },
                            {
                                "target_lang_word": "讥笑",
                                "target_lang_sense_clarification": "指发出带有嘲讽意味的笑声。"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ridacchiare",
                                "target_lang_sense_clarification": "ridere a mezza voce o sotto i baffi"
                            },
                            {
                                "target_lang_word": "ridere sotto i baffi",
                                "target_lang_sense_clarification": "ridere di nascosto o maliziosamente"
                            },
                            {
                                "target_lang_word": "sghignazzare",
                                "target_lang_sense_clarification": "ridere con derisione o beffa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}