                ],
                "translations": [
                    {
                        "translation_id": "51dca959-0beb-404f-93f9-3edd205fe12c",
                        "source_entry_id": "95d17953-9973-3adb-a755-56fb93513ebb",
                        "source_sense_id": "d1b31602-93cd-362f-a7fc-aa8a4a07caa1",
                        "target_lang_word": "attempt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attempt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                                        "entry_id": "8431ca84-15e8-395f-a3ce-fcb1086502f2",
                                        "glosses": [
                                            "To try."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101cf86c-de48-4b21-9f96-10982492c62c",
                                                "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                                                "text": "to attempt an escape from prison"
                                            },
                                            {
                                                "example_id": "075cb10e-180e-4f7a-a947-95ad97023044",
                                                "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                                                "text": "I attempted to sing, but my throat was too hoarse."
                                            },
                                            {
                                                "example_id": "fc79fe56-b476-4544-8ce4-a6963dfc0dd1",
                                                "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                                                "text": "A group of 80 budding mountaineers attempted Kilimanjaro, but 30 of them didn’t make it to the top."
                                            },
                                            {
                                                "example_id": "c559b20d-3ea7-46a4-a620-87e9d7aa7191",
                                                "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                                                "text": "Something attempted, something done, / Has earned a night's repose."
                                            },
                                            {
                                                "example_id": "fcae01a3-e680-4ac3-bc0a-9e87d3571079",
                                                "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fcc7a58-432a-3f50-bce1-e910c82f36f1",
                                        "entry_id": "8431ca84-15e8-395f-a3ce-fcb1086502f2",
                                        "glosses": [
                                            "To try to move, by entreaty, by afflictions, or by temptations; to tempt."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e870f5b-33fb-4ba2-996c-a743b74248ba",
                                                "sense_id": "8fcc7a58-432a-3f50-bce1-e910c82f36f1",
                                                "text": "Yet since I see you fearful, that neither my coat, integrity, nor persuasion can with ease attempt you, I will go further than I meant, to pluck all fears out of you."
                                            },
                                            {
                                                "example_id": "e268944b-1248-4d43-b02a-448f29ab86e4",
                                                "sense_id": "8fcc7a58-432a-3f50-bce1-e910c82f36f1",
                                                "text": "It made the laughter of an afternoon / That Vivien should attempt the blameless king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b9b1e8-550f-3819-ab82-ec147d54c61d",
                                        "entry_id": "8431ca84-15e8-395f-a3ce-fcb1086502f2",
                                        "glosses": [
                                            "To try to win, subdue, or overcome."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b3331d2-f9c4-48fd-9b33-062fbbf38469",
                                                "sense_id": "82b9b1e8-550f-3819-ab82-ec147d54c61d",
                                                "text": "one who attempts the virtue of a woman"
                                            },
                                            {
                                                "example_id": "4f08bd84-d944-4ccf-a5b1-ccb682b4549f",
                                                "sense_id": "82b9b1e8-550f-3819-ab82-ec147d54c61d",
                                                "text": "Dear sir, of force I must attempt you further: / Take some remembrance of us, as a tribute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cac91d-9d6d-39c1-9a0c-82af3e111f36",
                                        "entry_id": "8431ca84-15e8-395f-a3ce-fcb1086502f2",
                                        "glosses": [
                                            "To attack; to make an effort or attack upon; to try to take by force."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e96ce7-26d3-4517-be2f-9b5c82bafbc5",
                                                "sense_id": "53cac91d-9d6d-39c1-9a0c-82af3e111f36",
                                                "text": "to attempt the enemy’s camp"
                                            },
                                            {
                                                "example_id": "7e037b11-4251-49bd-89ca-253d5452bc24",
                                                "sense_id": "53cac91d-9d6d-39c1-9a0c-82af3e111f36",
                                                "text": "without attempting his adversary’s life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c2db56-7d72-3e94-856e-377fcd32ce68",
                                        "entry_id": "8431ca84-15e8-395f-a3ce-fcb1086502f2",
                                        "glosses": [
                                            "To make a substantial but unsuccessful effort (to commit a crime)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584ea3fd-c334-4df5-af9c-b2953a8150a3",
                                                "sense_id": "20c2db56-7d72-3e94-856e-377fcd32ce68",
                                                "text": "Whoever takes a direct and immediate step towards the realisation of the offence as envisaged by them attempts to commit an offence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "attempt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                                        "entry_id": "f1d0b866-bc4e-3586-85b0-35073d57bbff",
                                        "glosses": [
                                            "The action of trying at something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183f8173-9d9c-458e-8ca9-3d6209ad33d2",
                                                "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                                                "text": "We made an attempt to cross the stream, but didn’t manage."
                                            },
                                            {
                                                "example_id": "5a7639a2-4885-4db9-9734-cb0011fc1625",
                                                "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                                                "text": "This poem is much better than the feeble attempt of mine."
                                            },
                                            {
                                                "example_id": "f4e8f983-cc66-4962-90d3-32f276c881a3",
                                                "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                                                "text": "It was worth the attempt."
                                            },
                                            {
                                                "example_id": "d937a0fe-f1fe-4374-acf1-09c845c8fbaf",
                                                "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                                                "text": "No matter how many failed attempts we made, we maintained a positive attitude and tried again and again until we succeeded."
                                            },
                                            {
                                                "example_id": "3a6417b9-0c35-4203-8b06-ce544c98eed4",
                                                "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e1ae18-4526-3ef6-8496-697df90fe631",
                                        "entry_id": "f1d0b866-bc4e-3586-85b0-35073d57bbff",
                                        "glosses": [
                                            "An assault or attack, especially an assassination attempt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b42941b-4c18-41e1-872c-bb1613375950",
                                                "sense_id": "06e1ae18-4526-3ef6-8496-697df90fe631",
                                                "text": "No man can charge us of any attempt against the realm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1caf9777-0a95-3300-9539-4da2760e2842",
                                        "entry_id": "f1d0b866-bc4e-3586-85b0-35073d57bbff",
                                        "glosses": [
                                            "A substantial but unsuccessful effort (to commit a crime)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252fad71-56d5-430d-9a66-cd4597313bb0",
                                                "sense_id": "1caf9777-0a95-3300-9539-4da2760e2842",
                                                "text": "Whoever voluntarily abandons the further commission of the offence or prevents its completion incurs no penalty for attempt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3774591b-9b4d-38d5-9eed-4b8abb86e74e",
                                        "entry_id": "f1d0b866-bc4e-3586-85b0-35073d57bbff",
                                        "glosses": [
                                            "An act of trying to commit suicide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "938137db-a75d-48d4-8c84-c144942f4f07",
                                                "sense_id": "3774591b-9b4d-38d5-9eed-4b8abb86e74e",
                                                "text": "Her attempt was not successful, and resulted in her being hospitalized."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba3ec7e-f86d-4569-98e9-2ed4f340d280",
                        "source_entry_id": "95d17953-9973-3adb-a755-56fb93513ebb",
                        "source_sense_id": "d1b31602-93cd-362f-a7fc-aa8a4a07caa1",
                        "target_lang_word": "effort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                        "entry_id": "438d5834-9e52-3b94-8f3d-194229621300",
                                        "glosses": [
                                            "The work involved in performing an activity; exertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9295cf93-be33-44f7-8cb6-33a84b8bb122",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "make an effort"
                                            },
                                            {
                                                "example_id": "0fa7929d-42e8-4bbd-bdbc-96366f0d9ca6",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "take a lot of effort"
                                            },
                                            {
                                                "example_id": "2d433dbb-befd-4ec9-8e63-89bc905a46b3",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "put in effort"
                                            },
                                            {
                                                "example_id": "68525f29-7c72-43d4-9a46-d2019b64b9f8",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "It took a lot of effort to find a decent-sized, fully-furnished apartment within walking distance of the office. He made a conscious effort to not appear affected by the stories in the paper."
                                            },
                                            {
                                                "example_id": "544721c6-c4cb-415d-9dcf-7f31982ddeca",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "The slightest effort made the patient cough. He would stand leaning on a stick and holding a hand to his side, and when the paroxysm had passed it left him shaking."
                                            },
                                            {
                                                "example_id": "5c175a7e-ae53-4647-a477-02284adadf13",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "The 30-year-old South Korean, who joined United in 2005, retired from international duty after last season's Asian Cup in an effort to prolong his club"
                                            },
                                            {
                                                "example_id": "0d1620a7-f951-4ed3-9698-be8e48ab3903",
                                                "sense_id": "5c13ae9e-b9b7-3614-9e8b-8b3c8239cc2b",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d1da751-601b-3aae-b425-133cdfa3cf42",
                                        "entry_id": "438d5834-9e52-3b94-8f3d-194229621300",
                                        "glosses": [
                                            "An endeavor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cca0ee3-34f0-4299-8070-ed2efeb3c430",
                                                "sense_id": "6d1da751-601b-3aae-b425-133cdfa3cf42",
                                                "text": "Although he didn't win any medals, Johnson's effort at the Olympics won over many fans."
                                            },
                                            {
                                                "example_id": "f98418e4-3a30-4aa2-91b0-a3c1efcc8f6c",
                                                "sense_id": "6d1da751-601b-3aae-b425-133cdfa3cf42",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255c11c3-3617-3dad-82ff-cf93c03c0710",
                                        "entry_id": "438d5834-9e52-3b94-8f3d-194229621300",
                                        "glosses": [
                                            "A force acting on a body in the direction of its motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4847a56e-5b65-4a3a-8820-87d6449f7ef5",
                                                "sense_id": "255c11c3-3617-3dad-82ff-cf93c03c0710",
                                                "text": "the two bodies between which the effort acts"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "effort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da3dab2b-10b1-3114-8719-6a6cb5a4075d",
                                        "entry_id": "18619063-aa90-3055-8d3e-82dcb89e4b68",
                                        "glosses": [
                                            "To make an effort."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a7858e7-4e10-353e-9a38-69e8e5bf1aef",
                                        "entry_id": "18619063-aa90-3055-8d3e-82dcb89e4b68",
                                        "glosses": [
                                            "To strengthen, fortify or stimulate"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b46e4b-bbd6-4ddc-9dbd-c704cbcd8be3",
                                                "sense_id": "1a7858e7-4e10-353e-9a38-69e8e5bf1aef",
                                                "text": "When old, he lived in London where, being High-minded and Poor, he was exposed to the contempt of disingenuous persons. Yet he efforted his Spirits with a Commemoration of the Days of Old."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2975c535-a722-42ff-a534-25693d5d08aa",
                        "source_entry_id": "95d17953-9973-3adb-a755-56fb93513ebb",
                        "source_sense_id": "d1b31602-93cd-362f-a7fc-aa8a4a07caa1",
                        "target_lang_word": "tentative",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tentative",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c2d20af-a9f0-37ea-9045-cc821d04b999",
                                        "entry_id": "0fc163a4-0a2b-3993-a8d0-0970994ded8b",
                                        "glosses": [
                                            "Action par laquelle on tente, on essaie de faire réussir quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f548006-57e9-414b-86a5-840960e6645d",
                                                "sense_id": "9c2d20af-a9f0-37ea-9045-cc821d04b999",
                                                "text": "L’Exposition de 1900 était une occasion toute indiquée pour reprendre les tentatives d’unification faites précédemment."
                                            },
                                            {
                                                "example_id": "e2a6f09d-6b8f-4b8c-af4e-26f5b56dd5ba",
                                                "sense_id": "9c2d20af-a9f0-37ea-9045-cc821d04b999",
                                                "text": "J’ai si souvent fait buisson creux, dans mes tentatives précédentes, que je n’ose plus me présenter au guichet de la gare. À quoi bon ?"
                                            },
                                            {
                                                "example_id": "ae884dd1-3f3a-4e36-bb6f-6f5de917c66b",
                                                "sense_id": "9c2d20af-a9f0-37ea-9045-cc821d04b999",
                                                "text": "Lorsque nous arrivâmes à destination, la mer trop houleuse nous interdisait toute nouvelle tentative de débarquement."
                                            },
                                            {
                                                "example_id": "5225b7ed-7aa8-4d21-8608-1ecc484ce3a0",
                                                "sense_id": "9c2d20af-a9f0-37ea-9045-cc821d04b999",
                                                "text": "Et j’en passe. Le bouquet, c’est l’énumération de mes récentes tentatives d’extorsion de fonds."
                                            },
                                            {
                                                "example_id": "131e7d5d-a7af-4971-a04a-7f468bae5fbe",
                                                "sense_id": "9c2d20af-a9f0-37ea-9045-cc821d04b999",
                                                "text": "Vingt ans durant, il a eu à faire face à l’une des plus fortes tentatives de scission que le christianisme ait connu depuis l’Arianisme et avant le Protestantisme : il a vu se dresser, devant lui, le Catharisme, ou mouvement des Albigeois, et l’hérésie vaudoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377b5309-8176-31e5-896e-5ee6e5947e19",
                                        "entry_id": "0fc163a4-0a2b-3993-a8d0-0970994ded8b",
                                        "glosses": [
                                            "Examen, thèse que soutenait celui qui voulait être reçu licencié en théologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461b5b8d-f397-48f5-bd9d-cf97365d0b9d",
                                                "sense_id": "377b5309-8176-31e5-896e-5ee6e5947e19",
                                                "text": "Il a soutenu sa tentative."
                                            }
                                        ]
                                    }
                                ]
                            },
