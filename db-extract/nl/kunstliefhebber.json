                            {
                                "example_id": "1fb72407-def2-404f-989f-ce3e98ffd255",
                                "sense_id": "0e4b864d-ba26-3852-9cb2-b46449984731",
                                "text": "De miljardair en filantroop stond ook bekend als kunstliefhebber. In Grand Rapids liet hij botanische tuinen en een beeldenpark aanleggen en bouwde hij een medische kliniek en theaters."
                            },
                            {
                                "example_id": "cec5e579-fca1-4887-b1ea-2030e5ebf535",
                                "sense_id": "0e4b864d-ba26-3852-9cb2-b46449984731",
                                "text": "Volgens de aanklacht tegen de drie verdachten die vorige week werden gearresteerd, zou een Roemeense zakenman en kunstliefhebber interesse hebben getoond in twee van de schilderijen, een Matisse en een Gauguin."
                            }
                        ]
