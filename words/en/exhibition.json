{
    "word_family": [
        "exhibit",
        "exhibitor",
        "exhibitionism",
        "exhibitionist",
        "exhibitory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ff80294-866f-3a3e-8e7f-67e4c3330cbf",
                    "sense_definition": "A large-scale public showing of objects, products, or works of art.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "public_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local gallery is hosting a new art <w>exhibition</w> featuring local painters.",
                            "target_lang_translations": {
                                "ru": "В местной галерее проходит новая художественная <w>выставка</w> работ местных художников."
                            }
                        },
                        {
                            "text": "We spent the entire afternoon at the international boat <w>exhibition</w> near the harbor.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день на международной <w>выставке</w> катеров рядом с гаванью."
                            }
                        }
                    ],
                    "synonyms": [
                        "show",
                        "display",
                        "exposition",
                        "expo"
                    ],
                    "common_phrases": [
                        "art exhibition",
                        "museum exhibition",
                        "host an exhibition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупномасштабный публичный показ предметов, товаров или произведений искусства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставка",
                                "target_lang_sense_clarification": "мероприятие или место показа"
                            },
                            {
                                "target_lang_word": "экспозиция",
                                "target_lang_sense_clarification": "подборка предметов для показа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fe66706-f53d-3b3f-b940-dc43081680d5",
                    "sense_definition": "The act of showing or demonstrating something, or the thing that is shown.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "public_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot provided a thrilling <w>exhibition</w> of flying skills during the air show.",
                            "target_lang_translations": {
                                "ru": "Пилот продемонстрировал захватывающий <w>показ</w> летного мастерства во время авиашоу."
                            }
                        },
                        {
                            "text": "The museum's latest <w>exhibition</w> of ancient coins attracted many history buffs.",
                            "target_lang_translations": {
                                "ru": "Последняя <w>экспозиция</w> древних монет в музее привлекла многих любителей истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "demonstration",
                        "presentation"
                    ],
                    "common_phrases": [
                        "public exhibition",
                        "exhibition of skill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт показа или демонстрации чего-либо, либо сам предмет показа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показ",
                                "target_lang_sense_clarification": "демонстрация чего-либо"
                            },
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "публичное проявление навыков или качеств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d17acc61-187a-3b0f-aa50-2002533b1506",
                    "sense_definition": "A sports game or match that does not count toward competition standings or rankings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basketball teams played an <w>exhibition</w> game to raise money for charity.",
                            "target_lang_translations": {
                                "ru": "Баскетбольные команды провели <w>товарищеский</w> матч, чтобы собрать деньги на благотворительность."
                            }
                        },
                        {
                            "text": "Since it was just an <w>exhibition</w> match, the coach let the younger players play.",
                            "target_lang_translations": {
                                "ru": "Так как это был всего лишь <w>показательный</w> матч, тренер дал возможность сыграть молодым игрокам."
                            }
                        }
                    ],
                    "synonyms": [
                        "friendly",
                        "warm-up"
                    ],
                    "antonyms": [
                        "competition",
                        "tournament"
                    ],
                    "common_phrases": [
                        "exhibition game",
                        "exhibition match"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивная игра или матч, который не учитывается в турнирной таблице или рейтинге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищеский матч",
                                "target_lang_sense_clarification": "вне рамок официального турнира"
                            },
                            {
                                "target_lang_word": "показательное выступление",
                                "target_lang_sense_clarification": "демонстрация мастерства без соревновательной цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90c72d82-235b-3db2-8fde-565c3b913f95",
                    "sense_definition": "A clear demonstration or outward expression of personal feelings or qualities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>exhibition</w> of anger surprised everyone in the quiet meeting room.",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>проявление</w> гнева удивило всех в тихой переговорной."
                            }
                        },
                        {
                            "text": "She was embarrassed by her father's public <w>exhibition</w> of emotion at the airport.",
                            "target_lang_translations": {
                                "ru": "Она была смущена тем, как ее отец публично <w>выражал</w> свои эмоции в аэропорту."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifestation",
                        "expression",
                        "revelation"
                    ],
                    "antonyms": [
                        "concealment",
                        "suppression"
                    ],
                    "common_phrases": [
                        "exhibition of emotion",
                        "outward exhibition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Явная демонстрация или внешнее выражение личных чувств или качеств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "выражение чувств или качеств"
                            },
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "внезапное проявление эмоций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "958fbeb4-09e7-3ded-a236-dd2376fbdbdd",
                    "sense_definition": "A public display of behavior that is considered inappropriate, shameful, or disgusting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drunken man made a shameful <w>exhibition</w> of himself in front of the guests.",
                            "target_lang_translations": {
                                "ru": "Пьяный мужчина устроил постыдное <w>зрелище</w> перед гостями."
                            }
                        },
                        {
                            "text": "I have never seen such a disgusting <w>exhibition</w> of greed in my entire life.",
                            "target_lang_translations": {
                                "ru": "Я никогда в жизни не видел такого отвратительного <w>проявления</w> жадности."
                            }
                        }
                    ],
                    "synonyms": [
                        "spectacle"
                    ],
                    "common_phrases": [
                        "shameful exhibition",
                        "disgusting exhibition",
                        "make an exhibition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное поведение, которое считается неуместным, постыдным или отвратительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "неприятная или постыдная сцена"
                            },
                            {
                                "target_lang_word": "спектакль",
                                "target_lang_sense_clarification": "неуместное поведение на людях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c68b6193-5b73-3588-af29-c271b9da9a8b",
                    "sense_definition": "A financial award or prize given to a student by a school or university based on academic merit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic_award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was proud to have won an <w>exhibition</w> to study history at Oxford University.",
                            "target_lang_translations": {
                                "ru": "Он гордился тем, что выиграл <w>стипендию</w> на изучение истории в Оксфордском университете."
                            }
                        },
                        {
                            "text": "The university offers a prestigious <w>exhibition</w> to the top student in the science department.",
                            "target_lang_translations": {
                                "ru": "Университет предлагает престижный <w>грант</w> лучшему студенту научного факультета."
                            }
                        }
                    ],
                    "synonyms": [
                        "scholarship",
                        "bursary",
                        "grant"
                    ],
                    "common_phrases": [
                        "win an exhibition",
                        "academic exhibition"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежная награда или приз, выдаваемый студенту школой или университетом за академические заслуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стипендия",
                                "target_lang_sense_clarification": "грант за академические успехи"
                            },
                            {
                                "target_lang_word": "грант",
                                "target_lang_sense_clarification": "финансовая поддержка обучения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aad4d1e4-e89b-3700-af78-d51d7a8940b7",
                    "sense_definition": "To engage in the act of exposing one's body or genitals in public.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man was arrested after he began <w>exhibitioning</w> in the middle of the park.",
                            "target_lang_translations": {
                                "ru": "Мужчина был арестован после того, как начал <w>обнажаться</w> посреди парка."
                            }
                        },
                        {
                            "text": "He faced legal consequences for <w>exhibitioning</w> himself to passersby on the street.",
                            "target_lang_translations": {
                                "ru": "Он понес юридическую ответственность за <w>эксгибиционизм</w> перед прохожими на улице."
                            }
                        }
                    ],
                    "synonyms": [
                        "exposing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное обнажение тела или половых органов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эксгибиционизм",
                                "target_lang_sense_clarification": "публичное обнажение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}