            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b1e816a-3554-3d6a-99cb-13f0ad48268a",
                    "sense_definition": "obudzić się później niż się zamierzało, nie obudzić się na czas",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spóźnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znowu <w>zaspałem</w> do szkoły.",
                            "target_lang_translations": {
                                "en": "I <w>overslept</w> for school again."
                            }
                        },
                        {
                            "text": "Przez budzik <w>zaspałem</w> na ważne spotkanie.",
                            "target_lang_translations": {
                                "en": "Because of the alarm clock, I <w>overslept</w> for an important meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "przespać"
                    ],
                    "common_phrases": [
                        "zaspać do pracy",
                        "zaspać do szkoły"
                    ],
                    "target_lang_definitions": {
                        "en": "To wake up later than intended or fail to wake up on time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oversleep",
                                "target_lang_sense_clarification": "To sleep longer than intended, often resulting in being late."
                            },
                            {
                                "target_lang_word": "sleep in",
                                "target_lang_sense_clarification": "To sleep past one's planned hour, often intentionally or due to relaxation."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12822f5c-e312-305d-a238-9e7419463bf1",
                    "sense_definition": "przegapić coś; nie zająć się czymś na czas, w odpowiednim momencie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spóźnienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu ludzi <w>zaspało</w> moment na inwestycję w tę firmę.",
                            "target_lang_translations": {
                                "en": "Many people <w>missed out on</w> the moment to invest in this company."
                            }
                        },
                        {
                            "text": "Nie <w>zaspałem</w> okazji, by zmienić pracę na lepszą.",
                            "target_lang_translations": {
                                "en": "I didn't <w>miss out on</w> the opportunity to change to a better job."
                            }
                        }
                    ],
                    "synonyms": [
                        "przegapić",
                        "przeoczyć"
                    ],
                    "common_phrases": [
                        "zaspać okazję"
                    ],
                    "target_lang_definitions": {
                        "en": "To miss an opportunity or fail to act at the right moment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miss out on",
                                "target_lang_sense_clarification": "To fail to take advantage of an opportunity."
                            },
                            {
                                "target_lang_word": "be slow to act",
                                "target_lang_sense_clarification": "To fail to respond or take action in a timely manner."
                            }
                        ]
                    }
                }
            ]
        }
    ]
