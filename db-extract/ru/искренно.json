                        "examples": [
                            {
                                "example_id": "f217b59c-f15e-4f28-b8cf-a0e6dfd21ceb",
                                "sense_id": "2f6002d8-4f7d-34a9-8205-bab2f48e45f9",
                                "text": "1829 (written), 1830 (published), Alexander Pushkin, Я вас любил… (\"I Loved You\"); 2020 translation by Chesnokova and van Peer\nЯ вас любил безмолвно, безнадежно,\nТо робостью, то ревностью томим;\nЯ вас любил так искренно, так нежно,\nКак дай вам Бог любимой быть другим.\nJa vas ljubil bezmolvno, beznadežno,\nTo robostʹju, to revnostʹju tomim;\nJa vas ljubil tak iskrenno, tak nežno,\nKak daj vam Bog ljubimoj bytʹ drugim.\nI loved you silently, hopelessly,\nNow by timidity, now by jealousy tormented;\nI loved you so sincerely, so tenderly,\nAs may God grant you to be [so] loved by another."
                            }
                        ]
                    }
