                "senses": [
                    {
                        "sense_id": "79b4c27b-761e-387e-b32b-04cf5fa92179",
                        "entry_id": "4f0c1c5c-143c-30a0-9878-f5f503be84f1",
                        "glosses": [
                            "Gruppe von Personen, die gemeinsam eine Hochzeit feiern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfaa245f-46e5-4c14-a7e0-f34a48f5d9ad",
                                "sense_id": "79b4c27b-761e-387e-b32b-04cf5fa92179",
                                "text": "„Rainer, Claras Vater, hatte ich in der Hochzeitsgesellschaft den ganzen Tag schon vergeblich gesucht.“"
                            },
                            {
                                "example_id": "c86800cd-0570-415c-931e-3c3f216070d6",
                                "sense_id": "79b4c27b-761e-387e-b32b-04cf5fa92179",
                                "text": "„Das Hauptspiel stellt dann eine Hochzeitsgesellschaft in einer Wohnung vor, in der alles andere als die gutbürgerliche Hochzeit eines eben getrauten Paares gefeiert wird.“"
                            },
                            {
                                "example_id": "371f9f02-095e-4e0f-a91f-060c8cc3c79e",
                                "sense_id": "79b4c27b-761e-387e-b32b-04cf5fa92179",
                                "text": "„Der Anblick dieser Hochzeitsgesellschaft brachte Bouvard und Pécuchet dazu, über die Frauen zu sprechen, die sie für frivol, zänkisch und eigensinnig erklärten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
