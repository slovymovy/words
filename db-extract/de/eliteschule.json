                "senses": [
                    {
                        "sense_id": "3a7c6385-8542-307d-817e-887c36a8d821",
                        "entry_id": "71aab3f3-2168-3f38-8f32-c107da297802",
                        "glosses": [
                            "Bildungsanstalt mit besonderen (intellektuellen oder gesellschaftlichen) Ansprüchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca5c134-307f-4317-9d71-c13ad593c174",
                                "sense_id": "3a7c6385-8542-307d-817e-887c36a8d821",
                                "text": "„Die 1926 eröffnete Parteischule war als Internat eingerichtet und als Eliteschule angelegt; […]“"
                            },
                            {
                                "example_id": "54542ba2-2875-4826-a545-11358dd1ac7a",
                                "sense_id": "3a7c6385-8542-307d-817e-887c36a8d821",
                                "text": "„Eine stadtbekannte Eliteschule sei sowieso nicht infrage gekommen.“"
                            },
                            {
                                "example_id": "73ef72df-b11a-44d1-a714-7c376d5b203e",
                                "sense_id": "3a7c6385-8542-307d-817e-887c36a8d821",
                                "text": "„Nur wenige haben Zugang zu Privat- und Eliteschulen, die qualitativ deutlich hervorstechen und nebenbei vergleichsweise liberale Werte vermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
