                    {
                        "sense_id": "6aa7f609-c0f9-3897-9f12-baa81ae3ee48",
                        "entry_id": "ef23abb1-e480-3158-9c42-23c77b8f9d3a",
                        "glosses": [
                            "op zodanige wijze mollig en voorzien van rondingen dat het wellustige gevoelens opwekt"
                        ],
