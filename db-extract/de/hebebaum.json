                "senses": [
                    {
                        "sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                        "entry_id": "733ff192-db5d-349b-a9f4-78a85e4501d6",
                        "glosses": [
                            "Hebung oder sonstiger Bewegung von Lasten dienende Stange aus hartem Holz oder Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a38e5729-64b0-4fe4-9585-efeb84c25644",
                                "sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                                "text": "„Der Hebebaum dient zum Heben und Bewegen von Lasten bei geringer Hubhöhe.“"
                            },
                            {
                                "example_id": "58505de2-4fbc-4de2-aa96-13fe0548acd9",
                                "sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                                "text": "Der Hebebaum in seiner einfachsten Ausführung ist ein Ast, den man unter einen liegenden Stein legt und diesen per Körperkraft und Hebelwirkung von der Stelle bewegt."
                            },
                            {
                                "example_id": "3fceb89c-ce9a-4fea-b0cb-9c9519b717d4",
                                "sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                                "text": "„Dieser Hebebaum ist eine etwa 8 oder 1o Ellen lange und am vordern Ende A 7 bis 10 Zoll starke runde Stange.“"
                            },
                            {
                                "example_id": "6d9868cd-7af9-4005-84a6-d27d3437a8ca",
                                "sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                                "text": "„Wie Abb. 28 vermuten läßt, ruht jeder Hebebaum mittels einer kurzen Achse auf einem Pfeiler, der zu diesem Zwecke wohl gabelförmig ausgeschnitten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24dba72c-56cf-48d4-a618-6733c64ba5f7",
                        "source_entry_id": "733ff192-db5d-349b-a9f4-78a85e4501d6",
                        "source_sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                        "source_sense_description": "Hebung oder sonstiger Bewegung von Lasten dienende Stange aus hartem Holz oder Eisen",
                        "target_lang_word": "lever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1191bf-8054-309e-974c-bfce98a6866f",
                                        "entry_id": "3638a07e-fc64-3ef6-a688-59b65e6a772b",
                                        "glosses": [
                                            "A rigid piece which is capable of turning about one point, or axis (fulcrum), and in which are two or more other points where forces are applied; — used for transmitting and modifying force and motion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8caa381c-0661-3725-8bdf-3505cd70905e",
                                        "entry_id": "3638a07e-fc64-3ef6-a688-59b65e6a772b",
                                        "glosses": [
                                            "A rigid piece which is capable of turning about one point, or axis (fulcrum), and in which are two or more other points where forces are applied; — used for transmitting and modifying force and motion.",
                                            "Specifically, a bar of metal, wood or other rigid substance, used to exert a pressure, or sustain a weight, at one point of its length, by receiving a force or power at a second, and turning at a third on a fixed point called a fulcrum. It is usually named as the first of the six mechanical powers, and is of three kinds, according as either the fulcrum F, the weight W, or the power P, respectively, is situated between the other two, as in the figures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b213a82-0b42-477e-a6a9-2912a3d831c0",
                                                "sense_id": "8caa381c-0661-3725-8bdf-3505cd70905e",
                                                "text": "Retractable steps and handrails are provided on each side of the cars. The steps, which are under the control of the guard, are operated by hand levers in the entrance vestibule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2ce723c-67e5-3c66-bd5c-a94cdfdd1c00",
                                        "entry_id": "3638a07e-fc64-3ef6-a688-59b65e6a772b",
                                        "glosses": [
                                            "A small such piece to trigger or control a mechanical device (like a switch or a button)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4337f5fb-c38c-3c44-90ed-ac65de2ebacc",
                                        "entry_id": "3638a07e-fc64-3ef6-a688-59b65e6a772b",
                                        "glosses": [
                                            "A bar, as a capstan bar, applied to a rotatory piece to turn it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48ac7bd-2d2f-43d1-ab47-3dcb61a159bf",
                                                "sense_id": "4337f5fb-c38c-3c44-90ed-ac65de2ebacc",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f25b9788-b518-3eea-908e-32159fd4c41b",
                                        "entry_id": "3638a07e-fc64-3ef6-a688-59b65e6a772b",
                                        "glosses": [
                                            "An arm on a rock shaft, to give motion to the shaft or to obtain motion from it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de5cf01f-bde6-37d9-9fd2-9e8ca502562e",
                                        "entry_id": "3638a07e-fc64-3ef6-a688-59b65e6a772b",
                                        "glosses": [
                                            "A crowbar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ecf7e8d-077a-43fa-ba5c-a7b6a7aec60a",
                                                "sense_id": "de5cf01f-bde6-37d9-9fd2-9e8ca502562e",
                                                "text": "My lord, I brained him with a lever my neighbour lent me, and he stood by and cried, ‘Strike home, old boy!’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "890ce97d-24ec-34c8-bc1f-cb8f54301c9a",
                                        "entry_id": "fa83f755-0ae8-3343-8632-ba42907958d4",
                                        "glosses": [
                                            "To move with a lever."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c4d6f7e-6ec8-45de-aa2f-d9f1597d72d1",
                                                "sense_id": "890ce97d-24ec-34c8-bc1f-cb8f54301c9a",
                                                "text": "With great effort and a big crowbar I managed to lever the beam off the floor."
                                            },
                                            {
                                                "example_id": "d3e27753-0c09-4472-a41a-8a80652db805",
                                                "sense_id": "890ce97d-24ec-34c8-bc1f-cb8f54301c9a",
                                                "text": "Someone found a pick and levered a burst plank out of the floor, and in a few minutes we had got a fire alight and our drenched clothes were steaming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b621c96-6ff4-35bd-a248-3e226b24018b",
                                        "entry_id": "fa83f755-0ae8-3343-8632-ba42907958d4",
                                        "glosses": [
                                            "To use, operate or move (something) like a lever (physically)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07f4e695-74be-4300-bbc2-7566bfedf040",
                                                "sense_id": "4b621c96-6ff4-35bd-a248-3e226b24018b",
                                                "text": "Sullen now, with stultified spleen, Mrs Dibble grappled her crutches and levered herself upright after an ungainly struggle."
                                            },
                                            {
                                                "example_id": "6f58653d-4c80-4495-bd8d-c03c51ba6d80",
                                                "sense_id": "4b621c96-6ff4-35bd-a248-3e226b24018b",
                                                "text": "Suddenly he had levered himself up from the sofa, rocking the lame man violently, and was walking towards the receptionist."
                                            },
                                            {
                                                "example_id": "7517e913-2f91-445d-9ca5-5a900bfe5f48",
                                                "sense_id": "4b621c96-6ff4-35bd-a248-3e226b24018b",
                                                "text": "The guard at the door coughed up blood, and died instantly. Fina was carrying an empty rifle with a sharpened bayonet, and she'd thrust it straight up through his neck, severing the spinal cord. She levered him off the front stoop and into the bushes, then stood up on the tips of her toes to peer through the window in the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfdfa5ef-897f-33f1-974e-bb1af8ca845d",
                                        "entry_id": "fa83f755-0ae8-3343-8632-ba42907958d4",
                                        "glosses": [
                                            "To use (something) like a lever (in an abstract sense)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f3dd97-6fc9-47a5-8497-a039becbc364",
                                                "sense_id": "bfdfa5ef-897f-33f1-974e-bb1af8ca845d",
                                                "text": "He was a man who levered his way from small-time communist hack to political power by tapping into the most potent vein of historical juice in the Balkans: nationalism."
                                            },
                                            {
                                                "example_id": "0ef583dd-ec86-46f2-8ffc-da49745844da",
                                                "sense_id": "bfdfa5ef-897f-33f1-974e-bb1af8ca845d",
                                                "text": "Credited with pioneering the detective novel, Collins has attracted many biographers over the years, drawn to his extraordinary life and work in the hope of levering open a new understanding of the Victorian psyche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb0e781-c02f-3cea-a0b8-98293723da27",
                                        "entry_id": "fa83f755-0ae8-3343-8632-ba42907958d4",
                                        "glosses": [
                                            "To increase the share of debt in the capitalization of a business."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06478ac4-7aba-4001-810a-686355a2dc90",
                                                "sense_id": "1cb0e781-c02f-3cea-a0b8-98293723da27",
                                                "text": "\"The equity holders want you to 'lever up,' use as much debt as you can,\" said David Stanley, chairman of Kansas City-based Payless Cashways,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c77ab5-241d-3f8f-8275-4bfe8aeb5e11",
                                        "entry_id": "c804a4cd-1a53-3c47-ba38-720b54a4c16c",
                                        "glosses": [
                                            "Rather."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a848d3b-3e7c-4f4a-b6df-4d0a9071fd63",
                                                "sense_id": "a8c77ab5-241d-3f8f-8275-4bfe8aeb5e11",
                                                "text": "Now therfore take my life from me / for I had leuer dye then liue."
                                            },
                                            {
                                                "example_id": "3ba20010-cf3d-4f8f-a840-042f6b30708f",
                                                "sense_id": "a8c77ab5-241d-3f8f-8275-4bfe8aeb5e11",
                                                "text": "The wolde ſome mayſter perhappes clowt ye / But as for me ye nede nat doute ye / For I had leuer be without ye / Then haue ſuche beſyneſſe aboute ye."
                                            },
                                            {
                                                "example_id": "5d8fb03e-b99f-49c8-a454-667d87e1009c",
                                                "sense_id": "a8c77ab5-241d-3f8f-8275-4bfe8aeb5e11",
                                                "text": "For although they were worthy of any puniſhment: yit had I leuer they might haue flooriſhed in welfare and ſafetie: […]"
                                            },
                                            {
                                                "example_id": "d87407ef-cdeb-4f61-90e3-3568105c6fbc",
                                                "sense_id": "a8c77ab5-241d-3f8f-8275-4bfe8aeb5e11",
                                                "text": "For leuer had I die, then ſee his deadly face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b1433a8-6ac0-3886-a195-467b08d62ed2",
                                        "entry_id": "f9e9cdb0-c970-378d-a7cc-25accb720380",
                                        "glosses": [
                                            "A levee."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edecbf29-72f6-4532-aeab-d2c9b57310b7",
                                                "sense_id": "7b1433a8-6ac0-3886-a195-467b08d62ed2",
                                                "text": "We do not appear at Phœbus's Levér."
                                            },
                                            {
                                                "example_id": "e4cd7321-94cb-4030-ae76-a17cd7f61262",
                                                "sense_id": "7b1433a8-6ac0-3886-a195-467b08d62ed2",
                                                "text": "Louis XIV’s day began with a lever at 9 and ended (officially) at around midnight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "babe639d-e725-4447-aafa-eb7152e4073b",
                        "source_entry_id": "733ff192-db5d-349b-a9f4-78a85e4501d6",
                        "source_sense_id": "0e068607-ebd9-3f9b-b1fa-c8988118cc4c",
                        "source_sense_description": "Hebung oder sonstiger Bewegung von Lasten dienende Stange aus hartem Holz oder Eisen",
                        "target_lang_word": "levier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30fdd5b1-5bb6-39e0-9510-349edd1d608b",
                                        "entry_id": "843c06af-bd32-3b85-a5e1-f2c5d9cf19d7",
                                        "glosses": [
                                            "Barre rigide que l’on fixe à un point d’appui servant à faciliter un mouvement pour déplacer, soutenir ou soulever d’autres corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4dc415e-38a0-44ad-b9d7-58e1acaf1ce5",
                                                "sense_id": "30fdd5b1-5bb6-39e0-9510-349edd1d608b",
                                                "text": "La nappe formée passe alors entre deux cylindres cannelés 2 et 3, soumis à une forte pression au moyen d'un système de leviers avec contrepoids 5."
                                            },
                                            {
                                                "example_id": "3cb61e73-60b0-450f-97d4-68baf9c2fe63",
                                                "sense_id": "30fdd5b1-5bb6-39e0-9510-349edd1d608b",
                                                "text": "On pouvait le surprendre intrépidement planté sur ses jambes, le nez en l’air, assistant à la chute d’une pierre qu’un maçon ébranle avec un levier en haut d’une muraille, et sans quitter la place que la pierre ne tombât ; et, quand la pierre était tombée, il s’en allait heureux comme un académicien le serait de la chute d’un drame romantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "280d34a2-212b-3f39-9c38-185f8c33544c",
                                        "entry_id": "843c06af-bd32-3b85-a5e1-f2c5d9cf19d7",
                                        "glosses": [
                                            "Tout instrument qui a de l’analogie avec le levier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219d3708-3822-49d8-9615-fbc580b6bf76",
                                                "sense_id": "280d34a2-212b-3f39-9c38-185f8c33544c",
                                                "text": "Le levier des accoucheurs."
                                            },
                                            {
                                                "example_id": "f8f3423e-ca07-45e9-b43a-155457d961d6",
                                                "sense_id": "280d34a2-212b-3f39-9c38-185f8c33544c",
                                                "text": "Le levier du trépan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b41900f-09dc-314d-8afc-41b150f02581",
                                        "entry_id": "843c06af-bd32-3b85-a5e1-f2c5d9cf19d7",
                                        "glosses": [
                                            "Commande de machine en forme de barre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cdf23dc-fdcd-48fd-8a17-519d93ef88ef",
                                                "sense_id": "0b41900f-09dc-314d-8afc-41b150f02581",
                                                "text": "Un petit levier, qui jusqu’ici s’obstinait à ne pas fonctionner, était devenu mobile. Il le poussa doucement vers la droite : l’aile gauche modifia mystérieusement sa bordure extrême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2445fceb-c271-3fd7-9cb6-690d6bc5eee7",
                                        "entry_id": "843c06af-bd32-3b85-a5e1-f2c5d9cf19d7",
                                        "glosses": [
                                            "Force morale, ou moyen d’action entraînant un changement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0b9d5e7-36e9-49d1-9648-6de51ca9ef83",
                                                "sense_id": "2445fceb-c271-3fd7-9cb6-690d6bc5eee7",
                                                "text": "\"En n’agissant qu’imparfaitement sur les différents leviers disponibles, l’État ne s’est pas donné les moyens d’infléchir les comportements à risque\", dénonce la Cour qui dresse une longue liste des échecs de la politique de prévention de l’alcoolisme."
                                            },
                                            {
                                                "example_id": "929daccc-89fd-4489-8e14-9c5df786e512",
                                                "sense_id": "2445fceb-c271-3fd7-9cb6-690d6bc5eee7",
                                                "text": "Parmi les priorités du budget, en progression d’un milliard d’euros, figure la lutte contre le changement climatique dont l’un des leviers est la contribution climat énergie (CCE)."
                                            },
                                            {
                                                "example_id": "53ee6c66-6352-4e98-a231-e4350088e524",
                                                "sense_id": "2445fceb-c271-3fd7-9cb6-690d6bc5eee7",
                                                "text": "Les marchés publics se doivent d’agir comme un véritable levier économique en intégrant des critères d’innovation, de développement durable, de performance et de retombées régionales dans le processus décisionnel."
                                            },
                                            {
                                                "example_id": "91760e5d-ec88-4074-acf7-5903fd1468b5",
                                                "sense_id": "2445fceb-c271-3fd7-9cb6-690d6bc5eee7",
                                                "text": "L’intérêt est le grand levier de l’activité humaine."
                                            }
                                        ]
                                    }
                                ]
                            }
