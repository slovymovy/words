                                                "sense_id": "a8d497e2-4b10-3321-8572-af5cdef5b171",
                                                "text": "Mit dem ersten Korb wurden die Bergleute befördert."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a55190c5-ef21-3f5f-b1fe-f433a1df6936",
