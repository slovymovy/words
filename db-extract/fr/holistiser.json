                        "glosses": [
                            "Donner un caractère holistique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ea3e65-7539-4bc3-828e-7183c432723b",
                                "sense_id": "53672df6-9afb-3a14-b728-1fd7e4e5521f",
                                "text": "Vous avez raison de globaliser (holistiser) et de dénuer d'intérêt tout terme technico-chimique concernant les organismes vivants."
                            },
                            {
                                "example_id": "630265f8-5d69-41e5-8ef7-7c069859a2c7",
                                "sense_id": "53672df6-9afb-3a14-b728-1fd7e4e5521f",
                                "text": "Allier la tête et les tripes, le coeur et la raison, nous holistiser."
                            }
                        ]
                    }
