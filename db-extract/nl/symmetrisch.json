                                                "example_id": "f42e3644-ec71-4af3-9eef-6baed17594e7",
                                                "sense_id": "a071a395-bcc4-3283-bfb3-dd317c87d146",
                                                "text": "perfectly symmetrical"
                                            },
                                            {
                                                "example_id": "0d49994c-d91b-4b77-89a2-6cc546bf959c",
                                                "sense_id": "a071a395-bcc4-3283-bfb3-dd317c87d146",
                                                "text": "The building had a perfectly symmetrical façade."
                                            },
                                            {
                                                "example_id": "4a78d099-f61b-412a-85fd-6ff457e527be",
                                                "sense_id": "a071a395-bcc4-3283-bfb3-dd317c87d146",
