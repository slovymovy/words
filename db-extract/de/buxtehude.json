                                        "sense_id": "e0fb4bce-65d1-35f8-bc81-810b20f3678e",
                                        "entry_id": "bba6fc01-7930-35ff-8670-9195c64ab863",
                                        "glosses": [
                                            "Lieu imaginaire censé se trouver très loin."
