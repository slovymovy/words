        "fr-extract.jsonl": [
            {
                "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                "word": "fantasmagorie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "238060ec-6989-4074-b751-4a2598a0a419",
                        "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "tags": [
                            "plural"
                        ],
                        "form": "fantasmagories"
                    },
                    {
                        "form_id": "8401476e-4090-40c0-944a-ecc07a4ac834",
                        "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "tags": [
                            "Plus rare"
                        ],
                        "form": "phantasmagorie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cf64b83-be77-3098-b2a6-822db7f734f3",
                        "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "glosses": [
                            "Sorte de spectacle qui consiste à faire apparaître, dans un lieu obscur, des images qui semblent être des fantômes."
                        ],
                        "tags": [
                            "Prestidigitation"
                        ],
                        "examples": [
                            {
                                "example_id": "b73db236-1715-4912-8fd8-d9f262051b15",
                                "sense_id": "8cf64b83-be77-3098-b2a6-822db7f734f3",
                                "text": "Je suis, dit-il, le fils du fameux Comus, physicien du roi et de la reine […] un savant distingué de l'école de Volta, de Galvani et de Mesmer. Le premier, en France il s'occupa de fantasmagorie et d'électricité, donnant des séances de mathématiques et de physique à la cour."
                            },
                            {
                                "example_id": "8717cd61-7d62-40e7-ac2b-c9cffe12d2f9",
                                "sense_id": "8cf64b83-be77-3098-b2a6-822db7f734f3",
                                "text": "C’était une de ces fantasmagories du pays des fées, une de ces visions racontées par les voyageurs qui reviennent de très loin et que nous écoutons sans les croire."
                            },
                            {
                                "example_id": "271c12ad-9554-465e-80c2-e6b33117b480",
                                "sense_id": "8cf64b83-be77-3098-b2a6-822db7f734f3",
                                "text": "Ces petits esprits de la terre vous ont assailli, abusé par toutes sortes de fantasmagories, séduit par mille mensonges, et finalement poussé à fuir ma maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "8378c5e4-286e-387a-a6f1-e9c2db0ea4cc",
                        "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "740fcff6-d4e3-4a06-881e-3aaa903661b6",
                                "sense_id": "8378c5e4-286e-387a-a6f1-e9c2db0ea4cc",
                                "text": "Au cours de ma vie, j’aurais donc été moins impressionné sans doute par la fantasmagorie changeante du monde, si je n’avais commencé l’étape dans un milieu presque incolore, dans le coin le plus tranquille de la plus ordinaire des petites villes : recevant une éducation austèrement religieuse ; bornant mes plus grands voyages à ces bois de la Limoise, qui me semblaient profonds comme les forêts primitives, ou bien à ces plages de l’« île », qui me mettaient un peu d’immensité dans les yeux lors de mes visites à mes vieilles tantes de Saint-Pierre-d’Oleron."
                            },
                            {
                                "example_id": "d18dbf1e-aa46-4cf8-b037-e10d1d8a06f9",
                                "sense_id": "8378c5e4-286e-387a-a6f1-e9c2db0ea4cc",
                                "text": "De ces magazines et de ces livres j’ai tiré ma fantasmagorie la plus intime : l’optimisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf003ad2-ad6b-3101-8057-e16406b9e939",
                        "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "glosses": [
                            "Abus des effets produits par des moyens surnaturels ou extraordinaires."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "915eec4c-eef8-4554-be3c-1c1cdf862237",
                                "sense_id": "cf003ad2-ad6b-3101-8057-e16406b9e939",
                                "text": "C'est une féerie, une fantasmagorie de couleurs à donner la jaunisse à la Loïe Fuller, à faire sembler ternes les célèbres fontaines lumineuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "cab5a1c4-8268-36ea-9b69-aacd7722ce03",
                        "entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "glosses": [
                            "Artifices, des allégations spécieuses par lesquelles on essaie de faire illusion dans un récit, dans une affaire, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "39aee01a-cede-4aa7-b74c-9ee5f32b0eff",
                                "sense_id": "cab5a1c4-8268-36ea-9b69-aacd7722ce03",
                                "text": "Cette comptabilité n’est pas sincère, c’est une fantasmagorie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7763fe7-d960-4b42-a8ba-ce884aaf666c",
                        "source_entry_id": "5b2f516f-5cd4-37c0-b178-ae544d4caca1",
                        "source_sense_description": "spectacle magique",
                        "target_lang_word": "Phantasmagorie",
