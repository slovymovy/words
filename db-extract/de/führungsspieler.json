                                "example_id": "101569e0-e185-4d92-aa51-3f9ec05cda7c",
                                "sense_id": "2dd776c2-578c-3840-9a2a-882a23acfa81",
                                "text": "„Die vermeintlichen Führungsspieler zeigten nichts, was auch nur annähernd nach Führung aussah.“"
                            },
