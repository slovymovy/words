                                "target_senses": [
                                    {
                                        "sense_id": "0faf5b8a-f657-3cc0-a70b-0ec778551f6c",
                                        "entry_id": "0075fa3b-58be-3678-8d06-06d46cc8b03b",
                                        "glosses": [
                                            "een vrouwelijk persoon die óf dezelfde moeder óf dezelfde vader heeft als jou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f52c4a-795d-4706-9f6a-11a5ef40abea",
                                                "sense_id": "0faf5b8a-f657-3cc0-a70b-0ec778551f6c",
                                                "text": "Hitler loopt vlak achter de kist, gekleed in een lange, zwarte mantel, zwarte handschoenen en met in zijn ene hand een zwarte hoge hoed. Hij is ernstig gestemd en beheerst. Links van hem loopt zijn zwager, Raubal, en tussen hen in, Paula. Zijn halfzuster, Angela, die zwanger is en binnenkort moet bevallen, zit in een gesloten wagen die achter hen aan rijdt. De rest van het gevolg bestaat uit een paar buren. Kubizek beschrijft de begrafenis als armoedig."
                                            },
