                                "target_lang_sense_clarification": "о животных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "044d470d-5323-3309-ad5b-cfa86aa926e1",
                    "sense_definition": "The act of searching through discarded waste or rubbish for food or useful materials.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "scavenge_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our <w>scavenging</w> at the rubbish dump often yielded items of real value.",
                            "target_lang_translations": {
                                "ru": "Наши <w>поиски</w> на свалке нередко приносили действительно ценные вещи."
                            }
                        },
                        {
                            "text": "Urban foxes rely on nighttime <w>scavenging</w> to survive in the city.",
                            "target_lang_translations": {
                                "ru": "Городские лисы полагаются на ночные <w>поиски съестного</w>, чтобы выжить в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "foraging",
                        "rummaging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поиск среди выброшенных отходов или мусора пищи либо полезных вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор отходов",
                                "target_lang_sense_clarification": "поиск полезных вещей на свалке или в мусоре"
                            },
                            {
                                "target_lang_word": "поиск съестного",
                                "target_lang_sense_clarification": "поиск еды среди мусора или падали"
                            },
                            {
                                "target_lang_word": "рытьё в мусоре",
                                "target_lang_sense_clarification": "действие по поиску среди отходов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1afac6f6-cf04-33cb-801c-9c5c9a99eacd",
                    "sense_definition": "Habitually feeding on carrion, decaying matter, or discarded food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scavenge_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vultures and other <w>scavenging</w> birds gathered around the dead animal.",
                            "target_lang_translations": {
                                "ru": "Грифы и другие птицы-<w>падальщики</w> собрались вокруг мертвого животного."
                            }
                        },
                        {
                            "text": "Hyenas are known to exhibit both hunting and <w>scavenging</w> behaviors.",
                            "target_lang_translations": {
                                "ru": "Известно, что гиены проявляют как повадки охотников, так и повадки <w>трупоядных</w> животных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scavenging birds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Питающийся падалью, гниющими остатками или выброшенной пищей (о животных или птицах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падальный",
                                "target_lang_sense_clarification": "питающийся падалью"
                            },
                            {
                                "target_lang_word": "питающийся падалью",
                                "target_lang_sense_clarification": "о поведении животных или птиц"
                            },
                            {
                                "target_lang_word": "трупоядный",
                                "target_lang_sense_clarification": "зоологический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
