                    {
                        "sense_id": "43d83c87-3602-3971-b79d-c315845c3cb7",
                        "entry_id": "72ff5e78-a9a3-3792-b705-00c75223de87",
                        "glosses": [
                            "indignation, resentment (anger or displeasure felt out of belief that others have engaged in wrongdoing or mistreatment)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c3b4f0f-e412-430d-af62-830d5b3ae508",
                                "sense_id": "43d83c87-3602-3971-b79d-c315845c3cb7",
                                "text": "— Позвольте спросить, кто вы такой и за кого вы меня принимаете? — спросил он, с трудом удерживая свое негодование.",
                                "translation": "\"Allow me to ask, what are you, and for whom do you take me?\" he said, with difficulty restraining his indignation.",
                                "english": "\"Allow me to ask, what are you, and for whom do you take me?\" he said, with difficulty restraining his indignation."
                            }
                        ]
                    }
