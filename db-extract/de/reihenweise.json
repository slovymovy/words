                "senses": [
                    {
                        "sense_id": "30451655-1b8a-3dec-8592-9fc9fc8b8f06",
                        "entry_id": "831fe437-e5a5-3b5b-a0ff-644df2d2a808",
                        "glosses": [
                            "En grande quantité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b42dc22c-e6a1-438b-ae27-9bfed77b566f",
                                "sense_id": "30451655-1b8a-3dec-8592-9fc9fc8b8f06",
                                "text": "Ein Erbe der CDU-Alleinregierung der Jahre 2004 bis 2008 hat für die Hamburger Steuerzahler*innen womöglich teure Konsequenzen: Damals hat der Senat reihenweise Bürogebäude verkauft, um Geld in die Stadtkasse zu spülen.",
                                "translation": "L'un des héritages du gouvernement CDU de 2004 à 2008 pourrait avoir des conséquences coûteuses pour les contribuables hambourgeois : A l'époque, le Sénat avait vendu de nombreux immeubles de bureaux pour faire rentrer de l’argent dans les caisses de la ville."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "69212ee7-0c73-3835-b445-6f65f24b1e80",
                "word": "reihenweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                        "entry_id": "69212ee7-0c73-3835-b445-6f65f24b1e80",
                        "glosses": [
                            "in großer Menge, viel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b264bd56-3414-49ba-b5f5-661421ed6eaa",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Als das Kreuzfahrtschiff ausgelaufen war, kam der Sturm und die Passagieren wurden reihenweise seekrank."
                            },
                            {
                                "example_id": "db449fd4-e6d7-407a-aefb-05749707e549",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Die Spieler des FC Bayern ließen reihenweise beste Chancen aus, am Ende stand es 0:1 gegen Bayern."
                            },
                            {
                                "example_id": "9643029c-638c-4653-8e22-11ec8529470c",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Das Problem bei der Deutschen Bahn ist der Winter und der Sommer: bei Kälte und bei Hitze fallen reihenweise die Züge aus."
                            },
                            {
                                "example_id": "72f26c24-a465-4549-baf2-214a80dd6546",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "In der Finanzkrise 2008 mit der folgenden Rezession gingen reihenweise Firmen bankrott."
                            },
                            {
                                "example_id": "24b31ec8-aedc-47e5-92b7-64485988b044",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "In diesem Winter geht ein Virus um, die Leute erkranken reihenweise an Grippe."
                            },
                            {
                                "example_id": "49d6b027-14bc-4824-8bbb-f51d40d9e9cc",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "„Henry ist so charmant, er erobert reihenweise Frauenherzen.“"
                            },
                            {
                                "example_id": "1fbce480-6267-4a57-8d55-b60d1b672590",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Bei zwei Messkampagnen im vergangenen Jahr untersuchten Heidelberger Umweltphysiker 50 Dieselbusse in Heidelberg und 22 in Reutlingen - und reihenweise überschritten die Fahrzeuge die Grenzwerte."
                            },
                            {
                                "example_id": "28932d11-fca1-4b58-9882-586755d73860",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Die Glaubwürdigkeitskrise [nach der Dieselabgasaffäre] führt nicht unbedingt dazu, dass die Menschen reihenweise Abstand nehmen von den Produkten von Volkswagen."
                            },
                            {
                                "example_id": "e0ab4132-44c2-43c7-aaed-cae2b40ac2ed",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Die Fantasy-Serie \"Game of Thrones\" räumt erneut reihenweise Preise ab: Bei der Gala zur Verleihung des US-Fernsehpreises Emmy, gewann die TV-Serie in Los Angeles gleich zwölf Auszeichnungen."
                            },
                            {
                                "example_id": "8616cf35-ae3a-467b-baff-52f84d71b678",
                                "sense_id": "f816c4f0-f26f-3007-a8b0-24c94cd6f997",
                                "text": "Bei den Winterspielen 2014 in Sotschi soll es ein staatlich gestütztes System gegeben haben, bei dem reihenweise Dopingproben russischer Sportler ausgetauscht wurden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06a2f801-2c3b-38f1-8b10-4c39bf89391a",
                        "entry_id": "69212ee7-0c73-3835-b445-6f65f24b1e80",
                        "glosses": [
                            "angeordnet in Reihen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b94a8c-256d-4d68-97f8-dc492af24f3c",
                                "sense_id": "06a2f801-2c3b-38f1-8b10-4c39bf89391a",
                                "text": "Lächelnd erwiderte er mir: „Das sind Störche und jene dort sind Kraniche und Reiher, welche die Steppe von Schlangen (eigentlich Panzerechsen) reinigen und sich in ihrer Ruhe immer reihenweise aufstellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
