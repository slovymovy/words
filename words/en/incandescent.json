{
    "word_family": [
        "incandescence",
        "incandescently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6566b9f2-a3c0-3c63-9644-717af2b7c251",
                    "sense_definition": "Emitting light as a result of being heated to a high temperature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "glowing_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old <w>incandescent</w> light bulbs use a lot of electricity to produce light.",
                            "target_lang_translations": {
                                "de": "Alte <w>Glühbirnen</w> verbrauchen viel Strom, um Licht zu erzeugen.",
                                "ru": "Старые лампы <w>накаливания</w> потребляют много электроэнергии для освещения."
                            }
                        },
                        {
                            "text": "They bought an <w>incandescent</w> bulb for the bedroom lamp because it gives a warm light.",
                            "target_lang_translations": {
                                "de": "Sie kauften eine <w>Glühlampe</w> für die Schlafzimmerlampe, weil sie ein warmes Licht abgibt.",
                                "ru": "Они купили лампочку <w>накаливания</w> для светильника в спальне, потому что она даёт тёплый свет."
                            }
                        }
                    ],
                    "synonyms": [
                        "glowing",
                        "radiant"
                    ],
                    "common_phrases": [
                        "incandescent bulb",
                        "incandescent light"
                    ],
                    "target_lang_definitions": {
                        "de": "Licht aussendend als Folge einer Erhitzung auf eine hohe Temperatur.",
                        "ru": "Излучающий свет в результате нагревания до высокой температуры; накалённый."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "glühend",
                                "target_lang_sense_clarification": "Eigenschaft von Materialien, die durch Hitze leuchten"
                            },
                            {
                                "target_lang_word": "Glüh-",
                                "target_lang_sense_clarification": "in Zusammensetzungen wie Glühbirne"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "накалённый",
                                "target_lang_sense_clarification": "сильно нагретый и светящийся"
                            },
                            {
                                "target_lang_word": "накалённый добела",
                                "target_lang_sense_clarification": "нагретый до яркого белого свечения"
                            },
                            {
                                "target_lang_word": "накаливания",
                                "target_lang_sense_clarification": "в составе терминов (лампа накаливания)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ea8779a-8463-33b3-aa6a-c23c3cd596cd",
                    "sense_definition": "Shining extremely brightly or vividly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "glowing_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun rose over the desert, filling the sky with <w>incandescent</w> light.",
                            "target_lang_translations": {
                                "de": "Die Sonne ging über der Wüste auf und erfüllte den Himmel mit <w>strahlendem</w> Licht.",
                                "ru": "Солнце встало над пустыней, наполнив небо <w>ослепительным</w> светом."
                            }
                        },
                        {
                            "text": "Her face was brightened by an <w>incandescent</w> glow in the morning sun.",
                            "target_lang_translations": {
                                "de": "Ihr Gesicht wurde von einem <w>leuchtenden</w> Schimmer in der Morgensonne erhellt.",
                                "ru": "Её лицо озарилось <w>сияющим</w> блеском в лучах утреннего солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzling",
                        "brilliant",
                        "luminous"
                    ],
                    "antonyms": [
                        "dim",
                        "dull"
                    ],
                    "common_phrases": [
                        "incandescent glow"
                    ],
                    "target_lang_definitions": {
                        "de": "Extrem hell oder strahlend leuchtend.",
                        "ru": "Чрезвычайно ярко или ослепительно светящийся."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "strahlend",
                                "target_lang_sense_clarification": "sehr hell leuchtend"
                            },
                            {
                                "target_lang_word": "weißglühend",
                                "target_lang_sense_clarification": "vor extremer Hitze hell leuchtend"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "ослепительно яркий"
                            },
                            {
                                "target_lang_word": "светящийся",
                                "target_lang_sense_clarification": "испускающий яркий свет"
                            },
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "очень яркий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94e9ba41-f269-3d2c-8914-f928781546de",
                    "sense_definition": "Full of intense emotion, passion, or brilliant energy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intense_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician gave an <w>incandescent</w> performance that captivated everyone in the hall.",
                            "target_lang_translations": {
                                "de": "Der Musiker bot eine <w>mitreißende</w> Darbietung, die jeden im Saal fesselte.",
                                "ru": "Музыкант выступил с <w>пламенным</w> исполнением, покорившим всех присутствующих в зале."
                            }
                        },
                        {
                            "text": "The actor delivered an <w>incandescent</w> speech that brought the audience to their feet.",
                            "target_lang_translations": {
                                "de": "Der Schauspieler hielt eine <w>glühende</w> Rede, die das Publikum zu Begeisterungsstürmen hinriss.",
                                "ru": "Актёр произнёс <w>пылкую</w> речь, заставившую зрителей аплодировать стоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "passionate",
                        "fiery",
                        "vibrant"
                    ],
                    "antonyms": [
                        "dull",
                        "lifeless"
                    ],
                    "common_phrases": [
                        "incandescent performance"
                    ],
                    "target_lang_definitions": {
                        "de": "Voll intensiver Emotion, Leidenschaft oder brillanter Energie.",
                        "ru": "Преисполненный глубоких чувств, страсти или яркой энергии."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mitreißend",
                                "target_lang_sense_clarification": "voller Energie und Begeisterung"
                            },
                            {
                                "target_lang_word": "glühend",
                                "target_lang_sense_clarification": "voller Leidenschaft"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пылкий",
                                "target_lang_sense_clarification": "страстный, эмоциональный"
                            },
                            {
                                "target_lang_word": "горячий",
                                "target_lang_sense_clarification": "полный энергии и страсти"
                            },
                            {
                                "target_lang_word": "пламенный",
                                "target_lang_sense_clarification": "крайне вдохновенный и яркий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fdbf6b3-40ba-3656-a9b4-b50d531ba6fa",
                    "sense_definition": "Extremely angry; overcome with intense fury.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intense_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>incandescent</w> with rage when he saw the damage to his car.",
                            "target_lang_translations": {
                                "de": "Er war <w>weißglühend vor Wut</w>, als er den Schaden an seinem Auto sah.",
                                "ru": "Он был <w>вне себя от ярости</w>, когда увидел повреждения на своей машине."
                            }
                        },
                        {
                            "text": "She felt completely <w>incandescent</w> after reading the unfair news article.",
                            "target_lang_translations": {
                                "de": "Sie war völlig <w>aufgebracht</w>, nachdem sie den ungerechten Zeitungsartikel gelesen hatte.",
                                "ru": "Она была совершенно <w>взбешена</w>, прочитав несправедливую новостную статью."
                            }
                        }
                    ],
                    "synonyms": [
                        "furious",
                        "enraged",
                        "livid"
                    ],
                    "antonyms": [
                        "calm",
                        "peaceful"
                    ],
                    "common_phrases": [
                        "incandescent with rage"
                    ],
                    "target_lang_definitions": {
                        "de": "Extrem wütend; von extremer Wut überwältigt.",
                        "ru": "Крайне злой, разъярённый; охваченный яростью."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "weißglühend vor Wut",
                                "target_lang_sense_clarification": "extrem zornig"
                            },
                            {
                                "target_lang_word": "stinksauer",
                                "target_lang_sense_clarification": "umgangssprachlich für sehr wütend"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вне себя от ярости",
                                "target_lang_sense_clarification": "крайне разгневанный"
                            },
                            {
                                "target_lang_word": "разъярённый",
                                "target_lang_sense_clarification": "охваченный сильной злостью"
                            },
                            {
                                "target_lang_word": "взбешённый",
                                "target_lang_sense_clarification": "сильно разозлённый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c57ee67c-066d-3e7c-a446-2c76f2ef39f6",
                    "sense_definition": "An incandescent lamp or light bulb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many stores have stopped selling standard <w>incandescents</w> in favor of energy-efficient alternatives.",
                            "target_lang_translations": {
                                "de": "Viele Geschäfte haben den Verkauf von normalen <w>Glühlampen</w> zugunsten energieeffizienter Alternativen eingestellt.",
                                "ru": "Многие магазины перестали продавать обычные <w>лампы накаливания</w> в пользу энергосберегающих альтернатив."
                            }
                        },
                        {
                            "text": "These old <w>incandescents</w> burn out much faster than modern lights.",
                            "target_lang_translations": {
                                "de": "Diese alten <w>Glühbirnen</w> brennen viel schneller durch als moderne Leuchten.",
                                "ru": "Эти старые <w>лампочки накаливания</w> перегорают намного быстрее, чем современные светильники."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Glühlampe oder Glühbirne.",
                        "ru": "Лампа накаливания."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Glühbirne",
                                "target_lang_sense_clarification": "Leuchtmittel"
                            },
                            {
                                "target_lang_word": "die Glühlampe",
                                "target_lang_sense_clarification": "Fachbegriff für Glühbirne"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лампа накаливания",
                                "target_lang_sense_clarification": "осветительный прибор"
                            },
                            {
                                "target_lang_word": "лампочка накаливания",
                                "target_lang_sense_clarification": "разговорное обозначение лампы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}