                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux professeur gardait une mine <w>austère</w> qui intimidait immédiatement tous les étudiants de la classe."
                        },
                        {
                            "text": "Malgré son ton très <w>austère</w>, le juge savait se montrer compréhensif dans les situations particulièrement difficiles."
                        }
                    ],
                    "synonyms": [
