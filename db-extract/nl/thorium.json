                                        "glosses": [
                                            "Métal pur de cet élément, ductile, de couleur blanche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d831d827-6478-40f2-8bbe-16c069f6d2a1",
                                                "sense_id": "ddf82a4f-90d4-38c1-9bc7-f9cb27d82c89",
                                                "text": "L’Inde mise sur le thorium comme nouveau combustible nucléaire."
                                            },
                                            {
                                                "example_id": "346b7d49-7c9c-4612-a051-73504c7a1265",
                                                "sense_id": "ddf82a4f-90d4-38c1-9bc7-f9cb27d82c89",
                                                "text": "La raison, c'est que les minerais où on trouve les terres rares contiennent aussi des éléments radioactifs, comme de l'uranium et du thorium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e1387e-7222-3645-a968-930cd7809228",
                                        "entry_id": "d07f658b-1348-308d-8088-8fd5b053ff71",
                                        "glosses": [
                                            "Atome de thorium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
