                "senses": [
                    {
                        "sense_id": "0ef6d0f2-3543-30e0-a82f-53cde5e0ac4d",
                        "entry_id": "fbd6160c-e06a-31dd-987c-2c0339413e04",
                        "glosses": [
                            "Enlever son caractère radial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a0d392-0560-437c-a271-a10c88aae9de",
                                "sense_id": "0ef6d0f2-3543-30e0-a82f-53cde5e0ac4d",
                                "text": "Ce qui me marque c'est qu'on ne voit pas de volonté de \"déradialiser\" le réseau, comme Strasbourg l'a fait avec ses extensions en déconcentrant la station centrale \"Homme de fer\"."
                            },
                            {
                                "example_id": "88456671-4b6b-4f1c-8e1c-40c532db7439",
                                "sense_id": "0ef6d0f2-3543-30e0-a82f-53cde5e0ac4d",
                                "text": "Paul Delouvrier, premier responsable du « district de Paris » créé en 1961 élabore le schéma directeur d'une région parisienne « déradialisée », avec des axes de développement tangentiels au noyau de la petite couronne, et un programme de villes nouvelles à la périphérie."
                            }
                        ]
                    }
