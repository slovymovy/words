                "senses": [
                    {
                        "sense_id": "581a6f84-2100-3d74-8490-54b9a88d551f",
                        "entry_id": "bf55dbab-b410-3d9b-a1ef-37fea8f86821",
                        "glosses": [
                            "Personne exerçant l’activité de photostop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5469a4bb-85b9-4271-8961-d7e50efc0b3c",
                                "sense_id": "581a6f84-2100-3d74-8490-54b9a88d551f",
                                "text": "Je glissai dans un tiroir le rebut paperassier : sommations du percepteur, tracts politiques et publicitaires, tickets de photo-stoppeurs."
                            },
                            {
                                "example_id": "c5784573-918f-4e88-b61c-368dc54963f1",
                                "sense_id": "581a6f84-2100-3d74-8490-54b9a88d551f",
                                "text": "Un photo-stoppeur braqua son appareil sur eux. D’un geste qu’il voulut machinal, Plantin enfouit dans sa poche le ticket qu’on lui tendit. Il en éprouva tout un immense soulagement. Quoi qu’il arrivât, il garderait de cette rencontre, de cette promenade, un souvenir solide qui lui prouverait, plus tard, qu’elle avait vraiment existé."
                            },
                            {
                                "example_id": "b8de1f49-3431-48ef-88e4-6d47248782a0",
                                "sense_id": "581a6f84-2100-3d74-8490-54b9a88d551f",
                                "text": "Que pense le gouvernement de l’exercice, sur la voie publique, de certains métiers, notamment de celui de photo-stoppeur ?"
                            }
                        ]
                    }
                ],
