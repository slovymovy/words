                                "target_senses": [
                                    {
                                        "sense_id": "925a3865-931b-33f6-9d15-e701da13f793",
                                        "entry_id": "a74ee060-0bab-3d3b-b221-536f3247abb8",
                                        "glosses": [
                                            "The tip of the toe."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tiptoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d6f355-85ac-3d71-834e-ead8142acc54",
                                        "entry_id": "2422d323-5859-32bc-b5db-9a6f83c0bab7",
                                        "glosses": [
                                            "Standing elevated, on or as if on the tips of one's toes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d2ba60e-1da4-4ffb-ab1c-d84947ef937e",
                                                "sense_id": "a0d6f355-85ac-3d71-834e-ead8142acc54",
                                                "text": "Night's candles are burnt out, and jocund day / Stands tiptoe on the misty mountain tops."
                                            },
                                            {
                                                "example_id": "3972e348-ebf3-4099-b0c5-837ff5395427",
                                                "sense_id": "a0d6f355-85ac-3d71-834e-ead8142acc54",
                                                "text": "And ever as they talked Beregond was more amazed, and looked with greater wonder at the hobbit, swinging his short legs as he sat on the seat, or standing tiptoe upon it to peer over the sill at the lands below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f45f992-da1d-35e8-aada-1cb9322ed654",
                                        "entry_id": "2422d323-5859-32bc-b5db-9a6f83c0bab7",
                                        "glosses": [
                                            "Moving carefully, quietly, warily or stealthily, on or as if on the tips of one's toes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a585905-fe86-46d3-97d4-6192b0598393",
                                                "sense_id": "2f45f992-da1d-35e8-aada-1cb9322ed654",
                                                "text": "with tiptoe step"
                                            },
                                            {
                                                "example_id": "643c99dc-fd6b-4b10-afa3-00837125e5d6",
                                                "sense_id": "2f45f992-da1d-35e8-aada-1cb9322ed654",
                                                "text": "And stole along on tiptoe tread"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tiptoe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcefd5a8-a163-32b8-a4d8-eff9e0de9c0a",
                                        "entry_id": "ff046807-f274-3d86-b6e0-d0e24fe8c827",
                                        "glosses": [
                                            "To walk quietly with only the tips of the toes touching the ground."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "550c9d1d-d535-46c4-a9ee-508cd022e4c1",
                                                "sense_id": "dcefd5a8-a163-32b8-a4d8-eff9e0de9c0a",
                                                "text": "We went tip-toeing along a path amongst the trees back towards the end of the widow's garden, stooping down so as the branches wouldn't scrape our heads."
                                            },
                                            {
                                                "example_id": "1195ed61-acab-4116-ad97-86da91813104",
                                                "sense_id": "dcefd5a8-a163-32b8-a4d8-eff9e0de9c0a",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time."
                                            },
                                            {
                                                "example_id": "8916845b-ea2a-4875-a5fa-7bf7eaf17526",
                                                "sense_id": "dcefd5a8-a163-32b8-a4d8-eff9e0de9c0a",
                                                "text": "Tiptoe through the window\nBy the window, that is where I'll be\nCome tiptoe through the tulips with me\nTiptoe from your pillow\nTo the shadow of the willow tree\nAnd tiptoe through the tulips with me."
                                            },
                                            {
                                                "example_id": "9f3d33d8-3e0b-4007-9655-0b2d7fa7f055",
                                                "sense_id": "dcefd5a8-a163-32b8-a4d8-eff9e0de9c0a",
                                                "text": "Who can it be knocking at my door?\nMake no sound, tiptoe across the floor\nIf he hears, he'll knock all day\nI'll be trapped and here I'll have to stay"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
