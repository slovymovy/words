                ],
                "senses": [
                    {
                        "sense_id": "f0e68f6f-f53c-302a-9bf4-264844562df0",
                        "entry_id": "412ac524-fcff-3f7e-a21c-00426a93587f",
                        "glosses": [
                            "Eimer aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4024b5-d8c0-46b5-b582-a45bed215003",
                                "sense_id": "f0e68f6f-f53c-302a-9bf4-264844562df0",
                                "text": "„Waschmittel stapelte sich in einer Ecke neben Wäscheklammern, Plastikeimern und Putzlappen.“"
                            },
                            {
                                "example_id": "90110bb6-d8d9-471b-a929-7114fb52a1c4",
                                "sense_id": "f0e68f6f-f53c-302a-9bf4-264844562df0",
                                "text": "„Zozan und Leyla sollten die Plastikeimer aus der Speisekammer bringen, in denen sie die schon Tage zuvor überreifen Trauben gesammelt hatten.“"
                            },
                            {
                                "example_id": "ede94e09-0292-45bb-90bf-dd441a2bc32f",
                                "sense_id": "f0e68f6f-f53c-302a-9bf4-264844562df0",
                                "text": "„Fülle einen Plastikeimer mit genügend warmem Wasser, um das Seil vollständig damit zu bedecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
