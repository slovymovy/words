                "senses": [
                    {
                        "sense_id": "1ea0f41d-7451-3c1d-98fc-b6af432afc7a",
                        "entry_id": "8b0c4d8f-2bcb-3ea6-b6a4-4f3771b31662",
                        "glosses": [
                            "Stadtteil von London"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32a30d39-be94-4856-9800-4e022c19d499",
                                "sense_id": "1ea0f41d-7451-3c1d-98fc-b6af432afc7a",
                                "text": "„Es passierte gegen Mitternacht. Eine Wohnung in Mayfair in den oberen Etagen.“"
                            },
                            {
                                "example_id": "83dea0ec-4cc5-4aca-9237-9a7d19d318f5",
                                "sense_id": "1ea0f41d-7451-3c1d-98fc-b6af432afc7a",
                                "text": "„Vom Arbeitszimmer im Dachgeschoss seines Hauses in Ennismore Gardens konnte Perkins über die roten Ziegeldächer von Harrods in der Brompton Road bis hin zu den hinter dem Park gelegenen Hotelhochhäusern an der Grenze zu Mayfair blicken.“"
                            },
                            {
                                "example_id": "152f90e1-7539-4548-a462-ea0eae093ccd",
                                "sense_id": "1ea0f41d-7451-3c1d-98fc-b6af432afc7a",
                                "text": "„Dieser Mercedes-Limousine war er von der Wohnung ihres Besitzers in Mayfair bis hierher auf einem Leihrad gefolgt, mit dem es ihm im zähen Verkehr schwergefallen war, nicht allzu dicht aufzufahren; und sobald der Wagen in die Savile Row abgebogen war, hatte er sich denken können, wohin die Fahrt ging, und war schnellstens in eine Parallelstraße geradelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
