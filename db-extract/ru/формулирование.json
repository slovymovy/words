                ],
                "translations": [
                    {
                        "translation_id": "4c30a98a-82eb-40e8-bc9c-a52a371d8c0b",
                        "source_entry_id": "644796f7-2f7a-3396-bcc9-b610f9f4db33",
                        "source_sense_id": "3576e644-a3a7-30b0-99be-c309d5c36121",
                        "target_lang_word": "Formulierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Formulierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                        "entry_id": "243d3f7a-591f-35da-b1b8-8c85b9146d53",
                                        "glosses": [
                                            "eine bewusst gewählte Zusammenstellung von Wörtern, um einen bestimmten Gedankeninhalt auszudrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a1bb20-a175-40d0-bb2f-35b8c6432df9",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "Die Formulierung eines guten Bewerbungsschreibens bereitet vielen Leuten Schwierigkeiten."
                                            },
                                            {
                                                "example_id": "9dad02bc-53ad-4d06-a2c1-eb65b3a91810",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Wie viel von all diesen Formulierungen ihm selber einfielen und wie viel ihm die Kommunisten ins Papier schrieben, ist heute nicht mehr auszumachen.“"
                                            },
                                            {
                                                "example_id": "694ffd41-95ec-4ee3-915a-095e94411009",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Wenn du als Besucher deinen Blick über die Wände der ägyptischen Tempel wandern lässt, wirst du sehr bald auf zahlreiche Beispiele dieser Formulierung stoßen.“"
                                            },
                                            {
                                                "example_id": "8bfeb171-f913-4995-8978-726619fffef7",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Solche sehr suggestiv vorgebrachten, sich wiederholenden Formulierungen ließen sogar einige nationalistische Kritiker den Roman über das Leben in den Schützengräben preisen.“"
                                            },
                                            {
                                                "example_id": "fcbdf01c-e9a2-468e-bba7-55c7e51d4cde",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Damit die Formulierung nicht so großformatig daherkommt, sei sie erläutert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbaea1ea-c93a-371b-954a-5898b2104c83",
                                        "entry_id": "243d3f7a-591f-35da-b1b8-8c85b9146d53",
                                        "glosses": [
                                            "eine spezielle Zusammenstellung von chemischen oder pharmazeutischen Komponenten, um ein Medikament mit einer genau definierten pharmazeutischen Wirkung zu erstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd036f6-a110-4fff-b6c0-29a76ab661fe",
                                                "sense_id": "dbaea1ea-c93a-371b-954a-5898b2104c83",
                                                "text": "Auf Grund seiner speziellen Formulierung tritt die Wirkung des neuen Medikaments bereits wenige Minuten nach seiner Einnahme ein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
