                "senses": [
                    {
                        "sense_id": "0939ced5-4547-3fe9-8b60-66190b5ffab4",
                        "entry_id": "c73803b9-542c-3145-a94c-d6a832a991ea",
                        "glosses": [
                            "Impudique, luxurieux."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3c61551b-447d-4880-83df-4de86ee1cf1d",
                                "sense_id": "0939ced5-4547-3fe9-8b60-66190b5ffab4",
                                "text": "Il se réjouissait surtout des histoires de femmes ribaudes et de maris trompés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c572adc3-cd18-422e-9777-8f8a8588f24d",
                        "source_entry_id": "c73803b9-542c-3145-a94c-d6a832a991ea",
                        "source_sense_id": "0939ced5-4547-3fe9-8b60-66190b5ffab4",
                        "source_sense_description": "Impudique, luxurieux",
                        "target_lang_word": "ribald",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ribald",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                        "entry_id": "dce36f13-6e6c-3d2e-aebb-ffdf74e902fb",
                                        "glosses": [
                                            "Coarsely, vulgarly, or lewdly amusing; referring to sexual matters in a rude or irreverent way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfd6fd7-1ba9-4082-9350-1388bc0cc400",
                                                "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                                "text": "[L]et no zealous Christian trust the rogue,—the filthy ribald rascal is a liar."
                                            },
                                            {
                                                "example_id": "17cafe0f-60e4-430e-b646-5822f02d03ee",
                                                "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                                "text": "But when he died the \"Reform Democracy\" instinctively returned to its vomit of ribald insult."
                                            },
                                            {
                                                "example_id": "314ee0fd-6a5f-46fe-80c0-b24ca00710eb",
                                                "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                                "text": "[T]he curious crowd had collected in the street […], with here and there a scoffer uttering his incredulity and courage with scornful remarks or ribald cries."
                                            },
                                            {
                                                "example_id": "6e73a578-095c-462f-b2b4-74acb1188da2",
                                                "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                                "text": "Anyway up against Reba McEntire, '60s-rock-bred big city escapee K.T. Oslin comes off both more ribald (\"Younger Men\") and prouder of the bras and bridges she used to burn (\"'8s Ladies\") in her best country hits."
                                            },
                                            {
                                                "example_id": "b4b24797-c860-46bd-bcfe-e368142cad66",
                                                "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                                "text": "Baron Cohen turns his attentions back towards England, satirising the Establishment’s contempt for what Nobby himself proudly calls “scum” with ribald and corrosive glee."
                                            },
                                            {
                                                "example_id": "88d3eb14-93d9-435e-bb42-cea94d34017e",
                                                "sense_id": "51e3c21e-223e-3371-91bf-b78b4209e05f",
                                                "text": "The “South Park” social media account responded, “Wait, so we ARE relevant?” and added a ribald hashtag."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ribald",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7ba8cb5-a8e9-3245-98f1-a7e1def4f8e0",
                                        "entry_id": "25a5b2c6-2044-36d3-9a89-a3720236663b",
                                        "glosses": [
                                            "A person who is filthy or vulgar in nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83442a4a-f69e-4ea8-959a-47aeee8ef894",
                                                "sense_id": "a7ba8cb5-a8e9-3245-98f1-a7e1def4f8e0",
                                                "text": "After, he made an harlot, a ribald, come to him alone for to touch his members and his body, to move to lechery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "17657cf6-0f59-3fc0-99fe-c8c1e98651d0",
                "word": "ribaud",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "819ab287-7dd4-410d-9fda-ff51e23842c8",
