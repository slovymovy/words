                        "entry_id": "4f7602cd-4f5c-3709-9c9b-b0042907ed96",
                        "glosses": [
                            "de kracht die tijdens het afvuren van een vuurwapen uitgeoefend wordt op het wapen zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6f3e17-ae28-42b3-86e1-8c7f303246f3",
                                "sense_id": "88cfcaed-c8b4-35f9-8b9e-334142ae6213",
                                "text": "Door de terugslag viel het pistool uit mijn hand na het afvuren."
                            }
                        ]
                    },
                    {
                        "sense_id": "b231103b-70f9-3763-8b17-132b03d2bdfe",
                        "entry_id": "4f7602cd-4f5c-3709-9c9b-b0042907ed96",
                        "glosses": [
                            "nadelig gevolg van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "468056a1-36e7-4be0-8d29-073ed38ea8b6",
                                "sense_id": "b231103b-70f9-3763-8b17-132b03d2bdfe",
                                "text": "Na het herstel van de operatie kreeg ze toch nog een terugslag."
                            }
                        ]
                    },
                    {
                        "sense_id": "06b9bac8-d665-3631-903c-792c58e0df36",
                        "entry_id": "4f7602cd-4f5c-3709-9c9b-b0042907ed96",
                        "glosses": [
                            "reactie op een actie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b47d0f1-e24b-4bfe-b185-ab01b9218f63",
                                "sense_id": "06b9bac8-d665-3631-903c-792c58e0df36",
                                "text": "De couppoging werd afgeslagen doordat duizenden Turken met gevaar voor eigen leven de straat op gingen om de democratie te beschermen. Zeker 200 burgers en politieagenten vonden daarbij de dood. Maar de foto staat ook voor de buitensporige terugslag die volgde: het ongehoorde aantal arrestaties, ontslagen en schorsingen van iedereen die - terecht of onterecht- in verband wordt gebracht met de beweging van de islamitische geestelijke Fethullah Gülen. Het resultaat is een land in de greep van wantrouwen, cynisme en geweld."
                            }
                        ]
                    }
