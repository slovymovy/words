                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De harde knal heeft de baby uit zijn diepe slaap <w>geschrikt</w>.",
                            "target_lang_translations": {
