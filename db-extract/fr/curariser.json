                        "source_entry_id": "92a07f2a-ae81-3a53-941b-703413e837c7",
                        "target_lang_word": "curarize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curarize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1b8856a-0aa0-31bc-b547-60fe0c5bd39e",
                                        "entry_id": "4856fc80-efbe-39d3-be0e-d7e84dbe6600",
                                        "glosses": [
                                            "To administer curare to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "006f97e6-c2d6-4057-99af-bdc84959aa45",
                                                "sense_id": "c1b8856a-0aa0-31bc-b547-60fe0c5bd39e",
                                                "text": "Curarize the frog sufficiently to paralyze the motor nerves."
                                            },
                                            {
                                                "example_id": "0723e86f-10be-48a2-8f1d-316b304d5bc5",
                                                "sense_id": "c1b8856a-0aa0-31bc-b547-60fe0c5bd39e",
                                                "text": "Curarize a large frog, and remove the arches from the fifth, sixth, seventh, eighth, and ninth vertebræ."
                                            },
                                            {
                                                "example_id": "b352070c-2b26-4851-ac6d-21ef44fcd486",
                                                "sense_id": "c1b8856a-0aa0-31bc-b547-60fe0c5bd39e",
                                                "text": "It is difficult to curarize vitally stained frogs, and thoroughly curarized animals may be restored by injections of dyestuff (Congo red, trypan blue)."
                                            },
                                            {
                                                "example_id": "121e4654-4b05-46fe-ae96-5086bcf4a12f",
                                                "sense_id": "c1b8856a-0aa0-31bc-b547-60fe0c5bd39e",
                                                "text": "In addition, I do not smoke nor does anyone in my laboratory when we curarize rats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
