                "senses": [
                    {
                        "sense_id": "1255d395-9ded-3921-a717-ead4d1c2d617",
                        "entry_id": "c530df96-97d1-3c43-854c-95b84ae1934d",
                        "glosses": [
                            "Handlung, mit der jemand beansprucht, sich äußern zu können, vor allem durch Handzeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a33e18-dfba-45de-b05b-2e3a2764663e",
                                "sense_id": "1255d395-9ded-3921-a717-ead4d1c2d617",
                                "text": "Es gab noch viele Wortmeldungen mehr, die aber nicht alle zum Zuge kommen konnten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fdc585d0-d9f3-359e-afbf-9fba8ebdb515",
                        "entry_id": "c530df96-97d1-3c43-854c-95b84ae1934d",
                        "glosses": [
                            "Redebeitrag einer Person in einer größeren Runde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a723a96-0c70-4a06-9b19-084efe3b7c4a",
                                "sense_id": "fdc585d0-d9f3-359e-afbf-9fba8ebdb515",
                                "text": "„Hier sank der Anteil der Wortmeldungen mit Schmäh- und Schmuddelwörtern von 27 auf 20 Prozent.“"
                            },
                            {
                                "example_id": "637ca05b-f634-4761-ad5d-0ab2a90059cf",
                                "sense_id": "fdc585d0-d9f3-359e-afbf-9fba8ebdb515",
                                "text": "„Die meistbeachtete Wortmeldung war allerdings eine Erklärung, in der sich der Altkanzler im Sommer 2011 gegen die »öffentliche Zurschaustellung und Vermarktung« seines Privatlebens wandte.“"
                            },
                            {
                                "example_id": "9ead9428-6ee4-4b36-9f5d-fe5d669f62cf",
                                "sense_id": "fdc585d0-d9f3-359e-afbf-9fba8ebdb515",
                                "text": "„Später wurde mir klar, wer sie waren und warum sie gerade diese Art der Wortmeldungen nicht ertrugen.“"
                            },
                            {
                                "example_id": "d0b97b84-656c-4007-b7c5-dd0a195cef9b",
                                "sense_id": "fdc585d0-d9f3-359e-afbf-9fba8ebdb515",
                                "text": "„Einige Wortmeldungen aufgebrachter Bürger sind überliefert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
