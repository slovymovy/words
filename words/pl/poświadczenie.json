                {
                    "sense_id": "c4879376-9874-31b8-8374-7e984958b352",
                    "sense_definition": "Dokument lub pisemne zaświadczenie potwierdzające prawdziwość faktów, tożsamość lub uprawnienia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dokument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Urzędnik poprosił o oficjalne <w>poświadczenie</w> zameldowania w tym lokalu.",
                            "target_lang_translations": {
                                "ru": "Чиновник попросил официальное <w>свидетельство</w> о регистрации в этом помещении."
                            }
                        },
                        {
                            "text": "Wymagane jest notarialne <w>poświadczenie</w> podpisu złożonego pod tą umową.",
                            "target_lang_translations": {
                                "ru": "Требуется нотариальное <w>заверение</w> подписи, поставленной под этим договором."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaświadczenie",
                        "potwierdzenie"
                    ],
                    "common_phrases": [
                        "notarialne poświadczenie",
                        "poświadczenie odbioru",
                        "poświadczenie bezpieczeństwa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ или письменное свидетельство, подтверждающее истинность фактов, личность или полномочия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свидетельство",
                                "target_lang_sense_clarification": "официальный документ"
                            },
                            {
                                "target_lang_word": "удостоверение",
                                "target_lang_sense_clarification": "документ, подтверждающий факт или статус"
                            },
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "письменный документ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4abb848e-1846-3cb9-b126-ae5354fa2667",
                    "sense_definition": "Działanie polegające na potwierdzeniu prawdziwości, autentyczności lub tożsamości kogoś bądź czegoś; rzeczownik odczasownikowy od <w>poświadczyć</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Świadek zdecydował się na pisemne <w>poświadczenie</w> prawdziwości tych zeznań.",
                            "target_lang_translations": {
                                "ru": "Свидетель решил дать письменное <w>подтверждение</w> правдивости этих показаний."
                            }
                        },
                        {
                            "text": "Radca prawny dokonał formalnego <w>poświadczenia</w> zgodności dokumentu z oryginałem.",
                            "target_lang_translations": {
                                "ru": "Юрисконсульт произвёл формальное <w>заверение</w> соответствия документа оригиналу."
                            }
                        }
                    ],
                    "synonyms": [
                        "potwierdzenie"
                    ],
                    "common_phrases": [
                        "poświadczenie nieprawdy",
                        "poświadczenie zgodności"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по подтверждению истинности, подлинности или личности кого-либо или чего-либо."
                    },
                    "translations": {
