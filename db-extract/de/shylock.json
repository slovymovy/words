                        "cross_references": [
                            {
                                "target_word": "shylock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f494e7-1915-3fce-aff0-715910720aac",
                                        "entry_id": "41ade68e-1629-31d8-943e-4adc6d26760e",
                                        "glosses": [
                                            "A loan shark; a usurer."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6bb38d-8b23-493c-bcb8-946b58933709",
                                                "sense_id": "c6f494e7-1915-3fce-aff0-715910720aac",
                                                "text": "Eventually, their gambling debts grow so big that they are cut off from making any more bets, eliminating the chance that they can make enough money to satisfy their shylocks."
                                            },
                                            {
                                                "example_id": "4f8b648c-6912-4c80-bf80-ad869bd0fa4c",
                                                "sense_id": "c6f494e7-1915-3fce-aff0-715910720aac",
                                                "text": "If a guy got into hock with several shylocks from different crews and was unable to keep up with his weekly payments, a sit-down would have to be called with all of the shylocks involved and their respective capos."
                                            },
                                            {
                                                "example_id": "830b9bff-72f8-44e8-9ba2-ff1977cfcb9b",
                                                "sense_id": "c6f494e7-1915-3fce-aff0-715910720aac",
                                                "text": "After Caspian's father killed his credit lines at all the big casinos, he ran up a six-figure tab with a couple of shylocks in Miami, then couldn't make the vig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47caf320-8da1-3fe0-a6e9-6ff10fc4e9ac",
                                        "entry_id": "41ade68e-1629-31d8-943e-4adc6d26760e",
                                        "glosses": [
                                            "A person of Jewish descent."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shylock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb076d42-e547-3ba0-bdad-3bde1a999af9",
                                        "entry_id": "7d966fde-b2fb-359f-851d-b2bc31e19dc1",
                                        "glosses": [
                                            "To lend money at exorbitant rates of interest."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5394ecd7-52aa-4114-92e3-96069227b3d2",
                                                "sense_id": "fb076d42-e547-3ba0-bdad-3bde1a999af9",
                                                "text": "I wanted to know whether shylocking is a legal business or not, and if it is legal, under which Act does it operate?"
                                            },
                                            {
                                                "example_id": "056d170b-544a-4870-b305-2245a5b45fbd",
                                                "sense_id": "fb076d42-e547-3ba0-bdad-3bde1a999af9",
                                                "text": "When you've accumulated a good stash of money, you may want to go into the nightclub business, or shylocking. Shylocking is free. There is no ten percent vig on loan sharking."
                                            },
                                            {
                                                "example_id": "201df682-1129-437a-84d0-5adf426fd2a6",
                                                "sense_id": "fb076d42-e547-3ba0-bdad-3bde1a999af9",
                                                "text": "Lori said it sounded outright felonious, but Dad said all he was doing was outsmarting the fat-cat bank owners who shylocked the common man by charging usurious interest rates."
                                            },
                                            {
                                                "example_id": "6b221cbc-fbc2-41b3-bffb-ac5f5261b201",
                                                "sense_id": "fb076d42-e547-3ba0-bdad-3bde1a999af9",
                                                "text": "Do you recall this question having been put to you—the shylocking business you were involved in continued right up until the time that you were arrested, correct?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
