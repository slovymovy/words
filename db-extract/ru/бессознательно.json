                                        "entry_id": "5fec2ee4-0e5e-395d-a51a-c2b3739ed5e4",
                                        "glosses": [
                                            "Without awareness, without intent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f142f5-fe80-4ae3-945f-7673bce2ec8d",
                                                "sense_id": "eea3f965-e25c-3fb7-b76f-2982119a0138",
                                                "text": "An endianness difference can cause problems if a computer unknowingly tries to read binary data written in the opposite format from a shared memory location or file."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b9bd90a-26ec-4e2b-ad6c-73b12567f9d4",
                        "source_entry_id": "97db1365-21dc-390c-ae5f-e96daede3c3d",
