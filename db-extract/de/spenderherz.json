                        "glosses": [
                            "Herz, das von einem freiwilligen Organspender stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c5f4ee6-5fbe-48e3-ad1b-a79dace33c12",
                                "sense_id": "28e3f086-877b-3464-a87a-0de981ecb10b",
                                "text": "„Durchschnittlich wartet in Europa ein Patient nach der Registrierung bei Eurotransplant vier Monate auf sein Spenderherz.“"
                            },
                            {
                                "example_id": "502f2319-2506-463b-95ec-977cacaf6618",
                                "sense_id": "28e3f086-877b-3464-a87a-0de981ecb10b",
                                "text": "„Sie sind eine große Hoffnung für all jene Menschen, die bislang vergebens auf ein Spenderherz warten.“"
                            }
                        ],
