                        "cross_references": [
                            {
                                "target_word": "водоснабжение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8af6659a-9401-35e2-b3be-60ce824fee62",
                                        "entry_id": "26e2972d-4fb5-387b-8690-e244c379f7b4",
                                        "glosses": [
                                            "действие по значению снабжать, снабдить водой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e07aea-b6db-4e37-bc0f-3d9e1652e994",
                                                "sense_id": "8af6659a-9401-35e2-b3be-60ce824fee62",
                                                "text": "Под влиянием недостаточного водоснабжения изменяется анатомическая структура растения: клетки становятся мельче, а число их на единицу поверхности больше"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529f740e-dc93-3709-a38b-b4f17a91c87e",
                                        "entry_id": "26e2972d-4fb5-387b-8690-e244c379f7b4",
                                        "glosses": [
                                            "совокупность мероприятий для удовлетворения потребностей в воде каких-либо организаций или материальных потребностей населения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b0f644-00c1-4cac-b3ec-00f1594166ea",
                                                "sense_id": "529f740e-dc93-3709-a38b-b4f17a91c87e",
                                                "text": "Англия поняла, что большая смертность есть общественное зло, против которого нужно бороться общественными же силами, ― и с этого момента в английских городах начинается сооружение так называемых «Sanitary Works», т. е. тех грандиозных работ по канализации и водоснабжению населённых мест, которыми англичане по правде могут гордиться и которыми они дали сильный толчок не только практическому движению санитарных вопросов, но и разработке научной гигиены."
                                            }
                                        ]
