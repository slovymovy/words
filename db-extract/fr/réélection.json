                "senses": [
                    {
                        "sense_id": "864bb9ec-75c8-3892-a5a7-4152f1c4ea66",
                        "entry_id": "dd2dd263-8cc7-3982-b872-b4d27d8b24a8",
                        "glosses": [
                            "Action d’élire de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dffa2052-7e89-4b8c-97dc-586bc530e37a",
                                "sense_id": "864bb9ec-75c8-3892-a5a7-4152f1c4ea66",
                                "text": "Battu par Joe Biden en 2020, Donald Trump veut devenir le premier ex-président depuis Grover Cleveland, en 1892, à remporter un second mandat après avoir perdu une réélection."
                            },
                            {
                                "example_id": "8f364b16-fda0-463f-8a26-63c02682fa6a",
                                "sense_id": "864bb9ec-75c8-3892-a5a7-4152f1c4ea66",
                                "text": "Sarkozy sait au moins que sa réélection ne se fera que par la droite. Mais les citoyens ont appris à se méfier des mots présidentiels, toujours justes mais généralement inopérants..."
                            },
                            {
                                "example_id": "f671e84b-0282-4032-8c2f-7300c1747b75",
                                "sense_id": "864bb9ec-75c8-3892-a5a7-4152f1c4ea66",
                                "text": "À la nation qui l’attendait, le Président, officiellement, a annoncé sa Réélection."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "836c0091-18fa-44f3-85b4-a14ebb6ce29e",
                        "source_entry_id": "dd2dd263-8cc7-3982-b872-b4d27d8b24a8",
                        "source_sense_id": "864bb9ec-75c8-3892-a5a7-4152f1c4ea66",
                        "target_lang_word": "Wiederwahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederwahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a17572ed-797e-37e6-956d-a30729a9017b",
                                        "entry_id": "4ec55a4d-2c37-3cc0-805e-d4857c65a445",
                                        "glosses": [
                                            "Bestätigung eines gewählten Amts- oder Mandatsträgers durch eine erneute Wahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ffbb923-4ec6-4cd2-83c8-55ceb5c6f416",
                                                "sense_id": "a17572ed-797e-37e6-956d-a30729a9017b",
                                                "text": "Nachdem er drei Wiederwahlen geschafft hat, beabsichtigt der Bürgermeister bei der nächsten Wahl nicht mehr anzutreten."
                                            },
                                            {
                                                "example_id": "6b6ce286-1ddb-4888-bc79-3d6eb2a54128",
                                                "sense_id": "a17572ed-797e-37e6-956d-a30729a9017b",
                                                "text": "Nach einer erfolgreichen Amtszeit stellt sich der Präsident zur Wiederwahl."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
