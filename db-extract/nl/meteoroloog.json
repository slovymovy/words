                    {
                        "sense_id": "ecb426c6-0b92-3acb-9661-fd06e34cf4ef",
                        "entry_id": "7a9adaf0-f78c-39af-85bb-495999821944",
                        "glosses": [
                            "iemand die beroepsmatig het weer bestudeert"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "30a124c7-9753-4c7a-89c7-47b942d3bc15",
                                "sense_id": "ecb426c6-0b92-3acb-9661-fd06e34cf4ef",
                                "text": "\"We zien meer hittegolven achter elkaar in landen als Portugal en Spanje. Dat is echt opvallend\", zegt meteoroloog Roosmarijn Knol van Weerplaza. \"Ook de komende dagen gaan de temperaturen stijgen. In plaatsen als Madrid en Sevilla wordt het 45 graden.\""
                            },
                            {
                                "example_id": "4beb847e-bf14-45da-92d9-24f6ac318996",
                                "sense_id": "ecb426c6-0b92-3acb-9661-fd06e34cf4ef",
                                "text": "Toen meteorologen aankondigden dat orkaan Milton een desastreuze koers over het zuiden van Florida zou volgen, wist de 24-jarige Nick Weppner uit Sarasota dat hij aan de slag moest. En dat betekende dat hij zijn oude legertruck, \"gewoon voor de lol gekocht\", moest inzetten voor serieuzer werk. Weppner is zelfredzaam, maar maakt zich zorgen over hoe moeilijk het voor inwoners wordt om zich nog te verzekeren tegen extreem weer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5de8088-c572-4cc3-a1da-977592a0f86b",
                        "source_entry_id": "7a9adaf0-f78c-39af-85bb-495999821944",
                        "source_sense_id": "ecb426c6-0b92-3acb-9661-fd06e34cf4ef",
                        "target_lang_word": "Meteorologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meteorologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                        "entry_id": "f55dc01d-2448-327c-ba4b-386d5e6b84fe",
                                        "glosses": [
                                            "Person, die in der Meteorologie ausgebildet und bewandert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559f58be-dd03-48e6-9ec9-6e7d9350d0bb",
                                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                                "text": "„Heute Abend warnte der Meteorologe vor einem drohenden Unwetter im Norden.“"
                                            },
                                            {
                                                "example_id": "f8936054-8c18-45d9-aae6-d7bb475a83bd",
                                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                                "text": "„Kreuzwinde, Sturm, Hagel, Seitenwinde, was Meteorologen lieben, Piloten spannend finden und Touristen hassen: All das gibt es hier, im minütlichen Wechsel.“"
                                            },
                                            {
                                                "example_id": "9fab8369-b9d8-44b7-bf1d-4e09db824e26",
                                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                                "text": "„Und als richtigen Eistag, an dem die Temperatur nicht über null Grad steigt, haben die Meteorologen nur einen einzigen Tag zu bieten, den 30. Januar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20f483a1-9d63-4f5e-9a48-1a8fe62f548a",
                        "source_entry_id": "7a9adaf0-f78c-39af-85bb-495999821944",
                        "source_sense_id": "ecb426c6-0b92-3acb-9661-fd06e34cf4ef",
