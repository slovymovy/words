{
    "word_family": [
        "symptomatic",
        "symptomless",
        "symptomatology"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "016a8ad0-61fb-357a-ae38-2302fc596d19",
                    "sense_definition": "A physical or mental feature which is regarded as indicating a condition of disease, particularly such a feature that is apparent to the patient.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked if I had noticed any other <w>symptom</w> besides the persistent cough.",
                            "target_lang_translations": {
                                "ru": "Врач спросил, не заметил ли я каких-либо других <w>симптомов</w>, кроме постоянного кашля."
                            }
                        },
                        {
                            "text": "A high fever is a common <w>symptom</w> of the flu that usually appears suddenly.",
                            "target_lang_translations": {
                                "ru": "Высокая температура — это распространенный <w>симптом</w> гриппа, который обычно появляется внезапно."
                            }
                        }
                    ],
                    "synonyms": [
                        "sign"
                    ],
                    "common_phrases": [
                        "common symptom",
                        "flu symptom",
                        "physical symptom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический или психический признак, рассматриваемый как показатель заболевания, особенно такой, который заметен самому пациенту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симптом",
                                "target_lang_sense_clarification": "медицинский признак болезни"
                            },
                            {
                                "target_lang_word": "признак",
                                "target_lang_sense_clarification": "проявление недомогания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48c42ff8-8d08-3988-8510-c10f21891b12",
                    "sense_definition": "A sign or indication of the existence of something else, especially of an undesirable situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recent increase in crime is a <w>symptom</w> of a much deeper social problem.",
                            "target_lang_translations": {
                                "ru": "Недавний рост преступности является <w>симптомом</w> гораздо более глубокой социальной проблемы."
                            }
                        },
                        {
                            "text": "Constant arguing is often a <w>symptom</w> of a failing relationship between two people.",
                            "target_lang_translations": {
                                "ru": "Постоянные ссоры часто являются <w>признаком</w> разрушающихся отношений между двумя людьми."
                            }
                        }
                    ],
                    "synonyms": [
                        "indication",
                        "manifestation",
                        "sign",
                        "signal"
                    ],
                    "common_phrases": [
                        "symptom of decay",
                        "symptom of failure",
                        "clear symptom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признак или свидетельство существования чего-либо другого, особенно нежелательной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симптом",
                                "target_lang_sense_clarification": "внешний признак проблемы"
                            },
                            {
                                "target_lang_word": "признак",
                                "target_lang_sense_clarification": "показатель ситуации"
                            },
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "обнаружение скрытого процесса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}