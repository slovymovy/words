                        "translation_id": "81d2fddf-1eec-417f-899b-c5bf0f1b89dc",
                        "source_entry_id": "a1fb00ca-c1a6-3397-8c26-214a49bc2bb4",
                        "source_sense_id": "b679ee0b-8bd1-3c44-8ff6-227ec0162ec9",
                        "source_sense_description": "inhabitant of a town — see also townsman, townswoman",
                        "target_lang_word": "горожа́нин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "горожа́нин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5dce8e56-cc97-3754-b28f-5dff12a39315",
                                        "entry_id": "70363380-9e29-3459-8afc-4f4710dcc1a0",
                                        "glosses": [
                                            "житель города"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8a3abb-9e3c-449f-92f3-908d2492ec73",
                                                "sense_id": "5dce8e56-cc97-3754-b28f-5dff12a39315",
                                                "text": ".. горожане жили зимою и летом в городе, в городской черте, и только по праздникам, в хорошую погоду, прогуливались за городом."
                                            },
                                            {
                                                "example_id": "36c42ac4-f69f-47e4-949f-d83c04068b51",
                                                "sense_id": "5dce8e56-cc97-3754-b28f-5dff12a39315",
                                                "text": ".. с шумом промчался вечерний дачный поезд, развозивший горожан по полям и лесам…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ecc14a2-1b89-42bd-b04f-5f2087780645",
                        "source_entry_id": "a1fb00ca-c1a6-3397-8c26-214a49bc2bb4",
                        "source_sense_id": "b679ee0b-8bd1-3c44-8ff6-227ec0162ec9",
                        "source_sense_description": "inhabitant of a town — see also townsman, townswoman",
                        "target_lang_word": "горожа́нка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "горожа́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1d57ee3c-7427-3da4-8999-c2962ec17f8a",
                                        "entry_id": "e86bc2a9-cb32-35d3-9a2a-4976f5acf510",
                                        "glosses": [
                                            "женск. к горожанин; жительница города"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8cc3db-f2f1-45ac-b1a8-0c9d20c9ab49",
                                                "sense_id": "1d57ee3c-7427-3da4-8999-c2962ec17f8a",
                                                "text": "И вот эта горожанка, почти еще ребенок, должна отказаться от всех радостей жизни в большой семье и в большом городе с его развлечениями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ea2a63-91e2-3c92-b23e-2c969d63525e",
                                        "entry_id": "e86bc2a9-cb32-35d3-9a2a-4976f5acf510",
                                        "glosses": [
                                            "перен. о женщине, не знавшей \\\"деревни\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647ed846-68e6-4a0f-b12b-4d0ec32a4f96",
                                                "sense_id": "f7ea2a63-91e2-3c92-b23e-2c969d63525e",
                                                "text": "Она-де горожанка, руки у нее не рабочие, она не знает, что делать в огороде, со скотиной не умеет обращаться, доить не умеет, и при этом перечислении матушка заметно оживилась и повеселела."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
