                ],
                "senses": [
                    {
                        "sense_id": "0f633137-b350-3cf3-ab6e-93f5f4fd9fea",
                        "entry_id": "432ab96f-817d-3271-8bcb-f3f893fb3d1b",
                        "glosses": [
                            "Gastronomiebetrieb mit hochwertigen, meist teuren Speisen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "6bd7eea0-bc54-4f06-9bbb-6c4e2fde0b56",
                                "sense_id": "0f633137-b350-3cf3-ab6e-93f5f4fd9fea",
                                "text": "„Im aktuellen Michelin-Führer für Frankreich und Monaco sind zusammen 27 Gourmettempel mit drei Sternen ausgezeichnet.“"
                            },
                            {
                                "example_id": "c7c8fec3-9dea-4b8a-ad46-341553796341",
                                "sense_id": "0f633137-b350-3cf3-ab6e-93f5f4fd9fea",
                                "text": "„Der 18LochGolfplatz, Tauchzentren rund um ruhige Korallenriffe, Unterhaltungs und Shoppingmeilen, eingerahmt von Restaurantvielfalt und Gourmettempel, ziehen Winterflüchtlinge, Rentiers und Skipper auf Weltreise magisch an.“"
                            },
                            {
                                "example_id": "c95f9aab-37a8-4440-af1a-e7dbdf6a7235",
                                "sense_id": "0f633137-b350-3cf3-ab6e-93f5f4fd9fea",
                                "text": "„»So ein Gourmettempel mit viel Chichi wird mich niemals von innen sehen. Stofftischdecken, blankes Kristall, Deko – das ist nicht meins.« “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
