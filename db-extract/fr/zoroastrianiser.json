                        "glosses": [
                            "Donner un caractère zoroastrien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42e28583-1f38-4cbe-9aae-822264d08cad",
                                "sense_id": "4651ce9e-1ef7-3191-8a94-3e252f0f523c",
                                "text": "Kartīr aura-t-il réussi à le « zoroastrianiser » complètement et définitivement?"
                            },
                            {
                                "example_id": "16119561-b2fc-4179-aec1-48e073cfb079",
                                "sense_id": "4651ce9e-1ef7-3191-8a94-3e252f0f523c",
                                "text": "Avec la théologie zervanite, le culte d’Anâhita est aussi prépondérant (Arsak, Ectabane, Suse, Kengavar, Pstakhr, Arménie, Cappadoce), et le sanctuaire des mages à Shîz (Médie atropatène), bien que zoroastrianisé, se voit dédié à la déesse."
                            }
                        ]
                    }
