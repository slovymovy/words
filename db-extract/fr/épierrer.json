                ],
                "senses": [
                    {
                        "sense_id": "a2abba83-1fa1-351a-8d37-89afcaf84c83",
                        "entry_id": "273c9d07-87de-3fba-8835-2cd298d2d27f",
                        "glosses": [
                            "Débarrasser un terrain des pierres qui empêchent qu’on ne le cultive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ebd984-cb0d-480a-a05d-f1efc9632f37",
                                "sense_id": "a2abba83-1fa1-351a-8d37-89afcaf84c83",
                                "text": "J’avais épierré des pièces entières, défriché des coins broussailleux, divisé des haies trop larges et creusé des mares dans les champs qui en étaient dépourvus."
                            },
                            {
                                "example_id": "2f9bf379-2e00-4c95-bcae-e897a27b3f83",
                                "sense_id": "a2abba83-1fa1-351a-8d37-89afcaf84c83",
                                "text": "Piocher, bêcher, arracher des ajoncs, épierrer une lande, c’est bon pour les idées, les idées qu’on se fait dès qu’on tricote, dès qu’on se met à coudre."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dcded2e-78f2-3878-afbc-c4aa98ed0389",
                        "entry_id": "273c9d07-87de-3fba-8835-2cd298d2d27f",
                        "glosses": [
                            "Ôter les pierres d'un minerai."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "1dce5287-6158-4cd3-b422-cc046ddbbc54",
                                "sense_id": "0dcded2e-78f2-3878-afbc-c4aa98ed0389",
                                "text": "Jusqu'à présent, les grosses catégories de charbons — celles dont le calibre est supérieur à 80 ou au plus 150 mm. — sont épierrées à la main."
                            }
                        ]
                    }
                ],
