                ],
                "senses": [
                    {
                        "sense_id": "bd107c5d-410f-3428-ad21-5cc63bbd16c6",
                        "entry_id": "11b50f3c-eee6-33fe-822e-1debf6cebf09",
                        "glosses": [
                            "związany z saniami: odbywający się saniami, nadający się do jazdy saniami"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2f927570-60c6-4ae9-8f28-7c3cb70d7212",
                                "sense_id": "bd107c5d-410f-3428-ad21-5cc63bbd16c6",
                                "text": "Trzeba czekać sannej drogi."
                            },
                            {
                                "example_id": "9a902e12-917d-4a04-bae4-f9e9864775c8",
                                "sense_id": "bd107c5d-410f-3428-ad21-5cc63bbd16c6",
                                "text": "(…) wszystkich było ich coś oprócz wozowych ludzi, wozów sannych z leguminą i towarami, około 40."
                            },
                            {
                                "example_id": "2824cbc8-bc2d-4271-8170-9463970950e4",
                                "sense_id": "bd107c5d-410f-3428-ad21-5cc63bbd16c6",
                                "text": "Miłość gorąca, sanna droga, krogulcze pole – niedługo trwają – jak mówi przysłowie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cb1978bb-a1a3-32be-8de2-ba8c05a02331",
                "word": "sanny",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bed88daa-408e-3c47-9b22-9cf7f818f085",
                        "entry_id": "cb1978bb-a1a3-32be-8de2-ba8c05a02331",
                        "glosses": [
                            "lp zob. sanna"
                        ],
                        "tags": [
                            "genitive"
                        ],
                        "examples": [
                            {
                                "example_id": "905af638-861a-4815-9c73-b7496449bc21",
                                "sense_id": "bed88daa-408e-3c47-9b22-9cf7f818f085",
                                "text": "Moi mili barankowie, pojedziecie dziś czołem bić, potem zaś umówiliśmy się z dziewczyną, że do Mitrunów wszyscy wyruszymy, aby sanny w lasach zażyć i tę trzecią majętność obaczyć."
                            },
                            {
                                "example_id": "1e630852-f61f-45ab-bdf1-0ddec6bf5144",
                                "sense_id": "bed88daa-408e-3c47-9b22-9cf7f818f085",
                                "text": "Sami zaś wpakowawszy się na sanki albo gdy sanny nie było, na kolaski, karety, wózki (…), jak kto mógł, jachali do sąsiada pobliższego ani proszeni od niego, ani przestrzegłszy go, żeby się im nie skrył albo nie ujechał z domu."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
