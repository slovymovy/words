                                    {
                                        "sense_id": "69037ba7-01ec-3971-844b-827cf5f9e6db",
                                        "entry_id": "d38d5919-1332-39ef-a2b7-cdf6dc2bbc9f",
                                        "glosses": [
                                            "In an unspeakable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1a1883-0f9e-4101-9ef3-b10d96202820",
                                                "sense_id": "69037ba7-01ec-3971-844b-827cf5f9e6db",
                                                "text": "My point is that we shouldn't be too hard on the Star, the unspeakably vile supermarket tabloid that has been trying to dirty up Governor Bill Clinton."
                                            },
                                            {
                                                "example_id": "6a628095-e598-4fc0-b92c-4a7be7ab6abc",
                                                "sense_id": "69037ba7-01ec-3971-844b-827cf5f9e6db",
                                                "text": "\"The Japanese imperialists enforced the harshest colonial rule in history over Korea, bringing unspeakably horrible misfortune and sufferings and disasters to the Korean nation,\" said a spokesman for the Central Committee of the Democratic Front for the Reunification of Korea, according to the state-run Korean Central News Agency."
                                            },
                                            {
                                                "example_id": "819a5421-fd99-4013-b7aa-e0f5009991f1",
                                                "sense_id": "69037ba7-01ec-3971-844b-827cf5f9e6db",
                                                "text": "Last July, a federal appeals court said that Tsarnaev will remain in prison for the rest of his life for “unspeakably brutal acts,” but that he should be given a new penalty-phase trial, citing jury selection issues and a failure to properly screen jurors for bias."
                                            }
                                        ]
                                    }
