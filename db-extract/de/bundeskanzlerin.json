                        "form": "die Bundeskanzlerin"
                    },
                    {
                        "form_id": "f45be2d9-409e-448e-b44b-1bf2d23cff1d",
                        "entry_id": "437149f3-fda6-35ac-85c5-d56ebb2c4562",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bundeskanzlerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aec4c732-cf01-32a1-8c1e-a30b255cd02d",
                        "entry_id": "437149f3-fda6-35ac-85c5-d56ebb2c4562",
                        "glosses": [
                            "Regierungschefin der Bundesrepublik Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8503fdb-ab4e-4c32-9a6c-b4820a5b1169",
                                "sense_id": "aec4c732-cf01-32a1-8c1e-a30b255cd02d",
                                "text": "Die Bundeskanzlerin wird vom Bundestag gewählt."
                            },
                            {
                                "example_id": "26b914e9-1894-4778-9b5e-7960d5ae08d9",
                                "sense_id": "aec4c732-cf01-32a1-8c1e-a30b255cd02d",
                                "text": "„Wie sich unsere Bundeskanzlerin dem Land meiner Vorfahren gegenüber verhält, ist mehr als enttäuschend.“"
                            },
                            {
                                "example_id": "be4faed3-dc49-4cef-bae1-5e5b3ce71dbf",
                                "sense_id": "aec4c732-cf01-32a1-8c1e-a30b255cd02d",
                                "text": "„Deutschland hat eine Bundeskanzlerin, einen fast weiblichen Außenminister und eine Familienministerin, die während ihrer Amtszeit zur Freude des Volkes schwanger wurde.“"
                            },
                            {
                                "example_id": "90ba4bf8-3168-48ab-bba4-9ee8adab1244",
                                "sense_id": "aec4c732-cf01-32a1-8c1e-a30b255cd02d",
                                "text": "„Angela Dorothea Merkel […] ist eine ehemalige deutsche Politikerin (CDU). Sie war vom 22. November 2005 bis zum 8. Dezember 2021 achter Bundeskanzler und als Frau die erste Bundeskanzlerin der Bundesrepublik Deutschland.“"
                            },
                            {
                                "example_id": "31f1db41-43db-4f8a-9f40-45ace2730d76",
                                "sense_id": "aec4c732-cf01-32a1-8c1e-a30b255cd02d",
                                "text": "„Ebenso viele sagten 2005 voraus, dass es noch Jahrzehnte dauern würde, bis Deutschland eine Bundeskanzlerin hat, oder 2008, dass in den USA niemals ein Schwarzer Päsident werden könne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0dd07c7-fb7e-3bef-b101-90d23d253774",
                        "entry_id": "437149f3-fda6-35ac-85c5-d56ebb2c4562",
                        "glosses": [
                            "Regierungschefin der Republik Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "629e531d-06c7-45ea-914d-76510d06fa58",
                                "sense_id": "e0dd07c7-fb7e-3bef-b101-90d23d253774",
                                "text": "„Brigitte Bierlein […] ist eine österreichische Juristin, ehemalige Verfassungsrichterin und Politikerin (parteilos). Sie war vom 3. Juni 2019 bis zum 7. Jänner 2020 Bundeskanzlerin der Republik Österreich und damit die erste Frau in diesem Amt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "db831037-fedf-3927-930f-872b52134125",
                        "entry_id": "437149f3-fda6-35ac-85c5-d56ebb2c4562",
                        "glosses": [
                            "Leiterin der Bundeskanzlei in der Schweiz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f295e93-9426-4162-b18c-b993151d4c43",
                                "sense_id": "db831037-fedf-3927-930f-872b52134125",
                                "text": "Die Bundeskanzlerin in der Schweiz leitet die Bundeskanzlei."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
