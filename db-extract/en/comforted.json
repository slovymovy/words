                        "entry_id": "c72e520b-d587-32b3-b417-b1f4ac76c415",
                        "glosses": [
                            "Having been soothed or comforted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10916fe6-41ee-450e-9fa5-9ff7ae5adcbe",
                                "sense_id": "d7f85b84-7e2e-3859-a0c4-ff7f51946c75",
                                "text": "I also felt very comforted knowing that you were consistently calling the hospital to check on me during my stay at the hospital."
                            },
                            {
                                "example_id": "325091bd-9a44-4967-9232-7d71f4b0d51a",
                                "sense_id": "d7f85b84-7e2e-3859-a0c4-ff7f51946c75",
                                "text": "To summarize: on the average, rightists are made more anxious by ambiguity and have a stronger need for closure, dislike novelty, are more comforted by structure and hierarchy, more readily perceive circumstances as threatening, and are more parochial in their empathy."
                            },
                            {
                                "example_id": "8e45fc34-3d63-490f-b6d3-8a6fe4bdd0ef",
                                "sense_id": "d7f85b84-7e2e-3859-a0c4-ff7f51946c75",
                                "text": "I'm afraid I can't be very comforted by the thought that people I love are in a better place."
                            }
                        ]
                    }
