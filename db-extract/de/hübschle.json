                "senses": [
                    {
                        "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                        "entry_id": "d952b8dd-a5f9-3187-a01e-cd643e90c335",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6161697-989f-465c-bac4-4945c7050008",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Frau Hübschle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "503bf697-3c33-4c59-81c9-a9ceb3ed085e",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Herr Hübschle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "939beb90-0db3-4ef6-94d3-0de6cfecd0d2",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Die Hübschles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e18daed9-488d-4ccb-9b1b-0189123524ef",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Der Hübschle trägt nie die Schals, die die Hübschle ihm strickt."
                            },
                            {
                                "example_id": "067618a1-ead9-40c6-af9c-810106f1cb92",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hübschle kommt, geht der Herr Hübschle.“"
                            },
                            {
                                "example_id": "ef78dc75-472a-4236-bb14-52e28b0d724d",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Hübschle kommt und geht."
                            },
                            {
                                "example_id": "50ad8cdd-d70d-4687-aa7e-431448d3922e",
                                "sense_id": "6503783b-0666-3149-9c66-88190e9984f8",
                                "text": "Hübschles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
