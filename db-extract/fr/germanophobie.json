                                        "entry_id": "a269c412-ba67-37af-973e-ade36893ebba",
                                        "glosses": [
                                            "Alternative form of Germanophobia."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db8afd56-07fa-46fb-8cbd-8f730130578f",
                                                "sense_id": "3af8e467-4152-38ea-a317-1d5fdd27fc89",
                                                "text": "We sincerely regret that the statesmen in Britain and France are suffering from virulent germanophobia."
                                            },
                                            {
                                                "example_id": "ff68df32-e05d-4fdd-a377-777aa0ccaec2",
                                                "sense_id": "3af8e467-4152-38ea-a317-1d5fdd27fc89",
                                                "text": "I don't know how I managed to square this most wonderful of institutions with my deep-seated germanophobia."
                                            },
                                            {
                                                "example_id": "30b6c784-93d0-4cc9-b13b-1bba97a151ac",
                                                "sense_id": "3af8e467-4152-38ea-a317-1d5fdd27fc89",
                                                "text": "Perhaps the chink in Kroenig's argument is his search for germanophobia."
                                            }
                                        ]
                                    }
