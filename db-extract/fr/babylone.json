                                    },
                                    {
                                        "sense_id": "eeef6bd3-23a6-3d5c-9850-92006aedd6df",
                                        "entry_id": "5f8172f5-3d89-34ea-99ea-495a79ace5b6",
                                        "glosses": [
                                            "The police."
                                        ],
                                        "tags": [
                                            "Jamaica",
