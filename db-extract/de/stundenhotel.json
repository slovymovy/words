                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hôtel de passe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91303397-d699-3284-91df-085d44e397d2",
                                        "entry_id": "ee1c5d26-0faf-3943-b36d-bd126d472561",
                                        "glosses": [
                                            "Établissement hôtelier où se pratique la prostitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d6b5b0-3d4b-4dbb-b7c9-f851b6e0b8e9",
                                                "sense_id": "91303397-d699-3284-91df-085d44e397d2",
                                                "text": "Dans ma rue, il y a une boulangerie, une épicerie, une laverie, un traiteur chinois, un café-tabac, un hôtel de passe et une bouquinerie."
                                            },
                                            {
                                                "example_id": "be85c63d-cd2a-4311-adcb-09ef99096656",
                                                "sense_id": "91303397-d699-3284-91df-085d44e397d2",
                                                "text": "Le Sphinx, le Chabanais, le One-Two-Two disparurent à jamais, mais aussi les maisons d’abattage dont les propriétaires s’empressèrent d’ouvrir, sur des rues entières, des hôtels de passe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
