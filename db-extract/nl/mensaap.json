                    {
                        "translation_id": "41cf1f6b-c7f4-49c4-a665-f10bacddeab7",
                        "source_entry_id": "f53405b4-eec0-3866-822e-82783794c947",
                        "source_sense_id": "e5717021-0151-374f-83dc-75a6a5b6e0ad",
                        "source_sense_description": "een gemeenschappelijke naam voor dieren uit de orde van de primaten",
                        "target_lang_word": "Menschenaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "242a441b-d3b4-3b29-abd8-696ec5688536",
                                        "entry_id": "0c3322e9-db47-3798-bc4c-cd625fbe5384",
                                        "glosses": [
                                            "die Tierfamilie der Hominidae (deutsch: Menschenaffen); dem Menschen biologisch ähnlicher Affe, der sich besonders dadurch auszeichnet, dass ihm ein Schwanz als Balanceorgan fehlt und der gewissermaßen als Ersatz eine hohe Gelenkigkeit seiner Extremitäten für das Baumhangeln ausgebildet hat"
                                        ],
                                        "tags": [
                                            "Zoologische Taxonomie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1cbe9ed-9257-476a-9932-276b56f944eb",
                                                "sense_id": "242a441b-d3b4-3b29-abd8-696ec5688536",
                                                "text": "„Worin unterscheiden sich die Menschenaffen von anderen Primaten? Sie alle haben keinen Schwanz. Rumpf und Gliedmaßen müssen darum neue Aufgaben übernehmen. Also verfügen Mensch und Menschenaffen über besonders gelenkige Gliedmaßen. …“"
                                            },
                                            {
                                                "example_id": "06e23d4d-aa41-4154-899b-ae0dc7017fd8",
                                                "sense_id": "242a441b-d3b4-3b29-abd8-696ec5688536",
                                                "text": "„Proconsul gilt als der erste unstrittige Menschenaffe. Er lebte vor 19 Millionen Jahren in Afrika. Er besaß offensichtlich keinen Schwanz mehr … Allerdings hatte er noch ein relativ kleines Gehirn und war in den Gelenken nicht so beweglich wie die modernen Arten.“"
                                            },
                                            {
                                                "example_id": "5cb64155-6ef1-48dd-b68b-ef5292905f1e",
                                                "sense_id": "242a441b-d3b4-3b29-abd8-696ec5688536",
                                                "text": "„Große Menschenaffen hingegegen sind ans Hangeln angepasst. Sie besitzen weniger Wirbel und eine starrere Wirbelsäule, die hilft, den Körper aufrechter zu halten. Ihre Gliedmaßen sind äußerst beweglich und die Hände sehr groß und kräftig.“"
                                            },
                                            {
                                                "example_id": "7eb9796e-d8ba-464b-8033-e80b34981326",
                                                "sense_id": "242a441b-d3b4-3b29-abd8-696ec5688536",
                                                "text": "„Anders als Hundsaffen besitzen die Menschenaffen oder Andropomorpha bzw. Hominoidea keinen Schwanz“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd525a3b-2a1e-31c7-a31a-8e6b9db81d4b",
                                        "entry_id": "0c3322e9-db47-3798-bc4c-cd625fbe5384",
                                        "glosses": [
                                            "ein Vertreter der Menschenaffen"
                                        ],
                                        "tags": [
                                            "im Singular"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cf0bea1-0c0d-46ac-ae65-a7cdc71aacd0",
