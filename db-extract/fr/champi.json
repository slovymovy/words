                            {
                                "example_id": "6ee5c45a-99bc-4673-8bf0-df5d5ff7c219",
                                "sense_id": "1369a5c1-a0f8-3f0b-8988-3bdc773acbb8",
                                "text": "Les champis en thérapie, ou quand planer soigne"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2676ca5-073b-40f8-bb27-c3325c074575",
                        "source_entry_id": "d2ba6e8c-3ab1-30f3-a275-15a028be6ce9",
                        "source_sense_id": "1369a5c1-a0f8-3f0b-8988-3bdc773acbb8",
                        "target_lang_word": "shroom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shroom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6831f06a-3d88-3ddc-bc2d-534151968b26",
                                        "entry_id": "60043752-81a1-307f-948b-24c2cb6c1e05",
                                        "glosses": [
                                            "A magic mushroom: a hallucinogenic fungus."
                                        ],
                                        "tags": [
                                            "plural-normally",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc3b466e-d441-45f4-96e8-06a9f9eeeb14",
                                                "sense_id": "6831f06a-3d88-3ddc-bc2d-534151968b26",
                                                "text": "Dosage: The typical amount of beginner “shroom” dosage ranges from 1.5 grams of dried shrooms for a mild experience, to 3.5 grams for an intense experience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                        "entry_id": "60043752-81a1-307f-948b-24c2cb6c1e05",
                                        "glosses": [
                                            "Any mushroom."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46de499e-6f65-446d-bccb-b4ee069aa751",
                                                "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                                "text": "To determine how much live protein may be occupying a shroom, try this test: […]."
                                            },
                                            {
                                                "example_id": "998d54c0-6fd4-4dd3-b8ca-68f58667d038",
                                                "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                                "text": "These succulent little shrooms from pop culture scholar Lena Lencek will drive everyone back for seconds."
                                            },
                                            {
                                                "example_id": "301be2f7-8cc5-44fb-9826-3f77b403ab1f",
                                                "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                                "text": "Shrooms—and I don’t mean the psychedelic kind—are one of those vegetables that you either love or hate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shroom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80ab5a61-9a6c-3829-916c-dbfed1814d41",
                                        "entry_id": "f44955aa-81a2-3cac-bcc1-4f175e95eb88",
                                        "glosses": [
                                            "To take magic mushrooms."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80cb7ff4-8aad-447d-820b-6a5c172de4c7",
                                                "sense_id": "80ab5a61-9a6c-3829-916c-dbfed1814d41",
                                                "text": "Not just because it was sophmoric^([sic]) and juvenile (which it surely was) but I was shrooming pretty heavily by now."
                                            },
                                            {
                                                "example_id": "174a0d80-0894-414a-a7c2-dd7b355f28d4",
                                                "sense_id": "80ab5a61-9a6c-3829-916c-dbfed1814d41",
                                                "text": "Just a few months ago I was in Amsterdam with two old friends from the Lahore art world. On a warm summer night we checked out some galleries and walked along the canals, whirring bicycles and shrooming teenagers passing us in the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "121969e8-490e-4d94-831a-863e41d31a70",
                        "source_entry_id": "d2ba6e8c-3ab1-30f3-a275-15a028be6ce9",
                        "source_sense_id": "1369a5c1-a0f8-3f0b-8988-3bdc773acbb8",
                        "target_lang_word": "magic mushroom",
