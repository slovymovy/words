                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gute Nacht, mein liebes <w>Sternchen</w>, schlaf gut und träum etwas Schönes!"
                        },
                        {
                            "text": "Sie nannte ihren kleinen Enkelsohn oft zärtlich ihr liebstes <w>Sternchen</w>."
