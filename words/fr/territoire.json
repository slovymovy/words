                    "frequency": "High",
                    "semantic_group_id": "espace_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de l'ordre surveillent attentivement les frontières du <w>territoire</w> national."
                        },
                        {
                            "text": "Cette nouvelle réglementation s'applique désormais sur l'ensemble du <w>territoire</w>."
                        }
                    ],
                    "common_phrases": [
                        "territoire national",
                        "territoire français",
                        "sur tout le territoire"
                    ]
                },
                {
                    "sense_id": "39dcf72f-0287-366c-89b1-8e4bc6feaf00",
                    "sense_definition": "Étendue de terre ou zone géographique plus ou moins précisément délimitée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les explorateurs ont traversé un vaste <w>territoire</w> inhabité pendant plusieurs semaines."
                        },
                        {
                            "text": "Une immense chaîne de montagnes traverse ce grand <w>territoire</w> sauvage."
                        }
                    ],
                    "synonyms": [
                        "contrée",
                        "zone",
                        "espace"
                    ],
                    "common_phrases": [
