                            {
                                "example_id": "5d69da47-85a4-4d90-bf2e-9b8b9e7db424",
                                "sense_id": "7bdd0e65-35e4-3b0d-ac16-4758d3440253",
                                "text": "„Als ein Kamelrudel vor ihm über die Straße humpelte, riss er das Steuer nach rechts, brach durch einen hölzernen Obststand und wirbelte ein Dutzend an Seilen hängende Bananenstauden in die Luft.“"
                            },
                            {
                                "example_id": "1a6db90f-6319-4e2e-9e53-282c0afab7bc",
                                "sense_id": "7bdd0e65-35e4-3b0d-ac16-4758d3440253",
                                "text": "„Der gelangweilt wirkende Verkäufer am Obststand wog die Tüte und klebte das Preisschild darauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
