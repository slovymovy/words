                "senses": [
                    {
                        "sense_id": "9b83026a-30b2-3a81-a791-0070f50ca2fe",
                        "entry_id": "23e08b73-6b4b-35fc-880e-ea18c1de3aac",
                        "glosses": [
                            "Stadt, die im Römischen Reich erbaut wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec19fdf0-04f5-4d97-a1c6-542ae6ef7e60",
                                "sense_id": "9b83026a-30b2-3a81-a791-0070f50ca2fe",
                                "text": "„Die ehemaligen Römerstädte Köln, Mainz, Worms, Speyer, Straßburg und Basel gewannen wirtschaftliche Bedeutung, seit der Warenaustausch mit Italien nicht mehr hauptsächlich über Marseille und Fos auf dem Seeweg, sondern immer mehr über die Alpenpässe abgewickelt wurde.“"
                            },
                            {
                                "example_id": "08587a6d-b035-4566-a69a-2bac657c5dfd",
                                "sense_id": "9b83026a-30b2-3a81-a791-0070f50ca2fe",
                                "text": "„Selbst als die Germanen etwa ab dem 3. Jahrhundert die Römerstädte bedrängten, geschah das nicht mit der Absicht, römische Verwaltungseinrichtungen oder Machtbasen zu übernehmen, sondern lediglich mit der Zielsetzung, germanische Handelszentren auszubauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
