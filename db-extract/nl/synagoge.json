                        ],
                        "examples": [
                            {
                                "example_id": "952d98bb-5656-413e-bab5-92922081a7bc",
                                "sense_id": "61e70074-0245-3284-9516-cc4a426ce19d",
                                "text": "Van protestants tot katholiek, pinkstergemeenschappen, synagogen en oecumenische vieringen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8439c992-d715-4752-a9ea-b1219042003e",
                        "source_entry_id": "debd5715-59ee-3a85-958a-6de693efbeaf",
                        "source_sense_id": "ba280728-0cda-3fc6-984e-9027036b65e4",
                        "source_sense_description": "gebedshuis van joden.",
                        "target_lang_word": "犹太教堂",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0968ba9a-8bbd-4b8e-8491-21e2239db4db",
                        "source_entry_id": "debd5715-59ee-3a85-958a-6de693efbeaf",
                        "source_sense_id": "ba280728-0cda-3fc6-984e-9027036b65e4",
                        "source_sense_description": "gebedshuis van joden.",
                        "target_lang_word": "Synagoge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Synagoge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                        "entry_id": "520c6dce-a90f-31ff-8bc5-7726da081dd1",
                                        "glosses": [
                                            "Ort (Raum oder Gebäude), an dem sich die jüdische Gemeinde zum Gebet und zur Unterweisung versammelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48871ac7-6999-4314-bacb-5a0116c5c083",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "In Deutschland müssen noch immer Synagogen polizeilich bewacht werden."
                                            },
                                            {
                                                "example_id": "cafa19a6-7819-4e1b-9b4a-7364f7fa8700",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Er hatte mit angesehen, wie völkische Truppen unter Führung des Standartenführers Klein aus Heilbronn den Ort besetzten, die Synagoge umstellten, den Gottesdienst - es war ein Samstag - unterbrachen. Sie trieben die Männer aus der Synagoge und schlossen die Frauen dort ein, ohne ihnen zu sagen, was weiter mit den Männern geschehen würde. Die Männer brachten sie aufs Rathaus und untersuchten sie »auf Waffen«. Warum die Männer zum samstäglichen Gottesdienst in die Synagoge Waffen mitgenommen haben sollten, blieb unerfindlich.“"
                                            },
                                            {
                                                "example_id": "e6d44b96-3dd3-48ce-8a91-664c86c4482b",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Brandanschläge auf Synagogen und Ausländerheime, Morde an Obdachlosen und Ausländern haben die rechte Szene wieder ins Gespräch gebracht.“"
                                            },
                                            {
                                                "example_id": "3d80c89f-a0f4-48f8-9850-ee78c49e8570",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Ihr habt sie doch brennen sehen, die Synagogen, die Häuser, klirren hören die Fensterscheiben, splittern das Holz der Türen, Balken, die Schreie der Geschlagenen gehört, die Demütigungen, ach Vater, ihr habt es doch alle gewußt!“"
                                            },
                                            {
                                                "example_id": "f56bc9ff-2227-4a6a-8a98-0851a2a5e5df",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Der letzte Besuch einer Synagoge lag so weit zurück, daß sie sich nicht einmal mehr an das Jahr erinnern können.“"
                                            },
                                            {
                                                "example_id": "bc5501ed-0ace-4476-b994-c60a7fd9057f",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Auf dem Platz vor der Synagoge warteten Kutschen.“"
                                            },
                                            {
                                                "example_id": "270b78e1-4385-4aea-9380-23fa4a45eb30",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Ebenfalls aus der Synagoge stammen Fragmente der Bima mit Graffiti.“"
                                            },
                                            {
                                                "example_id": "44830892-6b13-4301-9152-f6785ce5fd3c",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "„Hier stand die größte Synagoge Warschaus, gebaut dann und dann, gesprengt dann und dann, dazu ein Foto.“"
                                            },
                                            {
                                                "example_id": "8af75a6e-c2b1-4e59-b5d0-ee2e10753b64",
                                                "sense_id": "302e0313-a255-3f5c-9861-5cc15e9aadd9",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „Insgesamt gab es in Deutschland 1 600 Synagogen (jüdische Gotteshäuser) und Beträume.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cdec052-b203-30f7-b2f7-ab578430dc38",
                                        "entry_id": "520c6dce-a90f-31ff-8bc5-7726da081dd1",
                                        "glosses": [
                                            "die an dem unter [1] beschriebenen Ort zusammenkommende, sich versammelnde jüdische Gemeinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609e32fb-99bc-46c5-860c-b1232395cb8c",
                                                "sense_id": "2cdec052-b203-30f7-b2f7-ab578430dc38",
                                                "text": "„Dort hat eine ganze Synagoge für mich gebetet.“"
                                            },
                                            {
                                                "example_id": "2c3270e0-5751-40e0-b781-f21f38c3ed78",
                                                "sense_id": "2cdec052-b203-30f7-b2f7-ab578430dc38",
                                                "text": "„Dann lief die Braut vorne beim Altar um eine Art Zelt herum, siebenmal, am Ende zertrat der Bräutigam Glasscherben, und die ganze Synagoge rief «Masel tov!» - viel Glück!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b571202c-f7cd-3d74-a1d9-91dde1c43526",
                                        "entry_id": "520c6dce-a90f-31ff-8bc5-7726da081dd1",
                                        "glosses": [
                                            "(die örtliche, religiöse) jüdische Gemeinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5253c886-3b08-4ed2-b730-5fe1176f4a86",
                                                "sense_id": "b571202c-f7cd-3d74-a1d9-91dde1c43526",
                                                "text": "„Jüdische Mitbürger blieben auch in Sötern nicht vor der Verfolgung durch die Nazis verschont. Die örtliche Synagoge wurde vernichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "08fd49f0-9ad7-3adb-8f2c-aa31a8f179ca",
                                        "entry_id": "520c6dce-a90f-31ff-8bc5-7726da081dd1",
                                        "glosses": [
                                            "Gesamtheit der jüdischen Kultusinstitution"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b0f1a02-b564-469f-8f44-eb2d954418eb",
                                                "sense_id": "08fd49f0-9ad7-3adb-8f2c-aa31a8f179ca",
                                                "text": "„Das Studium Descartes’ und der Naturwissenschaften vollendete den Bruch mit der Synagoge, den man umsonst durch Bestechung und Drohungen, ja durch einen Mordversuch zu hindern suchte.“"
                                            },
                                            {
                                                "example_id": "33f2b30e-b946-4e55-8eb2-f42a3d848668",
                                                "sense_id": "08fd49f0-9ad7-3adb-8f2c-aa31a8f179ca",
                                                "text": "„Historisch gesehen, hat der Tempeluntergang letztlich die Trennung zwischen Synagoge und Kirche befördert und verfestigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "aa63972b-2b61-3c42-a694-c7b1a304366e",
                                        "entry_id": "520c6dce-a90f-31ff-8bc5-7726da081dd1",
                                        "glosses": [
                                            "(zusammen mit der Ecclesia dargestellte) Allegorie des Alten Testaments, das heißt des Judentums, in Gestalt einer Frau mit verbundenen Augen, zerbrochenem Stab in der Hand und niederfallender Gesetzestafel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfb5d419-a4e5-4ecb-941d-ca7727521cd3",
                                                "sense_id": "aa63972b-2b61-3c42-a694-c7b1a304366e",
                                                "text": "„Seit dem 9. Jahrhundert versinnbildlichen Synagoge und Ecclesia in der christlichen Kunst das Verhältnis zwischen dem Alten und dem Neuen Bunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e179311b-ff69-4b2b-8f59-9cb209b2aece",
                        "source_entry_id": "debd5715-59ee-3a85-958a-6de693efbeaf",
                        "source_sense_id": "ba280728-0cda-3fc6-984e-9027036b65e4",
                        "source_sense_description": "gebedshuis van joden.",
                        "target_lang_word": "synagogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synagogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5cb77da-e7e1-364c-afa9-24d8f48b8485",
                                        "entry_id": "eb42b796-4ca5-3a9f-9a5f-c962da223a9e",
                                        "glosses": [
                                            "A place of worship for Jews or Samaritans."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c77ae9-2050-4bd2-ad66-8e37930bd40f",
                                                "sense_id": "d5cb77da-e7e1-364c-afa9-24d8f48b8485",
                                                "text": "On Tuesday, Netanyahu and his wife toured Shanghai’s Ohel Moshe synagogue in the Hongkou district that was home to many of the 18,000 Jews granted refuge in Shanghai from the horrors of Nazi persecution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5cf8ce-6707-3f85-b25d-b9fcf422dce1",
                                        "entry_id": "eb42b796-4ca5-3a9f-9a5f-c962da223a9e",
                                        "glosses": [
                                            "A congregation of Jews or Samaritans for the purpose of worship or religious study."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f7a1c80-5027-3a8c-ad32-725ddfcc6a5e",
                                        "entry_id": "eb42b796-4ca5-3a9f-9a5f-c962da223a9e",
                                        "glosses": [
                                            "Any assembly of folk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5bfd69-9039-4bd3-b49a-351c88db2e45",
                                                "sense_id": "7f7a1c80-5027-3a8c-ad32-725ddfcc6a5e",
                                                "text": "But when they come hither, and ſee a Tympany of Spanioliz’d Biſhops ſwaggering in the fore-top of the State, and meddling to turn and dandle the Royal Ball with unskilful and Pedantick Palms, no marvel though they think it as unſafe to commit Religion and Liberty to their arbitrating as to a Synagogue of Jeſuits."
                                            },
                                            {
                                                "example_id": "94a66f40-919e-454d-9c91-95adcabb062a",
                                                "sense_id": "7f7a1c80-5027-3a8c-ad32-725ddfcc6a5e",
                                                "text": "It is in this period that some Christian authors even refer to the “Synagogue of … Muhammad,” demonstrating the extent to which they perceive non-Christian groups as one and the same.¹¹¹"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4903cac-76ff-464c-9610-1514434c39c9",
                        "source_entry_id": "debd5715-59ee-3a85-958a-6de693efbeaf",
                        "source_sense_id": "ba280728-0cda-3fc6-984e-9027036b65e4",
