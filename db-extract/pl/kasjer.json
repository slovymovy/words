                                                "sense_id": "a4ece7a4-b9a9-3e70-b477-4ec6f00211ef",
                                                "text": "Peníze vám vyplatí náš pokladník."
                                            },
                                            {
                                                "example_id": "64c1ae22-138c-4f49-b83e-353b17d78cc4",
                                                "sense_id": "a4ece7a4-b9a9-3e70-b477-4ec6f00211ef",
                                                "text": "Pokladník vyřizuje hotovostní vyrovnání s klienty banky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
