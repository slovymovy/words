                "word": "corkage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "93e16e81-3fb5-4db0-982f-fe3e68d73cd4",
                        "entry_id": "cb49e55f-b944-37ed-8ba0-0591bd0d9401",
                        "tags": [
                            "plural"
                        ],
