                    "sense_definition": "Прекратить двигаться, перестать идти или ехать",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автобус <w>остановился</w> прямо перед нами.",
                            "target_lang_translations": {
                                "en": "The bus <w>stopped</w> right in front of us.",
                                "es": "El autobús se <w>paró</w> justo delante de nosotros.",
                                "fr": "L'autobus <w>s'est arrêté</w> juste devant nous.",
                                "nl": "De bus <w>stopte</w> vlak voor ons.",
                                "pl": "Autobus <w>zatrzymał się</w> tuż przed nami.",
                                "de": "Der Bus <w>hielt</w> direkt vor uns <w>an</w>.",
                                "it": "L'autobus <w>si è fermato</w> proprio davanti a noi.",
                                "cs": "Autobus <w>se zastavil</w> přímo před námi.",
                                "tr": "Otobüs tam önümüzde <w>durdu</w>.",
                                "zh": "公共汽车就在我们面前<w>停下</w>了。"
                            }
                        },
                        {
                            "text": "Ты должен <w>остановиться</w> у знака стоп.",
                            "target_lang_translations": {
                                "en": "You must <w>stop</w> at the stop sign.",
                                "es": "Tienes que <w>detenerte</w> en la señal de alto.",
                                "fr": "Tu dois <w>t'arrêter</w> au panneau stop.",
                                "nl": "Je moet <w>stoppen</w> bij het stopbord.",
                                "pl": "Musisz <w>zatrzymać się</w> przy znaku stop.",
                                "de": "Du musst am Stoppschild <w>anhalten</w>.",
                                "it": "Devi <w>fermarti</w> al segnale di stop.",
                                "cs": "Musíš <w>zastavit</w> u značky stop.",
                                "tr": "Dur tabelasında <w>durmalısın</w>.",
                                "zh": "你必须在停车标志前<w>停下</w>。"
                            }
                        }
                    ],
                    "synonyms": [
