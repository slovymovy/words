                ],
                "senses": [
                    {
                        "sense_id": "3ea5f93d-6e5d-3fae-9a65-9e65bdd1f0bb",
                        "entry_id": "1c456e0f-000c-3299-abae-c769242daa02",
                        "glosses": [
                            "Rendre moite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d2981a-8ed3-408c-a6be-48a8c4362058",
                                "sense_id": "3ea5f93d-6e5d-3fae-9a65-9e65bdd1f0bb",
                                "text": "Le bracelet moitissait sa peau sous le vieux cuir."
                            },
                            {
                                "example_id": "f0f0cdd5-bdd8-4fd9-8839-53e8fdba01d6",
                                "sense_id": "3ea5f93d-6e5d-3fae-9a65-9e65bdd1f0bb",
                                "text": "Une chaleur humide moitissait tout ; les pierres transpiraient, les granits avaient de l’humeur ; les rameaux les plus secs, le houx, le chardon, tout exhalait des senteurs puerpérales qui faisaient froncer les narines."
                            }
                        ]
                    },
                    {
                        "sense_id": "6defad48-575d-3c6d-818a-961e03b7a8e6",
                        "entry_id": "1c456e0f-000c-3299-abae-c769242daa02",
                        "glosses": [
                            "Mouiller, imbiber d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db02cc06-b061-494c-b097-8dbb80baed73",
                                "sense_id": "6defad48-575d-3c6d-818a-961e03b7a8e6",
                                "text": "— Nous pourrions commencer par l’enduire de notre salive, proposa Mican sans autre idée. …\n— J’y vais la première, dit Hila en moitissant la surface de la porte à différents endroits afin de déceler le symbole triangulaire."
                            }
                        ]
                    },
