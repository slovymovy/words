                "senses": [
                    {
                        "sense_id": "f37b4332-b0fd-39c6-84a5-ff54c0b830b8",
                        "entry_id": "7fa9728a-148b-3440-8d5b-2398e87bb089",
                        "glosses": [
                            "Faire devenir archidémocratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92135186-1ace-496e-9afc-4910eaa89c3c",
                                "sense_id": "f37b4332-b0fd-39c6-84a5-ff54c0b830b8",
                                "text": "Qu'on aime ou pas, Facebook a eu le mérite d'archi-démocratiser le jeu vidéo, même si c'est pas le jeu vidéo qu'affectionnent les purs gamers."
                            },
                            {
                                "example_id": "c47b938c-13b4-40bb-bb9a-29137f0515a8",
                                "sense_id": "f37b4332-b0fd-39c6-84a5-ff54c0b830b8",
                                "text": "Juste un aparté pour dire que voila, ça-y-est, le roller s'est archi-démocratisé, une véritable industrie s'est développée autour de cette pratique et me voici parée de la tête aux pieds pour aller rouler."
                            },
                            {
                                "example_id": "62eb09ca-f7f1-4101-b279-f1b576032a12",
                                "sense_id": "f37b4332-b0fd-39c6-84a5-ff54c0b830b8",
                                "text": "Mais le vin était archi-démocratisé, il y avait des tavernes tous les 10 mètres."
                            }
                        ]
                    }
