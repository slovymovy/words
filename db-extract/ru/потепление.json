                                        "sense_id": "633cdd7f-97b4-3704-9a2e-878c6ba87aaa",
                                        "entry_id": "90c27e62-27be-3f84-822e-882cc81f60f1",
                                        "glosses": [
                                            "A small rise in temperature."
                                        ],
                                        "tags": [],
