                        "se casser la jambe"
                    ]
                },
                {
                    "sense_id": "87937b11-efec-37c4-abbe-433e6c1657cb",
                    "sense_definition": "Partie du membre inférieur humain située spécifiquement entre le genou et la cheville.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur de football a reçu un coup violent sur le devant de la <w>jambe</w>."
                        },
                        {
                            "text": "Ces bottes montent jusqu'au milieu de la <w>jambe</w> pour bien protéger du froid."
                        }
                    ]
                },
                {
                    "sense_id": "8f270fb2-6867-344e-8a78-4772c2c5a58b",
                    "sense_definition": "Membre locomoteur de certains animaux, en particulier du cheval.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vétérinaire a examiné attentivement les quatre <w>jambes</w> du cheval blessé."
                        },
                        {
                            "text": "Le poulain a encore du mal à tenir debout sur ses longues <w>jambes</w> fragiles."
