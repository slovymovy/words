                    {
                        "translation_id": "4b66b2cb-9f65-42ec-bf8e-dc4f36d26cf3",
                        "source_entry_id": "de75fe91-2972-33c6-b534-7898113136ba",
                        "source_sense_id": "2bee9d84-3c27-3d81-bdfa-5b2d9cd6a63b",
