                        "examples": [
                            {
                                "example_id": "8ba2d46e-1791-49f9-9404-4032bc85b292",
                                "sense_id": "5609d0c9-f15e-35b8-a66d-e9b98fa2e412",
                                "text": "De gemeente Zutphen kreeg de afgelopen weken veel adhesiebetuigingen binnen, nadat bekend was geworden dat het gezin gedwongen moest vertrekken. Dat aantal verveelvoudigde volgens de gemeente na het nieuws over het kinderpardon dat wellicht binnenkort van kracht wordt."
                            },
                            {
                                "example_id": "ed4d8ea1-8af7-42f1-b686-213bd3b7d4c6",
                                "sense_id": "5609d0c9-f15e-35b8-a66d-e9b98fa2e412",
                                "text": "Het echtpaar is onzeker over de toekomst. De tijd die hen nog rest bij De Meridiaan willen ze er het beste van maken. De adhesiebetuigingen veranderen niets aan de situatie, blijkt uit een reactie van bibliotheekdirecteur Gert-jan Sweep. \"De steunbetuigingen zijn mooi voor het echtpaar. Het bibliotheekbestuur heeft weloverwogen een besluit genomen.\""
                            }
                        ]
                    }
