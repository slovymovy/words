{
    "word_family": [
        "slushy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58a2ae2d-9a3e-3828-8b51-584560d72b94",
                    "sense_definition": "Partially melted snow or ice, typically found on the ground.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The streets were covered in <w>slush</w> after the heavy snowstorm began to melt.",
                            "target_lang_translations": {
                                "ru": "После того как сильный снегопад начал таять, улицы покрылись <w>слякотью</w>."
                            }
                        },
                        {
                            "text": "Walking through the <w>slush</w> made my boots completely wet and cold.",
                            "target_lang_translations": {
                                "ru": "Из-за ходьбы по <w>слякоти</w> мои ботинки стали совершенно мокрыми и холодными."
                            }
                        }
                    ],
                    "synonyms": [
                        "slush ice"
                    ],
                    "common_phrases": [
                        "melting slush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частично растаявший снег или лед, обычно находящийся на земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слякоть",
                                "target_lang_sense_clarification": "жидкая грязь, образующаяся от таяния снега"
                            },
                            {
                                "target_lang_word": "снежная каша",
                                "target_lang_sense_clarification": "разговорное описание тающего снега на дорогах"
                            },
                            {
                                "target_lang_word": "шуга",
                                "target_lang_sense_clarification": "мелкий рыхлый лед, смешанный с водой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6739c14c-be42-364b-a1d0-52911f8a0891",
                    "sense_definition": "A cold drink made of flavored shaved ice.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a hot summer day, nothing is better than a cold fruit <w>slush</w>.",
                            "target_lang_translations": {
                                "ru": "В жаркий летний день нет ничего лучше холодного фруктового <w>слаша</w>."
                            }
                        },
                        {
                            "text": "The children enjoyed drinking a sweet <w>slush</w> while walking in the park.",
                            "target_lang_translations": {
                                "ru": "Дети с удовольствием пили сладкий <w>слаш</w>, гуляя в парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "slushy",
                        "slushie",
                        "slurpee",
                        "Slurpee",
                        "slush puppy",
                        "Slush Puppie"
                    ],
                    "common_phrases": [
                        "fruit slush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Холодный напиток из ароматизированного колотого льда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слаш",
                                "target_lang_sense_clarification": "заимствованное название десертного напитка из ледяной крошки"
                            },
                            {
                                "target_lang_word": "фруктовый лед",
                                "target_lang_sense_clarification": "близкий по смыслу десерт, хотя чаще в форме мороженого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ad03167-50c0-3955-8910-dd1f96987a3c",
                    "sense_definition": "A mixture of mud and water.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weather_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain turned the dirt path into thick <w>slush</w>.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь превратил грунтовую дорожку в густую <w>жижу</w>."
                            }
                        },
                        {
                            "text": "The hikers struggled to walk through the deep <w>slush</w> after the storm.",
                            "target_lang_translations": {
                                "ru": "Туристам было трудно идти по глубокой <w>жиже</w> после шторма."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь грязи и воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жижа",
                                "target_lang_sense_clarification": "жидкая, неприятная на вид грязь"
                            },
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "общее название для размокшей земли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0675b2b-ec5c-31bd-8d21-fcdb10398bfc",
                    "sense_definition": "Unsolicited manuscripts submitted to a publisher.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor spent hours reading through the <w>slush</w> pile looking for new talent.",
                            "target_lang_translations": {
                                "ru": "Редактор часами просматривал <w>самотёк</w> в поисках новых талантов."
                            }
                        },
                        {
                            "text": "Most books in the <w>slush</w> pile are never accepted for publication.",
                            "target_lang_translations": {
                                "ru": "Большинство книг из <w>самотёка</w> никогда не принимаются к публикации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slush pile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невостребованные рукописи, присланные в издательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самотёк",
                                "target_lang_sense_clarification": "издательский термин для обозначения рукописей, присланных авторами без приглашения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ea9cf77-48df-3116-ad1f-2dde4c5e9a86",
                    "sense_definition": "To walk or move through a wet, muddy, or snowy substance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>slush</w> through the deep snow to reach the cabin.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>брести</w> по глубокому снегу, чтобы добраться до хижины."
                            }
                        },
                        {
                            "text": "The tired hikers <w>slush</w> along the muddy trail after the rain.",
                            "target_lang_translations": {
                                "ru": "Уставшие туристы <w>брели</w> по грязной тропе после дождя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slush along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти или передвигаться по мокрой, грязной или снежной субстанции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести по слякоти",
                                "target_lang_sense_clarification": "медленное передвижение через вязкую массу"
                            },
                            {
                                "target_lang_word": "чавкать",
                                "target_lang_sense_clarification": "о звуке шагов по грязи или талому снегу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}