                "senses": [
                    {
                        "sense_id": "f3a49c16-69f3-35a7-80b1-1fb2f3bdcca8",
                        "entry_id": "b38ed2e4-b701-3e9e-b50e-957db9b0fdbb",
                        "glosses": [
                            "großer Raum (Halle), in dem Ausstellungen abgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af42d1d-20af-40cf-ae82-bdc6e825c7e0",
                                "sense_id": "f3a49c16-69f3-35a7-80b1-1fb2f3bdcca8",
                                "text": "„Wenig Chancen auf den 1. Preis hätten seinerzeit die Objekte des Formenspielers Jerszy Seymour gehabt, angesichts derer sich der eine oder andere Besucher fragen mag, warum diese Stücke Einlass in die Ausstellungshalle fanden.“"
                            },
                            {
                                "example_id": "4c3741f3-0a7d-4080-8fea-78b8dcad10bd",
                                "sense_id": "f3a49c16-69f3-35a7-80b1-1fb2f3bdcca8",
                                "text": "„Ein Vorhang im Halbrund dunkelt die Ausstellungshalle ab, es wirkt, als gelte es, einen eigenen Kosmos zu vermessen.“"
                            },
                            {
                                "example_id": "58250931-2d3c-4f03-9c07-ba30d1047f5f",
                                "sense_id": "f3a49c16-69f3-35a7-80b1-1fb2f3bdcca8",
                                "text": "„Die Sonne brach durch das Glasdach und rückte die Menschen in der Ausstellungshalle in Licht und Schatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
