                "senses": [
                    {
                        "sense_id": "425d0acd-aad8-385b-969e-796dada6260d",
                        "entry_id": "6b79ee39-de94-34f6-8e86-cf222916a2b8",
                        "glosses": [
                            "van een gelaat dat je er geen emotie vanaf kunt lezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589a28cb-561b-48c9-af27-443c5fbd690e",
                                "sense_id": "425d0acd-aad8-385b-969e-796dada6260d",
                                "text": "Op de theusualroutine.com vind je niet alleen maar goedkoop knip- en plakwerk van imitatienieuws dat Trump ophemelt of Hillary besmeurt, stellen de twintigers. Wel, zegt Zarkov, zorgvuldig bewerkte stukken over een breed scala aan onderwerpen. En, met uitgestreken gezicht: “Wij promoten geen dingen die niet waar zijn.”"
                            },
                            {
                                "example_id": "de13c9dc-a208-409c-a20f-6525e79a3988",
                                "sense_id": "425d0acd-aad8-385b-969e-796dada6260d",
                                "text": "Met uitgestreken gezicht probeerde ik nog van kamer te ruilen, maar het motel zat dat hele weekend vol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afd57f63-f4fb-4652-8b31-309f2147652f",
                        "source_entry_id": "6b79ee39-de94-34f6-8e86-cf222916a2b8",
                        "source_sense_id": "425d0acd-aad8-385b-969e-796dada6260d",
                        "target_lang_word": "demure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5df20a78-8d88-3dc1-a5e5-07a69f3c9324",
                                        "entry_id": "b9cde453-3aa5-3aca-91ca-3dccad1811c6",
                                        "glosses": [
                                            "Modest, quiet, reserved, or serious."
                                        ],
                                        "tags": [
                                            "of a woman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3df9ca0-929b-4c73-824b-1dbfe42fd7e4",
                                                "sense_id": "5df20a78-8d88-3dc1-a5e5-07a69f3c9324",
                                                "text": "She is a demure young lady."
                                            },
                                            {
                                                "example_id": "a239323a-dbf5-4aa8-b967-3793e8a0c44b",
                                                "sense_id": "5df20a78-8d88-3dc1-a5e5-07a69f3c9324",
                                                "text": "Nan was very much delighted in her demure way, and that delight showed itself in her face and in her clear bright eyes."
                                            },
                                            {
                                                "example_id": "1c3228e2-91c9-4647-8409-fa876e4d31de",
                                                "sense_id": "5df20a78-8d88-3dc1-a5e5-07a69f3c9324",
                                                "text": "I was coming back from the ladies' room when I saw her. She looked demure. Oval wire-rimmed glasses. A sky blue jacket buttoned over a long black-and-white flowered shirt."
                                            },
                                            {
                                                "example_id": "d0fdef54-fa85-46e5-bba4-4b1364ac15c8",
                                                "sense_id": "5df20a78-8d88-3dc1-a5e5-07a69f3c9324",
                                                "text": "[H]owever hard she pushed the tough-talkin' shtick, she remained doe-eyed, glowing and somehow unassailably demure."
                                            },
                                            {
                                                "example_id": "63c75e39-a70c-4315-9405-652665763224",
                                                "sense_id": "5df20a78-8d88-3dc1-a5e5-07a69f3c9324",
                                                "text": "And in their daily lives, girls and women are pushed to conform to fairly narrow templates of behavior as demure or delicate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd67165-f478-3eaf-a928-c72d205404a8",
                                        "entry_id": "b9cde453-3aa5-3aca-91ca-3dccad1811c6",
                                        "glosses": [
                                            "Affectedly modest, decorous, or serious; making a show of gravity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e807f2ff-e8c2-4e4a-be05-8795b2da2ce4",
                                                "sense_id": "6bd67165-f478-3eaf-a928-c72d205404a8",
                                                "text": "Miss Lizzy, I have no doubt, would be as demure and coquettish, as if ten winters more had gone over her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "177afb81-cbfa-391e-9eab-548ae360be7c",
                                        "entry_id": "ada8452b-c9f1-31a1-a18b-a977ae56b194",
                                        "glosses": [
                                            "To look demurely."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2147bf3b-dd0d-4b7d-a0e0-08769a41d9fe",
                                                "sense_id": "177afb81-cbfa-391e-9eab-548ae360be7c",
                                                "text": "Your Wife Octavia, with her modeſt eyes, / […] ſhall acquire no Honour / Demuring vpon me:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
