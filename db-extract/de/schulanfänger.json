                "senses": [
                    {
                        "sense_id": "be946e8e-bff5-3ddd-b56c-bc25e6f13818",
                        "entry_id": "f81226e4-a8ea-3744-ab85-0a9274987915",
                        "glosses": [
                            "Kind, das erstmals die Schule besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fa049fd-4577-4604-9926-ed2a97c5d788",
                                "sense_id": "be946e8e-bff5-3ddd-b56c-bc25e6f13818",
                                "text": "„Schulanfänger schreiben häufig spontan von rechts nach links oder malen einzelne Zeichen spiegelverkehrt.“"
                            },
                            {
                                "example_id": "21d41f09-c061-4e2f-8171-1ac70b6f3e77",
                                "sense_id": "be946e8e-bff5-3ddd-b56c-bc25e6f13818",
                                "text": "„Allmählich, etwa als Schulanfänger, lernt das Kind dann, sich in ein Regelspiel hineinzufinden.“"
                            },
                            {
                                "example_id": "fb922823-0350-4d4b-b030-d757707e606d",
                                "sense_id": "be946e8e-bff5-3ddd-b56c-bc25e6f13818",
                                "text": "„Der Wortschatz von Schulanfängern wird immer kleiner.“"
                            },
                            {
                                "example_id": "5f904a81-0efc-44ca-a00c-615ee9711b51",
                                "sense_id": "be946e8e-bff5-3ddd-b56c-bc25e6f13818",
                                "text": "„Deshalb will sie mit einer von ihr eingeholten positiven gutachtlichen Stellungnahme des Universitätsprofessors M zu ihrer Methode das Begabtenabitur machen und dann Erziehungswissenschaften studieren, um selbst einmal Schulanfänger mit Lese- und Schreibproblemen unterrichten zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
