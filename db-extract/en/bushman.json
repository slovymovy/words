    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dd466548-49d6-3bf9-9c05-4194bae1d64f",
                "word": "bushman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d64fa4e7-4c88-47ff-a97b-9c332eafc74c",
                        "entry_id": "dd466548-49d6-3bf9-9c05-4194bae1d64f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bushmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8720956c-29b9-36ae-bdcf-a656e2bb0030",
                        "entry_id": "dd466548-49d6-3bf9-9c05-4194bae1d64f",
                        "glosses": [
                            "A man who lives in or has extensive experience of the Australian bush or outback."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "b30fb2b1-16e9-4861-80db-b52d12be8f89",
                                "sense_id": "8720956c-29b9-36ae-bdcf-a656e2bb0030",
                                "text": "To A. B. Paterson, son of a dispossessed squatter, writing from a city office, the bushmen with their horses and simple skills were the backbone of Australia."
                            },
                            {
                                "example_id": "0df79b50-9e0a-4469-ae5b-a24b38e3624c",
                                "sense_id": "8720956c-29b9-36ae-bdcf-a656e2bb0030",
                                "text": "Its^([the Bulletin's]) writers shaped ‘a group myth about Australians and their destiny’; in the absence of conventional heroes, visiting the past to claim the bushman as the first ‘Australian’, the anti-hero in the struggles against empire."
                            },
                            {
                                "example_id": "ea0f1ac2-f927-4cb1-add5-184207b26418",
                                "sense_id": "8720956c-29b9-36ae-bdcf-a656e2bb0030",
                                "text": "Later, historian Russel Ward (1958) famously identified the outback bushman as the “typical” Australian – a rugged individualist, courageous and loyal to his mates."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1be6136-7a17-4c21-b00d-a3e491354cb7",
                        "source_entry_id": "dd466548-49d6-3bf9-9c05-4194bae1d64f",
                        "source_sense_id": "8720956c-29b9-36ae-bdcf-a656e2bb0030",
                        "source_sense_description": "Translations",
                        "target_lang_word": "broussard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broussard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95a66ff0-ad01-3f8b-84df-8cfcae1b17d8",
                                        "entry_id": "0bf238e8-66c3-32a5-97a3-45a61a0ad1f0",
                                        "glosses": [
                                            "Habitant de la brousse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd94a041-b816-47fb-a4e4-9e93b8437079",
                                                "sense_id": "95a66ff0-ad01-3f8b-84df-8cfcae1b17d8",
                                                "text": "Pour nombre d’africains citadins francophones, broussard est péjoratif, presque synonyme d'arriéré!"
                                            },
                                            {
                                                "example_id": "1601e265-b582-4948-89e3-a129bd77f742",
                                                "sense_id": "95a66ff0-ad01-3f8b-84df-8cfcae1b17d8",
                                                "text": "Un jour, un broussard vint en Land-Rover au restaurant."
                                            },
                                            {
                                                "example_id": "4a412632-92a3-42f4-b202-e51aaa1419b8",
                                                "sense_id": "95a66ff0-ad01-3f8b-84df-8cfcae1b17d8",
                                                "text": "Et « après quoi, vient le retour au poste, dans la maison, tout est à recommencer, puis ils faut réparer les dégâts causés par le voyage, c’est toute la vie de la broussarde »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671c75da-5201-3b16-87e1-49a62407e667",
                                        "entry_id": "0bf238e8-66c3-32a5-97a3-45a61a0ad1f0",
                                        "glosses": [
                                            "Caldoche vivant dans la brousse (hors de Nouméa et de sa banlieue) et menant une vie rurale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
