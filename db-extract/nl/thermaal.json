                        "sense_id": "2192993d-e3de-37e4-b74a-3ee5a3438bd4",
                        "entry_id": "e404044c-5db0-3185-83bf-3839b1d7a7fb",
                        "glosses": [
                            "afkomstig van bronnen waar warm water uit komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626fd518-f924-4eae-b121-f973c2f604c2",
                                "sense_id": "2192993d-e3de-37e4-b74a-3ee5a3438bd4",
                                "text": "Daarnaast neem ik ook altijd thermaal water mee om te verfrissen, maar ook een gezichtscrème, masker en vochtige doekjes. Alles wat je nodig hebt voor een doe-het-zelf gezichtsbehandeling."
                            },
                            {
                                "example_id": "97b269ee-1cfd-4007-94b1-3dfcabab0c3e",
                                "sense_id": "2192993d-e3de-37e4-b74a-3ee5a3438bd4",
                                "text": "Omdat ik niet zo goed ben in het reinigen van mijn huid ’s avonds, doe ik het ’s ochtends. Deze cleansing gel op basis van thermaal water is speciaal voor de droge en zeer gevoelige huid."
                            }
                        ]
                    }
