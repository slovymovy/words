                ],
                "senses": [
                    {
                        "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                        "entry_id": "dd5db8a8-acd1-3c80-914b-b68ce3b0b205",
                        "glosses": [
                            "Jude, der aus einem deutschsprachigen Land stammt und nach Palästina/Israel ausgewandert ist"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d8c71c4a-2cc4-4d64-849c-e00b8de5b8f5",
                                "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                "text": "„Auch gab es unter den Jeckes, also jenen aus Deutschland stammenden Juden, die sprachlich und kulturell ihrer einstigen Heimat verbunden geblieben waren, so manche, die sich bereitwillig auf einen Dialog mit diesen Besuchern einließen.“"
                            },
                            {
                                "example_id": "b989b198-5453-4496-b5a1-ce66fe8156fa",
                                "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                "text": "„Da Du-nour keine Jeckin war und daher nie erleben konnte, welche Sprache Jeckes verwenden, wenn sie ganz unter sich sind, ging sie davon aus, dass Jeckes immer bewusst hebräische Begriffe einfließen lassen beziehungsweise Code-Switching praktizieren, um ihr jeckisches Deutsch vom Deutsch der heutigen Deutschen abzugrenzen.“"
                            },
                            {
                                "example_id": "df3a335e-2b51-4be3-b0c7-c4a4310bc27c",
                                "sense_id": "a83af6e9-2aa7-3ed9-bfea-c999e61d6416",
                                "text": "„In Schwajim konnte man auf den ersten Blick das Zimmer eines Ostjuden vom Zimmer eines Jecken unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
