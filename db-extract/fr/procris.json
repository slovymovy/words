            {
                "entry_id": "6fd47a03-4fa5-3828-8d06-00c08db8db56",
                "word": "procris",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1626a05f-a4c7-359e-9d41-69ac42d26fa4",
                        "entry_id": "6fd47a03-4fa5-3828-8d06-00c08db8db56",
                        "glosses": [
                            "Espèce de petit papillon des prairies européennes et nord-africaines, au dessus ocre présentant, à l’apex des ailes antérieures, un ocelle noir cerclé de clair et centré par un point blanc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65200b8-e7ed-423b-928e-c31e2f89031b",
                                "sense_id": "1626a05f-a4c7-359e-9d41-69ac42d26fa4",
                                "text": "On trouve sur les bruyères un petit papillon qu’on nomme Procris."
                            },
                            {
                                "example_id": "e2301647-2a53-4281-83fe-bb5dce1e6c3d",
                                "sense_id": "1626a05f-a4c7-359e-9d41-69ac42d26fa4",
                                "text": "Petit et peu coloré, le procris n’en est pas moins aisément repérable sur le terrain, car il peut abonder en sites favorables, et il est alors facile de l’observer de près."
                            },
                            {
                                "example_id": "9ed8432a-4474-403f-84eb-f5238c23bfeb",
                                "sense_id": "1626a05f-a4c7-359e-9d41-69ac42d26fa4",
                                "text": "Le Procris ou Fadet commun (Coenonympha pamphilus) possède 1 point blanc dans l’ocelle noir des ailes antérieures et des petits points blanc en dessous des ailes."
                            }
                        ]
                    }
                ],
