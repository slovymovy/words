                {
                    "sense_id": "9b44eda2-8351-3ed7-b9c6-f0ee33d87c83",
                    "sense_definition": "Denken; een mening toegedaan zijn of veronderstellen dat iets zo is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "denken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>meent</w> dat hij recht heeft op een hoger salaris.",
                            "target_lang_translations": {
                                "en": "He <w>thinks</w> he is entitled to a higher salary.",
                                "ru": "Он <w>считает</w>, что имеет право на более высокую зарплату.",
                                "pl": "On <w>uważa</w>, że ma prawo do wyższej pensji.",
                                "de": "Er <w>meint</w>, dass er Anspruch auf ein höheres Gehalt hat.",
                                "fr": "Il <w>pense</w> qu'il a droit à un salaire plus élevé.",
                                "it": "Lui <w>ritiene</w> di avere diritto a uno stipendio più alto.",
                                "cs": "<w>Domnívá</w> se, že má nárok na vyšší plat.",
                                "tr": "Daha yüksek bir maaşı hak ettiğini <w>düşünüyor</w>.",
                                "es": "Él <w>piensa</w> que tiene derecho a un salario más alto.",
                                "zh": "他<w>认为</w>自己有权获得更高的薪水。"
                            }
                        },
                        {
                            "text": "Ik <w>meen</w> me te herinneren dat de winkel op zondag gesloten is.",
                            "target_lang_translations": {
                                "en": "I <w>think</w> I remember that the shop is closed on Sundays.",
                                "ru": "Мне <w>кажется</w>, я помню, что магазин закрыт по воскресеньям.",
                                "pl": "<w>Wydaje mi się</w>, że pamiętam, iż sklep jest w niedziele zamknięty.",
                                "de": "Ich <w>meine</w> mich zu erinnern, dass das Geschäft sonntags geschlossen ist.",
                                "fr": "Je <w>crois</w> me souvenir que le magasin est fermé le dimanche.",
                                "it": "<w>Credo</w> di ricordare che il negozio sia chiuso la domenica.",
                                "cs": "<w>Myslím</w>, že si vzpomínám, že je obchod v neděli zavřený.",
                                "tr": "Dükkanın pazar günleri kapalı olduğunu <w>hatırlar gibiyim</w>.",
                                "es": "<w>Creo</w> recordar que la tienda está cerrada los domingos.",
                                "zh": "我<w>觉得</w>我记得那家店周日是不营业的。"
                            }
                        }
                    ],
                    "synonyms": [
