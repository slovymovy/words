                                "example_id": "e6ddd5aa-d6f3-4af3-a3c2-6098b9835d13",
                                "sense_id": "2d05d40a-a3e0-3c5f-9bcc-ced2f7f86ea4",
                                "text": "„Der Volumenstrom der Zuluft durch die Lüftungsdecke ist abhängig vom Lüftungsbedarf des Stalles.“"
                            },
                            {
                                "example_id": "57b060ea-c1d1-49a4-ac64-6ec248b21e91",
                                "sense_id": "2d05d40a-a3e0-3c5f-9bcc-ced2f7f86ea4",
                                "text": "„Die Firma Oetjen GmbH ist seit vielen Jahren für ihre hohe Qualität in der Planung, Herstellung und der Montage ihrer Lüftungsdecken bekannt.“"
                            },
                            {
                                "example_id": "5d49c0d8-9545-4e6b-b1c3-0418e6b41214",
                                "sense_id": "2d05d40a-a3e0-3c5f-9bcc-ced2f7f86ea4",
                                "text": "„In der Küche des Hotel Landgrafen-Mühle in Wallhalbern bei Kaiserslautern zieht der Kochwrasen seit Kurzem durch eine moderne Lüftungsdecke aus Metall ab.“"
                            }
                        ],
