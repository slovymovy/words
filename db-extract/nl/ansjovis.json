                "senses": [
                    {
                        "sense_id": "e5f1af48-8c02-3032-8f48-4de93761a28f",
                        "entry_id": "5f676fb5-e220-3c97-aad5-e62334a982df",
                        "glosses": [
                            "bewerkte en gezouten kleine visjes uit de familie Engraulidae die vooral om hun smaak aan gerechten worden toegevoegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b57a713-74aa-4bd6-bbaa-b210ce92d1dd",
                                "sense_id": "e5f1af48-8c02-3032-8f48-4de93761a28f",
                                "text": "Want wat is het heerlijke van ceasar salad? Die intens hartige smaak van ansjovis en parmezaan, smeuïg gemaakt met ei en dan het contrast van de iets bittere frisse sla met de stevige croutons."
                            },
                            {
                                "example_id": "ea436b3d-d26f-4ef6-87f5-58b0f5ead3de",
                                "sense_id": "e5f1af48-8c02-3032-8f48-4de93761a28f",
                                "text": "Er is geen andere plek waar je ansjovis en condooms kunt kopen, of wat je ook nodig hebt."
                            },
                            {
                                "example_id": "d835f8e3-e684-4858-afa8-e44ffb61fa9d",
                                "sense_id": "e5f1af48-8c02-3032-8f48-4de93761a28f",
                                "text": "Straatmuzikanten stonden te spelen op het plein, te midden van tafels vol tapas van garnalen, ansjovis en aardappels."
                            }
                        ]
                    },
                    {
                        "sense_id": "93d9b635-a495-3156-9f5d-5677ebf67177",
                        "entry_id": "5f676fb5-e220-3c97-aad5-e62334a982df",
                        "glosses": [
                            "benaming voor klein haringachtige vissen uit de familie Engraulidae"
                        ],
                        "tags": [
                            "straalvinnigen"
                        ],
                        "examples": [
                            {
                                "example_id": "704aaa0b-be6a-4b7f-b0d1-a5886672fc9b",
                                "sense_id": "93d9b635-a495-3156-9f5d-5677ebf67177",
                                "text": "Volgens hen zijn de bijna 4500 pelikanen omgekomen door een gebrek aan een bepaald soort ansjovis."
                            }
                        ]
                    },
                    {
                        "sense_id": "46473a0a-d765-3a19-9853-b0badb12c67b",
                        "entry_id": "5f676fb5-e220-3c97-aad5-e62334a982df",
                        "glosses": [
                            "kleine haringachtige vis Engraulis encrasicolus die in de wateren rond Europa voorkomt"
                        ],
                        "tags": [
                            "pregnant",
                            "straalvinnigen"
                        ],
                        "examples": [
                            {
                                "example_id": "da1f9cd5-d39b-4879-abff-b3ee9eda1b9c",
                                "sense_id": "46473a0a-d765-3a19-9853-b0badb12c67b",
                                "text": "In Limburg telen ze de heilige boontjes, in de Oosterschelde zwemt ansjovis. Hoewel de Slow Food-beweging zich van oudsher vooral bekommert om het behoud van voedselculturen en -tradities, draait het ook om biodiversiteit en duurzame productie."
                            }
                        ]
                    }
                ],
