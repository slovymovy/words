                "senses": [
                    {
                        "sense_id": "0c1541c5-6fb7-39c8-a136-92de09a6c95b",
                        "entry_id": "f7c672a3-4610-33ec-8b1d-24545d2250b5",
                        "glosses": [
                            "heterotroph"
                        ],
                        "tags": [
                            "masculine",
                            "rare",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "b88f944d-e467-41ea-b6fc-4be66da84e0c",
                                "sense_id": "0c1541c5-6fb7-39c8-a136-92de09a6c95b",
                                "text": "Die Aufnahme fester und flüssiger Stoffe bei den Heterotrophen bezeichnet man gewöhnlich als Nahrungsaufnahme, die Aufnahme (und Abgabe) gasförmiger Stoffe als Atmung; hier soll zunächst die Nahrungsaufnahme besprochen werden.",
                                "translation": "The intake of solid and liquid substances in heterotrophs is commonly referred to as food intake, while the intake (and release) of gaseous substances is called respiration; here, food intake will be discussed first.",
                                "english": "The intake of solid and liquid substances in heterotrophs is commonly referred to as food intake, while the intake (and release) of gaseous substances is called respiration; here, food intake will be discussed first."
                            },
                            {
                                "example_id": "b4adedf3-2ad8-41fd-85c2-55d53919d2e9",
                                "sense_id": "0c1541c5-6fb7-39c8-a136-92de09a6c95b",
                                "text": "Bei den vielartigen Möglichkeiten der Autotrophen, CO₂ zu assimilieren, erschien es verwunderlich, daß den Heterotrophen diese Fähigkeit ganz verlorengegangen sein sollte.",
                                "translation": "Given the diverse possibilities of autotrophs to assimilate CO₂, it seemed surprising that heterotrophs should have completely lost this ability.",
                                "english": "Given the diverse possibilities of autotrophs to assimilate CO₂, it seemed surprising that heterotrophs should have completely lost this ability."
                            },
                            {
                                "example_id": "03a6b74b-9219-4188-938e-89a6d1bf4b85",
                                "sense_id": "0c1541c5-6fb7-39c8-a136-92de09a6c95b",
                                "text": "Der Mensch als ein Heterotroph versorgt sich mit freier Energie durch Verspeisen von anderen Lebewesen, phototropher und heterotropher.",
                                "translation": "As a heterotroph, humans obtain free energy by consuming other living organisms, both phototrophic and heterotrophic.",
                                "english": "As a heterotroph, humans obtain free energy by consuming other living organisms, both phototrophic and heterotrophic."
                            }
                        ]
                    }
                ],
