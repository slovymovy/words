                    {
                        "sense_id": "2801a9ec-0cb2-3853-8151-fd27c56ede2b",
                        "entry_id": "114f0645-6782-3983-aa9b-61807fdf6975",
                        "glosses": [
                            "een paal die langs wegen staat en waarop de afstand tot een bepaald startpunt is aangegeven uitgedrukt in kilometers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1c28c77-92ac-4198-9248-448f6368b16d",
                                "sense_id": "2801a9ec-0cb2-3853-8151-fd27c56ede2b",
                                "text": "De vier bouwden een maximale voorsprong op van vier minuten. Die werd kleiner toen de mannen van onder meer Movistar, van de uiteindelijke ritwinnaar Alejandro Valverde, zich op de kop van het peloton nestelden. Bij kilometerpaal 171 vond de hergroepering plaats. ,,Vanaf dat moment is het krachten sparen en het melkzuur losjes uit de benen trappen.’’"
                            },
                            {
                                "example_id": "f376b285-ac43-4a7f-b9ba-594122d9993d",
                                "sense_id": "2801a9ec-0cb2-3853-8151-fd27c56ede2b",
                                "text": "Vanaf kilometerpaal 1.200 zie je het landschap veranderen. De bush wordt groener, de temperatuur en de vochtigheidsgraad stijgen zienderogen, en hier en daar duiken termietenheuvels en palmbomen op: welkom in de savanne."
                            }
                        ]
                    }
