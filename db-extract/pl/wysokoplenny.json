                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77203177-4713-4010-93a8-b2f10399bfb5",
                                                "sense_id": "7f25e9ea-9fed-32b7-824a-57da7ad3317b",
                                                "text": "Die Geologen stießen auf eine ergiebige Ölquelle."
                                            }
