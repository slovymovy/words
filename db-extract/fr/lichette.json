                                "target_senses": [
                                    {
                                        "sense_id": "2e6563f2-e803-3536-8727-d3b6503cead0",
                                        "entry_id": "0defa31d-061d-346c-b226-7c3ec6bfee40",
                                        "glosses": [
                                            "A tiny amount; a little bit."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9df7c56-3035-4f34-9a09-4548bc1495f5",
                                                "sense_id": "2e6563f2-e803-3536-8727-d3b6503cead0",
                                                "text": "He added just a skosh of vinegar, to give the recipe some zip."
                                            },
                                            {
                                                "example_id": "0d8a2bd0-04bd-4bf5-8486-0951959a315b",
                                                "sense_id": "2e6563f2-e803-3536-8727-d3b6503cead0",
                                                "text": "“Fly just a skosh to your one o'clock,” Elroy said."
                                            },
                                            {
                                                "example_id": "eed50246-6fbf-4b22-b6f7-a6bd1b196932",
                                                "sense_id": "2e6563f2-e803-3536-8727-d3b6503cead0",
                                                "text": "Just a skosh after the lunch break, Bivvy and Erin were singing a song together."
                                            },
                                            {
                                                "example_id": "e992e2a6-8a3f-47e5-803d-608dd77c770f",
                                                "sense_id": "2e6563f2-e803-3536-8727-d3b6503cead0",
                                                "text": "I set the bit a skosh under the width of the mortise's shoulder; […]"
                                            },
                                            {
                                                "example_id": "e926abb9-7a6b-46b4-8eb2-c817252d8875",
                                                "sense_id": "2e6563f2-e803-3536-8727-d3b6503cead0",
                                                "text": "Wondrously weird and a skosh too long, “Good Manners” is a dark Brazilian fable of animalistic passions and social isolation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
