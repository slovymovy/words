                "senses": [
                    {
                        "sense_id": "65df5068-8882-3c8b-90f2-a4eedac48e60",
                        "entry_id": "c840ffae-08d5-32eb-a207-c0fb759350dc",
                        "glosses": [
                            "Sackgasse, welche von einer weiterführenden Straße abzweigt, oft mit dem gleichen Straßennamen wie die Straße, von der sie abzweigt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90aebaba-a5ae-42f7-ba6e-c37702f2ce24",
                                "sense_id": "65df5068-8882-3c8b-90f2-a4eedac48e60",
                                "text": "Das Auto kam aus der Stichstraße."
                            },
                            {
                                "example_id": "a2f594a0-c5eb-4da7-816d-8fb3d4ba6802",
                                "sense_id": "65df5068-8882-3c8b-90f2-a4eedac48e60",
                                "text": "„Sie lagen ziemlich dicht beieinander, getrennt durch Gärten und Stichstraßen, sie waren in den Siebzigerjahren alle aus den selben Fertighauskatalogen ausgesucht worden.“"
                            },
                            {
                                "example_id": "ff4954e5-d48b-40a5-8041-e1f1f70b9816",
                                "sense_id": "65df5068-8882-3c8b-90f2-a4eedac48e60",
                                "text": "„Wir fahren die kurvenreiche Stichstraße hinab nach Vík.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5de890b7-b590-4f5e-ba11-bfa33c82d589",
                        "source_entry_id": "c840ffae-08d5-32eb-a207-c0fb759350dc",
                        "source_sense_id": "65df5068-8882-3c8b-90f2-a4eedac48e60",
                        "source_sense_description": "Sackgasse",
                        "target_lang_word": "dead end",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dead end",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0f991f6-80b3-3037-aace-505338583972",
                                        "entry_id": "d9da1e14-6f7f-3418-b053-0c018036abac",
                                        "glosses": [
                                            "A street or path or tunnel that goes nowhere or is blocked on one end."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad8e844c-7032-4c73-a4ad-9d722c9e5dab",
                                                "sense_id": "c0f991f6-80b3-3037-aace-505338583972",
                                                "text": "That road comes to a dead end at the lake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb384e3-9590-34cd-a68e-677f41df8ea3",
                                        "entry_id": "d9da1e14-6f7f-3418-b053-0c018036abac",
                                        "glosses": [
                                            "The inner end of a drift or tunnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f92d6b-c7f1-48e8-9f08-f86775c53c26",
                                                "sense_id": "dcb384e3-9590-34cd-a68e-677f41df8ea3",
                                                "text": "The ventilation of dead ends — always a serious problem — has in some mines been an absolute necessity. At the Oriental Consols Gold Mine a crosscut at a depth of 2,600 ft. has been continued to over 1,400 ft. from the shaft, and at the No. 2 South Great Eastern Gold Mine crosscutting and driving has been carried on at depths of 1,750 ft. and 2,000 ft. In order to ventilate these dead ends blowers have been used to force air into the faces through lines of pipes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a0ef26-1357-3cb0-9753-408c89f89cc8",
                                        "entry_id": "d9da1e14-6f7f-3418-b053-0c018036abac",
                                        "glosses": [
                                            "A position that offers no hope of change or progress."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b618cc9-c9e5-4e6a-bb15-20d9953b2365",
                                                "sense_id": "b2a0ef26-1357-3cb0-9753-408c89f89cc8",
                                                "text": "Her father suggested that she decline the job because it was a dead end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c140d26-ff2b-3431-871e-cdac1d3bbba8",
                                        "entry_id": "d9da1e14-6f7f-3418-b053-0c018036abac",
                                        "glosses": [
                                            "A split end in the hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac3deb18-7242-4181-bf21-a3a0459787c2",
                                                "sense_id": "9c140d26-ff2b-3431-871e-cdac1d3bbba8",
                                                "text": "Cut the ends of the hair once a month certain — no matter if you do cut but just the tips of a fourth of an inch, cut it. Cut off the dead ends every month as regularly as the new moon comes round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
