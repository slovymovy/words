                "senses": [
                    {
                        "sense_id": "988ddd14-8380-3c73-a587-a7def3b7a492",
                        "entry_id": "049e0d4e-a07a-32e5-baef-ad2b24666b18",
                        "glosses": [
                            "mündliche Äußerung, die Aufschluss zu bestimmten Fragen geben kann/soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7613c6cf-8f5c-4816-a1a1-a9f3a540b163",
                                "sense_id": "988ddd14-8380-3c73-a587-a7def3b7a492",
                                "text": "Eine erste Sprechprobe zeigte, dass die Anlage noch nicht gut genug eingestellt war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f73c6314-5071-38ca-bdf3-a4bf35ca2dc8",
                        "entry_id": "049e0d4e-a07a-32e5-baef-ad2b24666b18",
                        "glosses": [
                            "Probe eines Stücks, wenn die Texte schon auswendig gelernt sind und nicht mehr abgelesen werden müssen"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "778662e8-7038-4d9c-98ef-9121694c2660",
                                "sense_id": "f73c6314-5071-38ca-bdf3-a4bf35ca2dc8",
                                "text": "„Sie verlangten nur drei Tage Zeit zum Auswendiglernen, um sich auf eine Sprechprobe vorzubereiten, und ich war einverstanden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ce9621f-4858-4fd5-b32c-b35b0f7b6c19",
                        "source_entry_id": "049e0d4e-a07a-32e5-baef-ad2b24666b18",
                        "source_sense_id": "f73c6314-5071-38ca-bdf3-a4bf35ca2dc8",
                        "target_lang_word": "répétition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répétition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e56d8a1-3bcc-3fe3-9131-36719e3abffb",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Action de répéter, redite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83951f98-3915-486a-9e49-fc11ba6cc38a",
                                                "sense_id": "7e56d8a1-3bcc-3fe3-9131-36719e3abffb",
                                                "text": "Son livre est plein de répétitions."
                                            },
                                            {
                                                "example_id": "b4407106-d43d-49d8-9105-3cac9cdde790",
                                                "sense_id": "7e56d8a1-3bcc-3fe3-9131-36719e3abffb",
                                                "text": "Éviter les répétitions."
                                            },
                                            {
                                                "example_id": "6c0514b8-ec48-4c19-9e0e-5f642c5b3275",
                                                "sense_id": "7e56d8a1-3bcc-3fe3-9131-36719e3abffb",
                                                "text": "Répétition de mots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3bfc565-8b14-3e0c-86bc-3826a7eff837",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Figure de rhétorique qui consiste à répéter plusieurs fois soit les mêmes mots, soit le même tour."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8219200-78e9-41cc-9f6c-a81d8849b33f",
                                                "sense_id": "d3bfc565-8b14-3e0c-86bc-3826a7eff837",
                                                "text": "Cet orateur fait souvent usage de la répétition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca817009-832e-3492-9874-2f51ed567a4f",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Action d’expliquer à des élèves la leçon d’un professeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edea50a0-a310-442e-a883-101b050a2e57",
                                                "sense_id": "ca817009-832e-3492-9874-2f51ed567a4f",
                                                "text": "Donner des répétitions."
                                            },
                                            {
                                                "example_id": "ee61fd44-c608-4077-8119-1c02901de3af",
                                                "sense_id": "ca817009-832e-3492-9874-2f51ed567a4f",
                                                "text": "Mon père a changé pour moi. Il avait jusqu’ici vécu en dehors du foyer, par la raison ou sous le prétexte qu’il avait à donner des répétitions au collège et à assister à quelques conférences que faisait le professeur de rhétorique, pour les maîtres qui n’étaient pas agrégés."
                                            },
                                            {
                                                "example_id": "8bb02e27-be41-482e-884c-18bf98227b8d",
                                                "sense_id": "ca817009-832e-3492-9874-2f51ed567a4f",
                                                "text": "Il n’y a que douze élèves en philosophie, quoique le collège ait neuf cents élèves, dont environ deux cent cinquante à l’école de commerce. P… ne trouve pas de répétitions parce qu’il est professeur de philosophie."
                                            },
                                            {
                                                "example_id": "57b461f3-7728-4809-be8a-bb9161467aa7",
                                                "sense_id": "ca817009-832e-3492-9874-2f51ed567a4f",
                                                "text": "— Mademoiselle Alexandre a une répétition à donner. Ici, les grandes enseignent les petites. C’est ce qu’on appelle l’enseignement mutuel…"
                                            },
                                            {
                                                "example_id": "ddc45cb4-5e6d-40c5-8711-228784740c05",
                                                "sense_id": "ca817009-832e-3492-9874-2f51ed567a4f",
                                                "text": "Prendre des répétitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc1a54fc-e478-3c75-b594-195a15dc5ba8",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Action de répéter, d’essayer en particulier certaines choses, pour les mieux prononcer ou exécuter en public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42540f2-d503-445b-9753-494b374722b8",
                                                "sense_id": "cc1a54fc-e478-3c75-b594-195a15dc5ba8",
                                                "text": "Pendant les répétitions, il a fait des raccords, ajouté des béquets, et aussi pratiqué des coupures qui ont précisément pour but de lui rendre ce public indulgent et favorable."
                                            },
                                            {
                                                "example_id": "0affc068-3cbf-4da9-b933-a8777c58223d",
                                                "sense_id": "cc1a54fc-e478-3c75-b594-195a15dc5ba8",
                                                "text": "La manageuse de Madonna, Angela, exprime le souhait de suivre les répétitions depuis le car régie, pour garder un œil sur la réalisation. À la demande d'Élise, je l'accompagne."
                                            },
                                            {
                                                "example_id": "daed2319-21f2-4516-937a-1d5352cb8950",
                                                "sense_id": "cc1a54fc-e478-3c75-b594-195a15dc5ba8",
                                                "text": "La répétition générale."
                                            },
                                            {
                                                "example_id": "d801f89c-924b-4c90-87b3-97fa68d59e69",
                                                "sense_id": "cc1a54fc-e478-3c75-b594-195a15dc5ba8",
                                                "text": "Il est bien dommage qu'on ne fasse pas exécuter aux vivants une répétition de leurs obsèques, histoire de les inciter à la méditation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be2b76ef-56d5-3637-b153-b894c5c8c9d9",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Réitération, action de faire ce qu’on a déjà fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11f5b16-cc93-4ec9-912b-16f91134898e",
                                                "sense_id": "be2b76ef-56d5-3637-b153-b894c5c8c9d9",
                                                "text": "On peut voir les mêmes productions passer plusieurs fois par les mains des Marchands & des Artisans ; mais il faut faire attention que ces répétitions de ventes & d'achats qui multiplient infructueusement la circulation ne sont que transposition."
                                            },
                                            {
                                                "example_id": "e06830a6-255e-4605-b5fb-2d4ff817adf4",
                                                "sense_id": "be2b76ef-56d5-3637-b153-b894c5c8c9d9",
                                                "text": "Pour Don Juan, « la féminité tout à fait abstraite est l'essentiel », l’individualité n'existe pas : il n'y a jamais eu à ses yeux ni infidélité ni tromperie, mais seulement répétition et multiplicité."
                                            },
                                            {
                                                "example_id": "aef30eee-634d-4724-b208-f06bf2fce1b7",
                                                "sense_id": "be2b76ef-56d5-3637-b153-b894c5c8c9d9",
                                                "text": "Les habitudes s’acquièrent par la répétition fréquente des mêmes actes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d961e9f7-0dca-3301-a33c-13958e0ed252",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Copie, reproduction d’une statue, d’un tableau, faite par l’auteur lui-même ou sous ses yeux, sous sa direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2aa5e4-3b20-4ccb-bcfd-68d3f1c3e14c",
                                                "sense_id": "d961e9f7-0dca-3301-a33c-13958e0ed252",
                                                "text": "Il existe plusieurs répétitions de ce tableau de Raphaël."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f2c8cd-a0e2-36f4-8358-4d6ede9c515f",
                                        "entry_id": "22885737-500b-3098-85ae-749c34216cb9",
                                        "glosses": [
                                            "Action par laquelle on redemande en justice ce qu’on a payé en trop, ce qu’on a avancé pour un autre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d6d798c-8756-4c8c-9512-85a18b7fc562",
                                                "sense_id": "b1f2c8cd-a0e2-36f4-8358-4d6ede9c515f",
                                                "text": "Répétitions de fruits, de frais, de dot."
                                            },
                                            {
                                                "example_id": "532247cc-06e7-4da7-9770-61b9b9e61ad0",
                                                "sense_id": "b1f2c8cd-a0e2-36f4-8358-4d6ede9c515f",
                                                "text": "Cela est sujet à répétition."
                                            },
                                            {
                                                "example_id": "93009127-2b3d-4739-a130-f96069ea5a95",
                                                "sense_id": "b1f2c8cd-a0e2-36f4-8358-4d6ede9c515f",
                                                "text": "Action en répétition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
