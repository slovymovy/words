                                "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                "text": "Verloop je?"
                            },
                            {
                                "example_id": "d032f811-dd6a-464a-b7cb-94bceb05cea6",
                                "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                "text": "Mijn gehele base weight kreeg ik na verloop van tijd onder de 8 kilo."
                            },
                            {
                                "example_id": "e11ebf26-533c-4aa2-b5eb-d979e352345e",
                                "sense_id": "1eb1eb61-be6b-3235-8f3d-501b4de943ea",
                                "text": "Gevoed door mannelijke competitiedrang - werden na verloop van tijd de gerechten exquiser en de wijnen beter, en ook op het gebied van keukenapparatuur' en kookspullen begonnen we met elkaar te wedijveren."
                            }
                        ]
