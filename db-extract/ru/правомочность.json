                                            {
                                                "example_id": "d3d657ae-14f5-4b6b-9567-0cb2710e6d5f",
                                                "sense_id": "485ebe7f-4fdc-3a42-a284-dac0888d1159",
                                                "text": "meet eligibility"
                                            },
                                            {
                                                "example_id": "9793277c-598e-4230-ba61-05d4b480f04f",
                                                "sense_id": "485ebe7f-4fdc-3a42-a284-dac0888d1159",
                                                "text": "eligibility criteria"
                                            },
                                            {
                                                "example_id": "8cb2fd55-1ff3-4939-a7b6-e3734012cae8",
                                                "sense_id": "485ebe7f-4fdc-3a42-a284-dac0888d1159",
                                                "text": "She checked her eligibility for the scholarship."
                                            },
                                            {
                                                "example_id": "034d830f-8f86-4d34-b63d-9fae1adc6c14",
                                                "sense_id": "485ebe7f-4fdc-3a42-a284-dac0888d1159",
                                                "text": "Citizenship is a requirement for eligibility."
                                            }
                                        ]
                                    }
                                ]
