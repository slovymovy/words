                    }
                ],
                "senses": [
                    {
                        "sense_id": "c42834e1-0e43-3300-b25c-b9b0abc9aa25",
                        "entry_id": "cf7d1782-5f04-345b-8ba7-a3781564a19d",
                        "glosses": [
                            "важно, торжественно сесть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e44f2cc5-f270-47e1-b8fe-960c797d8d01",
                                "sense_id": "c42834e1-0e43-3300-b25c-b9b0abc9aa25",
                                "text": "От сынов Фалега и Рега воссел на престоле Царьградском император."
                            },
                            {
                                "example_id": "cc2bfaff-1670-4cdc-8ea7-b7508d0d4523",
                                "sense_id": "c42834e1-0e43-3300-b25c-b9b0abc9aa25",
                                "text": "Онисим Варфоломеич, сопутствуемый всем семейством, снова воссел за самовар."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e120b1d7-108c-4bad-8fc1-fe34f2e613f4",
                        "source_entry_id": "cf7d1782-5f04-345b-8ba7-a3781564a19d",
                        "source_sense_id": "c42834e1-0e43-3300-b25c-b9b0abc9aa25",
                        "target_lang_word": "sit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21eb8fa7-1084-3c55-b4cd-f9d024a4a9d4",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To be in a position in which the upper body is upright and supported by the buttocks."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b383cf3a-0650-499f-8c89-c6a00b1fe6ee",
                                                "sense_id": "21eb8fa7-1084-3c55-b4cd-f9d024a4a9d4",
                                                "text": "He is so fayre, withoutten les, / he semys full well to sytt on des.",
                                                "translation": "He is so fair, without any limit; his appearance shows well when he sits on the dais.",
                                                "english": "He is so fair, without any limit; his appearance shows well when he sits on the dais."
                                            },
                                            {
                                                "example_id": "a9900005-110a-4be5-a756-0fc6fd6d1b1a",
                                                "sense_id": "21eb8fa7-1084-3c55-b4cd-f9d024a4a9d4",
                                                "text": "This were as good as curds for our Jone, / When at a night we ſitten by the fire."
                                            },
                                            {
                                                "example_id": "63379b4e-34e8-4204-941f-4558aaeb5c65",
                                                "sense_id": "21eb8fa7-1084-3c55-b4cd-f9d024a4a9d4",
                                                "text": "After a long day of walking, it was good just to sit and relax."
                                            },
                                            {
                                                "example_id": "208f2388-b288-4ed8-8a7d-18f0378d3096",
                                                "sense_id": "21eb8fa7-1084-3c55-b4cd-f9d024a4a9d4",
                                                "text": "You're finishing the chowder if you sit there (motionless) all evening!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58953960-5ed0-3269-b2ce-3c570fffe8a5",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To move oneself into such a position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f90398-c8aa-4b62-a4de-f9f23f6246b6",
                                                "sense_id": "58953960-5ed0-3269-b2ce-3c570fffe8a5",
                                                "text": "I asked him to sit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ec8822-f97e-34c9-a3c4-71043d2088b2",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To occupy a given position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b6386fd-a853-4c53-bf7f-1206d5d808ed",
                                                "sense_id": "32ec8822-f97e-34c9-a3c4-71043d2088b2",
                                                "text": "The dishes are still sitting on the table!"
                                            },
                                            {
                                                "example_id": "b544c027-90ee-42c7-85b2-40a104b4b1b7",
                                                "sense_id": "32ec8822-f97e-34c9-a3c4-71043d2088b2",
                                                "text": "The temple has sat atop that hill for centuries."
                                            },
                                            {
                                                "example_id": "b3cea923-56bb-44af-aba9-d2632180d087",
                                                "sense_id": "32ec8822-f97e-34c9-a3c4-71043d2088b2",
                                                "text": "Jim's pet parrot sat on his left shoulder."
                                            },
                                            {
                                                "example_id": "3e3d558e-9b9a-41d6-a213-cc5c57accc6c",
                                                "sense_id": "32ec8822-f97e-34c9-a3c4-71043d2088b2",
                                                "text": "The Yellow Sea sits between the Korean Peninsula and China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42a64ab-894a-304d-8781-38c85a66c379",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To remain in a state of repose; to rest; to abide; to rest in any position or condition."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83908c87-5530-41bb-9ae7-7886fbafd737",
                                                "sense_id": "a42a64ab-894a-304d-8781-38c85a66c379",
                                                "text": "And Moses said to […] the children of Reuben, Shall your brothren go to war, and shall ye sit here?"
                                            },
                                            {
                                                "example_id": "da1d150b-a09a-414c-b898-cdeee67a4382",
                                                "sense_id": "a42a64ab-894a-304d-8781-38c85a66c379",
                                                "text": "Like a demigod here sit I in the sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab8f29d-7ae5-3bed-8663-fc18fc563cf0",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To be a member of a deliberative body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b0c3209-d448-4dd3-9cb9-1e35b1693507",
                                                "sense_id": "6ab8f29d-7ae5-3bed-8663-fc18fc563cf0",
                                                "text": "I currently sit on a standards committee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7707be43-9748-3cf9-822d-f5b192c54b18",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "Of a legislative or, especially, a judicial body such as a court, to be in session."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f36aac-ab1c-4fba-877d-59e0407802d1",
                                                "sense_id": "7707be43-9748-3cf9-822d-f5b192c54b18",
                                                "text": "In what city is the circuit court sitting for this session?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034a46e9-fb4e-3987-baaf-3741f2223c73",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To lie, rest, or bear; to press or weigh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a1a60d-1d35-4176-8a7a-2a781757154d",
                                                "sense_id": "034a46e9-fb4e-3987-baaf-3741f2223c73",
                                                "text": "The calamity sits heavy on us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5483f233-237b-38cc-8429-24dafbe78eeb",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To be adjusted; to fit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1544bc7f-e3cf-4e6d-9ded-b4592ccf3bc3",
                                                "sense_id": "5483f233-237b-38cc-8429-24dafbe78eeb",
                                                "text": "Your new coat sits well."
                                            },
                                            {
                                                "example_id": "5a90d784-756c-4b76-ba78-6e9bb3a79bd8",
                                                "sense_id": "5483f233-237b-38cc-8429-24dafbe78eeb",
                                                "text": "This new and gorgeous garment, majesty, / Sits not so easy on me as you think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4aa30e7-5c6a-368c-b169-b0f87bec1cee",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To be accepted or acceptable; to work."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9057846d-7d2a-44b4-b42a-ff2a3abbdefe",
                                                "sense_id": "d4aa30e7-5c6a-368c-b169-b0f87bec1cee",
                                                "text": "How will this new contract sit with the workers?"
                                            },
                                            {
                                                "example_id": "645cb719-57cc-48c5-91e9-c0d85e1464e0",
                                                "sense_id": "d4aa30e7-5c6a-368c-b169-b0f87bec1cee",
                                                "text": "I don’t think it will sit well."
                                            },
                                            {
                                                "example_id": "b946dd33-e0e7-4540-b74d-9109dc7ea518",
                                                "sense_id": "d4aa30e7-5c6a-368c-b169-b0f87bec1cee",
                                                "text": "The violence in these video games sits awkwardly with their stated aim of educating children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494eafe6-adba-3855-95e1-aa328ae29ed7",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To cause to be seated or in a sitting posture; to furnish a seat to."
                                        ],
                                        "tags": [
                                            "causative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558c279a-3a21-4ad8-8acd-2917c6e85da7",
                                                "sense_id": "494eafe6-adba-3855-95e1-aa328ae29ed7",
                                                "text": "Sit him in front of the TV and he might watch for hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d9e522-ad6a-37ef-b00f-24b14dc20dd2",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To accommodate in seats; to seat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501d9194-85ca-4292-ba91-85f6d617cdbe",
                                                "sense_id": "66d9e522-ad6a-37ef-b00f-24b14dc20dd2",
                                                "text": "The dining room table sits eight comfortably."
                                            },
                                            {
                                                "example_id": "a990e47e-3deb-424d-aeaa-19e75dbba95f",
                                                "sense_id": "66d9e522-ad6a-37ef-b00f-24b14dc20dd2",
                                                "text": "I sat me weary on a pillar's base, / And leaned against the shaft"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c380a442-5b8a-3b64-8d37-e3a6b9a3b62f",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To babysit."
                                        ],
                                        "tags": [
                                            "US",
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c62d88-c74a-4e7f-901e-fa8433c68dfb",
                                                "sense_id": "c380a442-5b8a-3b64-8d37-e3a6b9a3b62f",
                                                "text": "I'm going to sit for them on Thursday."
                                            },
                                            {
                                                "example_id": "a6b7d536-2a6d-4b27-a8c1-ee8455204b63",
                                                "sense_id": "c380a442-5b8a-3b64-8d37-e3a6b9a3b62f",
                                                "text": "I need to find someone to sit my kids on Friday evening for four hours."
                                            },
                                            {
                                                "example_id": "03028fe7-e2dc-434b-a72f-4229bb9fb5b4",
                                                "sense_id": "c380a442-5b8a-3b64-8d37-e3a6b9a3b62f",
                                                "text": "I saw […] Mrs. Turman, who sometimes sat Billy when Steff and I went out […]"
                                            },
                                            {
                                                "example_id": "4cafdfc9-4762-4d04-99e0-1376ba371d2d",
                                                "sense_id": "c380a442-5b8a-3b64-8d37-e3a6b9a3b62f",
                                                "text": "Sitting was a “quintessentially American experience,” Yasemin Besen-Cassino, a Montclair State University sociologist and the author of The Cost of Being a Girl: Working Teens and the Origins of the Gender Wage Gap, told me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa3bc992-2212-3d8c-8e78-7a5c9ac7e737",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To take, to undergo or complete (an examination or test)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "431c378e-1bc7-3895-bbbc-f58a82e6d933",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To cover and warm eggs for hatching, as a fowl; to brood; to incubate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9154f8ed-6b8c-4a8a-8662-18f6bf3cb098",
                                                "sense_id": "431c378e-1bc7-3895-bbbc-f58a82e6d933",
                                                "text": "The partridge sitteth on eggs, and hatcheth them not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4cbcf1f-5101-329a-a392-46280bd466e4",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To take a position for the purpose of having some artistic representation of oneself made, such as a picture or a bust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a333ab30-da1e-45af-b797-11b72186630e",
                                                "sense_id": "f4cbcf1f-5101-329a-a392-46280bd466e4",
                                                "text": "I'm sitting for a painter this evening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fcee2b8-ea21-3860-a2cc-9927158a7949",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To have position, as at the point blown from; to hold a relative position; to have direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "859d29ea-3b3b-4e9e-9783-41f4cd1f9628",
                                                "sense_id": "5fcee2b8-ea21-3860-a2cc-9927158a7949",
                                                "text": "like a good miller that knows how to grind, which way soever the wind sits"
                                            },
                                            {
                                                "example_id": "07d5d0cd-c7f1-461d-b187-9918e66282e9",
                                                "sense_id": "5fcee2b8-ea21-3860-a2cc-9927158a7949",
                                                "text": "Sits the wind in that quarter?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b98c46-afd5-3f3c-865f-1f9a84821d84",
                                        "entry_id": "ae69a01a-a225-3d74-8093-a56aa05526cb",
                                        "glosses": [
                                            "To keep one's seat when faced with (a blow, attack); to endure, to put up with."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa65f416-853f-4aca-81cc-68217b5dfe79",
                                                "sense_id": "b4b98c46-afd5-3f3c-865f-1f9a84821d84",
                                                "text": "Louisa, who […] had but ill born the commencement of this conversation, could sit it no longer, and hastily throwing up the sash, complained of the intense heat of the room."
                                            }
                                        ]
                                    }
