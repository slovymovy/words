                },
                {
                    "sense_id": "d0959b1d-1df2-34f3-bdd2-feaac998050d",
                    "sense_definition": "A defensive move in wrestling used to counter a takedown by dropping the hips.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His perfectly timed <w>sprawl</w> prevented the opponent from scoring any points.",
                            "target_lang_translations": {
                                "ru": "Его идеально исполненный <w>спрол</w> не позволил противнику набрать очки."
                            }
