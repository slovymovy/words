                        ]
                    },
                    {
                        "translation_id": "c3f3d0ad-fd64-4fdb-8ef0-85d78aea1ae5",
                        "source_entry_id": "e0f33615-0f49-31de-9245-bf6117b9b308",
                        "source_sense_id": "28e0a039-876f-3bff-9e82-2d6a0a4299f4",
                        "target_lang_word": "arglos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arglos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f934ef4-f63b-347b-be7f-659e946beb80",
                                        "entry_id": "d21fb5b3-a1c3-3fa2-a322-9cdc1029267c",
                                        "glosses": [
                                            "nichts Böses ahnend; harmlos; treuherzig; blauäugig; unschuldig; ohne Argwohn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "055d3a6a-604a-4c34-925f-39990a0d1bb6",
                                                "sense_id": "0f934ef4-f63b-347b-be7f-659e946beb80",
                                                "text": "Ältere Menschen sind meist arglos und öffnen vermeintlichen Telefontechnikern die Tür."
                                            },
                                            {
                                                "example_id": "3d0dc12b-e935-41f2-91ce-eb85483155b9",
                                                "sense_id": "0f934ef4-f63b-347b-be7f-659e946beb80",
                                                "text": "Hier hat eine sehr berechnende, raffinierte junge Dame ihren Charme und ihre Intelligenz eingesetzt, um diesen ziemlich arglosen Mann auszunutzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9429e28-cabd-4587-9cc7-38aa18631238",
                        "source_entry_id": "e0f33615-0f49-31de-9245-bf6117b9b308",
                        "source_sense_id": "28e0a039-876f-3bff-9e82-2d6a0a4299f4",
                        "target_lang_word": "gutherzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gutherzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a37ced-fd6f-3ea9-b52f-8d32780777b8",
                                        "entry_id": "61d08906-aa8b-3573-b782-7820e5580ed9",
                                        "glosses": [
                                            "wohlwollend und freundlich gegenüber anderen Personen"
                                        ],
                                        "tags": [
                                            "den Charakter von jemandem beschreibend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5235760-80c1-481c-8251-75ac8b0e390c",
                                                "sense_id": "48a37ced-fd6f-3ea9-b52f-8d32780777b8",
                                                "text": "„Ich habe die Deutschen ganz anders erlebt“, sagt Priscillia. „Sie sind gutherzig, hilfsbereit und lieben abwechslungsreiches Essen, keineswegs nur Wurst und Bier.“"
                                            },
                                            {
                                                "example_id": "bf8765a6-715c-4f86-a2df-164f2346b54a",
                                                "sense_id": "48a37ced-fd6f-3ea9-b52f-8d32780777b8",
                                                "text": "Gutherzig und leichtgläubig, wie sie [Justine] ist, gerät sie in die Hände von Sadisten und Ausbeutern, die sie misshandeln."
                                            },
                                            {
                                                "example_id": "2ef84167-04ee-49cc-8acd-b92d27b16bcf",
                                                "sense_id": "48a37ced-fd6f-3ea9-b52f-8d32780777b8",
                                                "text": "Eigentlich könnten der Fischer Klaas Klasen und seine Frau Ilsebill glücklich sein, hat doch der gutherzige Klaas den verwunschenen Butt, den er gefangen hat, wieder freigelassen und dieser erfüllt ihnen als Dank nun ihre Wünsche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
