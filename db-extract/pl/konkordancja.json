                ],
                "senses": [
                    {
                        "sense_id": "60d102e1-9030-300f-90e4-58e4959bbde8",
                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                        "glosses": [
                            "zestawienie tekstów, symboli, znaków czy dat dotyczących tego samego przedmiotu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ba4f92-15e3-421c-8db1-7b971a2b3a64",
                                "sense_id": "60d102e1-9030-300f-90e4-58e4959bbde8",
                                "text": "Dodatkowo zamieszczony został wykaz konkordancji sygnatur i numerów pozycji, która zawiera spis sygnatur stałych i akcesji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                        "glosses": [
                            "alfabetyczny spis wyrazów, zdań, znaków, symboli lub motywów znajdujących się w jakimś dziele literackim lub zbiorze dokumentów czy ksiąg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8f8c3f5-d834-4b50-8ddc-acecf46793ab",
                                "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                "text": "Był autorem wielkiego słownika aramejsko-grecko-hebrajsko-łacińskiego, konkordancji do dzieł Józefa Flawiusza oraz encyklopedii Talmudu"
                            },
                            {
                                "example_id": "14cb4d23-78dd-4844-9e9d-369942e11231",
                                "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                "text": "W konkordancji do Biblii Hebraica występuje ponad 6800 miejsc występowania JHVH"
                            },
                            {
                                "example_id": "95ce58e8-92d4-49c2-a914-ff2e81d86cd1",
                                "sense_id": "654efb1f-6200-39da-b360-ede459e3a8c5",
                                "text": "Konkordancja tematyczna (rzeczowa) jest alfabetycznym spisem idei, zagadnień i nazw własnych występujących w danej księdze świętej ze wskazaniem miejsc ich występowania (w Koranie sura i wers) i przytoczeniem ich kontekstu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "626ab999-fed9-3296-b52a-e20b304d6f27",
                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                        "glosses": [
                            "zgodność wzajemnego stosunku stykających się ze sobą 2 warstw skał osadowych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "2578cdcf-bb5b-360d-9079-4a91f2f5634d",
                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                        "glosses": [
                            "wystąpienie szukanej frazy lub słowa w tekście, ich zestawie lub korpusie językowym z dodatkowym krótkim kontekstem, też: zbiór takich wystąpień"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8b580a-6e77-4fab-93fd-4f481edc5e21",
                                "sense_id": "2578cdcf-bb5b-360d-9079-4a91f2f5634d",
                                "text": "W językach bogatych fleksyjnie ortograficznie rozszerzone zapytanie może zwracać mało dokładne konkordancje, w których warianty fleksyjne są przemieszane z derywatami należećmi do innej kategorii części mowy"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "6ccc2b2f-ddd0-3acc-a84b-4136fbdef545",
                        "entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                        "glosses": [
                            "prawdopodobieństwo, że para osobników będzie miała tę samą cechę fenotypową, zakładając, że jedna z tych osób ma tę cechę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd13ef3-902b-49e1-890c-befa474d17ed",
                                "sense_id": "6ccc2b2f-ddd0-3acc-a84b-4136fbdef545",
                                "text": "Wysoka konkordancja manifestowanej chorobowości z powodu jakiejkolwiek alergii wskazuje na czynniki genetyczne jako kształtujące fenotypową zmienność występowania chorób alergicznych"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12c93d64-1bd5-4bc9-a942-6a6a27b65d4d",
                        "source_entry_id": "7dd88e6b-fbbe-37d3-91a7-262562162e59",
                        "source_sense_id": "60d102e1-9030-300f-90e4-58e4959bbde8",
                        "target_lang_word": "concordance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concordance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e57f54e2-819b-3d6c-a719-efcb4ce65cfc",
                                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                                        "glosses": [
                                            "Agreement; accordance; consonance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcbcace3-82aa-4f5a-a5ab-90c6e643cb16",
                                                "sense_id": "e57f54e2-819b-3d6c-a719-efcb4ce65cfc",
                                                "text": "John Sterling at Herstmonceux that afternoon, and his Father here in London, would have offered strange contrasts to an eye that had seen them both. Contrasts, and yet concordances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95ef2d4-d08c-3a34-842b-9d219c8efd1a",
                                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                                        "glosses": [
                                            "Agreement of words with one another; concord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bd6f08d-1427-3e4d-a206-19f39a2d0fc0",
                                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                                        "glosses": [
                                            "An alphabetical verbal index showing the places in the text of a book where each principal word may be found, with its immediate context in each place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750e35fd-2548-4490-b2cf-cd9386bb7f77",
                                                "sense_id": "7bd6f08d-1427-3e4d-a206-19f39a2d0fc0",
                                                "text": "c. 1857, Thomas Macaulay, \"Paul Bunyan\", contribution to the Encyclopaedia Britannica,\nHis knowledge of the Bible was such, that he might have been called a living concordance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c363956-3871-34c5-94e5-2ef34a824135",
                                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                                        "glosses": [
                                            "A list of occurrences of a word or phrase from a corpus, with the immediate context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45a7ab93-ebaf-38cd-bcec-b80eea873a32",
                                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                                        "glosses": [
                                            "The probability that a pair of individuals will both have a certain characteristic (phenotypic trait) given that one of the pair has the characteristic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "concordance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bdb3d94-86d8-3b26-8a44-1a76104f1795",
                                        "entry_id": "e60b23a7-a64d-3ad1-9ee8-2ed3ba3bdc62",
                                        "glosses": [
                                            "To create a concordance from (a corpus)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4cdd441-d21d-402e-af75-ab5cf3b65c7c",
                                                "sense_id": "5bdb3d94-86d8-3b26-8a44-1a76104f1795",
                                                "text": "Different from concordances of the Bible or classic works in the western tradition, which were basically complete concordances of a specific single book, the Chinese Lei Shu usually concordanced miscellaneous books."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
