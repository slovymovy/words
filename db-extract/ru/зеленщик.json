                "senses": [
                    {
                        "sense_id": "e1fa5112-43a6-3cf4-89f0-acfeb1ff741a",
                        "entry_id": "42a50f2a-b2c7-3141-9c6a-0a828f801a0f",
                        "glosses": [
                            "продавец зелени, овощей и фруктов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f43a9d5-847d-492b-a706-95e0f7e65a7c",
                                "sense_id": "e1fa5112-43a6-3cf4-89f0-acfeb1ff741a",
                                "text": "— От мясника, от зеленщика, от прачки, от хлебника: все денег просят."
                            },
                            {
                                "example_id": "349a15b0-04d9-4757-a634-ce6868502733",
                                "sense_id": "e1fa5112-43a6-3cf4-89f0-acfeb1ff741a",
                                "text": "Я знал, кто выходит из дома рано, а кто склонен припоздниться. К примеру, полицай, когда работал в дневную смену, выходил очень рано. Почтальон – вообще чуть ли не затемно. Владелец продуктовой лавки и зеленщик тоже открывали свои заведения спозаранку."
                            }
                        ]
                    }
