                    {
                        "sense_id": "819eb17c-9506-35b6-862c-85521fb7e67f",
                        "entry_id": "278820b6-fa54-3e20-9295-61da4eea6b12",
                        "glosses": [
                            "miękka tkanina bawełniana lub wełniana, pokryta delikatnym meszkiem, stosowana do wyrobu m.in. koszul, piżam i pościeli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac3f171-dca9-4381-9437-b71a1af16bd1",
                                "sense_id": "819eb17c-9506-35b6-862c-85521fb7e67f",
                                "text": "Od babci dostałam koszulę nocną z różowej flaneli."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d50ba3f3-d679-41dc-a627-0a9567a33cd0",
                        "source_entry_id": "278820b6-fa54-3e20-9295-61da4eea6b12",
                        "source_sense_id": "819eb17c-9506-35b6-862c-85521fb7e67f",
                        "target_lang_word": "flannel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flannel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f4dcb2-c986-3373-af3a-e1200a99337e",
                                        "entry_id": "7c7991b7-d88e-3861-a47c-ec181e4bcec3",
                                        "glosses": [
                                            "A soft cloth material originally woven from wool, today often combined with cotton or synthetic fibers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6268d627-87b6-4fce-80fa-63933e59a319",
                                                "sense_id": "94f4dcb2-c986-3373-af3a-e1200a99337e",
                                                "text": "With the weather turning colder, it was time to dig out our flannel sheets and nightclothes."
                                            },
                                            {
                                                "example_id": "2ffcdbdf-cfd6-4048-8647-260458c0aca5",
                                                "sense_id": "94f4dcb2-c986-3373-af3a-e1200a99337e",
                                                "text": "First singer and guitarist Marcus Mumford, wearing a black suit, then bassist Ted Dwane, in leather bomber and T-shirt. Next bearded banjo player Winston Marshall, his blue flannel shirt hanging loose, and pianist Ben Lovett, wrapped in a woollen coat."
                                            },
                                            {
                                                "example_id": "7d2c1f00-204f-4fa7-836f-7697add16c36",
                                                "sense_id": "94f4dcb2-c986-3373-af3a-e1200a99337e",
                                                "text": "There’s a communal memory of [Kurt] Cobain’s wearing flannel in this video, and that this image was the dawn of grunge fashion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8032ef05-4a63-3e82-8ec0-3d5772ba9d39",
                                        "entry_id": "7c7991b7-d88e-3861-a47c-ec181e4bcec3",
                                        "glosses": [
                                            "A washcloth."
                                        ],
                                        "tags": [
                                            "British",
                                            "New-Zealand",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6958ea9-7346-4895-8537-4bebada227be",
                                                "sense_id": "8032ef05-4a63-3e82-8ec0-3d5772ba9d39",
                                                "text": "\"The Witch of Endor was a fool to her, sir: bless you, she would make no more of raising every gentleman in the Bible out of these here beastly tombs than I should of growing cress on an old flannel.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81fa3a63-b49e-36c3-913b-60cb64e4208e",
                                        "entry_id": "7c7991b7-d88e-3861-a47c-ec181e4bcec3",
                                        "glosses": [
                                            "A flannel shirt."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7c1ee8f-3bde-3dba-aa63-810cb8515263",
                                        "entry_id": "7c7991b7-d88e-3861-a47c-ec181e4bcec3",
                                        "glosses": [
                                            "Soothing, plausible untruth or half-truth; claptrap."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
