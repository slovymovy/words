                ],
                "senses": [
                    {
                        "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                        "entry_id": "a448202b-2e06-3a68-9e5d-68459b519937",
                        "glosses": [
                            "jemand, der durch anspornende oder aufhetzende Reden oder Schriften, Menschenmassen zu bestimmten gemeinsamen Handlungen bewegen möchte; Person, die Agitation betreibt"
                        ],
                        "tags": [
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "83f20bc3-26cb-487f-a057-b570c0c03c33",
                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                "text": "„François Noël Babeuf, genannt Gracchus Babeuf […] war Journalist und ein linksrevolutionärer französischer Agitator während der ersten französischen Revolution.“"
                            },
                            {
                                "example_id": "ee7a7348-c34c-4191-9dde-06b5fac1e466",
                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                "text": "„Anders als seine Mitstreiter sieht er [Gábor Vona] harmlos aus: blauer Strickpullover, darunter ein gestreiftes Businesshemd, die braunen Augen blicken sanft. Dabei ist der 30-Jährige der gefährlichste Agitator im Magyarenland.“"
                            },
                            {
                                "example_id": "2b761eab-91f4-4341-be39-e5b05488dafa",
                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                "text": "„Kaum verschlüsselt schildert der Autor den Auftritt eines charismatischen politischen Agitators, dem bald die Massen zuströmen sollten.“"
                            },
                            {
                                "example_id": "9fc8d94d-438e-4fcb-befe-204144c73a58",
                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                "text": "„Für das Empfinden bürgerlicher Ästheten hatte der Dichter zugunsten des Agitators abgedankt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2b89a71-d7f2-4bb4-bc57-f9369bb66b5c",
                        "source_entry_id": "a448202b-2e06-3a68-9e5d-68459b519937",
                        "source_sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                        "source_sense_description": "Person, die Agitation betreibt",
                        "target_lang_word": "agitator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agitator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                        "entry_id": "b055ae70-6d0c-31f3-8838-689a62157864",
                                        "glosses": [
                                            "One who agitates; one who stirs up or excites others, for example political reformers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ba9f0f-6ccc-4a2d-ae5f-4b3cdf322086",
                                                "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                                "text": "Near-synonyms: instigator; see also Thesaurus:troublemaker"
                                            },
                                            {
                                                "example_id": "6b0d17cd-9939-4b4b-b83b-2ef509bdc40a",
                                                "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                                "text": "In addition, they kept a watch on political agitators and foreigners arriving and departing at the port."
                                            },
                                            {
                                                "example_id": "26c37420-db73-49a6-a5a9-2466d58c8190",
                                                "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                                "text": "I’m only aware of one anti-ICE raid incident in California over the summer in which a single agitator pointed a pistol at federal agents, and that person is apparently still at large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c99ca4-42a4-358a-90ec-9eb60321ea20",
                                        "entry_id": "b055ae70-6d0c-31f3-8838-689a62157864",
                                        "glosses": [
                                            "An implement for shaking or mixing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38d53122-57ac-3173-a1b8-4bc5663d848f",
                                        "entry_id": "b055ae70-6d0c-31f3-8838-689a62157864",
                                        "glosses": [
                                            "One of a body of men appointed by the army, in Oliver Cromwell's time, to look after their interests."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f57f70f-672f-4078-bea0-79461e991e1c",
                        "source_entry_id": "a448202b-2e06-3a68-9e5d-68459b519937",
                        "source_sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
