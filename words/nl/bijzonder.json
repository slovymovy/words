{
    "word_family": [
        "bijzonderheid",
        "bijzonderlijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53f8941d-3eb8-3dbb-bf72-0d251f73779a",
                    "sense_definition": "afwijkend van het gewone en daardoor opvallend of speciaal",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>bijzondere</w> ervaring om haar na al die jaren weer te zien.",
                            "target_lang_translations": {
                                "en": "It was a <w>special</w> experience to see her again after all those years.",
                                "ru": "Это был <w>особенный</w> опыт — увидеть её снова спустя столько лет."
                            }
                        },
                        {
                            "text": "Zij heeft een <w>bijzonder</w> talent voor het spelen van de piano.",
                            "target_lang_translations": {
                                "en": "She has an <w>extraordinary</w> talent for playing the piano.",
                                "ru": "У неё <w>исключительный</w> талант к игре на пианино."
                            }
                        }
                    ],
                    "synonyms": [
                        "speciaal"
                    ],
                    "antonyms": [
                        "normaal"
                    ],
                    "common_phrases": [
                        "iets bijzonders",
                        "bijzondere gelegenheid",
                        "bijzondere aandacht"
                    ],
                    "target_lang_definitions": {
                        "en": "deviating from the ordinary and therefore striking or special",
                        "ru": "отличающийся от обычного и поэтому заметный или специальный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "special",
                                "target_lang_sense_clarification": "distinguished by a unique or particular quality"
                            },
                            {
                                "target_lang_word": "extraordinary",
                                "target_lang_sense_clarification": "very unusual or remarkable"
                            },
                            {
                                "target_lang_word": "exceptional",
                                "target_lang_sense_clarification": "unusually good or outstanding"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "особенный",
                                "target_lang_sense_clarification": "отличающийся от других, необычный"
                            },
                            {
                                "target_lang_word": "специальный",
                                "target_lang_sense_clarification": "предназначенный для особого случая"
                            },
                            {
                                "target_lang_word": "исключительный",
                                "target_lang_sense_clarification": "выдающийся или крайне редкий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "317dc5f9-24a3-3af9-99cb-adaf03c0e3cf",
                    "sense_definition": "met een eigen, soms vreemde of specifieke kwaliteit",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is heel <w>bijzonder</w> om 's avonds laat nog aan dit project te werken.",
                            "target_lang_translations": {
                                "en": "It is very <w>unusual</w> to still be working on this project late at night.",
                                "ru": "Это довольно <w>необычно</w> — работать над этим проектом так поздно вечером."
                            }
                        },
                        {
                            "text": "Hij heeft een <w>bijzondere</w> manier van praten die niemand anders heeft.",
                            "target_lang_translations": {
                                "en": "He has a <w>peculiar</w> way of talking that no one else has.",
                                "ru": "У него <w>своеобразная</w> манера речи, которой нет ни у кого другого."
                            }
                        }
                    ],
                    "synonyms": [
                        "speciaal"
                    ],
                    "antonyms": [
                        "normaal"
                    ],
                    "common_phrases": [
