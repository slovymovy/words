                        "discrétion",
                        "réserve",
                        "délicatesse"
                    ],
                    "antonyms": [
                        "impudeur",
                        "immodestie"
                    ],
                    "common_phrases": [
                        "avoir la pudeur de",
                        "manquer de pudeur"
                    ]
                }
            ]
        }
