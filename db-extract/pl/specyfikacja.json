                                    {
                                        "sense_id": "c8714bc7-801e-3e18-95da-23e9f497aa27",
                                        "entry_id": "b82ec962-40a9-30a3-9154-f0d292ee0270",
                                        "glosses": [
                                            "An explicit set of requirements to be satisfied by a material, product, or service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca93968e-5ad8-4e4e-a970-50a0253f84ba",
                                                "sense_id": "c8714bc7-801e-3e18-95da-23e9f497aa27",
                                                "text": "The contractor followed the architect’s specifications."
                                            },
                                            {
                                                "example_id": "a8159ef8-0568-431e-9856-58de46cea831",
                                                "sense_id": "c8714bc7-801e-3e18-95da-23e9f497aa27",
                                                "text": "Each computer is built to the customer’s exact specification."
                                            },
                                            {
                                                "example_id": "f5bfa358-56dc-4bf5-a4c2-4c6fbbd864ee",
                                                "sense_id": "c8714bc7-801e-3e18-95da-23e9f497aa27",
                                                "text": "The product failed to meet the required safety specifications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c83750-d98b-3068-a071-86a4e21d7b0a",
                                        "entry_id": "b82ec962-40a9-30a3-9154-f0d292ee0270",
                                        "glosses": [
                                            "An act of specifying."
                                        ],
                                        "tags": [
                                            "countable",
