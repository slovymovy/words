                        "sense_id": "f16eb8cb-6b7c-372f-a647-41817877408a",
                        "entry_id": "a4aa9b5c-c709-33a7-be65-2d7c0d3c9c06",
                        "glosses": [
                            "weibliche Person, die beruflich einen Kran bedient"
