                "senses": [
                    {
                        "sense_id": "c552600f-8a6b-3ca1-a14e-9a0f3b63e2c1",
                        "entry_id": "3eb7f48a-8668-3c5d-8a4e-8480c94b0d9b",
                        "glosses": [
                            "Geheimdienst, der innerhalb des eigenen Landes solche Informationen zusammenträgt und auswertet, die für den Erhalt der Staatssicherheit relevant sein könnten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8fe0df-2d73-491b-bb09-e67df502c76b",
                                "sense_id": "c552600f-8a6b-3ca1-a14e-9a0f3b63e2c1",
                                "text": "„Der schweizerische Inlandgeheimdienst hatte in seinem Fall ganze Arbeit geleistet.“"
                            },
                            {
                                "example_id": "9ed26d5c-9467-466c-bb25-6bcfe27aaa14",
                                "sense_id": "c552600f-8a6b-3ca1-a14e-9a0f3b63e2c1",
                                "text": "„Der britische Inlandgeheimdienst hat heute Nacht in Manchester eine Wohnung ausgehoben.“"
                            },
                            {
                                "example_id": "e0359fc1-b558-4566-b16e-fa06995406ce",
                                "sense_id": "c552600f-8a6b-3ca1-a14e-9a0f3b63e2c1",
                                "text": "„Beim SBU handelt es sich um den ukrainischen Inlandgeheimdienst, dessen Spezialeinheit Alpha in der Ostukraine zum Einsatz kommt.“"
                            },
                            {
                                "example_id": "5dcafac0-f75d-4447-bb7c-d0ac50eb2139",
                                "sense_id": "c552600f-8a6b-3ca1-a14e-9a0f3b63e2c1",
                                "text": "„Manchmal fragte sie sich, ob ihr Mann nur so tat, als sei er Kriminalpolizist, und in Wirklichkeit stattdessen ein Mitarbeiter des MI5, des Inlandgeheimdienstes, war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
