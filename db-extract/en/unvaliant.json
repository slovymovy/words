                        "glosses": [
                            "Not valiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ec4994-e941-4555-82df-3d6b127ecde8",
                                "sense_id": "02a23b32-eec9-3092-bdea-60042c753d30",
                                "text": "[…] and an unvaliant, impudent, affronted pleading for untruth, tyranny and wickednesse, which is neither a product of prudence, nor magnanimity."
                            },
                            {
                                "example_id": "cf6c5b39-fa2f-49c8-b55c-55442d84328e",
                                "sense_id": "02a23b32-eec9-3092-bdea-60042c753d30",
                                "text": "[…] and none but such as were unvaliant and despicable would long continue without the privilege of cutting their hair, after they had attained to years of maturity."
                            },
                            {
                                "example_id": "c2bc7255-c2ac-498d-b6c6-097fea075c38",
                                "sense_id": "02a23b32-eec9-3092-bdea-60042c753d30",
                                "text": "Even the unvaliant James would have dared to tackle him single-handed; but he represented the unknown and terrible majesty of the law."
                            },
                            {
                                "example_id": "8f363399-90f2-4941-bfc8-6eaf1c05669f",
                                "sense_id": "02a23b32-eec9-3092-bdea-60042c753d30",
                                "text": "To those in the law enforcement community, the tape captured what they already believed: Marschke was weak-kneed or, at least, unvaliant."
                            }
                        ]
                    }
