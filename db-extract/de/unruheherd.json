                        "source_entry_id": "42272894-bbda-3bb3-ae8f-ad0ed9cfa35f",
                        "source_sense_id": "df9916b2-ba9e-30e3-b52b-90c1f8e7e0e8",
                        "target_lang_word": "storm center",
