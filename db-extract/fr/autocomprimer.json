                        "glosses": [
                            "Faire se comprimer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f21f2dc-7afb-4350-a8b9-b888a736f5c6",
                                "sense_id": "c223b5cd-4d44-3657-a222-adcea833fbf4",
                                "text": "Procédé et dispositif pour tremper ou autocomprimer verres, cristaux ou autres matières notamment en plaques ou feuilles de toutes sortes."
