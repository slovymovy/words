                                "target_lang_sense_clarification": "金融术语"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "activo respaldado por valores",
                                "target_lang_sense_clarification": "finanzas"
                            },
                            {
                                "target_lang_word": "titulización de activos",
                                "target_lang_sense_clarification": "finanzas"
                            }
                        ]
                    }
