                        ]
                    },
                    {
                        "translation_id": "d2e73502-4ef4-4a16-bcfc-bb2beeecce2b",
                        "source_entry_id": "c15c2e59-6680-3cf4-aebf-8e974e39869e",
                        "source_sense_id": "961b1c46-ec64-3713-a2ff-823351e75adc",
                        "target_lang_word": "nuthatch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuthatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                        "entry_id": "0b41a2d6-e17a-321c-8b54-bb1e066508e5",
                                        "glosses": [
                                            "Any of various small passerine birds from the genus Sitta, found throughout the northern hemisphere and noted for their unusual proclivity for climbing down trees head first."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf96e60-b06d-4aae-a702-2b9a34208907",
                                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                                "text": "Nuthatches have rather a habit of entering houses through open windows, probably out of curiosity; and we owed to this habit a pet nuthatch, which became extremely tame, and used to take flies from our finger."
                                            },
                                            {
                                                "example_id": "6cd0aada-ec00-4c43-8d5a-8ed970a02304",
                                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                                "text": "The bird was in very faded plumage with only a slight rusty wash to the underparts, and had I not heard the call, I might have mistaken it for a Pygmy Nuthatch."
                                            },
                                            {
                                                "example_id": "d892092b-c41a-4ae2-871b-7b54effbcdbf",
                                                "sense_id": "41f06f55-24f6-3d06-b3ad-6e7e5645bc88",
                                                "text": "Considered a resident bird, the red-breasted nuthatch usually winters in the coniferous forests within its breeding range."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
