                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042a87e4-765f-4c65-9aaf-8798cdfc10cf",
                                "sense_id": "bd3ef11e-b828-3c30-8443-9b1a4d376f55",
                                "text": "Im Februar 1945 ist das alte Dresden im Bombenhagel der Alliierten untergegangen."
                            },
                            {
                                "example_id": "dfefb548-3bbc-4003-a6ba-686870575226",
                                "sense_id": "bd3ef11e-b828-3c30-8443-9b1a4d376f55",
                                "text": "„Ich bin in dieser Stadt zu Hause gewesen und habe mit eigenen Augen vom Dach eines Vororthauses gesehen, wie sie im Bombenhagel zerstört wurde.“"
                            },
                            {
                                "example_id": "0c8e76cc-7e9e-4a24-a012-b8c7320751e7",
                                "sense_id": "bd3ef11e-b828-3c30-8443-9b1a4d376f55",
                                "text": "„Die Rüstungsproduktion stockte, der Schienen- und Straßenverkehr kam im Bombenhagel von Monat zu Monat mehr zum Erliegen.“"
                            },
                            {
                                "example_id": "fdb05797-597a-46d9-b5c7-f277222f0c4c",
                                "sense_id": "bd3ef11e-b828-3c30-8443-9b1a4d376f55",
                                "text": "„Etwa 2500 Halberstädter kamen in den Flammen und im Bombenhagel um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
