                ],
                "senses": [
                    {
                        "sense_id": "9f6f432e-6912-3865-8876-6e0d310f24b2",
                        "entry_id": "5665892b-e49b-3bdf-bc49-cc20a376e179",
                        "glosses": [
                            "Relatif à la Valachie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75664ab0-2680-4c14-9ec8-98bee2367300",
                                "sense_id": "9f6f432e-6912-3865-8876-6e0d310f24b2",
                                "text": "Les femmes moldaves et valaques sont en général assez belles ; elles ont la peau blanche ; mais leur teint est ordinairement pâle."
                            },
                            {
                                "example_id": "97dfe0ed-fea8-486b-bd6f-89fabc586530",
                                "sense_id": "9f6f432e-6912-3865-8876-6e0d310f24b2",
                                "text": "J’ai beau avoir été élevé par une mère roumaine très portée sur ce genre de calembredaines, j’ai surtout grandi en France et ai développé un esprit bien trop rationnel pour pouvoir aujourd’hui être perméable à tous ces racontars de marabout valaque. Désolé!"
                            }
                        ]
                    }
                ],
