{
    "word_family": [
        "contraindre",
        "contraignant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08627d2a-35fc-3859-ba98-886898b074de",
                    "sense_definition": "Condition, règle ou limitation qui s'impose à quelqu'un ou à la réalisation d'un projet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation_limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte doit prendre en compte les nombreuses <w>contraintes</w> techniques du terrain."
                        },
                        {
                            "text": "En raison d'une forte <w>contrainte</w> budgétaire, nous avons dû réduire les dépenses du projet."
                        }
                    ],
                    "common_phrases": [
                        "contrainte budgétaire",
                        "contraintes de temps"
                    ]
                },
                {
                    "sense_id": "d6f1d617-f70e-3c6d-bb34-5cd7d69cc58f",
                    "sense_definition": "Pression physique ou morale exercée sur quelqu'un pour l'obliger à agir contre sa volonté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coercition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a reconnu avoir fait ses déclarations sous la <w>contrainte</w> des menaces."
                        },
                        {
                            "text": "Il a été obligé de signer ce document par <w>contrainte</w>, contre sa propre volonté."
                        }
                    ],
                    "common_phrases": [
                        "sous la contrainte",
                        "par contrainte"
                    ]
                },
                {
                    "sense_id": "7c352d26-1834-3ac5-bb11-8ba54b97bfb9",
                    "sense_definition": "Force ou effort interne appliqué par unité de surface à l'intérieur d'un corps déformé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs étudient la <w>contrainte</w> mécanique subie par les câbles métalliques du pont suspendu."
                        },
                        {
                            "text": "La structure risque de céder si la <w>contrainte</w> appliquée dépasse le niveau maximal autorisé."
                        }
                    ],
                    "synonyms": [
                        "contrainte mécanique"
                    ],
                    "common_phrases": [
                        "contrainte mécanique"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d2d4d4e9-8c48-32a5-b82e-6ba676d659f1",
                    "sense_definition": "Féminin singulier de <w>contraint</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à la tempête, la navigatrice s'est vue <w>contrainte</w> de faire demi-tour vers le port."
                        },
                        {
                            "text": "Elle est restée calme bien qu'elle fût <w>contrainte</w> de quitter son poste immédiatement."
                        }
                    ],
                    "common_phrases": [
                        "se voir contrainte"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d80ba97d-9585-31c7-b3d3-07a77c498af9",
                    "sense_definition": "Participe passé féminin singulier de <w>contraindre</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a été <w>contrainte</w> par la justice de dédommager tous ses anciens clients."
                        },
                        {
                            "text": "Elle a été <w>contrainte</w> à abandonner ses études pour aider financièrement sa famille."
                        }
                    ],
                    "common_phrases": [
                        "être contrainte de"
                    ]
                }
            ]
        }
    ]
