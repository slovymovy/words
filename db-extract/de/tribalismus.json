                    }
                ],
                "translations": [
                    {
                        "translation_id": "f018852d-910a-4dc1-b7c2-05fef0c59e03",
                        "source_entry_id": "29fa26f6-5ca7-3489-9194-4a1e45a7d94d",
                        "source_sense_id": "4e805729-e9d9-332e-9a88-3a80973284a0",
