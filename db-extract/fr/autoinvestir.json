                    },
                    {
                        "form_id": "7176e8be-5c44-42e4-837e-a547437d21ad",
                        "entry_id": "289dcdcf-d6f0-3ab5-b5a8-f7164b224e19",
                        "tags": [],
                        "form": "auto-investir"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43e2dbf8-b9a2-38e6-bef4-445d458a4cc8",
                        "entry_id": "289dcdcf-d6f0-3ab5-b5a8-f7164b224e19",
                        "glosses": [
                            "S’investir soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0aca5d40-8ed1-468c-9b67-842ded9d40af",
                                "sense_id": "43e2dbf8-b9a2-38e6-bef4-445d458a4cc8",
                                "text": "Le Conseil consultatif ne doit pas s'autoinvestir dans certains dossiers plutôt que d'autres."
                            },
                            {
                                "example_id": "c4b60a1b-7ff1-4c0f-a9b5-a63e0dcde89c",
                                "sense_id": "43e2dbf8-b9a2-38e6-bef4-445d458a4cc8",
                                "text": "Ses adversaires le disent «droitier», «ultralibéral». Lui reprochent de préempter les thèmes de campagne de Chirac. De s'autoinvestir en prenant l'opinion à témoin."
                            }
                        ]
                    },
                    {
                        "sense_id": "570fcc34-1a03-339a-9d05-2b6c26047097",
                        "entry_id": "289dcdcf-d6f0-3ab5-b5a8-f7164b224e19",
                        "glosses": [
                            "Investir en utilisant son propre argent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ffe5a86a-e641-43d0-af47-f90bf1108d69",
                                "sense_id": "570fcc34-1a03-339a-9d05-2b6c26047097",
                                "text": "Une bonne trésorerie permet d'autoinvestir afin de ne pas être prisonnier du marché des capitaux."
                            }
                        ]
                    }
                ],
