            {
                "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                "word": "sicilienne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f26e8a6c-bc09-47a8-859c-3d2c416f058e",
                        "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                        "tags": [
                            "plural"
                        ],
                        "form": "siciliennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c8aff6c-a534-3035-876b-16fb3ed1a053",
                        "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                        "glosses": [
                            "Danse ancienne à 6 /8 (ou 6 /4)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a894ada4-b834-41e4-8064-dd819a42afc9",
                                "sense_id": "9c8aff6c-a534-3035-876b-16fb3ed1a053",
                                "text": "L'antique sicilienne des Italiens […] ressemblait au passe-pied par ses petits pas serrés, croisés et dansés très gaiement sur une mesure alerte."
                            },
                            {
                                "example_id": "8e50262f-084f-4835-8d51-cb604c223dfa",
                                "sense_id": "9c8aff6c-a534-3035-876b-16fb3ed1a053",
                                "text": "Le prince Albertinelli fredonnait au piano la sicilienne : Ô Lola ! Ses doigts effleuraient mollement les touches."
                            }
                        ]
                    },
                    {
                        "sense_id": "956d91ef-4146-3f47-bf72-a4646f2fefcb",
                        "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                        "glosses": [
                            "Rythme musical syncopé dans une mélodie ternaire, formé du motif « croche pointée — double-croche — croche »."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6c94fdab-2f46-355a-b67e-d8669c7e3fe2",
                        "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                        "glosses": [
                            "Pizza tomate, mozzarella, basilic, anchois, câpres."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2fb45eae-35cc-33a0-865d-cbbb3fa9e539",
                        "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                        "glosses": [
                            "Défense sicilienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe4358c8-5548-4025-bdd8-6d5cae7f165f",
                                "sense_id": "2fb45eae-35cc-33a0-865d-cbbb3fa9e539",
                                "text": "Plus de 25 % des parties de maîtres sont des siciliennes […] dès le troisième coup le plan de bataille est tracé ; les Blancs ont un avantage d’espace, les Noirs une prépondérance en pions sur les colonnes centrales."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ecd60bd-bc58-31ac-9b91-36bd6e19f6c8",
                        "entry_id": "311a876f-313a-33db-b17f-b72466e90975",
                        "glosses": [
                            "Étoffe de soie utilisée pour confectionner des robes et des vêtements d'extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e3577c-9d21-4d5a-abd7-06e5cecc7c49",
                                "sense_id": "0ecd60bd-bc58-31ac-9b91-36bd6e19f6c8",
                                "text": "Je n’ai qu’à fermer un peu les yeux pour revoir Loulou comme elle était alors, dans la toilette qu’on portait à cette époque, avec sa visite en sicilienne noire garnie de passementerie, sa jupe drapée avec un pouf derrière, et son chapeau de feutre orné d’un biais de velours."
                            }
                        ]
                    }
                ],
