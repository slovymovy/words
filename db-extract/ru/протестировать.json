                            {
                                "example_id": "0f8b3da6-70e3-46f8-98c6-bba09ad9a01b",
                                "sense_id": "8d156769-b34c-3421-8126-9ae9e558b09e",
                                "text": "Следует протестировать эту модель, прежде чем вы запустите ей в рабочем режиме."
