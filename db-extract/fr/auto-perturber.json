                            {
                                "example_id": "0da30148-d90c-4619-bc42-bae4c656ab1b",
                                "sense_id": "e2556463-0f44-3783-bf2b-fc1974783418",
                                "text": "Trop bizarre. J'me tâte pour le changer mon avatar ceci dit, mais je suis tellement habituée que j'ai peur de m'auto-perturber."
                            },
                            {
                                "example_id": "c95697ad-aeba-4083-98e2-d2aac13d1589",
                                "sense_id": "e2556463-0f44-3783-bf2b-fc1974783418",
                                "text": "Cette capacité de s'auto-perturber et de s'auto-réguler, donne des perturbations endogènes, et donc une grande adaptation face à tout problème rencontré."
                            },
                            {
                                "example_id": "10117d55-3750-4d8a-89e1-28bb81b0752b",
                                "sense_id": "e2556463-0f44-3783-bf2b-fc1974783418",
                                "text": "Je commence déjà à m'auto-perturber."
                            }
                        ]
                    }
