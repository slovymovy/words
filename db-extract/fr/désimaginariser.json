                        "examples": [
                            {
                                "example_id": "8f85818b-185f-4ed4-9e7c-c900f0313b5e",
                                "sense_id": "91dcb3de-9ecb-3e3e-959a-9524ce6105ba",
                                "text": "L’expérience partagée à la vertu de « désimaginariser » le rapport à soi-même et aux prisons dans lesquelles on a tôt fait de s’enfermer."
                            },
                            {
                                "example_id": "10b0efe0-5c0a-44d7-b8d2-7fa69a3e7536",
                                "sense_id": "91dcb3de-9ecb-3e3e-959a-9524ce6105ba",
                                "text": "Or, n’y a-t-il pas une illusion à nouveau à vouloir prétendre « désimaginariser » l’identification à l’objet perdu en la réduisant à l’identification du trait unaire, à prétendre dégager le symbolique de tout imaginaire ?"
                            },
                            {
                                "example_id": "e9945e66-a9c3-4e1e-bb95-81976d989cf8",
                                "sense_id": "91dcb3de-9ecb-3e3e-959a-9524ce6105ba",
                                "text": "Le transfert peut être imaginaire : il met en œuvre autour de la personne de l’éducateur une image, un idéal qu’il s’agit de désimaginariser et désidéaliser."
                            }
                        ]
                    }
