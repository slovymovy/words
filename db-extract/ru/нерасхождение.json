                "senses": [
                    {
                        "sense_id": "c079173d-6042-383e-a45c-11e1f601af3b",
                        "entry_id": "832d4bd7-bf8a-374f-908a-43a8ded49264",
                        "glosses": [
                            "биол. о хромосомах: состояние, при котором пары гомологичных хромосом неполностью расходятся во время мейоза или происходит неполное разделение хромосомы во время анафазы митоза или мейоза, в результате образующаяся клетка содержит аномальное число хромосом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27834d3f-ac30-4a31-bdb3-bd04813e2b49",
                                "sense_id": "c079173d-6042-383e-a45c-11e1f601af3b",
                                "text": "Унивалентность же является важной предпосылкой для возникновения нерасхождения хромосом в мейозе."
                            }
                        ]
                    }
