                                        "glosses": [
                                            "Qui vaut cinq fois autant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9625609-d7f6-425c-9cc6-b7978eb879e6",
                                                "sense_id": "bcf54eb1-f4c4-3ab4-bc6d-6a7f95efb00f",
                                                "text": "Le quintuple champion du monde d’apnée dynamique s’est préparé pendant de longues minutes au coin du feu, dans une cabane traditionnelle norvégienne, structure en bois recouverte de terre et d’herbes."
                                            },
                                            {
                                                "example_id": "cce0e5ef-c3f4-4f43-adfb-e1d1403a1d43",
                                                "sense_id": "bcf54eb1-f4c4-3ab4-bc6d-6a7f95efb00f",
                                                "text": "Vingt est quintuple de quatre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2e8fc7-74f7-3991-8763-ff949c1c8882",
                                        "entry_id": "d458ee18-4517-31c7-bca2-5a3c8a8d1b56",
                                        "glosses": [
                                            "Qui est composé de cinq éléments de même nature ou semblables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00dd96c6-d1f1-441d-a264-066c37368587",
                                                "sense_id": "ca2e8fc7-74f7-3991-8763-ff949c1c8882",
                                                "text": "…et il replia ensuite jusqu’au haut des cuisses, en quintuple bourrelet, son pantalon."
                                            }
                                        ]
                                    }
                                ]
                            },
