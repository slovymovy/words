        "fr-extract.jsonl": [
            {
                "entry_id": "f267a878-55f1-3689-9243-869226694124",
                "word": "trailer",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "48fc247f-062f-420e-8f2d-219eb0392a78",
                        "entry_id": "f267a878-55f1-3689-9243-869226694124",
                        "tags": [
                            "plural"
                        ],
                        "form": "trailers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa5a122b-b93d-3f9e-b65b-c620e8a4233f",
                        "entry_id": "f267a878-55f1-3689-9243-869226694124",
                        "glosses": [
                            "Remorque."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7715e6e5-543b-3d53-a150-0981d2ece744",
                        "entry_id": "f267a878-55f1-3689-9243-869226694124",
                        "glosses": [
                            "Sportif qui pratique la course de trail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8fe5cc-753a-4df3-be6f-f51c33302a6a",
                                "sense_id": "7715e6e5-543b-3d53-a150-0981d2ece744",
                                "text": "À la suite de l’annonce de la décision… un débat acharné s’est engagé sur les réseaux sociaux, canal très utilisé par les trailers, grands amateurs de nature et de technologie."
                            },
                            {
                                "example_id": "7a3df23a-dd71-49d6-ba3e-d8800e5cb482",
                                "sense_id": "7715e6e5-543b-3d53-a150-0981d2ece744",
                                "text": "Fabrice Boixière (42 ans), grand trailer, venait de s’éteindre au terme d’une longue maladie et le club de Plumaugat Athlétisme avait tenu à lui rendre un dernier hommage avec une première place pour Étienne Poulard sur le 10 km."
                            }
                        ]
                    },
                    {
                        "sense_id": "33131516-7f47-33fd-b170-a3dac605cf65",
                        "entry_id": "f267a878-55f1-3689-9243-869226694124",
                        "glosses": [
                            "Bande-annonce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f04b44ad-f72c-44e0-9f05-94794b064842",
                                "sense_id": "33131516-7f47-33fd-b170-a3dac605cf65",
                                "text": "[…] les lumières tamisées de la salle s’éteignent parfois complètement pour le trailer d’un film américain qui a coûté suffisamment d’argent pour qu’on en soigne la publicité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "919a4a90-1de2-4f42-8e2b-5eccc0d551b8",
                        "source_entry_id": "f267a878-55f1-3689-9243-869226694124",
                        "source_sense_id": "fa5a122b-b93d-3f9e-b65b-c620e8a4233f",
                        "source_sense_description": "(Transport) (Canada) Remorque.",
                        "target_lang_word": "trailer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trailer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb3f6e6a-cebc-335d-a006-c7d486899e9e",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "Someone who or something that trails (follows behind); something that is trailing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6d3009-c9df-416f-86fe-ee7e666cd9d1",
                                                "sense_id": "cb3f6e6a-cebc-335d-a006-c7d486899e9e",
                                                "text": "There were vehicles following me, of course, but was any of them trailing me? […] Without any warning, and without signalling with the trafficator, I took a sudden right turn, hoping to shake off my trailer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9628054-ed04-3f8d-904d-3b5f3d534875",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "Part of an object which extends some distance beyond the main body of the object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f60d46b-0ec0-4171-a3f5-e9812b1c2ad9",
                                                "sense_id": "d9628054-ed04-3f8d-904d-3b5f3d534875",
                                                "text": "the trailer of a plant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71b414fa-9051-353c-af79-9ebe5e756e3b",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "An unpowered wheeled vehicle (not a caravan or camper) that is towed behind another, and used to carry equipment, etc., that cannot be carried in the leading vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8dd303b-9b1c-4221-b4f5-3b9a028d231a",
                                                "sense_id": "71b414fa-9051-353c-af79-9ebe5e756e3b",
                                                "text": "At the end of the day, we put the snowmobiles back on the trailer."
                                            },
                                            {
                                                "example_id": "9f79f37d-d9aa-4c3b-8545-36c9a952e37f",
                                                "sense_id": "71b414fa-9051-353c-af79-9ebe5e756e3b",
                                                "text": "My trailer is a Highlander T-14 8G, one of the smallest trailers. I normally use it for carrying a pair of Sunfish sailboats that are much lighter than its 800-pound weight limit."
                                            },
                                            {
                                                "example_id": "cc6ebfb7-9613-4339-9932-2d2b0af90e87",
                                                "sense_id": "71b414fa-9051-353c-af79-9ebe5e756e3b",
                                                "text": "Or you can slide the trailer′s tandem forward toward the tractor. This changes the kingpin weight because you changed the “A” dimension of the trailer along with its wheel-base."
                                            },
                                            {
                                                "example_id": "996c1f89-efcc-4fa2-bf16-549e7129410e",
                                                "sense_id": "71b414fa-9051-353c-af79-9ebe5e756e3b",
                                                "text": "There is also a strong preference to avoid the cave effect associated with the front of most horse trailers and a strong desire to face the large opening between the top of the rear doors and the roof of the trailer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ee3628-f4cb-3870-b803-f69226b96df4",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "A furnished vehicle towed behind another, and used as a dwelling when stationary."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816a4b2e-5cde-4c56-85cb-0c591b7d967a",
                                                "sense_id": "57ee3628-f4cb-3870-b803-f69226b96df4",
                                                "text": "We drove our trailer to Yellowstone Park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01f690b1-4dd1-3da1-9bbc-991988f21a87",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "A prefabricated home that could be towed to a new destination but is typically permanently left in an area designated for such homes."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1d3c0d-506a-4cb0-b7bb-f6be8cee3411",
                                                "sense_id": "01f690b1-4dd1-3da1-9bbc-991988f21a87",
                                                "text": "The young couple′s first home was in a trailer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2bbcd00-20dd-352b-9f6b-500785d63aad",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "A preview of a film, video game or TV show."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bec44b33-102e-43dc-bfc0-cf6b444f938c",
                                                "sense_id": "e2bbcd00-20dd-352b-9f6b-500785d63aad",
                                                "text": "The trailer for that movie makes it seem like it would be fun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c1ec8d5-9f4b-38fb-b6a5-1015d1a2a56b",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "A short blank segment of film at the end of a reel, for convenient insertion of the film in a projector."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01f9de09-fdad-39d9-9fe7-93416ba516e7",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "The final record of a list of data items, often identified by a key field with an otherwise invalid value that sorts last alphabetically (e.g., “ZZZZZ”) or numerically (“99999”); especially common in the context of punched cards, where the final card is called a trailer card."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a8c17a-3099-4b84-ae99-8bb294c509ba",
                                                "sense_id": "01f9de09-fdad-39d9-9fe7-93416ba516e7",
                                                "text": "The linked list terminates with a trailer record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fb55254-c47b-3188-b74e-13ceb2e0f6ee",
                                        "entry_id": "c00f8c22-0e30-3949-a482-03b3d2498bb4",
                                        "glosses": [
                                            "The last part of a packet, often containing a check sequence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "712fff3c-cfde-4aef-bcfd-67f5bc647cc1",
                                                "sense_id": "7fb55254-c47b-3188-b74e-13ceb2e0f6ee",
                                                "text": "The encapsulation layer adds an eight-byte header and a two-byte trailer to each packet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trailer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa20449-92d4-34e9-8588-063063ed4948",
                                        "entry_id": "f7451f61-346a-3d9c-8c96-b107cf0ed68c",
                                        "glosses": [
                                            "To load on a trailer or to transport by trailer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863a50dd-0165-45c7-a2d7-b268e05e3673",
                                                "sense_id": "0aa20449-92d4-34e9-8588-063063ed4948",
                                                "text": "The engine wouldn't run any more so we had to trailer my old car to the wrecking yard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
