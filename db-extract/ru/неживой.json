                                                "sense_id": "ae191603-f058-3dd1-b81b-88edadf9b94a",
                                                "text": "Mit der unbelebten Natur befasst sich unter anderem die Physik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eb1fc776-6330-3bbc-a4d8-daa3a7b5780e",
                                        "entry_id": "a138a64a-a364-3c95-8442-dc514459adab",
                                        "glosses": [
                                            "semantisches Merkmal (Sem) mit der Bedeutung nicht lebend"
                                        ],
                                        "tags": [
