{
    "word_family": [
        "expect",
        "expectation",
        "expectantly",
        "expectance",
        "expectancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b95831e2-4393-38e2-9877-b3bd13a13349",
                    "sense_definition": "Pregnant, or anticipating the birth of a child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pregnancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital organized special classes for <w>expectant</w> mothers to prepare for childbirth.",
                            "target_lang_translations": {
                                "zh": "医院为<w>准</w>妈妈们开设了专门的课程，帮助她们为分娩做准备。"
                            }
                        },
                        {
                            "text": "As an <w>expectant</w> father, he spent the weekend assembling the new crib.",
                            "target_lang_translations": {
                                "zh": "作为一名<w>准</w>爸爸，他花了一整个周末组装新的婴儿床。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pregnant"
                    ],
                    "common_phrases": [
                        "expectant mother",
                        "expectant father",
                        "expectant parents"
                    ],
                    "target_lang_definitions": {
                        "zh": "怀孕的；即将做父母的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "准",
                                "target_lang_sense_clarification": "常用于准妈妈、准爸爸等词，表示即将成为父母"
                            },
                            {
                                "target_lang_word": "怀孕的",
                                "target_lang_sense_clarification": "指女性处于妊娠期"
                            },
                            {
                                "target_lang_word": "待产的",
                                "target_lang_sense_clarification": "指等待分娩生育"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6e71dcb-7fa0-32cd-a4c4-e1e7c85992cd",
                    "sense_definition": "Characterized by excited waiting, anticipation, or hope that something is about to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>expectant</w> hush fell over the audience as the lights began to dim.",
                            "target_lang_translations": {
                                "zh": "随着灯光渐暗，观众席上笼罩在一片<w>充满期待的</w>寂静之中。"
                            }
                        },
                        {
                            "text": "The children waited with <w>expectant</w> faces as the performer walked onto the stage.",
                            "target_lang_translations": {
                                "zh": "当演员走上舞台时，孩子们带着<w>期盼的</w>神情等待着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anticipating",
                        "eager",
                        "waiting"
                    ],
                    "common_phrases": [
                        "expectant hush",
                        "expectant silence",
                        "expectant crowd",
                        "expectant look"
                    ],
                    "target_lang_definitions": {
                        "zh": "充满期待的，翘首以盼的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "充满期待的",
                                "target_lang_sense_clarification": "形容心情、表情或氛围充满希冀与等待"
                            },
                            {
                                "target_lang_word": "期待的",
                                "target_lang_sense_clarification": "表示盼望事情发生"
                            },
                            {
                                "target_lang_word": "期盼的",
                                "target_lang_sense_clarification": "表达深切盼望的态度或神情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82160bb5-118b-356f-8f59-4949301972e5",
                    "sense_definition": "Characterized by waiting for the natural course of a condition rather than giving active medical intervention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended an <w>expectant</w> approach to monitor how the symptoms would develop.",
                            "target_lang_translations": {
                                "zh": "医生建议采取<w>期待的</w>方式，观察症状会如何发展。"
                            }
                        },
                        {
                            "text": "Choosing <w>expectant</w> management allowed the patient to avoid unnecessary surgery.",
                            "target_lang_translations": {
                                "zh": "选择<w>期待疗法</w>使患者免于接受不必要的手术。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "expectant management",
                        "expectant treatment"
                    ],
                    "target_lang_definitions": {
                        "zh": "（医疗）期待的，观察等待的（不立即采取积极干预，观察自然病程）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "期待疗法的",
                                "target_lang_sense_clarification": "医学用语，指静候观察自然病程的治疗方法"
                            },
                            {
                                "target_lang_word": "期待的",
                                "target_lang_sense_clarification": "医学上指观察等待而非积极干预"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24d8a14b-73f7-32c1-93a8-1aba6bd74075",
                    "sense_definition": "A person who expects, anticipates, or awaits something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>expectants</w> gathered outside the office hoping for positive news about the promotion.",
                            "target_lang_translations": {
                                "zh": "<w>期待者</w>们聚集在办公室外，希望能听到关于晋升的好消息。"
                            }
                        },
                        {
                            "text": "He stood among the <w>expectants</w> awaiting the final reading of the will.",
                            "target_lang_translations": {
                                "zh": "他站在<w>等待者</w>中间，等待遗嘱的最终宣读。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "期待者；等待（某事发生）的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "期待者",
                                "target_lang_sense_clarification": "指怀抱期望等待事情结果的人"
                            },
                            {
                                "target_lang_word": "等待者",
                                "target_lang_sense_clarification": "指正在等待的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}