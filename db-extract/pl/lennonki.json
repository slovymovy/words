                                        "entry_id": "3c207054-51bc-3944-b809-48abafbc14ff",
                                        "glosses": [
                                            "A pair of eyeglasses (spectacles) with round lenses."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "774dd12c-a0e3-47df-b038-70a8896924b5",
                                                "sense_id": "dc9e82ed-2993-338d-917b-8618f80db7a6",
                                                "text": "Everyone in New York / Had a position on Shanker, / A story about garbage, / An unconventional sex life, / John Lennon glasses, […]"
                                            },
                                            {
                                                "example_id": "8aa72282-29d1-4584-bc0a-05d552256d66",
                                                "sense_id": "dc9e82ed-2993-338d-917b-8618f80db7a6",
                                                "text": "\"[…]Or, I could go to Harvard Square, browse the coffee shops wearing my John Lennon glasses, and look for an intellectual who's smart enough to see the woman inside.\""
                                            },
                                            {
                                                "example_id": "2d691f26-41dd-4dbd-8bd7-ad5c14796920",
                                                "sense_id": "dc9e82ed-2993-338d-917b-8618f80db7a6",
                                                "text": "A bookish young man with John Lennon glasses looked up, smiled, and answered in a northern accent. \"The tool is calibrated. Just waiting to hit total depth.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
