                        "entry_id": "c9ed23f9-a2c5-3003-b0ea-39e61c3e9a1e",
                        "glosses": [
                            "Système de fermeture qui consiste en deux bandes auto-agrippantes de texture différente permettant lorsqu’on les met en contact d’obtenir rapidement une liaison amovible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3f51ea-6a26-4c1d-8e04-30df7f2c9875",
                                "sense_id": "1d6a9d6e-571b-3c06-973e-2887e7502414",
                                "text": "Pour les enfants qui ne savent pas nouer les lacets, c’est pratique le velcro comme système de fermeture."
                            },
                            {
                                "example_id": "3c78578e-966d-423f-8718-9ced91ecf8bd",
                                "sense_id": "1d6a9d6e-571b-3c06-973e-2887e7502414",
                                "text": "Le velcro a été imité de la bardane."
                            }
                        ]
                    }
