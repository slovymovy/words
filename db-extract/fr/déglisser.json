                        "glosses": [
                            "Descendre en glissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9413fcfa-b4ce-4d78-bbbe-a4665f9981b7",
                                "sense_id": "4d660147-0d7a-37cf-b64a-381cad013eae",
                                "text": "Les rives sont sillonnées de longues \"glissades\" où les enfants, gamins et gamines, et aussi passants de tous âges, s’entraînent à \"déglisser\" à toute allure."
                            },
                            {
                                "example_id": "b38720f9-3f96-48fc-84fb-7b078796ae42",
                                "sense_id": "4d660147-0d7a-37cf-b64a-381cad013eae",
                                "text": "Sur le fil de mon être Sans valeur ajoutée Il faut combattre et mettre Urgence à déglisser…"
                            },
                            {
                                "example_id": "a43a03fc-fb7b-451a-8221-64f39c7120b8",
                                "sense_id": "4d660147-0d7a-37cf-b64a-381cad013eae",
                                "text": "V’lez-vous-t-y vous déglisser de là-haut, nom d’un fou… dre !"
                            }
                        ]
                    }
