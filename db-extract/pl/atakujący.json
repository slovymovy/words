                        ],
                        "examples": [
                            {
                                "example_id": "213569b3-ff8d-48a6-b1fe-457ccb58648f",
                                "sense_id": "1685dbdd-2c06-371d-842c-f4f8ac5bcade",
                                "text": "Jedynym atakującym światowej klasy, jakiego miała reprezentacja, był Wlazły"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a77f913-cb5a-4414-b227-aeb22b67fe50",
                        "source_entry_id": "70325ef4-de89-3713-8d81-189f21e9ab4a",
                        "source_sense_id": "1685dbdd-2c06-371d-842c-f4f8ac5bcade",
                        "target_lang_word": "attaquant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attaquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7de4b436-b052-35c3-be03-bb422ce50367",
                                        "entry_id": "f483bdc6-00c4-3c9c-bc89-70a0d4c48dbd",
                                        "glosses": [
                                            "Qui attaque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16a1445f-e33e-3b44-afbe-5005035b2dc0",
                                        "entry_id": "f483bdc6-00c4-3c9c-bc89-70a0d4c48dbd",
                                        "glosses": [
                                            "Qui critique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "attaquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56f7e0a9-a294-3dad-b8ed-82ae789d4884",
                                        "entry_id": "8376dd6c-8b05-386a-b77a-a5288a6f5c59",
                                        "glosses": [
                                            "Assaillant, personne qui attaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13e3c4f-1873-4206-9ee7-03b1fc738d6a",
                                                "sense_id": "56f7e0a9-a294-3dad-b8ed-82ae789d4884",
                                                "text": "Mais une jeune fille qui hurle tout à coup, et se retourne, bras levés comme pour se défendre d’un attaquant invisible, c’est curieux."
                                            },
                                            {
                                                "example_id": "aacdc190-9100-4a89-9f13-57549d0bfd96",
                                                "sense_id": "56f7e0a9-a294-3dad-b8ed-82ae789d4884",
                                                "text": "« Ces cyberattaques sur le secteur public, comme celle sur le conseil départemental de Seine-et-Marne, sont un peu surprenantes, dans la mesure où les attaquants sont sûrs de ne pas être payés », analyse Loïc Guézo, expert en cybersécurité et secrétaire général du Clusif, le Club de la sécurité de l’information en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e500891-f614-33a1-9ac8-069c1864653b",
                                        "entry_id": "8376dd6c-8b05-386a-b77a-a5288a6f5c59",
                                        "glosses": [
                                            "Joueur chargé de marquer des points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad4f025-f9f8-4bbc-be08-81b886cb2d56",
                                                "sense_id": "8e500891-f614-33a1-9ac8-069c1864653b",
                                                "text": "Quand les attaquants jouent le ballon dans la zone de danger, le défenseur a 50 pour cent de chances de pouvoir le dégager - ce qui signifie envoyer le ballon haut et loin des buts."
                                            },
                                            {
                                                "example_id": "2cb2138d-6aa1-4828-944c-34d2e0a61cbf",
                                                "sense_id": "8e500891-f614-33a1-9ac8-069c1864653b",
                                                "text": "Plus jeune attaquant de son équipe, il a récolté 15 points en 23 rencontres."
                                            },
                                            {
                                                "example_id": "70a06eea-0b03-4200-9476-f92874df7c81",
                                                "sense_id": "8e500891-f614-33a1-9ac8-069c1864653b",
                                                "text": "Un exemple concret : l’attaquant hondurien Alberth Elis, annoncé par la presse de son pays en partance pour le club turc de Galatasaray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d4cf80-cf93-3114-a678-da734a63c8f7",
                                        "entry_id": "8376dd6c-8b05-386a-b77a-a5288a6f5c59",
                                        "glosses": [
                                            "Personne physique ou morale qui prend l’initiative d’une offre publique sur les titres d'une société, conduite dans une logique exclusivement financière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c28b39d4-c46c-428e-a927-676c1e8e051d",
                                                "sense_id": "c2d4cf80-cf93-3114-a678-da734a63c8f7",
                                                "text": "Un attaquant est un financier spécialisé dans le rachat des entreprises (de préférence des entreprises en difficulté) pour en tirer rapidement un profit. Ce spéculateur prend une participation significative ou le contrôle d’une société lors d’un ramassage en bourse ou d’une offre publique d’achat hostile, et ce, dans le but de revendre au mieux de ses intérêts (et non pour gérer l’entreprise)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "attaquant",
                                "target_lang_code": "fr",
                                "target_senses": [
