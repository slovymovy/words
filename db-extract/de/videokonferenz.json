                "senses": [
                    {
                        "sense_id": "c72f167d-c1f7-3f1a-95cb-a240a71dbf57",
                        "entry_id": "bfd7d519-c406-385a-80cb-ede4e1dc8d19",
                        "glosses": [
                            "Besprechung, an der mehrere Personen teilnehmen, die sich an verschiedenen Orten befinden und sich über Video sehen und hören können; ein audiovisuelles Telekommunikationsverfahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acca9b99-9faf-419c-940e-eda0873d1b9d",
                                "sense_id": "c72f167d-c1f7-3f1a-95cb-a240a71dbf57",
                                "text": "Herr Schmitt nimmt mit seinem Kollegen an einer Videokonferenz in Bonn teil."
                            },
                            {
                                "example_id": "dcdfcebb-3674-4388-b876-e3f5113da3a0",
                                "sense_id": "c72f167d-c1f7-3f1a-95cb-a240a71dbf57",
                                "text": "Die europäischen Verkehrsminister wollen heute in einer Videokonferenz über die aktuelle Lage beraten."
                            },
                            {
                                "example_id": "5f4d51a3-d4b7-4ddf-ae9f-bffb55fd8f6b",
                                "sense_id": "c72f167d-c1f7-3f1a-95cb-a240a71dbf57",
                                "text": "Per Videokonferenz werden Pfeifers Vorträge an Hochschulen von Südkorea über Australien bis nach Algerien übertragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0c66e1d-908c-4553-8c75-61f97935339b",
                        "source_entry_id": "bfd7d519-c406-385a-80cb-ede4e1dc8d19",
                        "source_sense_id": "c72f167d-c1f7-3f1a-95cb-a240a71dbf57",
