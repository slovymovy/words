                "senses": [
                    {
                        "sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                        "entry_id": "fb1c760e-69c6-3f5e-b834-6b5d2fc00b43",
                        "glosses": [
                            "Entscheidung in einem Rechtsstreit, die durch ein übernatürliches Ereignis herbeigeführt wird"
                        ],
                        "tags": [
                            "Rechtsgeschichte",
                            "Mittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "ac486cee-f6b3-42c2-be8f-06875713fd13",
                                "sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                                "text": "„Das Russische Roulette ist eine Extremvariante des Ordals, bei welcher der Ordalist auf jede Möglichkeit verzichtet, die Schicksalsentscheidung selbst zu beeinflussen.“"
                            },
                            {
                                "example_id": "8b8dda72-0eaf-4954-8ffb-c7567d89789d",
                                "sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                                "text": "Im altertümlichen Gerichtsverfahren galt das Gottesurteil oder Ordal als sicheres Beweismittel. Der Angeklagte wurde dazu höchster Gefahr für Leib und Leben ausgesetzt (Feuerprobe, Wasserprobe, Zweikampf). Überlebte er unversehrt, so hatte Gott zu dessen Gunsten eingegriffen und seine Unschuld erwiesen."
                            },
                            {
                                "example_id": "4a5afa44-d470-487c-924a-ffd78e881d8f",
                                "sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                                "text": "„Im Laufe der Jahrhunderte bildeten sich folgende Hauptarten von Ordalien in unserem Kulturkreis heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd475921-6c67-4356-ba26-caea849637b1",
                        "source_entry_id": "fb1c760e-69c6-3f5e-b834-6b5d2fc00b43",
                        "source_sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                        "source_sense_description": "Entscheidung in einem Rechtsstreit, durch übernatürliches Ereignis herbeigeführt",
                        "target_lang_word": "ordeal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98da317a-f87a-30b6-96c3-74b023f96f7e",
                                        "entry_id": "e09f9a34-bd2f-3225-9572-894654e1f2ab",
                                        "glosses": [
                                            "A trial in which the accused was subjected to a dangerous test (such as ducking in water), divine authority deciding the guilt of the accused."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da94cb6f-5127-4e95-ab88-6ea8a88a7c57",
                                                "sense_id": "98da317a-f87a-30b6-96c3-74b023f96f7e",
                                                "text": "trial by ordeal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                        "entry_id": "e09f9a34-bd2f-3225-9572-894654e1f2ab",
                                        "glosses": [
                                            "A painful or trying experience."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c244b8-8f29-48d2-8446-eda1957dfd69",
                                                "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                                "text": "“And do you realize that in a few shakes I've got to show up at dinner and have Mrs Cream being very, very kind to me? It hurts the pride of the Woosters, Jeeves.” “My advice, sir, would be to fortify yourself for the ordeal.” “How?” “There are always cocktails, sir. Should I pour you another?” “You should.”"
                                            },
                                            {
                                                "example_id": "920b9c05-073e-439e-b981-cc0b8a1eb7c6",
                                                "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                                "text": "All the same, nearly eight hours on the footplate covering a distance of 320 miles, with an ambient temperature of up to 103° for much of the time, proved an ordeal which I would not lightly undertake again."
                                            },
                                            {
                                                "example_id": "76f5edde-adce-4810-bfb4-3a91957865e7",
                                                "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                                "text": "Arsène Wenger confessed: \"The result was not an accurate indication of the match.\" Certainly, at half-time it seemed unlikely that Arsenal would catch fire so spectacularly because the first half was a damp squib of a display from Wenger's team, as Newcastle initially showed no ill-effects from their Old Trafford ordeal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eecd012-785f-3e86-9da1-f639a16fd66d",
                                        "entry_id": "e09f9a34-bd2f-3225-9572-894654e1f2ab",
                                        "glosses": [
                                            "The poisonous ordeal bean or Calabar bean."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac2c393e-7383-4dcd-9290-a2e6eafca823",
                        "source_entry_id": "fb1c760e-69c6-3f5e-b834-6b5d2fc00b43",
                        "source_sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                        "source_sense_description": "Entscheidung in einem Rechtsstreit, durch übernatürliches Ereignis herbeigeführt",
                        "target_lang_word": "ordalie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                        "entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                                        "glosses": [
                                            "Épreuve, allant jusqu’à la torture, usitée au Moyen Âge comme preuve en justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3daa8c24-b88c-46c6-8819-481a4452ba2a",
                                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                                "text": "Quant à l’hypothèse, sous-introduite au moyen âge, qui tendrait à faire de la guerre, à la façon de l’ordalie ou combat judiciaire, une manifestation de la volonté du ciel, il va sans dire que Grotius et ses successeurs la rejettent."
                                            },
                                            {
                                                "example_id": "8e6ef478-2f7b-43f3-9ba3-63cbb696b630",
                                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                                "text": "Divination par l’entraille et le souffle et la palpitation du souffle ! Divination par l’eau du ciel et l’ordalie des fleuves…"
                                            },
                                            {
                                                "example_id": "a4c52a0f-795f-4d38-9369-db3b83a285e3",
                                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                                "text": "On leur a enseigné les vertus des plantes et la manière de procéder à des ordalies, truquées ou non, le Jugement de Dieu ayant été d'abord le Jugement des Dieux."
                                            },
                                            {
                                                "example_id": "70b187b6-4643-4129-b11f-bf9890257f5e",
                                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                                "text": "Grâce au tribunal de la Sainte Inquisition, la sorcière était soumise à l’ordalie qui pouvait l’innocenter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff90347e-0358-46ad-a1c0-002180b97e7b",
                        "source_entry_id": "fb1c760e-69c6-3f5e-b834-6b5d2fc00b43",
                        "source_sense_id": "74885cbd-5678-3901-a060-c775edd82d8b",
                        "source_sense_description": "Entscheidung in einem Rechtsstreit, durch übernatürliches Ereignis herbeigeführt",
                        "target_lang_word": "jugement de Dieu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jugement de Dieu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acccc729-942b-321c-9189-9dbc4957c179",
                                        "entry_id": "3555594a-2486-34bb-995c-fc1c728aaa84",
                                        "glosses": [
                                            "Ensemble des preuves extraordinaires, comme le duel, l'épreuve du feu, du fer chaud, etc., auxquelles on recourait anciennement pour décider de certaines contestations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df933a3-5945-4258-8525-473f67bbb3ff",
                                                "sense_id": "acccc729-942b-321c-9189-9dbc4957c179",
                                                "text": "Mon révérend père, répondit le précepteur de Goodalricke, il n’y a pas de charme qui puisse affecter le champion qui s’offre à combattre pour le jugement de Dieu."
                                            },
                                            {
                                                "example_id": "36ab7061-e090-4686-855e-5bda5e0ff4cc",
                                                "sense_id": "acccc729-942b-321c-9189-9dbc4957c179",
                                                "text": "La 18ᵉ séance de l'Assemblée de septembre ajournée, mais non close, pour donner le temps de jouer à l’application des sanctions et au « jugement de Dieu » dans le duel italo-éthiopien, allait s'ouvrir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
