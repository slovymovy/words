                                "target_senses": [
                                    {
                                        "sense_id": "1a95199c-2d39-3cb4-9a8a-49869e748e05",
                                        "entry_id": "95ed5dbe-163a-3df4-b426-9f2453328278",
                                        "glosses": [
                                            "Ce qui est à nul autre semblable."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
