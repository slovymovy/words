                    {
                        "translation_id": "f779576e-0cfb-4322-b739-2a59d9293ca5",
                        "source_entry_id": "2dfc3e84-781e-3a80-89aa-ae1123471e0f",
                        "source_sense_id": "c6fca0f7-c21a-3d95-b268-87634b7aa160",
                        "source_sense_description": "de ruimte waar een rechtszitting gehouden wordt",
                        "target_lang_word": "prétoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prétoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "668fdcbe-bf44-340f-b132-55146c8daaad",
                                        "entry_id": "704514c9-db72-3629-b424-4b80c654bc89",
                                        "glosses": [
                                            "Lieu où le préteur et divers autres magistrats rendaient la justice."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6167f357-48e7-48c9-9ed2-2e16fa0f4dbb",
                                                "sense_id": "668fdcbe-bf44-340f-b132-55146c8daaad",
                                                "text": "Préfet du prétoire : Celui qui commandait la garde de l’empereur."
                                            },
                                            {
                                                "example_id": "a71f1ebe-4ace-4bc5-8e07-5d271e1243cb",
                                                "sense_id": "668fdcbe-bf44-340f-b132-55146c8daaad",
                                                "text": "À quelque distance du prétoire de Pilate, nous trouvâmes la piscine Probatique et le palais d’Hérode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e106f6e2-6241-329d-8748-1f6d5db69c49",
                                        "entry_id": "704514c9-db72-3629-b424-4b80c654bc89",
                                        "glosses": [
                                            "Dans le Bas-Empire, une des quatre grandes provinces de l’Empire romain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47174fff-285b-4f49-bd25-61e82403eedb",
                                                "sense_id": "e106f6e2-6241-329d-8748-1f6d5db69c49",
                                                "text": "Le préfet du prétoire des Gaules, d’Orient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4739d9f4-4652-3a90-9233-7b98bfc98358",
                                        "entry_id": "704514c9-db72-3629-b424-4b80c654bc89",
                                        "glosses": [
                                            "Enceinte d’un tribunal."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d7590b-8ee2-4970-8216-99d4118951f2",
                                                "sense_id": "4739d9f4-4652-3a90-9233-7b98bfc98358",
                                                "text": "Son fauteuil à lui, Balsamo, établi en face de celui du président, occupant la place qu’on donne à l’accusé dans les conciles ou les prétoires."
                                            },
                                            {
                                                "example_id": "0ac19f88-90a3-4fbd-9316-55e91ec2310a",
                                                "sense_id": "4739d9f4-4652-3a90-9233-7b98bfc98358",
                                                "text": "À 36 ans, elle s'était fait un nom dans les prétoires en collectionnant les acquittements ou les peines allégées pour les pires criminels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ccb579f-9126-38d5-b0ff-067aae6c4757",
                                        "entry_id": "704514c9-db72-3629-b424-4b80c654bc89",
                                        "glosses": [
                                            "Tribunal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85089d4c-be1a-4c74-b29d-2012dcaac029",
                                                "sense_id": "0ccb579f-9126-38d5-b0ff-067aae6c4757",
                                                "text": "Pour l’heure, il n’avait pas sollicité l’avocat incontournable du prétoire stéphanois."
                                            },
                                            {
                                                "example_id": "24c4a22e-5e42-4db5-890c-8b269c8ec52b",
                                                "sense_id": "0ccb579f-9126-38d5-b0ff-067aae6c4757",
                                                "text": "Dans le même temps, il est assez difficile d’identifier les risques spécifiques que pourraient générer une telle ouverture du prétoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd8c154-cf7c-351e-a9fc-7d38817796bd",
                                        "entry_id": "704514c9-db72-3629-b424-4b80c654bc89",
                                        "glosses": [
                                            "Commission de discipline des prisons."
                                        ],
                                        "tags": [
                                            "France",
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b1ae01-fab4-48d5-955e-9cb7fcd1e5f0",
                                                "sense_id": "dcd8c154-cf7c-351e-a9fc-7d38817796bd",
                                                "text": "Si des infractions ont été signalées, le directeur a obligation de tenir chaque jour un prétoire de justice disciplinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
