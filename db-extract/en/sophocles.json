                        "entry_id": "fa5dabbe-0bee-3ffa-b71d-6ffc8b86d866",
                        "glosses": [
                            "A male given name from Ancient Greek, equivalent to Ancient Greek Σοφοκλῆς (Sophoklês) or Greek Σοφοκλής (Sofoklís)."
                        ],
