                "senses": [
                    {
                        "sense_id": "0a734f51-e1a5-3722-8d87-7cbfaaee6ec1",
                        "entry_id": "e1731a08-0e26-322d-ac1a-c34f23b37306",
                        "glosses": [
                            "To do the work of a Dorcas; to make and distribute clothes to the poor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2e050d-27e7-484f-aa2a-089b6473262b",
                                "sense_id": "0a734f51-e1a5-3722-8d87-7cbfaaee6ec1",
                                "text": "They had been pouring tea and passing wafers when they should have been Dorcassing at their Christmas tasks."
                            },
                            {
                                "example_id": "20a6d972-7196-413e-8a2d-a746915dfb62",
                                "sense_id": "0a734f51-e1a5-3722-8d87-7cbfaaee6ec1",
                                "text": "It was by good works of this kind — not by doles , “Dorcassing,” and such-like — that Ossett gained and deserved the title of a “Charitable Man.”"
                            },
                            {
                                "example_id": "bb018f7c-e287-4107-9ec4-04d4b308a6a2",
                                "sense_id": "0a734f51-e1a5-3722-8d87-7cbfaaee6ec1",
                                "text": "Peter and Paul knew what they were about when they kept the women Dorcassing and such like."
                            }
                        ]
                    }
                ],
