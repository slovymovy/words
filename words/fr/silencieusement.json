                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat s'approchait <w>silencieusement</w> de la souris sans faire le moindre bruit."
                        },
                        {
                            "text": "Elle a fermé <w>silencieusement</w> la porte pour ne pas réveiller les enfants endormis."
                        }
                    ],
