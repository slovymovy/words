                "senses": [
                    {
                        "sense_id": "44ae0059-e605-31fe-9ccd-f11aa7177be4",
                        "entry_id": "830ce99b-546c-3dda-b556-394ecdbdc98e",
                        "glosses": [
                            "Schriftzeichen, das nicht gesprochen wird, an ein Wort angehängt wird und einen Hinweis darauf gibt, zu welcher Bedeutungsklasse das Wort gehört"
                        ],
                        "tags": [
                            "Ägyptologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b5bdbd1c-9a62-45e7-b334-e161fc3c975b",
                                "sense_id": "44ae0059-e605-31fe-9ccd-f11aa7177be4",
                                "text": "„Als drittes hat die Hieroglyphenschrift Zeichen, die weder etwas über die Aussprache verraten – so wie die Lautzeichen – noch über die Bedeutungsklasse – so wie die Sinnzeichen –, sondern die man nur zur Schreibung eines einzigen Wortes (mit seinen Ableitungen) verwendet.“"
                            }
                        ],
