                        ]
                    },
                    {
                        "translation_id": "a4c0f0ee-54e2-4686-be70-a1213778b723",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "covertly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "covertly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                        "entry_id": "a3bb890e-6fa6-34b6-931c-40839b77a4f0",
                                        "glosses": [
                                            "In a covert manner, secretly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92bcb9ca-86e5-436e-a2e8-011c96b45972",
                                                "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                                "text": "Only a little removed from the predatory oafdom of male adolescence, he is suspicious of Christian and covertly protective of Cher's person and future."
                                            },
                                            {
                                                "example_id": "4798c8cc-07f7-44d9-a834-66cc6191142d",
                                                "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                                "text": "Shimon’s interestingly stereotypical role as a conformist, but in reality covertly resistant, dominand […] is accentuated in the second half of the story[.]"
                                            },
                                            {
                                                "example_id": "24ad0c24-4686-450c-8018-b6559624688a",
                                                "sense_id": "dbc7747d-dec1-3af1-a66e-956efd365119",
                                                "text": "Over at least the past year, RT and its employees, including KOSTIANTYN KALASHNIKOV, a/k/a \"Kostya,\" and ELENA AFANASYEVA, a/k/a \"Lena,\" the defendants, have deployed nearly $10 million, laundered through a network of foreign shell entities, to covertly fund and direct U.S. Company-1."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04ce85ed-f6da-48c7-8573-cd7bd21dc05a",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "klammheimlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klammheimlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23d7a475-13d7-34ba-b518-8bd92e5eec6e",
                                        "entry_id": "8285f1c0-c14c-3fb0-aa05-32cc0d28bc7a",
                                        "glosses": [
                                            "ganz heimlich"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab01b107-9218-4634-bc26-48a4dc297cea",
                                                "sense_id": "23d7a475-13d7-34ba-b518-8bd92e5eec6e",
                                                "text": "Er kletterte klammheimlich aus dem Küchenfenster."
                                            },
                                            {
                                                "example_id": "29e76ba5-1a4f-4804-99c5-a7b720e16f0d",
                                                "sense_id": "23d7a475-13d7-34ba-b518-8bd92e5eec6e",
                                                "text": "„Gelegentlich werden sie sogar verdächtigt, dass sie mit den Taliban, den Mullahs oder mit den Ultraorthodoxen sympathisieren und womöglich sogar Prügelstrafen oder Steinigungen klammheimlich in Kauf nehmen.“"
                                            },
                                            {
                                                "example_id": "cadafd15-e4a9-43b2-94e2-52496f8ef78a",
                                                "sense_id": "23d7a475-13d7-34ba-b518-8bd92e5eec6e",
                                                "text": "„Der Hass könnte niemals solche Wirkung entfalten, nicht so nachhaltig, nicht so dauerhaft, nicht überall in der ganzen Republik aufbrechen und sich entladen, gäbe es nicht die klammheimliche Duldung derer, die vielleicht nicht die Mittel von Gewalt und Einschüchterung gutheißen, aber doch das Objekt, an dem sich der Hass entlädt, missachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d15cf783-2335-4db0-9f7f-4e4d708e46f7",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "heimlich, still und leise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "695a282d-a6b2-49aa-bccb-b9d7c82acf02",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "in einer Nacht-und-Nebel-Aktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fd59ffe3-5811-41d2-bcb8-718547de97b7",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "en cachette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en cachette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                        "entry_id": "313f273b-3a5d-3599-b8fd-8901bb6f0f6f",
                                        "glosses": [
                                            "En secret : à la dérobée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b087d0a3-5fd7-41dc-8572-ea38c70be093",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "Souvenez-vous des paroles de nos pères théologiens, Hurtado de Mendoza et Sanchez, qui ont prouvé qu’on peut tuer en cachette son ennemi, puisque l’on évite par ce moyen deux péchés : celui d’exposer sa vie, et celui de se battre en duel. C’est d’après ce grand principe consolateur que j’ai toujours agi."
                                            },
                                            {
                                                "example_id": "855bb94c-17d6-465d-8309-7b8d31491cdf",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "Puisque j'arrivais à tenir et à diriger un porte-plume, pourquoi pas aussi un petit pinceau ? En cachette, j’essayai, je m’évertuai, j’éduquai mes doigts et mon poignet et j’arrivai à un résultat relativement satisfaisant."
                                            },
                                            {
                                                "example_id": "6b80f6eb-22b2-440b-9ca4-26392a369a4e",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "– Demande à papa. Dis-lui que c’est pour acheter des cigarettes et que tu les lui demandes en cachette de maman, il te les donnera."
                                            },
                                            {
                                                "example_id": "08475ea3-fa0c-426f-bc32-3cc907a16fcd",
                                                "sense_id": "226d8760-505b-334c-87c7-47bcd70651e6",
                                                "text": "Elle buvait en cachette tandis que vous vous écriviez, en cachette aussi, un livre sur ce drame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81afcd25-28fc-4813-9941-89abb94531a1",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "en douce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en douce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                        "entry_id": "3f1f51c7-cb81-3967-9cf1-6e188ab0e6aa",
                                        "glosses": [
                                            "En essayant de ne pas se faire voir, de ne pas attirer l’attention."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429a8929-0eea-4e9d-971a-e9be5d199d7f",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "Tu parles d’un mecton qui connaissait les heures des trains ! Tu l’voyais s’rentrer en s’glissant en douce dans un groupe du dépôt où c’était l’filon, et y rester, toujours en douce poil-poil, et même, i’ s’donnait beaucoup d’mal pour que les copains ayent besoin de lui."
                                            },
                                            {
                                                "example_id": "cb151ebc-8a80-480e-b0b1-53acb81de937",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "De n’pas danser, on mord les autres, n’est-ce pas ? et j’ai justement vu — quand tu m’interrogeais — une connaissance avec qui j’suis en affaire et qui, en douce, m’a fait signe de rappliquer."
                                            },
                                            {
                                                "example_id": "a5ffee8d-a086-467f-9b68-b524fca493cb",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "J’ai fait ça en douce\nJe suis v’nue je n’sais pas comment […]"
                                            },
                                            {
                                                "example_id": "32f8652c-17b5-4582-b91c-eede2869d971",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "Tenez, les gars, dans un aut’film que j’me suis payé à Noël, en douce, la Chair et le Diable, y a une femme ! Oh ! là là."
                                            },
                                            {
                                                "example_id": "bfba429f-7fe0-4242-8b48-e0a26546dac9",
                                                "sense_id": "dfd47dda-cb1f-3d5d-b065-24afd64c1cb2",
                                                "text": "– Tu pourrais me signer mon cahier ?\n– Bien sûr. […] Voyons voir… “Louis ne sait pas se tenir en classe.”\n Ah, je comprends mieux. Tu veux me faire signer ton cahier en douce pour éviter de le montrer à ta mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3acd9dcb-8eef-4075-a716-4edec6596d12",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "par derrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par derrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc735de5-ce74-3c9d-addb-935d9c479c42",
                                        "entry_id": "db34b04e-4c26-3fbd-be0e-16ee8ad91d6e",
                                        "glosses": [
                                            "Par la partie postérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26680b4-2cfa-4866-91d1-b3257d51ff99",
                                                "sense_id": "fc735de5-ce74-3c9d-addb-935d9c479c42",
                                                "text": "L’infortuné n’avait pas eu le temps de presser ce bouton. Déjà ses assaillants le frappaient, sauvagement, par derrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c3cbbca-17ad-4481-a8d5-4197cadc9744",
                        "source_entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                        "target_lang_word": "sournoisement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sournoisement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                        "entry_id": "c62cf84c-3e41-3647-bfdc-8a464f363dda",
                                        "glosses": [
                                            "D’une manière sournoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd276f96-3e73-4f60-9110-a394c2c4f647",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "Le cabinet de Vienne se déterminait sournoisement à la guerre,"
                                            },
                                            {
                                                "example_id": "a50a25ef-bedd-411c-8756-493b01efabf9",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "Il pressentait que l’eau triompherait des semelles sans résistance, et, sournoisement, s’infiltrerait jusqu'aux chevilles."
                                            },
                                            {
                                                "example_id": "66fe3a70-7820-4436-89b5-e4c32c2adb76",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "On n'échappe pas aux morsures de l’ypérite qui, sournoisement, s’accroche à la peau."
                                            },
                                            {
                                                "example_id": "71fb032d-085a-428a-b76b-08954977115b",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "Parti de Marrakech pour se rendre à Fez, il ne parvint que jusqu’à l’Oued El-Abid, au Tedla, où il succomba subitement à une maladie qui le minait sournoisement depuis longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
