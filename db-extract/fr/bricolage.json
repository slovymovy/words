                                        "glosses": [
                                            "Do-it-yourself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc25a54-1550-44ad-beeb-d401c1d0d342",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "Do you know where I could find a DIY pipe repair kit?"
                                            },
                                            {
                                                "example_id": "5517abcb-e8b2-4241-a4f0-3b8dbf8d1d0b",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "The product knowledge of salespeople is very high, which enables them to serve the demanding customer groups such as professional painters and builders, in addition to the usual DIY consumers."
                                            },
                                            {
                                                "example_id": "ff372f63-64b5-4333-a076-410cc655b3da",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "That is more DIY, more punk, anyway."
                                            },
                                            {
                                                "example_id": "92704706-c746-44aa-b8e1-76af4f673eaa",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "A temple abbot who used a DIY guillotine to behead himself in hope of attaining enlightenment might have misinterpreted some things along the way, Thailand’s religious authorities said yesterday."
                                            }
                                        ]
                                    }
                                ]
                            },
