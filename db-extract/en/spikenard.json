                                                "example_id": "a69e8b7a-97f0-4294-a8fb-f66dd0963a4e",
                                                "sense_id": "583e92cb-994c-326e-a034-56dc0ccddbc6",
                                                "text": "Ainsi, t’emportes-tu aujourd’hui contre cette femme qui vient d’arroser mes pieds d’un nard payé très cher, comme si mes pauvres ne devaient jamais profiter de l’industrie des parfumeurs."
                                            },
                                            {
                                                "example_id": "cee1b9d5-5930-4165-8ec6-78f0ab4c58d6",
                                                "sense_id": "583e92cb-994c-326e-a034-56dc0ccddbc6",
                                                "text": "Le nard des pinèdes peut être utilisé dans des tisanes ou pour devenir des épices à viande."
                                            },
                                            {
                                                "example_id": "2e87bf14-bbf1-4a48-97e3-4f67b941f5d5",
                                                "sense_id": "583e92cb-994c-326e-a034-56dc0ccddbc6",
                                                "text": "Il s’agit d’ingrédients naturels dont des poudres de santal, de dammar, de nard, de cannelle, de girofle, enroulés dans une feuille de papier fabriquée à partir de la fibre d’écorce de lokta, le « laurier du Népal »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eff726ec-afba-36b6-ae34-9c9ca8d95344",
                                        "entry_id": "8301a11b-9a6f-3c52-b2a9-46f16308dc5a",
                                        "glosses": [
                                            "Jeu de plateau d’origine perse proche du backgammon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45136122-5c55-4923-8173-ed1403ef6979",
                                                "sense_id": "eff726ec-afba-36b6-ae34-9c9ca8d95344",
                                                "text": "[…] ; bazar des drapiers, à l’intérieur d’une échoppe surélevée, une partie de nard se dispute encore à la lumière d’une lampe à huile, deux dés jetés, un juron, un rire étouffé ; …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cdcdb03-dda9-4ef5-bbd0-ea110931a1e0",
                        "source_entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "source_sense_description": "The plant Nardostachys jatamansi",
                        "target_lang_word": "spigonardo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ce03c545-ab7f-43dd-bc27-759ee44b27d5",
                        "source_entry_id": "d7331628-6b31-301f-8cff-2128babdfca1",
                        "source_sense_description": "The plant Nardostachys jatamansi",
                        "target_lang_word": "нард",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нард",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5718003c-8034-3430-8790-7d644ced0a17",
                                        "entry_id": "cc952da7-be6f-3bc4-ac66-738b28783914",
                                        "glosses": [
                                            "травянистое растение семейства валериановых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6360b6-f9e5-47e6-9fc9-d3714138b9d8",
                                                "sense_id": "5718003c-8034-3430-8790-7d644ced0a17",
                                                "text": "Женщины одеваются далеко не так изысканно, как мужчины: знатная дама и швея одинаково носят чёрное платье и мантилью, и душистый нард так же ярко белеется на чёрно-синих волосах швеи, как и на волосах маркизы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b7382e-5d78-3199-8a8d-e3f38717dbf6",
                                        "entry_id": "cc952da7-be6f-3bc4-ac66-738b28783914",
                                        "glosses": [
                                            "эфирное масло, получаемое из нарда [1], использующееся в косметических и медицинских целях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92d519f8-2c2b-40ee-9b1a-8d28e7527aba",
                                                "sense_id": "a1b7382e-5d78-3199-8a8d-e3f38717dbf6",
                                                "text": "Доколе царь был за столом своим, нард мой издавал благовоние своё."
                                            },
                                            {
                                                "example_id": "bd5c422d-0a3e-4675-a5df-8a62e8b697c8",
                                                "sense_id": "a1b7382e-5d78-3199-8a8d-e3f38717dbf6",
                                                "text": "«Теплота твоей одежды благоухает лучше, чем мирра, лучше, чем нард», ― говорит он, жарко касаясь губами её уха."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
