                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f462d03-0a0c-42c8-a054-f302622b03cf",
                                "sense_id": "f59fc9a8-efc4-3c08-9678-90c9855c7005",
                                "text": "Мы существу́ем совсе́м свобо́дно, то́ есть прозяба́ем, лжём и пустосло́вим, са́ми по себе́, без вся́ких осно́в.",
                                "translation": "We exist in total freedom — that is, we vegetate, lie, and prattle entirely of our own accord without any bases whatsoever.",
                                "english": "We exist in total freedom — that is, we vegetate, lie, and prattle entirely of our own accord without any bases whatsoever."
                            }
                        ]
                    }
