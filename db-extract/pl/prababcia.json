                ],
                "translations": [
                    {
                        "translation_id": "92d75a37-e5d1-45ba-a4b5-df6d264b6bda",
                        "source_entry_id": "73e128a6-f6ee-3f19-9342-75c5d0c2f0ee",
                        "source_sense_id": "2af189f7-f9d4-3018-bcc9-04d0646f9f67",
                        "target_lang_word": "great-grandmother",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "great-grandmother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef422c9-5cf9-3021-b2c7-576bcf682196",
                                        "entry_id": "106db0d2-cc87-32dc-8337-02850067d3a5",
                                        "glosses": [
                                            "The mother of one's grandparent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174f0ce0-0f5e-43ef-aed4-58d192719fe0",
                                                "sense_id": "1ef422c9-5cf9-3021-b2c7-576bcf682196",
                                                "text": "She’s now a great-grandmother with three sons, a grandson and two great-grandchildren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff8815f9-0f15-4f53-aeb2-66e38b365112",
                        "source_entry_id": "73e128a6-f6ee-3f19-9342-75c5d0c2f0ee",
                        "source_sense_id": "2af189f7-f9d4-3018-bcc9-04d0646f9f67",
                        "target_lang_word": "arrière-grand-mère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-grand-mère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7923965c-a887-362b-9a8a-e9271a76ed3a",
                                        "entry_id": "76cf652b-89e9-3bac-81bd-5e1aaa77daea",
                                        "glosses": [
                                            "La mère de l’un des grands-parents."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f833aaf6-a936-4dcb-ae1f-383e958b7ea4",
                                                "sense_id": "7923965c-a887-362b-9a8a-e9271a76ed3a",
                                                "text": "Mon arrière-grand-mère juive et mon arrière-grand-père palestinien ont eu neuf enfants. Ma grand-mère était l’aînée. L’histoire s'est vraiment compliquée pendant la grande révolte arabe."
                                            },
                                            {
                                                "example_id": "129085fd-ae5d-43a2-bbdd-b17e0c1c0fdf",
                                                "sense_id": "7923965c-a887-362b-9a8a-e9271a76ed3a",
                                                "text": "La famille entretenait un culte marial assidu. Les grands-mères et arrière-grands-mères avaient toutes accompli le pèlerinage de Lourdes."
                                            },
                                            {
                                                "example_id": "9403e291-d61e-4638-9dd2-dc031c6d1f5f",
                                                "sense_id": "7923965c-a887-362b-9a8a-e9271a76ed3a",
                                                "text": "Léontine Joudoux, 102 ans, arrière-grand-mère d’Emma, l’une des élèves, participe à ce spectacle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77bf2f91-885a-4592-aed7-cf90c0d3a043",
                        "source_entry_id": "73e128a6-f6ee-3f19-9342-75c5d0c2f0ee",
                        "source_sense_id": "2af189f7-f9d4-3018-bcc9-04d0646f9f67",
                        "target_lang_word": "bisabuela",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bisabuela",
