                "senses": [
                    {
                        "sense_id": "bdc9a155-d392-33b6-bd14-daed7af612b0",
                        "entry_id": "75ab4307-960f-31c9-9633-5490a34e8a01",
                        "glosses": [
                            "Sorte de comédie où la personne qui l’exécute est debout devant les spectateurs."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "8a638f1b-3196-4e85-8a00-2da996b2e2c4",
                                "sense_id": "bdc9a155-d392-33b6-bd14-daed7af612b0",
                                "text": "Ces deux spectacles s'amusent avec les codes du stand-up : un seul interprète, une adresse directe au public, un décor sobre et une histoire écrite avec rythme et phrases percutantes, ces fameuses punchlines qui déclenchent souvent les rires , et restent ensuite en tête."
                            },
                            {
                                "example_id": "2aa3e6cc-7dab-4dd9-a2b7-52b5c28dad37",
                                "sense_id": "bdc9a155-d392-33b6-bd14-daed7af612b0",
                                "text": "Les stand-uppers ne sont pas réputés pour être des gens sympas, à l’aise avec eux-mêmes. Les Américains pensent d’ailleurs qu’on ne peut pas faire du stand-up si notre vie va bien."
                            },
                            {
                                "example_id": "d4198cd8-b72e-43d5-bc8c-c020935ad95d",
                                "sense_id": "bdc9a155-d392-33b6-bd14-daed7af612b0",
                                "text": "Dans son nouveau spectacle de stand-up, le comédien assure qu’il ne représentera plus la plus prestigieuse cérémonie du 7ᵉ art."
                            },
                            {
                                "example_id": "b0a60240-dd0f-4c27-a71e-8a6592a74dec",
                                "sense_id": "bdc9a155-d392-33b6-bd14-daed7af612b0",
                                "text": "Ces deux spectacles s'amusent avec les codes du stand-up : un seul interprète, une adresse directe au public, un décor sobre et une histoire écrite avec rythme et phrases percutantes, ces fameuses punchlines qui déclenchent souvent les rires , et restent ensuite en tête."
                            }
                        ]
                    }
