            "senses": [
                {
                    "sense_id": "b60ff6c7-b10f-3187-957b-9edf20fd4677",
                    "sense_definition": "Innere Unsicherheit, Scheu oder Befangenheit, die jemanden daran hindert, unbeschwert und frei zu handeln",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit ein wenig Übung konnte er seine <w>Hemmungen</w> vor dem großen Publikum schließlich überwinden."
                        },
                        {
                            "text": "Auf der Tanzfläche verlor sie nach einer Weile alle <w>Hemmungen</w> und tanzte ausgelassen mit."
                        }
                    ],
                    "antonyms": [
                        "Mut",
                        "Sicherheit",
                        "Entspannung"
                    ],
                    "common_phrases": [
                        "Hemmungen überwinden",
                        "alle Hemmungen verlieren",
                        "soziale Hemmung"
                    ]
                },
                {
                    "sense_id": "b14498c5-2c8f-37b1-b673-a667ecfbab10",
                    "sense_definition": "Innere Bedenken oder moralischer Widerstand gegen eine bestimmte Handlung",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Betrüger hatte keinerlei <w>Hemmungen</w>, die Gutgläubigkeit älterer Menschen schamlos auszunutzen."
                        },
                        {
                            "text": "Aus moralischer <w>Hemmung</w> weigerte sich die Zeugin zunächst, gegen ihren früheren Kollegen auszusagen."
                        }
                    ],
                    "synonyms": [
                        "Bedenken",
                        "Skrupel"
                    ],
                    "antonyms": [
                        "Entschlossenheit"
                    ],
                    "common_phrases": [
                        "keine Hemmungen haben",
                        "moralische Hemmung"
                    ]
                },
                {
                    "sense_id": "1a7ed46e-2c18-335b-81b9-35035f3b1abd",
                    "sense_definition": "Verlangsamung, Erschwerung oder Blockierung eines natürlichen, biologischen oder technischen Vorgangs",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prozess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neu entwickelte Medikament bewirkt eine gezielte <w>Hemmung</w> der Entzündung im Körper."
                        },
                        {
                            "text": "Bürokratische Hürden führten zu einer spürbaren <w>Hemmung</w> der wirtschaftlichen Entwicklung des Unternehmens."
                        }
                    ],
                    "synonyms": [
                        "Hemmnis",
                        "Behinderung",
                        "Hindernis"
                    ],
                    "common_phrases": [
                        "Hemmung des Wachstums"
                    ]
                },
                {
                    "sense_id": "48419962-6fd9-3c0e-8db9-5bee7c946427",
                    "sense_definition": "Bauteil in mechanischen Uhren, das die Kraftübertragung reguliert und den gleichmäßigen Ablauf des Räderwerks steuert",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Uhrmacher überprüfte die mechanische <w>Hemmung</w> sorgfältig, um den gleichmäßigen Gang der Taschenuhr zu sichern."
                        },
                        {
                            "text": "Eine defekte <w>Hemmung</w> führte dazu, dass die historische Wanduhr ständig stehen blieb."
                        }
                    ],
                    "synonyms": [
                        "Gang"
                    ],
                    "common_phrases": [
