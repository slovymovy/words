                                "sense_id": "dd389873-8771-306f-ab4f-4a02b30d6487",
                                "text": "Wziąłem na siebie ciężar tajemnicy i celowo dezinformowałem panów"
                            },
                            {
                                "example_id": "04e465ec-30a6-4ed8-b74d-0493ad8bfc0b",
                                "sense_id": "dd389873-8771-306f-ab4f-4a02b30d6487",
                                "text": "Pragnął jak najszybciej oddalić się od fatalnego miejsca. Celowo zmienił trasę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
