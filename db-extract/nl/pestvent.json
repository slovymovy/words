                        "examples": [
                            {
                                "example_id": "d7b530ab-8483-4602-ae9d-517742486225",
                                "sense_id": "2fe80658-e932-3fdb-a915-c15236a44604",
                                "text": "„Op de basisschool was ik een pestventje. Er is een punt geweest dat ze me van school wilden sturen. Ik heb mensen nooit lichamelijk pijn gedaan maar wel samen met een andere jongen heel veel gepest. We konden met zijn tweeën een groep van tien man helemaal gek maken en we waren altijd aan het lachen. Het was makkelijk iemand die naast je stond in de zeik te nemen."
                            }
                        ]
                    }
