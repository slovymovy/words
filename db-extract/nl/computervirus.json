                        "entry_id": "5f995b59-d843-37f1-9714-51fcdc319171",
                        "glosses": [
                            "schadelijk computerprogramma dat zich kopieert naar andere programma's en van binnenuit de computer kapotmaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d92b8ef-d69a-41fc-939f-64d342807637",
                                "sense_id": "13d4b26d-d304-35aa-bf1c-b65f8d046160",
                                "text": "Een computervirus heeft de eigenschap dat het zichzelf kan overbrengen op andere programma's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38bd1fd9-5f3f-4c22-a10e-17bf391d239d",
                        "source_entry_id": "5f995b59-d843-37f1-9714-51fcdc319171",
