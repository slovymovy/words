                        "glosses": [
                            "Celle qui fait du canotage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac3c070b-b2f0-4d03-a16a-1303f48c4b34",
                                "sense_id": "f642b616-6255-32f7-a57f-04c9adc06519",
                                "text": "Les Schwanthaler donnèrent une grande soirée, non plus une de leurs soirées académiques d’autrefois, sobres de lumières et de bruit, mais un magnifique bal travesti, où Mme de Schwanthaler et ses filles parurent en canotières de Bougival, les bras nus, la jupe courte, et le petit chapeau plat à rubans éclatants."
                            },
                            {
                                "example_id": "3e8b954d-6024-4663-928c-7ca7f8f80cde",
                                "sense_id": "f642b616-6255-32f7-a57f-04c9adc06519",
                                "text": "Les canotières s’étalaient dans leur fauteuil en face de leurs mâles aux forts poignets, et elles considéraient avec mépris les quêteuses de dîners rôdant par l’île."
                            }
                        ]
                    }
