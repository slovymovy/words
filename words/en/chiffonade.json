    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83f9f056-1e73-3fd1-8c1b-517077b1800d",
                    "sense_definition": "A culinary preparation of herbs or leafy greens sliced into thin strips or ribbons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culinary_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sprinkle a fresh <w>chiffonade</w> of basil over the tomato pasta right before serving.",
                            "target_lang_translations": {
                                "zh": "上菜前，将新鲜的罗勒<w>细丝</w>撒在番茄意面上。"
                            }
                        },
                        {
                            "text": "The recipe calls for a delicate <w>chiffonade</w> of mint to garnish the fruit salad.",
                            "target_lang_translations": {
                                "zh": "食谱要求切出精致的薄荷<w>细丝</w>来装饰水果沙拉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chiffonade of basil",
                        "fresh chiffonade"
                    ],
                    "target_lang_definitions": {
                        "zh": "将香草或绿叶蔬菜切成细丝或薄条的烹饪切法（或切成的丝状物）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蔬菜丝",
                                "target_lang_sense_clarification": "指切细的叶菜丝"
                            },
                            {
                                "target_lang_word": "细丝",
                                "target_lang_sense_clarification": "指切出的香草或绿叶细丝"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b30f0cd2-2053-3d99-8ecb-128f8e241dbb",
                    "sense_definition": "To cut herbs or leafy vegetables into long, thin strips.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "culinary_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stack the spinach leaves together tightly before you <w>chiffonade</w> them with a sharp knife.",
                            "target_lang_translations": {
                                "zh": "用锋利的刀把菠菜叶<w>切细丝</w>之前，先将它们紧紧叠在一起。"
                            }
                        },
                        {
                            "text": "The chef demonstrated how to <w>chiffonade</w> fresh herbs quickly and cleanly.",
                            "target_lang_translations": {
                                "zh": "主厨示范了如何干净利落地将新鲜香草<w>切丝</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chiffonade herbs",
                        "chiffonade leaves"
                    ],
                    "target_lang_definitions": {
                        "zh": "把香草或绿叶蔬菜切成细长条或细丝。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "切细丝",
                                "target_lang_sense_clarification": "烹饪刀法，切成细长条"
                            },
                            {
                                "target_lang_word": "切丝",
                                "target_lang_sense_clarification": "将食材切成丝状"
                            }
                        ]
                    }
                }
            ]
        }
    ]
