                "senses": [
                    {
                        "sense_id": "99f88dff-ae37-345a-a779-2884b9067574",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "naam voor coniferen uit het geslacht Thuja, oorspronkelijk groeiend in Oost-Azië en Noord-Amerika"
                        ],
                        "tags": [
                            "coniferen"
                        ],
                        "examples": [
                            {
                                "example_id": "2133949d-4cea-4067-bb4b-2e1709586542",
                                "sense_id": "99f88dff-ae37-345a-a779-2884b9067574",
                                "text": "Dr. Gachet zette op het graf van Van Gogh een levensboom neer waar Van Gogh zo van hield."
                            }
                        ]
                    },
                    {
                        "sense_id": "70b5c80f-f27d-3874-aa19-955202b518bd",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "deel van de kleine hersenen waarvan de vorm op een vertakte boomstam lijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95275ddb-13cd-4c5d-bcf4-5e3e6c1edde5",
                                "sense_id": "70b5c80f-f27d-3874-aa19-955202b518bd",
                                "text": "De ongeschonden hersenschors onthult niet eens dat een doorsnede van de kleine hersenen, grillig vertakt, de zogenaamde levensboom vormt."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddad6d91-3604-3a44-8fd0-8fb4979b7dcb",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "boom geplant bij de geboorte van een kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d155de1c-f566-4746-a2b6-bc8985469485",
                                "sense_id": "ddad6d91-3604-3a44-8fd0-8fb4979b7dcb",
                                "text": "Ook bij de huwelijksgebruiken speelt deze levensboom een rol."
                            }
                        ]
                    },
                    {
                        "sense_id": "62c2c5fb-18a7-3be2-81dc-2e242bcfb637",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "het bestaan als een ontwikkeling die iemand vanaf zijn geboorte doormaakt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1a822890-36e8-4c60-ae36-57918852818a",
                                "sense_id": "62c2c5fb-18a7-3be2-81dc-2e242bcfb637",
                                "text": "Toch is onze levensboom geschud door de orkanen Gods."
                            }
                        ]
                    },
                    {
                        "sense_id": "07d458fe-aff0-39da-8649-4bd87fde358d",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "boom die de onderdelen van het heelal met elkaar verbindt (hindoeïsme, boeddhisten, Germanen)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e873c9f4-2ced-3604-a6cf-b78a636bd7e7",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "boom met vruchten die onsterfelijk maken, in het bijzonder zoals beschreven in het Bijbelse paradijs (Gen. 2:9; 3:22; Spreuk. 11:30; Openb. 2:7; 22:2 en 22:14)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f7db08-47db-40db-ac09-1de91e59cc51",
                                "sense_id": "e873c9f4-2ced-3604-a6cf-b78a636bd7e7",
                                "text": "Zij moesten de weg naar de levensboom bewaken"
                            }
                        ]
                    },
                    {
                        "sense_id": "1787fa24-0956-352b-b169-cfb50bde2ea4",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "geloof in Christus, dat immers tot eeuwig leven in het paradijs leidt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dfacd606-e1cb-38ce-adc4-551a4a626d72",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "onuitputtelijke bron van vitaliteit"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "26080a92-cfc9-3b3a-a5c2-8c4323c55988",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "boom als heilige plaats om een godheid te vereren"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f76a036b-3038-33f2-92fb-87573405715d",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "symbolische voorstelling van het hele universum"
                        ],
                        "tags": [
                            "bij kabbalisten"
                        ],
                        "examples": [
                            {
                                "example_id": "8997035c-e807-453f-ab09-be950e28046a",
                                "sense_id": "f76a036b-3038-33f2-92fb-87573405715d",
                                "text": "Ook wij moeten leren onze wijsheid langs de levensboom omlaag te brengen en toe te passen in de gewone wereld."
                            }
                        ]
                    },
                    {
                        "sense_id": "e103ab81-83f2-391d-beb9-3c6a9fab1536",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "beeld of afbeelding als symbool dat naar een van de hiervoor genoemde de religieuze of figuurlijke betekenissen verwijst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2702586-cd6d-47c6-b583-fe1bf0ccdb3e",
                                "sense_id": "e103ab81-83f2-391d-beb9-3c6a9fab1536",
                                "text": "De levensboom bestaat uit een kronkelende tak met bloemen, waartussen vogels als pauwen, duiven en papegaaien zitten."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d0b0640-6ece-383c-a8dd-74feb45ed7e8",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "bepaald runeteken; door nazi's gebruikt als symbool voor leven en door sommigen gebruikt als symbool voor extreem nationalisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1be67a-9941-45cd-9c21-90a9356d692d",
                                "sense_id": "0d0b0640-6ece-383c-a8dd-74feb45ed7e8",
                                "text": "Hun logo is de Algizrune, ook wel levensboom genoemd (...)"
                            }
                        ]
                    },
                    {
                        "sense_id": "4dc1fbb0-6437-3710-a6ba-38c1df3beed5",
                        "entry_id": "bee3b2f4-4bbd-30c7-8e97-18b454969ff4",
                        "glosses": [
                            "versiering in het bovenlicht boven een deur, vaak van gietijzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c06448-67c2-4215-be08-2189a9777825",
                                "sense_id": "4dc1fbb0-6437-3710-a6ba-38c1df3beed5",
                                "text": "De twee vensters van de zaadzolder op de verdieping bezitten diefijzers. In het bovenlicht van de voordeur zit een gietijzeren levensboom."
                            }
                        ]
                    }
