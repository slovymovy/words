                ],
                "senses": [
                    {
                        "sense_id": "263c0adf-7a45-3dcb-aee4-5881d341a867",
                        "entry_id": "d1c3c88b-b369-3238-b6e5-5c50f8459fe0",
                        "glosses": [
                            "unzutreffende Nachricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5ee8db-dad1-4c37-8fb2-945a753e155c",
                                "sense_id": "263c0adf-7a45-3dcb-aee4-5881d341a867",
                                "text": "Diese Nachricht hier könnte auch eine Fehlmeldung sein, wir sollten bei dem Kunden noch einmal nachhaken."
                            },
                            {
                                "example_id": "eb73f1d5-c8c8-41c2-8e75-65715e7b3ed9",
                                "sense_id": "263c0adf-7a45-3dcb-aee4-5881d341a867",
                                "text": "Da ist die Zeitung wohl einer Fehlmeldung aufgesessen!"
                            },
                            {
                                "example_id": "ee526447-e901-4eab-9975-1d9ed9c7a5aa",
                                "sense_id": "263c0adf-7a45-3dcb-aee4-5881d341a867",
                                "text": "„Ich habe noch nicht unterzeichnet, das war eine Fehlmeldung der BILD-Zeitung. Ich muß mich erst mal kundig machen, um was es da alles geht, […].“"
                            },
                            {
                                "example_id": "af5c2b59-1269-443b-ab15-f6b553b566a9",
                                "sense_id": "263c0adf-7a45-3dcb-aee4-5881d341a867",
                                "text": "Fast 99 Prozent der Alarme waren Fehlmeldungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "12ffedf6-a9b1-35c6-8f81-11561083e97b",
                        "entry_id": "d1c3c88b-b369-3238-b6e5-5c50f8459fe0",
                        "glosses": [
                            "Nachricht, die darüber informiert, was nicht da ist, also darüber, was fehlt Rückmeldung zu einer Anfrage/Abfrage, dass diese zwar bearbeitet wurde, aber darüber hinaus kein inhaltliches Ergebnis zu vermelden ist"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "0a33f120-c629-4dbc-b15a-e425b7074e20",
                                "sense_id": "12ffedf6-a9b1-35c6-8f81-11561083e97b",
                                "text": "„Der einzige Vorteil, der mit dem Anheften der Fehlmeldung an die Lagerfachkarte verbunden ist, ist die beschleunigte Nachlieferung, da nun nicht erst bis zur mengenmäßigen Zugangsbuchung gewartet werden muß.“"
                            },
                            {
                                "example_id": "b5b24595-6e85-47f5-9ce7-7d4a78569518",
                                "sense_id": "12ffedf6-a9b1-35c6-8f81-11561083e97b",
                                "text": "„Am 30. April erstattet die Kreisverwaltung über den Eingang der Zählpapiere dem Statistischen Landesamt Meldung; bei Nichteingang ist Fehlmeldung erforderlich.“"
                            },
                            {
                                "example_id": "9fd6426a-0da1-4545-afaa-27a36c774cef",
                                "sense_id": "12ffedf6-a9b1-35c6-8f81-11561083e97b",
                                "text": "„Die restlichen 177 Fälle setzten sich aus verschiedenen Fehlmeldungen zusammen: Verweigerung einer Antwort (52%), nicht angetroffene Personen (25%) und verschiedene Gründe (23%).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
