                        ],
                        "examples": [
                            {
                                "example_id": "5c633e42-e2b1-498f-bbea-4e2a9fc54db7",
                                "sense_id": "efbd6a14-8375-31a2-bd7f-b9a1f8e96f73",
                                "text": "Peter leistet sich einen nagelneuen Fünfhunderter."
                            },
                            {
                                "example_id": "25aef5a2-6d4a-4eaa-8846-50768450a97c",
                                "sense_id": "efbd6a14-8375-31a2-bd7f-b9a1f8e96f73",
                                "text": "„Andererseits versuchen immer wieder Bastler, aus einem 08/15-Fünfhunderter einen Möchtegern-Abarth zu zaubern.“"
                            },
                            {
                                "example_id": "efa1cc8d-37b5-40fc-846c-e0fa90785e18",
                                "sense_id": "efbd6a14-8375-31a2-bd7f-b9a1f8e96f73",
                                "text": "„Fiat hat seinen 500 behutsam verändert und will mit neuen Modellen zurück zum Erfolg. Auf Dauer ist ein Fünfhunderter eben nicht genug zum Leben.“"
                            },
                            {
                                "example_id": "f75537a5-500f-4bb1-842d-f3dfde506c69",
                                "sense_id": "efbd6a14-8375-31a2-bd7f-b9a1f8e96f73",
                                "text": "„Dieser Cinquecento oder Fünfhunderter war als Ausführung D ab 1960 erhältlich und ist der letzte der Baureihe mit den sogenannten “Selbstmördertüren”.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1c39bbb-9a88-348c-a690-0a99ee9e17f1",
                        "entry_id": "071db736-34f4-3a9f-941b-042837e9bfce",
                        "glosses": [
                            "Geldschein oder seltener eine Münze mit dem Wert 500 Währungseinheiten"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "94834530-2f75-4a77-b889-d2a614207d30",
                                "sense_id": "b1c39bbb-9a88-348c-a690-0a99ee9e17f1",
                                "text": "„Der Knilch, der Minuten später mit zwei Fünfhundertern in der Parkgarage aufkreuzte, wurde das Geld nicht los.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
