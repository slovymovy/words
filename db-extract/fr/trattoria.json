                                            {
                                                "example_id": "655b2b0f-1069-4afb-a131-8d59fbb9eab5",
                                                "sense_id": "b45a5130-9960-38f5-ad45-cb15c4586ca7",
                                                "text": "„An einer der Wände der kleinen Trattoria sind die Weinflaschen bis unter die Decke gestapelt.“"
                                            },
                                            {
                                                "example_id": "2ee3344a-ab4f-45b8-86cb-0490238f444c",
                                                "sense_id": "b45a5130-9960-38f5-ad45-cb15c4586ca7",
                                                "text": "„Die herausgeputzte Innenstadt wird von Pizzerien und Trattorien dominiert.“"
                                            },
                                            {
                                                "example_id": "e0d850be-77af-4cc3-a411-02d5bcae9987",
                                                "sense_id": "b45a5130-9960-38f5-ad45-cb15c4586ca7",
                                                "text": "„Als Perlmann nachher, fast zur selben Zeit wie am Vortag, den Glasperlenvorhang teilte und die Trattoria betrat, begann der Regen auf das Glasdach zu trommeln.“"
                                            },
                                            {
                                                "example_id": "b40c4435-1f60-4d8b-8a9a-77efd5816be2",
                                                "sense_id": "b45a5130-9960-38f5-ad45-cb15c4586ca7",
                                                "text": "„Die Trattoria in unserem Kiez hatte Lavazza-Espresso und Tomatensugo gespendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
