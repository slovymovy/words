                            {
                                "target_lang_word": "neerlating",
                                "target_lang_sense_clarification": "het fysiek naar beneden brengen van iets"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06176116-800a-3c1a-9e0e-781ba93d9d3a",
                    "sense_definition": "Describing the sky, clouds, or atmosphere when it appears dark, gloomy, and threatening, often indicating an approaching storm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "menacing_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to return home early because of the <w>lowering</w> sky.",
                            "target_lang_translations": {
                                "ru": "Мы решили вернуться домой пораньше из-за <w>хмурого</w> неба.",
                                "nl": "We besloten vroeg naar huis terug te keren vanwege de <w>dreigende</w> lucht."
                            }
                        },
                        {
                            "text": "The <w>lowering</w> clouds on the horizon promised a heavy thunderstorm.",
                            "target_lang_translations": {
                                "ru": "<w>Нависшие</w> тучи на горизонте предвещали сильную грозу.",
                                "nl": "De <w>dreigende</w> wolken aan de horizon beloofden een zwaar onweer."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "threatening"
                    ],
                    "common_phrases": [
                        "lowering sky",
                        "lowering clouds"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание неба, облаков или атмосферы, когда они выглядят темными, мрачными и угрожающими, часто предвещая шторм.",
                        "nl": "Beschrijft de lucht, wolken of atmosfeer wanneer deze er donker, somber en dreigend uitzien, vaak wijzend op een naderende storm."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмурый",
                                "target_lang_sense_clarification": "о небе или погоде"
                            },
                            {
                                "target_lang_word": "нависший",
                                "target_lang_sense_clarification": "об облаках или тучах"
                            },
                            {
