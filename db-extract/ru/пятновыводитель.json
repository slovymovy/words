                        "cross_references": [
                            {
                                "target_word": "détachant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cc5cb49-56ff-34b2-a712-dc9408aa6de0",
                                        "entry_id": "8bb955e6-6937-34b0-8319-38a402028cc7",
                                        "glosses": [
                                            "Produit qui permet de nettoyer les taches particulièrement difficiles à enlever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc0f0db-cd4b-487d-9bdd-437e0b1f5f65",
                                                "sense_id": "1cc5cb49-56ff-34b2-a712-dc9408aa6de0",
                                                "text": "Cette tâche sur ton maillot ne partira pas comme ça, laisse-le moi ça partira avec le détachant."
                                            },
                                            {
                                                "example_id": "1aedbcd9-e79f-4a52-8442-0359903dc65e",
                                                "sense_id": "1cc5cb49-56ff-34b2-a712-dc9408aa6de0",
                                                "text": "C’est un détachant efficace pour les taches de cire, de sueur, de brûlures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détachant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20bbaa9a-bce4-3783-be15-39ba182cd3f7",
                                        "entry_id": "bcb1d003-1a8a-31b9-ade7-790b3288ed69",
                                        "glosses": [
                                            "Qui enlève les taches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71384210-1c78-41a1-901c-03c8f6d66907",
                                                "sense_id": "20bbaa9a-bce4-3783-be15-39ba182cd3f7",
                                                "text": "Ajoutons que, comme savon, un composé presque isomère, le pétrole solidifié, atteint les qualités détachantes de la benzine elle-même."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détachant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f9c62f8-336e-3074-8945-aec80fbeb3ba",
                                        "entry_id": "b8c14213-45a2-3fc7-9199-6e80117ed5c7",
                                        "glosses": [
                                            "Participe présent de détacher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd927f59-70c3-405c-98aa-86a5c4d8205f",
                                                "sense_id": "0f9c62f8-336e-3074-8945-aec80fbeb3ba",
                                                "text": "L’écriture, à un haut degré d’élaboration littéraire, décape, exacerbe, « cruélise » l’expérience en la détachant de cette vérité–là pour une autre, problématique ou expérimentale (sujette à expérimentation) plutôt qu’établie, interrogative au–delà et peut–être différemment de ce que l’expérience donne à l’état brut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1d41f57-a999-4303-875f-940aa64c5b03",
                        "source_entry_id": "956afbd3-7f47-31d6-9e0d-edce4784960e",
                        "source_sense_id": "e78c6002-cdf7-3b3e-bb10-89310321d721",
