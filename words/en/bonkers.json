    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "792d54de-aad4-3283-b2da-9db7d4abb536",
                    "sense_definition": "Mentally unbalanced or acting in a way that is extremely foolish or irrational.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The idea of driving across the entire country in a single weekend is absolutely <w>bonkers</w>.",
                            "target_lang_translations": {
                                "ru": "Идея проехать через всю страну за одни выходные — это абсолютно <w>чокнутая</w> затея."
                            }
                        },
                        {
                            "text": "The crowd went <w>bonkers</w> when the lead singer finally walked onto the stage.",
                            "target_lang_translations": {
                                "ru": "Толпа просто <w>сошла с ума</w>, когда солист наконец вышел на сцену."
                            }
                        }
                    ],
                    "synonyms": [
                        "crazy",
                        "mad",
                        "insane",
                        "nuts",
                        "crackers"
                    ],
                    "antonyms": [
                        "sane",
                        "sensible",
                        "rational"
                    ],
                    "common_phrases": [
                        "go bonkers",
                        "absolutely bonkers",
                        "completely bonkers",
                        "stark staring bonkers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически неуравновешенный или ведущий себя крайне глупо или иррационально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чокнутый",
