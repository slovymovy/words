                "senses": [
                    {
                        "sense_id": "feb48c00-43af-3994-b743-53dd3298a2c6",
                        "entry_id": "d1bec76e-d928-31cb-87aa-9e97e54bb957",
                        "glosses": [
                            "Bignone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b768b3c3-8b1f-42e2-bd65-ac20a40d104d",
                                "sense_id": "feb48c00-43af-3994-b743-53dd3298a2c6",
                                "text": "Ailleurs un bignonia de l’Inde, aux longs calices d’un jaune soufre, au feuillage léger, est entouré d’un stéphanotis aux fleurs charnues et blanches qui répandent une senteur suave."
                            },
                            {
                                "example_id": "62b046b9-fb2d-43c2-90db-5326716e3197",
                                "sense_id": "feb48c00-43af-3994-b743-53dd3298a2c6",
                                "text": "Des paons faisaient la roue devant la maison couverte de glycines et de bignonias ; dans la volière, j’admirais les cardinaux à la tête rouge et les faisans dorés."
                            }
                        ]
                    }
