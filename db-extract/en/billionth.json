                                                "sense_id": "901de498-fa69-3cfb-8b27-4a4d6fb353f0",
                                                "text": "„Ende 2008 gibt Logitech bekannt, dass die milliardste Computermaus ausgeliefert wurde.“"
                                            },
                                            {
                                                "example_id": "decdbb17-8e90-421d-b16e-11e971d0cbb7",
                                                "sense_id": "901de498-fa69-3cfb-8b27-4a4d6fb353f0",
                                                "text": "„Ein Nanometer ist der milliardste Teil eines Meters, eine Winzigkeit, die sich nur durch Vergleiche veranschaulichen lässt.“"
                                            },
                                            {
                                                "example_id": "5b2e8a38-672b-4c3f-ac6a-50ea9c0685fc",
                                                "sense_id": "901de498-fa69-3cfb-8b27-4a4d6fb353f0",
                                                "text": "„Ein Meilenstein ist erreicht: In diesen Tagen wurde nach Uno-Berechnungen der milliardste Inder geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
