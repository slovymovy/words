                ],
                "senses": [
                    {
                        "sense_id": "9f7b6488-0948-3d61-8d80-718da9f213d2",
                        "entry_id": "79ae2cf5-06cc-3442-b9ed-d16f475b3620",
                        "glosses": [
                            "andere Bezeichnung für Wikinger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b49a35b-601e-44a0-9973-7b5bb81dabf9",
                                "sense_id": "9f7b6488-0948-3d61-8d80-718da9f213d2",
                                "text": "„Gut 80 Jahre nach der ersten Attacke von 793 müssen die Mönche erneut vor herannahenden Nordmännern fliehen.“"
                            },
                            {
                                "example_id": "15c7ffda-fa0b-4db0-8d32-477ba7e2e581",
                                "sense_id": "9f7b6488-0948-3d61-8d80-718da9f213d2",
                                "text": "„Die Nordmänner erkunden mit ihnen die Ströme des heutigen Russland und der Ukraine, befahren das Schwarze Meer und laden in Konstantinopel Schätze an Bord.“"
                            },
                            {
                                "example_id": "f7990a8c-096b-49a2-b3aa-d22ba5798e87",
                                "sense_id": "9f7b6488-0948-3d61-8d80-718da9f213d2",
                                "text": "„Im 11. Jahrhundert trafen die Nordmänner ein und verdrängten die sächsische Oberschicht von der Macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
