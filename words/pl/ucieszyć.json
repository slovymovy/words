{
    "word_family": [
        "cieszyć",
        "uciecha",
        "cieszący",
        "ucieszny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5672a30d-a826-3da8-9d76-7ec48815cc1f",
                    "sense_definition": "sprawić komuś radość, wywołać uśmiech",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "radość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowy rower bardzo <w>ucieszył</w> mojego młodszego brata.",
                            "target_lang_translations": {
                                "ru": "Новый велосипед очень <w>обрадовал</w> моего младшего брата."
                            }
                        },
                        {
                            "text": "Prezent od przyjaciół naprawdę ją <w>ucieszył</w> w dniu urodzin.",
                            "target_lang_translations": {
                                "ru": "Подарок от друзей по-настоящему <w>обрадовал</w> её в день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "pocieszyć",
                        "rozweselić"
                    ],
                    "antonyms": [
                        "zasmucić",
                        "zmartwić"
                    ],
                    "common_phrases": [
                        "ucieszyć kogoś prezentem",
                        "ucieszyć się wiadomością"
                    ],
                    "target_lang_definitions": {
                        "ru": "доставить кому-либо радость, вызвать улыбку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрадовать",
                                "target_lang_sense_clarification": "вызвать у кого-то чувство радости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "956328f7-ac70-39b5-b4a4-4d407851e414",
                    "sense_definition": "odczuć radość z jakiegoś powodu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "radość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci bardzo <w>ucieszyły</w> się z wycieczki do zoo.",
                            "target_lang_translations": {
                                "ru": "Дети очень <w>обрадовались</w> поездке в зоопарк."
                            }
                        },
                        {
                            "text": "Wszyscy <w>ucieszymy</w> się, gdy w końcu wyjdzie słońce.",
                            "target_lang_translations": {
                                "ru": "Мы все <w>обрадуемся</w>, когда наконец выйдет солнце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ucieszyć się z sukcesu"
                    ],
                    "target_lang_definitions": {
                        "ru": "почувствовать радость по какой-либо причине"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрадоваться",
                                "target_lang_sense_clarification": "испытать радость от чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8b07fd5-7ef9-37bd-aafc-454ec146c5a9",
                    "sense_definition": "spędzić czas na przyjemnościach, nacieszyć się czymś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "radość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej pracy wreszcie <w>ucieszył</w> się wolnym popołudniem w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "После долгой работы он наконец <w>насладился</w> свободным днём в саду."
                            }
                        },
                        {
                            "text": "Warto <w>ucieszyć</w> się chwilą spokoju przed powrotem do obowiązków.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>насладиться</w> моментом покоя перед возвращением к обязанностям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ucieszyć się chwilą"
                    ],
                    "target_lang_definitions": {
                        "ru": "провести время с удовольствием, насладиться чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насладиться",
                                "target_lang_sense_clarification": "получить удовольствие от чего-либо"
                            },
                            {
                                "target_lang_word": "порадоваться",
                                "target_lang_sense_clarification": "получить удовлетворение от момента или события"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}