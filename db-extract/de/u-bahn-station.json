                "senses": [
                    {
                        "sense_id": "00923087-4088-3101-b468-ecab459d7d9e",
                        "entry_id": "74b76156-f221-3e3d-9975-c8d7b9854e7e",
                        "glosses": [
                            "Haltestelle einer U-Bahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc484ee7-cfc2-45b6-a360-4e6487126166",
                                "sense_id": "00923087-4088-3101-b468-ecab459d7d9e",
                                "text": "„Am 9. Mai, dem Tag des Siegs, standen wir zu fünft, eine Mädchenclique, vor der U-Bahn-Station und gratulierten den Kriegsveteranen.“"
                            },
                            {
                                "example_id": "929eb0a3-9d8d-4289-9c5f-d2456a1f229d",
                                "sense_id": "00923087-4088-3101-b468-ecab459d7d9e",
                                "text": "„Vor der U-Bahn-Station Wedding entdeckte er das Rotfrontmädchen.“"
                            },
                            {
                                "example_id": "6b3dd593-7c17-47c4-820d-a909db1157b1",
                                "sense_id": "00923087-4088-3101-b468-ecab459d7d9e",
                                "text": "„Die U-Bahn-Station wurde wieder freigegeben, und als ich hinunterkam, wurde noch ein Teil des Bahnsteiges geputzt.“"
                            },
                            {
                                "example_id": "5d35ff66-f4a4-4ccf-bbb3-26ecb1b39f87",
                                "sense_id": "00923087-4088-3101-b468-ecab459d7d9e",
                                "text": "„Wir gingen schnurstracks zur nächsten U-Bahn-Station und fuhren in Richtung Themse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
