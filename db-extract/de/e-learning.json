                "senses": [
                    {
                        "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                        "entry_id": "4b3293d9-11ae-31e8-b5a3-60ab3f2796f3",
                        "glosses": [
                            "Sammelbegriff aller Formen des Lernens, bei denen digitale Medien für die Präsentation und Distribution von Lernmaterialien und/oder zur Unterstützung zwischenmenschlicher Kommunikation zum Einsatz kommen"
                        ],
                        "tags": [
                            "Pädagogik"
                        ],
                        "examples": [
                            {
                                "example_id": "d14581e5-f368-4ee8-b1d0-7a58279401c2",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "Während der Coronakrise sind alle Schulen geshlossen. Jetzt bräuchten wir funktionierendes E-Learning."
                            },
                            {
                                "example_id": "e0860f94-a443-4d83-8978-7ba7dd01051e",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "Beim E-Learning leben deutsche Schulen hinter dem eMond."
                            },
                            {
                                "example_id": "ba0b6078-716d-4c01-8f62-83fd5ef42a21",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„Ob bei der beruflichen Weiterbildung in Unternehmen und in privaten Trainingsinstituten, in Meisterkursen an Handwerks- und Handelskammern, an Fachhochschulen und Universitäten – überall ist E-Learning auf dem Vormarsch, inzwischen meist unter dem Namen ‚Blended Learning‘.“"
                            },
                            {
                                "example_id": "455c4dc0-0141-424b-822d-bf8c07edef13",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„Seit dieser Woche sind wegen Corona auch in Deutschland die Schulen geschlossen. Die Schüler sitzen zuhause vor ihren Computern - und warten. Kaum ein anderes Land in Europa ist so schlecht für E-Learning vorbereitet. […] Wie es stattdessen gehen kann, zeigt Estland, der europäische Spitzenreiter im E-Learning.“"
                            },
                            {
                                "example_id": "44bd33ff-4033-49cc-a713-ecacfcbd18f6",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„Allein an den beiden Bonner Gymnasien nutzen knapp 2.000 Schüler und etwa 160 Lehrer das sogenannte E-Learning.“"
                            },
                            {
                                "example_id": "41236a2b-3a9b-4d4c-a996-0e7464432145",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„Alle Hochschuleinrichtungen des Landes [sind] per Erlass aufgerufen worden, digitale Formen der Zusammenkunft wie E-Learning und Videokonferenzen verstärkt auszubauen.“"
                            },
                            {
                                "example_id": "1ed0f5f6-21c4-4c0a-a517-466b753133f4",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„»Trotzdem war die Notwendigkeit, E-Learning zu entwickeln, in Afrika sehr viel stärker als in Europa«, sagt die Expertin für Kommunikationstechnik.“"
                            },
                            {
                                "example_id": "9a33cc21-ec87-4a6a-b909-b69c0ef6d673",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„[…] E-Learning hat die Weiterbildung revolutioniert.“"
                            },
                            {
                                "example_id": "fc0e9491-cb3e-4510-b4c4-5f385090ba36",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„Sachsen setzt beim Thema E-Learning auf die Plattform LernSax und die Dienste des Sächsischen Bildungsservers, beispielsweise OPAL-Schule. […] eine Schule, die E-Learning bisher gar nicht genutzt [hat, hat] von Freitag auf Montag den Clouddienst für alle Klassen und Fächer aufgebaut.“"
                            },
                            {
                                "example_id": "9c724fdd-6ad8-49dd-97e4-05cafe17a364",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„Die sächsische FDP verlangt ein Sofort-Programm für E-Learning an Schulen und Universitäten des Freistaates.“"
                            },
                            {
                                "example_id": "221d9ce5-b372-425e-8e7c-5f4fad105dd3",
                                "sense_id": "e6af56b3-b5c7-3135-92bb-bc0b3a4aa6ef",
                                "text": "„E-Learning erobert die Unis und macht das Studium bequemer. Für Studenten stellt sich die Frage: Lohnt sich der Weg in den Hörsaal überhaupt noch?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
