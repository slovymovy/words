                                "target_senses": [
                                    {
                                        "sense_id": "52e1090a-6ca8-322f-b5eb-031f3c93c2f0",
                                        "entry_id": "b9a9f1bf-dcee-3420-a886-a02f6d58b594",
                                        "glosses": [
                                            "A son of one's child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7285c6e-50ea-49ae-87cb-be5c84f35965",
                                                "sense_id": "52e1090a-6ca8-322f-b5eb-031f3c93c2f0",
                                                "text": "Three days after his young grandsons died in a fire police said was set by their father, Chuck Cox on Wednesday still was coming to grips with what happened."
                                            },
                                            {
                                                "example_id": "0bab1b1a-dcf2-4164-85ae-898df9c5a4a5",
                                                "sense_id": "52e1090a-6ca8-322f-b5eb-031f3c93c2f0",
                                                "text": "She’s now a great-grandmother with three sons, a grandson and two great-grandchildren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59a446ce-be48-44e9-9e99-98c09f0ae6d4",
                        "source_entry_id": "03752f30-7be2-32a5-993a-ba2a3d53eb00",
                        "source_sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                        "source_sense_description": "männliches Kind des eigenen Sohnes oder der eigenen Tochter",
                        "target_lang_word": "petit-fils",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit-fils",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34393406-9b63-3685-938e-e3ac7734aaf7",
                                        "entry_id": "4b7b0c34-4eec-3d67-8d0d-aba0d8783ae0",
                                        "glosses": [
                                            "Fils du fils ou de la fille d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d4294a-8cf9-434c-9070-58026e19b5d1",
                                                "sense_id": "34393406-9b63-3685-938e-e3ac7734aaf7",
                                                "text": "Il mourut l’année d’après, léguant à son petit-fils John, mineur, sa pairie qui, du reste, devait s’éteindre en 1768."
                                            },
                                            {
                                                "example_id": "40431148-d708-481a-b814-62dbed9a50ae",
                                                "sense_id": "34393406-9b63-3685-938e-e3ac7734aaf7",
                                                "text": "Ce n’étaient pas proprement les neveux de l’empereur, mais ses petits-neveux, petits-fils de sa sœur Domitilla, et fils de Flavia Domitilla et de Flavius Clémens."
                                            },
                                            {
                                                "example_id": "c5313807-ce28-4e6e-ae00-651ef062c1f9",
                                                "sense_id": "34393406-9b63-3685-938e-e3ac7734aaf7",
                                                "text": "Youseff Mahboublanfard, 102 ans, a été trouvé inanimé dans son garage par un de ses petits-fils qui pensait qu’il avait simplement chuté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
