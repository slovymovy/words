                    {
                        "translation_id": "5f273cdd-68ac-428a-84f2-fbec5da40b0e",
                        "source_entry_id": "ddb5cafa-ec92-32d3-a613-db7432290f82",
                        "source_sense_id": "4f7b792d-4170-395a-ad3f-488237174d8d",
                        "target_lang_word": "Hütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hütte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "\\\"kleines und bautechnisch einfaches Gebäude, das häufig von den späteren Nutzern in Eigenarbeit aus lokal verfügbaren, möglicherweise auch vergänglichen oder losen zusammengefügten Materialien errichtet wird\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afcbdff0-d72a-4d6c-a8cf-2aab19c119ed",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "Die Hütte bietet Schutz vor Regen."
                                            },
                                            {
                                                "example_id": "d8b27be4-9c33-4117-b384-b163eaee7753",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„Friede den Hütten, Krieg den Palästen!“"
                                            },
                                            {
                                                "example_id": "48853aaa-5ea2-4591-b14c-5ab053c310b5",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„Gegen drei Uhr am Nachmittag landeten wir am rechten Ufer bei einer Hütte, vor der wir im morastigen Boden viele frische Fußspuren entdeckten.“"
                                            },
                                            {
                                                "example_id": "125aae6c-04f4-43da-af5c-3b43c25df485",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„Csoma lebte zwei Jahre in dieser Hütte, in der er Sanskrit, Marathi und Bengalisch erlernte.“"
                                            },
                                            {
                                                "example_id": "25d827d0-76c7-4372-a191-b4c4d2e0763e",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„In der Hütte war es stickig und heiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1b114a0-6f26-34e2-9f21-431fc4cd14fb",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "Gebäude/Anlage/Werk, in welchem Glas oder Metalle erschmolzen werden"
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14fef2f2-43c4-4f68-89ae-92707b06d532",
                                                "sense_id": "c1b114a0-6f26-34e2-9f21-431fc4cd14fb",
                                                "text": "„Ein Eisenwerk, oft auch als Hüttenwerk, Eisenhütte oder kurz Hütte bezeichnet, ist eine Anlage zur Erzeugung von Eisen oder Stahl aus Eisenerz.“"
                                            },
                                            {
                                                "example_id": "43354748-4c64-4b08-8091-6e3c777897b5",
                                                "sense_id": "c1b114a0-6f26-34e2-9f21-431fc4cd14fb",
                                                "text": "Eine Hütte zur Herstellung von Glas besteht aus Lagern für die Rohstoffe, einem sogenannten Gemengebunker zum Mischen dieser Rohstoffe nach genauen individuellen Rezepten, Ofenanlagen zum Schmelzen des Gemenges, Verarbeitungsstätten, Kühlöfen zum langsamen kontrollierten Abkühlen der Werkstücke und sonstigen Hilfseinrichtungen für die Produktion sowie Lagerstätten für Fertigwaren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13c3cd63-bbcc-3a29-b0e9-28550ce685d8",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "Decksaufbau am Heck eines Schiffes"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b94ef1f-fc4e-4561-b422-c32cdd9d3f1b",
                                                "sense_id": "13c3cd63-bbcc-3a29-b0e9-28550ce685d8",
                                                "text": "In der Regel haben Turmdeckschiffe eine Hütte und eine Back, bisweilen auch ein Brückenhaus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "44ff937b-7349-3700-a1a6-4d59eb3d2cd5",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "hotelähnliches Gebäude in den Bergen, welches Gästen Obdach und Kulinarisches aus der Region anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed2cfe1-af1d-4047-8727-eb1153fbbf67",
                                                "sense_id": "44ff937b-7349-3700-a1a6-4d59eb3d2cd5",
                                                "text": "Ich habe auf der Hütte einen Germknödel bestellt."
                                            },
                                            {
                                                "example_id": "293755f9-3baf-4f30-bc40-70135e5ea80c",
                                                "sense_id": "44ff937b-7349-3700-a1a6-4d59eb3d2cd5",
                                                "text": "„Im Kamin der Hütte brannte ein großen Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0e036e74-3ff9-3baa-abf5-7105e91e8582",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "Beherbergungseinrichtung (Schutzhütte) für Wanderer, zum Beispiel in den Bergen oder auch auf einer Sandbank"
                                        ],
                                        "tags": [],
                                        "examples": [
