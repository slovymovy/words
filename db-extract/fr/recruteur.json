                                        "glosses": [
                                            "Agent noun of recruit; one who recruits, particularly one employed to recruit others."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac2e439b-4363-4aea-a1d1-e2d9e661cc75",
                                                "sense_id": "ab45c265-06d7-3bc7-8ac8-20292c34edcb",
                                                "text": "The army recruiter promised that I'd see the world and learn useful skills if I enlisted."
                                            },
                                            {
                                                "example_id": "93bb1699-ae2f-4659-ab96-21cf3ec6b91d",
                                                "sense_id": "ab45c265-06d7-3bc7-8ac8-20292c34edcb",
                                                "text": "BBV expects to be one of the biggest recruiters in the region over the next two years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f52a217-e846-4e8f-924d-d55a1e96c9d6",
