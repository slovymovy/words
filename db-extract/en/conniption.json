                    {
                        "translation_id": "ad1b9cdd-d570-4926-89f1-c085049222b2",
                        "source_entry_id": "64bd85af-00c8-33e1-91cb-4d55311982e9",
                        "source_sense_description": "fit of anger or panic",
                        "target_lang_word": "Anfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "246aa27d-b5bf-3021-a291-65a8694dccec",
                                        "entry_id": "726483a6-eee0-3600-b04a-02e2ab388378",
                                        "glosses": [
                                            "plötzliches, heftiges Auftreten einer Krankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac82d52-b60e-4bf3-8176-737b6c35bdf1",
                                                "sense_id": "246aa27d-b5bf-3021-a291-65a8694dccec",
                                                "text": "Der Patient hatte durch die starke Medikamentendosis einen starken Anfall."
                                            },
                                            {
                                                "example_id": "73b199ad-d645-4845-92ae-8a2c263c224d",
                                                "sense_id": "246aa27d-b5bf-3021-a291-65a8694dccec",
                                                "text": "„Grenfeld dachte noch, wie perfekt sie den Anfall spielte, doch als sie bei der schwarzen Tasche angelangt war, krümmte sie sich laut röchelnd und rang nach Atem.“"
                                            },
                                            {
                                                "example_id": "32549662-46c2-4a44-ae32-1e5be9a50271",
                                                "sense_id": "246aa27d-b5bf-3021-a291-65a8694dccec",
                                                "text": "„Nachts litt er unter Anfällen von Atemnot und schnappte nach Luft wie ein Ertrinkender.“"
                                            },
                                            {
                                                "example_id": "122314e3-1f4d-40a5-84f7-7417ba360851",
                                                "sense_id": "246aa27d-b5bf-3021-a291-65a8694dccec",
                                                "text": "„Er hielt seinen einen Arm mit dem andern fest, war blass, und sein Unterkiefer zitterte in einem Anfall von Schüttelfrost.“"
                                            },
                                            {
                                                "example_id": "5e07b49e-0807-4f4e-8709-06389a05c22b",
                                                "sense_id": "246aa27d-b5bf-3021-a291-65a8694dccec",
                                                "text": "„In einem krampfhaften Anfall machte er ruckartige Bewegungen mit den Armen und stampfte mit den Füßen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8581450f-58a3-3fbe-837e-9d6f52d2c823",
                                        "entry_id": "726483a6-eee0-3600-b04a-02e2ab388378",
                                        "glosses": [
                                            "plötzliches, heftiges Auftreten eines Gefühls oder einer Gefühlsäußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d64a70d9-c061-4688-8996-f6c57cc2c895",
                                                "sense_id": "8581450f-58a3-3fbe-837e-9d6f52d2c823",
                                                "text": "„In einem Anfall von Raserei eilt er zur Arbeit und unterzeichnet die Weihnachtskarte für seinen Chef mit drei triumphierenden !!! nach seinem Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
