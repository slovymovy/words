                                    {
                                        "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                        "entry_id": "21c743a9-69d3-36c5-aa17-851816248502",
                                        "glosses": [
                                            "A doctor or scientist who specializes in oncology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d67515-23a2-4e2f-a314-93f8bfcd2479",
                                                "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                                "text": "There's been a lot of screening, and people still die,\" says Ian Thompson, a urologic oncologist at the University of Texas Health Science Center, San Antonio."
                                            },
                                            {
                                                "example_id": "271723b9-cbf4-475f-86ab-5a748ae68912",
                                                "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                                "text": "When considered in combination with the use of antiangiogenic therapy, this diagnostic tool is easy to apply and has broad utility among medical oncologists to avoid the risk of hemosputum in the great vessels [ 5 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c7b2b80-a322-4f40-b797-834ea88ea4a3",
                        "source_entry_id": "81a08e72-ef78-39af-8b0c-a5cbc6346b48",
                        "source_sense_id": "c3ae5865-177f-3449-b92b-dc9a0d78a654",
