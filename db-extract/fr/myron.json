                        "glosses": [
                            "Parfum, myrrhe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098c8f93-395d-444a-8061-da2cbb1631d4",
                                "sense_id": "d061aa80-d4d6-38a3-b537-2752b4e5c573",
                                "text": "Nous voyons des yeux du corps, dit-il, dans l’Eucharistie du pain & du vin, & par les yeux de la foi, nous concevons le corps & le sang de Jesus-Christ : de même dans le myron nous ne voyons que de l’huile, mais par la foi nous y appercevons l’esprit de Dieu."
                            },
                            {
                                "example_id": "c0d009ed-9376-4a6c-8f4c-8dd552c8f259",
                                "sense_id": "d061aa80-d4d6-38a3-b537-2752b4e5c573",
                                "text": "Au pied, était aménagée une petite ouverture, soi-disant pour l'écoulement de l'eau, en réalité pour la sortie du myron, qui coulait également de la lampe et de l'icône de la sainte, une myroblyte, tout comme saint Dèmètrios."
                            }
                        ]
                    }
