                "senses": [
                    {
                        "sense_id": "3a0f83bc-fa47-335c-9b44-790ee2f66361",
                        "entry_id": "2f0992bd-77b1-34b9-8478-52b78ee9b0d0",
                        "glosses": [
                            "eine Person/Gruppe mit ihrem Auftritt oder ein Ereignis, das so populär ist, dass eine Sportarena (das Stadion) sehr gut besucht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca102f7c-aa4c-46ad-91f8-9d12233124f2",
                                "sense_id": "3a0f83bc-fa47-335c-9b44-790ee2f66361",
                                "text": "„Kombiniert mit ‚echten‘ Bässen, Gitarren und Drums wurden die synthielastigen Simple Minds zum erfolgreichen Stadionfüller.“"
                            },
                            {
                                "example_id": "1c8e0780-4e45-40c0-bab5-4bec49b02ff1",
                                "sense_id": "3a0f83bc-fa47-335c-9b44-790ee2f66361",
                                "text": "„Sie waren richtige ‚Stadionfüller‘. Aber darum geht es mir weniger, es geht mir darum, dass ich deren bombastischen Sound mal sehr gemocht habe.“"
                            },
                            {
                                "example_id": "fcb7f79a-9a97-4bab-ba63-344634688c46",
                                "sense_id": "3a0f83bc-fa47-335c-9b44-790ee2f66361",
                                "text": "„Bis zum Stadionfüller hat er es also gebracht mit seiner deutschen Art, die er – und das dürfte eines seiner Erfolgsgeheimnisse sein – nie als ‚Piefke-Typ‘ über die Bühne oder das Studiomikrophon brachte.“"
                            },
                            {
                                "example_id": "7cfeb9f3-269e-4e66-912e-308d160ceb06",
                                "sense_id": "3a0f83bc-fa47-335c-9b44-790ee2f66361",
                                "text": "„Nur in England ist Frauenfußball ein Stadionfüller.“"
                            },
                            {
                                "example_id": "1224bc49-f31c-4cf6-a4a9-f457d916386e",
                                "sense_id": "3a0f83bc-fa47-335c-9b44-790ee2f66361",
                                "text": "„Hören Sie Michael Jacksons musikalischen Weg vom Kindheitsstar zum Stadionfüller und entdecken Sie die Geschichten hinter seinen Hits.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
