                            }
                        ]
                    }
                },
                {
                    "sense_id": "66a98e74-1e1f-38db-b2e3-4949a5cf0c18",
                    "sense_definition": "A surname of English origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Settle</w> will see you now regarding your appointment.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Сетл</w> примет вас сейчас по поводу вашей встречи.",
                                "zh": "关于你的预约，<w>塞特尔</w>先生现在会见你。"
                            }
                        },
                        {
                            "text": "The <w>Settle</w> family has lived in this area for generations.",
                            "target_lang_translations": {
