                        "examples": [
                            {
                                "example_id": "f777c3e1-e001-4a2d-8dc2-74bbd548573f",
                                "sense_id": "56d4fc52-6cc2-3c3c-998b-4b9eabc18ec5",
                                "text": "‘De haven boekt met 3,7 miljoen ton inzake conventioneel stukgoed voor het tweede jaar op rij een record. Staalplaten, plaatstaal en plaatijzer zijn hierbij de belangrijkste goederen."
                            },
                            {
                                "example_id": "5d84aac9-1306-4b46-9df0-9232df355688",
                                "sense_id": "56d4fc52-6cc2-3c3c-998b-4b9eabc18ec5",
                                "text": "Vijf dagen lang verliep de reis voorspoedig, maar op het moment dat de groep in een klein gebouwtje in een nauw dal op ongeveer 1900 meter hoogte aan het lunchen was, begon de aardbeving: 'Het gebouw had een dak van plaatstaal, het gaf een enorm lawaai, het trilde alsof er een locomotief doorheen denderde.'"
                            }
                        ]
                    }
