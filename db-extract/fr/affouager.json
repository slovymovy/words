                        "entry_id": "519631f3-5d74-3982-be90-4fa2a64b60a7",
                        "glosses": [
                            "Besogne d'appoint pratiquée en automne et en hiver dans les forêts."
                        ],
                        "tags": [
                            "Infinitif substantivé"
                        ],
                        "examples": [
                            {
                                "example_id": "d24e7012-76c1-4086-a596-71f39215ec92",
                                "sense_id": "0a86099b-835c-37de-81a1-3e38e896f07c",
                                "text": "Le droit d'affouager était accordé à l'année, par habitant ou par maison, sous réserve que les demandeurs fussent domiciliés dans la commune depuis un an au moins."
                            }
                        ]
                    }
