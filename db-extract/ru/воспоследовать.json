                        "examples": [
                            {
                                "example_id": "83f2bea0-80de-4024-ab13-c7721ea9a52b",
                                "sense_id": "bf5eafb0-3304-3585-abcb-9815cbf63874",
                                "text": "— Ну, и что же да́лее? — вопроси́ли Ива́на Северья́ныча.\n— Да́лее действи́тельно всё так воспосле́довало, как он обеща́лся.",
                                "translation": "“Well, and what then?” we asked Ivan Severyanych.\n“Then everything actually followed as he promised.”",
                                "english": "“Well, and what then?” we asked Ivan Severyanych.\n“Then everything actually followed as he promised.”"
                            }
                        ]
                    }
