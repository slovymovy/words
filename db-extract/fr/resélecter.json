                "senses": [
                    {
                        "sense_id": "b8354ea2-bca9-3c9c-a574-cf93478dcf92",
                        "entry_id": "5390518a-d8bb-357f-928d-12a8809634a1",
                        "glosses": [
                            "Sélecter de nouveau."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b7522901-abe6-4aba-9cd8-e12bf3fd6d2e",
                                "sense_id": "b8354ea2-bca9-3c9c-a574-cf93478dcf92",
                                "text": "Lors de la réinstallation, il te faudra resélecter la même option de partage, si tu ne veux pas te compliquer la vie."
                            },
                            {
                                "example_id": "4e65eff6-35ad-4405-9b67-cb92a5cc99b3",
                                "sense_id": "b8354ea2-bca9-3c9c-a574-cf93478dcf92",
                                "text": "Bon, mais comme néophyte, je veux bien resélecter mon attachment, mais dans quelle browser box?"
                            },
                            {
                                "example_id": "c76ce999-ee48-43c8-9da8-d856fadb75ae",
                                "sense_id": "b8354ea2-bca9-3c9c-a574-cf93478dcf92",
                                "text": "Prenez ensuite le calque dupliquer et faites select/reselect (sélection/resélecter) pour reprendre la sélection de la sphère et appliquer le filtre sphérique (filtres/déformation/sphérisation (Filter>Distort>Spherize)) à 100% et faites le une nouvelle fois, pour que cela donne :"
                            }
                        ]
                    }
