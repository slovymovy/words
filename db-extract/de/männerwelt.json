                            {
                                "example_id": "02415063-79df-48bf-9f11-f3745e922edb",
                                "sense_id": "11d3ceef-2f53-36b1-87be-92298f1744db",
                                "text": "„Noch vor wenigen Wochen hatte sie mir erklärt, dass sie der Männerwelt abgeschworen habe.“"
                            },
                            {
                                "example_id": "ee4f3b93-ec95-4b6f-a510-2119b20c7d3e",
                                "sense_id": "11d3ceef-2f53-36b1-87be-92298f1744db",
                                "text": "„Minni schüttete ihr Füllhorn an Liebreiz großzügig über die Männerwelt des Moka Efti aus.“"
                            }
                        ],
