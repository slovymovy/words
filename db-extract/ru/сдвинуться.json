                            {
                                "example_id": "d35078cf-abf4-41f6-a9d9-249946344aea",
                                "sense_id": "13e82e49-d287-3eaf-b6b9-205b20f3716e",
                                "text": "он не сдви́нулся с ме́ста",
                                "translation": "he never budged",
                                "english": "he never budged"
                            }
                        ]
                    },
                    {
