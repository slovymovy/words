                "senses": [
                    {
                        "sense_id": "9488fd51-82b8-341e-970b-5631450ed6f5",
                        "entry_id": "1eb222f9-90d0-3737-a2a8-4bc6a5533cc5",
                        "glosses": [
                            "Fleuve côtier de la province de Çanakkale, en Turquie, il prend sa source sur les flancs du Mont Ida et débouche dans la mer de Marmara."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "68a41fd6-9224-4354-a4f8-7d33d0502528",
                                "sense_id": "9488fd51-82b8-341e-970b-5631450ed6f5",
                                "text": "GRANIQUE, (le) Géog. anc.) Granicus, riviere de la Troade en Asie. Elle a sa source au mont Ida, coule en serpentant tantôt vers le S. E. tantôt vers le N. O. & enfin se tourne vers le N. N. O. avant que de tomber dans le Propontide."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fcd12cd-eeac-345d-afdd-537af1b79842",
                        "entry_id": "1eb222f9-90d0-3737-a2a8-4bc6a5533cc5",
                        "glosses": [
                            "Dieu-fleuve de ce cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d51e7f76-e594-4e30-86b2-bab32a2b1686",
                                "sense_id": "9fcd12cd-eeac-345d-afdd-537af1b79842",
                                "text": "Téthys donna à l’Océan des Fleuves au cours sinueux, le Nil, l’Alphée, l’Éridan aux gouffres profonds, le Strymon, le Méandre, l’Ister aux belles eaux, le Phase, le Rhésus, l’Achéloüs aux flots argentés, le Nessus, le Rhodius, l’Haliacmon, l’Heptapore, le Granique, l’Ésépus, le divin Simoïs, le Pénée, l’Hermus, le Caïque aux ondes gracieuses, le large Sangarius, le Ladon, le Parthénius, l’Événus, l’Ardesque et le divin Scamandre."
                            }
                        ]
                    }
                ],
