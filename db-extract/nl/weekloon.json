                        "examples": [
                            {
                                "example_id": "9cc5000d-72de-4d45-9ad2-a21b822d81c5",
                                "sense_id": "a4085f79-8466-3005-947a-f6e02f701767",
                                "text": "Volgens een inwoner die eerder sprak met Telegraafverslaggever Zander Lamme, had ’de mem van Doutzen ook een lot’. Als dat klopt, kan ook zij op een mooi bedrag rekenen... al is dat voor haar beroemde modellendochter slechts een weekloontje."
                            },
                            {
                                "example_id": "8fd31912-8e29-4737-ad3d-8118eddac7c3",
                                "sense_id": "a4085f79-8466-3005-947a-f6e02f701767",
                                "text": "Het banenrapport van afgelopen vrijdag vertoonde echter een sterke toename van 242.000 banen wat ruim 50.000 boven de verwachtingen lag. De looncomponent liet echter een tegenvallend beeld zien waarbij de gemiddelde weeklonen met -0,1% waren gedaald tegen 0,5% in de maand ervoor."
                            }
                        ]
