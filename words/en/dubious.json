    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a8c05f5-d6db-3d02-bebf-6d4ba0381f80",
                    "sense_definition": "Feeling or showing doubt; hesitant or uncertain about something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked <w>dubious</w> about the plan at first, but I eventually managed to persuade her.",
                            "target_lang_translations": {
                                "ru": "Сначала она выглядела <w>сомневающейся</w> по поводу этого плана, но в конце концов мне удалось её убедить."
                            }
                        },
                        {
                            "text": "The manager remained <w>dubious</w> about the success of the project despite the positive initial results.",
                            "target_lang_translations": {
                                "ru": "Менеджер по-прежнему <w>скептически</w> относился к успеху проекта, несмотря на положительные начальные результаты."
                            }
                        }
                    ],
                    "antonyms": [
                        "certain",
                        "confident",
                        "sure"
                    ],
                    "common_phrases": [
                        "dubious about",
                        "remain dubious",
                        "look dubious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или выражающий сомнение; нерешительный или неуверенный в чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомневающийся",
                                "target_lang_sense_clarification": "выражающий неуверенность"
                            },
                            {
                                "target_lang_word": "скептический",
                                "target_lang_sense_clarification": "относящийся с недоверием"
                            },
                            {
                                "target_lang_word": "колеблющийся",
                                "target_lang_sense_clarification": "не проявляющий решительности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                    "sense_definition": "Arousing suspicion or doubt; not to be relied upon; questionable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "suspicion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness provided a <w>dubious</w> claim that did not match the evidence found at the scene.",
                            "target_lang_translations": {
                                "ru": "Свидетель сделал <w>сомнительное</w> заявление, которое не соответствовало уликам, найденным на месте происшествия."
                            }
                        },
                        {
                            "text": "He has a <w>dubious</w> reputation in the business world due to his past financial dealings.",
                            "target_lang_translations": {
                                "ru": "У него <w>сомнительная</w> репутация в деловом мире из-за его прошлых финансовых махинаций."
                            }
                        }
                    ],
                    "synonyms": [
                        "mul:?!"
                    ],
                    "antonyms": [
                        "trustworthy",
                        "reliable",
                        "authentic"
                    ],
                    "common_phrases": [
                        "dubious claim",
                        "dubious reputation",
                        "dubious honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий подозрение или сомнение; ненадежный; сомнительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "вызывающий подозрения или недоверие"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "внушающий опасения"
                            },
                            {
                                "target_lang_word": "неоднозначный",
                                "target_lang_sense_clarification": "имеющий спорную репутацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a2f6615-f841-3351-99a9-6863ee8e2aec",
                    "sense_definition": "In chess, describing a move that is considered imprecise or risky but not a definitive blunder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chess evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster played a <w>dubious</w> move in the opening that led to a very complicated position.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер сделал <w>сомнительный</w> ход в дебюте, что привело к очень сложной позиции."
                            }
                        },
                        {
                            "text": "Analysts marked the knight sacrifice as a <w>dubious</w> move because it was difficult to justify.",
                            "target_lang_translations": {
                                "ru": "Аналитики отметили жертву коня как <w>сомнительный</w> ход, так как его было трудно оправдать."
                            }
                        }
                    ],
                    "synonyms": [
                        "mul:?!"
                    ],
                    "common_phrases": [
                        "dubious move"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in chess notation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В шахматах: описывает ход, который считается неточным или рискованным, но не является явной ошибкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "о шахматном ходе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
