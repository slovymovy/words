                                                "sense_id": "39007fb0-ba52-31e5-8c27-77016b555562",
                                                "text": "Lever, baisser la pale du moulin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d64e36-4585-3cd5-a18f-2cd65b60897b",
                                        "entry_id": "a884c06f-f72c-3280-9245-1840362461b1",
                                        "glosses": [
                                            "Partie d’une rame, d’un aviron, qui est plate et qui entre dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9b3bbef-28e3-347a-bff2-d9965c34d6dd",
                                        "entry_id": "a884c06f-f72c-3280-9245-1840362461b1",
                                        "glosses": [
                                            "Ailes vrillées qui forment une hélice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be395a55-dc36-40df-b415-dac0f5228518",
                                                "sense_id": "b9b3bbef-28e3-347a-bff2-d9965c34d6dd",
                                                "text": "L’aéronef est, en outre, incapable de transporter les plus grandes éoliennes en cours de développement dans le monde, à l’instar des pales de 140 mètres développées par l’entreprise chinoise Mingyang Smart Energy."
                                            },
                                            {
                                                "example_id": "d1112b57-1838-4268-a7e9-ef992a4377d5",
                                                "sense_id": "b9b3bbef-28e3-347a-bff2-d9965c34d6dd",
                                                "text": "Le rotor GWH252-16MW de Goldwind a un diamètre de 252 mètres, soit environ 2,5 terrains de football, et chaque pale peut atteindre plus des deux tiers de la vitesse du son."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e83c37a-005f-3d6f-a91c-ed328400b8a8",
                                        "entry_id": "1c8c536f-d394-3b32-b87a-f3ba654a8e55",
                                        "glosses": [
                                            "Morceau de toile blanche, renforcée par un morceau de carton, que le prêtre pose sur le calice pendant la messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25c6e0d-cf0c-415b-a7ca-57a3ca18b70f",
                                                "sense_id": "0e83c37a-005f-3d6f-a91c-ed328400b8a8",
                                                "text": "[L’abbé Mouret] préparait le calice sur une petite table […]. Il posa en travers de sa coupe un purificatoire propre, mit par-dessus ce linge la patène d’argent doré, contenant une hostie, qu’il recouvrit d’une petite pale de lin."
                                            }
                                        ]
                                    }
                                ]
