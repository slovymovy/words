                            {
                                "example_id": "1e50ff85-1fc2-4e35-9aa0-9a7ef2898786",
                                "sense_id": "1f9e0a67-1c50-3aac-bf30-a0a2f4fda5da",
                                "text": "When the ship was in position with the forestem to the south, a grave chamber was constructed just behind the mast."
                            },
                            {
                                "example_id": "c2575c0f-6a5f-4db2-818d-79daaa733156",
                                "sense_id": "1f9e0a67-1c50-3aac-bf30-a0a2f4fda5da",
                                "text": "Above the waterline they were more symmetrical with a transom-shaped bow above the fore-stem."
                            },
                            {
                                "example_id": "b9c67277-4359-45f1-9cbc-1d927ffb9b85",
                                "sense_id": "1f9e0a67-1c50-3aac-bf30-a0a2f4fda5da",
                                "text": "Magnus walked to one of the ships and put his hand on the forestem at the front."
                            }
                        ]
                    }
