                        "sense_id": "c426099a-2b88-3d47-9197-2813710a0bdb",
                        "entry_id": "8cb8bd8f-27aa-3119-ad62-17cc5b9e8034",
                        "glosses": [
                            "A variety of apple, the Mutsu."
                        ],
                        "tags": [],
                        "examples": []
                    }
