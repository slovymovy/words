                ],
                "senses": [
                    {
                        "sense_id": "cd8af179-33b0-364e-a752-f1f4d93c76bd",
                        "entry_id": "4f26aae5-d584-3abc-8291-5ed9ebaacffa",
                        "glosses": [
                            "Entscheidung über die Angemessenheit von etwas"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "afa24369-795e-44bf-963d-ade0f7452ad2",
                                "sense_id": "cd8af179-33b0-364e-a752-f1f4d93c76bd",
                                "text": "„In diesem Zusammenhang kann eine Angemessenheitsentscheidung über den Grad der vertretbaren Kosten gezogen werden.“"
                            },
                            {
                                "example_id": "e488e628-584b-4fc8-ab9a-4bcaec0f2c74",
                                "sense_id": "cd8af179-33b0-364e-a752-f1f4d93c76bd",
                                "text": "„Die sich aus der Natur der Sache ergebendes Subjektivität der Angemessenheitsentscheidung ist jedoch zu unterscheiden von ihrer Rationalität: Wiewohl sich keine „objektive“ Angemessenheitsentscheidung einfordern lässt, kann und muss deren Rationalität verlangt werden.“"
                            },
                            {
                                "example_id": "a85a8f42-e158-4a99-9103-2cc0aa19caa0",
                                "sense_id": "cd8af179-33b0-364e-a752-f1f4d93c76bd",
                                "text": "„Primärer Maßstab dieser Angemessenheitsentscheidung ist dabei die individualvertraglich vereinbarte, funktionale Risiko- und Leistungsverteilung, wie sie im Zusammenspiel zwischen AVB und den Bestimmungen des VVG ihren Niederschlag gefunden hat.“"
                            },
                            {
                                "example_id": "9efabcde-60d7-473e-a83f-455734ef9916",
                                "sense_id": "cd8af179-33b0-364e-a752-f1f4d93c76bd",
                                "text": "„Um in einem verfassungskonformen Rahmen zu bleiben, sollten die Befungnisse daher grundsätzlich eng ausgellegt werden und an die Angemessenheitsentscheidung im Einzelfall sollten hohe Hürden gelegt werden.“"
                            },
                            {
                                "example_id": "30d070aa-838b-4072-a42c-d562406aa171",
                                "sense_id": "cd8af179-33b0-364e-a752-f1f4d93c76bd",
                                "text": "„Erst sachfremde, das heiße programmliche oder medienpolitische Erwägungen oder eine Unverhältnismäßigkeit des Ergebnisses rechtertigen eine nachträgliche Korrektur der Angemessenheitsentscheidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c28b0b0b-13f6-337d-9de6-95278c360003",
                        "entry_id": "4f26aae5-d584-3abc-8291-5ed9ebaacffa",
                        "glosses": [
                            "von der Europäischen Kommission gemäß der Datenschutz-Grundverordnung (DSGVO) getroffene Entscheidung darüber, ob ein Drittland oder eine internationale Organisation ein angemessenes Schutzniveau für personenbezogene Daten bietet"
                        ],
                        "tags": [
                            "Datenschutzrecht",
                            "Europarecht"
                        ],
                        "examples": [
                            {
                                "example_id": "30937b6a-8159-42e1-92b7-c35259487a3b",
                                "sense_id": "c28b0b0b-13f6-337d-9de6-95278c360003",
                                "text": "„Die Kommission hat bislang sieben Angemessenheitsentscheidungen getroffen, in denen bestätigt wird, dass die Schweiz, Kanada, Argentinien, Guernsey, die Isle of Man, die Grundsätze des „sicheren Hafens“ des Handelsministeriums der Vereinigten Staaten sowie die Übermittlung von Fluggastdatensätzen an das United States Bureau of Customs and Border Protection (Zoll- und Grenzschutzbehörde der Vereinigten Staaten) einen angemessenen Schutz bieten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
