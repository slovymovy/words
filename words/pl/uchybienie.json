    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "838ad4a4-2fca-3ffa-964f-125da7b72561",
                    "sense_definition": "Brak lub niedoskonałość w czymś, niedociągnięcie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niedoskonałość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W raporcie wykryto poważne <w>uchybienie</w> dotyczące obliczeń finansowych.",
                            "target_lang_translations": {
                                "ru": "В отчете было обнаружено серьезное <w>нарушение</w> в финансовых расчетах."
                            }
                        },
                        {
                            "text": "Każde <w>uchybienie</w> w procedurach bezpieczeństwa musi zostać natychmiast zgłoszone.",
                            "target_lang_translations": {
                                "ru": "О каждом <w>недочете</w> в процедурах безопасности необходимо немедленно сообщать."
                            }
                        }
                    ],
                    "synonyms": [
                        "niedociągnięcie",
                        "wada",
                        "usterka"
                    ],
                    "common_phrases": [
                        "poważne uchybienie",
                        "uchybienie w procedurach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие или несовершенство в чем-либо, недочет, ошибка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недочет",
                                "target_lang_sense_clarification": "недостаток или упущение в работе"
                            },
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "неточность или погрешность"
                            },
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "отступление от установленных правил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb8e438-0e2f-3393-9e1e-850e78bc95ba",
                    "sense_definition": "Niewłaściwe zachowanie naruszające zasady dobrego wychowania lub konwenanse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego niestosowny komentarz podczas kolacji był dużym <w>uchybieniem</w> wobec gospodarzy.",
                            "target_lang_translations": {
                                "ru": "Его неуместный комментарий во время ужина был большой <w>бестактностью</w> по отношению к хозяевам."
                            }
                        },
                        {
                            "text": "Popełnił towarzyskie <w>uchybienie</w>, nie witając się z najważniejszym gościem.",
                            "target_lang_translations": {
                                "ru": "Он допустил светский <w>промах</w>, не поздоровавшись с самым важным гостем."
                            }
                        }
                    ],
                    "synonyms": [
                        "nietakt",
                        "gafa"
                    ],
                    "common_phrases": [
                        "towarzyskie uchybienie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неподобающее поведение, нарушающее правила этикета или приличия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бестактность",
                                "target_lang_sense_clarification": "неуместное поведение, отсутствие такта"
                            },
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "неловкая ошибка в поведении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e94ac424-2cd5-37d6-8bbc-bc26c99c1358",
                    "sense_definition": "Niewypełnienie nałożonego obowiązku lub zobowiązania.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obowiązki",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pracownik został ukarany za rażące <w>uchybienie</w> swoim obowiązkom służbowym.",
                            "target_lang_translations": {
                                "ru": "Сотрудник был наказан за грубое <w>неисполнение</w> своих служебных обязанностей."
                            }
                        },
                        {
                            "text": "Stwierdzono <w>uchybienie</w> w terminowym dostarczeniu wymaganej dokumentacji.",
                            "target_lang_translations": {
                                "ru": "Было выявлено <w>нарушение</w> сроков предоставления необходимой документации."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaniedbanie"
                    ],
                    "common_phrases": [
                        "uchybienie obowiązkom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невыполнение возложенных обязанностей или обязательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неисполнение",
                                "target_lang_sense_clarification": "невыполнение служебных обязанностей"
                            },
                            {
                                "target_lang_word": "халатность",
                                "target_lang_sense_clarification": "небрежное отношение к своим обязанностям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c2668c6-e876-3337-a8d2-4440fb428938",
                    "sense_definition": "Rzeczownik odczasownikowy od <w>uchybić</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Samo <w>uchybienie</w> godności drugiej osoby jest niedopuszczalne w każdej sytuacji.",
                            "target_lang_translations": {
                                "ru": "Само <w>ущемление</w> достоинства другого человека недопустимо в любой ситуации."
                            }
                        },
                        {
                            "text": "Częste <w>uchybienie</w> zasadom etyki prowadzi do utraty zaufania społecznego.",
                            "target_lang_translations": {
                                "ru": "Частое <w>нарушение</w> этических принципов ведет к потере общественного доверия."
                            }
                        }
                    ],
                    "traits": [
                        {
