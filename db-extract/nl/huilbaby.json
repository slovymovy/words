                    {
                        "sense_id": "eea552ca-dc33-33b9-b94b-23b5e8ae5023",
                        "entry_id": "ec5874c4-2e89-38c2-a99f-25feb7a09c96",
                        "glosses": [
                            "een niet zieke, zich goed ontwikkelende baby die zoveel huilt dat dat door duur, frequentie en/of intensiteit vragen oproept bij ouders en professionals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d24daac9-76e7-4e8c-a140-9e40c3d1048b",
                                "sense_id": "eea552ca-dc33-33b9-b94b-23b5e8ae5023",
                                "text": "Nederlandse baby’s huilen tegen hun zesde week gemiddeld tweeëneenhalf uur per dag. Wereldwijd is dat gemiddelde een kwartier minder. In Denemarken, Duitsland en Japan huilen baby’s het minst. Wanneer een baby drie weken lang meer dan drie uur per dag huilt, spreekt de wetenschap van „een huilbaby”."
                            },
                            {
                                "example_id": "2f399e8f-6f93-4bca-a16f-1cb1d128a5f0",
                                "sense_id": "eea552ca-dc33-33b9-b94b-23b5e8ae5023",
                                "text": "De reguliere medische wetenschap had hem uiteindelijk te zeer beperkt, en het centrum voor huilbaby's kon inmiddels ook zonder hem wel vooruit. Hij was zich de afgelopen jaren gaan verdiepen in alternatieve therapieën voor kinderen die kampten met psychische problemen en trauma's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c1dcd91-0233-44e8-a4a6-7f4de93eb6e5",
                        "source_entry_id": "ec5874c4-2e89-38c2-a99f-25feb7a09c96",
                        "source_sense_id": "eea552ca-dc33-33b9-b94b-23b5e8ae5023",
                        "source_sense_description": "(medisch) een niet zieke, zich goed ontwikkelende baby die zoveel huilt dat dat door duur...",
                        "target_lang_word": "crybaby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crybaby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc875d0-7a52-394d-883f-6f2633b93e69",
                                        "entry_id": "ab37582c-70a0-3c5e-9665-f59c11715e64",
                                        "glosses": [
                                            "A baby who cries excessively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0215ccf8-463f-4ba7-a1ae-fe0dc7ee7ce7",
                                                "sense_id": "9cc875d0-7a52-394d-883f-6f2633b93e69",
                                                "text": "A notorious human crybaby, according to her older siblings, parents and the building superintendent, will cry for two hours every two hours, refusing to acknowledge any distinction between crying and other basic infant activities, like “being awake” or “breathing.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b56267d-f7be-341d-965d-6876716eba0b",
                                        "entry_id": "ab37582c-70a0-3c5e-9665-f59c11715e64",
                                        "glosses": [
                                            "Someone whose feelings are very easily hurt, often by trivial matters."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "308ebdc1-bd1c-47c3-8f30-a0c78ee457e8",
                                                "sense_id": "3b56267d-f7be-341d-965d-6876716eba0b",
                                                "text": "Then he used the occasion to humiliate the provost, calling her an example of the censorious crybabies whom he had come to relieve of their responsibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578ff0a9-a280-3c57-9219-aa5b3d39a010",
                                        "entry_id": "ab37582c-70a0-3c5e-9665-f59c11715e64",
                                        "glosses": [
                                            "Someone who takes offense or excessively complains when things are not going well."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b78651-66a9-4a9a-9b27-b11c599c6b42",
                                                "sense_id": "578ff0a9-a280-3c57-9219-aa5b3d39a010",
                                                "text": "[…]Now there are a lot of crybabies around who are talking about what ought to have done and the bomb ought to have had a demonstration in Japan before you killed all those people. […] I don't care what the crybabies say now because they didn't have to make the decision."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crybaby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40c3bf78-d7f8-3209-a00b-2e366ccf8b74",
                                        "entry_id": "4602b6e3-7500-3482-9a6b-59c495992aa0",
                                        "glosses": [
                                            "To act like a crybaby."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef5396ca-602d-44fa-9eef-dc00dc50c56d",
                                                "sense_id": "40c3bf78-d7f8-3209-a00b-2e366ccf8b74",
                                                "text": "Out: Trash talk, dirty play, crybabying, showboating and players who can't be bothered to show up for games or keep their shoes on."
                                            },
                                            {
                                                "example_id": "993983f9-4b75-4158-98fa-1c84465a01cd",
                                                "sense_id": "40c3bf78-d7f8-3209-a00b-2e366ccf8b74",
                                                "text": "“I have learned the hard way,” she crybabied this week, “that we have to be fearless and loud in order to be heard, and to prepare for the backlash that occasionally comes with that outspokenness.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
