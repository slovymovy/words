                "senses": [
                    {
                        "sense_id": "5768a02c-e963-3c65-b1b5-63371afd1e66",
                        "entry_id": "f2e11eb0-4c1d-3283-a6ba-061eca13ea4b",
                        "glosses": [
                            "ein winkelförmiger Knochen und Teil des Beckens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64199d30-e07c-4c78-9667-d4d27513b948",
                                "sense_id": "5768a02c-e963-3c65-b1b5-63371afd1e66",
                                "text": "„Das Schambein liegt im unteren Beckenbereich.“"
                            },
                            {
                                "example_id": "11c33d7a-6223-4f25-9a5e-6ea986f72f02",
                                "sense_id": "5768a02c-e963-3c65-b1b5-63371afd1e66",
                                "text": "„Die Symphyse ist die knorpelige Verbindung beider Schambeine.“"
                            },
                            {
                                "example_id": "d24c633d-b13c-4411-bded-12d9c9ad81f8",
                                "sense_id": "5768a02c-e963-3c65-b1b5-63371afd1e66",
                                "text": "„Tatsächlich mussten dem Aufsichtsratsvorsitzenden der Deutschen Bank sechs Schrotkugeln aus dem Schambein operiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
