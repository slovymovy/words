                        "sense_id": "a7893e3b-f64b-3b44-8757-8447b2578c49",
                        "entry_id": "000bfceb-db57-3434-8689-94bfe1db635c",
                        "glosses": [
                            "in een stijl die past bij het begin van de regeringsperiode van koningin Victoria in Engeland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95ded94-d2d4-4253-91a7-3cf484517b1d",
                                "sense_id": "a7893e3b-f64b-3b44-8757-8447b2578c49",
                                "text": "Het is een door Hollywood geadopteerde Victoriaanse traditie die teruggaat op Charles Dickens’ A Christmas Carol in 1843: egoïsme en hebzucht die het onder de kerstboom afleggen tegen gulheid, warmte en samenzijn. Het leverde elk jaar kerstfilmhits op, van It’s a Wonderful Life (1946) tot Home Alone (1990). Eind november is de tijd om kerstfilms te lanceren: na de feestdagen gaat namelijk niemand meer. Maar gezien het aanbod van de laatste jaren, is het genre dood."
                            }
                        ]
