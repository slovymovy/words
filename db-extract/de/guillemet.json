                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c913ba9e-ea3c-43ff-8960-4f4f02c53e75",
                                "sense_id": "7db90b80-8397-358b-9621-befc7e5b9f09",
                                "text": "Guillemets verwendet man für die Kennzeichnung der direkten Rede."
                            },
                            {
                                "example_id": "3936ee19-0a98-4fba-ad1c-e992e20148c7",
                                "sense_id": "7db90b80-8397-358b-9621-befc7e5b9f09",
                                "text": "„Guillemets oder umgekehrte französische Anführungszeichen werden eingesetzt, um in UML Stereotypen anzugeben: « ».“"
                            },
                            {
                                "example_id": "7efbfa17-1346-4832-97e6-ed4cbd634992",
                                "sense_id": "7db90b80-8397-358b-9621-befc7e5b9f09",
                                "text": "„Guillemets sehen im Gegensatz zu Gänsefüßchen wie Gänsefüße aus und sind nach einem gewissen Guillaume benannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe254ec-c569-4508-a0a8-cd39a21445bd",
                        "source_entry_id": "1d0d9e7e-476b-36aa-a6d9-3fdfef91df09",
                        "source_sense_id": "7db90b80-8397-358b-9621-befc7e5b9f09",
                        "source_sense_description": "veraltet, meist im Plural verwendet: spitzes Anführungszeichen",
                        "target_lang_word": "chevron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevron",
