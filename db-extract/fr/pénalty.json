                        "target_lang_word": "Elfmeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elfmeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cba07037-8b6d-31a7-9089-7954e6d1cb56",
                                        "entry_id": "2fdcdc84-0b40-3506-aed7-96ad3fcb3508",
                                        "glosses": [
                                            "Strafstoß aus 11 Metern Entfernung vom Tor (vom Elfmeterpunkt) bei bestimmten Regelverstößen, bei grober Unsportlichkeit im Strafraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5615f6-2ce6-437d-bd8d-7495df4e6320",
                                                "sense_id": "cba07037-8b6d-31a7-9089-7954e6d1cb56",
                                                "text": "Der Schiedsrichter gab einen Elfmeter wegen Handspiels im Strafraum."
                                            },
                                            {
                                                "example_id": "7352a7d5-8a15-45ea-802e-c262d01246bf",
                                                "sense_id": "cba07037-8b6d-31a7-9089-7954e6d1cb56",
                                                "text": "„Er verschoss diverse Elfmeter.“"
                                            },
                                            {
                                                "example_id": "c082b01d-3a28-4287-8e0e-a7235f15c0b5",
                                                "sense_id": "cba07037-8b6d-31a7-9089-7954e6d1cb56",
                                                "text": "„Bei einem Elfmeter kann der Torwart zum Helden werden. Aber wie hält man einen Elfmeter? Welche Tricks gibt es?“"
                                            },
                                            {
                                                "example_id": "4240f586-b4b5-4d26-ae43-2dfd5329f5ee",
                                                "sense_id": "cba07037-8b6d-31a7-9089-7954e6d1cb56",
                                                "text": "„Eigentlich ist es keine Schwierigkeit, einen Elfmeter zu verwandeln. Aber selbst die besten Fußballer der Welt haben schon Elfer verschossen.“"
                                            },
                                            {
                                                "example_id": "a87d96e4-417c-420b-b165-78ec840c62b5",
                                                "sense_id": "cba07037-8b6d-31a7-9089-7954e6d1cb56",
                                                "text": "[Rassismus:] „Was sich nach den verschossenen Elfmetern von Bukayo Saka, Jadon Sancho und Marcus Rashford in den sozialen Netzwerken entladen hat, ist mehr als nur Frust über ein denkbar knapp verlorenes EM-Finale gegen Italien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
