                    },
                    {
                        "translation_id": "fa22325c-7181-4e2a-b80d-487d2f5f5d1d",
                        "source_entry_id": "a033e473-946e-3d0a-9e54-76581fdc0d74",
                        "source_sense_description": "to join together",
                        "target_lang_word": "conjoindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjoindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c49b63c-96c2-31db-a52b-08d31184186b",
                                        "entry_id": "42f69f00-68f2-32dc-8c93-5cb352772838",
                                        "glosses": [
                                            "Joindre en mariage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9631c4ff-c121-4e75-adc1-67531c91bcae",
                                                "sense_id": "5c49b63c-96c2-31db-a52b-08d31184186b",
                                                "text": "Il ne faut pas que l’homme sépare ce que Dieu a conjoint'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839d6dc1-f95d-3628-abc9-b3e57f4d23cb",
                                        "entry_id": "42f69f00-68f2-32dc-8c93-5cb352772838",
                                        "glosses": [
                                            "Avoir un rapport sexuel."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e1d4858-a7b0-4118-a128-ee574ab70154",
                                                "sense_id": "839d6dc1-f95d-3628-abc9-b3e57f4d23cb",
                                                "text": "Mais j’ai envie d'un jeune homme que je pourrais conjoindre d'une façon licite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc3055c-c605-3c93-ae3f-b5610a03a91c",
                                        "entry_id": "42f69f00-68f2-32dc-8c93-5cb352772838",
                                        "glosses": [
                                            "Réunir, joindre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec4d099-e11a-4db4-9013-1bed1a07794f",
                                                "sense_id": "4cc3055c-c605-3c93-ae3f-b5610a03a91c",
                                                "text": "Le génie de la Résistance, c’est d'avoir su conjoindre, face à une même urgence historique, toutes les forces spirituelles de ce pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1513f11-8574-397b-b7df-637d091f1637",
                                        "entry_id": "42f69f00-68f2-32dc-8c93-5cb352772838",
                                        "glosses": [
                                            "Se joindre, se réunir."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66e608f-dd68-4c50-9066-ac6f613d38db",
                                                "sense_id": "e1513f11-8574-397b-b7df-637d091f1637",
                                                "text": "De chaque côté de son grand nez, ses yeux divergents, globuleux et pleins de pitié se conjoignaient pour observer son consultant, pour pénétrer au fond de ses cryptes, dans ses replis les plus secrets."
                                            },
                                            {
                                                "example_id": "19d21c88-23ee-45c5-b147-551e86330848",
                                                "sense_id": "e1513f11-8574-397b-b7df-637d091f1637",
                                                "text": "La vie et la mort se conjoignaient dans cette hostie, cette victime élevée par le prêtre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
