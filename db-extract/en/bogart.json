                                "target_senses": [
                                    {
                                        "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                        "entry_id": "a226c1d4-a9ee-3f0d-b077-0c5af883aa1a",
                                        "glosses": [
                                            "Reunir posesiones o poder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e4d109-947d-4fb8-ac5c-a505ccdcddb8",
                                                "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                                "text": "El comienzo del fin empieza a atisbarse cuando Almanzor relegó a Hixam II (976-1013) y acaparó el poder."
                                            },
                                            {
                                                "example_id": "26b5c936-df76-4546-a033-6cab2cc74079",
                                                "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                                "text": "Este pujante grupo social también acaparó la nueva calle de La Cámara, convirtiéndola en la principal arteria comercial de Avilés."
                                            },
                                            {
                                                "example_id": "a90d6459-ccb3-41bc-b601-bf075638ecf2",
                                                "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                                "text": "Aunque permaneció como república la familia Medicis acaparó todo el poder. Hubo numerosas guerras internas entre partidos políticos, con miembros tan destacados como Dante."
                                            },
                                            {
                                                "example_id": "981110e2-dce8-4fd1-9341-c4d858d153c0",
                                                "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                                "text": "El film acaparó la atención de los estudios Walt Disney donde, a la edad de 14 años, Bird fue apadrinado por el legendario animador Milt Kahl, uno de los Nine Old Men (nombre que recibian los mas veteranos animadores del estudio)."
                                            },
                                            {
                                                "example_id": "73a45675-edc4-4a9a-9aa5-7a0b19dfe26f",
                                                "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                                "text": "Bonaparte acaparó cada vez más poder y ganaba apoyos para su visión sobre la reconstrucción de Francia y sus instituciones."
                                            },
                                            {
                                                "example_id": "78f0f843-5507-4014-bea6-30c76eeb4ae3",
                                                "sense_id": "5eefc914-a1c8-3e16-91c0-5cd35648def4",
                                                "text": "Con el tiempo, Odo acaparó un condado tras otro, hasta dominar un total de 23 pequeños territorios desperdigados por el suroeste de Inglaterra."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11bc7f10-d2fb-377f-96ef-3e2a71c4387d",
                                        "entry_id": "a226c1d4-a9ee-3f0d-b077-0c5af883aa1a",
                                        "glosses": [
                                            "Esconder bienes con el objeto de disminuir su disponibilidad y obtener ganancias más tarde al venderlos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
