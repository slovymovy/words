                    "sense_id": "3b083b0b-d8d4-30cd-ae92-f4ffec0acc5f",
                    "sense_definition": "Расположить кого-либо к себе с помощью лести, подарков или услуг.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "расположение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он попытался <w>задобрить</w> строгого начальника небольшим подарком.",
                            "target_lang_translations": {
                                "en": "He tried to <w>placate</w> his strict boss with a small gift."
                            }
                        },
                        {
                            "text": "Не пытайся меня <w>задобрить</w> своими пустыми обещаниями.",
                            "target_lang_translations": {
                                "en": "Don't try to <w>win me over</w> with your empty promises."
                            }
                        }
                    ],
                    "synonyms": [
                        "умилостивить"
                    ],
                    "common_phrases": [
                        "задобрить подарком",
                        "задобрить лестью"
                    ],
                    "target_lang_definitions": {
                        "en": "To win someone over or make them feel favorably disposed toward you through flattery, gifts, or favors."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "placate",
                                "target_lang_sense_clarification": "to make someone less angry or hostile, often by giving them what they want"
                            },
                            {
                                "target_lang_word": "appease",
                                "target_lang_sense_clarification": "to pacify someone by acceding to their demands or offering something to gain favor"
                            },
                            {
                                "target_lang_word": "win over",
                                "target_lang_sense_clarification": "to persuade someone to support or be friendly toward you"
                            },
                            {
                                "target_lang_word": "soften up",
                                "target_lang_sense_clarification": "to make someone more receptive or less resistant to a request"
                            }
                        ]
                    }
                }
            ]
        }
    ]
