                                        "sense_id": "697523c6-432d-322a-9cc2-2d539fa9f591",
                                        "entry_id": "9f73f81b-6d7f-3870-ad07-a71e4f21577a",
                                        "glosses": [
                                            "Ensemble cohérent de principes esthétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
