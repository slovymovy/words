                        {
                            "text": "Солнце освещало <золотые> купола старинной церкви.",
                            "target_lang_translations": {
                                "en": "The sun illuminated the <golden> domes of the ancient church.",
                                "nl": "De zon verlichtte de <gouden> koepels van de oude kerk.",
                                "pl": "Słońce oświetlało <złote> kopuły starej cerkwi.",
                                "de": "Die Sonne beleuchtete die <w>goldenen</w> Kuppeln der alten Kirche.",
                                "fr": "Le soleil illuminait les dômes <dorés> de l'ancienne église.",
                                "it": "Il sole illuminava le cupole <dorate> dell'antica chiesa.",
                                "cs": "Slunce osvětlovalo <zlaté> kopule starobylého kostela.",
                                "tr": "Güneş, eski kilisenin <altın rengi> kubbelerini aydınlatıyordu.",
                                "es": "El sol iluminaba las cúpulas <doradas> de la antigua iglesia.",
                                "zh": "阳光照耀着古老教堂的<w>金色</w>圆顶。"
