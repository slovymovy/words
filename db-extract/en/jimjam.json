    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "390019d6-d7d3-36ef-a6a8-cc07b94d3281",
                "word": "jimjam",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d89d4cb5-48cb-3aac-b1ac-17b0e9dbd9ea",
                        "entry_id": "390019d6-d7d3-36ef-a6a8-cc07b94d3281",
                        "glosses": [
                            "Crazy; insane or befuddled."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "989f2834-6d9a-4478-9c8e-eb0351d97943",
                                "sense_id": "d89d4cb5-48cb-3aac-b1ac-17b0e9dbd9ea",
                                "text": "Insurancewise, the papers tell of a new hat-passer started in Chicago to demonstrate that Dr. Keeley's \"cured\" jimjam patients, whom regular companies look askance at, are as safe risks as sober men ;"
                            },
                            {
                                "example_id": "aff13e7d-53a0-40fc-a9d1-27823a9db099",
                                "sense_id": "d89d4cb5-48cb-3aac-b1ac-17b0e9dbd9ea",
                                "text": "It was just a crazy jimjam lark, concocted by a fuddled brain, but it might have had most serious consequences for the innocent clerk."
                            },
                            {
                                "example_id": "e58cb86b-12c5-4ef1-8128-4d4150e9f215",
                                "sense_id": "d89d4cb5-48cb-3aac-b1ac-17b0e9dbd9ea",
                                "text": "She was having the jimjam fits. Carried on like the crazy bitch she is.”"
                            },
                            {
                                "example_id": "9fa64da2-ed8e-4f80-b1b2-7eae3f872228",
                                "sense_id": "d89d4cb5-48cb-3aac-b1ac-17b0e9dbd9ea",
                                "text": "Young guy in a caftan sitting on the floor was twisting a flower in his fingers, smiling at nothing and muttering to himself – a classic jim-jam case."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8292f3bc-dabd-3250-a29c-15251cc2ee50",
                "word": "jimjam",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5127e465-a63d-4253-a397-ab3756af8934",
                        "entry_id": "8292f3bc-dabd-3250-a29c-15251cc2ee50",
                        "tags": [
