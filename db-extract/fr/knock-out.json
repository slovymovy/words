                                        "sense_id": "503d98b1-fd56-39da-82e2-69ed02ec9cdb",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
                                            "To strike or render unconscious",
                                            "To strike or bump (someone or something) out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ece2c8e-d227-4222-b0c7-6f5719a6b6f5",
                                                "sense_id": "503d98b1-fd56-39da-82e2-69ed02ec9cdb",
                                                "text": "I accidentally knocked out the glass in my picture frame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e9f167-84f1-3138-ac74-d8d8eb11f2b7",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
                                            "To strike or render unconscious",
                                            "To render unconscious, as by a blow to the head."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d12909ad-ec19-45f0-a663-54cb2aa2c07b",
                                                "sense_id": "a0e9f167-84f1-3138-ac74-d8d8eb11f2b7",
                                                "text": "The boxer knocked out his opponent in the third round."
                                            },
                                            {
                                                "example_id": "119ad1e5-2874-4050-9437-bc6d3b623b1e",
                                                "sense_id": "a0e9f167-84f1-3138-ac74-d8d8eb11f2b7",
                                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a75d2d51-534a-3ce4-9835-8ec89500de79",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
                                            "To strike or render unconscious",
                                            "To put to sleep."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9b5d8b-dd23-44ed-9dea-de7a02a41c8c",
                                                "sense_id": "a75d2d51-534a-3ce4-9835-8ec89500de79",
                                                "text": "The allergy pill knocked him out for a good three hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f5bea99-733d-3207-b220-e181508fadce",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
                                            "To strike or render unconscious",
                                            "To fall asleep, especially suddenly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc42fdd8-b808-4ae8-8fb7-7f141deb9dce",
                                                "sense_id": "8f5bea99-733d-3207-b220-e181508fadce",
                                                "text": "That's a put-you-straight-to-sleep book if there ever was one, and I knocked right out after two paragraphs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e9e7cd-8171-3806-9831-2f2219d3faeb",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
                                            "To strike or render unconscious",
                                            "To exhaust."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14889ba9-dec7-4dbc-ab09-569c7ddca87f",
                                                "sense_id": "b5e9e7cd-8171-3806-9831-2f2219d3faeb",
                                                "text": "Running errands all day really knocked him out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e6ccb5-3df4-3a86-842b-3244b9c2e0bc",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
                                            "To strike or render unconscious",
                                            "To impress, surpass or overwhelm (someone)."
                                        ],
                                        "tags": [
