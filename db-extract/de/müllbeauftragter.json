                "senses": [
                    {
                        "sense_id": "084b6888-837d-3e63-bf14-bcd7516d0783",
                        "entry_id": "553b0135-8f54-36b0-8914-1fb9b07a1547",
                        "glosses": [
                            "jemand, der mit dem Auftrag oder der Aufgabe betraut ist, diese erledigen soll und den Auftraggeber eventuell dazu vertritt, wenn es um den Müll geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0fc94c-0639-4895-b455-407ffa6dd65f",
                                "sense_id": "084b6888-837d-3e63-bf14-bcd7516d0783",
                                "text": "„Wir empfehlen vor dem Entsorgen Absprache mit den örtlichen Müllbeauftragten der Gemeinde / Stadt Rücksprache zu halten.“"
                            },
                            {
                                "example_id": "bd932c68-0b22-48a8-a4de-23c4e2c0a22b",
                                "sense_id": "084b6888-837d-3e63-bf14-bcd7516d0783",
                                "text": "„Neulich hat unser Müllbeauftragter wegen akuter Pubertätsamnesie glatt vergessen die Mülltonne am Mittwoch abend an die Straße zu stellen.“"
                            },
                            {
                                "example_id": "e655c7bd-5421-4a1c-bd9c-4d3419feecb8",
                                "sense_id": "084b6888-837d-3e63-bf14-bcd7516d0783",
                                "text": "„Jahrelang hat er auf seine KollegInnen [sic] als Müllbeauftragter eingewirkt, damit sie lernen, wie man den Müll richtig trennt.“"
                            },
                            {
                                "example_id": "dc0f825a-cf58-4ad9-84f6-7a1eb12e4777",
                                "sense_id": "084b6888-837d-3e63-bf14-bcd7516d0783",
                                "text": "„Ein neuer Müllbeauftragter der Stadt soll dies den Multiplikatoren nahe bringen, die Informationen wiederum an ihre Landsleute weitergeben.“"
                            },
                            {
                                "example_id": "2860b55c-8cd5-48cd-a256-dab1ce8de55a",
                                "sense_id": "084b6888-837d-3e63-bf14-bcd7516d0783",
                                "text": "„Am 26.11.2010 hatten wir Besuch von Herrn Peter Hägler (Müllbeauftragter des Landratsamtes Neustadt).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
