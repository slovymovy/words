                {
                    "sense_id": "a909e6b8-76a7-3f6f-8def-ee8b8f89ce29",
                    "sense_definition": "Qualifie une culture végétale dense qui empêche le développement des mauvaises herbes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agronome conseille de semer une plante <w>étouffante</w> pour nettoyer naturellement la parcelle avant l'hiver."
                        },
                        {
                            "text": "Certaines cultures <w>étouffantes</w> permettent de limiter considérablement l'usage de produits chimiques dans les champs."
                        }
                    ],
                    "common_phrases": [
                        "culture étouffante"
                    ]
                }
            ]
        },
        {
