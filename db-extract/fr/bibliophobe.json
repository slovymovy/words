                        "entry_id": "80775f1c-e25c-3a0c-9c35-b0a9f5fb15b2",
                        "glosses": [
                            "Personne ou animal qui déteste les livres ou veut leur nuire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68bf1b5a-9762-4de3-894c-4c4df08febf6",
                                "sense_id": "ce890ab8-3423-36fe-bc2e-ae6f1f74185c",
                                "text": "Ce n’est pas que le bibliophobe lise Voltaire, il s’en garde bien ; mais il se félicite de trouver en Voltaire un prétexte spécieux à son dédain universel pour les livres."
                            },
                            {
                                "example_id": "cbacc6f1-b88d-42f8-bbd8-b6525836919d",
                                "sense_id": "ce890ab8-3423-36fe-bc2e-ae6f1f74185c",
                                "text": "Les insectes ont été de tout temps le fléau des bibliothèques, on ne saurait trop mettre de soins à les préserver de ces dangereux bibliophobes."
                            }
                        ]
                    }
