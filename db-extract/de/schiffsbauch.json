                "senses": [
                    {
                        "sense_id": "095eb677-2e4d-3dc0-8cfa-393e004999ac",
                        "entry_id": "3ecd4adb-08a2-3d1b-aa5d-a805c4532212",
                        "glosses": [
                            "unterer, innerer Teil eines Schiffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b737d9b-13fa-40de-93c1-93e959e4d353",
                                "sense_id": "095eb677-2e4d-3dc0-8cfa-393e004999ac",
                                "text": "„Der Fluch der untätigen Nutzlosigkeit war in diesem Moment von uns genommen, braune Kristalle rieselten nun aus den aufgeschlitzten Säcken unaufhaltsam in die Tiefen des Schiffsbauchs hinab.“"
                            },
                            {
                                "example_id": "70804dc0-f3df-49b4-bef1-ca5f79079b01",
                                "sense_id": "095eb677-2e4d-3dc0-8cfa-393e004999ac",
                                "text": "„Wir gehen in den Schiffsbauch, setzen uns an einen Tisch.“"
                            },
                            {
                                "example_id": "d7c8340b-df9b-4fe0-9976-41b02c893adc",
                                "sense_id": "095eb677-2e4d-3dc0-8cfa-393e004999ac",
                                "text": "„Nur das Heulen der Alarmanlagen drang noch aus dem Schiffsbauch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
