                ],
                "senses": [
                    {
                        "sense_id": "5d1771d2-ad8b-3901-be49-77945fb10029",
                        "entry_id": "931aac39-45dd-39d3-996e-15b20be85101",
                        "glosses": [
                            "ärmliche weibliche Person, die in der Gegend umherstreift, in der Regel ohne Wohnsitz"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "784e29cd-28f7-4133-8085-edf44eeea287",
                                "sense_id": "5d1771d2-ad8b-3901-be49-77945fb10029",
                                "text": "„Einzelne Münzen sprangen zur Seite und rollten durch die Stube, Stromer und Stromerinnen, Männer und Weiber stürzten nach, fuhren auf den Boden und zausten sich um das Geld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b015f8d3-e319-3c91-9a27-5562cd7578b5",
                        "entry_id": "931aac39-45dd-39d3-996e-15b20be85101",
                        "glosses": [
                            "meist junges oder kleines weibliches Wesen, das immer wieder seinen Ort verlässt, weit weggeht, ohne Wissen der Aufsichtsperson an verschiedene Orte geht"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "bd5d2e80-95df-4002-8393-1edaa2097b30",
                                "sense_id": "b015f8d3-e319-3c91-9a27-5562cd7578b5",
                                "text": "„Da wird Hauke Hansen aber Augen machen, wenn ich ihm seine nasse Katze zurückbringe, denke ich. Das ist ja eine richtige kleine Stromerin …“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
