                "senses": [
                    {
                        "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                        "entry_id": "20f990f9-2c85-3cd5-ad77-aa3972458ebc",
                        "glosses": [
                            "gefühlter Druck, erfolgreich sein zu müssen; Stress, der durch die Erwartung entsteht, bestimmte Erfolge oder Leistungen zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700c1623-6a83-494a-bafe-d687bcee4414",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "Der Erfolgsdruck ist für Schüler und Studenten in Südkorea sehr hoch."
                            },
                            {
                                "example_id": "7639c8aa-86a6-4de7-8b00-5784f16eb243",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Eigenen Angaben zufolge hatte Radcliffe bis 2010 wegen des Erfolgsdrucks durch die Harry-Potter-Filme ein Alkoholproblem.“"
                            },
                            {
                                "example_id": "32fbcabe-8689-4e05-a114-824f5da5d000",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Früh schon bestimmt Alenas Mutter […], dass die begabte Tochter Pianistin werden soll. Sie schickt ihr Mädchen für zehn Jahre nach Kiew ins Musikinternat. Das Kind zerbricht fast am Erfolgsdruck und den harten Bedingungen.“"
                            },
                            {
                                "example_id": "a3cc059a-54f9-4db4-92be-36b7725154b6",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Einige Kinder fühlen sich zudem von Hetze und Eile (7 Prozent), frühem Aufstehen und Erfolgsdruck (jeweils 3 Prozent) gestresst, wobei Drittklässler den Erfolgsdruck doppelt so oft als anstrengend empfinden wie Zweitklässler.“"
                            },
                            {
                                "example_id": "c460a23d-064c-4810-a469-53c2b57bdbc1",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Bei den Aufnahmen gab es aufgrund des Erfolgsdruckes erste Spannungen innerhalb der Band.“"
                            },
                            {
                                "example_id": "7166c95b-2df2-4dff-83ec-5ef5065a7ff9",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "[Über den schwedischen Fußballtrainer Sven-Göran Eriksson:] „Als Nachfolger von Toni, der den Klub 1988 ins Endspiel um den Europapokal der Landesmeister […] geführt und im folgenden Jahr die Meisterschaft gewonnen hatte, lastete ein starker Erfolgsdruck auf ihm.“"
                            },
                            {
                                "example_id": "61440afa-8afb-414e-acb4-c278658c3b1e",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Der sportliche Erfolgsdruck bei Real Madrid ist enorm.“"
                            },
                            {
                                "example_id": "9a48a1f2-a5f4-47a8-be75-c00b8d834a7f",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "[FC Bayern München:] „Die Entscheidung für [den neuen Trainer Vincent] Kompany ist mutig, denn nach der ersten titellosen Saison seit 2012 sind Erfolgsdruck und Erwartungshaltung äußerst hoch.“"
                            },
                            {
                                "example_id": "d61808c7-a756-4f78-b9c5-e6a60da1164d",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "[Radrennen: …] „Edelhelfer Sepp Kuss, der früher an Nervenflattern bei Erfolgsdruck litt, wirkt von Tag zu Tag souveräner im roten Trikot des Führenden.“"
                            },
                            {
                                "example_id": "6a49bf30-a4ec-44d3-810d-7e8f91cca087",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Laut der Deutschen Sporthilfe regiert Erfolgsdruck den Leistungssport. Doping und Versagensängste sind längst Normalität.“"
                            },
                            {
                                "example_id": "c7fef68a-bbc9-4ebe-ba45-bdbe54fa1d60",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„Als die Sowjets mit Juri Gagarin den ersten Menschen ins Weltall geschickt hatten, standen die US-Amerikaner unter erheblichem Erfolgsdruck.“"
                            },
                            {
                                "example_id": "f245bf9a-9fa0-4cbc-9350-0b2c17ec72f5",
                                "sense_id": "6ea1a14f-c639-3159-8375-472e9658e96d",
                                "text": "„«Die Entdeckung des Higgs-Teilchens hat dem CERN eine mediale Aufmerksamkeit beschert, die vorher unvorstellbar war. Damit ist der Erfolgsdruck gestiegen.»“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
