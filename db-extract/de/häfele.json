                ],
                "senses": [
                    {
                        "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                        "entry_id": "8d61b4ab-271f-335b-b146-abe7a84e4b77",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a601ba17-d5ed-4f04-9ebc-681293aa2837",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Frau Häfele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d11c8f62-bc79-48fc-8027-80b5e28bb86a",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Herr Häfele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d6171bdd-a4c3-481b-a852-4b86969d7e59",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Die Häfeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d0ec634a-f6d3-4e08-b5c4-c1c01e136da7",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Der Häfele trägt nie die Schals, die die Häfele ihm strickt."
                            },
                            {
                                "example_id": "22602b51-c8ce-40d7-b331-2a5d9dcb786e",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häfele kommt, geht der Herr Häfele.“"
                            },
                            {
                                "example_id": "a5ffbf29-4221-45f5-be40-595ced7deb0e",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Häfele kommt und geht."
                            },
                            {
                                "example_id": "875b7c1b-9363-4d17-a70a-7ae2df34c176",
                                "sense_id": "7dacae97-cad5-3027-806f-e9a6014e0859",
                                "text": "Häfeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
