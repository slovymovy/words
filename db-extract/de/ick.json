                                                "sense_id": "3bf809d5-94d6-32a9-b64e-aa376b4fdf01",
                                                "text": "Can you hear me?"
                                            },
                                            {
                                                "example_id": "0436ad12-8f4d-4b1d-b066-781aaa2c1203",
                                                "sense_id": "3bf809d5-94d6-32a9-b64e-aa376b4fdf01",
