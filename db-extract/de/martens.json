                ],
                "senses": [
                    {
                        "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                        "entry_id": "5aca007d-1dfc-3866-b008-37a281818299",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713a59ce-5c1f-4ac5-81af-0e9533de7845",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Frau Martens ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6842e889-61cc-4eb7-a764-4eb09e349e15",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Herr Martens wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7063da55-ed53-48c9-952e-7d0f29f59bf3",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Die Martens fahren heute ins Weserbergland."
                            },
                            {
                                "example_id": "954b2f32-9867-43b4-b9c4-82b6af16a368",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Der Martens trägt nie die Schals, die die Martens ihm strickt."
                            },
                            {
                                "example_id": "1bbaf6ad-ad7e-469d-8cdd-865935bfb927",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Martens kommt, geht der Herr Martens.“"
                            },
                            {
                                "example_id": "6fb3172b-2356-41ce-b470-2b29aefe2722",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Martens kommt und geht."
                            },
                            {
                                "example_id": "2af33834-9c6f-49be-9f1e-cb038ad74445",
                                "sense_id": "4d5c9b70-111f-3cfd-9595-441b2100fa11",
                                "text": "Martensens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
