{
    "word_family": [
        "zatrzymywać",
        "zatrzymanie",
        "trzymać",
        "powstrzymać",
        "wstrzymać",
        "utrzymać",
        "wytrzymać",
        "przytrzymać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ea13a4b-338f-3fee-9ae7-0c122a9340fe",
                    "sense_definition": "Sprawić, że ktoś lub coś przestaje się poruszać, działać lub funkcjonować",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_stop_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca musiał nagle <w>zatrzymać</w> samochód przed przejściem dla pieszych.",
                            "target_lang_translations": {
                                "ru": "Водитель должен был внезапно <w>остановить</w> машину перед пешеходным переходом.",
                                "en": "The driver had to suddenly <w>stop</w> the car before the pedestrian crossing."
                            }
                        },
                        {
                            "text": "Lekarzom udało się szybko <w>zatrzymać</w> krwawienie u pacjenta.",
                            "target_lang_translations": {
                                "ru": "Врачам удалось быстро <w>остановить</w> кровотечение у пациента.",
                                "en": "The doctors managed to quickly <w>stop</w> the patient's bleeding."
                            }
                        }
                    ],
                    "synonyms": [
                        "zahamować",
                        "wstrzymać",
                        "zastopować",
                        "unieruchomić"
                    ],
                    "antonyms": [
                        "uruchomić",
                        "ruszyć"
                    ],
                    "common_phrases": [
                        "zatrzymać samochód",
                        "zatrzymać oddech",
                        "zatrzymać krwawienie",
                        "zatrzymać akcję serca"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то или что-то перестать двигаться, действовать или функционировать",
                        "en": "To cause someone or something to stop moving, operating, or functioning."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "прекратить движение или действие"
                            },
                            {
                                "target_lang_word": "прекратить",
                                "target_lang_sense_clarification": "перестать делать что-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to bring to a halt"
                            },
                            {
                                "target_lang_word": "halt",
                                "target_lang_sense_clarification": "to bring to a sudden stop"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2fb8e7b-df71-39aa-9714-084ba1aaa774",
                    "sense_definition": "Przestać się poruszać, iść lub jechać; stanąć w miejscu (używane z zaimkiem „się”)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_stop_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pociąg <w>zatrzymał</w> się na stacji punktualnie o godzinie ósmej.",
                            "target_lang_translations": {
                                "ru": "Поезд <w>остановился</w> на станции ровно в восемь часов.",
                                "en": "The train <w>stopped</w> at the station punctually at eight o'clock."
                            }
                        },
                        {
                            "text": "Przed domem nauczyciela uczeń <w>zatrzymał</w> się i zapukał do drzwi.",
                            "target_lang_translations": {
                                "ru": "Перед домом учителя ученик <w>остановился</w> и постучал в дверь.",
                                "en": "In front of the teacher's house, the student <w>stopped</w> and knocked on the door."
                            }
                        }
                    ],
                    "synonyms": [
                        "stanąć",
                        "przystanąć"
                    ],
                    "antonyms": [
                        "ruszyć"
                    ],
                    "common_phrases": [
                        "zatrzymać się na chwilę",
                        "zatrzymać się na światłach",
                        "zatrzymać się w miejscu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать двигаться, идти или ехать; встать на месте",
                        "en": "To cease moving, walking, or driving; to stand still (used with the reflexive pronoun 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановиться",
                                "target_lang_sense_clarification": "перестать двигаться"
                            },
                            {
                                "target_lang_word": "встать",
                                "target_lang_sense_clarification": "разг. прекратить движение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cease motion"
                            },
                            {
                                "target_lang_word": "pull over",
                                "target_lang_sense_clarification": "to stop a vehicle at the side of the road"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "385f2736-1f11-36b3-b7c7-11e1df721cc8",
                    "sense_definition": "Zachować coś dla siebie; nie oddać czegoś lub nie wyrzucić",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Możesz <w>zatrzymać</w> resztę, to napiwek za dobrą obsługę.",
                            "target_lang_translations": {
                                "ru": "Можешь <w>оставить</w> сдачу, это чаевые за хорошее обслуживание.",
                                "en": "You can <w>keep</w> the change, it's a tip for good service."
                            }
                        },
                        {
                            "text": "Postanowiłem <w>zatrzymać</w> ten stary zegarek jako pamiątkę po dziadku.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>оставить</w> эти старые часы как память о дедушке.",
                                "en": "I decided to <w>keep</w> this old watch as a memento of my grandfather."
                            }
                        }
                    ],
                    "synonyms": [
                        "zachować",
                        "zostawić"
                    ],
                    "antonyms": [
                        "oddać",
                        "zwrócić",
                        "wyrzucić"
                    ],
                    "common_phrases": [
                        "zatrzymać resztę",
                        "zatrzymać dla siebie",
                        "zatrzymać w pamięci",
                        "zatrzymać paragon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставить что-то у себя; не отдавать или не выбрасывать",
                        "en": "To keep something for oneself; not to give away or throw away."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "сохранить у себя"
                            },
                            {
                                "target_lang_word": "сохранить",
                                "target_lang_sense_clarification": "сберечь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "to retain possession of"
                            },
                            {
                                "target_lang_word": "hold on to",
                                "target_lang_sense_clarification": "to keep something instead of giving it away"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c89d4fb2-1cbd-376c-be0e-ba72df20f515",
                    "sense_definition": "Zamieszkać gdzieś tymczasowo; spędzić gdzieś czas podczas podróży (używane z zaimkiem „się”)",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas wakacji w górach planujemy <w>zatrzymać</w> się w małym pensjonacie.",
                            "target_lang_translations": {
                                "ru": "Во время отпуска в горах мы планируем <w>остановиться</w> в маленьком пансионате.",
                                "en": "During our vacation in the mountains, we plan to <w>stay</w> in a small guesthouse."
                            }
                        },
                        {
                            "text": "Czy mogę <w>zatrzymać</w> się u ciebie na kilka dni, zanim znajdę mieszkanie?",
                            "target_lang_translations": {
                                "ru": "Могу ли я <w>остановиться</w> у тебя на несколько дней, пока не найду квартиру?",
                                "en": "Can I <w>stay</w> with you for a few days before I find an apartment?"
                            }
                        }
                    ],
                    "synonyms": [
                        "zamieszkać",
                        "zostać",
                        "przenocować",
                        "zakwaterować się"
                    ],
                    "antonyms": [
                        "wyjechać",
                        "opuścić"
                    ],
                    "common_phrases": [
                        "zatrzymać się w hotelu",
                        "zatrzymać się u znajomych",
                        "zatrzymać się na noc"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поселиться где-то временно; провести время где-то во время путешествия",
                        "en": "To stay somewhere temporarily; to spend time in a place during a trip (used with the reflexive pronoun 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановиться",
                                "target_lang_sense_clarification": "временно поселиться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "stay",
                                "target_lang_sense_clarification": "to reside temporarily"
                            },
                            {
                                "target_lang_word": "stop over",
                                "target_lang_sense_clarification": "to stay at a place during a journey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18f0c9c0-904b-3a3e-a890-1d60a1aed7c6",
                    "sense_definition": "Pozbawić kogoś wolności (zwykle o działaniu policji lub służb)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja zdołała <w>zatrzymać</w> złodzieja tuż po napadzie na bank.",
                            "target_lang_translations": {
                                "ru": "Полиция смогла <w>задержать</w> вора сразу после ограбления банка.",
                                "en": "The police managed to <w>detain</w> the thief right after the bank robbery."
                            }
                        },
                        {
                            "text": "Mężczyzna został <w>zatrzymany</w> do wyjaśnienia w sprawie wypadku.",
                            "target_lang_translations": {
                                "ru": "Мужчина был <w>задержан</w> для выяснения обстоятельств аварии.",
                                "en": "The man was <w>detained</w> for questioning regarding the accident."
                            }
                        }
                    ],
                    "synonyms": [
                        "aresztować",
                        "ująć",
                        "zgarnąć"
                    ],
                    "antonyms": [
                        "zwolnić",
                        "wypuścić"
                    ],
                    "common_phrases": [
                        "zatrzymać podejrzanego",
                        "zatrzymać do kontroli",
                        "zatrzymać prawo jazdy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишить кого-то свободы (обычно о действиях полиции или служб)",
                        "en": "To deprive someone of their freedom (usually regarding police or official actions)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "арестовать, взять под стражу"
                            },
                            {
                                "target_lang_word": "арестовать",
                                "target_lang_sense_clarification": "официально лишить свободы"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "detain",
                                "target_lang_sense_clarification": "to hold in custody"
                            },
                            {
                                "target_lang_word": "arrest",
                                "target_lang_sense_clarification": "to take into legal custody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e40d229-2bae-3bac-ba86-7167e550b77d",
                    "sense_definition": "Zająć komuś czas, sprawiając, że nie może on gdzieś pójść lub czegoś zrobić; opóźnić kogoś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przepraszam za spóźnienie, szef <w>zatrzymał</w> mnie w biurze po godzinach.",
                            "target_lang_translations": {
                                "ru": "Извини за опоздание, начальник <w>задержал</w> меня в офисе после работы.",
                                "en": "Sorry for being late, my boss <w>held</w> me <w>up</w> at the office after hours."
                            }
                        },
                        {
                            "text": "Przepraszam, że cię tak długo <w>zatrzymałem</w>, pewnie spieszysz się na pociąg.",
                            "target_lang_translations": {
                                "en": "Sorry for <w>keeping</w> you so long – you must be in a hurry to catch your train.",
                                "ru": "Извини, что я тебя так долго <w>задержал</w>, ты, наверное, спешишь на поезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "opóźnić",
                        "przetrzymać"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "zatrzymać kogoś w drzwiach",
                        "nic cię nie zatrzyma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять чье-то время, мешая уйти или что-то сделать; заставить ждать",
                        "en": "To occupy someone's time, preventing them from leaving or doing something; to delay someone."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "отнять время, заставить ждать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "detain",
                                "target_lang_sense_clarification": "to keep someone waiting"
                            },
                            {
                                "target_lang_word": "hold up",
                                "target_lang_sense_clarification": "to cause a delay"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04dcaedc-74e7-3113-8db9-4131e04f6a32",
                    "sense_definition": "Przeciąć komuś drogę lub przeszkodzić w dotarciu do celu; przechwycić",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_stop_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ochrona próbowała <w>zatrzymać</w> kibiców wbiegających na murawę boiska.",
                            "target_lang_translations": {
                                "ru": "Охрана пыталась <w>остановить</w> болельщиков, выбегающих на поле.",
                                "en": "Security tried to <w>stop</w> the fans running onto the pitch."
                            }
                        },
                        {
                            "text": "Udało nam się <w>zatrzymać</w> ten list, zanim trafił do adresata.",
                            "target_lang_translations": {
                                "ru": "Нам удалось <w>перехватить</w> это письмо, прежде чем оно попало к адресату.",
                                "en": "We managed to <w>intercept</w> this letter before it reached the recipient."
                            }
                        }
                    ],
                    "synonyms": [
                        "przechwycić",
                        "zastąpić drogę"
                    ],
                    "antonyms": [
                        "przepuścić"
                    ],
                    "common_phrases": [
                        "zatrzymać atak",
                        "zatrzymać w biegu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преградить кому-то путь или помешать достичь цели; перехватить",
                        "en": "To block someone's path or prevent them from reaching their goal; to intercept."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "преградить путь"
                            },
                            {
                                "target_lang_word": "перехватить",
                                "target_lang_sense_clarification": "поймать по дороге"
                            },
                            {
                                "target_lang_word": "сдержать",
                                "target_lang_sense_clarification": "не дать пройти"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "intercept",
                                "target_lang_sense_clarification": "to catch or block on the way"
                            },
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to prevent from proceeding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}