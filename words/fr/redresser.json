    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "114eddce-270e-3ae0-89a5-5bebf80b6076",
                    "sense_definition": "Rendre droit ce qui était courbé, tordu ou incliné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier utilise un marteau pour <w>redresser</w> les clous tordus avant de réparer la table."
                        },
                        {
                            "text": "En marchant dans la rue, il décida de <w>redresser</w> la tête pour regarder les vitrines."
                        }
                    ],
                    "antonyms": [
                        "courber",
                        "tordre",
                        "plier"
                    ],
                    "common_phrases": [
                        "redresser la tête",
                        "redresser la barre"
                    ]
                },
                {
                    "sense_id": "f165a97b-fdcb-3ff0-86eb-66864b6225f2",
                    "sense_definition": "Prendre ou reprendre une posture verticale et droite ; se relever.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué d'être assis devant son ordinateur, le jeune homme se <w>redresse</w> sur sa chaise."
                        },
                        {
                            "text": "Après avoir ramassé ses clés par terre, la voisine se <w>redressa</w> lentement avec un sourire."
                        }
                    ],
                    "synonyms": [
                        "se relever"
                    ],
                    "antonyms": [
                        "s'affaisser",
                        "se courber"
                    ]
                },
                {
                    "sense_id": "7bdb3cf3-8adc-3440-b144-0a48b3dcb79e",
                    "sense_definition": "Rétablir une situation en déclin ou redonner de la vigueur à une activité en difficulté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau directeur a proposé un plan efficace pour <w>redresser</w> l'économie de la société."
                        },
                        {
                            "text": "Grâce aux efforts de toute l'équipe, ils espèrent rapidement <w>redresser</w> la situation financière."
                        }
                    ],
                    "synonyms": [
                        "rétablir",
                        "relever"
                    ],
                    "antonyms": [
                        "aggraver",
                        "dégrader"
                    ],
                    "common_phrases": [
                        "redresser l'économie",
                        "redresser la situation"
                    ]
                },
                {
                    "sense_id": "a19d5d71-65d4-3161-929f-f16e93d800d5",
                    "sense_definition": "Corriger une erreur, une idée fausse ou ramener quelqu'un dans la bonne voie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "correction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur intervient calmement pour <w>redresser</w> les erreurs de calcul faites par les élèves."
                        },
                        {
                            "text": "Je me trompais lourdement dans mon raisonnement jusqu'à ce que mon collègue vienne me <w>redresser</w>."
                        }
                    ],
                    "synonyms": [
                        "corriger",
                        "rectifier"
                    ],
                    "common_phrases": [
                        "redresser un tort"
                    ]
                },
                {
                    "sense_id": "c68804e9-641d-3f30-8f4b-3b2e0c10763d",
                    "sense_definition": "Transformer un courant électrique alternatif en courant continu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dispositif électronique permet de <w>redresser</w> le courant alternatif fourni par le réseau domestique."
                        },
                        {
                            "text": "L'ingénieur doit <w>redresser</w> la tension afin d'alimenter correctement les composants sensibles."
                        }
                    ]
                }
            ]
        }
    ]
