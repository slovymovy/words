                        "glosses": [
                            "Idryma Koinonikon Asfaliseon (Griechenland, Transkription von: Ίδρυμα Κοινωνικών Ασφαλίσεων, ΙΚΑ; Institut für Sozialversicherung, wörtlich: ‚Anstalt Sozialer Versicherungen‘)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c2a54f-13c5-466c-b45c-3890bd60e094",
                                "sense_id": "e9c4a014-5717-3c37-9720-518302e5eb80",
                                "text": "„Es strebte vor allem die Erhöhung der Einkünfte, die Verringerung der Ausgaben und die Überwindung chronischer funktioneller Schwierigkeiten der Anstalt Sozialer Versicherungen (IKA = Idryma Koinonikon Asfaliseon), der grössten öffentlichen Krankenkasse Griechenlands.“"
                            }
                        ],
