                    }
                ],
                "senses": [
                    {
                        "sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                        "entry_id": "baf55ac6-2cbe-345c-84d7-b9a091fb35c7",
                        "glosses": [
                            "Excès d’information."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1fb8bcb8-6ef5-4939-b5d5-1c186d185887",
                                "sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                                "text": "Cette abondance de mails concourt à alimenter l’infobésité dont nous sommes victimes. Nous sommes, effectivement, face à affluence d’informations instantanées et continues en provenance de différents canaux d’information (radio, internet, téléphone portable, téléphone, médias sociaux, médias traditionnels…) qui deviennent difficiles à hiérarchiser, à prioriser et même à retenir…"
                            },
                            {
                                "example_id": "f5851282-24a6-4896-a587-76e9b8679589",
                                "sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                                "text": "L'abondance même des données numériques sur internet crée une pénurie d'attention, ce qui oblige à allouer cette attention de façon efficace parmi les multiples sources d'information qui pourraient la consommer afin d'éviter l'information overload, sorte d' « infobésité ». — (Gilles Bauche, Tout savoir sur Internet, Éditions Arléa, 1995)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95618e1b-40d1-4afa-8368-f1d5ae2cd9e8",
                        "source_entry_id": "baf55ac6-2cbe-345c-84d7-b9a091fb35c7",
                        "source_sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                        "target_lang_word": "Informationsüberflutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "05b13b04-44c7-4837-8100-6373625b6eea",
                        "source_entry_id": "baf55ac6-2cbe-345c-84d7-b9a091fb35c7",
                        "source_sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                        "target_lang_word": "Informationsflut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Informationsflut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbf468f-2266-3c0c-a65c-c78a196189ae",
                                        "entry_id": "34d1738c-708c-313a-b8f7-ddebc773f967",
                                        "glosses": [
                                            "große Menge an Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e13c3de-29c6-488e-a754-af58de63aaa9",
                                                "sense_id": "dbbf468f-2266-3c0c-a65c-c78a196189ae",
                                                "text": "„›Ich wusste einfach nicht, wie ich mein Bewusstsein gegen die Informationsflut schützen oder abblocken konnte.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "209d4866-9494-4db0-ad78-4c5209523d23",
                        "source_entry_id": "baf55ac6-2cbe-345c-84d7-b9a091fb35c7",
                        "source_sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                        "target_lang_word": "information overload",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "information overload",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b51a4f73-97d2-3b57-8fa1-c4863f7776cb",
                                        "entry_id": "b68443c7-76c0-3227-9ce3-f40abfc7ad84",
                                        "glosses": [
                                            "The inability to process everything one hears and sees; the availability or supply of too much information, or a state of stress which results."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd8093d2-31ff-487a-9179-be3c48f331c4",
                                                "sense_id": "b51a4f73-97d2-3b57-8fa1-c4863f7776cb",
                                                "text": "Some news executives attribute this youthful apathy to information overload and the explosion of media options."
                                            },
                                            {
                                                "example_id": "b9172548-5de7-42b5-a180-1afcf5544ab1",
                                                "sense_id": "b51a4f73-97d2-3b57-8fa1-c4863f7776cb",
                                                "text": "One of the men who has pioneered in information studies, Dr. James G. Miller, director of the Mental Health Research Institute at the University of Michigan, states flatly that “Glutting a person with more information than he can process may . . . lead to disturbance.” He suggests, in fact, that information overload may be related to various forms of mental illness."
                                            },
                                            {
                                                "example_id": "565854f0-ec4c-44d2-b3c3-bc79ad7b6090",
                                                "sense_id": "b51a4f73-97d2-3b57-8fa1-c4863f7776cb",
                                                "text": "But it's often hard to discern the forest for the archaeological trees, partly because archaeology is now so specialized, and also because all of us suffer from information overload about the past dumped on us by the Web, newspapers, TV specials, and all the apparatus of modern global communications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2d7cf76-2935-48a4-8d7f-58f9f8256b73",
                        "source_entry_id": "baf55ac6-2cbe-345c-84d7-b9a091fb35c7",
                        "source_sense_id": "e38d2059-0db7-3de7-affc-6f231a36daa0",
                        "target_lang_word": "infobesity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infobesity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                        "entry_id": "ba3971b0-7a77-37ff-80f2-df67a72d4f42",
                                        "glosses": [
                                            "Synonym of information overload (“the availability or supply of too much information, or a state of stress which results from it”)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c15fc3a-a0d8-401c-99e9-e519e738ddd8",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "[H]ow information professionals can embrace new social networking technologies, and the move from information to knowledge and meaning, as well as the idea of ‘infobesity’."
                                            },
                                            {
                                                "example_id": "e9937976-cb44-4d83-8e44-a1b4a67f1de6",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "We live in an age of infobesity. Information overload. Too much choice. You can't stop it – as even the Chinese are finding – by building virtual walls any more."
                                            },
                                            {
                                                "example_id": "f0c66199-8252-423b-ae5d-c3b515af9b74",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "As [Anthony] Lilley (2008) has suggested, we are living in an age of ‘infobesity’."
                                            },
                                            {
                                                "example_id": "9819be28-9ceb-4608-a3dc-186704d2a9da",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "On the data and information front, he believes we are suffering from infobesity. Too much information causes stress and confusion and makes us do irrational things."
                                            },
                                            {
                                                "example_id": "1a2884fb-1ec7-4436-972f-48b45843b10e",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "This module introduces students to the principles of dematerialization, to the need for perpetual mutation, adaptation and to co-evolution phenomena; to the phenomenon of infobesity, and so on."
                                            },
                                            {
                                                "example_id": "7418f3dd-7187-47a9-92b2-7d2f58053e50",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "Internet users have access to huge amounts of information. Confronted with infobesity, their attention is rare and volatile."
                                            },
                                            {
                                                "example_id": "db9e2372-206a-4a91-9bf3-5e31bf192c64",
                                                "sense_id": "2d0b6e51-db3d-33ad-a3e8-d470ef6908f5",
                                                "text": "As digital platforms continue to grow, it also gives rise to infobesity and the problem of plenty which can undermine the platforms' performance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
