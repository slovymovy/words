                                                "example_id": "d7f070ee-e799-4335-9a7a-4b732012bc14",
                                                "sense_id": "6569f6f0-31b9-37e2-ab17-1f0a79053a2d",
                                                "text": "Heute Abend gehen wir in die Operette."
                                            }
