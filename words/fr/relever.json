                        "relever le gant"
                    ]
                },
                {
                    "sense_id": "98c23c1c-9064-3113-be4e-d62fbd8cf495",
                    "sense_definition": "Prendre note par écrit, collecter ou enregistrer des informations ou des données chiffrées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
