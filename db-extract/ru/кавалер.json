                        ],
                        "form": "кавале́рах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9292dc9e-3d04-371e-9ef2-4c19997e5b45",
                        "entry_id": "0bec33b1-ae59-32e2-a90f-d98647d4bfc2",
                        "glosses": [
                            "мужчина, ухаживающий за женщиной, поклонник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "477483ce-1fb6-48d7-833b-96135ebd59c1",
                                "sense_id": "9292dc9e-3d04-371e-9ef2-4c19997e5b45",
                                "text": "Хороша ты очень. Я бы в тебя влюбилась, если б была кавалером."
                            },
                            {
                                "example_id": "19649e6e-71a3-4c9e-a758-151157ba4419",
                                "sense_id": "9292dc9e-3d04-371e-9ef2-4c19997e5b45",
                                "text": "Подарите мне, приятный кавалер, шесть копеек на выпивку!"
                            },
                            {
                                "example_id": "294de8d4-24f5-4b2c-b56b-60ec2be4150c",
                                "sense_id": "9292dc9e-3d04-371e-9ef2-4c19997e5b45",
                                "text": "Одни только молодые приказные снуют во все классы народа, нахально подмигивают девицам, толкают их под бока и приглашают гулять: «Позвольте, барышня, быть вашим кавалером»."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e134074-3dfe-33ab-8bca-95b0a4ed8e6b",
                        "entry_id": "0bec33b1-ae59-32e2-a90f-d98647d4bfc2",
                        "glosses": [
                            "мужчина, танцующий в паре с дамой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696a9df0-03be-4950-9972-3124a6158727",
                                "sense_id": "8e134074-3dfe-33ab-8bca-95b0a4ed8e6b",
                                "text": "Элен, не имевшая достойного кавалера, сама предложила мазурку Борису."
                            },
                            {
                                "example_id": "e1a7ca56-c631-4828-8bc6-9e10e100880e",
                                "sense_id": "8e134074-3dfe-33ab-8bca-95b0a4ed8e6b",
                                "text": "Иди же, танцуй… вот тебе и кавалер, ― сказала она, указывая на меня."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "093ac68d-90a3-4f09-ae5f-d4585646312c",
                        "source_entry_id": "0bec33b1-ae59-32e2-a90f-d98647d4bfc2",
                        "target_lang_word": "boyfriend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boyfriend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5562109-f6ea-3971-a2d6-58503277703d",
                                        "entry_id": "aa23e6df-39e9-3157-9dd7-b7b96d88cb14",
                                        "glosses": [
                                            "A male partner in an unmarried romantic relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0122d10-ec60-4cb4-a754-7ccbb9fd4ccc",
                                                "sense_id": "e5562109-f6ea-3971-a2d6-58503277703d",
                                                "text": "I was playing the drums and my boyfriend was playing the electric guitar."
                                            },
                                            {
                                                "example_id": "7eac752f-1a59-4540-81da-aa07da208a37",
                                                "sense_id": "e5562109-f6ea-3971-a2d6-58503277703d",
                                                "text": "If I was your boyfriend, I’d never let you go / I can take you places you ain’t never been before."
                                            },
                                            {
                                                "example_id": "f5edb659-984c-487f-aef2-c03d07183a7b",
                                                "sense_id": "e5562109-f6ea-3971-a2d6-58503277703d",
                                                "text": "Referring to someone as your boyfriend or girlfriend suggests several things about your relationship, said Leah Carey, a sex and relationship coach and podcast host of “Good Girls Talk About Sex.”"
                                            },
                                            {
                                                "example_id": "7af2e8b6-993b-48c0-ac8f-dc425db518af",
                                                "sense_id": "e5562109-f6ea-3971-a2d6-58503277703d",
                                                "text": "Whether he’s interested in the latest tech, takes pride in his personal style or loves spending his free time in the gym, these meaningful gifts for boyfriends are sure to win his heart all over again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668612b2-2129-3c4d-8c14-4e303cea7923",
                                        "entry_id": "aa23e6df-39e9-3157-9dd7-b7b96d88cb14",
                                        "glosses": [
                                            "A male friend."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a6cba33-839b-3c5e-b8b4-e6e2397e16ec",
                                        "entry_id": "aa23e6df-39e9-3157-9dd7-b7b96d88cb14",
                                        "glosses": [
                                            "A style of women's clothing that draws heavily from corresponding men's garments.ᵂⁱᵏⁱᵖᵉᵈⁱᵃ"
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b02d16c-6634-4a58-82b9-f81c2a98bed9",
                        "source_entry_id": "0bec33b1-ae59-32e2-a90f-d98647d4bfc2",
                        "target_lang_word": "petit ami",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit ami",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c51047d6-003c-3d9a-8dbc-f6fb09e780ca",
                                        "entry_id": "011db2f5-541c-3b4e-a91a-5916e65b9f9d",
                                        "glosses": [
                                            "Homme avec qui le sujet vit une relation de couple amoureuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c17724ee-d1d9-44db-b673-10f9f6924ea9",
                                                "sense_id": "c51047d6-003c-3d9a-8dbc-f6fb09e780ca",
                                                "text": "On le dit un peu distant, bêcheur, réservé... avec cependant la rumeur qu’il en croquerait à l’occase... qu’avant d’arriver à Glacourt, en centrouse à Poissy, il était le schbeb, je vous traduis, le petit ami, d’un caïd."
                                            },
                                            {
                                                "example_id": "a626a8d7-48e5-4242-8ec2-cbf3ed07f0a4",
                                                "sense_id": "c51047d6-003c-3d9a-8dbc-f6fb09e780ca",
                                                "text": "[…], j’assistais, dans la cour de récréation, au flirt entre filles et garçons, je recevais les confidences de mes amies à propos de leurs petits amis — tiens, tiens, « petits » mais pas « grands », pourtant... — , ça craignait du boudin de ne pas avoir d’amoureux, poil au nœud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
