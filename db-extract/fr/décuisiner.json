                "senses": [
                    {
                        "sense_id": "67285154-2585-3f71-90a6-3bc04bb5e77c",
                        "entry_id": "b2b81ffc-529b-390a-85a1-44d6d74fb24d",
                        "glosses": [
                            "Cesser de cuisiner de façon sophistiquée pour retrouver le goût des ingrédients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a377f0fb-1ccc-4f21-9463-228e505c3fd1",
                                "sense_id": "67285154-2585-3f71-90a6-3bc04bb5e77c",
                                "text": "Hélas ! toutes ces recettes destinées aux blanches fluettes (pas aux grosses) ont peu de chances de réapparaître sur les cartes puisque la mode n’est pas de cuisiner mais de décuisiner."
                            },
                            {
                                "example_id": "32c121b7-dbd6-4094-8347-7185ff3e73d3",
                                "sense_id": "67285154-2585-3f71-90a6-3bc04bb5e77c",
                                "text": "L’ouvrage s’accompagne de façon pratique de dérecettes, moyens de « décuisiner », de récupérer des ingrédients noyés dans des préparations hautement sophistiquées."
                            },
                            {
                                "example_id": "c30a5b6a-b64b-4e5c-8667-97d89eeac03d",
                                "sense_id": "67285154-2585-3f71-90a6-3bc04bb5e77c",
                                "text": "Non non Fush elle cuisine, lui il décuisine, c’est pô pareil"
                            }
                        ]
                    }
