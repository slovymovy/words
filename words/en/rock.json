                            {
                                "target_lang_word": "брюлик",
                                "target_lang_sense_clarification": "сленг для бриллианта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "094c1c2a-5c48-334f-96bf-b650a6657e88",
