                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need an external CD <w>burner</w> because my new laptop doesn't have a disc drive.",
                            "target_lang_translations": {
                                "ru": "Мне нужен внешний <w>пишущий привод</w>, потому что в моем новом ноутбуке нет дисковода."
                            }
                        },
                        {
                            "text": "Back in the day, we used a <w>burner</w> to make custom music mixes for our friends.",
                            "target_lang_translations": {
                                "ru": "Раньше мы использовали <w>резак</w>, чтобы делать собственные музыкальные сборники для друзей."
