                                                "sense_id": "70b6afa2-c597-3df9-b8d6-85948882eb35",
                                                "text": "Wegen des Wetters wurde der Wagen unter den Schauer gefahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
