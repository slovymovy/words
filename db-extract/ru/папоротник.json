                        ]
                    },
                    {
                        "translation_id": "19362021-d0af-4277-8104-b49b8aa1bfa0",
                        "source_entry_id": "40013cb7-1fb7-3772-805b-96f518766a67",
                        "target_lang_word": "Farn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                        "entry_id": "0803c03e-f075-355a-9dfb-aa2056dde2b8",
                                        "glosses": [
                                            "Vertreter einer arten- und formenreichen Gruppe sporenbildender Gefäßpflanzen, oft mit gefiederten Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a00be0a1-3304-4ade-9938-b83d3e41e4c9",
                                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                                "text": "Abgesehen von dem ein oder anderen Farn war der Waldboden nahezu kahl."
                                            },
                                            {
                                                "example_id": "4400d2aa-1329-4dc7-9ea7-da2220448fba",
                                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                                "text": "Farne werden hauptsächlich als Zierpflanzen, aber nur wenig als Heilpflanzen oder als Nahrungsmittel genutzt."
                                            },
                                            {
                                                "example_id": "9f97df91-e697-42ce-8cbb-370fad7e9bc7",
                                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                                "text": "Farne und Moose werden in der Botanik zu den sogenannten Sporenpflanzen oder Kryptogamen zusammengefasst."
                                            },
                                            {
                                                "example_id": "5e55dc2f-9b10-4a18-985e-27d14cc51db0",
                                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                                "text": "„Hohe Farne und Bananenstauden säumen den Weg.“"
                                            },
                                            {
                                                "example_id": "6262b1eb-ad1a-402e-b6f7-5ae91acba9b2",
                                                "sense_id": "2b08fb52-7259-3564-8843-190430453ee4",
                                                "text": "„Sie wohnen in drei Zimmern ohne Gardinen an den Fenstern und haben Palmen, Farne, Zypergras und Bogenhanf und schöne alte Stühle, die aber aus dem Leim sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da7bc02b-a047-4ab2-8e1b-da790032788a",
                        "source_entry_id": "40013cb7-1fb7-3772-805b-96f518766a67",
                        "target_lang_word": "Farnkraut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farnkraut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0a7d237-a7a4-319f-b372-1f6d57f0e1d7",
                                        "entry_id": "abe43236-6439-3579-a646-2068f683ed39",
                                        "glosses": [
                                            "formen- und artenreiche Abteilung der Gefäßsporenpflanzen oder Gefäßkryptogamen, die vorwiegend an schattigen und feuchten Orten wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ac5a42-1797-4529-bc4f-7a8ba6d72fcc",
                                                "sense_id": "a0a7d237-a7a4-319f-b372-1f6d57f0e1d7",
                                                "text": "Farnkräuter werden häufig als Zierpflanzen verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b88c868-299e-484c-bef1-1062b7952887",
                        "source_entry_id": "40013cb7-1fb7-3772-805b-96f518766a67",
                        "target_lang_word": "varen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "varen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e04abdb5-209f-3a53-b229-0b45f10ab3b5",
                                        "entry_id": "c8d6062b-67d2-3fa4-aab7-3ac78f6713a7",
                                        "glosses": [
                                            "zich in een vaartuig voortbewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52581aea-aa41-4d7d-abe7-f55167442f34",
                                                "sense_id": "e04abdb5-209f-3a53-b229-0b45f10ab3b5",
                                                "text": "Het schip vaart de haven uit."
                                            },
                                            {
                                                "example_id": "724bee50-8e9f-46a9-9a92-c466fa0ddf72",
                                                "sense_id": "e04abdb5-209f-3a53-b229-0b45f10ab3b5",
                                                "text": "'Door dat mens van Jans varen er tegenwoordig niet veel dames meer mee, en dat is maar goed ook,' had Nella's vader ooit opgemerkt."
                                            },
                                            {
                                                "example_id": "691b0c91-eccf-400f-9c74-2ec6de35fb90",
                                                "sense_id": "e04abdb5-209f-3a53-b229-0b45f10ab3b5",
                                                "text": "Was hun koning, Willem de Veroveraar, niet tijdens een geweldige storm, dankzij de heilige Nicolaas, veilig van Normandië naar Engeland gevaren? Want Nicolaas was in staat de wind en de onstuimige kracht der golven te doen bedaren!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9588bda-43a5-37f4-8a36-641c4983f0ba",
                                        "entry_id": "c8d6062b-67d2-3fa4-aab7-3ac78f6713a7",
                                        "glosses": [
                                            "zich voortbewegen"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea125453-9232-4808-a949-f6875409c7a9",
                                                "sense_id": "c9588bda-43a5-37f4-8a36-641c4983f0ba",
                                                "text": "Hij voer ten hemel."
                                            },
                                            {
                                                "example_id": "552e033e-e56d-4f5b-ac9f-0d4f5c40d025",
                                                "sense_id": "c9588bda-43a5-37f4-8a36-641c4983f0ba",
                                                "text": "Jan, Jan, Dubbele Jan, waar zijde gij heen gevaren?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "613af9e8-246b-3f16-a107-cc381e87e9e5",
                                        "entry_id": "c8d6062b-67d2-3fa4-aab7-3ac78f6713a7",
                                        "glosses": [
                                            "gezegd van iemands gesteldheid in het algemeen"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50970bbb-4bc4-4e1d-81c9-7d32d2a3e971",
                                                "sense_id": "613af9e8-246b-3f16-a107-cc381e87e9e5",
                                                "text": "Hoe vaart gij nu, mijn kind?"
                                            },
                                            {
                                                "example_id": "2abca97c-e641-45b9-be13-860c96e9987b",
                                                "sense_id": "613af9e8-246b-3f16-a107-cc381e87e9e5",
                                                "text": "Daarnaast varen oudere kinderen intellectueel wel bij het onderwijzen en begeleiden van hun jongere broers of zussen, terwijl hun jongere broertjes of zusjes, juist door die begeleiding, minder worden uitgedaagd om bepaalde problemen zelf op te lossen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25e756bb-ed40-3c1b-8566-41e6734ba729",
                                        "entry_id": "c8d6062b-67d2-3fa4-aab7-3ac78f6713a7",
                                        "glosses": [
                                            "autorijden"
                                        ],
                                        "tags": [
                                            "Limburg"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "varen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "76c3f58e-4b09-355b-ad00-66b27cc8da78",
                                        "entry_id": "1fd8344a-2cb9-3ec6-b6fa-69253f0a7dad",
                                        "glosses": [
                                            "onwennig voorkomen, niet meevallen"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb49e9b0-6435-4068-8b47-846abfb67911",
                                                "sense_id": "76c3f58e-4b09-355b-ad00-66b27cc8da78",
                                                "text": "Het vaarde hem al te zeer; de eerste, dikke waterstraal uit de bronne was uitgeloopen, en weinig versch water uit den schoot der aarde kwam toe om haar te voeden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "varen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e9eda29-97f2-3f63-a6b7-8b63bab205fe",
                                        "entry_id": "e0f2d25a-6d13-3d2d-83c1-c2cf59219e92",
                                        "glosses": [
                                            "Pteridophyta een sporenplant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0a4ee9-8cc6-4cfb-ad37-a9cc1ffb000c",
                                                "sense_id": "2e9eda29-97f2-3f63-a6b7-8b63bab205fe",
                                                "text": "De grond in het bos was bedekt met prachtige varens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae88e479-61ce-4661-bded-94a2b92315fd",
