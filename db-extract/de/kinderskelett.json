                "senses": [
                    {
                        "sense_id": "bc13da09-9b4e-3948-b92b-918d37e8c78a",
                        "entry_id": "a3faf69e-e52f-3b9e-b3b1-75437e08293a",
                        "glosses": [
                            "Skelett eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f766bc98-4d53-4a08-b6ee-52d5f39a4226",
                                "sense_id": "bc13da09-9b4e-3948-b92b-918d37e8c78a",
                                "text": "„Doch es war nicht so sehr das Kinderskelett selbst, was sie beunruhigte, sondern das, was in den Sargdeckel eingeritzt war.“"
                            },
                            {
                                "example_id": "f9345d6a-edac-43b3-b740-581616c421fb",
                                "sense_id": "bc13da09-9b4e-3948-b92b-918d37e8c78a",
                                "text": "„Sie warf einen flüchtigen Blick auf das Bild, an dem der Inhaber momentan arbeitete: ein Skelett mit langen blonden Haaren, das ein Kinderskelett an seine knochige Brust drückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
