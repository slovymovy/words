{
    "word_family": [
        "brutal",
        "brutalité",
        "brutaliser",
        "brutalisation"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7511222d-40e8-3252-9cc7-818832d574b9",
                    "sense_definition": "D'une manière brutale, avec violence ou sans ménagement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent de sécurité a <w>brutalement</w> repoussé la foule en colère.",
                            "target_lang_translations": {
                                "en": "The security guard <w>brutally</w> pushed back the angry crowd.",
                                "ru": "Охранник <w>грубо</w> оттолкнул разгневанную толпу.",
                                "de": "Der Sicherheitsbeamte drängte die aufgebrachte Menge <w>brutal</w> zurück.",
                                "es": "El agente de seguridad empujó <w>brutalmente</w> hacia atrás a la multitud enfurecida.",
                                "zh": "保安<w>粗暴</w>地把愤怒的人群推了回去。"
                            }
                        },
                        {
                            "text": "Il a répondu très <w>brutalement</w> à son collègue sans aucune raison valable.",
                            "target_lang_translations": {
                                "en": "He answered his colleague very <w>harshly</w> without any valid reason.",
                                "ru": "Он очень <w>грубо</w> ответил коллеге без всякой веской причины.",
                                "de": "Er hat seinem Kollegen ohne triftigen Grund sehr <w>grob</w> geantwortet.",
                                "es": "Respondió muy <w>bruscamente</w> a su compañero sin ninguna razón válida.",
                                "zh": "他毫无正当理由，就非常<w>粗暴</w>地回答了同事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "violemment"
                    ],
                    "antonyms": [
                        "doucement"
                    ],
                    "common_phrases": [
                        "repousser brutalement",
                        "réagir brutalement"
                    ],
                    "target_lang_definitions": {
                        "en": "In a brutal way, with violence or without any gentleness.",
                        "ru": "Грубо, с применением силы или без всякой мягкости.",
                        "de": "Auf brutale Weise, mit Gewalt oder ohne jede Rücksicht.",
                        "es": "De manera brutal, con violencia o sin contemplaciones.",
                        "zh": "以粗暴、猛烈或毫不温和的方式进行，常带有暴力色彩。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brutally",
                                "target_lang_sense_clarification": "with cruelty or physical violence"
                            },
                            {
                                "target_lang_word": "violently",
                                "target_lang_sense_clarification": "with force and physical aggression"
                            },
                            {
                                "target_lang_word": "roughly",
                                "target_lang_sense_clarification": "without gentleness or care"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "грубо",
                                "target_lang_sense_clarification": "о речи, обращении, поведении"
                            },
                            {
                                "target_lang_word": "жестоко",
                                "target_lang_sense_clarification": "с жестокостью и насилием"
                            },
                            {
                                "target_lang_word": "насильственно",
                                "target_lang_sense_clarification": "о нападении, принуждении"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "brutal",
                                "target_lang_sense_clarification": "mit roher Gewalt"
                            },
                            {
                                "target_lang_word": "grob",
                                "target_lang_sense_clarification": "im Umgang, Ton oder Verhalten"
                            },
                            {
                                "target_lang_word": "gewaltsam",
                                "target_lang_sense_clarification": "mit körperlicher Gewalt, Zwang"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brutalmente",
                                "target_lang_sense_clarification": "trato cruel o agresión física"
                            },
                            {
                                "target_lang_word": "violentamente",
                                "target_lang_sense_clarification": "ataque o empujón con fuerza"
                            },
                            {
                                "target_lang_word": "groseramente",
                                "target_lang_sense_clarification": "sin delicadeza en el trato"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗暴",
                                "target_lang_sense_clarification": "对人粗鲁，言行或动作蛮横"
                            },
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "力量大，攻击性强"
                            },
                            {
                                "target_lang_word": "狠狠",
                                "target_lang_sense_clarification": "用力重，毫不留情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbcb47b5-96c0-31eb-9cd4-9f5ef5e3e4df",
                    "sense_definition": "De manière soudaine, brusque et inattendue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soudaineté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture devant nous a freiné <w>brutalement</w> pour éviter un obstacle sur la route.",
                            "target_lang_translations": {
                                "en": "The car in front of us braked <w>abruptly</w> to avoid an obstacle on the road.",
                                "ru": "Машина перед нами <w>резко</w> затормозила, чтобы избежать препятствия на дороге.",
                                "de": "Das Auto vor uns bremste <w>abrupt</w> ab, um ein Hindernis auf der Straße zu vermeiden.",
                                "es": "El coche que iba delante de nosotros frenó <w>bruscamente</w> para evitar un obstáculo en la carretera.",
                                "zh": "为了躲开路上的障碍物，我们前面的车<w>猛然</w>刹了车。"
                            }
                        },
                        {
                            "text": "La température a chuté <w>brutalement</w> au cours de la nuit dernière.",
                            "target_lang_translations": {
                                "en": "The temperature dropped <w>sharply</w> last night.",
                                "ru": "Прошлой ночью температура <w>резко</w> упала.",
                                "de": "Die Temperatur ist in der letzten Nacht <w>schlagartig</w> gefallen.",
                                "es": "La temperatura cayó <w>bruscamente</w> durante la noche pasada.",
                                "zh": "昨天夜里气温<w>骤然</w>下降了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brusquement",
                        "soudainement"
                    ],
                    "antonyms": [
                        "progressivement",
                        "lentement"
                    ],
                    "common_phrases": [
                        "freiner brutalement",
                        "chuter brutalement",
                        "s'arrêter brutalement"
                    ],
                    "target_lang_definitions": {
                        "en": "Suddenly, abruptly and without warning.",
                        "ru": "Внезапно, резко и без предупреждения.",
                        "de": "Plötzlich, abrupt und ohne jede Vorwarnung.",
                        "es": "De manera súbita, brusca e inesperada, sin previo aviso.",
                        "zh": "突然发生，出乎意料，事先没有任何预兆。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abruptly",
                                "target_lang_sense_clarification": "sudden, unexpected stop or change"
                            },
                            {
                                "target_lang_word": "suddenly",
                                "target_lang_sense_clarification": "happening without any warning"
                            },
                            {
                                "target_lang_word": "sharply",
                                "target_lang_sense_clarification": "rapid, steep drop or change"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "внезапно",
                                "target_lang_sense_clarification": "неожиданное событие без предупреждения"
                            },
                            {
                                "target_lang_word": "резко",
                                "target_lang_sense_clarification": "о торможении, падении, изменении"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "plötzlich",
                                "target_lang_sense_clarification": "unerwartete Ereignisse oder Wechsel"
                            },
                            {
                                "target_lang_word": "abrupt",
                                "target_lang_sense_clarification": "abruptes Bremsen oder Abbrechen"
                            },
                            {
                                "target_lang_word": "schlagartig",
                                "target_lang_sense_clarification": "rascher Temperatursturz, plötzlicher Wechsel"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "bruscamente",
                                "target_lang_sense_clarification": "frenada o cambio abrupto"
                            },
                            {
                                "target_lang_word": "repentinamente",
                                "target_lang_sense_clarification": "suceso inesperado, sin aviso"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突然",
                                "target_lang_sense_clarification": "事先没有预兆，出乎意料"
                            },
                            {
                                "target_lang_word": "猛然",
                                "target_lang_sense_clarification": "动作急剧，突然发生"
                            },
                            {
                                "target_lang_word": "骤然",
                                "target_lang_sense_clarification": "变化急剧，如气温骤降"
                            }
                        ]
                    }
                }
            ]
        }
