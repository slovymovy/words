                "senses": [
                    {
                        "sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                        "entry_id": "f2041b79-ba95-375f-8125-1e3b2b86d3df",
                        "glosses": [
                            "zamknięta dla niezakonników część klasztoru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2604f3e4-319a-4a5f-91fb-ff53937f4285",
                                "sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                                "text": "Zakony z obowiązującą ścisłą klauzurą nazywane są zakonami klauzurowymi"
                            },
                            {
                                "example_id": "6110b6c6-f645-4cc4-b84d-3eedeee204ac",
                                "sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                                "text": "Dwukondygnacyjny budynek klauzury przylega do kościoła od wschodu oraz południa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0a0cb107-c74d-3c61-9366-63d2c33b5781",
                        "entry_id": "f2041b79-ba95-375f-8125-1e3b2b86d3df",
                        "glosses": [
                            "przepisy regulujące życie wewnątrz klauzury (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd9fd60a-f336-4b8c-b0ee-bc0f9c95243f",
                        "source_entry_id": "f2041b79-ba95-375f-8125-1e3b2b86d3df",
                        "source_sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                        "target_lang_word": "enclosure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enclosure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "151f9826-bb69-368f-8625-c20ccb31d047",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "Something that is enclosed, i.e. inserted into a letter or similar package."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d23d2daa-46a9-49c8-85fe-b378594dc69d",
                                                "sense_id": "151f9826-bb69-368f-8625-c20ccb31d047",
                                                "text": "There was an enclosure with the letter — a photo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b20a430-e32e-3eb1-b490-e34894f09cb3",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The act of enclosing, i.e. the insertion or inclusion of an item in a letter or package."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1513f58d-c82a-49fd-a21e-1aa8a937dff3",
                                                "sense_id": "1b20a430-e32e-3eb1-b490-e34894f09cb3",
                                                "text": "The enclosure of a photo with your letter is appreciated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "An area, domain, or amount of something partially or entirely enclosed by barriers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2648ca-241d-4c2f-a659-acc3925b2807",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "He faced punishment for creating the fenced enclosure in a public park."
                                            },
                                            {
                                                "example_id": "3d122d0c-5725-491f-968a-24e9fc6f7923",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "The glass enclosure holds the mercury vapor."
                                            },
                                            {
                                                "example_id": "5485671a-f98d-421e-b265-a284ba6b2fbf",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "The winning horse was first into the unsaddling enclosure."
                                            },
                                            {
                                                "example_id": "50237a83-5589-46c1-af3e-7bfa9941cdd6",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "And the village was deserted, the huts gaped black, rotting, all askew within the fallen enclosures."
                                            },
                                            {
                                                "example_id": "1ce39b6e-af1d-4e41-8b59-678e385aa01c",
                                                "sense_id": "7768611b-4b0c-3d08-8a18-72e60da4fc5b",
                                                "text": "Away from the village, there was an enclosure containing several large animals of a kind I had not seen before—shaggy, long-necked, small-headed creatures who stood or lay at ease around their pen. Alpacas?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The act of separating and surrounding an area, domain, or amount of something with a barrier."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20dfc6b4-32c6-41e7-9de1-9ae9a0c849e9",
                                                "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                                "text": "The enclosure of public land is against the law."
                                            },
                                            {
                                                "example_id": "183272bd-fc9e-43ea-ada8-c137f3126034",
                                                "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                                "text": "The experiment requires the enclosure of mercury vapor in a glass tube."
                                            },
                                            {
                                                "example_id": "608b35bd-7acf-42cf-a6fa-9ddcb943c00a",
                                                "sense_id": "a6a8ed05-3c46-30c0-9902-cef07c4a4801",
                                                "text": "At first, untrained horses resist enclosure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b09b7577-2a30-3b88-9b4e-fed2961b775c",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The act of restricting access to ideas, works of art or technologies using patents or intellectual property laws."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d8c1a2b-094f-4edf-846d-b8686417df8a",
                                                "sense_id": "b09b7577-2a30-3b88-9b4e-fed2961b775c",
                                                "text": "Copyright, from day one, was designed to be both an impediment and an incentive, a mechanism of enclosure (one that prevented the unlicensed printing of texts, thereby limiting access) and a catalyst of sorts, a structure to stimulate the production of literary goods by rewarding writers and publishers for their labor."
                                            },
                                            {
                                                "example_id": "ca7ed2ba-bf8e-4ddd-9fbf-6356214c9967",
                                                "sense_id": "b09b7577-2a30-3b88-9b4e-fed2961b775c",
                                                "text": "The commons evokes resistance to “enclosure” in all its forms, whether in its early proto-capitalist form of fencing in commonly shared land, or in its contemporary forms of marshalling judicial restraints such as “patent” and “intellectual property” to police the ownership of ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca555879-8ea0-3538-8264-fedaa0632e0d",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The post-feudal process of subdivision of common lands for individual ownership."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15fb7c5-60ac-4e77-acbe-4d82117b64c0",
                                                "sense_id": "ca555879-8ea0-3538-8264-fedaa0632e0d",
                                                "text": "Strip-farming disappeared after enclosure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f045d811-99de-343e-889e-a20adcc1b6f4",
                                        "entry_id": "64044073-e55f-360f-a82c-0343564ede63",
                                        "glosses": [
                                            "The area of a convent, monastery, etc where access is restricted to community members."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e794973-232b-4b0e-8b3d-88ec7670f429",
                        "source_entry_id": "f2041b79-ba95-375f-8125-1e3b2b86d3df",
                        "source_sense_id": "6061e2d2-a5c7-3c41-a68f-162f027c3f43",
                        "target_lang_word": "cloître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "130ccdc2-537b-3b20-a3eb-1bc68274a328",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Partie d’un monastère qu’une clôture sépare du reste du bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcc51c6-36b4-4d31-8c98-b311b485cd06",
                                                "sense_id": "130ccdc2-537b-3b20-a3eb-1bc68274a328",
                                                "text": "Le démon, au contraire, a envoyé dans les cloîtres des monastères la faim et la soif d’entendre les paroles des hommes et les bruits du monde, en sorte qu’occupés d’un vain parlage, nous repoussions d’autant plus la parole divine, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061bad89-be9c-3af3-8fc5-9143fb03f842",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Partie d’un monastère qui est faite en forme de galeries, avec un jardin ou un préau au milieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77eda109-10ea-4d8f-80bc-616946ad3827",
                                                "sense_id": "061bad89-be9c-3af3-8fc5-9143fb03f842",
                                                "text": "Un cloître est fort bien situé auprès d’une église ; il ménage heureusement la transition de la tranquillité du sanctuaire à l’agitation de la cité. On peut aller s’y promener, rêver, réfléchir, sans toutefois être astreint à suivre les prières et les cérémonies du culte ; les catholiques entrent dans le temple, les chrétiens restent plus souvent dans le cloître."
                                            },
                                            {
                                                "example_id": "ad068639-11c5-4319-bf06-272dbe8c87ac",
                                                "sense_id": "061bad89-be9c-3af3-8fc5-9143fb03f842",
                                                "text": "Rien n’est plus noble que ce cloître gothique attenant à la cathédrale Saint-Pierre de Condom."
                                            },
                                            {
                                                "example_id": "a6219257-d5b8-4be5-896e-c9064de898a4",
                                                "sense_id": "061bad89-be9c-3af3-8fc5-9143fb03f842",
                                                "text": "Agadem, qu’il ne faut pas confondre avec Agadès, capitale de l’Aïr, est un ancien fortin abandonné, du type classique à cour intérieure, avec bâtiments donnant sur le puits et arcades en forme de cloître ; le fort est en ruine, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c57580a0-9dfd-33c9-a352-1c7afa1773e1",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Monastère."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4203010b-3e27-46cb-8b1a-b60653f4b634",
                                                "sense_id": "c57580a0-9dfd-33c9-a352-1c7afa1773e1",
                                                "text": "On entre dans un couvent, on se jette dans un cloître : la mortification se pratique dans le cloître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b31f81-d04f-3b92-9b87-fd5499c0c13a",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Enceinte de maisons où logeaient autrefois les chanoines des églises cathédrales ou collégiales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37b6ea1-c601-4dfd-9259-ff40546f6022",
                                                "sense_id": "91b31f81-d04f-3b92-9b87-fd5499c0c13a",
                                                "text": "Le cloître de Notre-Dame ou de Saint-Germain-l'Auxerrois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01548e76-e30d-3421-8c0a-e410f9905553",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Édifice qui entoure une cour fermée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f48b467-803f-4bc6-9dd0-323923191449",
                                                "sense_id": "01548e76-e30d-3421-8c0a-e410f9905553",
                                                "text": "Les marchés d’esclaves les plus importants étaient ceux de Fez et de Marrakech. Je n’ai vu que ce dernier. C’était un préau carré entouré d’un cloître."
                                            }
                                        ]
                                    }
                                ]
