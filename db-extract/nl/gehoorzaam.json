                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a08956-c21d-432a-9157-c73d16c40661",
                                "sense_id": "ce95166a-8004-3e4b-bdf9-cb57f9bb0a8c",
                                "text": "De hond is heel gehoorzaam en luistert altijd naar zijn baas.",
                                "translation": "The dog is very obedient and always listens to its owner.",
                                "english": "The dog is very obedient and always listens to its owner."
                            },
                            {
                                "example_id": "0fdd5166-4814-4866-a0a0-ce783e6a7fd9",
                                "sense_id": "ce95166a-8004-3e4b-bdf9-cb57f9bb0a8c",
                                "text": "Kinderen zijn niet altijd gehoorzaam aan hun ouders.",
                                "translation": "Children are not always obedient to their parents.",
                                "english": "Children are not always obedient to their parents."
                            },
                            {
                                "example_id": "96091e04-d8bc-45cd-ba54-9787d70830df",
                                "sense_id": "ce95166a-8004-3e4b-bdf9-cb57f9bb0a8c",
                                "text": "Van alle leerlingen is zij de gehoorzaamste.",
                                "translation": "Of all the students, she is the most obedient.",
                                "english": "Of all the students, she is the most obedient."
                            }
                        ]
                    }
