                ],
                "senses": [
                    {
                        "sense_id": "84493928-8f46-38c5-af4e-41219e3927cb",
                        "entry_id": "07e1022c-fda4-3d22-918e-84a3cfe418b2",
                        "glosses": [
                            "Arbeitsstätte für Menschen mit Behinderungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc84a86d-ab55-4c26-b6c3-a6e0e4d0016c",
                                "sense_id": "84493928-8f46-38c5-af4e-41219e3927cb",
                                "text": "„In diesem Jahr wurde die Förderwerkstatt mit 26 Plätzen eröffnet.“"
                            },
                            {
                                "example_id": "581cd3c3-ef38-4bef-a4a3-dd6cb04e0820",
                                "sense_id": "84493928-8f46-38c5-af4e-41219e3927cb",
                                "text": "„Die geholzten Bäume werden von Pferden aus dem Wald gezogen und in einem lokalen Sägewerk verarbeitet und in Spandau in der Förderwerkstatt der Stephanus Stiftung schließlich zum fertigen Kiezbett-Bausatz.“"
                            },
                            {
                                "example_id": "1c8ae669-de08-4520-8e0f-447dde0e1e7b",
                                "sense_id": "84493928-8f46-38c5-af4e-41219e3927cb",
                                "text": "„Nicht nur mit der Planung und dem Bau der neuen Förderwerkstatt, wo er maßgeblich beteiligt war, hat sich Peter Aggensteiner ein Denkmal gesetzt.“"
                            },
                            {
                                "example_id": "8294280e-7927-4084-8b54-76e0c3cfd2f0",
                                "sense_id": "84493928-8f46-38c5-af4e-41219e3927cb",
                                "text": "„Es ist früher Nachmittag, bald wird Bernd (Name geändert) in sein Zimmer zurückkommen - nicht aus der Schule, sondern aus der Förderwerkstatt des Wohn- und Pflegeheims Algasing.“"
                            },
                            {
                                "example_id": "890bd3d0-a61b-4a34-8deb-5030049b269c",
                                "sense_id": "84493928-8f46-38c5-af4e-41219e3927cb",
                                "text": "„Nach dem schlimmen Wochenende ist Finn jetzt sehr aufgeregt; auch die Stunden in der Förderwerkstatt haben ihn nicht beruhigen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
