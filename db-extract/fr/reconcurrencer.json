                "senses": [
                    {
                        "sense_id": "d54ac116-4237-3399-8242-f6b448d2c9da",
                        "entry_id": "089e2f02-cd05-38da-8d34-21ff82a33413",
                        "glosses": [
                            "Concurrencer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f14d99f1-e026-44d0-ad8a-5477a86d40ef",
                                "sense_id": "d54ac116-4237-3399-8242-f6b448d2c9da",
                                "text": "Ta rumeur est, pour le moment, fausse, mais les cablo-opérateurs sont en train de modifier leurs offres afin de reconcurrencer la recrudescence de l'ADSL."
                            },
                            {
                                "example_id": "da428d08-c694-4444-a209-994ababac87d",
                                "sense_id": "d54ac116-4237-3399-8242-f6b448d2c9da",
                                "text": "On peut d’ailleurs espérer qu’avec cette nouvelle monoplace, s’ajoutant à la répartition égale circuits/ovales, tout le monde repartira sur de nouvelles bases, permettant aux monoplaces américaines de retrouver tout leur lustre (voire reconcurrencer la F1 ?)."
                            },
                            {
                                "example_id": "117d4314-c1da-48cf-a06f-a7c0ee1c1db4",
                                "sense_id": "d54ac116-4237-3399-8242-f6b448d2c9da",
                                "text": "Apple n'a pas basculé en x86 pour que d'autres espèrent reconcurrencer cette archi."
                            }
                        ]
                    }
                ],
