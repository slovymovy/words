                    {
                        "sense_id": "5b1d4dd6-7f14-3f42-b495-5e18a4a0d1c7",
                        "entry_id": "64e7e4c1-5a7f-3d4e-9b3f-c3c96290133b",
                        "glosses": [
                            "Any ester or salt of acetic acid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056c78d2-e1df-4675-a071-a233a68fa17d",
                                "sense_id": "5b1d4dd6-7f14-3f42-b495-5e18a4a0d1c7",
                                "text": "[…] to pad a piece in diluted acetate of alumine to obtain a pale lemon ground […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b51c31f2-cd66-3113-ad8d-c10666e1be0c",
                        "entry_id": "64e7e4c1-5a7f-3d4e-9b3f-c3c96290133b",
                        "glosses": [
                            "Cellulose acetate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf80091-df3b-4d99-9dfa-07ecb38f2060",
                                "sense_id": "b51c31f2-cd66-3113-ad8d-c10666e1be0c",
                                "text": "Performers use acetate because eyelash glue is not available. They create eyelashes out of horse hair or cut from carbon paper. Their nails are glued on with a shoe adhesive."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc67e509-451b-3823-82af-38abdb6abd22",
                        "entry_id": "64e7e4c1-5a7f-3d4e-9b3f-c3c96290133b",
                        "glosses": [
                            "A transparent sheet used for overlays, whether of cellulose acetate or (loosely) any macroscopically similar plastic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12a9e3d-b42e-49cf-81c8-ac874ab1db07",
                                "sense_id": "dc67e509-451b-3823-82af-38abdb6abd22",
                                "text": "Near-synonym: gel"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6bae66c-b10d-37d1-b505-2acfe019090d",
                        "entry_id": "64e7e4c1-5a7f-3d4e-9b3f-c3c96290133b",
                        "glosses": [
                            "In full acetate disc: a disc of aluminium covered in a wax used to make demonstration copies of a phonograph record."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e368f913-761c-455a-8d9d-46c0384ab660",
                                "sense_id": "e6bae66c-b10d-37d1-b505-2acfe019090d",
                                "text": "Acetates are a relic of the days before cassettes, DAT, and recordable CDs came into widespread use in recording studios. Manufactured from aluminum, and coated in a thin sheet of vinyl, they were produced to allow the concerned parties to hear how a particular version of a recording would sound outside the studio, on their home hi-fi, for example."
                            }
                        ]
                    }
                ],
