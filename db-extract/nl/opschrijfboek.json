                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab42e5eb-d690-43b3-83ae-bd1a906b07b5",
                                "sense_id": "e848210b-b4f6-320c-9716-0550e8128256",
                                "text": "Ook met het gezelschap hier in Delft blijft ze niet lang binnen, er moet water gemeten worden. Fosfaatgehalte, zuurtegraad, welke dieren leven er, wat is de temperatuur– ze heeft een kit met buisjes, kleurenstalen en een opschrijfboekje om de data te noteren."
                            },
                            {
                                "example_id": "154236a0-d0c9-462c-af0f-7c375c103904",
                                "sense_id": "e848210b-b4f6-320c-9716-0550e8128256",
                                "text": "Ik heb een opschrijfboek bij me met een extra pen. Alle uitspraken en wetten waar we aan refereren heb ik voor de zekerheid nog een keer gekopieerd. Ik heb er zin in vandaag."
                            }
                        ]
                    }
