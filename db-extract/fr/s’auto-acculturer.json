                "senses": [
                    {
                        "sense_id": "395178af-c86c-3731-85c3-368e517d5750",
                        "entry_id": "e04eacc3-2b5e-3d5c-a636-6cba873178a2",
                        "glosses": [
                            "S’acculturer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da22028-45e9-49aa-9d48-8a17ba9cfca9",
                                "sense_id": "395178af-c86c-3731-85c3-368e517d5750",
                                "text": "C'est dans les pratiques de tous les jours, selon Balandier (1988), que le social est mouliné, digéré, reproduit, auto-acculturé et que les croyances et les actions s'ordonnent les unes aux autres et parfois aussi se modifient."
                            },
                            {
                                "example_id": "99803d78-9d1f-440c-bb08-d1f25ea82e5a",
                                "sense_id": "395178af-c86c-3731-85c3-368e517d5750",
                                "text": "Peut-il aller jusqu'à « s'auto acculturer « et ressentir un sentiment d'appartenance à un habitus autre que celui initialement sien?"
                            },
                            {
                                "example_id": "22a237cd-f388-4862-8547-547a5e15e166",
                                "sense_id": "395178af-c86c-3731-85c3-368e517d5750",
                                "text": "Le but n'est quand même pas de s'auto acculturer!"
                            }
                        ]
                    }
