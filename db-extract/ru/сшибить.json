                    {
                        "form_id": "a0b2801c-2e9a-42f3-a808-8ba882b87f04",
                        "entry_id": "12079425-021d-3640-a1bd-effb893bcf5a",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "сшиби́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "942131b4-e60d-396a-8352-7d1886c90a16",
                        "entry_id": "12079425-021d-3640-a1bd-effb893bcf5a",
                        "glosses": [
                            "сбить, свалить ударом, толчком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a1900b-faec-4c98-a198-c9384ec342b0",
                                "sense_id": "942131b4-e60d-396a-8352-7d1886c90a16",
                                "text": "Франц, как автомат, выбросил через стол руку, нацелясь на протянутую рюмку, сшиб вазочку с тяжелой, коричневатой розой («которую давно следовало убрать», — подумала Марта), и цвелая вода отвратительным узором растеклась по скатерти."
                            }
                        ]
                    },
                    {
                        "sense_id": "233dc316-6cf7-3b2b-bf7d-15fef701ea95",
                        "entry_id": "12079425-021d-3640-a1bd-effb893bcf5a",
                        "glosses": [
                            "перен. сделать что-нибудь для уничтожения, умаления чего-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c93e1998-c2f6-4bd7-bb8d-ec046821647a",
                                "sense_id": "233dc316-6cf7-3b2b-bf7d-15fef701ea95",
                                "text": "Да гордость-то, гордость-то ему сшибить надо."
                            }
                        ]
                    },
                    {
                        "sense_id": "59476056-dd89-36e9-acc2-bd159557bbef",
                        "entry_id": "12079425-021d-3640-a1bd-effb893bcf5a",
                        "glosses": [
                            "столкнуть вместе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbf29de-29ed-4b33-961e-a3c722c4e8ee",
                                "sense_id": "59476056-dd89-36e9-acc2-bd159557bbef",
                                "text": "Сшибить лбами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7914ca43-7977-4d02-b6c7-6821fbcaaf63",
                        "source_entry_id": "12079425-021d-3640-a1bd-effb893bcf5a",
                        "target_lang_word": "renverser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renverser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f7a5d8c-9462-301d-8527-1e83f1850e46",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Mettre à l’envers ; inverser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab8af0c-b3d6-4a82-9905-38a7fe2e2e39",
                                                "sense_id": "3f7a5d8c-9462-301d-8527-1e83f1850e46",
                                                "text": "Un long baiser rescella leur pacte. Aïssa, lourde de langueur, avait renversé sa tête sur l’épaule de son amant."
                                            },
                                            {
                                                "example_id": "a0049a7e-c2e1-4f77-950a-ddc30d05635b",
                                                "sense_id": "3f7a5d8c-9462-301d-8527-1e83f1850e46",
                                                "text": "L’image d’un objet est renversée sur la rétine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4304340-41db-3de1-a29e-863b0584d00e",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Mettre à l’envers ; inverser.",
                                            "Être à l’envers de la position normale, en parlant d’un organe."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cea1f7eb-ae2e-46c0-b23d-41aaaa78ea74",
                                                "sense_id": "c4304340-41db-3de1-a29e-863b0584d00e",
                                                "text": "Cet organe se renverse, il est renversé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1c3ca6-eebf-3ca0-9545-b01d50273d7a",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Mettre sens dessus dessous."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b3ef31d-1217-42c3-a030-566fab2be8c6",
                                                "sense_id": "5e1c3ca6-eebf-3ca0-9545-b01d50273d7a",
                                                "text": "Il y a des engueulades qui rougissent les yeux, bleuissent les joues, crispent les poings, arrachent les cheveux, cassent les œufs, renversent les éventaires, dépoitraillent les matrones, et me remplissent d'une joie pure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e63b1a-895c-3027-a666-2fcab91aaffe",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Détruire, troubler l’état, l’ordre des choses politiques ou morales."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de50ad3b-3d98-46e7-963c-28c5c7308034",
                                                "sense_id": "e3e63b1a-895c-3027-a666-2fcab91aaffe",
                                                "text": "Grâce à eux, Rome téléguidait une opposition interne au sein des gouvernements qui lui étaient hostiles et les renversait à l’occasion."
                                            },
                                            {
                                                "example_id": "c0c61890-a69d-4f5f-bf57-c75381103f27",
                                                "sense_id": "e3e63b1a-895c-3027-a666-2fcab91aaffe",
                                                "text": "C’est renverser toute la jurisprudence."
                                            },
                                            {
                                                "example_id": "acb32447-86d0-4d72-9f03-cb361b652e7d",
                                                "sense_id": "e3e63b1a-895c-3027-a666-2fcab91aaffe",
                                                "text": "Renverser des projets, des espérances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Mettre à bas, faire tomber une personne, une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4b6744-fba5-4035-9fe3-0e66a9319028",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "Dans la nuit de samedi à dimanche à Albi, une voiture a renversé et tué un piéton"
                                            },
                                            {
                                                "example_id": "2140e451-1f78-4d3d-82eb-3e6ff0eba81e",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "Le 20 septembre 2020, Joop Zoetemelk, le vainqueur du Tour de France 1980, a failli mourir sur son vélo, au carrefour d’une route de Seine-et-Marne, la D 147, à Lizy-sur-Ourcq. Renversé par une voiture, le Néerlandais, alors âgé de 74 ans, est passé par-dessus le véhicule. Mais il a eu le réflexe de protéger sa tête avec ses bras."
                                            },
                                            {
                                                "example_id": "b08c3106-51e9-41c9-823f-e8bb3b16a5a2",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "Aux souffrances que lui causaient ses blessures se mêlait le souvenir de coups donnés et reçus, de coursiers lancés les uns contre les autres, tantôt renversés, tantôt renversant, de cris, de cliquetis d’armes, et de tout le tumulte assourdissant d’une bataille confuse."
                                            },
                                            {
                                                "example_id": "8f1a18fb-3141-48af-9462-5e500203bcfe",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "On était plongé dans cette nuit profonde par la continuation du despotisme jaloux de Charles-Quint et de Philippe II ; on renversa leurs statues, et tout à coup l’on se trouva inondé de lumière."
                                            },
                                            {
                                                "example_id": "36cf6e11-2dfc-4a0a-8d8a-35e78caca30a",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "Les vestiges du culte primitif et du druidisme sont assez rares, grâce au zèle des chrétiens des premiers siècles, qui renversèrent, brisèrent et enfouirent une multitude de pierres-fittes."
                                            },
                                            {
                                                "example_id": "26d9752f-12e2-46c9-83b1-a54cd0e786d8",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "Il est en effet à noter que l’Assemblée européenne ne peut pas être dissoute ; mais qu’en revanche cette dernière doit accorder sa confiance aux membres de la Commission européenne, et peut également la renverser en cours de mandat."
                                            },
                                            {
                                                "example_id": "e49e3821-850a-41d2-813c-dc0b759ad559",
                                                "sense_id": "bc04caae-5c27-38ab-8ffe-db9ab9f7fa93",
                                                "text": "Renverser un ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f84f864-330a-3845-bffe-5550eaea3896",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Mettre à bas, faire tomber une personne, une chose.",
                                            "Défaire, mettre en déroute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6341eec7-eab0-477d-b5de-ba50f66e7d8d",
                                                "sense_id": "6f84f864-330a-3845-bffe-5550eaea3896",
                                                "text": "Notre aile droite renversa l’aile gauche des ennemis."
                                            },
                                            {
                                                "example_id": "3a2ed403-933c-4b1d-acdd-18602ea02427",
                                                "sense_id": "6f84f864-330a-3845-bffe-5550eaea3896",
                                                "text": "Nos troupes ont renversé tout ce qui s’est présenté devant elles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1115fb-aa2c-3b06-995f-b6b3d3422c5c",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Mettre à bas, faire tomber une personne, une chose.",
                                            "Pousser un corps de troupes de manière qu’en reculant il mette le désordre dans un autre et qu’il l’entraîne dans sa déroute."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9fd071-1ab8-4204-bd5f-264d44d23982",
                                                "sense_id": "0a1115fb-aa2c-3b06-995f-b6b3d3422c5c",
                                                "text": "La première ligne fut renversée sur la seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79290e97-6db7-3ea5-baf1-4f55e0b9c70b",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Causer un trouble extrême, bouleverser."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a387ea2-c28d-4953-b918-3e69d4814a88",
                                                "sense_id": "79290e97-6db7-3ea5-baf1-4f55e0b9c70b",
                                                "text": "Cet événement le renversa."
                                            },
                                            {
                                                "example_id": "d2b0a295-02eb-4fa4-bedb-f1feec92d4da",
                                                "sense_id": "79290e97-6db7-3ea5-baf1-4f55e0b9c70b",
                                                "text": "Ce que vous me dites là me renverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ebbf57-8d3a-34ac-b937-ed9dd7b472e0",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Transposer, réaliser une inversion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b33beb9-e733-4f99-a971-440ddb323b6f",
                                                "sense_id": "c4ebbf57-8d3a-34ac-b937-ed9dd7b472e0",
                                                "text": "Renverser un accord."
                                            },
                                            {
                                                "example_id": "d7a21eb0-635f-45c9-a860-57c80f81dd13",
                                                "sense_id": "c4ebbf57-8d3a-34ac-b937-ed9dd7b472e0",
                                                "text": "Renverser les termes d’une traction, d’un rapport."
                                            },
                                            {
                                                "example_id": "b0c369bd-c366-4e3a-9a94-0dc634e648e1",
                                                "sense_id": "c4ebbf57-8d3a-34ac-b937-ed9dd7b472e0",
                                                "text": "Renverser les termes d’une proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40d324b1-9d4f-3aeb-962c-85e2d36ae82f",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Se mettre, se coucher sur le dos."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2e22966-8f80-3bb6-b4c0-cc77bcb229b4",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Se pencher fortement en arrière."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51fcf7d3-35f9-42ad-8887-ae5f68785c56",
                                                "sense_id": "f2e22966-8f80-3bb6-b4c0-cc77bcb229b4",
                                                "text": "Elle alluma une cigarette, croisa les jambes et se renversa, languissante, dans son fauteuil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793552d7-58c3-3c13-b791-cdac21419727",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "S’écrouler."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5719471-b81a-456c-b851-4f3eb0f5af1d",
                                                "sense_id": "793552d7-58c3-3c13-b791-cdac21419727",
                                                "text": "Si un édifice se renverse, n’essayez pas de le maintenir debout en jetant sur les murs une couche de ciment, mais empêchez-le de s’écrouler en renforçant la base."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f56b3ed8-8a0c-3f51-9728-da8d1bba7760",
                                        "entry_id": "9440d094-e90e-3847-a6e1-3969fba0257e",
                                        "glosses": [
                                            "Vomir."
                                        ],
                                        "tags": [
                                            "Anjou"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c62804e-2b46-4bd8-8935-e09f3fc12d22",
                                                "sense_id": "f56b3ed8-8a0c-3f51-9728-da8d1bba7760",
                                                "text": "J'ai eu mal au ventre toute la nuit et, ce matin, j'ai renversé avant de venir au bureau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
