                        "sense_id": "7ca4d9f9-1472-3862-9f88-0c9a49c49c78",
                        "entry_id": "f8cdafad-09f0-3989-b842-62938a084d9f",
                        "glosses": [
                            "Punkt auf der Umlaufbahn eines Doppelstern-Partners, auf dem dieser von seinem Begleiter am weitesten entfernt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0886726-5347-4bd9-83bc-82bd66eea010",
                                "sense_id": "7ca4d9f9-1472-3862-9f88-0c9a49c49c78",
                                "text": "„Die so gefundenen Verteilungsellipsoide hatten folgende Eigenschaften: a) Die großen Achsen der Bahnen, und zwar die Apastren sind bevorzugt zum galaktischen Zentrum gerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
