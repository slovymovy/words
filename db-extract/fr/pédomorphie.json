                        "glosses": [
                            "Fait de conserver des caractéristiques physiologiques juvéniles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b73fff-3b0d-44c8-8f43-2e22022070fc",
                                "sense_id": "a8bb4651-7c07-3abb-8f72-0ee7b27aa976",
                                "text": "La néoténie se distingue de la « pédomorphie », qui est la persistance des caractères infantiles, ou embryonnaires, chez l’adulte."
                            }
                        ]
                    }
                ],
                "translations": [
