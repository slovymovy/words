                "senses": [
                    {
                        "sense_id": "540dbb3d-9a9b-318e-9526-b3f3f54409b3",
                        "entry_id": "9356191b-c10c-3123-88ce-7ba97914c236",
                        "glosses": [
                            "Donner un caractère sorabe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb26a8aa-2bef-40a2-a554-70c85ffb947a",
                                "sense_id": "540dbb3d-9a9b-318e-9526-b3f3f54409b3",
                                "text": "Frido Mětšk écrit une page de l’histoire des relations culturelles entre Lusace et Lituanie, touchant le poème Gais yr’ tylējims (Die Rest ist Schweigen) de Georg Sauerwein (qui sorabisait son nom en Juro Surowin et le lituanisait en Girēnas), mis en musique par K. A. Kocor (ZslPh, XXX1, p. 300-315)."
                            },
                            {
                                "example_id": "c9c7d1b5-5993-4db9-8e6a-b3f0b504c975",
                                "sense_id": "540dbb3d-9a9b-318e-9526-b3f3f54409b3",
                                "text": "Le quotidien doit en effet presque chaque jour sorabiser les mots nouveaux qui apparaissent en politique et dans la vie de la société et les diffuser en direction de la population."
                            }
                        ]
                    }
