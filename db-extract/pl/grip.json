                "senses": [
                    {
                        "sense_id": "05acbfd1-8bfd-38ac-b526-fcb81052c9f2",
                        "entry_id": "031ff4a5-eb3a-3711-81cc-246d3dabfaa7",
                        "glosses": [
                            "dodatkowy uchwyt przymocowany do spodniej części aparatu fotograficznego, ułatwiający stabilne trzymanie go w pionie, posiadający zestaw najważniejszych przycisków sterujących, pozwalający także na zamontowanie dodatkowych baterii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9253d92-993d-4934-a7d4-e78ac35f4838",
                                "sense_id": "05acbfd1-8bfd-38ac-b526-fcb81052c9f2",
                                "text": "Jeśli się robi dużo pionowych fotek, to grip się przydaje"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04498ee4-dc68-44c8-8d95-fb74745eb3b0",
                        "source_entry_id": "031ff4a5-eb3a-3711-81cc-246d3dabfaa7",
                        "source_sense_id": "05acbfd1-8bfd-38ac-b526-fcb81052c9f2",
                        "target_lang_word": "grip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                                        "entry_id": "cd8cb26e-b7d8-33c0-b396-689569ba31e9",
                                        "glosses": [
                                            "To take hold (of), particularly with the hand."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "480666cf-0568-4787-855b-3577c4dd2ea2",
                                                "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                                                "text": "That suitcase is heavy, so grip the handle firmly."
                                            },
                                            {
                                                "example_id": "90d3cae2-8dda-4e99-a7a6-cbee2f0745fb",
                                                "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                                                "text": "Unfortunately the glue didn't grip, and the whole thing came apart."
                                            },
                                            {
                                                "example_id": "4f395ad2-5069-48ed-82d0-9c7e316765f5",
                                                "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                                                "text": "After a few slips, the tires gripped the pavement."
                                            },
                                            {
                                                "example_id": "3da91809-1a08-439d-9eae-53ad9799617a",
                                                "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                                                "text": "\"Grip tightly on the rope!\" — \"I'm gripping! I'm gripping!\""
                                            },
                                            {
                                                "example_id": "52379874-dec8-4393-9a25-4cccada1d6f4",
                                                "sense_id": "c71afc9b-7ccc-3946-b930-b0d287efa0b0",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31275b83-b49f-3850-9ec3-820755ef0e75",
                                        "entry_id": "cd8cb26e-b7d8-33c0-b396-689569ba31e9",
                                        "glosses": [
                                            "To figuratively take hold of or grasp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6436a02f-c3d6-424b-b106-941ca75ff592",
                                                "sense_id": "31275b83-b49f-3850-9ec3-820755ef0e75",
                                                "text": "We need to grip this problem, not shut our eyes and hope it goes away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a97818-8eb7-3fd2-810d-8e2721db811e",
                                        "entry_id": "cd8cb26e-b7d8-33c0-b396-689569ba31e9",
                                        "glosses": [
                                            "Of an emotion or situation: to have a strong effect upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7811d3db-e581-4a3f-8752-be3ae17ff591",
                                                "sense_id": "18a97818-8eb7-3fd2-810d-8e2721db811e",
                                                "text": "As the water level began to rise, I was gripped by panic."
                                            },
                                            {
                                                "example_id": "001b316a-138a-4e33-9467-ecccccc4f2b1",
                                                "sense_id": "18a97818-8eb7-3fd2-810d-8e2721db811e",
                                                "text": "[…] I lost something of the stifling fear that had gripped me, and could listen with more ease to what was going forward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ecde3f-2de3-30c8-9b50-00861bd1b021",
                                        "entry_id": "cd8cb26e-b7d8-33c0-b396-689569ba31e9",
                                        "glosses": [
                                            "To firmly hold the attention of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e6a030-6843-448b-92d2-2fc3fff0ddd1",
                                                "sense_id": "31ecde3f-2de3-30c8-9b50-00861bd1b021",
                                                "text": "The movie gripped me from beginning to end."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b8be9e0-c553-30d9-9519-8ff9a567c8f6",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A hold or way of holding, particularly with the hand."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6d5ddac-a9a8-408d-b21b-accf77258198",
                                                "sense_id": "0b8be9e0-c553-30d9-9519-8ff9a567c8f6",
                                                "text": "It's good to have a firm grip when shaking hands."
                                            },
                                            {
                                                "example_id": "366f3968-9f20-4e77-9cd8-3dd60fa4fc36",
                                                "sense_id": "0b8be9e0-c553-30d9-9519-8ff9a567c8f6",
                                                "text": "The ball will move differently depending on the grip used when throwing it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853e8838-8b55-3b10-8120-958e160238f3",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "Ability to resist slippage when pressed in contact with another object or surface."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec9c03b-2de6-4837-8c07-ef59a2e46735",
                                                "sense_id": "853e8838-8b55-3b10-8120-958e160238f3",
                                                "text": "These tyres are worn out and don't have much grip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abbec2e4-b9c3-313b-b1dc-63b266b11b92",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A place to grip; a handle; the portion of a handle that the hand occupies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1998b9d6-1789-4a88-bd1a-96cd5a41db1a",
                                                "sense_id": "abbec2e4-b9c3-313b-b1dc-63b266b11b92",
                                                "text": "Near-synonym: handgrip"
                                            },
                                            {
                                                "example_id": "daa4fc2c-aed4-4d14-8718-a5c1730b5176",
                                                "sense_id": "abbec2e4-b9c3-313b-b1dc-63b266b11b92",
                                                "text": "There are several good grips on the northern face of this rock."
                                            },
                                            {
                                                "example_id": "791efa19-afc3-4f0b-8320-14c6ed7981da",
                                                "sense_id": "abbec2e4-b9c3-313b-b1dc-63b266b11b92",
                                                "text": "The grip of a sword is part of its hilt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a9d210-0174-365e-bb29-aae0ce9add0b",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A device, or a portion of one, that grasps or holds fast to something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40da890a-e61a-4758-ba64-3f9f0d7375cb",
                                                "sense_id": "08a9d210-0174-365e-bb29-aae0ce9add0b",
                                                "text": "The unthreaded portion of the bolt's shank is called the grip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "560ef092-3551-39ca-9446-a4f881a047df",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A device, or a portion of one, that grasps or holds fast to something.",
                                            "An apparatus attached to a car (e.g., cable car, funicular car, mine car) for clutching a traction cable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f24ba4fb-9c61-313d-b6b9-8a68da0ebcd2",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "Assistance; help; encouragement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f66f6f7b-3207-4078-90e1-7a5bef2a1ee1",
                                                "sense_id": "f24ba4fb-9c61-313d-b6b9-8a68da0ebcd2",
                                                "text": "He gave me a grip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0978869-c0e1-380c-81fe-73b0a74f696b",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "Someone who is helpful, interesting, admirable, or inspiring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ef93dc6-bb48-49e8-ac3e-c077917daaa3",
                                                "sense_id": "e0978869-c0e1-380c-81fe-73b0a74f696b",
                                                "text": "You're a real grip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "Control, power, or mastery over someone or something; a tenacious grasp; a holding fast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71cbbc3d-c2c7-4266-9396-22af2afe80d2",
                                                "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            },
                                            {
                                                "example_id": "e7471320-5093-4838-a381-8b0b538bfa0c",
                                                "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                                "text": "The current president toppled his uncle in a violent coup in 1979, before sentencing him to death by firing squad. Since then, he has consolidated his grip over the country's industries and is accused of diverting tax money into his personal accounts."
                                            },
                                            {
                                                "example_id": "1d567edb-e2a1-43b6-bb7a-f0272434256c",
                                                "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                                "text": "We need to get a grip on these spiralling costs."
                                            },
                                            {
                                                "example_id": "b3b37e98-7bba-4dc4-a64f-ee6f794608b9",
                                                "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                                "text": "in the grip of a blackmailer"
                                            },
                                            {
                                                "example_id": "1e893ea1-76e0-4176-9f63-4cb2fe5e58f6",
                                                "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                                "text": "to strengthen one's grip on a company"
                                            },
                                            {
                                                "example_id": "767c810c-0770-4c66-b88a-42a0a8348bc3",
                                                "sense_id": "0246e586-5523-3a99-9f6e-4196033c31e5",
                                                "text": "Instead England produced something that felt a little transgressive in this most controlled of stages, tightening their grip in a bruising first half, before freewheeling downhill in the second with their feet up on the handlebars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938dc31c-9cef-3eb4-a176-12bef128d01b",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "Mental grasp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bae35b3-90c2-4a94-97a8-aa903bdc4037",
                                                "sense_id": "938dc31c-9cef-3eb4-a176-12bef128d01b",
                                                "text": "He's losing his grip – he's practically senile."
                                            },
                                            {
                                                "example_id": "830bdffa-8004-47ea-8058-edf7abe825cc",
                                                "sense_id": "938dc31c-9cef-3eb4-a176-12bef128d01b",
                                                "text": "For God's sake man, stop panicking and get a grip of yourself!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc51a7c6-eed5-33e1-97b3-4a6e967eaa3a",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A medium-sized bag or holdall for one's belongings, made of soft leather, canvas etc., and carried in the hand by two handles, one either side of the opening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e563fb0-9892-377c-9f3c-38a4173cff1a",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A visual component on a window etc. enabling it to be resized and/or moved by dragging with a mouse or finger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "576cffc8-bc41-3d59-ae96-e6d5908f4c86",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A person responsible for handling equipment on the set."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47918805-c98b-31e5-b597-957035aaa3d7",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "As much as one can hold in a hand; a handful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a119344-cbc1-49d3-a885-bafcdf6370d0",
                                                "sense_id": "47918805-c98b-31e5-b597-957035aaa3d7",
                                                "text": "I need to get a grip of nails for my project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f56ed7-eef2-3006-86cc-b09619e59b0e",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A lot of something."
                                        ],
                                        "tags": [
                                            "California",
                                            "Southern",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be054968-f436-4cc4-9fce-8e4891444740",
                                                "sense_id": "25f56ed7-eef2-3006-86cc-b09619e59b0e",
                                                "text": "That is a grip of cheese."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e6f803-1688-37f0-a1f1-046b21a49546",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A long time."
                                        ],
                                        "tags": [
                                            "California",
                                            "Southern",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47ef0f4-9335-41a8-8c6a-fd1b5572dbef",
                                                "sense_id": "a1e6f803-1688-37f0-a1f1-046b21a49546",
                                                "text": "I haven't seen you in a grip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ae7cd4-e425-3a9e-b751-33fdde1a70b3",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "Archaic spelling of grippe (“influenza”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f988b4d-c0df-422f-b56b-346cec8b93be",
                                                "sense_id": "70ae7cd4-e425-3a9e-b751-33fdde1a70b3",
                                                "text": "She has the grip."
                                            },
                                            {
                                                "example_id": "bade2a5b-b455-448c-a02b-70b5044f54d2",
                                                "sense_id": "70ae7cd4-e425-3a9e-b751-33fdde1a70b3",
                                                "text": "It so happened that, during a stretch of inclement weather in the fall, Lester was seized with a mild form of grip. When he felt the first symptoms he thought that his indisposition would be a matter of short duration, and tried to overcome it by taking a hot bath and a liberal dose of quinine. But the infection was stronger than he counted on; by morning he was flat on his back, with a severe fever and a splitting headache."
                                            },
                                            {
                                                "example_id": "c6319a19-d414-4678-adb4-5cb898704341",
                                                "sense_id": "70ae7cd4-e425-3a9e-b751-33fdde1a70b3",
                                                "text": "Grip! Grip!! The little touch of grip you had is no excuse for following the example of some of our \"best citizens\" who make every little ailment a pretext for dallying with the \"demon\"!!!!!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0b2554-fff5-3d7d-a3eb-c94000fd780d",
                                        "entry_id": "02796795-6d8b-3876-884a-8fd300f32b29",
                                        "glosses": [
                                            "A small travelling-bag or gripsack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e69972a-1aff-4e8d-b011-620cb20d5d61",
                                                "sense_id": "5c0b2554-fff5-3d7d-a3eb-c94000fd780d",
                                                "text": "'I put my grips against the communicating door last night'."
                                            }
                                        ]
                                    }
                                ]
                            },
