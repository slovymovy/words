                        "source_sense_id": "0ec2cd10-4577-374e-b2fd-ce23c201a7da",
                        "source_sense_description": "treat badly",
                        "target_lang_word": "mishandelen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mishandelen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "23a598b8-24e4-3308-b7f6-e137765efd33",
                                        "entry_id": "dbe2916c-6c37-3c24-a4ae-e0be2b1292f3",
                                        "glosses": [
                                            "iemand slecht behandelen en pijn doen of verwonden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67763c8b-3344-4864-bf2f-4707167bc7c4",
                                                "sense_id": "23a598b8-24e4-3308-b7f6-e137765efd33",
                                                "text": "Omdat hij eind februari een vierjarig meisje heeft mishandeld werd een Drachtster (24) donderdag door de Leeuwarder rechtbank veroordeeld tot een celstraf van acht maanden."
                                            },
                                            {
                                                "example_id": "6541e50b-888f-42c6-9671-4dc4f07772eb",
                                                "sense_id": "23a598b8-24e4-3308-b7f6-e137765efd33",
                                                "text": "Een vrouw uit Kansas vertrouwde me toe dat ze de benen had genomen na mishandeld te zijn in haar huwelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aacfd70-17d8-401d-9470-665f6700ad46",
                        "source_entry_id": "1eac6408-3b6c-3b31-a097-f10c19ea680b",
                        "source_sense_id": "0ec2cd10-4577-374e-b2fd-ce23c201a7da",
                        "source_sense_description": "treat badly",
                        "target_lang_word": "misshandeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misshandeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                        "entry_id": "eea974f1-6a87-3048-b5b4-2616420e1a40",
                                        "glosses": [
                                            "jemanden mutwillig seelisch oder körperlich heftig verletzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e14a2867-f490-4912-b03e-baff25a5ffa0",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "„Jeder kann in Ägypten ohne Grund verhaftet, misshandelt und beliebig lange hinter Gitter kommen.“"
                                            },
                                            {
                                                "example_id": "032166ce-ff76-41d2-9edd-a180c4c7265f",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "„Die beiden Pflegeeltern der toten Anna aus Bad Honnef haben gestanden, die Neunjährige misshandelt zu haben - als \"Erziehungsmaßnahme\".“"
                                            },
                                            {
                                                "example_id": "f2cb8d11-4d7f-46be-be7c-74db20433559",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "Doch auch angenommen, der Bauer hätte das Opossum über der That ertappt? dann spornt ihn sein Aerger an, das arme Thier mit Fußtritten zu mißhandeln."
                                            },
                                            {
                                                "example_id": "e354bd90-ac48-48cb-b206-005da0815472",
                                                "sense_id": "826845de-a45c-382f-8a50-7c93275a0f23",
                                                "text": "„Er stellte sicher - oder auch nicht -, dass der Schiffsarzt seine Pflicht tat und dass Matrosen und Offiziere die Gefangenen nicht misshandelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
