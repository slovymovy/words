{
    "word_family": [
        "curtsey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be159fa3-44d8-328b-b572-c9b69e35db5f",
                    "sense_definition": "A gesture of respect made by bending the knees and lowering the body, typically performed by women or girls.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young girl performed a graceful <w>curtsy</w> before the queen.",
                            "target_lang_translations": {
                                "ru": "Юная девушка сделала изящный <w>реверанс</w> перед королевой."
                            }
                        },
                        {
                            "text": "She gave a quick <w>curtsy</w> and left the stage after her performance.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>сделала реверанс</w> и ушла со сцены после своего выступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "bow"
                    ],
                    "common_phrases": [
                        "make a curtsy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жест вежливости, совершаемый путем сгибания коленей и приседания, традиционно исполняемый женщинами или девочками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реверанс",
                                "target_lang_sense_clarification": "традиционный женский поклон с приседанием"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19bd9b94-0914-3ec5-bdbb-5bafb0aafb1d",
                    "sense_definition": "To perform a gesture of respect by bending the knees and lowering the body.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers <w>curtsied</w> to the audience at the end of the show.",
                            "target_lang_translations": {
                                "ru": "Танцоры <w>сделали реверанс</w> зрителям в конце шоу."
                            }
                        },
                        {
                            "text": "She <w>curtsied</w> politely when she was introduced to the guests.",
                            "target_lang_translations": {
                                "ru": "Она вежливо <w>сделала реверанс</w>, когда ее представили гостям."
                            }
                        }
                    ],
                    "synonyms": [
                        "bow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять жест вежливости, сгибая колени и приседая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать реверанс",
                                "target_lang_sense_clarification": "совершать поклон с приседанием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}