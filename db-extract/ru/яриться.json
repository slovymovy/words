                "senses": [
                    {
                        "sense_id": "220e8eb9-3b13-3ddc-8449-3927ec959420",
                        "entry_id": "86beb870-3819-3ff6-8387-71c6e4dd641a",
                        "glosses": [
                            "быть в состоянии ярости, сильного гнева, горячиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae4cc02-9e71-4a50-9056-c35ba915732e",
                                "sense_id": "220e8eb9-3b13-3ddc-8449-3927ec959420",
                                "text": "Пёс прыгал и ярился."
                            },
                            {
                                "example_id": "6191fea7-2cad-4519-ac8f-fd613876b280",
                                "sense_id": "220e8eb9-3b13-3ddc-8449-3927ec959420",
                                "text": "Представляю, как ярился отец, понимая, что не вышло по его воле."
                            }
                        ]
                    },
                    {
                        "sense_id": "d70c3300-485c-3cda-b5b9-e9279695239f",
                        "entry_id": "86beb870-3819-3ff6-8387-71c6e4dd641a",
                        "glosses": [
                            "поэт., перен. бушевать (о стихиях, битве), протекать бурно, неудержимо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4648827-1d73-45fb-bb4b-c3b0ea317c7e",
                                "sense_id": "d70c3300-485c-3cda-b5b9-e9279695239f",
                                "text": "Ярится бой."
                            },
                            {
                                "example_id": "38f61e66-b822-4114-9dc5-c09ddfc40213",
                                "sense_id": "d70c3300-485c-3cda-b5b9-e9279695239f",
                                "text": "Вчера, встревоженное ветром, ярилось море, а сегодня оно только зыбилось."
                            },
                            {
                                "example_id": "78d6bdec-cb81-4e38-a8b6-1d297c214c66",
                                "sense_id": "d70c3300-485c-3cda-b5b9-e9279695239f",
                                "text": "Тьма пускай еще ярится! День взойдет могуч."
                            }
                        ]
                    }
                ],
