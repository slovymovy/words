                        "target_lang_word": "Cervelat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cervelat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0438418b-72e6-351f-a231-b9e536740768",
                                        "entry_id": "90022dc6-7ecc-3da7-ab3e-e11da1c51d32",
                                        "glosses": [
                                            "aus Rindfleisch bestehende Brühwurst, in der Speck und Schwarten enthalten sind"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45eb2e4e-e958-46f1-b525-afa464396946",
                                                "sense_id": "0438418b-72e6-351f-a231-b9e536740768",
                                                "text": "„Der Cervelat ist die schweizerischste aller Würste.“"
                                            },
                                            {
                                                "example_id": "54930fde-e12e-4a07-99ce-1ea9d5628e96",
                                                "sense_id": "0438418b-72e6-351f-a231-b9e536740768",
                                                "text": "„Die wahren inneren Werte des Cervelats sind ein Gemisch aus Schweine- und Rindfleisch, aus Pfeffer, Pökelsalz und Gewürzen – die Zusammensetzung der Letztgenannten bleibt ein gut gehütetes Geheimnis der Metzger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b3f6c93-ddfa-469e-93d7-67a4f62c0670",
                        "source_entry_id": "d67e364a-f538-304b-b8dc-a118e6d51de8",
                        "source_sense_id": "efb1c6c9-292d-3334-89f5-ae9f5f0c7f5b",
                        "target_lang_word": "Zervelatwurst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zervelatwurst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01f63ef6-146b-3fe8-b922-6e24d0a238ea",
                                        "entry_id": "be183edf-1a3d-3110-a73a-ff4ae5b65ba0",
                                        "glosses": [
                                            "eine schnittfeste Rohwurst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe2a0b7-3bbf-4610-99c0-afe8f3b04096",
                                                "sense_id": "01f63ef6-146b-3fe8-b922-6e24d0a238ea",
                                                "text": "„Typische schnittfeste Rohwürste sind die länger gereiften, harten Dauerwürste wie Ahle Wurst, Chorizo, Landjäger, Salami, Walliser Trockenwurst und Zervelatwurst.“"
                                            },
                                            {
                                                "example_id": "bbd5970b-b759-4cde-9af1-b10839707e36",
                                                "sense_id": "01f63ef6-146b-3fe8-b922-6e24d0a238ea",
                                                "text": "„Ein Teller mit Zervelatwurst klatschte neben uns auf den Boden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
