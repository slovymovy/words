                        "cross_references": [
                            {
                                "target_word": "Januswort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad223ade-c6b5-338c-9952-eea4253b2471",
                                        "entry_id": "b2b1efc1-e81b-3537-a183-d49898b753aa",
                                        "glosses": [
                                            "Wort, das gegensätzliche Bedeutungen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276c415a-14e4-4f60-b3ad-94814fb9f9cd",
                                                "sense_id": "ad223ade-c6b5-338c-9952-eea4253b2471",
                                                "text": "„Dieser Bedeutungsumschlag macht frugal zum Januswort.“"
                                            },
                                            {
                                                "example_id": "e78107b4-8146-427c-a593-9c510196e3cd",
                                                "sense_id": "ad223ade-c6b5-338c-9952-eea4253b2471",
                                                "text": "„Wie wir gesehen haben, ist „sollen\" Hare zufolge ein sogenanntes Januswort.“"
                                            },
                                            {
                                                "example_id": "8a09fd02-e827-4bdb-857a-d03e734d7df9",
                                                "sense_id": "ad223ade-c6b5-338c-9952-eea4253b2471",
                                                "text": "Ein weiteres Januswort ist »Sanktion«, das »Androhung, Ausführung einer Strafmaßnahme«, aber auch »Billigung, Bestätigung« bedeuten kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33d2ea7a-d37d-47f7-95d5-76e70f894b69",
                        "source_entry_id": "273253a6-a90c-3495-aeee-fe72881ce05c",
                        "source_sense_id": "d84d0527-21cf-30e4-970c-87265ff49397",
