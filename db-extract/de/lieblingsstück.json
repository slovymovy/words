                "senses": [
                    {
                        "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                        "entry_id": "602821d9-4a10-362b-af74-bcc3e5651d96",
                        "glosses": [
                            "Komposition/Lied/Werk, das eine Person besonders mag"
                        ],
                        "tags": [
                            "Musik",
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "69c6bcba-0b87-4896-8829-327bdd82c9d4",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Als Erwachsener ist heute die Tannhäuser-Ouvertüre eines meiner Lieblingsstücke.“"
                            },
                            {
                                "example_id": "7df15abc-0b64-4d20-8660-72eb367924b5",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "[Abschied von Tugce Albayrak:] „Auf einem Klavier spielte ein Musiker die Lieblingsstücke von Tugce.“"
                            },
                            {
                                "example_id": "4715a2b2-ca68-4f21-beb0-470fec7156a7",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Abschied von Max Greger“ - […] „Die Familie hat zudem Lieblingsstücke Gregers ausgesucht, darunter \"Unforgettable\" von Nat \"King\" Cole, \"Stardust\", gespielt von Max Greger und seinem Sohn Max Greger junior sowie \"What a wonderful world\", gespielt von Enkel Maximilian.“"
                            },
                            {
                                "example_id": "e4f391f7-3233-4776-9f0e-d9ecfb0749ec",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Johann Sebastian Bachs \"Toccata und Fuge d-Moll\" gehörte zu den Lieblingsstücken des Altkanzlers.“"
                            },
                            {
                                "example_id": "aedbf3fa-2ebd-40d2-ad15-bf8ac3614ecb",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "[Coronapandemie 2020:] „Im Juni sollte ich einige meiner Lieblingsstücke von Alexander Skrjabin und ein Stück für Klavier und Orchester von Igor Strawinski einspielen. Das konnte nicht realisiert werden.“"
                            },
                            {
                                "example_id": "fa7a4d45-56b4-4cb0-8858-4e5f72aa2dda",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Auch Kaftan durfte ein Lieblingsstück wählen und entschied sich für \"Köcekce\" des türkischen Komponisten Ulvi Cemal Erkin von 1943.“"
                            },
                            {
                                "example_id": "1c5ff97e-6bf3-47e6-9823-e0ef12abc38a",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "[Felix Mendelssohn Bartholdy:] „Daneben interpretierte er die Klavierkonzerte Nr. 4 G-Dur, sein „altes Reitpferd“, und Nr. 5 Es-Dur von Beethoven sowie dessen Klaviersonaten, spielte oft Webers Konzertstück, ein Lieblingsstück, oder zeigte seine virtuosen Fähigkeiten mit Bachs Chromatischer Fantasie und Fuge.“"
                            },
                            {
                                "example_id": "be90a5d0-e400-4b1a-a9bf-f402e3d0340a",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "[Karl Merkatz:] „Dabei spielte er mehr als 150 Bühnenrollen, sein Lieblingsstück war Warten auf Godot.“"
                            },
                            {
                                "example_id": "0e566c7a-840a-4cb5-a9e1-e06f27bcca1e",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Das Lieblingsstück des Theaterfans ist ausgerechnet Die Räuber von Friedrich Schiller, ein Drama, in dem es um den Konflikt zwischen Gefühl und Verstand geht, zwischen Freiheit und Gesetz.“"
                            },
                            {
                                "example_id": "a00c1a07-d49c-4a1f-91d4-3f801998ccf3",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Kindertheatertreffen: Die Hamburger Kindertheater tun sich zusammen, laden das Publikum zum Gespräch ein und zeigen ihre Lieblingsstücke, zum Beispiel \"Frida und das Wut\" über ein Mädchen und ihr Zorn-Monster.“"
                            },
                            {
                                "example_id": "23a689a4-0d36-4c85-8773-8741a03b3a5a",
                                "sense_id": "aa781e4d-e886-3a16-a959-b8f4829260d0",
                                "text": "„Meine Damen und Herren, willkommen im Königlichen Hof- und Nationaltheater neben der Münchner Residenz, heute, am 9. Mai 1885, kurz vor Mitternacht. Wir erleben soeben den Schluss des Theaterstücks „Narciss“, wie bekannt das Lieblingsstück unseres verehrten Monarchen König Ludwig des Zweiten.“ […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                        "entry_id": "602821d9-4a10-362b-af74-bcc3e5651d96",
                        "glosses": [
                            "Gegenstand (beispielsweise ein Schmuckstück, ein Bild, eine Handtasche, ein Kleidungsstück), den eine Person besonders mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cafe4592-6ce6-486c-accb-13b066173547",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„Der Amerikaner gilt als Freund teurer Uhren und extravaganten Schmucks - in den sozialen Medien veröffentlicht er häufig Fotos seiner Lieblingsstücke.“"
                            },
                            {
                                "example_id": "0e4c634c-6de5-4ea9-a9b5-30b093e4cd1b",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„»Eines meiner Lieblingsstücke ist meine venezianische Lampe aus Muranoglas.«“"
                            },
                            {
                                "example_id": "3998800c-9a59-4ab0-8071-835c1c24563e",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„Victorias Leibarzt sorgte dafür, dass eine Sammlung von Lieblingsstücken in den Sarg gelegt wurde, wie sie es in einer geheimen Anweisung befohlen hatte. Dazu gehörten unter anderem ein Alabasterabdruck von Alberts Hand, Fotos und eine Locke von John Browns Haaren.“"
                            },
                            {
                                "example_id": "3bb3b603-a116-4441-86a4-597d96941ca4",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„Es erinnert mich an ein anderes Lieblingsstück aus der Porzellanmanufaktur Nymphenburg, den Laubbaum aus Porzellan.“"
                            },
                            {
                                "example_id": "5c441b69-da0e-4ee7-ac80-579311c2186c",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "[Photographie:] „Malick selbst hält sein Lieblingsstück in Händen, eine Rolleiflex, Baujahr 1959.“"
                            },
                            {
                                "example_id": "dba795d1-4316-4091-afe1-698ca2ab3e16",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„Kunstauktion – Christo-Nachlass erzielt Rekordpreise“ – […] „Unter dem Bild stand das einzige Möbel, das das Künstlerpaar aus Europa mitgenommen hatte - der moderne \"Hoge Stoel\" von Gerrit Rietveld, zeitlebens ein Lieblingsstück von Christo.“"
                            },
                            {
                                "example_id": "c41b5bec-e3fe-45b1-82f4-9a64589d6c7a",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„Der Radiosammler Ferenc Kreinicker“ – […] „Die Lieblingsstücke des Radiosammlers sind jene aus Holz. Er sagt, das Holz verleiht dem Gerät Leben.“"
                            },
                            {
                                "example_id": "fa066ad7-978a-44f0-a045-9e96185ade8f",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "„Die Kollektion für diesen Herbst war seine erfolgreichste, ein Mantel mit Rosendrucken wurde zum Lieblingsstück der internationalen Stylistinnen.“"
                            },
                            {
                                "example_id": "9acb450d-9477-4deb-a012-cf775b8a5441",
                                "sense_id": "1398a606-e77d-3ec3-8f0d-5d43fec19e24",
                                "text": "[3D-Drucker:] „Auch Hobby-Bastler oder Oldtimerliebhaber könnten sich bald ihr Lieblingsstück selbst ausdrucken und zusammenbauen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
