                        "cross_references": [
                            {
                                "target_word": "om",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b49099bb-c69e-394c-9d62-c7041d970e46",
                                        "entry_id": "01ffec91-7261-33ef-a58c-ed41f1b3d9f7",
                                        "glosses": [
                                            "A sacred, mystical syllable used in prayer and meditation."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f04c262f-3166-4f8e-ad5b-1fb9dfc38a06",
                                                "sense_id": "b49099bb-c69e-394c-9d62-c7041d970e46",
                                                "text": "In fact it sounded exactly like the voice of Livia, her vanished sister, and, like her, it was intoning the Aum just as she used once to do at the beginning of her yoga sessions."
                                            },
                                            {
                                                "example_id": "472db73d-ebac-4596-b9eb-31bb3980e679",
                                                "sense_id": "b49099bb-c69e-394c-9d62-c7041d970e46",
                                                "text": "Om is pronounced \"a-a-o-o-u-u-m-m\" and is repeated slowly for as long as possible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "om",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a977b878-5364-3ccb-b5ee-01b320088a14",
                                        "entry_id": "a30a76d2-d59a-3104-a274-12056739c1ed",
                                        "glosses": [
                                            "To chant the sacred syllable om."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9aa5731-7e52-4dba-bed7-158a88d8193e",
                                                "sense_id": "a977b878-5364-3ccb-b5ee-01b320088a14",
                                                "text": "Allen Ginsberg omming like a death rattle, his voice ravaged by the days of Hindu chants and gas."
                                            },
                                            {
                                                "example_id": "49871f56-ff06-46eb-9dd1-bf15083ac02f",
                                                "sense_id": "a977b878-5364-3ccb-b5ee-01b320088a14",
                                                "text": "I had to go into church to clear it by chanting the sacred mantra 'Om'. I was omming, loudly and intensely so that the vibration of that sacred mantra would fill every corner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
