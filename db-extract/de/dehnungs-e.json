                        "sense_id": "0e9ac2b9-2a3f-3dbd-860d-96d7e29c4760",
                        "entry_id": "27d461a7-fbec-3419-bd2e-0116f0aaf614",
                        "glosses": [
                            "Buchstabe ›e‹ in einem Wort, der anzeigt, dass der vorhergehende Vokal lang gesprochen werden soll, selbst aber nicht gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40647ac2-3cc5-44a3-86b3-0e94ff158585",
                                "sense_id": "0e9ac2b9-2a3f-3dbd-860d-96d7e29c4760",
                                "text": "„Übrigens spricht man das »i« in »Grevenbroich« nicht mit aus. Das ist ein Dehnungs-»i«. Wie das »e« in Soest ein Dehnungs-»e« ist.“"
                            },
                            {
                                "example_id": "5e4e992e-66a7-4659-b6f6-54b868535f34",
                                "sense_id": "0e9ac2b9-2a3f-3dbd-860d-96d7e29c4760",
                                "text": "„Der Ortsname spricht sich wie „Strahlen“, das E ist ein niederrheinisches Dehnungs-E. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
