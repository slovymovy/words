                                "target_senses": [
                                    {
                                        "sense_id": "900f320f-5b9f-3660-a279-5a4a35dad298",
                                        "entry_id": "65f69a83-ca10-381e-a996-c3da278b1eb2",
                                        "glosses": [
                                            "pomocí vhodných nástrojů rozrušovat na nepoměrně menší kousky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea8eec1-dc2c-4d00-b6db-a6ac1b7a0c4b",
                                                "sense_id": "900f320f-5b9f-3660-a279-5a4a35dad298",
                                                "text": "Nový stroj nám mele rudu rychleji a i lépe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ad04fb-d1be-3af8-8d5f-473b32733066",
                                        "entry_id": "65f69a83-ca10-381e-a996-c3da278b1eb2",
                                        "glosses": [
                                            "hodně, zbytečně nebo hloupě mluvit"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5c60eb-0040-4d1c-ab3d-cee463c074a8",
                                                "sense_id": "e6ad04fb-d1be-3af8-8d5f-473b32733066",
                                                "text": "Pořád o tom jenom mele, ale aby to udělal, to ne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dbf9541-0da9-4875-aca2-c98835469a7a",
                        "source_entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
