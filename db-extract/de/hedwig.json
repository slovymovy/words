                            {
                                "example_id": "0ceb6cbb-5c0e-49d8-88a7-8777320cfe72",
                                "sense_id": "477a9c4d-64fe-3f8f-a3c3-a7e477e182a6",
                                "text": "Hedwig Mustermann ist ein schönes Mädchen."
                            },
                            {
                                "example_id": "230617b2-ed5f-4cd4-8e70-f54b79736ac0",
                                "sense_id": "477a9c4d-64fe-3f8f-a3c3-a7e477e182a6",
                                "text": "Hedwig ist 20 Jahre alt."
                            },
                            {
                                "example_id": "6719e457-d3ab-4f8c-8031-ef257a61a44c",
                                "sense_id": "477a9c4d-64fe-3f8f-a3c3-a7e477e182a6",
                                "text": "Grüß bitte Hedwig Mustermann herzlich von mir."
                            }
                        ],
                        "sense_index_json": "\"1\""
