                ],
                "senses": [
                    {
                        "sense_id": "2a70b425-9bf4-3f4a-a62b-246bd73dfadf",
                        "entry_id": "a00b9012-beb3-3c64-9127-f061e944cfa8",
                        "glosses": [
                            "ein tief greifendes Muster negativer Einstellungen und einen passiven Widerstand gegenüber Forderungen nach angemessener Leistung zeigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7b769b-9063-4952-914a-266075e42f5f",
                                "sense_id": "2a70b425-9bf4-3f4a-a62b-246bd73dfadf",
                                "text": "„Von anderen sollten allerdings auf keinen Fall Aufgaben erledigt werden, die die passiv-aggressive Persönlichkeit zu übernehmen hatte.“"
                            },
                            {
                                "example_id": "3279d8a0-5fdf-42f5-aec6-1c8bb3e9187a",
                                "sense_id": "2a70b425-9bf4-3f4a-a62b-246bd73dfadf",
                                "text": "„Menschen mit einer passiv-aggressiven (auch: negativistischen) Persönlichkeitsstörung zeigen einen passiven Widerstand gegen soziale und berufliche Anregungen und Leistungsanforderungen und ein umfassendes Muster negativer Einstellungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
