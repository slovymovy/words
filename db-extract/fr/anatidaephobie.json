                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anatidaephobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43a8a29a-dad2-3a83-8359-0ce642a17bed",
                                        "entry_id": "a499d45e-a02e-3735-9b61-574f0c6be31b",
                                        "glosses": [
                                            "The fear that one is being constantly watched by a duck."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "167f607f-873f-4f0a-960c-a672f51bc71d",
                                                "sense_id": "43a8a29a-dad2-3a83-8359-0ce642a17bed",
                                                "text": "My regards to the ducks who watched me as I worked and gently encouraged me to stay on track. Even mild anatidaephobia has its uses."
                                            },
                                            {
                                                "example_id": "8be280ca-a389-41a1-aeac-3e1198cdff6c",
                                                "sense_id": "43a8a29a-dad2-3a83-8359-0ce642a17bed",
                                                "text": "Worse than that, Thomas himself suffered from anatidaephobia, the fear that you were being watched by a duck. As a youth, every time those Aflac commercials came on, Thomas had to retreat to his room in anguish."
                                            },
                                            {
                                                "example_id": "0b291c50-274b-4e18-ad2c-2cb553ab80a0",
                                                "sense_id": "43a8a29a-dad2-3a83-8359-0ce642a17bed",
                                                "text": "For example, Aflac, the insurance company, posted an ad featuring their duck mascot on the same page as an article about anatidaephobia—the fear that you are being watched by a duck (Figure 1.2)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
