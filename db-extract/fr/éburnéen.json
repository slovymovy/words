                        "entry_id": "051056f1-2337-3e00-8112-4bbe5d7b4c47",
                        "glosses": [
                            "Ivoirin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b2c8ec-b8e6-430b-a1f0-75d47b908409",
                                "sense_id": "5db4c3fc-9e6d-3daf-92bf-7766d7326bff",
                                "text": "Il revit le front haut, éburnéen, le nez qui semblait s’enfoncer dans la lèvre supérieure, et eut peur pour lui-même."
                            }
                        ]
                    }
                ],
                "translations": [
