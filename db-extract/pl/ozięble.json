                    },
                    {
                        "translation_id": "9df4cb50-7881-40e7-802e-1db904c7a828",
                        "source_entry_id": "bdfe5cde-444a-3f18-b98e-0ba6029a4051",
                        "source_sense_id": "d3ad3f79-104c-3fed-8327-9047469d6323",
                        "target_lang_word": "froidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "froidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c11c870e-62a4-3c80-86e1-cfaa2e65c1c5",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "De manière à sentir le froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5427bc06-57d6-41f1-9971-2f5295ae4cfd",
                                                "sense_id": "c11c870e-62a4-3c80-86e1-cfaa2e65c1c5",
                                                "text": "Être logé, vêtu froidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "D’une manière froide, sans chaleur, sans émotion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14a6753-c4bc-4141-a072-73837d0e9dbf",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Il écoute froidement les injures. Le stoïcien regarde froidement la mort."
                                            },
                                            {
                                                "example_id": "a48b7da9-2f03-4c78-97ec-413e7d953df0",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "En entendant cette horrible phrase, Pons se redressa comme si la décharge de quelque pile galvanique l’eût atteint, salua froidement sa cousine et alla reprendre son spencer."
                                            },
                                            {
                                                "example_id": "6e422b68-0e1d-4027-a86d-7cbe536aa636",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Il conte brièvement, mais froidement ; il ne se fait point écouter, il ne fait point rire."
                                            },
                                            {
                                                "example_id": "6983a801-092f-4aec-931e-4a096f669cb9",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Porus répondit froidement qu’il l’irait recevoir sur sa frontière, mais que ce serait les armes à la main."
                                            },
                                            {
                                                "example_id": "9a46f9c5-1d0d-4628-b661-626978801ede",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "[…]Ces flammes secrètes Que ne sentit jamais Boileau l’imitateur Dans ses tristes beautés si froidement parfaites."
                                            },
                                            {
                                                "example_id": "ba9c0509-da32-43f9-badb-79bf04766c51",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Mais honte soit au cœur Qui n'offre froidement que des vœux au malheur !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "D’une manière froide, avec réserve, sans encourager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc90c25-9b26-4ee0-956e-7455442df1d3",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "Vous louez les œuvres d’autrui froidement."
                                            },
                                            {
                                                "example_id": "59ce0825-5721-4bfb-abb3-4d2acdd2329d",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "M. le nonce en a parlé froidement."
                                            },
                                            {
                                                "example_id": "2df6370c-5889-4a6a-b4ec-c8312a61dce8",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "Piper lui demanda s’il n'y avait rien de nouveau : Non, dit le général froidement, et passa outre pour aller donner ses ordres."
                                            },
                                            {
                                                "example_id": "ca93502f-a3b2-47a4-9f16-a972dff9d860",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "La veille de son départ [de Bernin], on lui porta trois mille louis avec un brevet de douze mille livres de pension, il reçut le tout assez froidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeab8436-7c79-3f47-9a0f-04ff7d8c3724",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "Avec impassibilité, sans se troubler, sans s’émouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8566e281-3d10-48cb-af87-30ace76649ed",
                                                "sense_id": "aeab8436-7c79-3f47-9a0f-04ff7d8c3724",
                                                "text": "Il calcule froidement ce qui peut lui rester de vie."
                                            },
                                            {
                                                "example_id": "c5ad1a40-ff47-442a-931f-a99699729363",
                                                "sense_id": "aeab8436-7c79-3f47-9a0f-04ff7d8c3724",
                                                "text": "Il écouta froidement leurs injures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e80af4de-a681-41f9-97d0-064d40d79135",
                        "source_entry_id": "bdfe5cde-444a-3f18-b98e-0ba6029a4051",
                        "source_sense_id": "d3ad3f79-104c-3fed-8327-9047469d6323",
                        "target_lang_word": "холодно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "холодно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ea9e6c-633b-3c59-818d-e38ac6d96cb4",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "наречие к холодный; ощущая или распространяя холод"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079ddb7f-6919-4983-b9a9-3b295d575629",
                                                "sense_id": "f5ea9e6c-633b-3c59-818d-e38ac6d96cb4",
                                                "text": "Из-за угла выходит молодая длиннолицая, худая, очень бедно, холодно по погоде одетая крестьянка."
                                            },
                                            {
                                                "example_id": "15cd62a4-dbbb-463b-974d-22f940accd27",
                                                "sense_id": "f5ea9e6c-633b-3c59-818d-e38ac6d96cb4",
                                                "text": "А ещё лучше — бегите, а то, не ровён час, заболеете. На вас смотреть холодно. Я вас догоню."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f22d368-b966-30bb-956e-9e57573fc94f",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "перен. крайне сдержанно в проявлении чувств; бесстрастно, безучастно, равнодушно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35b96de-ef91-41f3-a127-31e0f4ba1e1c",
                                                "sense_id": "6f22d368-b966-30bb-956e-9e57573fc94f",
                                                "text": "— Как вы, дядюшка, можете так холодно издеваться над тем, что есть лучшего на земле?"
                                            },
                                            {
                                                "example_id": "7a654e10-242c-4aa1-b7a6-3bdd521a115f",
                                                "sense_id": "6f22d368-b966-30bb-956e-9e57573fc94f",
                                                "text": "Наши северные женщины любят как-то холодно и расчётливо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef131ed-e2aa-3727-9c1e-acb56b186c10",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "предик. о низкой температуре воздуха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ad32c9-292f-4452-9e05-930bb04b011f",
                                                "sense_id": "1ef131ed-e2aa-3727-9c1e-acb56b186c10",
                                                "text": "Холодно до гадости."
                                            },
                                            {
                                                "example_id": "11c741ee-12a1-4432-9f81-ef3b5118474a",
                                                "sense_id": "1ef131ed-e2aa-3727-9c1e-acb56b186c10",
                                                "text": "На улице холодно, скользко, на тротуарах мокрая наледь."
                                            },
                                            {
                                                "example_id": "0891fd7e-957d-496b-8741-29d57a5b7cc4",
                                                "sense_id": "1ef131ed-e2aa-3727-9c1e-acb56b186c10",
                                                "text": "На дворе пригревало солнце, а в комнатах было сыро и холодно, приходилось много топить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca5d56e-3dfb-3c8f-a48e-52dd690021d6",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "предик. об ощущении холода кем-нибудь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855d8980-f0ee-49a5-9914-606c4190bc07",
                                                "sense_id": "8ca5d56e-3dfb-3c8f-a48e-52dd690021d6",
                                                "text": "Утром мне было холодно даже в обоих свитерах и куртке."
                                            },
                                            {
                                                "example_id": "b8771d08-8e86-4d59-8cd0-60d7dc400521",
                                                "sense_id": "8ca5d56e-3dfb-3c8f-a48e-52dd690021d6",
                                                "text": "Была она очень бледна, казалось, что ей холодно, и она плотно закутывалась в свою прекрасную черную шаль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bad4cc4-7e46-39a2-9472-bf24315121ab",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "перен., предик. об ощущении одиночества, душевного холода, пустоты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad86fa31-25e7-48db-b421-91f5110d86d3",
                                                "sense_id": "6bad4cc4-7e46-39a2-9472-bf24315121ab",
                                                "text": "Бывали в моей тогдашней жизни минуты неопределённой тоски, когда я вдруг становился как-то равнодушен к своим скворцам и чижам, в душе делалось сухо, неприятно, холодно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4b66d0-ce96-3dab-82d6-f3418382a3d4",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "перен., предик. нет, скорее неверно, чем верно, скорее неправильно, чем правильно, скорее не так, чем так (об образе действия, указании направления или времени)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bccbb2df-54a6-35fb-815f-1378b71ee11c",
                                        "entry_id": "9a2dd1b5-d5e5-3b7a-b604-41454449bb92",
                                        "glosses": [
                                            "перен., предик. нет, скорее нет, чем да, скорее неверно, чем верно (при ответе на закрытый вопрос)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce8a9b4-0163-4db3-a42e-353311593052",
                                                "sense_id": "bccbb2df-54a6-35fb-815f-1378b71ee11c",
                                                "text": "— Фет? — Холодно. — Тютчев? — Холодно. Это не из школьной программы. — Сдаюсь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
