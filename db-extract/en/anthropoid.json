                "word": "anthropoid",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5f10da2d-f1e7-47aa-8d3d-d1d4aa75b8f4",
                        "entry_id": "d2aef2ae-3fed-3fb3-b481-3f081575dd69",
