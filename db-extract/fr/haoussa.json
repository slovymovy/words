        "fr-extract.jsonl": [
            {
                "entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
                "word": "haoussa",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d34a2399-09ac-406d-95f5-36475f22d20b",
                        "entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
                        "tags": [],
                        "form": "hausa"
                    },
                    {
                        "form_id": "acc9203d-641b-4af6-9429-5f6f6cd26895",
                        "entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
                        "tags": [],
                        "form": "hawsa"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                        "entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
                        "glosses": [
                            "Langue tchadique, parlée en Afrique occidentale, principalement au Niger et au Nigeria ; une des principales langues commerciales d’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd25a30c-8af9-4067-9776-0ebc239f7ce9",
                                "sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                                "text": "[…], enfin Moussa, jeune Nigérien, bavard et sympathique. Il fera ma cuisine et me servira d’interprète dans ce pays où l'on parle le haoussa principalement et d'autres dialectes, mais non l’arabe, à part quelques chefs et quelques marabouts."
                            },
                            {
                                "example_id": "c10ae3ce-7c64-45cb-abc3-90d9007389eb",
                                "sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                                "text": "En Inde, en Afrique, nombre de langues qui ont pourtant résisté à la colonisation sont aujourd’hui menacées par les grandes langues indiennes ou africaines, comme le swahili, le peul (en Afrique centrale), le haoussa (au Niger et au Cameroun) ou le ouolof (au Sénégal), particulièrement dangereuses parce qu’elles ne sont pas suspectes d’être des langues de l’étranger et possèdent le prestige des grandes langues africaines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14a77242-f583-4a97-94a4-3f0b61ea6e72",
                        "source_entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
                        "source_sense_id": "9fc9c72f-4c83-358c-bfc4-f33d15458d7d",
                        "target_lang_word": "Hausa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e4f9408-daef-3929-946a-39549f7e7793",
                                        "entry_id": "b71e2ce7-2aa9-3f66-9348-897583a26604",
                                        "glosses": [
                                            "ein afrikanisches Volk, das vor allem in Nigeria lebt"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9703898-3e3e-4c77-bc28-989e4a400a8f",
                                                "sense_id": "8e4f9408-daef-3929-946a-39549f7e7793",
                                                "text": "Die Volksgruppe der Hausa lebt vor allem im Norden von Nigeria und im Südosten des Niger."
                                            },
                                            {
                                                "example_id": "e8ec6e37-9da8-478e-91f2-c4202be21309",
                                                "sense_id": "8e4f9408-daef-3929-946a-39549f7e7793",
                                                "text": "„Anderes Vieh wurde von den Tuareg nicht an die Hausa verkauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2fade3c-6948-36d6-a542-37a06b6b3faa",
                                        "entry_id": "b71e2ce7-2aa9-3f66-9348-897583a26604",
                                        "glosses": [
                                            "ein Angehöriger des gleichnamigen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25156346-8b51-486b-ae31-74d88736f95c",
                                                "sense_id": "d2fade3c-6948-36d6-a542-37a06b6b3faa",
                                                "text": "„Von den zwei schwarzen Unteroffizieren, die Togos Kolonialtruppe 1894 hatte, war einer Hausa.“"
                                            },
                                            {
                                                "example_id": "6a61de78-3b12-41b2-ac6d-f145e3e5487b",
                                                "sense_id": "d2fade3c-6948-36d6-a542-37a06b6b3faa",
                                                "text": "„Zwei haben drei Frauen, zwei sind mit zwei Frauen verheiratet und nur ein Hausa hat lediglich eine Ehefrau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hausa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b73357a-e476-30c4-84d5-2e77921e1499",
                                        "entry_id": "018ddaad-2552-3cae-b371-ed4ecc5a5848",
                                        "glosses": [
                                            "eine Angehörige des gleichnamigen afrikanischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8530099e-0c89-48f1-acd3-32733a75a9ea",
                                                "sense_id": "7b73357a-e476-30c4-84d5-2e77921e1499",
                                                "text": "„Denn nun reifte in ihnen die Erkenntnis, daß der Mfon, der 1911 noch eine weitere Frau, eine Hausa, heiratete, offensichtlich längst nicht so schnell wie erwartet das Christentum anzunehmen gedachte.“"
                                            },
                                            {
                                                "example_id": "5e230a14-efd9-4ef9-846a-2ed5c295d0df",
                                                "sense_id": "7b73357a-e476-30c4-84d5-2e77921e1499",
                                                "text": "„[…]so die von Marv F. Smith 1949/50 aufgezeichnete Autobiographie einer Hausa aus der Provinz Zaria/Nigena, Baba of Karo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hausa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b847c69-7926-3474-b981-d3547fde907d",
                                        "entry_id": "907f10a6-43d0-3d4c-bd70-2b3960604677",
                                        "glosses": [
                                            "die Sprache des gleichnamigen Volks, Handelssprache im westlichen Zentralafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e97e89c4-eedf-41a8-9de4-27747a5cf748",
                                                "sense_id": "8b847c69-7926-3474-b981-d3547fde907d",
                                                "text": "Sprechen Sie Hausa?"
                                            },
                                            {
                                                "example_id": "0ee5d505-68f3-4d06-8477-6d4f4a416185",
                                                "sense_id": "8b847c69-7926-3474-b981-d3547fde907d",
                                                "text": "Das Hausa ist eine tschadische Sprache innerhalb der afroasiatischen Sprachen."
                                            },
                                            {
                                                "example_id": "fa8bdcdd-f291-4f24-884e-f5c9aee08f0d",
                                                "sense_id": "8b847c69-7926-3474-b981-d3547fde907d",
                                                "text": "„Anhand des Hausa, des Zulu und des Ashanti bietet sich ein faszinierender Einblick in die vielfältige und im wahrsten Sinne auch farbenfrohe Nutzung solcher Sprachwerkzeuge.“"
                                            },
                                            {
                                                "example_id": "ef2215e8-78b1-43fb-bb65-a3eb3721feb3",
                                                "sense_id": "8b847c69-7926-3474-b981-d3547fde907d",
                                                "text": "„Das Ende der Saga blieb ein Geheimnis, weil sie ab der achten Strophe auf Igbo, Yoruba und Hausa sangen.“"
                                            },
                                            {
                                                "example_id": "99fbf534-b13b-4902-bdf9-4e4a229a6b58",
                                                "sense_id": "8b847c69-7926-3474-b981-d3547fde907d",
                                                "text": "„Sein Hausa klingt komisch und je mehr ich auf seine Nase starre, desto mehr sieht sie aus, wie die von dem Dieb, der gelogen hat, dass er Idowu heißt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "503037dd-6da5-4a4e-897d-ba73c80ad2ab",
                        "source_entry_id": "fde33b67-b42c-3805-82c4-b9b9af3f75f6",
