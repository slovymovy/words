    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d6e5798-689b-360e-9315-90b1eb12f88a",
                    "sense_definition": "Een loofboom of heester uit het geslacht Acer, gekenmerkt door handlobbige bladeren en gevleugelde vruchten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst verkleuren de bladeren van de <w>esdoorn</w> prachtig rood en geel.",
                            "target_lang_translations": {
                                "en": "In autumn, the leaves of the <w>maple</w> turn a beautiful red and yellow."
                            }
                        },
                        {
                            "text": "In onze tuin staat een grote <w>esdoorn</w> die veel schaduw geeft.",
                            "target_lang_translations": {
                                "en": "There is a large <w>maple</w> in our garden that provides a lot of shade."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahorn",
                        "esdoren"
                    ],
                    "common_phrases": [
                        "bladeren van de esdoorn"
                    ],
                    "target_lang_definitions": {
                        "en": "A deciduous tree or shrub of the genus Acer, characterized by palmate leaves and winged fruits."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maple",
                                "target_lang_sense_clarification": "tree"
                            },
                            {
                                "target_lang_word": "maple tree",
                                "target_lang_sense_clarification": "tree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1cb3085-0185-38b0-a234-df7012ae9d76",
                    "sense_definition": "Het lichte en harde hout afkomstig van de esdoorn, veelal gebruikt voor meubels en muziekinstrumenten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De achterkant van deze viool is gemaakt van hoogwaardig <w>esdoorn</w>.",
                            "target_lang_translations": {
                                "en": "The back of this violin is made of high-quality <w>maple</w>."
                            }
                        },
                        {
                            "text": "Zij kozen voor een tafel van massief <w>esdoorn</w> vanwege de lichte kleur.",
                            "target_lang_translations": {
                                "en": "They chose a table made of solid <w>maple</w> because of its light color."
                            }
                        }
                    ],
                    "common_phrases": [
                        "massief esdoorn"
                    ],
                    "target_lang_definitions": {
                        "en": "The light and hard wood from the maple tree, commonly used for furniture and musical instruments."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maple",
                                "target_lang_sense_clarification": "wood"
                            },
                            {
                                "target_lang_word": "maple wood",
                                "target_lang_sense_clarification": "wood"
                            }
                        ]
                    }
                }
            ]
        },
        {
