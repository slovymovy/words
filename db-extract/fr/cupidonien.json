                            {
                                "example_id": "8c3822a7-3c83-4a0d-a1e7-f436f1281b95",
                                "sense_id": "c06112dc-f958-31c5-9baf-93127f6fbbe0",
                                "text": "Que Valere & Cleodeme, estoièt des Amans dont le Thorax & les visceres sembloient estre cógelez d'vn souffle Septentrional , & qu'ils ne deuoient iamais laisser eschaper leurs Nymphes des rets Cupidoniens: […]."
                            },
                            {
                                "example_id": "7710a601-79ad-434a-9dda-e95b70362be7",
                                "sense_id": "c06112dc-f958-31c5-9baf-93127f6fbbe0",
                                "text": "Il sourit, ravi de cette inattendue complicité cupidonienne : non, décidément, il n'était pas à l'écart du monde, il participait même à sa marche en avant."
                            }
                        ]
                    }
