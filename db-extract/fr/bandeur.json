                        "sense_id": "f93131ba-5788-3341-96f7-c28dad56e502",
                        "entry_id": "399443b1-e819-30c9-bd89-f90bf42b827c",
                        "glosses": [
                            "Personne qui pose des bandes, des bandages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c953bc1-ae99-4a71-aa89-597a87d7fe4b",
                                "sense_id": "f93131ba-5788-3341-96f7-c28dad56e502",
                                "text": "Quatre bandeurs de plaies."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f89d09f-696e-3bea-97c0-7eb006c44bfa",
                        "entry_id": "399443b1-e819-30c9-bd89-f90bf42b827c",
                        "glosses": [
                            "Jointeur. Ouvrier qualifié du bâtiment, chargé de la pose de bandes entre les plaques de plâtre ou de finition."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5cb7350b-8f7c-4b30-874b-ab850a0b144b",
                                "sense_id": "9f89d09f-696e-3bea-97c0-7eb006c44bfa",
                                "text": "Le travail du bandeur consiste à assurer la pose des bandes et enduits sur les plaques de placoplâtre et ainsi assurer les finitions des cloisons et des plafonds avant les interventions du peintre."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f358940-ba30-3f5a-a65f-501e16777933",
                        "entry_id": "399443b1-e819-30c9-bd89-f90bf42b827c",
                        "glosses": [
                            "Employé chargé d'aller chercher dans les locomotives les bandes graphiques (bande sur laquelle sont enregistrées les données telles que : vitesse, freinage, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d576ac5-4253-44ae-9b80-4d4fa9fef6e5",
                                "sense_id": "2f358940-ba30-3f5a-a65f-501e16777933",
                                "text": "Binot et Gandis, réveillés depuis belle lurette, se pointent à la loco. Le bandeur, visiblement en forme, bondit sur la plate-forme : – Allez-vous coucher !"
                            }
                        ]
                    },
                    {
                        "sense_id": "dff14460-2faa-389a-8bc5-4a0a7777c2ba",
                        "entry_id": "399443b1-e819-30c9-bd89-f90bf42b827c",
                        "glosses": [
                            "Aventurier, coureur de bandes (bande dans le sens utilisé dans la marine.) ^([1]) ^([2])"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9ccc9147-90b4-4737-8017-4fac745bef3d",
                                "sense_id": "dff14460-2faa-389a-8bc5-4a0a7777c2ba",
                                "text": "Ce notable bandeur [coureur de bandes, aventurier] avait une invention que j’estime devoir estre descrite."
                            }
                        ]
                    }
