                        "glosses": [
                            "mittlerer Wert der Noten (einer Person, in einem bestimmten Bereich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654cce33-bfce-4090-a39d-20c1dacf10f2",
                                "sense_id": "9708f5c9-1f71-3b00-82a7-4905cb607707",
                                "text": "„Mit einem Notendurchschnitt von mindestens 7,0 aus der neunten Klasse der Gemeinschaftsschule kommt man über eine Bewerbung in die gymnasiale Oberstufe.“"
                            },
                            {
                                "example_id": "d0c965d3-a16f-48f9-a675-4110abd8abd0",
                                "sense_id": "9708f5c9-1f71-3b00-82a7-4905cb607707",
                                "text": "„Mitten im Experiment aber ist die Gesamtschule in Verruf geraten, weil sich die Angst erhob, die Präsenz von Schülern aus den unteren Schichten würde den Notendurchschnitt der kleinen Akademiker in spe verschlechtern.“"
                            }
                        ],
