{
    "word_family": [
        "cosily",
        "cosiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6c688eb5-63a0-3597-b216-7150c2812c12",
                    "sense_definition": "Giving a feeling of warmth, comfort, and relaxation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat by the fireplace in the <w>cosy</w> living room on a cold night.",
                            "target_lang_translations": {
                                "ru": "Холодным вечером мы сидели у камина в <w>уютной</w> гостиной."
                            }
                        },
                        {
                            "text": "I feel very <w>cosy</w> under this thick woolen blanket.",
                            "target_lang_translations": {
                                "ru": "Под этим толстым шерстяным одеялом мне очень <w>уютно</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snug#Adjective",
                        "homely"
                    ],
                    "antonyms": [
                        "uncomfortable"
                    ],
                    "common_phrases": [
                        "cosy room",
                        "cosy corner",
                        "cosy atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создающий ощущение тепла, удобства и покоя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уютный",
                                "target_lang_sense_clarification": "о месте или атмосфере"
                            },
                            {
                                "target_lang_word": "тёплый",
                                "target_lang_sense_clarification": "согревающий, комфортный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c59c6ef1-ffc8-3009-a366-ef3ffdbdf618",
                    "sense_definition": "A padded or knitted fabric cover placed over a teapot or boiled egg to keep it warm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She knitted a colourful tea <w>cosy</w> to keep the pot warm during breakfast.",
                            "target_lang_translations": {
                                "ru": "Она связала разноцветную <w>грелку на чайник</w>, чтобы он оставался горячим во время завтрака."
                            }
                        },
                        {
                            "text": "He placed the knitted <w>cosy</w> over the freshly boiled egg.",
                            "target_lang_translations": {
                                "ru": "Он накрыл свежесваренное яйцо вязаным <w>колпачком</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tea cosy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий или вязаный чехол, надеваемый на чайник или варёное яйцо для сохранения тепла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грелка",
                                "target_lang_sense_clarification": "чехол на чайник или яйцо"
                            },
                            {
                                "target_lang_word": "стёганый чехол",
                                "target_lang_sense_clarification": "утеплённый колпак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "323837d9-db2d-316c-867f-9023283a0c1c",
                    "sense_definition": "A mystery novel or crime story featuring mild violence and set in a small, quiet community.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers reading a lighthearted <w>cosy</w> rather than dark thrillers.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает читать легкий <w>уютный детектив</w>, а не мрачные триллеры."
                            }
                        },
                        {
                            "text": "The author published another delightful <w>cosy</w> set in an English village.",
                            "target_lang_translations": {
                                "ru": "Автор опубликовал еще один замечательный <w>уютный детектив</w>, действие которого разворачивается в английской деревне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosy mystery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иронический или легкий детективный роман, действие которого происходит в небольшом тихом сообществе и без жестоких сцен насилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уютный детектив",
                                "target_lang_sense_clarification": "жанр литературы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8973f66-471d-34a3-9ade-966aa4530f7f",
                    "sense_definition": "To try to gain favor or become friendly with someone, usually to serve one's own interests.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent all afternoon <w>cosying</w> up to the new manager.",
                            "target_lang_translations": {
                                "ru": "Он провел всю вторую половину дня, <w>подлизываясь</w> к новому менеджеру."
                            }
                        },
                        {
                            "text": "The lobbyist tried <w>cosying</w> up to several politicians before the vote.",
                            "target_lang_translations": {
                                "ru": "Лоббист попытался <w>втереться в доверие</w> к нескольким политикам перед голосованием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosying up to"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used typically in the phrasal verb form cosy up to"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться втереться в доверие или подлизаться к кому-либо в корыстных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлизываться",
                                "target_lang_sense_clarification": "заискивать ради выгоды"
                            },
                            {
                                "target_lang_word": "заискивать",
                                "target_lang_sense_clarification": "добиваться благосклонности"
                            },
                            {
                                "target_lang_word": "втираться в доверие",
                                "target_lang_sense_clarification": "пытаться сблизиться ради выгоды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8bcfdd0-48ff-3db7-80c1-38b1fc79b07d",
                    "sense_definition": "To settle down comfortably and become warm and snug.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>cosied</w> down under the duvet with a good book.",
                            "target_lang_translations": {
                                "ru": "Она <w>уютно устроилась</w> под пуховым одеялом с хорошей книгой."
                            }
                        },
                        {
                            "text": "The cat <w>cosied</w> into the corner of the sofa and fell asleep.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>свернулась</w> в углу дивана и уснула."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cosy down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удобно и тепло устроиться, свернуться калачиком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уютно устроиться",
                                "target_lang_sense_clarification": "с комфортом усесться или лечь"
                            },
                            {
                                "target_lang_word": "примоститься",
                                "target_lang_sense_clarification": "устроиться в тепле и уюте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}