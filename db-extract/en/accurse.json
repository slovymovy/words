                        "source_sense_id": "1c1ad60d-268d-3406-abe3-e2938ecf1993",
                        "source_sense_description": "to devote to destruction; to imprecate misery or evil upon; to curse; to execrate; to anathematize",
                        "target_lang_word": "vervloeken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vervloeken",
                                "target_lang_code": "nl",
