                ],
                "senses": [
                    {
                        "sense_id": "9dbeb097-f1e0-3e4b-a9f6-1dc49ef57833",
                        "entry_id": "0210dcab-0b8c-3339-a8c2-7051872a4210",
                        "glosses": [
                            "azjatycka budowla o wielu kondygnacjach zaznaczonych z zewnątrz wystającymi daszkami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc047595-1e73-418b-a0f0-e50b99ef8633",
                                "sense_id": "9dbeb097-f1e0-3e4b-a9f6-1dc49ef57833",
                                "text": "Ostre i ścięte piramidy ułożone z warstw czarnych, żółtych, niebieskich; ciemnozielone pagody z jasnymi dachami; wysmukłe wieże, których każdy ganek ma inny kolor, świątynie indyjskie, fortece cyklopów, wielopiętrowe ściany w pasy szafirowe, złote i czerwone"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "78f104ea-057a-3bb1-a293-3840005e7f7c",
                        "entry_id": "0210dcab-0b8c-3339-a8c2-7051872a4210",
                        "glosses": [
                            "świątynia buddyjska o architekturze pagody (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dcefed1-a9e9-4afb-a867-d0271329c8af",
                        "source_entry_id": "0210dcab-0b8c-3339-a8c2-7051872a4210",
                        "source_sense_id": "78f104ea-057a-3bb1-a293-3840005e7f7c",
                        "target_lang_word": "pagoda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pagoda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3cb0a33-5c51-393f-8190-872a3452c016",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "A religious building in South and Southeast Asia, especially a multi-storey tower erected as a Hindu or Buddhist temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d28cb7-90cf-46cf-a61d-154f5dc2d4d1",
                                                "sense_id": "d3cb0a33-5c51-393f-8190-872a3452c016",
                                                "text": "On the journey southwards over the flat, fertile plains, paddy fields stretched away on each side of the line, and the landscape was broken only by wooden villages and stately pagodas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c15222d-5579-3c1f-87a8-873973f2629d",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "An image or carving of a god in South and Southeast Asia; an idol."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f6588e5-4d53-39d8-a7b8-e67b68c30dae",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "A unit of currency, a coin made of gold or half gold, issued by various dynasties and colonial powers in southern India."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d48c9ba-a7ca-44ae-839f-1a6341298bca",
                                                "sense_id": "9f6588e5-4d53-39d8-a7b8-e67b68c30dae",
                                                "text": "[T]he Mahrattas having offered Alimerdy Khan his liberty for a lak of Pagodas; he does in the Nabob's name desire that the Governor of Madras would receive jewels and money to that amount into his custody, […]"
                                            },
                                            {
                                                "example_id": "88979989-6fbf-49fd-8823-405d0a1246bc",
                                                "sense_id": "9f6588e5-4d53-39d8-a7b8-e67b68c30dae",
                                                "text": "I, in about two hours, notwithstanding the utmost caution, found myself minus upwards of six hundred pagodas […] ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f130cc5d-5c41-3686-9daa-5d3f4a284097",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "An ornamental structure imitating the design of the religious building, erected in a park or garden."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b5a4eb7-e459-3150-9d7a-f5917ebc32e8",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "A pagoda sleeve."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
