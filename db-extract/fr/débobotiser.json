                ],
                "senses": [
                    {
                        "sense_id": "28c715f3-c310-3adc-a58a-618c08914982",
                        "entry_id": "2d617656-4a05-3561-b4a4-067d5a826686",
                        "glosses": [
                            "Faire perdre son caractère bobo (bourgeois-bohème) à quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7fc4e6-d087-49a4-81fd-42741346f0c8",
                                "sense_id": "28c715f3-c310-3adc-a58a-618c08914982",
                                "text": "Il va falloir débobotiser la capitale !"
                            },
                            {
                                "example_id": "57a19fab-6421-4bc9-86d2-0d4f7cdd57c0",
                                "sense_id": "28c715f3-c310-3adc-a58a-618c08914982",
                                "text": "Elle doit, après tout, se débobotiser."
                            },
                            {
                                "example_id": "0c19cbf1-aa0c-49c4-8797-8054af64c2f5",
                                "sense_id": "28c715f3-c310-3adc-a58a-618c08914982",
                                "text": "Bref, tout pour « débobotiser » (sic) le tournoi et le rendre plus accessible et populaire."
                            },
                            {
                                "example_id": "5b348b35-2b02-48b7-8fc1-8e64db54a363",
                                "sense_id": "28c715f3-c310-3adc-a58a-618c08914982",
                                "text": "Non mais serieux ^([sic : sérieux]) il a raison, bcp [beaucoup] de sociaux démocrates votent UMP faute d’une vrai ^([sic : vraie]) gauche réaliste et « débobotisé ^([sic : débobotisée]) »."
                            }
                        ]
                    }
