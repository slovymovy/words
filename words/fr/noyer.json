                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette rupture difficile, il a tenté de <w>noyer</w> son chagrin dans l'alcool."
                        },
                        {
                            "text": "Au lieu d'affronter ses soucis, elle préfère les <w>noyer</w> au fond d'un verre."
