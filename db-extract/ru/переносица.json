                        "glosses": [
                            "nasal bridge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5640eb24-269b-478a-bd85-56e087aed903",
                                "sense_id": "2b3e7871-a8a7-31fe-aba4-95f71a2948f6",
                                "text": "Жадная блоха впилась ему в переносицу, но он этого не чувствует и даже улыбается, так как ему снится, будто все в городе кашляют и непрерывно покупают у него капли датского короля.",
                                "translation": "A greedy flea was stabbing the bridge of his nose, but he did not feel it, and was positively smiling, for he was dreaming that every one in the town had a cough, and was buying from him the King of Denmark's cough-drops.",
                                "english": "A greedy flea was stabbing the bridge of his nose, but he did not feel it, and was positively smiling, for he was dreaming that every one in the town had a cough, and was buying from him the King of Denmark's cough-drops."
                            }
                        ]
                    }
