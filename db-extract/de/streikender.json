                    },
                    {
                        "translation_id": "ed61f7b1-fb7a-43d5-bdde-f544aa1fdd3f",
                        "source_entry_id": "1358b61e-9e17-31a7-9f0d-be9226e0df86",
                        "source_sense_id": "e0fe64f6-6405-30bc-9eb3-41b82f605b96",
                        "source_sense_description": "jemand, der an einem Streik teilnimmt",
                        "target_lang_word": "gréviste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gréviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e26bef-72fb-3403-a3c8-a41ef95a6ae1",
                                        "entry_id": "e5ea1890-a936-306b-afac-ff68b0f1ef4b",
                                        "glosses": [
                                            "Celui, celle qui fait grève."
                                        ],
                                        "tags": [
                                            "Syndicalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc15b2d9-3cb0-4911-b823-353b9acdf5f9",
                                                "sense_id": "a3e26bef-72fb-3403-a3c8-a41ef95a6ae1",
                                                "text": "Les auteurs du meurtre furent arrêtés, mais quelqu'un de plus fut aussitôt impliqué dans l'affaire : Jules Durand, syndicaliste, gréviste."
                                            },
                                            {
                                                "example_id": "61e3a76f-dc57-41b7-906e-be45ce65deff",
                                                "sense_id": "a3e26bef-72fb-3403-a3c8-a41ef95a6ae1",
                                                "text": "La police attend avec des mitrailleuses et des gaz les grévistes noirs de Pennsylvanie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gréviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adb40675-b07d-37ea-8277-d8ae042604ff",
                                        "entry_id": "284c9a95-dee9-331f-bf58-4041fe940459",
                                        "glosses": [
                                            "Relatif aux grèves."
                                        ],
                                        "tags": [
                                            "Syndicalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb49434e-33df-4e87-9b65-c8f2192c9a1e",
                                                "sense_id": "adb40675-b07d-37ea-8277-d8ae042604ff",
                                                "text": "Aucun pays capitaliste du monde, même parmi les plus avancés comme l'Angleterre, les Etats-Unis d'Amérique ou l'Allemagne, n'a connu un mouvement gréviste aussi vaste que la Russie de 1905."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73ef9d1-7309-3851-b977-6dd7087e37fa",
                                        "entry_id": "284c9a95-dee9-331f-bf58-4041fe940459",
                                        "glosses": [
                                            "Qualifie les personnes qui mènent une grève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81255a31-e99f-4c75-9773-297563b19ae3",
                                                "sense_id": "a73ef9d1-7309-3851-b977-6dd7087e37fa",
                                                "text": "À d'autres moments des entretiens (non reproduits ici), il différencie rétrospectivement les ouvriers grévistes, qui sont ses proches, des ouvriers non grévistes qui manifestent leur inimitié après la grève, comme l'ouvrière responsable du casse-croûte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
