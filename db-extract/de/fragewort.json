                        "source_sense_id": "f198219f-b8fe-35ae-a504-b08dd9873c3b",
                        "source_sense_description": "Linguistik, im engeren Sinne: Synonym zu Interrogativpronomen",
                        "target_lang_word": "interrogative pronoun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interrogative pronoun",
