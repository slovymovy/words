                ],
                "senses": [
                    {
                        "sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                        "entry_id": "8fb2e9f5-7071-3a01-ba7a-ae211a601cfe",
                        "glosses": [
                            "Pflanze, die an salzreiche Standorte angepasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb757a0-eec0-40bb-bd8e-da05aa50d80c",
                                "sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                                "text": "Der Queller ist das Paradebeispiel für einen Halophyten."
                            },
                            {
                                "example_id": "c3b8e00f-b75b-44c5-9e03-1f9f8fdf1975",
                                "sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                                "text": "Obligate Halophyten wachsen ausschließlich an Salzstandorten."
                            },
                            {
                                "example_id": "3d943ae7-e1bf-4299-901d-42495c56ff36",
                                "sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                                "text": "In der Regel sind Halophyten an salzfreien Standorten anderen Pflanzen gegenüber unterlegen; das liegt nicht zuletzt an ihrer relativ langsamen Entwicklung."
                            },
                            {
                                "example_id": "94604909-fe23-4439-8d7d-5fccb34685d5",
                                "sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                                "text": "Obwohl Rosen keine ausgeprägten Halophyten sind, besiedeln dennoch innerhalb der Gattung Rosa die beiden einheimischen Arten Rosa spinosissima und Rosa mollis Küstenstandorte mit erhöhter Salinität, während andere in Nordeuropa vorkommende Wildrosen diese Gebiete meiden."
                            },
                            {
                                "example_id": "66f39b10-8bf8-4c61-b06d-455385ba2116",
                                "sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                                "text": "Durch Erwerb immer spezialisierterer Anpassungsstrategien verfeinerten dann die fakultativen Halophyten ihre Salztoleranz sukzessive, mussten jedoch - quasi als Eintrittsgeld in die Salzfluren - den Preis einer eingeschränkten Konkurrenzfähigkeit bezahlen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
