                                "target_senses": [
                                    {
                                        "sense_id": "82abfc14-955a-38f6-9013-72325961efa4",
                                        "entry_id": "c7a862e3-9fdc-31a7-bbd3-9f1f12e70708",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efea367-0d84-4aa9-adf4-e18532482d7b",
                                                "sense_id": "82abfc14-955a-38f6-9013-72325961efa4",
                                                "text": "And forth she sailed the ocean salt and rude. / O Constance, full of sweet solicitude, / O Emperor's daughter of a mighty realm, / He that is Lord of Fortune guide thy helm!"
                                            },
                                            {
                                                "example_id": "2f99f7c1-3842-448c-a5b7-83af338f13ed",
                                                "sense_id": "82abfc14-955a-38f6-9013-72325961efa4",
                                                "text": "My name is Constance; I was Geffrey's wife; / Young Arthur is my son, and he is lost: / I am not mad:—I would to heaven I were!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d4b5fa-b784-3258-ba7f-9f7e23175255",
                                        "entry_id": "c7a862e3-9fdc-31a7-bbd3-9f1f12e70708",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a1dbb52-e34c-3728-b100-4c214b3f7f2d",
