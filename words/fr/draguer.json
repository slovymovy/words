                    "frequency": "High",
                    "semantic_group_id": "seduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essaie de <w>draguer</w> toutes les personnes qui s'approchent du comptoir."
                        },
                        {
                            "text": "Elle n'apprécie pas du tout de se faire <w>draguer</w> avec insistance dans les transports."
                        }
                    ],
                    "synonyms": [
