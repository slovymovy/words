{
    "word_family": [
        "tijdloosheid",
        "tijd"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "905ed5ba-3d86-3a87-aa07-c2731300396d",
                    "sense_definition": "Niet onderhevig aan de invloed van de tijd of tijdelijke modetrends; van alle tijden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eeuwig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lijnen van deze stoel hebben een <w>tijdloze</w> schoonheid.",
                            "target_lang_translations": {
                                "en": "The lines of this chair have a <w>timeless</w> beauty."
                            }
                        },
                        {
                            "text": "Zijn muziek heeft een <w>tijdloos</w> karakter dat generaties blijft aanspreken.",
                            "target_lang_translations": {
                                "en": "His music has a <w>timeless</w> character that continues to appeal to generations."
                            }
                        }
                    ],
                    "synonyms": [
                        "achronisch"
                    ],
                    "antonyms": [
                        "tijdelijk",
                        "modieus"
                    ],
                    "common_phrases": [
                        "tijdloos ontwerp",
                        "tijdloze schoonheid",
                        "tijdloos karakter"
                    ],
                    "target_lang_definitions": {
                        "en": "Not subject to the influence of time or temporary fashion trends; of all times."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "timeless",
                                "target_lang_sense_clarification": "unaffected by time or fashion"
                            },
                            {
                                "target_lang_word": "ageless",
                                "target_lang_sense_clarification": "never looking old or outdated"
                            },
                            {
                                "target_lang_word": "classic",
                                "target_lang_sense_clarification": "having a lasting high quality and style"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dfe9e60-7cb4-3c5c-aaee-b58779f6c2e9",
                    "sense_definition": "Buiten de tijd staand; geen begin of einde hebbend.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eeuwig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die diepe meditatie ervoer zij een <w>tijdloze</w> staat van zijn.",
                            "target_lang_translations": {
                                "en": "In that deep meditation, she experienced a <w>timeless</w> state of being."
                            }
                        },
                        {
                            "text": "De filosoof sprak over een <w>tijdloze</w> dimensie waarin verandering niet bestaat.",
                            "target_lang_translations": {
                                "en": "The philosopher spoke of a <w>timeless</w> dimension in which change does not exist."
                            }
                        }
                    ],
                    "synonyms": [
                        "achronisch"
                    ],
                    "common_phrases": [
                        "tijdloze dimensie",
                        "tijdloze staat"
                    ],
                    "target_lang_definitions": {
                        "en": "Existing outside of time; having no beginning or end."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "timeless",
                                "target_lang_sense_clarification": "existing outside of time"
                            },
                            {
                                "target_lang_word": "eternal",
                                "target_lang_sense_clarification": "without beginning or end"
                            },
                            {
                                "target_lang_word": "timelessness",
                                "target_lang_sense_clarification": "the state of being outside of time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}