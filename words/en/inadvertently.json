                    "frequency": "Middle",
                    "semantic_group_id": "unintentional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>inadvertently</w> deleted the important file while cleaning up my computer desktop.",
                            "target_lang_translations": {
                                "ru": "Я <w>случайно</w> удалил важный файл, когда наводил порядок на рабочем столе компьютера."
                            }
                        },
                        {
                            "text": "She <w>inadvertently</w> offended her colleague by making a comment she did not realize was rude.",
                            "target_lang_translations": {
                                "ru": "Она <w>нечаянно</w> обидела коллегу, сделав замечание, грубости которого сама не осознавала."
