                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "15af12e1-d5d4-4a5d-9843-d2006bb437ac",
                        "source_entry_id": "dd01158d-afcb-3f5f-a0b5-4df9864e55cb",
                        "source_sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                        "source_sense_description": "pejorativ: Angeber; jemand, der mehr verspricht als er halten kann",
                        "target_lang_word": "big mouth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "big mouth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff570554-eaed-36bc-bad7-1007b8a46b03",
                                        "entry_id": "caae20db-39a9-30ea-8203-e0ce0eab6823",
                                        "glosses": [
                                            "The mouth of someone who talks too much, especially by making exaggerated claims or by inappropriately revealing information."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14861411-9fe5-434b-b644-bfa61d9c32da",
                                                "sense_id": "ff570554-eaed-36bc-bad7-1007b8a46b03",
                                                "text": "Shut your big mouth or I'll shut it for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f3674e-272b-3b8c-b838-a6934b585abd",
                                        "entry_id": "caae20db-39a9-30ea-8203-e0ce0eab6823",
                                        "glosses": [
                                            "A person who talks too much, especially by making exaggerated claims or by inappropriately revealing information."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99762c4e-3644-4599-9bb6-0e80d82d3bb1",
                                                "sense_id": "64f3674e-272b-3b8c-b838-a6934b585abd",
                                                "text": "Shut up, big mouth!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d66f28c-2e80-45f0-a2f2-7626588af2b7",
                        "source_entry_id": "dd01158d-afcb-3f5f-a0b5-4df9864e55cb",
                        "source_sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                        "source_sense_description": "pejorativ: Angeber; jemand, der mehr verspricht als er halten kann",
                        "target_lang_word": "hâbleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hâbleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                        "entry_id": "a8a5db83-610a-3790-81b3-1a3958577dff",
                                        "glosses": [
                                            "Qui hâble, qui parle des faits avec exagération, emphase et vantardise."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3e6f0c-3e0d-44c8-9f1b-3ce71a709144",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Retenus par une mauvaise honte, ils n’osent pas se louer eux-mêmes, mais ils attirent ordinairement auprès d’eux quelque panégyriste doucereux, quelque poète hâbleur qui, pour de l’argent s’engage à les louer, c’est-à-dire à leur débiter des mensonges."
                                            },
                                            {
                                                "example_id": "2058686c-a22b-41ba-973e-bdda405d29e8",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": ". – À propos d’artiste, ne voyez-vous pas dans ce petit cabaret ce grand gaillard qui gesticule devant des badauds ? Il frappe son verre sur la table ; si je ne me trompe, c’est ce hâbleur de Cellini."
                                            },
                                            {
                                                "example_id": "aa255c2c-acac-4976-bf03-3381d32fffc5",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Il avait menti ; c’est bien ici l’imagination et l’invention hâbleuse des Méridionaux."
                                            },
                                            {
                                                "example_id": "71b53a66-99e6-403f-b72a-9e006f58dcf9",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Les apophtegmes héroïques des Romains n’eurent aucun succès. Au diable ces hâbleurs ! « Chacun n’est né pour aller à Rome » Je hais le sot orgueil. Je veux avoir le droit de me plaindre, tout mon soûl, lorsque j’ai la colique…"
                                            },
                                            {
                                                "example_id": "4246d059-32aa-4664-af33-8352bab583fd",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Cette tendance, particulièrement nette chez les femmes de cette communauté religieuse très attachée à la morale et aux valeurs familiales, pourrait bien coûter au milliardaire hâbleur sa victoire dans certains états clés comme l’Arizona ou le Nevada où ils représentent environ 6% de la population, avertissent des experts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hâbleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                        "entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                                        "glosses": [
                                            "Personne qui hâble, qui parle avec exagération, emphase et vantardise."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e3709f-6ee4-4efd-b18b-998a6f2f4411",
                                                "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                                "text": "Quand on voudra citer un hâbleur, un vantard, un belître, incapable de modérer sa langue, un fier-à-bras qui menace s'avaler le monde, on parlera d'Adhémar de Trémazenc de Capestang !"
                                            },
                                            {
                                                "example_id": "373a79a8-305f-47dd-9f25-c99b74343f25",
                                                "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                                "text": "« Après tout, songea-t-il, ce n’est peut-être qu’un hâbleur, comme tous ces prodigues ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbdbed1c-577b-4bdb-856a-2684db2bd16d",
                        "source_entry_id": "dd01158d-afcb-3f5f-a0b5-4df9864e55cb",
                        "source_sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
