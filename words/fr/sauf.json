    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "36b22f9d-8d5e-3bc0-a0d7-2cc5cfcfdb99",
                    "sense_definition": "Indique une exception ou une exclusion ; hormis, excepté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde est venu à la réunion <w>sauf</w> Thomas qui était souffrant."
                        },
                        {
                            "text": "Le musée municipal est ouvert tous les jours de la semaine <w>sauf</w> le lundi."
                        }
                    ],
                    "synonyms": [
                        "à l'exception de",
                        "excepté",
                        "hormis"
                    ],
                    "common_phrases": [
                        "sauf si",
                        "tout le monde sauf"
                    ]
                },
                {
                    "sense_id": "33993861-d3b2-3a92-9420-6aa9584507be",
                    "sense_definition": "Sous réserve de, à moins de ; en envisageant une éventualité contraire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "réserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La livraison aura lieu demain matin, <w>sauf</w> imprévu de dernière minute."
                        },
                        {
                            "text": "<w>Sauf</w> erreur de ma part, nous avions convenu d'un rendez-vous à quinze heures."
                        }
                    ],
                    "common_phrases": [
                        "sauf erreur",
                        "sauf imprévu",
                        "sauf avis contraire"
                    ]
                },
                {
                    "sense_id": "aff1cc70-2f87-3710-ba71-4cbeecf967b0",
                    "sense_definition": "Formule de déférence employée pour atténuer une parole susceptible de choquer ou de déplaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sauf</w> votre respect, je ne partage pas du tout cette analyse de la situation."
                        },
                        {
                            "text": "<w>Sauf</w> le respect que je vous dois, monsieur le directeur, votre plan ne tient pas."
                        }
                    ],
                    "common_phrases": [
                        "sauf votre respect",
                        "sauf le respect"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7788d01e-4c6d-3443-a1a9-46aa20f2aec9",
                    "sense_definition": "Qui n'a pas subi de dommage physique ou mortel ; sain, indemne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cet impressionnant accident de voiture, le conducteur est sorti sain et <w>sauf</w>."
                        },
                        {
                            "text": "Tous les passagers ont eu la vie <w>sauve</w> grâce aux réflexes rapides du pilote."
                        }
                    ],
                    "common_phrases": [
                        "sain et sauf",
                        "la vie sauve"
                    ]
                }
            ]
        }
    ]
}