                ],
                "translations": [
                    {
                        "translation_id": "64b517c3-ec61-4097-8e03-cdb8346967d9",
                        "source_entry_id": "7ecde8bf-eb9d-3723-80f0-127905f603b8",
                        "source_sense_id": "e2a4aa1f-63b2-3274-81e0-ba9fd6093981",
                        "target_lang_word": "product",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "product",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "938616fb-2ff9-3766-9640-e2828c3db61d",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e769de-2e11-4695-b2c2-6ec608b1512a",
                                                "sense_id": "938616fb-2ff9-3766-9640-e2828c3db61d",
                                                "text": "The product of last month's quality standards committee is quite good, even though the process was flawed."
                                            },
                                            {
                                                "example_id": "d1fa4150-eae7-40b8-945c-a68123380fdc",
                                                "sense_id": "938616fb-2ff9-3766-9640-e2828c3db61d",
                                                "text": "To whom thus Michael: These are the product / Of those ill-mated marriages thou sawest;"
                                            },
                                            {
                                                "example_id": "05f72151-18fc-4e22-a79b-57750ee736a8",
                                                "sense_id": "938616fb-2ff9-3766-9640-e2828c3db61d",
                                                "text": "These institutions are the products of enthusiasm; they are the instruments of wisdom."
                                            },
                                            {
                                                "example_id": "e8440fb1-8f97-4035-be86-73706f18246f",
                                                "sense_id": "938616fb-2ff9-3766-9640-e2828c3db61d",
                                                "text": "The truth is that [Isaac] Newton was very much a product of his time. The colossus of science was not the first king of reason, Keynes wrote after reading Newton’s unpublished manuscripts. Instead “he was the last of the magicians”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a57f3da-4071-3ecb-acce-9d0122077ed4",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result.",
                                            "The amount of an artifact that has been created by someone or some process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "860f4947-3f47-45ed-825b-427c547b5bf2",
                                                "sense_id": "2a57f3da-4071-3ecb-acce-9d0122077ed4",
                                                "text": "They improve their product every year; they export most of their agricultural production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "738b25d7-7e4d-3dee-8fbc-2496ada7424a",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result.",
                                            "A consequence of someone's efforts or of a particular set of circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096e4ede-26d6-4a0e-b3e9-0eea9df0884e",
                                                "sense_id": "738b25d7-7e4d-3dee-8fbc-2496ada7424a",
                                                "text": "Skill is the product of hours of practice.  His reaction was the product of hunger and fatigue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1268dd2-09ea-3351-9569-f7186a1cef44",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result.",
                                            "A chemical substance formed as a result of a chemical reaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58302a6-919a-4225-a971-1548916a16f7",
                                                "sense_id": "a1268dd2-09ea-3351-9569-f7186a1cef44",
                                                "text": "This is a product of lime and nitric acid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18c93465-8628-37a8-aca8-706ce43c740a",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result.",
                                            "A quantity obtained by multiplication of two or more numbers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdde44f7-e1c4-4a2a-8a6e-2ad2d24c7013",
                                                "sense_id": "18c93465-8628-37a8-aca8-706ce43c740a",
                                                "text": "The product of 2 and 3 is 6.  The product of 2, 3, and 4 is 24."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56eec3a1-4584-33f6-82e3-cfd888800b04",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result.",
                                            "Any operation or a result thereof which generalises multiplication of numbers, like the multiplicative operation in a ring, product of types or a categorical product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a03b96d3-14f9-3570-b08b-5b9fafbba028",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Anything that is produced; a result.",
                                            "Any tangible or intangible good or service that is a result of a process and that is intended for delivery to a customer or end user."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148ad3e8-f7ea-4494-b78a-91b3c800b851",
                                                "sense_id": "a03b96d3-14f9-3570-b08b-5b9fafbba028",
                                                "text": "Product innovation is needed to meet changes in society and its requirements for particular types of banking product."
                                            },
                                            {
                                                "example_id": "29233b90-6eba-4cf1-a250-b6b252d7d76a",
                                                "sense_id": "a03b96d3-14f9-3570-b08b-5b9fafbba028",
                                                "text": "This sort of relationship can improve quality of transportation and can help in negotiations between transportation providers and transportation product users."
                                            },
                                            {
                                                "example_id": "970e54d0-f745-468c-b548-8dda543a1242",
                                                "sense_id": "a03b96d3-14f9-3570-b08b-5b9fafbba028",
                                                "text": "You can't create a stellar software product unless you know what it is supposed to do. You must work with the stakeholders to create the product scope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c077b6d-fcc7-3e9d-ae79-23810b920bd0",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "A commodity offered for sale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dcf5e4b-bb5f-4f87-9cea-65a3ace0c9c6",
                                                "sense_id": "5c077b6d-fcc7-3e9d-ae79-23810b920bd0",
                                                "text": "That store offers a variety of products.  We've got to sell a lot of product by the end of the month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52eb64b7-1473-3553-bdad-0965d0c72bbc",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "A commodity offered for sale.",
                                            "Illegal drugs, especially cocaine, when viewed as a commodity."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8350115-f3c2-408a-8ed4-7891aacf811b",
                                                "sense_id": "52eb64b7-1473-3553-bdad-0965d0c72bbc",
                                                "text": "I got some product here — you buying?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b220777-4e30-3477-bbdd-7f3b0fd29dc8",
                                        "entry_id": "90119e28-4b7b-3622-b166-21efaf233083",
                                        "glosses": [
                                            "Any preparation to be applied to the hair, skin, nails, etc. Often specifically a preparation used to hold one's hair in a desired arrangement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f010754b-0a43-418f-97e8-7fdd34c06546",
                                                "sense_id": "3b220777-4e30-3477-bbdd-7f3b0fd29dc8",
                                                "text": "Wash excess product out of your hair."
                                            },
                                            {
                                                "example_id": "f32d770b-8126-4436-8d7a-eef069672d31",
                                                "sense_id": "3b220777-4e30-3477-bbdd-7f3b0fd29dc8",
                                                "text": "He puts his fingers in Miller’s hair, which is greasy with product."
                                            }
                                        ]
                                    }
                                ]
                            },
