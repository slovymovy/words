                        "cross_references": [
                            {
                                "target_word": "Rauschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db01c6c0-dc2c-362a-a1c9-e9e5354605ee",
                                        "entry_id": "6a36213b-85b1-3ddc-870a-2c9ad5813236",
                                        "glosses": [
                                            "unregelmäßiges akustisches Signal aus unendlich vielen Teilschwingungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a05190e-4a5c-4f83-9b68-96a0063397c3",
                                                "sense_id": "db01c6c0-dc2c-362a-a1c9-e9e5354605ee",
                                                "text": "Das Rauschen des Meeres kann sehr beruhigend sein."
                                            },
                                            {
                                                "example_id": "55509f5b-8fd4-457c-b854-2983f1324e60",
                                                "sense_id": "db01c6c0-dc2c-362a-a1c9-e9e5354605ee",
                                                "text": "„Sie blieb noch eine Weile liegen und lauschte dem Rauschen vor dem Fenster, während sie auf die weiße Decke der Wohnung starrte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3adf0913-951e-4b90-9c9e-046537858df9",
                        "source_entry_id": "8834cf89-e540-3dcc-b0de-9e840b273800",
