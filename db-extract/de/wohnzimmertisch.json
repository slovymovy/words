                ],
                "senses": [
                    {
                        "sense_id": "98dcbfee-19d3-36ba-9db4-f6b40b24380a",
                        "entry_id": "0090c66b-7b71-3b32-abe5-a6f0e0db05fe",
                        "glosses": [
                            "Tisch, der im Wohnzimmer steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f744e104-9d37-4b14-9c97-fe5b63a3cd47",
                                "sense_id": "98dcbfee-19d3-36ba-9db4-f6b40b24380a",
                                "text": "„Er stellt die Schale mit den Süßigkeiten auf den Wohnzimmertisch aus weißem Marmor und lässt sich auf das Ledersofa fallen.“"
                            },
                            {
                                "example_id": "c46b18bd-8a64-4b96-9895-8728dd357515",
                                "sense_id": "98dcbfee-19d3-36ba-9db4-f6b40b24380a",
                                "text": "„Als ich zur Garage gehe, sehe ich die Post auf dem Wohnzimmertisch.“"
                            },
                            {
                                "example_id": "173ac617-ba00-407d-b1dc-d690a9628ac4",
                                "sense_id": "98dcbfee-19d3-36ba-9db4-f6b40b24380a",
                                "text": "„Der Onkel hat ihn heimlich durch den Türspalt beobachtet, wenn er am Wohnzimmertisch saß und Schulaufgaben machte.“"
                            },
                            {
                                "example_id": "069d82de-3ce5-42ec-8090-514cee9ad984",
                                "sense_id": "98dcbfee-19d3-36ba-9db4-f6b40b24380a",
                                "text": "„Auf dem Wohnzimmertisch lagen die Lehrbücher, und der Laptop stand halb zugeklappt neben ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
