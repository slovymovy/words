                "senses": [
                    {
                        "sense_id": "6aa5494f-2506-3e5f-a0d7-a0e34b3ab232",
                        "entry_id": "5fccd729-f3ed-3950-83cc-a294dc8cf2ef",
                        "glosses": [
                            "unsinkbares Kielboot, das meist von einer dreiköpfigen Crew gesegelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff128c7-2355-41f3-8fdf-8fc9fab80ae0",
                                "sense_id": "6aa5494f-2506-3e5f-a0d7-a0e34b3ab232",
                                "text": "„Trotz ihres Alters ist die Yngling ein modernes und attraktives Segelboot mit dem man, ob als Regatta- oder ‚Freizeitsegler‘, schöne Stunden auf dem Wasser verbringen kann.“"
                            },
                            {
                                "example_id": "98dd1af6-f448-4a06-b7ba-49ef38b91231",
                                "sense_id": "6aa5494f-2506-3e5f-a0d7-a0e34b3ab232",
                                "text": "„Hier wollen sich die Berlinerin Ulrike Schümann, die in Qingdao als Vierte im Yngling nur knapp eine Medaille verpasst hatte, und ihre Crew weiter profilieren.“"
                            },
                            {
                                "example_id": "52468acc-2b62-4306-927a-8a95467f3d3f",
                                "sense_id": "6aa5494f-2506-3e5f-a0d7-a0e34b3ab232",
                                "text": "„Neben Pickel/Borkowski werden in Qingdao Jan-Peter Peckolt/Hannes Peckolt (Hamburg/Kiel) im 49er, Petra Niemann (Berlin) in der Klasse Laser-Radial, das Trio Ulrike Schümann/Julia Bleck/Ute Hopfner (alle Berlin) im Yngling sowie das 470er-Team Stefanie Rothweiler/Vivien Kussatz (München/Berlin) an den Start gehen.“"
                            },
                            {
                                "example_id": "70f2253c-56ad-4607-bf2e-bea5e8e1b17a",
                                "sense_id": "6aa5494f-2506-3e5f-a0d7-a0e34b3ab232",
                                "text": "Konstruiert wurde die Yngling von Jan Hermann Linge (Norwegen), der 1971 dafür mit dem norwegischen Designerpreis ausgezeichnet wurde. Schnell wurden die ersten nationalen Klassenvereinigungen gegründet und 1971 entstand die International Yngling Association (IYA)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e26cad5-a6b2-420e-a7b6-de45fbbc03eb",
                        "source_entry_id": "5fccd729-f3ed-3950-83cc-a294dc8cf2ef",
                        "source_sense_id": "6aa5494f-2506-3e5f-a0d7-a0e34b3ab232",
                        "source_sense_description": "unsinkbares Kielboot, das meist von einer dreiköpfigen Crew gesegelt wird",
                        "target_lang_word": "Yngling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yngling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42cdf381-23d1-3d3f-8eec-f5401b5089b0",
                                        "entry_id": "d880c871-5c10-3b76-87c8-8f68cc5f821b",
                                        "glosses": [
                                            "A type of two-man keelboat from Norway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219439e1-bedd-45ea-a567-16da0e79c945",
                                                "sense_id": "42cdf381-23d1-3d3f-8eec-f5401b5089b0",
                                                "text": "The Yngling is highly stable, with a beam-to-waterline ratio of .37 and with 50 percent of the weight in ballast."
                                            },
                                            {
                                                "example_id": "bf602f95-a989-4821-aab0-fb8f84eed340",
                                                "sense_id": "42cdf381-23d1-3d3f-8eec-f5401b5089b0",
                                                "text": "… of the Yngling was calculated based on the known mass of the boat, including all equipment, and an estimation of the mass of the three female crew members. A triangular surface mesh was constructed on the Yngling geometry, with computational cells clustered and refined in regions of predominant interest and high surface curvature eg keel/rudder leading and trailing edges."
                                            },
                                            {
                                                "example_id": "53392554-60ec-4673-a0c2-a99617ae72d3",
                                                "sense_id": "42cdf381-23d1-3d3f-8eec-f5401b5089b0",
                                                "text": "And what a terrific performance by our girls in the Yngling. […] A strange name - do you Yngle it or sail it."
                                            },
                                            {
                                                "example_id": "626dff0a-b14f-4e43-a2e4-66391a034815",
                                                "sense_id": "42cdf381-23d1-3d3f-8eec-f5401b5089b0",
                                                "text": "For example, to insist on the inclusion of female match racing in Ynglings amounts to a foolish fixation on an arcane and visually unexciting aspect of the sport."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Yngling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a5f8a56-9a9e-3c44-8590-0ac108c986dc",
                                        "entry_id": "66c3d0ef-9060-3f31-95e3-389431db6efa",
                                        "glosses": [
                                            "A surname from Old Norse, especially used of members of the oldest known Scandinavian dynasty, the Ynglings, who were supposedly descended from Frey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
