                                        "entry_id": "2c1394b1-408c-3760-99b5-61d9f4303ee1",
                                        "glosses": [
                                            "term die aangeeft dat een speler bij een 40-40-stand een punt heeft gescoord en dus maar één punt verwijderd is van de winst van een game"
                                        ],
