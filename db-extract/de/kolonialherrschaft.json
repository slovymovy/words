                ],
                "senses": [
                    {
                        "sense_id": "32ec07de-e981-3415-b069-7b498593f210",
                        "entry_id": "5a35e7f7-68fb-3f57-a0c3-402aff00c1e2",
                        "glosses": [
                            "Herrschaft über eine Kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "090e016d-5919-478c-9026-6295bfbb8805",
                                "sense_id": "32ec07de-e981-3415-b069-7b498593f210",
                                "text": "„Er wusste ohnehin aus der Lektüre deutscher Zeitungsartikel, dass die britische Kolonialherrschaft nicht nur so zivil gewesen war, wie die Engländer es sich gerne vorstellten.“"
                            },
                            {
                                "example_id": "8cfaa43d-3c86-4a7e-b220-a685e666b837",
                                "sense_id": "32ec07de-e981-3415-b069-7b498593f210",
                                "text": "„Nimmt man den weit verbreiteten, lange währenden Kampf der afrikanischen Völker gegen die Kolonialherrschaft zum Ausgangspunkt, so steht das gemeinsame Element im Vordergrund.“"
                            },
                            {
                                "example_id": "92223ad0-a4c6-42ff-8ff5-7d8222ea0844",
                                "sense_id": "32ec07de-e981-3415-b069-7b498593f210",
                                "text": "„Unter der deutschen Kolonialherrschaft hieß diese Insel Neu-Pommern und gehörte zu Deutsch-Neuguinea; Beamte des deutschen Kaisers hatten hier von 1899 bis 1918 das Sagen.“"
                            },
                            {
                                "example_id": "2bdf67a5-777a-4815-bb32-3fa9d139739d",
                                "sense_id": "32ec07de-e981-3415-b069-7b498593f210",
                                "text": "„Mit Beginn der deutschen Kolonialherrschaft forcierte der deutsche Staat zunächst die Assimilierung der kolonialen ‚Untertanen‘ im Sinne einer auf Akkulturation ausgerichteten Germanisierung.“"
                            },
                            {
                                "example_id": "4568019f-4718-4e7d-b8be-660710e19d5a",
                                "sense_id": "32ec07de-e981-3415-b069-7b498593f210",
                                "text": "„Die erste Herausforderung der Kolonialherrschaft kam von ganz anderer Seite: Die indischen Söldner der Ostindiengesellschaft verschworen sich gegen sie zum großen Aufstand von 1857.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
