                        "examples": [
                            {
                                "example_id": "90efc293-9aae-4816-8960-c47a053899ce",
                                "sense_id": "e0c11725-db67-3784-bebd-767111214f36",
                                "text": "„Je dunkler die Farbe, desto stärker die Abweichung vom langjährigen Temperaturdurchschnitt.“"
                            },
                            {
                                "example_id": "71781ed6-a36e-420e-abb0-8047555406ab",
                                "sense_id": "e0c11725-db67-3784-bebd-767111214f36",
                                "text": "„Während aber der Temperaturdurchschnitt im Januar in Lübeck bei 0 Grad liegt, beträgt er an der Nordspitze Sachalins 21 Grad.“"
                            },
                            {
                                "example_id": "400324dc-f580-42bb-94b6-0c8fca7aaf95",
                                "sense_id": "e0c11725-db67-3784-bebd-767111214f36",
                                "text": "„Der Temperaturdurchschnitt blieb reichlich 1 ° unter dem normalen, dagegen übertraf die Niederschlagshöhe das vieljährige Mittel um 25 mm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
