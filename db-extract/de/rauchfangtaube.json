                "senses": [
                    {
                        "sense_id": "bff39826-0023-3334-a185-576b40ef8eb5",
                        "entry_id": "d057e35c-7e84-347f-b408-2c4df410f647",
                        "glosses": [
                            "abwertende Bezeichnung einer (meist weiblichen) Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e251dd2e-95e7-44f8-9e71-09aca1a448e6",
                                "sense_id": "bff39826-0023-3334-a185-576b40ef8eb5",
                                "text": "„Und die Standler schimpften: ‚Weg da von mein Salat, du alte Rauchfangtauben!‘“"
                            },
                            {
                                "example_id": "8261aae1-169e-4bc4-80bc-4e4ee4052287",
                                "sense_id": "bff39826-0023-3334-a185-576b40ef8eb5",
                                "text": "„Er kommt in meine Garderobe, um mich zu begrüßen: ‚Hallo, wie geht's, meine Rauchfangtauben?‘“"
                            },
                            {
                                "example_id": "03985e2a-d62c-4d2a-aad8-fe9b160f607e",
                                "sense_id": "bff39826-0023-3334-a185-576b40ef8eb5",
                                "text": "„Mein Scheibbser Großvater verwendete nicht nur gegen seinen Schwiegersohn Kraftausdrücke, er nannte eine Sopranistin Quietschfut und zu einer anderen sagte er, sie singe falsch wie eine Rauchfangtaube.“"
                            },
                            {
                                "example_id": "55cd6416-da6a-46a5-8260-fb91adffb618",
                                "sense_id": "bff39826-0023-3334-a185-576b40ef8eb5",
                                "text": "„Der alte Wiener Dialekt verschwindet langsam (wer sagt noch ‚du Safensiader‘ oder ‚oide Rauchfangtauben‘), ein neuer, angereichert mit Migrantendeutsch, entsteht.“"
                            },
                            {
                                "example_id": "d9ec6bc8-64ed-4587-afdd-578cc009e8e7",
                                "sense_id": "bff39826-0023-3334-a185-576b40ef8eb5",
                                "text": "„Meist reduzierte er sich dann, seiner Gemütsverfassung entsprechend, auf seine Minimalerscheinung und er saß wie eine Rauchfangtaube auf einem Ast.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
