                        "glosses": [
                            "Action de ouater (mettre de la ouate entre une étoffe et la doublure d’un vêtement, couvrir de ouate)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ffb947-0cc5-44a3-ac17-79291d86e931",
                                "sense_id": "cda7843b-128d-3011-8cb9-372c69329d05",
                                "text": "Quelques praticiens ayant encore abusé de l’emploi de la ouatte, nos premiers tailleurs ont décidé qu’on diminuerait le ouatage ou qu'on n’y aurait recours qu’en cas d’urgence absolue."
                            }
                        ]
                    },
                    {
                        "sense_id": "44bd5e07-651b-34ed-b779-5949b20681d1",
                        "entry_id": "bc605006-f0d0-3976-be2a-b5c164c561f1",
                        "glosses": [
                            "Couche de ouate entre l’étoffe et la doublure d’un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2e9b418-bcca-415b-8dad-d317dcadf8ad",
                                "sense_id": "44bd5e07-651b-34ed-b779-5949b20681d1",
                                "text": "Je suffoquai dans l’épaisseur de ce lourd vêtement, dont j’allais avoir largement l’occasion, tout à l'heure, d’apprécier le ouatage."
                            },
                            {
                                "example_id": "eda0073f-15c0-4156-80f0-f4160bda4a87",
                                "sense_id": "44bd5e07-651b-34ed-b779-5949b20681d1",
                                "text": "L’épais ouatage en MICROGUARD vous tient toujours bien chaud. Même lorsque vous passez des heures dehors."
                            }
                        ]
                    }
