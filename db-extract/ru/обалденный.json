                "senses": [
                    {
                        "sense_id": "03ceb0dc-e61b-37d6-9203-69cc51946fc0",
                        "entry_id": "2dfeaf7e-7a68-3285-afea-83d8f952991f",
                        "glosses": [
                            "жарг. очень хороший, отличный, прекрасный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d16c08c4-938f-4ce2-ac68-fa579c31cc26",
                                "sense_id": "03ceb0dc-e61b-37d6-9203-69cc51946fc0",
                                "text": "Сладкое не покупайте, я испекла обалденный торт, одна клиентка рецепт дала."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ae65f71-0828-306b-ac04-2d5135bb25c8",
                        "entry_id": "2dfeaf7e-7a68-3285-afea-83d8f952991f",
                        "glosses": [
                            "жарг. поразительный, необычайный, производящий очень сильное впечатление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e9bb15-614d-4ba2-b054-951e90f0f8e4",
                                "sense_id": "6ae65f71-0828-306b-ac04-2d5135bb25c8",
                                "text": "Посредством почти вертикального перелёта вам предстоит подняться на обалденную высоту 1234 метра, длина пути составит два километра двести метров, ― начал он с привычной забубенностью, но вдруг осекся."
                            }
                        ]
                    }
