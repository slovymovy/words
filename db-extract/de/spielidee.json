                ],
                "senses": [
                    {
                        "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                        "entry_id": "5c707644-062d-3205-8fb2-719219371b5d",
                        "glosses": [
                            "Einfall zum Spielen, der sich auch im Spielgedanken und in der Benennung des Spiels niederschlagen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b4d70b5-e61c-415c-abd1-76b83fadda89",
                                "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                                "text": "„Das ist eine wichtige Aufgabe des Trainers, – die Spieler von einer Spielidee zu überzeugen.“"
                            },
                            {
                                "example_id": "92b5ea6d-5734-4214-a30e-044b02ea6cf0",
                                "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                                "text": "„Wenn es einem Verein jedoch an Spielidee und Philosophie fehlt, daran kann keiner mehr zweifeln, dann ist nicht nur der Trainer schuld.“"
                            },
                            {
                                "example_id": "bd327e10-0008-42a9-ad51-b99ef3c4300f",
                                "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                                "text": "„Die Spielidee interessiert die Kinder, weckt ihre Aktivität und den Wunsch zu spielen.“"
                            },
                            {
                                "example_id": "ecde2dad-f195-4c3a-9093-f378413ddcab",
                                "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                                "text": "„Zu diesem Ende wird ein offenes Angebot von Spielen vorgelegt, zum Teil nach offenen Merkmalen oder Hilfsmitteln zusammengefasst,[…] zum Teil nach Spielideen oder konventionellen Spielgattungen gruppiert.“"
                            },
                            {
                                "example_id": "a2a4d15f-699f-46a7-9b10-ac51dc543043",
                                "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                                "text": "„Er ist nur Vollstreckungsorgan der Forderungen der jeweiligen Spielidee.“"
                            },
                            {
                                "example_id": "2ba4ee7f-fb53-45ac-9ab4-2b78abaae542",
                                "sense_id": "252a49ac-c689-32e7-a06b-5e296c17701f",
                                "text": "„Wer erfahren will, wie man Spiele aus einfachen Spielideen entwickelt, liest die Kapitel über das Arrangieren von Spielen oder das Ausgestalten von Spielgedanken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
