                    "frequency": "Middle",
                    "semantic_group_id": "succès",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'obtention de ce prix prestigieux représente la <w>consécration</w> suprême pour ce jeune romancier."
                        },
