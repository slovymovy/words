                "senses": [
                    {
                        "sense_id": "ad4ec98f-477e-321f-bbed-18b36c9010bc",
                        "entry_id": "27e28b80-9206-3e54-b2bf-d0b97e012959",
                        "glosses": [
                            "van verf of lak: glanzend als metaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d3a70b1-9d9b-41cb-9508-77ac4022587f",
                                "sense_id": "ad4ec98f-477e-321f-bbed-18b36c9010bc",
                                "text": "Zo draag ik deze zomer mijn lange jurk op een jeans of legging, en om een up-to-date versie van de loafer toe voegen aan mijn garderobe, kies ik voor een paar met metallic details of borduursel."
                            },
                            {
                                "example_id": "8650a28f-1dcf-44ac-983e-3fe6e4df5e0d",
                                "sense_id": "ad4ec98f-477e-321f-bbed-18b36c9010bc",
                                "text": "De vluchtauto zou na de overval in brand worden gestoken. Een locatie daarvoor hadden de twee overvallers in spe al op het oog: een verlaten plek in het bos bij het Brabantse Erp. Nadat ze in Brabant geen geschikte auto konden vinden, stroopten ze de parkeerplaatsen in Gelderland af. Op 20 januari 2003 viel de keuze op een donkergroene metallic Opel Omega, die op parkeerplaats Bloemers van het Gelderse natuurgebied de Posbank stond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa985018-b738-4693-870b-ffba459ca1f4",
                        "source_entry_id": "27e28b80-9206-3e54-b2bf-d0b97e012959",
                        "source_sense_id": "ad4ec98f-477e-321f-bbed-18b36c9010bc",
