                "translations": [
                    {
                        "translation_id": "b0ac9156-8d38-41f0-85ec-d98730950c84",
                        "source_entry_id": "7134c5ba-0f13-3002-9ed5-183a86f92d53",
                        "target_lang_word": "Gehenna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehenna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94b9a836-6c3b-3745-b034-55de682f5c4d",
                                        "entry_id": "1d005f3a-5a7b-33d8-a756-10ca93c16cc9",
                                        "glosses": [
                                            "In rabbinical literature and Christian and Islamic scripture, the place where the souls of the wicked go after death, where they suffer eternal damnation or annihilation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c597fd7-a165-4022-9481-a7ab498e4347",
                                                "sense_id": "94b9a836-6c3b-3745-b034-55de682f5c4d",
                                                "text": "Ye serpents, ye generation of vipers, how can ye escape the damnation of Gehenna?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3141ec4b-bcb6-3594-8c7e-5d2020f2af32",
                                        "entry_id": "1d005f3a-5a7b-33d8-a756-10ca93c16cc9",
                                        "glosses": [
                                            "Hell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3d18728-cdf8-3326-b8f1-4e02e59b590e",
                                        "entry_id": "1d005f3a-5a7b-33d8-a756-10ca93c16cc9",
                                        "glosses": [
                                            "A place of suffering and misery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada08823-c414-4875-b8e6-a978e6e47dbc",
                                                "sense_id": "f3d18728-cdf8-3326-b8f1-4e02e59b590e",
                                                "text": "School was Gehenna for the restless student."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adda7093-df4f-3ab7-865d-b50709bd7c9e",
                                        "entry_id": "1d005f3a-5a7b-33d8-a756-10ca93c16cc9",
                                        "glosses": [
                                            "The valley of Hinnom outside Jerusalem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002692c6-8fce-4023-b06a-53b9e60ec783",
                                                "sense_id": "adda7093-df4f-3ab7-865d-b50709bd7c9e",
                                                "text": "The people obeyed his commandment, and succeeding ages followed the example, and Gehenna became the general sink of the city, and the receptacle of all its pollutions."
                                            },
                                            {
                                                "example_id": "89d0563d-cfe5-4f91-af20-ca955572f49d",
                                                "sense_id": "adda7093-df4f-3ab7-865d-b50709bd7c9e",
                                                "text": "By the fifth century C.E., however, confusion about the tradition led to transference of the reputed site of Gehenna to the Kidron Valley, on the eastern side of Jerusalem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "453f7b50-4603-42f4-b1b1-b5a9fbaba17a",
                        "source_entry_id": "7134c5ba-0f13-3002-9ed5-183a86f92d53",
                        "target_lang_word": "perdition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perdition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d445289-82dc-32b5-be0b-df3fc0a92332",
                                        "entry_id": "84a6e65d-28bb-3753-9094-4557f0142380",
                                        "glosses": [
                                            "Eternal damnation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4909c12-087d-4da0-8cfb-6a786e9afe06",
                                                "sense_id": "0d445289-82dc-32b5-be0b-df3fc0a92332",
                                                "text": "I son ov perdition / From sheer nothingness transgressed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97246f8c-91c3-3c2a-a564-2cb90fbe8b87",
                                        "entry_id": "84a6e65d-28bb-3753-9094-4557f0142380",
                                        "glosses": [
                                            "Hell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ccd5bc1-d2a5-3287-b181-d0f0a52d767b",
                                        "entry_id": "84a6e65d-28bb-3753-9094-4557f0142380",
                                        "glosses": [
                                            "Absolute ruin; downfall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34be757d-5466-4f57-9ada-3b0a97221fc2",
                                                "sense_id": "7ccd5bc1-d2a5-3287-b181-d0f0a52d767b",
                                                "text": "Their decision to buy stocks just before the crisis led to their perdition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51ca3c2e-5178-49bd-99a5-40949bc636a5",
                        "source_entry_id": "7134c5ba-0f13-3002-9ed5-183a86f92d53",
                        "target_lang_word": "Gehenna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehenna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "744af843-b58e-397c-b46d-05ca35a2541c",
                                        "entry_id": "d3cc429e-6d71-3f25-b3e0-ff38204b92d8",
                                        "glosses": [
                                            "Strafort, an dem Menschen nach dem Tod ewig für ihre Sünden büßen müssen"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc3fc5e-30c5-4845-b055-7cec76a18dd7",
                                                "sense_id": "744af843-b58e-397c-b46d-05ca35a2541c",
                                                "text": "„Und dann muß sie ihr Thema weiter ausschreiben: ‚Wehe! Dem, der Böses tat, / Scheint Aurora eine Gehenna! / Und die schuldige Stirn zu kühlen, / Gibt es keinen Tropfen Naß in allen Weltenmeeren!‘ Gehenna, den althebräischen Namen für den Ort der Hölle, wo Menschenopfer dargebracht wurden, wählte Zwetajewa nicht von ungefähr. Seit dem 30. September 1940 wurde ihr Mann, der Jude Sergej Efron, im Lubjanka-Gefängnis ‚nicht mehr geführt‘. Er, der in Stalins Diensten einen Mord beging, wurde jetzt selbst dem Moloch Stalin geopfert.“"
                                            },
                                            {
                                                "example_id": "69b11bcc-7935-4f23-aeb3-1ac4ce31c733",
                                                "sense_id": "744af843-b58e-397c-b46d-05ca35a2541c",
                                                "text": "„Warum muss überhaupt Kaddisch gesagt werden? Weil der Sohn den Vater erlöst. Durch das Gebet, das ein Lobpreis Gottes (‚Erhoben und geheiligt werde sein großer Name…‘) darstellt, wird die Seele im ersten Todesjahr gereinigt und vermag dann von Gehenna nach Eden zu gelangen.“"
                                            },
                                            {
                                                "example_id": "11628c7d-5be2-4933-b21d-fdd48f78b604",
                                                "sense_id": "744af843-b58e-397c-b46d-05ca35a2541c",
                                                "text": "„Anderen zufolge werde in der Hölle, der Gehenna, schmachten, wer nach einer Frau einen Fluss überquere oder wer beim Geldzählen einer Frau die Münzen so in die Hand legt, dass er sie dabei anschauen muss.“"
                                            },
                                            {
                                                "example_id": "15376950-0338-4ca3-a04c-d4f0e628149f",
                                                "sense_id": "744af843-b58e-397c-b46d-05ca35a2541c",
                                                "text": "„Dank Manasse wurde aus dem Hinnomtal nicht nur ein Ort des Todes, sondern Gehenna, die ‚Hölle‘ der jüdischen und später auch christlichen und islamischen Mythologie. Gehenna scheint nicht auf das grausige Tal beschränkt.“"
                                            },
                                            {
                                                "example_id": "909efd7e-07fc-404b-afec-c6873e01211d",
                                                "sense_id": "744af843-b58e-397c-b46d-05ca35a2541c",
                                                "text": "„Resch Lakisch sagt gar, die Spötter sollen alle in die Gehenna fahren, die Hölle, und vermutlich denkt er dabei an seine eigenen Erfahrungen als Gladiator.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
