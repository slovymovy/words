{
    "word_family": [
        "rampager"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a90f6d2-8d96-37a3-b29f-bd746f25c7ed",
                    "sense_definition": "A period of violent, uncontrolled, and destructive behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violent_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry crowd went on a destructive <w>rampage</w> through the city center.",
                            "target_lang_translations": {
                                "zh": "愤怒的人群穿过市中心，一路进行破坏性的<w>狂暴肆虐</w>。"
                            }
                        },
                        {
                            "text": "Police were called to stop the suspect's violent <w>rampage</w> in the shopping mall.",
                            "target_lang_translations": {
                                "zh": "警方接到报警，前往商场制止嫌疑人的暴力<w>横冲直撞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "frenzy"
                    ],
                    "common_phrases": [
                        "go on a rampage"
                    ],
                    "target_lang_definitions": {
                        "zh": "狂暴、失控且具破坏性的行为或狂乱状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狂暴肆虐",
                                "target_lang_sense_clarification": "指暴力、破坏性的失控行为"
                            },
                            {
                                "target_lang_word": "横冲直撞",
                                "target_lang_sense_clarification": "指疯狂破坏或乱窜的行为"
                            },
                            {
                                "target_lang_word": "暴怒乱打乱闹",
                                "target_lang_sense_clarification": "指发怒时失去控制的骚乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f68ea73-490e-3209-bf9e-f2cacb674f85",
                    "sense_definition": "A period of wild, unrestrained partying or drinking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "party_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the final exam, the students went on a wild <w>rampage</w> through the local bars.",
                            "target_lang_translations": {
                                "zh": "期末考试结束后，学生们穿梭于当地各家酒吧，进行了一场疯狂的<w>狂欢胡闹</w>。"
                            }
                        },
                        {
                            "text": "They spent the entire weekend on a drunken <w>rampage</w> across the city.",
                            "target_lang_translations": {
                                "zh": "他们整个周末都在城市各处醉酒<w>寻欢作乐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "binge",
                        "spree"
                    ],
                    "common_phrases": [
                        "out on the rampage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe excessive social behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "狂欢、纵酒或放荡不羁的胡闹行为"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狂欢胡闹",
                                "target_lang_sense_clarification": "指聚会狂饮或无拘无束地胡闹"
                            },
                            {
                                "target_lang_word": "寻欢作乐",
                                "target_lang_sense_clarification": "指纵酒、寻欢的行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3160dec5-5fde-34c7-a101-703c86510eb5",
                    "sense_definition": "To move or act in a wild, violent, or destructive manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violent_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The escaped animals were <w>rampaging</w> through the small village streets.",
                            "target_lang_translations": {
                                "zh": "逃脱的动物在小村庄的街道上<w>横冲直撞</w>。"
                            }
                        },
                        {
                            "text": "The soldiers were <w>rampaging</w> across the border, causing chaos in the nearby towns.",
                            "target_lang_translations": {
                                "zh": "士兵们跨越边界一路<w>肆虐</w>，给附近城镇带来了混乱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "storm",
                        "rage"
                    ],
                    "target_lang_definitions": {
                        "zh": "狂暴地冲撞、横冲直撞或肆虐"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "横冲直撞",
                                "target_lang_sense_clarification": "狂暴乱跑并造成破坏"
                            },
                            {
                                "target_lang_word": "肆虐",
                                "target_lang_sense_clarification": "暴力冲杀或狂暴地行动"
                            },
                            {
                                "target_lang_word": "狂暴行动",
                                "target_lang_sense_clarification": "失控乱闯"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}