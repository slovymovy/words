                "senses": [
                    {
                        "sense_id": "c8715dce-31db-3d9a-9455-089e37a86b4b",
                        "entry_id": "6671dd9e-239e-39b3-a6d5-f9fe1bbcb3ff",
                        "glosses": [
                            "Ôter le chagrin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ef2d41-5a9e-4861-afa6-5493b6c135af",
                                "sense_id": "c8715dce-31db-3d9a-9455-089e37a86b4b",
                                "text": "Ce berger enjoué, ce doux magicien,\nQui connaît tous les morts des vieux temps et du sien,\nS’en va jusqu’aux enfers déchagriner les ombres"
                            },
                            {
                                "example_id": "2fd394c2-21ad-4661-996b-90be1acc611b",
                                "sense_id": "c8715dce-31db-3d9a-9455-089e37a86b4b",
                                "text": "J’ai donné les meubles à ma tante, il le fallait bien pour la déchagriner un peu."
                            }
                        ]
                    }
