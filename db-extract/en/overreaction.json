                    {
                        "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                        "entry_id": "66d5ca6e-efe7-3f0f-9fa8-78461cecd03c",
                        "glosses": [
                            "A reaction that is excessive."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e283e41d-297c-4365-9b90-8f62e6569e44",
                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                "text": "She had every right to dump you, but cutting up all your clothes after she did so was an overreaction."
                            },
                            {
                                "example_id": "0b3e6d58-c747-4139-b346-92371a0eb4c8",
                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                "text": "This whole fear over swine flu was unfounded; it was clearly an overreaction."
                            },
                            {
                                "example_id": "1a3a600f-0203-4f85-b394-c6ff115e4de5",
                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                "text": "The threat of terrorism to the British lies in the overreaction to it of British governments. Each one in turn clicks up the ratchet of surveillance, intrusion and security. Each one diminishes liberty."
                            },
                            {
                                "example_id": "7848ca77-5681-4722-907d-30034aac0694",
                                "sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                                "text": "In most cases, this overreaction to terrorism poses a far greater threat to our security than the terrorists themselves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7867f516-e1b1-416f-8825-fc081e275239",
                        "source_entry_id": "66d5ca6e-efe7-3f0f-9fa8-78461cecd03c",
                        "source_sense_id": "abc45418-66b5-3f92-b807-cd81ddbcbf89",
                        "source_sense_description": "reaction deemed excessive",
