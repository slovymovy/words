                        "entry_id": "82df3fa1-d9e8-3577-85c0-3fbd6fe65f49",
                        "glosses": [
                            "Chacun des isomères (molécules de même composition atomique) qui ne diffèrent entre eux que par la disposition de leurs atomes dans l'espace."
                        ],
                        "tags": [
                            "Stéréochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "3b02b18b-a24a-4382-b2cd-2a5be047be1f",
                                "sense_id": "8933890f-c1ef-3cd3-9b05-574a01e6f1d4",
                                "text": "Tous les isomères qui ont la même matrice de connectivité mais dont l’arrangement spatial des atomes est différent sont des stéréoisomères."
                            }
                        ]
                    }
                ],
