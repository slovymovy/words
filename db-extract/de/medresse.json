                "senses": [
                    {
                        "sense_id": "273794dc-f81a-35fb-88a9-b16ff45bff91",
                        "entry_id": "7a6d6061-c714-3800-8f6e-cf8f21b75007",
                        "glosses": [
                            "höhere Schule, in der hauptsächlich die islamischen Wissenschaften (Recht: Fiqh genannte Rechtslehre und Usūl al-fiqh genannte Rechtstheorie; Theologie: Hadith- und Koranwissenschaften; Philologie: klassisch-arabische Sprachlehre) unterrichtet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ec9c9f-11f8-4aab-8cdf-99ddcac16f2e",
                                "sense_id": "273794dc-f81a-35fb-88a9-b16ff45bff91",
                                "text": "„Naturwissenschaftliche Abhandlungen wurden zum ersten Mal in Urdu übersetzt, die neuen Theorien diskutierten nicht nur die Adeligen am Hof, sondern auch die Studenten in den Medressen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "31d5e5b8-e254-3aee-883d-53526d7eb669",
                        "entry_id": "7a6d6061-c714-3800-8f6e-cf8f21b75007",
                        "glosses": [
                            "zu einer Moschee gehörende Schule, in der die Vermittlung und Lesung des Korans im Vordergrund steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205bc252-fa28-4e97-a1d6-0b7d18bdbc22",
                                "sense_id": "31d5e5b8-e254-3aee-883d-53526d7eb669",
                                "text": "„Omar wurde in einer Medresse, in einer Koranschule, erzogen, schloss sich den Taleban an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
