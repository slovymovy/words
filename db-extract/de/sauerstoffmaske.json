                ],
                "senses": [
                    {
                        "sense_id": "85decdb2-125f-31eb-9623-9ca51555169a",
                        "entry_id": "7205868b-425c-32ed-ba9c-4190b1dd053f",
                        "glosses": [
                            "Maske, die dazu dient, eine Person mit Sauerstoff zu versorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc1497c-699b-49e4-9a31-658c26bafe61",
                                "sense_id": "85decdb2-125f-31eb-9623-9ca51555169a",
                                "text": "Man darf eine Sauerstoffmaske nicht mit weniger als 6l Fluss betreiben, weil es sonst zu einer CO2-Retention kommt."
                            },
                            {
                                "example_id": "572208c0-9bfa-4e54-9241-a0f49543be41",
                                "sense_id": "85decdb2-125f-31eb-9623-9ca51555169a",
                                "text": "Der Copilot habe zusammengesunken auf seinem Sitz gesessen und eine Sauerstoffmaske getragen, sagt man am Flughafen."
                            },
                            {
                                "example_id": "8ff5fb08-e3de-4fbd-a876-f99e263371fa",
                                "sense_id": "85decdb2-125f-31eb-9623-9ca51555169a",
                                "text": "Schnarchen ist nicht nur für die Ehepartner lästig - Sauerstoffmasken und Zahnschienen helfen gegen Atemblockaden."
                            },
                            {
                                "example_id": "44459421-243f-4dac-a2fb-5b0e4f5927d5",
                                "sense_id": "85decdb2-125f-31eb-9623-9ca51555169a",
                                "text": "Der Vater hatte Brandverletzungen erlitten und zwei der Kinder wurden mit Sauerstoffmasken ins Krankenhaus eingeliefert."
                            },
                            {
                                "example_id": "9126a83c-8a6c-4f62-93c6-91b168ede5c4",
                                "sense_id": "85decdb2-125f-31eb-9623-9ca51555169a",
                                "text": "Um die Brandstelle zu lokalisieren, griffen die Feuerwehrleute, die das Gebäude nur mit Atemschutz und Sauerstoffmaske betreten konnten, auf eine Wärmebildkamera zurück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
