                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20e6e873-224d-4a14-80d0-9a2bb183a97f",
                                                "sense_id": "b258f717-0d4b-3543-82c4-1cb8beee7990",
                                                "text": "Dépassant les échoppes des marchands de noix, il fut enlacé par une étrange femme-serpent qui lui flagella le dos à l’aide d’un faisceau de roseaux."
                                            }
                                        ]
