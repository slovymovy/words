                    "sense_id": "d82094e8-3fc8-3eb7-8663-024b265b4b66",
                    "sense_definition": "Сперва, в первое время; перед тем, как приступить к чему-либо другому.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Сначала</w> нужно сделать домашнее задание, а потом можно играть.",
                            "target_lang_translations": {
                                "en": "<w>First</w> you need to do your homework, and then you can play.",
                                "cs": "<w>Nejdříve</w> je potřeba udělat domácí úkol a potom si můžeš hrát.",
                                "zh": "<w>首先</w>得做完家庭作业，然后才能去玩。",
                                "nl": "<w>Eerst</w> moet je je huiswerk maken, en daarna mag je spelen.",
                                "pl": "<w>Najpierw</w> trzeba odrobić pracę domową, a potem można się bawić.",
                                "de": "<w>Zuerst</w> musst du die Hausaufgaben machen, und danach kannst du spielen.",
                                "fr": "<w>D'abord</w>, il faut faire les devoirs, et ensuite tu pourras jouer.",
                                "it": "<w>Prima</w> devi fare i compiti, e poi puoi giocare.",
                                "tr": "<w>Önce</w> ev ödevini yapman gerekiyor, sonra oynayabilirsin.",
                                "es": "<w>Primero</w> tienes que hacer la tarea, y luego puedes jugar."
                            }
                        },
                        {
                            "text": "Мы <w>сначала</w> пойдём в магазин за продуктами.",
                            "target_lang_translations": {
                                "en": "We will go to the grocery store <w>first</w>.",
                                "cs": "My <w>nejprve</w> půjdeme do obchodu pro potraviny.",
                                "zh": "我们<w>先</w>去商店买点食品。",
                                "nl": "Wij gaan <w>eerst</w> naar de winkel voor boodschappen.",
                                "pl": "My <w>najpierw</w> pójdziemy do sklepu po zakupy.",
                                "de": "Wir gehen <w>zuerst</w> in den Laden, um Lebensmittel einzukaufen.",
                                "fr": "Nous irons <w>d'abord</w> au magasin pour faire les courses.",
                                "it": "Noi <w>prima</w> andiamo al negozio a fare la spesa.",
                                "tr": "Biz <w>önce</w> markete alışverişe gideceğiz.",
                                "es": "Nosotros <w>primero</w> iremos a la tienda a comprar comida."
                            }
                        }
                    ],
