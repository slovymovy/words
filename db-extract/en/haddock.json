                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb68b1a-a59c-43fd-9d36-dc67850177ad",
                                                "sense_id": "171697db-70d9-3830-8ee9-13ca7758c96a",
                                                "text": "L’aiglefin a fait l’objet d’une exploitation intensive dans les pêcheries démarsales de l’Atlantique Nord-Ouest."
                                            },
                                            {
                                                "example_id": "f7f54b82-73cc-4fa7-8636-667842d5e03a",
                                                "sense_id": "171697db-70d9-3830-8ee9-13ca7758c96a",
                                                "text": "Peut-il, le goupillon sacré,\nRépandre ses grâces congrues\nSur l’aiglefin, ventre nacré,\nEt sur les maussades morues ?"
                                            }
                                        ]
                                    }
                                ]
                            }
