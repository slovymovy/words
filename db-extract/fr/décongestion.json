                "senses": [
                    {
                        "sense_id": "907e99e1-2e98-374d-9356-3b3e0a0e7390",
                        "entry_id": "4311af06-e46a-3201-a418-dd94f07f3578",
                        "glosses": [
                            "action de décongestionner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921d8e35-dff8-4d96-970c-bc528e9efa86",
                                "sense_id": "907e99e1-2e98-374d-9356-3b3e0a0e7390",
                                "text": "L’action de décongestion nasale par un médicament vasodilatateur constitute donc un phénomène parfaitement logique, et n’est contradictoire qu’en apparence …."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d7637d8-ed3f-3500-8c98-e312de0fc3f4",
                        "entry_id": "4311af06-e46a-3201-a418-dd94f07f3578",
                        "glosses": [
                            "désencombrer la circulation routière"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d661c0f4-9fac-47c5-b722-10446113206f",
                                "sense_id": "3d7637d8-ed3f-3500-8c98-e312de0fc3f4",
                                "text": "Par contre, la décongestion des autoroutes 40 et 20 sera bénéfique pour toute l’industrie de la livraison locale, selon le PDG de l’ACQ."
                            },
                            {
                                "example_id": "900b2d12-6da5-4cb2-ac22-7d6b8d8f9fff",
                                "sense_id": "3d7637d8-ed3f-3500-8c98-e312de0fc3f4",
                                "text": "Il a recueilli une centaine d’engagements et plus de 50 milliards de dollars (40,5 milliards d’euros), ou encore l’annonce par huit banques de développement d’un investissement de 175 milliards de dollars sur dix ans pour la décongestion et la dépollution de mégapoles."
                            }
                        ]
                    }
