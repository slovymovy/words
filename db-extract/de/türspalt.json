                    }
                ],
                "senses": [
                    {
                        "sense_id": "217e23fa-137f-3e38-ac93-11224f1ab7fe",
                        "entry_id": "20c0d2f9-6b41-3e96-8075-05b3338e67d7",
                        "glosses": [
                            "schmale Öffnung zwischen Tür und Türrahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ffd0df-0147-4e99-8da4-66d5ad903fe3",
                                "sense_id": "217e23fa-137f-3e38-ac93-11224f1ab7fe",
                                "text": "„Die Klinke senkte sich, und durch den Türspalt schaute das erstaunte, demütige Gesicht Pastor Schniggs, die Augen groß auf den geschmückten Weihnachtsbaum gerichtet.“"
                            },
                            {
                                "example_id": "15143904-55b1-4810-9f44-b692ff13c1a7",
                                "sense_id": "217e23fa-137f-3e38-ac93-11224f1ab7fe",
                                "text": "„Manchmal traten sie auch näher und unterhielten sich mit den Frauen durch den Türspalt.“"
                            },
                            {
                                "example_id": "b625d187-32c0-4e93-bb08-524cd1555616",
                                "sense_id": "217e23fa-137f-3e38-ac93-11224f1ab7fe",
                                "text": "„In dem Jemand, der durch den Türspalt vorsichtig nach draußen lugte, erkannte der Besucher den alten Sonderling Doktor Eisentür.“"
                            },
                            {
                                "example_id": "29672540-556b-4b47-b7f3-1aece328c219",
                                "sense_id": "217e23fa-137f-3e38-ac93-11224f1ab7fe",
                                "text": "„Am oberen Ende der ersten Treppe sah ich durch einen Türspalt Licht; ich wußte, daß dieses Zimmer sonst leer war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccc38f5e-99e0-42ce-aec4-b29a25401674",
                        "source_entry_id": "20c0d2f9-6b41-3e96-8075-05b3338e67d7",
                        "source_sense_id": "217e23fa-137f-3e38-ac93-11224f1ab7fe",
                        "source_sense_description": "schmale Öffnung zwischen Tür und Türrahmen",
                        "target_lang_word": "entrebâillement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrebâillement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cbb3747-a89b-3667-ba4c-ae08b4adbeed",
                                        "entry_id": "8dab4e3c-4dea-3705-b4ca-41145bb8523d",
                                        "glosses": [
                                            "Intervalle produit par ce qui est entrebâillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ac4da8-d2bb-49f3-bf47-7ffee10c4881",
                                                "sense_id": "9cbb3747-a89b-3667-ba4c-ae08b4adbeed",
                                                "text": "Elle vit plusieurs fois s’ouvrir et se fermer la porte, et à chaque fois, par l’entrebâillement, elle aperçut Catherine rajeunie par l’action, […]."
                                            },
                                            {
                                                "example_id": "5bb8c23f-036a-4295-bf8b-d253e9f667f1",
                                                "sense_id": "9cbb3747-a89b-3667-ba4c-ae08b4adbeed",
                                                "text": "Par un entrebâillement de rideaux, un rayon de soleil planta dans la pièce sa lance d’or, et son éclat, […], sembla transformer la chambre du poêle du père Jourgeot."
                                            },
                                            {
                                                "example_id": "6abf5ee6-eda0-416f-adb0-f6ed8b7d16eb",
                                                "sense_id": "9cbb3747-a89b-3667-ba4c-ae08b4adbeed",
                                                "text": "Tout le chargement était à refaire, dans la rue, c’est-à-dire au vu de tous les voisins réveillés par le vacarme et qui passaient maintenant des têtes curieuses dans l’entrebâillement de leurs volets."
                                            },
                                            {
                                                "example_id": "dbe28a0d-7b01-462e-9247-083a71a07ed4",
                                                "sense_id": "9cbb3747-a89b-3667-ba4c-ae08b4adbeed",
                                                "text": "Pour moi, dans ce moment à vrai dire incomparable où, dans l’entrebâillement de la porte vernie, je la vis apparaître, indifférente d’abord, puis changeant tout à coup de visage, je faillis ne pas la reconnaître."
                                            },
                                            {
                                                "example_id": "88ac7831-11bf-448b-95b5-e8cf3653ce3c",
                                                "sense_id": "9cbb3747-a89b-3667-ba4c-ae08b4adbeed",
                                                "text": "Ils étaient assis depuis longtemps dans un grand vestibule et, par l'entrebâillement des portes, on apercevait des bureaux déserts que leurs occupants venaient sans doute de quitter en y laissant un air vicié et une odeur de tabac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
