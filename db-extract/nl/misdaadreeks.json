                        "glosses": [
                            "serie televisieprogramma's waarin een misdaadverhaal wordt verteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "409d9722-c12a-4d97-afbc-fea09e497692",
                                "sense_id": "530dcaa4-44d2-3105-be3a-1a4b603e26b9",
                                "text": "Undercover, de Vlaams-Nederlandse misdaadreeks met Tom Waes (52) in de hoofdrol, zal niet meer uitgezonden worden op de Nederlandse televisie. Na zes afleveringen werd het programma al van de buis gehaald."
                            },
                            {
                                "example_id": "f7f1da4d-9902-47c9-abac-522d6791227c",
                                "sense_id": "530dcaa4-44d2-3105-be3a-1a4b603e26b9",
                                "text": "Di Rupo, in poloshirt en gympies, duikt op in de populaire misdaadreeks Salamander. Puur toeval, aldus producent Skyline Entertainment. Van de bewuste scène in Brussel werden in de zomer van 2011 meerdere takes opgenomen en in één ervan verscheen Di Rupo plots. Hij was op dat moment nog geen premier."
                            }
                        ]
                    }
