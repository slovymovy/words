                        "examples": [
                            {
                                "example_id": "322aca7d-a536-4162-9769-3e7c35cee360",
                                "sense_id": "988f013f-1f1a-3851-bb89-1babe1a86218",
                                "text": "И предложил ребятам следующее: я подсчитаю кубатуру нашей камеры, объем воздуха в ней, количество выдыхаемого каждым из нас углекислого газа, умножу на число людей, находящихся в камере."
                            }
                        ]
