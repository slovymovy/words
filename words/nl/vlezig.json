            "senses": [
                {
                    "sense_id": "7d9717fa-e8e9-3c2b-bbb2-8b1503251cd7",
                    "sense_definition": "met veel vruchtvlees, stevig en sappig",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vrucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze <w>vlezige</w> tomaten zijn bijzonder geschikt voor het maken van een dikke saus.",
                            "target_lang_translations": {
                                "de": "Diese <w>fleischigen</w> Tomaten eignen sich besonders gut für die Zubereitung einer sämigen Soße."
                            }
                        },
                        {
                            "text": "De perzik voelde heerlijk zacht en <w>vlezig</w> aan toen ze erin beet.",
                            "target_lang_translations": {
                                "de": "Der Pfirsich fühlte sich herrlich weich und <w>fleischig</w> an, als sie hineinbiss."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vlezige vruchten",
                        "vlezige bladeren"
                    ],
                    "target_lang_definitions": {
                        "de": "mit viel Fruchtfleisch; fest und saftig (von Früchten, Gemüse oder Pflanzenteilen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fleischig",
                                "target_lang_sense_clarification": "reich an Fruchtfleisch, fest"
                            },
                            {
                                "target_lang_word": "dickfleischig",
                                "target_lang_sense_clarification": "besonders bei Blättern oder Früchten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b6af26e-e18a-318e-a7a4-7aba3e86cb7a",
                    "sense_definition": "met veel spier- of vetweefsel op het lichaam; mollig of corpulent",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>vlezige</w> man at veel te veel tijdens het diner.",
                            "target_lang_translations": {
                                "de": "Der <w>korpulente</w> Mann aß während des Abendessens viel zu viel."
                            }
                        },
                        {
                            "text": "Hij begroette ons hartelijk met zijn grote, <w>vlezige</w> handen.",
                            "target_lang_translations": {
                                "de": "Er begrüßte uns herzlich mit seinen großen, <w>fleischigen</w> Händen."
                            }
                        }
                    ],
                    "synonyms": [
                        "dik",
                        "corpulent",
                        "gezet",
                        "mollig"
                    ],
                    "common_phrases": [
                        "vlezige handen"
                    ],
                    "target_lang_definitions": {
                        "de": "mit viel Muskel- oder Fettgewebe; mollig, korpulent oder dicklich (besonders von Körperteilen oder Personen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fleischig",
                                "target_lang_sense_clarification": "voll, dicklich (z. B. Hände, Lippen, Körper)"
                            },
                            {
                                "target_lang_word": "korpulent",
                                "target_lang_sense_clarification": "beleibt, voll gebaut"
                            },
                            {
                                "target_lang_word": "mollig",
                                "target_lang_sense_clarification": "rundlich, füllig"
                            }
                        ]
                    }
                }
            ]
        }
    ]
