                        "sense_id": "1de04235-a640-3aca-97b4-7d2cc207bc9a",
                        "entry_id": "2d389827-6aec-377e-9bc2-dbf7416075af",
                        "glosses": [
                            "ruimte die een donkere plaats verbindt met een verlichte plaats op zo'n manier dat er geen licht naar de donkere plaats kan ontsnappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd706e79-7d7b-42d5-b5d5-086dd50a5610",
                                "sense_id": "1de04235-a640-3aca-97b4-7d2cc207bc9a",
                                "text": "Eindelijk bereikten we de compagniescommandopost. Een zwaar canvas gordijn werd weggeschoven. Naar binnen. Een volgend gordijn ging open, terwijl het gordijn achter je weer zorgvuldig gesloten was. Een lichtsluis heette dat."
                            }
                        ]
                    },
                    {
                        "sense_id": "89e7d02b-64c3-3b3c-b353-4a6ffa998302",
                        "entry_id": "2d389827-6aec-377e-9bc2-dbf7416075af",
                        "glosses": [
                            "constructie waardoor indirect daglicht in een ruimte binnen een gebouw kan komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1094c3-fb56-4d7f-85fa-802594534d97",
                                "sense_id": "89e7d02b-64c3-3b3c-b353-4a6ffa998302",
                                "text": "In de Janne Bouwensstraat is vanochtend de 14-jarige J. Spijkers door een lichtsluis in het dak gevallen en tien meter lager terechtgekomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "30136672-ccad-3ac2-be88-11dc9461b7d5",
                        "entry_id": "2d389827-6aec-377e-9bc2-dbf7416075af",
                        "glosses": [
                            "combinatie van lichtbron en lichtsensor om vast te stellen of zich daartussen een voorwerp bevindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ddecd03-3224-4c2c-8603-6a9f2f8fb112",
                                "sense_id": "30136672-ccad-3ac2-be88-11dc9461b7d5",
                                "text": "De optie die wij gaan toepassen is het plaatsen van een lichtsluis die bij het donker worden (als de trein in de lichtsluis komt) de bezetmelder activeert en de loc laat stoppen."
                            }
                        ]
                    }
