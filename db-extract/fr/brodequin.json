        "fr-extract.jsonl": [
            {
                "entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                "word": "brodequin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4a29bf2-024f-4241-9cc2-4148e649f104",
                        "entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "tags": [
                            "plural"
                        ],
                        "form": "brodequins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                        "entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "glosses": [
                            "Chaussure de peau ou d’étoffe qui couvre le pied et le bas de la jambe et se lace sur le dessus du pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d9311d-a899-4fee-ad79-7f92a26f95f2",
                                "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                                "text": "Isaac, […], se jeta aux pieds du généreux outlaw, et, frottant sa barbe contre ses brodequins, il cherchait à baiser le pan de sa casaque verte."
                            },
                            {
                                "example_id": "17acacd2-28d6-452f-b007-1a8d22e2b99f",
                                "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                                "text": "Les mouvements de la marche relevaient par instants la robe de la jeune fille, et permettaient de voir, au-dessus des brodequins, la rondeur d’une jambe finement moulée par un bas de soie à jours."
                            },
                            {
                                "example_id": "c7b1db82-144c-4ca1-b845-28c5fe038a72",
                                "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                                "text": "Ses mains, grassement effilées, faisaient se jouer à travers les œillets le lacet du brodequin comme une navette agile, sans songer au jupon qu’il fallait rabattre."
                            },
                            {
                                "example_id": "9234e929-5331-45f4-ac30-4626b83aa81b",
                                "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                                "text": "Elle avait une robe en soie blanche brochée d’or ; ses brodequins étaient en satins bleus également brodés en or ; ses bas étaient en soie et d’une finesse extrême."
                            },
                            {
                                "example_id": "9a624fd4-fb41-4ebc-9d06-b804cf2922c8",
                                "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                                "text": "Un beau matin il s’est amené ici avec une paire de brodequins à recoudre."
                            },
                            {
                                "example_id": "37175bf8-2b1e-455d-84be-c56d7d1e4618",
                                "sense_id": "13d039c5-6480-39b7-96a6-34ed2cb5a728",
                                "text": "Morel s’éloigna du pas lourd de ses brodequins. Bien qu’il ne mît plus jamais les pieds dans la boue, il avait conservé l’habitude des souliers de chasse, son premier luxe, bien avant l’achat de sa première presse à injecter, quand il était encore tâcheron, avec deux compagnons."
                            }
                        ]
                    },
                    {
                        "sense_id": "d62f75c0-2b86-38b0-b13c-374fbf276a23",
                        "entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "glosses": [
                            "Chaussure que portaient les acteurs de comédie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "note": "S’oppose ainsi au cothurne et au socque des acteurs de tragédie",
                        "examples": []
                    },
                    {
                        "sense_id": "48e38ce8-ed01-3b24-b7d1-6472c7a6722b",
                        "entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "glosses": [
                            "Chaussure que portent les coureurs cyclistes."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b51e624f-3a08-4349-961c-d71c2b04d6a9",
                                "sense_id": "48e38ce8-ed01-3b24-b7d1-6472c7a6722b",
                                "text": "Il accéléra et passa à quarante-cinq à l’heure. Le sang coulait de la cuisse sur les jambes et sur les brodequins."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c3f3938-9e2d-3846-bd2c-da1ee14dcc79",
                        "entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "glosses": [
                            "Torture qui se donnait avec des planches et des coins dont on serrait fortement les jambes de l’accusé."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b44a9176-e87b-49c8-9d31-292fcaf71972",
                                "sense_id": "0c3f3938-9e2d-3846-bd2c-da1ee14dcc79",
                                "text": "Supplice des brodequins."
                            },
                            {
                                "example_id": "b452bc79-b125-420f-bb0c-303f57923562",
                                "sense_id": "0c3f3938-9e2d-3846-bd2c-da1ee14dcc79",
                                "text": "À vrai dire, les brodequins de fer rougi dont les nains chaussaient la marâtre de Blanche-Neige, les flammes où cuisait Lucifer, n’évoquaient jamais pour moi l’image d’une chair souffrante."
                            },
                            {
                                "example_id": "758e7bbd-71f7-4fe2-8717-267b3af8c4c6",
                                "sense_id": "0c3f3938-9e2d-3846-bd2c-da1ee14dcc79",
                                "text": "Il y eut, dans l’histoire de la question en France, un supplice fameux dit « des brodequins », destiné à briser les tibias de ceux qu’on voulait faire avouer : quatre coins enfoncés au marteau entre l’os et l’étau de planches qui enserrait le mollet pour la « question ordinaire », huit coins pour la « question extraordinaire »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5a9e229-f978-4f33-89a6-45fd6ebff721",
                        "source_entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "target_lang_word": "brodequin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brodequin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36d5c7d3-71f6-357b-aa92-9f8a82e602b2",
                                        "entry_id": "0bf6412f-b7a4-3af1-844f-db4a6aed9d7c",
                                        "glosses": [
                                            "A buskin or half-boot."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5d592a-2b19-41f1-8e7c-dc9f2397a2ab",
                                                "sense_id": "36d5c7d3-71f6-357b-aa92-9f8a82e602b2",
                                                "text": "Then followed the young monarch and his chevaliers, dressed after the Roman fashion—the cuirass of gold, the robes of frosted silver, the brodequins wrought with gold and silver mixed; and the casques were of silver, with white plumes tipped with scarlet. All were masked; but the King was easily distinguished by his snowy charger, whose mane was fantastically knitted with scarlet ribands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47e44834-342a-47e3-9dce-d4529c95fea3",
                        "source_entry_id": "327db645-d962-3c5d-9858-e50b0d36a308",
                        "target_lang_word": "buskin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buskin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a515b6b6-db0e-3dba-b203-6b91f98b7cc5",
                                        "entry_id": "9dd64eb1-a065-3e45-b7af-e97a34ab4cc9",
                                        "glosses": [
                                            "A soft boot reaching to calf or knee height."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02bd9bbf-0f74-4a57-9ac5-0242c6c1ac68",
                                                "sense_id": "a515b6b6-db0e-3dba-b203-6b91f98b7cc5",
                                                "text": "She, having hong upon a bough on high / Her bow and painted quiver, had unlaste / Her silver buskins from her nimble thigh […]"
                                            },
                                            {
                                                "example_id": "f1dd4ccf-3713-4d57-9434-34f62979c4b1",
                                                "sense_id": "a515b6b6-db0e-3dba-b203-6b91f98b7cc5",
                                                "text": "With this knife also, he will joynt a Deere, or any beast, shape his shooes, buskins, mantels, etc."
                                            },
                                            {
                                                "example_id": "f7d9e073-563a-45da-9706-4735e2b092b1",
                                                "sense_id": "a515b6b6-db0e-3dba-b203-6b91f98b7cc5",
                                                "text": "Isaac, relieved of one half of his apprehensions, by learning that his daughter lived, and might possibly be ransomed, threw himself at the feet of the generous Outlaw, and, rubbing his beard against his buskins, sought to kiss the hem of his green cassock."
                                            },
                                            {
                                                "example_id": "1c17a6fa-4d59-48ee-80ac-dfb85eaba909",
                                                "sense_id": "a515b6b6-db0e-3dba-b203-6b91f98b7cc5",
                                                "text": "And Dandolo took for Venice three eights of the city, including the merchants’ quarter, where a Venetian governor was soon strutting about in the scarlet buskins that had once been the prerogative of the Emperors of the East."
                                            },
                                            {
                                                "example_id": "ecc1ea69-4083-468c-9bbf-8eae55a99a75",
                                                "sense_id": "a515b6b6-db0e-3dba-b203-6b91f98b7cc5",
                                                "text": "Alexius was acclaimed with the imperial titles and formally shod with the purple buskins, embroidered in gold with the double-headed eagles of Byzantium [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0128dd24-a66a-3756-85b3-e994a10dff75",
                                        "entry_id": "9dd64eb1-a065-3e45-b7af-e97a34ab4cc9",
                                        "glosses": [
                                            "A pontifical vestment in the form of a silk stocking, sometimes embroidered or interwoven with gold thread, reaching to the base of the knee and worn over one’s regular socks but under episcopal sandals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e6f047b-aed2-3199-8223-a4b48680a5db",
                                        "entry_id": "9dd64eb1-a065-3e45-b7af-e97a34ab4cc9",
                                        "glosses": [
                                            "A type of soft calf- or knee-high boot that laces up the front, sometimes featuring open toes or thick soles, worn in the Greco-Roman world by hunters and horsemen, as well as by actors in Athenian tragedy."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "537e3bc9-63e8-4a24-9586-fa87f7c56216",
                                                "sense_id": "3e6f047b-aed2-3199-8223-a4b48680a5db",
                                                "text": "One thing we do know about the staging of Greek plays is that the tragic actors wore buskins on their feet that elevated them several inches above the ground. (They also wore masks.) But the members of the chorus did not wear buskins, though the sometimes wore masks. The comparison between the size of the tragic protagonists, on the one hand, and the members of the chorus, on the other hand, was thus highly significant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70601636-4c60-3765-8cf6-8e55c08c6e71",
                                        "entry_id": "9dd64eb1-a065-3e45-b7af-e97a34ab4cc9",
                                        "glosses": [
                                            "Tragic drama; tragedy."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddefc2b3-3fe0-49b6-801f-2b0696e128ba",
                                                "sense_id": "70601636-4c60-3765-8cf6-8e55c08c6e71",
                                                "text": "Such an undertaking by no means benefits the low-heeled buskin of modern fiction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1ce9cab-aaf2-3adc-8eeb-56a242f9c6cd",
                                        "entry_id": "9dd64eb1-a065-3e45-b7af-e97a34ab4cc9",
                                        "glosses": [
                                            "An instrument of torture for the foot; bootikin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
