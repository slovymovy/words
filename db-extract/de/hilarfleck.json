                "senses": [
                    {
                        "sense_id": "1785a340-db15-3aac-ba88-fd413afb8fd8",
                        "entry_id": "13a9e20f-d9e0-33e8-8181-6cfad71d35f8",
                        "glosses": [
                            "deutlich begrenzte Stelle der Pilzsporenwand, die oberhalb des Apiculi (Appendix oder \\\"Sporenstielchens\\\") liegt, die bei ornamentierten Sporen leicht eingedellt, glatt oder nur schwach ornamentiert ist"
                        ],
                        "tags": [
                            "Mykologie"
                        ],
                        "examples": [
                            {
                                "example_id": "71df2a92-d7c0-4885-97e3-a83249743fe1",
                                "sense_id": "1785a340-db15-3aac-ba88-fd413afb8fd8",
                                "text": "Hilarfleck (\"tache\") mittelgroß, relativ dunkel; (7,6 -) 8,2 -8,9 x (6,2 -) 6,6 -7,6 µm."
                            },
                            {
                                "example_id": "96357a2c-01a4-4743-9adb-cca7e8c5501e",
                                "sense_id": "1785a340-db15-3aac-ba88-fd413afb8fd8",
                                "text": "Sporen 8–11 (13)/6–8 µm isoliert warzig stumpf stachelig nur ganz selten einige Warzen verbunden, Ornamentation 0,3–0,5–1 µm hoch, Hilarfleck deutlich."
                            },
                            {
                                "example_id": "488d8b82-d4bd-4d35-9cbd-9f1eb8896138",
                                "sense_id": "1785a340-db15-3aac-ba88-fd413afb8fd8",
                                "text": "Der in der Nähe des Stielchens liegende Hilarfleck kann oft deutlich angefärbt sein."
                            },
                            {
                                "example_id": "9a7c7ef9-2ccf-41e9-a515-c5e59e9b5f7e",
                                "sense_id": "1785a340-db15-3aac-ba88-fd413afb8fd8",
                                "text": "„Der Hilarfleck ist bei Milchlingen und Täublingen ein wichtiges Bestimmungsmerkmal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
