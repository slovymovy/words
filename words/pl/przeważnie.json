                {
                    "sense_id": "2315414f-8617-300b-9934-923a71519a27",
                    "sense_definition": "W przeważającej części, w największym stopniu lub liczbie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na widowni siedzieli <w>przeważnie</w> młodzi ludzie.",
                            "target_lang_translations": {
                                "ru": "В зрительном зале сидели <w>преимущественно</w> молодые люди.",
                                "en": "The audience was <w>predominantly</w> young people.",
                                "zh": "观众席上坐着的<w>主要</w>是年轻人。"
                            }
                        },
                        {
                            "text": "Jego dieta składa się <w>przeważnie</w> ze świeżych warzyw.",
                            "target_lang_translations": {
                                "ru": "Его диета состоит <w>главным образом</w> из свежих овощей.",
                                "en": "His diet consists <w>mostly</w> of fresh vegetables.",
                                "zh": "他的饮食<w>主要</w>由新鲜蔬菜组成。"
                            }
                        }
                    ],
