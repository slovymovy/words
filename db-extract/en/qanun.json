                                "example_id": "cda5b225-d211-4f63-9a61-0fb368a82fa2",
                                "sense_id": "911288b1-b168-3bae-83b9-d9a38574717e",
                                "text": "WISPS of mournful tunes from a cane flute mingled with the plucking, jangling arabesques of the zitherlike qanun, the oud and gentle drums."
                            }
                        ]
                    }
                ],
