        "fr-extract.jsonl": [
            {
                "entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                "word": "intelligible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b2fa31b-e442-4773-962c-6c6e58a1b666",
                        "entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "intelligibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3df7735b-116c-339c-bc11-abfb6186dc49",
                        "entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                        "glosses": [
                            "Qui peut être compris par l’intelligence, clair pour l'esprit abstrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f0a1f5c-758c-414d-aedf-12b7bda1a097",
                                "sense_id": "3df7735b-116c-339c-bc11-abfb6186dc49",
                                "text": "Jusqu’ici j’ai taché de me rendre intelligible à tout le monde, mais pour ce traité je crains, qu’il ne pourra être lu que par ceux, qui savent déjà ce qui est dans les livres de Géométrie."
                            },
                            {
                                "example_id": "65ba41fc-2b01-43b0-ba29-b32b941cd795",
                                "sense_id": "3df7735b-116c-339c-bc11-abfb6186dc49",
                                "text": "Cela n’est pas intelligible, dit Philanthe. Non, répondit Eudoxe, ce n’est pas là tout à fait du galimatias, ce n’est que du phébus."
                            },
                            {
                                "example_id": "cc253d1a-7830-4efd-88c9-400f0791f045",
                                "sense_id": "3df7735b-116c-339c-bc11-abfb6186dc49",
                                "text": "Il se remettait alors à jouer avec sa sœur, […] qui parlait déjà plus distinctement que lui, dont les vagues paroles et les idées confuses étaient à peine intelligibles pour ses parents."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddbecfb0-3923-3331-8f82-c6e829b666e8",
                        "entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                        "glosses": [
                            "Qui s’adresse à l’intelligence et non pas aux sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f9fb72c-bdad-4520-b74f-973f4dba843e",
                                "sense_id": "ddbecfb0-3923-3331-8f82-c6e829b666e8",
                                "text": "Les idées de Platon constituent un monde intelligible. La réalité sensible dépend de la réalité intelligible."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8fb44a7-8a36-354f-a4a8-32e01bbbd5ed",
                        "entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                        "glosses": [
                            "Qui peut être compris, perçu distinctement par l’oreille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32f3a0e-dacf-49d4-bf7e-5a6b2c00f737",
                                "sense_id": "b8fb44a7-8a36-354f-a4a8-32e01bbbd5ed",
                                "text": "Parler à haute et intelligible voix. Des sons distincts et intelligibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f5696df-9061-4173-b044-89dba054762b",
                        "source_entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                        "target_lang_word": "verständlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verständlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38a5aa72-a6df-3821-ab53-f62d195f6373",
                                        "entry_id": "610315b1-5e9f-3ce1-a2e2-0a8f65bbf979",
                                        "glosses": [
                                            "praktisch gut aufzunehmen und klar zu hören, zu verstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37abd16-2eb1-418f-bd5c-7e0ff00baa53",
                                                "sense_id": "38a5aa72-a6df-3821-ab53-f62d195f6373",
                                                "text": "Hier hinten ist es nicht mehr verständlich, was da vorne gesprochen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fdc3b61-cef7-315d-9805-0dd5671d4e8c",
                                        "entry_id": "610315b1-5e9f-3ce1-a2e2-0a8f65bbf979",
                                        "glosses": [
                                            "mit dem Verstand gut nachzuvollziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c1e8f0-1a08-43af-b34a-f92816751e67",
                                                "sense_id": "4fdc3b61-cef7-315d-9805-0dd5671d4e8c",
                                                "text": "„…schwer zu trennen. Lichtschein, Glanz, Schimmer, Helligkeit - das ist des einen Wortes harmlose Urbedeutung (Sonnenschein). Kühn, aber noch verständlich, haben unsere Ahnen daraus den zweiten Wortsinn abgeleitet: etwa, worauf ein Lichtschein fällt und fallen soll - Schein, Bescheinigung, Beleg, Attest und Urkunde (Geldschein, Trauschein, Totenschein). - Gut - wenn da nicht im 15. Jahrhundert eine dritte Bedeutung hinzugetreten wäre, und die schlägt der zweiten ins Gesicht: Aus dem Lichtschein bildete sich zusätzlich die Lichtspiegelung heraus, die Fata Morgana, der trügerische Schein, die Sinnestäuschung, die Täuschung überhaupt (Scheinblüte, Scheinschwangerschaft), ja, der Betrug (Scheinehe). Unter demselben Begriffsdach also tummeln sich die beglaubigte Wahrheit, der Irrtum und die Lüge. Unsere Gene sind auf Lug und Trug programmiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0381e65c-bd57-3a68-bc47-5f761724b058",
                                        "entry_id": "610315b1-5e9f-3ce1-a2e2-0a8f65bbf979",
                                        "glosses": [
                                            "(auch) emotional gut nachzuvollziehen, wenn man sich in die Situation hineinversetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ae7b98-a871-42a9-9ffc-750a54dd92a5",
                                                "sense_id": "0381e65c-bd57-3a68-bc47-5f761724b058",
                                                "text": "„Verständlich - lief doch immer noch die Klage ihrer Stiefmutter wegen vorsätzlicher Körperverletzung gegen ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e895452-1cbc-4db4-a8b1-e6d86d680665",
                        "source_entry_id": "62048a03-5470-3448-95ab-ef196d889d29",
                        "target_lang_word": "vernehmbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
