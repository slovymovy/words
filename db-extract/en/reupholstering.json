                                "sense_id": "80c1a443-041c-3894-b64e-4f8af277cb8c",
                                "text": "These are strongly built and will survive any number of reupholsterings."
                            },
                            {
                                "example_id": "de8c14e3-929d-48cf-8993-f69149996220",
                                "sense_id": "80c1a443-041c-3894-b64e-4f8af277cb8c",
                                "text": "After several reupholsterings, the wood may no longer function to hold the upholstery in place and must be reinforced."
                            }
                        ]
                    }
