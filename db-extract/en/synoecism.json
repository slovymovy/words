                                "sense_id": "b6e08d09-7d40-3a68-b6ab-c42d0b9dc875",
                                "text": "They always remained separate states and were never synoikised."
                            },
                            {
                                "example_id": "a523220e-766d-4518-b7be-c137096eed58",
                                "sense_id": "b6e08d09-7d40-3a68-b6ab-c42d0b9dc875",
                                "text": "Legends...current before the villages were synoecised into Athens."
                            },
                            {
                                "example_id": "80f6e57a-4455-4b93-b416-b42ceaec18f7",
                                "sense_id": "b6e08d09-7d40-3a68-b6ab-c42d0b9dc875",
                                "text": "When the town was first formed...by the synœcism of the neighboring villages."
                            }
