                "senses": [
                    {
                        "sense_id": "d406e034-d92b-320c-882c-41d051f44212",
                        "entry_id": "10c59bc3-3775-358d-bdd3-22013c12ced1",
                        "glosses": [
                            "Donner un caractère néolibéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64cae71c-e871-43ad-ae96-70e743d73443",
                                "sense_id": "d406e034-d92b-320c-882c-41d051f44212",
                                "text": "La volonté de totalement néolibéraliser la France s'appelle \"réalisme\" et parfois \"pragmatisme\"."
                            },
                            {
                                "example_id": "50ca8715-cffc-4823-9306-71eca5c547de",
                                "sense_id": "d406e034-d92b-320c-882c-41d051f44212",
                                "text": "Néolibéraliser la ville fordiste."
                            },
                            {
                                "example_id": "3b303672-7eee-48ad-94a9-322ac8cccaa7",
                                "sense_id": "d406e034-d92b-320c-882c-41d051f44212",
                                "text": "En ce sens, les images d'horreur de New York sont porteuses d'un message qui n'est pas encore élucidé : un Etat, un pays peuvent se néolibéraliser à mort."
                            }
                        ]
                    }
