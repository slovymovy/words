                    {
                        "sense_id": "02615cc3-0f38-33fc-83fa-d3605a064533",
                        "entry_id": "6ac9b6a4-c0c0-3c32-b416-05b46673a5ba",
                        "glosses": [
                            "A dealer or merchant, especially an itinerant one."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1176eaba-6a35-474b-8fb0-0e26b4a9c419",
                                "sense_id": "02615cc3-0f38-33fc-83fa-d3605a064533",
                                "text": "Done. They are gone: the sum is here in bank, my Face. I would we knew another chapman now would buy 'em outright."
                            },
                            {
                                "example_id": "69e1f3e4-f68b-41d3-ab3e-0c7a32fc597c",
                                "sense_id": "02615cc3-0f38-33fc-83fa-d3605a064533",
                                "text": "When chapmen billies leave the street, / And drouthy neibors, neibors meet, / As market days are wearing late, / An' folk begin to tak the gate"
                            }
                        ]
                    },
                    {
                        "sense_id": "43690c1b-469a-338f-be27-da7cdf65fdb6",
