                        "target_lang_word": "Bärenmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärenmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "daab7acd-ffdb-3ad3-af63-faccea534096",
                                        "entry_id": "c8d6687d-df88-333c-8200-b6810cf5f93d",
                                        "glosses": [
                                            "Mütze/Kopfbedeckung, die aus Bärenfell hergestellt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b94e4d0-3733-48a7-b8eb-398c5d300439",
                                                "sense_id": "daab7acd-ffdb-3ad3-af63-faccea534096",
                                                "text": "Mein Opa trug eine Bärenmütze, die er von seinem Großonkel geschenkt bekommen hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e360b62-de81-48e3-919a-e6ecfa624b9a",
                        "source_entry_id": "e73951f1-c608-3dd7-8c62-634dca2c4f4d",
                        "source_sense_id": "b5e27f67-a520-36a4-8bbe-dd7df420ffd7",
                        "target_lang_word": "Bärenfellmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärenfellmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                        "entry_id": "aaea9d65-1392-306f-baf2-a4911f59b763",
                                        "glosses": [
                                            "Mütze, die aus Bärenfell gefertigt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd58710-aba5-4e1d-b658-0a7c04fafeeb",
                                                "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                                "text": "Für die Herstellung von Bärenfellmützen werden viele Bärenfelle benötigt."
                                            },
                                            {
                                                "example_id": "0eb7d09e-c012-4f3e-a513-87bf80e81b4e",
                                                "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                                "text": "„Die Trommler der Musikkapelle kreuzten die Schlegel über die Bärenfellmützen.“"
                                            },
                                            {
                                                "example_id": "a09eda66-f7cf-4628-81bc-e41479a6f303",
                                                "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                                "text": "„Staunend sah das Volk die blauen Jacken der Grenadiere, die weißen Röcke der Spanier, die schwarzen Bärenfellmützen, die bunten Standarten und Wimpel durch die rauchenden Trümmer ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
