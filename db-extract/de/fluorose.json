                        "entry_id": "eb5b90a7-9601-35e1-8ec7-32a88223fd05",
                        "glosses": [
                            "körperliche Schädigung durch Aufnahme einer zu großen Menge an Fluor oder Fluorverbindungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4db1f7-ad17-4b9c-8cb4-a85cdca9aa5f",
                                "sense_id": "75724fd9-c861-3153-b5a2-5a2f8f65b648",
                                "text": "„Denn der Stoff schützt zwar vor Karies, zu viel davon kann aber zu einer Fluorose führen – sie sorgt später für unschöne Flecken auf den Zähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
