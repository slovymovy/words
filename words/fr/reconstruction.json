                    ]
                },
                {
                    "sense_id": "50bd5751-3c07-35a4-bfa3-8ac1dbe0b79e",
                    "sense_definition": "Rétablissement ou réorganisation d'un État, d'une économie ou d'un tissu social après une crise grave ou une guerre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "societe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a présenté un vaste plan de <w>reconstruction</w> économique après la fin des hostilités."
                        },
                        {
                            "text": "Des mesures urgentes sont nécessaires pour favoriser la <w>reconstruction</w> du lien de confiance avec les citoyens."
                        }
                    ],
                    "synonyms": [
                        "refondation",
                        "réorganisation"
                    ],
                    "common_phrases": [
                        "reconstruction économique",
                        "reconstruction du pays"
                    ]
                },
                {
                    "sense_id": "db910167-6f75-3677-b0df-c1ba31893644",
                    "sense_definition": "Processus psychologique ou moral par lequel une personne surmonte une grave épreuve ou un traumatisme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le travail de <w>reconstruction</w> après un deuil difficile demande beaucoup de patience et de soutien."
                        },
                        {
                            "text": "Elle a entrepris une longue thérapie pour entamer sa <w>reconstruction</w> personnelle."
