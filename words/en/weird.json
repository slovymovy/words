{
    "word_family": [
        "weirdly",
        "weirdness",
        "weirdo"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0b2cc56-fcd2-3264-b600-9d9ae2d380f1",
                    "sense_definition": "Deviating from the normal; bizarre or unusual.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "strange_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>weird</w> to see my teacher at the supermarket.",
                            "target_lang_translations": {
                                "ru": "Было <w>стра́нно</w> увидеть учителя в супермаркете.",
                                "tr": "Süpermarkette öğretmenimi görmek <w>tuhaftı</w>.",
                                "zh": "在超市看到我的老师真是太<w>奇怪</w>了。"
                            }
                        },
                        {
                            "text": "She has a really <w>weird</w> sense of humor.",
                            "target_lang_translations": {
                                "ru": "У неё очень <w>стра́нное</w> чувство юмора.",
                                "tr": "Gerçekten çok <w>garip</w> bir mizah anlayışı var.",
                                "zh": "她的幽默感真的很<w>古怪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strange",
                        "odd",
                        "bizarre",
                        "peculiar",
                        "unusual",
                        "eccentric"
                    ],
                    "antonyms": [
                        "normal",
                        "ordinary",
                        "conventional",
                        "standard",
                        "regular"
                    ],
                    "common_phrases": [
                        "weird thing",
                        "weird feeling",
                        "really weird",
                        "act weird",
                        "look weird"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняющийся от нормы; странный или необычный.",
                        "tr": "Normalden sapma gösteren; tuhaf veya alışılmadık.",
                        "zh": "偏离常态的；古怪的或不寻常的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стра́нный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "чудно́й",
                                "target_lang_sense_clarification": "эксцентричный, забавный"
                            },
                            {
                                "target_lang_word": "необы́чный",
                                "target_lang_sense_clarification": "отличающийся от привычного"
                            },
                            {
                                "target_lang_word": "причу́дливый",
                                "target_lang_sense_clarification": "затейливый, оригинальный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tuhaf",
                                "target_lang_sense_clarification": "genel anlamda alışılmadık"
                            },
                            {
                                "target_lang_word": "garip",
                                "target_lang_sense_clarification": "alışılmışın dışında, şaşırtıcı"
                            },
                            {
                                "target_lang_word": "acayip",
                                "target_lang_sense_clarification": "olağana aykırı, yadırganan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇怪",
                                "target_lang_sense_clarification": "通用术语，表示不寻常"
                            },
                            {
                                "target_lang_word": "古怪",
                                "target_lang_sense_clarification": "形容性格或行为异于常人"
                            },
                            {
                                "target_lang_word": "离奇",
                                "target_lang_sense_clarification": "形容事物非常罕见或不合常理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd07423-3fe8-3a6d-b117-02b2c0cbd13f",
                    "sense_definition": "Suggestive of the supernatural; unearthly or uncanny.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strange_supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>weird</w> light glowed in the forest at night.",
                            "target_lang_translations": {
                                "ru": "Ночью в лесу светился <w>таи́нственный</w> свет.",
                                "tr": "Gece ormanda <w>esrarengiz</w> bir ışık parıldıyordu.",
                                "zh": "夜晚的森林里闪烁着一种<w>诡异</w>的光。"
                            }
                        },
                        {
                            "text": "The old house had a <w>weird</w> and spooky atmosphere.",
                            "target_lang_translations": {
                                "ru": "В старом доме была <w>жу́ткая</w> и пугающая атмосфера.",
                                "tr": "Eski evin <w>tekinsiz</w> ve korkutucu bir atmosferi vardı.",
                                "zh": "那座老房子有一种<w>阴森</w>且恐怖的氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eerie",
                        "uncanny",
                        "unearthly",
                        "supernatural",
                        "spooky"
                    ],
                    "antonyms": [
                        "natural",
                        "earthly"
                    ],
                    "common_phrases": [
                        "weird sisters",
                        "weird light"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий о сверхъестественном; неземной или жуткий.",
                        "tr": "Doğaüstünü çağrıştıran; dünyevi olmayan veya ürkütücü/tekinsiz.",
                        "zh": "暗示超自然现象的；阴森的或诡异的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверхъесте́ственный",
                                "target_lang_sense_clarification": "мистический"
                            },
                            {
                                "target_lang_word": "потусторо́нний",
                                "target_lang_sense_clarification": "не из этого мира"
                            },
                            {
                                "target_lang_word": "жу́ткий",
                                "target_lang_sense_clarification": "пугающий, зловещий"
                            },
                            {
                                "target_lang_word": "таи́нственный",
                                "target_lang_sense_clarification": "загадочный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esrarengiz",
                                "target_lang_sense_clarification": "sırlarla dolu, gizemli"
                            },
                            {
                                "target_lang_word": "doğaüstü",
                                "target_lang_sense_clarification": "fizik kurallarını aşan"
                            },
                            {
                                "target_lang_word": "tekinsiz",
                                "target_lang_sense_clarification": "ürkütücü ve garip bir hava veren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诡异",
                                "target_lang_sense_clarification": "形容神秘且令人不安"
                            },
                            {
                                "target_lang_word": "阴森",
                                "target_lang_sense_clarification": "形容环境令人恐惧"
                            },
                            {
                                "target_lang_word": "神秘",
                                "target_lang_sense_clarification": "难以捉摸的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c081122-6f9d-38f6-b370-71387e0b6bbb",
                    "sense_definition": "Acronym of Western, educated, industrialized, rich and democratic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many psychological studies rely too heavily on <w>WEIRD</w> participants.",
                            "target_lang_translations": {
                                "ru": "Многие психологические исследования слишком сильно полагаются на <w>WEIRD</w>-участников.",
                                "tr": "Birçok psikolojik çalışma aşırı derecede <w>WEIRD</w> katılımcılara dayanmaktadır.",
                                "zh": "许多心理学研究过于依赖 WEIRD 样本群体。"
                            }
                        },
                        {
                            "text": "The results may not apply to people outside of <w>WEIRD</w> societies.",
                            "target_lang_translations": {
                                "ru": "Результаты могут быть неприменимы к людям вне обществ <w>WEIRD</w>.",
                                "tr": "Sonuçlar <w>WEIRD</w> toplumlarının dışındaki insanlar için geçerli olmayabilir.",
                                "zh": "这些结果可能不适用于 WEIRD 社会之外的人群。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "WEIRD societies",
                        "WEIRD populations"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "used in sociology and psychology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним, обозначающий западные, образованные, промышленные, богатые и демократические общества.",
                        "tr": "Batılı, eğitimli, sanayileşmiş, zengin ve demokratik sözcüklerinin İngilizce baş harflerinden oluşan kısaltma.",
                        "zh": "西方、受过教育、工业化、富裕和民主社会的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "WEIRD",
                                "target_lang_sense_clarification": "аббревиатура (западный, образованный, промышленный, богатый, демократический)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "WEIRD",
                                "target_lang_sense_clarification": "psikoloji ve sosyolojide kullanılan terimsel kısaltma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "WEIRD",
                                "target_lang_sense_clarification": "心理学和社会学中使用的缩写词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e7ac2afc-c5d2-3e30-8652-685ab1d4b854",
                    "sense_definition": "In a strange manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "strange_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My computer has been acting <w>weird</w> all morning.",
                            "target_lang_translations": {
                                "ru": "Мой компьютер всё утро ведёт себя <w>стра́нно</w>.",
                                "tr": "Bilgisayarım bütün sabah <w>tuhaf</w> davranıyor.",
                                "zh": "我的电脑整个上午都表现得<w>奇怪</w>。"
                            }
                        },
                        {
                            "text": "Why are you looking at me <w>weird</w>?",
                            "target_lang_translations": {
                                "ru": "Почему ты так <w>стра́нно</w> на меня смотришь?",
                                "tr": "Bana neden öyle <w>garip</w> bakıyorsun?",
                                "zh": "你为什么<w>奇怪</w>地看着我？"
                            }
                        }
                    ],
                    "synonyms": [
                        "strangely",
                        "funny",
                        "oddly",
                        "unusually"
                    ],
                    "antonyms": [
                        "normally"
                    ],
                    "common_phrases": [
                        "act weird",
                        "talk weird",
                        "look weird"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "standard adverb is weirdly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Странным образом.",
                        "tr": "Garip veya tuhaf bir şekilde.",
                        "zh": "以奇怪的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стра́нно",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tuhaf",
                                "target_lang_sense_clarification": "zarf olarak (tuhaf bir şekilde)"
                            },
                            {
                                "target_lang_word": "garip",
                                "target_lang_sense_clarification": "zarf olarak (garip biçimde)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇怪地",
                                "target_lang_sense_clarification": "副词，表示以不寻常的方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f62e07c-d96b-3af3-a3dc-e286acee287b",
                    "sense_definition": "One's personal eccentricity or strange nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weirdness_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should embrace your <w>weird</w> and be yourself.",
                            "target_lang_translations": {
                                "ru": "Тебе следует принять свою <w>стра́нность</w> и быть собой.",
                                "tr": "Kendi <w>tuhaflığını</w> kabullenmeli ve kendin olmalısın.",
                                "zh": "你应该拥抱自己的<w>怪癖</w>，做真实的自己。"
                            }
                        },
                        {
                            "text": "I like her because she is not afraid to show her <w>weird</w>.",
                            "target_lang_translations": {
                                "ru": "Она мне нравится, потому что не боится показывать свои <w>причу́ды</w>.",
                                "tr": "Onu seviyorum çünkü kendi <w>garipliğini</w> göstermekten korkmuyor.",
                                "zh": "我喜欢她，因为她不怕展现自己的<w>古怪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentricity",
                        "quirkiness",
                        "oddness"
                    ],
                    "antonyms": [
                        "normality"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личная эксцентричность или странность характера.",
                        "tr": "Kişinin kendine has tuhaflığı veya garip yapısı.",
                        "zh": "个人的怪癖或古怪的本性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стра́нность",
                                "target_lang_sense_clarification": "черта характера"
                            },
                            {
                                "target_lang_word": "причу́да",
                                "target_lang_sense_clarification": "особенность поведения"
                            },
                            {
                                "target_lang_word": "чуди́нка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tuhaflık",
                                "target_lang_sense_clarification": "kişisel sıradışılık"
                            },
                            {
                                "target_lang_word": "gariplik",
                                "target_lang_sense_clarification": "özgün/farklı olma durumu"
                            }
                        ],
                        "zh": [
