    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef31eeb2-2840-3b6b-8c60-246dd0e56839",
                    "sense_definition": "iets globaal bestuderen, bekijken of bespreken om het te begrijpen of te controleren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bestuderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor de vergadering <w>namen</w> we nog even de belangrijkste punten <w>door</w>.",
                            "target_lang_translations": {
                                "en": "Before the meeting, we <w>went over</w> the most important points for a moment."
                            }
                        },
                        {
                            "text": "Laten we samen de tekst <w>doornemen</w> om te zien of er nog fouten in staan.",
                            "target_lang_translations": {
                                "en": "Let's <w>go through</w> the text together to see if there are any errors in it."
                            }
                        }
                    ],
                    "synonyms": [
                        "herhalen"
                    ],
                    "common_phrases": [
                        "de tekst doornemen",
                        "de punten doornemen",
                        "het plan doornemen"
                    ],
                    "target_lang_definitions": {
                        "en": "To study, look at, or discuss something globally in order to understand or check it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go over",
                                "target_lang_sense_clarification": "to review or examine something"
                            },
                            {
                                "target_lang_word": "review",
                                "target_lang_sense_clarification": "to look over something again"
                            },
                            {
                                "target_lang_word": "go through",
                                "target_lang_sense_clarification": "to examine or discuss in detail"
                            },
                            {
                                "target_lang_word": "run through",
                                "target_lang_sense_clarification": "to quickly review or practice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "493ee0e6-e6c2-30f4-9d75-1bac132daf21",
                    "sense_definition": "iets stap voor stap herhalen of nazeggen om het te leren of te onthouden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bestuderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar wilde de leerstof nog een keer met de klas <w>doornemen</w> voor het examen.",
                            "target_lang_translations": {
                                "en": "The teacher wanted to <w>review</w> the subject matter with the class one more time before the exam."
                            }
                        },
                        {
                            "text": "Zullen we de antwoorden van de toets even samen <w>doornemen</w>?",
                            "target_lang_translations": {
                                "en": "Shall we <w>go over</w> the answers to the test together?"
                            }
                        }
                    ],
                    "synonyms": [
                        "herhalen",
                        "nazeggen"
                    ],
                    "common_phrases": [
                        "de leerstof doornemen",
                        "de antwoorden doornemen"
                    ],
                    "target_lang_definitions": {
                        "en": "To repeat or say something step by step in order to learn or remember it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go through",
                                "target_lang_sense_clarification": "to practice or repeat a sequence"
                            },
                            {
                                "target_lang_word": "repeat",
                                "target_lang_sense_clarification": "to say or do again for learning"
                            },
                            {
                                "target_lang_word": "review",
                                "target_lang_sense_clarification": "to study material again"
                            }
                        ]
                    }
                }
            ]
        }
    ]
