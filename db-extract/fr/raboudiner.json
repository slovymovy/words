                "senses": [
                    {
                        "sense_id": "16df3181-6ca6-3c16-9c04-a350e5bf91e3",
                        "entry_id": "49d285f4-9e17-3261-b6a4-a98cbfc9ff61",
                        "glosses": [
                            "Rafistoler."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "891f671b-9f5a-4176-85eb-b5452b43cbe5",
                                "sense_id": "16df3181-6ca6-3c16-9c04-a350e5bf91e3",
                                "text": "Il avait aussi raboudiné des tuyaux de trompette et de trombone ajustés l’un dans l'autre et qui allaient faire résonner un son bizarre au bout de la salle."
                            },
                            {
                                "example_id": "0858bf14-e0f6-4348-86f9-7bc35aecddca",
                                "sense_id": "16df3181-6ca6-3c16-9c04-a350e5bf91e3",
                                "text": "Il raboudine tout avec rien."
                            },
                            {
                                "example_id": "df9fec16-6ee5-474e-8fcb-62cb72c6b859",
                                "sense_id": "16df3181-6ca6-3c16-9c04-a350e5bf91e3",
                                "text": "Le filage entre le tableau de bord et le moteur et les phares est « raboudiné » en plusieurs endroits."
                            }
                        ]
                    },
                    {
                        "sense_id": "48ba150d-3a6e-30df-aeb0-cc019705f895",
                        "entry_id": "49d285f4-9e17-3261-b6a4-a98cbfc9ff61",
                        "glosses": [
                            "Chiffonner, froisser."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "241b4a32-c27f-4ef3-ad03-0d577763c6a5",
                                "sense_id": "48ba150d-3a6e-30df-aeb0-cc019705f895",
                                "text": "Il a de nouveau laissé sa serviette de bain raboudinée dans un coin, encore toute mouillée."
                            }
                        ]
                    }
