                        "glosses": [
                            "Celui, celle qui s’occupe d’ornithologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1607e97b-ddfb-41a0-950c-ea3f0d0a2548",
                                "sense_id": "6632de05-8b7c-3bc2-a373-e95236eda8bb",
                                "text": "L’ornithologiste en conclut qu’elle avait pondu et qu’elle commençait à couver."
