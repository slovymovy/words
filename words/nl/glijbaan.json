    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79a3a8ad-fb0d-3ce5-a835-b6fabba0cc8c",
                    "sense_definition": "Een gladde, schuine constructie in een speeltuin waar kinderen vanaf kunnen glijden.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "speeltoestel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen staan in de rij om van de <w>glijbaan</w> te gaan.",
                            "target_lang_translations": {
                                "en": "The children are standing in line to go down the <w>slide</w>.",
                                "ru": "Дети стоят в очереди, чтобы скатиться с <w>горки</w>."
                            }
                        },
                        {
                            "text": "Wil je eerst naar de <w>glijbaan</w> of naar de schommels?",
                            "target_lang_translations": {
                                "en": "Do you want to go to the <w>slide</w> or to the swings first?",
                                "ru": "Ты хочешь сначала пойти на <w>горку</w> или на качели?"
                            }
                        }
                    ],
                    "synonyms": [
                        "roetsjbaan"
                    ],
                    "common_phrases": [
                        "houten glijbaan",
                        "hoge glijbaan",
                        "van de glijbaan"
                    ],
                    "target_lang_definitions": {
                        "en": "A smooth, inclined structure in a playground that children can slide down.",
                        "ru": "Гладкая наклонная конструкция на детской площадке, с которой дети могут скатываться вниз."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slide",
                                "target_lang_sense_clarification": "playground equipment"
                            },
                            {
                                "target_lang_word": "playground slide",
                                "target_lang_sense_clarification": "specific type of play equipment"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "горка",
                                "target_lang_sense_clarification": "детский игровой аттракцион"
                            },
                            {
                                "target_lang_word": "детская горка",
                                "target_lang_sense_clarification": "конструкция для катания детей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c85ce118-7944-3927-ac4a-45e616097caa",
                    "sense_definition": "Een opblaasbare baan die wordt gebruikt om een vliegtuig in geval van nood snel te verlaten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nooduitrusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De passagiers moesten het vliegtuig via de <w>glijbaan</w> verlaten na de noodlanding.",
                            "target_lang_translations": {
                                "en": "The passengers had to leave the plane via the <w>slide</w> after the emergency landing.",
                                "ru": "Пассажирам пришлось покинуть самолет по <w>трапу</w> после аварийной посадки."
                            }
                        },
                        {
                            "text": "Nadat een <w>glijbaan</w> per vergissing is ingezet moet deze op de thuisbasis worden vervangen.",
                            "target_lang_translations": {
                                "en": "After a <w>slide</w> has been deployed by mistake, it must be replaced at the home base.",
                                "ru": "После того как <w>трап</w> был развернут по ошибке, его необходимо заменить на базе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opblaasbare glijbaan"
                    ],
                    "target_lang_definitions": {
                        "en": "An inflatable track used to quickly exit an aircraft in case of an emergency.",
                        "ru": "Надувная дорожка, используемая для быстрой эвакуации из самолета в случае чрезвычайной ситуации."
                    },
                    "translations": {
                        "en": [
