                    "frequency": "Middle",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue journée de marche, il s'<w>affale</w> sur le canapé sans dire un mot."
                        },
                        {
                            "text": "Épuisée par son voyage, elle s'est <w>affalée</w> sur son lit tout habillée."
                        }
                    ],
                    "synonyms": [
                        "s'écrouler",
                        "s'effondrer",
                        "se vautrer"
                    ],
                    "common_phrases": [
                        "s'affaler sur le canapé",
                        "s'affaler de tout son long"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "6fab515a-80e7-374a-8752-dec53102cfaf",
                    "sense_definition": "Faire descendre rapidement une voile ou un cordage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche de la tempête, le capitaine a ordonné d'<w>affaler</w> les voiles immédiatement."
                        },
                        {
                            "text": "Les marins ont rapidement <w>affalé</w> la grand-voile pour stabiliser le bateau dans les vagues."
                        }
                    ],
                    "synonyms": [
