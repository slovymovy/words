                                "es": "¿<w>Quién</w> ha tomado prestada mi bicicleta?"
                            }
                        },
                        {
                            "text": "Ik weet niet <w>Wie</w> er aan de deur staat.",
                            "target_lang_translations": {
                                "en": "I don't know <w>who</w> is at the door.",
                                "ru": "Я не знаю, <w>кто</w> стоит у двери.",
                                "pl": "Nie wiem, <w>kto</w> stoi przy drzwiach.",
                                "de": "Ich weiß nicht, <w>wer</w> an der Tür steht.",
                                "fr": "Je ne sais pas <w>qui</w> est à la porte.",
