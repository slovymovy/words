                "senses": [
                    {
                        "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                        "entry_id": "2a7af4bb-14c3-3c9e-a952-1675354c03ae",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ca7f9f-8159-496d-a986-247006552d01",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Frau Ungruhe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c2400ecb-4e79-4a2b-b5ad-ee73c6003a92",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Herr Ungruhe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ae872ca7-9ba6-4857-abe5-51a6993c9d46",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Die Ungruhes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cccaeb41-450a-4c9a-8e0d-5b7cc41ee00a",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Der Ungruhe trägt nie die Schals, die die Ungruhe ihm strickt."
                            },
                            {
                                "example_id": "d2155ea8-4c4e-4fed-820c-3c02e48068cc",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ungruhe kommt, geht der Herr Ungruhe.“"
                            },
                            {
                                "example_id": "ab21f3f6-5697-48bf-8dc8-31af4900d09f",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Ungruhe kommt und geht."
                            },
                            {
                                "example_id": "64055608-aa7b-49a7-b903-3e24ab1e870f",
                                "sense_id": "30ae84a3-c5f2-355d-a9af-c40e7c8bf2e2",
                                "text": "Ungruhes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
