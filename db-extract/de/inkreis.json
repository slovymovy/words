                        "source_sense_id": "ceb7f302-e936-31f1-b1ba-e298a5499b82",
                        "source_sense_description": "Kreis, der alle Seiten eines Polygons von innen berührt",
                        "target_lang_word": "incircle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incircle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc10db5-efb0-3da3-b0c8-10f52ebfd225",
                                        "entry_id": "0a18a4c3-51da-342f-90aa-a4bd0553c13a",
                                        "glosses": [
                                            "A circle within a polygon, especially a triangle, that is tangent to each side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41fe1d91-344f-4013-852d-bf60d435b749",
                                                "sense_id": "5cc10db5-efb0-3da3-b0c8-10f52ebfd225",
                                                "text": "To construct the incircle of ΔABC, we need the center of the circle and a pass-through point."
                                            },
                                            {
                                                "example_id": "b5241f7c-72f4-4c04-a2d0-a026d5d64c43",
                                                "sense_id": "5cc10db5-efb0-3da3-b0c8-10f52ebfd225",
                                                "text": "Having constructed K, the incircle of the quadrilateral can be easily constructed since it is tangent to BA and BC."
                                            },
                                            {
                                                "example_id": "63929b50-22ae-429a-bc4b-8296ef214571",
                                                "sense_id": "5cc10db5-efb0-3da3-b0c8-10f52ebfd225",
                                                "text": "For example, in Figure 4.2a only two edges of the polygon are tangent to the incircle. The other four edges do not even touch the incircle, but their extensions, shown by dotted lines, are tangent to the incircle."
                                            }
                                        ]
                                    }
                                ]
                            },
