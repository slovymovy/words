    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                "word": "Horologium",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0df35cb-54aa-307d-9dfe-d94a4694f344",
                        "entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                        "glosses": [
                            "Synonym of Tower of the Winds, a monument in ancient Athens that included a clepsydra and multiple prominent sundials."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "edb3bc9e-0309-3b9e-9ad5-552e8007b1e9",
                        "entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                        "glosses": [
                            "Synonym of Solarium, a monument in ancient Rome whose obelisk was once believed to have acted as a sundial gnomon."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c4ab981f-c693-3734-826f-e332710d3624",
                        "entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                        "glosses": [
                            "A constellation of the southern sky, said to resemble a pendulum clock. It lies between the constellations Fornax and Dorado."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "855f16cb-2204-3208-91f6-0ce4bace3dfc",
                        "entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                        "glosses": [
                            "Alternative letter-case form of horologium, the book of hours in the Eastern Orthodox and Catholic churches."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe3e4e4-a113-4b32-b815-57c9fb6c8ebd",
                        "source_entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Horloge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Horloge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6914f3-21fd-396c-b847-5c6c65603e7b",
                                        "entry_id": "c712c669-d50e-3fb9-a3a6-cde949b169c4",
                                        "glosses": [
                                            "Constellation du ciel austral, bordée par l’Éridan, l’Hydre mâle, le Réticule, la Dorade et le Burin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d01b5a0c-10fd-4d20-9a9b-9d57d21db7fd",
                                                "sense_id": "0a6914f3-21fd-396c-b847-5c6c65603e7b",
                                                "text": "Voici donc ces nouvelles constellations suivant l’ordre des ascensions droites, & telles que M. de la Caille les rapporte dans les Mémoires de 1752 […] III. L’Horloge à pendule & à secondes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d87587c3-677f-4575-bdc5-8c66f341aa77",
                        "source_entry_id": "9a9b03a3-a159-39a3-9de8-8ccf01501c37",
                        "source_sense_description": "constellation",
                        "target_lang_word": "Pendeluhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pendeluhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                        "entry_id": "69ca6f26-2eab-3be5-9729-c728fa3bf713",
                                        "glosses": [
                                            "Uhr, deren Zeitnormal ein mechanisches Pendel ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6392e419-dcb6-48f8-bcb2-e72c43f6b364",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "An der Wand hängt eine Pendeluhr."
                                            },
                                            {
                                                "example_id": "64bf2934-52cf-4ec8-aa6c-15702f24e068",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„Jedes Teil einer Pendeluhr muss eigenhändig geschliffen, gesägt und gefräst werden.“"
                                            },
                                            {
                                                "example_id": "dc16cb48-e2eb-4b19-8da9-60ac4ea710a2",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„Sein fehlerhaftes Thermometer, seine nicht zustande gekommene Pendeluhr, sein unausgegorener Atomismus, sein korrekter Nachweis des Gewichts der Luft - alles fast vergessen.“"
                                            },
                                            {
                                                "example_id": "2fd71099-d8e9-4b16-a87c-363d6303e84f",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„In einem der Flure gab es eine alte Pendeluhr, ich glaube im ersten Stock; die Uhr stand immer; eine echte Standuhr also.“"
                                            },
                                            {
                                                "example_id": "63ca12e6-1bd7-485e-95db-e037a7df3b22",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„Schließlich hörten wir die Pendeluhr halb drei Uhr schlagen, und zwei oder drei Minuten später erschien lächelnd und gemessenen Schritts die schöne Undine, ging geradewegs auf Seramis zu, beugte ein Knie zur Erde und übergab ihr das Blatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
