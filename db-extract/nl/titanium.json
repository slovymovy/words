                        ]
                    },
                    {
                        "translation_id": "900d2151-aa42-47fd-83d0-8974a5aa49ed",
                        "source_entry_id": "d14f9c35-e6a6-3e31-a1f9-d0eccb257b76",
                        "source_sense_id": "46b74f77-7f31-3f46-b7f5-f5e0f98fe315",
                        "source_sense_description": "scheikundig element met symbool Ti en atoomnummer 22",
                        "target_lang_word": "titane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "titane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Élément chimique de symbole chimique Ti et de numéro atomique 22 de la série des métaux de transition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "602ee64a-3ea7-49dc-bdb3-73b8f9e4590f",
                                                "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                                "text": "La faible quantité de neutrons s’échappant de la surface témoigne d’une forte abondance de fer et de titane - des éléments qui absorbent efficacement ces particules élémentaires."
                                            },
                                            {
                                                "example_id": "acba6209-4327-4812-8e31-bd8f393801c8",
                                                "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                                "text": "Des retouches montrent la présence de titane (Ti), de zinc (Zn), de chrome (Cr) et de cadmium (Cd) qui confirment l’usage de pigments modernes, comme le blanc de titane, le blanc de zinc, le vert oxyde de chrome ou le rouge de cadmium."
                                            },
                                            {
                                                "example_id": "1790fdb3-cac2-4a14-b2a7-4a4c05e152eb",
                                                "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                                "text": "[L’impact géant qui a créé le cratère Aitken] a entraîné une instabilité (thermique et chimique) dans le manteau de la face cachée, qui a engendré la migration des roches riches en titane vers la face visible en seulement quelques dizaines de millions d’années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50053336-b4cf-3ed7-8a05-84f243836dd6",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Corps simple élémentaire, métal blanc brillant"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c989a24-b7dc-469e-8756-b102d6b32f9f",
                                                "sense_id": "50053336-b4cf-3ed7-8a05-84f243836dd6",
                                                "text": "On peut ainsi obtenir un matériau autocicatrisant. C’est le cas, par exemple, de la stabilisation de certaines céramiques par l’inclusion de particules de zircone, oxyde de zirconium, un métal assez semblable au titane."
                                            },
                                            {
                                                "example_id": "01589716-b56c-4c78-b3fd-c3ae341ca803",
                                                "sense_id": "50053336-b4cf-3ed7-8a05-84f243836dd6",
                                                "text": "Le titane pur est un métal blanc et brillant, très léger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df0ac42a-0082-3c83-b86d-9cad41a3bf65",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de titane."
                                        ],
                                        "tags": [
                                            "physical",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33f6d18-bdf1-4e98-9196-5927367ba7c5",
                                                "sense_id": "df0ac42a-0082-3c83-b86d-9cad41a3bf65",
                                                "text": "L’ajout de deux titanes aux extrémités opposées d’une molécule d’éthylène en fait un adsorbeur d’hydrogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbfc8ff2-e91a-3435-a5ac-de2b3e108886",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Alliages ou pigments de titane, dans leur ensemble."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "060f7cb5-1271-4a72-a0cb-04d36cad327f",
                                                "sense_id": "bbfc8ff2-e91a-3435-a5ac-de2b3e108886",
                                                "text": "Notions d’usinage des titanes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "titane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                        "entry_id": "6defcb60-66f0-3ea3-90b0-be13d713281d",
                                        "glosses": [
                                            "Titan femelle (personne, animal ou chose)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb318c82-19e6-4002-8e28-c091cb173fef",
                                                "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                                "text": "Et le peuple, qu’au fond votre impuissance blesse,\nRit devant la titane avortée en diablesse ;"
                                            },
                                            {
                                                "example_id": "66ca67c5-9043-48c1-9081-8f720aed7224",
                                                "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                                "text": "Libérée de ses menottes de dymérite, se tenant bien droite, la tête fièrement relevée, elle avait l’air d’une titane. Avec sa crinière noire désordonnée, on avait l’impression qu’elle touchait la voûte."
                                            },
                                            {
                                                "example_id": "ca956137-3101-497d-b93c-f706eb38b83f",
                                                "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                                "text": "A toujours s’affirmer\nComme cette belle\nQu’elle est\nComme cette lionne\nQu’elle est\nA la force d’une titane\nSous un cœur sulfurant"
                                            }
                                        ]
                                    }
                                ]
                            },
