                        "glosses": [
                            "Conforming tightly to the body, snug against the skin."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0bb87b2-d05f-4adb-a805-807aa88dad21",
                                "sense_id": "12d527ee-4bae-3d5a-8c3d-d6a823d39099",
                                "text": "He'd have to stow the Gun somewhere; no place to conceal it in the skintight bodysuit."
                            },
                            {
                                "example_id": "0903f038-9448-428d-8daf-44010d3f9d2c",
                                "sense_id": "12d527ee-4bae-3d5a-8c3d-d6a823d39099",
                                "text": "I'mma get your heart racing / In my skin-tight jeans / Be your teenage dream tonight"
                            }
                        ]
