                        "form": "den Tagelöhner"
                    },
                    {
                        "form_id": "56918347-ca7d-40ba-827e-88756abfd33d",
                        "entry_id": "c7d19423-2899-3622-9957-76ce24f34b9b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tagelöhner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                        "entry_id": "c7d19423-2899-3622-9957-76ce24f34b9b",
                        "glosses": [
                            "Arbeiter ohne festes Arbeitsverhältnis, der täglich seinen Lohn erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef4eba36-3fb2-4325-a5bd-299b36669336",
                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                "text": "„Deshalb brüste ich mich stets damit, daß ich eine Zeit meines Lebens Tagelöhner war.“"
                            },
                            {
                                "example_id": "0fed572a-0319-4345-a1c6-d18b27a243c7",
                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                "text": "„Die Entlassungen betrafen sowohl Tagelöhner und angelernte Arbeiter als auch besser bezahltes, ausgebildetes Personal.“"
                            },
                            {
                                "example_id": "bb62b208-bbcb-4a18-859f-0202b3c47671",
                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                "text": "„Hier also ackerten geflüchtete Tagelöhner ohne Schutzkleidung unter den Plastikbergen und spritzen Fungizide und Insektizide auf die zarten Pflanzen, die dann mit EU-Gütesiegel auf unseren Tellern landeten.“"
                            },
                            {
                                "example_id": "96149040-bc9e-4ca0-a718-49c104d2835f",
                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                "text": "„Am Anfang jeden Monats gab er ihr pflichtbewusst einen Teil des Geldes, das er als Tagelöhner auf dem Bau verdiente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61888b0d-6f49-4994-a091-c313376575ca",
                        "source_entry_id": "c7d19423-2899-3622-9957-76ce24f34b9b",
                        "source_sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                        "source_sense_description": "Arbeiter ohne festes Arbeitsverhältnis, der täglich seinen Lohn erhält",
                        "target_lang_word": "day laborer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "day laborer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b90212ab-3e2e-3c27-86da-5c0ff5a7ccd2",
                                        "entry_id": "660bb727-e113-308f-a9d6-7c9f122b9d9c",
                                        "glosses": [
                                            "A laborer who is hired and paid one day at a time, with no promise that more work will be available in the future."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a2009bc-90a5-4149-b1f9-a4dace83e38e",
                        "source_entry_id": "c7d19423-2899-3622-9957-76ce24f34b9b",
                        "source_sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                        "source_sense_description": "Arbeiter ohne festes Arbeitsverhältnis, der täglich seinen Lohn erhält",
                        "target_lang_word": "journalier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "journalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c95243a-b9ef-3562-ab4a-91f5a4d246ea",
                                        "entry_id": "03307235-a565-3d11-909f-b38755047ba7",
                                        "glosses": [
                                            "Qui se fait chaque jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe7a849-ea02-487d-95f1-9f9e89930e1e",
                                                "sense_id": "6c95243a-b9ef-3562-ab4a-91f5a4d246ea",
                                                "text": "C’est son travail journalier."
                                            },
                                            {
                                                "example_id": "30c5461b-8023-4af5-a73a-4265b9a9421c",
                                                "sense_id": "6c95243a-b9ef-3562-ab4a-91f5a4d246ea",
                                                "text": "On a une autre porte basse, masquée, discrète, ouvrant sur une ruelle, dont on se sert pour les usages journaliers."
                                            },
                                            {
                                                "example_id": "73bff858-36e8-4661-b6e1-b75597c913c6",
                                                "sense_id": "6c95243a-b9ef-3562-ab4a-91f5a4d246ea",
                                                "text": "L’ayant rencontré à deux reprises, lui qui pourtant côtoie la crème de l’élite de façon journalière a été impressionné par le charisme, la gentillesse et l’immense connaissance du foot du sanglier des Ardennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c65d68f0-9c15-3868-a306-381f8854ad05",
                                        "entry_id": "03307235-a565-3d11-909f-b38755047ba7",
                                        "glosses": [
                                            "Qui est sujet à changer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7375c04b-b6ce-47f1-aec7-21e427e4d86c",
                                                "sense_id": "c65d68f0-9c15-3868-a306-381f8854ad05",
                                                "text": "Son esprit est journalier."
                                            },
                                            {
                                                "example_id": "52fa189b-f51b-4046-b842-17bb5c67443c",
                                                "sense_id": "c65d68f0-9c15-3868-a306-381f8854ad05",
                                                "text": "Son humeur est journalière."
                                            },
                                            {
                                                "example_id": "029730f8-bf28-436d-baa7-0715a21756fe",
                                                "sense_id": "c65d68f0-9c15-3868-a306-381f8854ad05",
                                                "text": "Sa beauté est journalière."
                                            },
                                            {
                                                "example_id": "d200b105-e478-4297-9141-1bd2a130150d",
                                                "sense_id": "c65d68f0-9c15-3868-a306-381f8854ad05",
                                                "text": "Mais, moi, je suis journalier. S’il y a des jours où je mens comme un programme, il y en a d’autres où je ne peux pas être sérieux."
                                            },
                                            {
                                                "example_id": "9a0b592c-8351-4517-8d73-676f5eca3a2b",
                                                "sense_id": "c65d68f0-9c15-3868-a306-381f8854ad05",
                                                "text": "Il est journalier, elle est journalière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "journalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3183200-fac0-3258-8bc4-1aed6a15b034",
                                        "entry_id": "f2038fa7-319f-3798-abfd-c3f51d30935c",
                                        "glosses": [
                                            "Personne qui travaille à la journée."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c204c62c-e4d0-4c8d-a073-371573bc73f2",
                                                "sense_id": "d3183200-fac0-3258-8bc4-1aed6a15b034",
                                                "text": "Il n'y a pas encore trente ans que la population de Meigneux se composait de pauvres journaliers et de cultivateurs qui exploitaient les six fermes de la commune."
                                            },
                                            {
                                                "example_id": "82f5e285-f68e-4536-9dc6-201bb3d1598c",
                                                "sense_id": "d3183200-fac0-3258-8bc4-1aed6a15b034",
                                                "text": "Le penn-ty est un journalier à qui un propriétaire loue, ou bien à qui un fermier sous-loue une petite maison et quelques terres. À celui qui, ainsi, lui a fourni le moyen de subsister, le penn-ty doit une partie de son labeur. Paria du pays breton, le penn-ty a cependant une situation supérieure encore à celle du journalier agricole […]."
                                            },
                                            {
                                                "example_id": "6b9e05c9-76e7-460c-a4a9-4c7a432dac73",
                                                "sense_id": "d3183200-fac0-3258-8bc4-1aed6a15b034",
                                                "text": "Céline Thiébault dans la cuisine avait distribué les paies et l'un après l'autre, sans hâte, les journaliers quittaient Hurtebise."
                                            },
                                            {
                                                "example_id": "24162bbc-51d4-4e1d-8ffc-754c48c6bbd8",
                                                "sense_id": "d3183200-fac0-3258-8bc4-1aed6a15b034",
                                                "text": "Ils gèrent leur domaine en exploitation semi-directe, par l'intermédiaire d'un régisseur qui a la haute main sur les travaux et les ouvriers, le plus souvent des ouvriers employés au mois, \"mesadiers\" venus de la montagne et plus dociles que les journaliers venus du village voisin."
                                            },
                                            {
                                                "example_id": "a89a5d5c-6277-4b7c-b5af-1b5dc5664585",
                                                "sense_id": "d3183200-fac0-3258-8bc4-1aed6a15b034",
                                                "text": "— La rue de Jérusalem, entendez la police, tient ces garnis à l’œil : hôtes de passage, ouvriers journaliers ou escarpes n'échappent pas à sa surveillance […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "404754cb-eea3-30bf-9080-44a65afc7753",
                                        "entry_id": "f2038fa7-319f-3798-abfd-c3f51d30935c",
                                        "glosses": [
                                            "Terme de marine. Le journalier, les vivres frais qui se renouvellent tous les jours, par opposition aux vivres de campagne composés de viandes salées ou en daubes, de légumes, etc. — (https://www.littre.org/definition/journalier)"
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1638680-e92c-47d6-99d4-5c9108d51b02",
                                                "sense_id": "404754cb-eea3-30bf-9080-44a65afc7753",
                                                "text": "Ce bâtiment est au journalier, se dit quand, n'ayant pas encore ses provisions ou ne voulant pas les entamer, il achète au jour le jour."
                                            },
                                            {
                                                "example_id": "99b0b1ae-9442-44d4-8d6e-588fcf8af24c",
                                                "sense_id": "404754cb-eea3-30bf-9080-44a65afc7753",
                                                "text": "se dit d'un élément du navire qui sert pour une journée, par opposition aux éléments principaux.",
                                                "translation": "Le réservoir à gasoil journalier du navire sert de tampon pour alimenter les moteurs, et est rempli à partir des réservoirs principaux, qui contiennent assez de carburant pour la campagne. Un usage typique est sur les voiliers motorisés, où les réservoirs principaux sont à fond de cale ou de quille : le moteur est alimenté par gravité depuis ce \"réservoir journalier\", qui est opportunément placé dans une position surélevée, il est lui-même rempli par une pompe depuis les réservoirs principaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
