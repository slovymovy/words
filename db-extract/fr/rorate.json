                ],
                "senses": [
                    {
                        "sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                        "entry_id": "cedba246-ba3a-3d7b-a226-d323d463a1d9",
                        "glosses": [
                            "Matines célébrée lors de l’Avent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a9e1d5-765d-477c-a0ce-18d85dfb1082",
                                "sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                                "text": "Durant le temps de l'Avent, à l'aube du jour naissant, l'Église catholique propose des messes dites rorate, comme il est de coutume avant tout dans les pays alémaniques. Célébrées à la lueur des bougies, ces liturgies matinales font des chrétiens des «guetteurs d'aurore» qui attendent dans l'espérance l'avènement du Messie promis, le Christ."
                            },
                            {
                                "example_id": "9b9ab7bb-e0f6-45ec-84df-72e048ab0372",
                                "sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                                "text": "Les rorates ont lieu à 7h30, tous les jours, du lundi au samedi, jusqu'au 23 décembre inclus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dffbd5d8-d209-4ea0-b530-54c6beba2635",
                        "source_entry_id": "cedba246-ba3a-3d7b-a226-d323d463a1d9",
                        "source_sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                        "target_lang_word": "Rorate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rorate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "886f9b68-a4d8-3c1b-bdc0-f6b4f24bf9e6",
                                        "entry_id": "89fad79c-c7f6-3076-9617-2a1e95142862",
                                        "glosses": [
                                            "während der Adventszeit zu Ehren Marias stattfindende Votivmesse"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e456e895-86e3-49ed-b3ed-76f3c7818670",
                                                "sense_id": "886f9b68-a4d8-3c1b-bdc0-f6b4f24bf9e6",
                                                "text": "„Der Frauenbund Falkenberg bereitet sich jedes Jahr auf das Weihnachtsfest und die Ankunft Jesu Christi mit einem feierlichen Rorate vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72e04e97-bba3-3e2b-b866-b9fd72e34b5e",
                                        "entry_id": "89fad79c-c7f6-3076-9617-2a1e95142862",
                                        "glosses": [
                                            "vierter Sonntag im Advent"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3e1690-6e1e-4721-8d2b-606dc52497b3",
                                                "sense_id": "72e04e97-bba3-3e2b-b866-b9fd72e34b5e",
                                                "text": "„Alle Beteiligten überzeugten mit einem bewegenden, feierlichen Konzertprogramm zum vierten Adventssonntag „Rorate“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46c21731-7d1c-4b1f-a57b-186f6731752d",
                        "source_entry_id": "cedba246-ba3a-3d7b-a226-d323d463a1d9",
                        "source_sense_id": "66744da7-08aa-3f42-93b5-2b4a3e2f8fdf",
                        "target_lang_word": "roraty",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roraty",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                                        "entry_id": "02e55a35-b49e-3abc-8944-1b4c362a87a6",
                                        "glosses": [
                                            "w Kościele katolickim wczesna msza poranna ku czci Najświętszej Maryi Panny odprawiana w adwencie; ; zob. też roraty w Encyklopedii staropolskiej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4974c9a-11e0-46df-a262-c1f02c6fbf98",
                                                "sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                                                "text": "Podczas całego adwentu, oprócz niedziel i święta Niepokalanego Poczęcia, odprawiane są roraty."
                                            },
                                            {
                                                "example_id": "6fb4464c-cada-443d-aecd-9cbc6992da12",
                                                "sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                                                "text": "W czasie rorat zapala się dodatkowo specjalną świecę, zwaną roratką."
                                            },
                                            {
                                                "example_id": "23ec978f-65d8-41cb-9870-5f143213887d",
                                                "sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                                                "text": "Michaś przez cały adwent chodził do kościoła na roraty."
                                            },
                                            {
                                                "example_id": "fef9a614-8110-4008-9bf5-1fdf37c553f9",
                                                "sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                                                "text": "(…) o świtaniu się zrywał, kiedy przedzwaniali na roraty"
                                            },
                                            {
                                                "example_id": "1fc25f52-2fdb-432b-9869-db10472f2298",
                                                "sense_id": "499908e8-c448-3b9e-9575-6aa9f1a1ad5c",
                                                "text": "Udział w roratach, które tradycyjnie zaczynają się o godz. 6.30, to dla wielu wiernych prawdziwe wyzwanie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dd5152d-c736-4a8b-882f-54d47d05752d",
                        "source_entry_id": "cedba246-ba3a-3d7b-a226-d323d463a1d9",
