                "senses": [
                    {
                        "sense_id": "19228584-f9d9-3da4-8e5a-2a20fc0c624c",
                        "entry_id": "24bae7e2-3c8e-37fe-8299-02f0a05639d7",
                        "glosses": [
                            "katholische Partei, die vor allem in der Weimarer Republik bedeutend war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35970482-316e-464d-859c-96df4f53324a",
                                "sense_id": "19228584-f9d9-3da4-8e5a-2a20fc0c624c",
                                "text": "„Die drei Kartellparteien verloren haushoch, der Zentrumspartei wuchs im Parlament eine ausschlaggebende Rolle zu, und mit fast 1,5 Millionen Wählern wurde die SPD stimmenmäßig die stärkste Partei im Reich.“"
                            },
                            {
                                "example_id": "7c99e54d-64d8-49a6-96b8-ea78389e05a1",
                                "sense_id": "19228584-f9d9-3da4-8e5a-2a20fc0c624c",
                                "text": "„Sie entstand eben auch zu der Zeit, als sich das Kultusministerium und die katholische Zentrumspartei in den Haaren lagen.“"
                            },
                            {
                                "example_id": "d9da66d0-4e06-42f1-9b10-3396f8e08959",
                                "sense_id": "19228584-f9d9-3da4-8e5a-2a20fc0c624c",
                                "text": "„Denn SPD und Teile der Zentrumspartei weigerten sich, einen Nachtragshaushalt zu bewilligen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
