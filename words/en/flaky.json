{
    "word_family": [
        "flake",
        "flakiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "888270ac-5ab5-35e0-a32f-b191857e150d",
                    "sense_definition": "Consisting of or breaking into small, thin, loose pieces or layers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a delicious pie with a <w>flaky</w> crust that melted in the mouth.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил вкусный пирог со <w>слоистой</w> корочкой, которая таяла во рту.",
                                "pl": "Szef kuchni przygotował pyszne ciasto z <w>kruchym</w> spodem, który rozpływał się w ustach."
                            }
                        },
                        {
                            "text": "If you have <w>flaky</w> skin in the winter, you should use a stronger moisturizer.",
                            "target_lang_translations": {
                                "ru": "Если зимой у вас <w>шелушащаяся</w> кожа, вам следует использовать более сильное увлажняющее средство.",
                                "pl": "Jeśli zimą masz <w>łuszczącą się</w> skórę, powinieneś użyć silniejszego kremu nawilżającego."
                            }
                        }
                    ],
                    "synonyms": [
                        "scaly",
                        "crumbly"
                    ],
                    "antonyms": [
                        "smooth",
                        "solid"
                    ],
                    "common_phrases": [
                        "flaky pastry",
                        "flaky skin",
                        "flaky crust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из мелких, тонких, легко отделяющихся кусочков или слоев.",
                        "pl": "Składający się z małych, cienkich, łatwo oddzielających się kawałków lub warstw."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоистый",
                                "target_lang_sense_clarification": "о текстуре теста или материала"
                            },
                            {
                                "target_lang_word": "шелушащийся",
                                "target_lang_sense_clarification": "о коже"
                            },
                            {
                                "target_lang_word": "рассыпчатый",
                                "target_lang_sense_clarification": "о тесте"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "warstwowy",
                                "target_lang_sense_clarification": "o teksturze ciasta lub materiału"
                            },
                            {
                                "target_lang_word": "łuszczący się",
                                "target_lang_sense_clarification": "o skórze"
                            },
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "o cieście"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0a8abf-8bc5-370f-b0f9-cca1aeb0ac56",
                    "sense_definition": "Unreliable or inconsistent in behavior, especially regarding making and keeping plans with others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stopped inviting him to dinner because he is so <w>flaky</w> and always cancels at the last minute.",
                            "target_lang_translations": {
                                "ru": "Я перестал приглашать его на ужин, потому что он такой <w>ненадёжный</w> и всегда всё отменяет в последнюю минуту.",
                                "pl": "Przestałem zapraszać go na kolację, ponieważ jest bardzo <w>niesłowny</w> i zawsze odwołuje w ostatniej chwili."
                            }
                        },
                        {
                            "text": "It is hard to finish a group project when you have a <w>flaky</w> friend who never shows up.",
                            "target_lang_translations": {
                                "ru": "Трудно закончить групповой проект, когда у тебя есть <w>необязательный</w> друг, который никогда не приходит.",
                                "pl": "Trudno ukończyć projekt grupowy, gdy ma się <w>nieodpowiedzialnego</w> przyjaciela, który nigdy się nie pojawia."
                            }
                        }
                    ],
                    "synonyms": [
                        "unreliable",
                        "flighty",
                        "inconsistent"
                    ],
                    "antonyms": [
                        "reliable",
                        "dependable",
                        "consistent"
                    ],
                    "common_phrases": [
                        "flaky person",
                        "being flaky"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe unreliable people"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ненадежный или непостоянный в поведении, особенно в отношении планов и договоренностей.",
                        "pl": "Niezawodny lub niespójny w zachowaniu, zwłaszcza w odniesieniu do planów i ustaleń."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненадёжный",
                                "target_lang_sense_clarification": "на которого нельзя положиться"
                            },
                            {
                                "target_lang_word": "ветреный",
                                "target_lang_sense_clarification": "легкомысленный и непостоянный"
                            },
                            {
                                "target_lang_word": "необязательный",
                                "target_lang_sense_clarification": "часто нарушающий обещания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niesłowny",
                                "target_lang_sense_clarification": "osoba, na której nie można polegać"
                            },
                            {
                                "target_lang_word": "nieodpowiedzialny",
                                "target_lang_sense_clarification": "często zmieniający zdanie lub plany"
                            },
                            {
                                "target_lang_word": "postrzelony",
                                "target_lang_sense_clarification": "potocznie o kimś dziwnym lub nieprzewidywalnym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1cf4a3b-5629-3559-8ba3-09131267919c",
                    "sense_definition": "Working poorly or only intermittently; prone to frequent technical malfunctions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_reliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot enjoy the online game because of my <w>flaky</w> Internet connection.",
                            "target_lang_translations": {
                                "ru": "Я не могу наслаждаться онлайн-игрой из-за моего <w>нестабильного</w> интернет-соединения.",
                                "pl": "Nie mogę cieszyć się grą online z powodu mojego <w>niestabilnego</w> połączenia internetowego."
                            }
                        },
                        {
                            "text": "The old laptop has a <w>flaky</w> screen that turns off for no reason.",
                            "target_lang_translations": {
                                "ru": "У старого ноутбука <w>барахлящий</w> экран, который выключается без причины.",
                                "pl": "Stary laptop ma <w>szwankujący</w> ekran, który wyłącza się bez powodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "glitchy",
                        "unstable",
                        "erratic"
                    ],
                    "antonyms": [
                        "stable",
                        "steady"
                    ],
                    "common_phrases": [
                        "flaky connection",
                        "flaky WiFi"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for technology or connections"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работающий плохо или с перебоями; склонный к частым техническим сбоям.",
                        "pl": "Działający słabo lub z przerwami; podatny na częste awarie techniczne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "о соединении или работе техники"
                            },
                            {
                                "target_lang_word": "глючный",
                                "target_lang_sense_clarification": "разговорное о технике со сбоями"
                            },
                            {
                                "target_lang_word": "барахлящий",
                                "target_lang_sense_clarification": "работающий с перебоями"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niestabilny",
                                "target_lang_sense_clarification": "o połączeniu lub działaniu technologii"
                            },
                            {
                                "target_lang_word": "szwankujący",
                                "target_lang_sense_clarification": "działający z usterkami"
                            },
                            {
                                "target_lang_word": "wadliwy",
                                "target_lang_sense_clarification": "często psujący się"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}