                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91c73e8b-9e36-354f-8902-e78504df68d5",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "The smallest cardinality of a base."
                                        ],
