                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d8ebf20-58b6-4eac-ab03-15dd04fb35b3",
                                                "sense_id": "36c5643c-7547-3244-9277-000ef9a7d0fe",
                                                "text": "Smith fouled him hard."
                                            },
                                            {
                                                "example_id": "7a324df5-fde2-4f88-85ab-a030019476b5",
                                                "sense_id": "36c5643c-7547-3244-9277-000ef9a7d0fe",
                                                "text": "The Gunners dominated for long periods but, against the run of play, Denilson fouled Max Gradel and Robert Snodgrass put Leeds ahead from the spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b336870-f9db-3304-bcb0-7e04a6af38b6",
                                        "entry_id": "1d3b6708-1081-3dde-9982-c948cf227c9a",
                                        "glosses": [
                                            "To commit a foul."
