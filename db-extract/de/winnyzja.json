                "senses": [
                    {
                        "sense_id": "406e44a4-eaa9-33ad-bca3-588312b5b2a3",
                        "entry_id": "0eefe8e9-5481-35f8-849c-e04460013c3d",
                        "glosses": [
                            "Großstadt in der Zentralukraine, Zentrum des historischen Gebiets Podoliens"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "8737367c-8302-4abb-86ad-3f7ce3b555da",
                                "sense_id": "406e44a4-eaa9-33ad-bca3-588312b5b2a3",
                                "text": "Er lebt seit zehn Jahren in Winnyzja."
                            },
                            {
                                "example_id": "610f4858-c087-43ed-a746-75820c9e98bc",
                                "sense_id": "406e44a4-eaa9-33ad-bca3-588312b5b2a3",
                                "text": "„Sobald ich in Winnyzja angekommen bin, vereinbare ich ein Treffen mit dem diensthabenden Offizier und bitte ihn, mich für ein weiteres Jahr zu verpflichten.“"
                            },
                            {
                                "example_id": "2d75b832-2b4e-40ee-a378-978d84efbdca",
                                "sense_id": "406e44a4-eaa9-33ad-bca3-588312b5b2a3",
                                "text": "„Wenn sie im Winter zu sich nach Winnyzja gefahren war, hatte sie ihn zu Hause gelassen!“"
                            },
                            {
                                "example_id": "20d4e753-108b-4fb4-88a2-2b48c6132f29",
                                "sense_id": "406e44a4-eaa9-33ad-bca3-588312b5b2a3",
                                "text": "„Als im März 1944 die Rote Armee auf Winnyzja vorrückte, zerstörten die Deutschen die gesamte Anlage.“"
                            },
                            {
                                "example_id": "c2906438-9406-4eab-92da-00eb3fea95ed",
                                "sense_id": "406e44a4-eaa9-33ad-bca3-588312b5b2a3",
                                "text": "„Der ukrainische Präsident Wolodymyr Selenskyj beschuldigt russische Truppen, einen Flughafen im westukrainischen Gebiet Winnyzja zerstört zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
