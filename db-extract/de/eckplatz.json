                ],
                "senses": [
                    {
                        "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                        "entry_id": "2e1722bb-e129-38be-b787-adc2e5a1ad82",
                        "glosses": [
                            "Sitzplatz am Ende einer Sitzreihe (beispielsweise in einem Zug, einer Kirche, einem Saal, …)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ca10a0-e6ec-4dad-885a-208540c89eaa",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Besonders beliebt sind die Eckplätze.“"
                            },
                            {
                                "example_id": "9ce35a4f-b343-48da-a15a-bf14e93c3ed0",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Theodor Fontane war seit dem 17. August 1870 bei der liberal bürgerlichen Vossischen Zeitung als Theaterkritiker speziell für die Aufführungen des „Königlichen Schauspielhauses“ angestellt, verfolgte sie von seinem Eckplatz Nr. 23 im Parkett aus und machte sich mit seinen kritischen Texten im Theater keine Freunde.“"
                            },
                            {
                                "example_id": "474cc6e0-389c-4639-acc9-2a5625a67899",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Härdel steuert einen Eckplatz in der letzten Reihe an, einen schwarzen Rollkoffer hinter sich herziehend.“"
                            },
                            {
                                "example_id": "61f7615c-c14d-4347-b69b-5a9268e3f251",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Das Abteil dritter Klasse war vollgepfropft mit Bauern, kleinen Beamten und Opfern der polnischen Wiederansiedlungsbewegungen - zusammen mit deren Kindern und Gepäck. Ich fand einen Eckplatz, hielt mir eine Zeitung vor das Gesicht und schlief nach einiger Zeit ein.“"
                            },
                            {
                                "example_id": "436e9f0f-09f9-4125-ac47-0143d575ee6e",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Der Eckplatz an der Fensterfront des Horse Shoe Coffee House ist jedenfalls sehr begehrt:“ […]."
                            },
                            {
                                "example_id": "5daacdb6-6245-4ecd-8341-6bc00a7fb0ee",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Manchmal schlürfe ich am Freitagabend am Eckplatz einer szenigen Gaststätte meine Gin-Holunder-Bionade“ […]."
                            },
                            {
                                "example_id": "e1d7ceb5-abd3-4264-b6ab-2b1634042e51",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„»Er hat anscheinend einen Tisch reservieren lassen«, berichtet Moritz, »es ist für zwei Personen gedeckt. Sollen wir etwa auch dort essen? Ein Eckplatz scheint frei zu sein, aber preislich ist die Ritterstube nicht unsere Kragenweite.«“"
                            },
                            {
                                "example_id": "16b810f2-cb9f-41ee-a3cc-08e490042292",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Unter Jugendlichen gelten die Eckplätze der \"Strandhouse\"-Terrasse schon seit Monaten als Geheimtipp: Die einen festigen ihre Kenntnisse über die menschliche Anatomie, andere erfreuen sich schlicht an der Vielfalt körperlicher Erscheinungen.“"
                            },
                            {
                                "example_id": "9767e41d-8669-4152-84ef-db22749f70ec",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Zuerst kamen sie aus Neugier — Männer und Frauen — und erfuhren: auf dem Eckplatz hat keiner von euch zu sitzen; der Eckplatz gehört der Signora. Da sahen sie alle den Eckplatz an, der ihnen verboten war, und beschieden sich dabei.“"
                            },
                            {
                                "example_id": "ca9fc08c-01ee-4a3e-82e9-e5013975151c",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Vom Eckplatz der dritten Regierungsbankreihe im britischen Unterhaus erhob sich“ […] „George Brown.“"
                            },
                            {
                                "example_id": "dfac60c8-8bf8-4833-85aa-343996b511ba",
                                "sense_id": "65b73845-dc07-3104-9c51-719ca994ad65",
                                "text": "„Auf seinem Eckplatz saß Sir Winston Churchill; bleich, den Kopf auf die Brust gestützt und oft wie fröstelnd die Hände reibend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                        "entry_id": "2e1722bb-e129-38be-b787-adc2e5a1ad82",
                        "glosses": [
                            "Raum an einer Straßenecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a850484-83e2-4534-a01f-7e29e6ed54fa",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„Der Brunnen (OSM-ID: 1289561213) steht am Westen der Friedrichshaller Straße auf dem Eckplatz mit der Berkaer Straße.“"
                            },
                            {
                                "example_id": "0b231387-941f-4d03-83fb-45765c41c2b4",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„So blieb der erneute Versuch, einen anderen unbebauten Eckplatz unserer Straße zu einem Kinderspielplatz zu gestalten, in allgemeiner Lustlosigkeit stecken.“"
                            },
                            {
                                "example_id": "875c9c76-f063-4a5c-9c72-374668cb496f",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„Nach dem Krieg wurde diese Liegenschaft so nicht mehr aufgebaut. Dafür wurden rechts und links zwei große Mehrfamilienwohnhäuser errichtet. Der markante Eckplatz blieb unbebaut.“"
                            },
                            {
                                "example_id": "8970fe10-ee3c-46f4-bcc5-1c62d806a615",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„Hier besetzt das Haus einen Eckplatz an der bogig verlaufenden Schulstraße.“"
                            },
                            {
                                "example_id": "66d509b1-29ac-4fbc-812d-55c3b84a80a1",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„Das Landhaus in Zehlendorf-West, das auf einem Eckplatz steht, wurde in die Diagonale gerückt.“"
                            },
                            {
                                "example_id": "3ca8e163-043e-4903-8de6-e3ac1ad28e66",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„An den zwei Ecken der Westseite wurden Eckplätze auf quadratischem Grundriss angelegt, die mit streng beschnittenen Kleinbäumen gerahmt waren.“"
                            },
                            {
                                "example_id": "3dc5a748-045c-4cf7-ab25-c07f7c9533e9",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "„Letzte Erwähnung findet diese Kirche am Heilgeisttor im Jahr 1309, schon 1329 erwähnt das Stadtbuch an dieser Stelle nur noch einen Eckplatz.“"
                            },
                            {
                                "example_id": "bdcb1dd5-0f18-4049-a911-875c918703b9",
                                "sense_id": "e53e364d-9023-3ffd-81b0-0d3a6c088db2",
                                "text": "[Tuk-Tuks in Phnom Penh:] „Sein Standplatz ist fast an der Ecke Siswath Quay/Straße 136. Aber eben nur fast. Den lukrativen Eckplatz haben die Platzhirsche belegt, die dort seit Jahren Touristen und Nachtschwärmern, die in den Bars der 136. Straße Party machen, ihre Dienste anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
