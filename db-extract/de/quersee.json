                "senses": [
                    {
                        "sense_id": "850a7ccf-686c-3dd9-9d04-60a25887b117",
                        "entry_id": "bf23c2b8-2566-3de8-b03d-7c59e0018b93",
                        "glosses": [
                            "Wellen, die auf ein fahrendes Schiff seitwärts auftreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdbb9dff-804e-46e9-b6c1-0f6695fb1a23",
                                "sense_id": "850a7ccf-686c-3dd9-9d04-60a25887b117",
                                "text": "„Es gab Gegenseen, Querseen, Heckseen, und alles zur gleichen Zeit.“"
                            },
                            {
                                "example_id": "70b8b790-82a1-476d-996c-cf277091a78f",
                                "sense_id": "850a7ccf-686c-3dd9-9d04-60a25887b117",
                                "text": "„Der Anhänger muß dagegen auch in leerem Zustand wenigstens ausreichenden Stabilitätsumfang besitzen und dieses durch seine allgemeine Form und Reserve-Verdrang gewährleisten, um im Schlepp bei Kreuz- oder Quersee nicht zu kentern.“"
                            },
                            {
                                "example_id": "facf30fe-c6d8-49ae-aad6-feac092ea376",
                                "sense_id": "850a7ccf-686c-3dd9-9d04-60a25887b117",
                                "text": "„Weil das Meer dort nur acht Meter tief ist, türmen sich gefährliche Querseen auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
