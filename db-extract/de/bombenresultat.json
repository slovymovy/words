                "senses": [
                    {
                        "sense_id": "ee4c864e-81d6-31b4-93af-64b6c6ac915a",
                        "entry_id": "4892206e-a531-38fd-b570-678dcb4903d3",
                        "glosses": [
                            "ein äußerst gutes Resultat einer Aktion"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "376ec37a-c46f-4f85-bfee-b017425596fa",
                                "sense_id": "ee4c864e-81d6-31b4-93af-64b6c6ac915a",
                                "text": "„Und was macht Danica Patrick? Kann die 31-Jährige an ihre Bombenvorstellung von Daytona anknüpfen? Dort gewann sie als erste Frau eine Pole-Position, tummelte sich im gesamten Rennverlauf munter an der Spitze und lag eingangs der letzten Runde noch auf Platz drei. Lediglich ihre Unerfahrenheit verhinderte letztlich ein Bombenresultat und in Talladega übt Patrick bereits im Nationwide-Rennen am Samstag, um ihren achten Platz von Daytona vielleicht verbessern zu können.“"
                            },
                            {
                                "example_id": "903b11e2-8074-4237-be70-10810d2307f6",
                                "sense_id": "ee4c864e-81d6-31b4-93af-64b6c6ac915a",
                                "text": "„Nach Bombenresultat in Abfahrt: Schlagen Ski-Girls auch im Super-G zu?“"
                            },
                            {
                                "example_id": "58272540-b9b3-4ea6-bea2-dc23b1329e7d",
                                "sense_id": "ee4c864e-81d6-31b4-93af-64b6c6ac915a",
                                "text": "„Das ist ein Bombenresultat bei den Internationalen Deutschen Hallen-Meisterschaften der A- und B-Jugend!“"
                            },
                            {
                                "example_id": "fd7f489e-7741-453f-8457-4fd5b0f17cb2",
                                "sense_id": "ee4c864e-81d6-31b4-93af-64b6c6ac915a",
                                "text": "„Am ersten internen Kniendmatch, nahmen sechs Schützen teil. Gewonnen wurde der interne Wettkampf mit einem Bombenresultat, 576 Zähler, von Rolf Hengartner.“"
                            },
                            {
                                "example_id": "5980ea95-6030-4b47-bcf1-476092b692f7",
                                "sense_id": "ee4c864e-81d6-31b4-93af-64b6c6ac915a",
                                "text": "„Mit zwei Schlägen Abstand kann zur Zeit nur der Engländer Matt Ford bei -14 annähernd an das Bombenresultat von Trevor Fisher Jnr. heranreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
