                ],
                "senses": [
                    {
                        "sense_id": "fbed80d4-5f28-3469-ad05-283093441bba",
                        "entry_id": "312598e6-cb92-3f31-b4a5-b27be6bbe3b5",
                        "glosses": [
                            "de klanten van een bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b8efac-5fea-4b14-90ab-a74afc98be4e",
                                "sense_id": "fbed80d4-5f28-3469-ad05-283093441bba",
                                "text": "Gaia mag van de rechter het cliënteel van Renmans ook geen beelden tonen van mishandelde paarden. De dierenrechtenorganisatie beschuldigt Renmans ervan paardenmishandeling in Argentinië te ondersteunen of er een aandeel in te hebben."
                            },
                            {
                                "example_id": "537b51f6-7a49-4e13-9a61-565cceae1276",
                                "sense_id": "fbed80d4-5f28-3469-ad05-283093441bba",
                                "text": "De investering past in de diversificatieplannen van Harley-Davidson, dat door het ouder worden van zijn traditionele cliënteel ook zijn verkoop ziet zakken."
                            }
                        ]
                    }
                ],
                "translations": [
