                "senses": [
                    {
                        "sense_id": "c47a9a6a-8d3a-3fe3-b30f-b762eee025cb",
                        "entry_id": "094af8d9-d475-3e80-9a96-6f03cf9c693e",
                        "glosses": [
                            "Qualifie un organisme parasite qui se développe aux dépens d’un hôte dont les cellules restent vivantes pendant la colonisation."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "a8de5c1f-ae9c-4c5e-8b8c-46a8ac6823a5",
                                "sense_id": "c47a9a6a-8d3a-3fe3-b30f-b762eee025cb",
                                "text": "La conséquence du mode de vie biotrophe est l'affaiblissement de la plante, qui survit malgré tout et continue à fournir des nutriments à l'agent pathogène."
                            },
                            {
                                "example_id": "6825e652-cc4b-4664-98b6-0f39c1ca69cf",
                                "sense_id": "c47a9a6a-8d3a-3fe3-b30f-b762eee025cb",
                                "text": "Un des exemples les plus connus d'agent pathogène biotrophe est le champignon responsable de l'oïdium des céréales, Blumeria graminis, qui supprime les défenses végétales et forme des suçoirs ou haustria permettant les échanges d'acides aminés et de sucres à travers les membranes plasmiques de l'agent pathogène et de la cellule de céréale infectée."
                            }
                        ]
                    }
                ],
