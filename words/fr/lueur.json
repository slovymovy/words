                {
                    "sense_id": "484235eb-b4c3-3696-874e-73ef048dec0d",
                    "sense_definition": "Lumière faible, diffuse ou passagère.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la <w>lueur</w> d'une bougie, elle lisait tranquillement son livre dans le noir.",
                            "target_lang_translations": {
                                "en": "By the <w>glow</w> of a candle, she was quietly reading her book in the dark.",
                                "ru": "При <w>свете</w> свечи она спокойно читала книгу в темноте.",
                                "nl": "Bij het <w>schijnsel</w> van een kaars las zij rustig haar boek in het donker.",
                                "de": "Im <w>Schein</w> einer Kerze las sie ruhig ihr Buch im Dunkeln.",
                                "pl": "W <w>poblasku</w> świecy spokojnie czytała swoją książkę w ciemnościach.",
                                "it": "Al <w>barlume</w> di una candela, lei leggeva tranquillamente il suo libro nel buio.",
                                "cs": "Při <w>záři</w> svíčky klidně četla svou knihu ve tmě.",
                                "tr": "Bir mumun <w>ışığında</w>, kitabını karanlıkta sakin sakin okuyordu.",
                                "es": "A la <w>luz</w> de una vela, ella leía tranquilamente su libro en la oscuridad.",
                                "zh": "借着烛火的<w>微光</w>，她静静地在黑暗中读着书。"
                            }
                        },
                        {
                            "text": "Les randonneurs se sont mis en route dès les premières <w>lueurs</w> du jour.",
                            "target_lang_translations": {
                                "en": "The hikers set off at the first <w>glimmers</w> of daylight.",
                                "ru": "Туристы отправились в путь с первыми <w>проблесками</w> рассвета.",
                                "nl": "De wandelaars gingen al op pad bij de eerste <w>schijnsels</w> van de dag.",
                                "de": "Die Wanderer machten sich schon bei den ersten <w>Schimmern</w> des Tages auf den Weg.",
                                "pl": "Turyści ruszyli w drogę już przy pierwszych <w>przebłyskach</w> dnia.",
                                "it": "Gli escursionisti si sono messi in cammino alle prime <w>luci</w> del giorno.",
                                "cs": "Turisté vyrazili na cestu už za prvního <w>rozbřesku</w>.",
                                "tr": "Yürüyüşçüler günün ilk <w>ışıklarıyla</w> birlikte yola koyuldu.",
                                "es": "Los excursionistas se pusieron en marcha con las primeras <w>luces</w> del día.",
                                "zh": "徒步者们在天边刚泛起的<w>微光</w>中就出发了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clarté"
                    ],
                    "antonyms": [
                        "obscurité",
                        "ténèbres"
                    ],
                    "common_phrases": [
