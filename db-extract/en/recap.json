                ],
                "senses": [
                    {
                        "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                        "entry_id": "9c691941-0f5e-3c11-83d3-b5fb76f39d32",
                        "glosses": [
                            "A tire that has had new tread glued on."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a77c077-7c0f-4642-9245-f568ae11eaa8",
                                "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                                "text": "He refused to buy recaps because he didn't trust them not to come apart on the highway."
                            },
                            {
                                "example_id": "9a7ee1ca-fb0e-4642-ae4c-648a435cab95",
                                "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                                "text": "As she did so, Stacy noted that the tire had been a recap—a tire created by gluing a new outer portion of tread onto the worn inner core of old tires."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "767037c8-791e-40a7-8ae7-6b0904696745",
                        "source_entry_id": "9c691941-0f5e-3c11-83d3-b5fb76f39d32",
