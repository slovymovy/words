                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                        "entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                        "glosses": [
                            "An actor who specializes in tragic roles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01cf8c9f-1e9e-434f-b277-c887134a88fc",
                                "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                "text": "Euen thoſe you were wont to take such delight in the Tragedians of the City."
                            },
                            {
                                "example_id": "89b2b8cf-3eb9-4c59-a885-ca4da2bbbad6",
                                "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                "text": "And as for the separation scene from the child, while Becky was reciting it, Emmy retired altogether behind her pocket-handkerchief, so that the consummate little tragedian must have been charmed to see the effect which her performance produced on her audience."
                            },
                            {
                                "example_id": "342aa6c7-da9a-4daf-969c-ba9b315e71fe",
                                "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                "text": "Greene died of a debauch; and Marlowe, the gracer of tragedians, perished in an ignominious brawl."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdaea335-ac2b-360e-a1c4-5b219c63e079",
                        "entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                        "glosses": [
                            "A playwright who writes tragedies."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7228e686-888d-4c8f-a0eb-93f97227df8e",
                        "source_entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                        "source_sense_description": "actor who specializes in tragic roles",
                        "target_lang_word": "tragédien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragédien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                        "entry_id": "14e213d2-943a-3adc-9757-f42f814aebf4",
                                        "glosses": [
                                            "Acteur, actrice tragique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e909e3-15aa-4c7b-b4d8-dbdc44c91aca",
                                                "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                                "text": "C’est un grand tragédien, une grande tragédienne."
                                            },
                                            {
                                                "example_id": "2bc22e51-4173-434e-bbf9-72435fa6f99c",
                                                "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                                "text": "aussi, jouerais-je là un rôle hors de mon emploi, comme disent les tragédiens, et je risquerais de me faire siffler, ce qui est inutile"
                                            },
                                            {
                                                "example_id": "a16d2706-741f-458d-b028-fd9b79e91aca",
                                                "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                                "text": "Un premier accessit de tragédie et un tragédien, ce n’est malheureusement pas la même chose…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cfe7cee-612f-4687-93bc-770d013e1fd2",
                        "source_entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                        "source_sense_description": "actor who specializes in tragic roles",
                        "target_lang_word": "tragédienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragédienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0822bd7f-885f-3a9d-8330-a278e0cab20a",
                                        "entry_id": "146921cf-9b90-3ec6-90e4-f96c1af4d302",
                                        "glosses": [
                                            "Actrice tragique, ou qui excelle dans les rôles tragiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0be36c-8667-47d5-9140-208b349061dc",
                                                "sense_id": "0822bd7f-885f-3a9d-8330-a278e0cab20a",
                                                "text": "Mademoiselle Georges réunit également au degré le plus rare les qualités diverses et quelquefois même opposées que son rôle exige. […] Mère au premier acte, femme au second, grande comédienne dans cette scène de ménage avec le duc de Ferrare où elle est si bien secondée par M. Lockroy, grande tragédienne pendant l’insulte, grande tragédienne pendant la vengeance, grande tragédienne pendant le châtiment, elle passe comme elle veut, et sans effort, du pathétique tendre au pathétique terrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f44e1bf-db22-318a-aa66-1c05524f119f",
                                        "entry_id": "146921cf-9b90-3ec6-90e4-f96c1af4d302",
                                        "glosses": [
                                            "Celle qui se comporte de manière si mélodramatique qu’on la compare à une actrice tragique."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "381a68cd-9686-4737-b39a-8923ea98b7d1",
                                                "sense_id": "4f44e1bf-db22-318a-aa66-1c05524f119f",
                                                "text": "Elle exagère, c’est une vraie tragédienne !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bb7a800-de74-48e7-9e68-7483f3b3ae6a",
                        "source_entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                        "source_sense_description": "actor who specializes in tragic roles",
                        "target_lang_word": "Tragöde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tragöde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ada391a-a358-3353-a638-eea0eb1b6987",
                                        "entry_id": "51d97d82-68e7-3b58-8f2b-77a362b40f19",
                                        "glosses": [
                                            "Darsteller, der eine tragische Rolle verkörpert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25030a7-d94d-42e8-b701-0ac1ffaed997",
                                                "sense_id": "4ada391a-a358-3353-a638-eea0eb1b6987",
                                                "text": "Er ist ein begnadeter Tragöde und auf allen Theaterbühnen sehr gefragt."
                                            },
                                            {
                                                "example_id": "9425f37f-ac51-4d51-9747-e2d702d67cc1",
                                                "sense_id": "4ada391a-a358-3353-a638-eea0eb1b6987",
                                                "text": "Durch die Erkrankung unseres Tragöden und seiner Zweitbesetzung muss die Vorstellung heute ausfallen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25ff773d-5411-39aa-aede-e93a6c6cb09e",
                                        "entry_id": "51d97d82-68e7-3b58-8f2b-77a362b40f19",
                                        "glosses": [
                                            "Verfasser von Tragödien"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "499d26c9-ff09-4925-8cea-c67591a6c498",
                                                "sense_id": "25ff773d-5411-39aa-aede-e93a6c6cb09e",
                                                "text": "Der Argentinier hat eine Reihe von preisgekrönten Tragödien verfasst und sich mittlerweile einen Namen als Tragöde gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f754c89-ad5e-44d7-b1c4-3567014ac400",
                        "source_entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
