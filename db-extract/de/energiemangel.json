                "senses": [
                    {
                        "sense_id": "adc01cc6-b28f-3475-b721-26912cf8a3ba",
                        "entry_id": "31611689-e55d-305c-9ccd-91da5d7f6109",
                        "glosses": [
                            "Mangel an ausreichend Energie; Zustand, bei dem zu wenig Energie verfügbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7693b4a-6a1c-451d-ac5f-93f53dc34edf",
                                "sense_id": "adc01cc6-b28f-3475-b721-26912cf8a3ba",
                                "text": "„Die kommunale Gesellschaft für Stadtentwicklung und Stadtmarketing hatte die stromlose Schlittschuhbahn schon im vergangenen Jahr gekauft, als drohender Energiemangel und hohe Strompreise noch kein Thema waren.“"
                            },
                            {
                                "example_id": "f6e21d86-b5a5-4b35-8b2b-1fcac4a99193",
                                "sense_id": "adc01cc6-b28f-3475-b721-26912cf8a3ba",
                                "text": "„Während weite Teile der Gesellschaft auf einen Energiemangel vorbereitet werden, soll es beim Verkehr in Deutschland keine Einschränkungen in Form eines Tempolimits auf Autobahnen geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
