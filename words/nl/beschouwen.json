    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c19e340-7c6b-3867-8f0b-cd6993177ac9",
                    "sense_definition": "iets of iemand op een bepaalde manier zien of beoordelen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beoordeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>beschouwde</w> zichzelf als de ideale kandidaat voor de nieuwe baan.",
                            "target_lang_translations": {
                                "en": "He <w>considered</w> himself the ideal candidate for the new job.",
                                "ru": "Он <w>считал</w> себя идеальным кандидатом на новую работу."
                            }
                        },
                        {
                            "text": "Wij <w>beschouwen</w> dit project als een groot succes voor ons bedrijf.",
                            "target_lang_translations": {
                                "en": "We <w>regard</w> this project as a great success for our company.",
                                "ru": "Мы <w>рассматриваем</w> этот проект как большой успех для нашей компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "opvatten",
                        "zien",
                        "vinden"
                    ],
                    "common_phrases": [
                        "beschouwen als",
                        "worden beschouwd als"
                    ],
                    "target_lang_definitions": {
                        "en": "To see or judge something or someone in a particular way.",
                        "ru": "видеть или оценивать что-либо или кого-либо определенным образом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to assign a quality to or think of as"
                            },
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "to look upon or think of in a specific way"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "to have a particular opinion or way of thinking about"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "считать",
                                "target_lang_sense_clarification": "приписывать качество или рассматривать как"
                            },
                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "воспринимать определенным образом"
                            },
                            {
                                "target_lang_word": "расценивать",
                                "target_lang_sense_clarification": "давать оценку чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee9b57a8-be5f-3f96-96b0-a4771dbf1fe8",
                    "sense_definition": "iets met veel aandacht en concentratie bekijken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>beschouwde</w> het juweel in alle glorie voordat ze het kocht.",
                            "target_lang_translations": {
                                "en": "She <w>contemplated</w> the jewel in all its glory before she bought it.",
                                "ru": "Она <w>созерцала</w> драгоценность во всей красе, прежде чем купить её."
                            }
                        },
                        {
                            "text": "De kunstenaar bleef minutenlang zijn eigen schilderij aandachtig <w>beschouwen</w>.",
                            "target_lang_translations": {
                                "en": "The artist continued to <w>observe</w> his own painting attentively for several minutes.",
                                "ru": "Художник в течение нескольких минут продолжал внимательно <w>рассматривать</w> свою собственную картину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aandachtig beschouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To look at something with great attention and concentration.",
                        "ru": "смотреть на что-либо с большим вниманием и концентрацией"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contemplate",
                                "target_lang_sense_clarification": "to look at thoughtfully for a long time"
                            },
                            {
                                "target_lang_word": "observe",
                                "target_lang_sense_clarification": "to watch or look at carefully"
                            },
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to look at attentively"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "созерцать",
                                "target_lang_sense_clarification": "внимательно и долго рассматривать"
                            },
                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "внимательно изучать взглядом"
                            },
                            {
                                "target_lang_word": "обозревать",
                                "target_lang_sense_clarification": "осматривать со вниманием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}