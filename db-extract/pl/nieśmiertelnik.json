                    },
                    {
                        "translation_id": "db1cdd88-a7ed-4208-a063-8eb20a8387b4",
                        "source_entry_id": "0f385017-4fca-3e35-97a8-40b84ca1b513",
                        "source_sense_id": "ea407aa7-51f3-321a-8390-1e0a41326d9e",
                        "target_lang_word": "vojenská známka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72574c9f-5a02-4b08-8b5f-e57351969ce9",
                        "source_entry_id": "0f385017-4fca-3e35-97a8-40b84ca1b513",
                        "source_sense_id": "ea407aa7-51f3-321a-8390-1e0a41326d9e",
                        "target_lang_word": "Erkennungsmarke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erkennungsmarke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92c90e1f-2c99-33ec-8b5c-569c0e3172fb",
                                        "entry_id": "b51795da-5951-3f8a-9048-b920e48c939b",
                                        "glosses": [
                                            "teilbares Metallplättchen an einer Kette, das ein Soldat um den Hals trägt und auf dem wichtige Information über ihn eingeprägt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ff4983c-05e8-4ce8-a999-f0daa7f05b73",
                                                "sense_id": "92c90e1f-2c99-33ec-8b5c-569c0e3172fb",
                                                "text": "Die Erkennungsmarke soll dabei helfen Gefallene zu identifizieren, die stark verstümmelt sind."
                                            },
                                            {
                                                "example_id": "bcef7607-af83-40f7-a1db-fe2882063d0c",
                                                "sense_id": "92c90e1f-2c99-33ec-8b5c-569c0e3172fb",
                                                "text": "Erkennungsmarken erfreuen sich auch als Modeartikel einiger Beliebtheit."
                                            },
                                            {
                                                "example_id": "a5fab3ea-f5bd-47e2-91e0-39347f1312ec",
                                                "sense_id": "92c90e1f-2c99-33ec-8b5c-569c0e3172fb",
                                                "text": "„Ich knöpfte ihm Rock und Hemd auf und schnitt das Band der Erkennungsmarke durch.“"
                                            },
                                            {
                                                "example_id": "4cb86f8c-cf66-41fa-b536-ece51f0cee18",
                                                "sense_id": "92c90e1f-2c99-33ec-8b5c-569c0e3172fb",
                                                "text": "„Es war leichter bei diesen Leichen, die Erkennungsmarken unter den Uniformen herauszuschneiden; das Schneewasser hatte den Stoff bereits aufgeweicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9584ba7a-1e82-4315-8f4e-a6c9164545c6",
                        "source_entry_id": "0f385017-4fca-3e35-97a8-40b84ca1b513",
                        "source_sense_id": "ea407aa7-51f3-321a-8390-1e0a41326d9e",
                        "target_lang_word": "Hundemarke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hundemarke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a000546-26e2-366f-b93f-57f85c0092ad",
                                        "entry_id": "fe2b1727-172c-3249-a9c1-8d060e863aa9",
                                        "glosses": [
                                            "Marken für das Hundehalsband als Zeichen, dass die Hundesteuer entrichtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6071a939-0b01-4709-a684-213e25e39333",
                                                "sense_id": "6a000546-26e2-366f-b93f-57f85c0092ad",
                                                "text": "Die Hundemarke wird von der zuständigen Gemeinde, bei ordentlicher Anmeldung des Hundes und nach Entrichtung der dann jährlich fälligen Hundesteuer, ausgegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c02bbf83-aa43-3c48-ae2a-0931ad7cfb9e",
                                        "entry_id": "fe2b1727-172c-3249-a9c1-8d060e863aa9",
                                        "glosses": [
                                            "Erkennungsmarke eines Soldaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4dda1b-c0e6-4b7c-aaf5-5bd67b12a447",
                                                "sense_id": "c02bbf83-aa43-3c48-ae2a-0931ad7cfb9e",
                                                "text": "Die Erkennungsmarke eines jeden Soldaten, die sogenannte Hundemarke wird im Falle seines Todes zweigeteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "16cafe69-de59-347f-8da8-ffa0832b9c90",
                                        "entry_id": "fe2b1727-172c-3249-a9c1-8d060e863aa9",
                                        "glosses": [
                                            "Dienstmarke eines Polizisten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1cd3247-2e99-42bf-b177-4e779c1bbe08",
                                                "sense_id": "16cafe69-de59-347f-8da8-ffa0832b9c90",
                                                "text": "Jeder Polizist trägt im Dienst, zur Legitimation seiner Person, eine Dienstmarke oder eine sogenannte Hundemarke bei sich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
