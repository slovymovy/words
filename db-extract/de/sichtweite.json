                        "form": "die Sichtweiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                        "entry_id": "fdab5bf6-0c33-3765-91ba-5d02ea287545",
                        "glosses": [
                            "der Abstand zum Rand des visuellen Erfassungsbereiches; die Entfernung, bis zu der man etwas erkennen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2be0ab-4684-4e03-bf19-3882e28ecf32",
                                "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                                "text": "Nebel schränkt die Sichtweite drastisch ein."
                            },
                            {
                                "example_id": "37c68240-013b-4012-9b6d-ee976dc04e4e",
                                "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                                "text": "„Solange die Polizisten in Sichtweite waren, gab es für den Blick einen Halt.“"
                            },
                            {
                                "example_id": "42702b21-3834-4a95-8376-fc08608d0b82",
                                "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                                "text": "„Das Deutsche Reich begann jetzt unmittelbar am Südufer der Donau, in Sichtweite der Hauptstadt Bratislava.“"
                            },
                            {
                                "example_id": "11710333-e5d5-4f70-87fe-813a7d2d30ec",
                                "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                                "text": "„Die Piroge lag in Sichtweite einer sichelförmigen Insel.“"
                            },
                            {
                                "example_id": "70d73bc2-94e2-4c7d-84ba-0a6d4c30a533",
                                "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                                "text": "„Leider vereiteln das mühevolle Anziehen von Helm und Handschuhen eine schnelle Flucht auf dem Motorrad, und als der Wagen schon außer Sichtweite war, hatte ich bereits eine Menge Schaulustiger angezogen.“"
                            },
                            {
                                "example_id": "bd0917a3-cedd-46fc-bd06-1d946c5a4849",
                                "sense_id": "701b3de7-bc31-3dc1-b44c-a68f37933767",
                                "text": "„Bei Sichtweiten von nur wenigen Metern begann […] ein aufwendiger Einsatz von Bodenkräften, zudem kreiste ein Hubschrauber konstant über dem Berg, um die beiden bei einer Wolkenlücke sofort mit einer Winde an Bord holen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
