{
    "word_family": [
        "spluttering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                    "sense_definition": "To make a series of short, explosive sounds, often while emitting small particles or liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_and_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old pen began to <w>splutter</w> and scratch across the paper as he wrote.",
                            "target_lang_translations": {
                                "ru": "Старая ручка начала <w>фыркать</w> и царапать бумагу, пока он писал."
                            }
                        },
                        {
                            "text": "The damp log on the fire started to <w>splutter</w> and sent sparks up the chimney.",
                            "target_lang_translations": {
                                "ru": "Сырое полено в камине начало <w>трещать</w>, выбрасывая искры в дымоход."
                            }
                        }
                    ],
                    "synonyms": [
                        "sputter"
                    ],
                    "common_phrases": [
                        "fire splutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать серию коротких взрывных звуков, часто с выбросом мелких частиц или жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фыркать",
                                "target_lang_sense_clarification": "о звуках, издаваемых механизмом или огнем"
                            },
                            {
                                "target_lang_word": "трещать",
                                "target_lang_sense_clarification": "о звуках, сопровождающих горение или работу устройства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71480d6c-f577-33c4-9ff6-4060fc228909",
                    "sense_definition": "To speak in a hurried, confused, or unclear way, often due to anger or excitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so angry that he could only <w>splutter</w> and point at the broken vase.",
                            "target_lang_translations": {
                                "ru": "Он был так зол, что мог только <w>захлебываться</w> словами и указывать на разбитую вазу."
                            }
                        },
                        {
                            "text": "She tried to explain, but she could only <w>splutter</w> out a few incoherent words.",
                            "target_lang_translations": {
                                "ru": "Она пыталась объясниться, но могла лишь <w>выбормотать</w> несколько бессвязных слов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить поспешно, сбивчиво или невнятно, часто из-за гнева или волнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захлебываться",
                                "target_lang_sense_clarification": "говорить сбивчиво от сильных эмоций"
                            },
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "говорить невнятно и быстро"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1115eb1-e0f0-393c-aad6-36dde831eb4c",
                    "sense_definition": "A sudden, forceful emission of small drops or particles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_and_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a sudden <w>splutter</w> of sparks when the fuse was lit.",
                            "target_lang_translations": {
                                "ru": "Раздалось внезапное <w>фырканье</w> искр, когда запалили фитиль."
                            }
                        },
                        {
                            "text": "The pipe gave a loud <w>splutter</w> of water before it finally stopped leaking.",
                            "target_lang_translations": {
                                "ru": "Труба издала громкое <w>фырканье</w> воды, прежде чем окончательно перестала течь."
                            }
                        }
                    ],
                    "synonyms": [
                        "sputter"
                    ],
                    "common_phrases": [
                        "splutter of sparks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, резкий выброс мелких капель или частиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фырканье",
                                "target_lang_sense_clarification": "резкий звук или выброс"
                            },
                            {
                                "target_lang_word": "треск",
                                "target_lang_sense_clarification": "резкий звук, сопровождающий выброс частиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6c0803-b312-357d-b4f3-aa72f7d302e9",
                    "sense_definition": "A confused or chaotic outburst of speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man let out a <w>splutter</w> of rage when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Старик разразился гневным <w>бормотанием</w>, когда услышал новости."
                            }
                        },
                        {
                            "text": "Her explanation was just a <w>splutter</w> of excuses that made no sense.",
                            "target_lang_translations": {
                                "ru": "Ее объяснение было лишь бессвязным <w>лепетом</w> оправданий, лишенным всякого смысла."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбивчивый или хаотичный поток речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бормотание",
                                "target_lang_sense_clarification": "неразборчивая, сбивчивая речь"
                            },
                            {
                                "target_lang_word": "лепет",
                                "target_lang_sense_clarification": "бессвязная, эмоциональная речь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}