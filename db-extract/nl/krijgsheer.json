                        "glosses": [
                            "aanvoerder die controle heeft over een beperkt gebied, meestal onafhankelijk van de centrale regering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c59d2be-1a89-448a-9c78-fe7a9f6ff83a",
                                "sense_id": "f9f689a0-6915-3dca-bdff-2aab3169a4a8",
                                "text": "in Somalië, Liberia, Sierra Leone, Afghanistan en de Congo hebben krijgsheren lange tijd de dienst uitgemaakt"
                            }
