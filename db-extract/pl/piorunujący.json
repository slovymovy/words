                                "target_senses": [
                                    {
                                        "sense_id": "a8c41e67-8d89-3c9a-b872-86b936cc00e6",
                                        "entry_id": "aaf4b1cd-9220-37d1-a51b-746e13b2fcb1",
                                        "glosses": [
                                            "The act by which a person or animal is physically stunned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7531c829-002b-40e6-85fc-68e797c85a6a",
                                                "sense_id": "a8c41e67-8d89-3c9a-b872-86b936cc00e6",
                                                "text": "He wished he had tens of thousands more troops under Andez's control so he could round up every one of these demonstrators. But it was futile to continue cracking down. The stunnings, beatings and arrests had only inflamed them further."
                                            }
                                        ]
                                    }
