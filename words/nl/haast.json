                {
                    "sense_id": "b5fdb97a-382d-3e8a-be1c-ea6f2fddc14c",
                    "sense_definition": "gebiedende wijs van het werkwoord <w>haasten</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Haast</w> je een beetje, anders komen we te laat voor de film!",
                            "target_lang_translations": {
                                "en": "<w>Hurry</w> up a bit, otherwise we'll be late for the movie!",
                                "ru": "<w>Поторапливайся</w>, иначе мы опоздаем на фильм!"
                            }
                        },
                        {
                            "text": "<w>Haast</w> u niet, we hebben nog alle tijd van de wereld.",
                            "target_lang_translations": {
