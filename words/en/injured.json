                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4254fa17-2828-3307-82b3-932eb2a72019",
                    "sense_definition": "Simple past and past participle of <w>injure</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>injured</w> his knee while playing football with his friends.",
                            "target_lang_translations": {
                                "ru": "Он <w>повредил</w> колено, играя в футбол с друзьями.",
                                "zh": "他和朋友踢足球时<w>弄伤</w>了膝盖。"
                            }
                        },
                        {
                            "text": "The falling branch <w>injured</w> several parked cars on the street.",
                            "target_lang_translations": {
                                "ru": "Падающая ветка <w>повредила</w> несколько припаркованных на улице машин.",
                                "zh": "掉落的树枝<w>损坏</w>了街上停着的几辆车。"
                            }
                        }
                    ],
                    "synonyms": [
