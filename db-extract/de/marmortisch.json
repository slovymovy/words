                "senses": [
                    {
                        "sense_id": "65f3aad6-c497-351f-9c53-39d3ade8d8f3",
                        "entry_id": "a47e67ee-7e5a-30d3-9e35-8f20b7cb9638",
                        "glosses": [
                            "Tisch, bei dem mindestens die Platte aus Marmor besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ed4941-4438-4762-a1c3-b733878ddabd",
                                "sense_id": "65f3aad6-c497-351f-9c53-39d3ade8d8f3",
                                "text": "„6000 Gäste speisten an Marmortischen von goldenem Geschirr oder wurden im weitläufigen Park unterhalten.“"
                            },
                            {
                                "example_id": "d6a9fb27-02eb-4fe2-8062-34a135c95bff",
                                "sense_id": "65f3aad6-c497-351f-9c53-39d3ade8d8f3",
                                "text": "„Aus den Lautsprechern in der Decke tönte John Coltrane, und die Marmortische und die Bar glänzten so, dass sogar das gedämpfte Licht in ihnen funkelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
