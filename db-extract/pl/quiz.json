                "translations": [
                    {
                        "translation_id": "c3772064-b5af-4c4f-8b93-fd0ecd9835ec",
                        "source_entry_id": "e76a67f6-423f-370a-b4c4-6a918579ecee",
                        "source_sense_id": "ea7235d5-8e39-3b39-98bb-68771943d81a",
                        "target_lang_word": "quiz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quiz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33c7e4a-ba7f-37e8-8db7-10bf29df8b29",
                                        "entry_id": "e9e4c8c6-a885-35b0-9664-749720a485bb",
                                        "glosses": [
                                            "An odd, puzzling or absurd person or thing."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90ad1b9-e3cf-4224-a5bc-f71ba3d8b748",
                                                "sense_id": "a33c7e4a-ba7f-37e8-8db7-10bf29df8b29",
                                                "text": "I've always heard he was a quiz, says another, or a quoz, or some such word ; but I did not know he was such a book-worm."
                                            },
                                            {
                                                "example_id": "24899b0a-5d5b-4ded-9861-e9a01e0b9020",
                                                "sense_id": "a33c7e4a-ba7f-37e8-8db7-10bf29df8b29",
                                                "text": "I tell you I am going to the music shop. I trust to your honour. Lord Rawson, I know, will call me a fool for trusting to the honour of a quiz."
                                            },
                                            {
                                                "example_id": "f7628ed5-0433-47f5-b5c2-95039126e387",
                                                "sense_id": "a33c7e4a-ba7f-37e8-8db7-10bf29df8b29",
                                                "text": "Where did you get that quiz of a hat? It makes you look like an old witch."
                                            },
                                            {
                                                "example_id": "d31c3823-754c-4ce9-91a7-5bef66498f53",
                                                "sense_id": "a33c7e4a-ba7f-37e8-8db7-10bf29df8b29",
                                                "text": "“I’m afraid you’re a sad quiz,” said Mrs. Bungay. ¶ “Quiz! never made a joke in my—hullo! who’s here? How d’ye do, Pendennis?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40d7854f-bd80-3c87-92d2-a1e15c0e3604",
                                        "entry_id": "e9e4c8c6-a885-35b0-9664-749720a485bb",
                                        "glosses": [
                                            "One who questions or interrogates; a prying person."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b183685-a8cf-34c9-81a1-6fd873fb8d4e",
                                        "entry_id": "e9e4c8c6-a885-35b0-9664-749720a485bb",
                                        "glosses": [
                                            "A competition in the answering of questions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb9c512-161a-4839-8763-98605ef7d9ee",
                                                "sense_id": "6b183685-a8cf-34c9-81a1-6fd873fb8d4e",
                                                "text": "We came second in the pub quiz."
                                            },
                                            {
                                                "example_id": "cabed8dd-e5d1-48c0-9724-d3cea3ba30cb",
                                                "sense_id": "6b183685-a8cf-34c9-81a1-6fd873fb8d4e",
                                                "text": "Once all six friends are clear that the topic of Janet's story is a pub quiz, we launch into talk around this topic, combining factual information about quizzes we have participated in with fantasies about becoming a team ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc0297e-0f63-3d08-83fb-c06ddd62118b",
                                        "entry_id": "e9e4c8c6-a885-35b0-9664-749720a485bb",
                                        "glosses": [
                                            "A school examination of less importance, or of greater brevity, than others given in the same course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5afe344e-d98b-4f2c-ae63-c14dd3c87cf3",
                                                "sense_id": "bfc0297e-0f63-3d08-83fb-c06ddd62118b",
                                                "text": "For many it is hard to envision a scenario where a student completes an online quiz (or test) without using their smartphone, tablet, or other device to look up the answers, or ‘share’ those answers with other students."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quiz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "420d0787-99ca-3562-83ed-2304b465e75f",
                                        "entry_id": "87822681-7af6-3fab-a03d-f74761cd30d1",
                                        "glosses": [
                                            "To hoax; to chaff or mock with pretended seriousness of discourse; to make sport of, as by obscure questions."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afd9730e-5aa7-4bc1-a5bc-623c5f8d3534",
                                                "sense_id": "420d0787-99ca-3562-83ed-2304b465e75f",
                                                "text": "he quizzed unmercifully all the men in the room—"
                                            },
                                            {
                                                "example_id": "aa5a9957-9dea-43f1-a69f-2b8b836f4a0c",
                                                "sense_id": "420d0787-99ca-3562-83ed-2304b465e75f",
                                                "text": "'Now, Puddock, back him up—encourage your man,' said Devereux, who took a perverse pleasure in joking; 'tell him to flay the lump, splat him, divide him, and cut him in two pieces—'\nIt was a custom of the corps to quiz Puddock about his cookery […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e76b44c-6287-3893-9526-eca5e70decc1",
                                        "entry_id": "87822681-7af6-3fab-a03d-f74761cd30d1",
                                        "glosses": [
                                            "To peer at; to eye suspiciously or mockingly."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "183f1535-5bd0-3b0f-aee1-eb1c1d49fc23",
                                        "entry_id": "87822681-7af6-3fab-a03d-f74761cd30d1",
                                        "glosses": [
                                            "To question (someone) closely, to interrogate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc7b8b37-d1d0-423e-b6a4-0fb487b426d8",
                                                "sense_id": "183f1535-5bd0-3b0f-aee1-eb1c1d49fc23",
                                                "text": "He quizzed the suspect for around half an hour."
                                            },
                                            {
                                                "example_id": "4ee3f908-bb63-4cd2-aca9-18e88d094c33",
                                                "sense_id": "183f1535-5bd0-3b0f-aee1-eb1c1d49fc23",
                                                "text": "This week members return to the chamber to quiz the government on the Zimbabwe election, teacher shortages, backlog of asylum applications and improving the system for dementia diagnosis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b4162ae-2057-3639-bfa7-6c8b73fb4efc",
                                        "entry_id": "87822681-7af6-3fab-a03d-f74761cd30d1",
                                        "glosses": [
                                            "To instruct (someone) by means of a quiz."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c739409-9878-3ef1-afa3-83da42ba09df",
                                        "entry_id": "87822681-7af6-3fab-a03d-f74761cd30d1",
                                        "glosses": [
                                            "To play with a quiz."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
