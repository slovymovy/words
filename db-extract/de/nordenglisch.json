                "senses": [
                    {
                        "sense_id": "c01cc639-7421-338e-b545-9a464af0132b",
                        "entry_id": "86d5cf46-4668-3388-9910-72e4bfcdc3bc",
                        "glosses": [
                            "auf Nordengland und/oder dessen Bewohner bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf130809-3db6-47d3-a410-0837ff4fef6c",
                                "sense_id": "c01cc639-7421-338e-b545-9a464af0132b",
                                "text": "„Das Feuer schlug eine tapfere, aber verlorene Schlacht gegen die Kälte und die Feuchtigkeit, die selbst für nordenglische Verhältnisse im März noch elend waren.“"
                            },
                            {
                                "example_id": "32850394-9b1e-461a-b529-4f82a5133fdb",
                                "sense_id": "c01cc639-7421-338e-b545-9a464af0132b",
                                "text": "„Auf mich wirkt er wie eine zahmere, nordenglische Version von Jon Hamm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
