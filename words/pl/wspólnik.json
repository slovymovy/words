            "senses": [
                {
                    "sense_id": "4555ef70-68a5-3a01-b572-cf412da8bdf2",
                    "sense_definition": "Osoba prowadząca z kimś wspólne przedsiębiorstwo lub mająca udział w jakimś przedsięwzięciu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biznes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój <w>wspólnik</w> zaproponował otwarcie nowej filii naszej firmy w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Мой <w>партнёр</w> предложил открыть новый филиал нашей фирмы в центре города."
                            }
                        },
                        {
                            "text": "Bardzo się zapalał do każdego nowego pomysłu swojego <w>wspólnika</w>.",
                            "target_lang_translations": {
                                "ru": "Он с большим воодушевлением воспринимал каждую новую идею своего <w>компаньона</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "udziałowiec",
                        "współpracownik"
                    ],
                    "antonyms": [
                        "konkurent",
                        "rywal"
                    ],
                    "common_phrases": [
                        "wspólnik w biznesie",
                        "wspólnik spółki",
                        "nowy wspólnik"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, ведущий с кем-либо общее предприятие или имеющий долю в каком-либо бизнесе, начинании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партнёр",
                                "target_lang_sense_clarification": "в бизнесе или деле"
                            },
                            {
                                "target_lang_word": "компаньон",
                                "target_lang_sense_clarification": "совладелец предприятия"
                            },
                            {
                                "target_lang_word": "соучредитель",
                                "target_lang_sense_clarification": "один из основателей бизнеса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ee35c26-3ca8-3869-ad89-2fd618c5ecfd",
                    "sense_definition": "Osoba biorąca udział z kimś w popełnieniu przestępstwa, wykroczenia lub oszustwa.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przestępczość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja szybko aresztowała złodzieja i rozpoczęła poszukiwania jego <w>wspólnika</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция быстро арестовала вора и начала поиски его <w>сообщника</w>."
                            }
                        },
                        {
                            "text": "Szuler dostrzegł umówiony ruch ręką swojego <w>wspólnika</w> i podbił stawkę.",
                            "target_lang_translations": {
                                "ru": "Шулер заметил условный жест рукой своего <w>сообщника</w> и поднял ставку."
                            }
                        }
                    ],
                    "synonyms": [
                        "współsprawca",
                        "współwinny"
                    ],
                    "common_phrases": [
                        "wspólnik przestępstwa",
                        "wspólnik kradzieży"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, участвующий вместе с кем-либо в совершении преступления, проступка или обмана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщник",
                                "target_lang_sense_clarification": "в преступлении или афере"
                            },
                            {
                                "target_lang_word": "соучастник",
                                "target_lang_sense_clarification": "в уголовном контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
