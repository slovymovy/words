                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontwikkelde",
                                "target_lang_sense_clarification": "verleden tijd van ontwikkelen"
                            },
                            {
                                "target_lang_word": "ontwikkeld",
                                "target_lang_sense_clarification": "voltooid deelwoord van ontwikkelen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5884713e-5263-34ec-8e61-404f451db152",
                    "sense_definition": "Describing a country or region that is wealthy, industrialized, and has a high standard of living.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Healthcare is generally easily accessible in a <w>developed</w> country.",
                            "target_lang_translations": {
                                "ru": "Медицинское обслуживание, как правило, легко доступно в <w>развитой</w> стране.",
                                "nl": "Gezondheidszorg is over het algemeen gemakkelijk toegankelijk in een <w>ontwikkeld</w> land."
                            }
                        },
                        {
                            "text": "The <w>developed</w> world must do more to reduce carbon emissions.",
                            "target_lang_translations": {
                                "ru": "<w>Развитый</w> мир должен делать больше для сокращения выбросов углерода.",
                                "nl": "De <w>ontwikkelde</w> wereld moet meer doen om de CO2-uitstoot te verminderen."
                            }
                        }
                    ],
                    "synonyms": [
                        "advanced",
                        "industrialised",
                        "first-world"
                    ],
                    "antonyms": [
                        "undeveloped"
                    ],
                    "common_phrases": [
                        "developed country",
                        "developed world",
                        "developed nation",
                        "developed economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает страну или регион с богатой экономикой, промышленностью и высоким уровнем жизни.",
                        "nl": "Beschrijft een land of regio die welvarend en geïndustrialiseerd is en een hoge levensstandaard heeft."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развитый",
                                "target_lang_sense_clarification": "экономически"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontwikkeld",
                                "target_lang_sense_clarification": "economisch gevorderd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650fbdf2-7f9b-3cb2-a5ce-2288af820f26",
                    "sense_definition": "Advanced, mature, or fully formed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a highly <w>developed</w> sense of responsibility for her age.",
                            "target_lang_translations": {
