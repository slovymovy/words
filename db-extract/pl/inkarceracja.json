                    {
                        "sense_id": "8fde5c7d-8257-3321-afdc-a36ec40e8a89",
                        "entry_id": "3f50cbde-8956-3db6-920e-6199a21650fb",
                        "glosses": [
                            "pozbawienie wolności, uwięzienie"
                        ],
                        "tags": [
