                        "glosses": [
                            "Personne admise dans un hôpital, en qualité de malade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4867b2a-99c7-42cc-911f-c16f593e8bfb",
                                "sense_id": "f8f7d5dd-dc8c-39a1-bf96-adc948ad6afb",
                                "text": "Elle est couverte de la même façon que pourrait être couverte une erreur faite par un vaguemestre qui se trompe en mettant un mandat à un hospitalisé à la place d’un autre."
                            },
                            {
                                "example_id": "f1580571-6a94-4e84-ab90-0b410745a61c",
                                "sense_id": "f8f7d5dd-dc8c-39a1-bf96-adc948ad6afb",
                                "text": "Le souci de l’administration de dénuméroter les hospitalisés ne date pas d’hier, mais il s’est longtemps heurté au confort de l’habitude."
                            }
                        ]
                    }
