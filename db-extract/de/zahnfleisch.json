                ],
                "senses": [
                    {
                        "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                        "entry_id": "a4ea2ccf-89cc-3d9c-a466-328da9ab95c8",
                        "glosses": [
                            "ein Teil der Mundschleimhaut, der an den Zähnen anliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c02171-c43a-48e0-b213-79b004e7f710",
                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                "text": "Mein Arzt hat gestern zu mir gemeint, mein Zahnfleisch sehe nicht gut aus."
                            },
                            {
                                "example_id": "e8237549-da78-4d59-9804-2118614632ac",
                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                "text": "„Gleichzeitig reinigte er das Zahnfleisch und den Gaumen mit dem starken Getränk.“"
                            },
                            {
                                "example_id": "18831e99-f0e2-4c77-a271-9b2612412f2b",
                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                "text": "„Fast alle kauten auf irgendwelchen blassgrünen Zweigen herum, die die Zähne säuberten und das Zahnfleisch massierten.“"
                            },
                            {
                                "example_id": "66a3efbe-5587-44ef-8741-716c95ddeb11",
                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                "text": "„Linksseitig kamen mir meine Zähne plötzlich locker vor, als würden sie sich durch das schnelle Aufeinanderschlagen aus dem Zahnfleisch lösen.“"
                            },
                            {
                                "example_id": "3816237a-7d39-4de5-9f1d-acd58fe39180",
                                "sense_id": "fa225940-1dbe-336d-80c8-90cae138a0e5",
                                "text": "„2010 wurde sein erster geruhsamer Sommer seit Langem dadurch getrübt, dass seine Zunge und sein Zahnfleisch wund waren, was ihm Schmerzen beim Essen bereitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
