                                "sense_id": "bc85bf5f-6e8c-317f-88b2-d2598d20166c",
                                "text": "„Ich gih dann Wag zengst Dinge hie.“",
                                "translation": "Ich geh den Weg entlang (ohne Ziel, bis zum Ende)"
                            },
                            {
                                "example_id": "e9dfaf8b-5393-47f8-bf94-064adc7deeb5",
                                "sense_id": "bc85bf5f-6e8c-317f-88b2-d2598d20166c",
                                "text": "„Ne Wag zengst naus durchn Klötzerwald, dan harrlichn Buchnwald na, de Hirschlack nauf bis ofn Barg, ´s kam bal der Mittig ra.“",
                                "translation": "Einen Weg ganz hinaus durch den Klötzerwald, an dem herrlichen Buchenwald, die Hirschlack rauf bis auf den Berg, es brach bald der Mittag an."
                            },
                            {
                                "example_id": "e5d301a8-0943-4f8a-90dd-8a0af72ac4f8",
                                "sense_id": "bc85bf5f-6e8c-317f-88b2-d2598d20166c",
                                "text": "„zengst nauf",
                                "translation": "ganz hinauf"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
