                "senses": [
                    {
                        "sense_id": "72e646fd-3ccb-3890-8fac-ca9dca58597e",
                        "entry_id": "7dd2b300-fc04-349d-8146-93b303548716",
                        "glosses": [
                            "разг., сниж. тот, у кого широко и неуклюже расставлены ноги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b95f3fe-41c0-4e7f-98f2-760e6acbaa3d",
                                "sense_id": "72e646fd-3ccb-3890-8fac-ca9dca58597e",
                                "text": "Оглушительный раздался свист. То свистел, распялив губы пальцами, рыжебородый раскоряка."
                            }
                        ]
                    },
                    {
                        "sense_id": "26568afe-0213-3f76-a26e-f25c9f302d18",
                        "entry_id": "7dd2b300-fc04-349d-8146-93b303548716",
                        "glosses": [
                            "разг., сниж., неодобр. или бран. употребляется как порицающее или бранное слово"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8270803d-f4e4-4463-aeab-adf7c9ed68a3",
                                "sense_id": "26568afe-0213-3f76-a26e-f25c9f302d18",
                                "text": "— Экий ты, — не знаю, как тебя назвать, — раскоряка!"
                            }
                        ]
                    }
                ],
