                "senses": [
                    {
                        "sense_id": "b68084f2-b37a-360c-bae7-d12fedfc1eb3",
                        "entry_id": "149f0077-6ba5-3684-a9c8-c111d5898822",
                        "glosses": [
                            "Postwesen: Reihe thematisch und typographisch gleichartiger Briefmarken, die eine längere Zeit von der Post bereitgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21023cde-d93f-47f2-b72c-6d444ea749b0",
                                "sense_id": "b68084f2-b37a-360c-bae7-d12fedfc1eb3",
                                "text": "„Die nächste Dauermarkenserie erschien erst 1966 mit 14 Werten.“"
                            },
                            {
                                "example_id": "15129b66-aa87-4770-beaf-beba83639814",
                                "sense_id": "b68084f2-b37a-360c-bae7-d12fedfc1eb3",
                                "text": "„Die Post lanciert in ihrer dritten Ausgabe dieses Jahres eine neue Dauermarkenserie mit dem Thema «Schweizer Bahnhöfe».“"
                            },
                            {
                                "example_id": "7989c223-bc1c-4cd1-bf29-f434f2af4687",
                                "sense_id": "b68084f2-b37a-360c-bae7-d12fedfc1eb3",
                                "text": "„Der Posthornsatz ist die erste Dauermarkenserie der Deutschen Bundespost, eine sogenannte Ziffernserie, bei der eben die Wertziffer das Motiv der Briefmarke bestimmt, oft kombiniert mit einem weiteren Symbol, hier dem Posthorn.“"
                            },
                            {
                                "example_id": "97bae68b-fc14-40bd-9fef-f714d6f9eeb4",
                                "sense_id": "b68084f2-b37a-360c-bae7-d12fedfc1eb3",
                                "text": "„Bereits 1977 erschien die Marksburg im Rahmen einer Dauermarkenserie der Deutschen Bundespost auf einer 60 Pfennig Marke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
