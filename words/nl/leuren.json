{
    "word_family": [
        "leur",
        "leurder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f7f2800-08ef-3533-b938-9fc7769ac45f",
                    "sense_definition": "Huis aan huis of aan voorbijgangers spullen te koop aanbieden, in het bijzonder als die spullen niet erg gewild zijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verkoper probeerde langs de deuren te <w>leuren</w> met goedkope pennen.",
                            "target_lang_translations": {
                                "en": "The salesman tried to <w>peddle</w> cheap pens door-to-door."
                            }
                        },
                        {
                            "text": "Het heeft geen zin om met deze oude spullen langs de deuren te <w>leuren</w>.",
                            "target_lang_translations": {
                                "en": "There is no point in <w>selling</w> these old things <w>door-to-door</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "colporteren",
                        "venten"
                    ],
                    "common_phrases": [
                        "langs de deuren leuren"
                    ],
                    "target_lang_definitions": {
                        "en": "To offer goods for sale door-to-door or to passersby, especially when those goods are not highly sought after."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peddle",
                                "target_lang_sense_clarification": "to sell small goods door-to-door or in public places"
                            },
                            {
                                "target_lang_word": "sell door-to-door",
                                "target_lang_sense_clarification": "to offer items for sale by visiting houses"
                            },
                            {
                                "target_lang_word": "hawk",
                                "target_lang_sense_clarification": "to offer goods for sale, especially by calling out in public"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63d7cd9e-ed61-3de6-996f-158c3f0d4815",
                    "sense_definition": "Bedriegen of knoeien.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bedriegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde met de cijfers te <w>leuren</w> om de winst hoger te laten lijken.",
                            "target_lang_translations": {
                                "en": "He tried to <w>fiddle</w> with the numbers to make the profit look higher."
                            }
                        },
                        {
                            "text": "Je moet niet met de regels <w>leuren</w> om je gelijk te krijgen.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>bend</w> the rules just to get your way."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruikt in de betekenis van sjoemelen of knoeien"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cheat, manipulate, or tamper with something in an underhanded way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fiddle",
                                "target_lang_sense_clarification": "to manipulate or falsify information or rules"
                            },
                            {
                                "target_lang_word": "tamper",
                                "target_lang_sense_clarification": "to interfere or mess with something secretly or dishonestly"
                            },
                            {
                                "target_lang_word": "fudge",
                                "target_lang_sense_clarification": "to adjust or manipulate figures or facts in a dishonest way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b57a974-5e23-36e6-933a-adfb5a69630d",
                    "sense_definition": "Sleuren of slepen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij moesten de zware koffers de hele middag met zich mee <w>leuren</w>.",
                            "target_lang_translations": {
                                "en": "They had to <w>lug</w> the heavy suitcases around with them all afternoon."
                            }
                        },
                        {
                            "text": "Waarom loop je toch zo te <w>leuren</w> met die oude zakken?",
                            "target_lang_translations": {
                                "en": "Why are you <w>dragging</w> those old bags <w>around</w> like that?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in bepaalde dialecten of regio's gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To drag, lug, or carry heavy things around with effort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lug",
                                "target_lang_sense_clarification": "to carry or drag something heavy with great effort"
                            },
                            {
                                "target_lang_word": "drag around",
                                "target_lang_sense_clarification": "to pull or carry something heavy from place to place"
                            },
                            {
                                "target_lang_word": "schlep",
                                "target_lang_sense_clarification": "to carry or travel with difficulty (informal)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c59c97ba-e4aa-3d82-a675-6905859f2952",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>leur</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude handelaar verkocht allerlei <w>leuren</w> en prullaria op de markt.",
                            "target_lang_translations": {
                                "en": "The old merchant sold all kinds of <w>trifles</w> and knick-knacks at the market."
                            }
                        },
                        {
                            "text": "Zij verzamelden de waardeloze <w>leuren</w> die op zolder lagen.",
                            "target_lang_translations": {
                                "en": "They collected the worthless <w>junk</w> that was lying in the attic."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'leur', meaning worthless items, trifles, or junk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trifles",
                                "target_lang_sense_clarification": "things of little value or importance"
                            },
                            {
                                "target_lang_word": "junk",
                                "target_lang_sense_clarification": "worthless or low-value items"
                            },
                            {
                                "target_lang_word": "odds and ends",
                                "target_lang_sense_clarification": "miscellaneous small items of little value"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}