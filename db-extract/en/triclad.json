                        "glosses": [
                            "Any of the turbellarian flatworms of order Tricladida."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ff75685-077c-493d-8e3c-2f599879ce7a",
                                "sense_id": "c4240301-2457-391f-83df-b767de6f09eb",
                                "text": "Planarians (freshwater triclads) are turbellarian flatworms widely used in experimental biology."
                            },
                            {
                                "example_id": "829c2ce0-75d0-4f8e-bc92-b88bc3ec93fc",
                                "sense_id": "c4240301-2457-391f-83df-b767de6f09eb",
                                "text": "The triclads Dugesia, Polycelis and Planaria have been encountered (Durrenfeldt 1978) though Minckley (1963) mentions the avoidance of Dugesia in carbonate-depositing areas."
                            },
                            {
                                "example_id": "fe137dec-3737-409c-ada8-42f604c7c3b4",
                                "sense_id": "c4240301-2457-391f-83df-b767de6f09eb",
                                "text": "The body length of adult triclads (Tricladida) chiefly exceeds 6 mm."
                            }
                        ]
