                "senses": [
                    {
                        "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                        "entry_id": "7d0e6e8c-5a75-3f16-9461-21b922279935",
                        "glosses": [
                            "een vierkante lap stof die vooral door vrouwen driehoekig samengevouwen over het hoofd gedragen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae7eca6-5f46-4c12-b0d2-1aae8ca7bb5b",
                                "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                                "text": "In islamitische kringen wordt het dragen van hoofddoekjes veelal als religieuze plicht gezien."
                            },
                            {
                                "example_id": "fd74baac-81d3-4c9a-9e3d-554115e3d0d7",
                                "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                                "text": "Vanachter halfgesloten ogen zag ik een vrouw met een Schots geruite rok en een hoofddoek met gespreide armen op me afrennen. Ik besloot me niet te verzetten. Willoos liet ik me heen en weer schudden."
                            },
                            {
                                "example_id": "4ccd2067-d0f2-475e-b56f-35642cecdaac",
                                "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                                "text": "Weerstand tegen verplichting hoofddoek groeit in Iran"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd3cf28a-8524-44c7-b4af-e52f54edfeaf",
                        "source_entry_id": "7d0e6e8c-5a75-3f16-9461-21b922279935",
                        "source_sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                        "source_sense_description": "een vierkante lap stof die vooral door vrouwen driehoekig samengevouwen over het hoofd gedragen wordt",
                        "target_lang_word": "Kopftuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopftuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                        "entry_id": "46f2535c-295e-3b54-ac1e-1cb6d182b64d",
                                        "glosses": [
                                            "Stück Stoff, das als Schutz vor der Witterung oder Verletzungen, als Modeaccessoire oder aus politischen oder religiösen Motiven auf dem Kopf getragen wird"
                                        ],
                                        "tags": [
                                            "Mode",
                                            "Bekleidung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cedabfe-6ee2-44fc-90eb-85e089bbbc0c",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "In der Fabrik band sie sich ein Kopftuch um, damit ihre Haare nicht in die Maschine gerieten."
                                            },
                                            {
                                                "example_id": "3a67c5d0-6cf8-4f58-a721-0f6cda9d8992",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "Du solltest dir wenigstens ein Kopftuch umbinden, es ist kalt draußen!"
                                            },
                                            {
                                                "example_id": "e6a85d1e-d787-4df0-8acc-98b00de14d59",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "Das palästinensische Kopftuch wurde zu einem politischen Symbol."
                                            },
                                            {
                                                "example_id": "9942d26d-dac9-4b39-81be-71a0268a7438",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "Kopftücher werden in vielen Religionen und Glaubensrichtungen getragen."
                                            },
                                            {
                                                "example_id": "b4f4f096-28b8-4814-9931-a76e7b285516",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Niemand darf in unserem Land gezwungen werden, ein Kopftuch zu tragen.“"
                                            },
                                            {
                                                "example_id": "353869cc-338f-458b-97e3-a01a7ff89e86",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„«Kopftuch oder nicht, das ist meine Entscheidung!»“"
                                            },
                                            {
                                                "example_id": "b92fd1d2-7617-45de-8fce-bcf6510819df",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Als ich noch ein Kind war, habe ich kaum Frauen mit Kopftüchern gesehen.“"
                                            },
                                            {
                                                "example_id": "fd83c975-4f75-4044-9ad4-bd353ced2b73",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Ja, ich trage manchmal Kopftuch, aber nur bei Berliner Minusgraden, weil ich sonst eine Ohrenentzündung bekomme.“"
                                            },
                                            {
                                                "example_id": "58d9442f-2745-4e34-b1d0-a7aca82b9444",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Nur die russischen Pilgerinnen erkannte man schon von weitem an ihren frommen Kopftüchern.“"
                                            },
                                            {
                                                "example_id": "e3b8e004-de89-42ea-a68f-7557310af906",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Eine Karateschülerin trat bei einem Wettbewerb mit Kopftuch an. Das sei nicht erlaubt, fand der Kampfrichter – und gab ihr null Punkte.“"
                                            },
                                            {
                                                "example_id": "aff71648-43ed-4e4c-b041-a26df58f35db",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Das Land Berlin] „untersagte es allen Lehrkräften an öffentlichen Schulen, im Dienst irgendein religiöses Symbol zu tragen – egal ob Kopftuch, Kippa oder Kreuz am Hals.“"
                                            },
                                            {
                                                "example_id": "9813ce1c-19c9-4b7d-8b71-9c19d274e36a",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Fast alle Bundesländer erlauben Lehrerinnen inzwischen ein Kopftuch, wenn diese das wollen – alle, außer Berlin.“"
                                            },
                                            {
                                                "example_id": "163103cd-4079-4f58-b032-0732668b6657",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Urteil des Bundesarbeitsgericht:] „Als letztes Bundesland muss Berlin Lehrerinnen mit Kopftuch zulassen.“"
                                            },
                                            {
                                                "example_id": "7b5fbe31-387f-45ef-9b7a-3b28afdae967",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Das Land Berlin darf seinen Lehrerinnen nicht pauschal verbieten, ein Kopftuch zu tragen.“"
                                            },
                                            {
                                                "example_id": "e92b95b2-fcb7-4e50-b9c9-293356b0485a",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Durch seine Normalität wird das Kopftuch mehr und mehr entpolitisiert.“"
                                            },
                                            {
                                                "example_id": "43c96833-2ef4-4a19-988b-e195177206de",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Der Kulturkampf] „begann vor ziemlich genau 25 Jahren, als die deutsch-afghanische Lehrerin Fereshta Ludin in Baden-Württemberg nicht in den Schuldienst aufgenommen wurde, weil sie im Unterricht aus Glaubensgründen ein Kopftuch tragen wollte.“"
                                            },
                                            {
                                                "example_id": "b5f90544-4093-4290-8eb7-fd6b12631709",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Der Kampf um das Kopftuch hat sich inzwischen von den Schulen auf andere Gebiete verlagert. Einige Bundesländer haben neue Gesetze eingeführt, die es Richterinnen, Staatsanwältinnen und sogar Referendarinnen untersagen, im Gerichtssaal ein Kopftuch zu tragen.“"
                                            },
                                            {
                                                "example_id": "f571e541-1dd9-4aaa-a5e9-8f5a89041873",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Vor dem Europäischen Gerichtshof hat eine belgische Muslimin geklagt, das Kopftuch bei der Arbeit tragen zu dürfen.“"
                                            },
                                            {
                                                "example_id": "c1522462-5d5a-42a3-8ee8-de385a776619",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Verletzt ein Kopftuch die strikten Neutralitätsregeln eines Unternehmens? Das musste der Europäische Gerichtshof jetzt entscheiden.“"
                                            },
                                            {
                                                "example_id": "2178448b-5470-47e6-a983-c3cd51a0c7e4",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Das Kopftuch ist in der Islamischen Republik Iran ein wichtiges Kleidungsstück. Frauen müssen ihre Haare in der Öffentlichkeit zwingend bedecken.“"
                                            },
                                            {
                                                "example_id": "3e67fbfa-1075-4b69-801f-7dfa63ed6fe1",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Auf Instagram hatte sie ein inzwischen gelöschtes Bild von sich ohne das im Iran obligatorische Kopftuch veröffentlicht.“"
                                            },
                                            {
                                                "example_id": "5ffa1205-eb6c-4227-8626-af6a24f74ae9",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Iran:] „Die sogenannte Sittenpolizei hatte sie festgenommen, weil sie ihr Kopftuch nicht ordnungsgemäß getragen haben soll.“"
                                            },
                                            {
                                                "example_id": "b6d1163c-2da0-4297-a4cb-812249e52cd5",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Auf den Protestvideos aus dem Iran sieht man ausgezogene Kopftücher - Frauen mit offenen Haaren protestieren an Schulen, Unis und auf den Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84c79809-5b45-4a8d-be74-32d0c1e26448",
                        "source_entry_id": "7d0e6e8c-5a75-3f16-9461-21b922279935",
                        "source_sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                        "source_sense_description": "een vierkante lap stof die vooral door vrouwen driehoekig samengevouwen over het hoofd gedragen wordt",
                        "target_lang_word": "headscarf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headscarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a02809fd-3167-3ae7-aa34-b65f2ed9dcd5",
                                        "entry_id": "789c2d9b-502a-3d24-afc9-28d4165938a9",
                                        "glosses": [
                                            "A more or less square piece of material worn over the head, typically by women, often to protect the hair, or for religious reasons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeec685c-debb-4a45-867c-3754d83b5426",
                                                "sense_id": "a02809fd-3167-3ae7-aa34-b65f2ed9dcd5",
                                                "text": "As far as only the Quran itself is concerned, wearing a headscarf is neither required nor prohibited."
                                            },
                                            {
                                                "example_id": "bcde8506-4d2d-4c24-9045-6196ce225ec1",
                                                "sense_id": "a02809fd-3167-3ae7-aa34-b65f2ed9dcd5",
                                                "text": "But as Ms. Eran adjusted her resplendent costume, two young women wearing traditional headscarfs walked across the plaza nearby."
                                            },
                                            {
                                                "example_id": "7ff6a02a-5fb1-4ebe-89f2-bae41409d421",
                                                "sense_id": "a02809fd-3167-3ae7-aa34-b65f2ed9dcd5",
                                                "text": "The headscarf is a perfect tool to block the nonmoderns from participating in the class privileges that the modern state represents."
                                            },
                                            {
                                                "example_id": "84b7d433-e691-47cb-9dfb-374279568a62",
                                                "sense_id": "a02809fd-3167-3ae7-aa34-b65f2ed9dcd5",
                                                "text": "By the early 1980s, Gucci was overlicensed, with its logo on every product imaginable from headscarves to key rings to lighters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca51be0c-40a7-4f1e-8298-acda2c949ac4",
                        "source_entry_id": "7d0e6e8c-5a75-3f16-9461-21b922279935",
                        "source_sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                        "source_sense_description": "een vierkante lap stof die vooral door vrouwen driehoekig samengevouwen over het hoofd gedragen wordt",
                        "target_lang_word": "fichu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fichu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa46c14-56b7-3673-b3db-525cf4b58bd9",
                                        "entry_id": "b9eade36-e88d-32dc-adc7-25e738620f4d",
                                        "glosses": [
                                            "Participe passé masculin singulier de fiche, ficher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf449f88-21a4-4915-adc5-b155c3929a9f",
                                                "sense_id": "4fa46c14-56b7-3673-b3db-525cf4b58bd9",
                                                "text": "Il s’était accoudé à une planche où il y avait des verres, un compotier ; je ne sais pas comment il n’a rien fichu par terre."
                                            },
                                            {
                                                "example_id": "5097c85c-99c7-4108-a74a-5cf9b4204975",
                                                "sense_id": "4fa46c14-56b7-3673-b3db-525cf4b58bd9",
                                                "text": "Qu’est-ce qui m’a fichu un parpaillot de cet acabit ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fichu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4693dcd2-a42b-32af-87aa-7daf6d9cf9fb",
                                        "entry_id": "20ac887e-3835-38c0-bbb5-77e68f41cc70",
                                        "glosses": [
                                            "Fait, arrangé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7049af-1885-417a-a709-867b7cc70956",
                                                "sense_id": "4693dcd2-a42b-32af-87aa-7daf6d9cf9fb",
                                                "text": "On disait dans le village : – C’est clair que le diable a fait quelque apparition. Boulatruelle l’a vu, et cherche. Au fait, il est fichu pour empoigner le magot de Lucifer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c7270ca-244d-3096-aa8f-31279bafd492",
                                        "entry_id": "20ac887e-3835-38c0-bbb5-77e68f41cc70",
                                        "glosses": [
                                            "Qui est mal tourné, déplaisant, fâcheux, critique."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a973c43-6e81-400c-b7f4-adfc2adbdf3a",
                                                "sense_id": "2c7270ca-244d-3096-aa8f-31279bafd492",
                                                "text": "Mais ils m’ont répondu qu’elle avait une fichue caboche, et qu’elle ne voulait pas en entendre parler ; […]."
                                            },
                                            {
                                                "example_id": "01f0acc4-e05a-4fee-b447-12bd61a33903",
                                                "sense_id": "2c7270ca-244d-3096-aa8f-31279bafd492",
                                                "text": "Voilà un fichu compliment. – Quel fichu caractère !"
                                            },
                                            {
                                                "example_id": "d6867dc7-79bb-4bb2-a2bc-1d509cda2b46",
                                                "sense_id": "2c7270ca-244d-3096-aa8f-31279bafd492",
                                                "text": "Il est dans une fichue situation. - Fichu métier."
                                            },
                                            {
                                                "example_id": "da751fd5-acce-46e7-b8f0-b3a182763058",
                                                "sense_id": "2c7270ca-244d-3096-aa8f-31279bafd492",
                                                "text": "Fichu imbécile !"
                                            },
                                            {
                                                "example_id": "b56f1bbb-1cdf-4384-a96c-eced8fa67180",
                                                "sense_id": "2c7270ca-244d-3096-aa8f-31279bafd492",
                                                "text": "Je ramassai la robe de chambre et la chemise de nuit en question, qui gisaient en vrac et en fichu état sur le tapis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c8a8d8a-e11c-3ea8-b005-0035c4c80580",
                                        "entry_id": "20ac887e-3835-38c0-bbb5-77e68f41cc70",
                                        "glosses": [
                                            "Qui est perdu, car hors d’usage, cassé, ruiné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c31b9a0-caed-4723-b51b-7f0012876010",
                                                "sense_id": "3c8a8d8a-e11c-3ea8-b005-0035c4c80580",
                                                "text": "Ce pauvre Robineau est fichu, il a une figure d’homme qui se noie."
                                            },
                                            {
                                                "example_id": "6e2d7563-f477-400a-817e-ea0fd6f9ca96",
                                                "sense_id": "3c8a8d8a-e11c-3ea8-b005-0035c4c80580",
                                                "text": "Mais en ce qui concernait la voiture, tout était fichu. Il faudrait l’abandonner, elle aussi, dans un coin tranquille et sauter dans le premier autobus."
                                            },
                                            {
                                                "example_id": "276effc8-c98f-4aca-8461-a66075e27766",
                                                "sense_id": "3c8a8d8a-e11c-3ea8-b005-0035c4c80580",
                                                "text": "Entre autres fines fleurs, je compte, sur ma liste\nRose, un bon nombre de femmes de journalistes\nQui, me pensant fichu, mettent toute leur foi\nÀ me donner du bonheur une dernière fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5419dae-a4ba-3003-8254-32f0a452d9f2",
                                        "entry_id": "20ac887e-3835-38c0-bbb5-77e68f41cc70",
                                        "glosses": [
                                            "Capable, susceptible de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab18a584-2be8-4a38-a573-62f2eb20eb53",
                                                "sense_id": "e5419dae-a4ba-3003-8254-32f0a452d9f2",
                                                "text": "Il est fichu de lui claquer la porte au nez."
                                            },
                                            {
                                                "example_id": "7c87e559-f060-4d13-b52e-0a3f17bddf42",
                                                "sense_id": "e5419dae-a4ba-3003-8254-32f0a452d9f2",
                                                "text": "Et Protos, en s’en allant, murmurait :\n– On t’en donnera, du cardinal !… C’est que, tout seul, il était fichu d’aller trouver le vrai !"
                                            },
                                            {
                                                "example_id": "1045d35d-95ef-444a-a03d-70465a0c196c",
                                                "sense_id": "e5419dae-a4ba-3003-8254-32f0a452d9f2",
                                                "text": "Il y a un type qui est bien fichu de clamser dans la soirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e167d1-8b4d-3537-ba81-b03f4e282893",
                                        "entry_id": "20ac887e-3835-38c0-bbb5-77e68f41cc70",
                                        "glosses": [
                                            "Antéposé, sert à donner plus de force à des termes d’injure ou d’admiration ironique."
                                        ],
                                        "tags": [
                                            "Employé comme épithète"
                                        ],
                                        "note": "Il s’utilise, dans ce sens, aussi bien péjorativement que méliorativement",
                                        "examples": [
                                            {
                                                "example_id": "32a6e7a0-de9f-4db2-a60b-8b9f10f88bfb",
                                                "sense_id": "79e167d1-8b4d-3537-ba81-b03f4e282893",
                                                "text": "– Hassan Ibn Abbou m’a l’air d’un fichu rigolo, dit Amaury un instant plus tard."
                                            },
                                            {
                                                "example_id": "3d107630-91c5-4292-a8b3-af087cedba3a",
                                                "sense_id": "79e167d1-8b4d-3537-ba81-b03f4e282893",
                                                "text": "Antoine regarde sa mère ouvrir la barre de nougat tandis qu'il finit son chocolat chaud. C'est vraiment interminable de dégager de son emballage en plastique ce fichu nougat !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fichu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87ce1dea-e1b7-3748-bf19-bbe2cff3ce67",
                                        "entry_id": "53f1fe5c-d2dd-3c62-b788-8033de8067bc",
                                        "glosses": [
                                            "Petite pièce d’étoffe carrée, d’ordinaire pliée en triangle, dont les femmes se couvrent la tête, la gorge et les épaules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e32286f-08f6-4564-813e-7774291d4aeb",
                                                "sense_id": "87ce1dea-e1b7-3748-bf19-bbe2cff3ce67",
                                                "text": "Un fichu de point d’Angleterre retombait sur les épaules en badinant."
                                            },
                                            {
                                                "example_id": "382b93bc-7bba-4877-a501-600cc8af87ce",
                                                "sense_id": "87ce1dea-e1b7-3748-bf19-bbe2cff3ce67",
                                                "text": "Liane s'était contentée d'un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s'appelle une canipette."
                                            },
                                            {
                                                "example_id": "941df924-ed9c-4f2f-83b5-32c301e9fe41",
                                                "sense_id": "87ce1dea-e1b7-3748-bf19-bbe2cff3ce67",
                                                "text": "[…]; des agents du préfet se glissèrent dans les marchés : ils arrêtaient les femmes qui portaient des fichus trop courts ou des serre-tête en soie, et les exposaient en public avec leur fichu pendu au cou."
                                            },
                                            {
                                                "example_id": "ea1530dc-8d89-4678-bbd8-83bcb221230a",
                                                "sense_id": "87ce1dea-e1b7-3748-bf19-bbe2cff3ce67",
                                                "text": "Casquette prolétarienne pour beaucoup, catogan ou fichu pour les femmes, parfois légèrement maquillées, non sans un brin de coquetterie pour certaines …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
