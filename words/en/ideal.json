{
    "word_family": [
        "idealism",
        "idealist",
        "idealistic",
        "idealize",
        "ideally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7e4c8ef-a6f0-30a1-9ec3-ccaaafc4e42c",
                    "sense_definition": "Perfect, flawless, having no defects.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunny weather provided <w>ideal</w> conditions for our picnic.",
                            "target_lang_translations": {
                                "ru": "Солнечная погода обеспечила <w>идеальные</w> условия для нашего пикника.",
                                "zh": "晴朗的天气为我们的野餐提供了<w>理想的</w>条件。"
                            }
                        },
                        {
                            "text": "She is the <w>ideal</w> candidate for the job because of her extensive experience.",
                            "target_lang_translations": {
                                "ru": "Она — <w>идеальный</w> кандидат на эту должность благодаря своему обширному опыту.",
                                "zh": "凭借丰富的经验，她是这份工作的<w>理想</w>人选。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flawless",
                        "perfect"
                    ],
                    "common_phrases": [
                        "ideal candidate",
                        "ideal conditions",
                        "ideal situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенный, безупречный, не имеющий недостатков.",
                        "zh": "完美的，无瑕疵的，没有任何缺陷的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеа́льный",
                                "target_lang_sense_clarification": "совершенный, безупречный"
                            },
                            {
                                "target_lang_word": "соверше́нный",
                                "target_lang_sense_clarification": "не имеющий изъянов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理想的",
                                "target_lang_sense_clarification": "完美的，符合期望的"
                            },
                            {
                                "target_lang_word": "完美的",
                                "target_lang_sense_clarification": "无懈可击的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bf3a928-3401-33ba-bc34-00361de2167d",
                    "sense_definition": "Optimal; being the best possibility.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find an <w>ideal</w> solution that satisfies everyone involved.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>идеальное</w> решение, которое устроит всех участников.",
                                "zh": "我们需要找到一个能让各方都满意的<w>理想</w>方案。"
                            }
                        },
                        {
                            "text": "It was not the <w>ideal</w> time to discuss the budget, but we had no choice.",
                            "target_lang_translations": {
                                "ru": "Это было не <w>идеальное</w> время для обсуждения бюджета, но у нас не было выбора.",
                                "zh": "现在并不是讨论预算的<w>理想</w>时机，但我们别无选择。"
                            }
                        }
                    ],
                    "synonyms": [
                        "best",
                        "optimal",
                        "optimum"
                    ],
                    "common_phrases": [
                        "ideal solution",
                        "ideal time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оптимальный; наилучший из возможных вариантов.",
                        "zh": "最优的；最好的可能性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеа́льный",
                                "target_lang_sense_clarification": "наилучший, оптимальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理想的",
                                "target_lang_sense_clarification": "最合适的"
                            },
                            {
                                "target_lang_word": "最佳的",
                                "target_lang_sense_clarification": "最优选的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db4a3c32-86ce-356f-9d1b-97a747b920c4",
                    "sense_definition": "Existing only in the mind; conceptual, imaginary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In an <w>ideal</w> world, nobody would have to go hungry.",
                            "target_lang_translations": {
                                "ru": "В <w>идеальном</w> мире никому не пришлось бы голодать.",
                                "zh": "在<w>理想</w>世界里，没有人会挨饿。"
                            }
                        },
                        {
                            "text": "The concept of a frictionless surface is purely <w>ideal</w> and does not exist in reality.",
                            "target_lang_translations": {
                                "ru": "Концепция поверхности без трения чисто <w>идеальная</w> и не существует в реальности.",
                                "zh": "无摩擦表面的概念纯属<w>理想</w>状态，现实中并不存在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conceptual",
                        "imaginary",
                        "notional"
                    ],
                    "common_phrases": [
                        "ideal world",
                        "ideal gas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий только в мыслях; концептуальный, воображаемый.",
                        "zh": "仅存在于思想中的；概念上的，想象的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеа́льный",
                                "target_lang_sense_clarification": "существующий только в теории"
                            },
                            {
                                "target_lang_word": "вообража́емый",
                                "target_lang_sense_clarification": "существующий в воображении"
                            },
                            {
                                "target_lang_word": "абстра́ктный",
                                "target_lang_sense_clarification": "отвлеченный от реальности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理想的",
                                "target_lang_sense_clarification": "仅存在于理论或想象中"
                            },
                            {
                                "target_lang_word": "抽象的",
                                "target_lang_sense_clarification": "脱离现实的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "430e0c43-0796-3eb5-8f9f-451cdddf4e51",
                    "sense_definition": "A perfect standard of beauty, intellect etc., or a standard of excellence to aim at.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always tried to live up to her high <w>ideals</w> of honesty and integrity.",
                            "target_lang_translations": {
                                "ru": "Она всегда старалась соответствовать своим высоким <w>идеалам</w> честности и порядочности.",
                                "zh": "她总是努力践行自己关于诚实和正直的高尚<w>理想</w>。"
                            }
                        },
                        {
                            "text": "The organization was founded on the <w>ideals</w> of equality and justice.",
                            "target_lang_translations": {
                                "ru": "Организация была основана на <w>идеалах</w> равенства и справедливости.",
                                "zh": "该组织建立在平等与正义的<w>理想</w>之上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high ideals",
                        "democratic ideals",
                        "political ideals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенный образец красоты, интеллекта и т.д., или стандарт совершенства, к которому нужно стремиться.",
                        "zh": "完美的典范，或追求的卓越标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеа́л",
                                "target_lang_sense_clarification": "высшая цель стремлений, образец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理想",
                                "target_lang_sense_clarification": "追求的目标或信念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd12f001-fa04-344b-8d36-e758c9849ee3",
                    "sense_definition": "A subset of a ring which is closed under both left and right multiplication by elements of the ring.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ring theory, every maximal <w>ideal</w> is also a prime ideal.",
                            "target_lang_translations": {
                                "ru": "В теории колец каждый максимальный <w>идеал</w> также является простым идеалом.",
                                "zh": "在环论中，每一个极大<w>理想</w>也是素理想。"
                            }
                        },
                        {
                            "text": "The student calculated the generator of the principal <w>ideal</w>.",
                            "target_lang_translations": {
                                "ru": "Студент вычислил образующую главного <w>идеала</w>.",
                                "zh": "学生计算了主<w>理想</w>的生成元。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prime ideal",
                        "maximal ideal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подмножество кольца, замкнутое относительно сложения и умножения на элементы кольца.",
                        "zh": "环的一个子集，对环元素的左右乘法封闭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеа́л",
                                "target_lang_sense_clarification": "алгебраический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理想",
                                "target_lang_sense_clarification": "代数术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f5c24fd-a686-33f7-b1b4-a992af72e506",
                    "sense_definition": "A non-empty lower set (of a partially ordered set) which is closed under binary suprema.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the study of lattices, an order <w>ideal</w> is a specific type of subset.",
                            "target_lang_translations": {
                                "ru": "В изучении решеток порядковый <w>идеал</w> — это особый тип подмножества.",
                                "zh": "在格论研究中，序<w>理想</w>是一种特定的子集。"
                            }
                        },
                        {
                            "text": "The concept of a filter is dual to that of an <w>ideal</w> in order theory.",
                            "target_lang_translations": {
                                "ru": "Понятие фильтра двойственно понятию <w>идеала</w> в теории порядков.",
                                "zh": "在序理论中，滤子的概念与<w>理想</w>是对偶的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "order ideal"
                    ],
                    "antonyms": [
                        "filter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непустое нижнее множество (частично упорядоченного множества), замкнутое относительно бинарных супремумов.",
                        "zh": "偏序集中的一个非空下集，对二元上确界封闭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеа́л",
                                "target_lang_sense_clarification": "в теории порядков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理想",
                                "target_lang_sense_clarification": "序理论术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1a9633a3-5ba2-3d10-84fa-a104d3d42189",
                    "sense_definition": "A city in Georgia, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through <w>Ideal</w> on our way to Atlanta.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через <w>Айдиал</w> по пути в Атланту.",
                                "zh": "我们在去亚特兰大的路上经过了<w>艾迪尔</w>。"
                            }
                        },
                        {
                            "text": "The population of <w>Ideal</w> is quite small.",
                            "target_lang_translations": {
                                "ru": "Население <w>Айдиала</w> довольно маленькое.",
                                "zh": "<w>艾迪尔</w>的人口非常少。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в штате Джорджия, США.",
                        "zh": "美国佐治亚州的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Айдиал",
                                "target_lang_sense_clarification": "город в Джорджии, США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾迪尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}