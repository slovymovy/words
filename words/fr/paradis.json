                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Genèse raconte comment Adam et Ève ont été chassés du <w>paradis</w> terrestre."
                        },
                        {
                            "text": "L'arbre de la connaissance se trouvait au centre du <w>paradis</w>."
                        }
