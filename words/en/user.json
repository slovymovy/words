    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75bbf3de-7697-32ec-ab25-21d73bf7735a",
                    "sense_definition": "A person or entity that utilizes a product, service, or facility.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consumer_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manual is written clearly so the average <w>user</w> can understand it.",
                            "target_lang_translations": {
                                "ru": "Руководство написано понятно, чтобы средний <w>пользователь</w> мог его понять.",
                                "zh": "手册写得很清楚，以便普通<w>用户</w>都能看懂。"
                            }
                        },
                        {
                            "text": "Every road <w>user</w> must pay attention to the traffic signals.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>участник</w> дорожного движения должен обращать внимание на сигналы светофора.",
                                "zh": "每一位道路<w>使用者</w>都必须注意交通信号。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nonuser",
                        "non-user"
                    ],
                    "common_phrases": [
                        "end user",
                        "road user",
                        "heavy user",
                        "average user"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организация, использующие продукт, услугу или объект.",
                        "zh": "使用产品、服务或设施的人或实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользователь",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "потребитель",
                                "target_lang_sense_clarification": "товаров или услуг"
                            },
                            {
                                "target_lang_word": "клиент",
                                "target_lang_sense_clarification": "заказчик услуг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用户",
                                "target_lang_sense_clarification": "通用称呼"
                            },
                            {
                                "target_lang_word": "使用者",
                                "target_lang_sense_clarification": "强调使用行为的人"
                            },
                            {
                                "target_lang_word": "消费者",
                                "target_lang_sense_clarification": "针对商品或服务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb8516e5-a77e-323d-9511-9e503bbac034",
                    "sense_definition": "A person who interacts with a computer system, network, or software application.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consumer_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software allows the <w>user</w> to customize the interface settings.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет <w>пользователю</w> настраивать параметры интерфейса.",
                                "zh": "该软件允许<w>用户</w>自定义界面设置。"
                            }
                        },
                        {
                            "text": "Each registered <w>user</w> has access to the private database.",
                            "target_lang_translations": {
                                "ru": "Каждый зарегистрированный <w>пользователь</w> имеет доступ к закрытой базе данных.",
                                "zh": "每位注册<w>用户</w>都有权访问私有数据库。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "user interface",
                        "active user",
                        "user account",
                        "user experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, взаимодействующий с компьютерной системой, сетью или программным приложением.",
                        "zh": "与计算机系统、网络或软件应用程序进行交互的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользователь",
                                "target_lang_sense_clarification": "компьютерных систем"
                            },
                            {
                                "target_lang_word": "юзер",
                                "target_lang_sense_clarification": "разговорное, сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用户",
                                "target_lang_sense_clarification": "计算机系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9b860c6-fe59-37d6-b00c-2f20a6c5bcde",
                    "sense_definition": "A username; a unique name used to identify a person on a computer system.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "consumer_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to enter your <w>user</w> and password to log in.",
                            "target_lang_translations": {
                                "ru": "Вам нужно ввести <w>имя пользователя</w> и пароль для входа.",
                                "zh": "你需要输入<w>用户名</w>和密码才能登录。"
                            }
                        },
                        {
                            "text": "I forgot which <w>user</w> I created for this website.",
                            "target_lang_translations": {
                                "ru": "Я забыл, какое <w>имя пользователя</w> я создал для этого сайта.",
                                "zh": "我忘了我为这个网站创建了哪个<w>用户名</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of username"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя пользователя; уникальное имя для идентификации человека в компьютерной системе.",
                        "zh": "用户名；用于在计算机系统中识别个人的唯一名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имя пользователя",
                                "target_lang_sense_clarification": "идентификатор"
                            },
                            {
                                "target_lang_word": "логин",
                                "target_lang_sense_clarification": "учетная запись"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用户名",
                                "target_lang_sense_clarification": "标识符"
                            },
                            {
                                "target_lang_word": "账号",
                                "target_lang_sense_clarification": "账户名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c30f307-a753-373b-9489-ee8380e24a1d",
                    "sense_definition": "A person who habitually consumes illegal drugs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rehabilitation center offers support for every drug <w>user</w>.",
                            "target_lang_translations": {
                                "ru": "Реабилитационный центр предлагает поддержку каждому <w>наркозависимому</w>.",
                                "zh": "康复中心为每一位<w>吸毒者</w>提供支持。"
                            }
                        },
                        {
                            "text": "He was a heavy <w>user</w> for many years before he quit.",
                            "target_lang_translations": {
                                "ru": "Он был заядлым <w>наркоманом</w> много лет, прежде чем бросил.",
                                "zh": "他在戒掉之前，曾做了多年的重度<w>吸毒者</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drug user"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, регулярно употребляющий запрещенные наркотические вещества.",
                        "zh": "习惯性使用非法药物的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наркоман",
                                "target_lang_sense_clarification": "зависимый человек"
                            },
                            {
                                "target_lang_word": "потребитель наркотиков",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸毒者",
                                "target_lang_sense_clarification": "依赖药物的人"
                            },
                            {
                                "target_lang_word": "药物滥用者",
                                "target_lang_sense_clarification": "正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85c2478e-5cb9-3bba-9f9a-af1e772fe723",
                    "sense_definition": "A person who selfishly takes advantage of others for personal gain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She realized too late that her boyfriend was just a <w>user</w>.",
                            "target_lang_translations": {
                                "ru": "Она слишком поздно поняла, что её парень был просто <w>манипулятором</w>.",
                                "zh": "她太晚才意识到她的男朋友只是个<w>利用他人者</w>。"
                            }
                        },
                        {
                            "text": "Nobody trusts him because he is a <w>user</w> who never gives back.",
                            "target_lang_translations": {
                                "ru": "Никто ему не доверяет, потому что он <w>приспособленец</w>, который никогда ничего не отдаёт взамен.",
                                "zh": "没人信任他，因为他是个从不回报的<w>投机者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parasite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который эгоистично использует других ради личной выгоды.",
                        "zh": "为了个人利益而自私地利用他人的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манипулятор",
                                "target_lang_sense_clarification": "использующий людей"
                            },
                            {
                                "target_lang_word": "приспособленец",
                                "target_lang_sense_clarification": "ищущий выгоду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利用他人者",
                                "target_lang_sense_clarification": "操纵者"
                            },
                            {
                                "target_lang_word": "投机者",
                                "target_lang_sense_clarification": "寻求个人利益"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfdf57f0-662a-329b-bfdc-789fa199369f",
                    "sense_definition": "The continued use or enjoyment of a right, especially regarding land or property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer presented evidence of <w>user</w> to prove the public right of way.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил доказательства <w>пользования</w>, чтобы подтвердить общественное право проезда.",
                                "zh": "律师提交了<w>使用权</w>证据，以证明公共通行权。"
                            }
                        },
                        {
                            "text": "Long-term <w>user</w> can sometimes establish a legal claim to the land.",
                            "target_lang_translations": {
                                "ru": "Длительное <w>пользование</w> иногда может служить основанием для юридических прав на землю.",
                                "zh": "长期的<w>使用权</w>有时可以确立对土地的法律主张。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "evidence of user"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "legal jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжительное использование или владение правом, особенно в отношении земли или собственности.",
                        "zh": "对权利的持续使用或享有，特别是在土地或财产方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользование",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "право пользования",
                                "target_lang_sense_clarification": "владение правом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使用权",
                                "target_lang_sense_clarification": "法律术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
