                "senses": [
                    {
                        "sense_id": "91df5e62-5399-3b17-87bf-e28b7effddc1",
                        "entry_id": "3d62a24e-1ee4-3f0b-a1b9-4299ffdbcfe9",
                        "glosses": [
                            "Polyphénol de la classe des stilbènes présent dans la peau du raisin et dans certains fruits comme les mûres ou les cacahuètes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e87f932-5226-4ad5-9d4d-970c5a8b0093",
                                "sense_id": "91df5e62-5399-3b17-87bf-e28b7effddc1",
                                "text": "Les études montrent que le vin rouge, par son contenu élevé en resvératrol et autres anthocyanidines qui lui donnent sa couleur, est différent des autres alcools."
                            },
                            {
                                "example_id": "5503164b-afe0-4331-b173-e1563842e895",
                                "sense_id": "91df5e62-5399-3b17-87bf-e28b7effddc1",
                                "text": "C’est un cardioprotecteur et un anti-inflammatoire : l’OMS (Organisation mondiale de la santé) indique que le resvératrol réduit à lui seul de 40 % le risque cardiovasculaire !"
                            },
                            {
                                "example_id": "9c6e812a-b70e-4881-99ae-d69a75275524",
                                "sense_id": "91df5e62-5399-3b17-87bf-e28b7effddc1",
                                "text": "Malgré leur structure semblable, les capacités anti-fongiques du resvératrol et de la pinosylvine sont très différentes."
                            }
                        ]
                    }
