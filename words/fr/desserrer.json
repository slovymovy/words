    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30468951-56ae-32f4-ab48-fa3ff836874d",
                    "sense_definition": "Rendre moins serré un objet, un lien, un vêtement ou une fixation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relâcher_tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce repas copieux, il a dû <w>desserrer</w> un peu sa ceinture pour respirer."
                        },
                        {
                            "text": "Le mécanicien utilise une clé pour <w>desserrer</w> les boulons de la roue avant."
                        }
                    ],
                    "synonyms": [
                        "détendre",
                        "relâcher",
                        "dénouer"
                    ],
                    "antonyms": [
                        "serrer"
                    ],
                    "common_phrases": [
                        "desserrer la ceinture",
                        "desserrer un nœud",
                        "desserrer une vis"
                    ]
                },
                {
                    "sense_id": "c10fae17-203a-3f6d-aa4d-dc95083c68b9",
                    "sense_definition": "Ouvrir ou cesser de maintenir contractée une partie du corps, ou débloquer un mécanisme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relâcher_tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de la colère, elle refusait de <w>desserrer</w> les dents devant le juge."
                        },
                        {
                            "text": "N'oublie pas de <w>desserrer</w> le frein à main avant de démarrer la voiture."
                        }
                    ],
                    "synonyms": [
                        "ouvrir",
                        "décontracter",
                        "relâcher"
                    ],
                    "antonyms": [
                        "serrer",
                        "crisper"
                    ],
                    "common_phrases": [
                        "desserrer les dents",
                        "desserrer le frein"
                    ]
                },
                {
                    "sense_id": "e94e37e5-6291-3d52-833f-6820ad76791b",
                    "sense_definition": "Devenir moins tendu ou perdre de sa fermeté, en parlant d'un lien ou d'un assemblage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relâcher_tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force de marcher sur ce chemin caillouteux, mes lacets se sont <w>desserrés</w>."
                        },
                        {
                            "text": "Avec les vibrations constantes du moteur, plusieurs vis risquent de se <w>desserrer</w>."
                        }
                    ],
                    "synonyms": [
                        "se détendre",
                        "se relâcher"
                    ],
                    "antonyms": [
                        "se serrer",
                        "se resserrer"
                    ]
                },
                {
                    "sense_id": "5dd33d0c-a89b-33a7-a649-4d815ce71a45",
                    "sense_definition": "Rendre une situation, une règle ou une contrainte moins rigoureuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relâcher_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque centrale a décidé de <w>desserrer</w> sa politique monétaire pour relancer l'activité."
                        },
                        {
                            "text": "Les forces de police ont fini par <w>desserrer</w> l'étau autour du quartier bloqué."
                        }
                    ],
                    "synonyms": [
                        "assouplir",
                        "alléger",
                        "atténuer"
                    ],
                    "antonyms": [
                        "durcir",
                        "resserrer"
                    ],
                    "common_phrases": [
                        "desserrer l'étau"
                    ]
                },
                {
                    "sense_id": "6f5dc5dc-fae7-332f-840a-2e32462ea6a3",
                    "sense_definition": "Augmenter l'intervalle entre des personnes ou des objets trop rapprochés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a demandé aux élèves de <w>desserrer</w> les rangs dans la cour."
                        },
                        {
                            "text": "Le graphiste a légèrement <w>desserré</w> les lettres du titre pour mieux l'aérer."
                        }
                    ],
                    "synonyms": [
                        "espacer",
                        "écarter"
                    ],
                    "antonyms": [
                        "rapprocher",
                        "resserrer"
                    ],
                    "common_phrases": [
                        "desserrer les rangs"
                    ]
                }
            ]
        }
    ]
