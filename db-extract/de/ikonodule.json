                        "examples": [
                            {
                                "example_id": "02147fb3-5bab-467c-8ce0-dca5a5f1450f",
                                "sense_id": "b3c1a133-5209-35a2-b536-1147c2e42108",
                                "text": "„Der unermüdlichen Verteidigung durch die Bilderverehrer (Ikonodulen) haben wir die Bedeutung der Ikonen, ihre Ikonographie und ihren Stil zu verdankten.“"
                            },
                            {
                                "example_id": "b2e6ca65-03d9-40bb-9362-dde2ef3d320e",
                                "sense_id": "b3c1a133-5209-35a2-b536-1147c2e42108",
                                "text": "Die Ikonodulen wurden während des Bilderstreites (726-843) verfolgt und mit Folter sowie Hinrichtung bedroht (* Ikonoklasmus)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
