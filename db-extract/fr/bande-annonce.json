                ],
                "senses": [
                    {
                        "sense_id": "1faa7fda-a57f-3530-90cc-2db50be959e9",
                        "entry_id": "21ed7403-5946-39e8-8330-6e88ad200fe2",
                        "glosses": [
                            "Séquence vidéo faisant la promotion d’un film, d’un jeu vidéo, d’une émission de télévision, d’une pièce de théâtre ou d’un livre qui doit sortir, être diffusée ou être interprétée prochainement."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "7a13e093-0657-42b2-abbe-36b988a248d3",
                                "sense_id": "1faa7fda-a57f-3530-90cc-2db50be959e9",
                                "text": "Parfois, une bande-annonce est bien meilleure qu'un film. Toutefois, en matière de vidéos familiales, la bande-annonce est rarement utilisée. En effet, elle est relativement complexe à créer."
                            },
                            {
                                "example_id": "597fbf6c-cec0-4630-b981-9ae02d8e53ce",
                                "sense_id": "1faa7fda-a57f-3530-90cc-2db50be959e9",
                                "text": "Comme je l'annonçais au début de ce chapitre, iMovie propose une fonction de création de bandes-annonces qui n'a rien à envier aux créations d’Hollywood avec ses transitions et son fond musical."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1826ca47-c162-4aed-bc6e-313b2d96f18c",
                        "source_entry_id": "21ed7403-5946-39e8-8330-6e88ad200fe2",
                        "source_sense_id": "1faa7fda-a57f-3530-90cc-2db50be959e9",
