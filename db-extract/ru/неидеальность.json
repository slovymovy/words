                    {
                        "translation_id": "8429ec25-e88f-4f13-8ace-d512f625e1b1",
                        "source_entry_id": "95731d11-5a94-3b5d-b47d-5bebe68582e5",
                        "source_sense_id": "75243ea0-6faa-3602-a36e-556e091f7b89",
