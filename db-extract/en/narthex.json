                "senses": [
                    {
                        "sense_id": "e79e535e-5ecd-364a-946d-19958d8e137d",
                        "entry_id": "05a9b508-9506-3a34-aa26-fc22516efad2",
                        "glosses": [
                            "A western vestibule leading to the nave in some Christian churches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3419b08d-e467-4b36-a705-c26cd8509c1f",
                                "sense_id": "e79e535e-5ecd-364a-946d-19958d8e137d",
                                "text": "we were in the antechamber, called the narthex, which runs across the front of any Byzantine church [...]."
                            },
                            {
                                "example_id": "8e465561-1dae-4d1e-a5dd-af76cc3b820e",
                                "sense_id": "e79e535e-5ecd-364a-946d-19958d8e137d",
                                "text": "One of these was Cardinal Jacopo Stefaneschi, [...] who had now conceived ambitious plans for paintings to decorate the entire narthex, or entrance porch, of Avignon's ancient cathedral."
                            },
                            {
                                "example_id": "f5e699cd-8445-402e-ac29-cb10803a05bf",
                                "sense_id": "e79e535e-5ecd-364a-946d-19958d8e137d",
                                "text": "“Cinco,” Marco bellowed now, hurrying across the narthex to give him a hearty handshake, which Cinco returned without enthusiasm."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb1cd5d2-9b5a-4fa0-8cc3-58642ee3125e",
                        "source_entry_id": "05a9b508-9506-3a34-aa26-fc22516efad2",
