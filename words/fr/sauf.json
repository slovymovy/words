                {
                    "sense_id": "33993861-d3b2-3a92-9420-6aa9584507be",
                    "sense_definition": "Sous réserve de, à moins de ; en envisageant une éventualité contraire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "réserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La livraison aura lieu demain matin, <w>sauf</w> imprévu de dernière minute.",
                            "target_lang_translations": {
                                "en": "The delivery will take place tomorrow morning, <w>barring</w> any last-minute problems.",
                                "ru": "Доставка состоится завтра утром, <w>если не</w> возникнет непредвиденных проблем в последний момент.",
                                "nl": "De levering vindt morgenochtend plaats, <w>tenzij</w> er op het laatste moment iets onverwachts gebeurt.",
                                "de": "Die Lieferung erfolgt morgen früh, <w>sofern nicht</w> in letzter Minute etwas dazwischenkommt.",
                                "pl": "Dostawa odbędzie się jutro rano, <w>chyba że</w> pojawi się jakiś nieprzewidziany problem na ostatnią chwilę.",
                                "it": "La consegna avverrà domani mattina, <w>salvo</w> imprevisti dell'ultimo minuto.",
                                "cs": "Doručení proběhne zítra ráno, <w>pokud nenastane</w> nějaká nečekaná komplikace na poslední chvíli.",
