                                    },
                                    {
                                        "sense_id": "be9c6402-a340-3dea-a55a-cd92bfdf2e14",
                                        "entry_id": "7aa9fcb7-f6e2-3d57-bf99-c8be1bdf9e98",
                                        "glosses": [
                                            "een van de kleine kerkelijke getijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f37be2-7d25-4940-be31-8e23d4a0fad2",
                                                "sense_id": "be9c6402-a340-3dea-a55a-cd92bfdf2e14",
                                                "text": "Rond negen uur 's ochtends wordt, met name in kloosters, het officie van de terts gebeden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5439499-1a80-4ebc-839e-aac43e54fb43",
                        "source_entry_id": "f0389715-48f3-349f-827f-d57e46cfb315",
                        "source_sense_id": "b034ac05-2a46-3910-8e5d-6dbfc287935b",
                        "target_lang_word": "Terz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8eaa61-4d5b-3b66-bf09-cf035d7d9aca",
                                        "entry_id": "cd5d1935-5333-3b6e-a03a-6d504eaefdc2",
                                        "glosses": [
                                            "ein Intervall mit zwei Tönen Unterschied"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bdfa314-8de3-4c64-8196-e5f43fc816e8",
                                                "sense_id": "bd8eaa61-4d5b-3b66-bf09-cf035d7d9aca",
                                                "text": "Das Intervall C–E ist eine Terz."
                                            },
                                            {
                                                "example_id": "11135f8c-33de-45ff-9372-4d3794b54c83",
                                                "sense_id": "bd8eaa61-4d5b-3b66-bf09-cf035d7d9aca",
                                                "text": "„Die verminderten Terzen, die kleinen Septimen verschleifen sich über das Baumwollfeld bis zum Farmhaus hin.“"
                                            },
                                            {
                                                "example_id": "4a6a1f63-2e73-41a2-b890-d8711f3c38c5",
                                                "sense_id": "bd8eaa61-4d5b-3b66-bf09-cf035d7d9aca",
                                                "text": "„Die abwärtsgehende Terz an jedem Morgen ist so sicher wie das Amen in der Kirche und das Überreichen des Pokals nach dem Pokalfinale.“"
                                            },
                                            {
                                                "example_id": "71eaa42c-2dde-4abd-9096-03b6c81f16a0",
                                                "sense_id": "bd8eaa61-4d5b-3b66-bf09-cf035d7d9aca",
                                                "text": "„Die Stimme des Alten sinkt um eine Terz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80a7b8f1-bbfa-3e61-8587-12847e5519b8",
                                        "entry_id": "cd5d1935-5333-3b6e-a03a-6d504eaefdc2",
                                        "glosses": [
                                            "ein Hieb, der aus einem 45°-Winkel von oben auf den Gegner getätigt wird"
                                        ],
                                        "tags": [
                                            "Fechten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f636f102-ce63-4c72-8ad1-a03abd5dd047",
                                                "sense_id": "80a7b8f1-bbfa-3e61-8587-12847e5519b8",
                                                "text": "Terz und Sekond unterscheiden sich vor allem dadurch, daß bei der Terz die Klingenspitze über der Faust ist, bei der Sekond umgekehrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "72eab228-5b3e-3342-b86a-5235fc2c7ed4",
                                        "entry_id": "cd5d1935-5333-3b6e-a03a-6d504eaefdc2",
                                        "glosses": [
                                            "Gebetszeit des Stundengebets, die zur dritten Stunde des Tages (circa 9 Uhr) gebetet wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb24ad5a-c4b4-4210-85d5-fec347123ec3",
                                                "sense_id": "72eab228-5b3e-3342-b86a-5235fc2c7ed4",
                                                "text": "Die Terz ist eine der sogenannten „Kleinen Horen“."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Terz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1b202f-d0c2-3020-a289-adfa007df8ec",
                                        "entry_id": "a72b4b7d-1287-32cf-98ff-e5fad6f594a3",
                                        "glosses": [
                                            "Krach, Umstände"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c0cf640-aaaf-4e2f-a0f0-b31caf4370fc",
                                                "sense_id": "0c1b202f-d0c2-3020-a289-adfa007df8ec",
                                                "text": "Mach keinen solchen Terz!"
                                            },
                                            {
                                                "example_id": "5be66d21-8472-4934-a6d6-dff5a500a7c0",
                                                "sense_id": "0c1b202f-d0c2-3020-a289-adfa007df8ec",
                                                "text": "Mann, was war das für ein Terz, als sie im Büro anfingen, einen auf rauchfrei zu machen."
                                            },
                                            {
                                                "example_id": "6aeee950-f68e-4213-ba29-16addcbde99a",
                                                "sense_id": "0c1b202f-d0c2-3020-a289-adfa007df8ec",
                                                "text": "Ich verstehe ja, dass die Firma nichts für den Terz kann, den die GEMA macht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb518984-32de-3356-a0ae-5bac7481a19d",
                                        "entry_id": "a72b4b7d-1287-32cf-98ff-e5fad6f594a3",
                                        "glosses": [
                                            "Stier, der dreijährig zum Ochse wurde"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
