                        "glosses": [
                            "Gesamtheit aller Merkmale und Tätigkeiten, die einen Beruf ausmachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "204d475e-7c41-47a7-a62e-9ade93597082",
                                "sense_id": "81bcdfb6-9843-3b13-acfc-a9e3bb4ed8ed",
                                "text": "„Trotz der einheitlichen Berufsbezeichnung ist die psychologische Tätigkeit - verglichen mit anderen Berufen - außerordentlich heterogen, es existiert kein einheitliches Berufsbild."
                            },
                            {
                                "example_id": "0413a17b-a486-49bb-80db-90114de353f3",
                                "sense_id": "81bcdfb6-9843-3b13-acfc-a9e3bb4ed8ed",
                                "text": "„Mit der Veranstaltung will die Schule über das Berufsbild des Physiotherapeuten informieren.“"
                            }
                        ],
