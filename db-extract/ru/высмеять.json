                ],
                "senses": [
                    {
                        "sense_id": "b9271c9d-b982-35fe-ab3e-43e77c263b1e",
                        "entry_id": "e343d14a-99e3-3c79-aaa7-3d8e35ae2858",
                        "glosses": [
                            "представить в смешном виде; осмеять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52782527-c753-4514-942e-7beb200344b1",
                                "sense_id": "b9271c9d-b982-35fe-ab3e-43e77c263b1e",
                                "text": "А вдруг глупо? Вдруг он высмеет? Страшно боюсь."
                            }
                        ]
                    },
                    {
                        "sense_id": "845c4e2e-d99c-36c5-af7c-7441ac5804c3",
                        "entry_id": "e343d14a-99e3-3c79-aaa7-3d8e35ae2858",
                        "glosses": [
                            "разг. исчерпать все поводы для веселья, смеха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637545b3-12f0-4a4e-9b65-8177d5703c21",
                                "sense_id": "845c4e2e-d99c-36c5-af7c-7441ac5804c3",
                                "text": "Уже всё высмеяла Маруся ― весь свой смех истратила ― и сидела уже неулыбой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edd1c0bd-2284-4a3c-8fa7-fd61a839834e",
                        "source_entry_id": "e343d14a-99e3-3c79-aaa7-3d8e35ae2858",
                        "target_lang_word": "uitlachen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
