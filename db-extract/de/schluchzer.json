                "senses": [
                    {
                        "sense_id": "0bce7dfb-b933-30cc-ba07-53f539f6edd8",
                        "entry_id": "ae70094e-9a55-3d2a-90bb-920d8496add6",
                        "glosses": [
                            "eine kurze, stoß- und krampfhafte, als schmerzlich empfundene Äußerung einer inneren Verletztheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c32b19db-4dcd-4bcd-be4b-8c2a121c0944",
                                "sense_id": "0bce7dfb-b933-30cc-ba07-53f539f6edd8",
                                "text": "Er konnte seine Schluchzer nur mit Mühe unterdrücken."
                            },
                            {
                                "example_id": "5fbf773e-9865-4cd5-ada9-56255a16e22b",
                                "sense_id": "0bce7dfb-b933-30cc-ba07-53f539f6edd8",
                                "text": "„Mit einem rauen Schluchzer bahnte sich ein Weinen den Weg, das sie nicht mehr aufhalten und nicht mehr anhalten konnte.“"
                            },
                            {
                                "example_id": "b7f13d5a-7d72-4ec6-8a6d-50f327017602",
                                "sense_id": "0bce7dfb-b933-30cc-ba07-53f539f6edd8",
                                "text": "„Nie habe ich Geigenklänge leiden können, diese Schluchzer einer hohlen Kunst.“"
                            },
                            {
                                "example_id": "b212a748-2ede-4cf2-a010-8d92b6e30ebd",
                                "sense_id": "0bce7dfb-b933-30cc-ba07-53f539f6edd8",
                                "text": "„Er seufzte tiefer, ein Schluchzer entrang sich ihm, Verzweiflung malte sich in seinen Zügen, und er stürzte sich von neuem auf den Spaten, vor Anstrengung toll.“"
                            },
                            {
                                "example_id": "7a6df09f-a549-4174-8bc3-28d17041af8b",
                                "sense_id": "0bce7dfb-b933-30cc-ba07-53f539f6edd8",
                                "text": "„Ihre Worte wurden von einem lauten Schluchzer unterbrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
