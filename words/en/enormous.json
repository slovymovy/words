                                "target_lang_sense_clarification": "избыточный, переходящий границы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olağandışı",
                                "target_lang_sense_clarification": "normların dışında kalan"
                            },
                            {
                                "target_lang_word": "anormal",
                                "target_lang_sense_clarification": "genel kurala veya sisteme uymayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异常",
                                "target_lang_sense_clarification": "偏离正常情况"
                            },
                            {
                                "target_lang_word": "非凡",
                                "target_lang_sense_clarification": "超出寻常，通常指程度高"
                            }
