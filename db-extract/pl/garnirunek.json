                "senses": [
                    {
                        "sense_id": "0b8aa5e0-0bc5-3601-aea1-01891fb9cb75",
                        "entry_id": "574f0eda-e200-37cf-ac0a-26db311eface",
                        "glosses": [
                            "przybranie potrawy, dodatki ją zdobiące"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "862c64e6-cfdb-4d5d-b407-ce46a011244c",
                        "source_entry_id": "574f0eda-e200-37cf-ac0a-26db311eface",
                        "source_sense_id": "0b8aa5e0-0bc5-3601-aea1-01891fb9cb75",
                        "target_lang_word": "Garnierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Garnierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                        "entry_id": "48e00977-51a4-3783-a316-016106fa8c77",
                                        "glosses": [
                                            "Verzierung, Dekoration einer zubereiteten Speise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc865d81-d530-4b86-a380-fe4921cfe165",
                                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                                "text": "„Ich schiebe die Schale beiseite und sehe hinüber zum Tresen, wo Dylan einen extrem großen Eisbecher bestellt und so ziemlich jede Garnierung draufschüttet, die sie haben.“"
                                            },
                                            {
                                                "example_id": "1875618f-cca8-4458-b228-ec312025f164",
                                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                                "text": "„Bereiten Sie zuerst die Garnierung vor: Geben Sie die gehackten Salatblätter und Dreiviertel der Butter in einen Topf mit schwerem Boden.“"
                                            },
                                            {
                                                "example_id": "b3d7621f-f11c-4005-b098-6165f5abb645",
                                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                                "text": "„Es gibt Barkeeper, die aufgrund der raffinierten und ansprechenden Garnierung ihrer Cocktails Karriere gemacht haben.“"
                                            },
                                            {
                                                "example_id": "787ddb5e-ee23-4283-b4f0-b07b7248d23a",
                                                "sense_id": "824795ab-8707-317e-b1aa-9dae5dac1c0b",
                                                "text": "„Wenden Sie die Pizza und streuen Sie dann Ihre Garnierungen über die gebratene Seite, die nun oben liegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11f937aa-0a6a-48b8-8ad5-59948956278f",
                        "source_entry_id": "574f0eda-e200-37cf-ac0a-26db311eface",
                        "source_sense_id": "0b8aa5e0-0bc5-3601-aea1-01891fb9cb75",
                        "target_lang_word": "гарнир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гарнир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e2e27c-7a40-3696-a833-7901b6978206",
                                        "entry_id": "2a3e528a-a174-31bf-8ccd-88c1668d2e83",
                                        "glosses": [
                                            "кулин. то, что является дополнением к мясным и рыбным блюдам (жареный, вареный картофель, овощи, вареные крупы или макаронные изделия, фрукты, ягоды, приправы и соусы)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "092f8022-cbfb-49c2-a398-92d1c719ca9d",
                                                "sense_id": "f5e2e27c-7a40-3696-a833-7901b6978206",
                                                "text": "«А в обкладку к осетру подпусти свеклу звёздочкой, да сняточков, да груздочков, да там, знаешь, репушки, да морковки, да бобков, там чего-нибудь этакого, знаешь, того растого, чтобы гарниру, гарниру всякого побольше.»"
                                            },
                                            {
                                                "example_id": "ec30e504-5d76-4077-b450-17826313c946",
                                                "sense_id": "f5e2e27c-7a40-3696-a833-7901b6978206",
                                                "text": "Даже селёдка, распластанная на длинном узком лотке и пестреющая гарниром, как будто смеялась, держа во рту пучок зелёной петрушки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2991410-acf3-36f5-b123-365608bb511e",
                                        "entry_id": "2a3e528a-a174-31bf-8ccd-88c1668d2e83",
                                        "glosses": [
                                            "перен., разг. то, что сопутствует чему-либо главному, основному"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbfb55dc-1d49-4505-ab11-8b13a6c53677",
                                                "sense_id": "b2991410-acf3-36f5-b123-365608bb511e",
                                                "text": ".. да позовёт ещё известного чудака энтузиаста Песцова, либерала, говоруна, музыканта, историка и милейшего пятидесятилетнего юношу, который будет соус или гарнир к Кознышеву и Каренину."
                                            },
                                            {
                                                "example_id": "c86fedc4-392e-4a1f-8e81-778a81fd071d",
                                                "sense_id": "b2991410-acf3-36f5-b123-365608bb511e",
                                                "text": "Весь же остальной «кондуит» представляет гарнир из сквернословия, зуботычин и нагаек, настолько общеизвестный, что даже куплета не стоило сочинять."
                                            },
                                            {
                                                "example_id": "34761ae8-f524-4481-ab2c-eaa24abdfc28",
                                                "sense_id": "b2991410-acf3-36f5-b123-365608bb511e",
                                                "text": "Окружив словесным гарниром свои нехитрые, хотя вполне преступные действия, результат которых уже известен читателю, придумав много препятствий к осуществлению их, Сногден представил дело трудным распутыванием свалявшегося клубка и особенно напирал на то, каких трудов будто бы стоило ему уговорить мастера вывесок Баркета."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
