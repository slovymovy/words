                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a82f001d-d069-44fd-bc0d-9bd86f6ea923",
                                "sense_id": "23c5f6d4-70d4-3d81-ab1c-5c63587400d1",
                                "text": "Eine Baugruppe besteht aus mehreren Einzelteilen."
                            },
                            {
                                "example_id": "d790c02e-2276-4d5f-b7cd-8539fdfb24b1",
                                "sense_id": "23c5f6d4-70d4-3d81-ab1c-5c63587400d1",
                                "text": "„Viele der Wagen waren aus zig Einzelteilen zusammengebastelt, hatten verschiedenfarbige Türen oder Motorhauben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
