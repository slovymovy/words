                    {
                        "translation_id": "33643dee-93dd-4166-a493-f6e951d13c82",
                        "source_entry_id": "1b3c2e5e-e4d0-373d-ad41-52d318527565",
                        "source_sense_id": "81e79a76-9535-39b2-83b2-e2792b01d9db",
                        "target_lang_word": "Flamingo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flamingo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30730e70-b9c0-3377-8954-7d77fe17a324",
                                        "entry_id": "749180f9-85f0-3265-9fb8-1814e1e832a0",
                                        "glosses": [
                                            "Vogel mit langen dünnen Beinen, einem langen biegsamen Hals und einem rosa Gefieder"
                                        ],
                                        "tags": [
                                            "Phoenicoparrus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbc11f5-7554-4104-bc85-6695f11bd9a5",
                                                "sense_id": "30730e70-b9c0-3377-8954-7d77fe17a324",
                                                "text": "Das Gefieder der Flamingos weist stets unterschiedliche Rosatöne auf."
                                            },
                                            {
                                                "example_id": "a912f655-93a9-4414-bdd3-a6eccadfcff4",
                                                "sense_id": "30730e70-b9c0-3377-8954-7d77fe17a324",
                                                "text": "„Jan grinste mich von der Seite an, während wir über die Miniatur-Wege Richtung Ausgang liefen, einbeinige Flamingos zu unserer Rechten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "432ba0c4-7c51-4836-95b5-23e7e1ce3fd0",
                        "source_entry_id": "1b3c2e5e-e4d0-373d-ad41-52d318527565",
                        "source_sense_id": "81e79a76-9535-39b2-83b2-e2792b01d9db",
                        "target_lang_word": "фламинго",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фламинго",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f15add0a-7b0d-3d79-931c-59cb23cbcfa7",
                                        "entry_id": "6859fd6e-ca02-353a-9f83-27a6c82385af",
                                        "glosses": [
                                            "зоол. водная птица семейства фламинговых с нежно-розовым оперением и с очень длинными шеей и ногами (Phoenicopterus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cc4939f-7ec8-4e3d-90c6-cd51298d28b7",
                                                "sense_id": "f15add0a-7b0d-3d79-931c-59cb23cbcfa7",
                                                "text": "У фламинго прелестная, необычайная окраска оперения: она и не розовая и не красная, она особенная. А кроме того, очень трудно проследить, как бледнеет эта окраска, постепенно исчезая в белой…"
                                            },
                                            {
                                                "example_id": "f5d30264-165e-435c-8b9c-292551518034",
                                                "sense_id": "f15add0a-7b0d-3d79-931c-59cb23cbcfa7",
                                                "text": "То была стая фламинго, сидевших на пене и питавшихся рачьей икрой."
                                            },
                                            {
                                                "example_id": "ba82b24c-33b5-452b-9c02-4f1f645cde64",
                                                "sense_id": "f15add0a-7b0d-3d79-931c-59cb23cbcfa7",
                                                "text": "― Кто это? ― Это? ― Бирюков бросился к окну, повис на подоконнике. ― Это розовый фламинго. ― Какой фламинго? ― удивился я и тоже стал карабкаться на подоконник. ― Розовый."
                                            },
                                            {
                                                "example_id": "b5f413af-e931-46dc-8401-f65ca14f2024",
                                                "sense_id": "f15add0a-7b0d-3d79-931c-59cb23cbcfa7",
                                                "text": "А птицы фламинго замерли и любуются своим отражением в спокойной воде."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
