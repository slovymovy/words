                    {
                        "sense_id": "5d7a1401-ccf8-3dff-bbce-8e250be08512",
                        "entry_id": "8a638416-30fe-3943-9675-b5bf60eae526",
                        "glosses": [
                            "Se dit de remèdes très énergiques, spécialement de certains purgatifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5805d141-2409-4ee4-a935-e28b5f1ff614",
                                "sense_id": "5d7a1401-ccf8-3dff-bbce-8e250be08512",
                                "text": "Un remède drastique."
                            },
                            {
                                "example_id": "a04e609a-03fc-48c3-888e-2055c23a43f0",
                                "sense_id": "5d7a1401-ccf8-3dff-bbce-8e250be08512",
                                "text": "Douleurs de ventre, semblables à celles que l’on éprouve, après avoir pris un remède drastique, six heures après le remède."
                            }
                        ]
                    },
                    {
                        "sense_id": "2004085f-cc47-3be5-9037-c8d2fe7322ed",
                        "entry_id": "8a638416-30fe-3943-9675-b5bf60eae526",
                        "glosses": [
                            "(Calque de l’anglais drastic) Draconien, radical."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "0274d194-e7e3-4afc-85f4-4ab5ede5c9ff",
                                "sense_id": "2004085f-cc47-3be5-9037-c8d2fe7322ed",
                                "text": "Son secrétaire se chargea d’effectuer une sélection drastique parmi ces propositions […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65dda7c7-a272-4fc4-9c43-938ebb3c290a",
