                "senses": [
                    {
                        "sense_id": "165a4a98-e443-357f-8a73-c5a8232c7e22",
                        "entry_id": "f1464c2e-d45e-300f-9021-6154b8f62702",
                        "glosses": [
                            "gleichzeitig gezündeter Anschlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7cd238-2695-4b24-bda0-4f2b90fcf32e",
                                "sense_id": "165a4a98-e443-357f-8a73-c5a8232c7e22",
                                "text": "„Häufiges Ziel sind dicht besetzte Nahverkehrsmittel, jüngst vermehrt als Simultananschläge.“"
                            },
                            {
                                "example_id": "57e90179-0908-48bf-b958-6c3fd06dcb85",
                                "sense_id": "165a4a98-e443-357f-8a73-c5a8232c7e22",
                                "text": "„Doch von geschrumpften Raumverhältnissen profitiert nicht nur der Tourist, […], sondern eben auch der Schleuser, der Flugtickets verschafft, der Wirtschaftkriminelle, der schmutziges Geld verschiebt, oder der Terrorist, der Simultananschläge organisiert.“"
                            },
                            {
                                "example_id": "aab27a46-dbad-47b6-b1d1-c5aef7984202",
                                "sense_id": "165a4a98-e443-357f-8a73-c5a8232c7e22",
                                "text": "„Nachrichtendienstler beunruhigt vor allem die Tatsache, dass in Madrid welche Organisation auch immer trotz des hohen Fahndungsdrucks unbemerkt einen derart ausgeklügelten Simultananschlag verüben konnte.“"
                            },
                            {
                                "example_id": "93d2bf8a-dcee-4565-a748-92a57919ba08",
                                "sense_id": "165a4a98-e443-357f-8a73-c5a8232c7e22",
                                "text": "„\"Angsichts der großen Sprengstoffmenge wäre auch ein Simultananschlag mit mehreren gleichzeitig explodierenden Autobombem möglich gewesen\", sagte BKA-Chef Ziercke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
