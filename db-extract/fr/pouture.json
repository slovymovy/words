                        "entry_id": "45c4be6d-7f9e-37e4-b9d3-7819715be29a",
                        "glosses": [
                            "Nourriture pour animaux sous forme de poudre utilisée pour l'engraissement, obtenue en broyant des céréales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412a696d-514b-4418-a1fd-8fa636b0fcb3",
                                "sense_id": "eee0f406-7765-3d73-908a-33bed2bb9325",
                                "text": "Les porcs d’élevage sont nourris avec de la pouture."
                            },
                            {
                                "example_id": "0c18ae44-3dc5-4ec3-93a1-b0b629963949",
                                "sense_id": "eee0f406-7765-3d73-908a-33bed2bb9325",
                                "text": "L’exploitation judicieuse des caractéristiques naturelles, des produits locaux abondants et de faible coût – foin, raves, châtaignes – l’irrigation des prés de fauche et l’engraissement des bœufs de pouture à l’étable l’hiver, ont permis de fournir des animaux gras au marché parisien au moment de l’année où les autres provinces comme la Normandie ne l’approvisionnent que faiblement."
                            }
                        ]
                    }
