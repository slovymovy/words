                                    {
                                        "sense_id": "563261b3-03ae-3f45-9c06-608a46d71263",
                                        "entry_id": "022e98e6-b6a4-31d1-acef-8cc456bba361",
                                        "glosses": [
                                            "den Prinzipien und Methoden der Wissenschaft entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84c69270-e230-453f-9ab6-834e70db78b9",
                                                "sense_id": "563261b3-03ae-3f45-9c06-608a46d71263",
                                                "text": "Das ist eine wissenschaftliche Studie."
                                            },
                                            {
                                                "example_id": "a5bf7f0b-f561-43aa-86ce-c4f24550763c",
                                                "sense_id": "563261b3-03ae-3f45-9c06-608a46d71263",
                                                "text": "„Wir können sagen, daß die Naturphilosophen die ersten Schritte in Richtung einer wissenschaftlichen Denkweise machten.“"
                                            },
                                            {
                                                "example_id": "ddedd3ee-7b21-40bb-8549-57821c13dde3",
                                                "sense_id": "563261b3-03ae-3f45-9c06-608a46d71263",
                                                "text": "„Mit Humboldt beginnt die außereuropäische Dimension wissenschaftlicher Bergbesteigungen.“"
                                            },
                                            {
                                                "example_id": "bc837224-ce23-46ec-8ab9-7884f5608f79",
                                                "sense_id": "563261b3-03ae-3f45-9c06-608a46d71263",
                                                "text": "Mitte der 50er-Jahre beginnt die Ostberliner Humboldt-Universität mit den ersten wissenschaftlichen Untersuchungen zur Entwicklung von Krippenkindern in der DDR."
                                            },
                                            {
                                                "example_id": "64798575-b783-461b-8896-7456a08f7a0b",
                                                "sense_id": "563261b3-03ae-3f45-9c06-608a46d71263",
                                                "text": "„So entziehen sich ausgereifte Sports wie das Bungeespringen, Reiten, Tauchen oder Drachenfliegen dieser Subsumierung als Risikosport, sobald objektivierende Beweisforderungen und wissenschaftliche Maßstäbe an die Zuordnung gelegt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
