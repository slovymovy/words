                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hereditary",
                                "target_lang_sense_clarification": "passed from parent to offspring through genes"
                            },
                            {
                                "target_lang_word": "genetic",
                                "target_lang_sense_clarification": "relating to genes or heredity"
                            },
                            {
                                "target_lang_word": "inherited",
                                "target_lang_sense_clarification": "received from one's parents"
                            }
