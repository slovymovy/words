                    "sense_id": "ec750a76-f281-31f9-b707-61934227af55",
                    "sense_definition": "einen Gegenstand an einen Ort legen oder abdecken, damit andere ihn nicht sehen können",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verstecken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Dieb versuchte, das gestohlene Geld in einem Koffer zu <w>verbergen</w>."
                        },
                        {
                            "text": "Sie <w>verbarg</w> das Geschenk schnell unter ihrem dicken Mantel."
                        }
                    ],
                    "synonyms": [
                        "verstecken"
                    ],
                    "common_phrases": [
                        "unter dem Mantel verbergen"
                    ]
                },
                {
                    "sense_id": "4c4c1094-d38e-340f-bc84-1cedb3095d68",
                    "sense_definition": "sich an einen unauffälligen Ort begeben, um nicht gesehen oder gefunden zu werden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verstecken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kleine Katze <w>verbirgt</w> sich ängstlich hinter dem großen Sofa."
