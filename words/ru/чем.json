{
    "word_family": [
        "что",
        "чтобы",
        "ничто",
        "нечто",
        "кое-что",
        "что-то",
        "что-либо",
        "что-нибудь"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "dc883ad6-8a16-36ec-b82a-06211399ac04",
                    "sense_definition": "Союз, используемый при сравнении предметов, качеств или действий для присоединения второго элемента сравнения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот дом намного выше, <w>чем</w> соседний.",
                            "target_lang_translations": {
                                "en": "This house is much taller <w>than</w> the neighboring one.",
                                "zh": "这座房子<w>比</w>邻居家的房子高得多。"
                            }
                        },
                        {
                            "text": "Она пришла домой позже, <w>чем</w> обещала.",
                            "target_lang_translations": {
                                "en": "She came home later <w>than</w> she promised.",
                                "zh": "她回家的时间<w>比</w>她承诺的要晚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "лучше поздно, чем никогда",
                        "больше, чем",
                        "раньше, чем"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction used to introduce the second element in a comparison.",
                        "zh": "用于比较事物、性质或动作，引出比较的第二项。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "than",
                                "target_lang_sense_clarification": "comparison"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "比",
                                "target_lang_sense_clarification": "用于比较"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76331bbc-5c89-3f1e-bbf7-2bc3f964d34e",
                    "sense_definition": "Используется в двойной конструкции «чем ..., тем ...» для выражения зависимости одной части предложения от другой.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Чем</w> больше мы тренируемся, тем лучше играем.",
                            "target_lang_translations": {
                                "en": "<w>The</w> more we train, the better we play.",
                                "zh": "我们<w>越</w>练习，玩得就越好。"
                            }
                        },
                        {
                            "text": "<w>Чем</w> быстрее ты закончишь работу, тем раньше пойдёшь домой.",
                            "target_lang_translations": {
                                "en": "<w>The</w> sooner you finish work, the earlier you will go home.",
                                "zh": "你工作完成得<w>越</w>快，就能越早回家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "чем больше, тем лучше",
                        "чем скорее, тем лучше"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in the 'the ..., the ...' construction to express that one thing depends on another.",
                        "zh": "用于“越……越……”结构，表示程度随另一事物变化而变化。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the",
                                "target_lang_sense_clarification": "in 'the... the...' construction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "越",
                                "target_lang_sense_clarification": "用于越……越……结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5770ecd3-51bf-357f-b545-378485bd902f",
                    "sense_definition": "Употребляется для противопоставления одного действия другому в значении «вместо того чтобы».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Чем</w> сидеть дома, лучше пойдём погуляем в парке.",
                            "target_lang_translations": {
                                "en": "<w>Rather than</w> sitting at home, let's go for a walk in the park.",
                                "zh": "<w>与其</w>待在家里，不如我们去公园散散步。"
                            }
                        },
                        {
                            "text": "<w>Чем</w> спорить попусту, давай просто сделаем это.",
                            "target_lang_translations": {
                                "en": "<w>Instead of</w> arguing for nothing, let's just do it.",
                                "zh": "<w>与其</w>空争论，不如我们直接把它做了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вместо того чтобы"
                    ],
                    "common_phrases": [
                        "чем говорить, лучше сделать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to contrast one action with another, indicating preference or substitution.",
                        "zh": "表示与其做某事，不如做另一件事，用于对比或选择。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rather than",
                                "target_lang_sense_clarification": "preference"
                            },
                            {
                                "target_lang_word": "instead of",
                                "target_lang_sense_clarification": "substitution"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "与其",
                                "target_lang_sense_clarification": "表示选择"
                            },
                            {
                                "target_lang_word": "不如",
                                "target_lang_sense_clarification": "表示建议"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "e540a5f4-986a-3a59-80ef-c3d31156ba90",
                    "sense_definition": "Форма творительного падежа местоимения <w>что</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Чем</w> ты обычно пишешь, ручкой или карандашом?",
                            "target_lang_translations": {
                                "en": "<w>What</w> do you usually write with, a pen or a pencil?",
                                "zh": "你平时<w>用什么</w>写字，钢笔还是铅笔？"
                            }
                        },
                        {
                            "text": "Я не знаю, <w>чем</w> я могу тебе помочь в этой ситуации.",
                            "target_lang_translations": {
                                "en": "I don't know <w>how</w> I can help you in this situation.",
                                "zh": "我不知道在这种情况下我能<w>怎么</w>帮你。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "чем могу помочь",
                        "ни с чем",
                        "всем, чем можно"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "instrumental case"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The instrumental case form of the pronoun 'what', used to ask about the instrument or means.",
                        "zh": "代词“什么”的工具格形式，用于询问工具、手段或方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "with what",
                                "target_lang_sense_clarification": "instrument/means"
                            },
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "used with 'with'"
                            },
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "by what means"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用什么",
                                "target_lang_sense_clarification": "询问工具"
                            },
                            {
                                "target_lang_word": "怎么",
                                "target_lang_sense_clarification": "询问方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4bc0b6f-859c-394c-a1e3-7b98bdf1cc12",
                    "sense_definition": "Река в России.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Небольшая река <w>Чем</w> протекает через живописный лес.",
                            "target_lang_translations": {
                                "en": "The small river <w>Chem</w> flows through a picturesque forest.",
                                "zh": "一条名为<w>切姆河</w>的小河穿过风景如画的森林。"
                            }
                        },
                        {
                            "text": "Рыбаки часто приезжают на реку <w>Чем</w> за уловом.",
                            "target_lang_translations": {
                                "en": "Fishermen often come to the river <w>Chem</w> for a catch.",
                                "zh": "渔民们经常来到<w>切姆河</w>捕鱼。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A river in Russia.",
                        "zh": "俄罗斯的一条河流。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Chem",
                                "target_lang_sense_clarification": "proper noun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "切姆河",
                                "target_lang_sense_clarification": "专有名词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}