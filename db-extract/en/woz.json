                        "sense_id": "7e6cf0f9-3f04-35a1-9495-92e8a520cd6c",
                        "entry_id": "ab3d964e-d566-3cd0-96ac-2d87446c4b42",
                        "glosses": [
                            "Eye dialect spelling of was."
                        ],
                        "tags": [
                            "alt-of",
