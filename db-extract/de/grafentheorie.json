                "senses": [
                    {
                        "sense_id": "6ad05668-bc41-3d5e-8914-88d347ddfeac",
                        "entry_id": "40d46b6a-ec35-3318-bf70-e845e41df280",
                        "glosses": [
                            "Teilgebiet der Mathematik, das die Eigenschaften von Graphen und ihre Beziehungen zueinander untersucht"
                        ],
                        "tags": [
                            "seltenere Form"
                        ],
                        "examples": [
                            {
                                "example_id": "0bd45751-5da6-4590-93d3-f5e37f5cd007",
                                "sense_id": "6ad05668-bc41-3d5e-8914-88d347ddfeac",
                                "text": "„Diese Definition verwendet direkt die in der Grafentheorie gebräuchlichen Begriffe Pfad und stark zusammenhängend. Man kann deshalb die in der Grafentheorie entwickelten Algorithmen für die Bestimmung stark zusammenhängender Knoten verwenden, wenn man das Blockschaltbild als gerichteten Grafen interpretiert.“"
                            },
                            {
                                "example_id": "6733ef64-e988-4925-9a9a-4255bfc96879",
                                "sense_id": "6ad05668-bc41-3d5e-8914-88d347ddfeac",
                                "text": "„Das Handlungsreisendenproblem gehört zu den härteren Problemen der Grafentheorie, insbesondere, wenn noch die Nebenbedingung erfüllt werden soll, dass nicht nur ein Weg, sondern der kürzeste Weg gefunden werden soll.“"
                            },
                            {
                                "example_id": "2f84fde4-c0e1-4e56-b535-c1058d9709fc",
                                "sense_id": "6ad05668-bc41-3d5e-8914-88d347ddfeac",
                                "text": "„Die Grafentheorie stellt mathematische Methoden bereit, mit denen komplexe Strukturen, die durch verknüpfte Elemente hervorgerufen werden, analysiert werden können.“"
                            },
                            {
                                "example_id": "cd4c34e7-0130-445d-a6c1-7b56c8879a07",
                                "sense_id": "6ad05668-bc41-3d5e-8914-88d347ddfeac",
                                "text": "„Ablaufdiagramme sind Blockschaltbilder, die auf den Symbolen der Grafentheorie basieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
