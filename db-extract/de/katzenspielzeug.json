                "senses": [
                    {
                        "sense_id": "e5b0ffcd-9040-3a4c-a5bc-cce3ac7fb055",
                        "entry_id": "e8da7a90-55b7-3b5e-a5bf-70b3f2086c6e",
                        "glosses": [
                            "speziell auf die Bedürfnisse von Katzen abgestimmtes Spielzeug"
