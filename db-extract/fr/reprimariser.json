                "senses": [
                    {
                        "sense_id": "be65e7b3-1180-3b33-81d7-7e84de7e64fd",
                        "entry_id": "15cf6723-2a84-38cd-bc8e-8297c9c193d6",
                        "glosses": [
                            "Primariser à nouveau une économie."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "baa7ad35-d6c0-4a97-915a-91b457245fa0",
                                "sense_id": "be65e7b3-1180-3b33-81d7-7e84de7e64fd",
                                "text": "Ils ne permettront pas une mise à niveau des asymétries actuelles et ils risquent de reprimariser les économies les plus vulnérable au lieu de permettre de construire de nouveaux avantages comparatifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce1046b-8f43-37c8-92c6-0c36876346da",
                        "entry_id": "15cf6723-2a84-38cd-bc8e-8297c9c193d6",
                        "glosses": [
                            "Rendre un caractère primaire à une forêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72adb319-bc46-4685-aa33-4d1302bcf34d",
                                "sense_id": "0ce1046b-8f43-37c8-92c6-0c36876346da",
                                "text": "Dans certains pays comme le Gabon, l'exode rural a conduit 75% des effectifs humains à se regrouper dans les trois pôles économiques du pays et entraîné un phénomène de «déprise humaine» sur l'environnement, permettant à la forêt de se «reprimariser»."
                            }
                        ]
                    }
