                "senses": [
                    {
                        "sense_id": "623ebda3-b810-38fe-ab60-f15739eb5f9b",
                        "entry_id": "16e4d598-2035-3ad3-97e1-d1d4d30ce7d7",
                        "glosses": [
                            "Gesamtheit der Betriebe, die in der Produktion und Wartung von Kraftfahrzeugen tätig ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb534c20-d602-4c48-bedc-ae9b700f6b70",
                                "sense_id": "623ebda3-b810-38fe-ab60-f15739eb5f9b",
                                "text": "„Da hat die Rücksichtnahme der Regierung auf die Autoindustrie dafür gesorgt, dass die Treibhausgasemissionen gestiegen sind - und zwar von 2010 bis 2013 um über drei Prozent.“"
                            },
                            {
                                "example_id": "2b475647-26ea-4075-95fa-f05df57deb34",
                                "sense_id": "623ebda3-b810-38fe-ab60-f15739eb5f9b",
                                "text": "„Es gibt eine Menge Indizien, dass die Autoindustrie als großer Arbeitgeber in Europa mit besonders viel Nachsicht bei den EU-Behörden, aber auch den nationalen Genehmigungsbehörden rechnen konnte.“"
                            },
                            {
                                "example_id": "726ee303-ee83-4c8f-b85e-a957b6316f88",
                                "sense_id": "623ebda3-b810-38fe-ab60-f15739eb5f9b",
                                "text": "„Die 41-jährige Kalifornierin verfügt im jungen Elektrozweig der Autoindustrie über langjährige Erfahrung und weiß, wo die Stolpersteine liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
