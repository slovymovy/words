                    {
                        "sense_id": "bae33f44-5331-3df7-8d05-506d7406c3b3",
                        "entry_id": "65c51451-4ccf-3d37-a6a5-6c6b5d5a859f",
                        "glosses": [
                            "A surname from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf1ebc2-2cc8-4b05-8a32-6332c33bdb87",
                                "sense_id": "bae33f44-5331-3df7-8d05-506d7406c3b3",
                                "text": "For it would surely improve the domestic standing of Prime Minister Benjamin Netanyahu, an unbudgeable hawk, and thereby indefinitely delay peace on that Middle Eastern front."
                            },
                            {
                                "example_id": "e3db75b8-42d8-4a1c-8871-59b1b64d3fda",
                                "sense_id": "bae33f44-5331-3df7-8d05-506d7406c3b3",
                                "text": "On Tuesday, Netanyahu and his wife toured Shanghai’s Ohel Moshe synagogue in the Hongkou district that was home to many of the 18,000 Jews granted refuge in Shanghai from the horrors of Nazi persecution."
                            }
                        ]
                    }
                ],
