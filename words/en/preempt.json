{
    "word_family": [
        "preemption",
        "preemptive",
        "preemptor",
        "preemptory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7804387-e3ad-32ee-9704-ed63c8d82664",
                    "sense_definition": "To act before an expected event happens in order to prevent it or to gain an advantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preventative action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>preempt</w> the criticism by releasing a detailed report before the meeting.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>опередить</w> критику, опубликовав подробный отчет перед встречей."
                            }
                        },
                        {
                            "text": "She tried to <w>preempt</w> his denial by showing him the evidence immediately.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>предупредить</w> его отказ, немедленно предъявив ему доказательства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preempt the criticism",
                        "preempt his denial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать на опережение, чтобы предотвратить ожидаемое событие или получить преимущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "действовать раньше других"
                            },
                            {
                                "target_lang_word": "предупреждать",
                                "target_lang_sense_clarification": "предотвращать заранее"
                            },
                            {
                                "target_lang_word": "предвосхищать",
                                "target_lang_sense_clarification": "совершать действие до наступления события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f104023-3327-373d-ae6b-40a6037db467",
                    "sense_definition": "To take the place of something else because of having higher priority or importance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "replacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breaking news report will <w>preempt</w> the regularly scheduled television program.",
                            "target_lang_translations": {
                                "ru": "Экстренный выпуск новостей <w>заменит</w> собой обычную телевизионную программу."
                            }
                        },
                        {
                            "text": "Older storage technologies were eventually <w>preempted</w> by more efficient cloud solutions.",
                            "target_lang_translations": {
                                "ru": "Старые технологии хранения данных со временем были <w>вытеснены</w> более эффективными облачными решениями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preempt the schedule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимать место чего-либо другого из-за более высокого приоритета или важности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытеснять",
                                "target_lang_sense_clarification": "заменять собой менее важное"
                            },
                            {
                                "target_lang_word": "заменять",
                                "target_lang_sense_clarification": "вставать на место чего-то другого"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "в пользу более приоритетного события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b01df33e-9a04-37d2-b783-9c2b87e28e71",
                    "sense_definition": "To acquire or take possession of something before others can do so.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investor moved quickly to <w>preempt</w> the best properties in the developing district.",
                            "target_lang_translations": {
                                "ru": "Инвестор действовал быстро, чтобы <w>захватить</w> лучшие объекты недвижимости в развивающемся районе."
                            }
                        },
                        {
                            "text": "He <w>preempted</w> the prime seating area before the rest of the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Он <w>занял</w> лучшие места до того, как прибыли остальные гости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preempt the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приобретать или завладевать чем-либо раньше, чем это смогут сделать другие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывать",
                                "target_lang_sense_clarification": "занимать заранее"
                            },
                            {
                                "target_lang_word": "завладевать",
                                "target_lang_sense_clarification": "получать преимущественное право владения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5748083-e720-3436-9914-fe54feb8b4be",
                    "sense_definition": "To secure land or property by exercising a legal right to purchase it before others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The settlers were able to <w>preempt</w> the land they had been farming for years.",
                            "target_lang_translations": {
                                "ru": "Поселенцы смогли <w>закрепить за собой право</w> на землю, которую они обрабатывали годами."
                            }
                        },
                        {
                            "text": "Under the new law, the government could <w>preempt</w> private claims for public use.",
                            "target_lang_translations": {
                                "ru": "Согласно новому закону, правительство могло <w>аннулировать</w> частные претензии в пользу общественных нужд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preempt the land"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать право на землю или имущество, используя законное право преимущественной покупки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пользоваться правом преимущественной покупки",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "застолбить",
                                "target_lang_sense_clarification": "закрепить за собой право на участок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91ef1da9-357b-3803-89be-c3cb85ecb467",
                    "sense_definition": "In the game of bridge, to make a high bid early to prevent opponents from communicating their strengths.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bridge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>preempt</w> with a three-spade bid to shut out the other team.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>сделать упреждающую заявку</w> в три пики, чтобы отсечь другую команду."
                            }
                        },
                        {
                            "text": "If you <w>preempt</w> correctly, you can make it very difficult for the opponents to find their fit.",
                            "target_lang_translations": {
                                "ru": "Если вы правильно <w>сделаете блок</w>, противникам будет очень сложно найти подходящую масть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preempt the bidding"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "bridge card game"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В бридже: делать высокую ставку в начале игры, чтобы помешать противникам обмениваться информацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать упреждающую заявку",
                                "target_lang_sense_clarification": "в картах"
                            },
                            {
                                "target_lang_word": "прерывать",
                                "target_lang_sense_clarification": "торговлю противника высокой ставкой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "417bed4e-9b56-38e0-a480-44723c82b1d5",
                    "sense_definition": "A high opening bid in bridge intended to interfere with the opponents' bidding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bridge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her aggressive <w>preempt</w> left the opposing pair with no room to explore their options.",
                            "target_lang_translations": {
                                "ru": "Ее агрессивная <w>упреждающая заявка</w> не оставила паре противников возможности изучить свои варианты."
                            }
                        },
                        {
                            "text": "A weak two-bid is a common type of <w>preempt</w> used in modern bridge systems.",
                            "target_lang_translations": {
                                "ru": "Слабая заявка на уровне двух — это распространенный тип <w>преемпта</w>, используемый в современных системах бриджа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opening preempt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "bridge card game"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокая открывающая ставка в бридже, предназначенная для создания помех торговле противников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упреждающая заявка",
                                "target_lang_sense_clarification": "в бридже"
                            },
                            {
                                "target_lang_word": "преемпт",
                                "target_lang_sense_clarification": "профессиональный жаргон игроков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}