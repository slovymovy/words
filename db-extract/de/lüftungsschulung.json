                "senses": [
                    {
                        "sense_id": "7b5d068c-7b36-320d-8cd0-875435732163",
                        "entry_id": "0b373f09-03cf-360f-93c4-36e9cf343fbf",
                        "glosses": [
                            "Veranstaltung, bei der Wissen zur Lüftungstechnik vermittelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e735e588-c185-490b-beca-edd8b56986d6",
                                "sense_id": "7b5d068c-7b36-320d-8cd0-875435732163",
                                "text": "„Zusätzlich zum personellen Ausbau werden seit Oktober 2012 auch spezielle Lüftungsschulungen im neuen Wissenszentrum Glen Dimplex Forum (Bericht von TGA Fachplaner) angeboten.“"
                            },
                            {
                                "example_id": "6cb6f375-0d47-4546-a607-b1546cd40b7b",
                                "sense_id": "7b5d068c-7b36-320d-8cd0-875435732163",
                                "text": "„Zur Prävention von Schimmelpilzen werden extra auf Kinder zugeschnittenen Lüftungsschulungen angeboten.“"
                            },
                            {
                                "example_id": "fd35ce7b-35f3-4971-a79c-edbbf3b8b42c",
                                "sense_id": "7b5d068c-7b36-320d-8cd0-875435732163",
                                "text": "„Um unsere Wärmepumpen- und Lüftungsschulungen so anschaulich wie möglich gestalten zu können, finden diese in unserem Kunden- und Schulungscenter in Kasendorf statt.“"
                            },
                            {
                                "example_id": "18ef0e04-40cb-46cd-a1c8-1c8227bdafd7",
                                "sense_id": "7b5d068c-7b36-320d-8cd0-875435732163",
                                "text": "„„Schimmel- und Lüftungsschulung“ mit Sachverständiger Ahring & VELUX Deutschland in Gevelsberg“."
                            },
                            {
                                "example_id": "2b345573-718e-4b04-9ae5-6c0546e04ff6",
                                "sense_id": "7b5d068c-7b36-320d-8cd0-875435732163",
                                "text": "„Nach einer kurzen Pause folgte eine Lüftungsschulung. Dabei erläuterte uns der Leiter unserer Lüftungs-Abteilung, Herr T. Z., verschiedene Arten von Lüftern und deren Einsatzmöglichkeiten.“"
                            }
                        ],
