                ],
                "senses": [
                    {
                        "sense_id": "b2cf5dde-31b9-385f-a96f-9b4de572e7ae",
                        "entry_id": "65014a63-546f-30a2-8903-82899e0ac783",
                        "glosses": [
                            "Person, die Kunststücke mit einem Luftfahrzeug (vor allem Flugzeug) vorführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80f42852-3cc1-45b0-b0b4-c0a03aa43f49",
                                "sense_id": "b2cf5dde-31b9-385f-a96f-9b4de572e7ae",
                                "text": "„Beim Red Bull Air Race sausen Kunstflieger durch einen Hinderniskurs.“"
                            },
                            {
                                "example_id": "a715aa1b-e148-4d17-9232-d36c9f113a09",
                                "sense_id": "b2cf5dde-31b9-385f-a96f-9b4de572e7ae",
                                "text": "„Hiervon macht vor allem der Kunstflieger mit seinen Figuren wie Loopings, Steilkehren, Spiralen, Trudeln, Rückenkreisen, Gestoßenen und Gesteuerten Rollen Gebrauch.“"
                            },
                            {
                                "example_id": "4d302460-1a8f-4f37-b168-69218b453681",
                                "sense_id": "b2cf5dde-31b9-385f-a96f-9b4de572e7ae",
                                "text": "„Doch am kommenden Sonntag können die Besucher von Verden fliegt einen geschulten Kunstflieger hautnah erleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
