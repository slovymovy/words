                        "target_lang_word": "Twitter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Twitter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5297ad40-82bf-3537-83ec-8ac5dcf379c4",
                                        "entry_id": "b3e1a9cd-d6b1-3073-86ce-cf065f4006e4",
                                        "glosses": [
                                            "Réseau social de messagerie publique."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d4e074-182a-4323-96e8-ca4e6a3eba78",
                                                "sense_id": "5297ad40-82bf-3537-83ec-8ac5dcf379c4",
                                                "text": "Tout comme sur Facebook, Twitter vous permet de créer une communauté de fidèles et d'attirer les prospects, quand vos « followers » retwittent vos messages à leurs propres abonnés."
                                            },
                                            {
                                                "example_id": "e62a777c-9dd0-4171-a23a-4b65608fcfb8",
                                                "sense_id": "5297ad40-82bf-3537-83ec-8ac5dcf379c4",
                                                "text": "Au sein de Twitter, la première semaine sous la houlette d’Elon Musk a ressemblé à une tornade."
                                            },
                                            {
                                                "example_id": "1444aba4-6172-4f10-a54c-7e87a6084eb1",
                                                "sense_id": "5297ad40-82bf-3537-83ec-8ac5dcf379c4",
                                                "text": "Parmi les alternatives, on retrouve Bluesky, plateforme lancée en 2019 par l’ex-fondateur de Twitter, Jack Dorsey."
                                            },
                                            {
                                                "example_id": "1e665135-2858-44e6-9b52-dcb5d66b2f0b",
                                                "sense_id": "5297ad40-82bf-3537-83ec-8ac5dcf379c4",
                                                "text": "Kevin possédait un vieux compte Facebook qui réunissait ses parents et une poignée d'amis, ainsi qu'un Instagram datant de ses années d’AgroParisTech et un Twitter qu'il utilisait de manière passive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
