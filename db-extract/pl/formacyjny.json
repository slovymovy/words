                                "example_id": "bc0ce157-f74b-496c-ba12-8ee87b75d079",
                                "sense_id": "5db8a36e-3023-3336-bfe5-d318e843168c",
                                "text": "Nowicjusz powinien przebywać w domu formacyjnym przez jeden rok."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1a154205-97d5-3d1d-871c-8257f85b57e2",
