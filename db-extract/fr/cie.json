                "entry_id": "8c39b93a-2a12-3c50-9fc3-af40bee370e1",
                "word": "CIE",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "12f2d116-5586-392f-b908-b7c8dee541e4",
                        "entry_id": "8c39b93a-2a12-3c50-9fc3-af40bee370e1",
                        "glosses": [
                            "Centre français qui informe sur la qualité de l’eau, sa consommation, les ressources, l’assainissement des eaux usées, le service public, les professionnels de l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d29784-bf2c-43b8-9523-ffcb4f0d2519",
                                "sense_id": "12f2d116-5586-392f-b908-b7c8dee541e4",
                                "text": "« Difficile d’opposer l’une à l’autre », tempère Nathalie Davoisne du Centre d’information sur l’eau (CIE)."
                            },
                            {
                                "example_id": "7c5b478d-3351-4e42-b08f-934c84bd4567",
                                "sense_id": "12f2d116-5586-392f-b908-b7c8dee541e4",
                                "text": "Le Centre d’information sur l'eau (CIE) a dévoilé, ce vendredi 3 mars, un outil vous permettant d’estimer votre consommation d'eau."
                            },
                            {
                                "example_id": "e5dbcf2d-f0f4-479a-8356-e2ece5e6eee2",
                                "sense_id": "12f2d116-5586-392f-b908-b7c8dee541e4",
                                "text": "Le Centre d’information sur l'eau (CIE) appelle au civisme et à ne plus jeter les lingettes désinfectantes dans les toilettes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
