                    {
                        "sense_id": "ba06894a-e006-38ba-8e45-8a8bfc23578b",
                        "entry_id": "5d6e037c-df05-3006-a0e3-e6c65246ebc8",
                        "glosses": [
                            "Unterricht über einen bestimmten Zeitraum, der dem Aufbau oder der Verbesserung der Kenntnisse der Kursteilnehmer über das Indonesische dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9777824a-3649-43da-864f-4d3038f85b5c",
                                "sense_id": "ba06894a-e006-38ba-8e45-8a8bfc23578b",
                                "text": "„Die herzensgute Gastgeberin Nana und ihr kanadischer Mann Mel umsorgen ihre Gäste bestens und organisieren Mietwagen, Koch- und Indonesischkurse.“"
                            },
                            {
                                "example_id": "70e74929-3a22-4491-a585-ce27e4f989fe",
                                "sense_id": "ba06894a-e006-38ba-8e45-8a8bfc23578b",
                                "text": "„Manfred, der Oldie, der neben mir im Indonesischkurs saß, hat die Dinger an der Weihnachtsfeier verteilt.“"
                            },
                            {
                                "example_id": "840bbd4f-ce78-49cf-b852-a21898233239",
                                "sense_id": "ba06894a-e006-38ba-8e45-8a8bfc23578b",
                                "text": "„Nach einem Vorschlag zur Ausbildung von Spezialisten für Landeskunde und Sprachen wurde 1949 der erste Indonesischkurs eingerichtet.“"
                            }
                        ],
