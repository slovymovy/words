                        "glosses": [
                            "Qui peut être dérouté."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d224b6ae-a146-4c1a-907e-7cf930b4728a",
                                "sense_id": "c85a60c6-f0ae-3f61-9a60-ee90a06a9485",
                                "text": "Il était bien juste que nos climats dussent profiter aussi des découvertes d’une nation qui s’est rendue pas moins respectable à la république des lettres qu’elle a toujours été déroutable au monde guerrier."
                            },
                            {
                                "example_id": "f339250e-cbe1-4924-95cc-e51c360776df",
                                "sense_id": "c85a60c6-f0ae-3f61-9a60-ee90a06a9485",
                                "text": "Les médecins sont facilement déroutables; dans ce cas, il n’en fallait pas tenir compte quant au diagnostic et au pronostic."
                            },
                            {
                                "example_id": "8160b4cd-e5b6-4378-b9ea-e7b45fc9bdba",
                                "sense_id": "c85a60c6-f0ae-3f61-9a60-ee90a06a9485",
                                "text": "Dans l’Arctique, les structures doivent résister à l’assaut des glaces. Si certains icebergs ne sont pas déroutables car trop massifs, les plates-formes sont alors déplacées."
                            }
                        ]
                    }
