                ],
                "senses": [
                    {
                        "sense_id": "2bd4f106-73f5-3f3e-9f18-23bea5b37862",
                        "entry_id": "03c24efc-4883-33b6-9667-f98ccac03457",
                        "glosses": [
                            "Rendre plus robuste."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "bce72b8d-9dcc-4b0c-b4e8-5481f700e551",
                                "sense_id": "2bd4f106-73f5-3f3e-9f18-23bea5b37862",
                                "text": "Bien que convexe, le coût mixte ralentit la progression du coût quadratique pour des grandes erreurs et robustifie son effet."
                            },
                            {
                                "example_id": "a9f6ac09-e17d-4111-ace0-61f6545fadfc",
                                "sense_id": "2bd4f106-73f5-3f3e-9f18-23bea5b37862",
                                "text": "Cette approche permet de robustifier notablement les descripteurs utilisés dans la reconnaissance d’objets vidéo."
                            },
                            {
                                "example_id": "de169374-d87f-4eb6-84ba-cf8cd5fa28dc",
                                "sense_id": "2bd4f106-73f5-3f3e-9f18-23bea5b37862",
                                "text": "Il en résulte qu’elle joue un rôle considérable dans la thérapeutique, puisqu'elle affaiblit la graine et qu’elle robustifie le terrain."
                            },
                            {
                                "example_id": "b6901e2b-3665-4746-9282-391397315227",
                                "sense_id": "2bd4f106-73f5-3f3e-9f18-23bea5b37862",
                                "text": "Cet estimateur combine régularisation et réduction de dimension, respectivement basées sur une pénalité Firth et sur PLS ; Ding et Gentleman robustifient la méthode proposée par Bull et al. (2001) dans le cas n > p et n petit, pour la rendre applicable au cas n < p."
                            }
                        ]
                    }
                ],
