                "senses": [
                    {
                        "sense_id": "75841bb8-5ba9-3a4b-9694-b0cebb6c341a",
                        "entry_id": "46d332e0-3d9b-3292-9308-6f519be7bf75",
                        "glosses": [
                            "mit entsteinten Zwetschgen belegter Kuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c684d627-7244-4888-add8-0ad717d2137c",
                                "sense_id": "75841bb8-5ba9-3a4b-9694-b0cebb6c341a",
                                "text": "Matilda hat am Wochenende einen Zwetschgenkuchen gebackt."
                            },
                            {
                                "example_id": "4c47d20c-0041-4917-801e-ffd4f963c255",
                                "sense_id": "75841bb8-5ba9-3a4b-9694-b0cebb6c341a",
                                "text": "„Als er sich den ersten Bissen ihres selbst kreierten Zwetschgenkuchens mit der herrlichen Mandelcreme und dem süßen Marzipanguss auf der Zunge zergehen ließ, lobte er die Backkunst seiner Frau in den höchsten Tönen: \"Der Kuchen ist preisverdächtig.\"“"
                            },
                            {
                                "example_id": "afbd5bd0-4747-4d47-98e3-854012bb7ef9",
                                "sense_id": "75841bb8-5ba9-3a4b-9694-b0cebb6c341a",
                                "text": "„Auch Herr Lafontaine lies mir schöne Grüße schicken und erklärte, dass seine Lieblingssüßigkeit ein Zwetschgenkuchen vom Blech mit Hefeteig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
