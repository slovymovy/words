                "senses": [
                    {
                        "sense_id": "14efbb2c-ab6f-3a14-b724-1b7cb617418d",
                        "entry_id": "713c0559-233b-3739-a5fb-492047d885dd",
                        "glosses": [
                            "Fait de réioniser, ioniser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6ea199-2a16-48a1-ad5b-156b55e11fe3",
                                "sense_id": "14efbb2c-ab6f-3a14-b724-1b7cb617418d",
                                "text": "En même temps que de permettre de sonder la vitesse à laquelle le brouillard primordial s’est effacé, les observations de l’équipe ont également pointé vers la source probable de la lumière ultraviolette qui a fourni l’énergie nécessaire pour que se produise la réionisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "917bb8ae-7ed1-339d-99b6-e1f82afb77e5",
                        "entry_id": "713c0559-233b-3739-a5fb-492047d885dd",
                        "glosses": [
                            "Époque où un grand nombre d’atomes existant dans l’Univers ont été ionisés par le rayonnement intense de la probable toute première génération d’étoiles à avoir illuminé l’Univers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e146b051-2b60-4c23-94af-3c6cc41818f8",
                                "sense_id": "917bb8ae-7ed1-339d-99b6-e1f82afb77e5",
                                "text": "Ce processus est techniquement connu comme la période de réionisation, car on suppose qu’il a aussi existé une brève période dans les 100 000 premières années après le Big Bang pendant laquelle l’hydrogène était également ionisé."
                            }
                        ]
                    }
