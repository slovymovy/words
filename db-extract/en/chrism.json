                    {
                        "translation_id": "e80a7d03-79ed-4ec6-88c3-17854287378c",
                        "source_entry_id": "b03112ad-dc6d-302d-8ddb-83ce7a0df7e6",
                        "source_sense_id": "6a54f609-9564-38d2-87d0-3c7a26ceb4a2",
