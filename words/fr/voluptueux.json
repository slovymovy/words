{
    "word_family": [
        "volupté",
        "voluptueusement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "381c0473-2fea-3069-9e4b-030ff10d2fbc",
                    "sense_definition": "Qui exprime ou suggère le plaisir sensuel, notamment en parlant de formes corporelles, de gestes ou d'expressions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe mettait magnifiquement en valeur ses formes <w>voluptueuses</w> lors de la soirée."
                        },
                        {
                            "text": "Les danseurs exécutaient des mouvements d'une lenteur <w>voluptueuse</w> au rythme de la musique orientale."
                        }
                    ],
                    "synonyms": [
                        "sensuel",
                        "lascif"
                    ],
                    "antonyms": [
                        "chaste",
                        "pudique"
                    ],
                    "common_phrases": [
                        "formes voluptueuses",
                        "bouche voluptueuse",
                        "danse voluptueuse"
                    ]
                },
                {
                    "sense_id": "1653b2aa-3e6b-3050-b8d7-6f04cd206b24",
                    "sense_definition": "Qui procure ou inspire une vive sensation de plaisir physique, de bien-être ou d'enchantement des sens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle appréciait la chaleur <w>voluptueuse</w> d'un bain parfumé après une longue journée d'hiver."
                        },
                        {
                            "text": "La pièce était imprégnée d'un parfum <w>voluptueux</w> qui invitait immédiatement à la détente."
                        }
                    ],
                    "synonyms": [
                        "délicieux",
                        "enivrant",
                        "suave"
                    ],
                    "antonyms": [
                        "désagréable"
                    ],
                    "common_phrases": [
                        "plaisir voluptueux",
                        "parfum voluptueux",
                        "chaleur voluptueuse"
                    ]
                },
                {
                    "sense_id": "67863faa-25b0-3d1f-b27c-4c3fe8599426",
                    "sense_definition": "Qui aime et recherche avidement les plaisirs des sens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme <w>voluptueux</w> consacrait l'essentiel de sa fortune à la gastronomie et aux arts raffinés."
                        },
                        {
                            "text": "Sa nature <w>voluptueuse</w> l'empêchait de supporter la rigueur et les privations de la vie monastique."
                        }
                    ],
                    "synonyms": [
                        "épicurien",
                        "hédoniste",
                        "jouisseur"
                    ],
                    "antonyms": [
                        "ascétique",
                        "austère",
                        "frugal"
                    ],
                    "common_phrases": [
                        "homme voluptueux",
                        "nature voluptueuse"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9f438cd-0494-3f46-9920-8fbec3151be2",
                    "sense_definition": "Personne qui recherche et s'abandonne sans retenue aux plaisirs des sens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Véritable <w>voluptueux</w>, il ne concevait l'existence qu'à travers les délices d'une table raffinée."
                        },
                        {
                            "text": "Les chats sont de grands <w>voluptueux</w> qui aiment s'étirer des heures durant au soleil."
                        }
                    ],
                    "synonyms": [
                        "épicurien",
                        "hédoniste",
                        "jouisseur"
                    ],
                    "antonyms": [
                        "ascète"
                    ],
                    "common_phrases": [
                        "vrai voluptueux",
                        "grand voluptueux"
                    ]
                }
            ]
        }
    ]
}