                                                "sense_id": "ad62393f-b918-3719-a089-42ecacb58fa1",
                                                "text": "„Die Jury bestand aus Werbefachleuten, Gewerkschaftsvertretern und Delegierten der Handelsbetriebe.“"
                                            },
                                            {
                                                "example_id": "c3bd5792-1250-48c9-92f3-f3e36fa04a08",
                                                "sense_id": "ad62393f-b918-3719-a089-42ecacb58fa1",
                                                "text": "„Er sei Delegierter »des größten Parlamentes der Welt«, sagt er stolz.“"
                                            },
                                            {
                                                "example_id": "ac171fd2-71db-4ad4-ae11-bf3d9531970c",
                                                "sense_id": "ad62393f-b918-3719-a089-42ecacb58fa1",
                                                "text": "„Die dritte Konferenz der Imame und Delegierter islamischer Zentren in Europa ging am Sonntag in Wien zu Ende.“"
                                            }
                                        ],
