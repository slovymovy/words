                "senses": [
                    {
                        "sense_id": "b940b07d-eac4-39bf-aeca-1dbbe6007216",
                        "entry_id": "81eae419-5cb8-377e-aec0-5bf45105b8bf",
                        "glosses": [
                            "Qui thésaurise."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "131cafcb-44de-46ce-9fad-83395f474af8",
                                "sense_id": "b940b07d-eac4-39bf-aeca-1dbbe6007216",
                                "text": "Il semble que ce peuple thésauriseur ait perdu son âme avec l’or qu’il couvait, comme le dragon des poésies Scandinaves."
                            },
                            {
                                "example_id": "272c0bf8-7c13-4359-9c41-3e8494fa03b4",
                                "sense_id": "b940b07d-eac4-39bf-aeca-1dbbe6007216",
                                "text": "Cet homme au physique de notaire était hypermnésique, ce qui entrait dans son cerveau n'en sortait plus et se plaçait automatiquement au bon endroit au point que la documentation du Journal du soir n'était plus que la matérialisation de son esprit thésauriseur, classificateur et archivistique."
                            }
                        ]
                    }
                ],
