                                    {
                                        "sense_id": "5096151f-5016-357a-a915-badba1580d31",
                                        "entry_id": "c35650a8-f3ab-3b97-aac2-7be44804968b",
                                        "glosses": [
                                            "Hatred, fear, dislike of, or prejudice against homosexuals, or LGBTQ people in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1483dc6-b612-49dd-90ab-81b177b2a806",
                                                "sense_id": "5096151f-5016-357a-a915-badba1580d31",
                                                "text": "He lost his racism when he worked with a black man in Chicago. He lost his homophobia when he was befriended and looked after by his gay neighbors, a doctor and a nurse, in Little Rock."
                                            },
                                            {
                                                "example_id": "16a4b117-3154-4f6d-9d4c-3fa67b5e7f2b",
                                                "sense_id": "5096151f-5016-357a-a915-badba1580d31",
                                                "text": "Thinly-veiled homophobia – this time in early-2000s Hollywood – made Brokeback Mountain an immense challenge for Ossana and her fellow producer James Schamus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                        "entry_id": "c35650a8-f3ab-3b97-aac2-7be44804968b",
                                        "glosses": [
                                            "Deliberate misspelling of heterochromia."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "alt-of",
                                            "countable",
                                            "deliberate",
                                            "humorous",
                                            "misspelling",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3d1af4-b7f1-4729-9cb6-85b68b8c0362",
                                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                                "text": "A beautiful otter with homophobia in her 💙 eyes 🧡"
                                            },
                                            {
                                                "example_id": "9f23329a-9a60-451d-a5ef-307206bbce3a",
                                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                                "text": "A dog with homophobia in its eyes ✨✨"
                                            },
                                            {
                                                "example_id": "2b82e62b-661a-4f31-a163-e9f352a0c66b",
                                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                                "text": "beautiful cat with homophobia 💛🩵"
                                            },
                                            {
                                                "example_id": "aaeaa3d7-99c3-4a95-b839-69346ccfa9f2",
                                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                                "text": "beautiful rabbit with homophobia"
                                            },
                                            {
                                                "example_id": "2ef61d11-854f-4899-a147-465a1440fe7e",
                                                "sense_id": "5a9f6d2a-f689-3c54-9b69-8a295ea17b63",
                                                "text": "Alice's Homophobia eyes is what make her beautiful 😔"
                                            }
                                        ]
