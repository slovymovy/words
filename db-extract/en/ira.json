                        "sense_id": "a7744173-f760-3309-b1aa-f813df6f6544",
                        "entry_id": "afc3f06c-32ee-3896-a1fe-fdbfc7720deb",
                        "glosses": [
                            "Initialism of individual retirement account."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
