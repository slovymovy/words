{
    "word_family": [
        "transition",
        "transitional",
        "transitive",
        "transitory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a03fccd-c777-3fd6-aaf2-d20895777b82",
                    "sense_definition": "A system of public transport, such as buses and trains, used by the general public to travel within a city or region.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transport_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually take <w>transit</w> to get to work because driving is too expensive.",
                            "target_lang_translations": {
                                "ru": "Я обычно пользуюсь <w>общественным транспортом</w>, чтобы добраться до работы, так как ездить на машине слишком дорого.",
                                "zh": "我通常坐<w>公共交通</w>去上班，因为开车太贵了。"
                            }
                        },
                        {
                            "text": "The city is planning to improve its mass <w>transit</w> system next year.",
                            "target_lang_translations": {
                                "ru": "В следующем году город планирует улучшить систему <w>общественного транспорта</w>.",
                                "zh": "市政府计划明年改善其<w>公共交通</w>系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "public transport",
                        "transportation"
                    ],
                    "common_phrases": [
                        "mass transit",
                        "public transit",
                        "rapid transit",
                        "take transit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система общественного транспорта (автобусы, поезда и т.д.), используемая населением для передвижения внутри города или региона.",
                        "zh": "指城市或地区内供公众使用的公共交通系统，如公交车和火车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общественный транспорт",
                                "target_lang_sense_clarification": "система пассажирских перевозок"
                            },
                            {
                                "target_lang_word": "транспорт",
                                "target_lang_sense_clarification": "средства передвижения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公共交通",
                                "target_lang_sense_clarification": "指城市内的公共运输系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1c13248-a103-300a-aa4b-9bc13570225c",
                    "sense_definition": "The act or process of moving people or goods from one place to another.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "transport_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The package was damaged while in <w>transit</w> to the customer.",
                            "target_lang_translations": {
                                "ru": "Посылка была повреждена при <w>перевозке</w> клиенту.",
                                "zh": "包裹在<w>运输</w>给客户的过程中受损了。"
                            }
                        },
                        {
                            "text": "We had a long wait in the <w>transit</w> area before our connecting flight.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось долго ждать в <w>транзитной</w> зоне перед пересадкой на следующий рейс.",
                                "zh": "在转机前，我们在<w>过境</w>区等了很久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transport"
                    ],
                    "common_phrases": [
                        "in transit",
                        "goods in transit",
                        "transit visa",
                        "transit time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс перемещения людей или грузов из одного места в другое.",
                        "zh": "将人员或货物从一地运送到另一地的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозка",
                                "target_lang_sense_clarification": "транспортировка грузов или людей"
                            },
                            {
                                "target_lang_word": "транзит",
                                "target_lang_sense_clarification": "провоз грузов или проезд через промежуточный пункт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运输",
                                "target_lang_sense_clarification": "指货物的运送过程"
                            },
                            {
                                "target_lang_word": "过境",
                                "target_lang_sense_clarification": "指经过某地或在某地中转"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee4a9714-852a-3391-8762-53abaffa3817",
                    "sense_definition": "The passage of a celestial body, such as a planet, across the face of a larger body like the sun.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astro_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers gathered to observe the rare <w>transit</w> of Venus.",
                            "target_lang_translations": {
                                "ru": "Астрономы собрались, чтобы пронаблюдать редкое <w>прохождение</w> Венеры.",
                                "zh": "天文学家们聚集在一起观测罕见的金星<w>凌</w>日现象。"
                            }
                        },
                        {
                            "text": "The telescope recorded the <w>transit</w> of the satellite across the moon.",
                            "target_lang_translations": {
                                "ru": "Телескоп зафиксировал <w>прохождение</w> спутника на фоне Луны.",
                                "zh": "望远镜记录下了卫星经过月球表面的<w>凌</w>月过程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прохождение небесного тела, например планеты, на фоне диска более крупного тела, например Солнца.",
                        "zh": "指天体（如行星）经过较大天体（如太阳）表面的现象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прохождение",
                                "target_lang_sense_clarification": "астрономическое явление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凌",
                                "target_lang_sense_clarification": "天文学术语，指天体经过另一天体表面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a7d90ff-3245-3bc5-9435-0e9ae2baf587",
                    "sense_definition": "To pass across or through a specific area or place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large cargo ship <w>transited</w> the canal without any issues.",
                            "target_lang_translations": {
                                "ru": "Большой грузовой корабль <w>прошел</w> через канал без каких-либо проблем.",
                                "zh": "那艘大型货船顺利地<w>通过</w>了运河。"
                            }
                        },
                        {
                            "text": "Passengers must stay in the terminal while they <w>transit</w> through the airport.",
                            "target_lang_translations": {
                                "ru": "Пассажиры должны оставаться в терминале, пока <w>следуют транзитом</w> через аэропорт.",
                                "zh": "乘客在机场<w>过境</w>时必须留在航站楼内。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пересекать или проходить через определенную область или место.",
                        "zh": "穿过或经过某个特定的区域或地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "двигаться через пространство"
                            },
                            {
                                "target_lang_word": "следовать транзитом",
                                "target_lang_sense_clarification": "проезжать через пункт пересадки"
                            },
                            {
                                "target_lang_word": "пересекать",
                                "target_lang_sense_clarification": "проходить поперек чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "指穿过某处"
                            },
                            {
                                "target_lang_word": "过境",
                                "target_lang_sense_clarification": "指经过某国或某地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e1fba19-94fb-3d9f-90da-afb8f0a7947a",
                    "sense_definition": "To pass across the face of a celestial body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astro_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched as the planet <w>transited</w> the star, slightly dimming its light.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как планета <w>проходила</w> по диску звезды, слегка затмевая её свет.",
                                "zh": "我们观察到行星<w>凌</w>过恒星，使其光芒略微变暗。"
                            }
                        },
                        {
                            "text": "The space station <w>transited</w> the sun in less than a second.",
                            "target_lang_translations": {
                                "ru": "Космическая станция <w>прошла</w> по диску Солнца менее чем за секунду.",
                                "zh": "空间站在不到一秒的时间内<w>凌</w>日。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить на фоне небесного тела.",
                        "zh": "指天体在另一个天体表面经过。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "двигаться на фоне другого объекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凌日",
                                "target_lang_sense_clarification": "指行星经过太阳表面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}