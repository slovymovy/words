                                "sense_id": "43c7cfe2-b62b-3383-877e-48def14c79c4",
                                "text": "Nous nous prîmes la main, nous marchâmes en silence vers notre lit douillet."
                            }
                        ]
                    },
                    {
                        "sense_id": "f35626a7-a1be-3d94-94e7-0287d8004168",
                        "entry_id": "584ddad0-5932-3a50-887f-f4e9f0169727",
                        "glosses": [
                            "Qualifie une personne trop délicate, qu’un rien incommode, qui est sensible à la plus légère douleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53fad1fe-682c-428d-8a3e-a225eb8082f9",
                                "sense_id": "f35626a7-a1be-3d94-94e7-0287d8004168",
                                "text": "Au Québec, on jappe, mais on ne mord pas. Nous sommes un peuple douillet."
                            },
                            {
                                "example_id": "4eeda935-2a41-4844-88e2-8a5704520c5b",
                                "sense_id": "f35626a7-a1be-3d94-94e7-0287d8004168",
                                "text": "Cet enfant est trop douillet !"
                            },
                            {
                                "example_id": "15bb99db-f297-494a-9ba3-6a987ce982e8",
                                "sense_id": "f35626a7-a1be-3d94-94e7-0287d8004168",
                                "text": "Ne soyez pas si douillette !"
                            }
                        ]
                    }
