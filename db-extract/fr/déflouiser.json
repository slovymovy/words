                        "entry_id": "26b5d62d-1f9f-349a-ad9e-78b577ee18cc",
                        "glosses": [
                            "Faire perdre son caractère flou à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb747c8e-ce93-458b-80ed-21967cfb8ec3",
                                "sense_id": "26f850ae-68dd-3662-bceb-4db5ad230fc9",
                                "text": "Mais lorsque les décisions possibles ne sont pas nombreuses, « déflouiser » peut être brutal."
                            },
                            {
                                "example_id": "c638f67f-e3ba-479e-a8fa-04c545fd6683",
                                "sense_id": "26f850ae-68dd-3662-bceb-4db5ad230fc9",
                                "text": "ok! lol ! je vais essayer de « déflouiser » sur photofiltre…!!"
                            },
                            {
                                "example_id": "0deafca3-f2cc-42ee-b92c-b8d067a816fc",
                                "sense_id": "26f850ae-68dd-3662-bceb-4db5ad230fc9",
                                "text": "Sinon je vais tester tiens, en réglant mieux le cleartype, voir si ça déflouise un peu mon écran quand je pousse à 120Hz le 1600."
                            },
                            {
                                "example_id": "32108842-2a6a-4ac5-9739-e284a8d3269e",
                                "sense_id": "26f850ae-68dd-3662-bceb-4db5ad230fc9",
                                "text": "Noah, ça se déflouise gentiment mais sûrement"
                            }
                        ]
                    }
