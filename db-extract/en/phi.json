                        "entry_id": "970686b9-1e14-3b66-ae33-0cb45524809c",
                        "glosses": [
                            "Φ, the 21st letter of the Euclidean and modern Greek alphabet, usually romanized as \\\"ph\\\"."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ab7f3b63-cbcd-3a84-b687-0a2bf0677bfe",
                        "entry_id": "970686b9-1e14-3b66-ae33-0cb45524809c",
