                    {
                        "sense_id": "66e3258d-95f2-30e1-8b90-02a170cd95ab",
                        "entry_id": "8c2fd5c8-3384-31ea-87aa-976244a3939d",
                        "glosses": [
                            "kan met een uitstulping aan de bovenrand om het schenken te vergemakkelijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d311ca-7e99-4a2b-a50a-9853346354cc",
                                "sense_id": "66e3258d-95f2-30e1-8b90-02a170cd95ab",
                                "text": "De thee wordt geschonken uit een tuitkan, in glazen."
                            },
                            {
                                "example_id": "9d4e5f4f-9d89-490c-9f1a-b2301c303052",
                                "sense_id": "66e3258d-95f2-30e1-8b90-02a170cd95ab",
                                "text": "Op het tinnen deksel van een kruik van aardewerk heeft Peeters zichzelf als minuscule reflectie afgebeeld, met wit kapje en witte kraag. Op de tinnen tuitkan van een Stilleven met bloemen en lekkernijen (1611) heeft ze dat maar liefst vijf keer gedaan, in een rij boven elkaar, waarvan een keer ondersteboven geprojecteerd op de bolling van de kan. De schilderijen van Peeters hebben een glanzende hardheid en precisie, als van parelmoer."
                            }
                        ]
                    },
