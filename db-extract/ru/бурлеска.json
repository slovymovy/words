                        "glosses": [
                            "пародийно-возвышенный, героико-комический стиль"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a26ca744-6072-37aa-bc3c-af2b1f031393",
                        "entry_id": "4936cc6d-6a90-3a52-804c-aec354b10926",
                        "glosses": [
                            "муз. пьеса причудливого, шутливого, грубовато-комического характера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97e6f23-1104-4032-bedd-688d2f4d55d6",
                                "sense_id": "a26ca744-6072-37aa-bc3c-af2b1f031393",
                                "text": "Юный Штраус начал с подражания Мендельсону, Шуману и их школам (рояльный квартет ор. 13, серенада ор. 7 для духовых инструментовъ, бурлеска для рояля и оркестра, великолепно исполненная Бакгаузом,.."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b925ff8-ddfd-3655-8195-426974483962",
                        "entry_id": "4936cc6d-6a90-3a52-804c-aec354b10926",
                        "glosses": [
                            "театр. небольшая шуточная, пародийная опера, близкая к водевилю"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8929bd7-1f71-4196-8357-2b2326951d52",
                        "source_entry_id": "4936cc6d-6a90-3a52-804c-aec354b10926",
                        "target_lang_word": "burlesque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burlesque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edb181e1-4f8f-31ba-a7bd-af9bad5e66a8",
                                        "entry_id": "7ce4c03e-b9c2-33cf-ab91-d17e68b706d9",
                                        "glosses": [
                                            "Qui est d’une bouffonnerie outrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508d263f-7387-4f51-b5bf-1f2254fe1024",
                                                "sense_id": "edb181e1-4f8f-31ba-a7bd-af9bad5e66a8",
                                                "text": "Ces récits de braconnage sont inséparables de l'exagération si bien que beaucoup d'entre eux se sont mués en hâbleries, en contes de mensonge, invraisemblables et burlesques."
                                            },
                                            {
                                                "example_id": "37f0abee-cb7d-4d4e-a77b-fa580d1b8eb8",
                                                "sense_id": "edb181e1-4f8f-31ba-a7bd-af9bad5e66a8",
                                                "text": "Le pianiste Nicolas Chalopain accompagnera la projection des films en apportant un univers musical autour des personnages, et pour illustrer les situations burlesques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burlesque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c284619-0b2a-3ea6-b593-a30246d03060",
                                        "entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                                        "glosses": [
                                            "Genre, style burlesque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76314a05-e59d-4858-b118-92abe98f5c89",
                                                "sense_id": "6c284619-0b2a-3ea6-b593-a30246d03060",
                                                "text": "Dans le domaine du spectacle, le burlesque recourt à tous les artifices pour provoquer le rire, jouant sur le décalage entre l'absurde et la réalité. La gestuelle est généralement mise à contribution."
                                            },
                                            {
                                                "example_id": "6e736a39-9221-47bb-84f3-8737d9c5d390",
                                                "sense_id": "6c284619-0b2a-3ea6-b593-a30246d03060",
                                                "text": "Le burlesque c’est l’inconvenance, l’inadéquation, l’incongruité même, par définition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0e9a6d-950d-3293-8a73-d096ba065ee9",
                                        "entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                                        "glosses": [
                                            "Décalage entre grandeur et petitesse."
                                        ],
                                        "tags": [
                                            "Littérature française classique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93811c7e-8f82-418b-8a39-ff1b8c5948f2",
                                                "sense_id": "1e0e9a6d-950d-3293-8a73-d096ba065ee9",
                                                "text": "Le discours d'un personnage qui mèlera dans les mêmes tirades un champ lexical lyrique, passionné, tragique, etc. à des préoccupations triviales. Le théâtre de Molière recourt fréquemment au burlesque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
