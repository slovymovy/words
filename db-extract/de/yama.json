                "senses": [
                    {
                        "sense_id": "b34048c5-4336-34a2-9c7b-1a0e1bfbeb22",
                        "entry_id": "ec46f985-25f4-3e68-98f5-2e2f3e3e090b",
                        "glosses": [
                            "ethische Grundregel, Verhaltensweise gegenüber den Mitmenschen"
                        ],
                        "tags": [
                            "Hinduismus",
                            "Yoga, insbesondere Raja Yoga, Kundalini Yoga, Hatha Yoga"
                        ],
                        "examples": [
                            {
                                "example_id": "c06cee58-c8d1-4ba7-82cb-152e1b2933ea",
                                "sense_id": "b34048c5-4336-34a2-9c7b-1a0e1bfbeb22",
                                "text": "„Die Yamas bestehen aus Nicht-Verletzen (Ahimsa), Wahrhaftigkeit (Satya); Nicht-Stehlen (Asteya), Enthaltsamkeit (Brahmacharya) und Unbestechlichkeit (Aparigraha). Diese Grundregeln sind nicht durch soziale Schicht, Ort, Zeit oder Umstände bedingt. Sie gelten für alle Ebenen und bilden das große universelle Gelübde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
