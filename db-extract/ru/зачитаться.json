                "senses": [
                    {
                        "sense_id": "5cd47561-35aa-378b-82c0-b98dbcef3904",
                        "entry_id": "c5d48a8d-63c0-3f28-917a-de5df3909316",
                        "glosses": [
                            "погрузившись в чтение, увлечься, забыться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64df162-d3db-4c3b-9235-5ce7c6cc3b5a",
                                "sense_id": "5cd47561-35aa-378b-82c0-b98dbcef3904",
                                "text": "Сегодня я нечаянно открыл вашу \"Историю в рассказах\" и поневоле зачитался. Вот как надобно писать!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f688507-784a-3419-b706-5543265748a5",
                        "entry_id": "c5d48a8d-63c0-3f28-917a-de5df3909316",
                        "glosses": [
                            "растратить умственные способности, помешаться, слишком много читая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c32db66f-2e80-497b-9db0-e1a2b1c3daaa",
                                "sense_id": "1f688507-784a-3419-b706-5543265748a5",
                                "text": "Филипп был какой-то ипохондрик... люди говорили, \"зачитался\"."
                            }
                        ]
                    }
