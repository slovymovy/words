                "senses": [
                    {
                        "sense_id": "1c295683-1d21-3e27-ac38-17c7b0e2151f",
                        "entry_id": "ec367c59-e0f8-3dd4-9dd8-5f239df34b37",
                        "glosses": [
                            "een geheel van met behulp van loodlijsten en kit bij elkaar gehouden stukken glas in een versterruit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc657985-5eb4-4236-b624-4392dc592d9d",
                                "sense_id": "1c295683-1d21-3e27-ac38-17c7b0e2151f",
                                "text": "Een glas-in-loodraam is een vrij zwakke constructie."
                            },
                            {
                                "example_id": "ed655105-5eba-4705-a002-5e2c4b193e70",
                                "sense_id": "1c295683-1d21-3e27-ac38-17c7b0e2151f",
                                "text": "- Dan beent Stefan naar voren en schuift hij met een ruk de puideuren dicht. Achter het half doorschijnende glas-in-loodraam zien we de magere vrouw tot stilstand komen; we horen zelfs de zachte bons van trillend glas als ze tegen het ruitje op botst."
                            },
                            {
                                "example_id": "4e06c0d1-7da2-4b58-9f3d-e11a902df6bf",
                                "sense_id": "1c295683-1d21-3e27-ac38-17c7b0e2151f",
                                "text": "- De Britse koningin Elizabeth II heeft vandaag een speciaal glas-in-loodraam gekregen in Westminster Hall in Londen. Dit gebeurde ter gelegenheid van haar toespraak tot parlementsleden wegens haar 60-jarig regeringsjubileum dit jaar. Het raam bestaat uit 1500 stukjes glas."
                            }
                        ]
                    }
