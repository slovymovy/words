                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffff6d55-6bfb-4875-a158-5ef9ad172476",
                                                "sense_id": "2f0e6b13-9d75-3db2-b77e-28e76f933062",
                                                "text": "Une fois absorbé, ce fongicide se transforme en carbendazime qui est un antimitotique."
                                            },
                                            {
                                                "example_id": "9202bd61-3771-44b3-b374-2954d8e29083",
                                                "sense_id": "2f0e6b13-9d75-3db2-b77e-28e76f933062",
                                                "text": "Les antimitotiques coûtent très cher et le coût du traitement du cancer est élevé."
                                            },
                                            {
                                                "example_id": "14cfe0ba-3d1e-4062-bac3-b7b02c296fe1",
                                                "sense_id": "2f0e6b13-9d75-3db2-b77e-28e76f933062",
                                                "text": "Le chloraminophène est un antimitotique violent, une seule injection est très tératogène chez la souris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antimitotique",
