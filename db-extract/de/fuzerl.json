                ],
                "senses": [
                    {
                        "sense_id": "25a6461c-4c1a-3c63-823f-dff3f0fc8959",
                        "entry_id": "54066b5b-659f-3d55-853f-7915532c2c3a",
                        "glosses": [
                            "winziges Stück von (homogenem) Material"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c353ac82-9e78-4c73-9c6e-22b63cb9c20f",
                                "sense_id": "25a6461c-4c1a-3c63-823f-dff3f0fc8959",
                                "text": "„Hier treffen sich die Freerider bis zum letzten Fuzerl Schnee im abschüssigen Gelände.“"
                            },
                            {
                                "example_id": "97204ecb-3122-4b24-9808-0db87f857232",
                                "sense_id": "25a6461c-4c1a-3c63-823f-dff3f0fc8959",
                                "text": "„Das Haupthindernis war, dass wir kein Schreibzeug hatten, jedes Fuzerl Papier und geliehene Bleistifte mussten mit Brotschnitten erkauft werden.“"
                            },
                            {
                                "example_id": "f5874712-161f-4a2c-ae7b-5941eec038de",
                                "sense_id": "25a6461c-4c1a-3c63-823f-dff3f0fc8959",
                                "text": "„Auch wenn noch ein Fuzerl der abgekratzten Vignette vorhanden gewesen wäre, hätte das nichts genützt.“"
                            },
                            {
                                "example_id": "35b1b004-cb69-42d5-a122-261b2eed2d09",
                                "sense_id": "25a6461c-4c1a-3c63-823f-dff3f0fc8959",
                                "text": "„Wenn das Geschriebene mir nicht gefiel, zerriss ich den Zettel in ganz kleine Fuzerl, warf sie in den Ofen, wenn gekocht wurde. Im Sommer saß ich aber trotz Verbot gerne am Rand des Baches, warf die Fuzerl ins Wasser und schaute ihnen nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
