                                "sense_id": "87755fa6-d1bd-3e90-af64-4b948836075f",
                                "text": "Les zapatistes cherchent à prendre le pouvoir."
                            },
                            {
                                "example_id": "4139f847-d610-4358-8459-1558d566b591",
                                "sense_id": "87755fa6-d1bd-3e90-af64-4b948836075f",
                                "text": "Il y a vingt ans, l’insurrection des zapatistes du Chiapas inaugurait un cycle de dissidence et de résistance aux effets destructeurs de la mondialisation néolibérale."
                            }
                        ]
                    }
