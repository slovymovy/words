                {
                    "sense_id": "e0638c7e-562b-3186-ad64-fdf43693efcb",
                    "sense_definition": "Marque la répétition successive ou la progression continue entre deux termes identiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La situation économique du pays s'améliore peu <w>à</w> peu avec le temps."
                        },
                        {
                            "text": "Le professeur vérifie les exercices des élèves un <w>à</w> un."
                        }
                    ],
                    "common_phrases": [
                        "peu à peu",
                        "un à un",
                        "pas à pas"
                    ]
                },
                {
                    "sense_id": "45bba527-1b1f-3e28-8472-c69985d2b6e3",
                    "sense_definition": "Relie deux nombres pour marquer une approximation ou un intervalle estimé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nombre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyage en autocar durera de quatre <w>à</w> cinq heures selon la circulation."
                        },
                        {
                            "text": "Il faudra inviter dix <w>à</w> douze personnes pour ce dîner officiel."
                        }
                    ],
                    "common_phrases": [
                        "deux à trois",
                        "cinq à six"
                    ]
                },
                {
                    "sense_id": "42253a5d-1976-3a65-8600-4741fe709aa9",
                    "sense_definition": "Indique la personne ou le lieu d'où l'on obtient, achète ou prend quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "provenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a emprunté une somme d'argent importante <w>à</w> son voisin."
                        },
                        {
                            "text": "Nous avons acheté ces délicieux légumes <w>à</w> un producteur local."
                        }
                    ],
                    "common_phrases": [
                        "acheter à un marchand",
                        "emprunter à quelqu'un"
                    ]
                },
                {
                    "sense_id": "769fedb1-d355-33c9-8170-1e8669afd706",
                    "sense_definition": "Introduit la manière, le point de vue ou le motif selon lequel une chose est considérée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons aborder cette question délicate <w>à</w> la lumière des faits récents."
                        },
                        {
                            "text": "Il a été engagé pour diriger ce projet <w>à</w> titre purement consultatif."
                        }
                    ],
                    "common_phrases": [
                        "à ce propos",
                        "à titre indicatif"
                    ]
                }
            ]
        }
    ]
