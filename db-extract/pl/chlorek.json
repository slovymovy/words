                        ]
                    },
                    {
                        "translation_id": "77b1cd58-41fe-4f37-aa56-dae45babea8b",
                        "source_entry_id": "92e69709-2965-3e05-86e4-95f7d96c8672",
                        "source_sense_id": "6bdb8c7e-b53b-325b-bc0f-9376ad3d8592",
                        "target_lang_word": "Chlorid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chlorid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c6d7931-1348-381a-9fa5-bbbb8808b3f0",
                                        "entry_id": "87adc78e-9c65-3609-8022-a0348dc99f7e",
                                        "glosses": [
                                            "Salz der Chlorwasserstoffsäure (auch Salzsäure) mit ionischer Bindung"
                                        ],
                                        "tags": [
                                            "anorganische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e6be87-bd03-45e5-817a-dc619d69823f",
                                                "sense_id": "3c6d7931-1348-381a-9fa5-bbbb8808b3f0",
                                                "text": "Kochsalz ist das bekannteste Chlorid."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e94de12-4abf-3793-bb59-77454ff472d5",
                                        "entry_id": "87adc78e-9c65-3609-8022-a0348dc99f7e",
                                        "glosses": [
                                            "Derivat der verschiedenen Verbindungen der Kohlenwasserstoffe mit molekularer Bindung"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61cf7174-a26a-4d1a-9399-644f1e1c36a7",
                                                "sense_id": "2e94de12-4abf-3793-bb59-77454ff472d5",
                                                "text": "„Die Bezeichnung dieser nicht salzartigen organischen Verbindungen als ‚Chlorid‘ ist fragwürdig, aber dennoch üblich.“",
                                                "translation": "„Polen hatte die Übernahme russischen Öls am Mittwochabend gestoppt, nachdem starke Verunreinigungen mit Chloriden nachgewiesen worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e896b31-e2db-4652-8912-b0425119a438",
                        "source_entry_id": "92e69709-2965-3e05-86e4-95f7d96c8672",
                        "source_sense_id": "6bdb8c7e-b53b-325b-bc0f-9376ad3d8592",
                        "target_lang_word": "хлорид",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хлорид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb898819-9014-3061-83ee-d479dd2a7906",
                                        "entry_id": "7604dce9-82f2-3422-921d-9aca4e6f5bab",
                                        "glosses": [
                                            "хим. соль хлороводородной (соляной) кислоты HCl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "250c96e9-4eb0-4c15-807c-da3bf253026b",
                                                "sense_id": "eb898819-9014-3061-83ee-d479dd2a7906",
                                                "text": "Хлорид цезия, содержащий катионы сильного основания и анионы сильной кислоты, дает в растворе реакцию, близкую к нейтральной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d5d1c3-6870-3402-a5fc-69bf4e85e40b",
                                        "entry_id": "7604dce9-82f2-3422-921d-9aca4e6f5bab",
                                        "glosses": [
                                            "хим. анион хлороводородной (соляной) кислоты Cl⁻"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95fc677b-d3f8-42d0-99c0-3a12579a0bbe",
                                                "sense_id": "93d5d1c3-6870-3402-a5fc-69bf4e85e40b",
                                                "text": "Концентрации хлорид- и сульфат-ионов и ионов меди не вызывают опасений, так как не выходят за пределы ПДК."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e573f5-3cc8-31b7-bc36-44f64541fc80",
                                        "entry_id": "7604dce9-82f2-3422-921d-9aca4e6f5bab",
                                        "glosses": [
                                            "хим. хлорсодержащее соединение, содержащее ковалентную связь хлор-элемент"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713973af-b6cf-4ccb-b900-d603f6511c61",
                                                "sense_id": "61e573f5-3cc8-31b7-bc36-44f64541fc80",
                                                "text": "Полученные из 2,5-дихлордигидропиразина (этот хлорид является производным энола дикетопиперазина) амидины со временем претерпевают десмотропную перегруппировку"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
