{
    "word_family": [
        "frill"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d432ca5-1ca0-36ca-a905-23917481d614",
                    "sense_definition": "Decorated with frills or ruffles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl wore a <w>frilly</w> dress to the birthday party.",
                            "target_lang_translations": {
                                "pl": "Mała dziewczynka założyła na przyjęcie urodzinowe sukienkę <w>z falbankami</w>."
                            }
                        },
                        {
                            "text": "She bought a <w>frilly</w> pillowcase for her new bed.",
                            "target_lang_translations": {
                                "pl": "Kupiła <w>falbaniastą</w> poszewkę na poduszkę do swojego nowego łóżka."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffled"
                    ],
                    "common_phrases": [
                        "frilly dress",
                        "frilly skirt"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ozdobiony falbankami lub marszczeniami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "z falbankami",
                                "target_lang_sense_clarification": "najbardziej bezpośrednie określenie przedmiotu posiadającego falbanki"
                            },
                            {
                                "target_lang_word": "falbaniasty",
                                "target_lang_sense_clarification": "przymiotnik opisujący coś, co ma dużo falban"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e7e5d45-170c-3f2a-82e8-0d11747b3503",
                    "sense_definition": "Excessively elaborate or showy in style.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speech was too <w>frilly</w> and lacked any real substance.",
                            "target_lang_translations": {
                                "pl": "Przemówienie było zbyt <w>przeładowane ozdobnikami</w> i brakowało mu konkretnej treści."
                            }
                        },
                        {
                            "text": "He preferred a simple design over the <w>frilly</w> decorations of the past.",
                            "target_lang_translations": {
                                "pl": "Wolał prosty design od <w>przekombinowanych</w> dekoracji z przeszłości."
                            }
                        }
                    ],
                    "synonyms": [
                        "ornate",
                        "fussy"
                    ],
                    "antonyms": [
                        "plain",
                        "simple"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nadmiernie ozdobny, przesadnie wyszukany lub pretensjonalny w stylu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeładowany",
                                "target_lang_sense_clarification": "odnoszący się do stylu, który ma zbyt wiele ozdobników"
                            },
                            {
                                "target_lang_word": "przekombinowany",
                                "target_lang_sense_clarification": "odnoszący się do czegoś, co jest zbyt skomplikowane lub ozdobne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}