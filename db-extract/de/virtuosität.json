                        "sense_id": "4abfd7c1-baff-3909-95cb-3aebac74f562",
                        "entry_id": "38135ed2-2eda-3801-94e1-f3778ccf0322",
                        "glosses": [
                            "ausgereifte Fähigkeit und Fertigkeit, besonders als Eigenschaft von Künstlern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54e297e-e7bd-4075-ab83-500e2c8dc0e2",
                                "sense_id": "4abfd7c1-baff-3909-95cb-3aebac74f562",
                                "text": "Dieser Pianist zeichnet sich durch eine außerordentliche Virtuosität aus."
                            },
                            {
                                "example_id": "241d5377-4e9a-4dde-809d-c5b38c0cbdfc",
                                "sense_id": "4abfd7c1-baff-3909-95cb-3aebac74f562",
                                "text": "„Das Ganze ist elegant erzählt, passagenweise auch witzig, man merkt aber die Routine und das Fehlen eines Stoffes, der der formalen Virtuosität noch inhaltlichen Witz hizugibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
