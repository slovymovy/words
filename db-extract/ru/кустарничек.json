                    {
                        "translation_id": "0d498aaf-30fc-4e90-b49a-400b03bda595",
                        "source_entry_id": "d279513c-a896-3598-90cf-128a9943a2a1",
                        "source_sense_description": "заросли кустов",
                        "target_lang_word": "Gebüsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebüsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e582f69e-8c11-327b-a8db-b18457300a0d",
                                        "entry_id": "a53b1cbc-7ec3-3b5f-9ae2-640b1b98f405",
                                        "glosses": [
                                            "ein einzelner oder eine Ansammlung von Büschen, kleinen Bäumen, ein kleines Gehölz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a41b7d-8336-4707-bbb3-2b9acaa9fa92",
                                                "sense_id": "e582f69e-8c11-327b-a8db-b18457300a0d",
                                                "text": "Ich duckte mich hinter ein Gebüsch."
                                            },
                                            {
                                                "example_id": "bd8dee10-0a1d-4e0d-a8e4-3e74bcacda48",
                                                "sense_id": "e582f69e-8c11-327b-a8db-b18457300a0d",
                                                "text": "„Ich band mein Pferd fest, kletterte auf die Mauer und ließ mich auf der anderen Seite in ein Gebüsch gleiten.“"
                                            },
                                            {
                                                "example_id": "44c75238-7922-4728-9ddf-0096fe361534",
                                                "sense_id": "e582f69e-8c11-327b-a8db-b18457300a0d",
                                                "text": "„Im Gebüsch verborgen beobachte ich, daß die Hühner für die Nacht in einem Stall eingeschlossen werden, der vom Wohnhaus aus kaum zu sehen ist, weil ein Geräteschuppen sich vor ihn schiebt.“"
                                            },
                                            {
                                                "example_id": "0cf26ee6-1a7a-4049-8a5b-ba22f0585be5",
                                                "sense_id": "e582f69e-8c11-327b-a8db-b18457300a0d",
                                                "text": "„Er suchte im Gebüsch, konnte aber niemand finden.“"
                                            },
                                            {
                                                "example_id": "f55635c2-f700-4b45-9bda-5cca55610c17",
                                                "sense_id": "e582f69e-8c11-327b-a8db-b18457300a0d",
                                                "text": "„Die drei Offiziere waren nun gegenüber einem Landhause angekommen, dessen hellbeleuchtete Fenster durch das Gebüsch herüberschimmerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
