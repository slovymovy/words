    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dae817f8-318b-3e4e-97c2-649e466d6fc7",
                "word": "slyboots",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8cbe5de4-576b-4c82-b8a7-66c41263d23d",
                        "entry_id": "dae817f8-318b-3e4e-97c2-649e466d6fc7",
                        "tags": [
                            "plural"
                        ],
                        "form": "slyboots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                        "entry_id": "dae817f8-318b-3e4e-97c2-649e466d6fc7",
                        "glosses": [
                            "A person who is clever or shrewd, especially one who is stealthy, manipulative, and rather charming."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "cff0e731-b32a-4ebf-b6da-f1a7c1fe7564",
                                "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                                "text": "But Truth is such a flyaway, such a slyboots, so untransportable and unbarrelable a commodity, that it is as bad to catch as light."
                            },
                            {
                                "example_id": "40ea6b73-9845-4ad1-b5eb-28efca3b176a",
                                "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                                "text": "\"Oh, you sly-boots!\" says the Countess. \"Guess you come after the old lady's money!\""
                            },
                            {
                                "example_id": "ff2a847a-1b90-4568-aacd-60069d8f1467",
                                "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                                "text": "You're such a slyboots, old cocky. I could kiss you."
                            },
                            {
                                "example_id": "5d75c50e-63d9-44ea-88a4-2e27474d78c0",
                                "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                                "text": "Peter: All we gotta do is tell a little white lie. Just go with it. [dials phone] Is this the Grant-a-Dream Foundation? My son Chris is dying!\nChris: Holy crap, no! Oh, my God!\nPeter: That was the lie.\nChris: Oh, you slyboots."
                            },
                            {
                                "example_id": "eaaccabc-16e7-4583-9b40-f9db3e8d9ac4",
                                "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                                "text": "This slyboots took me for a ton of money, made me do whatever she wanted."
                            },
                            {
                                "example_id": "bd66a5e2-4a80-4d76-beaa-db6e244dfb5c",
                                "sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                                "text": "Cruz was obviously analogizing Bernie Sanders to the Bolsheviks and Hillary Clinton to the Mensheviks. The oleaginous Texan is an erudite slyboots, but his history is off-kilter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65f81483-4559-4fe2-ba1f-bdc99663197e",
                        "source_entry_id": "dae817f8-318b-3e4e-97c2-649e466d6fc7",
                        "source_sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
                        "source_sense_description": "Translations",
                        "target_lang_word": "chattemite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chattemite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "580df0d8-2362-3a77-a8f8-d5ac50cc64c1",
                                        "entry_id": "e1083800-d67e-3e8f-8733-739ca878fe27",
                                        "glosses": [
                                            "Hypocrite qui affecte, pour tromper, un air doux, humble et flatteur."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99fe3b51-da37-421a-9a9d-5ea01bf85249",
                                                "sense_id": "580df0d8-2362-3a77-a8f8-d5ac50cc64c1",
                                                "text": "Un chat faisant la chattemite,\nUn saint homme de chat, bien fourré, gros et gras,\nArbitre expert sur tous les cas."
                                            },
                                            {
                                                "example_id": "56beeff5-9dcd-4344-b4c6-ab6de6ae1efb",
                                                "sense_id": "580df0d8-2362-3a77-a8f8-d5ac50cc64c1",
                                                "text": "Moi j’aurais honte à ta place ! — Continue, mon cher ami, ... Est-ce que tu crois qu’on ne te connaît pas, malgré ta mine de chattemite ?"
                                            },
                                            {
                                                "example_id": "5dbc22ce-d31d-42e6-93ab-d87434ac82cc",
                                                "sense_id": "580df0d8-2362-3a77-a8f8-d5ac50cc64c1",
                                                "text": "On s'aligne vite, on vous permet de sauver la face. Dès le lendemain Madame Mère allait s'aplliquer davantage à faire sa chattemite. Mais serait-ce vraiment de l'application?"
                                            },
                                            {
                                                "example_id": "19f41b3a-40e7-4be4-9b0e-1d1d9942b317",
                                                "sense_id": "580df0d8-2362-3a77-a8f8-d5ac50cc64c1",
                                                "text": "Sous son air de chattemite perçait quelque chose comme un brin de volupté sadique."
                                            },
                                            {
                                                "example_id": "00e9c20a-a7e0-45de-80b2-1c729fd6fb37",
                                                "sense_id": "580df0d8-2362-3a77-a8f8-d5ac50cc64c1",
                                                "text": "Elles lui répondaient toujours ; alors seulement, enveloppant comme une chattemite, il leur proposait un déjeuner dans un restaurant où l’on pouvait voir et être vu…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chattemite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6be102de-7b08-3854-af68-47eb4c341fd7",
                                        "entry_id": "b469d156-28cf-3004-84dc-158b13c7027f",
                                        "glosses": [
                                            "Qui relève d’une chattemite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b875e34-9dd7-4e36-a1f1-f42c26b34ddd",
                                                "sense_id": "6be102de-7b08-3854-af68-47eb4c341fd7",
                                                "text": "Elle se répétait avec délices « c’est ... La voix avait une inflexion fausse et chattemite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffb5f3be-c18f-41cb-89e1-4411536c1a62",
                        "source_entry_id": "dae817f8-318b-3e4e-97c2-649e466d6fc7",
                        "source_sense_id": "81212b30-28f6-32f6-9251-a94255d8d5e4",
