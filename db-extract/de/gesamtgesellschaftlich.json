                "senses": [
                    {
                        "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                        "entry_id": "7419145c-7261-39e2-bd03-570be777c674",
                        "glosses": [
                            "eine Gesellschaft als Ganzes betreffend oder beeinflussend (und nicht nur einzelne Gruppen oder Personen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9061c953-054a-4881-812c-7f15cb7079a3",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Das \"Kirchenmanifest\" appelliert an die gesamtgesellschaftliche Verantwortung zum Kirchenerhalt.“"
                            },
                            {
                                "example_id": "48e44d74-f815-458d-9add-0b53e6040f6f",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "Das Lernen des Lesens, Schreibens, Rechnens im frühen Kindesalter ist ein gesamtgesellschaftliches Anliegen."
                            },
                            {
                                "example_id": "80bd6eee-5557-483e-af1a-aa602cf90579",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Einsamkeit ist ein gesamtgesellschaftliches Phänomen.“"
                            },
                            {
                                "example_id": "ca3b6b8c-df30-437c-baa9-071f087fcbce",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Sie fordern, die gesamtgesellschaftliche Aufgabe „Anrechnung von Kindern in der Rente“ müsse auch gesamtgesellschaftlich getragen, also aus dem Steueraufkommen finanziert werden und dürfe nicht aus Rentenbeiträgen geleistet werden.“"
                            },
                            {
                                "example_id": "59cb8a65-a9d9-463d-af8f-9dc3d03b0315",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Zusätzlich erhält der Fonds Steuermittel zur Finanzierung gesamtgesellschaftlicher Aufgaben wie z. B. der beitragsfreien Mitversicherung von Kindern.“"
                            },
                            {
                                "example_id": "a79a64cf-3867-4ac1-8e69-7d870c5c08c8",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Für ihn ist klar: Der Kampf gegen Antisemitismus muss als gesamtgesellschaftliche Aufgabe betrachtet werden.“"
                            },
                            {
                                "example_id": "187a8125-2024-46bd-a4ee-1f571e992a2e",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„»Wir brauchen eine gesamtgesellschaftliche Lösung und das heißt, die Gründe dafür anzugehen, warum Menschen die AfD wählen. […]«“"
                            },
                            {
                                "example_id": "3e2b8d1e-d66c-4379-a8b0-40bf1c6234bf",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„»Die Klimakrise braucht gesamtgesellschaftliche Lösungen […]«, sagte Sprecherin Annika Rittmann der Nachrichtenagentur dpa.“"
                            },
                            {
                                "example_id": "aa6cd412-62d0-468d-832b-556efd824076",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Zu den gesamtgesellschaftlichen Auswirkungen der COVID-19-Pandemie gehörte auch die Wirtschaftskrise 2020–2021.“"
                            },
                            {
                                "example_id": "1e0d3bd6-d2ff-4f1a-bacd-0ac69e837044",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Das zentrale Argument, mit dem sie die negativen gesamtgesellschaftlichen Folgen hoher Ungleichheit begründen: Ungleichheit erzeugt Stress.“"
                            },
                            {
                                "example_id": "34dffe45-7806-4f84-a0bf-4e9acd1eaeea",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Die vielbeachtete Studie „Gleichheit ist Glück“ (engl. The spirit level) aus dem Jahr 2009 der britischen Gesundheitswissenschaftler:innen [sic] Richard Wilkinson und Kate Pickett weist für eine Vielzahl von gesamtgesellschaftlichen Indikatoren durchgängig nach, dass höhere Ungleichheit negative Folgen hat: In ungleichen Gesellschaften ist die Gesundheit der Menschen schlechter, das soziale Vertrauen sinkt, die politische Beteiligung ist geringer, die Demokratie instabiler, die Kriminalität höher, die soziale Mobilität (Aufstiegschancen) geringer.“"
                            },
                            {
                                "example_id": "e6490bd9-4cf3-46a2-b437-4e290df3f0df",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "„Es setzte mit den folgenden Preußischen Reformen ein umfassender gesamtgesellschaftlicher Modernisierungsprozess in Gesamtpreußen ein, von dem Brandenburg umfasst wurde.“"
                            },
                            {
                                "example_id": "37dc8b72-6590-4237-9a60-dcbb15debddc",
                                "sense_id": "e3b9bb72-f15d-3039-8e8e-32e93abb74f1",
                                "text": "[Coronapandemie 2021:] „Der Virologe Christian Drosten rechnet fest damit, dass im Herbst wieder gesamtgesellschaftliche Kontaktbeschränkungen nötig werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
