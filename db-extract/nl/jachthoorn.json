                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunting horn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01bc1324-2833-316e-a5e4-ec879d2cea8d",
                                        "entry_id": "77a7a54b-4d76-3425-92b4-4295ff624feb",
                                        "glosses": [
                                            "A bugle, being either simply curved (especially in heraldry), or having from one (in e.g. some Roman horns) to three (in many modern musical horns) spirals, on which signals are blown during a hunt."
                                        ],
                                        "tags": [],
