                                "target_lang_sense_clarification": "形容词"
                            },
                            {
                                "target_lang_word": "漆黑的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "negro azabache",
                                "target_lang_sense_clarification": "color muy oscuro"
                            },
                            {
                                "target_lang_word": "negro brillante",
                                "target_lang_sense_clarification": "referido a cabello o pelaje"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc0701a6-d514-3fcd-8fde-c925d148a385",
                    "sense_definition": "To eat something with great hunger and greed; to devour.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plunder_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The starving wolves began to <w>raven</w> the meat as soon as it was thrown to them.",
                            "target_lang_translations": {
                                "ru": "Голодающие волки начали <w>пожирать</w> мясо, как только его им бросили.",
                                "zh": "饥饿的狼群一拿到肉就开始<w>狼吞虎咽</w>地吃起来。",
                                "es": "Los lobos hambrientos comenzaron a <w>devorar</w> la carne tan pronto como se la lanzaron."
                            }
                        },
                        {
                            "text": "In the novel, the monster exists only to <w>raven</w> and destroy everything in its path.",
                            "target_lang_translations": {
                                "ru": "В романе монстр существует только для того, чтобы <w>пожирать</w> и уничтожать все на своем пути.",
                                "zh": "在小说中，怪物存在的目的就是<w>吞噬</w>并摧毁它路径上的一切。",
                                "es": "En la novela, el monstruo existe solo para <w>devorar</w> y destruir todo a su paso."
                            }
                        }
                    ],
                    "synonyms": [
                        "devour",
                        "gorge",
                        "wolf down"
                    ],
                    "antonyms": [
                        "nibble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mostly found in literary or older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть что-то с сильным голодом и жадностью; пожирать.",
                        "zh": "极度饥饿且贪婪地进食；狼吞虎咽。",
                        "es": "Comer algo con mucha hambre y avidez; devorar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожирать",
                                "target_lang_sense_clarification": "жадно есть"
                            },
                            {
