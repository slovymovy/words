                "senses": [
                    {
                        "sense_id": "b9aaf25a-5f13-3268-be9e-38df5eeddc61",
                        "entry_id": "76c2bf97-5c5e-375a-ab81-b09b07dfdbfe",
                        "glosses": [
                            "устар. магазин, в котором продаётся в разлив виноградное вино"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20f363f7-4376-48ca-a8fc-70048817c73d",
                                "sense_id": "b9aaf25a-5f13-3268-be9e-38df5eeddc61",
                                "text": "Накупил лучших папирос, апельсинов, шоколаду, зашел в грузинскую винницу, купил вина, влетел в кооператив, накупил всего прочего."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaabf70d-32c8-3d32-839e-7ed293430036",
                        "entry_id": "76c2bf97-5c5e-375a-ab81-b09b07dfdbfe",
                        "glosses": [
                            "устар. винокуренный завод"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1f1072-e2fa-42ba-ad2a-41a3c7e86dfd",
                                "sense_id": "eaabf70d-32c8-3d32-839e-7ed293430036",
                                "text": "Теперешний пан хочет строить на том месте винницу и прислал нарочно для того сюда винокура…"
                            }
                        ]
                    }
                ],
