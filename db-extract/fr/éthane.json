            {
                "entry_id": "713673c6-96f8-3360-83c1-c30d89c575c7",
                "word": "éthane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b759d752-e2bb-47d3-85b2-bd9fea1b070a",
                        "entry_id": "713673c6-96f8-3360-83c1-c30d89c575c7",
                        "tags": [
                            "plural"
