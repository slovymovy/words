                    {
                        "translation_id": "beb49ba0-cfd3-4a07-87fb-20dfb18c0fd3",
                        "source_entry_id": "e48c119c-b1c3-3704-8c0c-a5da7cbcce93",
                        "source_sense_id": "ed399f38-ed9f-38d6-aab2-b7fc362e15c5",
                        "target_lang_word": "понятно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "понятно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf06a03-4954-3294-8968-3f1a727ca763",
                                        "entry_id": "940af680-2484-3e99-96a7-f47e6db70231",
                                        "glosses": [
                                            "наречие к понятный; доступно пониманию"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "715615e3-dda5-4e6c-992f-e47fd55801e6",
                                                "sense_id": "3cf06a03-4954-3294-8968-3f1a727ca763",
                                                "text": "Теперь всё было понятно: если ревдинский караван пробежал, так нам уж не статья была сидеть у моря и ждать погоды."
                                            },
                                            {
                                                "example_id": "dfc3f56b-5ef6-425e-bc45-245278671c02",
                                                "sense_id": "3cf06a03-4954-3294-8968-3f1a727ca763",
                                                "text": "Тишина, только тишина и безлюдье — вот что нужно было ему для того, чтобы все самые слабые и спутанные голоса внутреннего мира зазвучали понятно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f0e7c0-75bc-3e66-ab0f-89920e3ee8ab",
                                        "entry_id": "940af680-2484-3e99-96a7-f47e6db70231",
                                        "glosses": [
                                            "безл., предик. оценка какой-либо ситуации, чьих-либо действий как являющихся ясными, доступными для понимания; ясно, очевидно"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "понятно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb0d8816-2e75-333c-8c74-d70d17fff572",
                                        "entry_id": "b07cce37-ba4a-3eee-88de-924e562be494",
                                        "glosses": [
                                            "разг. употребляется при выражении согласия, подтверждения, утверждения; соответствует по значению словам: так, конечно"
                                        ],
                                        "tags": [
                                            "частица"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7baed3f-0ebe-43ed-9518-2b624dac15be",
                                                "sense_id": "eb0d8816-2e75-333c-8c74-d70d17fff572",
                                                "text": "«Вам ни о чём не придётся заботиться, вас доставят куда нужно, и вам не причинят никакого беспокойства. Понятно?» Маргарита помолчала, потом ответила: «Понятно»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bae48c6-2ae4-3a19-a5e7-bc703bfa3847",
                                        "entry_id": "b07cce37-ba4a-3eee-88de-924e562be494",
                                        "glosses": [
                                            "вводн. сл. употребляется как вводное слово, соответствуя по значению словам: естественно, конечно, разумеется"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c4b355-1ae0-4d7c-9c5b-7ad776674780",
                                                "sense_id": "3bae48c6-2ae4-3a19-a5e7-bc703bfa3847",
                                                "text": "Понятно, что никто не молил, не просил, все прекрасно знали, что легче тронуть заштукатуренный камень капитальной стены, чем сердце Саенки."
                                            },
                                            {
                                                "example_id": "13bc665d-9e46-4ce5-879c-e27d485705df",
                                                "sense_id": "3bae48c6-2ae4-3a19-a5e7-bc703bfa3847",
                                                "text": "За окном пролетали вороны. Жене, понятно, тотчас захотелось узнать совершенно точно, сколько ворон — семь или восемь?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
