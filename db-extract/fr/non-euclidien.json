                "senses": [
                    {
                        "sense_id": "df729696-2a29-3073-a15c-974326719102",
                        "entry_id": "dac166a9-42fc-3078-ab42-c625cad7b582",
                        "glosses": [
                            "Se dit des branches de la géométrie qui invalident le cinquième postulat d’Euclide selon lequel, par un point extérieur à une droite, il passe toujours une parallèle à cette droite, et une seule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c99d9f-227d-4bc2-acec-d854717626fa",
                                "sense_id": "df729696-2a29-3073-a15c-974326719102",
                                "text": "La conception des mathématiques est mise en cause par la découverte de l’existence des systèmes non-euclidiens."
                            },
                            {
                                "example_id": "75d151b9-1f0d-4bbf-ae5e-56e98ab3b302",
                                "sense_id": "df729696-2a29-3073-a15c-974326719102",
                                "text": "Il développe également ses théories d’avant-garde en mathématiques ; il faudra attendre le XIXᵉ siècle pour que les chercheurs européens reconnaissent en lui un génial précurseur des géométries non euclidiennes."
                            }
                        ]
                    }
                ],
