                    {
                        "translation_id": "bb03ceed-ab24-4a94-9f41-2dd6b06280fa",
                        "source_entry_id": "790fb288-e104-325e-a926-d0774f0ca117",
                        "source_sense_id": "085c5b50-429a-32e1-a3a9-6f7038535cf9",
                        "target_lang_word": "зад",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зад",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "053c9300-3049-3674-b899-39231ee8bb3e",
                                        "entry_id": "e14ae17d-c9db-391e-b000-61587031fcdc",
                                        "glosses": [
                                            "сторона или часть чего-либо, противоположная передней стороне, той, что соответствует направлению взгляда от объекта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f23dda4-2211-41d6-b91e-3402373ec0f0",
                                                "sense_id": "053c9300-3049-3674-b899-39231ee8bb3e",
                                                "text": "Впереди из дымчатой гари сплошь краснели огни автомобильных задов, как давленые спелые помидоры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb1db0cf-2ebc-3ce6-bced-1050e1615ff6",
                                        "entry_id": "e14ae17d-c9db-391e-b000-61587031fcdc",
                                        "glosses": [
                                            "разг. задняя часть туловища, задница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2398f942-6a58-4150-98c4-b3323a577abb",
                                                "sense_id": "cb1db0cf-2ebc-3ce6-bced-1050e1615ff6",
                                                "text": "У него жутко толстый зад."
                                            },
                                            {
                                                "example_id": "cad048f7-7358-40a1-ac74-15eb8704aafe",
                                                "sense_id": "cb1db0cf-2ebc-3ce6-bced-1050e1615ff6",
                                                "text": "Один раз даже его лошадь вздумала бить задом, но и это не останавливало честолюбцев."
                                            },
                                            {
                                                "example_id": "5e91864b-ff13-4384-8971-1166eba7212f",
                                                "sense_id": "cb1db0cf-2ebc-3ce6-bced-1050e1615ff6",
                                                "text": "На заду паренька на выцветших джинсах красовался сверкающий знак «Серп и Молот»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7dd00d3-7d41-3ffe-84c7-846c8c5a0a79",
                                        "entry_id": "e14ae17d-c9db-391e-b000-61587031fcdc",
                                        "glosses": [
                                            "задворки, непарадная часть какого-либо сооружения"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf16bfc-1195-444c-9fcc-c9cb04fb685d",
                                                "sense_id": "f7dd00d3-7d41-3ffe-84c7-846c8c5a0a79",
                                                "text": "Латники ворвались на необороненные зады замка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72471279-5ed8-3bf9-8d01-8ea8e79fe7ba",
                                        "entry_id": "e14ae17d-c9db-391e-b000-61587031fcdc",
                                        "glosses": [
                                            "устар., перен. давно выученное, пройденное"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206b009a-d9c5-46e3-bbff-ec6b9e41859b",
                                                "sense_id": "72471279-5ed8-3bf9-8d01-8ea8e79fe7ba",
                                                "text": "Бедный Обломов то повторял зады, то бросался в книжные лавки за новыми увражами и иногда целую ночь не спал, рылся, читал, чтоб утром, будто нечаянно, отвечать на вчерашний вопрос знанием, вынутым из архива памяти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33cda1a2-985e-433a-966c-457e673aae09",
                        "source_entry_id": "790fb288-e104-325e-a926-d0774f0ca117",
                        "source_sense_id": "b16e0f10-1da7-3e90-a839-ea700c7f9bf5",
                        "target_lang_word": "задница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "задница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ac7e762-8927-30a4-8a36-242d8d977178",
                                        "entry_id": "bfbcb6d7-b7da-3c3c-a40f-cc20fce8b6d4",
                                        "glosses": [
                                            "разг. ягодицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3872173-a94f-4adf-8ece-f072e0a23a23",
                                                "sense_id": "1ac7e762-8927-30a4-8a36-242d8d977178",
                                                "text": "Сидеть на кафельном полу было холодно — задница у меня замёрзла."
                                            },
                                            {
                                                "example_id": "d816ac70-1f38-4a53-b6dc-0215663f7630",
                                                "sense_id": "1ac7e762-8927-30a4-8a36-242d8d977178",
                                                "text": "Эд смотрит вслед подруге, размахивающей туфлями и сумкой, и думает, какая все же большая у подруги задница."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b599f2a-f88f-35f4-b5a3-ca08da01fba9",
                                        "entry_id": "bfbcb6d7-b7da-3c3c-a40f-cc20fce8b6d4",
                                        "glosses": [
                                            "перен. плохой, аморальный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ef0b37-1e17-49ce-9f02-6bd9f2e95666",
                                                "sense_id": "6b599f2a-f88f-35f4-b5a3-ca08da01fba9",
                                                "text": "Меркин вышел. Вот старая задница!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4f4be21-ebe0-300c-817b-72b2e9bc895a",
                                        "entry_id": "bfbcb6d7-b7da-3c3c-a40f-cc20fce8b6d4",
                                        "glosses": [
                                            "перен. неприятная ситуация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6384552d-c4ab-438a-83ce-5f38e2d4399c",
                                                "sense_id": "b4f4be21-ebe0-300c-817b-72b2e9bc895a",
                                                "text": "И тут от вас шило — на аукционе-то, оказывается, полная задница."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
