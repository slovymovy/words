        "fr-extract.jsonl": [
            {
                "entry_id": "3f01d0ee-40c5-3c1f-8216-accf8f1fb857",
                "word": "lessivable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7316269c-5fe2-48ab-b3c2-24b069268487",
                        "entry_id": "3f01d0ee-40c5-3c1f-8216-accf8f1fb857",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "lessivables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bccec12a-1a66-3182-9bbd-fd2d1badd26d",
                        "entry_id": "3f01d0ee-40c5-3c1f-8216-accf8f1fb857",
                        "glosses": [
                            "Que l’on peut lessiver sans risque de détérioration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1a2ab8-0c59-476d-8db1-97ee6b5fcd04",
                                "sense_id": "bccec12a-1a66-3182-9bbd-fd2d1badd26d",
                                "text": "Les matériaux doivent être imperméables, incombustibles, lessivables ; ils doivent se prêter facilement à la désinfection."
                            },
                            {
                                "example_id": "1cad3a0b-5859-465c-884f-59459745f4e1",
                                "sense_id": "bccec12a-1a66-3182-9bbd-fd2d1badd26d",
                                "text": "Des lavandières y étaient installées à demeure et ne devaient pas en sortir. Munies de tous les ustensiles de leur profession, recevant nourriture et salaire, elles avaient la charge d’approprier tout ce qui était lessivable des hardes ayant appartenu à des pestiférés."
                            },
                            {
                                "example_id": "a608de49-4226-4b93-be21-87d91aceaee4",
                                "sense_id": "bccec12a-1a66-3182-9bbd-fd2d1badd26d",
                                "text": "En revanche, la mention lessivable (ou mieux encore lessivable et brossable) signifie que le revêtement est fait d’une matière plus solide que vous pouvez nettoyer plus souvent."
                            }
                        ]
                    },
                    {
                        "sense_id": "24bf0b32-c705-373c-a21e-8de9e1af1bd3",
                        "entry_id": "3f01d0ee-40c5-3c1f-8216-accf8f1fb857",
                        "glosses": [
                            "Qui peut être dissous et entraîné par l’eau lors de rinçages ou de pluies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d79625-1fb5-41f5-bdd7-5994a961c9ac",
                                "sense_id": "24bf0b32-c705-373c-a21e-8de9e1af1bd3",
                                "text": "De ces essais, on peut conclure que la roche saine contient environ 20 % d’uranium facilement lessivable, et 80 % d’uranium dit « fixé » réparti entre l’uraninite (environ 50 %) et les minéraux accessoires transparents (environ 30 %), essentiellement la monazite et le zircon."
                            },
                            {
                                "example_id": "6b6ecbed-a79c-4798-9e96-24f792cb8e2b",
                                "sense_id": "24bf0b32-c705-373c-a21e-8de9e1af1bd3",
                                "text": "Facilement lessivable, elle [= l’atrazine] s’accumule de façon importante dans les nappes phréatiques et risque pour cette raison d’être retirée du marché."
                            },
                            {
                                "example_id": "a725fdba-1242-4cf8-afce-d6f2f03d5d6b",
                                "sense_id": "24bf0b32-c705-373c-a21e-8de9e1af1bd3",
                                "text": "… le mâchefer lui-même fait l’objet de soupçons comme matériau de terrassement (risque de présence de métaux lourds lessivables)."
                            }
                        ]
                    }
                ],
                "translations": [
