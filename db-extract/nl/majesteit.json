                    {
                        "sense_id": "dd27d005-c13b-3cd0-8f58-7be12a1032ce",
                        "entry_id": "05b581ca-f37b-3098-8e2f-696ba643dbbd",
                        "glosses": [
                            "monarch, king, queen"
