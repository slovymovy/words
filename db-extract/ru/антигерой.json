                        "sense_id": "8995f9ef-ff10-3e4d-9ded-a84b68bfb3e4",
                        "entry_id": "9d860073-934d-3bd3-b20f-ab989033dd13",
                        "glosses": [
                            "персонаж, лишённый героических черт, но несмотря на это занимающий центральное место в произведении"
                        ],
                        "tags": [],
