                ],
                "senses": [
                    {
                        "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                        "entry_id": "c4eaa607-4e91-3a9a-b24e-3181a1060d2a",
                        "glosses": [
                            "Leitungssystem, in dem heißes Wasser gepumpt wird; meist um Gebäude, beispielsweise einer Stadt/eines Stadtteils, mit Wärme zu versorgen"
                        ],
                        "tags": [
                            "Energie"
                        ],
                        "examples": [
                            {
                                "example_id": "5383a761-d12c-4d82-ae4d-bd78e72b5de5",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "[Schlagzeile:] „Kreuzlingen und Konstanz wollen ein gemeinsames Wärmenetz“"
                            },
                            {
                                "example_id": "c24e6412-aa91-4f23-b7fc-e1a6f4180bdb",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Nach drei Bürgerversammlungen war fast allen klar: Es rechnet sich, ein eigenes Wärmenetz zu bauen.“"
                            },
                            {
                                "example_id": "4cd804f5-3485-4b59-8fff-c15159727933",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Schätzungsweise sechs Milliarden Euro soll Ausbau der Wärmenetze kosten, zwei Milliarden will das Land übernehmen.“"
                            },
                            {
                                "example_id": "1bb3b201-bb5c-4fd7-8cef-7b1614c27493",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Stand jetzt könnte sich Germering die Bohrungen und ein Wärmenetz selbst nicht leisten. Anlage und Netz würden – so die vorsichtige Annahme – rund 150 Millionen Euro kosten.“"
                            },
                            {
                                "example_id": "41e88462-29b8-4c1f-bbd3-15ff61560d40",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Im Haus von Dieter Portele schließt Peter Seelos die Heizung an das Wärmenetz der Gemeinde an. Viele Fuchstaler wollen ihre Öl- oder Gasheizung jetzt schnell abschaffen.“"
                            },
                            {
                                "example_id": "fc00dc11-4a93-4246-9927-3bca2dafaaff",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "[…] „im Vergleich zu Gas zahlt, wer hier ans Wärmenetz angeschlossen ist, im Monat etwa zwei Drittel weniger.“"
                            },
                            {
                                "example_id": "29fdf568-544c-437e-b252-432765fcb235",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Inzwischen sollen auch andere Gebäude der Stadt an dieses Wärmenetz angeschlossen werden. Nämlich die Pfarrkirche, das Pfarrheim, eine Turnhalle, Vereinsräume und das Feuerwehrhaus.“"
                            },
                            {
                                "example_id": "4d081a8e-ce55-4184-96d4-37fcf9f64b4e",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Der zuständige Staatsrat Antonio Hodgers sagt: «Es gibt ein Gesetz, das Gebäudebesitzer dazu verpflichten kann, sich an das künftige Wärmenetz anzuschliessen und das wird zu 80 Prozent aus erneuerbaren Energien bestehen.»“"
                            },
                            {
                                "example_id": "93ee3f6d-458c-453d-9985-478693da29ff",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Im Stadtrat erhofft er sich grünes Licht für das Projekt: ein eigenes Wärmenetz mit eigenen Großwärmepumpen, betrieben durch eigenen Strom aus eigenen Wind- und Solarparks.“"
                            },
                            {
                                "example_id": "ff1569b3-f681-44b6-aa1a-1669a3f7522a",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Die Versorgung mit Nahwärme erfolgt über ein Wärmenetz. Durch ein verzweigtes Leitungsnetz wird als Wärmespeicher und Transportmedium Wasser im Heizkreis gepumpt.“"
                            },
                            {
                                "example_id": "c60dfd85-0140-4b34-8a42-389a4cbad015",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Der Transport der thermischen Energie erfolgt in einem wärmegedämmten Rohrsystem, einem sogenannten Wärmenetz, das üblicherweise erdverlegt ist; teilweise werden jedoch auch Freileitungen verwendet.“"
                            },
                            {
                                "example_id": "4bc88ca0-2875-433a-8d2b-6051be6b4d15",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Eine Heizzentrale versorgt u.a. Schulen, Kindergarten, Sporthallen, Vereine und Kirche über ein eigenes Wärmenetz.“"
                            },
                            {
                                "example_id": "89360198-1a69-46ac-9557-ec7c11c836ff",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Wärmenetze gelten als optimale Lösung, wo große Wohnblocks oder Mehrfamilienhäuser dicht beieinanderliegen. Sie können auch in Wohngebieten dafür sorgen, dass nicht jeder Einzelne eine Wärmepumpe anschaffen muss.“"
                            },
                            {
                                "example_id": "ac14a82d-b0e4-4d7b-813a-413e764abdd4",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Der Nordhäuser Campus ist zwar klein, das Wärmenetz aber zweigeteilt. Der Nordcampus und Südcampus haben jeweils ein geschlossenes Heizsystem.“"
                            },
                            {
                                "example_id": "a56dd7df-cadd-4795-98cb-96a7e9ea7d28",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "[Fernwärme-Ausfall im Berliner Norden – Haushalte wieder mit Heizung und Warmwasser versorgt:] „Jekat betonte, dass ähnliche Druckverluste im Wärmenetz normalerweise nicht von den Kunden bemerkt werden würden, da in den Heizungssystemen von Wohnhäusern und in der Warmwasserversorgung noch ausreichend Restwärme vorhanden sei.“"
                            },
                            {
                                "example_id": "eabbadec-7cf7-457e-b9ca-c0bac12db04c",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„»In Wien gilt es sicher noch viel mehr Quellen ans Wärmenetz anzuschließen. Ich denke da vor allem an die Kühlung aus dem Gebäudebereich, aus Büros.« Die Klimaanlagen würden nämlich beim Abkühlen der Räume die umliegende Luft aufheizen.“"
                            },
                            {
                                "example_id": "7cc9a68c-66d0-44ab-8cce-081d90adede6",
                                "sense_id": "dfa3b7e1-7e91-36f5-ba4c-818f6b9c9a08",
                                "text": "„Ökologisch interessant sind kalte Wärmenetze, die mit Temperaturen von weniger als 25 °C arbeiten und sehr effizient sind, weil unterwegs nur wenig Wärme verloren geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
