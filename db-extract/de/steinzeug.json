                        "form": "das Steinzeug"
                    },
                    {
                        "form_id": "4ea4ee44-9ee6-48df-99aa-ee4b75db59cf",
                        "entry_id": "c51bf693-49e1-3560-b3c3-ca6b535f03a4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Steinzeuge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1caf81b-f557-341c-aae7-a85d352034d2",
                        "entry_id": "c51bf693-49e1-3560-b3c3-ca6b535f03a4",
                        "glosses": [
                            "gebrannte keramische Masse zur Herstellung von Gefäßen, Fliesen und anderen Produkten; dichter und höher gebrannt als Steingut, üblicherweise bis zur Sinterung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83bf185-3c28-4b07-9fd9-5d8a659eda3f",
                                "sense_id": "b1caf81b-f557-341c-aae7-a85d352034d2",
                                "text": "Steinzeug wird ebenso wie das noch höher gebrannte Porzellan auch als Sinterzeug bezeichnet."
                            },
                            {
                                "example_id": "8960364f-a804-4de3-9de5-b2e18f0d3e3d",
                                "sense_id": "b1caf81b-f557-341c-aae7-a85d352034d2",
                                "text": "Steinzeug wird traditionell in nicht weißbrennendes Grobsteinzeug und hell- oder weißbrennendes Feinsteinzeug unterteilt."
                            },
                            {
                                "example_id": "3e122b30-71fd-40df-a369-a1bf816d47bf",
                                "sense_id": "b1caf81b-f557-341c-aae7-a85d352034d2",
                                "text": "„Feinkeramische Fliesen aus Steinzeug und Steingut haben einen feinkörnigen, kristallinen Scherben, der aus trocken gepressten Rohlingen gebrannt wurde. Im Gegensatz zu Fliesen mit hoher Wasseraufnahme (STG und IG) haben Steinzeugfliesen einen dichten Scherben mit geringer Wasseraufnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1435ebe-319d-3a2d-a0c8-782dd12f7097",
                        "entry_id": "c51bf693-49e1-3560-b3c3-ca6b535f03a4",
                        "glosses": [
                            "Produkte aus Steinzeugmasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a90f7b-c0b7-4739-9d10-1b10074fb1af",
                                "sense_id": "a1435ebe-319d-3a2d-a0c8-782dd12f7097",
                                "text": "„Im Zuge der Rationalisierung der Herstellung von Steinzeug (Kanalisationsrohre, Behälter, Laborausgußbecken und dgl.) ging man auch dazu über, das Brennverfahren wirtschaftlicher zu gestalten.“"
                            },
                            {
                                "example_id": "f116dfc3-5da7-4948-bd4c-545fd5af1d50",
                                "sense_id": "a1435ebe-319d-3a2d-a0c8-782dd12f7097",
                                "text": "„Hier beherrscht der Import den Markt mit den vielfach auf bremische Bestellung gelieferten, mit dem Stadtwappen gezierten rheinischen Steinzeug oder den leuchtendroten, kräftig mit Kupfer- und Eisenoxydfarben bemalten Irdenwaren aus Wahnfried an der Werra.“"
                            },
                            {
                                "example_id": "e4c98301-7dcb-4173-a979-92db514227b5",
                                "sense_id": "a1435ebe-319d-3a2d-a0c8-782dd12f7097",
                                "text": "„Historisches Westerwälder Steinzeug in Afrika“ – so der genaue Titel – kehrte nach fast 300 Jahren wieder zurück an seinen Ursprungsort, in das Doppelstädtchen Höhr-Grenzhausen."
                            },
                            {
                                "example_id": "47b7209d-17b1-4489-931a-0552d781ebb5",
                                "sense_id": "a1435ebe-319d-3a2d-a0c8-782dd12f7097",
                                "text": "Vor allem im heutigen Ghana, an der Elfenbeinküste und in Zaire überlebte das glänzende Steinzeug dank seiner einmaligen Qualität alle Stammesfehden, Sklavenjagden und Kolonialkriege."
                            },
                            {
                                "example_id": "c114b9d4-3fe1-4ed8-879f-f87e2313ac1c",
                                "sense_id": "a1435ebe-319d-3a2d-a0c8-782dd12f7097",
                                "text": "„Nach dem Verschwinden des Gegensatzes zwischen Kannen-, Krug- und Krusebäckern mußte der werdende Meister im Westerwald 1775 einen rötlich-braunen Mineralwasserkrug, einfaches und künstliches Steinzeug und spitze Krüge als Meisterstück vorweisen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c055e34-805f-4c39-bf6b-fefd6c9d8f22",
                        "source_entry_id": "c51bf693-49e1-3560-b3c3-ca6b535f03a4",
