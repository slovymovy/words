                ],
                "senses": [
                    {
                        "sense_id": "71cdcc68-df00-35e9-afd5-ff976a1f78ca",
                        "entry_id": "7f1b53f2-9672-31b1-9d77-5a8a21b9bbc3",
                        "glosses": [
                            "een woord dat door een taal uit een andere taal overgenomen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3871f55c-3e5f-4b1f-8e55-df6e9a587d9b",
                                "sense_id": "71cdcc68-df00-35e9-afd5-ff976a1f78ca",
                                "text": "Het zelfstandige naamwoord download is een leenwoord uit het Engels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25fe625e-1ad7-49fe-abc0-9c7bd31646da",
                        "source_entry_id": "7f1b53f2-9672-31b1-9d77-5a8a21b9bbc3",
                        "source_sense_id": "71cdcc68-df00-35e9-afd5-ff976a1f78ca",
                        "source_sense_description": "een woord dat door een taal aan een andere taal ontleend is",
                        "target_lang_word": "Lehnwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehnwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                        "entry_id": "463e7cc1-8d6f-3c63-b6cf-20bfe2c9688c",
                                        "glosses": [
                                            "Wort, das aus einer anderen Sprache übernommen wurde und an die aufnehmende Sprache lautlich, orthographisch und/oder grammatisch mehr oder weniger angepasst wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd7e53f-e6f7-47f1-9ccc-38ccd254d335",
                                                "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                                "text": "Lehnwörter im Deutschen sind u. a. „Bluse, Fenster, schick, Streik, Wein“."
                                            },
                                            {
                                                "example_id": "88dd2de1-e927-405d-b817-f37fed39ee5b",
                                                "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                                "text": "„Sprachwissenschaftler unterscheiden nach der geschichtlichen Herkunft der Lautgestalt eines Wortes zwischen Erbwort (z.B. Haus), Fremdwort (z.B. Idee) und Lehnwort (z.B. Fenster). Erbwörter wurden in der Abstammungslinie vom Indogermanischen über das Germanische, Althochdeutsche, Mittelhochdeutsche und Neuhochdeutsche irgendwann gebildet und bis heute überliefert…“"
                                            },
                                            {
                                                "example_id": "87361ddb-718b-4f59-b975-6fb1f7cc3781",
                                                "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                                "text": "„Da Integration graduell verläuft, ist die Abgrenzung zwischen Lehnwort und Fremdwort häufig schwierig oder unmöglich.“"
                                            },
                                            {
                                                "example_id": "7a218049-8824-4141-a46f-5620efffe0c7",
                                                "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                                "text": "„Doch oft werden Fremd- und Lehnwörter als Eindringlinge gesehen und aus einem puristischen Blickwinkel mit Skepsis betrachtet.“"
                                            },
                                            {
                                                "example_id": "af9f37a3-375b-488d-b64c-ea09f216be50",
                                                "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                                "text": "„Ein Lehnwort wird in Schrift und Aussprache in der fremden Sprache übernommen; beim Xenogramm wird zwar das fremde Wort geschrieben, aber ein Wort der eigenen Sprache dafür gesprochen. Wenn ein Perser malcan malca las, sprach er ›šahinša‹. “"
                                            },
                                            {
                                                "example_id": "e53927f4-d950-4f72-9362-1e9dd33e3d01",
                                                "sense_id": "c218fe34-4417-3205-9267-1c6e9384ae71",
                                                "text": "„Und ein zweiter, etwas ausführlicherer Blick macht schnell deutlich, dass es mit polnischen Lehnwörtern selbst im Ruhrgebiet nicht weit her ist, dass viele der so beliebten rheinischen Französismen gar keine sind und italienische Spuren gerade einmal in Sprachspielereien wie in alles palletti, Aparillo oder picobello vorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "383f6e9d-79a0-496d-a800-e5db0d856070",
                        "source_entry_id": "7f1b53f2-9672-31b1-9d77-5a8a21b9bbc3",
                        "source_sense_id": "71cdcc68-df00-35e9-afd5-ff976a1f78ca",
                        "source_sense_description": "een woord dat door een taal aan een andere taal ontleend is",
                        "target_lang_word": "loanword",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loanword",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f41e963-aadf-388d-a506-cd53b62335f1",
                                        "entry_id": "0bf9b539-7572-32b4-a79f-0fa39ec552db",
                                        "glosses": [
                                            "A word directly taken into one language from another one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38353b39-6f6d-4cf3-a46d-2fa14d3b515e",
                                                "sense_id": "9f41e963-aadf-388d-a506-cd53b62335f1",
                                                "text": "\"Calque\" is a loanword with French origins, and \"loanword\" is a calque with German origins."
                                            },
                                            {
                                                "example_id": "85db7944-e95e-4fa8-9f3e-0aaed3d3e5c3",
                                                "sense_id": "9f41e963-aadf-388d-a506-cd53b62335f1",
                                                "text": "New words, and particularly loanwords, are simplified, and hence naturalized in American much more quickly than in English. Employé has long since become employee in our newspapers, and asphalte has lost its final e, and manœuvre has become maneuver, and pyjamas has become pajamas."
                                            },
                                            {
                                                "example_id": "3f10998a-36f6-422b-b304-f4e96a3e4a20",
                                                "sense_id": "9f41e963-aadf-388d-a506-cd53b62335f1",
                                                "text": "This searching was facilitated by the author's knowledge of the vagaries of Anglo-Indian spelling and the numerous colonial-era transliteration systems used for loanwords from Indian languages."
                                            },
                                            {
                                                "example_id": "4ef88fc5-708d-4626-bebe-81918f68eb28",
                                                "sense_id": "9f41e963-aadf-388d-a506-cd53b62335f1",
                                                "text": "Indeed, in 1957 Xenophon Zolotas, the then governor of the Bank of Greece, gave two speeches to the IMF that contained just Greek loanwords apart from the inevitable basic English. (Example: “Our policies should be based more on economic and less on political criteria.”)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b53d4bea-d3ec-4de5-8406-4a11eef8c0ce",
                        "source_entry_id": "7f1b53f2-9672-31b1-9d77-5a8a21b9bbc3",
                        "source_sense_id": "71cdcc68-df00-35e9-afd5-ff976a1f78ca",
                        "source_sense_description": "een woord dat door een taal aan een andere taal ontleend is",
                        "target_lang_word": "emprunt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emprunt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73193b96-ad11-3101-a42a-f684888e63cb",
                                        "entry_id": "70d65fb5-e20e-3941-8e7f-e9821a6b3f3f",
                                        "glosses": [
                                            "Action ou chose qu'on emprunte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35123655-d353-4931-92cb-a8d255c9a724",
                                                "sense_id": "73193b96-ad11-3101-a42a-f684888e63cb",
                                                "text": "Un emprunt à la bibliothèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f099078-0437-3921-9799-c5b30b825906",
                                        "entry_id": "70d65fb5-e20e-3941-8e7f-e9821a6b3f3f",
                                        "glosses": [
                                            "Euphémisme, en parlant de vol, de plagiat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fea6bd-1d87-41e6-b969-b8b24dc5308f",
                                                "sense_id": "3f099078-0437-3921-9799-c5b30b825906",
                                                "text": "Cet auteur a soin de cacher ses emprunts."
                                            },
                                            {
                                                "example_id": "3e6b38b7-c918-43fb-be46-e7f66fb9046a",
                                                "sense_id": "3f099078-0437-3921-9799-c5b30b825906",
                                                "text": "– C’est pour vous dire que livre de Tourny comporte quelques emprunts. Il a quelquefois oublié les guillemets, mais son précis fait cependant autorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cd057b1-2b58-3148-8678-32605b41b6d5",
                                        "entry_id": "70d65fb5-e20e-3941-8e7f-e9821a6b3f3f",
                                        "glosses": [
                                            "Capitaux empruntés par un particulier, un État, une société financière."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab547698-bb97-4adf-a54a-d356333cb129",
                                                "sense_id": "9cd057b1-2b58-3148-8678-32605b41b6d5",
                                                "text": "Faire un emprunt à la caisse d'épargne."
                                            },
                                            {
                                                "example_id": "3449126f-7b93-40d5-a91a-ba17bc3983e0",
                                                "sense_id": "9cd057b1-2b58-3148-8678-32605b41b6d5",
                                                "text": "La vie laborieuse, active, toute estimable, toute positive, d’un conseiller d’État, d’un manufacturier de tissus de coton ou d’un banquier fort alerte pour les emprunts, est récompensée par des millions, et non par des sensations tendres."
                                            },
                                            {
                                                "example_id": "646a92bd-751c-4517-afd1-4e44f9f1c0ad",
                                                "sense_id": "9cd057b1-2b58-3148-8678-32605b41b6d5",
                                                "text": "Mon oncle faisait le bilan des sacrifices de son passé. Ça n’était pas sa faute s’il avait été ruiné dans l’affaire de l’emprunt russe et si les actions des tramways de Shanghai ne valaient presque plus rien."
                                            },
                                            {
                                                "example_id": "7314b972-f628-4ba9-a441-2b8f8a9ea151",
                                                "sense_id": "9cd057b1-2b58-3148-8678-32605b41b6d5",
                                                "text": "Nous avons, aux articles de la capacité des parties contractantes, rapporté un arrêt qui a déclaré un ex-maire personnellement responsable d’un emprunt qu’il avait fait en cette qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee119f9-c082-39e1-a75c-029b90553ceb",
                                        "entry_id": "70d65fb5-e20e-3941-8e7f-e9821a6b3f3f",
                                        "glosses": [
                                            "Caractérise une chose artificielle, forcée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e961fdc9-2e86-4ee9-ba5e-181e4c8466cc",
                                                "sense_id": "fee119f9-c082-39e1-a75c-029b90553ceb",
                                                "text": "Beauté d’emprunt, sourire d’emprunt, vertus d’emprunt, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e891586-67cc-3e81-87be-be5bb7ac9e80",
                                        "entry_id": "70d65fb5-e20e-3941-8e7f-e9821a6b3f3f",
                                        "glosses": [
                                            "Mot rapporté d’une langue à une autre ; emprunt lexical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a30862-b55c-4d49-bd67-ed43a578dfa2",
                                                "sense_id": "8e891586-67cc-3e81-87be-be5bb7ac9e80",
                                                "text": "Contrairement à une idée reçue, les apports africains sont négligeables. Par contre les emprunts – aux langues caraïbes, au malgache, au portugais selon les cas - sont plus importants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
