                    }
                ],
                "senses": [
                    {
                        "sense_id": "725491c3-9e52-31b1-9a4c-4416692a7fbb",
                        "entry_id": "fd374194-bee4-369f-95ed-8dcfe0d3c78d",
                        "glosses": [
                            "waanzinnigheid, acuut psychische stoornis ten gevolge van lichamelijke aandoening, vergiftiging of onthouding van middelen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec7758f1-e06a-4f9f-94f8-a8f51d731bb2",
                        "source_entry_id": "fd374194-bee4-369f-95ed-8dcfe0d3c78d",
                        "source_sense_id": "725491c3-9e52-31b1-9a4c-4416692a7fbb",
                        "source_sense_description": "waanzinnigheid, acuut psychische stoornis ten gevolge van lichamelijke aandoening, vergiftiging...",
                        "target_lang_word": "Delirium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Delirium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "379b83ba-ea26-32b3-bdad-0f0f774922b5",
                                        "entry_id": "0e25c366-2b82-3676-baa1-c4e67cb3b4f9",
                                        "glosses": [
                                            "Geisteszustand mit gestörter Sinneswahrnehmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca547b23-f3b0-4225-8810-56bf77f2bf01",
                                                "sense_id": "379b83ba-ea26-32b3-bdad-0f0f774922b5",
                                                "text": "„In der vergangenen Stunde hatte er zwischen Bewußtlosigkeit und Delirium geschwebt, und jetzt war er sehr müde und erschöpft.“"
                                            },
                                            {
                                                "example_id": "1197a1a5-63b0-41ee-9c7d-cb7b4cbbb1c8",
                                                "sense_id": "379b83ba-ea26-32b3-bdad-0f0f774922b5",
                                                "text": "„Ich schrieb ihr hintereinander drei Briefe, jeden an einem anderen Ort, da ich in einem wahren Delirium umherirrte.“"
                                            },
                                            {
                                                "example_id": "30144c6c-8e07-4120-a355-a41974d15d0a",
                                                "sense_id": "379b83ba-ea26-32b3-bdad-0f0f774922b5",
                                                "text": "„In ihrem Delirium sprach sie griechische und lateinische Wörter, und nun zweifelte niemand mehr an der Art ihrer Krankheit.“"
                                            },
                                            {
                                                "example_id": "898ed7c3-31d4-45e5-aa74-209dc46aa9da",
                                                "sense_id": "379b83ba-ea26-32b3-bdad-0f0f774922b5",
                                                "text": "„Er hatte die Besinnung verloren und schien in eine Art Delirium verfallen zu sein.“"
                                            },
                                            {
                                                "example_id": "a64c7183-2ea8-4f41-b061-c53c86adeb7f",
                                                "sense_id": "379b83ba-ea26-32b3-bdad-0f0f774922b5",
                                                "text": "„Der Hunger konnte einen zum Narren halte. Aber in seinem Gesicht zeigte sich kein Anzeichen von Delirium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bb5e7d1-b579-3006-885f-c97fa1644d12",
                                        "entry_id": "0e25c366-2b82-3676-baa1-c4e67cb3b4f9",
                                        "glosses": [
                                            "durch anhaltenden Alkoholmissbrauch verursachtes Delirium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959c8b46-0985-4d6e-9af6-d18948aefa96",
                                                "sense_id": "0bb5e7d1-b579-3006-885f-c97fa1644d12",
                                                "text": "Nach übermäßigem Alkoholkonsum lag er eine Weile im Delirium."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "867c2381-e6df-4eaf-802a-74f52e3c366a",
                        "source_entry_id": "fd374194-bee4-369f-95ed-8dcfe0d3c78d",
                        "source_sense_id": "725491c3-9e52-31b1-9a4c-4416692a7fbb",
                        "source_sense_description": "waanzinnigheid, acuut psychische stoornis ten gevolge van lichamelijke aandoening, vergiftiging...",
                        "target_lang_word": "delirium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delirium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6047f971-69b9-3786-924b-61e5736468b5",
                                        "entry_id": "8bb6a880-a7e2-3e4e-b606-f7463a7bce79",
                                        "glosses": [
                                            "A temporary mental state with a sudden onset, usually reversible, including symptoms of confusion, inability to concentrate, disorientation, anxiety, and sometimes hallucinations. Causes can include dehydration, drug intoxication, and severe infection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bcb7b17-70ab-4729-9059-9013badbaa9a",
                                                "sense_id": "6047f971-69b9-3786-924b-61e5736468b5",
                                                "text": "The popular delirium [of the French Revolution] at first caught his enthusiastic mind."
                                            },
                                            {
                                                "example_id": "280e1d80-60cb-4579-89b9-4f42d49ca8d9",
                                                "sense_id": "6047f971-69b9-3786-924b-61e5736468b5",
                                                "text": "Better to decay in absolute delirium, than to be the victim of the methodical unreason of ill-bestowed love."
                                            },
                                            {
                                                "example_id": "e9ff74eb-cb76-401b-a5c8-0cd6ed1c7e99",
                                                "sense_id": "6047f971-69b9-3786-924b-61e5736468b5",
                                                "text": "The evening wore away, and the long grass was silvery with dew; the consequence was what might have been expected,—next day, he was laid up with a violent cold; and the fever soon ran so high, that delirium came on; and before three days were past, his life hung upon a thread."
                                            },
                                            {
                                                "example_id": "8698126a-e7ae-48b8-a823-c1d8cf59c17e",
                                                "sense_id": "6047f971-69b9-3786-924b-61e5736468b5",
                                                "text": "the delirium of the preceding session (of Parliament)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a719d84-9e4c-3a67-a538-0bb2f0307fb7",
                                        "entry_id": "8bb6a880-a7e2-3e4e-b606-f7463a7bce79",
                                        "glosses": [
                                            "Wild, frenzied excitement or ecstasy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97af2c37-2a2c-43f4-9555-a4fd3bb7286b",
                        "source_entry_id": "fd374194-bee4-369f-95ed-8dcfe0d3c78d",
                        "source_sense_id": "725491c3-9e52-31b1-9a4c-4416692a7fbb",
                        "source_sense_description": "waanzinnigheid, acuut psychische stoornis ten gevolge van lichamelijke aandoening, vergiftiging...",
                        "target_lang_word": "délirium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
