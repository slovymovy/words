                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Leichtathletik dient ein lauter Schuss als <w>Signal</w> für den Beginn des Rennens."
                        },
                        {
                            "text": "Das Smartphone kann hier kein <w>Signal</w> empfangen, weil wir uns tief im Wald befinden."
                        }
                    ],
                    "synonyms": [
                        "Zeichen",
                        "Hinweis"
                    ],
                    "common_phrases": [
                        "akustisches Signal",
