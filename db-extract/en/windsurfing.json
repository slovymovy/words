                        "translation_id": "09851bcc-89d4-4a34-98e4-b2498cd7aa37",
                        "source_entry_id": "e8d9bcca-3089-3f00-a3e1-91e73487717b",
                        "source_sense_id": "6e8d93c3-37ab-3554-bf2c-0cb8bc060c29",
