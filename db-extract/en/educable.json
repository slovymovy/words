                                "target_senses": [
                                    {
                                        "sense_id": "406ac18a-3052-3460-9524-109fb03e6c7c",
                                        "entry_id": "e53e6c4b-e9d5-30bb-a237-6d1d6e2ef0e6",
                                        "glosses": [
                                            "Qui est apte à recevoir l’éducation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d1816c-73a8-4c7e-8b0e-261363847d44",
                                                "sense_id": "406ac18a-3052-3460-9524-109fb03e6c7c",
                                                "text": "- Le singe est-il le plus éducable des animaux ? - Oui, quoiqu’il le paraisse moins que le chien …."
                                            },
                                            {
                                                "example_id": "765dafa3-5d46-4daa-9d20-b7ab76bee003",
                                                "sense_id": "406ac18a-3052-3460-9524-109fb03e6c7c",
                                                "text": "Ô phrénologues ! L’inéducabilité érigée en principe ? quel inhominalisme ! La sublime créature est éducable, voyante et libre, criminelle ou vertueuse à son choix, responsable."
                                            },
                                            {
                                                "example_id": "554978c8-21a3-4454-a3e6-b6aa44e402d8",
                                                "sense_id": "406ac18a-3052-3460-9524-109fb03e6c7c",
                                                "text": "De cet optimisme, nous avons soit la variante forte – l’homme est bon par nature –, soit la variante atténuée – l’homme est perfectible et éducable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
