                                                "sense_id": "d5269384-206d-384b-be10-31debfe24b4d",
                                                "text": "Czy waranom z Komodo można podać kangurze mięso?"
                                            },
                                            {
                                                "example_id": "51035ac2-a042-4712-934f-fa36cc660db7",
                                                "sense_id": "d5269384-206d-384b-be10-31debfe24b4d",
                                                "text": "Szeroka szczęka waranów z Komodo uzbrojona jest w sześćdziesiąt zębów."
                                            }
