                                            {
                                                "example_id": "ca285f84-9008-4c05-9900-47e11885b0a6",
                                                "sense_id": "3c478fb3-4c52-391e-a3b4-e54c11c83027",
                                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                                            },
                                            {
                                                "example_id": "284442cd-8603-4096-837e-4ff04166f1c9",
                                                "sense_id": "3c478fb3-4c52-391e-a3b4-e54c11c83027",
                                                "text": "L’un des rescapés, le père Lannuzel, évoque un « trou pluvieux » et pour qu’un Breton se plaigne de la pluie, c’est que les précipitations devaient être conséquentes !"
                                            }
                                        ]
