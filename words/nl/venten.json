                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>ventte</w> met koek en snoepgoed, maar de zaken gingen slecht.",
                            "target_lang_translations": {
                                "en": "He <w>peddled</w> cakes and sweets, but business was bad."
