{
    "word_family": [
        "curtain"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cdc118c-966d-3e5f-902c-87014aff381f",
                    "sense_definition": "The plural form of <w>curtain</w>, referring to pieces of fabric hung to block light or for privacy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "household items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to hang new blue <w>curtains</w> in the living room to match the sofa.",
                            "target_lang_translations": {
                                "ru": "Она решила повесить в гостиной новые синие <w>шторы</w>, чтобы они подходили к дивану."
                            }
                        },
                        {
                            "text": "Please close the <w>curtains</w> because the sunlight is making it hard to see the screen.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, задерни <w>занавески</w>, потому что из-за солнечного света плохо видно экран."
                            }
                        }
                    ],
                    "common_phrases": [
                        "close the curtains",
                        "draw the curtains",
                        "heavy curtains"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа слова curtain, означающая куски ткани, подвешенные для блокировки света или обеспечения приватности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шторы",
                                "target_lang_sense_clarification": "общее название для занавесей"
                            },
                            {
                                "target_lang_word": "занавески",
                                "target_lang_sense_clarification": "обычно более легкие или короткие"
                            },
                            {
                                "target_lang_word": "гардины",
                                "target_lang_sense_clarification": "часто декоративные или тюлевые"
                            },
                            {
                                "target_lang_word": "портьеры",
                                "target_lang_sense_clarification": "плотные, тяжелые шторы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a51f3e0c-a918-3d77-937f-a1c0c84b2ca5",
                    "sense_definition": "A slang or informal term indicating the end, ruin, or death of someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "endings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the boss finds out about this mistake, it will be <w>curtains</w> for my career.",
                            "target_lang_translations": {
                                "ru": "Если босс узнает об этой ошибке, моей карьере придут <w>кранты</w>."
                            }
                        },
                        {
                            "text": "The villain realized it was <w>curtains</w> for his plan when the police arrived at the scene.",
                            "target_lang_translations": {
                                "ru": "Злодей понял, что его плану пришла <w>хана</w>, когда на место прибыла полиция."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curtains for you",
                        "call curtains on"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to signal a final end or failure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговый или неформальный термин, указывающий на конец, крах или смерть кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кранты",
                                "target_lang_sense_clarification": "просторечное обозначение конца или провала"
                            },
                            {
                                "target_lang_word": "хана",
                                "target_lang_sense_clarification": "разговорное о безнадежной ситуации"
                            },
                            {
                                "target_lang_word": "крышка",
                                "target_lang_sense_clarification": "разговорное о гибели или конце"
                            },
                            {
                                "target_lang_word": "конец",
                                "target_lang_sense_clarification": "нейтральное обозначение завершения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f851772-ffae-30a3-9802-7fccf822ec2b",
                    "sense_definition": "A ring of liquid drops forming on the inside of a wine glass due to evaporation and surface tension.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wine terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sommelier pointed out the thick <w>curtains</w> on the glass as a sign of high alcohol content.",
                            "target_lang_translations": {
                                "ru": "Сомелье указал на густые винные <w>ножки</w> на бокале как на признак высокого содержания алкоголя."
                            }
                        },
                        {
                            "text": "You can observe the Marangoni effect through the <w>curtains</w> forming after swirling the fortified wine.",
                            "target_lang_translations": {
                                "ru": "Вы можете наблюдать эффект Марангони по <w>слёзам</w>, образующимся после взбалтывания крепленого вина."
                            }
                        }
                    ],
                    "synonyms": [
                        "church windows",
                        "legs",
                        "tears of wine",
                        "wine tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кольцо из капель жидкости, образующееся на внутренней стороне винного бокала из-за испарения и поверхностного натяжения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винные ножки",
                                "target_lang_sense_clarification": "профессиональный термин в виноделии"
                            },
                            {
                                "target_lang_word": "слёзы вина",
                                "target_lang_sense_clarification": "поэтическое название эффекта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d222e40-0246-3f68-8451-6f5e12d9611f",
                    "sense_definition": "The third-person singular present tense of the verb <w>curtain</w>, meaning to provide or cover with a curtain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He usually <w>curtains</w> the stage off before the actors begin their final rehearsal.",
                            "target_lang_translations": {
                                "ru": "Обычно он <w>занавешивает</w> сцену перед тем, как актеры начнут свою финальную репетицию."
                            }
                        },
                        {
                            "text": "The designer <w>curtains</w> the large windows to create a more intimate atmosphere in the hall.",
                            "target_lang_translations": {
                                "ru": "Дизайнер <w>занавешивает</w> большие окна, чтобы создать в зале более уютную атмосферу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа настоящего времени глагола curtain, означающая снабжать шторами или закрывать их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занавешивает",
                                "target_lang_sense_clarification": "закрывает шторами"
                            },
                            {
                                "target_lang_word": "отгораживает",
                                "target_lang_sense_clarification": "отделяет с помощью занавеса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}