                        "tags": [
                            "plural"
                        ],
                        "form": "départements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1369a506-47e6-359e-85fa-86dd83be023d",
                        "entry_id": "e03c927b-f7e1-3dc1-92aa-6d2477f4ebec",
                        "glosses": [
                            "An administrative unit in various French-speaking countries, smaller than a région, similar to an English county."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e449130e-8baa-44c2-a438-e19546f8b925",
                                "sense_id": "1369a506-47e6-359e-85fa-86dd83be023d",
                                "text": "On the other hand, the political–territorial pattern has been maintained but also redirected at the départemental level by the transformation of former ministerial départemental directorates into inter-ministerial units, under the supervision of the prefects of the département."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a5b8082-cedb-4798-8867-2d4dc9d9b49a",
                        "source_entry_id": "e03c927b-f7e1-3dc1-92aa-6d2477f4ebec",
                        "source_sense_id": "1369a506-47e6-359e-85fa-86dd83be023d",
                        "source_sense_description": "administrative unit in various French-speaking countries",
                        "target_lang_word": "département",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "département",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ceede256-8fe5-3c04-a8b6-e11ee1526049",
                                        "entry_id": "535f3585-9e8d-3a9b-ba84-b95d544b86fb",
                                        "glosses": [
                                            "Chacune des parties des affaires d’État, distribuées entre les ministres et dont la connaissance leur est attribuée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553c8682-04d5-4fc4-b442-ff7df1cb59e9",
                                                "sense_id": "ceede256-8fe5-3c04-a8b6-e11ee1526049",
                                                "text": "A l’est de l’afrag s’étendait une sorte d’esplanade, le mechouar, bordé de tentes faisant office de benikas ou bureaux où les vizirs et leurs secrétaires venaient expédier les affaires de leur département."
                                            },
                                            {
                                                "example_id": "9381f668-8a24-427e-a2f3-e824f02400a7",
                                                "sense_id": "ceede256-8fe5-3c04-a8b6-e11ee1526049",
                                                "text": "Le département de la Guerre."
                                            },
                                            {
                                                "example_id": "33e62033-16ee-4fee-9d71-93da6dd62d77",
                                                "sense_id": "ceede256-8fe5-3c04-a8b6-e11ee1526049",
                                                "text": "Le département des affaires étrangères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                        "entry_id": "535f3585-9e8d-3a9b-ba84-b95d544b86fb",
                                        "glosses": [
                                            "Principale division administrative du territoire français. La France compte cent départements dont quatre départements d’outre-mer."
                                        ],
                                        "tags": [
                                            "Administration territoriale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f52372f-4105-4c8d-b079-25951d3c70e9",
                                                "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                                "text": "A la frontière de quatre départements (Haute-Saône, Territoire de Belfort, Vosges, Haut-Rhin), le ballon d’Alsace constitue également l’un des plus beaux points de vue de la région (sommet à 1 247 m)."
                                            },
                                            {
                                                "example_id": "346136ab-460c-4257-bc4e-b1ef02e1f4fd",
                                                "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                                "text": "Le 22 décembre 1789, la France fut divisée en quatre-vingt-trois départements à peu près égaux en étendue et en population."
                                            },
                                            {
                                                "example_id": "72ce4939-3add-4ad8-a93a-784379aaa5fd",
                                                "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                                "text": "Vous, dont la vie a été la poésie la plus inutile de ce siècle, puisque votre sang répandu sur l’Europe, et vos énormes souffrances exigées par un colosse, n’ont pas empêché la France de perdre dix départements acquis par la République, comment donnez-vous dans ce raisonnement."
                                            },
                                            {
                                                "example_id": "075f9574-0957-413e-a83f-e1caeff912b4",
                                                "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                                "text": "« J’ai vu quatre-vingt-six départements l’un à côté de l’autre, messieurs, rangés sagement l’un à côté de l’autre d’une façon dont vous n’avez pas idée.\n« Quatre-vingt-six départements qui ont des dents !\n« Quatre-vingt-six départements qui ont des pointes, des épines, des crêtes, des lames, des tenons, des crochets, des griffes, des ongles, et qui ont aussi des fentes, des fissures, des crevasses, des creux, des trous ; et qui s’engrènent, qui s’ajustent, qui s’emboîtent, et qui s’accouplent comme une bande de cochons.\n« Chose étrange, au milieu de chaque département il y a un œil ! »"
                                            },
                                            {
                                                "example_id": "9d533fd4-f0b9-4f42-acea-536fe5ffeb42",
                                                "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                                "text": "Je sors d’un département, l’Orne, qui est celui où l’on trouva le plus de réfractaires sous le premier Empire."
                                            },
                                            {
                                                "example_id": "dd621beb-c7ba-4482-9fa3-d75b883ae2d2",
                                                "sense_id": "38112ef5-9d10-341f-aaf5-d96ee056cdba",
                                                "text": "Il possédait si bien la carte des fossiles du département qu’il ne donnait jamais un coup de piochon sans exhumer un spécimen rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05e99f6-ba7f-3a6a-a0a3-db04d6b632dc",
                                        "entry_id": "535f3585-9e8d-3a9b-ba84-b95d544b86fb",
                                        "glosses": [
                                            "L’administration qui dirige ce territoire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8d12922-463a-415d-9436-c5342ba5c941",
                                                "sense_id": "c05e99f6-ba7f-3a6a-a0a3-db04d6b632dc",
                                                "text": "Le département fait de louables efforts pour créer un dispensaire antituberculeux. Il organise l’inspection des écoles. Quant à un sanatorium, n’en parlons pas pour l’instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a652abac-4c65-39b7-b3e3-6f1a7b7662c6",
                                        "entry_id": "535f3585-9e8d-3a9b-ba84-b95d544b86fb",
                                        "glosses": [
                                            "L’ensemble des habitants de ce territoire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf7ec08-bc1a-4b92-8bef-68e5a84e2b0a",
                                                "sense_id": "a652abac-4c65-39b7-b3e3-6f1a7b7662c6",
                                                "text": "Tout le monde étant d’accord pour me désigner nettement sous le nom de scepticisme, d’impiété ou de laïcisme l’esprit dominant du département, tout le monde aussi, on l’a vu, reconnaît son esprit de progrès …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef58818a-46a6-308f-b31c-ff4f977f5181",
                                        "entry_id": "535f3585-9e8d-3a9b-ba84-b95d544b86fb",
                                        "glosses": [
                                            "Province, par opposition à la capitale."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f5230d-5009-4bd2-a22a-13879136fbbb",
                                                "sense_id": "ef58818a-46a6-308f-b31c-ff4f977f5181",
                                                "text": "à Paris et dans les départements."
                                            },
                                            {
                                                "example_id": "1de619ba-468c-46d5-b40c-6d4a464c2579",
                                                "sense_id": "ef58818a-46a6-308f-b31c-ff4f977f5181",
                                                "text": "Faire des envois dans les départements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe44bcc-1755-3279-9d48-3a3290c3c6d1",
                                        "entry_id": "535f3585-9e8d-3a9b-ba84-b95d544b86fb",
                                        "glosses": [
                                            "Unité dans le schéma d’organisation hiérarchique à l’intérieur d’une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a3ac04-2e7e-42c3-9202-e1a565e6d3db",
                                                "sense_id": "ebe44bcc-1755-3279-9d48-3a3290c3c6d1",
                                                "text": "Le département d’informatique est un des départements essentiels d’une banque d’aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
