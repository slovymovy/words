                            {
                                "example_id": "c7713966-f6b1-4615-b3d4-0d6d98e7840e",
                                "sense_id": "6eaff827-69bd-32ca-9e2f-df1e2e047dc9",
                                "text": "Op een balkon van een huis aan de Stationsstraat in Schiedam is vanmiddag een dode baby gevonden. Het gaat volgens de politie om een pasgeboren kind."
                            },
                            {
                                "example_id": "7ab1fa67-fbe8-434d-a17f-a061323b1cdf",
                                "sense_id": "6eaff827-69bd-32ca-9e2f-df1e2e047dc9",
                                "text": "De politie rukte uit vanwege een melding dat een man zichzelf in zijn appartement aan de Stationsstraat iets wilde aandoen. Ter plekke zagen agenten dat de man een vuurwapen had, waarna ze een arrestatieteam en een onderhandelaar inschakelden. Het appartementencomplex werd ontruimd."
                            }
                        ]
