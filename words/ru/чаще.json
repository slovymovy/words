    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2fa16bd5-4d6e-3efd-ab97-59fa77787761",
                    "sense_definition": "Сравнительная степень наречия <w>часто</w>; происходя в большем количестве случаев за определенный период времени.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_freq",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я стал <w>чаще</w> ходить в кино по выходным.",
                            "target_lang_translations": {
                                "en": "I started going to the cinema <w>more often</w> on weekends.",
                                "zh": "周末我<w>更经常</w>去看电影了。"
                            }
                        },
                        {
                            "text": "Звони родителям <w>чаще</w>, они скучают.",
                            "target_lang_translations": {
                                "en": "Call your parents <w>more often</w>, they miss you.",
                                "zh": "多给父母打打电话，他们很想你。"
                            }
                        }
                    ],
                    "antonyms": [
                        "реже",
                        "пореже"
                    ],
                    "common_phrases": [
                        "всё чаще",
                        "как можно чаще",
                        "намного чаще",
                        "гораздо чаще"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adverb 'often'; occurring in a greater number of instances over a certain period.",
                        "zh": "副词“经常”的比较级；指在特定时间内发生的次数更多。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "more often",
                                "target_lang_sense_clarification": "general frequency"
                            },
                            {
                                "target_lang_word": "more frequently",
                                "target_lang_sense_clarification": "slightly more formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更经常",
                                "target_lang_sense_clarification": "表示频率增加"
                            },
                            {
                                "target_lang_word": "更频繁",
                                "target_lang_sense_clarification": "较为正式的表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6c27739-fe20-3545-86ab-e0d030ced576",
                    "sense_definition": "Сравнительная степень наречия <w>часто</w>; располагаясь плотнее, с меньшими промежутками в пространстве.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "space_dens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Саженцы должны стоять <w>чаще</w>, чтобы образовать живую изгородь.",
                            "target_lang_translations": {
                                "en": "The saplings should stand <w>closer together</w> to form a hedge.",
                                "zh": "树苗要种得<w>更密</w>一些，才能形成绿篱。"
                            }
                        },
                        {
                            "text": "Зубья у этой пилы расположены <w>чаще</w>, чем у той.",
                            "target_lang_translations": {
                                "en": "The teeth on this saw are spaced <w>closer together</w> than on that one.",
                                "zh": "这把锯的锯齿比那把锯得<w>更紧凑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "гуще"
                    ],
                    "antonyms": [
                        "реже"
                    ],
                    "common_phrases": [
                        "сажать чаще",
                        "расти чаще"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adverb 'often'; located more densely, with smaller intervals in space.",
                        "zh": "副词“经常”的比较级；指在空间上分布得更紧密，间隔更小。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "closer together",
                                "target_lang_sense_clarification": "spatial arrangement"
                            },
                            {
                                "target_lang_word": "more densely",
                                "target_lang_sense_clarification": "regarding distribution"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更密",
                                "target_lang_sense_clarification": "指空间分布密度"
                            },
                            {
                                "target_lang_word": "更紧凑",
                                "target_lang_sense_clarification": "指排列间距"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae4436ef-afd0-38c7-a5cd-773ebd15e4d1",
                    "sense_definition": "Сравнительная степень прилагательного <w>частый</w>; такой, который повторяется через более короткие интервалы времени.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_freq",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его пульс стал <w>чаще</w> после пробежки.",
                            "target_lang_translations": {
                                "en": "His pulse became <w>faster</w> after the run.",
                                "zh": "跑步后他的脉搏跳得<w>更快</w>了。"
                            }
                        },
                        {
                            "text": "Дыхание больного становилось всё <w>чаще</w> и тяжелее.",
                            "target_lang_translations": {
                                "en": "The patient's breathing was becoming <w>more rapid</w> and heavier.",
                                "zh": "病人的呼吸变得越来越<w>急促</w>且沉重。"
                            }
                        }
                    ],
                    "antonyms": [
                        "реже"
                    ],
                    "common_phrases": [
                        "пульс чаще",
                        "дыхание чаще"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adjective 'frequent'; repeating at shorter time intervals (e.g., pulse, breathing).",
                        "zh": "形容词“频繁”的比较级；指重复的时间间隔更短（如脉搏、呼吸）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "faster",
                                "target_lang_sense_clarification": "pulse or rhythm"
                            },
                            {
                                "target_lang_word": "more rapid",
                                "target_lang_sense_clarification": "breathing or heartbeat"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更快",
                                "target_lang_sense_clarification": "用于脉搏或节奏"
                            },
                            {
                                "target_lang_word": "更急促",
                                "target_lang_sense_clarification": "用于呼吸或心跳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf8afd93-88ba-3a98-abdb-43a1ec8065dd",
                    "sense_definition": "Сравнительная степень прилагательного <w>частый</w>; более плотный, состоящий из близко расположенных элементов.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "space_dens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Трава на этом участке <w>чаще</w> и зеленее.",
                            "target_lang_translations": {
                                "en": "The grass in this area is <w>thicker</w> and greener.",
                                "zh": "这片区域的草长得<w>更茂密</w>、更绿。"
                            }
                        },
                        {
                            "text": "Лес становится <w>чаще</w> по мере углубления в заповедник.",
                            "target_lang_translations": {
                                "en": "The forest becomes <w>denser</w> as you go deeper into the reserve.",
                                "zh": "越往保护区深处走，森林就变得<w>更浓密</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "гуще"
                    ],
                    "antonyms": [
                        "реже"
                    ],
                    "common_phrases": [
                        "лес чаще"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative degree of the adjective 'frequent'; denser, consisting of closely spaced elements.",
                        "zh": "形容词“频繁”的比较级；指由紧密排列的元素组成，密度更高。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thicker",
                                "target_lang_sense_clarification": "vegetation or hair"
                            },
                            {
                                "target_lang_word": "denser",
                                "target_lang_sense_clarification": "forest or growth"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更茂密",
                                "target_lang_sense_clarification": "用于植被或毛发"
                            },
                            {
                                "target_lang_word": "更浓密",
                                "target_lang_sense_clarification": "用于森林或生长物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20b41609-c42f-38b5-a288-68c885ce4b6e",
                    "sense_definition": "Форма дательного или предложного падежа единственного числа существительного <w>чаща</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы долго пробирались по лесной <w>чаще</w>.",
                            "target_lang_translations": {
                                "en": "We made our way through the forest <w>thicket</w> for a long time.",
                                "zh": "我们在森林<w>丛林</w>中穿行了很久。"
                            }
                        },
                        {
                            "text": "В непроходимой <w>чаще</w> скрывались дикие звери.",
                            "target_lang_translations": {
                                "en": "Wild beasts were hiding in the impassable <w>thicket</w>.",
                                "zh": "野兽躲藏在难以通行的<w>丛林</w>里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "в лесной чаще",
                        "по чаще"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "noun form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the dative or prepositional case singular of the noun 'thicket'.",
                        "zh": "名词“丛林”的与格或前置格形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thicket",
                                "target_lang_sense_clarification": "dense group of bushes or trees"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丛林",
                                "target_lang_sense_clarification": "指茂密的灌木丛或树林"
                            }
                        ]
                    }
                }
            ]
        }
    ]
