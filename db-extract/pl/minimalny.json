                ],
                "senses": [
                    {
                        "sense_id": "8c989cd9-7b47-300b-9fbd-8358e1d642be",
                        "entry_id": "79595a2a-a344-3aa9-b047-ad45dd266657",
                        "glosses": [
                            "bardzo mały, ograniczony lub zbliżony do minimum"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c5707da7-424a-4169-beaf-c4fb27688e25",
                                "sense_id": "8c989cd9-7b47-300b-9fbd-8358e1d642be",
                                "text": "Mówili dobrą polszczyzną, z minimalną domieszką rusycyzmów, jak zresztą mówi lud na całem Podlasiu i Chełmszczyźnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ab340a26-3a22-3be5-941b-32f5667c4dea",
                        "entry_id": "79595a2a-a344-3aa9-b047-ad45dd266657",
                        "glosses": [
                            "najniższy z możliwych lub dopuszczalnych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4570344-a5c6-405d-a3a6-9beec3a10d7a",
                        "source_entry_id": "79595a2a-a344-3aa9-b047-ad45dd266657",
                        "source_sense_id": "8c989cd9-7b47-300b-9fbd-8358e1d642be",
                        "target_lang_word": "minimal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "823318a2-cd69-3e66-8ea3-108ad2d89c8e",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "The smallest possible amount, quantity, or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fc2eb5-abf4-4571-a4e9-3be8dca5152d",
                                                "sense_id": "823318a2-cd69-3e66-8ea3-108ad2d89c8e",
                                                "text": "With minimal effort, you won't be able to achieve all your dreams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d12106e-453c-3919-b4ee-c07f4ae50469",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "The smallest possible amount, quantity, or degree.",
                                            "Among elements of some collection, such that no other element is greater (with respect to some given partial order)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bb7921-b96c-4650-a87d-d09bad1bc054",
                                                "sense_id": "6d12106e-453c-3919-b4ee-c07f4ae50469",
                                                "text": "With respect to the ordering induced by set-theoretic inclusion, the power set of the set of natural numbers has a unique minimal element: the empty set."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f901ccb6-0c0a-3c17-8e51-402edec0274c",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "Characterised by the use of simple form or structures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efce4a22-e73e-3f55-abe8-f061b3ee68dd",
                                        "entry_id": "30b41b50-50e8-31c4-9521-f7b17d21b269",
                                        "glosses": [
                                            "Characterised by the repetition and gradual alteration of short phrases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "minimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "504a6ea9-c63a-3304-96b9-78dd2b2bc03f",
                                        "entry_id": "ad306f45-a6da-35ad-bedd-5a0698ca6c24",
                                        "glosses": [
                                            "Something very small; a tiny part or fragment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9288d79-520d-4f98-afe5-66c331fbf84e",
                                                "sense_id": "504a6ea9-c63a-3304-96b9-78dd2b2bc03f",
                                                "text": "[…] we seek in explaining mental phenomena and behavior always the \"minimals,\" the little fragments of association, on which the mind is (passively) supposed to be based."
                                            },
                                            {
                                                "example_id": "92528e40-ec28-4440-b2c8-0f4042cc6be4",
                                                "sense_id": "504a6ea9-c63a-3304-96b9-78dd2b2bc03f",
                                                "text": "[…] identifications with birds, fish, trees, and flowers (and occasionally as relief, with the stillness of rocks, clam shells, driftwood, and nature's minimals); […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
