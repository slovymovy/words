                        "form": "die Bergfexen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                        "entry_id": "bc39c786-1fc4-3ae2-948a-e925ed9e4094",
                        "glosses": [
                            "leidenschaftlicher Bergsteiger"
                        ],
                        "tags": [
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "9b18747b-b590-449c-b0b5-07455477d400",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "Xaver ist ein ausgemachter Bergfex."
                            },
                            {
                                "example_id": "0ad8153b-e442-41fd-9a6b-bedb22e8aefd",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "Des Bergfexes Gattin begleitet ihn nie auf seinen Touren."
                            },
                            {
                                "example_id": "89e7be3f-5c4e-49ce-9ec2-1099f1467f0f",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "„Diese Nachricht dürfte zwar die Bergfexe freuen, bei den Freibad-Betreibern sorgt diese Botschaft allerdings eher für lange Gesichter.“"
                            },
                            {
                                "example_id": "6f589135-9643-4fce-a547-ce34532cd269",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "„Es liest sich nicht nach einer milden Rückschau eines erfolgreichen Lebens, sondern nach Altersbockigkeit eines grantelnden Bergfexen.“"
                            },
                            {
                                "example_id": "e889dab2-1f8c-4302-b428-4a41eebafa6d",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "„Nürnberg liegt zwischen zwei prominenten Klettergebieten, die (meist gut vorbereitete) Bergfexe aus ganz Europa anziehen.“"
                            },
                            {
                                "example_id": "2607f774-aedd-49a3-8f82-78a34568979a",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "„Mit Tabakgenuss aus einer Wasserpfeife feierten einige Bergfexen aus dem Berchtesgadener Land ihre Besteigung des 5 642 Meter hohen Elbrus im russischen Kaukasus-Gebirge.“"
                            },
                            {
                                "example_id": "7154e827-0b43-4e00-a4cd-33a7df60a26b",
                                "sense_id": "618db776-2e8f-3407-9d71-1d14baf44951",
                                "text": "„Selbst die Eissporen muß man dort gebrauchen, auch Haltetaue und Bergstock, und sogar der erfahrenste Bergfex kann sich dort ohne Mühe einen Absturz erobern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
