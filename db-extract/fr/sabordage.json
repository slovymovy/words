                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "16726992-fbea-4afc-932a-db6b1c642aff",
                        "entry_id": "2f009f84-a8e5-3562-872a-f8ebd19096e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "sabordages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb12b2f6-066e-3af5-9762-49cd9ff34e37",
                        "entry_id": "2f009f84-a8e5-3562-872a-f8ebd19096e8",
                        "glosses": [
                            "Action de couler volontairement un bateau par l’équipage qui le contrôle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad53ee03-3f66-41e9-be05-0f1527d4b7cc",
                                "sense_id": "bb12b2f6-066e-3af5-9762-49cd9ff34e37",
                                "text": "Après le 5ᵉ dépôt, il a fait ses classes comme apprenti marin à la compagnie de garde de Toulon où il se trouvait donc au moment du sabordage de la flotte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85543d33-4cdc-400b-b65d-3f9962380040",
                        "source_entry_id": "2f009f84-a8e5-3562-872a-f8ebd19096e8",
                        "source_sense_id": "bb12b2f6-066e-3af5-9762-49cd9ff34e37",
                        "target_lang_word": "Selbstversenkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstversenkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a517af81-261b-3b67-b0de-787a33da480b",
                                        "entry_id": "a0e49bfe-589f-3184-a0b1-6d21c7e07734",
                                        "glosses": [
                                            "absichtliche Vernichtung des eigenen Wasserfahrzeugs durch Untergang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c34664-a15b-48ec-85ff-0679f2485925",
                                                "sense_id": "a517af81-261b-3b67-b0de-787a33da480b",
                                                "text": "„Nachdem die Siegermächte die Selbstversenkung zunächst als Bruch der Waffenstillstandsbedingungen und als Ausdruck »ungeheuer bösen Willens« verurteilt hatten, waren am Ende zumindest die Briten gar nicht so unzufrieden damit.“"
                                            },
                                            {
                                                "example_id": "d1fc411c-ddc0-4192-a62d-8bf8bbe0a02b",
                                                "sense_id": "a517af81-261b-3b67-b0de-787a33da480b",
                                                "text": "„Der Plan sah vor, ein randvoll mit Zement beladenes Schiff unter falscher Flagge in den Kanal zu schicken und diesen durch eine Selbstversenkung zu blockieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6d99954-0da0-3859-8b31-a512ca7a524d",
                                        "entry_id": "a0e49bfe-589f-3184-a0b1-6d21c7e07734",
                                        "glosses": [
                                            "tiefe Konzentration"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ae961d-9dac-413e-bb3a-3984e2bcd2a1",
                                                "sense_id": "e6d99954-0da0-3859-8b31-a512ca7a524d",
                                                "text": "„Die Konzentration nach innen, z. B. die Beobachtung des eigenen Atems, nennt man auch Selbstversenkung.“"
                                            },
                                            {
                                                "example_id": "d87d1956-262b-4216-acd8-58c11eb8cce0",
                                                "sense_id": "e6d99954-0da0-3859-8b31-a512ca7a524d",
                                                "text": "„Selbstversenkung meint nun einen bestimmten Umgang mit sich und der Welt, den sich ein Mensch errichten kann: seine Hingabe an das Wirken des Geistes in seinem Leibe und in seiner Geschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbcc498d-dd31-4366-b48c-ba851debf778",
                        "source_entry_id": "2f009f84-a8e5-3562-872a-f8ebd19096e8",
                        "source_sense_id": "bb12b2f6-066e-3af5-9762-49cd9ff34e37",
                        "target_lang_word": "scuttle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scuttle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da9b0e34-aab4-312d-bde7-531c094374a9",
                                        "entry_id": "7741e86a-908f-3301-bf9c-445eb3dfa3b7",
                                        "glosses": [
                                            "A container like an open bucket (usually to hold and carry coal)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb3407ce-c52c-4935-b732-741309dd15ac",
                                                "sense_id": "da9b0e34-aab4-312d-bde7-531c094374a9",
                                                "text": "All through dinner—which was long, in consequence of such accidents as the dish of potatoes being mislaid in the coal skuttle and the handle of the corkscrew coming off and striking the young woman in the chin—Mrs. Jellyby preserved the evenness of her disposition."
                                            },
                                            {
                                                "example_id": "6b9c3a98-fc80-48ff-8ddb-b6706315bf2c",
                                                "sense_id": "da9b0e34-aab4-312d-bde7-531c094374a9",
                                                "text": "On the way, with superior precaution, we got out our saucepan. The kitchen fire was red, but low; the coal-cellar was locked, and there was nothing in the scuttle but a little coal-dust and the piece of brown paper that is put in to keep the coals from tumbling out through the bottom where the hole is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3417302c-abdf-3477-b786-80fb8ad9b63e",
                                        "entry_id": "7741e86a-908f-3301-bf9c-445eb3dfa3b7",
                                        "glosses": [
                                            "A broad, shallow basket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcad5b42-98e8-382e-bb3e-68c2e881d63b",
                                        "entry_id": "7741e86a-908f-3301-bf9c-445eb3dfa3b7",
                                        "glosses": [
                                            "A dish, platter or a trencher."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scuttle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d22c45ca-3738-3dd0-8000-8e4e61dcc4e8",
                                        "entry_id": "55272e11-9075-3680-ac6b-c7135c460c2e",
                                        "glosses": [
                                            "A small hatch or opening in a boat, sometimes one used for draining water from open deck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7956a7f-a825-4a48-a313-ddf4f85cb12b",
                                                "sense_id": "d22c45ca-3738-3dd0-8000-8e4e61dcc4e8",
                                                "text": "My knife was at my hip. I returned to my hut for the shotgun, made sure it was loaded, and went down to the Ghost. With some difficulty, and at the expense of a wetting to the waist, I climbed aboard. The forecastle scuttle was open. I paused to listen for the breathing of the men, but there was no breathing."
                                            },
                                            {
                                                "example_id": "ba9a92a3-9c6c-4a19-9d6a-9c4203b066dd",
                                                "sense_id": "d22c45ca-3738-3dd0-8000-8e4e61dcc4e8",
                                                "text": "The detective kept them in view. He made his way casually along the inside of the shelter until he reached an open scuttle close to where the two men were standing talking. Eavesdropping was not a thing Larard would have practised from choice, but there were times when, in the public interest, he had to do it, and this was one of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f463a1-3aca-3f3f-b7c2-d8f60ffe0a59",
                                        "entry_id": "55272e11-9075-3680-ac6b-c7135c460c2e",
                                        "glosses": [
                                            "A drained trough between the windscreen and bonnet of a motor vehicle, forming the intake to the heating/air-conditioning system, often also containing the windscreen wiper motor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fc3f266-e50c-3992-9878-0d947548cd8a",
                                        "entry_id": "55272e11-9075-3680-ac6b-c7135c460c2e",
                                        "glosses": [
                                            "A drained trough between the windscreen and bonnet of a motor vehicle, forming the intake to the heating/air-conditioning system, often also containing the windscreen wiper motor.",
                                            "By extension, the bulkhead at the front of the passenger compartment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6876bbd-3a27-356f-9858-0f23bdcd5969",
                                        "entry_id": "55272e11-9075-3680-ac6b-c7135c460c2e",
                                        "glosses": [
                                            "A hatch that provides access to the roof from the interior of a building."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scuttle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a82d212-84fe-3126-96b1-50d61e2d52fd",
                                        "entry_id": "230ed3a9-412b-3cc6-93cc-4fc553cb3214",
                                        "glosses": [
                                            "To cut a hole or holes through the bottom, deck, or sides of (as of a ship), for any purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                        "entry_id": "230ed3a9-412b-3cc6-93cc-4fc553cb3214",
                                        "glosses": [
                                            "To deliberately sink one's ship or boat by any means, usually by order of the vessel's commander or owner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7ab94df-45ac-427d-9763-aeeccece6241",
                                                "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                                "text": "The Vichy French fleet in Toulon in 1942 scuttled itself as a final \"fuck you\" to the invading Germans."
                                            },
                                            {
                                                "example_id": "3382b5c2-4dd2-45cb-93a8-c5baef8959e4",
                                                "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                                "text": "\"My men, the schooner coming up on our weather quarter is a Portuguese pirate. His character is known; he scuttles all the ships he boards, dishonours the women, and murders the crew.\""
                                            },
                                            {
                                                "example_id": "172d09d1-ceac-4070-bfb5-0726b634f864",
                                                "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                                "text": "In this version, the Patriot was boarded by pirates (or the crew and passengers were overpowered by mutineers), who murdered everyone and then looted and scuttled the ship."
                                            },
                                            {
                                                "example_id": "97f4ad88-0c10-4c77-bde0-bc80c1cb2c8c",
                                                "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                                "text": "To lay the foundation for an all-weather dock at Shelter Bay, he filled an old barge with worn-out grindstones from the Thorold paper mill, then scuttled the vessel."
                                            },
                                            {
                                                "example_id": "1b806aa8-5938-48fa-b10b-21b02e957827",
                                                "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                                "text": "He decided that before scuttling the ship to prevent her falling into enemy hands he had to get the dead and wounded ashore."
                                            },
                                            {
                                                "example_id": "b3831d04-c86c-4003-8311-1e016f9c1e65",
                                                "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                                                "text": "In recent years, steel-hull vessels up to 350 feet long have been scuttled in stable sandy-bottom areas, amassing new communities of fish and invertebrates and easing the stress and strain on the coral reef by creating new fishing and diving sites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a90caee-d004-32e2-bb94-6bf0040ec5e1",
                                        "entry_id": "230ed3a9-412b-3cc6-93cc-4fc553cb3214",
                                        "glosses": [
                                            "To deliberately wreck one's vehicle (of any sort)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2970da02-9e36-45b6-a2e9-a2a0ae4bd158",
                                                "sense_id": "7a90caee-d004-32e2-bb94-6bf0040ec5e1",
                                                "text": "The third and equally important fact is that at the time of gear retraction more than ample runway remained to brake to a successful stop and even had there been a fire in the left engine no necessity existed for scuttling the aircraft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8388e3d3-640a-334c-bdeb-732927724845",
                                        "entry_id": "230ed3a9-412b-3cc6-93cc-4fc553cb3214",
                                        "glosses": [
                                            "To undermine or thwart oneself or one's position or property, especially deliberately."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdaa86c7-7e09-4f54-b0c5-58cd7398d9dc",
                                                "sense_id": "8388e3d3-640a-334c-bdeb-732927724845",
                                                "text": "The candidate had scuttled his chances with his unhinged outburst."
                                            },
                                            {
                                                "example_id": "38d70642-340e-4161-8362-2cdf28970446",
                                                "sense_id": "8388e3d3-640a-334c-bdeb-732927724845",
                                                "text": "The proposed merger of the Morgan Stanley Group and the S. G. Warburg Group collapsed today, scuttling plans by the companies to create one of the world's most powerful investment banks."
                                            },
                                            {
                                                "example_id": "e4e0cdb3-7a16-4139-85e7-5cd273a8ca23",
                                                "sense_id": "8388e3d3-640a-334c-bdeb-732927724845",
                                                "text": "But the $3.5 billion ignition facility, derided by some critics as taxpayer-financed science fiction, is running into new challenges that may further delay and perhaps scuttle its goal."
                                            },
                                            {
                                                "example_id": "0cf9a913-7746-4617-b73f-ca5535ba25df",
                                                "sense_id": "8388e3d3-640a-334c-bdeb-732927724845",
                                                "text": "By pushing for such an extreme and indefensible position, the old-media moguls sparked a tremendous outcry, which caused the legislation to be redrafted and then scuttled, at least temporarily"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scuttle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92bc97e4-e9a9-37f3-823e-e298ade20f79",
                                        "entry_id": "e11ae84f-3c97-3740-a691-2325054965b0",
                                        "glosses": [
                                            "To move hastily, to scurry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78d6bf06-962c-43fd-8c60-e74b8e3f5f6f",
                                                "sense_id": "92bc97e4-e9a9-37f3-823e-e298ade20f79",
                                                "text": "With the first dawn of day, old Janet was scuttling about the house to wake the baron."
                                            },
                                            {
                                                "example_id": "4e92cb72-4e75-4351-bc4a-40ff6648c190",
                                                "sense_id": "92bc97e4-e9a9-37f3-823e-e298ade20f79",
                                                "text": "there was a wisp or two of fine seaweed that had somehow got in, and a small crab was still alive and scuttled across the corner, yet the coffins were but little disturbed."
                                            },
                                            {
                                                "example_id": "6c781b5b-d7a5-4b46-a7e6-d021c98b2751",
                                                "sense_id": "92bc97e4-e9a9-37f3-823e-e298ade20f79",
                                                "text": "Morel scuttled out of the house before his wife came down."
                                            },
                                            {
                                                "example_id": "88150d71-78de-4e4d-b23d-bbc8849d6a8f",
                                                "sense_id": "92bc97e4-e9a9-37f3-823e-e298ade20f79",
                                                "text": "Frank was crouched in the hallway, but scuttled back to his bedroom just in time. With her bloomers still round her ankles Auntie Flip scampered sideways like a crab back to the living room."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scuttle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "991858b8-976f-3c00-abeb-ef4e421a5a7c",
                                        "entry_id": "fe0d8f5b-dd7b-3da0-a72d-3437528eb298",
                                        "glosses": [
                                            "A quick pace; a short run."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8d33b6-d73b-438f-946d-19628b504927",
                                                "sense_id": "991858b8-976f-3c00-abeb-ef4e421a5a7c",
                                                "text": "She scarce gave me time to return her salute, before she quitted the shop with an easy scuttle, and stepped again into her coach"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
