                        "cross_references": [
                            {
                                "target_word": "Hyperonymie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da426dd7-272d-391c-9716-96c8e8dab54b",
                                        "entry_id": "f6693368-a414-34a9-bab8-069c3f0c5c17",
                                        "glosses": [
                                            "semantische Beziehung zwischen Wörtern, bei denen eines, das Hyperonym, dem anderen übergeordnet ist, weil es eine allgemeinere Bedeutung hat"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4be73cf-cb20-49c8-a05b-27566f9dd8dc",
                                                "sense_id": "da426dd7-272d-391c-9716-96c8e8dab54b",
                                                "text": "Zwischen den Wörtern Baum und Tanne besteht die Bedeutungsbeziehung der Hyperonymie, da \"Baum\" das allgemeinere, umfassendere Wort ist und \"Tanne\" die speziellere Bedeutung hat."
                                            },
                                            {
                                                "example_id": "38c65b2a-31fb-4123-b0af-c3e1b89ff7bc",
                                                "sense_id": "da426dd7-272d-391c-9716-96c8e8dab54b",
                                                "text": "„Zu den paradigmatischen Angaben gehören unter anderen Synonymie, Antonymie, Hyponymie, Hyperonymie, Komplenymie und Meronymie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
