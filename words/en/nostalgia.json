{
    "word_family": [
        "nostalgic",
        "nostalgically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c9ee7c1-c4a9-3658-941e-98805034c3ba",
                    "sense_definition": "A longing for home or familiar surroundings; homesickness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "longing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student felt a deep <w>nostalgia</w> for his family home during his first month abroad.",
                            "target_lang_translations": {
                                "zh": "这名学生在国外的第一个月里，感到深深的<w>乡愁</w>。"
                            }
                        },
                        {
                            "text": "Living in a foreign city often triggers a sudden <w>nostalgia</w> for the comforts of one's own country.",
                            "target_lang_translations": {
                                "zh": "住在外国城市往往会突然引发对祖国舒适生活的<w>乡愁</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "homesickness"
                    ],
                    "antonyms": [
                        "nostopathy",
                        "nostophobia"
                    ],
                    "target_lang_definitions": {
                        "zh": "对家乡或熟悉环境的思念；乡愁。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乡愁",
                                "target_lang_sense_clarification": "指对家乡的思念之情。"
                            },
                            {
                                "target_lang_word": "思乡",
                                "target_lang_sense_clarification": "指想念家乡的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68fd1365-7d14-37fe-bf9f-e87028d020ca",
                    "sense_definition": "A bittersweet yearning for the things of the past.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "longing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Looking at old photographs always fills me with a sense of <w>nostalgia</w> for my childhood.",
                            "target_lang_translations": {
                                "zh": "看着旧照片总是让我心中充满对童年的<w>怀旧</w>之情。"
                            }
                        },
                        {
                            "text": "The music from the eighties evokes a strong <w>nostalgia</w> for a simpler time.",
                            "target_lang_translations": {
                                "zh": "八十年代的音乐唤起了人们对那个更简单时代的强烈<w>怀旧</w>感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wistfulness",
                        "yearning"
                    ],
                    "common_phrases": [
                        "wave of nostalgia",
                        "rush of nostalgia"
                    ],
                    "target_lang_definitions": {
                        "zh": "对过去事物的苦乐参半的怀念。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怀旧",
                                "target_lang_sense_clarification": "指对过去美好时光的怀念。"
                            },
                            {
                                "target_lang_word": "怀念",
                                "target_lang_sense_clarification": "指对过去的人或事物的思念。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}