                                                "sense_id": "3c3f730d-1301-3537-9e3e-94bd307eae6c",
                                                "text": "They sat in the kitchen slurping their spaghetti."
                                            },
                                            {
                                                "example_id": "b7442d08-b7a7-4666-bd2e-d9543ea429fb",
                                                "sense_id": "3c3f730d-1301-3537-9e3e-94bd307eae6c",
                                                "text": "As the crowd cackles and caws, a white-backed vulture snakes its head deep into the wildebeest’s eye socket and hurriedly slurps, with grooved tongue, whatever it can before being ripped from its place at the table."
                                            }
                                        ]
                                    },
                                    {
