                                        "glosses": [
                                            "In a gushing manner; with overeffusive sentimentality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "410a43c1-40c8-4411-aa91-bcbdcf2dcb9e",
                                                "sense_id": "3ada5eef-3473-3e63-ad81-b4f788a3585d",
                                                "text": "\"We went to see Guys and Dolls in New York,\" Maria Clara said gushingly. \"It was so typical. We thought of you.\""
                                            }
                                        ]
                                    }
                                ]
