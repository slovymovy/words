                ],
                "senses": [
                    {
                        "sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                        "entry_id": "70091ec3-6ce2-3d1f-93b3-2d1739784e4f",
                        "glosses": [
                            "Silbe, die hinter dem Wortstamm steht; deutsche Entsprechung für Suffix"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c043455-396d-429e-924a-fd45b08b3110",
                                "sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                                "text": "Mit dem Wort Nachsilbe wird auf die Stellung der Silbe im Verhältnis zum Wortstamm hingewiesen."
                            },
                            {
                                "example_id": "fdc853e0-78c4-40b9-880c-e5a5208f8852",
                                "sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                                "text": "Nachsilben dienen der Ableitung oder Flexion von Wörtern."
                            },
                            {
                                "example_id": "99f7901b-7ddc-4742-a277-6187f32243c6",
                                "sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                                "text": "„Ableitungen nennen wir Wörter, die aus einem vorhandenen Wort und einer Vor- und Nachsilbe bestehen (…).“"
                            },
                            {
                                "example_id": "0c762512-7be3-4573-9876-de36a56a8a58",
                                "sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                                "text": "„Letztlich glückte das Unterfangen, erforderte jedoch immer wieder den Blick in die Systemurkunde, die neben dem Zeichenvorrat für Konsonanten und Vokale, für Konsonanten- und Vokalverbindungen sowie für Vor- und Nachsilben auch jede Menge an Kürzeln (Zeichen zur Schreibung von besonders häufigen Wörtern und Wortbestandteilen) enthält.“"
                            },
                            {
                                "example_id": "f528a347-836a-46f7-8333-437614355461",
                                "sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                                "text": "„Vorsilben, Nachsilben, ganze Wörter, Morpheme spielen in den nächsten Witzen eine wichtige Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f4cf526-f34d-470e-9148-cecd77187eb2",
                        "source_entry_id": "70091ec3-6ce2-3d1f-93b3-2d1739784e4f",
                        "source_sense_id": "7857ae3b-4c48-34eb-8090-05035aa8312e",
                        "source_sense_description": "Linguistik: Silbe, die hinter dem Wortstamm steht; deutsche Entsprechung für Suffix",
                        "target_lang_word": "suffix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                        "entry_id": "3dbf6574-844b-38db-911a-b65b983d480b",
                                        "glosses": [
                                            "A morpheme added at the end of a word to modify the word's meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b12c30a-4c89-4605-814f-26351c6088dc",
                                                "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                                "text": "The suffix \"-able\" changes \"sing\" into \"singable\"."
                                            },
                                            {
                                                "example_id": "35f497bb-c94d-48c2-8435-f012cf7455b8",
                                                "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                                "text": "The praenomen and nomen for the most part consisted of simple stems with the suffix -us or -ius, […]"
                                            },
                                            {
                                                "example_id": "157ddfd8-9acc-4484-9485-93d86b6b65f7",
                                                "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                                "text": "Before I simply create a root meaning X, is there any way I can use Ithkuil morphological categories or the 150 or so suffix categories to derive this word from a more general or primary word? […] In other words, the writer would not write or “key” a certain Ithkuil symbol, but rather would select a particular root from a database and identify the particular forms of the 22 morphological categories which apply to the root as well as any suffixes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44594ef3-e7ac-3d48-8b08-97b036dd422e",
                                        "entry_id": "3dbf6574-844b-38db-911a-b65b983d480b",
                                        "glosses": [
                                            "A subscript."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d93cab9-3341-3608-9352-c0bc4d64cff7",
                                        "entry_id": "3dbf6574-844b-38db-911a-b65b983d480b",
                                        "glosses": [
                                            "A final segment of a string of characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546daeb5-d69f-41d1-a792-1f0d3027746d",
                                                "sense_id": "9d93cab9-3341-3608-9352-c0bc4d64cff7",
                                                "text": "The string \"abra\" is both a prefix and a suffix of the string \"abracadabra\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suffix",
