                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ecd388-e148-4be0-926f-0c76f5ca2c43",
                                "sense_id": "48d164bd-01ca-348f-bd82-34abba2bdfd6",
                                "text": "‘Hoe denken wij?’ staat er op hun hippe website. De button knippert op de maat van loungemuziek. Ik klik hem aan, want ik wil weten hoe zij denken."
                            }
                        ]
                    },
                    {
                        "sense_id": "01758ffb-389a-31dc-8c2d-8583eee82b21",
                        "entry_id": "3bf65e3f-4620-34ad-909f-58ee4ad92efa",
                        "glosses": [
                            "bedieningsknop op een beeldscherm",
                            "knop van een grafisch besturingssysteem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937ca9f0-3c64-4f17-8b0a-f18c6c8016c5",
                                "sense_id": "01758ffb-389a-31dc-8c2d-8583eee82b21",
                                "text": "Het linkergedeelte van het scherm toont de tekst, die door het aanklikken van de UP-DOWN button kan worden doorgebladerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef945372-9190-3834-a416-6c0488ba4273",
                        "entry_id": "3bf65e3f-4620-34ad-909f-58ee4ad92efa",
                        "glosses": [
                            "soort speldje met een wat groter oppervlak, vaak gedragen op de borst om te laten zien bij welke groep je hoort of welke opvatting je huldigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3254f8d-7a50-44d8-b1c3-24ef4212ffd7",
                                "sense_id": "ef945372-9190-3834-a416-6c0488ba4273",
                                "text": "Op haar borst droeg ze een button. Daar stond op ‘Vecht met ons mee voor de Sophia-Jacoba’."
                            },
                            {
                                "example_id": "eb00d8dc-77c8-487c-8c4f-a1ccaefa9b12",
                                "sense_id": "ef945372-9190-3834-a416-6c0488ba4273",
                                "text": "Wij zagen reeds mannen, vrouwen en kinderen met op revers of trui een button; een grote, ronde speld met een speelse tekst erop. Bij de massale Vietnam-demonstraties in Amsterdam afgelopen zaterdagmiddag droegen véél deelnemers ze."
                            }
                        ]
                    }
