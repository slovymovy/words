                        "examples": [
                            {
                                "example_id": "8456d98f-44d3-40fc-b827-864a247547ae",
                                "sense_id": "f183fc57-816f-361e-91b0-84d359398524",
                                "text": "„Wenn der Rekurswerber auf die angeblich ständige Rechtsprechung verweist, wonach die Partei die Wahl zwischen Antrag auf neuerliche Zustellung und Nichtigkeitsklage bzw. Nichtigkeitsberufung habe, so unterläßt sie es wohlweislich, diese angebliche ständige Rechtsprechung nachzuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c633785d-850f-4874-a3e3-81b5ab35b867",
                        "source_entry_id": "d224f9d9-ee6d-37d4-be18-f0ef60c9b834",
                        "source_sense_id": "f183fc57-816f-361e-91b0-84d359398524",
                        "source_sense_description": "alles bedenkend, aus nachvollziehbaren Gründen",
                        "target_lang_word": "en connaissance de cause",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en connaissance de cause",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "893e9db4-a388-3f7c-b3e8-16c790b78892",
                                        "entry_id": "349ee6ba-a03a-39a4-9442-e117a8555555",
                                        "glosses": [
                                            "En sachant ce que l’on fait ou dit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f623a58-b8c9-4fa0-b1c3-3b3f7ed8b19a",
                                                "sense_id": "893e9db4-a388-3f7c-b3e8-16c790b78892",
                                                "text": "J’ai retracé devant vous le fil d’évènements qui a conduit cet homme à tuer en pleine connaissance de cause."
                                            },
                                            {
                                                "example_id": "e496e1f2-adc2-4a42-85c6-abbd5f333fd2",
                                                "sense_id": "893e9db4-a388-3f7c-b3e8-16c790b78892",
                                                "text": "Il lui a menti sur son passé en connaissance de cause."
                                            },
                                            {
                                                "example_id": "a3ed0a2b-0dff-4e80-b387-2fd0d98232b3",
                                                "sense_id": "893e9db4-a388-3f7c-b3e8-16c790b78892",
                                                "text": "On imagine mal a priori, un système permettant d’avoir la certitude que l’engagement a été pris en connaissance de cause."
                                            },
                                            {
                                                "example_id": "93194898-cc7c-451e-9d17-f5020e13e2e8",
                                                "sense_id": "893e9db4-a388-3f7c-b3e8-16c790b78892",
                                                "text": "Ces imprévus faisaient le sel du spectacle, et l’on venait en connaissance de cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
