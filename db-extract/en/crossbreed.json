                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "25402875-3688-3fd3-974f-de2e4d27ce21",
                                        "entry_id": "7872ffb4-e222-3e56-b4e3-d0dba12846a0",
                                        "glosses": [
