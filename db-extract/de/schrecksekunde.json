                "senses": [
                    {
                        "sense_id": "1aa2d751-86f4-3020-a8ac-a2c6ebf0ded0",
                        "entry_id": "4757cc87-ab7c-3ed4-8a93-59c331bc4860",
                        "glosses": [
                            "Moment nach einem überraschendem Erlebnis, welcher bei manchen Lebewesen Starre, Ausrufe, Affekthandlungen, etc. hervorruft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55520f6-69b1-4192-86f6-071107dbe3c8",
                                "sense_id": "1aa2d751-86f4-3020-a8ac-a2c6ebf0ded0",
                                "text": "Nach der Schrecksekunde erkannte er, dass es bloß ein Scherz gewesen ist."
                            },
                            {
                                "example_id": "ec1f9ca8-7307-46ab-ae46-6f5fb90c6414",
                                "sense_id": "1aa2d751-86f4-3020-a8ac-a2c6ebf0ded0",
                                "text": "„Er führte einige Beispiele an, bei denen es auf diese Weise gelungen sei, dem Archiv wichtige Protokolle über die Schrecksekunde des Lebens zuzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
