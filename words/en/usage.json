                },
                {
                    "sense_id": "ee39e2d1-9bb1-3867-add2-f08829d6ea3e",
                    "sense_definition": "A custom or established practice that has become a habit over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a long-standing <w>usage</w> in the village to ring the bells at midnight on New Year's Eve.",
                            "target_lang_translations": {
                                "ru": "В деревне существовал давний <w>обычай</w> звонить в колокола в полночь накануне Нового года."
                            }
                        },
                        {
                            "text": "The diplomat followed the established <w>usage</w> of the court during the formal ceremony.",
                            "target_lang_translations": {
                                "ru": "Дипломат следовал установленному <w>этикету</w> двора во время официальной церемонии."
                            }
                        }
                    ],
                    "synonyms": [
