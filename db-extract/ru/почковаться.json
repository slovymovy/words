                ],
                "translations": [
                    {
                        "translation_id": "2a100705-fc98-4556-afde-532939e65333",
                        "source_entry_id": "c30b4b92-bce2-3c7a-9672-e15aaeb711d6",
                        "source_sense_description": "размножаться почкованием",
                        "target_lang_word": "bud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19c22244-64ed-3c2e-803b-aacd8dfbbc9f",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "A newly sprouted leaf or blossom that has not yet unfolded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62483fd7-b93a-49a7-823e-cd11e7f6e66b",
                                                "sense_id": "19c22244-64ed-3c2e-803b-aacd8dfbbc9f",
                                                "text": "After a long, cold winter, the trees finally began to produce buds."
                                            },
                                            {
                                                "example_id": "bf57a552-6837-4eb9-807a-8a464845d9e3",
                                                "sense_id": "19c22244-64ed-3c2e-803b-aacd8dfbbc9f",
                                                "text": "Among Turks, pills consisting of hemp buds, muscat nuts, saffron, and honey were a popular aphrodisiac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b895860-7d59-359b-ad58-1d4d486b96bf",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "Something that has begun to develop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c79b33-51b3-4bfc-93f1-fa51a4dee4c3",
                                                "sense_id": "1b895860-7d59-359b-ad58-1d4d486b96bf",
                                                "text": "breast buds"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34fe358-5439-300d-96b0-a39783f6c109",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "A small rounded body in the process of splitting from an organism, which may grow into a genetically identical new organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7d12c7-6996-48bd-850d-6ad2a9b9b64e",
                                                "sense_id": "f34fe358-5439-300d-96b0-a39783f6c109",
                                                "text": "In this slide, you can see a yeast cell forming buds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96db38b-1e6b-3ba6-8a8f-419d4b4968db",
                                        "entry_id": "23a627aa-c6ba-3d69-aa2b-0d1cff0aa240",
                                        "glosses": [
                                            "Potent cannabis taken from the flowering part of the plant (the \\\"bud\\\"), or marijuana generally.",
                                            "Cannabis that has been taken from the flowering part of the plant intended to be smoked."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
