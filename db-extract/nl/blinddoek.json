                "translations": [
                    {
                        "translation_id": "a4d8e073-20d3-46c2-a9bd-7ea62eaf1557",
                        "source_entry_id": "405eff3c-8fd7-347f-a8c0-2cb07714084b",
                        "source_sense_id": "2f8264ff-6ed0-3fd3-b87d-ffb38190625a",
                        "source_sense_description": "over de ogen gebonden reep ondoorzichtige stof om het zien te verhinderen",
                        "target_lang_word": "Augenbinde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenbinde",
