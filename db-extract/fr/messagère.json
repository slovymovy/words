                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fcf382d-d661-43e6-8f56-39866820de90",
                                "sense_id": "bde59555-7464-3e64-b408-0fc7de94b4d9",
                                "text": "Donnez-moi cette lettre, je serai votre messagère."
                            },
                            {
                                "example_id": "e3afb4f0-2896-40ce-88ca-b4c6c2189fae",
                                "sense_id": "bde59555-7464-3e64-b408-0fc7de94b4d9",
                                "text": "Mais, passionnée par les idées nouvelles de liberté et d’égalité, elle décide, par défi, de rejoindre en secret les amis de Mirabeau dont elle accepte d’être la messagère secrète auprès de la Cour."
                            }
                        ]
