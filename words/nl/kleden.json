                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die donkerblauwe kleur <w>kleedt</w> je echt heel goed.",
                            "target_lang_translations": {
