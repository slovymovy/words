                "senses": [
                    {
                        "sense_id": "a65e2917-84db-32eb-a5c8-146121f2d4a1",
                        "entry_id": "b29cf85e-980c-3069-9055-09769f1de8f5",
                        "glosses": [
                            "Faire bénéficier d’une préretraite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02fc1476-08e2-4846-85ea-77effecfb8b9",
                                "sense_id": "a65e2917-84db-32eb-a5c8-146121f2d4a1",
                                "text": "Des parlementaires ont fustigé hier les deux projets de Proximus visant à \"préretraiter\" des travailleurs âgés."
                            },
                            {
                                "example_id": "20fd85fa-8909-4ee6-a9be-ad683d5518a8",
                                "sense_id": "a65e2917-84db-32eb-a5c8-146121f2d4a1",
                                "text": "Doit-on en déduire que les entreprises vont enfin renoncer à \" préretraiter \" leurs quinquas ?"
                            },
                            {
                                "example_id": "8ea8d1e3-8ab5-401d-a46b-e4238cfcefb6",
                                "sense_id": "a65e2917-84db-32eb-a5c8-146121f2d4a1",
                                "text": "mais faut d'abord amorcer la pompe à fric et sans boulot les banques te pissent dessus (je sais devine où j'étais avant de me préretraiter...)"
                            },
                            {
                                "example_id": "42967a1e-2f29-4f18-b1a9-645bf22a888f",
                                "sense_id": "a65e2917-84db-32eb-a5c8-146121f2d4a1",
                                "text": "Et puis tu crois vraiment qu'il vaut mieux virer (ou « préretraiter ») des petits fonctionnaires pour engraisser les hauts?"
                            }
                        ]
                    }
