                "translations": [
                    {
                        "translation_id": "332f6052-bef1-4d24-85ea-fc3752a5bcaa",
                        "source_entry_id": "899eedf6-92f2-36c4-825d-deedb67e6e79",
                        "source_sense_id": "cb2e5cc3-5315-3de6-8c9b-fa48e12dd4cb",
                        "target_lang_word": "nunatak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nunatak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "986b847d-cea9-303c-9971-91ca6a502f90",
                                        "entry_id": "7294523e-0f13-357d-a168-0a68a069ff1b",
                                        "glosses": [
                                            "A mountain top or rocky element of a ridge that is surrounded by glacial ice but is not covered by ice; a peak protruding from the surface ice sheet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d97709-3c0a-48e0-9a4f-dd82dca75fdf",
                                                "sense_id": "986b847d-cea9-303c-9971-91ca6a502f90",
                                                "text": "We made for a slope close to the end of the island or nunatak, where Shackleton must have got up also; it is obviously the only place when you look at it from a commanding rise."
                                            },
                                            {
                                                "example_id": "a3835edd-9bbc-47bf-b931-e0f9984807f2",
                                                "sense_id": "986b847d-cea9-303c-9971-91ca6a502f90",
                                                "text": "Only a few lichens and mosses colonize the rocky walls of cirques and nunataks."
                                            },
                                            {
                                                "example_id": "00ff3a22-4bf8-40be-b88e-4dae97c490d4",
                                                "sense_id": "986b847d-cea9-303c-9971-91ca6a502f90",
                                                "text": "The peak in whose lee you have chosen to set up your command post is far too regular in shape to be the nunatak you imagine it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb90284d-454f-4547-8978-bd314a2ddc7d",
                        "source_entry_id": "899eedf6-92f2-36c4-825d-deedb67e6e79",
                        "source_sense_id": "cb2e5cc3-5315-3de6-8c9b-fa48e12dd4cb",
                        "target_lang_word": "nunatak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nunatak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0b92f15-789e-3420-8107-b5233d1ffc44",
                                        "entry_id": "11dc172d-fde8-3302-bbbf-deb8b617460f",
                                        "glosses": [
                                            "Sommet rocheux émergeant d’un inlandsis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1247ac3a-dc2b-4ed3-8802-485f01336932",
                                                "sense_id": "f0b92f15-789e-3420-8107-b5233d1ffc44",
                                                "text": "Si son cap est juste, il devrait atteindre la côte est du Groenland au niveau du Gunnbjørn, la montagne la plus haute du pays, un nunatak dont le sommet devrait percer la calotte de glace environnante, un bon point de repère."
                                            },
                                            {
                                                "example_id": "2a07cffa-307b-4d49-9004-4f95c78c501f",
                                                "sense_id": "f0b92f15-789e-3420-8107-b5233d1ffc44",
                                                "text": "À contre-jour, dans ce soleil déjà assez bas sur l’horizon, aveuglant, nous ne voyons presque rien. Seuls les nunataks se rapprochent comme nous descendons, grossissent, bleuissent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cebc7dc-a320-4da1-bcbd-2a327319be04",
                        "source_entry_id": "899eedf6-92f2-36c4-825d-deedb67e6e79",
                        "source_sense_id": "cb2e5cc3-5315-3de6-8c9b-fa48e12dd4cb",
                        "target_lang_word": "Nunatak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nunatak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                        "entry_id": "99f8ee9e-26d2-3bb3-b31e-21e6194a9892",
                                        "glosses": [
                                            "Bergspitze, die isoliert aus Gletschern oder aus dem Inlandeis herausragt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1a451b1-c269-42f3-ae85-573afaaac7d9",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Nach achtwöchiger Reise kam Land in Sicht, ein Nunatak – ein durch das Eis stoßender Berggipfel.“"
                                            },
                                            {
                                                "example_id": "1267b5c2-6bfc-48ce-bff7-6a4f1a61bdd9",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Der 742 m hohe Breiðamerkurfjall war früher ein Nunatak, eingeschlossen von Breiðamerkurjökull und Fjallsjökull, aber die Gletscher gingen zurück und gaben ihn wieder frei.“"
                                            },
                                            {
                                                "example_id": "24f66d65-0b93-4e2b-aed1-3a089e78454c",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Der Kleine Burgstall war bis ins Jahr 2008 ein Nunatak, der aus dem Pasterzeneis ragte, heute steht der niedrige Gipfel neben dem Gletscher.“"
                                            },
                                            {
                                                "example_id": "a6edddcf-c30f-4959-a2d8-bf97b2044e0b",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Ein Umgehen des Nunataks ist nicht möglich, da an seinem südlichen Ende der zerrissene Gletscher direkt vorbeifließt. Uns bleibt nichts weiter übrig, als uns einen Weg über den Nunatak zu suchen.“"
                                            },
                                            {
                                                "example_id": "c0fd9c3d-dab2-49da-bb9f-8f2a141280e3",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Weithin aber erblickt das Auge nichts als Schnee; er wandert mit dem Winde und wird im Windschatten der Erhebungen, in den Randgebieten auch an den Nunataks, oft mächtig angehäuft.“"
                                            },
                                            {
                                                "example_id": "b0e10096-fe3c-4049-8d6e-d0ef2e13d176",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Während des Flugs umkreisten wir die Nunataks der Alexandraberge und bildeten sie allseitig ab.“"
                                            },
                                            {
                                                "example_id": "9149ab33-62e0-46c8-8690-114cf8435054",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Über die Eisoberfläche ragten die höchsten Gipfelregionen als Nunataker heraus, an diesen wurden durch mechanische Erosion kantige Formen gebildet.“"
                                            },
                                            {
                                                "example_id": "cb3614a3-8a33-400c-a753-8796b6948d25",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Die Antarktis war weit über das heutige Maß vereist, nicht nur die Nunataker über dem festländischen Inlandeis wie der Gaußberg tragen Findlinge, auch das Schelfeis lag weiter draußen […].“"
                                            },
                                            {
                                                "example_id": "c52dcb75-a95b-48fa-939d-ae42b5d05972",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Die großen Felspyramiden der Alpen sind die eiszeitlichen Geschwister der Nunatakker in Spitzbergen.“"
                                            },
                                            {
                                                "example_id": "cf54c82d-351d-4bc4-a906-4bcfe7e77ccb",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Vermutlich trugen dann während der letzten Eiszeit die Nunatakker der Pennines eine ähnliche Flora wie heute die Tundren von Lappland oder Grönland und anderen subarktischen Gebieten, d. h. gewisse arktische, bzw. alpine Arten.“"
                                            },
                                            {
                                                "example_id": "ed3829a4-29bc-4a1a-a163-745d0da9ddee",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Vier Tage lang schon fegte der Oststurm über die Gletscher und Nunatakr Spitzbergens.“"
                                            },
                                            {
                                                "example_id": "8e33fcd0-278f-4343-a85f-8e66431072f2",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Nur nahe der Küste, bis etwa 50 km landeinwärts, ragen einzelne Berggipfel, Nunatakr genannt, inselartig aus dem Eise heraus.“"
                                            },
                                            {
                                                "example_id": "37c9e6d1-7ca3-4c43-8059-bdf294dcf041",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Hartmut will noch zu den Nunatakern im Norden des Eyjarfjördur.“"
                                            },
                                            {
                                                "example_id": "2f669681-2d6d-4165-af36-560fc4e4d1cf",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„Vorherrschend in Lappland sind alpine und subarktische Pflanzen, die die Eiszeit auf den aus dem Eis herausragenden Berggipfeln, den Nunatakkern, überlebt haben.“"
                                            },
                                            {
                                                "example_id": "8708773a-cc94-45ed-9b4e-c18d1d19650f",
                                                "sense_id": "82be9b6f-6d9e-3a08-ba3f-67949fd2f592",
                                                "text": "„In den östlichen Teilen des Landes zeigt sich an den Nunatakrn ein Emporsteigen der Eismasse, im Westen dagegen eine Senkung gegen dieselben bzw. eine Trennungszone oder Schmelzkehle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
