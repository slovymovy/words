                {
                    "sense_id": "282754af-b017-39d6-95a8-182f9d28b90e",
                    "sense_definition": "Инструмент для нанесения знака на документы, подтверждающий их подлинность.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stamp_tool_and_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор взял <печать> и заверил важный документ.",
                            "target_lang_translations": {
                                "en": "The director took the <w>stamp</w> and certified the important document.",
                                "es": "El director tomó el <w>sello</w> y legalizó el documento importante.",
                                "fr": "Le directeur a pris le <w>tampon</w> et a certifié le document important."
                            }
                        },
                        {
                            "text": "Для получения визы вам нужно поставить <печать> в банке.",
                            "target_lang_translations": {
                                "en": "To obtain a visa, you need to get a <w>stamp</w> at the bank.",
                                "es": "Para obtener el visado, necesita poner un <w>sello</w> en el banco.",
                                "fr": "Pour obtenir un visa, vous devez faire mettre un <w>tampon</w> à la banque."
                            }
                        }
                    ],
                    "synonyms": [
                        "штамп"
                    ],
                    "common_phrases": [
                        "поставить печать",
                        "круглая печать",
                        "гербовая печать"
                    ],
                    "target_lang_definitions": {
                        "en": "A tool used to apply a mark to documents, confirming their authenticity.",
                        "es": "Herramienta para aplicar una marca a documentos, confirmando su autenticidad.",
                        "fr": "Outil utilisé pour apposer une marque sur des documents, confirmant leur authenticité."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stamp",
                                "target_lang_sense_clarification": "tool for marking"
                            },
                            {
