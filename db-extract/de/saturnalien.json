                    {
                        "sense_id": "1776b029-864f-3204-988d-b6abca6c43ea",
                        "entry_id": "84099bd9-6f9c-36c7-91d9-6392ff2d9932",
                        "glosses": [
                            "Fest zu Ehren von Saturn, dem römischen Gott des Ackerbaus"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7ec8472a-4007-4bbb-9753-03b1fa8854dc",
                                "sense_id": "1776b029-864f-3204-988d-b6abca6c43ea",
                                "text": "„Ein weiteres, im alten Rom besonders beliebtes Fest waren die Saturnalien, die Mitte Dezember gefeiert wurden. Deren Traditionen (Singen, Kerzenanzünden, Schenken) wurden demnach auf das Weihnachtsfest übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad347e7c-d464-35ae-b2ec-7f015937a38a",
                        "entry_id": "84099bd9-6f9c-36c7-91d9-6392ff2d9932",
                        "glosses": [
                            "ausgelassenes Fest"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "2f4908c2-523e-4922-b4e7-5f0ee15b602b",
                                "sense_id": "ad347e7c-d464-35ae-b2ec-7f015937a38a",
                                "text": "„Die darauf folgenden Saturnalien kann man sich in groben Umrissen vorstellen, doch gewiß nicht in ihrer ganzen schrecklichen Wirklichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adcc2488-a227-4fcf-9a5d-6a4b2d750398",
                        "source_entry_id": "84099bd9-6f9c-36c7-91d9-6392ff2d9932",
                        "source_sense_id": "1776b029-864f-3204-988d-b6abca6c43ea",
                        "source_sense_description": "historisch (im antiken Rom): Fest zu Ehren von Saturn, dem römischen Gott des Ackerbaus",
                        "target_lang_word": "Saturnalia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saturnalia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                        "entry_id": "625fc712-4e22-3cb1-b60f-26115e6605f5",
                                        "glosses": [
                                            "An Ancient Roman holiday honoring the deity Saturn."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8486677b-ab7f-46b6-bd72-8a1a330eaf9d",
                                                "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                                "text": "Saturn was an ancient Italian deity. It was attempted to identify him with the Grecian god Cronos, and fabled that after his dethronement by Jupiter he fled to Italy, where he reigned during what was called the Golden Age. In memory of his beneficent dominion, the feast of Saturnalia was held every year in the winter season."
                                            },
                                            {
                                                "example_id": "9956fa23-90c9-4966-a72a-d6b710625b5b",
                                                "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                                "text": "CATULLUS described the Saturnalia as “the merriest festival of the year,” and Seneca [the Younger] reported that “all Rome seemed to go mad on this holiday.” The Saturnalia, named for Saturnus, an ancient agricultural deity, began on Dec. 17."
                                            },
                                            {
                                                "example_id": "b8a1c8fc-d56c-4c70-a39f-c39e20b7b9d9",
                                                "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                                "text": "The Church co-opted these and other pagan festivals and concepts: the Roman Lupercalia and the feast of the purification of Isis became the Feast of the Nativity; the Saturnalia were replaced by Christmas celebrations; Mithra (the Persian sun god) was born in a cave, of a virgin, on Dec. 25."
                                            },
                                            {
                                                "example_id": "a5bd3271-535b-4402-970b-353dc05b14d2",
                                                "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                                "text": "Inspired by the Roman Saturnalias, the Philadelphia Mummers New Year’s Day Parade, below, will teem with 15,000 mummers – elaborately costumed members of local New Year’s clubs – competing in four divisions."
                                            },
                                            {
                                                "example_id": "488ee614-be90-4fab-b967-86896ef5f95c",
                                                "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                                "text": "The sculpture sits about 20 feet from a traditional Nativity scene of Mary, Joseph and the baby Jesus, and is backed by a banner from an atheist group reading “Keep Saturn in Saturnalias,” a reference to the belief that the early Christian church substituted Christmas for a Roman pagan holiday."
                                            },
                                            {
                                                "example_id": "742ebc8a-39ea-4ff0-82ef-c2e0508083ba",
                                                "sense_id": "f3aa3cc8-39ab-36bf-9163-866b402e723a",
                                                "text": "In many of these early instances, they [lotteries] were deployed either as a kind of party game—during Roman Saturnalias, tickets were distributed free to guests, some of whom won extravagant prizes—or as a means of divining God’s will."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Saturnalia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d30289d2-0960-3cec-bfff-715d9cea4ada",
                                        "entry_id": "81fed10d-fea9-3836-9ec9-a81cf8eb479e",
                                        "glosses": [
                                            "Alternative letter-case form of saturnalia."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b8df477-6c99-43cc-ac49-3b7709fbbbc1",
                                                "sense_id": "d30289d2-0960-3cec-bfff-715d9cea4ada",
                                                "text": "It was odd that the literary festival should be turned into a Donnybrook fair, but so it was when I was a boy, and the tents and the shows and the crowds on the Common were to the promiscuous many the essential parts of the great occasion. They had been so for generations, and it was only gradually that the Cambridge Saturnalia were replaced by the decencies and solemnities of the present sober anniversary."
                                            },
                                            {
                                                "example_id": "6cf1def5-496b-4952-9578-4f6a49be8840",
                                                "sense_id": "d30289d2-0960-3cec-bfff-715d9cea4ada",
                                                "text": "For New York Times photographers, it has been a night to leave their families in order to document the Saturnalia of Times Square."
                                            },
                                            {
                                                "example_id": "72765fc8-160e-4465-9ec3-fb4a9d1ec499",
                                                "sense_id": "d30289d2-0960-3cec-bfff-715d9cea4ada",
                                                "text": "G N’ R, as they are colloquially known, were an affront to the ears and nostrils of civilised society, a Saturnalia in the flesh and in the speakers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
