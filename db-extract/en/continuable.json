                        "translation_id": "7e5038a6-08de-44a0-9c58-31d7050b8e6c",
                        "source_entry_id": "a32b1289-e059-30a8-808a-d1f44a390281",
                        "source_sense_id": "f8b6f1c0-c295-3c0b-9150-4fd27c82890b",
                        "source_sense_description": "able to be continued",
                        "target_lang_word": "fortsetzbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortsetzbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54c37e47-09d2-30f0-94b0-3597856c2f00",
                                        "entry_id": "499e1026-a098-384b-878f-5c1241539b7c",
                                        "glosses": [
                                            "so, dass es fortgesetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c9ed17-59df-4e6d-ac5d-0eaca7fb822d",
                                                "sense_id": "54c37e47-09d2-30f0-94b0-3597856c2f00",
                                                "text": "„Wir begreifen heute, dass unsere Lebensform nicht fortsetzbar ist und an ein Ende kommt, ohne dass wir wüssten, was an deren Stelle treten kann. Das Ruhrgebiet musste ein solches Abbruchsbewusstsein schon vor 40 Jahren entwickeln.“"
                                            },
                                            {
                                                "example_id": "fc82efde-6b20-4bde-ab1a-d45d19a0223d",
                                                "sense_id": "54c37e47-09d2-30f0-94b0-3597856c2f00",
                                                "text": "„Man sagt: Die Funktion 'f' ist an der Stelle 'x0' stetig fortsetzbar bzw. die Definitionslücke 'x0' der Funktion 'f' ist hebbar.“"
                                            },
                                            {
                                                "example_id": "12817c12-4642-431f-a860-246e155e2c61",
                                                "sense_id": "54c37e47-09d2-30f0-94b0-3597856c2f00",
                                                "text": "„'f' ist in 'a' stetig fortsetzbar <–> 'f' ist in 'a' stetig“"
                                            },
                                            {
                                                "example_id": "39f5aab5-74e6-481d-8afd-f56ed8493100",
                                                "sense_id": "54c37e47-09d2-30f0-94b0-3597856c2f00",
                                                "text": "„Wenn man der neuen Funktion nun an der Stelle den Grenzwert als Funktionswert gibt, ist die neue Funktion an der Stelle gemäß Definition stetig. Damit ist die ursprüngliche Funktion dort stetig fortsetzbar.“"
                                            },
                                            {
                                                "example_id": "ddc307cc-693a-4b77-ae1b-470c05c98125",
                                                "sense_id": "54c37e47-09d2-30f0-94b0-3597856c2f00",
                                                "text": "„Der Punkt (0|0) liegt nur auf H0. Heißt das, dass die Funktion daher nicht stetig fortsetzbar ist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
