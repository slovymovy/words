            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95d1a6d9-d5c1-3e83-bb6f-e263e36d08e8",
                    "sense_definition": "Action ou fait d'accepter, de consentir à une proposition, une idée ou une situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>acceptation</w> de notre offre a permis de finaliser le contrat rapidement."
                        },
                        {
                            "text": "L'<w>acceptation</w> des différences culturelles est essentielle pour vivre en harmonie dans la société."
                        }
                    ],
                    "synonyms": [
                        "accord",
                        "assentiment",
                        "consentement"
                    ],
                    "antonyms": [
                        "refus",
                        "rejet"
                    ],
                    "common_phrases": [
                        "acceptation d'une offre",
                        "lettre d'acceptation"
                    ]
                },
                {
                    "sense_id": "452ed598-7844-32f5-be48-431fee8fd5d4",
                    "sense_definition": "Acte par lequel une personne consent formellement à un droit ou à une obligation dans les formes légales.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>acceptation</w> de la donation doit être expressément signifiée devant un notaire pour être valide."
                        },
                        {
                            "text": "Une <w>acceptation</w> tacite du règlement intérieur engage tous les employés dès leur embauche."
                        }
                    ],
                    "synonyms": [
                        "agrément",
                        "approbation"
                    ],
                    "antonyms": [
                        "renonciation",
                        "répudiation"
                    ],
                    "common_phrases": [
                        "acceptation d'une succession",
                        "acceptation tacite"
                    ]
                },
                {
                    "sense_id": "9841f18e-7e5a-30cc-8d64-a8d92fe33afe",
                    "sense_definition": "Engagement signé par lequel une personne s'oblige à payer un effet de commerce ou une lettre de change à l'échéance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque exige l'<w>acceptation</w> de la lettre de change avant d'accorder le déblocage des fonds."
                        },
                        {
                            "text": "Une fois l'<w>acceptation</w> accordée, le débiteur ne peut plus contester son obligation de paiement."
                        }
                    ],
                    "common_phrases": [
                        "acceptation bancaire"
                    ]
                }
            ]
        }
    ]
