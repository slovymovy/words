                            {
                                "example_id": "71caf124-3980-42b8-b60b-5183a2d9232a",
                                "sense_id": "a3c183ec-b31d-3ab8-aa08-a5a32ee738db",
                                "text": "Литви́нов засну́л о́чень по́здно и спал недо́лго: со́лнце то́лько что вста́ло, когда́ он подня́лся с посте́ли.",
                                "translation": "Litvinov fell asleep very late, and did not sleep long; the sun had only just risen when he got out of bed.",
                                "english": "Litvinov fell asleep very late, and did not sleep long; the sun had only just risen when he got out of bed."
                            }
                        ]
