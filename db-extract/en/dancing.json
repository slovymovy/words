                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5277043-ade7-3b3f-afc8-a9800c59963d",
                        "entry_id": "16c9a587-0735-30dc-85ea-93a0ac9936bd",
                        "glosses": [
                            "The activity of taking part in a dance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "49f23268-f2a3-320b-bbdb-2d6024cd2aa8",
                        "entry_id": "16c9a587-0735-30dc-85ea-93a0ac9936bd",
                        "glosses": [
                            "A dance club in France."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "81c4320e-0f16-4569-b5df-3a1028bfb6a1",
                                "sense_id": "49f23268-f2a3-320b-bbdb-2d6024cd2aa8",
                                "text": "New dancings pervaded the length and breadth of Montmartre in order to suit the taste of foreign patrons."
                            },
                            {
                                "example_id": "00273bcf-13ab-472f-b98c-e0620bb42d8f",
                                "sense_id": "49f23268-f2a3-320b-bbdb-2d6024cd2aa8",
                                "text": "Different dancings also attracted different crowds. Indeed, the diversity of dancers throughout the city makes drawing a detailed portrait of them difficult."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c809417-3724-4972-b5c4-0cc2f0d975bf",
                        "source_entry_id": "16c9a587-0735-30dc-85ea-93a0ac9936bd",
                        "source_sense_description": "activity of dancing",
                        "target_lang_word": "dansen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dansen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3fa88990-bde4-3a11-84d8-d40547c63b79",
                                        "entry_id": "7b550ef4-4e3f-3393-af06-4e16c61fc0c1",
                                        "glosses": [
                                            "sierlijk en ritmisch bewegen, gewoonlijk op muziek"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4044b94-ae4c-40c2-b789-2395870f026e",
                                                "sense_id": "3fa88990-bde4-3a11-84d8-d40547c63b79",
                                                "text": "Er werd gedanst op muziek uit de jaren dertig."
                                            },
                                            {
                                                "example_id": "68901a17-c223-411e-92d2-caa238428b7d",
                                                "sense_id": "3fa88990-bde4-3a11-84d8-d40547c63b79",
                                                "text": "Mag ik met je dansen vroeg de verlegen jongen aan het meisje."
                                            },
                                            {
                                                "example_id": "3ab9a599-7ef8-4e82-a375-531ba70e0814",
                                                "sense_id": "3fa88990-bde4-3a11-84d8-d40547c63b79",
                                                "text": "Pogue deed wat geld in de jukebox, begon te dansen en zweepte iedereen op."
                                            },
                                            {
                                                "example_id": "47e9149c-ecae-40dc-90ca-0bc8c9d3c5aa",
                                                "sense_id": "3fa88990-bde4-3a11-84d8-d40547c63b79",
                                                "text": "In een vak waarin zich uitsluitend Brazilianen bevonden was het feest. Ze dansten dat het een lieve lust was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca044d3-8410-32c0-9798-1d755be6484a",
                                        "entry_id": "7b550ef4-4e3f-3393-af06-4e16c61fc0c1",
                                        "glosses": [
                                            "niet stilstaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a3aa2e-502c-4098-bb80-3d3cfdce305f",
                                                "sense_id": "aca044d3-8410-32c0-9798-1d755be6484a",
                                                "text": "Door de enorme vermoeidheid dansten de letters voor mijn ogen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dansen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d85b3110-f48c-3cf3-a23a-c421d4b8f59a",
