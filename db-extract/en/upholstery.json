                                        "entry_id": "4910b040-92f1-368f-b0f6-39bbd32411dc",
                                        "glosses": [
                                            "een laag stof ter versiering en bescherming aangebracht op een hard oppervlak of een meubelstuk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30623cce-ab9e-4a88-8c8a-ec15f5de9412",
                                                "sense_id": "d7c1b137-c54d-34fd-a95b-7ae5ef70ed0b",
                                                "text": "De bekleding van die stoel raakt los, die moeten we binnenkort laten repareren."
                                            },
                                            {
                                                "example_id": "9587d383-360a-4516-ad0f-414bd15c19c4",
                                                "sense_id": "d7c1b137-c54d-34fd-a95b-7ae5ef70ed0b",
                                                "text": "In de voorkamer stond een antiekrode leren chesterfieldfauteuil zij aan zij met een Louis xv -zetel die was voorzien van een oudroze fluwelen bekleding met een rozenmotief, en een voetbankje in ongeveer dezelfde kleur naast een prachtige achttiende-eeuwse salontafel met elegant houtsnijwerk."
                                            },
                                            {
                                                "example_id": "22adf584-5381-44af-9fb9-3f9286f176a0",
                                                "sense_id": "d7c1b137-c54d-34fd-a95b-7ae5ef70ed0b",
                                                "text": "Gelijktijdig sloeg ze met haar hand op de leren bekleding van de bank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
