                "senses": [
                    {
                        "sense_id": "447bdf60-b68a-37e9-8ef4-73dd87b44169",
                        "entry_id": "485b0b0c-9599-3b55-ad36-00c0e055bca3",
                        "glosses": [
                            "Having been used, as a sample item in a retail store."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4640fc-cfc1-40f7-bf66-935222f17fc2",
                                "sense_id": "447bdf60-b68a-37e9-8ef4-73dd87b44169",
                                "text": "The handbag looks nice, but shopworn."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b3d35eb-857a-3c79-9f5c-90369aa4d662",
                        "entry_id": "485b0b0c-9599-3b55-ad36-00c0e055bca3",
                        "glosses": [
                            "Faded."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b07f8a38-9e59-3702-a8b8-b0fa158930dd",
                        "entry_id": "485b0b0c-9599-3b55-ad36-00c0e055bca3",
                        "glosses": [
                            "Not fresh; tired or cliché."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "70426b9c-fa0a-4ccf-932e-1bcecfd2bca4",
                                "sense_id": "b07f8a38-9e59-3702-a8b8-b0fa158930dd",
                                "text": "New York is positioned as the third protagonist—literally, as the characters repeatedly tell each other. Recycled aerial footage of the city underlines just how generic this particular insight is. The whole film is like that, its dialogue constantly poking fun and calling attention to the shopworn conventions."
                            },
                            {
                                "example_id": "e0e8368b-36aa-45cf-b897-6a6ba176ae1e",
                                "sense_id": "b07f8a38-9e59-3702-a8b8-b0fa158930dd",
                                "text": "Musk is our avatar of infinite possibility, our usher to the remade world, where shopworn practices are cast aside and the unprecedented becomes logical, where Earth and humanity can still be saved."
                            }
                        ]
                    }
                ],
