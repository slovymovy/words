                ],
                "senses": [
                    {
                        "sense_id": "05653a42-0169-3e3d-aba3-3639ee9f474e",
                        "entry_id": "96f74991-8595-3207-8abb-b59549896761",
                        "glosses": [
                            "Personne ni trop grosse ni trop mince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce4ef75-11ec-44a8-aa37-3403f513771d",
                                "sense_id": "05653a42-0169-3e3d-aba3-3639ee9f474e",
                                "text": "Athlétique, le mésomorphe a une bonne base de masse musculaire."
                            },
                            {
                                "example_id": "cf189765-7b16-4d13-8ce7-ef82b03fa25a",
                                "sense_id": "05653a42-0169-3e3d-aba3-3639ee9f474e",
                                "text": "En plus de l’ectomorphe, il y a l’endomorphe et le mésomorphe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d6d7a3f-5acd-4aab-9705-e6e6489cd4e7",
                        "source_entry_id": "96f74991-8595-3207-8abb-b59549896761",
                        "source_sense_id": "05653a42-0169-3e3d-aba3-3639ee9f474e",
                        "target_lang_word": "mesomorph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesomorph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "918a3b46-d5de-3331-a4a7-c25d543ed2da",
                                        "entry_id": "61a46be3-2735-3e7d-ab42-ef0fca56b917",
                                        "glosses": [
                                            "A person with pronounced muscular development and low body fat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de8160c7-1ef0-4c87-992f-2446030dbe3e",
                                                "sense_id": "918a3b46-d5de-3331-a4a7-c25d543ed2da",
                                                "text": "They found that endomorphs had significantly greater asymmetry in arm fat than mesomorphs and ectomorphs. […] They can also achieve mesomorph qualities through resistance training (which builds muscle) and a balanced diet rich in protein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7a7b8d-f616-358e-b521-783eafa2d03b",
                                        "entry_id": "61a46be3-2735-3e7d-ab42-ef0fca56b917",
                                        "glosses": [
                                            "Theoretical body type in which a person naturally has lower body fat and greater ability to achieve muscular development than average."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
