                                        "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                        "entry_id": "0a556187-0f8d-3bc5-80d7-867294d40ff2",
                                        "glosses": [
                                            "die Landwirtschaft betreffend, auf ihr beruhend, von ihr herrührend, zu ihr gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a272cbe-01fa-49c3-b61d-549c9d78d881",
                                                "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                                "text": "Mein Vater hat einen landwirtschaftlichen Betrieb. Er ist Bauer."
                                            },
                                            {
                                                "example_id": "2a75a429-c319-4c32-918d-d365642ed8bd",
                                                "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                                "text": "Obwohl sie das Leben in der Großstadt mag, braucht sie die Natur und die Bodennähe, die ein landwirtschaftlicher Beruf mit sich bringt."
                                            },
                                            {
                                                "example_id": "00512143-8612-4f47-ae76-ea1aa55ddcce",
                                                "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühner und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1d0dd858-8077-3a84-8b2c-87150b0350dd",
                                        "entry_id": "0a556187-0f8d-3bc5-80d7-867294d40ff2",
                                        "glosses": [
                                            "der Landwirtschaft dienend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "047432d8-e139-4c92-8b97-5ca01a70c3bc",
                                                "sense_id": "1d0dd858-8077-3a84-8b2c-87150b0350dd",
                                                "text": "Diese [nachhaltige Landnutzung] sind nicht nur für die lokale Ernährungssicherung von hoher Relevanz, sondern auch für die landwirtschaftliche, medizinische und biotechnologische Forschung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
