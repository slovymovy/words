                "senses": [
                    {
                        "sense_id": "c5671cb9-1aa2-3e01-9332-4d2798c2c999",
                        "entry_id": "dc6618f4-3fdf-3356-8177-d3a40934ef9a",
                        "glosses": [
                            "Figure géométrique connexe quelconque, en deux, trois ou n dimensions."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5663f940-36d3-4e0b-90d7-fdf5260d9df5",
                                "sense_id": "c5671cb9-1aa2-3e01-9332-4d2798c2c999",
                                "text": "Les premières déviations ont substitué au carrefour giratoire du rond-point un vaste anneau routier de forme irrégulière, que nous appelons le « patatoïde » à l'intérieur duquel peut être construite toute la partie centrale du futur échangeur."
                            },
                            {
                                "example_id": "87c28631-5533-4228-a631-ec7e004cbb5e",
                                "sense_id": "c5671cb9-1aa2-3e01-9332-4d2798c2c999",
                                "text": "La forme de la Terre, qui selon les dires d'un éminent savant est une « patatoïde », vient perturber les meilleurs désirs et l'homme qui souhaiterait définir une trajectoire circulaire ne le peut pas."
                            },
                            {
                                "example_id": "dcee386b-839d-44bb-8d07-558bbb6bebfd",
                                "sense_id": "c5671cb9-1aa2-3e01-9332-4d2798c2c999",
                                "text": "Phobos, la plus grosse des deux lunes de Mars, a la forme d'un patatoïde et mesure environ 28 km x 23 km x 20 km. Elle est dominée par le cratère Stickney […]."
                            }
                        ]
                    }
