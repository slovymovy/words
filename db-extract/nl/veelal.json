                                    {
                                        "sense_id": "11d87044-a000-3ea6-a207-d6c534f21dba",
                                        "entry_id": "7265ffb2-0082-3ce3-bf3a-1766d21b61fd",
                                        "glosses": [
                                            "in der Mehrheit, vor allem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49861f74-66b2-4fbb-884f-1b839014890f",
                                                "sense_id": "11d87044-a000-3ea6-a207-d6c534f21dba",
                                                "text": "Die Bevölkerung ist überwiegend dagegen."
                                            },
                                            {
                                                "example_id": "a27605dc-4c3f-4686-b41c-9b299494329d",
                                                "sense_id": "11d87044-a000-3ea6-a207-d6c534f21dba",
                                                "text": "„Alicias Eltern, beide 1943 in Königsberg geboren, verbrachten ihre ersten zwei Lebensjahre überwiegend in Luftschutzkellern und auf der Flucht.“"
                                            },
                                            {
                                                "example_id": "8378a4b9-7432-4344-bfa1-7a2edc1ae4bf",
                                                "sense_id": "11d87044-a000-3ea6-a207-d6c534f21dba",
                                                "text": "„Die überwiegend auf Routenaufnahmen basierende Kartenherstellung wird wenig später durch das geodätische Verfahren der Triangulation ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
