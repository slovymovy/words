                        "examples": [
                            {
                                "example_id": "51cc3779-9b5f-4394-9275-336919a13c9a",
                                "sense_id": "44679ed5-1550-30d6-8aaa-a2550eade4fe",
                                "text": "Rochdale ontsloeg Möllenkamp in 2009. De Amsterdamse woningcorporatie maakte toen een miljoenenverlies en stond een tijd onder toezicht."
                            },
                            {
                                "example_id": "6c06a4a6-eccf-479d-9e7b-52fe79753260",
                                "sense_id": "44679ed5-1550-30d6-8aaa-a2550eade4fe",
                                "text": "Uit de laatste cijfers van Kijkshop blijkt dat er een miljoenenverlies wordt geleden. Over de periode van mei 2014 tot en met december 2015 was er een verlies van 20 miljoen euro. Ook over 2016 waren er rode cijfers, maar het bedrag is nog niet bekend. Het bedrijf schrijft in het laatste verslag dat de omzet in 2017 mogelijk herstelt."
                            }
                        ]
