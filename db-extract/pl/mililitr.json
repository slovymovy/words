                ],
                "translations": [
                    {
                        "translation_id": "811303c1-029d-4e24-8163-2c09dfb1e1d0",
                        "source_entry_id": "a0419781-b61f-3d08-b333-40f416476c94",
                        "source_sense_id": "e477a651-97ac-310c-9ee1-a6f5d7205cb3",
                        "target_lang_word": "millilitre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millilitre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                        "entry_id": "383f472b-e60a-3624-b941-22ba3c8af5a9",
                                        "glosses": [
                                            "A unit of measure of capacity, equal to one thousandth of a litre. Symbol: mL or ml."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34860cf6-312d-424f-af51-878d369ed4c4",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "Holonyms: litre < kilolitre < megalitre < gigalitre"
                                            },
                                            {
                                                "example_id": "f83c0881-93a0-4534-b490-b5c2316a84b4",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "Meronyms: picolitre < nanolitre < microlitre"
                                            },
                                            {
                                                "example_id": "14203f9e-4934-4e55-aea2-3268a54c4df7",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "A smaller mammal such as a dog has a sperm concentration of 300 000 000 per millilitre in an ejaculate of 8 ml in volume. Thus, each ejaculate will contain only 2 400 000 000 (24 × 10⁸)."
                                            },
                                            {
                                                "example_id": "49a5c039-916e-4a94-97fe-f61e593cb3ca",
                                                "sense_id": "4dd9be76-9c21-3179-943c-c1877765d0b8",
                                                "text": "One serve of carbohydrates is approximately equal to a slice of bread, a piece of fruit, third of a cup of cooked rice, half a cup of grains, cereals, starchy vegetables or cooked pasta, 200 grams of plain yoghurt, or 300 millilitres of milk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f730ab2-08be-4ca6-bce8-537184d59eb5",
                        "source_entry_id": "a0419781-b61f-3d08-b333-40f416476c94",
                        "source_sense_id": "e477a651-97ac-310c-9ee1-a6f5d7205cb3",
                        "target_lang_word": "milliliter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milliliter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac36eb60-c8ae-31c7-9f61-60820f0941b2",
                                        "entry_id": "63001388-cd71-35a7-85de-c85071be1fa6",
                                        "glosses": [
                                            "Alternative form of millilitre."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0125234-c602-4e6a-b124-34b3d8602b14",
                                                "sense_id": "ac36eb60-c8ae-31c7-9f61-60820f0941b2",
                                                "text": "A slurry of 10 grams of powder in 100 milliliters distilled water was carried on a cotton swab and the panels scrubbed until free from waterbreak when rinsed."
                                            },
                                            {
                                                "example_id": "ccdcf4f9-e403-4cf3-ad31-816ac0b9bd48",
                                                "sense_id": "ac36eb60-c8ae-31c7-9f61-60820f0941b2",
                                                "text": "The following day, nonattached cells were harvested by centrifugation and resuspended in growth medium at a density of 1 × 10⁷ per milliliter."
                                            },
                                            {
                                                "example_id": "d969d8e2-2c0b-4542-8755-d1913066ae11",
                                                "sense_id": "ac36eb60-c8ae-31c7-9f61-60820f0941b2",
                                                "text": "In addition to having a relative with Type 1, people in that subgroup had insulin autoantibody levels equal to or greater than 80 milliunits per milliliter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "712eaacf-9147-4111-8c7f-62592b74df94",
                        "source_entry_id": "a0419781-b61f-3d08-b333-40f416476c94",
