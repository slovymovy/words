                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "histologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd26fd0-f613-3f83-be71-afdd338feb66",
                                        "entry_id": "0aab6310-4759-391f-abd9-bbcc9c6fdaf6",
                                        "glosses": [
                                            "Science qui étudie des tissus organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0fa2e60-86d8-46cc-a10b-6ecfe8c9ea90",
                                                "sense_id": "5fd26fd0-f613-3f83-be71-afdd338feb66",
                                                "text": "Les développements de l’histologie, de la biochimie et de l’immunohistologie ont ensuite permis de mieux identifier les différents acteurs cellulaires et biologiques impliqués au cours du développement par le biais de marqueurs spécifiques des uns et des autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c368b455-766e-36b1-a232-7a80e2e04b64",
                                        "entry_id": "0aab6310-4759-391f-abd9-bbcc9c6fdaf6",
                                        "glosses": [
                                            "Analyse des tissus cellulaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ffd1cbb-2bfc-4240-8c12-0d04a25d895a",
                                                "sense_id": "c368b455-766e-36b1-a232-7a80e2e04b64",
                                                "text": "Sarkar et al. ont proposé le terme de phénomène plutôt que celui de syndrome, en raison de sa survenue sur des tumeurs vasculaires d’histologies distinctes."
                                            },
                                            {
                                                "example_id": "d041fb94-6b9c-4492-a366-6df74fc4541d",
                                                "sense_id": "c368b455-766e-36b1-a232-7a80e2e04b64",
                                                "text": "[Jean-Jacques Thomasset] donne ainsi des descriptions de l’histologie des dents de plusieurs espèces trouvées dans le bone bed et ailleurs, signale la présence de plusieurs types de dentine et en propose une classification, étudie les rapports entre l’ivoire et l’émail dentaire, se lance dans l’histologie comparée et précise la position systématique de poissons fossiles à partir de leur microstructure dentaire…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c44d9ba-38ef-3dda-98fa-6e7b5677dcd7",
                                        "entry_id": "0aab6310-4759-391f-abd9-bbcc9c6fdaf6",
                                        "glosses": [
                                            "Patient dont l'analyse a révélé une pathologie."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a2d03e3-74a1-42fb-b1df-38cabddf6044",
                                                "sense_id": "9c44d9ba-38ef-3dda-98fa-6e7b5677dcd7",
                                                "text": "Le traitement postopératoire sera d’un maximum de six mois pour les histologies à haut risque et les stades II et III."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
