                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34854329-686c-4183-b431-544e66ac14e9",
                                                "sense_id": "d0994134-4758-369d-9911-87d0d696d384",
                                                "text": "Češi, obzvláště skuteční Češi a čeští spisovatelé, jsou tak bedlivě a úzkostlivě pozorováni, že by můj revolucionářský článek (u nich by za takový platil) pokládán byl za smýšlení většiny a že by mohl ze strany tmářů ošklivou reakci vyvolati."
                                            }
                                        ]
