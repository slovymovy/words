                    ]
                },
                {
                    "sense_id": "f9734675-8861-3f78-b24b-85468264e2e0",
                    "sense_definition": "Agent de police ou représentant des forces de l'ordre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la vue de la patrouille, le manifestant a crié mort aux <w>vaches</w> avant de s'enfuir."
