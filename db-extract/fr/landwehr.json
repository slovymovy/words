                "forms": [],
                "senses": [
                    {
                        "sense_id": "320becbe-5148-3197-8c55-a1f2d9a433c9",
                        "entry_id": "f8e8a22e-13e0-37f3-a0c6-29b0a6796a2f",
                        "glosses": [
                            "Nom de l'armée prussienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23fcf4c2-523e-45a1-8299-ecef9254d271",
                                "sense_id": "320becbe-5148-3197-8c55-a1f2d9a433c9",
                                "text": "La landwehr sera progressivement armée du wetterli."
                            },
                            {
                                "example_id": "7e1baacc-68fc-4020-b390-596a6f957bbd",
                                "sense_id": "320becbe-5148-3197-8c55-a1f2d9a433c9",
                                "text": "Cette ville, que j'avais vue encombrée de troupes françaises, était alors occupée par une garnison de soldats de la landwehr."
                            }
                        ]
                    },
                    {
                        "sense_id": "88e5636b-9711-30c2-847f-2bf75f24e7c6",
                        "entry_id": "f8e8a22e-13e0-37f3-a0c6-29b0a6796a2f",
                        "glosses": [
                            "Nom de l'armée autrichienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79994d9c-b2bc-4f9b-b956-de87149c9075",
                                "sense_id": "88e5636b-9711-30c2-847f-2bf75f24e7c6",
                                "text": "On sait qu'il existe, en Autriche-Hongrie, trois armées : l'armée commune; l'armée autrichienne ou landwehr; l'armée hongroise, les honveds à côté desquels il y a, dans le royaume croate, quelques régiments de domobranci."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
