                        "sense_id": "196ecd96-91a2-3ccd-91dc-77fd80c38513",
                        "entry_id": "8830e1c5-6c16-3a18-b45b-082175a5974c",
                        "glosses": [
                            "Usure sous faible débattement."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "89f4796a-f3e9-4a1e-b98a-d8995e4f11a5",
                                "sense_id": "196ecd96-91a2-3ccd-91dc-77fd80c38513",
                                "text": "La corrosion-frottement et le « fretting-corrosion » sont dus à des pièces frottantes. Ils se distinguent par l'amplitude des déplacements relatifs qui permet ou ne permet pas d'évacuer hors de la zone frottante les débris formés par la dégradation des surfaces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74517edc-4458-42d1-8299-1528c6c83c78",
                        "source_entry_id": "8830e1c5-6c16-3a18-b45b-082175a5974c",
                        "source_sense_id": "196ecd96-91a2-3ccd-91dc-77fd80c38513",
                        "target_lang_word": "Fressen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fressen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "532fe909-0a14-31f2-8496-c4db92e9c611",
                                        "entry_id": "8e6f663c-ef08-3f89-b905-1a61a16e888f",
                                        "glosses": [
                                            "Vorgang, Handlung, bei dem beziehungsweise bei der gefressen wird"
                                        ],
                                        "tags": [
                                            "von Tieren; salopp oder emotional",
                                            "abwertend von Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c062985-8f57-41fb-9cab-bc149b1b5b3c",
                                                "sense_id": "532fe909-0a14-31f2-8496-c4db92e9c611",
                                                "text": "„Bei der Untersuchung zeigte sich, dass die Reptilien beim Fressen nicht nur feuchte Augen bekommen, sondern dass es aus den Tränendrüsen mitunter sogar regelrecht sprudelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                        "entry_id": "8e6f663c-ef08-3f89-b905-1a61a16e888f",
                                        "glosses": [
                                            "zubereitete Nahrung für bestimmte Haustiere, zur Mahlzeit hergerichtete, vorbereitete Speise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8acdd3-2fa7-4008-99cd-051356c51919",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "Sie gab der Katze ihr Fressen."
                                            },
                                            {
                                                "example_id": "4b9b4f24-f4e3-4fb9-ab6b-fd4e6c860318",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "Er schüttete seinem Hund das Fressen in den Fressnapf."
                                            },
                                            {
                                                "example_id": "f9416857-2dda-4728-8a51-25b07294dc27",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "Das Fressen in der Kaschemme war mies."
                                            },
                                            {
                                                "example_id": "2b19a5c0-9d5b-485f-9962-179fd347e909",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "„Vater sitzt zum ’zigsten Male, / wegen „Hm“ in Plötzensee, / und sein Schatz, der schimpft sich Male, / und der Mutter tut’s so weh! / Ja so gut wie der hat’s Keener, / Fressen kriegt er und noch mehr, / und er baumelt mit de Beene, / mit de Beene vor sich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "06912856-e4ec-3fd4-82df-c3a15d01dc0c",
                                        "entry_id": "8e6f663c-ef08-3f89-b905-1a61a16e888f",
                                        "glosses": [
                                            "infolge mangelhafter Schmierung und einer daraus entstehenden starken Reibungswärme sowie durch kontinuierliches mechanisches Bewegen, wiederholt entstehendes Verschweißen und Losreißen zweier Gleitpartner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d1c5521-effb-4f40-b888-dfe6aa1877a7",
                                                "sense_id": "06912856-e4ec-3fd4-82df-c3a15d01dc0c",
                                                "text": "Nicht ganz so schön aber auch nicht weiter kritisch ist das Fressen der oberen Pleuelaugen am Kolbenbolzen, das bei allen FZR Motoren festzustellen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
