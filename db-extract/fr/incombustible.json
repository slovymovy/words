                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df8f3df4-e77f-435a-8136-bb97b5af47dc",
                        "entry_id": "d6262a4f-9f74-3cca-98de-373c35262d06",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incombustibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "188246ad-e20b-3f9c-9039-79844f3419d3",
                        "entry_id": "d6262a4f-9f74-3cca-98de-373c35262d06",
                        "glosses": [
                            "Qui ne peut être brûlé, qui ne se consume pas au feu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af3c59a-08dd-43b8-8582-e1ecca82f65f",
                                "sense_id": "188246ad-e20b-3f9c-9039-79844f3419d3",
                                "text": "Les assistants ne demandaient pas mieux que de la laisser faire, croyant qu’elle était incombustible, et que le diable sauverait toujours une si méchante sorcière pour faire enrager les bons chrétiens."
                            },
                            {
                                "example_id": "a0067c71-3fee-40c4-a7f6-30eb48190d35",
                                "sense_id": "188246ad-e20b-3f9c-9039-79844f3419d3",
                                "text": "L'amiante est incombustible et infusible; ce qui fait qu'on en fait des étoffes permettant d'être utilisées contre le feu."
                            },
                            {
                                "example_id": "e00d70ed-88c4-4563-888b-55b5b96d091f",
                                "sense_id": "188246ad-e20b-3f9c-9039-79844f3419d3",
                                "text": "En 1903, un forage pétrolier à Dexter, dans le Kansas (États-Unis), suscite l’étonnement : le jet de gaz qui s’en échappe est incombustible !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43a777e8-e467-45f8-8817-3e07bd75560c",
                        "source_entry_id": "d6262a4f-9f74-3cca-98de-373c35262d06",
                        "source_sense_id": "188246ad-e20b-3f9c-9039-79844f3419d3",
                        "target_lang_word": "unbrennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbrennbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e79e1bb3-1711-3a34-b032-b7044bb0e067",
                                        "entry_id": "37025b93-c891-3d3b-8402-5392a50c2e9c",
                                        "glosses": [
                                            "nicht brennbar; feuerfest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f1cf78-ac3c-468d-9298-72e6290416c6",
                                                "sense_id": "e79e1bb3-1711-3a34-b032-b7044bb0e067",
                                                "text": "„Kohlenstoffdioxid ist ein saures, unbrennbares, farb- und geruchloses Gas, das sich gut in Wasser löst.“"
                                            },
                                            {
                                                "example_id": "194dc17c-05b4-4512-bb52-23f450606c2c",
                                                "sense_id": "e79e1bb3-1711-3a34-b032-b7044bb0e067",
                                                "text": "Sie [die Fluorchlorkohlenwasserstoffe (FCKW)] galten als billig, unbrennbar und vielfältig einsetzbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31b02134-67e6-403f-a8a3-1f1f7efdc1cd",
                        "source_entry_id": "d6262a4f-9f74-3cca-98de-373c35262d06",
                        "source_sense_id": "188246ad-e20b-3f9c-9039-79844f3419d3",
                        "target_lang_word": "feuerfest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuerfest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                        "entry_id": "85603fa7-8300-30bc-aee8-2a3901f2d0ea",
                                        "glosses": [
                                            "unempfindlich gegen die Auswirkungen von Feuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d12767c-d786-4520-9875-ef8f623adc69",
                                                "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                                "text": "Die wichtigen Firmenunterlagen werden in einem feuerfesten Tresor aufbewahrt."
                                            },
                                            {
                                                "example_id": "a7d671a4-ff15-4cbd-906d-54d12b3e8a73",
                                                "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                                "text": "„Feuerfest und wärmedämmend, hitze- und säurebeständig sind diese mineralischen Fasern – für die Anwendung in Bauten und Anlagen ideale Eigenschaften.“"
                                            },
                                            {
                                                "example_id": "b314da0b-b10e-4aad-8b25-91dc97144935",
                                                "sense_id": "36b0646c-ec93-331a-b24d-ce1d3744a785",
                                                "text": "„Über ihm, in dem Haus, zu dem der Pool gehört, ist Licht angegangen, und Kinder sehen aus ihren Schlafzimmerfenstern zu ihm herunter, warm und kuschelig in ihren Li'l Crips und Ninja-Krieger-Pyjamas, die entweder feuerfest oder nichtkrebserzeugend sein können, aber nicht beides zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1cec323-dee8-433d-9594-4cb27ecdc22e",
