                "senses": [
                    {
                        "sense_id": "c8d328ce-1e3b-3615-b6ee-0c0eeef8ad9e",
                        "entry_id": "19247b44-4df9-37bb-8e17-88d13f1d37b7",
                        "glosses": [
                            "Vivre en concubinage avec quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de8f9e4-a583-48bb-8756-947fc2df052c",
                                "sense_id": "c8d328ce-1e3b-3615-b6ee-0c0eeef8ad9e",
                                "text": "Pourquoi par exemple le Nambudiri, après avoir noué le tali, ne pourrait-il concubiner directement avec la fille Nayar ?"
                            },
                            {
                                "example_id": "7e463f00-0b56-469f-af20-21ebcc54cd52",
                                "sense_id": "c8d328ce-1e3b-3615-b6ee-0c0eeef8ad9e",
                                "text": "De Retz a été admiré par les hommes et les femmes de son temps, — même par celles avec qui il n'avait pas fait concubiner sa politique."
                            }
                        ]
                    }
