                                        "glosses": [
                                            "zwykle w lm: coś nieważnego, nieistotnego, błahego lub bezsensownego, drobiazg bez znaczenia"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7258c0b0-af95-4af9-b70c-5f44715172f1",
                                                "sense_id": "7cadcdd2-67a5-37e9-b837-7106356c9198",
                                                "text": "– Ale nie przyjechałeś tutaj przecież po to, żeby słuchać takich dyrdymałów, prawda?"
                                            },
                                            {
                                                "example_id": "a8be41ff-7bc5-4580-847d-9249be3e64f7",
                                                "sense_id": "7cadcdd2-67a5-37e9-b837-7106356c9198",
                                                "text": "Dzięki chorobie nauczyłem się doceniać małe rzeczy, a jednocześnie nie przejmować się każdą dyrdymałą."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
