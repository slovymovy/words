        "fr-extract.jsonl": [
            {
                "entry_id": "3107c2dd-65e8-3949-ba5d-6559b1d593d7",
                "word": "fixité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35e3aa1a-f065-4dc3-8e0b-1a5ad3e32efc",
                        "entry_id": "3107c2dd-65e8-3949-ba5d-6559b1d593d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "fixités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2e5bd7d-a993-3667-b7fc-b52ff8732c5c",
                        "entry_id": "3107c2dd-65e8-3949-ba5d-6559b1d593d7",
                        "glosses": [
                            "État de ce qui est fixe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5585c39-2022-4643-8c1d-19b2e3879f2e",
                                "sense_id": "a2e5bd7d-a993-3667-b7fc-b52ff8732c5c",
                                "text": "Ces institutions acquirent plus de fixité."
                            },
                            {
                                "example_id": "7f459600-7e8e-46b9-abaf-7670acebb2a1",
                                "sense_id": "a2e5bd7d-a993-3667-b7fc-b52ff8732c5c",
                                "text": "C’est un esprit sans fixité."
                            },
                            {
                                "example_id": "a6c8c07b-1d61-4f86-a87c-0776a406a3b6",
                                "sense_id": "a2e5bd7d-a993-3667-b7fc-b52ff8732c5c",
                                "text": "Ses idées n’ont aucune fixité."
                            },
                            {
                                "example_id": "0e361449-9316-4ca1-a9fe-e980fab6e0bb",
                                "sense_id": "a2e5bd7d-a993-3667-b7fc-b52ff8732c5c",
                                "text": "La fixité de ses opinions, de ses principes."
                            },
                            {
                                "example_id": "20cbe645-7068-4982-8d89-b78aa9a5566d",
                                "sense_id": "a2e5bd7d-a993-3667-b7fc-b52ff8732c5c",
                                "text": "La tentative qu’elle avait déjà faite auprès de son père la décourageait d’en essayer une nouvelle : elle le connaissait, et elle savait quelle fixité il apportait dans ses idées, – pour ne pas employer un autre mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a250ba0-db98-3bb4-874d-8e3546081397",
                        "entry_id": "3107c2dd-65e8-3949-ba5d-6559b1d593d7",
                        "glosses": [
                            "Absence d’évolution dans le temps."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9c780fa0-2739-4a6a-8b91-acad1bf46ded",
                                "sense_id": "0a250ba0-db98-3bb4-874d-8e3546081397",
                                "text": "Il vaut toujours mieux croiser avec une race dont la fixité est reconnue, qu’avec des types artificiels dont les caractères finissent souvent par se perdre."
                            },
                            {
                                "example_id": "265967c8-e00c-4af1-ac2b-c3fcbc30946d",
                                "sense_id": "0a250ba0-db98-3bb4-874d-8e3546081397",
                                "text": "Pour s’évader de la mentalité scolastique, il fallait répudier le réalisme des universaux […] ; qui conduisait à des théories erronées, telles que la fixité des espèces et la distinction ontologique des caractères essentiels et accidentels ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ffc670c-a7f8-35a4-8ac3-e02035af5db4",
                        "entry_id": "3107c2dd-65e8-3949-ba5d-6559b1d593d7",
                        "glosses": [
                            "Nature d’un regard qui s’attache ou semble s’attacher avec persistance à un objet, à une personne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "28f3dc8d-595b-4f7a-9230-fb6ae34bd7e5",
                                "sense_id": "5ffc670c-a7f8-35a4-8ac3-e02035af5db4",
                                "text": "Ses yeux avaient une fixité morbide."
                            },
                            {
                                "example_id": "1e6e62aa-111d-47d2-862a-6396629cf986",
                                "sense_id": "5ffc670c-a7f8-35a4-8ac3-e02035af5db4",
                                "text": "L’inquiétante fixité de son regard."
                            },
                            {
                                "example_id": "f00340f7-8d7b-4c32-9034-202a0f696a3a",
                                "sense_id": "5ffc670c-a7f8-35a4-8ac3-e02035af5db4",
                                "text": "Ses yeux noirs et pénétrants avaient la fixité de ceux des tigres."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
