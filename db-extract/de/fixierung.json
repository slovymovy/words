                "senses": [
                    {
                        "sense_id": "470f7671-6c41-3cea-9e6c-6068b49b4f6f",
                        "entry_id": "0296329b-7514-37c1-a10e-39867bf1d891",
                        "glosses": [
                            "das Befestigen von jemandem oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f125692c-c7c7-4fe0-9fdb-77048ff3e3b2",
                                "sense_id": "470f7671-6c41-3cea-9e6c-6068b49b4f6f",
                                "text": "„Nach baden-württembergischen Landesrecht kann es beispielsweise genügen, wenn ein Arzt die Fixierung anordnet.“"
                            },
                            {
                                "example_id": "e7b6f479-945f-4330-addd-6ae302a5bfe4",
                                "sense_id": "470f7671-6c41-3cea-9e6c-6068b49b4f6f",
                                "text": "„Analog der orthopädischen Fixierung sollte das Festbinden auf den Zwangsstuhl die Unbotmäßigkeit des Irren, seine geistige Verkrümmung, korrigieren, begradigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "371738af-0d8b-33ff-8db2-a23b831c7faf",
                        "entry_id": "0296329b-7514-37c1-a10e-39867bf1d891",
                        "glosses": [
                            "Hilfsmittel zum Befestigen von jemandem oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7efa4f78-79db-4edf-8f21-4e7bfbd78c49",
                                "sense_id": "371738af-0d8b-33ff-8db2-a23b831c7faf",
                                "text": "Die Fixierung war mit Lammfell gepolstert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "383c3223-7c4a-31d3-99d9-68d0ca7ab3be",
                        "entry_id": "0296329b-7514-37c1-a10e-39867bf1d891",
                        "glosses": [
                            "das schriftliche Festhalten von Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b2d299-92c6-4306-9868-ea81e40e590c",
                                "sense_id": "383c3223-7c4a-31d3-99d9-68d0ca7ab3be",
                                "text": "Ich bestehe auf einer schriftlichen Fixierung unserer Absprache."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9fd4a1da-1027-3826-a675-c820a8d17c8f",
