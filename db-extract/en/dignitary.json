                                        "sense_id": "bd2e57de-f97c-336d-88d1-2c5edd8ff57d",
                                        "entry_id": "1804d2cb-3630-3af8-a531-22f7ef16846c",
                                        "glosses": [
                                            "iemand die een hoog ambt bekleedt of anderszins een hoge positie in de Kerk of maatschappij bezit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5524488-fb76-4618-91b8-9e329012b254",
                                                "sense_id": "bd2e57de-f97c-336d-88d1-2c5edd8ff57d",
                                                "text": "De koning, de kardinaal, de bisschop, de ministers en vele andere hoogwaardigheidsbekleders woonden de plechtigheid bij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65d5ae98-41f5-4539-9601-de3bde4ab5d3",
