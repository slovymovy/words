                "senses": [
                    {
                        "sense_id": "1ff1c282-222e-3609-8beb-77ce580d12d3",
                        "entry_id": "76f2cf9b-53d7-3bf6-818e-407311357dd4",
                        "glosses": [
                            "das Unsterblich-Machen (die Verleihung der Eigenschaft des unbegrenzten Lebens) einer Zelle"
                        ],
                        "tags": [
                            "Cytologie"
                        ],
                        "examples": [
                            {
                                "example_id": "566d3191-fbfc-4dca-883a-13ae31194b10",
                                "sense_id": "1ff1c282-222e-3609-8beb-77ce580d12d3",
                                "text": "„Bereits 1963 wurde von Todaro und Green gezeigt, dass ein bestimmtes Passagierungsprotokoll zur spontanen Immortalisierung von murinen embryonalen Fibroblasten (MEF) führt“"
                            },
                            {
                                "example_id": "e94ed385-c8cc-4c3b-8e0f-4a08881f1398",
                                "sense_id": "1ff1c282-222e-3609-8beb-77ce580d12d3",
                                "text": "„Prinzipiell gilt, dass für eine Immortalisierung sowohl von humanen als auch von murinen Zellen Mechanismen inaktiviert werden müssen, die das Replikationslimit begrenzen.“"
                            },
                            {
                                "example_id": "52e18b14-53bc-411f-bbcf-6060d0db2fa4",
                                "sense_id": "1ff1c282-222e-3609-8beb-77ce580d12d3",
                                "text": "„Ziel [der] Arbeit war es, mit Hilfe von Mutanten den Einfluss der Proteine BALF1, BHRF1 und LMP2A von Epstein-Barr Virus (EBV) auf die B-Zell-Immortalisierung zu bestimmen.“"
                            },
                            {
                                "example_id": "9acc2e8b-96d7-48e0-9446-3a4df63dacb0",
                                "sense_id": "1ff1c282-222e-3609-8beb-77ce580d12d3",
                                "text": "„Um mesenchymale Stammzellen (MSC) umfassend zu verstehen, haben wir die Strategie der konditionalen Immortalisierung mittels Tetrazyklin-induzierbaren SV40 Large T Antigen verwendet, die es uns ermöglicht MSCs aus Knochenmark zu kultivieren und zu klonieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
