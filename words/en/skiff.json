                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Skiff</w> gave an inspiring lecture on maritime history.",
                            "target_lang_translations": {
                                "de": "Professor <w>Skiff</w> hielt eine inspirierende Vorlesung über Seefahrtsgeschichte."
                            }
                        },
                        {
                            "text": "We met the <w>Skiff</w> family during our summer holiday in the village.",
                            "target_lang_translations": {
                                "de": "Wir lernten die Familie <w>Skiff</w> während unseres Sommerurlaubs im Dorf kennen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Skiff",
                                "target_lang_sense_clarification": "Familienname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}