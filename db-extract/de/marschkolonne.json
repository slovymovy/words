                    {
                        "sense_id": "9afcfdd9-121b-3223-8012-76bc4c17082d",
                        "entry_id": "349086bc-35a3-361e-a13a-f6ef023b38cd",
                        "glosses": [
                            "Kolonne, die sich auf dem Marsch befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c6f1b52-423c-4ad2-b72f-9cb377bb40da",
                                "sense_id": "9afcfdd9-121b-3223-8012-76bc4c17082d",
                                "text": "„Die Marschkolonne hielt.“"
                            },
                            {
                                "example_id": "2f7c099a-7d46-4d3e-a58a-c3bf1c0035f1",
                                "sense_id": "9afcfdd9-121b-3223-8012-76bc4c17082d",
                                "text": "„In drei Marschkolonnen bewegte sich die Armee auf den Strom zu, Martins Regiment wurde zur mittleren der drei Brücken beordert.“"
                            },
                            {
                                "example_id": "b338551b-9e71-48eb-a4bc-7a5fb274af88",
                                "sense_id": "9afcfdd9-121b-3223-8012-76bc4c17082d",
                                "text": "„Fürst Andrej streifte mit verächtlichen Blicken diese endlosen, ineinander verhaspelten Marschkolonnen, Wagen, Parks, Artillerie und wieder Wagen, Wagen, Wagen aller nur möglichen Arten, die einander zu überholen suchten, sich zu dreien, zu vieren nebeneinander drängten und die schutzige Landstraße versperrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
