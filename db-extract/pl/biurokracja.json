                    {
                        "translation_id": "b5d1b39d-2cc8-49ff-9dc8-79fee5e873c4",
                        "source_entry_id": "eafb8919-d5b4-3743-8c08-1c165c233a76",
                        "source_sense_id": "f692cfeb-e8a8-35f5-8478-daa2a03a5943",
                        "target_lang_word": "бюрократия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бюрократия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ff64079d-17c3-3e33-b27e-cb33f37cf432",
                                        "entry_id": "c522cd91-245d-31bb-b242-964f932b5793",
                                        "glosses": [
                                            "система управления обществом, в которой реальная власть принадлежит чиновничеству"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d066f087-51b8-49c9-9a04-c92ded00008e",
                                                "sense_id": "ff64079d-17c3-3e33-b27e-cb33f37cf432",
                                                "text": "Административный характер обществ на этой ступени развития ― бюрократия, составляющая полнейший контраст первобытному племенному быту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "927c55a7-f190-3424-a44e-8552a8f4b141",
                                        "entry_id": "c522cd91-245d-31bb-b242-964f932b5793",
                                        "glosses": [
                                            "прослойка канцелярских служащих, чиновничество, номенклатура"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2023af54-a114-410e-820c-17ebd4419184",
                                                "sense_id": "927c55a7-f190-3424-a44e-8552a8f4b141",
                                                "text": "Первый распад империи Хань в эпоху Ван Мана протекал по иной схеме: вышла из повиновения конфуцианская бюрократия, двести лет бывшая оплотом имперского режима."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef7347b-78cb-30b2-a04f-1448d655c161",
                                        "entry_id": "c522cd91-245d-31bb-b242-964f932b5793",
                                        "glosses": [
                                            "перен. бюрократизм, формализм в ведении дел, пренебрежение существом дела ради соблюдения формальностей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141a96a4-b920-4138-940f-d6a4a717ab91",
                                                "sense_id": "2ef7347b-78cb-30b2-a04f-1448d655c161",
                                                "text": "Бюрократию развели, понимаешь!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
