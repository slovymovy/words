                "senses": [
                    {
                        "sense_id": "f03a5044-7a58-35fb-8dca-4d364afd37b5",
                        "entry_id": "80118b8f-66a2-321e-92f7-64d78edf8372",
                        "glosses": [
                            "Nahrung für Babys und Kleinkinder in Form einer feinen Masse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a689d7ed-29ff-4119-a217-6bc2ca87800c",
                                "sense_id": "f03a5044-7a58-35fb-8dca-4d364afd37b5",
                                "text": "„Plötzlich haut der eine Säugling dem andern die Klapper auf den Kopf, daß dem sein Säuglingsbrei aus dem Gesicht fällt.“"
                            },
                            {
                                "example_id": "4d31448b-49d8-495f-83f2-dae6a0d5121e",
                                "sense_id": "f03a5044-7a58-35fb-8dca-4d364afd37b5",
                                "text": "„In dieser Küche wird aus dem Magermilchpulver eine Art Säuglingsbrei hergestellt.“"
                            },
                            {
                                "example_id": "a1d9f0ac-5574-4b20-98a2-0d71270f1d30",
                                "sense_id": "f03a5044-7a58-35fb-8dca-4d364afd37b5",
                                "text": "„In der Klinik kommen die Säuglingsbreie fertiggekocht und numeriert aus der Milchküche und werden, wie die Flaschen, vor der betreffenden Mahlzeit im Wasserbad erwärmt.“"
                            },
                            {
                                "example_id": "ff81cef9-b895-46b4-bae3-7100cc98eed0",
                                "sense_id": "f03a5044-7a58-35fb-8dca-4d364afd37b5",
                                "text": "„Kehrt zurück zu euren Müttern und löffelt Säuglingsbrei aus dem Napf!“"
                            },
                            {
                                "example_id": "16224008-6396-4659-83e3-87950d29f21d",
                                "sense_id": "f03a5044-7a58-35fb-8dca-4d364afd37b5",
                                "text": "„Zehn mal hielt ich ihr den Säuglingsbrei zum Abschmecken unter die Nase, sie sollte endlich ihr Ok dazu geben und zehn mal ließ sie mich nachsalzen und umrühren […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
