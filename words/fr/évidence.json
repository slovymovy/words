                    "frequency": "Middle",
                    "semantic_group_id": "truisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier n'a fait que répéter des <w>évidences</w> sans apporter la moindre idée nouvelle."
                        },
                        {
