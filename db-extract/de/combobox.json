                        "sense_id": "db565a16-ae5d-3ed5-adfd-f4b065d3f3db",
                        "entry_id": "210b3ff2-aff6-3c52-b191-bd398c7f35a4",
                        "glosses": [
                            "ein Kombinationsfeld"
                        ],
