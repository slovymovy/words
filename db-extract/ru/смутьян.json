                                "target_senses": [
                                    {
                                        "sense_id": "1c95bb45-734f-3b3d-9710-35c98bea629a",
                                        "entry_id": "f501c2f9-a1fa-3feb-9938-a6e0664e3ef5",
                                        "glosses": [
                                            "Celui qui cause du trouble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57f37e2-8fbd-4b29-b92a-1501ec58cb8c",
                                                "sense_id": "1c95bb45-734f-3b3d-9710-35c98bea629a",
                                                "text": "Perturbateur du repos public."
                                            },
                                            {
                                                "example_id": "10a6aefe-e2f1-4f0e-8214-4cf6e932b110",
                                                "sense_id": "1c95bb45-734f-3b3d-9710-35c98bea629a",
                                                "text": "Il y a eu du désordre dans cette réunion et l’on dut expulser les perturbateurs."
                                            },
                                            {
                                                "example_id": "a45c2c40-5363-4cd2-ac49-f8ea05491e94",
                                                "sense_id": "1c95bb45-734f-3b3d-9710-35c98bea629a",
                                                "text": "Reconnaissant la gêne qu'il cause aux autres, il se donne l'identité d'un perturbateur, mais renvoie une mauvaise image des autres, maîtres ou élèves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perturbateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a516782f-1f59-3cad-8844-22e1687984ea",
                                        "entry_id": "baa6e403-c7f5-3c00-b524-6cbbc85dd391",
                                        "glosses": [
                                            "Qui perturbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dbbd3bf-4350-4c4f-898f-15f8f3c1ad61",
                                                "sense_id": "a516782f-1f59-3cad-8844-22e1687984ea",
                                                "text": "Les élèves perturbateurs, c'est à la schlague qu'il faut les remettre au pas. Quant aux parents démissionnaires, on va leur supprimer les allocs !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "547ace25-2661-3e8a-a531-2c097bc46636",
