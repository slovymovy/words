                "senses": [
                    {
                        "sense_id": "d5ddebd3-a0b5-3b92-8378-efe88cf25470",
                        "entry_id": "e65ba837-9921-33b9-a87b-fbe0106837e3",
                        "glosses": [
                            "A former subunit of currency equal to one-hundredth of the franc."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b015b650-7d98-3eb0-99e9-d7e6c8da2c16",
                        "entry_id": "e65ba837-9921-33b9-a87b-fbe0106837e3",
                        "glosses": [
                            "A coin having face value of one centime."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c08ea3e6-d4a1-41e2-8d94-38dcfebda4fd",
                        "source_entry_id": "e65ba837-9921-33b9-a87b-fbe0106837e3",
                        "source_sense_description": "subunit of currency",
                        "target_lang_word": "centime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd955a96-6b15-3ee2-87c1-a03c0b7e57bd",
                                        "entry_id": "f91ea20b-c278-36f1-88aa-f4d9b6cdb2e5",
                                        "glosses": [
                                            "La centième partie du franc."
                                        ],
                                        "tags": [
                                            "Système monétaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d0dd11-d6a3-49f0-8f08-69ca24ef36e0",
                                                "sense_id": "cd955a96-6b15-3ee2-87c1-a03c0b7e57bd",
                                                "text": "Les ouvriers occupés à la fouille et à l’extraction des coquins bruts, travaillent à la tâche ; on les paye à raison de 33 centimes le mètre cube de minerai extrait. Les bons ouvriers gagnent 3 fr 50 par jour."
                                            },
                                            {
                                                "example_id": "52272ca6-4cad-4954-a3f8-290239306a3a",
                                                "sense_id": "cd955a96-6b15-3ee2-87c1-a03c0b7e57bd",
                                                "text": "On demanda aux enfants des écoles d’apporter une obole. Je donnai une pièce de cinq sous en nickel dont la valeur faciale, vingt-cinq centimes, était inscrite en grands chiffres dans un cadre."
                                            },
                                            {
                                                "example_id": "e6f5b291-6c18-449c-99ae-12ecd5f4786a",
                                                "sense_id": "cd955a96-6b15-3ee2-87c1-a03c0b7e57bd",
                                                "text": "Après plusieurs années de nouveaux francs, la monnaie française retrouva son appellation officielle de francs, sans aucun adjectif les précédant ou les suivant. Mais un pourcentage important de personnes, pas obligatoirement âgées, continua à tout calculer en anciens francs, tandis qu'une autre partie parlait de nouveaux francs ou francs lourds, et de centimes pour les anciens francs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b87e44-6d1a-37e6-bea5-48ba077f5bf7",
                                        "entry_id": "f91ea20b-c278-36f1-88aa-f4d9b6cdb2e5",
                                        "glosses": [
                                            "La centième partie de l’euro."
                                        ],
                                        "tags": [
                                            "Système monétaire européen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b2c6b9-85d3-4db5-83c0-07e9b3b375ce",
                                                "sense_id": "66b87e44-6d1a-37e6-bea5-48ba077f5bf7",
                                                "text": "Un centime. Une pièce d’un centime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80882a61-5ff3-32f7-b3be-8f26a6abbf42",
                                        "entry_id": "f91ea20b-c278-36f1-88aa-f4d9b6cdb2e5",
                                        "glosses": [
                                            "Pièce de valeur faciale de un centime."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
