                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oficjalne_przekazanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Delegacja oficjalnie <w>złożyła</w> kwiaty pod pomnikiem bohaterów narodowych.",
