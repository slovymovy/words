                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d2a8cd8-f1a0-4907-aee2-ce9695b4dad6",
                        "source_entry_id": "af018ee5-d813-3e13-8dde-c25799c6ac59",
                        "target_lang_word": "Cut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38dac5f7-d209-31f6-9f99-55a311715db4",
                                        "entry_id": "87657a6a-a51f-3052-b8c1-912089b227b8",
                                        "glosses": [
                                            "kurz für Cutaway, festlicher Anzug für den Tag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d206e639-63ba-4eea-8734-e99a5f0d496b",
                                                "sense_id": "38dac5f7-d209-31f6-9f99-55a311715db4",
                                                "text": "Der Bräutigam erschien festlich gekleidet mit Cut und Zylinder sowie der obligatorischen weißen Chrysantheme im Knopfloch."
                                            },
                                            {
                                                "example_id": "89afe866-2aec-4657-a7b4-5750e57b0449",
                                                "sense_id": "38dac5f7-d209-31f6-9f99-55a311715db4",
                                                "text": "„Der Cut ist schwarz, die Weste weiß, die Haare sind rot - er ist eine lebendige Fahnenstange.“"
                                            },
                                            {
                                                "example_id": "9b1504ce-8323-4a6f-8011-09533c56ee6e",
                                                "sense_id": "38dac5f7-d209-31f6-9f99-55a311715db4",
                                                "text": "„Gareis hat seinen grauen flauschigen Lodenmantel über den Cut geworfen und geht zwischen dem Stadtverordneten Geier und dem Parteisekretär Nothmann auf und ab.“"
                                            },
                                            {
                                                "example_id": "aeed4dcb-65c4-45e8-bc7f-b7ffc31fb2db",
                                                "sense_id": "38dac5f7-d209-31f6-9f99-55a311715db4",
                                                "text": "„Mein Einfall war närrisch, was soll es helfen, wenn ein Herr um sechs Uhr früh in Cut und Monokel die Tür öffnet, in diesem Augenblick erscheint er mir die Rettung.“"
                                            },
                                            {
                                                "example_id": "e8fda651-3f6b-49af-8c2d-49c99cb90eec",
                                                "sense_id": "38dac5f7-d209-31f6-9f99-55a311715db4",
                                                "text": "„Oberst Blount, in grauem Cut, kam um elf Uhr herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df120ec9-8e89-32d3-b1a4-0f7e2337fa81",
                                        "entry_id": "87657a6a-a51f-3052-b8c1-912089b227b8",
                                        "glosses": [
                                            "Schnittstelle, Trennstelle zwischen zwei Einstellungen"
                                        ],
                                        "tags": [
                                            "Film"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be54685e-c3fd-4ce3-b63e-da43fa5fc7fb",
                                                "sense_id": "df120ec9-8e89-32d3-b1a4-0f7e2337fa81",
                                                "text": "Das ist einer der härtesten Cuts in einem Film, die ich je gesehen habe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9177c058-66ae-312a-a637-bf8bfb5be9c7",
                                        "entry_id": "87657a6a-a51f-3052-b8c1-912089b227b8",
                                        "glosses": [
                                            "vom Disc Jockey gestalteter Übergang zwischen zwei Songs"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd7baa2-fb45-41b7-a2e7-cdaff6dc8fd4",
                                                "sense_id": "9177c058-66ae-312a-a637-bf8bfb5be9c7",
                                                "text": "Aus dem Live-Mitschnitt ist ein nettes Album geworden. Ich finde es schön, wie die Musik im Cut zwischen den Songs weiterläuft, er also erstmal nur ein paar Takte der neuen Melodie reincuttet, das geht dann eher so sanft ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "56706b4a-2752-391a-96dd-1146f86e439d",
                                        "entry_id": "87657a6a-a51f-3052-b8c1-912089b227b8",
                                        "glosses": [
                                            "bei einem vierrundigen Golfturnier die Schlaganzahl nach zwei Runden, die zur Teilnahme an den beiden letzten Runden berechtigt"
                                        ],
                                        "tags": [
                                            "Golf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc68dc9-a00c-4b4c-9074-10d8239353a4",
                                                "sense_id": "56706b4a-2752-391a-96dd-1146f86e439d",
                                                "text": "Trotz einer starken zweiten Runde hatte er den Cut um einen Schlag verpasst und musste nach Hause fahren."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8ce7ea69-6487-3708-abf5-da45c40af07e",
                                        "entry_id": "87657a6a-a51f-3052-b8c1-912089b227b8",
                                        "glosses": [
                                            "Verletzung, Riss der Haut"
                                        ],
                                        "tags": [
                                            "Boxen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e14157f1-66a2-417b-bbcb-7bcd89bfdae6",
                                                "sense_id": "8ce7ea69-6487-3708-abf5-da45c40af07e",
                                                "text": "Der Cut über dem Auge blutete so stark, dass der Kampf abgebrochen werden musste."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "dfcdfce3-b403-3ed7-b7be-fe72d9ac9f2f",
                                        "entry_id": "87657a6a-a51f-3052-b8c1-912089b227b8",
                                        "glosses": [
                                            "Ereignis, nach dem eine Situation deutlich anders ist als vorher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959ccb25-d4aa-41b4-8b6f-d7837182f138",
                                                "sense_id": "dfcdfce3-b403-3ed7-b7be-fe72d9ac9f2f",
                                                "text": "Das war schon ein deutlicher Cut, keine Dienstreisen mehr, keine Seminarteilnahmen. Plötzlich war ich nichts mehr wert, so kam es mir vor."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "588ab8f4-972d-4aae-bfad-61b46a5f6706",
                        "source_entry_id": "af018ee5-d813-3e13-8dde-c25799c6ac59",
                        "target_lang_word": "Cutaway",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cutaway",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "879b50b6-43f1-3f46-ab8b-ee8134351220",
                                        "entry_id": "f64e8ba3-f2bb-3d24-a091-34979382f5b4",
                                        "glosses": [
                                            "festlicher Anzug für den Tag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0d52ac-01a7-4376-a5d9-8ea94cbf9d76",
                                                "sense_id": "879b50b6-43f1-3f46-ab8b-ee8134351220",
                                                "text": "„Er trug einen Cutaway.“"
                                            },
                                            {
                                                "example_id": "309a95bb-4748-4ea1-ac09-920bb234eb1e",
                                                "sense_id": "879b50b6-43f1-3f46-ab8b-ee8134351220",
                                                "text": "„Es stellte sich heraus, daß dieser Herr im Cutaway ein Schneider war, den die gnädige Frau bestellt hatte, und dieser Herr hatte, nach den Angaben der gnädigen Frau, bereits einen Anzug mitgebracht.“"
                                            },
                                            {
                                                "example_id": "d2d87040-5c22-4bbb-8f61-cbdf0fa1d240",
                                                "sense_id": "879b50b6-43f1-3f46-ab8b-ee8134351220",
                                                "text": "„So ein Cutaway steckt meinem Vater im Kopf.“"
                                            },
                                            {
                                                "example_id": "8f07055d-4bb9-4bec-9bf4-5a7f546b68f2",
                                                "sense_id": "879b50b6-43f1-3f46-ab8b-ee8134351220",
                                                "text": "„Mit ungetrübter Freude nahm er O'Donnels Cutaway zur Kenntnis; die Streifen des Beinkleides waren zu schmal, und über das Plastron ließ sich ebenfalls manches sagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b7a0afb-d3e7-4044-8342-7e825e6a8592",
                        "source_entry_id": "af018ee5-d813-3e13-8dde-c25799c6ac59",
