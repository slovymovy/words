                        "entry_id": "f41450d3-66f5-3076-a399-304fd4a350ca",
                        "glosses": [
                            "informelle Geste zur Begrüßung, bei der zwei Personen ihre Fäuste kurz gegeneinanderdrücken"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "90d256ab-039b-47c5-bf35-59e9efbaecd7",
                                "sense_id": "11f1a4e1-4be5-3bb1-9029-a309850e273c",
                                "text": "In der Pandemie hat sich auch bei geschäftlichen Begegnungen die Ghettofaust zur Begrüßung durchgesetzt."
                            },
                            {
                                "example_id": "049714b4-225b-442c-b7b3-8ea2456a33df",
                                "sense_id": "11f1a4e1-4be5-3bb1-9029-a309850e273c",
                                "text": "„Zur Begrüßung hat Merkel mir eine Ghettofaust gegeben.“"
                            }
                        ],
