                ],
                "senses": [
                    {
                        "sense_id": "c2ddcebe-1cec-311f-b736-1a2067f67c5a",
                        "entry_id": "0839668c-151b-3416-af55-e5d4ea3f6451",
                        "glosses": [
                            "The head."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1f74342a-8121-470d-8839-735a534764e7",
                                "sense_id": "c2ddcebe-1cec-311f-b736-1a2067f67c5a",
                                "text": "Leo[ntes]: Thou want′ſt a rough paſh, & the shoots that I haue, / To be full like me:"
                            }
                        ]
                    }
                ],
