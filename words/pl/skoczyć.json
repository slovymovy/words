    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4dd71d73-4c45-3427-89d9-203c87970b1b",
                    "sense_definition": "Wykonać gwałtowny ruch, odrywając się od podłoża i przemieszczając w powietrzu; aspekt dokonany od: <w>skakać</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tomek bez wahania <w>skoczył</w> do zimnej wody.",
                            "target_lang_translations": {
                                "ru": "Томек без колебаний <w>прыгнул</w> в холодную воду.",
                                "en": "Tomek <w>jumped</w> into the cold water without hesitation."
                            }
                        },
                        {
                            "text": "Kot przyczaił się i zwinnie <w>skoczył</w> na wysoki płot.",
                            "target_lang_translations": {
                                "ru": "Кот притаился и ловко <w>прыгнул</w> на высокий забор.",
                                "en": "The cat crouched and nimbly <w>leaped</w> onto the high fence."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skoczyć do wody",
                        "skoczyć na nogi",
                        "skoczyć z radości",
                        "skoczyć w ogień"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить резкое движение, отрываясь от поверхности и перемещаясь в воздухе; совершенный вид от: <w>skakać</w>",
                        "en": "To perform a sudden movement by pushing off the ground and moving through the air; perfective aspect of 'skakać'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгнуть",
                                "target_lang_sense_clarification": "совершить прыжок"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "jump",
                                "target_lang_sense_clarification": "to push oneself off a surface into the air"
                            },
                            {
                                "target_lang_word": "leap",
                                "target_lang_sense_clarification": "to jump a long distance or with great force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4999cb9a-c167-3d60-b7cd-18853347e2eb",
                    "sense_definition": "Udać się gdzieś szybko, zazwyczaj na krótki czas i w konkretnym celu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_colloquial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę szybko <w>skoczyć</w> na pocztę, żeby wysłać ten list.",
                            "target_lang_translations": {
                                "ru": "Мне нужно быстро <w>сбегать</w> на почту, чтобы отправить это письмо.",
                                "en": "I need to <w>pop</w> to the post office quickly to send this letter."
                            }
                        },
                        {
                            "text": "<w>Skocz</w> proszę do sklepu po świeże bułki na śniadanie.",
                            "target_lang_translations": {
                                "ru": "<w>Сбегай</w>, пожалуйста, в магазин за свежими булочками к завтраку.",
                                "en": "Please <w>run</w> to the store for some fresh rolls for breakfast."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skoczyć do sklepu",
                        "skoczyć na chwilę",
                        "skoczyć na miasto",
                        "skoczyć na piwo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро отправиться куда-либо, обычно ненадолго и с конкретной целью",
                        "en": "To go somewhere quickly, usually for a short time and for a specific purpose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбегать",
                                "target_lang_sense_clarification": "быстро сходить куда-то и вернуться"
                            },
                            {
                                "target_lang_word": "заскочить",
                                "target_lang_sense_clarification": "зайти ненадолго по пути"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "pop",
                                "target_lang_sense_clarification": "to go somewhere quickly and briefly (informal)"
                            },
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to go somewhere quickly to perform a task"
                            },
                            {
                                "target_lang_word": "drop by",
                                "target_lang_sense_clarification": "to visit someone or a place briefly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
