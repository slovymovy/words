{
    "word_family": [
        "eyebrow",
        "browbeat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5881602-e75a-32ba-bad0-3f0481a07d45",
                    "sense_definition": "The forehead.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wiped the sweat from her <w>brow</w> after the long run.",
                            "target_lang_translations": {
                                "zh": "长跑后，她擦去了<w>额头</w>上的汗水。",
                                "ru": "После долгого бега она вытерла пот со своего <w>лба</w>."
                            }
                        },
                        {
                            "text": "He had a deep wrinkle across his <w>brow</w> while thinking.",
                            "target_lang_translations": {
                                "zh": "他思考时，<w>额头</w>上出现了一道深深的皱纹。",
                                "ru": "Когда он думал, на его <w>лбу</w> пролегла глубокая морщина."
                            }
                        }
                    ],
                    "synonyms": [
                        "forehead"
                    ],
                    "common_phrases": [
                        "wipe brow"
                    ],
                    "target_lang_definitions": {
                        "zh": "前额，额头。",
                        "ru": "Лоб, передняя часть головы."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "额头",
                                "target_lang_sense_clarification": "指人的前额部位。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лоб",
                                "target_lang_sense_clarification": "Анатомическая часть лица над бровями."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03f1c5ff-6019-3f3e-8dd8-f4b2e6889755",
                    "sense_definition": "The eyebrow.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She raised one <w>brow</w> in surprise at the news.",
                            "target_lang_translations": {
                                "zh": "听到这个消息，她惊讶地挑起了一侧<w>眉毛</w>。",
                                "ru": "Услышав новости, она удивленно приподняла одну <w>бровь</w>."
                            }
                        },
                        {
                            "text": "He has a thick <w>brow</w> that makes him look serious.",
                            "target_lang_translations": {
                                "zh": "他有着浓密的<w>眉毛</w>，这让他看起来很严肃。",
                                "ru": "У него густые <w>брови</w>, из-за чего он выглядит серьезным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raise brow"
                    ],
                    "target_lang_definitions": {
                        "zh": "眉毛。",
                        "ru": "Бровь."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "眉毛",
                                "target_lang_sense_clarification": "眼睛上方的毛。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бровь",
                                "target_lang_sense_clarification": "Волосяной покров над глазом."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0793c550-aba1-3391-a03f-7b1185add538",
                    "sense_definition": "The projecting upper edge of a steep place such as a hill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stood at the <w>brow</w> of the hill to look at the view.",
                            "target_lang_translations": {
                                "zh": "我们站在<w>山顶</w>俯瞰风景。",
                                "ru": "Мы стояли на <w>вершине</w> холма, любуясь видом."
                            }
                        },
                        {
                            "text": "The car stopped right at the <w>brow</w> of the steep cliff.",
                            "target_lang_translations": {
                                "zh": "车停在了陡峭悬崖的<w>顶端</w>。",
                                "ru": "Машина остановилась прямо на <w>краю</w> крутого обрыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brow of hill"
                    ],
                    "target_lang_definitions": {
                        "zh": "陡峭地形（如山丘）的顶部边缘。",
                        "ru": "Верхний край крутого склона или холма."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "山顶",
                                "target_lang_sense_clarification": "指山丘或陡坡的顶部边缘。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "Самая высокая точка или край холма."
                            },
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "Верхняя кромка возвышенности."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea5de8af-967e-3097-afb5-da4a54ddc1c9",
                    "sense_definition": "Aspect; appearance; facial expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at him with a calm <w>brow</w> despite the chaos.",
                            "target_lang_translations": {
                                "zh": "尽管一片混乱，她仍以平静的<w>神色</w>看着他。",
                                "ru": "Несмотря на хаос, она смотрела на него с <w>спокойным</w> выражением лица."
                            }
                        },
                        {
                            "text": "His worried <w>brow</w> revealed his true feelings about the plan.",
                            "target_lang_translations": {
                                "zh": "他忧虑的<w>神色</w>暴露了他对该计划的真实感受。",
                                "ru": "Его <w>озабоченный</w> вид выдавал истинное отношение к плану."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "面部表情或神态。",
                        "ru": "Выражение лица, мимика."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "神色",
                                "target_lang_sense_clarification": "指人的面部表情。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выражение лица",
                                "target_lang_sense_clarification": "Внешнее проявление эмоций на лице."
                            },
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "Внешний облик или выражение."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6464ccc-ea40-32eb-9b1d-4b618cc82349",
                    "sense_definition": "The bony ridge over the eyes, upon which the eyebrows are located.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injury left a small cut just above his <w>brow</w>.",
                            "target_lang_translations": {
                                "zh": "伤口在他<w>眉骨</w>上方留下了一道小口子。",
                                "ru": "От травмы остался небольшой порез прямо над <w>надбровной</w> дугой."
                            }
                        },
                        {
                            "text": "He felt a sharp pain along his <w>brow</w> after the impact.",
                            "target_lang_translations": {
                                "zh": "撞击后，他感到<w>眉骨</w>处一阵剧痛。",
                                "ru": "После удара он почувствовал резкую боль в области <w>надбровной</w> дуги."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "眼眶上方的骨骼隆起处。",
                        "ru": "Костный выступ над глазницами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "眉骨",
                                "target_lang_sense_clarification": "眼眶上方的骨头。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "надбровная дуга",
                                "target_lang_sense_clarification": "Анатомический термин для кости над глазом."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44ec07eb-bc73-3ad2-a252-62cd1db56afa",
                    "sense_definition": "The gangway from ship to shore when a ship is lying alongside a quay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passengers walked down the <w>brow</w> to reach the dock.",
                            "target_lang_translations": {
                                "zh": "乘客们走下<w>跳板</w>到达码头。",
                                "ru": "Пассажиры сошли на берег по <w>трапу</w>."
                            }
                        },
                        {
                            "text": "The crew secured the <w>brow</w> before the ship departed.",
                            "target_lang_translations": {
                                "zh": "船员在船只启航前固定好了<w>跳板</w>。",
                                "ru": "Перед отплытием экипаж закрепил <w>трап</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "船只靠岸时连接船身与码头的跳板。",
                        "ru": "Переходный мостик или сходни для входа на судно."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳板",
                                "target_lang_sense_clarification": "供人上下船的通道。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "трап",
                                "target_lang_sense_clarification": "Лестница или мостик для посадки на судно."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5b15fa8-b76e-3f79-a74e-dd96ff50b9f8",
                    "sense_definition": "The hinged part of a landing craft or ferry which is lowered to form a landing platform; a ramp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ferry lowered its <w>brow</w> so the cars could drive off.",
                            "target_lang_translations": {
                                "zh": "渡轮放下了<w>舷梯</w>，以便车辆驶出。",
                                "ru": "Паром опустил <w>аппарель</w>, чтобы машины могли съехать."
                            }
                        },
                        {
                            "text": "The soldiers exited the craft across the heavy metal <w>brow</w>.",
                            "target_lang_translations": {
                                "zh": "士兵们穿过沉重的金属<w>舷梯</w>走出了登陆艇。",
                                "ru": "Солдаты покинули судно, пройдя по тяжелой металлической <w>аппарели</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "登陆艇或渡轮上可放下作为登陆平台的铰接式坡道。",
                        "ru": "Откидная аппарель или платформа для погрузки."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "舷梯",
                                "target_lang_sense_clarification": "用于车辆或人员上下船的坡道。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "аппарель",
                                "target_lang_sense_clarification": "Пологая площадка для въезда техники."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d76a878-6a2e-3464-ac51-355a4ee864b8",
                    "sense_definition": "The first tine of an antler's beam.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter noted the size of the <w>brow</w> on the stag.",
                            "target_lang_translations": {
                                "zh": "猎人注意到了那头雄鹿<w>眉叉</w>的大小。",
                                "ru": "Охотник отметил размер <w>надглазничного</w> отростка у оленя."
                            }
                        },
                        {
                            "text": "The <w>brow</w> was sharp and clearly visible on the antler.",
                            "target_lang_translations": {
                                "zh": "鹿角上的<w>眉叉</w>尖锐且清晰可见。",
                                "ru": "<w>Надглазничный</w> отросток был острым и хорошо заметным на роге."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "鹿角主干上的第一根分叉。",
                        "ru": "Первый отросток на роге оленя."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "眉叉",
                                "target_lang_sense_clarification": "鹿角最下方的分叉。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "надглазничный отросток",
                                "target_lang_sense_clarification": "Нижний отросток оленьего рога."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9647887-561d-3124-88e0-8da3a0f222a5",
                    "sense_definition": "A gallery in a coal mine running across the face of the coal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners worked deep within the <w>brow</w> of the coal seam.",
                            "target_lang_translations": {
                                "zh": "矿工们在煤层的<w>工作面巷道</w>深处作业。",
                                "ru": "Шахтеры работали глубоко в <w>забое</w> угольного пласта."
                            }
                        },
                        {
                            "text": "The ventilation system was extended into the new <w>brow</w>.",
                            "target_lang_translations": {
                                "zh": "通风系统被延伸到了新的<w>工作面巷道</w>中。",
                                "ru": "Систему вентиляции продлили до нового <w>забоя</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "煤矿中沿煤层工作面延伸的巷道。",
                        "ru": "Горная выработка вдоль угольного пласта."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "工作面巷道",
                                "target_lang_sense_clarification": "煤矿中沿煤层开采的通道。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "забой",
                                "target_lang_sense_clarification": "Место непосредственной добычи угля."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f57b7db1-c221-3afc-a683-c3d859c1854c",
                    "sense_definition": "To bound or limit; to be at, or form, the edge of.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall trees <w>brow</w> the quiet valley below.",
                            "target_lang_translations": {
                                "zh": "高大的树木<w>位于</w>下方宁静山谷的<w>边缘</w>。",
                                "ru": "Высокие деревья <w>возвышаются</w> над тихой долиной внизу."
                            }
                        },
                        {
                            "text": "The cliffs <w>brow</w> the river as it flows to the sea.",
                            "target_lang_translations": {
                                "zh": "悬崖<w>位于</w>奔向大海的河流<w>边缘</w>。",
                                "ru": "Скалы <w>нависают</w> над рекой, текущей к морю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or older contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于……的边缘；构成……的边缘。",
                        "ru": "Находиться на краю чего-либо."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "位于……边缘",
                                "target_lang_sense_clarification": "指处于某处的边缘位置。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "возвышаться над",
                                "target_lang_sense_clarification": "Находиться на краю, нависая над чем-то."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ac291ab9-7b52-3da4-8812-ba4a08df84b9",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named <w>Brow</w>.",
                            "target_lang_translations": {
                                "zh": "这本书的作者名叫<w>布劳</w>。",
                                "ru": "Автора книги зовут <w>Брау</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Brow</w> will be joining the meeting later today.",
                            "target_lang_translations": {
                                "zh": "<w>布劳</w>先生今天晚些时候会参加会议。",
                                "ru": "Мистер <w>Брау</w> присоединится к собранию позже сегодня."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。",
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布劳",
                                "target_lang_sense_clarification": "英文姓氏 Brow 的音译。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Брау",
                                "target_lang_sense_clarification": "Транслитерация английской фамилии."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}