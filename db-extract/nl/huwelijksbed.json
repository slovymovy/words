                        "sense_id": "c282b2a8-5058-3e50-80fe-a4d526d3639e",
                        "entry_id": "c1fd3978-962d-3497-aad2-d70c4d350caf",
                        "glosses": [
                            "het tweepersoonsbed waarin een echtpaar slaapt; echtelijke sponde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3bf9cfc-13b7-4316-baf8-9e06f582c304",
                                "sense_id": "c282b2a8-5058-3e50-80fe-a4d526d3639e",
                                "text": "Sook-hee krijgt de opdracht mee om voor hem een weg te banen naar het hart en huwelijksbed van haar nieuwe meesteres. Boze opzet, want het is hem alleen om Lady Hideko’s fortuin te doen."
                            },
                            {
                                "example_id": "7593ba02-de52-43e5-b245-86103171376a",
                                "sense_id": "c282b2a8-5058-3e50-80fe-a4d526d3639e",
                                "text": "Ook ín dat huwelijksbed kon het stukken leuker. Kerken bleven in de jaren zestig het gebruik van condooms en de pil verbieden, maar de gelovigen trokken zich er steeds minder van aan."
                            },
                            {
                                "example_id": "b86bd5dc-98fa-4de0-a5e0-4c98b30a6a47",
                                "sense_id": "c282b2a8-5058-3e50-80fe-a4d526d3639e",
                                "text": "Op donderdag 24 augustus 1939, rond vijf uur in de ochtend, stierf mijn vader. Thuis, in het witte ziekenhuisledikant dat naast het huwelijksbed stond opgesteld sinds hij, ruim drie jaar tevoren was thuisgekomen uit het sanatorium Hoog Laren, waar hij ook zo'n drie jaar had gelegen."
                            }
                        ]
                    }
