                        "entry_id": "f80f9814-4998-3c49-9604-e66f041d62cf",
                        "glosses": [
                            "Jeune crapaud, après l’ensemble de ses métamorphoses larvaires."
                        ],
                        "tags": [
                            "Batrachologie"
                        ],
                        "examples": [
                            {
                                "example_id": "80594fab-b003-4668-821d-6247f0593806",
                                "sense_id": "84e0e7e5-79f9-395d-897a-f8fbbccfa8fd",
                                "text": "C’est vers la mi-juin que le crapelet quitte l’étang où il naquit voilà quelques semaines."
                            },
                            {
                                "example_id": "00eebf81-701a-4bb3-a9f3-443b3b36293d",
                                "sense_id": "84e0e7e5-79f9-395d-897a-f8fbbccfa8fd",
                                "text": "Plus loin, au bord d’une rigole où gazouillait un filet d’eau fraîche, Justin trouva un Crapelet qui chantait doucement : U, û ! û !"
                            },
                            {
                                "example_id": "f5b0849c-1c56-4f7e-a468-b16e7a6c5509",
                                "sense_id": "84e0e7e5-79f9-395d-897a-f8fbbccfa8fd",
                                "text": "Oh ! il ne rama pas bien méthodiquement, le pauvre ! Il agita l’eau, voilà tout, tel un crapelet qui apprend son métier, mais cela suffit à mouvoir le pan de glace jusqu’à la rive."
                            }
                        ]
                    }
