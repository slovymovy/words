{
    "word_family": [
        "enlisement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c21ea12-175d-37c2-86e9-5c5202d196b0",
                    "sense_definition": "Enfoncer ou faire pénétrer quelqu'un ou quelque chose dans un sol meuble comme de la boue, du sable ou de la vase.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enliser_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le camion a quitté la route goudronnée et s'est <w>enlisé</w> dans le sable du désert."
                        },
                        {
                            "text": "Nadia conduit très lentement de peur d'<w>enliser</w> les roues de sa voiture dans la boue."
                        }
                    ],
                    "synonyms": [
                        "embourber"
                    ],
                    "common_phrases": [
                        "s'enliser dans le sable",
                        "s'enliser dans la boue"
                    ]
                },
                {
                    "sense_id": "4e7babc2-df00-3ae4-8255-f45482b0fa93",
                    "sense_definition": "Faire stagner, bloquer ou paralyser durablement le déroulement d'une action, d'un projet ou d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enliser_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les négociations de paix risquent de s'<w>enliser</w> si aucune des deux parties ne fait de concession."
                        },
                        {
                            "text": "L'enquête policière s'<w>enlise</w> depuis des semaines faute de nouvelles preuves concluantes."
                        }
                    ],
                    "synonyms": [
                        "paralyser"
                    ],
                    "common_phrases": [
                        "s'enliser dans un conflit",
                        "s'enliser dans les négociations"
                    ]
                },
                {
                    "sense_id": "e4d51cec-60e0-39cc-80fd-c4628be3c0b2",
                    "sense_definition": "Provoquer un profond ennui chez quelqu'un, lasser ou assommer d'ennui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enliser_ennui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce long discours protocolaire finit par m'<w>enliser</w> tellement il manque d'intérêt et d'énergie."
                        },
                        {
                            "text": "Arrête de parler de tes soucis administratifs, tu nous <w>enlises</w> tous avec ces détails."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        }
    ]
