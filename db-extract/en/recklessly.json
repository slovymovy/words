                                    {
                                        "sense_id": "dd237cdd-cef0-3685-9fc9-cbfff96fc9cc",
                                        "entry_id": "622e7dab-80e5-302d-96e5-c723925bca94",
                                        "glosses": [
                                            "Sin conciencia de la propia capacidad de obligación y respuesta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5cc445-4e6f-4331-b6f4-9b20cbe450d2",
                                                "sense_id": "dd237cdd-cef0-3685-9fc9-cbfff96fc9cc",
                                                "text": "Frecuentemente, las personas que tienen necesidad de ejercer el control y de adquirir el poder han sido personas mimadas y consentidas en su infancia. Sienten que la vida les debe dar el mismo trato que sus padres les dieron y que pueden continuar ejerciendo el control y actuando irresponsablemente como lo hacían cuando eran pequeños. Pero la vida no es así"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38f7d042-8eca-4f0c-a845-f049d9d5478c",
                        "source_entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                        "source_sense_description": "with contempt of others",
                        "target_lang_word": "rücksichtslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rücksichtslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                        "entry_id": "4aaf714c-b16b-38af-8b34-35394455da46",
                                        "glosses": [
                                            "andere nicht schonend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61639fd2-74ac-4956-a215-706649aa2087",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Er habe mehrfach beobachtet, dass durch die rücksichtslose Raserei Fußgänger gefährdet worden seien.“"
                                            },
                                            {
                                                "example_id": "65b17c8e-74f9-4978-ab91-13f45a11c8f5",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                                            },
                                            {
                                                "example_id": "9f25ab8e-314f-4e7c-a748-d96b85d5fb95",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Das ist rücksichtsloses Verhalten, für das mir jedes Verständnis fehlt und das wir nicht hinnehmen.“"
                                            },
                                            {
                                                "example_id": "eefd427b-38bd-4310-8d7e-d6fadc4e79e1",
                                                "sense_id": "524cb2b4-84e9-32b1-a17c-974d91b98b5e",
                                                "text": "„Nordkorea hatte zuvor die Rede Trumps in Seoul und seine Warnungen als ‚rücksichtslose Äußerungen eines verkalkten Alten‘ bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
