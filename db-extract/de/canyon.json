                                        "sense_id": "242d4c9b-24b9-3575-8147-221f0ba67e4d",
                                        "entry_id": "712bac89-7956-3448-86ef-150b5133a2a0",
                                        "glosses": [
                                            "βαθύ ρήγμα σε βουνά, βαθιά χαράδρα με απότομες πλαγιές"
                                        ],
                                        "tags": [
                                            "γεωγραφία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23477f71-ed41-482e-9bf7-df944dbdc93b",
                                                "sense_id": "242d4c9b-24b9-3575-8147-221f0ba67e4d",
                                                "text": "το φαράγγι της Σαμαριάς"
                                            },
                                            {
                                                "example_id": "ac19b72a-4c27-486d-8fef-6834626b5986",
                                                "sense_id": "242d4c9b-24b9-3575-8147-221f0ba67e4d",
                                                "text": "Το Γκραν Κάνιον (Grand Canyon) είναι ένα από τα μεγαλύτερα και αρχαιότερα φαράγγια του κόσμου."
                                            }
                                        ]
                                    }
                                ]
