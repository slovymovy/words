                "senses": [
                    {
                        "sense_id": "002198fa-6a42-3abb-9d9d-1a7941d3d979",
                        "entry_id": "443bf662-a96d-3b8b-9962-5233bf89657a",
                        "glosses": [
                            "Küste, die im Westen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9202925b-3873-49e2-a06f-81447f24c306",
                                "sense_id": "002198fa-6a42-3abb-9d9d-1a7941d3d979",
                                "text": "An einem grauen, windigen Tag stehe ich lange in der Verzon Bay an der Westküste und schaue den Surfern, Windsurfern, Kitesurfern, Bodyboardern zu, nicht ohne Neid."
                            },
                            {
                                "example_id": "5ec64bd1-12b0-4d92-8c78-887d83c5be5c",
                                "sense_id": "002198fa-6a42-3abb-9d9d-1a7941d3d979",
                                "text": "Entlang der Westküste des afrikanischen Kontinents stoßen die Expeditionen immer weiter nach Süden vor: Gil Eanes umrundet 1434 das Kap Bojador an der Westküste der Sahara."
                            },
                            {
                                "example_id": "4feea66b-2b0a-4564-9f63-0c3b815921cf",
                                "sense_id": "002198fa-6a42-3abb-9d9d-1a7941d3d979",
                                "text": "„Etwa 11 ständige Bewohner hat die Insel, die alle im gleichnamigen Dorf an der flacheren Westküste der Insel leben.“"
                            },
                            {
                                "example_id": "adaa0b0b-19fd-49bf-a0ae-1c26d8a5b0ae",
                                "sense_id": "002198fa-6a42-3abb-9d9d-1a7941d3d979",
                                "text": "„Corisco liegt wenige Kilometer vor Afrikas Westküste im Golf von Guinea.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
