                                        "entry_id": "789e6b7c-8442-3ac3-a90e-4627749b99a4",
                                        "glosses": [
                                            "Qui concerne les joueurs adultes, généralement de plus de 20 ans et de moins de 45 ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febb040c-ee7f-4edb-90c5-1516b58eecf1",
                                                "sense_id": "715af9f6-7af7-3108-8f6a-6e0371c2367c",
                                                "text": "C'est pas toutes les écoles qui ont une équipe junior et une équipe senior, mais nous, oui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "376ab161-43bb-34db-9f2d-165f1bd5391f",
                                        "entry_id": "789e6b7c-8442-3ac3-a90e-4627749b99a4",
