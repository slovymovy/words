                                "target_senses": [
                                    {
                                        "sense_id": "07cdc8af-ca97-3788-9e66-d9d514981c49",
                                        "entry_id": "2961b3dd-76a7-36b2-8c74-7431ed81122e",
                                        "glosses": [
                                            "Unable to defend oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d718b73f-ea31-4ee4-a1b9-32f5f68510a7",
                                                "sense_id": "07cdc8af-ca97-3788-9e66-d9d514981c49",
                                                "text": "Then when you find yourself lyin' helpless in her arms\nYou know you really love a woman"
                                            },
                                            {
                                                "example_id": "db730f8f-c7c3-40de-b145-96bd55b26226",
                                                "sense_id": "07cdc8af-ca97-3788-9e66-d9d514981c49",
                                                "text": "Rana Thanoptis: Are we good? Can I go?\nShepard: You conducted brutal experiments on helpless test subjects. You helped Saren. You don't get to live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6b6cabc-b5dd-3c0c-a2e8-92dd13b716dc",
                                        "entry_id": "2961b3dd-76a7-36b2-8c74-7431ed81122e",
                                        "glosses": [
                                            "Lacking help; powerless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "140c7e6a-34bd-402d-bedd-743234b3437a",
                                                "sense_id": "c6b6cabc-b5dd-3c0c-a2e8-92dd13b716dc",
                                                "text": "A gaoler struck him, pushing him back in place in the hopeless, helpless line of prisoners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5514c6cb-8e0c-38f1-994d-0218dfcb40a0",
                                        "entry_id": "2961b3dd-76a7-36b2-8c74-7431ed81122e",
                                        "glosses": [
                                            "Unable to act without help; needing help; feeble."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ead6b18-5beb-352d-938c-3b9f3ee3b513",
                                        "entry_id": "2961b3dd-76a7-36b2-8c74-7431ed81122e",
                                        "glosses": [
                                            "Uncontrollable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ce05dac-65fc-4dfe-85af-55eec330988d",
                                                "sense_id": "2ead6b18-5beb-352d-938c-3b9f3ee3b513",
                                                "text": "a helpless urge"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbbd3c89-54f8-3b50-b54d-a9f9e45c231a",
                                        "entry_id": "2961b3dd-76a7-36b2-8c74-7431ed81122e",
                                        "glosses": [
                                            "From which there is no possibility of being saved."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d468b962-6d83-4647-83d3-669937a02afd",
                                                "sense_id": "bbbd3c89-54f8-3b50-b54d-a9f9e45c231a",
                                                "text": "For, while they fly that gulf's devouring jawes,\nThey on the rock are rent and sunck in helplesse wawes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dcfdb44-3858-4468-8a86-c0caa6ad0bba",
                        "source_entry_id": "e6602819-3bd2-3d9b-ba98-fe43066c3ab4",
                        "source_sense_description": "неспособный без посторонней помощи справиться с чем-либо",
                        "target_lang_word": "hilflos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hilflos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                        "entry_id": "d658fb20-aa9a-3289-b8ee-81f21faef271",
                                        "glosses": [
                                            "nicht in der Lage, allein zurechtzukommen/sich selbst zu helfen; auf Hilfe angewiesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b0bc04-ab56-486f-acb4-9b61072c3f10",
                                                "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                                "text": "„Mein Vater muss sich sehr hilflos vorgekommen sein, abhängig von seinen halbwüchsigen Kindern.“"
                                            },
                                            {
                                                "example_id": "0470cb6b-4ac2-4236-aefe-e31fc4117aa4",
                                                "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                                "text": "„Kinder sind ausgeprägte Sinnsucher; insofern ist auch bei diesem unglückseligen Vorfall zunächst nicht von einem Wegwerfen des Lebens auszugehen, sondern von einer – wenn auch hilflosen, vielleicht pervertierten- Sinnsuche, die in einem tödlichen Unfall endete.“"
                                            },
                                            {
                                                "example_id": "e0d30d85-cc83-4126-90e7-89aa7006c92a",
                                                "sense_id": "4c81a56f-2cc8-3222-826b-7dbfc60e8f90",
                                                "text": "„Der Vogel, von der Größe einer Taube, schüttelte die verstaubten Federn seines seit einer Ewigkeit unbenutzten Gefieders, stakste unsicher auf dem Fußboden umher, machte einen hilflosen Flugversuch und hüpfte schließlich durch eine Tür, die sich rechts des gewaltigen Kamins auftat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7dd68591-44f3-3e08-8bb4-0032d863fba8",
                                        "entry_id": "d658fb20-aa9a-3289-b8ee-81f21faef271",
                                        "glosses": [
                                            "nicht in der Lage, jemandem zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d40764a-1bb5-4988-9a10-7f4d39d0a6b3",
                                                "sense_id": "7dd68591-44f3-3e08-8bb4-0032d863fba8",
                                                "text": "„Die Bevölkerung wurde grosso modo mit hilflosen Ratschlägen und finanziellen Zuschüssen für Privatbunker unter dem Eigenheim abgespeist, zudem entstand hier und da ein Notbehelf in Bahnhöfen und Parkhäusern, U-Bahnschächten und Schulen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
