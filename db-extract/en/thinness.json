                                "target_senses": [
                                    {
                                        "sense_id": "0742dea6-aa6f-35c4-ac19-dca2d95e8b8a",
                                        "entry_id": "0dfce6ca-04eb-3a7a-8911-fc24e7a29316",
                                        "glosses": [
                                            "свойство по значению прилагательного тонкий"
                                        ],
                                        "tags": [],
