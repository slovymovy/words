                "entry_id": "96330f08-1023-397a-8ace-85c633bedfa2",
                "word": "raconteur",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "07b34acb-2686-33cb-9e0b-ba896e1ce1ba",
                        "entry_id": "96330f08-1023-397a-8ace-85c633bedfa2",
                        "glosses": [
                            "Erzähler, Anekdotenerzähler, Geschichtenerzähler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8878a9b8-d63c-41e5-ad23-4d1db53a6890",
                                "sense_id": "07b34acb-2686-33cb-9e0b-ba896e1ce1ba",
                                "text": "\"Not everyone will become a master raconteur, of course, but there will always be available a sufficient number of storytellers to ensure the continued existence of oral literature.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8df92f4e-6392-4d21-851d-a45976b6da0b",
                        "source_entry_id": "96330f08-1023-397a-8ace-85c633bedfa2",
                        "source_sense_id": "07b34acb-2686-33cb-9e0b-ba896e1ce1ba",
                        "source_sense_description": "Erzähler, Anekdotenerzähler, Geschichtenerzähler",
                        "target_lang_word": "Erzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Person, die etwas erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                                            },
                                            {
                                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Verfasser einer Erzählung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89e54974-56ce-4809-9d60-af09c17eaf3f",
                        "source_entry_id": "96330f08-1023-397a-8ace-85c633bedfa2",
                        "source_sense_id": "07b34acb-2686-33cb-9e0b-ba896e1ce1ba",
                        "source_sense_description": "Erzähler, Anekdotenerzähler, Geschichtenerzähler",
                        "target_lang_word": "Anekdotenerzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "36bf1651-62e8-4042-937c-da00cc92ad69",
                        "source_entry_id": "96330f08-1023-397a-8ace-85c633bedfa2",
                        "source_sense_id": "07b34acb-2686-33cb-9e0b-ba896e1ce1ba",
                        "source_sense_description": "Erzähler, Anekdotenerzähler, Geschichtenerzähler",
                        "target_lang_word": "Geschichtenerzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschichtenerzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5f8486-47c8-3503-b04e-81b8887d3e8d",
                                        "entry_id": "87d7ab7d-802a-3583-ad31-441cc3a4473d",
                                        "glosses": [
                                            "Person, die Geschichten erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566d88c6-8dc7-4504-afed-5a9622ec0132",
                                                "sense_id": "2b5f8486-47c8-3503-b04e-81b8887d3e8d",
                                                "text": "„Der Priester Wu hatte einen Geschichtenerzähler kommen lassen, der aus dem kritischen Werke über die westliche Han-Dynastie das Zusammentreffen in Schwanentor vortrug.“"
                                            },
                                            {
                                                "example_id": "fe987709-15ec-4bdb-8ba7-5be48ef833d2",
                                                "sense_id": "2b5f8486-47c8-3503-b04e-81b8887d3e8d",
                                                "text": "„Streitfragen entschied der Rabbi, und einer der Rabbis in Kosliw war Roths Urgroßvater Akiva, der auch ein großer Geschichtenerzähler war.“"
                                            },
                                            {
                                                "example_id": "f087d469-f90f-41b9-a3b8-2129b55a83c9",
                                                "sense_id": "2b5f8486-47c8-3503-b04e-81b8887d3e8d",
                                                "text": "„Wir wurden gute Freunde, und er war ein großartiger Geschichtenerzähler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
