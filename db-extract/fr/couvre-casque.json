                        "sense_id": "1c18a6ad-373b-32b8-8e1b-10f0a5f20b1d",
                        "entry_id": "299b6bcf-33a4-39b4-b193-15cff7f4cd39",
                        "glosses": [
                            "Sorte de parure qui vient couvrir un casque, soit pour le camoufler, soit pour l’enjoliver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3dfccaa-bd71-4de9-916e-829b57a5a127",
                                "sense_id": "1c18a6ad-373b-32b8-8e1b-10f0a5f20b1d",
                                "text": "Il avait très vite découvert qu'il ne fallait pas quitter des yeux la jammeuse, reconnaissable à son couvre-casque à deux étoiles. Ce n'étaient pas obligatoirement les mêmes qui occupaient cette position, le couvre-casque à étoiles passait d'une joueuse à l'autre entre les jams."
                            },
                            {
                                "example_id": "a63a2277-8a06-4b49-85c1-716951578aeb",
                                "sense_id": "1c18a6ad-373b-32b8-8e1b-10f0a5f20b1d",
                                "text": "Les Waffler portaient sur leur écusson un lion d'or avec couronne d'argent sur champ de sable, de même sur le casque, le couvre-casque sable et or."
                            },
                            {
                                "example_id": "1380ed68-2790-4bee-a747-29536b7e581e",
                                "sense_id": "1c18a6ad-373b-32b8-8e1b-10f0a5f20b1d",
                                "text": "On ne devine pas le régiment, faute de voir un chiffre sur les pattes d'épaule, ni sur les couvre-casques en toile."
                            }
                        ]
                    }
