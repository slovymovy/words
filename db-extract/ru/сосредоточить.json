                    },
                    {
                        "translation_id": "ede0c9d6-9a2d-4ac9-9ac8-49f6c82db645",
                        "source_entry_id": "32561106-3033-3879-8bf8-e6d40744d08e",
                        "target_lang_word": "concentrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concentrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d53dd1d-9f9e-342d-b588-81a521da1570",
                                        "entry_id": "275f09bd-5049-39c1-ad31-399c39736e36",
                                        "glosses": [
                                            "Réunir en un centre ce qui est dispersé."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a57fca49-e8b8-43c6-b4b3-1f62951d08c9",
                                                "sense_id": "7d53dd1d-9f9e-342d-b588-81a521da1570",
                                                "text": "Nous avons fait usage du fourneau ordinaire de fondeurs, avec cette différence que ce fourneau étoit recouvert d’un dôme en terre cuite pour concentrer la chaleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01ab463-b838-3e11-aece-63a90cfbde11",
                                        "entry_id": "275f09bd-5049-39c1-ad31-399c39736e36",
                                        "glosses": [
                                            "Réunir ; rassembler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ae0143c-2306-4b42-9cf1-a4bc176d2cdd",
                                                "sense_id": "e01ab463-b838-3e11-aece-63a90cfbde11",
                                                "text": "— Les divers corps d’armée se concentrèrent sur tel point."
                                            },
                                            {
                                                "example_id": "03b4a40d-3bd3-4a99-a7dd-f2a59dd87f8d",
                                                "sense_id": "e01ab463-b838-3e11-aece-63a90cfbde11",
                                                "text": "Soutenus dans le ciel par les avions de la coalition (qui, à partir de la fin septembre, avaient concentré quasiment tous leurs efforts sur Kobané), ultra-déterminés, ultra-organisés, renforcés par leurs bataillons féminins d’une redoutable efficacité, les YPG reconquirent, mètre après mètre, la moitié de la ville que les djihadistes leur avaient prise, avant de les en chasser complètement le 25 janvier."
                                            },
                                            {
                                                "example_id": "0604ae76-4f0a-4c32-af0a-159d9cf20d10",
                                                "sense_id": "e01ab463-b838-3e11-aece-63a90cfbde11",
                                                "text": "L’émigration islandaise a commencé en 1870, […]. On a cherché à concentrer le mouvement, mais la difficulté était de trouver une contrée convenable; on a proposé la Nouvelle-Écosse, l’Ontario, le Wisconsin, le Nebraska, le Manitoba."
                                            },
                                            {
                                                "example_id": "4aff6694-9e73-460a-86a1-abf9b9f7b255",
                                                "sense_id": "e01ab463-b838-3e11-aece-63a90cfbde11",
                                                "text": "Leurs recherches leur avaient appris que le roi de Pologne et les autres chefs militaires s'étaient réunis en conseil de guerre au château de Stetteldorf avant de traverser le fleuve et de concentrer leurs armées à Tulln."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f3ab57-a558-3838-8f0d-eb627a138d58",
                                        "entry_id": "275f09bd-5049-39c1-ad31-399c39736e36",
                                        "glosses": [
                                            "Réduire, condenser un liquide, diminuer la quantité d’eau qu’il contient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cedc794-827f-44ec-a03c-35e0316c89c2",
                                                "sense_id": "65f3ab57-a558-3838-8f0d-eb627a138d58",
                                                "text": "Alcool concentré."
                                            },
                                            {
                                                "example_id": "2f9498cf-db6f-4630-9d6d-5cee5cfaa610",
                                                "sense_id": "65f3ab57-a558-3838-8f0d-eb627a138d58",
                                                "text": "Lait concentré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a93b56-ab15-3a6b-bcf4-918744d3f40b",
                                        "entry_id": "275f09bd-5049-39c1-ad31-399c39736e36",
                                        "glosses": [
                                            "Contenir, dissimuler."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c423fc3d-9919-4ffc-a7c1-531db53e9003",
                                                "sense_id": "21a93b56-ab15-3a6b-bcf4-918744d3f40b",
                                                "text": "Pouls concentré, Pouls dont les battements se font peu sentir."
                                            },
                                            {
                                                "example_id": "ed2ea006-7a1a-44bc-b6db-d2678a259554",
                                                "sense_id": "21a93b56-ab15-3a6b-bcf4-918744d3f40b",
                                                "text": "Concentrer sa fureur, sa haine, etc."
                                            },
                                            {
                                                "example_id": "84b5885d-f1d4-4e5d-bfac-2985845b4311",
                                                "sense_id": "21a93b56-ab15-3a6b-bcf4-918744d3f40b",
                                                "text": "Douceur concentrée."
                                            },
                                            {
                                                "example_id": "32fbe968-9667-41e7-baba-ad5f7d8ff7a7",
                                                "sense_id": "21a93b56-ab15-3a6b-bcf4-918744d3f40b",
                                                "text": "Chagrin concentré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f17b73d-c1b3-3c9b-8410-6874596a029d",
                                        "entry_id": "275f09bd-5049-39c1-ad31-399c39736e36",
                                        "glosses": [
                                            "Faire abstraction de ce qui est autour et qui peut distraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45703c99-e15c-4ac2-ad02-5e5a4ecf75bd",
                                                "sense_id": "6f17b73d-c1b3-3c9b-8410-6874596a029d",
                                                "text": "Nous concentrerons notre analyse sur cette dernière dimension, en analysant quels ont été ses effets sur l’industrie cordonnière de la Province de Concepción."
                                            },
                                            {
                                                "example_id": "ff4c1cb2-1acc-489f-b468-0fd91f2862b1",
                                                "sense_id": "6f17b73d-c1b3-3c9b-8410-6874596a029d",
                                                "text": "Concentrez-vous sur l’essentiel. Et surtout ne donnez aucune prise aux critiques !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
