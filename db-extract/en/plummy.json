                "senses": [
                    {
                        "sense_id": "442336b2-2865-3a8c-a0f4-c9d22dbbbc67",
                        "entry_id": "6b197a02-4be1-3fe1-9927-f57b28ce709b",
                        "glosses": [
                            "Of, pertaining to, containing, or characteristic of plums."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6baf0206-5162-4893-b0b9-20a7bb54fff2",
                                "sense_id": "442336b2-2865-3a8c-a0f4-c9d22dbbbc67",
                                "text": "The jam had a rich plummy aroma."
                            }
                        ]
                    },
                    {
                        "sense_id": "aedc047c-bb17-30c5-8803-f5f11f845431",
                        "entry_id": "6b197a02-4be1-3fe1-9927-f57b28ce709b",
                        "glosses": [
                            "Desirable; profitable; advantageous."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "70accb9b-31ae-478e-b5c5-debc6d819609",
                                "sense_id": "aedc047c-bb17-30c5-8803-f5f11f845431",
                                "text": "The poets have made tragedies enough about signing one's self over to wickedness for the sake of getting something plummy; I shall write a tragedy of a fellow who signed himself over to be good, and was uncomfortable ever after."
                            }
                        ]
                    },
                    {
                        "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                        "entry_id": "6b197a02-4be1-3fe1-9927-f57b28ce709b",
                        "glosses": [
                            "Rich, mellow and carefully articulated, especially with an upper-class accent."
                        ],
                        "tags": [
                            "of a voice"
                        ],
                        "examples": [
                            {
                                "example_id": "beb292e5-f959-4c8c-b423-0a5ea0c90a43",
                                "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                                "text": "plummy-voiced"
                            },
                            {
                                "example_id": "f71b1ec5-afb1-4646-a0ef-765bf55b4cbf",
                                "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                                "text": "Then, feeling the fat hands caressing her reluctant bosom, listening dutifully to the rich, plummy voice, she realized finally what marriage to the King meant."
                            },
                            {
                                "example_id": "aa0c07c2-227c-495a-9eee-b8068f4a8a24",
                                "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                                "text": "Ludovic's deferential voice (\"after what's happened, Sir, don't you think it will be more suitable\") suddenly turns from its plummy to the plebeian key (\"to shut your bloody trap\")."
                            },
                            {
                                "example_id": "e2fa45a2-ef37-4279-855f-de7203b3372d",
                                "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                                "text": "The fact that David Cameron, the conservative prime minister, is a plummy-voiced, Eton-educated, upper-class Brit from central casting has played into [Alex] Salmond's hands."
                            },
                            {
                                "example_id": "26fb5885-e90f-4186-afd2-afe374688a12",
                                "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                                "text": "But a plummy-voiced Labour peer, Baron Peter Hain, decided to defy the court order, invoking his parliamentary privilege to identify Mr. Green as the subject of the newspaper’s investigation."
                            },
                            {
                                "example_id": "2e93c17f-d1b7-4436-bca0-c6bf0a9002af",
                                "sense_id": "93896c1d-9a69-372a-aa31-de04b1d108ad",
                                "text": "Reviewing a collection of Tom Wolfe’s journalism, Hitchens deplored Wolfe’s affectations and his plummy conservative politics."
                            }
                        ]
                    }
                ],
