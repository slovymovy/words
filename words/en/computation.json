            "senses": [
                {
                    "sense_id": "aabd26f2-8521-3fd6-8365-b7b100b86c86",
                    "sense_definition": "The act or process of calculating or determining something by mathematical or logical methods.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calculation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex <w>computation</w> required for the space mission took several days to complete.",
                            "target_lang_translations": {
                                "ru": "Сложное <w>вычисление</w>, необходимое для космической миссии, заняло несколько дней."
                            }
                        },
                        {
                            "text": "Modern software allows for the rapid <w>computation</w> of large datasets in seconds.",
                            "target_lang_translations": {
                                "ru": "Современное программное обеспечение позволяет выполнять быстрый <w>расчёт</w> больших наборов данных за считанные секунды."
                            }
                        }
                    ],
                    "synonyms": [
                        "calculation",
                        "ciphering"
                    ],
                    "common_phrases": [
                        "rapid computation",
                        "mathematical computation",
                        "perform a computation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс вычисления или определения чего-либо с помощью математических или логических методов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычисление",
