                "senses": [
                    {
                        "sense_id": "5a41bd66-f82e-3aca-9efb-e70a711ecbf7",
                        "entry_id": "34bffee4-c33b-3172-8a94-dd29171e34e4",
                        "glosses": [
                            "größere Ansammlung von aufgestellten Totenbrettern, die zum Gedächtnis am Haus, der Straße oder am Todesort aufgestellt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08bc5175-72d7-4eca-8716-c657e5cc82aa",
                                "sense_id": "5a41bd66-f82e-3aca-9efb-e70a711ecbf7",
                                "text": "„Es ist bereits eine liebgewordene Tradition: Die Marienandacht an der Totenbretteranlage des EC Kronberg Bodenmais am Ufer des Rothbaches.“"
                            },
                            {
                                "example_id": "dc549eaa-ef80-4cf0-a602-902a45f18d4d",
                                "sense_id": "5a41bd66-f82e-3aca-9efb-e70a711ecbf7",
                                "text": "„Die Wanderung beginnt in Edenstetten, vorbei an der Totenbretteranlage bis nach Weibing.“"
                            },
                            {
                                "example_id": "99eeba34-48e0-4ab0-bdf0-f60090f5d56a",
                                "sense_id": "5a41bd66-f82e-3aca-9efb-e70a711ecbf7",
                                "text": "„Wer es etwas langsamer angehen möchte, der besucht am besten die mitten im Wald liegende Totenbretteranlage oder die Katholische Kirche St. Aegidius.“"
                            },
                            {
                                "example_id": "e09dc07d-6982-4b8b-a69b-344f833f7d35",
                                "sense_id": "5a41bd66-f82e-3aca-9efb-e70a711ecbf7",
                                "text": "„Zur Erinnerung an die Staatsforstarbeiter wurde hier eine Totenbretteranlage errichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
