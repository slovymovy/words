                {
                    "sense_id": "2c7dc208-69a8-3b6b-a936-0a56fddc078d",
                    "sense_definition": "De manière imprévue et instantanée ; tout d'un coup.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "soudain_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous marchions tranquillement dans la forêt quand, <w>soudain</w>, un violent orage a éclaté.",
                            "target_lang_translations": {
                                "en": "We were walking calmly through the forest when, <w>suddenly</w>, a violent storm broke out.",
                                "ru": "Мы спокойно шли по лесу, когда <w>вдруг</w> разразилась сильная гроза.",
                                "nl": "We liepen rustig door het bos toen er <w>ineens</w> een hevig onweer losbarstte.",
                                "de": "Wir gingen ruhig durch den Wald, als <w>plötzlich</w> ein heftiges Gewitter losbrach.",
                                "pl": "Szliśmy spokojnie przez las, kiedy <w>nagle</w> rozpętała się gwałtowna burza.",
                                "it": "Camminavamo tranquillamente nel bosco quando, <w>all'improvviso</w>, è scoppiato un violento temporale.",
                                "cs": "Šli jsme klidně lesem, když <w>najednou</w> vypukla silná bouřka.",
                                "tr": "Ormanda sakin sakin yürürken <w>birden</w> şiddetli bir fırtına koptu.",
                                "es": "Caminábamos tranquilamente por el bosque cuando, <w>de repente</w>, estalló una violenta tormenta.",
                                "zh": "我们正平静地走在森林里，这时<w>突然</w>爆发了一场猛烈的暴风雨。"
                            }
                        },
                        {
                            "text": "<w>Soudain</w>, toutes les lumières se sont éteintes et le public a retenu son souffle.",
                            "target_lang_translations": {
                                "en": "<w>Suddenly</w>, all the lights went out and the audience held its breath.",
                                "ru": "<w>Вдруг</w> погасли все огни, и публика затаила дыхание.",
                                "nl": "<w>Ineens</w> gingen alle lichten uit en hield het publiek de adem in.",
                                "de": "<w>Plötzlich</w> gingen alle Lichter aus, und das Publikum hielt den Atem an.",
                                "pl": "<w>Nagle</w> wszystkie światła zgasły, a publiczność wstrzymała oddech.",
                                "it": "<w>All'improvviso</w>, tutte le luci si sono spente e il pubblico ha trattenuto il respiro.",
                                "cs": "<w>Najednou</w> zhasla všechna světla a publikum zadrželo dech.",
                                "tr": "<w>Birden</w> bütün ışıklar söndü ve izleyiciler nefeslerini tuttu.",
                                "es": "<w>De repente</w>, todas las luces se apagaron y el público contuvo la respiración.",
                                "zh": "<w>突然</w>，所有的灯都灭了，观众屏住了呼吸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soudainement",
                        "subitement"
                    ],
                    "target_lang_definitions": {
                        "en": "In an unexpected and instantaneous manner; all at once.",
                        "ru": "Совершается неожиданно и мгновенно, без предупреждения.",
                        "nl": "Onverwacht en in een oogwenk, zonder voorafgaande waarschuwing.",
                        "de": "Unerwartet und in einem Augenblick geschehend, ohne Vorwarnung.",
                        "pl": "Nagle, niespodziewanie i w jednej chwili, bez ostrzeżenia.",
                        "it": "In modo imprevisto e istantaneo; tutto d'un tratto.",
                        "cs": "Děje se neočekávaně a okamžitě, bez předchozího varování.",
                        "tr": "Beklenmedik bir biçimde, bir anda olan ya da yapılan.",
                        "es": "De forma inesperada e instantánea, todo de una vez. Se usa para introducir un hecho que sucede sin aviso.",
                        "zh": "以出乎意料且瞬间的方式进行或发生，一下子。"
                    },
