                    "sense_id": "d950d763-5973-3f16-bbfb-7c776cf0bb67",
                    "sense_definition": "Expressing opinions in a pompous, dogmatic, or authoritative manner; present participle of <w>pontificate</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire dinner <w>pontificating</w> about modern economic theories without letting anyone else speak.",
                            "target_lang_translations": {
                                "nl": "Hij bracht het hele diner door met <w>pontificeren</w> over moderne economische theorieën zonder iemand anders aan het woord te laten."
                            }
                        },
                        {
                            "text": "The professor is known for <w>pontificating</w> on subjects far outside his own field of expertise.",
                            "target_lang_translations": {
                                "nl": "De professor staat erom bekend dat hij graag <w>doceert</w> over onderwerpen die ver buiten zijn eigen vakgebied liggen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pontificating about politics",
                        "pontificating on issues",
                        "stop pontificating"
                    ],
                    "target_lang_definitions": {
