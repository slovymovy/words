                "senses": [
                    {
                        "sense_id": "c00c7acc-a4b9-35c0-9165-98a709187219",
                        "entry_id": "f7981f52-326e-3565-8291-90fdaece5872",
                        "glosses": [
                            "Qui est solitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d46c28-c317-48e0-b618-71d9937526fd",
                                "sense_id": "c00c7acc-a4b9-35c0-9165-98a709187219",
                                "text": "Burr est arrivé avec Radko cette saison, et tranquillement mais surement, il taille sa place. Il est un peu réclusif vis à vis des gens qu’il ne connait pas, mais il adore sa Kat."
                            },
                            {
                                "example_id": "f1125dba-7ccf-4886-8456-effa7f930e75",
                                "sense_id": "c00c7acc-a4b9-35c0-9165-98a709187219",
                                "text": "Du reste, il fallait à tout prix par ce système réclusif, exploiter l’inutilité des inutiles, les pauvres et les infirmes."
                            },
                            {
                                "example_id": "94b23df7-86af-49d1-a230-50688ff8e4aa",
                                "sense_id": "c00c7acc-a4b9-35c0-9165-98a709187219",
                                "text": "Un vagabond solitaire quitte son isolement réclusif pour s’enfermer dans une spirale vengeresse"
                            },
                            {
                                "example_id": "aac9a5fc-fd1e-477f-9358-07481ff143bf",
                                "sense_id": "c00c7acc-a4b9-35c0-9165-98a709187219",
                                "text": "Si l’espace réclusif des Miroirs d’Ostende présente un kaléidoscope d’identités changeantes qui vont et viennent, celui de Elle disait dormir pour mourir est comme enveloppé de somnolence, il s’en dégage une atmosphère de latence et de stase extrême."
                            },
                            {
                                "example_id": "ac40a166-f4f9-4ad9-838c-c6cd8d28cfb4",
                                "sense_id": "c00c7acc-a4b9-35c0-9165-98a709187219",
                                "text": "En 1596 l’usage réclusif du pontifical romain est rendu obligatoire."
                            }
                        ]
                    }
                ],
