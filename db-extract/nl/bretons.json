                    {
                        "translation_id": "80cb9675-aa3e-4954-9605-c9ed69f09d43",
                        "source_entry_id": "721b8fa0-6e85-3839-aad0-963e6e7d5f9f",
                        "source_sense_id": "b780aafc-bebf-3369-a18b-dfb131c01081",
