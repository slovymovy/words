                "senses": [
                    {
                        "sense_id": "b206cf55-88e4-390d-af17-a648a604fe9a",
                        "entry_id": "c3dad72b-3310-3766-ba0e-fcda30d36ce7",
                        "glosses": [
                            "een fantasyfiguur uit de werken van J.R.R. Tolkien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608c1f64-d41b-475b-a55b-49322d09a750",
                                "sense_id": "b206cf55-88e4-390d-af17-a648a604fe9a",
                                "text": "David Bowie heeft jaren geleden auditie gedaan voor een rol in Lord of the Rings. Dat vertelt acteur Dominic Monaghan, die de hobbit Merry speelde, aan Huffington Post."
                            },
                            {
                                "example_id": "23a811c5-a4f4-4361-960a-683d0d4f7fcd",
                                "sense_id": "b206cf55-88e4-390d-af17-a648a604fe9a",
                                "text": "De film gaat vervolgens verder waar deel 1, An Unexpected Journey, ophield. Het reisgezelschap rond hobbit en inbreker Bilbo (Martin Freeman), die handig genoeg wordt geacht om de schat aan de draak te ontfutselen, zit midden in het avontuur. Een roedel wolfachtigen is nauwelijks verslagen of de groep verdwaalt in een giftig bos en wordt belaagd door levensgrote spinnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d4e89c4-4fba-3089-b726-ed3546449e80",
                        "entry_id": "c3dad72b-3310-3766-ba0e-fcda30d36ce7",
                        "glosses": [
                            "een klein persoon"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf2fbd3-c059-4f9e-913b-d077a65540dc",
                        "source_entry_id": "c3dad72b-3310-3766-ba0e-fcda30d36ce7",
                        "source_sense_id": "b206cf55-88e4-390d-af17-a648a604fe9a",
                        "target_lang_word": "hobbit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hobbit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03991d5d-812a-35c7-871a-dd0f4a413d06",
                                        "entry_id": "ad234676-bfb0-3b0d-8001-344c940c846f",
                                        "glosses": [
                                            "A member of a fictional race of small humanoids with shaggy hair and hairy feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68aec7bf-a638-4afb-b52b-4a08fb94a971",
                                                "sense_id": "03991d5d-812a-35c7-871a-dd0f4a413d06",
                                                "text": "It was his thirty-third birthday and already he had […] a little round tummy like a hobbit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85f988ff-75e2-335b-8926-569554ed73fa",
                                        "entry_id": "ad234676-bfb0-3b0d-8001-344c940c846f",
                                        "glosses": [
                                            "A member of a fictional race of small humanoids with shaggy hair and hairy feet.",
                                            "A person of short stature."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "106cfdd8-2cbd-3b99-bd45-e6e562f927aa",
                                        "entry_id": "ad234676-bfb0-3b0d-8001-344c940c846f",
                                        "glosses": [
                                            "An extinct species of hominin, Homo floresiensis, with a short body and relatively small brain, fossils of which have been recovered from the Indonesian island of Flores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64add560-cd03-4888-8395-daa29fab5e40",
                                                "sense_id": "106cfdd8-2cbd-3b99-bd45-e6e562f927aa",
                                                "text": "Although partial remains of other Hobbits have surfaced at the same site, they say it could have been an isolated colony of inbred people who shared the same genetic abnormalities."
                                            },
                                            {
                                                "example_id": "91a6e2ca-6fec-4238-b45a-fe1bbff29013",
                                                "sense_id": "106cfdd8-2cbd-3b99-bd45-e6e562f927aa",
                                                "text": "And in the island regions of southeast Asia, where the descendants of erectus, and the Hobbit, and any similar relict populations lived, climate changes would have greatly disrupted connections between regions and populations, as sea levels rose and fell by 100 metres or more."
                                            },
                                            {
                                                "example_id": "fd07c397-f0da-4c30-a8bf-8f608e909d72",
                                                "sense_id": "106cfdd8-2cbd-3b99-bd45-e6e562f927aa",
                                                "text": "The discovery of the Hobbit skeleton in Liang Bua cave in 2003 was an instant sensation. But what it said about human evolution was less clear.\nDiscoverer Mike Morwood proposed that it was a shrunken Homo erectus, the same species that eventually evolved to become us; others suggested the Hobbits were descended from smaller, more primitive early humans such as Homo habilis or Australopithecus."
                                            },
                                            {
                                                "example_id": "a8dfd041-e6e6-4ee8-8784-5e43a5aa8b57",
                                                "sense_id": "106cfdd8-2cbd-3b99-bd45-e6e562f927aa",
                                                "text": "The hobbit became extinct 50,000 years ago, about the time the first humans arrived on Flores, but the Pacific rat lived on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c6d6780-1872-3258-8f19-6753ee8195a3",
                                        "entry_id": "ad234676-bfb0-3b0d-8001-344c940c846f",
                                        "glosses": [
                                            "A socially unappealing, overly academic student."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
