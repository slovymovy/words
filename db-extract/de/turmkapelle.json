                ],
                "senses": [
                    {
                        "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                        "entry_id": "ddfe87f6-2bbf-36c3-bc95-5da8728a0ce2",
                        "glosses": [
                            "geweihte Kapelle in einem Turm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd72d545-da30-4138-8425-8211f50442fc",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„Einsegnung der Turmkapelle als Wallfahrtsstätte durch Joachim Kardinal Meisner, Erzbischof von Köln“"
                            },
                            {
                                "example_id": "93bf2724-ec2b-48eb-805c-8491e09aec23",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„Aus dem 14. oder 15. Jahrhundert stammt die Ausmalung in der alten Turmkapelle der Bimbacher St.-Laurentius-Kirche.“"
                            },
                            {
                                "example_id": "adf1f46b-1d3a-42cc-9211-62ddd9f03847",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„Bei der Restaurierung im Jahre 1976 wurde der Turmkapelle die ursprüngliche Farbwirkung zurückgegeben und die beiden bunten Glasfenster wurden durch Sechseckerbleiung in Antikglas ersetzt.“"
                            },
                            {
                                "example_id": "51ef4877-ed46-4c48-b31f-6699c3befe7c",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„Am 24. Oktober 1992 weihte Bischof Dr. Sigisbert Kraft die Turmkapelle.“"
                            },
                            {
                                "example_id": "fe62283b-9bcf-46a1-9c46-65eafe634e54",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„Am Eingang zur Turmkapelle steht die Bronzefigur des hl. Antonius von Egino Weinert (1978).“"
                            },
                            {
                                "example_id": "d834f36d-93e9-47a7-9f3e-658299d413ba",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„In der Turmkapelle des erhalten gebliebenen Kirchturmes konnten Gottesdienste gefeiert werden.“"
                            },
                            {
                                "example_id": "0fc7ccd1-3901-4b43-905b-22078a9d91ac",
                                "sense_id": "adf65e4c-1016-3369-90a2-54f0c26b10cd",
                                "text": "„Der Dombaumeister Helmut Maintz führt über enge Wendeltreppen zu den Turmkapellen, zur Galerie und über die Dachregion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
