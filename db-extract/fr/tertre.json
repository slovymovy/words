                "senses": [
                    {
                        "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                        "entry_id": "43bedaad-9dfd-3e5d-8491-d31a8d9ca6d3",
                        "glosses": [
                            "Monticule, éminence isolée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f47a05-50fa-4ccf-85d9-18ce458781a1",
                                "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                                "text": "Un château situé sur un tertre."
                            },
                            {
                                "example_id": "ba690102-698c-4056-aefb-5d57360d49aa",
                                "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                                "text": "Un tertre de gazon."
                            },
                            {
                                "example_id": "0aa98778-75ec-428c-a3ca-b61b7766e9cd",
                                "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                                "text": "…, il tomba subitement malade, se coucha au pied de la montagne de Kè Giàng et mourut. Les termites recouvrirent son corps d’un tertre."
                            },
                            {
                                "example_id": "9b0839be-d1a3-45ad-aeed-77443da2f4b6",
                                "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                                "text": "Non loin d’Apalachucla s’élevait, sur un tertre isolé, le pavillon du conseil."
                            },
                            {
                                "example_id": "0a8db4c4-5d1c-4f6b-9c8c-853fe1e775d6",
                                "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                                "text": "Mon chemin était presque transversal, du nord au sud, et passait par le tertre le plus haut."
                            },
                            {
                                "example_id": "91cf35cd-f34c-4cdc-acba-17cbff513b5a",
                                "sense_id": "e2dcf505-067b-39bb-ab4c-cad566992bea",
                                "text": "Tertre élevé."
                            }
                        ]
                    },
                    {
                        "sense_id": "53b7d88d-1195-32d8-941e-be44396e1487",
                        "entry_id": "43bedaad-9dfd-3e5d-8491-d31a8d9ca6d3",
                        "glosses": [
                            "Tumulus fait de terre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8d1e817d-c728-41ed-b35a-1730d21e93ec",
                                "sense_id": "53b7d88d-1195-32d8-941e-be44396e1487",
                                "text": "Il y avait au bout du parc un tertre gazonné assez élevé, dont on se servait en été comme glacière."
                            }
                        ]
                    }
