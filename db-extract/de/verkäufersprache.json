                "senses": [
                    {
                        "sense_id": "6e9eae6a-39f6-3ec8-be8c-e87b96c80303",
                        "entry_id": "f7b6b0ba-e91b-3036-9cb2-304e4837a8dc",
                        "glosses": [
                            "diejenige Ebene der Fachsprache, die der Kommunikation mit Interessierten/Kunden, nicht zum Betrieb gehörenden Personen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f428ce5-0255-4877-9c9a-155f4a139239",
                                "sense_id": "6e9eae6a-39f6-3ec8-be8c-e87b96c80303",
                                "text": "„Hans Ischreyt hat - ohne dies im einzelnen zu untersuchen - eine Stufung der Fachsprache vorgeschlagen: er unterscheidet eine wissenschaftliche Sprache von der Werkstattsprache und der Verkäufersprache.“"
                            },
                            {
                                "example_id": "bbedb849-76bd-4025-91f5-821e7b98ef59",
                                "sense_id": "6e9eae6a-39f6-3ec8-be8c-e87b96c80303",
                                "text": "„Der Begriff Verkäufersprache rührt aus der Konzentration der Fachsprachforschung auf die technischen Fachsprachen her.“"
                            },
                            {
                                "example_id": "501f3adc-3569-41cc-acd3-a5d10805f9be",
                                "sense_id": "6e9eae6a-39f6-3ec8-be8c-e87b96c80303",
                                "text": "„Der Verkäufer und der Kunde sprechen in der sogenannten Verkäufersprache (Ischreyt).“"
                            },
                            {
                                "example_id": "48a9bcf3-b199-44e3-ae92-28901ba00af5",
                                "sense_id": "6e9eae6a-39f6-3ec8-be8c-e87b96c80303",
                                "text": "„R. Pelka unterscheidet grob mit H. Ischreyt drei Sprachschichten: Wissenschaftssprache, Verkäufersprache und Betriebssprache (bei Ischreyt ›Werkstattsprache‹).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
