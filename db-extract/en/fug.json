                    }
                ],
                "senses": [
                    {
                        "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                        "entry_id": "11f082d1-9ce6-346f-bc03-1329bfb28fec",
                        "glosses": [
                            "Euphemistic form of fuck.",
                            "Used as an intensifier."
                        ],
                        "tags": [
                            "singular",
                            "singular-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2fcce1ff-1e96-4809-9d12-b176705d4846",
                                "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                "text": "I don't know jes where the fug he think he is at."
                            },
                            {
                                "example_id": "2b68a1f6-df87-43a5-9a8e-c2edcc550eda",
                                "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                "text": "How the fug does a thug like you know about any preacher?"
                            },
                            {
                                "example_id": "173ab5f2-9bfc-46d1-99fe-e4266a178000",
                                "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                "text": "I mean, who the fug cares?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d55b2d5-c2d2-3749-a87d-e82da60395f1",
                        "entry_id": "11f082d1-9ce6-346f-bc03-1329bfb28fec",
                        "glosses": [
                            "Euphemistic form of fuck.",
                            "Something of little value."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "076678c0-cd44-4596-885c-f7d7e95e111b",
                                "sense_id": "3d55b2d5-c2d2-3749-a87d-e82da60395f1",
                                "text": "I didn't know what any of it meant and didn't give a fug either."
                            },
                            {
                                "example_id": "17e89add-19c9-4ae8-924c-82fa1a314850",
                                "sense_id": "3d55b2d5-c2d2-3749-a87d-e82da60395f1",
                                "text": "After a short pause, Jay proclaimed, “I don't give a fug what you wave in fronna me. I'm sticking to my story.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe66c2f0-6add-3b2d-9afb-c27b7064ca05",
                        "entry_id": "11f082d1-9ce6-346f-bc03-1329bfb28fec",
                        "glosses": [
                            "Euphemistic form of fuck.",
                            "A contemptible person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2691c7-588e-4514-b3fb-903c34980d6c",
                                "sense_id": "fe66c2f0-6add-3b2d-9afb-c27b7064ca05",
                                "text": "Look at those fugs!"
                            },
                            {
                                "example_id": "9ee6b3a5-052f-431a-8ce6-be40fe87e299",
                                "sense_id": "fe66c2f0-6add-3b2d-9afb-c27b7064ca05",
                                "text": "'You bein' there an' him bein' there an' you such a fug of a loser an' him such a fug of a winner . . .'"
                            }
                        ]
                    }
                ],
