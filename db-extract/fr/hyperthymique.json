                "senses": [
                    {
                        "sense_id": "2bae67ea-ddd7-3d86-9241-c240c06cd082",
                        "entry_id": "0b800b15-96f8-3474-a71f-629aaa5cf5f1",
                        "glosses": [
                            "Relatif à l’hyperthymie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a173ba9-d83e-4a8a-8fe2-2961bdf2de1d",
                                "sense_id": "2bae67ea-ddd7-3d86-9241-c240c06cd082",
                                "text": "On classe aussi sous cette étiquette les patients souffrant de récurrences dépressives sans aucun épisode hypomaniaque, mais ayant des antécédents familiaux avérés de bipolarité, ou présentant eux-mêmes un tempérament (une personnalité) hyperthymique."
                            },
                            {
                                "example_id": "8e5e8658-fac6-442a-9768-f6d279380fb3",
                                "sense_id": "2bae67ea-ddd7-3d86-9241-c240c06cd082",
                                "text": "Les personnes avec un tempérament hyperthymique sont décrites comme exubérantes, énergiques, extraverties, avec une attitude optimiste, et ayant d’habitude besoin de moins de sommeil que les autres."
                            },
                            {
                                "example_id": "1737c234-928a-4eaf-8de9-2615ded76587",
                                "sense_id": "2bae67ea-ddd7-3d86-9241-c240c06cd082",
                                "text": "Le tempérament hyperthymique (sensation extrême de bien-être, euphorie, exubérance) est plus souvent rencontré chez les personnes nées au printemps et en été."
                            }
                        ]
                    }
                ],
