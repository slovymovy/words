                        "examples": [
                            {
                                "example_id": "42d2dbc0-d72d-4bef-ab6c-040c85cbc37f",
                                "sense_id": "5437203a-aa03-3991-b846-08be958dbc1c",
                                "text": "Het doel was om de Strator II minstens 50 kilometer de hoogte in te schieten. De bijzondere brandstofcombinatie moest daarvoor zorgen. Met de brandstof op basis van suiker en kaarsvet ging alles goed, maar de 50 kilometer werd niet gehaald. Volgens onofficiële metingen heeft de raket een hoogte van 21 kilometer bereikt, een Europees hoogterecord."
                            },
                            {
                                "example_id": "d5f875b8-de15-43c3-a535-f736627d9f98",
                                "sense_id": "5437203a-aa03-3991-b846-08be958dbc1c",
                                "text": "Begin dit jaar was er juist sprake van een hoogwatergolf bij Lobith. Op 10 januari was er een hoogterecord: 14,65 boven NAP."
                            }
                        ]
                    }
