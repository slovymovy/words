{
    "word_family": [
        "voddenman",
        "voddenmand",
        "voddenmarkt",
        "voddenboer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b756ec1f-c8f1-317d-983d-09082dc8260c",
                    "sense_definition": "een versleten of gescheurd stuk stof of kleding",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was zijn motor aan het poetsen met een <w>vod</w>.",
                            "target_lang_translations": {
                                "en": "He was cleaning his motorcycle with a <w>rag</w>.",
                                "fr": "Il nettoyait sa moto avec un <w>chiffon</w>."
                            }
                        },
                        {
                            "text": "Zij waren keurig gekleed en wij droegen alleen maar versleten <w>vodden</w>.",
                            "target_lang_translations": {
                                "en": "They were neatly dressed and we were only wearing worn-out <w>rags</w>.",
                                "fr": "Ils étaient habillés proprement et nous ne portions que des <w>guenilles</w> usées."
                            }
                        }
                    ],
                    "synonyms": [
                        "lap",
                        "lompe",
                        "doek"
                    ],
                    "common_phrases": [
                        "oude vod",
                        "vuile vod"
                    ],
                    "target_lang_definitions": {
                        "en": "a worn or torn piece of fabric or clothing",
                        "fr": "un morceau de tissu ou un vêtement usé ou déchiré"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rag",
                                "target_lang_sense_clarification": "a piece of old cloth used for cleaning or patching"
                            },
                            {
                                "target_lang_word": "rags",
                                "target_lang_sense_clarification": "tattered or worn-out clothing"
                            },
                            {
                                "target_lang_word": "scrap",
                                "target_lang_sense_clarification": "a small fragment of cloth"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "chiffon",
                                "target_lang_sense_clarification": "morceau de vieux tissu utilisé pour nettoyer"
                            },
                            {
                                "target_lang_word": "guenilles",
                                "target_lang_sense_clarification": "vêtements en lambeaux ou très usés"
                            },
                            {
                                "target_lang_word": "loque",
                                "target_lang_sense_clarification": "morceau de tissu vieux et sale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "088707d2-2fca-34ac-a4d8-1fb3f7f177f1",
                    "sense_definition": "iets wat geen waarde heeft, vooral een waardeloos stuk papier of document",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waardeloos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat contract is niet meer dan een <w>vod</w> papier.",
                            "target_lang_translations": {
                                "en": "That contract is nothing more than a <w>scrap</w> of paper.",
                                "fr": "Ce contrat n'est rien de plus qu'un <w>torchon</w> de papier."
                            }
                        },
                        {
                            "text": "Hij smeet het waardeloze <w>vod</w> direct in de prullenbak.",
                            "target_lang_translations": {
                                "en": "He threw the worthless <w>scrap</w> directly into the trash can.",
                                "fr": "Il a jeté ce <w>torchon</w> sans valeur directement à la poubelle."
                            }
                        }
                    ],
                    "synonyms": [
                        "prul",
                        "vodje"
                    ],
                    "common_phrases": [
                        "vod papier"
                    ],
                    "target_lang_definitions": {
                        "en": "something of no value, especially a worthless piece of paper or document",
                        "fr": "quelque chose qui n'a aucune valeur, en particulier un document ou un papier sans intérêt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrap",
                                "target_lang_sense_clarification": "a worthless piece of paper"
                            },
                            {
                                "target_lang_word": "rag",
                                "target_lang_sense_clarification": "a low-quality newspaper or document"
                            },
                            {
                                "target_lang_word": "piece of junk",
                                "target_lang_sense_clarification": "something completely worthless"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "torchon",
                                "target_lang_sense_clarification": "document ou journal de très mauvaise qualité"
                            },
                            {
                                "target_lang_word": "papier sans valeur",
                                "target_lang_sense_clarification": "document inutile ou insignifiant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c52d39e-e003-3eff-b289-1b0d5a10cfe6",
                    "sense_definition": "een zinloos of onbelangrijk praatje",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb geen zin om naar dat <w>vod</w> van hem te luisteren.",
                            "target_lang_translations": {
                                "en": "I don't feel like listening to that <w>rubbish</w> of his.",
                                "fr": "Je n'ai pas envie d'écouter ses <w>balivernes</w>."
                            }
                        },
                        {
                            "text": "Zijn hele toespraak was eigenlijk één groot <w>vod</w>.",
                            "target_lang_translations": {
                                "en": "His entire speech was actually one big pile of <w>nonsense</w>.",
                                "fr": "Tout son discours n'était en fait que du <w>n'importe quoi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "beuzelarij",
                        "onzin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a meaningless or unimportant talk or piece of writing",
                        "fr": "un discours ou un écrit dénué de sens ou sans importance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rubbish",
                                "target_lang_sense_clarification": "nonsense or worthless talk"
                            },
                            {
                                "target_lang_word": "trash",
                                "target_lang_sense_clarification": "worthless communication or content"
                            },
                            {
                                "target_lang_word": "nonsense",
                                "target_lang_sense_clarification": "meaningless words"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "balivernes",
                                "target_lang_sense_clarification": "propos sans intérêt ou absurdes"
                            },
                            {
                                "target_lang_word": "n'importe quoi",
                                "target_lang_sense_clarification": "propos dénués de sens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}