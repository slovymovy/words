{
    "word_family": [
        "fluster"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49165bc4-58e6-385d-ac85-47e1c9b25d21",
                    "sense_definition": "Confused, befuddled, or in a state of panic due to being overwrought with confusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker became quite <w>flustered</w> when she dropped all her notes.",
                            "target_lang_translations": {
                                "zh": "演讲者把笔记掉了一地，显得十分<w>慌张</w>。"
                            }
                        },
                        {
                            "text": "The student felt <w>flustered</w> during the exam because of the time pressure.",
                            "target_lang_translations": {
                                "zh": "由于时间紧迫，学生在考试时感到<w>不知所措</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get flustered",
                        "look flustered"
                    ],
                    "target_lang_definitions": {
                        "zh": "因困惑、忙乱或压力而感到慌张、不知所措。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慌张",
                                "target_lang_sense_clarification": "形容因突发状况而感到心慌意乱。"
                            },
                            {
                                "target_lang_word": "不知所措",
                                "target_lang_sense_clarification": "形容因情况复杂或压力大而感到手足无措。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b39c8a95-96f0-36b9-b88e-1a7e732e018d",
                    "sense_definition": "Emotionally overwhelmed or visibly embarrassed, especially in a romantic context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became <w>flustered</w> when his crush suddenly walked into the room.",
                            "target_lang_translations": {
                                "zh": "当他暗恋的人突然走进房间时，他显得十分<w>局促不安</w>。"
                            }
                        },
                        {
                            "text": "She looked <w>flustered</w> after receiving the unexpected compliment.",
                            "target_lang_translations": {
                                "zh": "收到那句意料之外的赞美后，她显得有些<w>面红耳赤</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因情绪激动或尴尬而显得局促不安。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "局促不安",
                                "target_lang_sense_clarification": "形容因害羞或尴尬而表现出的不自然状态。"
                            },
                            {
                                "target_lang_word": "面红耳赤",
                                "target_lang_sense_clarification": "形容因尴尬或害羞而脸红的样子。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47f4f024-568d-3882-945e-a5989b7cfd6f",
                    "sense_definition": "Past tense and past participle of <w>fluster</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected question <w>flustered</w> the candidate during the interview.",
                            "target_lang_translations": {
                                "zh": "面试中那个意想不到的问题<w>扰乱</w>了候选人的思绪。"
                            }
                        },
                        {
                            "text": "She had been <w>flustered</w> by the sudden change in plans.",
                            "target_lang_translations": {
                                "zh": "计划的突然改变让她感到<w>慌乱</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到慌乱或不知所措（动词 fluster 的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……慌乱",
                                "target_lang_sense_clarification": "指导致某人失去镇定。"
                            },
                            {
                                "target_lang_word": "扰乱",
                                "target_lang_sense_clarification": "指打乱某人的思绪或计划。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}