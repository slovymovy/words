                ],
                "senses": [
                    {
                        "sense_id": "865d0f25-ec4d-316f-9f68-4b68d0497a80",
                        "entry_id": "a4befcb3-dab3-3fe3-a3ce-f0ad6dba33c6",
                        "glosses": [
                            "Anziehungskraft"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "381c8cff-0764-4993-9896-63cb77c63944",
                        "source_entry_id": "a4befcb3-dab3-3fe3-a3ce-f0ad6dba33c6",
                        "source_sense_id": "865d0f25-ec4d-316f-9f68-4b68d0497a80",
                        "source_sense_description": "Anziehungskraft",
                        "target_lang_word": "Anziehungskraft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anziehungskraft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                        "entry_id": "e3c46e40-31b1-3fa7-975c-1b440d3fae88",
                                        "glosses": [
                                            "anziehend wirkende, auf einen Punkt gerichtete Kraft"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b3645b-edcb-4cb6-9d71-f8354c91ed1a",
                                                "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                                "text": "Auf dem Mond und auf der Erde erfährt der gleiche Körper unterschiedliche Anziehungskräfte."
                                            },
                                            {
                                                "example_id": "6d88752e-8301-4e02-b2c2-c499f2f75655",
                                                "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                                "text": "[Chemie: …:] „Beim Lösen eines Salzes muss zunächst die Gitterenergie aufgewendet werden, um die Anziehungskräfte zwischen den Ionen im Kristallgitter zu überwinden und die Ionen voneinander zu trennen.“"
                                            },
                                            {
                                                "example_id": "c7a3945e-b4a9-4004-9390-0cb5b35cd0a0",
                                                "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                                "text": "Ob die elektromagnetische Wechselwirkung eine Anziehungskraft ist, hängt von dem Vorzeichen der Ladung ab, durch die sie erzeugt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                        "entry_id": "e3c46e40-31b1-3fa7-975c-1b440d3fae88",
                                        "glosses": [
                                            "Eigenschaft, Interesse zu erwecken, zu faszinieren"
                                        ],
                                        "tags": [
                                            "in Bezug auf Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d42e2b1a-3355-41db-96c2-460fcede6300",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "Eine große, leuchtende Werbetafel hat eine gewisse Anziehungskraft."
                                            },
                                            {
                                                "example_id": "16032bd8-e95f-4407-aaa5-652b86cbd9fa",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Hätte Hitler nur bramarbasiert, ohne irgendwelche greifbaren Ergebnisse vorzuweisen, dann hätte Enttäuschung seine Anziehungskraft natürlich rasch schwinden lassen.“"
                                            },
                                            {
                                                "example_id": "b9267ad6-a914-4791-a9ce-16f5f3649756",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Vor allem auf Frauen, die von ihren Männern geschlagen werden, übt Awra Amba eine magische Anziehungskraft aus.“"
                                            },
                                            {
                                                "example_id": "c384dc7f-80bc-46d3-b10e-ed8a1b756b47",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Auch Martin spürte diese sonderbare Anziehungskraft.“"
                                            },
                                            {
                                                "example_id": "a3965562-e4d7-46ec-b808-24d350e4e980",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Allerdings ließ die Anziehungskraft des jungen Mannes eine Weile später nach.“"
                                            },
                                            {
                                                "example_id": "04171baf-cbba-4654-879d-1617bb8d9fad",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Zachäus ist von der Anziehungskraft Jesu begeistert.“"
                                            },
                                            {
                                                "example_id": "e22dabe4-e75c-49e1-b0a7-d85100862eb3",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Durch die Anziehungskraft von künstlichem Licht auf Insekten sterben allein in Deutschland schätzungsweise pro Sommer 100 Milliarden Individuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ca1725b-714c-429f-9ef0-6b98de372911",
                        "source_entry_id": "a4befcb3-dab3-3fe3-a3ce-f0ad6dba33c6",
                        "source_sense_id": "865d0f25-ec4d-316f-9f68-4b68d0497a80",
                        "source_sense_description": "Anziehungskraft",
                        "target_lang_word": "attraction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attraction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0fc83a-292a-3a97-b298-b9ecc69ec076",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The tendency to attract."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdc504c1-3d8a-48c9-b97f-2d1bbf272678",
                                                "sense_id": "2f0fc83a-292a-3a97-b298-b9ecc69ec076",
                                                "text": "The Moon is held in its orbit by the attraction of the Earth's gravity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2efb46d3-2b28-3f17-9fd9-78d89d196422",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The feeling of being attracted (to something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588b7682-6480-43a2-adbf-da74afb2d9da",
                                                "sense_id": "2efb46d3-2b28-3f17-9fd9-78d89d196422",
                                                "text": "I felt a strange attraction towards the place."
                                            },
                                            {
                                                "example_id": "a1051571-6d38-40b7-a821-f180473663a4",
                                                "sense_id": "2efb46d3-2b28-3f17-9fd9-78d89d196422",
                                                "text": "When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose. And the queerer the cure for those ailings the bigger the attraction. A place like the Right Livers' Rest was bound to draw freaks, same as molasses draws flies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "The feeling of being attracted (to something).",
                                            "Sexual or romantic desire (especially for a specified individual, kind of person, etc)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24007ca8-7d4d-441a-86b1-9ec7d3f215e3",
                                                "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                                                "text": "Murphy struggled with his attraction to men while remaining happily married all his life, daily negotiating the challenges of living in two locations simultaneously. These doublings of desire and emotional attachment left their trace in the multiple doublings within […] the billboard painting he made to signpost the home he created with his wife Sara […]"
                                            },
                                            {
                                                "example_id": "d3efdcbc-3366-4f89-b4d3-712270a72d87",
                                                "sense_id": "e175e395-d2df-3521-ab11-a64e69676fd7",
                                                "text": "\"I'm asexual,\" Yazhiisai said, the words spilling out faster than she intended. \"I don't experience attraction the way most people do. I'm telling you this because I don't want there to be any surprises.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
                                        "glosses": [
                                            "An event, location, or business that has a tendency to draw interest from visitors, and in many cases, local residents."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a6df023-eabe-4a38-a40b-3d78e5f92c6f",
                                                "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                                                "text": "The new mall should be a major attraction."
                                            },
                                            {
                                                "example_id": "27fde16d-a88c-439d-8e21-eeced8e7242c",
                                                "sense_id": "a002d985-dfac-3ff5-9c6c-096c242b4d75",
                                                "text": "Star Tours is a very cool Disney World attraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e4d7aac-c396-3fdc-a5ed-28be48bad1a2",
                                        "entry_id": "23f07461-bb0e-38d1-87ba-5898ddb9671a",
