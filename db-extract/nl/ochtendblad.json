                        "entry_id": "111f3258-02a4-3751-8433-862881cf6496",
                        "glosses": [
                            "een krant die 's morgens vroeg wordt bezorgd"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "18d60ef0-d167-4475-87b7-414704b1da0e",
                                "sense_id": "0ed6aa98-4bc4-301c-b301-864043a6297a",
                                "text": "We zijn altijd op zoek naar gemotiveerde bezorgers voor het verspreiden van onze ochtendbladen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c614d0c3-f274-4711-b00c-05860c66890a",
                        "source_entry_id": "111f3258-02a4-3751-8433-862881cf6496",
                        "source_sense_id": "0ed6aa98-4bc4-301c-b301-864043a6297a",
                        "source_sense_description": "een krant die 's morgens vroeg wordt bezorgd",
                        "target_lang_word": "Morgenzeitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morgenzeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9b79f5d-50d7-3448-a2d4-f8daf3f8c0de",
                                        "entry_id": "396a56e0-d8ca-3469-a641-5ce4de0ef0d0",
                                        "glosses": [
                                            "Tageszeitung, die am Morgen erscheint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2494f206-fd36-44b8-be22-e1b1bbeda09d",
                                                "sense_id": "e9b79f5d-50d7-3448-a2d4-f8daf3f8c0de",
                                                "text": "„Er strich Marmelade aufs Brot, holte die Morgenzeitungen und schlug eine davon auf.“"
                                            },
                                            {
                                                "example_id": "b089dee7-52c5-40f9-a0af-4de6e1e261c9",
                                                "sense_id": "e9b79f5d-50d7-3448-a2d4-f8daf3f8c0de",
                                                "text": "„Die Morgenzeitungen haben auch keine Erlösung gebracht.“"
                                            },
                                            {
                                                "example_id": "43f5a6b7-9ada-467f-987b-bb82cd8f6a4e",
                                                "sense_id": "e9b79f5d-50d7-3448-a2d4-f8daf3f8c0de",
                                                "text": "„Die Morgenzeitungen hatten nun allgemein die Mobilmachung der russischen Armee verkündet, was zwangsläufig eine entsprechende Reaktion des Kaiserreichs auslösen musste, wie wenigstens alle »gedienten« deutschen Männer wussten.“"
                                            },
                                            {
                                                "example_id": "2d4af633-f485-44cd-a481-44d9470a087c",
                                                "sense_id": "e9b79f5d-50d7-3448-a2d4-f8daf3f8c0de",
                                                "text": "„Ich stand da im Laden und blickte auf die frischen Morgenzeitungen, auf die die meisten Männer so verrückt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
