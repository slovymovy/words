                        ],
                        "form": "ragworts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee997671-0587-392f-914d-315fb89a2c1d",
                        "entry_id": "05d0c7c8-6702-3e01-9cfa-00331b0c2129",
                        "glosses": [
                            "Any of a number of wild flowering plants with yellow flowers in the family Asteraceae, mostly belonging to Senecio and related genera."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "361c26c8-50bb-493d-9772-819d0a1c1aae",
                                "sense_id": "ee997671-0587-392f-914d-315fb89a2c1d",
                                "text": "Ragwort is under the command of dame Venus, and cleanses, digests and discusses."
                            },
                            {
                                "example_id": "c8ce9e1b-28b6-4a88-855b-32c5fd108a2e",
                                "sense_id": "ee997671-0587-392f-914d-315fb89a2c1d",
                                "text": "Sea-poppies and ragwort were plants of ill-fame, too."
                            },
                            {
                                "example_id": "cfcba7ea-d8f8-4afa-8e0e-8b5ca00cb14a",
                                "sense_id": "ee997671-0587-392f-914d-315fb89a2c1d",
                                "text": "As we all know, witches ride through the air on a broom, but sometimes their means of locomotion was a bulrush, a branch of thorn, mullein stalks, cornstalk, or ragweed, called fairies' horse in Ireland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10e8e1c9-e016-4bfb-89dd-d313ccb52dac",
                        "source_entry_id": "05d0c7c8-6702-3e01-9cfa-00331b0c2129",
                        "source_sense_id": "ee997671-0587-392f-914d-315fb89a2c1d",
