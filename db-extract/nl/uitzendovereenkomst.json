                "senses": [
                    {
                        "sense_id": "b392ed89-da80-30a3-ae75-9b50ac82d18c",
                        "entry_id": "60c4d103-3e82-3a1a-95c2-382931d0e8cc",
                        "glosses": [
                            "bijzondere arbeidsovereenkomst met drie partijen de werknemer, het uitzendbureau en de organisatie waar de werknemer daadwerkelijk werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f5b3bf1-a768-4348-9978-2a558b5b2c6b",
                                "sense_id": "b392ed89-da80-30a3-ae75-9b50ac82d18c",
                                "text": "Het loon wordt door de schoonmaker en het huishouden bepaald, en maar ten dele door Helpling. Er is dus geen sprake van een arbeidsovereenkomst, maar van een uitzendovereenkomst."
                            },
                            {
                                "example_id": "5254b704-23b7-4299-86a7-ffa05bf10b49",
                                "sense_id": "b392ed89-da80-30a3-ae75-9b50ac82d18c",
                                "text": "Een uitzendkracht wordt geworven door een uitzendbureau, door een intercedent, zoals Randstad. Na gesprekken wordt iemand tijdelijk ingezet. Dat kan ook heel lang duren. Dan gaat het om structureel werk. Maar het blijft een uitzendovereenkomst. Raakt iemand na vijf jaar z’n baan kwijt, dan kan het uitzendbureau bemiddelen zodat de arbeidskracht een andere baan vindt."
                            },
                            {
                                "example_id": "82b1970e-3311-4351-b686-021e8139e9e0",
                                "sense_id": "b392ed89-da80-30a3-ae75-9b50ac82d18c",
                                "text": "Voor de lange termijn wordt er een onderzoekscommissie ingesteld die onderzoek doet naar de introductie van een ondernemersovereenkomst, de herziening van de uitzendovereenkomst en andere arbeidsmarktvraagstukken."
                            }
                        ]
                    }
