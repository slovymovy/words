                        "entry_id": "89fccfe5-28af-3e67-97ea-789622fb583d",
                        "glosses": [
                            "Celui qui absout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497c9f47-7eb4-41ba-b271-920fd0b1a8b6",
                                "sense_id": "49b5b69c-37ec-3b0c-8932-20d5f02b1546",
                                "text": "Depuis que j’ai atteint l’âge de raison, j’ai une propension à jouet les redresseurs de torts – sous la réserve qu’il ne m’en coûte pas trop – les absoluteurs magnanimes."
                            }
                        ]
                    }
