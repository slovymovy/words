                    {
                        "sense_id": "069e28cd-27c0-3718-94bb-05984963324b",
                        "entry_id": "9266be31-bfa4-3453-927e-75ab8f550ef9",
                        "glosses": [
                            "Musiker in einer Band, der mit Gitarre den Rhythmus und die Begleitung spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584fe1c9-d783-493d-9523-db977e572068",
                                "sense_id": "069e28cd-27c0-3718-94bb-05984963324b",
                                "text": "„Der Rhythmusgitarrist mit dem dicken Schnäuzer, Jakes Jacobs, der meistens auch sang, hatte jede Menge Spott für seine eigenwillige Aussprache des Französischen über sich ergehen lassen müssen.“"
                            },
                            {
                                "example_id": "7b9d2b4b-5b53-4e30-83c8-95a156a73795",
                                "sense_id": "069e28cd-27c0-3718-94bb-05984963324b",
                                "text": "„New Red war der Leadsänger und Rhythmusgitarrist, ein junger Mann mit sandfarbenem Haar und Bart.“"
                            }
                        ],
