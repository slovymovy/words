    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b570a360-18be-37de-b313-82dbe041391d",
                    "sense_definition": "A logical operator or Boolean function that produces a false value only when all of its inputs are true; the negation of AND.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logic_gate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer designed the digital circuit using several <w>NAND</w> gates to simplify production.",
                            "target_lang_translations": {
                                "tr": "Mühendis, üretimi basitleştirmek için dijital devreyi birkaç <w>VE DEĞİL</w> kapısı kullanarak tasarladı."
                            }
                        },
                        {
                            "text": "In Boolean logic, a <w>NAND</w> operation is equivalent to applying an AND operation followed by a NOT.",
                            "target_lang_translations": {
                                "tr": "Boole mantığında bir <w>VE DEĞİL</w> işlemi, bir VE işleminin ardından bir DEĞİL işlemi uygulamaya eşdeğerdir."
                            }
                        }
                    ],
                    "antonyms": [
                        "AND"
                    ],
                    "common_phrases": [
                        "NAND gate",
                        "NAND flash"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yalnızca tüm girdileri doğru olduğunda yanlış değeri üreten bir mantıksal işleç veya Boole fonksiyonu; VE DEĞİL (VE işleminin değili)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "VE DEĞİL",
                                "target_lang_sense_clarification": "mantık işlemi veya kapısı"
                            },
                            {
                                "target_lang_word": "NAND",
                                "target_lang_sense_clarification": "elektronik ve bilişimde yaygın terim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e85dd5f6-8599-3e46-9202-4ab6497ab986",
                    "sense_definition": "Alternative letter-case form of <w>NAND</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic_gate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The textbook used lower-case letters, writing <w>nand</w> where most documentation preferred capital letters.",
                            "target_lang_translations": {
                                "tr": "Ders kitabı küçük harfler kullanarak çoğu dokümantasyonun büyük harf tercih ettiği yerlerde <w>nand</w> yazıyordu."
                            }
                        },
                        {
                            "text": "In some programming contexts, the operator is represented simply as <w>nand</w>.",
                            "target_lang_translations": {
                                "tr": "Bazı programlama bağlamlarında bu işleç yalnızca <w>nand</w> olarak gösterilir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative capitalization"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "NAND teriminin küçük harfle yazılmış biçimi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nand",
                                "target_lang_sense_clarification": "küçük harfli yazım"
                            },
                            {
                                "target_lang_word": "ve değil",
                                "target_lang_sense_clarification": "küçük harfli yazım"
                            }
                        ]
                    }
                }
            ]
        },
        {
