                                    {
                                        "sense_id": "e92657cb-981f-3859-81d9-e39ce3d565f9",
                                        "entry_id": "cf2047d9-d934-31f1-ad15-4e74aac1f7d8",
                                        "glosses": [
                                            "etwas oder jemandem einen neuen/anderen Namen geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582634ff-724f-44bc-a71c-c7c3bcc3f6b8",
                                                "sense_id": "e92657cb-981f-3859-81d9-e39ce3d565f9",
                                                "text": "„In der SED dort kam man eines Tages auf die Idee, den im Erzgebirge hergestellten, bei der Bevölkerung beliebten kerzengeschmückten Weihnachtsengel in die weltanschaulich unverfängliche «Jahresendfigur» umzutaufen.“"
                                            },
                                            {
                                                "example_id": "16274d62-0281-4a59-a997-407f7d480917",
                                                "sense_id": "e92657cb-981f-3859-81d9-e39ce3d565f9",
                                                "text": "„Noch 1935 fragte Strauss polemisch bei Clemens Krauss an, ob er sich »Strossano umtaufen lassen« sollte, um an der Berliner Staatsoper in ausreichendem Maße - vielmehr, was er dafür hielt - aufgeführt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea21f2d2-37e5-3664-832e-aec5d45af26f",
                                        "entry_id": "cf2047d9-d934-31f1-ad15-4e74aac1f7d8",
                                        "glosses": [
                                            "eine weitere/andere Form der Taufe durchführen (lassen)"
                                        ],
                                        "tags": [
                                            "Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef0868d-e186-443a-8aa2-7c2077c1016d",
                                                "sense_id": "ea21f2d2-37e5-3664-832e-aec5d45af26f",
                                                "text": "„Der Papst sprach zuerst seinen Schmerz aus über die Verwüstung der afrikanischen Kirchen, wo nicht Laien und niedere Kleriker, sondern auch Diakone, Priester und Bischöfe sich hätten umtaufen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
