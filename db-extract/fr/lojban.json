                                            {
                                                "example_id": "408628e5-5cbd-4e81-9f4a-a77a47b31c59",
                                                "sense_id": "d829aaf5-0cdd-34cc-93b9-12158542669c",
                                                "text": "Das Lojban ist eine Plansprache."
                                            },
                                            {
                                                "example_id": "0f30b0a1-3d99-420c-9e6a-557486183755",
                                                "sense_id": "d829aaf5-0cdd-34cc-93b9-12158542669c",
                                                "text": "„Ein spezifisches Merkmal von Lojban ist, dass die bedeutungstragenden Wörter nicht in Verben, Substantive, usw. unterschieden werden.“"
                                            },
                                            {
                                                "example_id": "fccdff51-0f98-4682-8daa-9ef9c8e9d889",
                                                "sense_id": "d829aaf5-0cdd-34cc-93b9-12158542669c",
                                                "text": "„Hier soll noch einmal schnell die Aussprache von Lojban erläutert werden. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
