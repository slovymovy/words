                "senses": [
                    {
                        "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                        "entry_id": "13317c9d-a16f-3bae-9135-bf1d372ba304",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db2708e2-cb7c-4f54-aabc-b9451a4c03a5",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Frau Kackstein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "686feaa6-87f1-45fd-8469-1af4c5d0fdb6",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Herr Kackstein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c3e7b6ad-e9a0-41c0-afae-b75dce5e22f7",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Die Kacksteins fahren heute nach Berlin."
                            },
                            {
                                "example_id": "45994001-3d92-474c-b04c-dd4f5297a9e8",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Der Kackstein trägt nie die Schals, die die Kackstein ihm strickt."
                            },
                            {
                                "example_id": "a985be58-42f6-4a79-8bcd-b8196a202a73",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kackstein kommt, geht der Herr Kackstein.“"
                            },
                            {
                                "example_id": "93f7e357-0077-4196-a0a1-db3b0e5e860d",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Kackstein kommt und geht."
                            },
                            {
                                "example_id": "f7c81a39-2bb5-4f93-b169-da6842ea5b9f",
                                "sense_id": "ec7d41cb-f935-3fe5-9a47-64ab4fb4f5ea",
                                "text": "Kacksteins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
