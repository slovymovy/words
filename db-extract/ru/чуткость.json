                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f391c5a-5e39-3df5-96da-50c891261f10",
                                        "entry_id": "d3001ebf-abf3-3491-aa30-4a992d0e9640",
                                        "glosses": [
                                            "The quality or state of being sensitive; sensitiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32560ab3-c0fb-4633-9250-2e9e7f3ffc40",
                                                "sense_id": "9f391c5a-5e39-3df5-96da-50c891261f10",
                                                "text": "In any event, the incident, and the media attention it attracted, highlights the sensitivity of language politics in Singapore and is reflective of the fact that this sensitivity extends to campus life."
                                            },
                                            {
                                                "example_id": "c983bc95-04c7-476e-a427-29ec18c41359",
                                                "sense_id": "9f391c5a-5e39-3df5-96da-50c891261f10",
                                                "text": "Owing to sensitivities about the force's capabilities, Russell is unable to say how many drones BTP has, or where and when they operate. But he does confide that the force works hand in hand with the helicopter service, and its ability to deploy drones is getting quicker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc2323e-fab5-3ea3-bdc4-373d37e0e793",
                                        "entry_id": "d3001ebf-abf3-3491-aa30-4a992d0e9640",
                                        "glosses": [
                                            "The ability of an organism or organ to respond to external stimuli."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db672b07-fa68-4963-8454-5c708934601c",
                                                "sense_id": "fcc2323e-fab5-3ea3-bdc4-373d37e0e793",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            },
                                            {
                                                "example_id": "b290f53c-6c95-4804-af7e-f141d291d384",
                                                "sense_id": "fcc2323e-fab5-3ea3-bdc4-373d37e0e793",
                                                "text": "A coenzyme that exists in all living cells, NAD+ plays a central role in the body’s biological processes, such as regulating cellular energy, increasing insulin sensitivity and reversing mitochondrial dysfunction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a29619-701d-39d6-b694-d286aa0ed8d9",
                                        "entry_id": "d3001ebf-abf3-3491-aa30-4a992d0e9640",
                                        "glosses": [
                                            "The ability of an organism or organ to respond to external stimuli.",
                                            "Vulnerability to medical treatment: Synonym of susceptibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31563754-1eab-3344-8888-b3c3e6a0cacc",
                                        "entry_id": "d3001ebf-abf3-3491-aa30-4a992d0e9640",
                                        "glosses": [
                                            "The probability, in a binary classification test, of a true positive being correctly identified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c371ef53-61d8-4a6d-b00d-14cec0946512",
                                                "sense_id": "31563754-1eab-3344-8888-b3c3e6a0cacc",
                                                "text": "Coordinate term: specificity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b90db84-f799-370d-9754-1805364168ed",
                                        "entry_id": "d3001ebf-abf3-3491-aa30-4a992d0e9640",
                                        "glosses": [
                                            "The degree of response of an instrument to a change in an input signal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fa193a6-71c6-4dfb-9665-01306a420c2c",
                                                "sense_id": "7b90db84-f799-370d-9754-1805364168ed",
                                                "text": "Up to 1,884 microplastic particles were found per cubic metre of seawater in some locations, up to 18 times higher than in similar tests during the last Ocean Race, which ended in 2018. Scientists noted that the sensitivity of their instruments is now higher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a298bb-b409-3b85-9cd7-8a99d093b194",
                                        "entry_id": "d3001ebf-abf3-3491-aa30-4a992d0e9640",
