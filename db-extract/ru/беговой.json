                                        "sense_id": "f90a91c4-938c-3867-adf6-570fa651c1ac",
                                        "entry_id": "91d7d1fb-443b-3cdd-a183-210bf3fdcfb1",
                                        "glosses": [
                                            "The sport of competing in races."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a36cf34a-25b4-435c-8066-46ceee7b90a0",
                                                "sense_id": "f90a91c4-938c-3867-adf6-570fa651c1ac",
                                                "text": "Chariot racings are probably, however, those in which the horse first distinguished himself as a courser, and we believe our earliest notices on the subject point to those of Persia, which were practised at the sacrifices made to the sun […]"
                                            },
                                            {
