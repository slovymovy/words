                },
                {
                    "sense_id": "ba0ee8a6-8fb5-32dd-b819-06634d88f64f",
                    "sense_definition": "Relating to incipient tooth decay or caries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist identified a <w>precarious</w> lesion on the surface of the molar.",
                            "target_lang_translations": {
                                "ru": "Стоматолог обнаружил <w>предкариозное</w> поражение на поверхности коренного зуба.",
                                "tr": "Diş hekimi, azı dişinin yüzeyinde <w>çürük öncesi</w> bir lezyon tespit etti."
                            }
                        },
                        {
                            "text": "Early intervention can prevent a <w>precarious</w> spot from developing into a full cavity.",
                            "target_lang_translations": {
                                "ru": "Раннее вмешательство может предотвратить перерастание <w>начального кариозного</w> пятна в полноценный кариес.",
                                "tr": "Erken müdahale, <w>çürük başlangıcı</w> olan bir noktanın tam bir çürüğe dönüşmesini engelleyebilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "precarious lesion"
                    ],
                    "traits": [
