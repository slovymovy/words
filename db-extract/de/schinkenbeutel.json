                "senses": [
                    {
                        "sense_id": "ea2f71b3-8777-36d9-a459-dae4937da35b",
                        "entry_id": "c5b12e85-708a-3d10-8e31-a37a648c238e",
                        "glosses": [
                            "Leinensäckchen, das beim Trocknen und Reifen von aus der Hausschlachtung stammendem Schweineschinken als Fliegenschutz diente"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4882c24f-78e7-4803-835f-fa03c111be1c",
                                "sense_id": "ea2f71b3-8777-36d9-a459-dae4937da35b",
                                "text": "\"Schinkenbeutel. Leinensack, in dem der Schinken vor Fliegen und Maden geschützt werden soll: […] die Schinken werden im Sommer im Schinkenbeutel aufbewahrt.\""
                            },
                            {
                                "example_id": "858df7cb-38c3-4c45-bf02-100530434c3e",
                                "sense_id": "ea2f71b3-8777-36d9-a459-dae4937da35b",
                                "text": "[…] verpackt in rot-weiß-karierten Schinkenbeuteln und Karton"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14ed2464-3d5e-3b14-96b6-e6f5f6ab4f42",
                        "entry_id": "c5b12e85-708a-3d10-8e31-a37a648c238e",
                        "glosses": [
                            "große weibliche Unterhose oder Schlüpfer"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "4b7a23a5-ad7b-4dd2-b7fc-2b26a61cbede",
                                "sense_id": "14ed2464-3d5e-3b14-96b6-e6f5f6ab4f42",
                                "text": "\"Sie hält keine Unterhose, sondern einen Schinkenbeutel Größe 52 mit großem Rosenmuster in die Höhe und schwenkt ihn wie eine Fahne.\""
                            },
                            {
                                "example_id": "b240ebb5-07f9-45be-91d2-df723ff6105c",
                                "sense_id": "14ed2464-3d5e-3b14-96b6-e6f5f6ab4f42",
                                "text": "„[…] Wir sehen uns im Halbdunkel an, er ausgezogen, ich gerade in die Schinkenbeutel schlüpfend, das Schiff schlägt gemein in die Wellen, und wir lachen beide, daß uns die Tränen kommen.“"
                            },
                            {
                                "example_id": "3c7cfffa-baaf-4017-9f90-6d610a775bf1",
                                "sense_id": "14ed2464-3d5e-3b14-96b6-e6f5f6ab4f42",
                                "text": "[…] auch hab ich bis 1900 keine weibliche Unterhose oder Schlüpfer, sogenannte Schinkenbeutel, bei der Wäsche entdecken können […]"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
