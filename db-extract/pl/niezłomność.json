                        "sense_id": "feeab517-4739-3b88-8868-3257e1e2a243",
                        "entry_id": "1ae7b371-e53a-33ee-861e-1ec708b644a8",
                        "glosses": [
                            "cecha tego, kto jest niezłomny, silny psychicznie, nie poddający się w obliczu trudu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8b60e4-c34a-4d58-aed5-352c21ab7899",
                                "sense_id": "feeab517-4739-3b88-8868-3257e1e2a243",
                                "text": "Jeśli ktoś organizowałby kiedyś konkurs na miejsce na świecie, które pokazuje niezłomność człowieka, to moim zdaniem mógłby do tej kategorii nominować Bejrut. Rozdzierany wojnami, zamachami i zamieszkami, zawsze się odradza, nie tracąc nic ze swej żywotności, tej nieustannej energii, która każe mu przetrzymywać wszystko"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
