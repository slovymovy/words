{
    "word_family": [
        "embark",
        "disembarkation",
        "embarkation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7cd92fc4-f2fb-3add-a6b1-cc9c4bf53744",
                    "sense_definition": "To go ashore out of a ship or boat, or to leave an aircraft or train.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leave_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passengers are requested to remain seated until the aircraft has come to a complete stop and they are cleared to <w>disembark</w>.",
                            "target_lang_translations": {
                                "ru": "Пассажиров просят оставаться на своих местах до полной остановки самолета и получения разрешения <w>высадиться</w>."
                            }
                        },
                        {
                            "text": "We will <w>disembark</w> from the ferry as soon as it reaches the harbor.",
                            "target_lang_translations": {
                                "ru": "Мы <w>сойдем</w> с парома, как только он зайдет в гавань."
                            }
                        }
                    ],
                    "synonyms": [
                        "land",
                        "debark",
                        "alight",
                        "get off"
                    ],
                    "antonyms": [
                        "embark"
                    ],
                    "common_phrases": [
                        "disembark from the ferry",
                        "disembark from the plane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сойти на берег с корабля или лодки, либо покинуть самолет или поезд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высаживаться",
                                "target_lang_sense_clarification": "выходить из транспорта на землю"
                            },
                            {
                                "target_lang_word": "высадиться",
                                "target_lang_sense_clarification": "выйти из транспорта на землю (сов. вид)"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "покидать транспортное средство"
                            },
                            {
                                "target_lang_word": "сойти",
                                "target_lang_sense_clarification": "покинуть транспортное средство (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36dc61df-7692-3dfc-b5d7-276e2de5bbd3",
                    "sense_definition": "To leave or get off (a boat, train, or aircraft).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leave_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists began to <w>disembark</w> the cruise ship early in the morning to explore the island.",
                            "target_lang_translations": {
                                "ru": "Туристы начали <w>сходить</w> с круизного лайнера рано утром, чтобы осмотреть остров."
                            }
                        },
                        {
                            "text": "Please make sure you have all your personal belongings before you <w>disembark</w> the train.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вы взяли все свои личные вещи, прежде чем <w>сойдете</w> с поезда."
                            }
                        }
                    ],
                    "synonyms": [
                        "get off"
                    ],
                    "antonyms": [
                        "embark"
                    ],
                    "common_phrases": [
                        "disembark the train",
                        "disembark the ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покинуть или выйти из лодки, поезда или самолета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "выходить из поезда, судна и т. п."
                            },
                            {
                                "target_lang_word": "сойти",
                                "target_lang_sense_clarification": "выйти из поезда, судна и т. п. (сов. вид)"
                            },
                            {
                                "target_lang_word": "высаживаться",
                                "target_lang_sense_clarification": "покидать транспорт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f00faf7-8821-3e8a-bc5e-3961f987bb6d",
                    "sense_definition": "To unload or remove passengers, troops, or cargo from a ship, aircraft, or other vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unload_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the crew to <w>disembark</w> the cargo as soon as they docked.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде <w>выгрузить</w> груз, как только они пришвартуются."
                            }
                        },
                        {
                            "text": "It took several hours to <w>disembark</w> the troops and their heavy equipment from the transport vessel.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько часов, чтобы <w>высадить</w> войска и выгрузить их тяжелую технику с транспортного судна."
                            }
                        }
                    ],
                    "synonyms": [
                        "debark"
                    ],
                    "common_phrases": [
                        "disembark the cargo",
                        "disembark the troops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выгружать или производить высадку пассажиров, войск или груза с корабля, самолета или другого транспортного средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высаживать",
                                "target_lang_sense_clarification": "помогать выйти пассажирам или войскам"
                            },
                            {
                                "target_lang_word": "высадить",
                                "target_lang_sense_clarification": "произвести высадку людей (сов. вид)"
                            },
                            {
                                "target_lang_word": "выгружать",
                                "target_lang_sense_clarification": "производить выгрузку груза"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}