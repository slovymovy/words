                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3629378-fd50-4b9e-9e2a-b5e4daa78e6d",
                                                "sense_id": "5222f21d-aa04-3fa0-a39e-d4449768f004",
                                                "text": "И завели свои волынки шотландские волынщики в клетчатых юбках!"
