    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "394487a2-102c-303f-b990-441aa439453d",
                    "sense_definition": "Rendre banal ou faire perdre son caractère original, unique et remarquable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rendre_ordinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La production de masse risque de <w>banaliser</w> les créations artisanales de notre région."
                        },
                        {
                            "text": "En répétant constamment les mêmes thèmes, cet auteur a fini par <w>banaliser</w> son style."
                        }
                    ],
                    "synonyms": [
                        "uniformiser",
                        "vulgariser"
                    ],
                    "antonyms": [
                        "ennoblir"
                    ],
                    "common_phrases": [
                        "se banaliser avec le temps"
                    ]
                },
                {
                    "sense_id": "81f65129-edc1-3690-b426-e05574ff4d6c",
                    "sense_definition": "Présenter ou considérer un fait grave ou inacceptable comme normal et sans importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rendre_ordinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut jamais <w>banaliser</w> la violence verbale dans les établissements scolaires."
                        },
                        {
                            "text": "Les médias ont tendance à <w>banaliser</w> des comportements qui devraient pourtant alerter le public."
                        }
                    ],
                    "synonyms": [
                        "dédramatiser",
                        "minimiser",
                        "normaliser"
                    ],
                    "common_phrases": [
                        "banaliser la violence"
                    ]
                },
                {
                    "sense_id": "ae205045-678c-36f7-93a0-ea2fc653585e",
                    "sense_definition": "Réserver ou libérer une période habituellement consacrée aux cours pour une activité particulière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction du lycée a décidé de <w>banaliser</w> une journée pour organiser un forum des métiers."
                        },
                        {
                            "text": "L'université va <w>banaliser</w> cet après-midi afin de permettre aux étudiants de voter."
                        }
                    ],
                    "common_phrases": [
                        "banaliser une journée"
                    ]
                }
            ]
        }
    ]
