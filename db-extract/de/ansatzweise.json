                                "target_senses": [
                                    {
                                        "sense_id": "43411677-092b-37a8-896a-84f9a4523bad",
                                        "entry_id": "e7453cb5-0637-36d7-837a-33148fe47068",
                                        "glosses": [
                                            "In a rudimentary fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2245c81-48e5-4616-aea5-34587d953f0d",
                                                "sense_id": "43411677-092b-37a8-896a-84f9a4523bad",
                                                "text": "Håkan looked at his forearm, not knowing how he had hurt himself but noticing that the wound had been rudimentarily, yet efficiently, cleaned and bandaged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "226f3697-f08a-4e46-a3d4-9c15bb74ce43",
                        "source_entry_id": "e80db2f0-7eba-3721-8ade-66e7e38c6866",
                        "source_sense_id": "51e5b22c-8ba3-3820-bcd0-abb3e83b9e87",
                        "source_sense_description": "im Ansatz, in einem geringen Maße und lange nicht vollständig",
                        "target_lang_word": "rudimentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rudimentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f840cd9-e55a-351d-b082-1fabe92b7e44",
                                        "entry_id": "54a30bcb-2af0-3aa4-aac6-dc3e9b064704",
                                        "glosses": [
                                            "In a rudimental way; involving only the rudiments or basics of something."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8749a04-f896-4670-a472-57d42cecdcbd",
                                                "sense_id": "5f840cd9-e55a-351d-b082-1fabe92b7e44",
                                                "text": "All men are rudimentally alike; and the body of each human being is made after a certain pattern, which pattern is in accordance with the general principles which apply to all individuals."
                                            },
                                            {
                                                "example_id": "8cc0507c-71a8-48d4-9dd5-1fb988567701",
                                                "sense_id": "5f840cd9-e55a-351d-b082-1fabe92b7e44",
                                                "text": "The intelligent and impartial consideration of the subject is necessary, and should be taught rudimentally in our schools, even though it were advisable to establish special schools for the purpose."
                                            },
                                            {
                                                "example_id": "992c6b1a-d6b0-46ea-ac65-29590c40ea0d",
                                                "sense_id": "5f840cd9-e55a-351d-b082-1fabe92b7e44",
                                                "text": "The rudimentally trained drummer can apply himself to any musical unit—band, orchestra or drum corps—more proficiently than can the drummer trained only for one branch of drumming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
