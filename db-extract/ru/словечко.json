                "senses": [
                    {
                        "sense_id": "bb68cceb-4486-3f63-80f9-e1cc1b469ad9",
                        "entry_id": "1f560220-cca9-3d7b-93f2-4a68f04001f6",
                        "glosses": [
                            "разг. ласк. к слово"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cdb75e1-9732-4191-827e-92dea0a194d5",
                                "sense_id": "bb68cceb-4486-3f63-80f9-e1cc1b469ad9",
                                "text": "Так что он только иногда вверчивал ничего не значащее словечко, или величаво кивал головой в знак согласия."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04980a9d-aff3-4164-9c06-8d3727be5417",
                        "source_entry_id": "1f560220-cca9-3d7b-93f2-4a68f04001f6",
                        "source_sense_id": "bb68cceb-4486-3f63-80f9-e1cc1b469ad9",
                        "target_lang_word": "Wörtchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wörtchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c55af2ee-9a97-3d50-b3e6-e7d7010bda87",
                                        "entry_id": "df25c20e-b336-372a-9cf2-c2a3b9d164a1",
                                        "glosses": [
                                            "kleines Wort, im Sinne von Wort als kleinster grammatischer Einheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a091b7c3-6bad-4fad-939f-cca4881bb972",
                                                "sense_id": "c55af2ee-9a97-3d50-b3e6-e7d7010bda87",
                                                "text": "„Er lachte, als ich ihn an das Wörtchen »sko« erinnerte, er schien diese isländische Marotte gut zu kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63671a03-e186-3e7a-aa15-e1904405db29",
                                        "entry_id": "df25c20e-b336-372a-9cf2-c2a3b9d164a1",
                                        "glosses": [
                                            "kleines Wort, im Sinne von Wort als Äußerung von Gedanken/Gefühlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f72d68c-355f-4171-a47b-91a9a54af05b",
                                                "sense_id": "63671a03-e186-3e7a-aa15-e1904405db29",
                                                "text": "„Ich weiß, dass da die Politik ein Wörtchen mitzureden hat.“"
                                            },
                                            {
                                                "example_id": "cd30f4cf-007d-4785-947a-c88741405b98",
                                                "sense_id": "63671a03-e186-3e7a-aa15-e1904405db29",
                                                "text": "„Aber die Gräfin Thor von Thorfels könnte vielleicht ein Wörtchen dazu sagen?“"
                                            },
                                            {
                                                "example_id": "ff21de9b-ec40-41b4-8ac0-67b075373d9b",
                                                "sense_id": "63671a03-e186-3e7a-aa15-e1904405db29",
                                                "text": "„Meier hätte gern mit Gareis vorher ein Wörtchen gesprochen, eigentlich hatte er den Eindruck, daß man daheim, in jenem großen, trüben, dunklen Zimmer, gerne Frieden mit diesem Mann gemacht hätte …“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
