                {
                    "sense_id": "b1aa07e4-b27e-3e1a-8bfc-f7d8594c54c1",
                    "sense_definition": "Present participle and gerund of <w>decline</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quality of service in this restaurant is <w>declining</w> rapidly.",
                            "target_lang_translations": {
                                "ru": "Качество обслуживания в этом ресторане стремительно <w>снижается</w>.",
                                "pl": "Jakość obsługi w tej restauracji gwałtownie <w>spada</w>."
                            }
                        },
                        {
                            "text": "She is <w>declining</w> the invitation because she has to work late.",
                            "target_lang_translations": {
                                "ru": "Она <w>отклоняет</w> приглашение, так как ей нужно работать допоздна.",
                                "pl": "Ona <w>odrzuca</w> zaproszenie, ponieważ musi pracować do późna."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rapidly declining",
                        "steadily declining",
                        "declining health"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
