                                        "entry_id": "ac05f40c-7b15-30ee-a09b-bd8bf9ec1c4c",
                                        "glosses": [
                                            "To shoot into a long stem, as some plants do."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
