        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                "word": "advertiser",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8d9e2f82-9083-4329-8b97-0ada7888108f",
                        "entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                        "tags": [
                            "plural"
                        ],
                        "form": "advertisers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "054e9700-6c39-35f0-bf43-258dec838724",
                        "entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                        "glosses": [
                            "One who advertises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295afcaf-e7a0-46b0-88d4-a7c04dba07a3",
                                "sense_id": "054e9700-6c39-35f0-bf43-258dec838724",
                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention. Partly, this is a result of how online advertising has traditionally worked: advertisers pay for clicks, and a click is a click, however it's obtained."
                            }
                        ]
                    },
                    {
                        "sense_id": "88972db8-4bd8-39d6-96ab-e5ea8ffdcaec",
                        "entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                        "glosses": [
                            "A periodical in which advertisements can be published by individuals."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4502e1ae-7272-4636-a721-060b4db2d3c8",
                        "source_entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                        "source_sense_description": "one who advertises",
                        "target_lang_word": "adverteerder",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adverteerder",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "af6881ea-7463-3bf9-8ed5-2be43e9e7311",
                                        "entry_id": "20fb43eb-d256-3b1a-ad23-a9c2b1067c0e",
                                        "glosses": [
                                            "iemand die een reclame plaatst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f650ca-f0da-4a34-b41a-26ab1054da04",
                                                "sense_id": "af6881ea-7463-3bf9-8ed5-2be43e9e7311",
                                                "text": "Een dagblad verdient zijn geld aan adverteerders en abonnees"
                                            },
                                            {
                                                "example_id": "2fff3ec9-d30c-43bc-9399-b9b2c31dc058",
                                                "sense_id": "af6881ea-7463-3bf9-8ed5-2be43e9e7311",
                                                "text": "Google verdient geld door advertenties te plaatsen voor adverteerders."
                                            },
                                            {
                                                "example_id": "1a775da7-3aae-43ef-bb9a-007a54db2d1c",
                                                "sense_id": "af6881ea-7463-3bf9-8ed5-2be43e9e7311",
                                                "text": "Maar waarom zijn juist kinderen zo interessant voor sociale media? Dat heeft alles te maken met adverteerders. Die zijn op zoek naar een jonge doelgroep en die vinden ze op sociale media, legt universitair hoofddocent communicatiewetenschap aan de Universiteit van Amsterdam Eva van Reijmersdal uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f97c0d74-71be-4f84-8b63-0cd704a33afe",
                        "source_entry_id": "f6d9a69d-f51b-3e0f-b253-5c106eae479a",
                        "source_sense_description": "one who advertises",
                        "target_lang_word": "messager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "messager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                        "entry_id": "83952abd-4164-3ea1-9272-9544223a2724",
                                        "glosses": [
                                            "Qui transmet des messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ce92a90-d380-43ed-844c-0b95d70d82b9",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "Acide ribonucléique messager, acide ribonucléique qui exerce une transmission de l'information génétique des gènes aux ribosomes où s'effectue la synthèse des protéines."
                                            },
                                            {
                                                "example_id": "f5258331-9b85-4094-a06c-21c49c80c29b",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "Le pigeon messager, pigeon voyageur qui transmet des messages."
                                            },
                                            {
                                                "example_id": "85a5545f-e059-4ca3-8ca3-9bd4ca087d36",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "La colombe messagère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "messager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Celui qui est chargé de porter un message."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a7a182-ae00-4a03-9f9f-9d952b066334",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Messager fidèle."
                                            },
                                            {
                                                "example_id": "b6b12aff-2689-444f-ad36-0eca732e1d97",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Le messager des dieux, Mercure ou Hermès."
                                            },
                                            {
                                                "example_id": "973da0a3-2371-443c-bae5-21371df2aaec",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Je lui ai envoyé messager sur messager."
                                            },
                                            {
                                                "example_id": "c578eccc-8f67-4581-90b4-a5dc95470e79",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Donnez-moi cette lettre, je serai votre messagère."
                                            },
                                            {
                                                "example_id": "ca9292ae-cd7f-4100-90a7-e8adf97fe2da",
                                                "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s’efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d’une forme littéraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Porteur, transporteur de colis ou de messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88deb65b-a56c-4a4f-a510-9263379edae2",
                                                "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                                                "text": "Messager de malheur, porteur de mauvaises nouvelles."
                                            },
                                            {
                                                "example_id": "e3664a7c-078b-4500-8342-28507d300cba",
                                                "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                                                "text": "Apparemment conçu pour que personne ne s’y attarde, sauf les chauffeurs-gardes du corps venus déposer et attendre leurs ministres qui assistent au Conseil ou à diverses autres réunions, ce hall ne comporte aucun véritable endroit pour s’asseoir, à l’exception de deux longues banquettes de bois peu invitantes et sur lesquelles traînent invariablement colis et enveloppes en attente d’un messager ou d'un taxi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e322d3f-41bf-39ef-8e21-d107bd52e219",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Annonciateur, avant-coureur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb49eb6e-f855-42fc-a762-d915b30da14b",
                                                "sense_id": "7e322d3f-41bf-39ef-8e21-d107bd52e219",
                                                "text": "Les hirondelles sont les messagères du printemps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b847e0-4a90-3f7c-97c0-82fbbe88dfc7",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
                                            "Fin cordage servant à guider une drisse à l'intérieur d'un mât."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88d6d9f4-75b0-3d80-bfc4-d831d3e7087c",
                                        "entry_id": "34aa0079-ab0d-3488-9670-181519b55e68",
                                        "glosses": [
