                "senses": [
                    {
                        "sense_id": "dd70735b-8b0b-33ca-a6aa-f64efefb23db",
                        "entry_id": "f7afc833-1664-3055-bfec-2e86efe22229",
                        "glosses": [
                            "eine Kleinigkeit, etwas Unbedeutendes"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e2bec8e0-15d2-4f78-9022-3f6aa141adaa",
                                "sense_id": "dd70735b-8b0b-33ca-a6aa-f64efefb23db",
                                "text": "„Ach, das ist Pillepalle. Da wurden jetzt ein paar Dinge gestrichen.“"
                            },
                            {
                                "example_id": "a2ebc517-38ca-48a0-86aa-6df1e1323ad8",
                                "sense_id": "dd70735b-8b0b-33ca-a6aa-f64efefb23db",
                                "text": "Pillepalle wird in dieser oder in anderen Schreibweisen auch als Name für alles Mögliche (Lokale, Titel von Veröffentlichungen…) verwendet."
                            },
                            {
                                "example_id": "0597dfe5-3128-44d3-a5da-a81ebc21d2aa",
                                "sense_id": "dd70735b-8b0b-33ca-a6aa-f64efefb23db",
                                "text": "[…] „im Vergleich zu dem, was auf uns zukommt, ist dieser Gefängnisaufenthalt sowieso Pillepalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
