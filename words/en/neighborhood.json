                            {
                                "target_lang_word": "街坊",
                                "target_lang_sense_clarification": "指邻里或街坊邻居"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a3212a8-9a62-3b83-8632-12761348392c",
                    "sense_definition": "An approximate amount or value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The repairs will cost somewhere in the <w>neighborhood</w> of five hundred dollars.",
                            "target_lang_translations": {
                                "ru": "Ремонт обойдется где-то <w>в районе</w> пятисот долларов.",
                                "pl": "Naprawa będzie kosztować gdzieś <w>w granicach</w> pięciuset dolarów.",
                                "zh": "维修费用大概在五百美元<w>左右</w>。"
                            }
                        },
                        {
                            "text": "He earns an annual salary in the <w>neighborhood</w> of six figures.",
                            "target_lang_translations": {
                                "ru": "Он получает годовую зарплату <w>в районе</w> шестизначной суммы.",
                                "pl": "Zarabia roczną pensję <w>rzędu</w> sześciu cyfr.",
                                "zh": "他的年薪在六位数<w>左右</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the neighborhood of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приблизительное количество или значение.",
                        "pl": "Przybliżona ilość lub wartość.",
                        "zh": "近似的数量或数值。"
                    },
                    "translations": {
