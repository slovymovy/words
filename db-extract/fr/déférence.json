                                        "entry_id": "33fdfc9c-1292-33f4-a3d6-cd19bd5cd9b8",
                                        "glosses": [
                                            "Great respect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d0bb68e-601f-491d-ae5d-989427cdd49b",
                                                "sense_id": "942caec4-cbe9-3cdf-bbea-70776b6382dc",
                                                "text": "The children treated their elders with deference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a89f4a2-fa28-3e33-9579-5d3dae721467",
                                        "entry_id": "33fdfc9c-1292-33f4-a3d6-cd19bd5cd9b8",
                                        "glosses": [
                                            "The willingness to carry out the wishes of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5317e2bb-95b5-4348-9ff0-2bb64a4ea0c1",
                                                "sense_id": "1a89f4a2-fa28-3e33-9579-5d3dae721467",
                                                "text": "By tidying his room, he showed deference to his mother."
                                            },
                                            {
                                                "example_id": "a4d54329-1174-4cc8-92ef-ab9ece400ac1",
                                                "sense_id": "1a89f4a2-fa28-3e33-9579-5d3dae721467",
                                                "text": "Michael in turn benefits from Tom. He loosens up a bit, stops talking so much like one of the bad novels he used to read, and learns to give his intellect a rest once in a while in deference to the emotions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
