                "senses": [
                    {
                        "sense_id": "a915da15-acd9-3519-bb17-b66c46f03158",
                        "entry_id": "635c43d7-dfe0-3688-ad9b-7b87a0f479e1",
                        "glosses": [
                            "Proclamation, annonce, usuellement depuis la chaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a78d92-c8bd-4fcf-a485-a9ac3a94dccf",
                                "sense_id": "a915da15-acd9-3519-bb17-b66c46f03158",
                                "text": "Nach dem Segen und der Abkündigung der Kollekte, die in einer Teekanne gesammelt wurde, lud das Weltgebetstags-Team die Gemeinde zu Tee und pikanten Scones ein.",
                                "translation": "Après la bénédiction et l’annonce de la collecte, qui a été recueillie dans une théière, l’équipe de la Journée mondiale de prière a invité la communauté à prendre le thé avec des scones épicés."
                            }
                        ]
                    },
                    {
                        "sense_id": "57e65829-fe4d-3609-8985-55c57e8508f6",
                        "entry_id": "635c43d7-dfe0-3688-ad9b-7b87a0f479e1",
                        "glosses": [
                            "Annonce de la fin de vie d’un produit : obsolescence, cessation de la production, de la livrabilité, de la maintenance, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d7ae48-c590-43ba-8473-41c68a7d46aa",
                                "sense_id": "57e65829-fe4d-3609-8985-55c57e8508f6",
                                "text": "Nach der Abkündigung dieser alten Komponente müssen wir dringend einen Ersatzlösung finden.",
                                "translation": "Après l’annonce d’obsolescence de ce vieux composant, nous devons urgemment trouver une solution de remplacement."
                            }
                        ]
                    }
                ],
