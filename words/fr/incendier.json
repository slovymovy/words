                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des inconnus ont <w>incendié</w> une voiture abandonnée au milieu de la nuit."
                        },
                        {
                            "text": "Le violent feu de forêt menace d'<w>incendier</w> plusieurs maisons du village voisin."
                        }
                    ],
                    "synonyms": [
                        "brûler",
                        "mettre le feu"
                    ],
                    "common_phrases": [
                        "incendier un bâtiment",
                        "incendier une forêt"
                    ]
                },
                {
                    "sense_id": "dc10bde2-5a49-3b53-aa46-8a648be3143c",
                    "sense_definition": "Réprimander ou disputer quelqu'un de façon très vive et agressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reproche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a <w>incendié</w> son équipe après cet échec inattendu."
                        },
                        {
                            "text": "Il s'est fait <w>incendier</w> par ses parents parce qu'il est rentré trop tard."
                        }
                    ],
                    "synonyms": [
                        "disputer"
                    ],
                    "common_phrases": [
                        "se faire incendier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "c24b3cc7-cd57-34ae-a101-a56f1b211e32",
                    "sense_definition": "Enflammer ou surexciter vivement les esprits, les sentiments ou les passions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours passionné a suffi pour <w>incendier</w> les esprits des manifestants."
                        },
                        {
                            "text": "Ces propos provocateurs risquent d'<w>incendier</w> le débat politique actuel."
