{
    "word_family": [
        "guidage",
        "guide",
        "guidon",
        "téléguider"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05adf174-80b2-3699-89d8-dfd114373a00",
                    "sense_definition": "Accompagner une personne pour lui indiquer le chemin ou la mener à une destination.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "orientation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde forestier va nous <w>guider</w> à travers les sentiers de la montagne."
                        },
                        {
                            "text": "Une faible lueur dans la nuit a permis de <w>guider</w> les promeneurs perdus."
                        }
                    ],
                    "synonyms": [
                        "conduire"
                    ],
                    "common_phrases": [
                        "guider les pas"
                    ]
                },
                {
                    "sense_id": "1ed59697-ce1a-3e47-ac2b-52d270275823",
                    "sense_definition": "Conseiller ou orienter quelqu'un dans sa conduite, ses choix ou sa réflexion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur bienveillant prend le temps de <w>guider</w> ses étudiants vers la réussite."
                        },
                        {
                            "text": "Dans les moments difficiles, c'est son intuition qui <w>guide</w> ses décisions professionnelles."
                        }
                    ],
                    "common_phrases": [
                        "guider les choix",
                        "se laisser guider"
                    ]
                },
                {
                    "sense_id": "3a5744a0-2542-3e68-a027-eed2a5ebcde2",
                    "sense_definition": "S'orienter ou diriger ses mouvements d'après des repères ou des indices.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orientation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les navigateurs d'autrefois apprenaient à se <w>guider</w> grâce aux étoiles."
                        },
                        {
                            "text": "Dans ce couloir sombre, le vieil homme se <w>guide</w> lentement avec sa canne."
                        }
                    ],
                    "common_phrases": [
                        "se guider aux étoiles"
                    ]
                },
                {
                    "sense_id": "ba9127fa-ec19-3603-8506-519bccb9fed3",
                    "sense_definition": "Diriger ou manœuvrer la trajectoire d'un véhicule ou d'une monture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conduite_vehicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier expérimenté sait parfaitement <w>guider</w> son cheval sur les chemins escarpés."
                        },
                        {
                            "text": "Il faut beaucoup d'adresse pour <w>guider</w> une barque sur une rivière agitée."
                        }
                    ],
                    "synonyms": [
                        "conduire"
                    ],
                    "common_phrases": [
                        "guider la monture",
                        "guider une barque"
                    ]
                }
            ]
        }
    ]
}