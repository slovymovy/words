                        "examples": [
                            {
                                "example_id": "22328257-390a-46c1-b0b8-d23851e339b2",
                                "sense_id": "d4cb8515-e954-3f27-ac8b-3719e6da68c1",
                                "text": "Samsung heeft aangekondigd maandag bekend te maken wat de oorzaak is van de oververhitting en het in brand vliegen van zijn smartphone Galaxy Note 7. De persconferentie wordt in het Chinees, Engels en Koreaans op de website van het elektronicabedrijf gelivestreamd."
                            },
                            {
                                "example_id": "bc7a6910-ad2e-4b7b-926d-32658036b46b",
                                "sense_id": "d4cb8515-e954-3f27-ac8b-3719e6da68c1",
                                "text": "Het voormalige elektronicabedrijf heeft zich de laatste jaren omgebouwd tot een technologieconcern, met focus op gezondheid. De traditionele Philips-producten zoals televisie, audio en licht zijn verkocht of afgestoten."
                            },
                            {
                                "example_id": "57754fce-586f-4821-aa68-9a2a6c423ba3",
                                "sense_id": "d4cb8515-e954-3f27-ac8b-3719e6da68c1",
                                "text": "Elektronicabedrijf Philips zegt dat Groot-Brittannië een belangrijke markt voor de onderneming is. \"We blijven gecommitteerd aan onze Britse werknemers, partners en klanten\", aldus het bedrijf in een korte reactie."
                            }
                        ]
