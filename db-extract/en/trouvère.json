                                        "entry_id": "72373f86-d5ed-3c6f-91aa-5edbdda21bc6",
                                        "glosses": [
                                            "in het middeleeuws Noord-Frankrijk rondreizend dichter, en zanger van (minne-) liederen"
                                        ],
