                        "glosses": [
                            "Comité d’organisation des Jeux olympiques et paralympiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b698ec8-de9d-4dbb-98e6-e588b93bb272",
                                "sense_id": "07d2766a-d8ec-3a0c-8010-b9e6259f79b9",
                                "text": "C’est là tout l’enjeu du « look » des Jeux, qui a été présenté début février par le Comité d’organisation des Jeux olympiques et paralympiques (Cojop)."
                            },
                            {
                                "example_id": "de745d36-7b63-4fb1-90a4-e77e93c4a790",
                                "sense_id": "07d2766a-d8ec-3a0c-8010-b9e6259f79b9",
                                "text": "Le Cojop n’a pas lésiné : 24 parasports en démonstration, comme le basket fauteuil, la boccia (sorte de parapétanque), le para-tir à l’arc, ou encore le tennis fauteuil."
                            },
                            {
                                "example_id": "c23b723f-8066-4177-b215-6ecbe263669e",
                                "sense_id": "07d2766a-d8ec-3a0c-8010-b9e6259f79b9",
                                "text": "« Au sommet du Cojop, on compte un tiers de femmes pour deux tiers d’hommes et les deux têtes pensantes sont exclusivement masculines, avec Tony Estanguet et Étienne Thobois », comptabilise Béatrice Barbusse, vice-présidente à la fédération française de handball."
                            }
                        ]
                    }
