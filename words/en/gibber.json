{
    "word_family": [
        "gibberish"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e44c395-140f-3f26-ae63-1f682c109048",
                    "sense_definition": "To speak rapidly and in a way that is difficult or impossible to understand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened child began to <w>gibber</w> in terror when the lights suddenly went out.",
                            "target_lang_translations": {
                                "tr": "Işıklar aniden söndüğünde korkudan titreyen çocuk <w>saçmalamaya</w> başladı."
                            }
                        },
                        {
                            "text": "He would <w>gibber</w> incoherently whenever he was under extreme pressure or stress.",
                            "target_lang_translations": {
                                "tr": "Ne zaman aşırı baskı veya stres altında kalsa tutarsızca <w>gevelerdi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "babble",
                        "jabber",
                        "prattle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Anlaşılması güç veya imkansız olacak şekilde hızlı ve anlamsız konuşmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saçmalamak",
                                "target_lang_sense_clarification": "Anlamsız veya tutarsız konuşma eylemi."
                            },
                            {
                                "target_lang_word": "gevelemek",
                                "target_lang_sense_clarification": "Hızlı ve anlaşılmaz bir şekilde konuşmak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36d69076-6f96-3446-9ae5-e25ead70f278",
                    "sense_definition": "Speech that is unintelligible or lacks meaning.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old radio produced nothing but static and <w>gibber</w>.",
                            "target_lang_translations": {
                                "tr": "Eski radyo cızırtıdan ve <w>anlaşılmaz seslerden</w> başka bir şey vermiyordu."
                            }
                        },
                        {
                            "text": "I could not understand his <w>gibber</w> after he had been awake for three days.",
                            "target_lang_translations": {
                                "tr": "Üç gün boyunca uyanık kaldıktan sonraki <w>saçmalıklarını</w> anlayamadım."
                            }
                        }
                    ],
                    "synonyms": [
                        "gibberish",
                        "babble"
                    ],
                    "target_lang_definitions": {
                        "tr": "Anlaşılmaz veya anlamsız olan konuşma."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saçmalık",
                                "target_lang_sense_clarification": "Anlamsız sözler bütünü."
                            },
                            {
                                "target_lang_word": "anlaşılmaz konuşma",
                                "target_lang_sense_clarification": "İçerik olarak anlam ifade etmeyen sesler."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0663c37-8a8c-3d4d-af61-67e2bba272fd",
                    "sense_definition": "A small stone or rock found in arid regions of Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert floor was covered in a vast expanse of red <w>gibber</w>.",
                            "target_lang_translations": {
                                "tr": "Çöl zemini uçsuz bucaksız kırmızı <w>çöl taşlarıyla</w> kaplıydı."
                            }
                        },
                        {
                            "text": "Walking across the <w>gibber</w> plains requires sturdy boots to protect your feet.",
                            "target_lang_translations": {
                                "tr": "<w>Çöl taşı</w> ovalarında yürümek, ayaklarınızı korumak için sağlam botlar gerektirir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gibber plain"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Avustralya'nın kurak bölgelerinde bulunan küçük taş veya kaya parçası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çöl taşı",
                                "target_lang_sense_clarification": "Avustralya'nın kurak bölgelerine özgü küçük taş."
                            },
                            {
                                "target_lang_word": "çakıl taşı",
                                "target_lang_sense_clarification": "Genel anlamda küçük kaya parçası."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}