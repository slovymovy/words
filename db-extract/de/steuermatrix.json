                ],
                "senses": [
                    {
                        "sense_id": "b7ce8ce4-1bed-3651-a9d2-bb213f8d9094",
                        "entry_id": "c7dd41f4-c87a-31aa-a7d4-d5ad677a1570",
                        "glosses": [
                            "vorüberlegte und schriftlich fixierte Wirkprinzipbeschreibung von Technik zu einem Gebäude bei einem plötzlichen Ereignis"
                        ],
                        "tags": [
                            "Stochastik",
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "a53a0bd2-eefe-4b7d-81a2-bb33ae25e6c1",
                                "sense_id": "b7ce8ce4-1bed-3651-a9d2-bb213f8d9094",
                                "text": "„Die Steuermatrix umfasst alle Steuerungen, die im Brandfall gemeinsam genutzt werden. Der Verknüpfungsplan, nach DIN VDE 0833-2 kann Bestandteil der Steuermatrix sein.“"
                            },
                            {
                                "example_id": "137f9dea-a96d-4a6c-9f67-5bc2d40d3ac3",
                                "sense_id": "b7ce8ce4-1bed-3651-a9d2-bb213f8d9094",
                                "text": "„Eine eventuelle falsche übergreifende Programmierung kann diesbezüglich nur durch eine praktische Wirkprinzipprüfung erfolgen, wobei ein Melder ausgelöst wird und die gesamte Steuermatrix abläuft und die Anlagenansteuerung und –funktion geprüft wird.“"
                            },
                            {
                                "example_id": "342abf2e-c367-48ef-81d1-5574089bf315",
                                "sense_id": "b7ce8ce4-1bed-3651-a9d2-bb213f8d9094",
                                "text": "„Dies erfolgt zweckmäßigerweise durch eine tabellarische Darstellung, die so genannte Steuermatrix.“"
                            },
                            {
                                "example_id": "0143a393-3a89-451b-8452-ad73a1f8a988",
                                "sense_id": "b7ce8ce4-1bed-3651-a9d2-bb213f8d9094",
                                "text": "„In der Steuermatrix ordnen Sie einem Steuerkennzeichen einen Steuerschlüssel zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
