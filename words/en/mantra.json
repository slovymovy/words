{
    "word_family": [
        "mantric"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2dcaa5d-23cd-3fed-a259-2b976cd99563",
                    "sense_definition": "A slogan or phrase often repeated to express a belief or goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repeated_phrase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's <w>mantra</w> is to always put the customer first.",
                            "target_lang_translations": {
                                "zh": "这家公司的<w>口号</w>是始终将客户放在第一位。"
                            }
                        },
                        {
                            "text": "Hard work is his personal <w>mantra</w> for success.",
                            "target_lang_translations": {
                                "zh": "努力工作是他个人的成功<w>座右铭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slogan",
                        "catchphrase"
                    ],
                    "common_phrases": [
                        "personal mantra"
                    ],
                    "target_lang_definitions": {
                        "zh": "常被重复以表达某种信念或目标的口号或短语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "口号",
                                "target_lang_sense_clarification": "指为了表达信念或目标而反复使用的短语。"
                            },
                            {
                                "target_lang_word": "座右铭",
                                "target_lang_sense_clarification": "指个人作为行为准则或信念的格言。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b084abb9-2167-3e0c-b172-c0772e9a04ba",
                    "sense_definition": "A word or phrase repeated to help focus the mind during meditation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "repeated_phrase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat quietly and repeated her <w>mantra</w> to clear her mind.",
                            "target_lang_translations": {
                                "zh": "她静静地坐着，重复念诵着她的<w>咒语</w>以清空思绪。"
                            }
                        },
                        {
                            "text": "Focusing on a <w>mantra</w> helps reduce stress during daily meditation.",
                            "target_lang_translations": {
                                "zh": "在日常冥想中专注于<w>真言</w>有助于减轻压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incantation"
                    ],
                    "target_lang_definitions": {
                        "zh": "在冥想时为了帮助集中注意力而反复念诵的词语或短语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咒语",
                                "target_lang_sense_clarification": "指冥想时用于专注心神的重复性词句。"
                            },
                            {
                                "target_lang_word": "真言",
                                "target_lang_sense_clarification": "指修行时念诵的具有特定精神意义的短语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93819c27-8743-33ce-b7af-35c1a9068166",
                    "sense_definition": "A sacred utterance or prayer from the Vedas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest chanted a traditional <w>mantra</w> during the ceremony.",
                            "target_lang_translations": {
                                "zh": "祭司在仪式中吟诵了一段传统的<w>曼特罗</w>。"
                            }
                        },
                        {
                            "text": "Many ancient texts contain a specific <w>mantra</w> for spiritual guidance.",
                            "target_lang_translations": {
                                "zh": "许多古籍中都包含用于精神指引的特定<w>咒文</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recitation"
                    ],
                    "target_lang_definitions": {
                        "zh": "源自《吠陀经》的神圣语词或祈祷文。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "曼特罗",
                                "target_lang_sense_clarification": "指源自印度教或佛教传统的圣言。"
                            },
                            {
                                "target_lang_word": "咒文",
                                "target_lang_sense_clarification": "指宗教仪式中使用的神圣经文或咒语。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}