{
    "word_family": [
        "heaping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ae31a8a-ef0f-34cd-8253-22d5e5d5da77",
                    "sense_definition": "A pile or mass of things laid together to form an elevation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener made a large <w>heap</w> of leaves in the corner of the yard.",
                            "target_lang_translations": {
                                "cs": "Zahradník udělal v rohu dvora velkou <w>hromadu</w> listí."
                            }
                        },
                        {
                            "text": "She found a <w>heap</w> of old books in the attic.",
                            "target_lang_translations": {
                                "cs": "Našla na půdě <w>hromadu</w> starých knih."
                            }
                        }
                    ],
                    "synonyms": [
                        "pile up"
                    ],
                    "common_phrases": [
                        "heap of stones",
                        "heap of earth"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hromada nebo masa věcí navršených dohromady tak, že tvoří vyvýšeninu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hromada",
                                "target_lang_sense_clarification": "navršená kupa věcí nebo materiálu"
                            },
                            {
                                "target_lang_word": "halda",
                                "target_lang_sense_clarification": "spíše větší navršené množství; i expresivně"
                            },
                            {
                                "target_lang_word": "kupa",
                                "target_lang_sense_clarification": "volněji o kupě věcí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c85a6d8-b0ac-3256-8532-e32e7e90284c",
                    "sense_definition": "A large amount or quantity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thanks a <w>heap</w> for all your help with the project.",
                            "target_lang_translations": {
                                "cs": "Díky <w>moc</w> za všechnu pomoc s projektem."
                            }
                        },
                        {
                            "text": "We have a <w>heap</w> of work to finish before the weekend.",
                            "target_lang_translations": {
                                "cs": "Máme <w>spoustu</w> práce, kterou musíme dokončit před víkendem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thanks a heap"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velké množství nebo velká míra něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spousta",
                                "target_lang_sense_clarification": "velké množství čeho; neutrální a velmi běžné"
                            },
                            {
                                "target_lang_word": "hromada",
                                "target_lang_sense_clarification": "hovorově velké množství"
                            },
                            {
                                "target_lang_word": "halda",
                                "target_lang_sense_clarification": "expresivně mnoho"
                            },
                            {
                                "target_lang_word": "moc",
                                "target_lang_sense_clarification": "ve spojení thanks a heap = díky moc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2fb8c8a-d8d8-3f08-85f7-09a5e6a74bdd",
                    "sense_definition": "A dilapidated or broken-down vehicle or place.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My first car was a real <w>heap</w> that broke down every week.",
                            "target_lang_translations": {
                                "cs": "Moje první auto byl opravdový <w>krám</w>, který se každých pár dní porouchal."
                            }
                        },
                        {
                            "text": "He tried to sell his old <w>heap</w> for a few hundred dollars.",
                            "target_lang_translations": {
                                "cs": "Snažil se prodat svůj starý <w>krám</w> za pár set dolarů."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe something in poor condition."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zchátralé nebo porouchané vozidlo či místo; něco ve velmi špatném stavu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "krám",
                                "target_lang_sense_clarification": "hovorově o starém rozbitém autě nebo kraksně"
                            },
                            {
                                "target_lang_word": "vrak",
                                "target_lang_sense_clarification": "hovorově o rozpadlém autě"
                            },
                            {
                                "target_lang_word": "rachotina",
                                "target_lang_sense_clarification": "expresivně o něčem ve velmi špatném stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d1d4212-0ed2-346d-a2c5-795f9d3f0c84",
                    "sense_definition": "A large crowd or multitude of people.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity was surrounded by a <w>heap</w> of fans at the airport.",
                            "target_lang_translations": {
                                "cs": "Na letišti tu celebritu obklopoval <w>dav</w> fanoušků."
                            }
                        },
                        {
                            "text": "He had a <w>heap</w> of supporters waiting outside the building.",
                            "target_lang_translations": {
                                "cs": "Před budovou na něj čekal <w>dav</w> příznivců."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velký dav nebo množství lidí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dav",
                                "target_lang_sense_clarification": "velký počet lidí na jednom místě"
                            },
                            {
                                "target_lang_word": "spousta lidí",
                                "target_lang_sense_clarification": "větší množství lidí, poněkud neformálně"
                            },
                            {
                                "target_lang_word": "zástup",
                                "target_lang_sense_clarification": "množství lidí, často s důrazem na počet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10ffec63-8ad8-3880-9cb1-84836eb8376b",
                    "sense_definition": "A region of computer memory used for dynamic allocation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program crashed because it ran out of space on the <w>heap</w>.",
                            "target_lang_translations": {
                                "cs": "Program spadl, protože mu došlo místo v <w>haldě</w>."
                            }
                        },
                        {
                            "text": "Developers must manage the <w>heap</w> carefully to prevent memory leaks.",
                            "target_lang_translations": {
                                "cs": "Vývojáři musí <w>haldu</w> pečlivě spravovat, aby zabránili únikům paměti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Oblast počítačové paměti používaná pro dynamickou alokaci."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "halda",
                                "target_lang_sense_clarification": "oblast paměti pro dynamickou alokaci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc7b8398-a08b-3911-8d9b-7033ea791595",
                    "sense_definition": "A specialized tree-based data structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A binary <w>heap</w> is often used to implement a priority queue.",
                            "target_lang_translations": {
                                "cs": "Binární <w>halda</w> se často používá k implementaci prioritní fronty."
                            }
                        },
                        {
                            "text": "The algorithm uses a <w>heap</w> to efficiently find the smallest element.",
                            "target_lang_translations": {
                                "cs": "Algoritmus používá <w>haldu</w> k efektivnímu nalezení nejmenšího prvku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Specializovaná stromová datová struktura."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "halda",
                                "target_lang_sense_clarification": "stromová datová struktura"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ff9cf85-50c2-3376-a85e-828f6732e84f",
                    "sense_definition": "To pile things together in a heap.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>heap</w> the dirty clothes in the laundry basket.",
                            "target_lang_translations": {
                                "cs": "Prosím <w>naházej</w> špinavé oblečení do koše na prádlo."
                            }
                        },
                        {
                            "text": "They <w>heaped</w> the firewood against the wall of the cabin.",
                            "target_lang_translations": {
                                "cs": "<w>Nakupili</w> dříví ke stěně chaty."
                            }
                        }
                    ],
                    "synonyms": [
                        "amass",
                        "heap up",
                        "pile up"
                    ],
                    "common_phrases": [
                        "heap up"
                    ],
                    "target_lang_definitions": {
