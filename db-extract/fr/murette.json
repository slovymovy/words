                ],
                "senses": [
                    {
                        "sense_id": "96afa731-7897-3eb9-a162-d5ad10bfb640",
                        "entry_id": "8d9d2820-3088-3d6e-871c-e73dd6be4764",
                        "glosses": [
                            "Petit mur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bae61fa-8346-4a6f-8a7b-fc2d03aa85ea",
                                "sense_id": "96afa731-7897-3eb9-a162-d5ad10bfb640",
                                "text": "Le froid ne dura pas. L'hiver avait atteint ses dernières limites et déjà, derrière toutes les murettes, toutes les haies, les premiers signes du printemps touchaient les plantes précoces."
                            },
                            {
                                "example_id": "07650644-984c-4935-bbd0-6f53ce24eb11",
                                "sense_id": "96afa731-7897-3eb9-a162-d5ad10bfb640",
                                "text": "Ils traversèrent l’un après l’autre les douze enclos, bordés par des murettes d’argile desséchée, reliés entre eux par des brèches étroites et tous pareils : quadrilatères au sol nu, craquelé, que le soleil, bien qu’il fût très loin encore de son zénith, faisait déjà brûlants."
                            },
                            {
                                "example_id": "fab38936-18d6-49c7-906c-625ed7e86157",
                                "sense_id": "96afa731-7897-3eb9-a162-d5ad10bfb640",
                                "text": "Comment en effet, se peut il que cette murette puisse arrêter l'envahisseur?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4a498cde-55fe-33e4-9ea6-f3a7a3d832ee",
                        "entry_id": "8d9d2820-3088-3d6e-871c-e73dd6be4764",
                        "glosses": [
                            "Mur construit à l'intérieur du foyer d'un four protégeant la charge enfournée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74bd1f71-c6c9-41aa-a90e-bd7252f48021",
                                "sense_id": "4a498cde-55fe-33e4-9ea6-f3a7a3d832ee",
                                "text": "le foyer est séparé de la marchandise par une murette en briques réfractaires, à joints de 0ᵐ,02 afin de laisser passer librement la flamme, tout en préservant les tuiles du premier choc du foyer."
                            }
                        ]
                    }
