                {
                    "sense_id": "a8ff1799-8052-33f7-a52a-4d672be8c67c",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>écraser</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train a percuté le véhicule et l'a complètement <w>écrasé</w> sur la voie.",
                            "target_lang_translations": {
                                "en": "The train hit the vehicle and completely <w>crushed</w> it on the tracks.",
                                "ru": "Поезд врезался в автомобиль и полностью <w>раздавил</w> его на путях.",
                                "de": "Der Zug rammte das Fahrzeug und <w>zerquetschte</w> es vollständig auf dem Gleis.",
                                "es": "El tren chocó contra el vehículo y lo <w>aplastó</w> por completo sobre la vía.",
                                "zh": "火车撞上了那辆汽车，并把它完全<w>压扁</w>在铁轨上。"
                            }
                        },
                        {
                            "text": "Un petit avion de tourisme s'est <w>écrasé</w> dans un champ près du village.",
                            "target_lang_translations": {
                                "en": "A small light aircraft <w>crashed</w> into a field near the village.",
                                "ru": "Небольшой туристический самолёт <w>разбился</w> в поле возле деревни.",
                                "de": "Ein kleines Leichtflugzeug ist auf einem Feld in der Nähe des Dorfes <w>abgestürzt</w>.",
                                "es": "Una pequeña avioneta <w>se estrelló</w> en un campo cerca del pueblo.",
                                "zh": "一架小型观光飞机在村子附近的一片田野里<w>坠毁</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of the French verb écraser.",
                        "ru": "Форма мужского рода единственного числа причастия прошедшего времени глагола écraser.",
                        "de": "Maskuline Singularform des Partizips Perfekt des französischen Verbs écraser.",
                        "es": "Forma masculina singular del participio pasado del verbo francés écraser.",
                        "zh": "法语动词 écraser 的阳性单数过去分词，表示被压碎或压扁。"
                    },
