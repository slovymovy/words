                    {
                        "translation_id": "ccee2477-c6e5-4d10-b005-9f7e0bc14a1d",
                        "source_entry_id": "fc8bba0d-ef7c-3586-8908-5cc2df751b3c",
                        "source_sense_description": "животное",
                        "target_lang_word": "Einsiedlerkrebs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsiedlerkrebs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60f827f7-2732-3f89-84d0-b49b91f7b29c",
                                        "entry_id": "4b948339-0f37-3318-8b70-6fa4da30be5f",
                                        "glosses": [
                                            "Krebs, der seinen Hinterleib in leeren Schneckenhäusern, ähnlichen von anderen Lebewesen gebildeten Behausungen wie beispielsweise Korallen oder kalkigen Wurmröhren, oder auch Plastikmüll verbirgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b28432bd-19b5-4c08-8f31-2f12f17f0dd6",
                                                "sense_id": "60f827f7-2732-3f89-84d0-b49b91f7b29c",
                                                "text": "„Seine Haut juckte ihn plötzlich so sehr, dass er sie am liebsten abgestreift hätte wie ein Einsiedlerkrebs, der sich eine neue Schale sucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1faa45e6-73db-4772-bdac-382dd3b84e81",
                        "source_entry_id": "fc8bba0d-ef7c-3586-8908-5cc2df751b3c",
                        "source_sense_description": "животное",
                        "target_lang_word": "Eremit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eremit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                        "entry_id": "f6352f79-1ace-3163-89ba-a5e633ba22e3",
                                        "glosses": [
                                            "in Zurückgezogenheit lebender Mann (zum Beispiel aus religiöser Überzeugung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "025662d5-ec63-4bbd-9f19-f458542696df",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "Nicht alle Eremiten haben sich aus religiösen Gründen für ein Leben in Abgeschiedenheit entschieden."
                                            },
                                            {
                                                "example_id": "946db05e-05d8-4147-98be-4cff5d18c96a",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„1573 hatte sich der Eremit Claus Scheffer am Rande der Nuenhagener Wüstung niedergelassen.“"
                                            },
                                            {
                                                "example_id": "eea747de-1d52-4231-92a8-18c21edef9b4",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Endlich erblickte ich in der Ferne eine gotische Kapelle mit einer Hütte, die die Klause eines Eremiten zu sein schien.“"
                                            },
                                            {
                                                "example_id": "eeb390ff-9b8d-4afe-8bc2-3a70c44af328",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                                            },
                                            {
                                                "example_id": "fa9da3af-67d5-414a-8436-b5d040c1e38b",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Die ernste, eindringliche Warnung des heiligen Eremiten, die so voll Vernunft war, hatte Eingang nicht nur in seine Ohrmuschel, sondern auch in seinen Verstand und sein Herz gefunden und sein Gewissen wachgerüttelt.“"
                                            },
                                            {
                                                "example_id": "d4c49fea-2d00-4cc7-9206-7744ffc90e65",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Die frühen Asketen hatten auch Kontakte mit christlichen Eremiten im Irak und in Syrien, und es gab einen gewissen Austausch zwischen den beiden Gruppen, die gleichermaßen von der Vergänglichkeit und Nutzlosigkeit aller irdischen Freuden wussten und nur Gott ersehnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "541a4ee7-616e-37cf-89a9-44a76400ad87",
                                        "entry_id": "f6352f79-1ace-3163-89ba-a5e633ba22e3",
                                        "glosses": [
                                            "seltener Käfer der Art Osmoderma eremita aus der Familie der Rosenkäfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53634d08-be47-4ff7-a7be-6ed012457470",
                                                "sense_id": "541a4ee7-616e-37cf-89a9-44a76400ad87",
                                                "text": "Eremiten leben in Baumhöhlen, vor allem an Eichen, die sie oft ihr Leben lang nicht verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
