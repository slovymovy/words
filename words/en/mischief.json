{
    "word_family": [
        "mischievous",
        "mischievously",
        "mischievousness",
        "mischief-maker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4d7d651-5fbc-3dcd-b5a1-4318a92271db",
                    "sense_definition": "Conduct that playfully causes petty annoyance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "playful_misbehavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were full of <w>mischief</w> as they planned a surprise for their teacher.",
                            "target_lang_translations": {
                                "ru": "Дети были полны <w>озорства</w>, планируя сюрприз для своего учителя."
                            }
                        },
                        {
                            "text": "He had a look of <w>mischief</w> in his eyes before he hid his sister's favorite toy.",
                            "target_lang_translations": {
                                "ru": "В его глазах читалось <w>лукавство</w>, прежде чем он спрятал любимую игрушку сестры."
                            }
                        }
                    ],
                    "synonyms": [
                        "naughtiness",
                        "devilment",
                        "impishness",
                        "monkey business",
                        "prankishness"
                    ],
                    "antonyms": [
                        "decorum",
                        "propriety"
                    ],
                    "common_phrases": [
                        "full of mischief",
                        "get into mischief",
                        "up to mischief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поведение, которое в шутливой форме вызывает небольшое раздражение или беспокойство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озорство",
                                "target_lang_sense_clarification": "игривое поведение"
                            },
                            {
                                "target_lang_word": "шалость",
                                "target_lang_sense_clarification": "мелкая проделка"
                            },
                            {
                                "target_lang_word": "баловство",
                                "target_lang_sense_clarification": "несерьезное поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c5fce2-b265-3c8a-9b94-0cc8e2da3cd2",
                    "sense_definition": "Harm or trouble caused by an agent or brought about by a particular cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harm_and_injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm did a great deal of <w>mischief</w> to the small coastal village.",
                            "target_lang_translations": {
                                "ru": "Шторм нанес большой <w>ущерб</w> маленькой прибрежной деревушке."
                            }
                        },
                        {
                            "text": "I fear there is some <w>mischief</w> afoot in the political shadows of the city.",
                            "target_lang_translations": {
                                "ru": "Боюсь, что в политических кулуарах города затевается какое-то <w>зло</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "harm",
                        "damage",
                        "detriment",
                        "injury",
                        "trouble"
                    ],
                    "common_phrases": [
                        "mischief afoot",
                        "do serious mischief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вред или неприятности, причиненные кем-либо или возникшие по какой-либо причине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вред",
                                "target_lang_sense_clarification": "ущерб или урон"
                            },
                            {
                                "target_lang_word": "зло",
                                "target_lang_sense_clarification": "беда или напасть"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "материальный или физический"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "816b2a5d-50d3-3916-86da-9c648f9a0c39",
                    "sense_definition": "A playfully annoying action or prank.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "playful_misbehavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His latest <w>mischief</w> involved swapping the salt and sugar in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Его последней <w>проделкой</w> была подмена соли сахаром на кухне."
                            }
                        },
                        {
                            "text": "The kitten's little <w>mischiefs</w> around the house kept the family entertained all day.",
                            "target_lang_translations": {
                                "ru": "Маленькие <w>шалости</w> котенка по всему дому развлекали семью весь день."
                            }
                        }
                    ],
                    "synonyms": [
                        "prank",
                        "trick",
                        "caper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутливый, раздражающий поступок или розыгрыш."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шалость",
                                "target_lang_sense_clarification": "забавная проделка"
                            },
                            {
                                "target_lang_word": "проказа",
                                "target_lang_sense_clarification": "шутливая выходка"
                            },
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "неожиданный поступок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c9fcea9-4fa6-3075-bb4c-a53d86cdb831",
                    "sense_definition": "A cause or agent of annoyance, harm or injury, especially a person who causes trouble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "troublemaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That little boy is a real <w>mischief</w> when he is left alone in the garden.",
                            "target_lang_translations": {
                                "ru": "Этот маленький мальчик — настоящий <w>озорник</w>, когда его оставляют одного в саду."
                            }
                        },
                        {
                            "text": "She was known as a <w>mischief</w> to the local authorities because of her constant protests.",
                            "target_lang_translations": {
                                "ru": "Она была известна местным властям как <w>смутьянка</w> из-за своих постоянных протестов."
                            }
                        }
                    ],
                    "synonyms": [
                        "troublemaker",
                        "mischief-maker",
                        "scamp",
                        "imp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (особенно ребенок), который постоянно причиняет беспокойство или мелкий вред."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озорник",
                                "target_lang_sense_clarification": "склонный к шалостям"
                            },
                            {
                                "target_lang_word": "шалун",
                                "target_lang_sense_clarification": "непоседливый ребенок"
                            },
                            {
                                "target_lang_word": "проказник",
                                "target_lang_sense_clarification": "любитель шуток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc937e91-62ed-3801-9042-9fb8e1dee875",
                    "sense_definition": "A criminal offence involving the willful destruction of or damage to another's property.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_offence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers were charged with public <w>mischief</w> after spray-painting the library walls.",
                            "target_lang_translations": {
                                "ru": "Подросткам было предъявлено обвинение в нарушении <w>общественного порядка</w> после того, как они раскрасили стены библиотеки."
                            }
                        },
                        {
                            "text": "He faced a fine for criminal <w>mischief</w> after breaking the shop window.",
                            "target_lang_translations": {
                                "ru": "Ему грозил штраф за <w>умышленную порчу имущества</w> после того, как он разбил витрину магазина."
                            }
                        }
                    ],
                    "synonyms": [
                        "vandalism",
                        "misdemeanor"
                    ],
                    "common_phrases": [
                        "criminal mischief",
                        "public mischief"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уголовное преступление, связанное с умышленным уничтожением или повреждением чужого имущества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хулиганство",
                                "target_lang_sense_clarification": "нарушение порядка"
                            },
                            {
                                "target_lang_word": "порча имущества",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "вандализм",
                                "target_lang_sense_clarification": "осквернение или разрушение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01eeb273-15ad-345e-8f8c-95946664d490",
                    "sense_definition": "A collective noun for a group or a pack of rats.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_groups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>mischief</w> of rats scurried through the dark alleyway behind the restaurant.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> крыс пронеслась по темному переулку за рестораном."
                            }
                        },
                        {
                            "text": "The scientist observed how the <w>mischief</w> of rats interacted within the maze.",
                            "target_lang_translations": {
                                "ru": "Ученый наблюдал за тем, как <w>группа</w> крыс взаимодействует внутри лабиринта."
                            }
                        }
                    ],
                    "synonyms": [
                        "pack"
                    ],
                    "common_phrases": [
                        "mischief of rats"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для обозначения группы или стаи крыс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа животных"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "большое количество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "432ce3d5-5c5d-3b80-a460-45a07cc7c24e",
                    "sense_definition": "The Devil; used as an expletive to express frustration or surprise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expletives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What the <w>mischief</w> are you doing in my office at this hour?",
                            "target_lang_translations": {
                                "ru": "Какого <w>черта</w> вы делаете в моем офисе в такой час?"
                            }
                        },
                        {
                            "text": "How the <w>mischief</w> did he manage to finish the project so quickly?",
                            "target_lang_translations": {
                                "ru": "Как, <w>черт возьми</w>, ему удалось так быстро закончить проект?"
                            }
                        }
                    ],
                    "synonyms": [
                        "devil",
                        "deuce"
                    ],
                    "common_phrases": [
                        "what the mischief",
                        "how the mischief"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used as an expletive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дьявол; используется как восклицание для выражения разочарования или удивления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черт",
                                "target_lang_sense_clarification": "ругательство"
                            },
                            {
                                "target_lang_word": "леший",
                                "target_lang_sense_clarification": "в устойчивых выражениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a94cce2-ec82-3da1-9edf-a8f97d2286e7",
                    "sense_definition": "To do a mischief to; to cause harm or injury to someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harming_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain sought to <w>mischief</w> the entire kingdom with his dark magic.",
                            "target_lang_translations": {
                                "ru": "Злодей стремился <w>навредить</w> всему королевству своей темной магией."
                            }
                        },
                        {
                            "text": "He warned them not to <w>mischief</w> the delicate balance of the ecosystem.",
                            "target_lang_translations": {
                                "ru": "Он предупредил их, чтобы они не <w>нарушали</w> хрупкий баланс экосистемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "harm",
                        "injure",
                        "damage"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять вред или ущерб кому-либо или чему-либо (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вредить",
                                "target_lang_sense_clarification": "наносить урон"
                            },
                            {
                                "target_lang_word": "пакостить",
                                "target_lang_sense_clarification": "делать гадости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}