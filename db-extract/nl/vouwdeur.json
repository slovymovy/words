                        "entry_id": "d5c5af2a-cfe7-305e-875c-2384b2fe470c",
                        "glosses": [
                            "een deur die men opent door hem op te vouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acdcc4f6-ae3c-4202-b1bc-91663470e4ab",
                                "sense_id": "5c4b24b4-3aa0-3a70-ad57-05093b8ea7d6",
                                "text": "Tijdens douchen voorkomt een kunststof vouwdeur een nat toiletgedeelte en – slim! – de houten toegangsdeur is met kunststof bekleed tegen spetters."
                            },
                            {
                                "example_id": "998969d4-3fed-4c48-a173-ca7ddce4835a",
                                "sense_id": "5c4b24b4-3aa0-3a70-ad57-05093b8ea7d6",
                                "text": "Aan de kant van de voetbalvelden is het gebouw door grote glaspuien en vouwdeuren zo transparant mogelijk gemaakt. Overal is goed zicht op de velden."
                            }
                        ]
                    }
