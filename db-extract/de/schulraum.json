                ],
                "senses": [
                    {
                        "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                        "entry_id": "cf51fed3-9b2a-3680-b6c8-82a0ff6fcec6",
                        "glosses": [
                            "Menge an Räumlichkeiten und Fläche, die für Unterricht zur Verfügung steht"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5f5d39f4-cf59-4887-be99-064635753b14",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "„Dass neuer Schulraum dringend benötigt wird, betonte auch Oberbürgermeister Sören Link bei der Grundsteinlegung zu einem Erweiterungsneubau an der Astrid-Lindgren-Schule im Stadtteil Duissern.“"
                            },
                            {
                                "example_id": "acf31139-3336-4e72-93de-91cafb030085",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "„Ein Pionierprojekt will dringend benötigten Schulraum schaffen und gleichzeitig die Kirche besser nutzen.“"
                            },
                            {
                                "example_id": "89c625a9-8c66-4cf7-8cd0-299fdbfa7f8a",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "„Das Gebiet «Zug West» wächst derart rasch, dass bis 2025 ein Drittel mehr Kinder zur Schule gehen werden. Die Stadtregierung schreibt, dass der Neubau von Schulraum unumgänglich sei. Bei der Schulanlage Riedmatt soll ein weiteres Schulhaus für 17 Millionen Franken entstehen.“"
                            },
                            {
                                "example_id": "4f5e3fcb-b9c0-443a-8e1f-ceaf3524dbf1",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "„In seiner letzten Sitzung bewilligte der Einwohnerrat gleich zwei Kredite zur Schaffung von neuem Schulraum:“ […]."
                            },
                            {
                                "example_id": "81d05a6a-e68e-4714-8df0-4e7a8fef1d96",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "„»Aktuell sind schon über 3.000 neue Schülerinnen und Schüler aus der Ukraine geflohen, die jetzt in Wiener Klassen sind. Da war es kurzfristig notwendig, neuen Schulraum zu mobilisieren.«“"
                            },
                            {
                                "example_id": "57ecf6c8-f5a3-4b06-836e-7fd1111e42e0",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "[Berlin, Kinder aus der Ukraine:] „Idealerweise sollte es zwar das politische Ziel sein, allen Kindern einen Platz im deutschen Bildungssystem zu bieten, sagt Kuhn, »davon sind wir aber weit entfernt und deshalb reden wir über Not- und Überbrückungsmaßnahmen: Weil Berlin es auch in den nächsten zwölf Monaten nicht schaffen wird, ausreichend Schulraum zu finden«, befürchtet er.“"
                            },
                            {
                                "example_id": "15bf1283-43f8-4beb-9ecc-dcb0928c2419",
                                "sense_id": "4b5e3700-f2de-34b7-a893-467d2f322e54",
                                "text": "„83,2 Prozent der Jugendlichen in der Rütli-Hauptschule haben einen \"Migrationshintergrund\", wie es offiziell heißt. Sie stammen meist aus sogenannten bildungsfernen Elternhäusern und haben kein Interesse zu lernen. Vielmehr missbrauchen sie den Schulraum als Schauplatz ihrer Machtkämpfe um Anerkennung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                        "entry_id": "cf51fed3-9b2a-3680-b6c8-82a0ff6fcec6",
                        "glosses": [
                            "Raum (in einer Schule), in dem unterrichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f7952c-cdb8-4b3a-a149-ebaa9cd0d600",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„»Wer selber in einem Schulraum gesessen hat und weiß, wie nach 45 Minuten die Luft in einem Schulraum ist, weiß, dass man sich da nicht gut konzentrieren kann.«“"
                            },
                            {
                                "example_id": "aea1115a-919d-46bc-8a28-67516bf2ba15",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„Die Schulräume der evangelischen Volksschule am Markt in Lübbecke i./Westf. reichten seit längerer Zeit nicht mehr aus.“"
                            },
                            {
                                "example_id": "9dfdb97e-b33a-4dda-8a52-fb6c7ccef423",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„Die überaus schnelle Entwicklung Pankows, das damals noch ein Vorort Berlins mit über 40.000 Einwohnern war, machte die Bereitstellung neuer Schulräume notwendig.“"
                            },
                            {
                                "example_id": "5c184221-e5cc-43f1-906c-14f0eaa09a1d",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„In Pyhra entstehen ein neues Internat und weitere Schulräume. Insgesamt werden 15,6 Millionen Euro investiert.“"
                            },
                            {
                                "example_id": "037e93b5-b3e6-41cd-aa00-563720388bbc",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "[Coronapandemie 2022:] „Das Bayerische Kultusministerium empfiehlt Luftfilter, um die Viruslast in Schulräumen zu senken.“"
                            },
                            {
                                "example_id": "c0105a1f-81ba-4f82-a16a-fc934aaed819",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„Der 20 Meter hohe und 20 Tonnen schwere Baum stürzte auf die Bibliothek der Schule. Verletzt wurde niemand. Die Schulräume sind mittlerweile wieder freigegeben.“"
                            },
                            {
                                "example_id": "5cc4e72a-4f2a-4391-8ef3-2512efd3249b",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„Außerdem gibt es wertvolle Anleitungen, wie man den Geräuschpegel in Kitas und Schulräumen senken kann - und Kinder für Lärm sensibilisiert - ein ausgesprochen wichtiger Punkt, der sich auf Nerven und Gesundheit aller Beteiligten auswirkt!“"
                            },
                            {
                                "example_id": "729bca4c-f99a-4d08-94ff-ec82b03df834",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "[Landschaftsverband Westfalen-Lippe:] „6.400 behinderte Kinder und Jugendliche werden in den Schulen des LWL entsprechend ihrer Fähigkeiten gefördert. Dafür stellt der LWL den notwendigen Schulraum und die erforderliche Sachausstattung zur Verfügung.“"
                            },
                            {
                                "example_id": "e2472b3c-15b1-4636-b17a-aeb9cb436c6a",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "„Da viele Kommunen den sozialistischen Arbeiterchören nicht gestatteten, in Schulräumen zu proben, traf man sich häufig in Gaststätten und war angehalten, dort auch etwas zu trinken oder zu verzehren.“"
                            },
                            {
                                "example_id": "0b521f1d-c93a-4f6d-a781-727ff47921fa",
                                "sense_id": "617b2871-32c7-3597-8a0d-e6ce63037d4a",
                                "text": "[Eine kleine Dorfschule im Schwarzwald zu Beginn der 60er Jahre:] „Kinder unterschiedlichen Alters stapfen mehrere Kilometer ins Dorf, um am gemeinsamen Unterricht teilzunehmen, mit nur einem Lehrer, in nur einer Klasse, in einem winzigen Schulraum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
