                "senses": [
                    {
                        "sense_id": "3b58117e-c9aa-30cc-ab71-c6c6ffbc7234",
                        "entry_id": "0a7b9587-86d2-37b2-82a9-0effaf9f3f87",
                        "glosses": [
                            "Ort, an dem Überreste alter Kulturen aus der Erde geborgen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a88a72c-102f-4f21-b8c8-e706e52a9ca7",
                                "sense_id": "3b58117e-c9aa-30cc-ab71-c6c6ffbc7234",
                                "text": "„Forscher haben an der nordspanischen Ausgrabungsstätte Atapuerca einen menschlichen vorderen Backenzahn gefunden, dessen Alter sie auf bis zu 1,2 Millionen Jahre schätzen.“"
                            },
                            {
                                "example_id": "27b8257d-46a3-4927-a4aa-bb8490dd7b82",
                                "sense_id": "3b58117e-c9aa-30cc-ab71-c6c6ffbc7234",
                                "text": "„Dort liegt die rund 2400 Jahre alte Ausgrabungsstätte der antiken Stadt Messini.“"
                            },
                            {
                                "example_id": "d25547a7-772e-479c-9b51-f79c24cbe8b7",
                                "sense_id": "3b58117e-c9aa-30cc-ab71-c6c6ffbc7234",
                                "text": "„Schneebedeckte Berge bilden den Hintergrund der Ausgrabungsstätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
