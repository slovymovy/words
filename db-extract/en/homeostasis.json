    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                "word": "homeostasis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "26321fd2-0e96-4fa5-ae4b-b1ccde9d7dec",
                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "tags": [
                            "plural"
                        ],
                        "form": "homeostases"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "glosses": [
                            "The ability of a system or living organism to adjust its internal environment to maintain a state of dynamic constancy; such as the ability of warm-blooded animals to maintain a stable temperature."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a87313a-6f70-43a2-9b00-42be9dbdd88a",
                                "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                "text": "His most important work concentrated on the complexities of chemical neurotransmission (for which Otto Loewi received a Nobel Prize in 1936) and on “homeostasis” (a term coined by Cannon in 1926), the maintenance of steady states in the body and the physiological processes through which they are regulated."
                            },
                            {
                                "example_id": "27af30af-a9f1-4080-a108-a9e18267b4f4",
                                "sense_id": "f5fc2513-0abc-35fb-bf77-9febb5b93885",
                                "text": "When homeostasis is disrupted by an external stressor - such as injury, lack of nutrients, or invasion by parasites or other organisms - illness may occur."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c2918ed-f235-3a00-94aa-caee3a42a92c",
                        "entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "glosses": [
                            "Such a dynamic equilibrium or balance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8ba1478-0c7f-4f8c-9976-17dd8f2b73c2",
                        "source_entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
                        "source_sense_description": "ability to stabilize internal environment",
                        "target_lang_word": "homeostáza",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeostáza",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "8f42d0f8-3842-3792-9d12-6dcb879ebd42",
                                        "entry_id": "68043b71-b8cc-37d5-83b1-09040f2d47cf",
                                        "glosses": [
                                            "stav dynamické funkční rovnováhy organismu nebo společenství"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d55e07-3a9a-492e-8565-1ccc364b9999",
                                                "sense_id": "8f42d0f8-3842-3792-9d12-6dcb879ebd42",
                                                "text": "Žlázy s vnitřní sekrecí spolu s nervovým a imunitním systémem řídí a integrují veškeré funkce těla tak, aby byla zachovaná homeostáza organismu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfc7dc5c-4845-4b49-a17d-87fd15570916",
                        "source_entry_id": "32159d56-4a9a-30f2-bef7-39877dfa4bfc",
