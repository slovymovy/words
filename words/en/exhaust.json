{
    "word_family": [
        "exhaustion",
        "exhaustive",
        "inexhaustible",
        "inexhaustibly",
        "exhaustively"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28a30a09-228e-3469-b397-4422e66d3b91",
                    "sense_definition": "To make someone extremely tired, either physically or mentally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fatigue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long journey completely <w>exhausted</w> the children.",
                            "target_lang_translations": {
                                "ru": "Длительное путешествие совершенно <w>изнурило</w> детей.",
                                "zh": "漫长的旅途让孩子们<w>精疲力竭</w>。"
                            }
                        },
                        {
                            "text": "Working two jobs without a break will eventually <w>exhaust</w> you.",
                            "target_lang_translations": {
                                "ru": "Работа на двух работах без перерыва в конечном итоге <w>истощит</w> вас.",
                                "zh": "不间断地做两份工作最终会把你<w>耗尽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tire out",
                        "weary",
                        "wear out",
                        "drain"
                    ],
                    "common_phrases": [
                        "exhaust oneself",
                        "completely exhaust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно утомлять кого-либо физически или морально.",
                        "zh": "使某人感到极度疲劳，无论是身体上还是精神上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнурять",
                                "target_lang_sense_clarification": "сильно утомлять, лишать сил"
                            },
                            {
                                "target_lang_word": "истощать",
                                "target_lang_sense_clarification": "доводить до полного бессилия"
                            },
                            {
                                "target_lang_word": "выматывать",
                                "target_lang_sense_clarification": "разговорное; сильно утомлять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使精疲力竭",
                                "target_lang_sense_clarification": "使人彻底失去体力或精力"
                            },
                            {
                                "target_lang_word": "耗尽",
                                "target_lang_sense_clarification": "消耗掉所有的精力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f862d08-7383-398d-be3e-86616684d360",
                    "sense_definition": "To use all of something so that there is none left.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "depletion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have <w>exhausted</w> our supply of clean water.",
                            "target_lang_translations": {
                                "ru": "Мы <w>исчерпали</w> наш запас чистой воды.",
                                "zh": "我们已经<w>耗尽</w>了净水储备。"
                            }
                        },
                        {
                            "text": "The team <w>exhausted</w> every option before admitting defeat.",
                            "target_lang_translations": {
                                "ru": "Команда <w>исчерпала</w> все возможности, прежде чем признать поражение.",
                                "zh": "团队在承认失败前<w>用尽</w>了所有方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consume",
                        "spend"
                    ],
                    "common_phrases": [
                        "exhaust resources",
                        "exhaust supplies",
                        "exhaust all possibilities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать что-либо полностью, пока ничего не останется.",
                        "zh": "用尽某物，以至于所剩无几。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчерпывать",
                                "target_lang_sense_clarification": "запасы, возможности"
                            },
                            {
                                "target_lang_word": "истощать",
                                "target_lang_sense_clarification": "ресурсы, почву"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耗尽",
                                "target_lang_sense_clarification": "用光资源或储备"
                            },
                            {
                                "target_lang_word": "用完",
                                "target_lang_sense_clarification": "消耗掉全部存量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b3e0c0b-3712-39ae-a055-40a67b5528e3",
                    "sense_definition": "To talk about a subject so thoroughly that there is nothing left to say.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "depletion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have <w>exhausted</w> this topic for today, so let us move on.",
                            "target_lang_translations": {
                                "ru": "Мы <w>исчерпали</w> эту тему на сегодня, так что давайте двигаться дальше.",
                                "zh": "今天这个话题我们已经<w>讨论透彻</w>了，让我们继续下一个吧。"
                            }
                        },
                        {
                            "text": "The committee <w>exhausted</w> the subject during the long meeting.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>исчерпал</w> тему во время долгого заседания.",
                                "zh": "委员会在漫长的会议中将该议题<w>详尽讨论</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exhaust a topic",
                        "exhaust the subject"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсудить тему настолько подробно, что больше нечего сказать.",
                        "zh": "将某个话题讨论得非常透彻，以至于没有什么可说的了。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчерпывать",
                                "target_lang_sense_clarification": "тему, вопрос"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "详尽讨论",
                                "target_lang_sense_clarification": "彻底探讨某个议题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73020b86-f965-3072-8659-3c771d7a3bec",
                    "sense_definition": "To expel or let out air, gas, or steam from a machine or enclosed space.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large fan <w>exhausts</w> hot air from the kitchen.",
                            "target_lang_translations": {
                                "ru": "Большой вентилятор <w>вытягивает</w> горячий воздух из кухни.",
                                "zh": "大风扇将厨房里的热气<w>排出</w>。"
                            }
                        },
                        {
                            "text": "The engine <w>exhausts</w> steam through a narrow pipe.",
                            "target_lang_translations": {
                                "ru": "Двигатель <w>выпускает</w> пар через узкую трубу.",
                                "zh": "发动机通过一根细管<w>排出</w>蒸汽。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exhaust air",
                        "exhaust fumes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпускать воздух, газ или пар из машины или замкнутого пространства.",
                        "zh": "从机器或封闭空间中排出空气、气体或蒸汽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "газ, пар"
                            },
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "удалять воздух или газ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排出",
                                "target_lang_sense_clarification": "将气体或蒸汽从内部导出"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c3e31b7-c02b-385f-9792-f7ff201bf25c",
                    "sense_definition": "The waste gas or steam that is discharged from an engine or machine.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emission_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of car <w>exhaust</w> filled the small garage.",
                            "target_lang_translations": {
                                "ru": "Запах автомобильных <w>выхлопных газов</w> наполнил маленький гараж.",
                                "zh": "汽车<w>尾气</w>的味道充斥着整个小车库。"
                            }
                        },
                        {
                            "text": "Carbon monoxide is a dangerous gas found in vehicle <w>exhaust</w>.",
                            "target_lang_translations": {
                                "ru": "Угарный газ — это опасный газ, содержащийся в автомобильном <w>выхлопе</w>.",
                                "zh": "一氧化碳是车辆<w>废气</w>中存在的一种危险气体。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "car exhaust",
                        "exhaust fumes",
                        "exhaust emissions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отработанные газы или пар, выбрасываемые двигателем или машиной.",
                        "zh": "从发动机或机器中排放出的废气或蒸汽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выхлопные газы",
                                "target_lang_sense_clarification": "смесь газов"
                            },
                            {
                                "target_lang_word": "выхлоп",
                                "target_lang_sense_clarification": "разговорное; выброс газов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废气",
                                "target_lang_sense_clarification": "发动机排放的有害气体"
                            },
                            {
                                "target_lang_word": "尾气",
                                "target_lang_sense_clarification": "车辆排放的废气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f082d44-bd23-3ecc-8642-ddd0159542e3",
                    "sense_definition": "The pipe or system of pipes through which waste gases are released from an engine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My car needs a new <w>exhaust</w> because the old one is rusty.",
                            "target_lang_translations": {
                                "ru": "Моей машине нужна новая <w>выхлопная труба</w>, так как старая заржавела.",
                                "zh": "我的车需要换个新的<w>排气管</w>，因为旧的已经生锈了。"
                            }
                        },
                        {
                            "text": "Water dripped from the <w>exhaust</w> of the truck as it idled.",
                            "target_lang_translations": {
                                "ru": "Вода капала из <w>выхлопной трубы</w> грузовика, пока он работал на холостом ходу.",
                                "zh": "卡车怠速时，水从<w>排气管</w>里滴了出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exhaust pipe",
                        "dual exhaust",
                        "fix the exhaust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Труба или система труб, через которые выводятся отработанные газы.",
                        "zh": "发动机排放废气的管道或管道系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выхлопная труба",
                                "target_lang_sense_clarification": "деталь автомобиля"
                            },
                            {
                                "target_lang_word": "система выхлопа",
                                "target_lang_sense_clarification": "техническое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排气管",
                                "target_lang_sense_clarification": "车辆排放废气的金属管"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}