{
    "word_family": [
        "bleat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb904274-6189-33d7-b2b3-e952468eccaf",
                    "sense_definition": "present participle and gerund of <w>bleat</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost lamb was <w>bleating</w> softly until its mother returned.",
                            "target_lang_translations": {
                                "de": "Das verlorene Lamm <w>blökte</w> leise, bis seine Mutter zurückkam."
                            }
                        },
                        {
                            "text": "Stop <w>bleating</w> about how unfair the rules are and just play.",
                            "target_lang_translations": {
                                "de": "Hör auf darüber zu <w>jammern</w>, wie unfair die Regeln sind, und spiel einfach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von bleat; blöken, meckern oder jammern"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "blöken",
                                "target_lang_sense_clarification": "Tierlaut von Schafen"
                            },
                            {
                                "target_lang_word": "meckern",
                                "target_lang_sense_clarification": "übertragen: nörgeln, sich beschweren"
                            },
                            {
                                "target_lang_word": "jammern",
                                "target_lang_sense_clarification": "wehleidig klagen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47297bf2-33a0-3830-b105-4103f1772c9e",
                    "sense_definition": "The sound made by a sheep, goat, or calf.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant <w>bleating</w> of sheep could be heard across the valley.",
                            "target_lang_translations": {
                                "de": "Das ferne <w>Blöken</w> der Schafe war im ganzen Tal zu hören."
                            }
                        },
                        {
                            "text": "A sudden <w>bleating</w> from the barn woke the farmer in the night.",
                            "target_lang_translations": {
                                "de": "Ein plötzliches <w>Blöken</w> aus der Scheune weckte den Bauern in der Nacht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bleating of sheep"
                    ],
                    "target_lang_definitions": {
                        "de": "Der charakteristische Laut von einem Schaf, einer Ziege oder einem Kalb."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Blöken",
                                "target_lang_sense_clarification": "Laut von Schafen"
                            },
                            {
                                "target_lang_word": "das Meckern",
                                "target_lang_sense_clarification": "Laut von Ziegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4e9e7a5-8a91-353a-aeba-92f620c3735d",
                    "sense_definition": "Foolish, whiny, or repetitive complaining.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to listen to his endless <w>bleating</w> about minor problems.",
                            "target_lang_translations": {
                                "de": "Niemand wollte sich sein endloses <w>Gejammer</w> über belanglose Probleme anhören."
                            }
                        },
                        {
                            "text": "Constant <w>bleating</w> from critics did not stop the project from moving forward.",
                            "target_lang_translations": {
                                "de": "Das ständige <w>Gemecker</w> der Kritiker hielt das Projekt nicht davon ab, weiter voranzukommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "whining",
                        "grumbling"
                    ],
                    "common_phrases": [
                        "constant bleating"
                    ],
                    "target_lang_definitions": {
                        "de": "Albernes, wehleidiges oder wiederholtes Klagen und Nörgeln."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Gejammer",
                                "target_lang_sense_clarification": "wehleidiges Klagen"
                            },
                            {
                                "target_lang_word": "das Gemecker",
                                "target_lang_sense_clarification": "ständiges Nörgeln"
                            },
                            {
                                "target_lang_word": "das Genörgel",
                                "target_lang_sense_clarification": "fortwährendes Beschweren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}