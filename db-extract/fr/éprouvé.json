                ],
                "senses": [
                    {
                        "sense_id": "1a08615e-2fb6-3e02-9828-e03aaf92d622",
                        "entry_id": "514cd9eb-778e-3a8d-b066-6bcf835d39cc",
                        "glosses": [
                            "Qui a beaucoup souffert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1597ba64-f2de-498e-bd63-94c700e97514",
                                "sense_id": "1a08615e-2fb6-3e02-9828-e03aaf92d622",
                                "text": "Ces jours derniers, une fille du village se tordait sur son lit pour mettre au monde un fils de père inconnu. Au plus fort de ses douleurs, l'idée lui vient d'implorer Notre-Dame, et elle charge sa sœur, fille éprouvée comme elle, de porter un cierge à l'autel."
                            },
                            {
                                "example_id": "e917dcd2-508c-4d28-8ae4-bf39bce668bc",
                                "sense_id": "1a08615e-2fb6-3e02-9828-e03aaf92d622",
                                "text": "Une recrudescence de l'épizootie de fièvre aphteuse est signalée dans le département des Ardennes. Douzy, Étalle, Étion, Marby, Carignan, Regniowez, Juniville, Perthes et Annelles sont parmi les localités les plus éprouvées."
                            }
                        ]
                    },
                    {
                        "sense_id": "9531924b-d538-3cda-9691-2a2bae4e785e",
                        "entry_id": "514cd9eb-778e-3a8d-b066-6bcf835d39cc",
                        "glosses": [
                            "Qui a fait ses preuves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "590f72f3-5b3a-47d2-90f2-5ea2ce0ae95b",
                                "sense_id": "9531924b-d538-3cda-9691-2a2bae4e785e",
                                "text": "Une méthode éprouvée."
                            }
                        ]
                    }
                ],
