                                                "example_id": "e4b00fbe-ee8e-4b5e-ae77-bbfcc51e91ba",
                                                "sense_id": "161a56de-9d70-3d65-bf78-74cefc9a99f3",
                                                "text": "В Париже произошел взрыв на ацетиленовой фабрике, разрушивший все здание."
                                            },
                                            {
                                                "example_id": "1ea6db6c-b9ef-4527-9253-555e73efae1c",
                                                "sense_id": "161a56de-9d70-3d65-bf78-74cefc9a99f3",
                                                "text": "Одним из научных направлений деятельности Карозерса было исследование полимеризации этиленовых и ацетиленовых соединений."
                                            },
                                            {
                                                "example_id": "291fefa5-a24b-447e-85e7-4732055ba8ff",
                                                "sense_id": "161a56de-9d70-3d65-bf78-74cefc9a99f3",
                                                "text": "Недаром пламя ацетиленовой горелки легко режет почти любой металл."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa009f19-7bf9-3418-bdd2-2aca047f6d40",
                                        "entry_id": "cac0b391-bf98-3eac-8973-817cb51b4c85",
                                        "glosses": [
