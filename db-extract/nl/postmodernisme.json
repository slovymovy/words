        "nl-extract.jsonl": [
            {
                "entry_id": "6105186d-d505-3c94-9f48-72a35a21923c",
                "word": "postmodernisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f64e900-c4e8-3f96-98e7-8a0143a00d7c",
                        "entry_id": "6105186d-d505-3c94-9f48-72a35a21923c",
                        "glosses": [
                            "culturele stroming die na het modernisme komt en zich daar tegen afzet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4999172-59d0-4251-ad79-cd09449a3c24",
                                "sense_id": "3f64e900-c4e8-3f96-98e7-8a0143a00d7c",
                                "text": "En grote cultuuruitingen als die van Beethoven en Bach, van Da Vinci en Rembrandt, van Shakespeare en Goethe mogen we koesteren en hoeven we ons door modernisme en postmodernisme niet te laten ontnemen."
                            },
                            {
                                "example_id": "00d08e0c-910e-40c6-baeb-ee76cc631b6a",
                                "sense_id": "3f64e900-c4e8-3f96-98e7-8a0143a00d7c",
                                "text": "Er hangt toch meteen een andere vibe. Zojuist zat ik nog in een gesprek waarin iemand, een jonge debutant was dat, zei: \"Ik ben de laatste tijd fan van de antiheld. Dat zal wel door het postmodernisme komen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e991faa0-a578-4e09-a87f-cbeff2cf87a8",
                        "source_entry_id": "6105186d-d505-3c94-9f48-72a35a21923c",
                        "source_sense_id": "3f64e900-c4e8-3f96-98e7-8a0143a00d7c",
                        "target_lang_word": "postmodernism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postmodernism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34272371-f87b-31f8-ab41-859acbef970c",
                                        "entry_id": "c8c6f281-92b2-3a95-838d-296d0e9efef2",
                                        "glosses": [
                                            "Any style in art, architecture, literature, philosophy, etc., that reacts against an earlier modernist movement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1537aa22-f765-3823-b58e-0b8be6f58763",
                                        "entry_id": "c8c6f281-92b2-3a95-838d-296d0e9efef2",
                                        "glosses": [
                                            "An attitude of skepticism or irony toward modernist ideologies, often questioning the assumptions of Enlightenment rationality and rejecting the idea of objective truth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db0ac03e-70ea-4676-b753-7a69ef8c89de",
                                                "sense_id": "1537aa22-f765-3823-b58e-0b8be6f58763",
                                                "text": "The most famous definition of postmodernism is Lyotard's: “I define postmodern as incredulity towards metanarratives.” […] To accept Lyotard's definition of postmodernism is to accept the premise that postmodernism is the first movement since the Enlightenment to think critically about such narratives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
