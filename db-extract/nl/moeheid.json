                                                "text": "Nach getaner Arbeit ließ er sich in den Sessel fallen und schlief vor Ermüdung ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ffc4a288-eb28-3913-bf34-834b344bd38d",
                                        "entry_id": "220c97cf-e612-3caf-b494-2f4f8fcc7aef",
