                "translations": [
                    {
                        "translation_id": "9de23fde-a9d6-4fb7-889c-10d599d3c7d0",
                        "source_entry_id": "df12aa24-f4b5-38d3-94c9-e3b9cd29d58d",
                        "source_sense_id": "c46703d0-50e9-30c1-8319-acc5510d6f91",
                        "source_sense_description": "ohne Plural: Sportart, bei der ein Ball mit der Hand in das gegnerische Tor geworfen werden muss",
                        "target_lang_word": "handball",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "418781f3-f628-301c-ab32-bb58a75cc7f1",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "A team sport where two teams of seven players each (six players and a goalkeeper) pass and bounce a ball trying to throw it in the goal of the opposing team."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5fa5852-8ac8-3ac1-84aa-fa7309e6ea85",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "The medium-sized inflated ball used in this sport."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "612b062a-573f-3453-9255-268b48a3da48",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "The offence of a player other than the goalkeeper touching the ball with the hand or arm on the field during play."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "473a9bdb-06c2-4965-a1ea-493daca1d8b6",
                                                "sense_id": "612b062a-573f-3453-9255-268b48a3da48",
                                                "text": "It was a dramatic finish to an absorbing, fast-paced game but Blackburn will be deeply unhappy with referee Anthony Taylor as Nzonzi's handball was harsh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c28d2f-1c4f-3ff1-b636-55c1321b3d06",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "A sport in which players alternately strike the ball against a wall with their hand. Irish and American variants have slightly different rules."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0313e138-6e26-3d5b-861b-bff7035ee771",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "The small rubber ball used in this sport."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e88d0580-d3fb-33fb-9231-8a796ce55b43",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "An act of passing a football by holding it with one hand and hitting it with the other."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77c08de7-c064-39a1-9d9b-32e0d4b69b95",
                                        "entry_id": "bc7fdacc-5156-3b5b-8a16-58c6723d79de",
                                        "glosses": [
                                            "A schoolyard game in which a tennis ball is struck with the hand, played on an improvised court on the asphalt or pavement."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "handball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "687be535-f790-3355-9348-405c151aab04",
                                        "entry_id": "4bb38e94-4540-359d-8fc0-91ee0e027a22",
                                        "glosses": [
                                            "To manually load or unload a container, trailer, or to otherwise manually move bulk goods (often on pallets) from one type of transport receptacle to another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f94b8f69-eb13-38f0-b6e8-f15a04ae30bd",
                                        "entry_id": "4bb38e94-4540-359d-8fc0-91ee0e027a22",
                                        "glosses": [
                                            "To illegally touch the ball with the hand or arm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6417fda-1d4d-44ea-b6c7-8aaab8cb495d",
                                                "sense_id": "f94b8f69-eb13-38f0-b6e8-f15a04ae30bd",
                                                "text": "If the defender handballs in the penalty area, a penalty is awarded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ced0c5-095d-371c-93d9-c6d97106a071",
                                        "entry_id": "4bb38e94-4540-359d-8fc0-91ee0e027a22",
                                        "glosses": [
                                            "To (legally) pass a football by holding it with one hand and hitting it with the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38d752e-97dc-46eb-9b1c-cf1495aac013",
                                                "sense_id": "05ced0c5-095d-371c-93d9-c6d97106a071",
                                                "text": "Meanwhile, you can introduce the basic concept of Aussie rules through a game like lineball, a lead-up game introduced in the basketball section of chapter 10, but with the ball handballed, not thrown."
                                            },
                                            {
                                                "example_id": "7e6cc3cf-ba11-414a-815c-c415b7279a9b",
                                                "sense_id": "05ced0c5-095d-371c-93d9-c6d97106a071",
                                                "text": "An obvious way in which football has changed over the last decade or two has been in the use of handballing."
                                            },
                                            {
                                                "example_id": "2327d333-d219-41cd-b3c9-eb53e82800fd",
                                                "sense_id": "05ced0c5-095d-371c-93d9-c6d97106a071",
                                                "text": "On only 8 occasions during the entire match did players who had marked the ball decide not to walk slowly and purposefully back and take their kick, but instead play on by handballing to a team mate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aea73e99-a751-3794-9793-4e2dba336bfc",
                                        "entry_id": "4bb38e94-4540-359d-8fc0-91ee0e027a22",
                                        "glosses": [
                                            "To insert a hand into someone's anus."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87b57215-d230-4e7a-804e-11eae585fcc2",
                        "source_entry_id": "df12aa24-f4b5-38d3-94c9-e3b9cd29d58d",
