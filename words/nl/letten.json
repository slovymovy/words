            "senses": [
                {
                    "sense_id": "889e5104-4b41-3733-95ab-d98be17524ef",
                    "sense_definition": "aandacht aan iets of iemand geven",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet goed <w>letten</w> op de verkeersborden als je in een nieuwe stad rijdt.",
                            "target_lang_translations": {
                                "en": "You must <w>pay</w> close <w>attention</w> to the traffic signs when you drive in a new city."
                            }
                        },
                        {
                            "text": "Tijdens het koken moet hij altijd goed <w>op</w> de <w>details</w> <w>letten</w>.",
                            "target_lang_translations": {
                                "en": "While cooking, he always has to <w>pay attention</w> to the details."
                            }
                        }
                    ],
                    "synonyms": [
                        "opletten",
                        "acht slaan op"
                    ],
                    "antonyms": [
                        "verwaarlozen",
                        "negeren"
                    ],
                    "common_phrases": [
                        "op details letten",
                        "op de kleintjes letten",
                        "goed letten op"
                    ],
                    "target_lang_definitions": {
                        "en": "to pay attention to something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay attention",
                                "target_lang_sense_clarification": "to focus one's mind on something"
                            },
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to observe or look out for something"
                            },
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "to be careful of or pay heed to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80890060-22dd-3c23-970b-5f87e8e3912d",
                    "sense_definition": "iets of iemand in de gaten houden of bewaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toezicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je even op mijn tas willen <w>letten</w> terwijl ik een kopje koffie haal?",
                            "target_lang_translations": {
                                "en": "Would you <w>watch</w> my bag for a moment while I get a cup of coffee?"
                            }
                        },
                        {
                            "text": "De oppas moet de hele avond op de spelende kinderen <w>letten</w>.",
                            "target_lang_translations": {
                                "en": "The babysitter has to <w>keep an eye on</w> the children playing all evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "passen op",
                        "bewaken"
                    ],
                    "common_phrases": [
                        "op de kinderen letten",
                        "op de bagage letten"
                    ],
                    "target_lang_definitions": {
                        "en": "to keep an eye on or guard something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to keep under observation"
                            },
                            {
                                "target_lang_word": "look after",
                                "target_lang_sense_clarification": "to take care of or keep an eye on"
                            },
                            {
                                "target_lang_word": "keep an eye on",
                                "target_lang_sense_clarification": "to monitor or guard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "484c4950-a4f4-372a-90b2-6f687b1c1a4d",
                    "sense_definition": "iemand tegenhouden of verhinderen om iets te doen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hinderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat <w>let</w> je om nu eindelijk die belangrijke beslissing te nemen?",
                            "target_lang_translations": {
                                "en": "What <w>stops</w> you from finally making that important decision?"
                            }
                        },
                        {
                            "text": "Niets <w>let</w> ons om morgen vroeg te vertrekken naar de kust.",
                            "target_lang_translations": {
                                "en": "Nothing <w>prevents</w> us from leaving for the coast early tomorrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "beletten",
                        "tegenhouden",
                        "verhinderen"
                    ],
                    "antonyms": [
                        "toestaan",
                        "aanmoedigen"
                    ],
                    "common_phrases": [
                        "wat let je"
                    ],
                    "target_lang_definitions": {
                        "en": "to stop or prevent someone from doing something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to prevent from acting"
                            },
