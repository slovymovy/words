                        "glosses": [
                            "A collection of Old Norse poems and tales from two medieval manuscripts found in Iceland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa9951f-359f-440b-a170-d1e073cf2100",
                                "sense_id": "c9b40b55-c3c8-315d-b2f3-57a7bc7cec9a",
                                "text": "So likewise a day comes when the Runic Thor, with his Eddas, must withdraw into dimness; and many an African Mumbo-Jumbo and Indian Pawpaw be utterly abolished."
                            }
                        ]
                    }
                ],
