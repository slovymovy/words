{
    "word_family": [
        "ruthlessly",
        "ruthlessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc8dcf62-fd9c-3434-b0ea-2e79339d0665",
                    "sense_definition": "Determined to succeed without allowing any feelings or difficulties to get in the way; uncompromising and unrelenting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncompromising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's <w>ruthless</w> efficiency led to record profits but left many employees feeling overworked and undervalued.",
                            "target_lang_translations": {
                                "ru": "<w>Бескомпромиссная</w> эффективность компании привела к рекордной прибыли, но заставила многих сотрудников чувствовать себя переутомленными и недооцененными."
                            }
                        },
                        {
                            "text": "He was known for his <w>ruthless</w> ambition, never letting anyone stand in the way of his career goals.",
                            "target_lang_translations": {
                                "ru": "Он был известен своим <w>неумолимым</w> честолюбием, никогда не позволяя никому стоять на пути к его карьерным целям."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrelenting",
                        "uncompromising",
                        "implacable"
                    ],
                    "common_phrases": [
                        "ruthless ambition",
                        "ruthless efficiency",
                        "ruthless determination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительно настроенный на успех, не позволяющий чувствам или трудностям мешать; бескомпромиссный и неуклонный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бескомпромиссный",
                                "target_lang_sense_clarification": "не идущий на уступки ради цели"
                            },
                            {
                                "target_lang_word": "неумолимый",
                                "target_lang_sense_clarification": "непреклонный в достижении результата"
                            },
                            {
                                "target_lang_word": "жесткий",
                                "target_lang_sense_clarification": "решительный и суровый в действиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f8653c-08de-367c-90eb-de8792d00480",
                    "sense_definition": "Having or showing no pity or compassion for others; cruel and pitiless.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cruel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ruthless</w> dictator ordered the arrest of anyone who dared to speak out against his regime.",
                            "target_lang_translations": {
                                "ru": "<w>Безжалостный</w> диктатор приказал арестовать любого, кто осмелится высказаться против его режима."
                            }
                        },
                        {
                            "text": "History remembers him as a <w>ruthless</w> killer who showed no mercy to his defeated enemies.",
                            "target_lang_translations": {
                                "ru": "История помнит его как <w>беспощадного</w> убийцу, не проявившего милосердия к своим побежденным врагам."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitiless",
                        "merciless",
                        "cruel",
                        "heartless"
                    ],
                    "antonyms": [
                        "ruthful"
                    ],
                    "common_phrases": [
                        "ruthless killer",
                        "ruthless dictator",
                        "ruthless treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не проявляющий жалости или сострадания к другим; жестокий и беспощадный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безжалостный",
                                "target_lang_sense_clarification": "лишенный сострадания"
                            },
                            {
                                "target_lang_word": "беспощадный",
                                "target_lang_sense_clarification": "не знающий пощады"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "крайне суровый и бесчеловечный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}