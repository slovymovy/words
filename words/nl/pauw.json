            "senses": [
                {
                    "sense_id": "08bf7b6c-c4de-3580-8065-d5eb1bf0c406",
                    "sense_definition": "Een grote siervogel uit het geslacht Pavo, waarvan het mannetje bekendstaat om zijn lange, kleurrijke staartveren die hij als een waaier kan opzetten.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de dierentuin zagen we een <w>pauw</w> die zijn prachtige staart liet zien.",
                            "target_lang_translations": {
                                "en": "At the zoo, we saw a <w>peacock</w> showing off its beautiful tail.",
                                "ru": "В зоопарке мы видели <w>павлина</w>, который показывал свой великолепный хвост."
                            }
                        },
                        {
                            "text": "De <w>pauw</w> liep trots over het gazon van het kasteel.",
                            "target_lang_translations": {
                                "en": "The <w>peacock</w> walked proudly across the castle lawn.",
                                "ru": "<w>Павлин</w> гордо расхаживал по газону замка."
                            }
                        }
                    ],
                    "synonyms": [
                        "blauwe pauw"
                    ],
                    "common_phrases": [
                        "trots als een pauw"
                    ],
                    "target_lang_definitions": {
                        "en": "A large ornamental bird of the genus Pavo, of which the male is known for its long, colorful tail feathers that it can fan out.",
                        "ru": "Крупная декоративная птица рода Pavo, самец которой известен своими длинными яркими перьями хвоста, которые он может раскрывать веером."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peacock",
                                "target_lang_sense_clarification": "specifically the male bird"
                            },
                            {
                                "target_lang_word": "peafowl",
                                "target_lang_sense_clarification": "general term for both male and female"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "павлин",
                                "target_lang_sense_clarification": "общее название птицы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e7f9a3e-1774-34ba-b7fd-8cbcf1990851",
                    "sense_definition": "Specifieke benaming voor de blauwe pauw (Pavo cristatus), oorspronkelijk afkomstig uit India.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De blauwe <w>pauw</w> is de nationale vogel van India.",
                            "target_lang_translations": {
