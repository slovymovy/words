                                                "text": "sounding words"
                                            },
                                            {
                                                "example_id": "808dadf6-4695-464f-8eb4-7d5325a3d12c",
                                                "sense_id": "11c3fa18-b6dc-3307-a47c-45ff8afe2628",
                                                "text": "In her tomb by the sounding sea."
