{
    "word_family": [
        "bevriezen",
        "vriespunt",
        "vrieskou",
        "vrieskist",
        "vriezer",
        "bevroren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a8b9590-1151-3eff-af5d-42a75e9f3d39",
                    "sense_definition": "het heersen van een temperatuur onder nul graden Celsius waarbij water in ijs verandert",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het heeft vannacht flink <w>gevroren</w>, dus de autoruiten zijn helemaal wit.",
                            "target_lang_translations": {
                                "en": "It <w>froze</w> hard last night, so the car windows are completely white."
                            }
                        },
                        {
                            "text": "Als het blijft <w>vriezen</w>, kunnen we volgende week eindelijk op natuurijs schaatsen.",
                            "target_lang_translations": {
                                "en": "If it continues to <w>freeze</w>, we can finally skate on natural ice next week."
                            }
                        }
                    ],
                    "antonyms": [
                        "dooien"
                    ],
                    "common_phrases": [
                        "licht vriezen",
                        "dat het vriest",
                        "blijven vriezen",
                        "flink vriezen"
                    ],
                    "target_lang_definitions": {
                        "en": "The occurrence of a temperature below zero degrees Celsius where water turns into ice."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "of weather or temperature"
                            },
                            {
                                "target_lang_word": "be freezing",
                                "target_lang_sense_clarification": "to be below zero degrees"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b15537d2-bef2-34ce-8033-9b6d8ae95b3f",
                    "sense_definition": "door koude hard of ijskoud worden, of voedsel conserveren door het zeer koud te maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet die groenten direct <w>vriezen</w> om de vitamines goed te bewaren.",
                            "target_lang_translations": {
                                "en": "You should <w>freeze</w> those vegetables immediately to preserve the vitamins well."
                            }
                        },
                        {
                            "text": "Ik sta hier buiten te <w>vriezen</w> omdat ik mijn dikke winterjas ben vergeten.",
                            "target_lang_translations": {
                                "en": "I am <w>freezing</w> out here because I forgot my thick winter coat."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevriezen",
                        "invriezen"
                    ],
                    "common_phrases": [
                        "vers vriezen",
                        "stijf vriezen"
                    ],
                    "target_lang_definitions": {
                        "en": "To become hard or ice-cold due to cold, or to preserve food by making it very cold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "to preserve food or become solid"
                            },
                            {
                                "target_lang_word": "be freezing",
                                "target_lang_sense_clarification": "to feel extremely cold"
                            },
                            {
                                "target_lang_word": "deep-freeze",
                                "target_lang_sense_clarification": "to preserve food at very low temperatures"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}