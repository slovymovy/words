                "senses": [
                    {
                        "sense_id": "1a9ebdd7-90ec-3ce0-801a-8f9e45b6bed0",
                        "entry_id": "40bc39a4-bb40-3c4c-a698-062abd56f419",
                        "glosses": [
                            "чувствовать и проявлять к кому-либо, чему-либо глубокое уважение, почтение; почитать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb814773-3f94-4106-846f-4158e550b325",
                                "sense_id": "1a9ebdd7-90ec-3ce0-801a-8f9e45b6bed0",
                                "text": "Подумайте, что счастие человека находится в ваших руках; что не только я, но дети мои, внуки и правнуки благословят вашу память и будут её чтить как святыню…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99e16a04-eb58-45d7-8c18-1f350e4f4049",
                        "source_entry_id": "40bc39a4-bb40-3c4c-a698-062abd56f419",
                        "source_sense_id": "1a9ebdd7-90ec-3ce0-801a-8f9e45b6bed0",
                        "target_lang_word": "verehren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verehren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80d8ad1c-a2fa-3c02-8c95-ec280f944ff6",
                                        "entry_id": "a490377d-6b73-3640-8b2a-7f17dfbdeb8d",
                                        "glosses": [
                                            "jemandem mit großer Hochachtung und Bewunderung begegnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "806b8a60-8fd8-455c-a3b8-b128b830e4f2",
                                                "sense_id": "80d8ad1c-a2fa-3c02-8c95-ec280f944ff6",
                                                "text": "Ich habe Ihre Frau Mutter bereits viele Jahre heimlich verehrt, ehe ich ihr meine Gefühle offenbarte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a7f09d4-91ea-3e1b-a1fb-9a39ee520d7f",
                                        "entry_id": "a490377d-6b73-3640-8b2a-7f17dfbdeb8d",
                                        "glosses": [
                                            "jemanden (wie einen Gott) anbeten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85077fbd-6f41-49ae-bdb8-31e047ea0798",
                                                "sense_id": "4a7f09d4-91ea-3e1b-a1fb-9a39ee520d7f",
                                                "text": "„Die Erinnerung an den Exodus sperrt sich dagegen, ihn nach Art fremder Götter zu verehren, die in der Regel Herrschaftsverhältnisse absegneten.“"
                                            },
                                            {
                                                "example_id": "4a0b1a07-5935-40ae-b65e-3982ce231fcf",
                                                "sense_id": "4a7f09d4-91ea-3e1b-a1fb-9a39ee520d7f",
                                                "text": "Die Heiligen wurden verehrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8c3d54e-7ac7-330f-84fd-880762d27d5c",
                                        "entry_id": "a490377d-6b73-3640-8b2a-7f17dfbdeb8d",
                                        "glosses": [
                                            "jemandem etwas schenken"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c91dcaef-6430-49b6-93c8-32c39fe25992",
                                                "sense_id": "e8c3d54e-7ac7-330f-84fd-880762d27d5c",
                                                "text": "Darf ich Ihnen dieses Büchlein mit Gedichten verehren?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
