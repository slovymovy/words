    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8a810f5e-4917-3d9a-ba60-d5b40191af0b",
                "word": "chouse",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e02cb8ca-8b48-4e2a-b251-753368798c73",
                        "entry_id": "8a810f5e-4917-3d9a-ba60-d5b40191af0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "chouses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63f627ab-34d9-36a8-8287-795c3e3e90f2",
                        "entry_id": "8a810f5e-4917-3d9a-ba60-d5b40191af0b",
                        "glosses": [
                            "One who is easily cheated; a gullible person."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3caa9051-db6e-45b2-8e19-a8c8ec4affe5",
                                "sense_id": "63f627ab-34d9-36a8-8287-795c3e3e90f2",
                                "text": "He that with injury is griev'd,\nAnd goes to law to be reliev'd,\nIs sillier than a sottish chouse\nWho , when a thief has robb'd his house,\nApplies himself to cunning men,\nTo help him to his goods agen"
                            }
                        ]
                    },
                    {
                        "sense_id": "d650574e-8628-3c35-a090-5a5b7abbc579",
                        "entry_id": "8a810f5e-4917-3d9a-ba60-d5b40191af0b",
                        "glosses": [
                            "A trick; a sham."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2f8fd860-8159-3b21-b70c-77f7cab27bdb",
                        "entry_id": "8a810f5e-4917-3d9a-ba60-d5b40191af0b",
                        "glosses": [
                            "A swindler."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e7c5f360-4060-49c8-a553-27dab76e4fb4",
                                "sense_id": "2f8fd860-8159-3b21-b70c-77f7cab27bdb",
                                "text": "By this hand of flesh,\nWould it might never write good court-hand more,\nIf I discover . What do you think of me,\nThat I am a chouse?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
