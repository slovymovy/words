                "senses": [
                    {
                        "sense_id": "695af904-bd21-3f16-a628-7ce6678d115a",
                        "entry_id": "673d7cb1-8363-36e7-aee8-74859aa27495",
                        "glosses": [
                            "Voir disparaître les organismes vivants supérieurs à la suite de l’envahissement des algues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "138ee2aa-734c-4a56-8b31-c62722b7b09c",
                                "sense_id": "695af904-bd21-3f16-a628-7ce6678d115a",
                                "text": "Bain de canards dans une eau eutrophisée (et même dystrophisée) où foisonnent des algues bleues."
                            },
                            {
                                "example_id": "eae2e6c3-d3ee-4357-9744-1a0d008d9798",
                                "sense_id": "695af904-bd21-3f16-a628-7ce6678d115a",
                                "text": "Le Strbské pleso est bien plus dystrophisé que le lac de Popradské, situé à proximité de la limite supérieure de la forêt, d’où résulte la rareté du Tubifex tubifex dans le Strbské pleso."
                            },
                            {
                                "example_id": "b0f024d8-7892-4bb9-8c11-659db360aac9",
                                "sense_id": "695af904-bd21-3f16-a628-7ce6678d115a",
                                "text": "La productivité des lacs dystrophisés subit de profonds bouleversements."
                            }
                        ]
                    }
