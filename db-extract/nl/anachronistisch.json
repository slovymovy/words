                                "target_senses": [
                                    {
                                        "sense_id": "aebe0627-6769-3d85-9827-78470d3f8e8e",
                                        "entry_id": "34190004-4520-3821-8825-c1eb7f62115b",
                                        "glosses": [
                                            "Faux ou erroné par rapport à la chronologie ; qui est déplacé à son époque, qui est d'un autre âge. Aussi désuet, obsolète, périmé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c038c9f-9389-4e57-b0cb-547c4a924fd2",
                                                "sense_id": "aebe0627-6769-3d85-9827-78470d3f8e8e",
                                                "text": "C'est anachronique, comme la beauté."
                                            },
                                            {
                                                "example_id": "7a5c4e44-7d0d-435f-84d5-ab2a06310d54",
                                                "sense_id": "aebe0627-6769-3d85-9827-78470d3f8e8e",
                                                "text": "Tout le monde convient que le serment royal est dépassé, caduc, anachronique, surtout à l’ère de Charles III."
                                            },
                                            {
                                                "example_id": "c37ad9b9-a3ec-4185-a004-69bf51fa9c32",
                                                "sense_id": "aebe0627-6769-3d85-9827-78470d3f8e8e",
                                                "text": "Il est parfaitement anachronique d’ajouter à un dictionnaire de grec ancien une translitération du nom Popeye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
