                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7ed51610-25b1-3536-ba68-01fc07d1116b",
                        "entry_id": "f21402ea-4dde-3658-93c8-307d00ccdcc1",
                        "glosses": [
                            "A wedge-tailed eagle."
