                "senses": [
                    {
                        "sense_id": "70b971df-0dda-305b-ab6e-afdaeddd118c",
                        "entry_id": "21d286ed-023c-3784-b617-97a945984401",
                        "glosses": [
                            "het stroeve en plakkerige product van boomsappen, met name van naaldbomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d51255ce-27d4-4cf7-8f0e-bc583d0e08e9",
                                "sense_id": "70b971df-0dda-305b-ab6e-afdaeddd118c",
                                "text": "Als ze de stammen te veel verwarmden, zodat er kokend sap en hars naar buiten begon te dringen, werden de houtvezels te zacht en konden ze de bouten niet meer vastzetten, het was alsof je schroeven in een spons drukte."
                            }
                        ]
                    },
                    {
                        "sense_id": "57b875c1-2b56-3923-8aab-cf3af28e625a",
                        "entry_id": "21d286ed-023c-3784-b617-97a945984401",
                        "glosses": [
                            "een klasse van polymerisatieproducten van terpenen, met name α- en β-pineen, zoals aanwezig in [1]"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "154e8cb4-995d-352f-accf-4cba2b2be54b",
                        "entry_id": "21d286ed-023c-3784-b617-97a945984401",
                        "glosses": [
                            "een klasse van kunstmatige polymeren met vergelijkbare eigenschappen als [2]"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15fd0334-0af5-424c-8e47-fd3c8dce84ef",
                        "source_entry_id": "21d286ed-023c-3784-b617-97a945984401",
                        "source_sense_id": "70b971df-0dda-305b-ab6e-afdaeddd118c",
                        "source_sense_description": "het stroeve en plakkerige product van boomsappen, met name van naaldbomen",
                        "target_lang_word": "Harz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                        "entry_id": "2629ccbc-d030-3a44-9f0d-45a694fe9629",
                                        "glosses": [
                                            "zähflüssige, klebrige, stark duftende Absonderung von weißer bis gelbbrauner Farbe, meist aus dem Holz von Nadelbäumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a532e55-30b5-49ba-b91f-e37f6fbf0eaa",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "Gesunde Nadelbäume wehren sich gegen Schädlinge, indem sie Harz bilden."
                                            },
                                            {
                                                "example_id": "8145d04a-f387-4042-a353-a772107149dd",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "Harz von Laubbäumen klebt und riecht kaum, lässt sich nicht schmelzen, sondern verkohlt beim Erhitzen."
                                            },
                                            {
                                                "example_id": "c7b56e74-b609-405a-aa86-223e7640d99a",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "Das Forscherteam geht davon aus, dass das Spinnennetz im Harz eingeschlossen wurden, das damalige Bäume wahrscheinlich infolge eines Feuers absonderten."
                                            },
                                            {
                                                "example_id": "920b04fe-e982-4bc3-a337-f6453fff32e2",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "Dem Boden fehlte entschieden Wasser, und die angeschnittenen Tannen gaben Harz von sich, ihren Lebensbalsam."
                                            },
                                            {
                                                "example_id": "a4af386b-84a8-44d0-a316-082024eaf282",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "Eine Möglichkeit besteht darin, das Harz mit Türschlossenteiser einzusprühen. Lassen Sie das Mittel fünf Minuten lang einwirken. Dadurch wird das Harz weich."
                                            },
                                            {
                                                "example_id": "a0fb0fec-a315-4ce2-8816-53e1a8211954",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "Ebenso wirkungsvoll sei das Aufbringen von Baby- oder Speiseöl. Denn Harz ist fettlöslich."
                                            },
                                            {
                                                "example_id": "7360a635-2555-4f17-92af-a43f1001a51a",
                                                "sense_id": "59021522-af7a-3bde-a1a7-4770cd037aed",
                                                "text": "„Ich konnte das Harz der Pinien neben dem Bootshaus riechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Harz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                        "entry_id": "da83d38e-f22e-3e9f-b135-cf9bca28e497",
                                        "glosses": [
                                            "Mittelgebirge in Niedersachsen, Sachsen-Anhalt und Thüringen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1149832-c8f6-47a8-aa5d-a72415fa4de7",
                                                "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                                "text": "Im Harz finden sich viele Buchen."
                                            },
                                            {
                                                "example_id": "252042ee-7d07-408b-b2d6-20b1bc80817d",
                                                "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                                "text": "Für die höchste Auszeichnung, die ein Wanderer im Harz erlangen kann, müssen sie in ihren Heftchen allerdings noch viele, viele Stempel mit der besenreitenden Hexe sammeln, 222 insgesamt, was bedeutet, dass sie eine wochenlange Odyssee kreuz und quer durch den Harz vor sich haben, von Seesen bis Sangerhausen, von Herzberg bis Blankenburg, über den Brocken und durchs Selketal, durch Wald und Wiese."
                                            },
                                            {
                                                "example_id": "5d4650ab-01c1-459b-b760-9fef4a83b28d",
                                                "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                                "text": "Ihr Haupt- und der Stammsage nach ältestes Volk, die Semnonen, reichen von dem linken Ufer der Elbe nordöstlich vom Harz (wo wohl Grenzwald sie von den Cheruskern schied) südlich der Havel bis über die Spree."
                                            },
                                            {
                                                "example_id": "d9814294-30f4-432b-ba6f-f7c9e79918ee",
                                                "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                                "text": "„Als undurchdringlich und einsam wird der Harz in ältesten historischen Nachrichten bezeichnet.“"
                                            },
                                            {
                                                "example_id": "9d60b559-c59d-4a9e-904f-ca6b695d36cf",
                                                "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                                "text": "„In einem Treck gingen Marianne und ihre Mutter zu Fuß bis zum Harz.“"
                                            },
                                            {
                                                "example_id": "8f03ff24-da10-4ed3-b698-a3a2d5e0abeb",
                                                "sense_id": "dd269a43-b579-3c9f-b931-8096c178b41d",
                                                "text": "„Im Harz ist das Leitungswasser eher weich, im Teutoburger Wald eher hart.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2729e18e-ef3c-3f2a-ab6f-59615149d62d",
                                        "entry_id": "da83d38e-f22e-3e9f-b135-cf9bca28e497",
                                        "glosses": [
                                            "Namensbestandteil des Landkreises, Harz, Sachsen-Anhalt Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f0431e-03cb-4a52-88cc-8d550dbbb358",
                                                "sense_id": "2729e18e-ef3c-3f2a-ab6f-59615149d62d",
                                                "text": "Der Landkreis Harz wurde aus den Altlandkreisen Halberstadt, Wernigerode und Quedlinburg sowie Teilen des Altlandkreises is Aschersleben-Staßfurt gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
