                    "frequency": "Low",
                    "semantic_group_id": "element_particulier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur confiera la gestion de cette affaire à <w>quelqu'un</w> de ses adjoints."
                        },
                        {
                            "text": "Si le roi succombait dans <w>quelqu'un</w> de ces périls, le royaume serait menacé."
