                "senses": [
                    {
                        "sense_id": "83b96f8b-c7cf-3d90-9218-b0759ef76144",
                        "entry_id": "e66d9d8a-3a33-3718-9e13-f9af08cd026f",
                        "glosses": [
                            "obraźliwe, aroganckie lub niekulturalne słowa czy zachowanie skierowane wobec kogoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327c6e19-f905-455e-b3c8-f5805e36a505",
                                "sense_id": "83b96f8b-c7cf-3d90-9218-b0759ef76144",
                                "text": "Mam dość słuchania twoich impertynencji!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f03847cc-9943-4857-b1dc-6cfbfc0dc39d",
                        "source_entry_id": "e66d9d8a-3a33-3718-9e13-f9af08cd026f",
                        "source_sense_id": "83b96f8b-c7cf-3d90-9218-b0759ef76144",
                        "target_lang_word": "impertinence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impertinence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cabae79e-b9ad-32d9-857c-6a52e7f9f563",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Lack of pertinence; irrelevance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "An instance of this; a moment of being impertinent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a958ca5-1fbd-4ce6-a67f-036c21e3bce1",
                                                "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                                "text": "\"Enough, sir! \" he thundered with barely restrained fury. \"Enough, I say! Once and for all I must endeavour to rid myself of you and your impertinence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15643dfb-94ed-3a72-bd4d-90bd496fe180",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "The fact or character of being out of place; inappropriateness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Insolence; impudence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273eca85-0d82-41a7-b05c-11960ef88d0b",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "\"Because,\" interrupted the actress, \"I see things exactly as they are. I calculate my effects, but they do not deceive myself; you, on the contrary, live in a world of illusions, where every thing is called by such an exceedingly fine name, that it seems a downright impertinence to ascertain what it really is.\""
                                            },
                                            {
                                                "example_id": "06d0d651-ebae-430e-8466-3b5d770050b5",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "The musical has always had a lightness of touch, an impertinence that resembles gay humor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f74ad68f-d632-4aad-ab88-45041f9387ea",
                        "source_entry_id": "e66d9d8a-3a33-3718-9e13-f9af08cd026f",
                        "source_sense_id": "83b96f8b-c7cf-3d90-9218-b0759ef76144",
                        "target_lang_word": "impertinence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impertinence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67b7e3c8-025c-35d2-8442-47a7485cac05",
                                        "entry_id": "06816e0f-71b2-392a-8fc0-6253e7df784b",
                                        "glosses": [
                                            "Manière irrespectueuse de parler et d’agir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8f6adb-d213-4814-8bbf-1e6b2898588b",
                                                "sense_id": "67b7e3c8-025c-35d2-8442-47a7485cac05",
                                                "text": "C’est une grande misère que de n’avoir pas assez d’esprit pour bien parler, ni assez de jugement pour se taire. Voilà le principe de toute impertinence."
                                            },
                                            {
                                                "example_id": "54ed5f78-be5a-439c-9c56-a98311aaf4ed",
                                                "sense_id": "67b7e3c8-025c-35d2-8442-47a7485cac05",
                                                "text": "Voilà comme sont tous ces grands seigneurs, […], ils vous engagent à parler, vous y invitent par des compliments ; vous croyez les amuser, point du tout ! Ils vous font des impertinences, vous mettent à distance et vous jettent même à la porte sans se gêner."
                                            },
                                            {
                                                "example_id": "47a8dfdc-74f0-40c0-9d31-90d9afdb4958",
                                                "sense_id": "67b7e3c8-025c-35d2-8442-47a7485cac05",
                                                "text": "— Monseigneur, dit-il, nous venons vous demander mille pardons de l’impertinence de ce peuple, qui ne cesse de crier qu’il veut la mort de votre ennemi, et qu’il voudrait même vous voir Régent si nous avions le malheur de perdre sa majesté."
                                            },
                                            {
                                                "example_id": "d0d99ee6-5ca4-4607-bac1-f48d8c1669d4",
                                                "sense_id": "67b7e3c8-025c-35d2-8442-47a7485cac05",
                                                "text": "Les Sophistes ont risqué, au Vᵉ siècle, sans être autrement molestés, les plus graves impertinences, telle que celle-ci : la religion n'est qu'un mensonge utile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e55c164-8036-38b1-bab1-5e876594090f",
                                        "entry_id": "06816e0f-71b2-392a-8fc0-6253e7df784b",
                                        "glosses": [
                                            "Manière de parler et d’agir contre les bienséances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d119d2-6839-43fc-8c63-df91839270c4",
                                                "sense_id": "2e55c164-8036-38b1-bab1-5e876594090f",
                                                "text": "Dire des impertinences. - S’exprimer avec impertinence."
                                            },
                                            {
                                                "example_id": "fb37569f-d62a-4321-8a82-b8907bef28f9",
                                                "sense_id": "2e55c164-8036-38b1-bab1-5e876594090f",
                                                "text": "Il y eut assez de hauteur, d’impertinence, et même de menaces dans ses premières paroles pour que je lui fisse comprendre que j’étais chez moi et que je n’avais de compte à lui rendre de ma vie qu’à cause de la sincère affection que j’avais pour son fils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb0112e6-564a-3e50-bffd-802f62f60036",
                                        "entry_id": "06816e0f-71b2-392a-8fc0-6253e7df784b",
                                        "glosses": [
                                            "Ce qui n’a rien de commun avec la chose dont il s’agit ; caractère de ce qui n'est pas pertinent."
                                        ],
                                        "tags": [
                                            "Autrefois"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
