                ],
                "senses": [
                    {
                        "sense_id": "dccc7d7b-2bba-379a-a0dd-be163083eef6",
                        "entry_id": "9cb38c22-5d4b-3222-8320-28375b241203",
                        "glosses": [
                            "beëindigd, wat voorbij is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdcfcbf5-5b75-47e6-90bf-b6d8fa812057",
                                "sense_id": "dccc7d7b-2bba-379a-a0dd-be163083eef6",
                                "text": "'Vroeger had ik een mannetje in dienst om het verkeer op de parkeerplaats te regelen. Moet je nu zien!', zucht patron Thierry Gleize (49). 'Moeilijk, moeilijk... binnen tien jaar is het hier afgelopen.'"
                            },
                            {
                                "example_id": "df46a682-06f0-449e-887d-e7354cf421b3",
                                "sense_id": "dccc7d7b-2bba-379a-a0dd-be163083eef6",
                                "text": "Afgelopen kun je alleen gebruiken tegen het einde van de desbetreffende periode."
                            },
                            {
                                "example_id": "4a8ab413-f7b7-45e0-b5a3-7d54176339d8",
                                "sense_id": "dccc7d7b-2bba-379a-a0dd-be163083eef6",
                                "text": "\"Nooit in de afgelopen decennia heeft een Amerikaanse president zo'n boze, vernietigende aanval gedaan op een buitenlandse leider die op bezoek was in het Witte Huis\", schrijft Peter Baker."
                            },
                            {
                                "example_id": "c7fcbae2-5ff6-4c61-a745-b960dc9d832b",
                                "sense_id": "dccc7d7b-2bba-379a-a0dd-be163083eef6",
                                "text": "Criminoloog Wouter Buikhuisen is afgelopen dinsdag op 91-jarige leeftijd overleden. Buikhuisen is onder meer bekend van de affaire Buikhuisen. Ook muntte hij de naam provo voor de Provobeweging in Amsterdam, een protestbeweging die in de jaren 60 werd opgericht."
                            }
                        ]
                    }
                ],
