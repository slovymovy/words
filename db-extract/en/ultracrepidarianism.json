    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "83122c30-81bf-3ba8-b355-a9f3227e9229",
                "word": "ultracrepidarianism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8ca4759-8b63-3656-8565-1686c5f9dfdf",
                        "entry_id": "83122c30-81bf-3ba8-b355-a9f3227e9229",
                        "glosses": [
                            "The habit or act of giving opinions on matters outside the scope of one's knowledge."
                        ],
                        "tags": [
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1308c58d-b921-44c5-9b3e-f5e3e5918d62",
                                "sense_id": "d8ca4759-8b63-3656-8565-1686c5f9dfdf",
                                "text": "The other is for the Gatt to steer off its slippery slope toward ultracrepidarianism and avoid any interference with national environmental policies, so long as they are not protectionist."
                            },
                            {
                                "example_id": "fb38df8a-9d41-4bb2-a99f-dc1b50d53a9b",
                                "sense_id": "d8ca4759-8b63-3656-8565-1686c5f9dfdf",
                                "text": "Unfortunately, people who are competent in some areas of security sometimes overestimate their own competence in other areas, and viruses seem to attract a particularly virulent brand of ultracrepidarianism (“acting or speaking outside one's ability or knowledge”)."
                            },
                            {
                                "example_id": "fe0f081a-ba27-46cc-b518-62e28b19c1ba",
                                "sense_id": "d8ca4759-8b63-3656-8565-1686c5f9dfdf",
                                "text": "The unabashed ultracrepidarianism evident in most mainstream philosophers' use and abuse of \"postmodernism\" is itself provocative."
                            }
                        ]
                    }
                ],
