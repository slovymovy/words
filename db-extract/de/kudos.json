                "senses": [
                    {
                        "sense_id": "57256455-8303-31ad-8d50-3f34a274e72f",
                        "entry_id": "9b2a458b-6b58-3a79-ba5b-12906596a852",
                        "glosses": [
                            "lobende Würdigung"
                        ],
                        "tags": [
                            "Internetslang"
                        ],
                        "examples": [
                            {
                                "example_id": "adb7e757-80e6-4241-af29-4f27e8008455",
                                "sense_id": "57256455-8303-31ad-8d50-3f34a274e72f",
                                "text": "Kudos an den Herrn in der ersten Reihe für die Auswahl der perfekten Krawatte!"
                            },
                            {
                                "example_id": "d156772d-f725-409d-9df2-5299077664fc",
                                "sense_id": "57256455-8303-31ad-8d50-3f34a274e72f",
                                "text": "„Also ehrlich gesagt waren wir ganz aus dem Häuschen. Respekt und Kudos an Obama!“"
                            },
                            {
                                "example_id": "426da7e0-3492-44ae-9ccb-bf6fb260a3ac",
                                "sense_id": "57256455-8303-31ad-8d50-3f34a274e72f",
                                "text": "„Für mich ist das ein dicker Pluspunkt, es ist mittlerweile selten geworden, dass mich eine deutsche Synchronisation so packt. Kudos an die Sprecher.“"
                            },
                            {
                                "example_id": "6b4f0fc3-d484-49b5-8def-769001403632",
                                "sense_id": "57256455-8303-31ad-8d50-3f34a274e72f",
                                "text": "„Weniger Kudos gibt es für den Rest der Technik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3affe7c5-4e80-4fd1-8095-6b5f3ccb571b",
                        "source_entry_id": "9b2a458b-6b58-3a79-ba5b-12906596a852",
                        "source_sense_id": "57256455-8303-31ad-8d50-3f34a274e72f",
