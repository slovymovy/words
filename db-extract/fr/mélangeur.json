        "fr-extract.jsonl": [
            {
                "entry_id": "299073fb-770f-38d0-84c0-0a3fd86db09c",
                "word": "mélangeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fd8df2eb-f646-4002-bca6-a1f67f1bb7d4",
                        "entry_id": "299073fb-770f-38d0-84c0-0a3fd86db09c",
                        "tags": [
                            "plural"
                        ],
                        "form": "mélangeurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1585cfa-f876-34c7-8ccc-65b1dcd19f34",
                        "entry_id": "299073fb-770f-38d0-84c0-0a3fd86db09c",
                        "glosses": [
                            "Machine, mécanisme qui assure un mélange homogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3eba57a-9445-4ae7-a749-6d6c0dd68ee0",
                                "sense_id": "e1585cfa-f876-34c7-8ccc-65b1dcd19f34",
                                "text": "Mécalynox réalise des mélangeurs inox pour le nucléaire, la chimie, pharmacie et l’agro-alimentaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd83ed79-9389-386e-97f0-7ee31be7e1e6",
                        "entry_id": "299073fb-770f-38d0-84c0-0a3fd86db09c",
                        "glosses": [
                            "Machine, mécanisme qui assure un mélange homogène.",
                            "Ensemble de deux robinets couplés, un pour l'eau chaude, l'autre pour l'eau froide, qui ensuite sont mélangées pour ressortir par un seul orifice. (Note : le mélangeur et le mitigeur sont deux types de robinets différents)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "265a8c98-d5c0-4e71-8e27-5dd747c4d19d",
                                "sense_id": "fd83ed79-9389-386e-97f0-7ee31be7e1e6",
                                "text": "Un vieux mélangeur sur un lavabo (ou un plan de toilette) peut présenter deux inconvénients …."
                            }
                        ]
                    },
                    {
                        "sense_id": "36f5f1f9-7daa-3523-b186-bba79be50a2e",
                        "entry_id": "299073fb-770f-38d0-84c0-0a3fd86db09c",
                        "glosses": [
                            "Appareil qui sert à mélanger et réduire des aliments en purée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39df026-f5db-4b30-b179-2dad0adfab3d",
                                "sense_id": "36f5f1f9-7daa-3523-b186-bba79be50a2e",
                                "text": "Quand je prépare un smoothie, les glaçons et les fruits congelés ont tendance à se coincer dans le mélangeur. Comment faire pour régler le problème ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7118ba61-91d9-4f8a-86a0-a610fe6d2225",
                        "source_entry_id": "299073fb-770f-38d0-84c0-0a3fd86db09c",
                        "source_sense_id": "e1585cfa-f876-34c7-8ccc-65b1dcd19f34",
                        "source_sense_description": "Machine",
                        "target_lang_word": "mixer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mixer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42b0ba8b-6aff-35ec-94fa-47f8f4eb7ff2",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "One who, or a device that, mixes or merges things together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13190a51-80d1-31b4-a33f-06905f737e7f",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "One who mixes or socializes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd9a7ce0-ede3-481e-8b22-4412ad216f20",
                                                "sense_id": "13190a51-80d1-31b4-a33f-06905f737e7f",
                                                "text": "I had seen so many people all my life—I was an average mixer, but more than average in a tendency to identify myself, my ideas, my destiny with those of all classes that I came in contact with."
                                            },
                                            {
                                                "example_id": "cd908616-2805-4ae0-9633-ef64b65fa853",
                                                "sense_id": "13190a51-80d1-31b4-a33f-06905f737e7f",
                                                "text": "Bad mixer as he was, he preferred to be \"out of it\" in a crowd than out of it altogether."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45aaf91-b14c-36e6-8043-e1130634d671",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A machine outfitted with (typically blunt) blades with which it mixes or beats ingredients in a bowl below."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "382d4b2f-2448-385a-a58f-a40772d21d4d",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A nonalcoholic drink (such as lemonade, Coca-Cola or fruit juice) that is added to spirits to make cocktails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7801a312-75c3-48d6-919c-9100350795da",
                                                "sense_id": "382d4b2f-2448-385a-a58f-a40772d21d4d",
                                                "text": "Do we have any mixers? I don't want to drink this vodka neat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043b1643-b73e-3875-9a03-97e83d1457f5",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A mixing console."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01e439bc-b384-3cca-9d6b-d1ff7598ad0d",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A dance or other social event meant to foster new acquaintances, as at the beginning of a school year."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "446a8bf6-892c-4055-88e0-6ea355bbc302",
                                                "sense_id": "01e439bc-b384-3cca-9d6b-d1ff7598ad0d",
                                                "text": "To encourage those IRL meetings, Thursday hosts events in London and New York, the two cities where it is up and running; the mixer at Hair of the Dog was its eighth in this city and drew a crowd of about 450."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05725095-6742-3bb4-8475-c0102cfbd8ba",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "Any of various social dances involving frequent changes of partners."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e74e27fd-3cf5-33c7-8490-dc67fe6a3de4",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A device for combining hot and cold water before it emerges from a single spout or shower head."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c701ea2-2a78-3abc-b2df-f291e59a45e2",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A nonlinear electrical circuit that creates new frequencies from two signals applied to it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad7233ea-3053-3c73-b463-b1e53e641089",
                                        "entry_id": "e81c7393-a3c1-3adf-8f7d-0da2cb65d736",
                                        "glosses": [
                                            "A chiropractor who uses other treatments in addition to spinal adjustment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9e36cc3-7acb-3f4b-a6ad-1a32b2e9035e",
