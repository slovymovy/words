{
    "word_family": [
        "humid",
        "humidify",
        "humidifier",
        "dehumidify",
        "dehumidifier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc5d065d-d40e-3dc9-9e22-98c81505613a",
                    "sense_definition": "The amount of water vapor present in the air.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moisture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather report said the relative <w>humidity</w> would reach ninety percent today.",
                            "target_lang_translations": {
                                "ru": "В прогнозе погоды говорилось, что относительная <w>влажность</w> сегодня достигнет девяноста процентов."
                            }
                        },
                        {
                            "text": "Tropical plants in the greenhouse thrive in constant <w>humidity</w> and warm temperatures.",
                            "target_lang_translations": {
                                "ru": "Тропические растения в оранжерее процветают в условиях постоянной <w>влажности</w> и теплых температур."
                            }
                        }
                    ],
                    "synonyms": [
                        "moisture",
                        "mugginess"
                    ],
                    "antonyms": [
                        "aridity",
                        "dryness"
                    ],
                    "common_phrases": [
                        "relative humidity",
                        "high humidity",
                        "low humidity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество водяного пара, содержащегося в воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влажность",
                                "target_lang_sense_clarification": "показатель содержания влаги в воздухе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "189972ed-1c9c-3396-9408-ce3fedd4cb70",
                    "sense_definition": "A state of dampness or moisture, especially in the atmosphere, that makes conditions feel uncomfortable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moisture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high <w>humidity</w> made the air feel sticky and hot during our walk.",
                            "target_lang_translations": {
                                "ru": "Из-за высокой <w>влажности</w> воздух во время нашей прогулки казался липким и жарким."
                            }
                        },
                        {
                            "text": "I cannot stand the oppressive <w>humidity</w> in this city during the summer months.",
                            "target_lang_translations": {
                                "ru": "Я не выношу гнетущую <w>влажность</w> в этом городе в летние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "dampness",
                        "clamminess"
                    ],
                    "antonyms": [
                        "dryness"
                    ],
                    "common_phrases": [
                        "oppressive humidity",
                        "stifling humidity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сырости или влаги, особенно в атмосфере, которое делает условия некомфортными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влажность",
                                "target_lang_sense_clarification": "сырость воздуха"
                            },
                            {
                                "target_lang_word": "сырость",
                                "target_lang_sense_clarification": "неприятная влага"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}