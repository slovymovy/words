                ],
                "senses": [
                    {
                        "sense_id": "14e56fd1-d55c-32e4-bdff-d2e25a5ac47a",
                        "entry_id": "84bea6f5-000f-3747-8be1-f4536d34daeb",
                        "glosses": [
                            "The property of being sluggish, unable or unwilling to act quickly."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "189dad7c-26bd-3929-a27a-bf6c4fdb8ec6",
                        "entry_id": "84bea6f5-000f-3747-8be1-f4536d34daeb",
                        "glosses": [
                            "The state of economic decline, inactivity, slow or subnormal growth."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e34fd668-1f55-4106-a82e-4cc2b42cbaba",
                                "sense_id": "189dad7c-26bd-3929-a27a-bf6c4fdb8ec6",
                                "text": "And we see such interdependence even more clearly in their economic performance: China’s annual GDP growth rate, for example, will slow by two percentage points this year, owing to sluggishness in the United States and the EU."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26e5b73a-0470-4144-a962-605263c3b4e4",
                        "source_entry_id": "84bea6f5-000f-3747-8be1-f4536d34daeb",
                        "source_sense_description": "the property of being sluggish",
                        "target_lang_word": "traag",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traag",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f67cdf07-c481-3a76-b854-86443dcf157b",
                                        "entry_id": "897cda23-bc84-3c00-93a1-45207a09afd1",
                                        "glosses": [
                                            "met geringe snelheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb64a56e-2d1e-40ea-a304-39de803bd812",
                                                "sense_id": "f67cdf07-c481-3a76-b854-86443dcf157b",
                                                "text": "Een trage beweging"
                                            },
                                            {
                                                "example_id": "5a20ea24-06bd-4988-a514-5e414beed7ef",
                                                "sense_id": "f67cdf07-c481-3a76-b854-86443dcf157b",
                                                "text": "Piraterij en avontuur, terwijl Frans en Maren achterbleven tussen mahoniehouten meubels en verstikkende wandtapijten, traag stromende grachten en beierende klokken die hen naar de kerk riepen."
                                            },
                                            {
                                                "example_id": "899ce356-d9d1-4ba0-83b7-56d55a91b59b",
                                                "sense_id": "f67cdf07-c481-3a76-b854-86443dcf157b",
                                                "text": "Wanneer we dichterbij komen, komt hij traag overeind en gaat opzij, waarbij hij met zijn achterlijf over de gladgesleten kinderkopjes schuift."
                                            },
                                            {
                                                "example_id": "7eaf86c6-033d-4121-ae7d-7dafd9e3c5d6",
                                                "sense_id": "f67cdf07-c481-3a76-b854-86443dcf157b",
                                                "text": "‘Van Gooooo,’ klonk een tijdje later het trage zuidelijke Tennessee accent van Pogue, ‘Is er daar water?’ Ik knikte en wees naar beneden in de richting van de groene plas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc7f20a-775a-34b8-9cfb-1b66554b3299",
                                        "entry_id": "897cda23-bc84-3c00-93a1-45207a09afd1",
                                        "glosses": [
                                            "niet snel reagerend"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee606a18-8822-4bb4-ae3e-76428f520b0f",
                                                "sense_id": "9cc7f20a-775a-34b8-9cfb-1b66554b3299",
                                                "text": "Albert Maillard. Hij was een slanke jongen met een enigszins traag, bescheiden karakter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
