{
    "word_family": [
        "проектировать",
        "спроектировать",
        "проектирование",
        "проектировщик",
        "проектный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5c3e3b4-f7c2-3c60-9a80-5dc7dfd8a1ce",
                    "sense_definition": "Запланированное дело, мероприятие или инициатива, направленные на достижение определённой цели в рамках заданного времени и бюджета.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наша команда успешно завершила этот сложный <w>проект</w> раньше установленного срока.",
                            "target_lang_translations": {
                                "en": "Our team successfully completed this complex <w>project</w> ahead of schedule.",
                                "zh": "我们的团队在截止日期前成功完成了这个复杂的<w>项目</w>。"
                            }
                        },
                        {
                            "text": "Студенты должны подготовить совместный <w>проект</w> по истории к концу семестра.",
                            "target_lang_translations": {
                                "en": "Students must prepare a joint history <w>project</w> by the end of the semester.",
                                "zh": "学生们必须在学期末前准备好一份历史合作<w>项目</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "предприятие",
                        "инициатива",
                        "план"
                    ],
                    "common_phrases": [
                        "новый проект",
                        "руководитель проекта",
                        "участвовать в проекте",
                        "сдать проект"
                    ],
                    "target_lang_definitions": {
                        "en": "A planned piece of work or enterprise with a specific goal, timeframe, and budget.",
                        "zh": "指为实现特定目标，在规定时间和预算内进行的有计划的工作或活动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "project",
                                "target_lang_sense_clarification": "undertaking"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "项目",
                                "target_lang_sense_clarification": "指一项有计划的任务或事业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff5c765b-9a70-3e6a-8155-7ae563010da2",
                    "sense_definition": "Разработанный план сооружения, устройства или конструкции, представленный в виде чертежей, схем и расчётов.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Архитектор показал нам готовый <w>проект</w> загородного дома с большим садом.",
                            "target_lang_translations": {
                                "en": "The architect showed us the finished <w>design</w> of a country house with a large garden.",
                                "zh": "建筑师向我们展示了带大花园的郊区住宅的成品<w>设计</w>。"
                            }
                        },
                        {
                            "text": "Инженеры долго обсуждали технический <w>проект</w> нового моста через широкую реку.",
                            "target_lang_translations": {
                                "en": "The engineers discussed the technical <w>design</w> of the new bridge across the wide river for a long time.",
                                "zh": "工程师们讨论了很久关于横跨宽阔河流的新桥梁技术<w>方案</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "план"
                    ],
                    "common_phrases": [
                        "проект здания",
                        "архитектурный проект",
                        "утвердить проект",
                        "разработка проекта"
                    ],
                    "target_lang_definitions": {
                        "en": "A detailed plan, drawing, or set of calculations for a structure or device.",
                        "zh": "指为建筑物、设备或结构制定的详细计划、图纸或计算方案。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "design",
                                "target_lang_sense_clarification": "architectural or technical"
                            },
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "drawing/layout"
                            },
                            {
                                "target_lang_word": "blueprint",
                                "target_lang_sense_clarification": "technical drawing"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "设计",
                                "target_lang_sense_clarification": "指建筑或技术层面的构思与规划"
                            },
                            {
                                "target_lang_word": "方案",
                                "target_lang_sense_clarification": "指具体的实施计划或设计蓝图"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c98976e1-48ad-3747-b956-5517a52230af",
                    "sense_definition": "Предварительный текст документа, закона или договора, который ещё не утверждён окончательно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Депутаты рассмотрели <w>проект</w> закона о защите окружающей среды в первом чтении.",
                            "target_lang_translations": {
                                "en": "The deputies considered the <w>draft</w> law on environmental protection in the first reading.",
                                "zh": "议员们在一读中审议了环境保护法<w>草案</w>。"
                            }
                        },
                        {
                            "text": "Юрист отправил мне на электронную почту <w>проект</w> договора для ознакомления и правок.",
                            "target_lang_translations": {
                                "en": "The lawyer emailed me the <w>draft</w> contract for review and edits.",
                                "zh": "律师把合同<w>草稿</w>发到了我的电子邮箱，供我审阅和修改。"
                            }
                        }
                    ],
                    "synonyms": [
                        "черновик",
                        "набросок"
                    ],
                    "common_phrases": [
                        "проект закона",
                        "проект договора",
                        "проект решения",
                        "согласовать проект"
                    ],
                    "target_lang_definitions": {
                        "en": "A preliminary version of a document, law, or agreement that has not yet been finalized.",
                        "zh": "指文件、法律或合同尚未最终确定的初步版本。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "draft",
                                "target_lang_sense_clarification": "document/law"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草案",
                                "target_lang_sense_clarification": "指法律或文件的初步稿件"
                            },
                            {
                                "target_lang_word": "草稿",
                                "target_lang_sense_clarification": "指尚未定稿的文书"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b820c6a8-762f-3efb-9008-6471b7eddee9",
                    "sense_definition": "Замысел, идея или намерение что-либо сделать (часто используется в контексте планов на будущее).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него в голове постоянно рождаются фантастические <w>проекты</w>, но он редко доводит их до конца.",
                            "target_lang_translations": {
                                "en": "Fantastic <w>schemes</w> are constantly born in his head, but he rarely follows through with them.",
                                "zh": "他脑子里总是冒出各种奇妙的<w>构想</w>，但他很少能坚持到底。"
                            }
                        },
                        {
                            "text": "Мы обсуждали этот смелый <w>проект</w> весь вечер, но так и не решились начать действовать.",
                            "target_lang_translations": {
                                "en": "We discussed this bold <w>plan</w> all evening but never decided to take action.",
                                "zh": "我们整晚都在讨论这个大胆的<w>计划</w>，但最终还是没下定决心开始行动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "замысел",
                        "задумка",
                        "намерение",
                        "прожект"
                    ],
                    "common_phrases": [
                        "строить проекты",
                        "смелый проект",
                        "дерзкий проект"
                    ],
                    "target_lang_definitions": {
                        "en": "A conception, idea, or intention to do something, often referring to future plans.",
                        "zh": "指做某事的构想、主意或意图，常用于未来的计划。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scheme",
                                "target_lang_sense_clarification": "idea/plan"
                            },
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "intention"
                            },
                            {
                                "target_lang_word": "design",
                                "target_lang_sense_clarification": "intent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计划",
                                "target_lang_sense_clarification": "指打算做某事的意图"
                            },
                            {
                                "target_lang_word": "构想",
                                "target_lang_sense_clarification": "指脑海中的初步设想"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}