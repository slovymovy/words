                    {
                        "translation_id": "528b02ea-70c8-4dd9-b1d6-50094bdf4d52",
                        "source_entry_id": "a8b06c6f-cdab-3ef1-b834-2766d564313f",
                        "source_sense_id": "59ecf184-8023-35f0-9a0e-d2546ec78427",
                        "source_sense_description": "compensating someone for an expense",
                        "target_lang_word": "remboursement",
