{
    "word_family": [
        "aider",
        "unaided"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e5a1c9a-5aaa-36f4-9342-b5d310fcd9f0",
                    "sense_definition": "Help, assistance, or support given to someone in need.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assistance_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He came to my <w>aid</w> when I was in trouble.",
                            "target_lang_translations": {
                                "ru": "Он пришел мне на <w>помощь</w>, когда я был в беде.",
                                "zh": "我遇到麻烦时，他来<w>帮助</w>我了。"
                            }
                        },
                        {
                            "text": "The organization provides humanitarian <w>aid</w> to war-torn countries.",
                            "target_lang_translations": {
                                "ru": "Организация предоставляет гуманитарную <w>помощь</w> странам, пострадавшим от войны.",
                                "zh": "该组织向饱受战乱的国家提供人道主义<w>援助</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "help",
                        "support",
                        "succor",
                        "assistance",
                        "relief"
                    ],
                    "antonyms": [
                        "hindrance",
                        "impediment"
                    ],
                    "common_phrases": [
                        "first aid",
                        "legal aid",
                        "foreign aid",
                        "come to someone's aid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помощь, содействие или поддержка, оказываемая нуждающемуся.",
                        "zh": "给予有需要的人帮助、援助或支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помощь",
                                "target_lang_sense_clarification": "основное значение; содействие в чем-либо"
                            },
                            {
                                "target_lang_word": "поддержка",
                                "target_lang_sense_clarification": "опора, помощь в трудную минуту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帮助",
                                "target_lang_sense_clarification": "一般性的帮助或支持"
                            },
                            {
                                "target_lang_word": "援助",
                                "target_lang_sense_clarification": "较正式，多用于国家、组织提供的帮助"
                            },
                            {
                                "target_lang_word": "救助",
                                "target_lang_sense_clarification": "紧急或困难情境中的帮助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a217792-3cdb-3618-aae5-1c78ac34a3b7",
                    "sense_definition": "An object, device, or resource that helps someone do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assistance_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather uses a hearing <w>aid</w> to listen to the radio.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка использует слуховой <w>аппарат</w>, чтобы слушать радио.",
                                "zh": "我爷爷用<w>助听器</w>听收音机。"
                            }
                        },
                        {
                            "text": "The teacher used a visual <w>aid</w> to explain the complex topic.",
                            "target_lang_translations": {
                                "ru": "Учитель использовал наглядное <w>пособие</w>, чтобы объяснить сложную тему.",
                                "zh": "老师用视觉<w>辅助材料</w>来解释这个复杂的话题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hearing aid",
                        "visual aid",
                        "teaching aid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, устройство или ресурс, помогающий кому-либо что-либо делать.",
                        "zh": "帮助某人做某事的物品、设备或资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пособие",
                                "target_lang_sense_clarification": "учебный материал (напр. наглядное пособие)"
                            },
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "инструмент или ресурс для достижения цели"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "техническое устройство (напр. слуховой аппарат)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅助工具",
                                "target_lang_sense_clarification": "泛指帮助人完成某事的工具或材料"
                            },
                            {
                                "target_lang_word": "辅助设备",
                                "target_lang_sense_clarification": "强调设备、器材"
                            },
                            {
                                "target_lang_word": "辅助材料",
                                "target_lang_sense_clarification": "教学或说明时使用的辅助材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "191d8c98-71bc-3ce2-8365-8f2c72154333",
                    "sense_definition": "A person who helps or assists; a helper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assistance_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She acted as a loyal <w>aid</w> to the director during the project.",
                            "target_lang_translations": {
                                "ru": "Она была верным <w>помощником</w> директора во время проекта.",
                                "zh": "项目期间，她一直是主任忠实的<w>助手</w>。"
                            }
                        },
                        {
                            "text": "The general called for his trusted <w>aid</w> to deliver the message.",
                            "target_lang_translations": {
                                "ru": "Генерал позвал своего доверенного <w>адъютанта</w>, чтобы передать сообщение.",
                                "zh": "将军叫来他信任的<w>副官</w>去传达消息。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "modern usage typically prefers 'aide' for a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который помогает или ассистирует; помощник.",
                        "zh": "帮助别人、协助工作的人；帮手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помощник",
                                "target_lang_sense_clarification": "тот, кто помогает в работе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "助手",
                                "target_lang_sense_clarification": "一般指帮助他人工作的人"
                            },
                            {
                                "target_lang_word": "副官",
                                "target_lang_sense_clarification": "尤其指军职或要人的随员助手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bad3ce9-7a7b-3de7-9eb8-dbe5c7013585",
                    "sense_definition": "Alternative spelling of aide (an assistant to an important person, especially a military officer).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assistance_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator's <w>aid</w> prepared the briefing documents.",
                            "target_lang_translations": {
                                "ru": "<w>Помощник</w> сенатора подготовил документы для брифинга.",
                                "zh": "参议员的<w>助手</w>准备了简报文件。"
                            }
                        },
                        {
                            "text": "He served as an <w>aid</w> to the commander for three years.",
                            "target_lang_translations": {
                                "ru": "Он служил <w>адъютантом</w> у командира в течение трех лет.",
                                "zh": "他给指挥官当了三年<w>副官</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of aide"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативное написание слова aide (помощник важного лица, особенно военного офицера).",
                        "zh": "aide 的另一种拼写，指重要人物的助手，尤其是军官的副官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помощник",
                                "target_lang_sense_clarification": "должностное лицо"
                            },
                            {
                                "target_lang_word": "адъютант",
                                "target_lang_sense_clarification": "военный помощник командира"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "助手",
                                "target_lang_sense_clarification": "要人或官员的助手"
                            },
                            {
                                "target_lang_word": "副官",
                                "target_lang_sense_clarification": "军队中指挥官的助手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fed27687-2e2e-315b-aab3-e37a7325714a",
                    "sense_definition": "The rider's use of hands, legs, or voice to control and signal a horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equestrian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider used a subtle leg <w>aid</w> to ask the horse to canter.",
                            "target_lang_translations": {
                                "ru": "Всадник использовал легкий <w>посыл</w> ногой, чтобы перевести лошадь в галоп.",
                                "zh": "骑手轻轻用腿发出<w>扶助</w>，示意马开始慢跑。"
                            }
                        },
                        {
                            "text": "Good communication with the horse requires precise and gentle <w>aids</w>.",
                            "target_lang_translations": {
                                "ru": "Хорошее общение с лошадью требует точных и мягких <w>средств управления</w>.",
                                "zh": "要想和马良好沟通，需要精准而轻柔的<w>扶助</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "equestrian terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование всадником рук, ног или голоса для управления лошадью и подачи сигналов.",
                        "zh": "马术中，骑手用手、腿或声音来控制马并向马发出信号的动作或方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средства управления",
                                "target_lang_sense_clarification": "термин в верховой езде"
                            },
                            {
                                "target_lang_word": "посыл",
                                "target_lang_sense_clarification": "команда лошади движением тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扶助",
                                "target_lang_sense_clarification": "马术术语，指骑手通过手、腿、声音等发出的控制信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "020b9f8c-40dd-3348-95b8-721ab2324e3b",
                    "sense_definition": "A historical subsidy granted to the crown by Parliament for a specific purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king requested a new <w>aid</w> to fund the ongoing war.",
                            "target_lang_translations": {
                                "ru": "Король запросил новую <w>субсидию</w> для финансирования продолжающейся войны.",
                                "zh": "国王请求一笔新的<w>补助金</w>来资助这场持续的战争。"
                            }
                        },
                        {
                            "text": "Parliament debated the granting of an <w>aid</w> for the royal defense.",
                            "target_lang_translations": {
                                "ru": "Парламент обсуждал предоставление <w>вспомоществования</w> для королевской обороны.",
                                "zh": "议会就是否拨给王室防务一笔<w>补助金</w>展开了讨论。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Историческая субсидия, предоставляемая короне парламентом для определенной цели.",
                        "zh": "历史上由议会为特定用途拨给王室的一种补助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспомоществование",
                                "target_lang_sense_clarification": "устаревший термин для денежной помощи"
                            },
                            {
                                "target_lang_word": "субсидия",
                                "target_lang_sense_clarification": "финансовая поддержка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补助金",
                                "target_lang_sense_clarification": "历史语境中由议会拨给王室的财政资助"
                            },
                            {
                                "target_lang_word": "特别补助",
                                "target_lang_sense_clarification": "较正式的历史财政用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "562cb564-9a5d-34a1-a985-a112a6260373",
                    "sense_definition": "Initialism of artificial insemination by donor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple discussed the possibility of using <w>AID</w> to start their family.",
                            "target_lang_translations": {
                                "ru": "Пара обсуждала возможность использования <w>ИИД</w> для создания семьи.",
                                "zh": "这对夫妻讨论了通过<w>供精人工授精</w>组建家庭的可能性。"
                            }
                        },
                        {
                            "text": "Medical ethics regarding <w>AID</w> have evolved over the decades.",
                            "target_lang_translations": {
                                "ru": "Медицинская этика в отношении <w>ИИД</w> эволюционировала на протяжении десятилетий.",
                                "zh": "与<w>供精人工授精</w>相关的医学伦理在过去几十年里不断演变。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "medical initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"искусственная инсеминация донором\".",
                        "zh": "“供精人工授精”的首字母缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ИИД",
                                "target_lang_sense_clarification": "медицинская аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "供精人工授精",
                                "target_lang_sense_clarification": "医学术语，指由捐精者提供精液进行的人工授精"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20064fc0-a00b-3ff6-a4bb-75dc53a0e133",
                    "sense_definition": "To provide support, help, or assistance to someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assistance_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software is designed to <w>aid</w> in project management.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение разработано, чтобы <w>помогать</w> в управлении проектами.",
                                "zh": "这款新软件旨在<w>帮助</w>进行项目管理。"
                            }
                        },
                        {
                            "text": "Several volunteers arrived to <w>aid</w> the victims of the flood.",
                            "target_lang_translations": {
                                "ru": "Несколько волонтеров прибыли, чтобы <w>оказать помощь</w> жертвам наводнения.",
                                "zh": "几名志愿者赶来<w>援助</w>洪灾受害者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "help",
                        "assist",
                        "support",
                        "serve",
                        "succor",
                        "promote",
                        "sustain"
                    ],
                    "antonyms": [
                        "hinder"
                    ],
                    "common_phrases": [
                        "aid in",
                        "aid recovery",
                        "aid development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать поддержку, помощь или содействие кому-либо или чему-либо.",
                        "zh": "向某人或某事提供支持、帮助或援助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помогать",
                                "target_lang_sense_clarification": "содействовать в чем-либо"
                            },
                            {
                                "target_lang_word": "оказывать помощь",
                                "target_lang_sense_clarification": "более формальный вариант"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "способствовать успеху или развитию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帮助",
                                "target_lang_sense_clarification": "一般性的帮助、协助"
                            },
                            {
                                "target_lang_word": "援助",
                                "target_lang_sense_clarification": "较正式，常用于救援或机构语境"
                            },
                            {
                                "target_lang_word": "促进",
                                "target_lang_sense_clarification": "强调促进某事发展或进行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6521658c-cd66-3341-b8b8-977199d06b74",
                    "sense_definition": "To climb a rock face using artificial aids such as pitons or ladders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>aid</w> the difficult section of the cliff rather than free climb it.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>пройти с использованием ИТО</w> сложный участок скалы, а не лезть свободным лазанием.",
                                "zh": "他们决定对那段难爬的岩壁进行<w>借助器械攀登</w>，而不是自由攀登。"
                            }
                        },
                        {
                            "text": "The mountaineers <w>aided</w> their way up the sheer granite wall.",
                            "target_lang_translations": {
                                "ru": "Альпинисты <w>поднимались на ИТО</w> по отвесной гранитной стене.",
                                "zh": "登山者们<w>借助器械攀登</w>，上了这面陡直的花岗岩壁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "climbing jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься по скале, используя искусственные приспособления, такие как крючья или лестницы.",
                        "zh": "攀岩时借助岩钉、梯子等人工器械进行攀登。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать ИТО",
                                "target_lang_sense_clarification": "альпинистский жаргон (искусственные точки опоры)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "借助器械攀登",
                                "target_lang_sense_clarification": "登山中借助岩钉、梯子等人工器械上攀"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
