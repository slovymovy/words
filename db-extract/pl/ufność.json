                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d8f7ae5-597b-43e4-8e32-24e1a26e18d5",
                        "source_entry_id": "38c01f18-ce40-38ac-b28b-a2963e42f238",
                        "source_sense_id": "8bbd326a-42f9-3f8e-a287-c204a5c41f6f",
                        "target_lang_word": "confidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d54a281-052b-3fee-b037-1a8f8fd8e5e8",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Self-assurance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91447330-766d-4ee2-9b41-8225eff0253b",
                                                "sense_id": "2d54a281-052b-3fee-b037-1a8f8fd8e5e8",
                                                "text": "He entered the ring with confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "A feeling of certainty; firm trust or belief; faith."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c953efe6-64e8-4d49-99ac-8fd103c483f5",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "She had confidence it would soon end."
                                            },
                                            {
                                                "example_id": "b87f62f3-206b-4ad0-be18-546ff46a3863",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "It is better to truſt in the Lord : then to put confidence in man. / It is better to truſt in the Lord : then to put confidence in Princes."
                                            },
                                            {
                                                "example_id": "fe0ebaca-3e7d-455d-bd1d-3d022851f240",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "Khedron hesitated for a moment, wondering how far he should take Jeserac into his confidence. He knew that Jeserac was kindly and well-intentioned, but he also knew that he must be bound by the same taboos that controlled everyone on Diaspar."
                                            },
                                            {
                                                "example_id": "669172c3-6af4-459e-90db-9fb65c35f788",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6af89e55-bf6e-3c86-b402-7747c6e4b71e",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Information held in secret; a piece of information shared but to thence be kept in secret."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9ca2b6-ec39-4f53-acab-368b3a1a7db1",
                                                "sense_id": "6af89e55-bf6e-3c86-b402-7747c6e4b71e",
                                                "text": "In the course of these confidences it became quite plain to me I had been represented to the wife of the high dignitary, and goodness knows to how many more people besides, as an exceptional and gifted creature - a piece of good fortune for the Company - a man you don’t get hold of every day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae91c80-8457-32d2-ac69-01719c3315d1",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Boldness; presumption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
