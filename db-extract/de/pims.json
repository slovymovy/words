            {
                "entry_id": "532b6d7f-de7a-3d6c-bc57-b2df501039b8",
                "word": "PIMS",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                        "entry_id": "532b6d7f-de7a-3d6c-bc57-b2df501039b8",
                        "glosses": [
                            "Pädiatrisches inflammatorisches multisystemisches Syndrom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd76ec92-fa41-4298-a48c-ecd949df217f",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "Zu den Komplikationen und Folgeerkrankungen von COVID-19 zählen außerdem Erkrankungen des Herz-Kreislauf- und Nervensystems, Magen-Darm-Beschwerden, Hautprobleme, Nierenerkrankungen, Entzündungsreaktionen sowie das PIMS (Pädiatrisches Inflammatorisches Multisystemisches Syndrom)."
                            },
                            {
                                "example_id": "b64318c5-fde7-42ef-9c3f-ddb92091a295",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "In Einzelfällen wird bei Kindern ein Pädiatrisches Inflammatorisches Multisystemisches Syndrom (PIMS) beobachtet."
                            },
                            {
                                "example_id": "33a3628f-dc18-4947-b053-f68a1d0d8417",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "Im Zuge der zweiten Corona-Welle haben die Kinder-Intensivstationen in der Schweiz vermehrt Fälle von PIMS festgestellt."
                            },
                            {
                                "example_id": "267df265-fd5a-4f9c-b685-8bbe02c3157c",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "Erneut taucht die seltene, aber schwere Erkrankung PIMS bei Kindern und Jugendlichen auf. Sie gilt als Folge einer Corona-Infektion, fast 170 Fälle sind in Deutschland bisher bekannt."
                            },
                            {
                                "example_id": "2b5cfc3e-ab38-4866-be02-e507b6077cbe",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "Die Krankheit [PIMS], die eigentlich sehr selten vorkommt, äußert sich in hohem Fieber, Durchfall, Erbrechen und Entzündungsreaktionen an der Haut."
                            },
                            {
                                "example_id": "d55ed9ef-bb76-41cb-a3da-21671a0604cc",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "Nun treten bei erkrankten Kinder immer mehr Fälle der schweren Kinderkrankheit PIMS auf."
                            },
                            {
                                "example_id": "5013c0f2-4676-4d1f-be68-8863c9dd535b",
                                "sense_id": "8588e3a8-5948-37ad-81f5-bc598a646edd",
                                "text": "Nach einer Serie weiterer Fallberichte, geht man nun von einer eigenständigen entzündlichen Erkrankung mit der Abkürzung PIMS-TS, kurz PIMS, aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
