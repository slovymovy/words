        "fr-extract.jsonl": [
            {
                "entry_id": "3457415a-881a-3dce-b26e-dded8e090430",
                "word": "labradorite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4e700ef-82c0-47eb-9ce3-b1745d70cf31",
                        "entry_id": "3457415a-881a-3dce-b26e-dded8e090430",
                        "tags": [
                            "plural"
                        ],
                        "form": "labradorites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2312e40f-fc7f-3b29-abca-58b3730ebe16",
                        "entry_id": "3457415a-881a-3dce-b26e-dded8e090430",
                        "glosses": [
                            "Variété d’anorthite qui présente de belles couleurs à l’éclat métallique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc13971f-0838-4063-ae7e-7bb49a99ed6f",
                                "sense_id": "2312e40f-fc7f-3b29-abca-58b3730ebe16",
                                "text": "À sa surface scintillaient d’innombrables labradorites, galets variés, aux reflets vifs et changeants, bleus, rouges, verts, puis, çà et là, des pierres ponces et des obsidiennes."
                            },
                            {
                                "example_id": "45dd1cae-d2a8-402b-ade1-9ec28fc135d8",
                                "sense_id": "2312e40f-fc7f-3b29-abca-58b3730ebe16",
                                "text": "Au microscope il [l’échantillon] présente une texture doléritique typique, définie par des poutrelles de labradorite, à environ 65 % d’anorthite, des plages plus ou moins développées de pigeonite, quelques-unes incluant pœcilitiquement des petites poutrelles de calciclase. Des cavités géodiques se montrent bordées par des bandes de chlorite fibrolamellaire, qui arrivent, parfois, à les remplir complètement. Il s’agit d’une chlorite pléochroïque, vert sombre, suivant l’allongement (lequel est positif), et jaune clair, dans une position à 90° de celle-là, polarisant, généralement, dans l’ultra-bleu de la clinozoisite, ce qui nous fait croire que, probablement, il s’agit de pennine, bien que d’autres chlorites puissent exister en mélange."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2f638a5-fd78-4128-a0a7-cff8244e1c7c",
                        "source_entry_id": "3457415a-881a-3dce-b26e-dded8e090430",
                        "source_sense_id": "2312e40f-fc7f-3b29-abca-58b3730ebe16",
                        "source_sense_description": "Minéral",
                        "target_lang_word": "Labradorit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Labradorit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
                                        "entry_id": "7d09a0d5-658e-38e4-9e14-a6c0393b1f48",
                                        "glosses": [
                                            "Abart des Feldspats mit auffälligem Farbenspiel (meist in Blau-, Violett- oder Grüntönen), weshalb er auch gerne als Schmuckstein verwendet wird"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811a7eb6-b0cb-4444-b86a-e90c2aa4161f",
                                                "sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
                                                "text": "„Labradorit bildet sich entweder magmatisch in Gabbros, Basalt und Anorthosit oder metamorph in Amphibolit.“"
                                            },
                                            {
                                                "example_id": "b916ff12-4451-4bd4-83b1-34523c5878f4",
                                                "sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
                                                "text": "„Alle Ketten sind Unikate und von einer kleinen Kollektion mal abgesehen jeweils auf die Trägerin persönlich abgestimmt. Am Hals der Besitzerin entfalten Labradorit, Amazonit oder Bergkristall dann nicht nur ihre optische Wirkung: Die Steine fördern Energie und Wohlbefinden, Sinnlichkeit und Lebensfreude, Gesundheit und manchmal auch das Glück in der Liebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
