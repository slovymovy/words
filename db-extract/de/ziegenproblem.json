                    },
                    {
                        "sense_id": "807bd26d-9a3e-3a78-970d-13b14ae58f1e",
                        "entry_id": "029e49e4-ec09-3d45-85cf-a01e6b825bbb",
                        "glosses": [
                            "ein bekanntes mathematisches Paradoxon"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9601f6d8-8a28-4d8c-8154-ca21e42f95f7",
                                "sense_id": "807bd26d-9a3e-3a78-970d-13b14ae58f1e",
                                "text": "Beim Ziegenproblem ist immer genau ein Gewinn vorhanden."
                            },
                            {
                                "example_id": "cc264add-fe7a-4b42-ae0a-af4851c7a79c",
                                "sense_id": "807bd26d-9a3e-3a78-970d-13b14ae58f1e",
                                "text": "„Ach, das Ziegenproblem! Es beschäftigt die Leser dieser Zeitung seit zwei Jahrzehnten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "166af790-fbfe-482b-9da1-f94877a20332",
                        "source_entry_id": "029e49e4-ec09-3d45-85cf-a01e6b825bbb",
                        "source_sense_id": "807bd26d-9a3e-3a78-970d-13b14ae58f1e",
                        "source_sense_description": "kein Plural: ein bekanntes mathematisches Paradoxon",
                        "target_lang_word": "Monty Hall problem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monty Hall problem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a10f7f7-9607-325f-8e36-2c5841722856",
                                        "entry_id": "4a087d43-6d69-3a1a-89f4-960208dfa241",
                                        "glosses": [
                                            "A brainteaser regarding probability, in which a game show contestant picks a door to win a prize. One door conceals a car; the other two conceal goats. After the contestant picks a door, the host opens one of the two remaining doors which reveals a goat. Counterintuitively, it is then in the contestant's interests to switch to the remaining door."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfb81b8-98b5-410f-849b-12275bb75cf8",
                                                "sense_id": "3a10f7f7-9607-325f-8e36-2c5841722856",
                                                "text": "A few mathematicians were familiar with the puzzle long before Ms. vos Savant's column. They called it the Monty Hall Problem—the title of an analysis in the journal American Statistician in 1976—or sometimes Monty's Dilemma or the Monty Hall Paradox."
                                            },
                                            {
                                                "example_id": "28e52d36-a1c7-493e-bdd7-3313fddb64ac",
                                                "sense_id": "3a10f7f7-9607-325f-8e36-2c5841722856",
                                                "text": "In the Monty Hall problem, it is one thing if your initial choice is incorrect and you lose the game by failing to switch. It is quite another to be sitting on the correct door and then lose the game by moving away from it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
