                "senses": [
                    {
                        "sense_id": "ed3c3ed0-597f-39bf-82ba-9157f5f18460",
                        "entry_id": "34848642-fe9f-3833-8094-99ba987493d4",
                        "glosses": [
                            "Europäischer Stabilitätsmechanismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75152110-8e7c-4504-b6e8-dea25bb70d66",
                                "sense_id": "ed3c3ed0-597f-39bf-82ba-9157f5f18460",
                                "text": "Der Europäische Stabilisierungsmechanismus (ESM) oder einfach Euro-Rettungsschirm wurde ins Leben gerufen um akute Verschuldung eines Staates und dessen Auswirkungen aufzufangen.."
                            },
                            {
                                "example_id": "82e89572-f6d9-4e90-b316-9152ddedb228",
                                "sense_id": "ed3c3ed0-597f-39bf-82ba-9157f5f18460",
                                "text": "Die Finanzminister der Euro-Zone haben sich über den Vertrag für den dauerhaften Euro-Rettungsfonds ESM geeinigt."
                            },
                            {
                                "example_id": "beb2ace3-df0c-4efd-9a36-9303db9f9df4",
                                "sense_id": "ed3c3ed0-597f-39bf-82ba-9157f5f18460",
                                "text": "Der ESM wird dem Beschluss zufolge bereits im Juli 2012 – und damit ein Jahr früher als ursprünglich geplant – in Kraft treten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
