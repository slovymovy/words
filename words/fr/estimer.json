    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "916cc0da-0629-340d-b591-59452a14c9a9",
                    "sense_definition": "Penser, juger ou avoir l'opinion que quelque chose est vrai ou approprié.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>estime</w> que cette décision est la meilleure pour l'avenir de l'entreprise."
                        },
                        {
                            "text": "Le directeur <w>estime</w> nécessaire de reporter la réunion à la semaine prochaine."
                        }
                    ],
                    "common_phrases": [
                        "estimer nécessaire",
                        "estimer opportun"
                    ]
                },
                {
                    "sense_id": "8b333f8f-4795-32b3-9158-1e505b480d2b",
                    "sense_definition": "Déterminer ou fixer la valeur financière ou matérielle de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un expert est venu hier pour <w>estimer</w> la valeur exacte du tableau ancien."
                        },
                        {
                            "text": "Les propriétaires souhaitent faire <w>estimer</w> leur maison avant de la mettre en vente."
                        }
                    ],
                    "common_phrases": [
                        "faire estimer un bien",
                        "estimer la valeur"
                    ]
                },
                {
                    "sense_id": "e0655104-bfe5-39c4-af5e-af35b411494f",
                    "sense_definition": "Évaluer de manière approximative une quantité, un nombre ou une durée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers <w>estiment</w> à plusieurs milliers d'euros le montant total des dégâts causés."
                        },
                        {
                            "text": "On <w>estime</w> le nombre de participants à plus de cinq cents personnes aujourd'hui."
                        }
                    ],
                    "common_phrases": [
                        "estimer les dégâts",
                        "estimer le nombre"
                    ]
                },
                {
                    "sense_id": "d798383d-e1a7-3b4c-b15a-43e2f42dd374",
                    "sense_definition": "Avoir du respect ou une opinion très favorable envers quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous ses collègues l'<w>estiment</w> pour sa compétence et son intégrité professionnelle irréprochable."
                        },
                        {
                            "text": "C'est un professeur remarquable que l'on <w>estime</w> grandement dans tout l'établissement."
                        }
                    ],
                    "common_phrases": [
                        "estimer grandement",
                        "se faire estimer"
                    ]
                },
                {
                    "sense_id": "a8f8e2c9-82d0-348d-8dd0-54e9f7b5b527",
                    "sense_definition": "Se considérer ou se juger soi-même dans un certain état ou une situation donnée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les retards importants, nous pouvons nous <w>estimer</w> heureux d'être arrivés à temps."
                        },
                        {
                            "text": "Le client mécontent s'<w>estime</w> lésé par les frais supplémentaires qui lui sont réclamés."
                        }
                    ],
                    "common_phrases": [
                        "s'estimer heureux",
                        "s'estimer satisfait"
                    ]
                }
            ]
        }
    ]
