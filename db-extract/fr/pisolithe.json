                        "sense_id": "85c13b50-73e5-37d5-994c-778436ec0f3f",
                        "entry_id": "595e6ea1-0695-334f-8b32-d9fc4d0dc188",
                        "glosses": [
                            "Concrétion calcaire sphérique à structure concentrique."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0af28c72-05dc-49fc-80aa-2672cfa66d35",
                                "sense_id": "85c13b50-73e5-37d5-994c-778436ec0f3f",
                                "text": "Les vingt premiers centimètres de ce comblement sont constitués par une argile rouge à pisolithe qui repose sur une argile rouge plus sombre dépourvue de pisolithes."
                            },
                            {
                                "example_id": "a4f41454-c5a8-4f32-8cfb-ce3849ae7709",
                                "sense_id": "85c13b50-73e5-37d5-994c-778436ec0f3f",
                                "text": "Cette roche, qu’on ne peut plus voir en place, est couverte de pisolithes, et paraît avoir été travaillée par des actions ignées, ou soumise à une grande chaleur."
                            },
                            {
                                "example_id": "2ba2d7f9-d242-4135-be86-2751f8f428f9",
                                "sense_id": "85c13b50-73e5-37d5-994c-778436ec0f3f",
                                "text": "Les pisolithes sont de gros oolithes de la grosseur d’un pois."
                            }
                        ]
                    }
