                                        "glosses": [
                                            "A female given name from Italian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce1df29-2617-45f0-af9d-65c2690b55c6",
                                                "sense_id": "4ff5d6b6-7ffa-342e-b025-2e71e506fc0f",
                                                "text": "\"Did you ever know a lady named Miss May-rant? With a funny sort of first name, like Donna? Yes, that is it - Miss Donna May-rant.\""
                                            },
                                            {
                                                "example_id": "0bf67407-314d-4a15-953e-332f72605b96",
                                                "sense_id": "4ff5d6b6-7ffa-342e-b025-2e71e506fc0f",
                                                "text": "I had a girl / Donna was her name. / Since she left me / I've never been the same."
                                            },
                                            {
                                                "example_id": "1a6e62e3-60b2-4367-a2eb-a2517a5c03ad",
                                                "sense_id": "4ff5d6b6-7ffa-342e-b025-2e71e506fc0f",
                                                "text": "For Donna Cona, who has played it since before the Times acquisition, Wordle has become her go-to thing each morning."
                                            }
                                        ]
                                    },
