                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dfa9ab7-b720-47c5-a251-d78c46e61623",
                                                "sense_id": "b78f7125-e916-3a58-a687-553a0db82ee5",
                                                "text": "Штангист установил на штангу дополнительные блины."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "блин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "137bd8ea-fb5d-3d2d-9ddf-9ab7013ebec7",
                                        "entry_id": "b6e218fc-7e75-30a7-9be8-a846ae0ca35f",
                                        "glosses": [
                                            "эвф. то же, что блядь;"
                                        ],
                                        "tags": [
                                            "выражает любую сильную эмоцию"
                                        ],
                                        "examples": [
