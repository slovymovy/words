                "senses": [
                    {
                        "sense_id": "1e24e458-5517-31f6-8298-887c0314b29d",
                        "entry_id": "bd37d0d1-35f6-3bb3-a43e-6111791a04b6",
                        "glosses": [
                            "Donner un caractère mémorable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815a275c-cd14-40a8-9872-080f9238f898",
                                "sense_id": "1e24e458-5517-31f6-8298-887c0314b29d",
                                "text": "Encore une photo pour mémorabiliser ce moment."
                            },
                            {
                                "example_id": "e0e50bd8-ca9e-4a39-ade5-0c120497a0c8",
                                "sense_id": "1e24e458-5517-31f6-8298-887c0314b29d",
                                "text": "Pourtant, le déroulement du primaire ne signifie qu’une seule chose digne d’être mémorabilisée dans l’histoire socialiste toute pareille à celle d’Henry Emmanuelli."
                            },
                            {
                                "example_id": "3a3abb4d-76fa-405f-8f37-92dcbf0cedb9",
                                "sense_id": "1e24e458-5517-31f6-8298-887c0314b29d",
                                "text": "Elle élimine tout ce qui n'a pas été mémorabilisé par le pschent ou le mandat du ciel."
                            }
                        ]
                    }
