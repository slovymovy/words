                                "target_senses": [
                                    {
                                        "sense_id": "5b34b87d-94d6-3040-bc01-ccf860b00441",
                                        "entry_id": "ea735dac-90c2-3d51-980f-160368cfc282",
                                        "glosses": [
                                            "Variante orthographique de crèmerie."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65cb642f-999c-4929-b18a-f0fbcb891215",
                                                "sense_id": "5b34b87d-94d6-3040-bc01-ccf860b00441",
                                                "text": "C’était, dans le haut de la rue Pigalle, non loin de la brasserie Fontaine, une espèce de crémerie disparue aujourd’hui."
                                            },
                                            {
                                                "example_id": "19c410ef-8ee8-4bcc-a425-9d22d5188f07",
                                                "sense_id": "5b34b87d-94d6-3040-bc01-ccf860b00441",
                                                "text": "En sortant de la crémerie je me suis trouvé dans le froid gris sec, qui me paraît une indulgence des choses, presque une promesse, alors qu’on ne saurait vivre à la fois selon la nature et selon le bien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bb493d5-74f8-4d94-a82e-481d778d25f5",
                        "source_entry_id": "7b19d06e-e8ea-32bb-8353-24b680f04797",
                        "source_sense_description": "place where dairy products are prepared or sold",
                        "target_lang_word": "Milchgeschäft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchgeschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1202991a-baf8-34fe-9e13-8ebb0f2eaa31",
                                        "entry_id": "c156e822-f600-396e-b25b-c7688f795d9e",
                                        "glosses": [
                                            "Geschäft, in dem Milch und verwandte Produkte verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d793efa-4637-4dd0-ad51-a357370b7881",
                                                "sense_id": "1202991a-baf8-34fe-9e13-8ebb0f2eaa31",
                                                "text": "„Ein Jahr später heiratete sie einen Witwer, der ein Milchgeschäft hat, nicht weit von der Straße entfernt, in der ich jetzt wohne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b27a0b-02e7-446e-b81f-25ef9fcd30d5",
                        "source_entry_id": "7b19d06e-e8ea-32bb-8353-24b680f04797",
                        "source_sense_description": "place where dairy products are prepared or sold",
                        "target_lang_word": "Milchladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd555581-9ced-3184-8f71-c67f91a521ff",
                                        "entry_id": "629639e8-f9c8-3152-817c-a55b5223dd0d",
                                        "glosses": [
                                            "Geschäft, in dem Milch und verwandte Produkte verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b0d46db-1fda-4f1b-9d28-b3bdeb7e7714",
                                                "sense_id": "cd555581-9ced-3184-8f71-c67f91a521ff",
                                                "text": "„Der Milchladen ist von sechs Uhr an geöffnet und bleibt das, bis es nichts mehr zu verkaufen gibt.“"
                                            },
                                            {
                                                "example_id": "256e36e9-6390-4b80-9a13-b6f170250f11",
                                                "sense_id": "cd555581-9ced-3184-8f71-c67f91a521ff",
                                                "text": "„Andererseits, wenn Tante Matta gute Laune hatte, erlaubte sie uns gnädig, ihr beim Verkauf im Milchladen zu helfen.“"
                                            },
                                            {
                                                "example_id": "9e4dffe1-15fd-43ba-980f-a3a71c19d5a3",
                                                "sense_id": "cd555581-9ced-3184-8f71-c67f91a521ff",
                                                "text": "„Während unserer Schulpausen spielte dieser Milchladen für uns eine wichtige Rolle und war aus unserem Schulalltag gar nicht mehr wegzudenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1904202-e95d-4f2b-b165-b33c7e65ce84",
                        "source_entry_id": "7b19d06e-e8ea-32bb-8353-24b680f04797",
                        "source_sense_description": "place where dairy products are prepared or sold",
                        "target_lang_word": "Molkerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molkerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                        "entry_id": "7464f4f7-1907-35fb-afd0-489072fb8a1b",
                                        "glosses": [
                                            "Betrieb zur Verarbeitung von Milch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d1b4b5-d505-482f-950f-7fcbf9377818",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„In den Räumen der ehemaligen Molkerei in der Osterweder Straße haben sich eine Reihe verschiedener Kunsthandwerksbetriebe, Ateliers und Galerien angesiedelt.“"
                                            },
                                            {
                                                "example_id": "87704605-49be-4108-a03c-7a99616b2470",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                                            },
                                            {
                                                "example_id": "40b86b0b-3957-4d62-939b-7768ee2d4159",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Überall gibt es noch Kühe, jedoch keine Lieferungen mehr an die Molkerei von Glowitz.“"
                                            },
                                            {
                                                "example_id": "07536cb5-62a1-40fb-a750-f13e67389521",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Sie arbeiten im Familienbetrieb, der Molkerei, aber die Eltern wollen sie glüklich verheiratet sehen, und Tewje erählt, wie es ihnen dabei ergeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
