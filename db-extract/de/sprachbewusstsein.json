                ],
                "senses": [
                    {
                        "sense_id": "ab053f7b-a8d5-361d-b278-004594f1676b",
                        "entry_id": "36c9a147-af9d-31d0-865f-b9ba83a98d02",
                        "glosses": [
                            "das, was jemand über seine Sprache weiß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d4e1c7e-0c2a-4f5a-b404-6e250ece885a",
                                "sense_id": "ab053f7b-a8d5-361d-b278-004594f1676b",
                                "text": "In unserem Sprachbewusstsein ist saugen kein starkes Verb mehr."
                            },
                            {
                                "example_id": "c43dd1a4-ec73-4648-91c8-d2f1c71ef23c",
                                "sense_id": "ab053f7b-a8d5-361d-b278-004594f1676b",
                                "text": "„Sprachbewußtsein (…) erschöpft sich nicht in der Kenntnis von Normen, wenngleich diese Kenntnis eine Grundlage bildet (…). Man hat sicherlich zwischen Alltagssprachbewußtsein und wissenschaftlichem Sprachbewußtsein zu unterscheiden.“"
                            },
                            {
                                "example_id": "1b1f9e2d-0c07-4037-a22c-c8e1bf8d0654",
                                "sense_id": "ab053f7b-a8d5-361d-b278-004594f1676b",
                                "text": "„Im selben Umkreis begegnen meistens ebenfalls zwei divergierende, nicht selten ineinander übergehende Postulate: das Sprachbewußtsein (auch: -»empfinden«, »-gefühl«) zu fördern und das »Sprachvermögen« (bzw. die »Sprachsensibilität«) auszubilden.“"
                            },
                            {
                                "example_id": "78964ec7-3bf3-4b19-8f8a-c3fade122582",
                                "sense_id": "ab053f7b-a8d5-361d-b278-004594f1676b",
                                "text": "„Im folgenden versuche ich, in der gebotenen Kürze die Grundlagen von Sprachbewußtsein in der DDR und damit von Sprachdidaktik wiederzugeben.“"
                            },
                            {
                                "example_id": "24257b73-f646-4856-9310-4476ec077af1",
                                "sense_id": "ab053f7b-a8d5-361d-b278-004594f1676b",
                                "text": "„Die Bedeutung des Sprachbewusstseins hat sich die Sprachwissenschaft und übrigens gerade auch die neueste noch keineswegs klargemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10d343d7-c350-310a-a1e0-b28008146d11",
                        "entry_id": "36c9a147-af9d-31d0-865f-b9ba83a98d02",
                        "glosses": [
                            "Aufmerksamkeit gegenüber oder Einstellung zu der eigenen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c95ccbda-23d1-4321-89e8-3d1328c19bd7",
                                "sense_id": "10d343d7-c350-310a-a1e0-b28008146d11",
                                "text": "Zum Sprachbewusstsein gehört die Achtung der eigenen Sprache."
                            },
                            {
                                "example_id": "6d055e9d-db35-4b73-9808-ed944d16ba66",
                                "sense_id": "10d343d7-c350-310a-a1e0-b28008146d11",
                                "text": "Polenz versteht seine große deutsche Sprachgeschichte in hohem Maße als eine Geschichte des Sprachbewusstseins."
                            },
                            {
                                "example_id": "3cfda32d-dae7-4807-a1db-f638d7c4df20",
                                "sense_id": "10d343d7-c350-310a-a1e0-b28008146d11",
                                "text": "„Wenn überhaupt im kollektiven Sprachbewusssein das Jiddische eine Rolle spielt, dann sicherlich im Zusammenhang mit den alten Händlersprachen und dem Rotwelschen, also der alten deutschen Gaunersprache.“"
                            },
                            {
                                "example_id": "99c946ce-3007-4411-aa85-7ef4aa4dbb9c",
                                "sense_id": "10d343d7-c350-310a-a1e0-b28008146d11",
                                "text": "„Besonders Nietzsches philologische Strenge trägt mit zu Canettis Sprachbewusstsein bei.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
