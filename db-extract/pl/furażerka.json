                ],
                "senses": [
                    {
                        "sense_id": "0a91c76c-a053-3861-acec-76186411909a",
                        "entry_id": "2fdc219e-81be-30fd-89ed-5b3903a6be2b",
                        "glosses": [
                            "Schiffchen"
                        ],
                        "tags": [
                            "Pfadfinder"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b9959ff-aeb5-4969-b87c-38295d6a9661",
                        "source_entry_id": "2fdc219e-81be-30fd-89ed-5b3903a6be2b",
                        "source_sense_id": "0a91c76c-a053-3861-acec-76186411909a",
                        "source_sense_description": "Militär, Pfadfinder, Kleidung: Schiffchen",
                        "target_lang_word": "Schiffchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiffchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb0da01-b969-3175-9e91-b262233b79dd",
                                        "entry_id": "80f0958b-5bdf-3ccf-8813-891004546aa9",
                                        "glosses": [
                                            "ein kleines Schiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148244c6-0780-4229-a66d-674ccd29231f",
                                                "sense_id": "6cb0da01-b969-3175-9e91-b262233b79dd",
                                                "text": "Mein Segelboot ist kein Schiffchen!"
                                            },
                                            {
                                                "example_id": "159df7b5-2a1c-4077-8b09-fd3b9308e664",
                                                "sense_id": "6cb0da01-b969-3175-9e91-b262233b79dd",
                                                "text": "„Das Schiffchen segelte zu pathetischer Musik ziemlich schnell von links nach rechts über das Meer.“"
                                            },
                                            {
                                                "example_id": "51b0191d-364a-4a56-a6f3-f5fd06e1e17b",
                                                "sense_id": "6cb0da01-b969-3175-9e91-b262233b79dd",
                                                "text": "„Er faltete die Karte zu einem Schiffchen, setzte es in den Zierbrunnen und beobachtete, wie es sich im Kreis auf dem Wasser bewegte.“"
                                            },
                                            {
                                                "example_id": "2809b36b-32a6-4c5e-a20a-3d3073770fef",
                                                "sense_id": "6cb0da01-b969-3175-9e91-b262233b79dd",
                                                "text": "„Die andern Kähne hatten sich mittlerweile gleichfalls mit Mädchen gefüllt, und die sechs Schiffchen schienen nun ernstlich willens, sich in ein Wettrudern einlassen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90119a22-43ca-3bcf-a94e-ca62a4b75477",
                                        "entry_id": "80f0958b-5bdf-3ccf-8813-891004546aa9",
                                        "glosses": [
                                            "eine militärische Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dd073c-47b2-404e-92b1-cc1be5b37a39",
                                                "sense_id": "90119a22-43ca-3bcf-a94e-ca62a4b75477",
                                                "text": "„Setzen Sie Ihr Schiffchen ab!“"
                                            },
                                            {
                                                "example_id": "82e49296-599d-44d2-8852-a1b047ffbea2",
                                                "sense_id": "90119a22-43ca-3bcf-a94e-ca62a4b75477",
                                                "text": "„Er trägt statt der Schirmmütze nur das Schiffchen, und unter dem Schiffchen drängen sich fahlblonde Haare hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "51fb80f0-972c-302f-9af3-dd2f8017cc54",
                                        "entry_id": "80f0958b-5bdf-3ccf-8813-891004546aa9",
                                        "glosses": [
                                            "die beiden unteren, verwachsenen Kronblätter der Hülsenfrüchtler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de9f7a2-957c-433d-9478-79138ee1d6ba",
                                                "sense_id": "51fb80f0-972c-302f-9af3-dd2f8017cc54",
                                                "text": "Das Schiffchen umhüllt die Staubblätter und den Griffel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4371ebd3-b670-316c-866a-cc1951969730",
                                        "entry_id": "80f0958b-5bdf-3ccf-8813-891004546aa9",
                                        "glosses": [
                                            "Teil eines Webstuhls, der den Schussfaden enthält und zwischen den Kettfäden hin- und hergeschoben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96629c1b-9269-458d-9bb6-f40a1ae4bee0",
                                                "sense_id": "4371ebd3-b670-316c-866a-cc1951969730",
                                                "text": "„Das Schiffchen fliegt, der Webstuhl kracht, / wir weben emsig Tag und Nacht“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2eab93af-e7fe-3f30-858d-8a73138165b7",
                                        "entry_id": "80f0958b-5bdf-3ccf-8813-891004546aa9",
                                        "glosses": [
                                            "schiffförmiger Behälter zum Aufbewahren des Weihrauchs"
                                        ],
                                        "tags": [
                                            "katholische Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4682cd9d-49d9-4aec-acf6-f59ee47d793b",
                                                "sense_id": "2eab93af-e7fe-3f30-858d-8a73138165b7",
                                                "text": "„Wenn der Bischof sich an der Kathedra oder an einem anderen Sitz befindet, legt er den Weihrauch im Sitzen ein, sonst im Stehen, wobei der Diakon ihm das Schiffchen reicht.“"
                                            },
                                            {
                                                "example_id": "2afcc55d-9c92-4212-a265-fcb9f3179ec5",
                                                "sense_id": "2eab93af-e7fe-3f30-858d-8a73138165b7",
                                                "text": "„Der Thuriferarius hat dafür zu sorgen, daß er zur rechten Zeit an einem bequem gelegenen Orte Feuer, Thuribulum mit dem Schiffchen und Weihrauch darin vorfindet.“"
                                            },
                                            {
                                                "example_id": "d84b3964-120f-453f-8fc2-64a385c97392",
                                                "sense_id": "2eab93af-e7fe-3f30-858d-8a73138165b7",
                                                "text": "„Das Schiffchen, in welchem der Weihrauch bewahrt wird, erinnert daran, daß wir durch das Gebet, welches der Weihrauch bedeutet, aus dem großen und weiten Weltmeere unser Schifflein zum himmlischen Vaterland richten sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
