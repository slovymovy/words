                    {
                        "sense_id": "a38e80d4-3d6b-3a52-b4ee-234f82086fb9",
                        "entry_id": "83636a4c-da9e-3e65-9f45-04c9275c58cc",
                        "glosses": [
                            "Stadt in Schleswig-Holstein, Deutschland"
