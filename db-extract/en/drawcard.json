                                    {
                                        "sense_id": "3ef1e974-3028-3f09-96e6-3f06acd5f9ee",
                                        "entry_id": "cc569f53-dc45-3865-bb71-74d102ce18c1",
                                        "glosses": [
                                            "als Zugtier dienendes Pferd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "121b8754-bf0c-4855-aeba-5440f5e34244",
                                                "sense_id": "3ef1e974-3028-3f09-96e6-3f06acd5f9ee",
                                                "text": "Panino ist ein zugerittenes Zugpferd, das vielseitig eingesetzt werden kann."
                                            },
                                            {
                                                "example_id": "a41293c1-0145-4858-8d7b-096564e818ef",
                                                "sense_id": "3ef1e974-3028-3f09-96e6-3f06acd5f9ee",
                                                "text": "„Martin kümmerte sich um die Zugpferde, die sie weiter hinten in einem Wäldchen angepflockt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f785f4e5-5a49-34f9-b0b3-f5b3c5ba8d92",
                                        "entry_id": "cc569f53-dc45-3865-bb71-74d102ce18c1",
                                        "glosses": [
                                            "besonders zugkräftige Sache oder Person, die viele Menschen anlockt oder mitreißt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb4fc690-2788-46b8-bf08-b3fc416927e1",
                                                "sense_id": "f785f4e5-5a49-34f9-b0b3-f5b3c5ba8d92",
                                                "text": "Sie ist zwar nicht mehr als Tennisspielerin aktiv, aber als Zugpferd für das Turnier in Bad Gandersheim ganz hervorragend geeignet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
