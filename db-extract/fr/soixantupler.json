                "senses": [
                    {
                        "sense_id": "14007875-1c6c-3937-a804-cd120b2a9614",
                        "entry_id": "eacf5a11-bad2-3a58-baed-f829c7a26c02",
                        "glosses": [
                            "Multiplier par soixante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084ee502-11fa-423c-8969-f9a584579b1a",
                                "sense_id": "14007875-1c6c-3937-a804-cd120b2a9614",
                                "text": "Il s’agit de soixantupler le territoire national, de créer un budget et une organisation politique nouvelle, s'exposer à des conflits imprévus, puisque la neutralité du Congo n’a pas la garantie des puissances qui assurent la nôtre !"
                            },
                            {
                                "example_id": "94e04e31-1272-471a-a1e2-32deeacee22b",
                                "sense_id": "14007875-1c6c-3937-a804-cd120b2a9614",
                                "text": "A cet âge de retraité où l’on risque de se retrouver seul, se sentir sincèrement désiré… soixantuple les forces."
                            }
                        ]
                    }
