                    }
                ],
                "senses": [
                    {
                        "sense_id": "40499015-bad8-3259-bc04-e86fa6646ae2",
                        "entry_id": "c89d7b0d-c88e-33d3-90fe-614380c3c896",
                        "glosses": [
                            "Forme de conférence en ligne, séminaire sur Internet."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "d0104291-e796-4dd6-a132-3e1a13ffbfa1",
                                "sense_id": "40499015-bad8-3259-bc04-e86fa6646ae2",
                                "text": "Un quatrième webinaire est prévu en février et concernera le développement économique."
                            },
                            {
                                "example_id": "8c5a4e37-a1c1-42ad-b4b9-4acdb4f6f024",
                                "sense_id": "40499015-bad8-3259-bc04-e86fa6646ae2",
                                "text": "Jeudi, lors du webinaire organisé par le Conseil du patronat du Québec, M. Dubé avait déclaré qu’il espérait pouvoir vacciner de 100 000 à 200 000 personnes par semaine grâce à l’aide du secteur privé."
                            },
                            {
                                "example_id": "dad5a131-ac97-4096-a0b9-58fe4283c3be",
                                "sense_id": "40499015-bad8-3259-bc04-e86fa6646ae2",
                                "text": "Deux webinaires thématiques sont proposés les 10 et 23 mai à 19 h pour approfondie les modalités de mise en œuvre de la voie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "487dd9e9-4b38-4892-8859-90d574783713",
                        "source_entry_id": "c89d7b0d-c88e-33d3-90fe-614380c3c896",
                        "source_sense_id": "40499015-bad8-3259-bc04-e86fa6646ae2",
                        "target_lang_word": "Webinar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Webinar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fccba390-9939-3b6d-a000-babc856aa77f",
                                        "entry_id": "ccb92b7f-c56c-3f73-b14d-1f124ab8b4dd",
                                        "glosses": [
                                            "ein Seminar, das über das World Wide Web gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01ba597-779b-4885-8ca3-5358d5088a63",
                                                "sense_id": "fccba390-9939-3b6d-a000-babc856aa77f",
                                                "text": "Ich habe an einem Webinar über Datensicherheit in Unternehmen teilgenommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddb0ce99-57b9-44da-820e-42c67d1a94bf",
                        "source_entry_id": "c89d7b0d-c88e-33d3-90fe-614380c3c896",
                        "source_sense_id": "40499015-bad8-3259-bc04-e86fa6646ae2",
                        "target_lang_word": "webinar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "webinar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                        "entry_id": "d4613e6e-8c56-3ea5-bfc8-2693c9362853",
                                        "glosses": [
                                            "An interactive seminar conducted via Internet. Usually a live presentation, lecture or workshop that happens in real time, as users participate through text-based chat, voice, video, or file-sharing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b2be3e-cf0e-4cf9-bf93-89c7dceb77bf",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "I just got an email invitation to a webinar on the value of primary sources."
                                            },
                                            {
                                                "example_id": "b16fcaf8-ae81-4dcb-ac77-2bceaa2413a4",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "Web conferences or Webinars are a great way to learn about products or subjects of interest."
                                            },
                                            {
                                                "example_id": "b873b0a7-db1f-4620-a976-69305887e1a0",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "Webinars are often painfully short on exposure to the actual product, devoting half of the typical one-hour length to an “expert” disserting on some lofty topic, another fifteen minutes to a fluffy presentation about the company and its strategic direction, and a scant five minutes to a quick demo."
                                            },
                                            {
                                                "example_id": "fbdb8452-a8c7-44d4-9ec5-df089cccb7c1",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "It's not that all women aren't interested in learning to download files or take Webinars, it's that their “why bother” factor may well kick in."
                                            },
                                            {
                                                "example_id": "9ac14c71-1abc-437d-baa2-1543cda37549",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "Register today for our informative webinar and executive book offer."
                                            },
                                            {
                                                "example_id": "a992cc61-af49-4656-a0d2-00013c14fc0a",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "One other point: An impressive site design can never rescue poorly written copy, sloppy videos, or boring webinar recordings."
                                            },
                                            {
                                                "example_id": "cff60025-46ab-494f-bdef-adb32e3e1aa9",
                                                "sense_id": "93300c50-cb4a-3bcf-ad6b-d7a7579001c8",
                                                "text": "Although there are many other tools that are available in a webinar tool, these are the ones you'll find yourself using most often."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
