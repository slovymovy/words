    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "212006fc-0a3d-3e38-9073-2918a5bcb67d",
                "word": "backroom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "abc21120-8410-405e-bb22-a35029276e95",
                        "entry_id": "212006fc-0a3d-3e38-9073-2918a5bcb67d",
                        "tags": [
                            "plural"
                        ],
                        "form": "backrooms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3766e02-6058-35a9-8ff8-4a58a0425278",
                        "entry_id": "212006fc-0a3d-3e38-9073-2918a5bcb67d",
                        "glosses": [
                            "A room near the rear of a premises.",
                            "Especially, one that is only accessible to a privileged few and can be used as an inconspicuous meeting place, where secrecy, anonymity, and even crooked dealings may occur."
                        ],
                        "tags": [
                            "attributive",
                            "figuratively",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "a78c2dec-d25f-4a21-9b47-693fc041a3a8",
                                "sense_id": "f3766e02-6058-35a9-8ff8-4a58a0425278",
                                "text": "Near-synonym: smoke-filled room (meeting place of crooked insiders)"
                            },
                            {
                                "example_id": "814713fd-f56b-4521-bf02-e97ba8f9cf9e",
                                "sense_id": "f3766e02-6058-35a9-8ff8-4a58a0425278",
                                "text": "backroom deals"
                            },
                            {
                                "example_id": "fcf67099-71dd-4f1a-ac50-7872ea7091a4",
                                "sense_id": "f3766e02-6058-35a9-8ff8-4a58a0425278",
                                "text": "backroom bargaining"
                            },
                            {
                                "example_id": "7d7f6051-f56a-499f-89c4-362932e8c8fd",
                                "sense_id": "f3766e02-6058-35a9-8ff8-4a58a0425278",
                                "text": "It is known that means of using this end of the former NLR and Broad Street station to take an overspill of traffic from Liverpool Street have been under backroom study for some time."
                            },
                            {
                                "example_id": "c028f8ed-7354-4dc0-afa6-e4725f7a9162",
                                "sense_id": "f3766e02-6058-35a9-8ff8-4a58a0425278",
                                "text": "The vote for a new prime minister will involve plenty of backroom bargaining, while Thailand struggles to revive its faltering economy."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c2b10b7-03e9-3ee6-b4c0-cbfcb7093538",
                        "entry_id": "212006fc-0a3d-3e38-9073-2918a5bcb67d",
                        "glosses": [
                            "A room near the rear of a premises.",
                            "A storeroom in the rear of the premises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8932489-73ea-4d24-b0f1-d041ee78d1c8",
                                "sense_id": "1c2b10b7-03e9-3ee6-b4c0-cbfcb7093538",
                                "text": "We had thought that they were out of the old model, but somebody checked in the backroom and found a case of them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc578423-55b5-4f7a-8c5a-c4076670b077",
                        "source_entry_id": "212006fc-0a3d-3e38-9073-2918a5bcb67d",
                        "source_sense_description": "room",
                        "target_lang_word": "pièce à l'arrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8fa7cd58-5345-4fc8-8763-1aa3d15c985d",
                        "source_entry_id": "212006fc-0a3d-3e38-9073-2918a5bcb67d",
                        "source_sense_description": "room",
                        "target_lang_word": "Hinterzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab228a8-88fa-3426-a60e-c91d0a11dbab",
                                        "entry_id": "21c5a507-2b3c-3abd-91db-963dab63e1f7",
                                        "glosses": [
                                            "Zimmer, das nur über andere Zimmer, also nicht direkt, zugänglich ist und zu dem oft nur ein beschränkter Personenkreis Zugang hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebb767b4-5eab-4c7f-a1ff-142863aecc9b",
                                                "sense_id": "1ab228a8-88fa-3426-a60e-c91d0a11dbab",
                                                "text": "Die verbotenen Glücksspiele betrieben sie im Hinterzimmer."
                                            },
                                            {
                                                "example_id": "f903b460-6c20-4e0b-8311-82a7f6e26104",
                                                "sense_id": "1ab228a8-88fa-3426-a60e-c91d0a11dbab",
                                                "text": "„Im Hinterzimmer führt eine gusseiserne Wendeltreppe steil nach oben in eine Wohnung, die sich über die gesamte erste Etage des Hauses erstreckt.“"
                                            },
                                            {
                                                "example_id": "10c4c7a3-ab6c-47fa-93dd-fc8879b03069",
                                                "sense_id": "1ab228a8-88fa-3426-a60e-c91d0a11dbab",
                                                "text": "„Im schmucklosen Hausflur der Nummer 30 im Römanns Kamp hängt ein Kartentelefon an der Wand, aus dem Hinterzimmer dröhnt laute Musik, über Satellitenschüssel empfängt der Fernseher einen polnischen Musiksender.“"
                                            },
                                            {
                                                "example_id": "452c2e24-6083-4d8b-b07f-7f7522534c1b",
                                                "sense_id": "1ab228a8-88fa-3426-a60e-c91d0a11dbab",
                                                "text": "„Sie hatten sich im Hinterzimmer eingerichtet.“"
                                            },
                                            {
                                                "example_id": "0a4748c0-410a-4f4e-9538-fe05a48234c5",
                                                "sense_id": "1ab228a8-88fa-3426-a60e-c91d0a11dbab",
                                                "text": "„Serana bewohnte die beiden großen Hinterzimmer eines vormals großherrschaftlichen Domizils, in dessen zwei kleinen Vorderräumen Frau Michelsen logierte, eine jugendliche Witwe, die ihren Unterhalt mit Schneidern verdiente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
