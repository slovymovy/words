                "senses": [
                    {
                        "sense_id": "a9d2188e-8938-37b1-9d18-979f675d576d",
                        "entry_id": "599c1a00-a2e6-3ff8-9535-ace7a7f429af",
                        "glosses": [
                            "морское или речное судно, приводимое в движение двигателем внутреннего сгорания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3133913-a9d7-46ee-a20f-3e89d8552e23",
                                "sense_id": "a9d2188e-8938-37b1-9d18-979f675d576d",
                                "text": "Большой теплоход поднимал якори и уходил в плавание."
                            },
                            {
                                "example_id": "9d53ef8f-36b7-41ae-9aa3-3331d6fda18a",
                                "sense_id": "a9d2188e-8938-37b1-9d18-979f675d576d",
                                "text": "Пишу тебе из Москвы, куда приехал на три дня для обсуждения проектов нового типа теплоходов пассажирских ― одного для Волги, другого для Чёрного моря."
                            },
                            {
                                "example_id": "3a2ba68b-e9c4-49ba-83f9-8d4102cd503b",
                                "sense_id": "a9d2188e-8938-37b1-9d18-979f675d576d",
                                "text": "В XIX веке все «тягловые судна» строились с паровой машиной. Но в 1903 году в России появился первый теплоход «Вандал»."
                            }
                        ]
                    }
                ],
