                        "en": [
                            {
                                "target_lang_word": "crew",
                                "target_lang_sense_clarification": "ship's personnel"
                            },
                            {
                                "target_lang_word": "ship's company",
                                "target_lang_sense_clarification": "entire crew"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "船员",
                                "target_lang_sense_clarification": "船上人员"
                            },
                            {
                                "target_lang_word": "全体船员",
                                "target_lang_sense_clarification": "船上所有人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f2cb480-e6b6-3af2-b0b4-70cdaada9e99",
                    "sense_definition": "Инструкция для компьютера или программы выполнить определённое действие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чтобы сохранить файл, нужно выбрать соответствующую <w>команду</w> в меню.",
                            "target_lang_translations": {
                                "en": "To save the file, you need to choose the appropriate <w>command</w> in the menu.",
                                "zh": "要保存文件，需要在菜单中选择相应的<w>命令</w>。"
                            }
                        },
                        {
                            "text": "Компьютер не смог выполнить эту сложную <w>команду</w>.",
                            "target_lang_translations": {
                                "en": "The computer could not execute this complex <w>command</w>.",
                                "zh": "计算机无法执行这条复杂的<w>指令</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "инструкция",
                        "указание"
                    ],
                    "common_phrases": [
                        "строка команд",
                        "выполнить команду",
                        "системная команда"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
