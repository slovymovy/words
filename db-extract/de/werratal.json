                        "examples": [
                            {
                                "example_id": "6ca210ad-94f3-4593-8b10-6e4eebea1708",
                                "sense_id": "d34d60d9-9144-3ca8-a1e1-5a5b52c38107",
                                "text": "„Tagsüber hatte ein schwerer Sturm von Nordwesten her durchs Werratal geheult, das trockene Gezweig aus den Bäumen gerissen und den Märzstaub in langen Fahnen über die Landstraßen getrieben.“"
                            },
                            {
                                "example_id": "5b05b011-041a-42fa-b64c-987d463afae8",
                                "sense_id": "d34d60d9-9144-3ca8-a1e1-5a5b52c38107",
                                "text": "„Seit über hundert Jahren werden im Werratal Kaliumsalze für die Herstellung von Düngemitteln gewonnen.“"
                            }
                        ],
