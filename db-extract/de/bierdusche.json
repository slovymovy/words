                ],
                "senses": [
                    {
                        "sense_id": "9b76ac5d-6a8c-3671-9a04-61410b0607d1",
                        "entry_id": "bbeb8e31-1fe5-3f68-a66a-c92ecc983ef3",
                        "glosses": [
                            "das (gegenseitige) Übergießen der Spieler, Trainer und anderer mit Bier zur Feier einer Meisterschaft, eines besonderen Sieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564f1b6f-0d41-47ae-b6ef-9081a6367402",
                                "sense_id": "9b76ac5d-6a8c-3671-9a04-61410b0607d1",
                                "text": "„Mit einer Bierdusche für Trainer Alfred Gislason und einer Flasche Schampus hat der THW Kiel seinen 17. Meistertitel im Handball gefeiert.“"
                            },
                            {
                                "example_id": "7d3c4008-e5de-4d87-a3b5-7faa0c31a9ff",
                                "sense_id": "9b76ac5d-6a8c-3671-9a04-61410b0607d1",
                                "text": "„Was hat diese Schale nicht schon alles mitgemacht? […] Sie hat wahrscheinlich mehr Rathausbalkone von oben und mehr Bierduschen von unten gesehen als jeder andere in diesem Land.“"
                            },
                            {
                                "example_id": "4c750b2b-bb80-4bfb-9337-889862d360f1",
                                "sense_id": "9b76ac5d-6a8c-3671-9a04-61410b0607d1",
                                "text": "„Bei der Jagd auf van Gaal erwies sich dieser beim Ausweichen der Bierduschen durchaus als geschickt und so musste ein unachtsamer Moment vor der Bayern-Kurve schliesslich zur finalen Bierdusche durch Kapitän van Bommel herhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
