                    {
                        "form_id": "d98884c9-eda4-4307-8da7-782c9aebe01b",
                        "entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Befriedigung"
                    },
                    {
                        "form_id": "c9fb902a-2473-487c-af3a-54bad1679f1d",
                        "entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Befriedigungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                        "entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                        "glosses": [
                            "Handlung, durch die die Wünsche und Ansprüche des Betreffenden erfüllt sind oder werden und Ergebnis dieser Handlung; Zufriedenstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3d9e3d8-4ea9-4683-b309-bf5a1bb72e4c",
                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                "text": "Es geht hier natürlich um die Befriedigung seiner Machtbedürfnisse."
                            },
                            {
                                "example_id": "b5105da3-90f3-49da-a04d-4acd313f99ca",
                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                "text": "Wenn das Bedürfnis nach Liebe und Zuwendung nie einer Befriedigung erfährt, entsteht ein gefährlicher Druck."
                            },
                            {
                                "example_id": "5d0a78e5-091d-4788-b376-b34af3462e4b",
                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                "text": "„Ich fühle die größte Befriedigung, daß diese Begegnung so gut abgelaufen ist, und werde wieder ruhig.“"
                            },
                            {
                                "example_id": "b97b0e08-790c-492b-a4a3-0c6b5af4be87",
                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                "text": "„Und dankbaren Herzens wollen wir daran denken, wie viel nationale Befriedigung uns allen das gemeinsame Sammeln von Briefmarken vermitteln wird.“"
                            },
                            {
                                "example_id": "1f7fa83e-7350-461a-931f-0b4a95190905",
                                "sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                                "text": "„Ich überlege, wann mich überhaupt zum letzten Mal irgendetwas mit Befriedigung erfüllt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                        "entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                        "glosses": [
                            "die Erfüllung sexueller Wünsche"
                        ],
                        "tags": [
                            "insbesondere sexuell"
                        ],
                        "examples": [
                            {
                                "example_id": "89c07e39-54bf-4144-9854-2d2e9f925373",
                                "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                "text": "„Die orale Befriedigung einer Frau ist wirklich eine Kunst, die nicht jeder beherrscht.“"
                            },
                            {
                                "example_id": "de9af636-92d5-475b-b4d4-0e080f12e180",
                                "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                "text": "Im Mittelpunkt dieser Diskussion steht leider immer noch alleine die sexuelle Befriedigung des Mannes."
                            },
                            {
                                "example_id": "99927a63-d894-4863-b90a-b5673c4e1b5b",
                                "sense_id": "4b45e3c8-b4e6-37aa-9a36-1e053a627abc",
                                "text": "„Etwas von der kostbaren Nacht mußte ja schließlich auch der Befriedigung des beiderseitigen stürmischen Liebesverlangens vorbehalten bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fb57dae-dc8a-4789-8692-2bb4650ddfa9",
                        "source_entry_id": "93d3022a-cd04-3e89-89ee-8f41f1765400",
                        "source_sense_id": "5b6d259d-5f07-33f4-92cb-8a88d048afb7",
                        "source_sense_description": "Handlung, durch die die Wünsche des Betreffenden erfüllt werden und Ergebnis dieser Handlung",
                        "target_lang_word": "satisfaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satisfaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A fulfilment of a need or desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32d0a7f-19ee-4357-8326-5dd3b50c5f2b",
                                                "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The pleasure obtained by such fulfillment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34259c4-c60b-473a-b42b-035929ff20c6",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "November 4, 1860, Henry David Thoreau, letter to Mr. D. R.\nThis life is not for complaint, but for satisfaction."
                                            },
                                            {
                                                "example_id": "7a9e0a5b-44e7-49bf-b2ac-5f1e4220978c",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "Selwyn, sitting up rumpled and cross-legged on the floor, after having boloed Drina to everybody's exquisite satisfaction, looked around at the sudden rustle of skirts to catch a glimpse of a vanishing figure—a glimmer of ruddy hair and the white curve of a youthful face, half-buried in a muff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bff076-83ba-3c86-81dd-8118a07497aa",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The source of such gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa560a67-e08d-308f-8633-5a534f01305a",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
