                    {
                        "sense_id": "cfc27d68-3486-3ee8-8056-06f6b4a0ec78",
                        "entry_id": "5849dd5b-b879-37cd-a871-26250d449614",
                        "glosses": [
                            "Fähigkeit zur Ausübung einer Funktion"
                        ],
                        "tags": [
                            "von Personen oder Sachen"
                        ],
                        "examples": [
                            {
                                "example_id": "40dc161a-188d-4f19-af33-91dc72c6ad60",
                                "sense_id": "cfc27d68-3486-3ee8-8056-06f6b4a0ec78",
                                "text": "Der Begriff der Funktionsfähigkeit eines Menschen umfasst alle Aspekte der funktionalen Gesundheit."
                            },
                            {
                                "example_id": "d3fa41c0-2836-4caf-a227-b04634070389",
                                "sense_id": "cfc27d68-3486-3ee8-8056-06f6b4a0ec78",
                                "text": "Wer die Funktionsfähigkeit eines Computersystems, über das er nicht oder nicht allein verfügen darf, dadurch schwer stört, dass er Daten eingibt oder übermittelt, ist, wenn die Tat nicht nach § 126a mit Strafe bedroht ist, mit Freiheitsstrafe bis zu sechs Monaten oder mit Geldstrafe bis zu 360 Tagessätzen zu bestrafen."
                            },
                            {
                                "example_id": "c1d9133a-d429-4f10-86fd-1a922f31a628",
                                "sense_id": "cfc27d68-3486-3ee8-8056-06f6b4a0ec78",
                                "text": "Das Vitamin A, das im Körper aus dem Beta-Carotin gebildet wird, ist lebensnotwendig für die Funktionsfähigkeit des menschlichen Auges, indem es eine Austrocknung der Hornhaut verhindert und der gefürchteten Makuladegeneration vorbeugt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
