                ],
                "senses": [
                    {
                        "sense_id": "cbaaa6ea-a7ad-37ce-a81d-8d1c286fdf08",
                        "entry_id": "822aa27d-5a4a-3e7e-971a-88da0fde4dda",
                        "glosses": [
                            "die Ursache für das Auftreten einer Fehlerwirkung"
                        ],
                        "tags": [
                            "Softwaretesten"
                        ],
                        "examples": [
                            {
                                "example_id": "7f22a24e-cf90-4eb8-87cf-e8192ead325d",
                                "sense_id": "cbaaa6ea-a7ad-37ce-a81d-8d1c286fdf08",
                                "text": "Ein Fehlerzustand, der zur Laufzeit angetroffen wird, kann eine Fehlerwirkung einer Komponente oder eines Systems verursachen."
                            },
                            {
                                "example_id": "ecbcda84-5f9d-4b89-8ccd-af40bbe1da51",
                                "sense_id": "cbaaa6ea-a7ad-37ce-a81d-8d1c286fdf08",
                                "text": "„Je komplizierter eine technische Anlage, desto mehr tacit knowledge ist notwendig, um sie zu fahren. Wer alle ihre möglichen Fehlerzustände explizit beschreiben wollte, der stünde vor einer schier unmöglichen Aufgabe; hat indessen jemand schon allerhand Macken einer bestimmten Technik gesehen, kann er sich oft recht schnell einen Reim auf Fehler und Versagen machen.“"
                            },
                            {
                                "example_id": "ee41d947-d1fa-4bbc-b859-8a9ad653b379",
                                "sense_id": "cbaaa6ea-a7ad-37ce-a81d-8d1c286fdf08",
                                "text": "„Ernste Probleme verursachte die Migration einer Dokumenten Management Software von Oracle auf Websphere. Die Ursache, warum es auf den JSP Seiten nach kurzem Arbeiten in der Applikation zu IllegalStateException gekommen ist, konnte zwei Wochen lang nicht gefunden werden. Der Rollout-Plan war damit gefährdet. Erst der Einsatz von dynaTrace hat in wenigen Stunden die Ursache des Problems aufgedeckt. Dabei benötigte die Installation und Instrumentierung von dynaTrace lediglich 45 Minuten. Danach konnten anhand konkreter Transaktionen, der Fehlerzustand nachvollzogen und die betreffenden Codezeilen identifiziert werden, welchen den Fehler verursachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b61a5984-344f-4250-a88c-1937d42e9c91",
                        "source_entry_id": "822aa27d-5a4a-3e7e-971a-88da0fde4dda",
                        "source_sense_id": "cbaaa6ea-a7ad-37ce-a81d-8d1c286fdf08",
                        "source_sense_description": "Softwaretesten: die Ursache für das Auftreten einer Fehlerwirkung",
                        "target_lang_word": "fault",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fault",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "Culpability; the responsibility for a blameworthy event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6729b4d0-9c28-4a9c-b500-ede8a68c0900",
                                                "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                                                "text": "No, don't blame yourself. It's my fault that we lost the game."
                                            },
                                            {
                                                "example_id": "f8f7dc81-26e1-43dd-aac8-20a7fe47a663",
                                                "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                                                "text": "I told them the pie was still too hot. If they burn their tongues, that's their fault."
                                            },
                                            {
                                                "example_id": "71686adb-7a9e-4c36-ada1-536aacdc2cb6",
                                                "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                                                "text": "The fault, dear Brutus, is not in our stars, / But in ourselves, that we are underlings."
                                            },
                                            {
                                                "example_id": "1aad81bf-cbd9-4aaa-bbe5-88aad7eac6f2",
                                                "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                                                "text": "A police official, speaking on the condition of anonymity, said that a note found at the scene addressed to Ms. Spade's 13-year-old daughter indicated, among other things, that what had happened was not the child’s fault."
                                            },
                                            {
                                                "example_id": "8da6d9f3-5ca2-4c40-8ba5-71897071bb68",
                                                "sense_id": "cb0431a5-5db8-3787-9647-a2f9eb8dc300",
                                                "text": "How many more innocent people and kids gotta get killed by these police, man? / And then it's always the victim's fault"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e85356-8f77-3192-90c8-066c7793661e",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "A defect, imperfection, or weakness; more severe than a flaw.",
                                            "A failing of character; less severe than a vice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b81880-a518-4563-aea8-c4f18f930ad1",
                                                "sense_id": "52e85356-8f77-3192-90c8-066c7793661e",
                                                "text": "Despite all her faults, she’s a good person at heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10db612d-f808-310a-9f90-764f85036908",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "A defect, imperfection, or weakness; more severe than a flaw.",
                                            "A characteristic, positive or negative or both, which increases one's risk of danger or difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae2741f7-94ca-4d80-a7f3-033d5745bbc5",
                                                "sense_id": "10db612d-f808-310a-9f90-764f85036908",
                                                "text": "You're still young, that's your fault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beabd423-4302-3c1e-a602-d3a5cefc3352",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "A defect, imperfection, or weakness; more severe than a flaw.",
                                            "A strongly undesirable variation of food or drink caused by impurity or contamination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e6685c-5ac7-4733-bd1d-497c47962015",
                                                "sense_id": "beabd423-4302-3c1e-a602-d3a5cefc3352",
                                                "text": "Cork taint is one of the most recognizable wine faults."
                                            },
                                            {
                                                "example_id": "d9878106-6bbe-4afa-ad46-99e0170d1fb8",
                                                "sense_id": "beabd423-4302-3c1e-a602-d3a5cefc3352",
                                                "text": "The time of greatest prevalence of this microörganism, August and September, agreed in general with the occurrence of this cheese fault. Not a single Cheddar cheese was found which turned blue, and as the iron content of Cheddar cheese was low the author regards this as supporting his conclusion that iron is the cause of the fault."
                                            },
                                            {
                                                "example_id": "074619aa-cae4-4da1-90ca-594877e3d3d2",
                                                "sense_id": "beabd423-4302-3c1e-a602-d3a5cefc3352",
                                                "text": "No common wine fault is likely to cause serious health problems but you won't want to take the tasting much further if the wine smells faulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb4f012-2965-356d-916b-c2280329dcab",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "A defect, imperfection, or weakness; more severe than a flaw.",
                                            "A point of weakness in something's physical structure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dfb5bfd-fea1-40e3-a648-d65b82265114",
                                                "sense_id": "abb4f012-2965-356d-916b-c2280329dcab",
                                                "text": "As patches set upon a little breach / Discredit more in hiding of the fault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6876b891-d859-3e33-bba9-287606b1093c",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "A mistake or error.",
                                            "A minor offense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b60f276-23c8-3e9a-85e8-9c208fe5f48a",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
                                            "A mistake or error.",
                                            "An illegal serve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "616e1836-bb00-4ef7-b0d3-4e0b26f88c42",
                                                "sense_id": "6b60f276-23c8-3e9a-85e8-9c208fe5f48a",
                                                "text": "It is a fault if the ball served drop in the net, or beyond the Service-Line, or if it drop out of Court, or in the wrong Court. A fault may not be taken. After a fault, the Server shall serve again from the same Court from which he served that fault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e09d4e-b877-3414-94a9-4e113a1fb432",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
