            {
                "entry_id": "ab1cb913-fbcc-3830-be9e-275fc4b5202a",
                "word": "Abecedarian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "471cc627-11da-4535-b64a-5ee31310d0f7",
                        "entry_id": "ab1cb913-fbcc-3830-be9e-275fc4b5202a",
                        "tags": [
                            "plural"
                        ],
                        "form": "Abecedarians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8dee7f7-fb63-3eb5-adb5-dbb9c88d5c59",
                        "entry_id": "ab1cb913-fbcc-3830-be9e-275fc4b5202a",
                        "glosses": [
                            "A member of a 16th-century Anabaptist sect, follower of the Zwickau prophets (and specially of Thomas Storch), who believed that any kind of knowledge (even basic reading and writing) would keep one from obtaining salvation."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "53f4c549-dbb0-441b-b5a6-018014c88618",
                                "sense_id": "c8dee7f7-fb63-3eb5-adb5-dbb9c88d5c59",
                                "text": "Behind the stable doors, where competitors frenziedly shine tack and polish hooves, Donna McNulty busies herself with her horse, Abecedarian."
                            },
                            {
                                "example_id": "bbc0dad0-6585-494d-8a89-f2bcc0c325a4",
                                "sense_id": "c8dee7f7-fb63-3eb5-adb5-dbb9c88d5c59",
                                "text": "Heckman has been analyzing data from two famous early-childhood intervention programs, the Abecedarian Project of the ’70s and the Perry Preschool project of the ’60s. Both have furnished ample evidence that, if you enroll very young children from poor families in programs that give both them and their parents an extra boost, then they grow up to be wealthier and healthier than their counterparts—less fat, less sick, better educated, and, for men, more likely to hold down a job."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "972c9ad0-172a-434b-857c-5ad05ee1bc23",
                        "source_entry_id": "ab1cb913-fbcc-3830-be9e-275fc4b5202a",
                        "source_sense_id": "c8dee7f7-fb63-3eb5-adb5-dbb9c88d5c59",
