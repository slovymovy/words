                                        "entry_id": "23be2848-f593-3904-aab2-690d87cadc0d",
                                        "glosses": [
                                            "Rapport, dans un triangle rectangle, de la longueur du côté adjacent à l’angle considéré par la longueur de l’hypoténuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf1bdf3-20da-4f95-88b2-490783fea0f0",
                                                "sense_id": "b7350a7b-a751-3717-82aa-f97ef636159e",
                                                "text": "Si dans un triangle rectangle on abaisse une perpendiculaire du sommet de l'angle droit sur l’hypoténuse, le rapport d'un segment d’hypoténuse à la longueur de l’hypoténuse est égal au carré du cosinus de l'angle adjacent au segment."
                                            }
                                        ]
                                    }
                                ]
