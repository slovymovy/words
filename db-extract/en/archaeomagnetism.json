                        "entry_id": "eaf1e980-ffdb-39d4-9ba2-c68a240431bf",
                        "glosses": [
                            "The magnetism induced by the Earth's magnetic field in magnetizable matter after heating to the Curie temperature; directional magnetism, thermoremanent magnetism."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
