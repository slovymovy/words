                        "examples": [
                            {
                                "example_id": "9b58d1c3-9a4d-4c49-ac63-e1841acdb7cf",
                                "sense_id": "d828e865-fb8f-34dc-a61e-c7b1c29b36da",
                                "text": "„Der letzte Winterschnee war bereits gefallen, und das Tauwetter würde gegen Mittag einsetzen.“"
                            },
                            {
                                "example_id": "274c7681-6c0a-434f-8af8-37ff54100cab",
                                "sense_id": "d828e865-fb8f-34dc-a61e-c7b1c29b36da",
                                "text": "„Winterschnee rieselte auf seinen verdorrten Schädel, auf die letzten noch darauf haftenden Haarbüschel; vorbeiziehende Jäger bemerkten ihn nicht, wie er mti seinen ausgetrockneten Gliedern dumpf vor sich hin baumelte.“"
                            }
                        ],
