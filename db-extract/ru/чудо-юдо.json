                        "examples": [
                            {
                                "example_id": "4c4aa341-7576-4765-b302-34f45cf495d4",
                                "sense_id": "397a3e77-60d3-3244-ab16-280b309026b1",
                                "text": "Эта мадам просто чудо-юдо на всю округу. — Самый главный профессор по танцулькам, — добавил Лука."
                            }
                        ]
                    }
