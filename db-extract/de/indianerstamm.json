                ],
                "senses": [
                    {
                        "sense_id": "1905e8a3-f5b7-3bee-8d38-d1340a344f45",
                        "entry_id": "710acf32-6490-31d6-a18f-f7f71847fe96",
                        "glosses": [
                            "Gruppe von Ureinwohnern Amerikas, welche sich durch bestimmte Gemeinsamkeiten auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f88e2b-4f83-4e34-be04-c37c14464eb7",
                                "sense_id": "1905e8a3-f5b7-3bee-8d38-d1340a344f45",
                                "text": "„Ohne diese Gewohnheit wären die Indianerstämme schon längst ganz vertilgt.“"
                            },
                            {
                                "example_id": "d03d8d39-7b56-47f3-91ed-dd14fd449f1f",
                                "sense_id": "1905e8a3-f5b7-3bee-8d38-d1340a344f45",
                                "text": "„Wahrscheinlich hatten sie dieselben von irgend einem Indianerstamme erhalten.“"
                            },
                            {
                                "example_id": "57045eb5-cbda-4e78-8ea3-37c413b2d5c3",
                                "sense_id": "1905e8a3-f5b7-3bee-8d38-d1340a344f45",
                                "text": "„Im Amazonasgebiet ist ein Indianerstamm entdeckt worden, der bislang praktisch keinen Kontakt mit der westlichen Zivilisation hatte.“"
                            },
                            {
                                "example_id": "ee1bb7db-dc8c-4066-81e8-bcef1600b2fa",
                                "sense_id": "1905e8a3-f5b7-3bee-8d38-d1340a344f45",
                                "text": "„So wurden beide Indianerstämme praktisch ausgerottet.“"
                            },
                            {
                                "example_id": "149420b3-2004-496e-b0ff-b313491fda0a",
                                "sense_id": "1905e8a3-f5b7-3bee-8d38-d1340a344f45",
                                "text": "„In solchen Hütten wohnen noch jezt die Irokesen und andere von der Nachbarschaft der Europäer entfernte Indianer-Stämme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
