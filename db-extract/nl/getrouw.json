                                "target_senses": [
                                    {
                                        "sense_id": "e9be8bb9-f0b2-3ac2-95ab-420285ba0355",
                                        "entry_id": "68098ecf-4fa6-34c8-a493-808053cf2acd",
                                        "glosses": [
                                            "The practicing members of a religion or followers of a cause."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d328ea5-2e45-45eb-a164-7ee40cac0197",
                                                "sense_id": "e9be8bb9-f0b2-3ac2-95ab-420285ba0355",
                                                "text": "The faithful pray five times a day."
                                            },
                                            {
                                                "example_id": "eb256c9a-1e11-4690-863f-661a7dd9d816",
                                                "sense_id": "e9be8bb9-f0b2-3ac2-95ab-420285ba0355",
                                                "text": "We Fremen have a saying: God created Arrakis to train the faithful. One cannot go against the word of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91da683-4ef6-3a44-8b53-bb53291feec7",
                                        "entry_id": "68098ecf-4fa6-34c8-a493-808053cf2acd",
                                        "glosses": [
                                            "Someone or something that is faithful or reliable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11091a30-c0cb-4b43-bff5-823e83ac5f83",
                                                "sense_id": "d91da683-4ef6-3a44-8b53-bb53291feec7",
                                                "text": "Earlier this year, as the recession put a damper on ticket sales, Maxwell said the easy route would have been to go for the tried-and-true old faithfuls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
