                    {
                        "sense_id": "50fc7fc7-2d1a-3c79-b82d-cf46d962729e",
                        "entry_id": "c49bd25c-0dcb-308b-9d6f-158e58e89243",
                        "glosses": [
                            "Cloth made from cotton and treated with oil and pigment to make it waterproof."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f4202a70-c923-3d3d-8f20-9f9c58bf66ab",
                        "entry_id": "c49bd25c-0dcb-308b-9d6f-158e58e89243",
                        "glosses": [
                            "A raincoat made from cotton fabric treated with oil and pigment to make it waterproof."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ad9d128-1228-4fda-aaa1-0e236f968f71",
                                "sense_id": "f4202a70-c923-3d3d-8f20-9f9c58bf66ab",
                                "text": "I noticed Larry to-day had on two vests, two coats, and an overcoat with his oilskin outside of that."
                            },
                            {
                                "example_id": "dff90a16-a7cd-4f3b-9e2b-b7eeb586fead",
                                "sense_id": "f4202a70-c923-3d3d-8f20-9f9c58bf66ab",
                                "text": "He was preparing to venture out again, when Gaskin opened a locker and brought out an oilskin.\n“Hit'll 'elp you keep dry, sir,” holding up the garment."
                            }
                        ]
                    },
                    {
                        "sense_id": "58fc72d7-854a-315b-ad7e-8dda8f21a566",
                        "entry_id": "c49bd25c-0dcb-308b-9d6f-158e58e89243",
                        "glosses": [
                            "Foul-weather gear worn by sailors, whether of natural or synthetic materials."
