                        "glosses": [
                            "Donner un caractère archétypal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f111f4e-7e38-4255-a208-99b84ce2e02e",
                                "sense_id": "9fa3454e-bcd1-361c-8295-72ea9eb5c6e4",
                                "text": "\"Du simple fait d'être cité, l'environnement, cliché familier, est archétypalisé\""
                            },
                            {
                                "example_id": "ca689235-b165-44d7-a815-6ad4f1ace00a",
                                "sense_id": "9fa3454e-bcd1-361c-8295-72ea9eb5c6e4",
                                "text": "Le fonctionnement de cet ensemble cortex-neurones est assuré d’une part par l’information directe, et d’autre part par la transmission héréditaire, « archétypalisant » les répertoires acquis et constamment agrandis dont nous ne récupérons pour le moment qu’un fragment minime."
                            }
                        ]
                    }
