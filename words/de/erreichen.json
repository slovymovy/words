                    ],
                    "antonyms": [
                        "verfehlen"
                    ],
                    "common_phrases": [
                        "ein Ziel erreichen",
                        "eine Einigung erreichen",
                        "ein hohes Alter erreichen"
                    ]
                }
            ]
        },
        {
