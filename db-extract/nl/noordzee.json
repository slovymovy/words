        "nl-extract.jsonl": [
            {
                "entry_id": "4c2cf8a1-3021-3d99-a774-f11a113fe77c",
                "word": "Noordzee",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5113d44a-1797-3d49-aac2-58442ceb6950",
                        "entry_id": "4c2cf8a1-3021-3d99-a774-f11a113fe77c",
                        "glosses": [
                            "zee tussen Groot-Brittannië, Noorwegen, Denemarken, Duitsland, Nederland en België"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "1377d472-7852-4d45-bfe6-77d2ee80bd62",
                                "sense_id": "5113d44a-1797-3d49-aac2-58442ceb6950",
                                "text": "'Ze hebben samen een paar van de ergste stormen overleefd die de Noordzee ooit hebben geteisterd."
                            },
                            {
                                "example_id": "69af0d55-06dc-4fd1-af56-ba1160b9a853",
                                "sense_id": "5113d44a-1797-3d49-aac2-58442ceb6950",
                                "text": "Om zes uur had de vertrouwde stem van de radionieuwslezer in onze huiskamer geklonken met het nieuws en het weerbericht: Boven het noordelijk en westelijk deel van de Noordzee woedt een zware storm tussen noordwest en noord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36b0c33c-7fe6-4614-88cc-b4607552ef3b",
                        "source_entry_id": "4c2cf8a1-3021-3d99-a774-f11a113fe77c",
                        "source_sense_id": "5113d44a-1797-3d49-aac2-58442ceb6950",
                        "source_sense_description": "zee tussen Groot-Brittannië, Noorwegen, Denemarken, Duitsland, Nederland en België",
                        "target_lang_word": "Nordsee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordsee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d06a3771-fd41-3d9d-a1fb-7bc60c1fc7d9",
                                        "entry_id": "de1a3fbc-33e3-3fd7-b7d5-0c1d641eb312",
                                        "glosses": [
                                            "ein Randmeer des Atlantiks im Nordwesten Europas zwischen Großbritannien, den Niederlanden, Deutschland, Dänemark und Norwegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3715da59-acf4-41a2-86ba-fa3b52a0e98f",
                                                "sense_id": "d06a3771-fd41-3d9d-a1fb-7bc60c1fc7d9",
                                                "text": "Die Nordsee ist bei Sturm sehr rau."
                                            },
                                            {
                                                "example_id": "ec735c90-873f-4959-b150-ad90c8619aa6",
                                                "sense_id": "d06a3771-fd41-3d9d-a1fb-7bc60c1fc7d9",
                                                "text": "„Endlich, am späten Nachmittag, kamen Flugzeuge, einige Spitfire und Mustangs, die aus Richtung Flensburg oder Schleswig hereindrehten, um im Tiefflug über uns hinwegzuflitzen und auf die Nordsee hinaus zu verschwinden.“"
                                            },
                                            {
                                                "example_id": "a5d1797e-d1c0-42ef-a8d8-2477bea517de",
                                                "sense_id": "d06a3771-fd41-3d9d-a1fb-7bc60c1fc7d9",
                                                "text": "Unseren letzten Urlaub verbrachten wir an der Nordsee."
                                            },
                                            {
                                                "example_id": "d8f79798-5256-44df-a844-9db969146713",
                                                "sense_id": "d06a3771-fd41-3d9d-a1fb-7bc60c1fc7d9",
                                                "text": "Das Lagerfeuer an der Nordsee erlosch erst am frühen Morgen."
                                            },
                                            {
                                                "example_id": "25e432af-3fe0-40d3-ac56-becab918b559",
                                                "sense_id": "d06a3771-fd41-3d9d-a1fb-7bc60c1fc7d9",
                                                "text": "„Die Nordsee hat unaufhörlich an Helgoland genagt und manchmal auch gierig zugeschlagen, wie im Jahr 1721, als die Insel durch einen Sturm endgültig in zwei Teile zerbrach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5654d346-94f0-46f4-9fdd-d7c554296aa3",
                        "source_entry_id": "4c2cf8a1-3021-3d99-a774-f11a113fe77c",
                        "source_sense_id": "5113d44a-1797-3d49-aac2-58442ceb6950",
                        "source_sense_description": "zee tussen Groot-Brittannië, Noorwegen, Denemarken, Duitsland, Nederland en België",
                        "target_lang_word": "North Sea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "North Sea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b6ef344-497b-398e-9daf-4c8a50a1dd24",
                                        "entry_id": "c06eccdc-6909-3620-8adf-a3100c0536bf",
                                        "glosses": [
                                            "A marginal sea of the Atlantic Ocean between Britain (in the west), Scandinavia (in the east) and Germany, Netherlands, Belgium and France (in the south)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc78febf-1ee8-43b1-b73e-fa023b0cc20c",
                                                "sense_id": "9b6ef344-497b-398e-9daf-4c8a50a1dd24",
                                                "text": "Ypres was not the actual start of the front; that distinction belongs to Nieuport, a city on the North Sea twentyodd miles down the river Yser from Ypres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d38b02b-92c7-448c-b2b7-e975181d1ea5",
                        "source_entry_id": "4c2cf8a1-3021-3d99-a774-f11a113fe77c",
                        "source_sense_id": "5113d44a-1797-3d49-aac2-58442ceb6950",
                        "source_sense_description": "zee tussen Groot-Brittannië, Noorwegen, Denemarken, Duitsland, Nederland en België",
                        "target_lang_word": "mer du Nord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mer du Nord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f4cee89-ecce-3103-aed0-c3daac960c7e",
                                        "entry_id": "0da001a7-31cf-316c-a18d-e055f5945d7b",
                                        "glosses": [
                                            "Mer épicontinentale de l’océan Atlantique, bordée par les îles Shetland, l’océan Atlantique et les îles Orcades au nord-ouest, par la Grande-Bretagne à l’ouest, par la Manche, la France, la Belgique et les Pays-Bas au sud, par l’Allemagne au sud-est, par le Danemark et le Skagerrak à l’est, par la Norvège au nord-est et par la mer de Norvège au nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f80ea8-b4a8-40b6-8b03-dbdb4e266146",
                                                "sense_id": "6f4cee89-ecce-3103-aed0-c3daac960c7e",
                                                "text": "L’« éventrement » d’un supertanker menace la vie d’un petit équipage, mais pollue une fraction notable de la Manche ou de la mer du Nord."
                                            },
                                            {
                                                "example_id": "90fba6d7-1c63-4e1a-95c7-3fd352fe8d04",
                                                "sense_id": "6f4cee89-ecce-3103-aed0-c3daac960c7e",
                                                "text": "Ainsi, il a décidé de construire un cinquième terminal flottant d’importation de gaz naturel liquéfié (GNL) dans le port de Wilhemshaven, sur la mer du Nord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c76d157-cf33-3848-a348-89119e46a770",
                                        "entry_id": "0da001a7-31cf-316c-a18d-e055f5945d7b",
                                        "glosses": [
                                            "Atlantique Nord."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478a6504-36e8-4eaf-8c66-ee634938fbc5",
                                                "sense_id": "4c76d157-cf33-3848-a348-89119e46a770",
                                                "text": "La Guiane espagnole s’étendait le long de la mer du Nord, depuis les bouches de l’Amazone jusqu’au-delà de celles de l’Orénoque, l’espace de cent vingt lieues, et embrassait tout le pays situé entre ces deux fleuves et le Rio-Négro, affluent du premier, qui communique avec le dernier par le Casiquiari, lequel sépare la Guiane du reste du continent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
