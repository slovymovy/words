                "senses": [
                    {
                        "sense_id": "0ab5f81d-23ec-358f-ba3e-0b61998c8fa9",
                        "entry_id": "938554b3-ce82-30fe-b9cb-4ac938a6cb07",
                        "glosses": [
                            "кулин. сладкое кушанье из взбитой в пену фруктовой, ягодной, шоколадной и т. п. массы с манной крупой или желатином"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296bead6-ff82-423f-a78e-477807bc1588",
                                "sense_id": "0ab5f81d-23ec-358f-ba3e-0b61998c8fa9",
                                "text": "Шоколадный мусс."
                            },
                            {
                                "example_id": "6847eb4e-58d6-411a-b81d-dc390593bac6",
                                "sense_id": "0ab5f81d-23ec-358f-ba3e-0b61998c8fa9",
                                "text": "Кормит нас Эмилия рябчиками, глухарями, пломбирами, фруктовыми муссами, золотыми ромовыми бабами."
                            }
                        ]
                    },
                    {
                        "sense_id": "49f2855f-0573-3178-b39b-fb5ef947319c",
                        "entry_id": "938554b3-ce82-30fe-b9cb-4ac938a6cb07",
                        "glosses": [
                            "спец. пена для укладки, крем для бритья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749c7b56-f954-4ae9-b10c-2cc0e0994172",
                                "sense_id": "49f2855f-0573-3178-b39b-fb5ef947319c",
                                "text": "Нанеси на волосы мусс или пенку для укладки и высуши феном, слегка приподнимая у корней."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ac53367-e762-4696-bc25-8d67022ec864",
                        "source_entry_id": "938554b3-ce82-30fe-b9cb-4ac938a6cb07",
