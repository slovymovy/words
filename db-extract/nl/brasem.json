                                    {
                                        "sense_id": "c9eee6a1-72e7-3a3c-88df-037cc5333413",
                                        "entry_id": "10955183-a18f-3e0c-9ab0-0db4a5a30b02",
                                        "glosses": [
                                            "bis zu 70 cm langer Karpfenfisch, der in Seen und sehr langsam fließenden Flüssen in Europa und Teilen Asiens lebt"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c667f0db-37e3-455e-a722-32cce2051fff",
                                                "sense_id": "c9eee6a1-72e7-3a3c-88df-037cc5333413",
                                                "text": "Brachsen fange ich nicht so gerne, weil sie so viele Gräten haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "943c46e4-738c-4289-86af-7aaf2af9102f",
                        "source_entry_id": "1a46fed9-59a2-3082-bbcc-1fb50d061464",
                        "source_sense_id": "3ae58afc-426d-31b3-a5b2-d227e9ad026c",
                        "source_sense_description": "bepaalde karperachtige vissoort Abramis brama",
                        "target_lang_word": "Brasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                        "entry_id": "bc744deb-2223-3af1-a6ce-e4b27244f22d",
                                        "glosses": [
                                            "bis zu 70 cm langer Karpfenfisch, der in Seen und sehr langsam fließenden Flüssen in Europa und Teilen Asiens lebt"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386813d5-3775-4baa-8eee-faef7b180e02",
                                                "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                                "text": "„Nach Malickis Erfahrungen und den jährlichen Dokumentationen der Bestände seien die Arten in den Gewässern gleich geblieben, darunter Barsch, Brasse, Forelle, Hecht, Karpfen, Rotauge und Zander.“"
                                            },
                                            {
                                                "example_id": "a146cc23-b304-48f1-b6a0-79b371bbe856",
                                                "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                                "text": "„Als Speisefisch sei die Brasse in der Region nicht absetzbar gewesen.“"
                                            },
                                            {
                                                "example_id": "207034dc-a4d6-48e7-96c3-4c989c6f7f57",
                                                "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                                "text": "„Am Nachmittag ging Walt zur Brücke an der Holzfällerstraße, wohin die Neger nach der Arbeit zum Fischen kommen, und von einem Negerjungen erstand er für zwei Zigaretten eine kleine Brasse, die er geangelt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a75c776-8e91-3b42-ac0a-c06e21e5f275",
                                        "entry_id": "b3861e54-04eb-362d-b304-a6ddf66f68ff",
                                        "glosses": [
                                            "Tau, das zum laufenden Gut eines Rahseglers gehört"
                                        ],
                                        "tags": [
                                            "Segeln",
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac7a2ba4-89bb-4827-bc60-a94ae2b49448",
                                                "sense_id": "4a75c776-8e91-3b42-ac0a-c06e21e5f275",
                                                "text": "„Üblich ist es, an einer Nock einer Rahe ein Nockstropp fester Länge von beispielsweise 2 bis 3 m anzuordnen, an dessen Ende sich ein Brassenumlenkblock befindet, durch den eine Brasse läuft, die für die Rahen des Großmastes seitlich am Besanmast vorbei zu einem Brassenbaum geführt wird.“"
                                            },
                                            {
                                                "example_id": "50148db7-8a55-45d6-90f4-4caa2b973687",
                                                "sense_id": "4a75c776-8e91-3b42-ac0a-c06e21e5f275",
                                                "text": "„Mit Tauen – den sogenannten Brassen – wurde es in die passende Stellung zum Wind gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd81ea7-db29-3454-bed0-b66b96203cbd",
                                        "entry_id": "fb09964a-02ec-383c-83b7-d1b45f5426ba",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb8aa043-f4e1-4bba-a7bb-df4afe012298",
                                                "sense_id": "fdd81ea7-db29-3454-bed0-b66b96203cbd",
                                                "text": "Frau Brasse stellt in der Galerie am Marktplatz aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b68b0db-161b-4543-9d01-9c22aa633096",
                        "source_entry_id": "1a46fed9-59a2-3082-bbcc-1fb50d061464",
                        "source_sense_id": "3ae58afc-426d-31b3-a5b2-d227e9ad026c",
                        "source_sense_description": "bepaalde karperachtige vissoort Abramis brama",
                        "target_lang_word": "Blei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6efe287-1ee6-3d1d-b30a-e4541a6923e8",
                                        "entry_id": "ecbc6b49-be1a-34d7-9ed2-7ce68644ad69",
                                        "glosses": [
                                            "silbernes, leicht verformbares, toxisch wirkendes Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d41058b-89b3-4182-a936-3e884a4f5302",
                                                "sense_id": "e6efe287-1ee6-3d1d-b30a-e4541a6923e8",
                                                "text": "„Mehr als das Blei in der Flinte hat das Blei im Setzkasten die Welt verändert.“"
                                            },
                                            {
                                                "example_id": "2d1f0a91-3a8e-44d3-abf5-f471da36231b",
                                                "sense_id": "e6efe287-1ee6-3d1d-b30a-e4541a6923e8",
                                                "text": "„Im Gegensatz zu früheren Zeiten, als Blei eines der wichtigsten und meistverwendeten Metalle war, versucht man heute, Blei durch andere, ungiftige Elemente oder Legierungen zu ersetzen.“"
                                            },
                                            {
                                                "example_id": "4d3ce122-1a2c-43bc-a601-c6ba8725d33c",
                                                "sense_id": "e6efe287-1ee6-3d1d-b30a-e4541a6923e8",
                                                "text": "„Der Diener Hubermann wiegt Antimon und Blei ab.“"
                                            },
                                            {
                                                "example_id": "1810110d-0e61-43aa-be6f-32141caade5e",
                                                "sense_id": "e6efe287-1ee6-3d1d-b30a-e4541a6923e8",
                                                "text": "„Die Fenster saßen hoch oben in den Wänden, mit kleinen, in Blei eingefaßten Scheiben, die nicht mehr Tageslicht hereinließen, als daß ein dünnes Talglicht auf dem Pult brennen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a2ba0a2-eb23-3863-9ba9-fa00f589787e",
                                        "entry_id": "ecbc6b49-be1a-34d7-9ed2-7ce68644ad69",
                                        "glosses": [
                                            "Geschoss oder Geschosse von Handfeuerwaffen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4971f340-af82-41e6-9269-d462b15b1625",
                                                "sense_id": "6a2ba0a2-eb23-3863-9ba9-fa00f589787e",
                                                "text": "„Ihr wollt Geschenke, besonders Munition, um zu jagen. […] Aber ihr bekommt kein Pulver und Blei, denn ihr habt vor kurzem friedliche Leute damit getötet.“"
                                            },
                                            {
                                                "example_id": "3532cdb2-2bf2-4619-b098-efca09796f1a",
                                                "sense_id": "6a2ba0a2-eb23-3863-9ba9-fa00f589787e",
                                                "text": "„»Ich will dich mit Blei vollpumpen, verfluchter Mormone«, schrie ich, halb weinend, ehe meine Mutter mich zum Schweigen bringen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Blei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4f2e86b-13c1-3fe6-8fd7-f19f6af98a61",
                                        "entry_id": "5f19e6c1-dc61-3749-b0ee-491cf7ec590a",
                                        "glosses": [
                                            "ein Karpfenfisch"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eadbf5a-4aed-47f0-9342-9fb8107f5827",
                                                "sense_id": "e4f2e86b-13c1-3fe6-8fd7-f19f6af98a61",
                                                "text": "Ich habe nur einen Blei gefangen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
