{
    "word_family": [
        "bristle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8113714a-34ca-3d1c-a06b-eae5bdbe141b",
                    "sense_definition": "Covered with or having stiff, coarse hairs or bristles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bristling</w> brush was perfect for scrubbing the rough stone floor.",
                            "target_lang_translations": {
                                "nl": "De <w>borstelige</w> borstel was perfect voor het schrobben van de ruwe stenen vloer."
                            }
                        },
                        {
                            "text": "He touched the <w>bristling</w> chin of the old man.",
                            "target_lang_translations": {
                                "nl": "Hij raakte de <w>stekelige</w> kin van de oude man aan."
                            }
                        }
                    ],
                    "synonyms": [
                        "spiky",
                        "prickly"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedekt met of voorzien van stijve, grove haren of borstelharen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "borstelig",
                                "target_lang_sense_clarification": "met stijve haren"
                            },
                            {
                                "target_lang_word": "stekelig",
                                "target_lang_sense_clarification": "met scherpe, stijve punten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e75f4e-7166-3b9b-8db9-adbdd5b86920",
                    "sense_definition": "Showing signs of intense anger, indignation, or defensive aggression.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She left the room <w>bristling</w> with indignation after the unfair criticism.",
                            "target_lang_translations": {
                                "nl": "Ze verliet de kamer, <w>vol verontwaardiging</w> na de oneerlijke kritiek."
                            }
                        },
                        {
                            "text": "The politician gave a <w>bristling</w> response to the reporter's difficult question.",
                            "target_lang_translations": {
                                "nl": "De politicus gaf een <w>geïrriteerde</w> reactie op de moeilijke vraag van de verslaggever."
                            }
                        }
                    ],
                    "synonyms": [
                        "furious",
                        "indignant"
                    ],
                    "common_phrases": [
                        "bristling with anger"
                    ],
                    "target_lang_definitions": {
                        "nl": "Tekenen vertonend van intense woede, verontwaardiging of defensieve agressie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "woedend",
                                "target_lang_sense_clarification": "zeer boos"
                            },
                            {
                                "target_lang_word": "verontwaardigd",
                                "target_lang_sense_clarification": "gekwetst en boos door onrecht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b167e49-f7a6-32a1-952c-a62efbe0918c",
                    "sense_definition": "The present participle and gerund of <w>bristle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat was <w>bristling</w> at the sight of the strange dog.",
                            "target_lang_translations": {
                                "nl": "De kat <w>zette de haren overeind</w> bij het zien van de vreemde hond."
                            }
                        },
                        {
                            "text": "He is <w>bristling</w> at the suggestion that he made a mistake.",
                            "target_lang_translations": {
                                "nl": "Hij <w>windt zich op</w> over de suggestie dat hij een fout heeft gemaakt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het overeind zetten van haren (als teken van angst of woede) of defensief reageren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich opwinden",
                                "target_lang_sense_clarification": "geïrriteerd of defensief reageren"
                            },
                            {
                                "target_lang_word": "de haren overeind zetten",
                                "target_lang_sense_clarification": "fysieke reactie van een dier"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c02f9f9-4e92-3a9d-a1b9-7df3e0279d02",
                    "sense_definition": "The act or state of showing sudden anger or defensive posture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal's <w>bristling</w> was a clear warning to stay away.",
                            "target_lang_translations": {
                                "nl": "Het <w>overeind zetten van de haren</w> van het dier was een duidelijke waarschuwing om uit de buurt te blijven."
                            }
                        },
                        {
                            "text": "His <w>bristling</w> at the comment showed how sensitive he was about the topic.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>geïrriteerde reactie</w> op de opmerking liet zien hoe gevoelig hij was over het onderwerp."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling of toestand van het tonen van plotselinge woede of een defensieve houding."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opwinding",
                                "target_lang_sense_clarification": "geïrriteerde reactie"
                            },
                            {
                                "target_lang_word": "defensieve houding",
                                "target_lang_sense_clarification": "het aannemen van een verdedigende positie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}