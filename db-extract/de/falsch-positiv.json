                "senses": [
                    {
                        "sense_id": "4e8b8153-84ff-3621-9d52-d7abfbecf657",
                        "entry_id": "5c4a6060-df4d-341f-9645-8a835084e4c1",
                        "glosses": [
                            "fälschlicherweise (falsch) als zutreffend (positiv) angegeben, als infiziert/erkrankt ausgewiesen, obwohl dies nicht der Fall ist"
                        ],
                        "tags": [
                            "über ein Testergebnis",
                            "bei einer Infektionskrankheit"
                        ],
                        "examples": [
                            {
                                "example_id": "3a28908d-39d7-4317-8cf6-76c04fc7416d",
                                "sense_id": "4e8b8153-84ff-3621-9d52-d7abfbecf657",
                                "text": "Der falsch-positive Befund liegt vor, wenn der Patient gesund ist, aber der Test ihn fälschlicherweise als krank eingestuft hat."
                            },
                            {
                                "example_id": "9e733d09-cddd-4b87-8497-fab939d627ca",
                                "sense_id": "4e8b8153-84ff-3621-9d52-d7abfbecf657",
                                "text": "„Die Rate an falsch-positiven Ergebnissen ist ein Kriterium für die Qualität einer diagnostischen Methode und sollte möglichst niedrig liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
