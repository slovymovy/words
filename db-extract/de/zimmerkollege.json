                        "source_sense_id": "d1724990-e808-33f9-b296-a5fc9a693317",
                        "source_sense_description": "jemand, mit dem man sein Zimmer teilt",
                        "target_lang_word": "slapie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slapie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3aa74938-25b2-3df5-8608-732e7ec0e747",
                                        "entry_id": "a28ebde3-195d-3ee9-a0d9-9f44786b460b",
                                        "glosses": [
                                            "ook buiten de krijgsmacht gangbaar geworden: iemand waarmee men een slaapvertrek deelt en die daarom vaak een goede kameraad is geworden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8598158-ec95-41d5-9044-5e4546ecb545",
                                                "sense_id": "3aa74938-25b2-3df5-8608-732e7ec0e747",
                                                "text": "Ze sliepen de afgelopen week samen op een kleine hotelkamer, Chris en Wout. Voor wielrenners is het niet ongewoon om een slapie te hebben."
                                            },
                                            {
                                                "example_id": "e58b4f3c-98ef-42bd-b04c-047544a76dcc",
                                                "sense_id": "3aa74938-25b2-3df5-8608-732e7ec0e747",
                                                "text": "⧖ De «praatjesmaker” wordt voor de grootste helft door zijn kameraden zelf ontbolsterd. Het «slapie” van den oud-miliciën (…) schijnt zoo’n exemplaar te zijn geweest; (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a350767-9955-330e-a1d6-747d53c98869",
                                        "entry_id": "a28ebde3-195d-3ee9-a0d9-9f44786b460b",
                                        "glosses": [
                                            "slaapje"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608c8345-9362-4a72-861e-624767b8bbc2",
                                                "sense_id": "7a350767-9955-330e-a1d6-747d53c98869",
                                                "text": "‘Alla,’ zei Tijmen Snoek, ‘nou de kattekop uit en Dirk 't eerst op wacht. We gaan 'n slapie doen, mannen. Jij Jaap, vóórin de kooi.’\nDat liet Jaap zich geen tweemaal zeggen.\nHij klom op de tweede stroomatras en strekte z'n leden behaaglijk uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
