                ],
                "senses": [
                    {
                        "sense_id": "fa367b3a-d515-3968-a3e0-ca4127c9ffa1",
                        "entry_id": "fbd17724-2b6a-368a-9160-102e01cb7be8",
                        "glosses": [
                            "Border au vent, du bord opposé à celui où on veut venir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5cb050-38af-4f09-8429-522b5b0e0d65",
                                "sense_id": "fa367b3a-d515-3968-a3e0-ca4127c9ffa1",
                                "text": "Pour abattre, il faut hisser la misaine, et éventuellement la contre-border, c'est à dire la border au vent, du bord opposé à celui où on veut venir ; mais pas trop tôt : si on prend de la vitesse avant que l'ancre soit à fleur de peau, elle risque d'être prise sous la quille."
                            },
                            {
                                "example_id": "ff7a0fab-1702-4d90-a4ce-2d949fb14f70",
                                "sense_id": "fa367b3a-d515-3968-a3e0-ca4127c9ffa1",
                                "text": "Des conditions particulièrement musclées donc, dans lesquelles il a fallu penser à ménager sa monture mais aussi à contre-border au meilleur moment pour dépasser le cap Finisterre."
                            },
                            {
                                "example_id": "61610ba6-1a38-4605-87ec-a034547ca12b",
                                "sense_id": "fa367b3a-d515-3968-a3e0-ca4127c9ffa1",
                                "text": "On sera obligé, une fois dans le sud, de contre-border et de faire une route vers Bonne Espérance à une latitude qui sera assez basse."
                            },
                            {
                                "example_id": "bd534067-eacc-4fa7-aaa9-31200d3d66e8",
                                "sense_id": "fa367b3a-d515-3968-a3e0-ca4127c9ffa1",
                                "text": "On contre-borde le Cap-Fragnet."
                            }
                        ]
                    }
                ],
