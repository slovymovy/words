                        "source_entry_id": "8501d4df-2a07-386e-8f9f-d57230899b04",
                        "source_sense_id": "65f04cd9-12ab-30e7-b071-6095b90eb072",
                        "target_lang_word": "absurdist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurdist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a65057ab-7a04-3a10-8446-55a340413bca",
                                        "entry_id": "16f68be2-73cf-3476-9a9d-fef61986b311",
                                        "glosses": [
                                            "An advocate of absurdism, in particular a writer of absurd topics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc5708f-61de-4f44-a6fb-e9b9be5009da",
                                                "sense_id": "a65057ab-7a04-3a10-8446-55a340413bca",
                                                "text": "The basic assumptions of our way of life as we traditionally justified it are being questioned by that revolt of the young absurdists."
                                            },
                                            {
                                                "example_id": "6a6feae4-5d01-4cc3-85c1-05daf09f3c7c",
                                                "sense_id": "a65057ab-7a04-3a10-8446-55a340413bca",
                                                "text": "But Mr. Albert was a leader of the Yippies, inasmuch as there were leaders, from before the formal hatching of the self-styled gang of political absurdists in January 1968 until they faded away after Vietnam."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absurdist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "146f3ba0-77a7-390b-a8e1-c0669f7974a4",
                                        "entry_id": "e3f8fa44-b4e7-369d-91aa-af03003f81aa",
                                        "glosses": [
                                            "Of, or relating to absurdism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50d6cbc6-1e79-4313-808e-230493d8f8da",
                                                "sense_id": "146f3ba0-77a7-390b-a8e1-c0669f7974a4",
                                                "text": "The tragically backward, sometimes absurdist hallmarks of the People's Democratic Republic of Korea and in particular its leader, Kim Jong Il, are well known. There's Kim's Elton John eyeglasses and cotton-candy hairdo, for instance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
