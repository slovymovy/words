                "senses": [
                    {
                        "sense_id": "18bb88f6-ba68-372f-b3b8-cbd4809ff952",
                        "entry_id": "02ca2c38-40c0-30c3-8d70-bf89d8ab305c",
                        "glosses": [
                            "een hele zware en gevaarlijke reis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a861b952-9452-4dec-ad44-e0db99e42680",
                                "sense_id": "18bb88f6-ba68-372f-b3b8-cbd4809ff952",
                                "text": "Het vervoer naar de slachterij noemt de Dierenbescherming \"een helletocht\". De dieren worden in plastic kratten vervoerd. In ieder krat worden tien tot vijftien kippen gepropt en daarbij lopen veel kippen botbreuken en andere verwondingen op."
                            },
                            {
                                "example_id": "4d85e32c-ddf0-4370-9fc2-5a5e8a395824",
                                "sense_id": "18bb88f6-ba68-372f-b3b8-cbd4809ff952",
                                "text": "Het is bekend hoe de opmars van Napoleons Grande Armée in Rusland verliep. Op de tentoonstelling is een schilderij uit het Russische Winterpaleis te zien dat de helletocht nog eens onderstreept. In de Slag bij de Berezina verloor Napoleon tienduizenden militairen."
                            },
                            {
                                "example_id": "e6178188-a855-473e-8811-5acdbb8327c4",
                                "sense_id": "18bb88f6-ba68-372f-b3b8-cbd4809ff952",
                                "text": "De roman gaat over een groep verwilderde vluchtelingen, de in een grensstad op de steppe angst en onrust veroorzaken. Pontus Beg, commissaris van politie, laat de groep oppakken. Hij ontrafelt de geschiedenis van hun helletocht, die gaandeweg verweven raakt met de ontdekking van het verhaal over zijn eigen afkomst."
                            }
                        ]
                    }
