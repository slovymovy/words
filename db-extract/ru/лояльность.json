                                "sense_id": "40825e85-c812-37d2-8bc1-0ff0384abd50",
                                "text": "лояльность по отношению к государству",
                                "translation": "loyalty to the state",
                                "english": "loyalty to the state"
                            }
                        ]
                    },
                    {
                        "sense_id": "43dbaacb-affa-35d7-b577-229331ddc4e3",
                        "entry_id": "b4126f0a-3bfb-3c69-9604-3ae3ab6d9f00",
                        "glosses": [
                            "benevolence, good intentions"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26702cec-f79e-44b7-8ad4-7a33017d4c84",
                                "sense_id": "43dbaacb-affa-35d7-b577-229331ddc4e3",
                                "text": "несмотря на заверения нового руководства в лояльности по отношению к населению острова",
                                "translation": "despite the assurances of the new leaders of good intentions toward the people of the island",
                                "english": "despite the assurances of the new leaders of good intentions toward the people of the island"
                            }
                        ]
                    },
                    {
                        "sense_id": "aa0d1322-87b7-344e-bfab-77c89f793131",
                        "entry_id": "b4126f0a-3bfb-3c69-9604-3ae3ab6d9f00",
                        "glosses": [
                            "accommodativeness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43d10c7-b4de-45fb-94c2-64bb17fb0da1",
                                "sense_id": "aa0d1322-87b7-344e-bfab-77c89f793131",
                                "text": "Китай проявляет достаточную лояльность и гибкость и со своими партнёрами, и с оппонентами.",
                                "translation": "China is showing ample accommodativeness and flexibility toward both partners and adversaries.",
                                "english": "China is showing ample accommodativeness and flexibility toward both partners and adversaries."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c93e8a8-8aef-379b-9812-7e8cda264d98",
                        "entry_id": "b4126f0a-3bfb-3c69-9604-3ae3ab6d9f00",
                        "glosses": [
                            "lenience, laxity, indulgence, permissiveness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b141a112-e81e-465b-9c89-1090fcedb372",
                                "sense_id": "9c93e8a8-8aef-379b-9812-7e8cda264d98",
                                "text": "Родители проявляют либо излишнюю лояльность, либо строгость в выборе наказания для ребенка.",
                                "translation": "Parents show either excessive lenience or strictness in choosing punishments for a child.",
                                "english": "Parents show either excessive lenience or strictness in choosing punishments for a child."
                            }
                        ]
                    }
                ],
