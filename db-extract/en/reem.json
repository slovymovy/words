                                "target_senses": [
                                    {
                                        "sense_id": "d347a54c-78df-3e25-97e5-933fa46d7c62",
                                        "entry_id": "056bfb94-3e47-3ebd-98b6-239dc89f0836",
                                        "glosses": [
                                            "краткая форма мужского рода единственного числа прилагательного единорогий"
                                        ],
