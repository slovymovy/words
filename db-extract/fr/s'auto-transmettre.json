                ],
                "senses": [
                    {
                        "sense_id": "95f5c259-c1d8-3b03-970b-8ed14f91bd7c",
                        "entry_id": "5eaf9c02-57b7-31d1-8fc5-7a00c4fcb5eb",
                        "glosses": [
                            "Se transmettre à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "861b9e2c-7c4e-4d0a-bc8b-3f85741f4ffe",
                                "sense_id": "95f5c259-c1d8-3b03-970b-8ed14f91bd7c",
                                "text": "Tu ne peux pas t'auto-transmettre le vih de toute façon..."
                            }
                        ]
                    },
                    {
                        "sense_id": "390ac92b-054a-39ad-8db1-97a22cb84b7e",
                        "entry_id": "5eaf9c02-57b7-31d1-8fc5-7a00c4fcb5eb",
                        "glosses": [
                            "Se transmettre automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eca02e7d-fc51-45f1-a010-0a2d1e83fb65",
                                "sense_id": "390ac92b-054a-39ad-8db1-97a22cb84b7e",
                                "text": "Il se répand comme une trainée de poudre en utilisant le carnet d'adresse de l'ordinateur infecté pour s'auto-transmettre et, avant qu'un antivirus soit en mesure de la repérer et de l'éradiquer, celui-ci s'est déjà propagé sur des millions d'ordinateurs."
                            },
                            {
                                "example_id": "1b40f25b-9844-4122-a48a-15fdfa406cf2",
                                "sense_id": "390ac92b-054a-39ad-8db1-97a22cb84b7e",
                                "text": "Un virus est un programme qui s'auto-transmet à l'insu de celui qui va le subir, là non plus ce n'est pas le cas."
                            }
                        ]
                    }
