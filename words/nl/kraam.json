            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9cc77b1-2bfd-32f4-a660-ab333c15e733",
                    "sense_definition": "Een verplaatsbare tent of tafel op een markt of kermis waar goederen worden verkocht.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verkoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de wekelijkse markt staat een <w>kraam</w> met verse groenten en fruit.",
                            "target_lang_translations": {
                                "en": "At the weekly market, there is a <w>stall</w> with fresh vegetables and fruit.",
                                "ru": "На еженедельном рынке стоит <w>лавка</w> со свежими овощами и фруктами."
                            }
                        },
                        {
                            "text": "Ik kocht een warme wafel bij de <w>kraam</w> op de kermis.",
                            "target_lang_translations": {
                                "en": "I bought a warm waffle at the <w>booth</w> at the fair.",
                                "ru": "Я купил теплую вафлю в <w>палатке</w> на ярмарке."
                            }
                        }
                    ],
                    "synonyms": [
                        "marktkraam"
                    ],
                    "common_phrases": [
                        "kraam op de markt"
                    ],
                    "target_lang_definitions": {
                        "en": "A portable tent or table at a market or fair where goods are sold.",
                        "ru": "Переносная палатка или стол на рынке или ярмарке, где продаются товары."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stall",
                                "target_lang_sense_clarification": "a small open-fronted shop in a market"
                            },
                            {
                                "target_lang_word": "booth",
                                "target_lang_sense_clarification": "a small stall for the display and sale of goods"
                            },
                            {
                                "target_lang_word": "stand",
                                "target_lang_sense_clarification": "a small building or booth, like a hamburger stand"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лавка",
                                "target_lang_sense_clarification": "небольшое торговое место"
                            },
                            {
                                "target_lang_word": "прилавок",
                                "target_lang_sense_clarification": "место продажи товаров"
                            },
                            {
                                "target_lang_word": "киоск",
                                "target_lang_sense_clarification": "небольшое строение для торговли"
                            },
                            {
                                "target_lang_word": "палатка",
                                "target_lang_sense_clarification": "временное торговое сооружение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "335d0265-944a-3e30-9f8d-be76c981515a",
                    "sense_definition": "De periode rondom de bevalling en de eerste dagen daarna.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geboorte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de <w>kraam</w> krijgt de moeder hulp van een professionele verzorgster.",
                            "target_lang_translations": {
                                "en": "During the <w>postpartum period</w>, the mother receives help from a professional caregiver.",
                                "ru": "В <w>послеродовой период</w> мать получает помощь от профессиональной сиделки."
                            }
                        },
                        {
                            "text": "Zij ligt nog in de <w>kraam</w> na de geboorte van haar zoon.",
                            "target_lang_translations": {
                                "en": "She is still in <w>confinement</w> after the birth of her son.",
                                "ru": "Она все еще <w>отходит от родов</w> после рождения сына."
                            }
                        }
                    ],
                    "synonyms": [
                        "kraambed"
                    ],
                    "common_phrases": [
                        "in de kraam liggen"
                    ],
                    "target_lang_definitions": {
                        "en": "The period around childbirth and the first few days following it.",
                        "ru": "Период родов и первые дни после них."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "postpartum period",
                                "target_lang_sense_clarification": "the time following the birth of a child"
                            },
                            {
                                "target_lang_word": "confinement",
                                "target_lang_sense_clarification": "the condition of being in childbirth (dated)"
                            },
                            {
                                "target_lang_word": "maternity",
                                "target_lang_sense_clarification": "relating to the period of pregnancy and childbirth"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "послеродовой период",
                                "target_lang_sense_clarification": "время восстановления после родов"
                            },
                            {
                                "target_lang_word": "родильное ложе",
                                "target_lang_sense_clarification": "состояние женщины сразу после родов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90d84023-4393-3cba-8ee0-0c4e6f16f813",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kramen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kraam</w> onzin uit als ik erg moe ben.",
                            "target_lang_translations": {
                                "en": "I <w>spout</w> nonsense when I am very tired.",
                                "ru": "Я <w>несу</w> чепуху, когда очень устаю."
                            }
                        },
                        {
                            "text": "Soms <w>kraam</w> ik dingen die ik later weer vergeet.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>talk</w> about things that I later forget.",
                                "ru": "Иногда я <w>мелю</w> вещи, о которых позже забываю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "onzin uit kraam"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'kramen' (to utter or produce).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола kramen (обычно в составе uitkramen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spout",
                                "target_lang_sense_clarification": "to express or utter something in a repetitive or mindless way"
                            },
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "to utter words, specifically nonsense"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нести",
                                "target_lang_sense_clarification": "говорить чепуху или вздор"
                            },
                            {
                                "target_lang_word": "молоть",
                                "target_lang_sense_clarification": "говорить глупости"
                            }
                        ]
                    }
                }
            ]
        }
