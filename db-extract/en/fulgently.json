                        "glosses": [
                            "In a fulgent manner; dazzlingly; glitteringly"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "044f9552-466c-4009-9fd4-a221fb9d2af5",
                                "sense_id": "0f2a5b54-a26a-3bcb-b34f-e25d497419a4",
                                "text": "I was silent when the sun set fulgently over the far hills, and Kilderry blazed all red and gold in a flame that seemed a portent."
                            },
                            {
                                "example_id": "1b386bbc-1fbb-42a6-b221-8b6f1f12954f",
                                "sense_id": "0f2a5b54-a26a-3bcb-b34f-e25d497419a4",
                                "text": "For genuine students the time to simply praise is past, the time to fitly appraise not yet come; for the morning he so fulgently heralded is still far from its noon, and the most prescient are still all-unsure what shall be the character of the evolution and completion of its day."
                            }
                        ]
                    }
