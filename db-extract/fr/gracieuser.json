                "senses": [
                    {
                        "sense_id": "1b0642ca-9421-3de3-a602-c29e47328a9e",
                        "entry_id": "ab722161-a1f9-35c8-95e3-09acaf668d8e",
                        "glosses": [
                            "Faire de grandes démonstrations de bienveillance à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1dff0c3-a09e-43d1-ae7d-fcab15974b37",
                                "sense_id": "1b0642ca-9421-3de3-a602-c29e47328a9e",
                                "text": "…Ce qui donna lieu à la reine de la gracieuser et de l’honorer d’une grande familiarité."
                            },
                            {
                                "example_id": "929b2786-1714-40c8-914c-8b1d62512e63",
                                "sense_id": "1b0642ca-9421-3de3-a602-c29e47328a9e",
                                "text": "Le roi d’Espagne fit venir de Flandre le comte de Serclaës pour y commander ses troupes sous lui, que le roi gracieusa fort en passant."
                            },
                            {
                                "example_id": "8d4b4c85-9f9f-41a1-9810-b40dbf0564ec",
                                "sense_id": "1b0642ca-9421-3de3-a602-c29e47328a9e",
                                "text": "Le duc d’Orléans vit les magistrats, les entretint, les gracieusa."
                            },
                            {
                                "example_id": "cd26171b-0986-4c5e-8c74-591a9077d502",
                                "sense_id": "1b0642ca-9421-3de3-a602-c29e47328a9e",
                                "text": "La serrure céda ; Aline, jetée à son cou, le gracieusa d’un baiser qui le laissa tremblant."
                            }
                        ]
                    }
                ],
