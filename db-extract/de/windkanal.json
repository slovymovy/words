                ],
                "senses": [
                    {
                        "sense_id": "9ae2c8bb-06ca-3d3f-9b56-6a52912bdd18",
                        "entry_id": "43f4e314-398d-3c91-a67b-26d019ba977f",
                        "glosses": [
                            "Vorrichtung, in der Objekte einem künstlichen Luftstrom ausgesetzt werden, um deren aerodynamische Eigenschaften zu bestimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9c600b-c19b-4132-b71d-ad4117e41cf6",
                                "sense_id": "9ae2c8bb-06ca-3d3f-9b56-6a52912bdd18",
                                "text": "Um für ein zukünftiges Automodell die Dachträger im Windkanal zu testen, wurde ein Autodach aus Hartholz gefräst, und mit Gewindebuchsen versehen."
                            },
                            {
                                "example_id": "3a60ae27-2432-403a-8fe8-ffa6c8313e80",
                                "sense_id": "9ae2c8bb-06ca-3d3f-9b56-6a52912bdd18",
                                "text": "Vertikale Windkanäle werden vorwiegend im Sport- und Freizeitbereich als Trainingsanlagen für Fallschirmspringer benutzt."
                            },
                            {
                                "example_id": "e03ddd25-7ae6-4e55-a4af-963586a2b995",
                                "sense_id": "9ae2c8bb-06ca-3d3f-9b56-6a52912bdd18",
                                "text": "„Die X-59, das Überschallflugzeug der Nasa, wurde im Windkanal getestet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5afb1825-c98a-3c49-b602-cb2a24babd29",
                        "entry_id": "43f4e314-398d-3c91-a67b-26d019ba977f",
                        "glosses": [
                            "Teil einer Orgel, der zur Verteilung des Windes innerhalb der Orgel verbaut wird, häufig ist dieser quadratisch und besteht aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3280371f-fc11-45b8-a557-aa9a1b816e3c",
                                "sense_id": "5afb1825-c98a-3c49-b602-cb2a24babd29",
                                "text": "Nur sehr kleine Orgeln kommen mit einem einzigen Windkanal aus. Größere Orgeln haben mehrere Windkanäle."
                            },
                            {
                                "example_id": "f77f7a55-ac1c-46da-9d83-c09a41db0b4a",
                                "sense_id": "5afb1825-c98a-3c49-b602-cb2a24babd29",
                                "text": "„Die Luft strömt durch einen verwinkelten Windkanal, steuerbare Tonventile und schließlich durch die Pfeifen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21a0fd41-a9fc-41b1-ace7-66b57f2883cc",
                        "source_entry_id": "43f4e314-398d-3c91-a67b-26d019ba977f",
                        "source_sense_id": "9ae2c8bb-06ca-3d3f-9b56-6a52912bdd18",
                        "target_lang_word": "wind tunnel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wind tunnel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98778f61-4c33-33cf-96a0-fe3505759f78",
                                        "entry_id": "2f59ed8a-13ce-376e-a0c9-cca437fa4505",
                                        "glosses": [
                                            "A test facility through which air is forced in a controlled manner so as to study the effects of flow around airfoils, aircraft, motor cars etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287bd5b1-3fbc-4e79-ad0f-74842e0f8829",
                                                "sense_id": "98778f61-4c33-33cf-96a0-fe3505759f78",
                                                "text": "But unlike many other tunnels that lay idle and decaying, Catesby has now found a new use as an aerodynamic wind tunnel for the motor industry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ec2d17d-25b2-4714-a561-468ce822dd28",
                        "source_entry_id": "43f4e314-398d-3c91-a67b-26d019ba977f",
                        "source_sense_id": "9ae2c8bb-06ca-3d3f-9b56-6a52912bdd18",
                        "target_lang_word": "soufflerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soufflerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d38f5347-f639-3307-8cb1-4423df09021d",
                                        "entry_id": "f2e2f2e2-03f4-3a3d-99bd-2cf08bf9b9b8",
                                        "glosses": [
                                            "Ensemble d’appareils destinés à produire un courant d’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8564c897-0914-4db3-9383-eb3190880499",
                                                "sense_id": "d38f5347-f639-3307-8cb1-4423df09021d",
                                                "text": "On procède ensuite au séchage par les moyens ordinaires: […], ou séchoirs à tabliers mobiles avec soufflerie d'air chaud, ou enfin, séchoirs à l'air libre."
                                            },
                                            {
                                                "example_id": "e920d9f7-7f33-4f40-b23c-900125acb89f",
                                                "sense_id": "d38f5347-f639-3307-8cb1-4423df09021d",
                                                "text": "Puis il enclencha le foehn sur «air chaud», et il eut la surprise de voir la chevelure, raidie et foncée par l'eau, retrouver sa souplesse et son or à mesure que la soufflerie opérait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a109778-ef30-3236-ba2e-2476f7f6c5d7",
                                        "entry_id": "f2e2f2e2-03f4-3a3d-99bd-2cf08bf9b9b8",
                                        "glosses": [
                                            "Ensemble des soufflets de l’orgue."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8da0384-9faa-4b23-93c7-da6938d4a00a",
                                                "sense_id": "8a109778-ef30-3236-ba2e-2476f7f6c5d7",
                                                "text": "La soufflerie de cet orgue a besoin d’être réparée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c544540-82f5-33c3-b5c4-56b1e577683b",
                                        "entry_id": "f2e2f2e2-03f4-3a3d-99bd-2cf08bf9b9b8",
                                        "glosses": [
                                            "Lieu où sont installés ces appareils."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4df9d74-d113-3bea-80ee-d47bcdf9bee3",
                                        "entry_id": "f2e2f2e2-03f4-3a3d-99bd-2cf08bf9b9b8",
                                        "glosses": [
                                            "Installation servant à simuler les conditions aérodynamiques d’un déplacement dans l’air."
                                        ],
                                        "tags": [
                                            "Aérodynamique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd0323d-9c1d-4832-8cda-a9bf82533173",
                                                "sense_id": "d4df9d74-d113-3bea-80ee-d47bcdf9bee3",
                                                "text": "On soumet à l'épreuve de la soufflerie les maquettes des voitures afin de déterminer les formes aérodynamiques les plus propices."
                                            },
                                            {
                                                "example_id": "8a287106-89c9-4f80-8d7a-9f468d7d9ca2",
                                                "sense_id": "d4df9d74-d113-3bea-80ee-d47bcdf9bee3",
                                                "text": "Par exemple, le gouvernement chinois a récemment annoncé qu’il avait construit une soufflerie qui pouvait simuler des vols d’engins à Mach 30."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
