                ],
                "senses": [
                    {
                        "sense_id": "0e6c7587-8fa8-3909-9e8e-ff0ba3dfdf35",
                        "entry_id": "824624da-372e-3caf-b25a-86fe16afc43a",
                        "glosses": [
                            "De guerre, relatif à la guerre."
                        ],
                        "tags": [
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d13ed2c1-076d-42f6-86b0-2fb80d82826e",
                                "sense_id": "0e6c7587-8fa8-3909-9e8e-ff0ba3dfdf35",
                                "text": "Quoi ! cette âme enhardie\nAu hâle, au sable ardent, craint le champ soleilleux ?\nQue ne va-t-il bellique\nJouter avec ses pairs, soumettre au loup dompteur\nUn étalon gallique ?"
                            },
                            {
                                "example_id": "d0c90b76-a342-4513-8477-0f9fdd908082",
                                "sense_id": "0e6c7587-8fa8-3909-9e8e-ff0ba3dfdf35",
                                "text": "Un ouvrage récent a magistralement rappelé la présence structurelle de l’activité bellique dans le développement des institutions communales italiennes aux XIIᵉ et XIIIᵉ siècles."
                            }
                        ]
                    },
                    {
                        "sense_id": "272cda0f-716a-39f5-b849-53d1a52cc6ac",
                        "entry_id": "824624da-372e-3caf-b25a-86fe16afc43a",
                        "glosses": [
                            "Colonne bellique, colonne dont le fût est en forme de canon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdb878b-b678-4660-85f5-5b1304a65461",
                                "sense_id": "272cda0f-716a-39f5-b849-53d1a52cc6ac",
                                "text": "On nomme colonne bellique, celle dont le fût Toscan, ou Dorique, imite la forme d’un canon telles que les colonnes de pierre qu’on voit à la porte de l’Arsénal, du coté du quai des Célestins a Paris."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faa9a573-f848-43dc-a5e7-03a01a9d7ff1",
                        "source_entry_id": "824624da-372e-3caf-b25a-86fe16afc43a",
                        "source_sense_description": "Relatif à la guerre",
                        "target_lang_word": "warlike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
