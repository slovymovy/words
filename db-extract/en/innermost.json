        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1a1b9259-e1ed-33e7-9c62-2f658958bb44",
                "word": "innermost",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11773a33-2bd7-32cc-be65-24a8508b1375",
                        "entry_id": "1a1b9259-e1ed-33e7-9c62-2f658958bb44",
                        "glosses": [
                            "superlative form of inner: most inner; the very deepest within; farthest from the surface or external part."
                        ],
                        "tags": [
                            "form-of",
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "230a832a-f41f-4b7f-b0fd-3816caaec888",
                                "sense_id": "11773a33-2bd7-32cc-be65-24a8508b1375",
                                "text": "She poured her innermost feelings into her journal."
                            },
                            {
                                "example_id": "6b0226d5-74b7-4e6d-836c-522ee63dec82",
                                "sense_id": "11773a33-2bd7-32cc-be65-24a8508b1375",
                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                            }
                        ]
                    }
                ],
