            "senses": [
                {
                    "sense_id": "10c11585-3ec8-3fab-b47e-a3c0686b0638",
                    "sense_definition": "Twelve o'clock at night exactly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party ended just after <w>midnight</w>.",
                            "target_lang_translations": {
                                "ru": "Вечеринка закончилась сразу после <w>полуночи</w>.",
                                "zh": "派对在<w>午夜</w>刚过就结束了。"
                            }
                        },
                        {
                            "text": "You must be back home before <w>midnight</w>.",
                            "target_lang_translations": {
                                "ru": "Ты должен вернуться домой до <w>полуночи</w>.",
                                "zh": "你必须在<w>午夜</w>之前回家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "12 a.m.",
                        "12 o'clock",
                        "12 midnight"
                    ],
                    "antonyms": [
                        "noon",
                        "midday"
                    ],
                    "common_phrases": [
                        "at midnight",
                        "midnight snack",
                        "past midnight",
                        "before midnight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ровно двенадцать часов ночи.",
                        "zh": "夜里十二点整。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́лночь",
                                "target_lang_sense_clarification": "время суток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "午夜",
                                "target_lang_sense_clarification": "指夜里十二点"
                            },
                            {
                                "target_lang_word": "半夜",
                                "target_lang_sense_clarification": "指夜里十二点左右"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d796100a-211a-3186-80ab-6ba179f2ab1d",
                    "sense_definition": "The middle of the night.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house was completely silent in the <w>midnight</w> darkness.",
                            "target_lang_translations": {
                                "ru": "В доме стояла полная тишина в <w>полуночной</w> тьме.",
                                "zh": "房子在<w>深夜</w>的黑暗中一片寂静。"
                            }
                        },
                        {
                            "text": "He had to burn the <w>midnight</w> oil to finish his project on time.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось засидеться за <полночь>, чтобы закончить проект вовремя.",
                                "zh": "为了按时完成项目，他不得不<w>熬夜</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dead of night",
                        "12:00 AM"
                    ],
                    "antonyms": [
                        "midday"
                    ],
                    "common_phrases": [
                        "burn the midnight oil",
                        "midnight sun",
                        "midnight mass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Середина ночи; время глубокой темноты.",
                        "zh": "深夜，夜深人静的时候。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́лночь",
                                "target_lang_sense_clarification": "середина ночи"
                            },
                            {
                                "target_lang_word": "глуха́я ночь",
                                "target_lang_sense_clarification": "период"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深夜",
                                "target_lang_sense_clarification": "指深夜时分"
                            },
                            {
                                "target_lang_word": "半夜",
                                "target_lang_sense_clarification": "指夜深之时"
                            }
                        ]
                    }
                },
                {
