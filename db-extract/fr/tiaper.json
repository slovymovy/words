                        ],
                        "examples": [
                            {
                                "example_id": "94d48523-1796-4a8d-8c15-8a27070e0844",
                                "sense_id": "9f030973-c4f0-3d24-8b74-82784d25211f",
                                "text": "Tout autour des halles, les bonnes adresses pour « tiaper » ne manquent pas : bar à tapas, bar à vins, cidreries, petits restos tradis ou bistros, gastros."
                            },
                            {
                                "example_id": "fc8a34cf-a539-464e-a83a-a3219583c1ff",
                                "sense_id": "9f030973-c4f0-3d24-8b74-82784d25211f",
                                "text": "Qu'allez vous tiaper ce midi?"
                            },
                            {
                                "example_id": "5abad82e-36f2-40cd-969f-4a437a268ce3",
                                "sense_id": "9f030973-c4f0-3d24-8b74-82784d25211f",
                                "text": "Bon, je crois que je vais venir tiaper une garbure béarnaise et mettre de l'ordre dans les ficelles !"
                            }
                        ]
                    }
