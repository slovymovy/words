                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His rude comments <w>miffed</w> everyone who was sitting at the table.",
                            "target_lang_translations": {
