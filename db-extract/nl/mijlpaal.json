                                        "entry_id": "45c6da33-727d-3daa-9b01-db002621cef2",
                                        "glosses": [
                                            "A stone milepost (or by extension in other materials), one of a series of numbered markers placed along a road at regular intervals, typically at the side of the road or in a median."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                        "entry_id": "45c6da33-727d-3daa-9b01-db002621cef2",
                                        "glosses": [
                                            "An important event in a person's life or career, in the history of a nation, in the life of some project, etc."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5a8800-4f22-4464-87d2-920664512c1a",
                                                "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                                "text": "Death is another milestone on their way."
                                            },
                                            {
                                                "example_id": "7c1c7d15-d35a-4dd8-a61b-c41d71c6ef4b",
                                                "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "9f0ee2e0-f077-4daa-82cb-0602c1214fc1",
                                                "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                                "text": "She bought the model as a surprise gift for a friend who is a lifelong HST fan and railwayman, and who will soon be celebrating a milestone birthday."
                                            }
                                        ]
                                    }
