{
    "word": "polymer",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                "word": "polymer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d982d318-85e6-489d-8c74-8fabf8f66799",
                        "entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "polymers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14a37812-59fc-38ae-8dc3-1c26c518bdeb",
                        "entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "glosses": [
                            "A long or larger molecule consisting of a chain or network of many repeating units, formed by chemically bonding together many identical or similar small molecules called monomers. A polymer is formed by polymerization, the joining of many monomer molecules."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1e729eda-2b8b-3f53-891f-a775ae920c57",
                        "entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "glosses": [
                            "A material consisting of such polymer molecules."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f0a8551-9d8b-4baf-870c-66b13029326d",
                                "sense_id": "1e729eda-2b8b-3f53-891f-a775ae920c57",
                                "text": "The water absorbency of the anionically starch-grafted AA/AM absorbent is markedly affected by the pH of the buffer solution at different ionic strengths. The charge of the ionic monomer affects the pH sensitivity of the superabsorbent polymers. An acidic superabsorbent normally ionizes at high pH but unionizes at low pH."
                            },
                            {
                                "example_id": "ac8b3009-d955-447b-924e-6a77083f86e7",
                                "sense_id": "1e729eda-2b8b-3f53-891f-a775ae920c57",
                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "077613c4-9c5e-470d-9026-ddbdb0d99505",
                        "source_entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "source_sense_description": "molecule",
                        "target_lang_word": "polymer",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "25a74a29-8221-48cc-bb6e-0dc125c8e99a",
                        "source_entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "source_sense_description": "molecule",
                        "target_lang_word": "polymeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "44def48d-d8b8-3fe8-ba4b-785efb5f689b",
                                        "entry_id": "30275be3-4f5a-3e84-adf1-c95391ba2d97",
                                        "glosses": [
                                            "betrekking hebbend op de vorming van een polymeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27c8070-5751-436d-83be-9b48046eac09",
                                                "sense_id": "44def48d-d8b8-3fe8-ba4b-785efb5f689b",
                                                "text": "Deze polymere verbinding ontleedt gemakkelijk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polymeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bb00742b-ba6c-3b77-856b-cb01fc83745e",
                                        "entry_id": "193cd941-e6fa-31c2-8dc0-d9ebcf972cc9",
                                        "glosses": [
                                            "een reuzenmolecuul dat bestaat uit een sequentie van één of meerdere identieke of soortgelijke onderdelen die aan elkaar zijn gekoppeld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df697839-822a-4240-95b7-440e739a1989",
                                                "sense_id": "bb00742b-ba6c-3b77-856b-cb01fc83745e",
                                                "text": "Het is niet juist om alle polymeren 'plastics' te noemen omdat zij lang niet allemaal plastisch te vervormen zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "026d3aa1-3b59-4863-a468-9d6a1d356546",
                        "source_entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "source_sense_description": "molecule",
                        "target_lang_word": "polymère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8cb9c0-46de-3fd1-9777-e7cb5ca2039a",
                                        "entry_id": "14f6bfce-d4af-3b9a-85ed-34291711450a",
                                        "glosses": [
                                            "Complexe, comportant de nombreux composants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5488f390-fcd9-4c08-b9b1-e83b0ed1ae86",
                                                "sense_id": "7c8cb9c0-46de-3fd1-9777-e7cb5ca2039a",
                                                "text": "Les travaux antérieurs s’intéressant aux émulsifiants polymères ne permettaient pas de réaliser des cycles avec les polymères."
                                            },
                                            {
                                                "example_id": "743dbbf7-bdaf-4eee-9363-3fa06d45a394",
                                                "sense_id": "7c8cb9c0-46de-3fd1-9777-e7cb5ca2039a",
                                                "text": "Dans d’autres cas, il y a beaucoup de sous-unités dans la protéine définitive, c’est une protéine polymère ou multimère.."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polymère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "383e0e59-ce4a-3865-9f91-d2ddf103eb8e",
                                        "entry_id": "e2b191e3-4382-3445-b9ae-c08b23caf7c0",
                                        "glosses": [
                                            "Molécule constituée d’au moins dix unités structurales de base, identiques ou semblables, rattachées le long d'une chaîne pouvant se déployer de façon différente dans l’espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f88144a-97c7-4b3c-bdde-3a00b052f0b0",
                                                "sense_id": "383e0e59-ce4a-3865-9f91-d2ddf103eb8e",
                                                "text": "Une seconde partie mentionnait la synthèse de revêtements autoréparants à base de polymères fluorés sous champ magnétique oscillant."
                                            },
                                            {
                                                "example_id": "0f720f17-5903-4427-8ac6-550d135867e8",
                                                "sense_id": "383e0e59-ce4a-3865-9f91-d2ddf103eb8e",
                                                "text": "Ce polymère cuticulaire permet une imperméabilisation de la plante, une protection contre les radiations UV, ainsi que la rigidification de ses parties érigées."
                                            },
                                            {
                                                "example_id": "f9063255-9726-4d28-8298-53590298161e",
                                                "sense_id": "383e0e59-ce4a-3865-9f91-d2ddf103eb8e",
                                                "text": "Les 20 dollars sont en polymère, mais on a souvent l’impression qu’ils sont en éphémère..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8ba4f05-ce02-44fa-b27c-80687093a8ae",
                        "source_entry_id": "59c7bbc8-1031-3a81-b17c-5b0241f1d4ea",
                        "source_sense_description": "molecule",
                        "target_lang_word": "Polymer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polymer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                        "entry_id": "05bbb5c8-780a-3f9d-beb1-1bd50211af55",
                                        "glosses": [
                                            "chemischer Stoff, der aus Makromolekülen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad9aa57-eb90-437a-b799-0a7947431f30",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "„Bislang haben die Forscher mit zwei verschiedenen Arten von Polymeren experimentiert und deren Wechselwirkung mit der Pellikel untersucht.“"
                                            },
                                            {
                                                "example_id": "f94be82e-6066-4f89-90b3-4ec3383a56a4",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "Die Mikrostruktur der Polymere ist durch Kettenmoleküle gekennzeichnet, dies fordert spezielle Herstellungsverfahren und bringt besondere Eigenschaften mit sich."
                                            },
                                            {
                                                "example_id": "e7b652c6-fdb5-46a3-90d1-2db75155a02c",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "Ein Polymer kann aus gleichen Monomeren bestehen, es ist jedoch genauso möglich, dass die Bestandteile eine Anzahl von verschiedenen Monomeren sind."
                                            },
                                            {
                                                "example_id": "17fe44ab-6e36-4b1b-ba3a-15a52cd9ec8e",
                                                "sense_id": "e425d6d6-f9d9-3d9f-b5ff-54543c31cf51",
                                                "text": "„Seine Dissertation hatte Polymere zum Thema, womit er sich im Laufe seiner Promotion über vier Jahre beschäftigt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
