{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07659e39-090e-37ba-9ed8-aed77604803f",
                    "sense_definition": "A mechanical tool with two jaws used to hold an object firmly in place while work is performed on it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed the metal bar in a <w>vise</w> before cutting it with a saw.",
                            "target_lang_translations": {
                                "de": "Er spannte die Metallstange in einen <w>Schraubstock</w>, bevor er sie mit einer Säge schnitt."
                            }
                        },
                        {
                            "text": "Make sure to <w>clamp</w> in a vise securely so the material does not slip.",
                            "target_lang_translations": {
                                "de": "Achten Sie darauf, das Material sicher im Schraubstock <w>einzuspannen</w>, damit es nicht verrutscht."
                            }
                        }
                    ],
                    "synonyms": [
                        "vice"
                    ],
                    "common_phrases": [
                        "clamp in a vise"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein mechanisches Werkzeug mit zwei Spannbacken, das verwendet wird, um einen Gegenstand während der Bearbeitung festzuhalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schraubstock",
                                "target_lang_sense_clarification": "Werkzeug zum Einspannen von Werkstücken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369632e1-8c24-3cdc-b911-9a83b2c6215d",
                    "sense_definition": "A tight, restrictive situation or force that severely limits freedom or action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economic crisis felt like a <w>vise</w> squeezing small local businesses.",
                            "target_lang_translations": {
                                "de": "Die Wirtschaftskrise fühlte sich an wie ein <w>Würgegriff</w>, der kleine lokale Unternehmen zusammendrückte."
                            }
                        },
                        {
                            "text": "Rising costs created a <w>financial</w> vise for many families this year.",
                            "target_lang_translations": {
                                "de": "Steigende Kosten führten in diesem Jahr bei vielen Familien zu einer <w>finanziellen</w> Zwangslage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "financial vise",
                        "caught in a vise"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine enge, einschränkende Situation oder Kraft, die die Freiheit oder das Handeln stark einschränkt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Würgegriff",
                                "target_lang_sense_clarification": "im übertragenen Sinne für eine beklemmende Lage"
                            },
                            {
                                "target_lang_word": "Klammer",
                                "target_lang_sense_clarification": "einschränkende Kraft oder Situation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac40a25b-4d57-320d-aa4f-8304ca9dc5dd",
                    "sense_definition": "To hold, secure, or squeeze something firmly as if with a vise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker <w>vised</w> the wooden board to the bench before carving it.",
                            "target_lang_translations": {
                                "de": "Der Arbeiter <w>spannte</w> das Holzbrett an der Werkbank <w>ein</w>, bevor er es bearbeitete."
                            }
                        },
                        {
                            "text": "Fear seemed to <w>vise</w> his chest, making it difficult for him to breathe.",
                            "target_lang_translations": {
                                "de": "Die Angst schien seine Brust <w>zusammenzuschnüren</w>, sodass er kaum atmen konnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "clamp",
                        "grip"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas fest einspannen, sichern oder zusammendrücken, wie mit einem Schraubstock."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "einspannen",
                                "target_lang_sense_clarification": "im Schraubstock fixieren"
                            },
                            {
                                "target_lang_word": "zusammendrücken",
                                "target_lang_sense_clarification": "fest pressen oder beklemmend wirken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b372d139-d2ef-37f6-8ff3-4684bb37ac7c",
                    "sense_definition": "A family name (surname).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Vise</w> delivered an insightful lecture on history today.",
                            "target_lang_translations": {
                                "de": "Professor <w>Vise</w> hielt heute einen aufschlussreichen Vortrag über Geschichte."
                            }
                        },
                        {
                            "text": "I received an email from Mr. <w>Vise</w> regarding the project proposal.",
                            "target_lang_translations": {
                                "de": "Ich habe eine E-Mail von Herrn <w>Vise</w> bezüglich des Projektvorschlags erhalten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname (Nachname)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Vise",
                                "target_lang_sense_clarification": "Familienname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}