                "senses": [
                    {
                        "sense_id": "56eb72e3-d711-3972-ab6f-651a1bf8ea9a",
                        "entry_id": "2b414d64-d0f0-308f-99d2-0ccd2f889c60",
                        "glosses": [
                            "institutionell anerkannte und beurkundete Verbindung von genau zwei Personen, die in der Regel durch eine Liebesbeziehung, gemeinsame Lebensführung und dauerhaftes Bestehen gekennzeichnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98511e99-cde0-4a57-84a0-544bb2118679",
                                "sense_id": "56eb72e3-d711-3972-ab6f-651a1bf8ea9a",
                                "text": "„Die Babylonier praktizierten meist die Einehe, nur unter bestimmten Umständen waren Nebenfrauen, normalerweise von niedrigerem Status, zulässig.“"
                            },
                            {
                                "example_id": "df6d052d-101a-4b61-84b9-91037102e88a",
                                "sense_id": "56eb72e3-d711-3972-ab6f-651a1bf8ea9a",
                                "text": "„Ich hatte als Kind und Jugendlicher genug Zeit, in die Abgründe germanischer Einehen zu schauen.“"
                            },
                            {
                                "example_id": "5f92b745-745a-4a88-902d-23841a7244fa",
                                "sense_id": "56eb72e3-d711-3972-ab6f-651a1bf8ea9a",
                                "text": "„Den Winter verbringt der Marquis nolens volens in strikter Einehe auf Schloß Echauffour, läßt sich verwöhnen und treibt viel Lektüre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
