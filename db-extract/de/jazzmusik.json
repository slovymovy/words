                "senses": [
                    {
                        "sense_id": "751a5ca5-225f-3438-a1dc-fba90d04c35d",
                        "entry_id": "ce66b925-b651-3b48-8ffc-ee73c17ec7f2",
                        "glosses": [
                            "in den USA entstandene Musikrichtung mit Wurzeln im Blues und der Musik schwarzer Sklavenarbeiter"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "4a2d8351-a1fc-4553-ab91-5a85110a663b",
                                "sense_id": "751a5ca5-225f-3438-a1dc-fba90d04c35d",
                                "text": "Am liebsten hört er Jazzmusik."
                            },
                            {
                                "example_id": "98ca6194-b888-4d5d-bab4-a2a21d3a0ca7",
                                "sense_id": "751a5ca5-225f-3438-a1dc-fba90d04c35d",
                                "text": "„Es gab Champagner und leise Jazzmusik und die grünen Augen dieser Frau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a70ad92-50f1-4943-9def-50001db97f99",
                        "source_entry_id": "ce66b925-b651-3b48-8ffc-ee73c17ec7f2",
                        "source_sense_id": "751a5ca5-225f-3438-a1dc-fba90d04c35d",
                        "source_sense_description": "Musikrichtung",
                        "target_lang_word": "jazz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jazz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                        "entry_id": "0495137a-20a2-3340-b14c-3289befb1c98",
                                        "glosses": [
                                            "Style de musique afro-américaine né aux États-Unis au début du XXᵉ siècle, issu du croisement du blues, du ragtime et de la musique européenne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f667bc96-84a0-4178-92f1-ac997d7704ee",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "Sait-on jamais pourquoi au milieu d’une fête, dans le bruit des rires et du jazz on sent tomber sur ses épaules le poids d’une lassitude subite."
                                            },
                                            {
                                                "example_id": "cd23f8b7-9091-428f-9313-be1339e1fa46",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "Dans la période de grande licence qui suivit les hostilités, le jazz fut un signe de ralliement, un étendard orgiaque, aux couleurs du moment. Il agissait magiquement et son mode d’influence peut être comparé à une possession. C'était le meilleur élément pour donner leur vrai sens à ces fêtes, un sens religieux, avec communion par la danse, l'érotisme latent ou manifesté, et la boisson, moyen le plus efficace de niveler le fossé qui sépare les individus les uns des autres dans toute espèce de réunion."
                                            },
                                            {
                                                "example_id": "51bdbcf0-22ec-4a3e-b160-53087db6d603",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "Elle agrémenta le meublé, mit des fleurs, apporta des bouteilles d’apéritifs et d’alcools, une théière, son phono et des disques de jazz ou de musique classique"
                                            },
                                            {
                                                "example_id": "47ed6264-883d-4d67-8c87-dbce6b2866ee",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "Comme j’aurais voulu plonger dans la nuit, entendre du jazz, coudoyer des gens !"
                                            },
                                            {
                                                "example_id": "a5b921eb-dc88-449c-bd30-7e0bfe05b80f",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "Des cheveux qui tombent comme le soir\nEt d’la musique en bas des reins\nCe jazz qui d’jazze dans le noir\nEt ce mal qui nous fait du bien."
                                            },
                                            {
                                                "example_id": "01148ea4-930c-41c4-bf2f-4abab3eafe69",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "À une époque où les artistes de jazz apparaissent de plus en plus souvent sur scène, il peut sembler surprenant qu'il ait fallu attendre 1956 pour voir réalisé un microsillon contenant l'enregistrement d'un récital de Garner."
                                            },
                                            {
                                                "example_id": "46102802-83bb-4134-8334-5105ea5a8974",
                                                "sense_id": "45dfe2ba-d389-3688-9893-dccf1cb159d4",
                                                "text": "Il est vrai qu’à l’époque le jazz – ou plus précisément sa version allégée, la musique syncopée, dernière vogue venue des États-Unis – constitue (comme le fera le rock plus tard) l’ossature de la variété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d74c221-3593-3a05-99ea-07728b380f81",
                                        "entry_id": "0495137a-20a2-3340-b14c-3289befb1c98",
                                        "glosses": [
                                            "Orchestre, jouant principalement de la musique de jazz."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84fe8210-0974-40f1-857c-a1f8fd3d2780",
                                                "sense_id": "8d74c221-3593-3a05-99ea-07728b380f81",
                                                "text": "Les Mortimer s’étaient installés près du jazz."
                                            },
                                            {
                                                "example_id": "b4fec6ce-052f-4f62-ab85-2aea306c714d",
                                                "sense_id": "8d74c221-3593-3a05-99ea-07728b380f81",
                                                "text": "Le jazz du « Bœuf », qui fut un des tout premiers de Paris, attirait rue Boissy-d’Anglas les clients les plus divers."
                                            },
                                            {
                                                "example_id": "be5590b0-b803-4e27-90f1-ebc87753d3f0",
                                                "sense_id": "8d74c221-3593-3a05-99ea-07728b380f81",
                                                "text": "C’est à peine s’il restait, en dehors des entraîneuses, une demi-douzaine de vrais clients dans la salle, et ils ne dansaient plus, le jazz se reposait de longs moments entre deux airs."
                                            },
                                            {
                                                "example_id": "aebee662-c6fd-4872-8524-9660aa015f03",
                                                "sense_id": "8d74c221-3593-3a05-99ea-07728b380f81",
                                                "text": "Déjà créateur d’un jazz qui, lors des manœuvres, au cantonnement, distrayait à bon compte les femmes de l’endroit et sa compagnie, Trugex fut satisfait de son autre innovation."
                                            }
                                        ]
                                    }
                                ]
                            },
