                ],
                "senses": [
                    {
                        "sense_id": "ac391092-585e-3abf-b8c8-5b73aac73b92",
                        "entry_id": "23a9b018-e4be-3b72-8682-243769e8dd09",
                        "glosses": [
                            "вытирая чем-нибудь, удаляя с поверхности влагу, сделать сухим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e95b0f-9f92-47bd-99b3-8ff70db400e4",
                                "sense_id": "ac391092-585e-3abf-b8c8-5b73aac73b92",
                                "text": "Обтёр губы истрёпанным фуляровым платком."
                            },
                            {
                                "example_id": "90cdc483-a012-421d-85cb-0b8b64ab028d",
                                "sense_id": "ac391092-585e-3abf-b8c8-5b73aac73b92",
                                "text": "Обтереть лицо полотенцем."
                            },
                            {
                                "example_id": "b0ba92bd-b455-4348-969a-5dc2970f772c",
                                "sense_id": "ac391092-585e-3abf-b8c8-5b73aac73b92",
                                "text": "Обтереть чашку."
                            },
                            {
                                "example_id": "3a6c33de-1dfc-4800-b360-6589424a6188",
                                "sense_id": "ac391092-585e-3abf-b8c8-5b73aac73b92",
                                "text": "Эмма обтёрла платочком руки и вышла, на ходу поправляя волосы и тёмно-синие проймочки сарафана, кокетливо оттеняющие белизну её рук и плеч."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0b9b819-14e6-32bb-b3e1-c80588b1e958",
                        "entry_id": "23a9b018-e4be-3b72-8682-243769e8dd09",
                        "glosses": [
                            "смочить, обмыть слегка, растирая (какую-нибудь жидкость) по поверхности чего-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "886334e2-0d40-4f7a-aad6-64af88913392",
                                "sense_id": "c0b9b819-14e6-32bb-b3e1-c80588b1e958",
                                "text": "Обтереть лицо одеколоном."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbcb0816-813b-37a1-8f90-bee093b04347",
                        "entry_id": "23a9b018-e4be-3b72-8682-243769e8dd09",
                        "glosses": [
                            "разг. привести в плохое, негодное состояние продолжительным употреблением, ноской, трением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bafee0-4312-4f90-97e6-f5ca96b1782a",
                                "sense_id": "cbcb0816-813b-37a1-8f90-bee093b04347",
                                "text": "Он свои новые шорты за лето обтёр до дыр."
                            }
                        ]
                    }
                ],
