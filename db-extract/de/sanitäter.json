                        ]
                    },
                    {
                        "translation_id": "af55194a-d9a6-45fc-baf5-5aa742946a75",
                        "source_entry_id": "b4a9629d-361a-30cd-8be5-7605d728317a",
                        "source_sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                        "source_sense_description": "Angehöriger eines Sanitätsdienstes",
                        "target_lang_word": "brancardier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brancardier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d67b698-689d-3339-a472-2bd908b5d27d",
                                        "entry_id": "4c1660b7-9b14-35ff-998e-3cf6da4e388a",
                                        "glosses": [
                                            "Celui qui porte un brancard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bddb385-8292-47be-8db9-2358f6f27473",
                                                "sense_id": "9d67b698-689d-3339-a472-2bd908b5d27d",
                                                "text": "Bert fut désigné comme brancardier, et il aida à transporter les blessés dans le plus proche des vastes hôtels qui faisaient face à la rive canadienne."
                                            },
                                            {
                                                "example_id": "5e0f1df4-206d-4e1e-8154-bcef30349679",
                                                "sense_id": "9d67b698-689d-3339-a472-2bd908b5d27d",
                                                "text": "Seuls les brancardiers sont prêts ; ils sont même partis : il faut les arrêter de force et les faire passer à l'arrière du bataillon."
                                            },
                                            {
                                                "example_id": "a468df02-601d-40e3-9066-f675294907b1",
                                                "sense_id": "9d67b698-689d-3339-a472-2bd908b5d27d",
                                                "text": "François marchait près de la civière. On n'apercevait pas Lulu : elle avait le visage couvert d'un drap et la forme de son corps disparaissait sous un amas de couvertures étroitement bordées. Les brancardiers pressèrent l'allure."
                                            },
                                            {
                                                "example_id": "1d8b3326-974e-496b-9216-6e630e03b1cd",
                                                "sense_id": "9d67b698-689d-3339-a472-2bd908b5d27d",
                                                "text": "Des brancardières se pressent devant les wagons. De qui émane le message qui les avisa ? Je ne me pose pas la question. Ma vue se porte, malgré moi, vers une des horloges de la gare : elle marque une heure moins vingt."
                                            },
                                            {
                                                "example_id": "3c124c9a-d00f-4b22-a0e3-7492557abccd",
                                                "sense_id": "9d67b698-689d-3339-a472-2bd908b5d27d",
                                                "text": "Chaque année, pendant le pèlerinage national, ils allaient à Lourdes ; les garçons servaient comme brancardiers ; les filles lavaient la vaisselle dans les cuisines des hospices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe5ec00-f1ab-37ed-8733-72cbe1a9edb0",
                                        "entry_id": "4c1660b7-9b14-35ff-998e-3cf6da4e388a",
                                        "glosses": [
                                            "Cheval attelé entre les deux brancards."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6abcaed1-b63c-42d7-9194-a63950a9c2e8",
                        "source_entry_id": "b4a9629d-361a-30cd-8be5-7605d728317a",
                        "source_sense_id": "25c2581c-625d-32ae-b714-0b56e19f5595",
                        "source_sense_description": "Angehöriger eines Sanitätsdienstes",
                        "target_lang_word": "secouriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secouriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                        "entry_id": "1306f3db-257e-3223-992b-a818e14d6692",
                                        "glosses": [
                                            "Personne qui porte secours, qui apporte une aide de première urgence aux blessés ou accidentés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d6ba5c-090c-4935-a0f3-fcd485406d2e",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Le secouriste diplômé peut, s'il le désire, faire partie des équipes de premiers secours intervenant lors de catastrophes ou de situations particulières (secours sur route, sur eau, en montagne, etc...)."
                                            },
                                            {
                                                "example_id": "e3886d9e-ef8f-499b-9757-fec37047ee31",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Aujourd'hui, les acteurs du secours sont nombreux : secouristes professionnels, infirmiers, médecins, équipages d’hélicoptère mais aussi marins, montagnards et spéléologues bénévoles."
                                            },
                                            {
                                                "example_id": "5ece0a75-0496-40f8-ade5-f38744005677",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Dès l'arrivée franchie, il a été terrassé par un arrêt cardiaque. Comme nous savons que c'est fréquent, il est tombé au pied d'une ravissante secouriste de la protection civile qui a commencé les gestes, et les médecins urgentistes du Samu ont été à ses côtés en moins de quatre minutes."
                                            },
                                            {
                                                "example_id": "edf790c9-6912-4eb4-88c4-84fb455132c7",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Les secouristes et les autres membres de l’expédition arrivaient enfin à l’épave de l’avion, lorsque les hommes montaient à bord, le spectacle qu'ils avaient devant leurs yeux était plus horrible qu'ils auraient pu l’imaginer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
