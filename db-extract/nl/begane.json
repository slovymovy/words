                    },
                    {
                        "sense_id": "40702b49-6229-37c0-87c0-9e6d14fabbdd",
                        "entry_id": "98979e90-8c5b-3042-9cf6-0aba685bdb25",
                        "glosses": [
                            "begane grond: de woonlaag die op het maaiveld ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600ad78d-157b-4b86-9330-950f3842aefa",
                                "sense_id": "40702b49-6229-37c0-87c0-9e6d14fabbdd",
                                "text": "De kelder en het souterrain liggen onder het maaiveld en de eerste en volgende etages liggen boven het maaiveld maarde begane grond ligt op het niveau van het maaiveld."
                            },
                            {
                                "example_id": "3bf0f56f-5158-4142-af10-e69105b3b687",
                                "sense_id": "40702b49-6229-37c0-87c0-9e6d14fabbdd",
                                "text": "Hoewel er geen eind aan de trappen leek te komen, stonden ze drie minuten later op de begane grond."
                            },
                            {
                                "example_id": "3d9fc670-b4ef-4088-a41c-bd5f08567837",
                                "sense_id": "40702b49-6229-37c0-87c0-9e6d14fabbdd",
                                "text": "In grote delen van het centrum van Berlijn hadden de huurpanden winkels op de begane grond, dat kon van alles zijn, van levensmiddelen en kleine naaiateliers tot antiquairs, groentemannen en meubelverkopers, groot en klein door elkaar heen zonder enig systeem, behalve in grote winkelstraten zoals de Leipziger Strasse."
                            }
                        ]
                    }
