                                    {
                                        "sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                                        "entry_id": "f0b7cc3a-e0a1-31de-9c3b-2f6f14e9b2a2",
                                        "glosses": [
                                            "iemand die een strafzaak aanspant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99bcc45-03bc-40db-9a95-f2f7b08f2f5f",
                                                "sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                                                "text": "'De openbare aanklager had twintig jaar geëist voor het sympathiseren met de marxistisch-leninistische beweging, terrorisme en landverraad. We hoorden pas weken later dat de rechtszaak had plaatsgevonden."
                                            },
                                            {
                                                "example_id": "cfb46809-7568-438e-bea7-a5884dc9b322",
                                                "sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                                                "text": "Het eerste punt was, zoals verwacht, de mededeling van de openbaar aanklager, ene Ebba Bengtsson-Stàhle, dat zij weliswaar de leiding over het vooronderzoek had, maar uiteraard alle vertrouwen had in de competentie van de politie en rekende op een even goede samenwerking als altijd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "114904ed-e95b-4a55-8419-3cd870b1156e",
                        "source_entry_id": "5a210206-cd61-3531-b037-9393bb4cd751",
                        "source_sense_id": "9e666339-d626-3845-acf6-4e542d6e52f9",
                        "source_sense_description": "one who accuses",
                        "target_lang_word": "beschuldiger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beschuldiger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "288f8423-2f5a-38c2-b121-cfd2d8b992af",
                                        "entry_id": "69357255-2a32-3afb-8c94-33cb439ef83f",
                                        "glosses": [
                                            "iemand die iets of iemand ergens van beschuldigt; iemand die een beschuldiging uitspreekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e11a800-c6aa-4d96-9060-f8de06faf040",
                                                "sense_id": "288f8423-2f5a-38c2-b121-cfd2d8b992af",
                                                "text": "Voorzitter Chuck Grassley van de Senaatscommissie zegt dat er een onderzoek loopt naar de beschuldigingen, maar dat de hoorzitting van morgen gewoon doorgaat. Kavanaugh en Ford, de eerste beschuldiger, zullen daar worden gehoord. Vrijdag wordt er gestemd over de benoeming van Kavanaugh."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff0ab788-2d28-4c0a-9885-e29b33fb3570",
                        "source_entry_id": "5a210206-cd61-3531-b037-9393bb4cd751",
