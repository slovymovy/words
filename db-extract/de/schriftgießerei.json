                            {
                                "example_id": "77dd8e1b-a559-41df-b132-59ec1a2233b7",
                                "sense_id": "6190d04a-5c33-3f41-98bc-c6e1d6096f8f",
                                "text": "„Die Anfänge der Druckerei und Schriftgießerei Offizin Haag-Drugulin lassen sich bis in die Mitte des 18. Jahrhunderts zurückverfolgen.“"
                            },
                            {
                                "example_id": "8c7ff50f-5095-4366-9576-8e803058b4b3",
                                "sense_id": "6190d04a-5c33-3f41-98bc-c6e1d6096f8f",
                                "text": "Die Univers ist eine serifenlose Linear-Antiqua Schrift, die in den Jahren 1950/1951 bis 1956 von Adrian Frutiger entworfen und 1957 von der Schriftgießerei Deberny & Peignot veröffentlicht wurde."
                            }
                        ],
