                                    }
                                ]
                            },
                            {
                                "target_word": "alaouite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bffde86-1aab-38d3-abb3-9c810a6ebde9",
                                        "entry_id": "182085fe-d03a-3cb1-8307-82275b90b97b",
                                        "glosses": [
                                            "Membre d’une communauté qui forme une branche du chiisme, présente principalement en Syrie."
                                        ],
                                        "tags": [
                                            "Chiisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a9cdc1-a522-46cf-97d2-8f813f6e4ec2",
                                                "sense_id": "1bffde86-1aab-38d3-abb3-9c810a6ebde9",
                                                "text": "C’était agaçant, séduisant, obsédant, tout à la fois, et peu en accord avec le rude paysage où nous roulions; mais cette traversée du désert restera à jamais liée à cette voix dont le chauffeur, un alaouite de Lattaquié, raffolait, et dont il pensait nous honorer."
                                            }
                                        ]
                                    }
                                ]
                            }
