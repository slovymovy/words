                                ]
                            },
                            {
                                "target_word": "beat up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed354122-4446-3873-8f0f-b9507b9b3df3",
                                        "entry_id": "2602b5cc-6ff3-37ec-b020-7e212d15d389",
                                        "glosses": [
                                            "Battered by time and usage; beaten up."
                                        ],
