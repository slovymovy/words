                ],
                "translations": [
                    {
                        "translation_id": "a99a39c0-34a0-4253-94c4-3b7c0c7bb47f",
                        "source_entry_id": "86550cc3-dd6a-3ac9-99c5-861a2f3b45e0",
                        "source_sense_id": "aa5b176a-00be-3592-a291-ba2d4d386a4e",
                        "target_lang_word": "ken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ffba337-e7d1-3e4b-96f8-109636ab9f17",
                                        "entry_id": "dc310b14-3537-3a92-806e-53860766c33a",
                                        "glosses": [
                                            "To give birth, conceive, beget, be born; to develop (as a fetus); to nourish, sustain (as life)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b519c51-eebc-4845-a468-09bb71040edb",
                                                "sense_id": "8ffba337-e7d1-3e4b-96f8-109636ab9f17",
                                                "text": "To the soul this ghostly bread is the learning and the teaching and the understanding in the commandments of God, wherethrough the soul is kenned and lives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7cc0cdf-0988-36d3-9374-1c1edb6922a6",
                                        "entry_id": "af0d2eca-f665-314d-b25e-a0fd716a894b",
                                        "glosses": [
                                            "To know, perceive or understand."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02ca5902-e8bf-438d-92a0-14c52de852e0",
                                                "sense_id": "a7cc0cdf-0988-36d3-9374-1c1edb6922a6",
                                                "text": "It was noted by them that kenned best that her cantrips were at their worst when the tides in the Sker Bay ebbed between the hours of twelve and one."
                                            },
                                            {
                                                "example_id": "40e448c2-161d-4d29-bc36-8a178ba5cf49",
                                                "sense_id": "a7cc0cdf-0988-36d3-9374-1c1edb6922a6",
                                                "text": "Johnny: Is your name Maggie? / Maggie: How'd you ken that? / Johnny: It's just a hunch. Are you looking for the, uh, petulant dwarf?"
                                            },
                                            {
                                                "example_id": "e2238446-4c8d-46a6-9155-5240dc9e2061",
                                                "sense_id": "a7cc0cdf-0988-36d3-9374-1c1edb6922a6",
                                                "text": "Ah thought he wis being harsh, flippant and show-oafy, until ah got sae far in. Now ah ken precisely what the cunt meant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c1a308a-5a3a-3f4e-9b1d-186a2289e17e",
                                        "entry_id": "af0d2eca-f665-314d-b25e-a0fd716a894b",
                                        "glosses": [
                                            "To discover by sight; to catch sight of; to descry."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0869c902-0329-42e0-ade6-2f6b7f33b58c",
                                                "sense_id": "3c1a308a-5a3a-3f4e-9b1d-186a2289e17e",
                                                "text": "'Tis he. I ken the manner of his gate, / He riſes on the toe:"
                                            },
                                            {
                                                "example_id": "37fd2e5e-9795-490a-9e19-0266df9fe37a",
                                                "sense_id": "3c1a308a-5a3a-3f4e-9b1d-186a2289e17e",
                                                "text": "I proposed to the Mariners, that it would be of great benefit in Navigation to make use of [the telescope] upon the round-top of a ship, to discover and kenne Vessels afar off."
                                            },
                                            {
                                                "example_id": "9c139651-bfef-4df7-a6be-c8edfb2276a6",
                                                "sense_id": "3c1a308a-5a3a-3f4e-9b1d-186a2289e17e",
                                                "text": "We ken them from afar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efebb175-1d1e-3d9c-8cb0-957dbc9601b2",
                                        "entry_id": "78d62ac3-5e09-36c4-b458-7383f583410f",
                                        "glosses": [
                                            "Range of perception."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae15c1a-9ab1-4ffb-9c9b-15f44655ebab",
                                                "sense_id": "efebb175-1d1e-3d9c-8cb0-957dbc9601b2",
                                                "text": "I had somehow the impression that he was on the point of letting go the ladder to swim away beyond my ken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                        "entry_id": "78d62ac3-5e09-36c4-b458-7383f583410f",
                                        "glosses": [
                                            "Knowledge, perception, or sight."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8919a6df-4cbe-4edb-867c-14a694d277f9",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "On this occasion, I wrote to them: \"Two more modest and deserving people than you are not in our ken; and it is but fitting that you receive this, preservation's most prestigious prize, for your selfless devotion to the cause through the years."
                                            },
                                            {
                                                "example_id": "2ede4658-2c45-459b-a81a-db33785b60d3",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "So far is it from the kenne of theſe wretched projectors of ours that beſcraull their Pamflets every day with new formes of government for our Church."
                                            },
                                            {
                                                "example_id": "11cd80aa-00d5-4bca-b5e1-269ee87b0b45",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "Within our ken / The Nightingale—ah! Love, the Nightingale! / Her tender sweetness made our cheeks grow pale,"
                                            },
                                            {
                                                "example_id": "9fc96305-0b8e-4a42-a48f-0bd03282fe38",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "These people, these 20 or 25, were in my ken. Senator Jenner. In his what? Mr. Greenglass. My ken, my line of vision, my knowledge."
                                            },
                                            {
                                                "example_id": "40d9066d-05d9-4f0b-8c53-3db858e70dd6",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "Though he was out in the streets and away from the Firm and the Firm's ken, though he had work to do and action to relieve him, he was angry."
                                            },
                                            {
                                                "example_id": "39aa5b5c-2f9c-486c-9c09-6031639fd1f9",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "Since nothing in our ken differentiates knowledge from luck, something beyond our ken is introduced to do so. But the conviction that we know something is small comfort when coupled with the realization that we cannot tell what."
                                            },
                                            {
                                                "example_id": "6cea3461-f4e2-447d-a943-21bf5b652a5b",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "I couldn't see the funny side myself, but Tristan could; after a while he could hardly control his merriment, in fact, so that he collapsed back on the bed, continuing to chortle, more of his rather unpleasant teeth making an unwelcome appearance in my ken."
                                            },
                                            {
                                                "example_id": "aa63d4bf-13c2-4573-aeb3-372160578838",
                                                "sense_id": "b9f68673-01f5-3fd5-b679-d937b0701a67",
                                                "text": "It was an intelligence beyond human ken but integral to everything, perhaps most like the Great Tao of Eastern philosophy of the same period, and it flowed like a European form of Chinese chi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17443f71-183b-31ce-9f36-72972e892e37",
                                        "entry_id": "78d62ac3-5e09-36c4-b458-7383f583410f",
                                        "glosses": [
                                            "Range of sight."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd8ed23-a1cb-45da-adb1-d384a8fe3302",
                                                "sense_id": "17443f71-183b-31ce-9f36-72972e892e37",
                                                "text": "At once as far as Angels kenn he views / The dismal Situation waste and wilde […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3e0060-f8f7-3df1-91be-2edfa2b3bea1",
                                        "entry_id": "7504c582-80d3-3188-a54b-8733a7467b9d",
                                        "glosses": [
                                            "A house, especially a den of thieves."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "306a2a4f-fa7a-4460-aa6f-c38f84163d83",
                                                "sense_id": "3b3e0060-f8f7-3df1-91be-2edfa2b3bea1",
                                                "text": "Ben mort, shall you and I heave a bough, mill a ken, or nip a bung, and then we'll couch a hogshead under the ruffmans, and there you shall wap with me, and I'll niggle with you."
                                            },
                                            {
                                                "example_id": "7837c967-08fe-454e-9f63-f9507c0947a9",
                                                "sense_id": "3b3e0060-f8f7-3df1-91be-2edfa2b3bea1",
                                                "text": "Ah, Bess, my covess, strike me blind if my sees don't tout your bingo muns in spite of the darkmans. Egad, you carry a bene blink aloft. Come to the ken alone—no! my blowen; did not I tell you I should bring a pater cove, to chop up the whiners for Dawson?"
                                            },
                                            {
                                                "example_id": "4c0c3baf-2a8f-46ca-b5d9-175b52e13750",
                                                "sense_id": "3b3e0060-f8f7-3df1-91be-2edfa2b3bea1",
                                                "text": "Up she goes to any likely ken, where she knows there are women that are married or expect to get married, and commences begging."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d71b200-f696-3cd5-b93a-e0ab67db19ba",
                                        "entry_id": "59766b79-a987-333e-ae3a-c5686e696956",
                                        "glosses": [
                                            "Youth or children's group."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a8e817-31f5-4de3-99dd-c0cf3366660d",
                                                "sense_id": "5d71b200-f696-3cd5-b93a-e0ab67db19ba",
                                                "text": "Gilboa and Habonim Dror also run year-round programming, holding regional reunions (called kenim) up and down the state"
                                            },
                                            {
                                                "example_id": "bcc9e2c0-b213-45ac-8988-d0c05c5a535a",
                                                "sense_id": "5d71b200-f696-3cd5-b93a-e0ab67db19ba",
                                                "text": "Gavriella: At an annual movement conference. I went for the first time, and we proposed creating new kenim [branches] and it was approved, which is amazing!"
                                            },
                                            {
                                                "example_id": "8a5a1bbc-a812-4240-b5b2-a0e7a23a08e9",
                                                "sense_id": "5d71b200-f696-3cd5-b93a-e0ab67db19ba",
                                                "text": "At the beginning of 1944 he was sent to Debreccen to operate the local ken and to organize self-defense."
                                            }
                                        ]
                                    }
                                ]
                            },
