                        "examples": [
                            {
                                "example_id": "06753799-4787-4f24-b950-87142940149d",
                                "sense_id": "8231f16b-cc09-351a-9ce7-6300668a932d",
                                "text": "Le bourrelet périoplique constitue un petit renflement hémi-cylindrique peu saillant (…), situé au-dessus du bourrelet principal, dont il suit la direction circulaire jusqu'au niveau des bulbes cartilagineux."
                            },
                            {
                                "example_id": "9061a8f9-fa94-49d6-be3d-bbbd218694c8",
                                "sense_id": "8231f16b-cc09-351a-9ce7-6300668a932d",
                                "text": "L'immersion du pied, pendant un certain temps, dans l'eau tiède, ou même à la température ordinaire, rend très-apparente cette bande périoplique, dont la couleur est toujours blanc-grisâtre, quelque foncée que soit celle du sabot."
                            }
                        ]
                    }
