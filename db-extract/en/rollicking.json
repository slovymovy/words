                        "entry_id": "3620faf4-6691-3eab-a00f-06c0a6be7974",
                        "glosses": [
                            "A scolding, a bollocking."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "04f40567-d374-424e-b821-13dfcf23849c",
                                "sense_id": "ef74613e-e8c9-3bab-9275-d0c313d2f143",
                                "text": "Thanks for explaining the situation. I'm going to give him the rollicking of his life."
                            },
                            {
                                "example_id": "25e45860-1732-4bed-96a3-ba7a4f2796ad",
                                "sense_id": "ef74613e-e8c9-3bab-9275-d0c313d2f143",
                                "text": "He can give someone a right rollicking but it comes over as advice."
                            },
                            {
                                "example_id": "c7b1e6f9-b96e-4212-9c21-bb37e3f4c721",
                                "sense_id": "ef74613e-e8c9-3bab-9275-d0c313d2f143",
                                "text": "That night, back at the billet, Corporal Banks summoned me to his room and there I stood to attention, whilst he gave me a roasting for getting him a rollicking from the sergeant."
                            }
                        ]
                    }
                ],
