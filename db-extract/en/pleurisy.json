                ],
                "senses": [
                    {
                        "sense_id": "e4713f69-4434-3c75-91c5-b8da3c08ea17",
                        "entry_id": "063577d5-4680-3539-afb7-23634f8db29f",
                        "glosses": [
                            "Inflammation of lung pleura."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "825b085a-5836-4225-9489-be1709be95bd",
                                "sense_id": "e4713f69-4434-3c75-91c5-b8da3c08ea17",
                                "text": "1829 September, Richard N. Allen, An Essay on Pneumonia Biliosa, Horatio Gates Jameson (editor), The Maryland Medical Recorder, Volume 1, Number 1, page 591,\nThe division of pleurisies now sanctioned by the general language of medical men, is that which arranges them as inflammatory,* bilious and typhoid."
                            },
                            {
                                "example_id": "ae601468-86e6-4e19-ab1d-9aba250716d6",
                                "sense_id": "e4713f69-4434-3c75-91c5-b8da3c08ea17",
                                "text": "And the dope often gave him a painful case of pleurisy if he smoked it for more than two straight days of heavy continuous smoking[…]"
                            },
                            {
                                "example_id": "cb712460-8615-4378-95c8-25cfc01ec14a",
                                "sense_id": "e4713f69-4434-3c75-91c5-b8da3c08ea17",
                                "text": "Pleurisy usually causes pain, which is made worse by deep breathing, since the two inflamed layers of the pleura rub against each other."
                            },
                            {
                                "example_id": "ec9e4b66-b948-4ce1-89a9-4908f4cc2712",
                                "sense_id": "e4713f69-4434-3c75-91c5-b8da3c08ea17",
                                "text": "Pleurisy usually occurs as a secondary disease to other infections (e.g., pneumonia, tuberculosis), conditions (e.g., pulmonary embolism, tumors), or as a result of injury."
                            }
                        ]
                    }
                ],
                "translations": [
