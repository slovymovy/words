                                "target_senses": [
                                    {
                                        "sense_id": "2e4bef15-3bba-38c7-805b-53255d060f23",
                                        "entry_id": "ad4239fe-f8e2-375b-8a79-5782306fdecd",
                                        "glosses": [
                                            "By means of a written message, as opposed to orally or through other means."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbccf8d-1664-4192-aa23-3210ee22546b",
                                                "sense_id": "2e4bef15-3bba-38c7-805b-53255d060f23",
                                                "text": "THE emigrant farmers beyond the Vaal River having communicated to me, in writing, through you, their desire to come to a favourable understanding with the British Government"
                                            },
                                            {
                                                "example_id": "6db14246-01bc-472c-b8ca-a47278e5f0ab",
                                                "sense_id": "2e4bef15-3bba-38c7-805b-53255d060f23",
                                                "text": "What a comfort and relief it is to the families of such people when they can make the change with an attitude like that of an elderly friend of ours, who expressed her feelings about it in writing. Here are some excerpts: […]"
                                            },
                                            {
                                                "example_id": "6400fbc9-7018-4f68-828d-5ab6e91342ec",
                                                "sense_id": "2e4bef15-3bba-38c7-805b-53255d060f23",
                                                "text": "Following a statewide trend among cities, Mountain View has opted to simply record in writing the actions taken by the city council […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a689432-96ff-41ad-968f-a23914867b0c",
                        "source_entry_id": "58c42af2-dd99-3cb1-adf5-ebd7f3d212e7",
                        "source_sense_id": "2407295a-53f2-34d8-98b8-f76b3f4977b3",
                        "target_lang_word": "par écrit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par écrit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d1dd68-01d1-35fe-bb9e-e76ad62114a7",
                                        "entry_id": "12209c42-6f2c-3856-9288-fa57499e2e34",
                                        "glosses": [
                                            "En écrivant, sous forme écrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c21fce-6654-4c80-a423-e536bde849f1",
                                                "sense_id": "e0d1dd68-01d1-35fe-bb9e-e76ad62114a7",
                                                "text": "– J’ai bien réfléchi. Tout sera consigné par écrit, ainsi il aura confiance en moi. Et de toute manière, la transaction se fera juste dans la foulée."
                                            },
                                            {
                                                "example_id": "99b0ec0b-73fb-424e-8adb-4aa5e004ec02",
                                                "sense_id": "e0d1dd68-01d1-35fe-bb9e-e76ad62114a7",
                                                "text": "La demande doit être formulée par écrit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6272e087-abfc-403d-8f11-897e59b63242",
                        "source_entry_id": "58c42af2-dd99-3cb1-adf5-ebd7f3d212e7",
