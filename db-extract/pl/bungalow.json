                "senses": [
                    {
                        "sense_id": "b65ad93a-13b1-3ef3-b940-5fe520bd0d9f",
                        "entry_id": "4f88eb94-ac90-3702-9548-0a19641acf87",
                        "glosses": [
                            "jednokondygnacyjny, podmiejski dom mieszkalny, z werandami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83b7176-bbc8-495c-a031-df6c9301e8f6",
                                "sense_id": "b65ad93a-13b1-3ef3-b940-5fe520bd0d9f",
                                "text": "Z dumą pokazywał grubym palcem długą listę atrakcji, jakie czekały na gości, którzy mieli szczęście znaleźć miejsce w jego bungalowach"
                            },
                            {
                                "example_id": "080783df-eb2e-49eb-885c-5da9c0a79914",
                                "sense_id": "b65ad93a-13b1-3ef3-b940-5fe520bd0d9f",
                                "text": "Idą w stronę bungalowu, przed którym na werandzie buja się w hamaku Eryk"
                            },
                            {
                                "example_id": "2a4b93a0-c167-4547-b670-c57742de1f76",
                                "sense_id": "b65ad93a-13b1-3ef3-b940-5fe520bd0d9f",
                                "text": "Tego dnia szczególnie źle się czuł i nawet godziny, które zwykle poświęcał na wędrówkę w głąb puszczy – od jedenastej do trzeciej – po raz pierwszy spędził w bungalowie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e449f28c-4f14-4242-a0b2-4a4777653d4e",
                        "source_entry_id": "4f88eb94-ac90-3702-9548-0a19641acf87",
                        "source_sense_id": "b65ad93a-13b1-3ef3-b940-5fe520bd0d9f",
                        "target_lang_word": "bungalow",
