                        "target_lang_word": "retrogression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retrogression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6467820e-2393-364f-9095-989a8b4acf43",
                                        "entry_id": "5d072536-588c-339d-873a-74ba879e113f",
                                        "glosses": [
                                            "A deterioration or decline to a previous state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "350d74d3-a4ca-40cb-923a-f634698f9d2e",
                                                "sense_id": "6467820e-2393-364f-9095-989a8b4acf43",
                                                "text": "History and experience, the enshriners of the past, and investigation, the discoverer of the present and preparer for the future, will prevent retrogression."
                                            },
                                            {
                                                "example_id": "0ed82afc-b092-4a9f-9719-f984ff3811b2",
                                                "sense_id": "6467820e-2393-364f-9095-989a8b4acf43",
                                                "text": "Suns spring into being, and then their height of power being reached, the process of retrogression begins, and after aeons they become dead masses of matter, awaiting another impulse which starts again their inner energies into activity and a new solar life cycle is begun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd7ca37b-bff5-3476-8a3b-1c0237e3e125",
                                        "entry_id": "5d072536-588c-339d-873a-74ba879e113f",
                                        "glosses": [
                                            "A return to a less complex condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07e1d163-6a42-4d73-a7fa-c89a47f449f8",
                        "source_entry_id": "db6f2373-e56d-386a-8c2a-099e1b5a6419",
                        "source_sense_id": "8e4576e6-1084-3ca8-84be-4363c942d2a6",
                        "source_sense_description": "sinnbildliches Wort, um einen Rückschritt oder ein Zurückschreiten zu beschreiben",
                        "target_lang_word": "rétrograde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétrograde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "686f0930-1ad5-3c66-ba38-1e419dcb3e56",
                                        "entry_id": "b983ae8c-f71a-3927-874f-95eb462d5bda",
                                        "glosses": [
                                            "Qui va, qui se fait en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8467eb0d-00e3-43f7-a6a2-99481808f90b",
                                                "sense_id": "686f0930-1ad5-3c66-ba38-1e419dcb3e56",
                                                "text": "Marche rétrograde. Mouvement rétrograde. Ordre rétrograde."
                                            },
                                            {
                                                "example_id": "32cce007-9c2d-4473-b135-8c3a5e7de33b",
                                                "sense_id": "686f0930-1ad5-3c66-ba38-1e419dcb3e56",
                                                "text": "Leuwen était sûr que tout le monde disait du bien de lui à madame de Chasteller ; mais la maison du marquis de Pontlevé n’en était pas moins la seule de Nancy où Lucien semblât faire des pas rétrogrades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05992f9a-c0d4-3c17-b156-3dd4e3f3a27a",
                                        "entry_id": "b983ae8c-f71a-3927-874f-95eb462d5bda",
                                        "glosses": [
                                            "Qualifie les corps célestes, lorsqu’ils paraissent aller en sens inverse des signes du zodiaque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c338d244-0c91-3c04-abbe-e4c2a856375d",
                                        "entry_id": "b983ae8c-f71a-3927-874f-95eb462d5bda",
                                        "glosses": [
                                            "Qualifie des hommes, partis, ou pouvoirs qui cherchent à revenir en arrière, à rétablir des institutions que l’on considère comme surannées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5676bbe5-f6f0-48f1-8f04-cd8d27f6ea6b",
                                                "sense_id": "c338d244-0c91-3c04-abbe-e4c2a856375d",
                                                "text": "Les tendances rétrogrades du gouvernement, ses provocations multipliées avancèrent l'heure du conflit."
                                            },
                                            {
                                                "example_id": "8117cef5-7829-45a1-bda0-9eaf6f26147e",
                                                "sense_id": "c338d244-0c91-3c04-abbe-e4c2a856375d",
                                                "text": "[…] des observateurs, […] signalent chez les campagnards du Lot comme une tare tout à fait caractéristique un individualisme outrancier, féroce, têtu, rétrograde qui leur a laissé ignorer jusqu'à ce jour les bienfaits de la solidarité, de l'entr’aide et même, dans bien des cas, de l'assurance et du remembrement."
                                            },
                                            {
                                                "example_id": "ae218105-a28f-4bd0-932f-8982ce6ac13b",
                                                "sense_id": "c338d244-0c91-3c04-abbe-e4c2a856375d",
                                                "text": "La Nouvelle Cuisine, c'était un espoir, un dépoussiérage pour une gastronomie qui était rétrograde et cependant leader dans le monde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rétrograde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3adacaf4-2259-33a3-8230-b9a4ef43a8af",
                                        "entry_id": "a8afab80-94ef-3a5c-b4b2-e18c148470e8",
                                        "glosses": [
                                            "Personne qui cherche à revenir en arrière, à rétablir des institutions que l’on considère comme surannées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6a5b0f-ef6b-4be2-aa7b-bd734ec35aef",
                                                "sense_id": "3adacaf4-2259-33a3-8230-b9a4ef43a8af",
                                                "text": "Que les réacteurs, qui avaient voué une haine particulière à celui que, dès le règne de Louis-Philippe, ils avaient insolemment surnommé « le foutriquet », n’aient pas eu de cesse qu’ils ne l’aient abattu, cela se conçoit. Mais les rétrogrades ne composaient qu’une minorité à l’Assemblée Nationale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e5d2f1d-41d6-3dea-bccf-834395a0f19f",
                                        "entry_id": "a8afab80-94ef-3a5c-b4b2-e18c148470e8",
                                        "glosses": [
                                            "Se dit de la forme lue de droite à gauche d'un motif mélodique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
