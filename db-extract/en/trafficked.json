        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5d7449b1-beaf-3f88-87bc-e0fb37ed4b39",
                "word": "trafficked",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "472d8285-210a-36a7-8cab-f544176c4a8d",
                        "entry_id": "5d7449b1-beaf-3f88-87bc-e0fb37ed4b39",
                        "glosses": [
                            "Carrying traffic; subject to traffic."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b2b56e0e-1c5e-47ca-984d-73ed055d3dca",
                                "sense_id": "472d8285-210a-36a7-8cab-f544176c4a8d",
                                "text": "Possessed of many thinly trafficked lines and dual-purpose assignments for engines, CPR commonsensically employed Pacifics as all-purpose engines, bought 4-6-2's until dieselization."
                            },
                            {
                                "example_id": "1993ad16-535e-41ba-84f6-ecd0f9726b06",
                                "sense_id": "472d8285-210a-36a7-8cab-f544176c4a8d",
                                "text": "The questionnaire was mainly referred to the white marble and was carried out at two sites, the more soiled North façade (FN), very trafficked area and the cleaner South façade (FS) (pedestrian area)."
                            },
                            {
                                "example_id": "76bcf643-fcd3-4e3d-8c8c-c7eef32404ed",
                                "sense_id": "472d8285-210a-36a7-8cab-f544176c4a8d",
                                "text": "We see a very trafficked big cross in Roma. Cars and people running everywhere. Camera holds on Emma standing on the pavement, like a statue, alone with her big suitcase."
                            },
                            {
                                "example_id": "6d29f1be-05b2-4706-8d97-a9d1ba381bd4",
                                "sense_id": "472d8285-210a-36a7-8cab-f544176c4a8d",
                                "text": "2018, Jonathan Moeller, Sevenfold Sword: Serpent, Azure Flame Media\nLikely this portion of the causeway was far more trafficked than the more remote regions."
                            },
                            {
                                "example_id": "d5eed25a-5c63-4c28-956d-fe564a8f3250",
                                "sense_id": "472d8285-210a-36a7-8cab-f544176c4a8d",
                                "text": "In a somewhat relieved tone, he shows that the heaviest trafficked routes for freight also happen to be the busiest passenger routes, enabling a concentration of services to use a small number of lines."
                            }
                        ]
                    }
                ],
