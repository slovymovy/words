                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bd2a21ce-e0fd-44f1-a000-bb84e45db869",
                        "source_entry_id": "9d33035c-c04d-35fd-b46b-7e800ca7229a",
                        "source_sense_id": "10d1dc5f-bff2-38a9-a3d3-e00fc5af0848",
                        "target_lang_word": "Kiefer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afe69309-09db-30d4-b7de-430fe1d2c95e",
                                        "entry_id": "b981cc80-ca87-3b76-a9af-53bbe96f8910",
                                        "glosses": [
                                            "Nadelbaum der Gattung Pinus (zum Beispiel Pinus sylvestris, Kiefer oder Föhre)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c3ab52-9058-4a35-a43b-42526c2c24bd",
                                                "sense_id": "afe69309-09db-30d4-b7de-430fe1d2c95e",
                                                "text": "Die Kiefer gehört zu den Nadelbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5614dbc6-1580-3038-ae3b-551c5d83857c",
                                        "entry_id": "b981cc80-ca87-3b76-a9af-53bbe96f8910",
                                        "glosses": [
                                            "Holz aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kiefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c070575-fbc9-3e5a-9aa0-002f8d253f7c",
                                        "entry_id": "69e33012-5eb2-3091-8e6e-973366e29b99",
                                        "glosses": [
                                            "zum Kauen dienender knöcherner Teil des Gesichtschädels, Träger der Zähne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc809dc8-d23c-4890-b6f4-f45b97e6fb3b",
                                                "sense_id": "7c070575-fbc9-3e5a-9aa0-002f8d253f7c",
                                                "text": "Ich bin am Kiefer operiert worden."
                                            },
                                            {
                                                "example_id": "362a19cf-9cd1-4396-86b5-aeb410845af7",
                                                "sense_id": "7c070575-fbc9-3e5a-9aa0-002f8d253f7c",
                                                "text": "„Knochenmaterial muss in das Kiefer eingebracht werden.“"
                                            },
                                            {
                                                "example_id": "b3d2245d-a37b-4840-814a-b7321abf512a",
                                                "sense_id": "7c070575-fbc9-3e5a-9aa0-002f8d253f7c",
                                                "text": "„Der Einarmige preßte die Kiefer zusammen, und der Andere konnte nirgendwo hin vor dem brechenden Geräusch.“"
                                            },
                                            {
                                                "example_id": "a2ca1d57-25c1-47c0-903b-5b9ff8f68d17",
                                                "sense_id": "7c070575-fbc9-3e5a-9aa0-002f8d253f7c",
                                                "text": "„Smoaks nahm den Haken, der seitlich im Kiefer des Haifischs steckte, und brachte ihn mehr in der Mitte an, damit der Hai sich leichter ins Schlepptau nehmen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
