                        "entry_id": "0c419b12-37e0-39d8-8c54-ca782a4c90bb",
                        "glosses": [
                            "Personne qui produit ou répare des pneus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df9ba85-3599-40d7-a0f5-4df16b389d01",
                                "sense_id": "ec99bd48-fd3a-3a40-a2d1-b584d1c078cc",
                                "text": "C'est ainsi que les balayeurs sont devenus techniciens de surface et les réparateurs de pneus des pneumaticiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "20d9ad74-f51a-3b86-b128-fe31c91c8b6f",
                        "entry_id": "0c419b12-37e0-39d8-8c54-ca782a4c90bb",
                        "glosses": [
                            "Personne qui construit ou entretient des appareils utilisant l’énergie pneumatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e68fa6-a522-4284-b2b4-c8ce121741a3",
                                "sense_id": "20d9ad74-f51a-3b86-b128-fe31c91c8b6f",
                                "text": "Le pneumaticien devra connaître les caractéristiques intrinsèques de chaque machine à automatiser, leurs particularités et il devra veiller à ca que la qualité mécanique, électrique ou même électronique soit équilibrée avec la qualité du réseau d’automatisation."
                            }
                        ]
                    }
                ],
