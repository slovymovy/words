                "senses": [
                    {
                        "sense_id": "cb7a5c63-8169-31aa-a13b-c4e8eb4f3f5e",
                        "entry_id": "4e7dc118-bb30-3af8-92a1-99c6dc208bc5",
                        "glosses": [
                            "iemand die als officiële getuige aanwezig is bij de doop van iemand en toezicht houdt op de religieuze opvoeding van de dopeling"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2424ed22-2f33-4daa-8391-8ef4fc01f524",
                                "sense_id": "cb7a5c63-8169-31aa-a13b-c4e8eb4f3f5e",
                                "text": "Want niet alle kinderen werden ten tijde van de Franse overheersing bij het gemeentebestuur aangegeven. De ouders deden dat uit ongehoorzaamheid en als een stil protest tegenover de bezetter. Die kinderen vond ik soms wel terug in de kerkelijke doopregisters. De kerkarchieven vermelden ook de doopgetuigen. Dat zijn dikwijls grootouders zodat ik nieuwe namen kon registeren of controleren.'"
                            }
                        ]
                    }
