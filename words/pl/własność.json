    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a12b7f0-1aea-3ce0-a7ba-f9ae9abe654a",
                    "sense_definition": "Rzecz lub majątek, który do kogoś należy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "posiadanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten samochód stanowi moją prywatną <w>własność</w>.",
                            "target_lang_translations": {
                                "ru": "Этот автомобиль является моей частной <w>собственностью</w>.",
                                "en": "This car is my private <w>property</w>."
                            }
                        },
                        {
                            "text": "Szanuj cudzą <w>własność</w> i nie niszcz jej.",
                            "target_lang_translations": {
                                "ru": "Уважай чужую <w>собственность</w> и не порти её.",
                                "en": "Respect other people's <w>property</w> and do not destroy it."
                            }
                        }
                    ],
                    "synonyms": [
                        "majątek",
                        "mienie",
                        "stan posiadania"
                    ],
                    "common_phrases": [
                        "własność prywatna",
                        "własność państwowa",
                        "własność publiczna",
                        "cudza własność"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещь или имущество, которое кому-то принадлежит.",
                        "en": "A thing or collection of things owned by someone; possessions or real estate."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собственность",
                                "target_lang_sense_clarification": "имущество"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "belongings, real estate, or possessions"
                            },
                            {
                                "target_lang_word": "possession",
                                "target_lang_sense_clarification": "something owned"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f811e716-77eb-3830-8d96-715e60e328a6",
                    "sense_definition": "Prawo do rozporządzania daną rzeczą i korzystania z niej na wyłączność.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "posiadanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy obywatel ma prawo do ochrony swojej <w>własności</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый гражданин имеет право на защиту своей <w>собственности</w>.",
                                "en": "Every citizen has the right to the protection of their <w>property</w>."
                            }
                        },
                        {
                            "text": "Przeniesienie <w>własności</w> domu wymaga wizyty u notariusza.",
                            "target_lang_translations": {
                                "ru": "Передача <w>собственности</w> на дом требует визита к нотариусу.",
                                "en": "The transfer of <w>ownership</w> of a house requires a visit to a notary."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prawo własności",
                        "własność intelektualna",
                        "przeniesienie własności"
                    ],
                    "target_lang_definitions": {
                        "ru": "Право распоряжаться вещью и пользоваться ею единолично.",
                        "en": "The legal right to possess, use, and dispose of a thing exclusively."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собственность",
                                "target_lang_sense_clarification": "право владения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ownership",
                                "target_lang_sense_clarification": "legal right of possession"
                            },
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "title or ownership rights"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7c5b47f-1b15-30a1-ac3c-a1bfc23ef2e5",
                    "sense_definition": "Cecha charakterystyczna dla danej osoby, rzeczy lub zjawiska.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cecha",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Badamy <w>własności</w> lecznicze tej rzadkiej rośliny.",
                            "target_lang_translations": {
                                "ru": "Мы исследуем лечебные <w>свойства</w> этого редкого растения.",
                                "en": "We are studying the medicinal <w>properties</w> of this rare plant."
                            }
                        },
                        {
                            "text": "Metal ma <w>własność</w> dobrego przewodzenia ciepła.",
                            "target_lang_translations": {
                                "ru": "Металл обладает <w>свойством</w> хорошо проводить тепло.",
                                "en": "Metal has the <w>property</w> of conducting heat well."
                            }
                        }
                    ],
                    "synonyms": [
                        "cecha",
                        "właściwość",
                        "przymiot"
                    ],
                    "common_phrases": [
                        "własności fizyczne",
                        "własności chemiczne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерная черта данного лица, предмета или явления.",
                        "en": "A characteristic quality, attribute, or feature of a person, object, or phenomenon."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свойство",
                                "target_lang_sense_clarification": "качество, характеристика"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "characteristic quality or trait"
                            },
                            {
                                "target_lang_word": "characteristic",
                                "target_lang_sense_clarification": "typical feature or quality"
                            },
                            {
                                "target_lang_word": "feature",
                                "target_lang_sense_clarification": "distinctive aspect or attribute"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}