                "senses": [
                    {
                        "sense_id": "529db3c8-a99f-35ba-a13e-93ae2a32fec9",
                        "entry_id": "16db70dc-125f-32ca-9c3b-c29f573c21b5",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de repartager (partager à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2baea99c-4da9-4c41-8908-9419d52cb089",
                                "sense_id": "529db3c8-a99f-35ba-a13e-93ae2a32fec9",
                                "text": "L’immense répartition du conte 425 et des formes associées interdit de même toute localisation pour le passage du mythe au conte, en admettant même - ce que je tiens pour probable - qu’il se soit opéré une seule fois, et de là diffusé, puis re-partagé en variantes."
                            },
                            {
                                "example_id": "8b447d4b-abd9-425c-9ae8-630b4312539c",
                                "sense_id": "529db3c8-a99f-35ba-a13e-93ae2a32fec9",
                                "text": "Dominant leur émotion, elles firent mine de se re-partager entre la pièce et les messieurs qui les reluquaient dans la salle."
                            }
                        ]
                    }
                ],
