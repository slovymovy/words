                        "glosses": [
                            "Bruit aigu anormal émis lors de l'inspiration, dû à un passage anormal de l'air dans le larynx ou la trachée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067e7bad-ea88-42e4-9859-e0a9d2255154",
                                "sense_id": "296f2bf1-ccd8-3dc0-abe3-76a749a33b74",
                                "text": "Le stridor laryngé congénital essentiel (ou laryngomalacie), l'anomalie la plus fréquente."
                            }
                        ]
                    }
                ],
                "translations": [
