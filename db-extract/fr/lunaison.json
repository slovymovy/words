                ],
                "senses": [
                    {
                        "sense_id": "6253f50b-4865-3cda-991e-c91aa61748cd",
                        "entry_id": "fac414ca-eb52-3e2d-8df4-cfa4692e8b68",
                        "glosses": [
                            "Temps qui s’écoule depuis la nouvelle lune jusqu’à la prochaine nouvelle lune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95aa1c6-069b-4b73-8b94-2473faade5f9",
                                "sense_id": "6253f50b-4865-3cda-991e-c91aa61748cd",
                                "text": "Toute cette lunaison a été pluvieuse."
                            },
                            {
                                "example_id": "0270ebea-e1b5-440d-95cc-b664f5e85b40",
                                "sense_id": "6253f50b-4865-3cda-991e-c91aa61748cd",
                                "text": "La nouvelle lunaison ramènera peut-être le beau temps."
                            },
                            {
                                "example_id": "f8cfe8f7-4115-4542-a40b-39f52eecab4c",
                                "sense_id": "6253f50b-4865-3cda-991e-c91aa61748cd",
                                "text": "Foncièrement, il ne change guère : il ne fait que subir des phases — oserai-je dire des lunaisons ? — qui le transforment, l’exaltent ou le dépriment, après lesquelles il redevient lui-même."
                            },
                            {
                                "example_id": "3513087f-7904-4c5e-a8ba-7926016c33fb",
                                "sense_id": "6253f50b-4865-3cda-991e-c91aa61748cd",
                                "text": "Je ne me demandais même pas quel allait être mon sort à la fin de la lunaison."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
