                ],
                "senses": [
                    {
                        "sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                        "entry_id": "7071e54e-1374-3d28-b7fa-45bec9a7b5bf",
                        "glosses": [
                            "Relatif à l’injonction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7f1233-48f2-4c83-9dc6-c31af2f3f438",
                                "sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                                "text": "Pour se prémunir des messages, comme ceux reçus par Tatiana Silva, Hugo Clément dit éviter « un ton péremptoire et trop injonctif. Il faut surtout mettre l’accent sur les chiffres, les images et les explications scientifiques de l’impact de l’élevage sur l’environnement. »"
                            },
                            {
                                "example_id": "255cb375-8765-47b7-a0e7-1208bbe411e7",
                                "sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                                "text": "Le serf est sommé (parole injonctive) de réaliser ce désir et, par conséquent, efface en lui tout désir propre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f7b89c1-7ce0-48c7-86da-7e22fcc16a8d",
                        "source_entry_id": "7071e54e-1374-3d28-b7fa-45bec9a7b5bf",
                        "source_sense_id": "c7660a5f-49ee-326d-b757-15990ea692e4",
                        "target_lang_word": "commanding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commanding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6f0870-d426-335e-8930-b4101d32a8a0",
                                        "entry_id": "c63298c1-58e1-3565-aba5-a715298bfad7",
                                        "glosses": [
                                            "Tending to give commands, authoritarian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4511482-ee03-4f51-bf90-f03d6613b690",
                                                "sense_id": "1e6f0870-d426-335e-8930-b4101d32a8a0",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e248c31c-11a5-39e1-9880-e5c91565ac8e",
                                        "entry_id": "c63298c1-58e1-3565-aba5-a715298bfad7",
                                        "glosses": [
                                            "Impressively dominant; very good and impressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa4df5a-3058-4ef5-a81c-2b2f67b50bb8",
                                                "sense_id": "e248c31c-11a5-39e1-9880-e5c91565ac8e",
                                                "text": "a commanding structure"
                                            },
                                            {
                                                "example_id": "6a295f7a-f088-49a3-a3dc-aa4e610c5d74",
                                                "sense_id": "e248c31c-11a5-39e1-9880-e5c91565ac8e",
                                                "text": "a man with a commanding presence"
                                            },
                                            {
                                                "example_id": "fd48646d-f2b3-4b47-9e3b-8901e6172c6b",
                                                "sense_id": "e248c31c-11a5-39e1-9880-e5c91565ac8e",
                                                "text": "Her colleagues say that [Dalia] Stasevska is eager to challenge the status quo both in the artistic realm and in life. Claire Chase, a prominent flutist and educator, described her as a “supernova,” praising her collaborative and commanding style."
                                            },
                                            {
                                                "example_id": "181d84cd-48b5-4533-b7ee-d66d75e0099c",
                                                "sense_id": "e248c31c-11a5-39e1-9880-e5c91565ac8e",
                                                "text": "Pierre Boulez, one of the most commanding musicians of the past century, must have been asked countless times, before his death in 2016, what he thought his legacy might be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83cce94d-8461-3e36-affe-710cb79f8b8f",
                                        "entry_id": "c63298c1-58e1-3565-aba5-a715298bfad7",
                                        "glosses": [
                                            "Dominating from above, giving a wide view (of a place or position)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc1d7391-d281-44f4-9b14-d4ccab66fac4",
                                                "sense_id": "83cce94d-8461-3e36-affe-710cb79f8b8f",
                                                "text": "2018, Rail, issue 857, July 18-July 31, article on Severn Bridge Junction signal box at Shrewsbury\nOn the top floor is the lever frame where signalmen are afforded an uninterrupted and commanding view of the junction below, and of Shrewsbury station's five working platforms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "commanding",
                                "target_lang_code": "en",
                                "target_senses": [
