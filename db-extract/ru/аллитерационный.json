                                    {
                                        "sense_id": "8961586b-3d82-3599-8059-265200e2c20c",
                                        "entry_id": "3da5829f-5949-366d-9061-470a2f0a7bf0",
                                        "glosses": [
                                            "Qui utilise l’allitération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "179f1432-f87c-4a29-ae5f-dfd85fa26c3e",
                                                "sense_id": "8961586b-3d82-3599-8059-265200e2c20c",
                                                "text": "La versification allitérative est une forme de versification dont la structure repose sur l’usage d’allitérations, au lieu par exemple des rimes."
                                            },
                                            {
                                                "example_id": "b36c31d5-4d80-4fc3-b303-4ec47f786f4d",
                                                "sense_id": "8961586b-3d82-3599-8059-265200e2c20c",
                                                "text": "Ces images prétendument rêvées par lesquelles je m’insinue dans la maison, me dirige vers la cave, et l’image du corps luisant, rose et rayonnant de sa rayonne à rayures (pour le plaisir allitératif) apparaissent soudain comme du réel vécu."
                                            }
                                        ]
                                    }
                                ]
