                },
                {
                    "sense_id": "3c519997-9d58-374f-9bf3-bca0b0e55464",
                    "sense_definition": "Qui est particulièrement rude, très froid et difficile à supporter, en parlant du climat ou d'une saison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "climat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants de cette région de montagne doivent affronter un hiver particulièrement <w>rigoureux</w>.",
                            "target_lang_translations": {
                                "en": "The people of this mountain region have to endure a particularly <w>harsh</w> winter.",
                                "ru": "Жителям этого горного района приходится выдерживать особенно <w>суровую</w> зиму.",
                                "de": "Die Bewohner dieser Bergregion müssen einen besonders <w>strengen</w> Winter überstehen.",
                                "es": "Los habitantes de esta región montañosa tienen que soportar un invierno especialmente <w>duro</w>.",
                                "zh": "这个山区的居民必须忍受特别<w>严寒</w>的冬天。"
                            }
                        },
                        {
                            "text": "Malgré les températures négatives d'une saison <w>rigoureuse</w>, les animaux trouvent refuge dans les granges.",
                            "target_lang_translations": {
                                "en": "Despite the sub-zero temperatures of such a <w>harsh</w> season, the animals find shelter in the barns.",
                                "ru": "Несмотря на минусовые температуры в <w>суровое</w> время года, животные находят укрытие в амбарах.",
                                "de": "Trotz der Minustemperaturen in dieser <w>rauen</w> Jahreszeit finden die Tiere Unterschlupf in den Scheunen.",
                                "es": "A pesar de las temperaturas bajo cero de una estación tan <w>dura</w>, los animales encuentran refugio en los graneros.",
                                "zh": "尽管气温降到零下，在这个<w>严酷</w>的季节里，动物们仍能在谷仓中找到栖身之处。"
                            }
                        }
                    ],
