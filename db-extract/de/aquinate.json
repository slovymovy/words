                            "singular"
                        ],
                        "form": "den Aquinaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                        "entry_id": "08878a1e-eb56-3ecf-af1c-606a4a6715d1",
                        "glosses": [
                            "Beiname des mittelalterlichen Kirchenlehrers und von den Katholiken als Heiligen verehrten Thomas von Aquin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f841da43-5556-4d18-814e-162d3d4532f8",
                                "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                                "text": "„Der Aquinate antwortet mit aller Deutlichkeit: das Wahre und das Gute können allein eine gedankliche Beziehung zum Seienden hinzufügen, die nicht etwas Reales im Seienden selbst setzt.“"
                            },
                            {
                                "example_id": "76c58a09-c4e1-4e17-bcb5-665cdc7366c2",
                                "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                                "text": "„Nun schreibt aber der Aquinate bestimmt die sakramentale Kraft erst dem vollendeten Sakramente zu […]“"
                            },
                            {
                                "example_id": "fe18f6c5-37c7-49c9-9abd-7fccab49eb53",
                                "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                                "text": "„Hier führt der Aquinate aus, wie sich die Austreibung von Dämonen durch andere Dämonen von der aus göttlicher Kraft vollzogenen unterscheidet.“"
                            },
                            {
                                "example_id": "ab7273c8-d031-4ddc-877b-780b65244574",
                                "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                                "text": "„Mehr als allen Besitz schätzte daher der Aquinate die Bücher.“"
                            },
                            {
                                "example_id": "d9051a15-1a58-4d94-afce-f1956bd65231",
                                "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                                "text": "„Albertus Magnus und Thomas von Aquin vermitteln mit großer autoritativer Wirkung die Aristotelische und Augustinische Urzeugungs-Lehre in die mittelalterliche Theologie und Naturphilosophie, wobei der Aquinat, gestützt auf die bei Aristoteles vorgezeichnete und von den Gelehrten des arabisch- islamischen Kulturkreises aufgegriffene Unterscheidung von «generatio univoca» und «generatio spontanea» davon ausgeht, daß auch nach der Schöpfung immer wieder neue Arten entstehen können.“"
                            },
                            {
                                "example_id": "9bc26932-96c7-43ef-8aa6-b33a8aa0f7e2",
                                "sense_id": "0bc8ba6d-862a-3bfd-8034-e2de42075df6",
                                "text": "„Die Argumentationen des Aquinaten stützen sich zu einem großen Teil auf die sich im Hochmittelalter wieder ausbreitenden Gedanken des Aristoteles, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
