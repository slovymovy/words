                    ],
                    "synonyms": [
                        "absence",
                        "manque",
                        "pénurie"
                    ],
                    "antonyms": [
                        "abondance",
                        "excès"
                    ],
                    "common_phrases": [
                        "faire défaut",
                        "à défaut de",
                        "défaut de paiement"
                    ]
                },
                {
                    "sense_id": "8abc41a2-2878-367a-bc83-bc490811148e",
                    "sense_definition": "Option, valeur ou réglage préétabli par le système qui s'applique si l'utilisateur n'en choisit pas d'autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous ne modifiez rien, la valeur par <w>défaut</w> sera conservée pour ce fichier."
                        },
                        {
                            "text": "L'application utilise par <w>défaut</w> la langue principale de votre système d'exploitation."
                        }
                    ],
                    "common_phrases": [
                        "par défaut",
                        "valeur par défaut"
                    ]
                },
                {
                    "sense_id": "b974f7c9-f416-3335-8b8d-99f72b467921",
                    "sense_definition": "Fait, pour une partie assignée en justice, de ne pas se présenter devant le tribunal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé ne s'étant pas présenté à l'audience, il a été condamné par <w>défaut</w>."
                        },
                        {
                            "text": "Le tribunal a prononcé un jugement par <w>défaut</w> en l'absence du défendeur."
                        }
                    ],
                    "synonyms": [
                        "non-comparution"
                    ],
                    "antonyms": [
                        "comparution"
                    ],
                    "common_phrases": [
                        "jugement par défaut",
                        "condamner par défaut"
                    ]
                },
                {
                    "sense_id": "ffa457c7-0c78-339d-948b-da9354fc5f55",
                    "sense_definition": "Manière d'arrondir ou d'estimer un nombre à une valeur immédiatement inférieure à sa valeur exacte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En arrondissant par <w>défaut</w> à l'unité, le nombre douze virgule huit devient douze."
                        },
                        {
                            "text": "Le professeur nous demande de calculer une approximation par <w>défaut</w> de ce résultat."
                        }
                    ],
                    "common_phrases": [
                        "arrondi par défaut"
                    ]
                },
                {
                    "sense_id": "e786eb12-e8d9-3456-9e40-2cea1b2ac86a",
                    "sense_definition": "Endroit du corps où se termine une partie anatomique ou où une articulation forme un creux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur a ajusté son tir exactement au <w>défaut</w> de l'épaule de l'animal."
                        },
                        {
                            "text": "Il ressentait une vive douleur au <w>défaut</w> du genou après sa longue marche."
                        }
                    ],
                    "common_phrases": [
                        "défaut de l'épaule"
                    ]
                }
            ]
        }
    ]
