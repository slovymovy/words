                    {
                        "sense_id": "93a02e99-75cc-3727-a828-f98fe27da000",
                        "entry_id": "feb254ee-adaf-3b28-8a47-f0542ad7882e",
                        "glosses": [
                            "aanlegsteiger, vloer boven een water en aan de waterkant"
                        ],
                        "tags": [
                            "Noord- en Zuid-Holland",
                            "kleine"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc8a36d-cdad-45b1-968c-f6aee1449b06",
                                "sense_id": "93a02e99-75cc-3727-a828-f98fe27da000",
                                "text": "„Ratten zijn gek op voedsel, op water en op schuilplekken, zoals vlonders of muren met klimop. Wie dat weghaalt, maakt het onaantrekkelijk voor een rat.”"
                            },
                            {
                                "example_id": "d5703929-3bc7-487f-97ee-1ce357c96dee",
                                "sense_id": "93a02e99-75cc-3727-a828-f98fe27da000",
                                "text": "Het terras en de vlonder worden overdekt, er zijn vijf masterclasses van brouwerijen en bezoekers kunnen afsluitend, middels een workshop, zelf bokbier brouwen. „Die kun je dan acht weken later ophalen in flesjes. Het hele brouwproces doe je dan hier. Op het biljart komt een ketel te staan.” Er zijn ook verschillende eettentjes."
                            }
                        ]
                    },
