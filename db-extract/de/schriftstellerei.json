                "senses": [
                    {
                        "sense_id": "0184e05e-5786-3240-ac66-8aa5093bbd78",
                        "entry_id": "bfb254d4-8d67-3d2f-bcda-374ed4426bde",
                        "glosses": [
                            "wiederholtes und/oder berufsmäßiges Verfassen von Texten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c38dc2c-7369-48f0-8acc-bd208747135f",
                                "sense_id": "0184e05e-5786-3240-ac66-8aa5093bbd78",
                                "text": "„Aber diese eifrige Schriftstellerei half dem armen Schlump wenig.“"
                            },
                            {
                                "example_id": "7895066b-0c98-4aed-bd5a-e609f6c1422c",
                                "sense_id": "0184e05e-5786-3240-ac66-8aa5093bbd78",
                                "text": "„In meiner Heimat war die Schriftstellerei neben der Kosmonautik eine verantwortungsvolle Staatsaufgabe.“"
                            },
                            {
                                "example_id": "22979b54-afea-4c15-8499-e58e691bf99f",
                                "sense_id": "0184e05e-5786-3240-ac66-8aa5093bbd78",
                                "text": "„Dik war so erfolgreich, dass er die Schriftstellerei zu seinem Brotberuf machen konnte, als die Kronschule 1864 geschlossen wurde und er in Geldnöte geriet.“"
                            },
                            {
                                "example_id": "8f1c67eb-7f51-4df0-9ce9-822a61ce11ee",
                                "sense_id": "0184e05e-5786-3240-ac66-8aa5093bbd78",
                                "text": "„Obwohl es auch in dieser Karriere turbulent zuging, kann man in der Schriftstellerei eine von zwei Geraden sehen, die Twains Zickzackleben durchzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
