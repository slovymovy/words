                    ]
                },
                {
                    "sense_id": "dcf92d82-ec93-3d91-a611-aaa5dff09842",
                    "sense_definition": "Kleines sternförmiges Schriftzeichen, das häufig als Verweis auf eine Fußnote oder Zusatzinformation dient",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hinter dem fremden Wort im Buch steht ein kleines <w>Sternchen</w> als Hinweis."
                        },
                        {
                            "text": "Der Autor wollte im Text ein <w>Sternchen</w> setzen und unten die Quelle angeben."
                        }
                    ],
                    "synonyms": [
