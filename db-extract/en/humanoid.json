                    },
                    {
                        "translation_id": "36eb3993-737e-453e-b124-ed05838552ac",
                        "source_entry_id": "a430f414-a406-33d5-b280-e40e4543da4f",
                        "source_sense_id": "15a64066-8a4b-3c1d-a6ac-f4d7c11f12ae",
