                        "poster une photo"
                    ]
                },
                {
                    "sense_id": "b1dcbde0-9aca-3b42-a93f-73bd1b5f5bbc",
                    "sense_definition": "Déposer un courrier ou un paquet dans une boîte ou un bureau pour l'expédier par les services postaux.",
