                        "entry_id": "9dcf6305-9f71-3ba9-9fb7-b8e853818ba3",
                        "glosses": [
                            "Any of various shrubs and small trees in the genus Ligustrum."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d08b090-ebb9-4712-9ada-1816b0570e72",
                                "sense_id": "598e7f94-ec16-3290-ba68-acf564d1006a",
                                "text": "Slowly she turned round and faced towards a neat white bungalow, set some way back from the path behind a low hedge of golden privet. No light showed, but someone there was playing the piano. The strange elusiveness of the soft, insistent melody seemed to draw her forward."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "913e50df-a4d3-4e6e-913e-df6b647eda08",
                        "source_entry_id": "9dcf6305-9f71-3ba9-9fb7-b8e853818ba3",
                        "source_sense_id": "598e7f94-ec16-3290-ba68-acf564d1006a",
