                                        "entry_id": "e60b23a7-a64d-3ad1-9ee8-2ed3ba3bdc62",
                                        "glosses": [
                                            "To create a concordance from (a corpus)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4cdd441-d21d-402e-af75-ab5cf3b65c7c",
                                                "sense_id": "5bdb3d94-86d8-3b26-8a44-1a76104f1795",
                                                "text": "Different from concordances of the Bible or classic works in the western tradition, which were basically complete concordances of a specific single book, the Chinese Lei Shu usually concordanced miscellaneous books."
                                            }
                                        ]
                                    }
                                ]
