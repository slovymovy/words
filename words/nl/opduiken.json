{
    "word_family": [
        "duiken",
        "duiker",
        "duikplank",
        "duikboot",
        "onderduiken",
        "afduiken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c63f76f5-6b86-32e2-bc32-b8fbe07e69a8",
                    "sense_definition": "weer aan het oppervlak zichtbaar worden na ondergedoken geweest te zijn",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "oppervlakte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pinguïn <w>dook</w> weer <w>op</w> met een visje in zijn bek.",
                            "target_lang_translations": {
                                "en": "The penguin <w>surfaced</w> again with a small fish in its beak."
                            }
                        },
                        {
                            "text": "Na een minuut onder water te zijn gebleven, <w>dook</w> de zwemmer eindelijk weer <w>op</w>.",
                            "target_lang_translations": {
                                "en": "After staying underwater for a minute, the swimmer finally <w>surfaced</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "bovenkomen"
                    ],
                    "antonyms": [
                        "onderduiken"
                    ],
                    "common_phrases": [
                        "boven water opduiken"
                    ],
                    "target_lang_definitions": {
                        "en": "To become visible at the surface again after having been submerged."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to surface",
                                "target_lang_sense_clarification": "coming up from underwater"
                            },
                            {
                                "target_lang_word": "to emerge",
                                "target_lang_sense_clarification": "rising out of a liquid"
                            },
                            {
                                "target_lang_word": "to pop up",
                                "target_lang_sense_clarification": "suddenly appearing at the surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c88c6752-1b43-37ab-85f1-1be8034d5306",
                    "sense_definition": "plotseling of onverwacht verschijnen na een tijdje afwezig of verborgen te zijn geweest",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verschijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik was er veel mee bezig, vooral als bekenden opeens voor me <w>opdoken</w>.",
                            "target_lang_translations": {
                                "en": "I was very preoccupied with it, especially when acquaintances suddenly <w>turned up</w> in front of me."
                            }
                        },
                        {
                            "text": "Het is niet de eerste keer dat deze zeldzame vogel in Nederland <w>opduikt</w>.",
                            "target_lang_translations": {
                                "en": "It is not the first time that this rare bird has <w>popped up</w> in the Netherlands."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschijnen",
                        "tevoorschijn komen",
                        "opsteken"
                    ],
                    "antonyms": [
                        "verdwijnen"
                    ],
                    "common_phrases": [
                        "plotseling opduiken",
                        "overal opduiken",
                        "onverwacht opduiken"
                    ],
                    "target_lang_definitions": {
                        "en": "To appear suddenly or unexpectedly after being absent or hidden for a while."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn up",
                                "target_lang_sense_clarification": "appearing unexpectedly"
                            },
                            {
                                "target_lang_word": "to pop up",
                                "target_lang_sense_clarification": "appearing suddenly in a place or conversation"
                            },
                            {
                                "target_lang_word": "to crop up",
                                "target_lang_sense_clarification": "appearing or happening unexpectedly"
                            },
                            {
                                "target_lang_word": "to resurface",
                                "target_lang_sense_clarification": "appearing again after a long absence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b873bb6c-44c8-30d8-83d9-b7ede9c6c09f",
                    "sense_definition": "iets uit de diepte of uit een verborgen plek naar boven halen of vinden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>doken</w> een Griekse amfoor <w>op</w> tijdens hun vakantie aan de kust.",
                            "target_lang_translations": {
                                "en": "They <w>fished out</w> a Greek amphora during their holiday at the coast."
                            }
                        },
                        {
                            "text": "De archivaris wist een oud document uit de kelder <w>op</w> te <w>duiken</w>.",
                            "target_lang_translations": {
                                "en": "The archivist managed to <w>dig up</w> an old document from the basement."
                            }
                        }
                    ],
                    "synonyms": [
                        "opvissen",
                        "opdiepen",
                        "vinden"
                    ],
                    "common_phrases": [
                        "iets ouds opduiken",
                        "informatie opduiken"
                    ],
                    "target_lang_definitions": {
                        "en": "To retrieve or find something from the depths or from a hidden place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to dig up",
                                "target_lang_sense_clarification": "finding something hidden or forgotten"
                            },
                            {
                                "target_lang_word": "to fish out",
                                "target_lang_sense_clarification": "retrieving something from a container or depth"
                            },
                            {
                                "target_lang_word": "to unearth",
                                "target_lang_sense_clarification": "discovering something lost or buried"
                            },
                            {
                                "target_lang_word": "to dredge up",
                                "target_lang_sense_clarification": "bringing something to light from the past or depths"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}