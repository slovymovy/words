                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer took a severe <w>pounding</w> during the final round.",
                            "target_lang_translations": {
