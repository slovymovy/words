{
    "word_family": [
        "reminder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6a75123-7cee-3a25-9fdd-5dc4e1c52986",
                    "sense_definition": "To cause someone to remember something or someone; to bring something to someone's attention.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>remind</w> me to buy milk on my way home.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>напомни</w> мне купить молоко по дороге домой.",
                                "zh": "请在回家的路上<w>提醒</w>我买牛奶。"
                            }
                        },
                        {
                            "text": "This old photograph <w>reminds</w> me of my grandfather.",
                            "target_lang_translations": {
                                "ru": "Эта старая фотография <w>напоминает</w> мне о дедушке.",
                                "zh": "这张旧照片让我想<w>起</w>了我的祖父。"
                            }
                        }
                    ],
                    "synonyms": [
                        "put someone in mind of",
                        "prompt"
                    ],
                    "common_phrases": [
                        "remind me later",
                        "remind someone of",
                        "remind yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо вспомнить что-либо или кого-либо; обращать чьё-либо внимание на что-либо.",
                        "zh": "使某人想起某事或某人；引起某人对某事的注意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напоминать",
                                "target_lang_sense_clarification": "вызывать воспоминания или быть похожим"
                            },
                            {
                                "target_lang_word": "напомнить",
                                "target_lang_sense_clarification": "указать на необходимость сделать что-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提醒",
                                "target_lang_sense_clarification": "告知某人去做某事"
                            },
                            {
                                "target_lang_word": "使想起",
                                "target_lang_sense_clarification": "因某物而联想到某人或某事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61d55444-cd4c-315a-b419-b444f459727b",
                    "sense_definition": "An act of reminding; a reminder.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just a quick <w>remind</w> that we have a meeting at noon.",
                            "target_lang_translations": {
                                "ru": "Просто короткое <w>напоминание</w> о том, что у нас встреча в полдень.",
                                "zh": "只是简单<w>提醒</w>一下，我们中午有个会议。"
                            }
                        },
                        {
                            "text": "She sent a <w>remind</w> to the team about the deadline.",
                            "target_lang_translations": {
                                "ru": "Она отправила команде <w>напоминание</w> о крайнем сроке.",
                                "zh": "她给团队发了一个关于截止日期的<w>提醒</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a shortening of reminder"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по значению глагола напоминать; напоминание.",
                        "zh": "提醒的行为；起提醒作用的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напоминание",
                                "target_lang_sense_clarification": "сообщение или действие, чтобы не забыть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提醒",
                                "target_lang_sense_clarification": "作为名词使用时，指提醒的动作"
                            },
                            {
                                "target_lang_word": "提示",
                                "target_lang_sense_clarification": "指为了防止遗忘而发出的信息"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}