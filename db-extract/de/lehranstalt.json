                "senses": [
                    {
                        "sense_id": "7bc0ce05-cf24-3f12-a7c2-376dab579103",
                        "entry_id": "b278cd99-f927-3c32-9510-64baef1b799d",
                        "glosses": [
                            "Einrichtung/Institution, deren Aufgabe es ist, zu lehren/unterrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5a7e9a-d481-49ba-926a-b14f4070c0d0",
                                "sense_id": "7bc0ce05-cf24-3f12-a7c2-376dab579103",
                                "text": "„In Köln gab es zwar seit 1798 keine Universität mehr, aber maßgebliche Teile der Bürgerschaft arbeiteten daran, die höhere Lehranstalt wieder zu errichten.“"
                            },
                            {
                                "example_id": "ce8e05dc-65cf-4114-8875-3400f06b0ee7",
                                "sense_id": "7bc0ce05-cf24-3f12-a7c2-376dab579103",
                                "text": "„Dem Bericht zufolge plante die renommierte Lehranstalt in den späten Neunzigerjahren eine räumliche Erweiterung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
