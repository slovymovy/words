                "senses": [
                    {
                        "sense_id": "ce74133c-5eae-3703-984a-6c6e391621a5",
                        "entry_id": "515dd0e6-9af9-39c0-ac8e-5206f4d6691a",
                        "glosses": [
                            "A lucky omen."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "042f132d-a159-36c4-82af-2b87c8d01f9d",
                        "entry_id": "515dd0e6-9af9-39c0-ac8e-5206f4d6691a",
                        "glosses": [
                            "A gift given at New Year, or at the start of some enterprise or new situation, meant to ensure good luck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93dcf24-c758-4cef-954a-57ff213914fb",
                                "sense_id": "042f132d-a159-36c4-82af-2b87c8d01f9d",
                                "text": "their first good handsel of breath in this world"
                            },
                            {
                                "example_id": "a988aeb0-079f-4ab9-b485-8c96c7c0fe58",
                                "sense_id": "042f132d-a159-36c4-82af-2b87c8d01f9d",
                                "text": "Our present tears here, not our present laughter, / Are but the handsels of our joys hereafter."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fb87d8a-8631-35aa-8e02-9605c318ce60",
                        "entry_id": "515dd0e6-9af9-39c0-ac8e-5206f4d6691a",
                        "glosses": [
                            "Price, payment; especially the first installment of a series."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1ddee77a-d106-460b-82ea-4638aded9eab",
                                "sense_id": "0fb87d8a-8631-35aa-8e02-9605c318ce60",
                                "text": "\"I see the first handsel that God gives them on their voyage to the Land of Promise; thirst and bitterness.\"\n(From Contemplations, Book Five, Contemplation 1, The Waters of Marah (Found in volume 1 of The Works of Joseph\nHall, edited by Peter Hall, published by Talboys, Oxford, 1837, page 88))"
                            },
                            {
                                "example_id": "5cf32fd3-7d3e-4823-bd20-a389cf4fb8bc",
                                "sense_id": "0fb87d8a-8631-35aa-8e02-9605c318ce60",
                                "text": "That whoso hardy hand on her doth lay ,\nIt dearly shall abye and death for handsel pay"
                            }
                        ]
                    }
                ],
