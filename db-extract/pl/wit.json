                    {
                        "translation_id": "2644392c-3fbd-4079-a67f-dafd77d58221",
                        "source_entry_id": "d89bd668-6b85-3183-8496-0adb8e096181",
                        "source_sense_id": "5f5d0ed8-845e-31fc-994e-90aff7698aa8",
                        "target_lang_word": "Guy",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Guy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5935b8b6-b961-339d-8777-89e701999d13",
                                        "entry_id": "63e51381-34a6-3ef9-a643-c4cf80814f3b",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2da48530-3b98-45ca-8a19-4381e4a1212c",
                                                "sense_id": "5935b8b6-b961-339d-8777-89e701999d13",
                                                "text": "J’ai dans la tête un vieux sapin, une crèche en d’ssous\n Un Saint-Joseph avec une canne en caoutchouc\n Était mal faite pis j’avais frette\n Quand je r’venais d’passer trois heures dans un igloo\n Qu’on avait fait deux ou trois gars chez Guy Rondoux."
                                            },
                                            {
                                                "example_id": "7c7cff25-e485-4e72-a833-e75ab29e8c6f",
                                                "sense_id": "5935b8b6-b961-339d-8777-89e701999d13",
                                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                                            },
                                            {
                                                "example_id": "417ea17a-d90c-445a-b341-3fabc82269ef",
                                                "sense_id": "5935b8b6-b961-339d-8777-89e701999d13",
                                                "text": "Enfin, la rubrique Rencontre fait la part belle à l’art culinaire dont Guy Savoy, chef triplement étoilé, parle avec passion en nous racontant son parcours personnel et professionnel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Guy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e644fbd9-0897-3e07-b13a-c34f8c1a02d3",
                                        "entry_id": "66e2050c-9a19-3035-9a38-f2d4a0f32dc9",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f6d17e-3249-4479-8382-2eea9b57b140",
                                                "sense_id": "e644fbd9-0897-3e07-b13a-c34f8c1a02d3",
                                                "text": "Buddy Guy, 87 ans à la fin du mois, joue (à guichets fermés) ce samedi 8 juillet sur la grande scène du 30ᵉ festival Cognac Blues Passions."
                                            },
                                            {
                                                "example_id": "bad14fff-1e8e-4f9e-b126-040e33812bc3",
                                                "sense_id": "e644fbd9-0897-3e07-b13a-c34f8c1a02d3",
                                                "text": "Grégory Gadebois, Estéban, le nouveau venu Thomas Guy et le trop rare Sergi López composent la troupe hétéroclite qui entoure Yolande Moreau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
