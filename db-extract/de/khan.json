                        "entry_id": "7be0a9f4-9ae6-3112-aa75-d68ab220a842",
                        "glosses": [
                            "Titel eines mongolischen oder türkischen Herrschers"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a6b61afe-abf9-44b0-aea6-dd945b3ba7ff",
                                "sense_id": "76916e2c-ae19-31b4-b77e-0dc0776929bc",
                                "text": "Kublai Khan war ein Enkel Dschingis Khans."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79182ce0-b95b-3a0d-8c93-bf05a268c6b3",
                        "entry_id": "7be0a9f4-9ae6-3112-aa75-d68ab220a842",
                        "glosses": [
                            "Träger des Titels [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d56211da-61d4-4b40-8761-e1da38fa8237",
                                "sense_id": "79182ce0-b95b-3a0d-8c93-bf05a268c6b3",
                                "text": "Die Herrschaft dieser Mongolischen Altyn-Khane war […] aber nur von kurzer Dauer."
                            },
                            {
                                "example_id": "e2031d9c-18c1-4edf-8fc5-1be545363106",
                                "sense_id": "79182ce0-b95b-3a0d-8c93-bf05a268c6b3",
                                "text": "„Sie umschließt den Palast des Khan und zwei Moscheen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5828178e-1fa2-3e38-8421-dd8b6336216c",
                        "entry_id": "7be0a9f4-9ae6-3112-aa75-d68ab220a842",
                        "glosses": [
                            "hoher staatlicher, persischer Würdenträger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72bfa582-1f54-4562-97b5-400f7401e817",
                                "sense_id": "5828178e-1fa2-3e38-8421-dd8b6336216c",
                                "text": "Die alten Könige von Turan hatten, von Vater auf Sohn, nur den Titel Khan geführt, Se. Majestät aber legten dem Abul Feiz, aus gar zu grosser Güte, den Titel Schah bey."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
