{
    "word_family": [
        "uncompromising"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02b9e308-e352-3365-a5ba-f59ee5115535",
                    "sense_definition": "An agreement reached by each side making concessions to end a dispute.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "agreement_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sides finally reached a <w>compromise</w> after long talks.",
                            "target_lang_translations": {
                                "ru": "Обе стороны наконец достигли <w>компромисса</w> после долгих переговоров.",
                                "tr": "İki taraf uzun görüşmelerden sonra nihayet bir <w>uzlaşmaya</w> vardı."
                            }
                        },
                        {
                            "text": "It was a fair <w>compromise</w> that satisfied everyone involved.",
                            "target_lang_translations": {
                                "ru": "Это был справедливый <w>компромисс</w>, который удовлетворил всех участников.",
                                "tr": "İlgili herkesi memnun eden adil bir <w>uzlaşmaydı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reach a compromise",
                        "make a compromise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соглашение, достигнутое путем взаимных уступок для прекращения спора.",
                        "tr": "Anlaşmazlığı sona erdirmek için her iki tarafın karşılıklı ödünler vererek vardığı anlaşma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компромисс",
                                "target_lang_sense_clarification": "соглашение на основе уступок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzlaşma",
                                "target_lang_sense_clarification": "karşılıklı anlaşma ve mutabakat"
                            },
                            {
                                "target_lang_word": "ödün",
                                "target_lang_sense_clarification": "karşı taraf yararına vazgeçme"
                            },
                            {
                                "target_lang_word": "taviz",
                                "target_lang_sense_clarification": "ödün verme durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13fef350-857d-31d6-a7c0-cc1ec9e84473",
                    "sense_definition": "An unauthorized access to or loss of sensitive data in a computer system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "security_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a serious security <w>compromise</w> last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе компания сообщила о серьезной <w>компрометации</w> системы безопасности.",
                                "tr": "Şirket geçen hafta ciddi bir güvenlik <w>ihlali</w> bildirdi."
                            }
                        },
                        {
                            "text": "We must prevent any <w>compromise</w> of our user data.",
                            "target_lang_translations": {
                                "ru": "Мы должны предотвратить любую <w>компрометацию</w> данных наших пользователей.",
                                "tr": "Kullanıcı verilerimizin herhangi bir şekilde <w>tehlikeye atılmasını</w> önlemeliyiz."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несанкционированный доступ к конфиденциальным данным в компьютерной системе или их утечка.",
                        "tr": "Bir bilgisayar sistemindeki hassas verilere yetkisiz erişim veya bu verilerin sızdırılması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компрометация",
                                "target_lang_sense_clarification": "нарушение безопасности данных"
                            },
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "потеря данных"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "güvenlik ihlali",
                                "target_lang_sense_clarification": "sistemin güvenliğinin bozulması"
                            },
                            {
                                "target_lang_word": "veri sızıntısı",
                                "target_lang_sense_clarification": "gizli bilgilerin dışarı çıkması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad72122-400b-3142-857c-de322f5fb84b",
                    "sense_definition": "A lowering of standards or principles, often with negative results.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "danger_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Accepting that money would be a <w>compromise</w> of his integrity.",
                            "target_lang_translations": {
                                "ru": "Принятие этих денег стало бы <w>сделкой</w> с его совестью.",
                                "tr": "O parayı kabul etmek, dürüstlüğünden <w>ödün vermek</w> olurdu."
                            }
                        },
                        {
                            "text": "There can be no <w>compromise</w> when it comes to safety regulations.",
                            "target_lang_translations": {
                                "ru": "Когда речь идет о правилах безопасности, не может быть никаких <w>компромиссов</w>.",
                                "tr": "Güvenlik yönetmelikleri söz konusu olduğunda hiçbir <w>taviz</w> verilemez."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижение стандартов или отступление от принципов, часто с негативными последствиями.",
                        "tr": "Genellikle olumsuz sonuçlar doğuran, standartların düşürülmesi veya ilkelerden taviz verilmesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделка с совестью",
                                "target_lang_sense_clarification": "отступление от принципов"
                            },
                            {
                                "target_lang_word": "компромисс",
                                "target_lang_sense_clarification": "уступка в ущерб качеству"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilkelerden ödün verme",
                                "target_lang_sense_clarification": "değerlerden vazgeçme"
                            },
                            {
                                "target_lang_word": "taviz",
                                "target_lang_sense_clarification": "standartların düşürülmesi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f64ac2f-d0cc-3fc2-8deb-dbdb1df07df3",
                    "sense_definition": "To settle a dispute or reach an agreement by each side giving up something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "agreement_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>compromise</w> on the price to reach a deal.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>пойти на компромисс</w> в вопросе цены, чтобы заключить сделку.",
                                "tr": "Anlaşmaya varmak için fiyatta <w>uzlaşmak</w> zorunda kaldık."
                            }
                        },
                        {
                            "text": "They refused to <w>compromise</w> with the opposition party.",
                            "target_lang_translations": {
                                "ru": "Они отказались <w>идти на компромисс</w> с оппозиционной партией.",
                                "tr": "Muhalefet partisiyle <w>uzlaşmayı</w> reddettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "split the difference"
                    ],
                    "common_phrases": [
                        "compromise on",
                        "compromise with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Урегулировать спор или прийти к соглашению, когда каждая сторона в чем-то уступает.",
                        "tr": "Her iki tarafın bir şeyler vererek bir anlaşmazlığı çözmesi veya bir anlaşmaya varması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти на компромисс",
                                "target_lang_sense_clarification": "договариваться уступая"
                            },
                            {
                                "target_lang_word": "прийти к соглашению",
                                "target_lang_sense_clarification": "договориться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzlaşmak",
                                "target_lang_sense_clarification": "karşılıklı ödünlerle anlaşmaya varmak"
                            },
                            {
                                "target_lang_word": "anlaşmaya varmak",
                                "target_lang_sense_clarification": "ortak bir noktada buluşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecba59a3-3423-3954-89de-435c4d303a33",
                    "sense_definition": "To bring into danger or weaken someone's reputation, safety, or principles.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "danger_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leak of secret documents could <w>compromise</w> national security.",
                            "target_lang_translations": {
                                "ru": "Утечка секретных документов может <w>поставить под угрозу</w> национальную безопасность.",
                                "tr": "Gizli belgelerin sızdırılması ulusal güvenliği <w>tehlikeye atabilir</w>."
                            }
                        },
                        {
                            "text": "He did not want to <w>compromise</w> his integrity by lying.",
                            "target_lang_translations": {
                                "ru": "Он не хотел <w>поступаться</w> своей честностью ради лжи.",
                                "tr": "Yalan söyleyerek dürüstlüğünü <w>zedelemek</w> istemedi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compromise safety",
                        "compromise security"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать опасности или наносить ущерб чьей-либо репутации, безопасности или принципам.",
                        "tr": "Birinin itibarını, güvenliğini veya ilkelerini tehlikeye atmak veya zayıflatmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить под угрозу",
                                "target_lang_sense_clarification": "подвергать опасности"
                            },
                            {
                                "target_lang_word": "компрометировать",
                                "target_lang_sense_clarification": "порочить репутацию"
                            },
                            {
                                "target_lang_word": "поступаться",
                                "target_lang_sense_clarification": "отказываться от принципов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tehlikeye atmak",
                                "target_lang_sense_clarification": "güvenliği veya durumu riske sokmak"
                            },
                            {
                                "target_lang_word": "itibarını zedelemek",
                                "target_lang_sense_clarification": "saygınlığına zarar vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7982bc44-4c8b-39a7-bbc7-49eb23c3f581",
                    "sense_definition": "To gain unauthorized access to a computer system or encrypted data.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "security_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hackers managed to <w>compromise</w> the bank's database.",
                            "target_lang_translations": {
                                "ru": "Хакерам удалось <w>взломать</w> базу данных банка.",
                                "tr": "Hackerlar bankanın veritabanını <w>ele geçirmeyi</w> başardı."
                            }
                        },
                        {
                            "text": "The firewall was unable to prevent the system from being <w>compromised</w>.",
                            "target_lang_translations": {
                                "ru": "Брандмауэр не смог предотвратить <w>взлом</w> системы.",
                                "tr": "Güvenlik duvarı, sistemin <w>ele geçirilmesini</w> engelleyemedi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить несанкционированный доступ к компьютерной системе или зашифрованным данным.",
                        "tr": "Bir bilgisayar sistemine veya şifreli verilere yetkisiz erişim sağlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взламывать",
                                "target_lang_sense_clarification": "получать незаконный доступ"
                            },
                            {
                                "target_lang_word": "компрометировать",
                                "target_lang_sense_clarification": "нарушать целостность системы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sistemi ele geçirmek",
                                "target_lang_sense_clarification": "yetkisiz erişim sağlamak"
                            },
                            {
                                "target_lang_word": "hacklemek",
                                "target_lang_sense_clarification": "bilgisayar sistemine sızmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}