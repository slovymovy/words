    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15a4d634-5b50-352a-b211-132fc678575d",
                    "sense_definition": "Établissement de soins de santé, le plus souvent privé, où des patients sont examinés, soignés ou hospitalisés.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etablissement_soins",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a été admise dans une <w>clinique</w> privée pour subir une petite opération."
                        },
                        {
                            "text": "Mon médecin généraliste m'a conseillé de consulter un spécialiste à la <w>clinique</w>."
                        }
                    ],
                    "synonyms": [
                        "hôpital",
                        "dispensaire"
                    ],
                    "common_phrases": [
                        "clinique privée",
                        "entrer en clinique"
                    ]
                },
                {
                    "sense_id": "0c75e59a-4214-31e1-8bb0-3d3d014a399b",
                    "sense_definition": "Enseignement médical dispensé auprès des patients ou pratique de la médecine fondée sur leur observation directe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discipline_medicale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune médecin brillant a été nommé chef de <w>clinique</w> l'année dernière."
                        },
                        {
                            "text": "Les cours de <w>clinique</w> permettent aux futurs praticiens d'apprendre au chevet des malades."
                        }
                    ],
                    "common_phrases": [
                        "chef de clinique",
                        "cours de clinique"
                    ]
                },
                {
                    "sense_id": "489ae416-59e0-3a4c-88d9-03393e83d456",
                    "sense_definition": "Ensemble des signes, symptômes et observations relevés directement lors de l'examen d'un patient.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discipline_medicale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats des analyses sanguines viennent confirmer ce que suggérait déjà la <w>clinique</w>."
                        },
                        {
                            "text": "Dans cette pathologie rare, la <w>clinique</w> reste souvent trompeuse lors des premières semaines."
                        }
                    ],
                    "synonyms": [
                        "symptomatologie"
                    ]
                },
                {
                    "sense_id": "f81c89a0-a62a-3666-83a1-87508fc2d9e9",
                    "sense_definition": "Dans l'Église chrétienne primitive, personne qui retardait son baptême jusqu'à son lit de mort.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains théologiens de l'Antiquité critiquaient ouvertement l'attitude hésitante des <w>cliniques</w>."
                        },
                        {
                            "text": "Un <w>clinique</w> attendait souvent les derniers instants de son agonie pour demander le baptême."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme historique de théologie chrétienne primitive"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf0bcdfe-cda5-344a-8565-57475f2f7941",
                    "sense_definition": "Qui se rapporte à l'observation directe du patient, au diagnostic médical ou aux soins prodigués.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le docteur a procédé à un examen <w>clinique</w> minutieux avant de poser son diagnostic."
                        },
                        {
                            "text": "Les résultats de ces essais <w>cliniques</w> confirment la remarquable tolérance du nouveau traitement."
                        }
                    ],
                    "synonyms": [
                        "médical"
                    ],
                    "common_phrases": [
                        "examen clinique",
                        "essai clinique",
                        "tableau clinique",
                        "mort clinique"
                    ]
                },
                {
                    "sense_id": "be0b0f30-c26d-3a92-8fb2-c63497bc4dbf",
                    "sense_definition": "Caractérisé par une froideur, une lucidité ou un détachement rigoureux, comparable à la rigueur d'un constat médical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a raconté les faits avec une précision <w>clinique</w> et sans laisser transparaître d'émotion."
                        },
                        {
                            "text": "Son regard <w>clinique</w> sur les défauts de son entreprise a permis d'éviter la faillite."
                        }
                    ],
                    "synonyms": [
                        "froid",
                        "détaché",
                        "objectif",
                        "impersonnel"
                    ],
                    "antonyms": [
                        "passionné",
                        "émotif",
                        "chaleureux"
                    ],
                    "common_phrases": [
                        "précision clinique",
                        "regard clinique"
                    ]
                }
            ]
        }
    ]
}