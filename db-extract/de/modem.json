                ],
                "senses": [
                    {
                        "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                        "entry_id": "165e6cf4-bb1a-3ad5-9357-9518f025bedb",
                        "glosses": [
                            "Apparat zum Übertragen (Senden und Empfangen) digitaler Daten durch analoge Signale (häufig über Telefonleitungen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235dc564-cea5-4256-857f-2dc0d4fc87e3",
                                "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                "text": "Bei meiner ersten Internetverbindung habe ich noch ein 28k Modem benutzt; heute sind 56k üblich."
                            },
                            {
                                "example_id": "7500f31e-fc29-4823-baa6-704a1855da43",
                                "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                "text": "Für Faxverbindungen der üblichen Gruppe 3 genügt ein Modem mit 9600 oder 14.400 Bit pro Sekunde."
                            },
                            {
                                "example_id": "6661910a-8f0e-4fcd-b9b4-89e65da44383",
                                "sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
                                "text": "„Um Forschung in einem Feld zu betreiben, in dem eine neue Sparte der Erzählkultur im Entstehen begriffen ist, braucht man heute seine Wohnung nicht mehr zu verlassen, die benötigten Daten werden bequem und kostenlos per Modem oder Breitbandkabelanschluss in den eigenen Rechner geliefert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0d6af383-0037-3d13-be8f-1ffcfe082371",
                        "entry_id": "165e6cf4-bb1a-3ad5-9357-9518f025bedb",
                        "glosses": [
                            "Wandler (Umsetzer, Konverter) zwischen digitalen Protokollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb04efc7-0100-4226-8064-c6ae981fdfb3",
                                "sense_id": "0d6af383-0037-3d13-be8f-1ffcfe082371",
                                "text": "Ein DSL-Modem wandelt zwischen den digitalen Protokollen DSL für den Ferntransport und Ethernet fürs lokale Datennetz (LAN)."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7417d60-77df-4162-a1eb-064634135dc8",
                        "source_entry_id": "165e6cf4-bb1a-3ad5-9357-9518f025bedb",
                        "source_sense_id": "c2ca5dbc-7cac-37ee-855b-6a1dce8ffad6",
