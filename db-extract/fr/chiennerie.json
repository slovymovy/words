                        "entry_id": "6e5ae31d-756b-37b1-9ca8-fb95251507d2",
                        "glosses": [
                            "a large group of dogs"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "1e04b82e-7ed3-4b08-baa1-4320b1f4a6b3",
                                "sense_id": "5f943b6c-c7f0-3511-a56d-8837c7eb1594",
                                "text": "C’était un concert de hurlements, les uns sourds, les autres criards, avec solos, répliques et chœurs où toute la chiennerie de la contrée faisait sa partie."
                            }
                        ]
                    },
                    {
                        "sense_id": "01af31ea-4248-3d76-b33e-10741a64c960",
                        "entry_id": "6e5ae31d-756b-37b1-9ca8-fb95251507d2",
                        "glosses": [
                            "things relating to dogs"
                        ],
                        "tags": [
                            "feminine",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "80f8759e-609a-4b15-8705-3016b175ee24",
                                "sense_id": "01af31ea-4248-3d76-b33e-10741a64c960",
                                "text": "Une […] passionnée de chiennerie, qui avait fait faire le portrait de sa chienne"
                            }
                        ]
                    },
                    {
                        "sense_id": "3fb6582c-b2e9-307d-9abf-f4597cd4b6a1",
                        "entry_id": "6e5ae31d-756b-37b1-9ca8-fb95251507d2",
                        "glosses": [
                            "an immodest act"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f23800e4-71e2-47f6-a0e6-624d499670ea",
                                "sense_id": "3fb6582c-b2e9-307d-9abf-f4597cd4b6a1",
                                "text": "Une atmosphère de rut, de cuissage et de chiennerie."
                            },
                            {
                                "example_id": "4ff07c70-93c2-4cd9-b69d-1b2f8d5dc70b",
                                "sense_id": "3fb6582c-b2e9-307d-9abf-f4597cd4b6a1",
                                "text": "Dans la chiennerie de son temps, et ceci ne peut s’oublier, il est le seul à avoir parlé profondément de l’amour."
                            }
                        ]
                    },
                    {
                        "sense_id": "306eebc8-cfbb-3c47-b49f-e174c678f98d",
                        "entry_id": "6e5ae31d-756b-37b1-9ca8-fb95251507d2",
                        "glosses": [
                            "avarice"
                        ],
                        "tags": [
                            "feminine",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "244e1243-0d02-4af3-8ee8-b5ec6e49b80d",
                                "sense_id": "306eebc8-cfbb-3c47-b49f-e174c678f98d",
                                "text": "Étant plus jeune de quelques années, je m’étonnais de cette chiennerie merveilleuse de certains personnages, comblés des biens de ce monde, qui eussent pu si facilement aider de leur superflu le seul écrivain qui ait quelque chose à dire pour la gloire de leur Seigneur Dieu, abominablement outragé."
                            }
                        ]
                    },
                    {
                        "sense_id": "573e307c-9e5b-30a8-a48d-66216ea16558",
                        "entry_id": "6e5ae31d-756b-37b1-9ca8-fb95251507d2",
                        "glosses": [
                            "an untenable situation"
                        ],
                        "tags": [
                            "feminine",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "bb92f0dc-9ac3-4182-a8c4-e765abbbc707",
                                "sense_id": "573e307c-9e5b-30a8-a48d-66216ea16558",
                                "text": "Je me demande encore comment il s'était fourré dans cette chiennerie !"
                            }
                        ]
                    }
                ],
