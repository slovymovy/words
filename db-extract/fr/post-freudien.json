                "senses": [
                    {
                        "sense_id": "4635787f-b392-3a99-9fc2-888888df7862",
                        "entry_id": "0b24068a-06d7-3d32-85c8-2c577c550c93",
                        "glosses": [
                            "Postérieur à la pensée de Sigmund Freud et qui la fait évoluer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ae81db-d622-45e3-9caa-78a8785cffe9",
                                "sense_id": "4635787f-b392-3a99-9fc2-888888df7862",
                                "text": "Du même coup, un tel examen me semble être au moins aussi impératif dans le cas de diverses versions révisionnistes post-freudiennes de la psychanalyse."
                            },
                            {
                                "example_id": "7f77f7a2-57f6-484c-ada2-999eab6a734d",
                                "sense_id": "4635787f-b392-3a99-9fc2-888888df7862",
                                "text": "Nous sommes dans une période post-freudienne ; tout le matériel psychanalytique qui surabonde dans mes livres ne peut donc plus appartenir à l’innocence, mais au contraire à la culture."
                            },
                            {
                                "example_id": "9cfb0796-81ad-43d8-a4c3-7e2dd43336e8",
                                "sense_id": "4635787f-b392-3a99-9fc2-888888df7862",
                                "text": "De plus, les auteurs post-freudiens s’affrontent souvent entre eux dans leur difficile cheminement vers la lumière scientifique."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
