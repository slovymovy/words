                    ]
                },
                {
                    "sense_id": "038e6b04-319d-3bab-aead-ad2a16f85db8",
                    "sense_definition": "Pointer un faisceau radar ou électromagnétique sur une cible pour la détecter ou la guider.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le radar militaire a réussi à <w>illuminer</w> la cible ennemie avant le tir."
                        },
                        {
                            "text": "Un système de défense au sol a immédiatement <w>illuminé</w> l'appareil inconnu dans la zone."
