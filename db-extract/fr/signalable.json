                        "glosses": [
                            "Qui peut être signalé, qui mérite de l’être."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d91a789-39f7-4329-9e2b-d8664eddf4d0",
                                "sense_id": "44c476e6-bfa4-31cc-b875-dd035ecf3a47",
                                "text": "Un autre signalable profit en revient infailliblement à tous : Sçavoir est que tout d’un mesme soin & labeur on apprend la lecture & prononciation de la langue, l’intelligence, la phrase, le style, avec les reigles & preceptes, qui est faire d’une pierre plusieurs coups."
                            },
                            {
                                "example_id": "d5d7d8d5-8b3b-4deb-8eab-35a12ee049a4",
                                "sense_id": "44c476e6-bfa4-31cc-b875-dd035ecf3a47",
                                "text": "La Providence, sous les espèces du secrétaire de la rédaction ou du metteur en page, m’a rendu un signalable service en allégeant ma dernière chronique des lignes consacrées à ANDRÉ CORNÉLIS."
                            },
                            {
                                "example_id": "115e75df-e34b-4eba-9852-bd86840faf95",
                                "sense_id": "44c476e6-bfa4-31cc-b875-dd035ecf3a47",
                                "text": "Dans cet effort pour s’appréhender comme réalité tangible et signalable, il ne peut, de premier élan, que se rejeter vers l’extérieur."
                            }
                        ]
                    }
