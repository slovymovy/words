                        "examples": [
                            {
                                "example_id": "316ef073-3770-4a1d-9459-4ee99e306364",
                                "sense_id": "e1aeaea5-259f-39c3-bdb4-6f7ff0558100",
                                "text": "Скворцы уже начали купаться в своих бадеечках."
                            },
                            {
                                "example_id": "d3a60e37-f40d-4859-a7a8-79bbd8c323c6",
                                "sense_id": "e1aeaea5-259f-39c3-bdb4-6f7ff0558100",
                                "text": "― Можно мне у вас, бабушка, водички из бадеечки попить?"
                            },
                            {
                                "example_id": "d5b10526-a1f5-4d86-ae03-5497d5930465",
                                "sense_id": "e1aeaea5-259f-39c3-bdb4-6f7ff0558100",
                                "text": "Маловата бадеечка! Надо бы подменить. Побольше поставить!"
                            }
                        ]
                    }
