                "senses": [
                    {
                        "sense_id": "37298352-6f95-34a7-bb29-ef9b189071dc",
                        "entry_id": "a63e1ccb-26e9-39ab-a80a-e4771a665192",
                        "glosses": [
                            "gewohnheitsmäßiges Verhalten, vor allem auch im geschäftlichen Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42033d4a-e74d-4a0f-8c64-67778a27f088",
                                "sense_id": "37298352-6f95-34a7-bb29-ef9b189071dc",
                                "text": "„Am Ende ist Pückler froh, als er endlich 16 ist, nach den Usancen der Zeit reif, um auf die Universität zu gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56de1cd4-4d3b-4fd6-891c-bb94f132158e",
                        "source_entry_id": "a63e1ccb-26e9-39ab-a80a-e4771a665192",
                        "source_sense_id": "37298352-6f95-34a7-bb29-ef9b189071dc",
                        "source_sense_description": "gewohnheitsmäßiges Verhalten, vor allem auch im geschäftlichen Bereich",
                        "target_lang_word": "usance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "514f0504-4741-3753-bf85-f70f766fb8b7",
                                        "entry_id": "40541e9d-8520-33fd-9a83-773fd54eed27",
                                        "glosses": [
                                            "En droit commercial, règle découlant de pratiques généralement reconnues."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc7c9a96-914f-486f-9f2d-44684ece16b3",
                                                "sense_id": "514f0504-4741-3753-bf85-f70f766fb8b7",
                                                "text": "Les Règles et Usances Uniformes (RUU) sont un ensemble de règles utilisées notamment pour les lettres de crédit de la Chambre de commerce internationale (CCI/ICC). Les RUU sont utilisées par les banques et commerçants dans plus de 175 pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5166d5-b62b-3701-8670-ea9e8e2ab769",
                                        "entry_id": "40541e9d-8520-33fd-9a83-773fd54eed27",
                                        "glosses": [
                                            "Terme fixé pour le payement d’une lettre de change, il est généralement de trente jours."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4de8abe-bbc3-39e3-a094-7a43e5ff4867",
                                        "entry_id": "40541e9d-8520-33fd-9a83-773fd54eed27",
                                        "glosses": [
                                            "Coutume, usage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28042b0d-bea8-4e1d-b445-a3adbee96935",
                                                "sense_id": "f4de8abe-bbc3-39e3-a094-7a43e5ff4867",
                                                "text": "C’est une usance qui apporte des commodités singulières aux nations où elle est observée, & désirable à tous bons princes qui ont à se plaindre de ce qu’on traite la mémoire des méchants comme la leur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea30e8e7-c705-4be7-9e43-234372513f76",
                        "source_entry_id": "a63e1ccb-26e9-39ab-a80a-e4771a665192",
                        "source_sense_id": "37298352-6f95-34a7-bb29-ef9b189071dc",
                        "source_sense_description": "gewohnheitsmäßiges Verhalten, vor allem auch im geschäftlichen Bereich",
                        "target_lang_word": "usage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Coutume ; pratique reçue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b93847-7397-4e9c-87e3-7e01f4f965f8",
                                                "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                                "text": "Il aimait fort les chansons de table ; et en cela il n'est pas blâmable, car depuis qu’elles ne sont plus d’usage le Français a beaucoup perdu de sa gaîté."
                                            },
                                            {
                                                "example_id": "65da6bcc-a618-4a18-9d48-0ccc31096832",
                                                "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                                "text": "Comme les chorfa descendent du Prophète, ils appartiennent à la plus pure noblesse musulmane, et leur illustre ascendance, par un usage spécial au Maghreb, leur vaut les plus extraordinaires avantages."
                                            },
                                            {
                                                "example_id": "017164f0-8d8f-43d4-8508-a1d063326b87",
                                                "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                                "text": "[…], on chercha, dans le Midi, à les déposséder des biens immeubles qu’ils détenaient en vertu d’usages très anciens."
                                            },
                                            {
                                                "example_id": "6d3b7a2d-36a8-482a-acb0-0bb7f8448ede",
                                                "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                                "text": "[…] il était reproché à un charcutier d’avoir confectionné des produits de charcuterie, en l’espèce saucissons, saucisses ou godiveaux, contenant des matières grasses supérieures à un taux de 50%, ce qui l’avait mis en l’état infractionnel, eu égard aux usages locaux, loyaux et constants."
                                            },
                                            {
                                                "example_id": "5c5938c6-7eb6-4f36-a49c-5a122bd24e5b",
                                                "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                                "text": "L’usage coutumier et les habitudes traditionnelles ont régi les relations commerciales et les transactions en affaires."
                                            },
                                            {
                                                "example_id": "9c10b3dc-62ef-4bfa-a71a-196f699c1dab",
                                                "sense_id": "9722e417-b4af-3f84-b417-006cceb15bed",
                                                "text": "Celui-ci s'est alors tourné vers la Cour de justice européenne afin de savoir si la collecte des données de civilité des clients, limitée aux mentions \"Monsieur\" et \"Madame\", peut se voir qualifiée de licite et conforme, notamment, au principe de minimisation des données, \"lorsque cette collecte vise à permettre une communication commerciale personnalisée à l’égard de ces clients, conformément aux usages couramment admis en la matière\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0feb5b8-ac54-37dd-b972-269064f26bd0",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Habitude, pratique particulière."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d8b585-8e32-4c02-9545-7d1b9f4980de",
                                                "sense_id": "f0feb5b8-ac54-37dd-b972-269064f26bd0",
                                                "text": "Il a l’usage de dîner de bonne heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e2d1a0-2304-3785-8964-61348d07b5c0",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Connaissance pratique acquise par l’expérience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5154b2a4-ab91-4ae2-9f65-29464eef0b45",
                                                "sense_id": "e1e2d1a0-2304-3785-8964-61348d07b5c0",
                                                "text": "Il avait été formé par un long usage à la vie de cour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f5b4597-7703-3d71-a3a8-b26116796194",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Expérience de la société, habitude d’en pratiquer les devoirs, d’en observer les règles."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc66c2d-7687-4c21-b2da-c42c0b4c9607",
                                                "sense_id": "3f5b4597-7703-3d71-a3a8-b26116796194",
                                                "text": "Manquer d’usage."
                                            },
                                            {
                                                "example_id": "e0f98b02-a45b-4dc0-ba9d-03d983140df4",
                                                "sense_id": "3f5b4597-7703-3d71-a3a8-b26116796194",
                                                "text": "C’est un homme qui a beaucoup d’usage, qui a peu d’usage."
                                            },
                                            {
                                                "example_id": "2d954b3f-9f57-4678-b1e5-71f91d34a2ef",
                                                "sense_id": "3f5b4597-7703-3d71-a3a8-b26116796194",
                                                "text": "Il n’avait guère d’usage. Il ne savait comment partir."
                                            },
                                            {
                                                "example_id": "9bc27656-ffeb-450f-b06c-a231920dd016",
                                                "sense_id": "3f5b4597-7703-3d71-a3a8-b26116796194",
                                                "text": "« Je suis navrée, dit la jeune femme. Je n’ai pas pu décider Patricia à venir. Il faut l’excuser. Elle n’a pas l’usage de la société. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e99578-ea4c-369f-8309-18776970a0c2",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Emploi d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a397bf8-076b-4cef-99cc-48fb1493cee2",
                                                "sense_id": "49e99578-ea4c-369f-8309-18776970a0c2",
                                                "text": "On note une prédominance à l’emploi des réseaux alternatifs et à l’usage généralisé du triphasé 200 V/400 Hz."
                                            },
                                            {
                                                "example_id": "75b45d20-6c3e-41df-8179-ebf58f8d3b56",
                                                "sense_id": "49e99578-ea4c-369f-8309-18776970a0c2",
                                                "text": "Les CRS ont fait usage de la force pour expulser les sans-papiers."
                                            },
                                            {
                                                "example_id": "8519f388-52f6-4a38-a9a9-810da75be84d",
                                                "sense_id": "49e99578-ea4c-369f-8309-18776970a0c2",
                                                "text": "Le bon, le mauvais usage des richesses."
                                            },
                                            {
                                                "example_id": "292612df-2694-4625-8f40-b103699be72f",
                                                "sense_id": "49e99578-ea4c-369f-8309-18776970a0c2",
                                                "text": "A quel usage destinez-vous cela ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34cd8d83-cd9a-39ab-bf73-8d014b90ec4f",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Utilité, possibilité d’emploi d’une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c9eb72-8cac-48fc-893d-eb279c3d2ba9",
                                                "sense_id": "34cd8d83-cd9a-39ab-bf73-8d014b90ec4f",
                                                "text": "Cela ne m’est plus d’aucun usage."
                                            },
                                            {
                                                "example_id": "8850e7d1-164e-4290-9333-dfcbf0426578",
                                                "sense_id": "34cd8d83-cd9a-39ab-bf73-8d014b90ec4f",
                                                "text": "Bréviaire à l’usage de Paris, de Rome."
                                            },
                                            {
                                                "example_id": "6e45ecaf-734e-4799-8b2d-737dac27b8b9",
                                                "sense_id": "34cd8d83-cd9a-39ab-bf73-8d014b90ec4f",
                                                "text": "L’usage de la parole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34bcda4a-889b-38bb-b25a-3a027bbc443d",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Emploi qu’on fait des mots de la langue, tel que la coutume l’a réglé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09807b4a-1c76-4e9c-9875-d74eeeb58174",
                                                "sense_id": "34bcda4a-889b-38bb-b25a-3a027bbc443d",
                                                "text": "L’usage est l’arbitre souverain des langues."
                                            },
                                            {
                                                "example_id": "bde7f7a0-9c1d-4a91-bbb4-0b60c370b1bc",
                                                "sense_id": "34bcda4a-889b-38bb-b25a-3a027bbc443d",
                                                "text": "Seulement, remarquez bien ceci, l’Académie, même à cette époque où elle était si franchement réformiste, ne devançait pas l’usage ; elle le suivait."
                                            },
                                            {
                                                "example_id": "5915eb3c-022a-4203-a41c-b92d72f8414c",
                                                "sense_id": "34bcda4a-889b-38bb-b25a-3a027bbc443d",
                                                "text": "Ce terme n’a d’usage, n’est en usage que dans le style familier."
                                            },
                                            {
                                                "example_id": "fcc6fb39-00cc-4e65-aab8-f95ce407dcc5",
                                                "sense_id": "34bcda4a-889b-38bb-b25a-3a027bbc443d",
                                                "text": "Le plus grand usage de ce mot est dans le style soutenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8651fe0e-701c-3f89-b61e-95da8f096774",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Emploi personnel qu’on fait des mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ce94eb-137c-4636-8b8d-287eb678de0e",
                                                "sense_id": "8651fe0e-701c-3f89-b61e-95da8f096774",
                                                "text": "L’usage qu’il a fait de cette expression est heureux."
                                            },
                                            {
                                                "example_id": "820e8072-ee1c-489f-991f-ffe6cef3cb1d",
                                                "sense_id": "8651fe0e-701c-3f89-b61e-95da8f096774",
                                                "text": "Habile écrivain, il a fait de ce moi un usage inattendu, tout nouveau."
                                            },
                                            {
                                                "example_id": "622f9948-0831-400d-9e38-6447cdb4a3d8",
                                                "sense_id": "8651fe0e-701c-3f89-b61e-95da8f096774",
                                                "text": "Vous faites des mots un usage vicieux."
                                            },
                                            {
                                                "example_id": "54fe7e19-04d8-4e58-8f28-9e8f1f7bfc29",
                                                "sense_id": "8651fe0e-701c-3f89-b61e-95da8f096774",
                                                "text": "L’Académie ne prétend pas régler l’usage de chaque mot, elle indique l’usage qu’on en fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de191dab-b7c4-335a-9491-530343842802",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Usufruit, droit de se servir personnellement d’une chose dont la propriété est à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2960ff81-78c6-4f45-b1ae-d91c9a8e1eea",
                                                "sense_id": "de191dab-b7c4-335a-9491-530343842802",
                                                "text": "En vendant sa bibliothèque, il s’en est réservé l’usage sa vie durant."
                                            },
                                            {
                                                "example_id": "6b52ca31-2d43-4ac1-9023-92e4f92d4fd5",
                                                "sense_id": "de191dab-b7c4-335a-9491-530343842802",
                                                "text": "Les droits d’usage s’établissent et se perdent de la même manière que l’usufruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd0ae8c-9c24-33f8-851d-21c9f0d47125",
                                        "entry_id": "57569588-aa09-3f11-b424-869ec7e6517e",
                                        "glosses": [
                                            "Usufruit, droit de se servir personnellement d’une chose dont la propriété est à un autre.",
                                            "Droit qu’ont les voisins d’une forêt ou d’un pacage d’y couper le bois qui leur est nécessaire, ou d’y mener paître leur bétail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1594fba7-b253-4a88-b397-90ff7ad0e392",
                                                "sense_id": "4fd0ae8c-9c24-33f8-851d-21c9f0d47125",
                                                "text": "J’ai mon usage dans tel bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
