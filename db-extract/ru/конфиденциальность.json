                    },
                    {
                        "form_id": "e4694bae-bbd6-4a83-a618-f0b233f91bbe",
                        "entry_id": "68cd9864-7f19-3d81-8d3e-3e9072c5aeb9",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "конфиденциа́льностях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6defed98-823d-38a0-80c6-59c5b6d8a626",
                        "entry_id": "68cd9864-7f19-3d81-8d3e-3e9072c5aeb9",
                        "glosses": [
                            "устар. свойство по значению прилагательного конфиденциальный; доверительность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4509e3b2-6b3b-4d70-8b75-1047cfa2d1c6",
                                "sense_id": "6defed98-823d-38a0-80c6-59c5b6d8a626",
                                "text": "Конечно ж, ― не «флирт»: платоническая сердечность; и чистая дружба; но требовала «культа дружбы»; и тут проявляла ревнивость; она добивалась горячей конфиденциальности, чтобы профессор, идя на свидание с ней, запевал про себя: Сияй же, указывай путь, Веди к недоступному счастью…"
                            },
                            {
                                "example_id": "c110207e-1056-4891-a95f-9786acca4646",
                                "sense_id": "6defed98-823d-38a0-80c6-59c5b6d8a626",
                                "text": "Он очень ценил безусловную конфиденциальность их бесед и то женственное начало, с которым Женька откровенно предпочитала согласие и мир, как бы далеко ни заводили споры."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c4c0f92-ad8b-3696-a725-83bb1174730e",
                        "entry_id": "68cd9864-7f19-3d81-8d3e-3e9072c5aeb9",
                        "glosses": [
                            "секретность, закрытость какой-либо информации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07dd7c2-b4a9-46b2-a9d3-81bd3937d1b8",
                                "sense_id": "0c4c0f92-ad8b-3696-a725-83bb1174730e",
                                "text": "Эта проблема прямо связана с правом человека на конфиденциальность прочитанной генетической информации."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57e65da0-6879-4c85-8f41-15e65bab2b8d",
                        "source_entry_id": "68cd9864-7f19-3d81-8d3e-3e9072c5aeb9",
                        "target_lang_word": "confidentiality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidentiality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e7aa60-3c02-3646-b602-45242aa7c126",
                                        "entry_id": "dfea7bb3-ca4c-38af-9aba-f460109c1066",
                                        "glosses": [
                                            "The property of being confidential."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb4847c-9195-4fd9-b63d-83df7916c3ee",
                                                "sense_id": "b3e7aa60-3c02-3646-b602-45242aa7c126",
                                                "text": "“Protection of victim confidentiality is essential, though we were never contacted about our thoughts on this,” the source said."
                                            },
                                            {
                                                "example_id": "5ed1412f-ff83-430c-89cf-d74762b94ea2",
                                                "sense_id": "b3e7aa60-3c02-3646-b602-45242aa7c126",
                                                "text": "The company was unable to comment on much of the moves owing to client confidentiality agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d408f9d-038e-3ad9-8fa6-a9aee466363d",
                                        "entry_id": "dfea7bb3-ca4c-38af-9aba-f460109c1066",
                                        "glosses": [
                                            "Something told in confidence; a secret."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
