    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac496760-dc9e-3b6e-9d03-90c6aee38f9a",
                    "sense_definition": "Covered or coated with a layer of plaster.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surface_coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly <w>plastered</w> ceiling was left to dry overnight.",
                            "target_lang_translations": {
                                "nl": "Het pas <w>bepleisterde</w> plafond moest een nacht drogen.",
                                "zh": "新<w>抹了灰泥的</w>天花板被留置晾干了一整夜。"
                            }
                        },
                        {
                            "text": "The old cottage had <w>plastered</w> walls that were painted a soft white.",
                            "target_lang_translations": {
                                "nl": "Het oude huisje had <w>bepleisterde</w> muren die zachtwit waren geschilderd.",
                                "zh": "那座老村舍有着<w>粉刷过的</w>墙壁，被漆成了柔和的白色。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Bedekt of bekleed met een laag pleisterwerk of gips.",
                        "zh": "涂有灰泥的；抹了石膏的。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bepleisterd",
                                "target_lang_sense_clarification": "Bedekt met een laag pleister."
                            },
                            {
                                "target_lang_word": "gepleisterd",
                                "target_lang_sense_clarification": "Voorzien van een laag gips of pleister."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂满灰泥的",
                                "target_lang_sense_clarification": "表面抹上灰泥层的"
                            },
                            {
                                "target_lang_word": "粉刷过的",
                                "target_lang_sense_clarification": "用灰泥粉刷修整好的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9836e509-856c-345d-a2bf-e4acb7087444",
                    "sense_definition": "Extremely drunk or intoxicated.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the party and got completely <w>plastered</w> by midnight.",
                            "target_lang_translations": {
                                "nl": "Hij ging naar het feest en was rond middernacht compleet <w>bezopen</w>.",
                                "zh": "他去了聚会，到午夜时分已经彻底<w>烂醉如泥</w>了。"
                            }
                        },
                        {
                            "text": "The group of friends returned home <w>plastered</w> after celebrating the victory.",
                            "target_lang_translations": {
                                "nl": "De vriendengroep keerde <w>lam</w> huiswaarts na het vieren van de overwinning.",
                                "zh": "庆祝胜利后，这群朋友<w>酩酊大醉</w>地回了家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk"
                    ],
                    "common_phrases": [
                        "get plastered"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for being very drunk."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Extreem dronken of onder invloed van alcohol.",
                        "zh": "酩酊大醉的，烂醉如泥的（俚语）。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bezopen",
                                "target_lang_sense_clarification": "Zeer informeel voor erg dronken."
                            },
                            {
                                "target_lang_word": "lam",
                                "target_lang_sense_clarification": "Slang voor erg dronken zijn."
                            },
                            {
                                "target_lang_word": "stomdronken",
                                "target_lang_sense_clarification": "Zeer dronken."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烂醉如泥的",
                                "target_lang_sense_clarification": "极度醉酒的"
                            },
                            {
                                "target_lang_word": "酩酊大醉的",
                                "target_lang_sense_clarification": "喝得极醉的"
                            },
                            {
                                "target_lang_word": "大醉的",
                                "target_lang_sense_clarification": "严重喝醉的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98e5db9c-3068-30d5-89f0-64a21b266267",
                    "sense_definition": "Simple past and past participle of <w>plaster</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder <w>plastered</w> the entire room in just one afternoon.",
                            "target_lang_translations": {
                                "nl": "De bouwvakker <w>bepleisterde</w> de hele kamer in slechts één middag.",
                                "zh": "施工人员仅用了一个下午就给整个房间<w>抹好了灰泥</w>。"
                            }
                        },
                        {
                            "text": "She has <w>plastered</w> posters all over her bedroom walls.",
                            "target_lang_translations": {
                                "nl": "Ze heeft posters over haar hele slaapkamermuren <w>geplakt</w>.",
                                "zh": "她的卧室墙上<w>贴满</w>了海报。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb plaster."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van pleisteren.",
                        "zh": "动词 plaster 的过去式及过去分词形式，意为“抹灰泥”或“到处张贴”。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bepleisterde",
                                "target_lang_sense_clarification": "Verleden tijd van bepleisteren."
                            },
                            {
                                "target_lang_word": "bepleisterd",
                                "target_lang_sense_clarification": "Voltooid deelwoord van bepleisteren."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抹灰泥",
                                "target_lang_sense_clarification": "在墙面等表面涂抹灰泥或石膏"
                            },
                            {
                                "target_lang_word": "贴满",
                                "target_lang_sense_clarification": "在表面到处张贴"
                            }
