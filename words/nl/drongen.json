            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9299aba5-1ee4-3c06-9eb2-d77d4ac70041",
                    "sense_definition": "meervoud verleden tijd van <w>dringen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dringen_verleden_tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mensen <w>drongen</w> naar voren om de bekende zanger beter te zien.",
                            "target_lang_translations": {
                                "fr": "Les gens <w>se bousculaient</w> vers l'avant pour mieux voir le célèbre chanteur."
                            }
                        },
                        {
                            "text": "De nieuwsgierige journalisten <w>drongen</w> aan op een snel en duidelijk antwoord.",
                            "target_lang_translations": {
                                "fr": "Les journalistes curieux <w>insistaient pour</w> obtenir une réponse rapide et claire."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drongen naar voren",
                        "drongen aan op"
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme du pluriel au passé (imparfait) du verbe « dringen » (se bousculer, presser, insister)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se bousculaient",
                                "target_lang_sense_clarification": "au sens physique de se presser en foule"
                            },
                            {
                                "target_lang_word": "pressaient",
                                "target_lang_sense_clarification": "au sens d'insister ou d'avancer en poussant"
                            },
                            {
                                "target_lang_word": "insistaient",
                                "target_lang_sense_clarification": "dans le contexte de 'drongen aan op' (insister sur)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f32b8914-c4d1-3286-92f1-fb3692d5641d",
                    "sense_definition": "aanvoegende wijs meervoud verleden tijd van <w>dringen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dringen_verleden_tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men wenste dat zij niet zo brutaal naar binnen <w>drongen</w>.",
                            "target_lang_translations": {
                                "fr": "On souhaitait qu'ils ne <w>pénétrassent</w> pas à l'intérieur de manière si impolie."
                            }
                        },
                        {
                            "text": "Het leek alsof de toeschouwers nog dichter naar het podium <w>drongen</w>.",
                            "target_lang_translations": {
                                "fr": "Il semblait que les spectateurs <w>se pressassent</w> encore plus près de la scène."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Aanvoegende wijs verleden tijd is zeer verouderd in modern Nederlands."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme archaïque du subjonctif imparfait pluriel du verbe « dringen »."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se bousculassent",
                                "target_lang_sense_clarification": "forme au subjonctif imparfait"
                            },
                            {
                                "target_lang_word": "pénétrassent",
                                "target_lang_sense_clarification": "au sens d'entrer de force (subjonctif)"
                            }
                        ]
                    }
                }
            ]
        },
