                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "юридический субъект права"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "legal entity with standing before the courts"
                            },
                            {
                                "target_lang_word": "entity",
                                "target_lang_sense_clarification": "a legal or business unit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "127aea8f-4ece-35a7-a700-e29b4cad3346",
                    "sense_definition": "W teologii chrześcijańskiej: każdy z trzech bytów tworzących Trójcę Świętą.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dogmat głosi, że Bóg istnieje w trzech Boskich <w>osobach</w>.",
                            "target_lang_translations": {
                                "ru": "Догмат гласит, что Бог существует в трех Божественных <w>ипостасях</w>.",
                                "en": "The dogma states that God exists in three Divine <w>persons</w>."
                            }
                        },
                        {
                            "text": "Duch Święty jest trzecią <w>osobą</w> Trójcy Świętej.",
                            "target_lang_translations": {
                                "ru": "Святой Дух является третьим <w>лицом</w> Святой Троицы.",
                                "en": "The Holy Spirit is the third <w>person</w> of the Holy Trinity."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypostaza"
                    ],
                    "common_phrases": [
                        "osoba boska",
                        "trzy osoby"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "termin teologiczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В христианском богословии: каждая из трех ипостасей, составляющих Святую Троицу.",
                        "en": "In Christian theology, each of the three hypostases of the Holy Trinity."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ипостась",
