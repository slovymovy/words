                "senses": [
                    {
                        "sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                        "entry_id": "9c4c5535-dc46-3107-942f-a2ad99375ce2",
                        "glosses": [
                            "Having the spirit, attitude or qualities of an entrepreneur; enterprising."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150dd5ca-06e3-40bf-8138-671b9dbc1644",
                                "sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                                "text": "Homer’s entrepreneurial spirit proves altogether overly infectious. Homer gives Barney a pep talk when he encounters him dressed up like a baby handing out fliers (Barney in humiliating costumes=always funny) and it isn’t long until Barney has purchased a truck of his own and set up shop as the Plow King."
                            },
                            {
                                "example_id": "acd893b9-4074-4330-89c0-554e83415641",
                                "sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                                "text": "It is a canard trotted out by lazy or tendentious journalists that nationalised British Railways lacked entrepreneurial flair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3f04097-4bf3-4f51-96d1-8fc13a20a125",
                        "source_entry_id": "9c4c5535-dc46-3107-942f-a2ad99375ce2",
                        "source_sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                        "source_sense_description": "having the spirit, attitude or qualities of an entrepreneur; enterprising",
                        "target_lang_word": "entreprenant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entreprenant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b9dd8de-9ca3-3238-8d19-32d546ee0e91",
                                        "entry_id": "4931e76c-5824-3b9b-b39a-812db30ad5d4",
                                        "glosses": [
                                            "Qui se porte hardiment à une entreprise, à une aventure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f05841a9-b7c8-4d9c-8e24-99bfb88912b8",
                                                "sense_id": "4b9dd8de-9ca3-3238-8d19-32d546ee0e91",
                                                "text": "C’est un homme actif et entreprenant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4861b5c-95b6-366b-9e4f-51129acf3171",
                                        "entry_id": "4931e76c-5824-3b9b-b39a-812db30ad5d4",
                                        "glosses": [
                                            "Qui est téméraire dans ses entreprises, ou disposé à entreprendre sur le droit d’autrui."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8200b84-4807-46e0-b1c5-218d369a28a4",
                                                "sense_id": "b4861b5c-95b6-366b-9e4f-51129acf3171",
                                                "text": "Cet homme est bien entreprenant, d’humeur entreprenante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d567e3c-885f-3581-93ff-860c331bc4a9",
                                        "entry_id": "4931e76c-5824-3b9b-b39a-812db30ad5d4",
                                        "glosses": [
                                            "Qualifie un homme hardi auprès des femmes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f9d05b-28b6-4c18-99ea-00904b03ffda",
                                                "sense_id": "7d567e3c-885f-3581-93ff-860c331bc4a9",
                                                "text": "Ceux-là s’y prendront comme ils voudront ; ils seront gais ou tristes, tendres ou passionnés, discrets ou entreprenants, ils réussiront toujours, à moins qu’ils ne rencontrent sur leur route une de ces deux choses qui font une femme impossible : une autre passion, ou la peur de l’enfer."
                                            },
                                            {
                                                "example_id": "a84d385d-1f02-4ea7-8ff9-60b887ee4fe8",
                                                "sense_id": "7d567e3c-885f-3581-93ff-860c331bc4a9",
                                                "text": "La question est la suivante : à partir de quand un(e) collègue un peu trop entreprenant(e) est-il ou elle en train de vous harceler sexuellement ? Interroge Jean-Luc Braunschweig-Klein, avocat au Barreau d’Avignon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entreprenant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3f0abe8-3177-32e5-8930-0eb1266bbb9b",
                                        "entry_id": "f6eac72c-c863-33e6-88c7-87230e42aa70",
                                        "glosses": [
                                            "Participe présent de entreprendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72d56149-94b0-437f-9d46-3c7234397e98",
                        "source_entry_id": "9c4c5535-dc46-3107-942f-a2ad99375ce2",
                        "source_sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                        "source_sense_description": "having the spirit, attitude or qualities of an entrepreneur; enterprising",
                        "target_lang_word": "entrepreneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrepreneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                        "entry_id": "71197670-91c7-30c7-87fe-285b36a259ca",
                                        "glosses": [
                                            "Celui qui dirige une entreprise."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16bbcb19-8b5d-41f9-a2b3-823a3845b7cb",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "De 1793 à 1799, du Bousquier fut entrepreneur des vivres des armées françaises."
                                            },
                                            {
                                                "example_id": "68625578-b665-4d14-9247-f6f06b2a4fe4",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "Les entrepreneurs les plus en vue se nomment Deville ou Wendel."
                                            },
                                            {
                                                "example_id": "6fa351a7-ee19-4943-9499-eeb12b5b2000",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "Le statut d’entrepreneur individuel spécialisé dans la chnouf semble en contradiction avec une vocation de pédagogue se destinant à enseigner les valeurs du sport. À moins de se spécialiser dans le cyclisme."
                                            },
                                            {
                                                "example_id": "d2db67e1-d79b-40ab-86ac-21bbef734dbc",
                                                "sense_id": "81551405-3f58-3d2d-89b8-7379ebe74e62",
                                                "text": "Marc de Comans et François de La Planche entrepreneurs de l’establissement de la fabricque et manufacture des tapisseries façon de Flandres"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c27bcf12-1292-3670-9d7c-4dd5919a31d9",
                                        "entry_id": "71197670-91c7-30c7-87fe-285b36a259ca",
                                        "glosses": [
                                            "(Travaux contractuels) Celui qui fait métier d’entreprendre sur contrat certains travaux, notamment de construction, ou de fournir des marchandises, des services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b476a7-263c-4bf0-bfb0-3607ea21c8be",
                                                "sense_id": "c27bcf12-1292-3670-9d7c-4dd5919a31d9",
                                                "text": "Les entrepreneurs avaient emprunté l’argent de la construction. Le locataire avait hypothéqué l’appartement. Tout le pays spéculait sur la propriété foncière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "253b30d8-e57e-4c6d-a4ea-39383a0701ac",
                        "source_entry_id": "9c4c5535-dc46-3107-942f-a2ad99375ce2",
