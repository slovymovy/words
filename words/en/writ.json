                    "frequency": "Middle",
                    "semantic_group_id": "legal_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge issued a <w>writ</w> ordering the immediate release of the prisoner."
                        },
                        {
                            "text": "Her lawyers applied for a <w>writ</w> to halt the demolition of the historic property."
                        }
                    ],
                    "synonyms": [
                        "claim form"
                    ],
                    "common_phrases": [
