                "senses": [
                    {
                        "sense_id": "27306d90-8d8f-3ab6-871d-123c7775db00",
                        "entry_id": "20df745e-e84e-3660-8e63-1e8c2393819d",
                        "glosses": [
                            "kurze Erzählung, die kleinen Kindern vor dem Einschlafen vorgelesen oder erzählt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba61e9a-237c-44a5-ae70-ba8db0c4786b",
                                "sense_id": "27306d90-8d8f-3ab6-871d-123c7775db00",
                                "text": "„Über dieses auf einer Gutenachtgeschichte für seine Kinder basierende Märchen von der bedrohten Wassernixe zerkrachte sich Shyamalan mit seinem Stammstudio Disney – und schrieb darüber ein beleidigtes Buch.“"
                            },
                            {
                                "example_id": "c7765320-3982-4fd6-9f6d-b5e8638c0852",
                                "sense_id": "27306d90-8d8f-3ab6-871d-123c7775db00",
                                "text": "„Es wurden auch Freiwillige unterstützt, die Kindern aus jenen Familien Gutenachtgeschichten vorlasen, in denen die Eltern das nicht selbst taten.“"
                            },
                            {
                                "example_id": "34c2235a-0ffb-446b-ba14-1f9b015a8373",
                                "sense_id": "27306d90-8d8f-3ab6-871d-123c7775db00",
                                "text": "„Amalia erzählte uns wie gewohnt eine Gutenachtgeschichte, und als Milena eingeschlafen war, setzte sie sich auf meine Bettkante und strich mir übers Haar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
