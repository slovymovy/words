                "senses": [
                    {
                        "sense_id": "e7f612cb-9581-36a7-9f10-80e041a6271d",
                        "entry_id": "e0a00ede-f969-3cd6-9e6e-793bc576bbd8",
                        "glosses": [
                            "Qualifie les médicaments et autres moyens employés pour décongestionner un endroit du corps en attirant le sang ailleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff965cc2-8e5a-459b-97e8-19a0d02b10e9",
                                "sense_id": "e7f612cb-9581-36a7-9f10-80e041a6271d",
                                "text": "Lotions excitantes. — Ces lotions, que l'on nomme encore lotions révulsives, ont pour but d'activer la circulation du sang dans le cuir chevelu et de ranimer la pousse des cheveux."
                            },
                            {
                                "example_id": "f1f6749f-07a1-4f8d-98a3-acb92672c2ee",
                                "sense_id": "e7f612cb-9581-36a7-9f10-80e041a6271d",
                                "text": "Saignée révulsive."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e64c330b-b0aa-30f8-ba86-6a8610e915fc",
                "word": "révulsif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c252702e-6616-48f5-985b-813f2dac3d22",
                        "entry_id": "e64c330b-b0aa-30f8-ba86-6a8610e915fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "révulsifs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03d1f679-9aa3-3412-8c02-0fc1f234ce8d",
                        "entry_id": "e64c330b-b0aa-30f8-ba86-6a8610e915fc",
                        "glosses": [
                            "Médicament révulsif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f33a8d9-cf39-4b51-968a-6748b605db9f",
                                "sense_id": "03d1f679-9aa3-3412-8c02-0fc1f234ce8d",
                                "text": "Les vésicatoires, les sinapismes et les rubéfiants agissent souvent comme des révulsifs."
                            },
                            {
                                "example_id": "0f5f2e5d-5636-4d3e-9492-dc0552beec98",
                                "sense_id": "03d1f679-9aa3-3412-8c02-0fc1f234ce8d",
                                "text": "La fièvre se dessinait d’une façon redoutable. Il fallait des ventouses et des révulsifs à la nuque, de la glace autour du front."
                            },
                            {
                                "example_id": "00b043d3-b972-43d2-a3a2-278bbef67540",
                                "sense_id": "03d1f679-9aa3-3412-8c02-0fc1f234ce8d",
                                "text": "Il ne m’avait été que trop facile de constater les symptômes d’une méningite aiguë. Je prescrivis des révulsifs aux pieds et des sangsues derrière les oreilles."
                            },
                            {
                                "example_id": "5a38cda5-0519-41be-beb4-75f6059ee7dd",
                                "sense_id": "03d1f679-9aa3-3412-8c02-0fc1f234ce8d",
                                "text": "Dans ce cas, le catholicisme jouerait tout à la fois le rôle d’un révulsif et d’un déprimant."
                            }
                        ]
                    },
                    {
                        "sense_id": "af37ba73-f26b-31d8-a4cb-35246aae4133",
                        "entry_id": "e64c330b-b0aa-30f8-ba86-6a8610e915fc",
                        "glosses": [
                            "Boisson destinée à provoquer une réaction."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "a33660d1-e38f-4bde-9a82-ca02df2eb469",
                                "sense_id": "af37ba73-f26b-31d8-a4cb-35246aae4133",
                                "text": "Le barman surgit, semblable à un chef d’orchestre dans sa fosse, et salua d’un léger sourire.\n— Toute l’équipe de nuit est là, à ce que je vois, fit-il en disposant devant eux d’aimables révulsifs."
                            }
                        ]
                    }
