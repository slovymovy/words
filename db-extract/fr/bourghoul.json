                        "examples": [
                            {
                                "example_id": "2e4e736b-2ff5-4365-89fc-b1fb57cb125a",
                                "sense_id": "84c452c4-8bee-3f99-b935-ec47570e17f5",
                                "text": "Couvrir la casserole et laisser sur le feu pendant 15 minutes, le temps que le bourghoul s’attendrisse."
                            },
                            {
                                "example_id": "73cd8d49-e7c6-4f3d-b0ab-280361e4b261",
                                "sense_id": "84c452c4-8bee-3f99-b935-ec47570e17f5",
                                "text": "La composition de base est la tomate cuite dans l’huile d’olive avec de l’oignon, à laquelle s’ajoutent aubergine […], courgette pelée […], poivron […], ou encore des céréales comme le boughoul, le riz ou encore les lentilles."
                            },
                            {
                                "example_id": "280b9326-d831-4cd3-80cb-ba335a0f47cc",
                                "sense_id": "84c452c4-8bee-3f99-b935-ec47570e17f5",
                                "text": "Nous passâmes devant une fabrique de bourghoul et nous nous arrêtâmes un instant."
                            }
                        ]
