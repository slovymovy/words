                },
                {
                    "sense_id": "024bb208-781b-3d64-90a8-a1466a303bfe",
                    "sense_definition": "Personne, chose ou comportement qui suscite une grande désolation ou un vif tourment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'indiscipline constante de cet élève est le <w>désespoir</w> de tous ses professeurs."
                        },
                        {
                            "text": "Cette voiture tombe toujours en panne et fait le <w>désespoir</w> de son propriétaire."
