                    ],
                    "target_lang_definitions": {
                        "zh": "可重复使用航天器；一种设计用于多次太空飞行而非一次性废弃的宇宙飞船。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可重复使用宇宙飞船",
                                "target_lang_sense_clarification": "航天载具"
                            },
                            {
                                "target_lang_word": "可重复使用航天器",
                                "target_lang_sense_clarification": "航天载具"
                            }
                        ]
                    }
                }
            ]
        }
    ]
