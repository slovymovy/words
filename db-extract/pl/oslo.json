                                                "example_id": "297e4794-709c-4c92-b642-c475fe34a564",
                                                "sense_id": "09437305-911a-3992-b0ab-f03f082bb2fb",
                                                "text": "À l’âge de 17 ans, il suit pendant quelques mois les cours du Collège royal de dessin à Oslo, alors appelée Kristiana, et expose pour la première fois deux ans plus tard."
                                            }
