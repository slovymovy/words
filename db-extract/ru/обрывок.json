                ],
                "senses": [
                    {
                        "sense_id": "b7b44e03-3605-39c1-b320-c8529db7927a",
                        "entry_id": "d9c31bf2-04a4-3a7f-a9c0-b154f256cacd",
                        "glosses": [
                            "то же, что клочок; оторванный кусок чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c37feb9c-f4fe-31de-ad24-c6cf408bc717",
                        "entry_id": "d9c31bf2-04a4-3a7f-a9c0-b154f256cacd",
                        "glosses": [
                            "перен. вырванная из контекста мысль, высказывание, фраза и т. д."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fb6419b-e0df-4995-aaac-f63d4c53241a",
                        "source_entry_id": "d9c31bf2-04a4-3a7f-a9c0-b154f256cacd",
                        "target_lang_word": "fragment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a928853-802a-3eb9-b934-de5caab3e727",
                                        "entry_id": "05cba763-acf1-38cd-9174-7ba2a94fcdfe",
                                        "glosses": [
                                            "Morceau de quelque chose qui a été cassé, brisé, séparé de son tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957dcc07-1cc1-425e-a8d7-14210c7b7817",
                                                "sense_id": "8a928853-802a-3eb9-b934-de5caab3e727",
                                                "text": "Elle s’approcha sans bruit de Charles IX, qui donnait à ses chiens des fragments de gâteaux coupés en portions pareilles."
                                            },
                                            {
                                                "example_id": "a633cc51-ab82-42a7-9e3f-76465c5df195",
                                                "sense_id": "8a928853-802a-3eb9-b934-de5caab3e727",
                                                "text": "Ce bouillonnement provenait d’une source sous-marine de naphte, et il a suffi de ce fragment de cigare pour l’enflammer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b18918-24dc-3806-857b-4f5a32af06fd",
                                        "entry_id": "05cba763-acf1-38cd-9174-7ba2a94fcdfe",
                                        "glosses": [
                                            "Petite partie d’un livre, d’un traité, d’un ouvrage, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618794c7-8b40-4c58-8307-ea78a22b7610",
                                                "sense_id": "12b18918-24dc-3806-857b-4f5a32af06fd",
                                                "text": "Il s'agissait de conférences et de parlottes défaitistes, au cours desquelles il était donné lecture de fragments de séances parlementaires en comité secret, considérés comme aptes à démoraliser les auditeurs, et aussi de tracts et de brochures progermaniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21948d6d-c1b0-3fb5-8073-fc40b8a8f700",
                                        "entry_id": "05cba763-acf1-38cd-9174-7ba2a94fcdfe",
                                        "glosses": [
                                            "Morceau d’un livre, d’un ouvrage qui n’est pas encore terminé, ou qui n’a pu l’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd49065b-8155-4496-9dbd-740ab1d421f3",
                                                "sense_id": "21948d6d-c1b0-3fb5-8073-fc40b8a8f700",
                                                "text": "Publier des fragments."
                                            },
                                            {
                                                "example_id": "8caecf54-4a04-4826-9c17-20c1c4862917",
                                                "sense_id": "21948d6d-c1b0-3fb5-8073-fc40b8a8f700",
                                                "text": "Fragments historiques, philosophiques, poétiques, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b634df9-d791-3e2e-ace2-ebaaa4d62cea",
                                        "entry_id": "05cba763-acf1-38cd-9174-7ba2a94fcdfe",
                                        "glosses": [
                                            "Format des données transitant par la couche de transport du modèle OSI."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06123cdc-acd8-3e48-badc-c52a7b64b8a6",
                                        "entry_id": "05cba763-acf1-38cd-9174-7ba2a94fcdfe",
                                        "glosses": [
                                            "Élément d’une base de données distribuée fragmentée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f241a9f-9ecb-40fa-b12d-d68b24086805",
                        "source_entry_id": "d9c31bf2-04a4-3a7f-a9c0-b154f256cacd",
                        "target_lang_word": "morceau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6ff78d5-7294-3621-a498-7d162d0c88d9",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Portion séparée d’une chose solide qui peut être mangée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02df5e5-f55c-486c-8975-5f65fec11a23",
                                                "sense_id": "b6ff78d5-7294-3621-a498-7d162d0c88d9",
                                                "text": "Ces considérations nous portaient donc à croire que l’histoire des bouts de corde était le produit de l’imagination de quelque amateur de l’horrible, de ces gens qui ne peuvent voir une hart se balançant à une branche d'arbre sans que leur esprit frappé ne mette un pendu au bout, avec des corbeaux décrivant leur affreuse courbe autour du supplicié pour en choisir les meilleurs morceaux; […]."
                                            },
                                            {
                                                "example_id": "952468d7-e2b0-4e09-a365-54441e9d096c",
                                                "sense_id": "b6ff78d5-7294-3621-a498-7d162d0c88d9",
                                                "text": "Gros, petit, bon morceau. — Morceau délicat, friand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad37b243-da05-3a63-afe3-13716dc33196",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Partie séparée d’un corps solide et continu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d92daa-6484-41a7-90ab-64d68e3afdb9",
                                                "sense_id": "ad37b243-da05-3a63-afe3-13716dc33196",
                                                "text": "On est alors fort étonné de retrouver les morceaux de bismuth intacts, leur aspect extérieur ne diffère en rien de ce qu’il était avant la chauffe […] Il semble, d’après cela que le bismuth n’a pas fondu […]"
                                            },
                                            {
                                                "example_id": "519752c0-e525-4cde-bde5-bb3596f4ad55",
                                                "sense_id": "ad37b243-da05-3a63-afe3-13716dc33196",
                                                "text": "Un morceau de savon traînait sur le bord de la baignoire en bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Portion, une partie non séparée, mais distincte et considérée à part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ba2efc-4768-41f8-851b-60f5c2a4edfa",
                                                "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                                "text": "Il a attrapé un bon morceau de cette succession : Il en a eu une bonne partie."
                                            },
                                            {
                                                "example_id": "9ea933ee-4c4a-4894-a12a-d675ec749bf2",
                                                "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                                "text": "Morceau de terre."
                                            },
                                            {
                                                "example_id": "4a79f54e-7214-4bce-92d8-221ad586eac5",
                                                "sense_id": "e8d3bacc-38a4-3630-b261-04fd2157dc80",
                                                "text": "Ils s’apercevront, émus,\nQue c’est au hasard des rues,\nSur un de ces fameux bancs,\nQu’ils ont vécu le meilleur morceau de leur amour…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b148416e-601d-3b3a-b577-f957dab0d8b6",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Parties, des fragments d’un ouvrage de l’esprit ou d’une œuvre d’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c6aee8-d75f-4f50-badd-b7ac34eab4db",
                                                "sense_id": "b148416e-601d-3b3a-b577-f957dab0d8b6",
                                                "text": "[…] et, d’autre part, elle citait, de mémoire, des morceaux d’une mystique un peu bizarre de la fin du XVIᵉ siècle, Jeanne Chézard de Matel, la fondatrice de l’ordre du Verbe Incarné […]"
                                            },
                                            {
                                                "example_id": "6242b5d6-3ce2-4115-800d-f2bf70763fa6",
                                                "sense_id": "b148416e-601d-3b3a-b577-f957dab0d8b6",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Objet entier, d’un tout considéré par rapport au genre ou à l’espèce dont il fait partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a565a0d-b519-4f56-a061-570242d7a952",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "La colonnade du Louvre est un beau morceau."
                                            },
                                            {
                                                "example_id": "46e76f50-9591-480e-8cd1-63769ea2b43a",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "Cette élégie, cette églogue sont de beaux morceaux de poésie."
                                            },
                                            {
                                                "example_id": "426b2fcb-827b-460a-9f95-8128fa7ef9be",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "Un morceau d’anthologie."
                                            },
                                            {
                                                "example_id": "7705613e-e7ce-4a5b-b12c-4259c39ed8fc",
                                                "sense_id": "87473baa-9399-3200-b61c-a6f6b8611508",
                                                "text": "Morceau de concours : Morceau choisi pour être exécuté par chacun de ceux qui prennent part à un concours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8cc0a97-8bf9-3821-9c92-17f64e666e22",
                                        "entry_id": "a5232ca2-a6e8-384b-b8c5-6da53b14b468",
                                        "glosses": [
                                            "Femme belle et désirable."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603b73e6-4f87-48af-abc4-37690efb14b7",
                                                "sense_id": "c8cc0a97-8bf9-3821-9c92-17f64e666e22",
                                                "text": "Samuel alla au théâtre et se mit à étudier la Fanfarlo sur les planches. Il la trouva légère, magnifique, vigoureuse, pleine de goût dans ses accoutrements, et jugea M. de Cosmelly bien heureux de pouvoir se ruiner pour un pareil morceau."
                                            },
                                            {
                                                "example_id": "34dd5aeb-26d9-40e6-beb1-2748123749af",
                                                "sense_id": "c8cc0a97-8bf9-3821-9c92-17f64e666e22",
                                                "text": "« Quel morceau… et elle a l’air facile, en plus !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5efc9c28-c30c-4df1-952a-9beb1103acc8",
                        "source_entry_id": "d9c31bf2-04a4-3a7f-a9c0-b154f256cacd",
                        "target_lang_word": "lambeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df21fb43-1e15-3666-9c7a-368a4e1096c7",
                                        "entry_id": "61594610-34f9-39e5-8c15-e278989e9720",
                                        "glosses": [
                                            "Morceau d’une étoffe déchirée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b32dde8-41a7-47e2-ae68-54569e3075b0",
                                                "sense_id": "df21fb43-1e15-3666-9c7a-368a4e1096c7",
                                                "text": "Ce vêtement est tout en lambeaux, s’en va en lambeaux, par lambeaux."
                                            },
                                            {
                                                "example_id": "49b6d97d-1e35-4138-b4e4-f3706e6c6359",
                                                "sense_id": "df21fb43-1e15-3666-9c7a-368a4e1096c7",
                                                "text": "Elle a laissé un lambeau de sa robe à ces épines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac817e15-1981-3c03-8ce2-c54dc633b4c7",
                                        "entry_id": "61594610-34f9-39e5-8c15-e278989e9720",
                                        "glosses": [
                                            "Morceaux de chair déchirée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc16402-a496-4537-aaa4-60a6ae0b10bd",
                                                "sense_id": "ac817e15-1981-3c03-8ce2-c54dc633b4c7",
                                                "text": "Lorsque le lambeau avait été couvert d'emplâtre, et qu'au bout de quelques jours j'enlevais ce dernier, le lambeau cutané avait une teinte blanchâtre; si cela avait lieu plus tard, il passait à une véritable putréfaction. Si, au contraire, je m'étais contenté de l'assujétir par des points de suture, il se racoquillait, et se desséchait en une mince lamelle."
                                            },
                                            {
                                                "example_id": "d7eebba3-caef-4975-ae38-0526feaf06d1",
                                                "sense_id": "ac817e15-1981-3c03-8ce2-c54dc633b4c7",
                                                "text": "Et soudain il sentit surgir en lui la résolution violente d’échapper à cette suppliciante domination. Elle l’avait cloué sur une croix ; il y saignait de tous ses membres, et elle le regardait agoniser sans comprendre sa souffrance, contente même d’avoir fait ça. Mais il s’arracherait de ce poteau mortel, en y laissant des morceaux de son corps, des lambeaux de sa chair et tout son cœur déchiqueté."
                                            },
                                            {
                                                "example_id": "dd44f373-ac4d-4149-8e75-11c724c65197",
                                                "sense_id": "ac817e15-1981-3c03-8ce2-c54dc633b4c7",
                                                "text": "— Je me demandais si, après avoir fait les quatre cents coups, laissé sans doute des lambeaux de mon cœur aux buissons du chemin, je pourrais m’accommoder d'un petit train-train tout bourgeois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8624998a-6330-34f0-b248-339ad03e2d97",
                                        "entry_id": "61594610-34f9-39e5-8c15-e278989e9720",
                                        "glosses": [
                                            "Partie détachée ; fragment ; débris."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081b480e-d92a-4dd3-962e-5db80d628de9",
                                                "sense_id": "8624998a-6330-34f0-b248-339ad03e2d97",
                                                "text": "Le groupe schisteux forme une bande qui circonscrit celle des poudingues de Fépin, ainsi que les massifs ardennais de Rocroy et de Givonne. […]. On en retrouve des lambeaux contre le massif ardennais de Givonne à Vrigne-aux-Bois, au Mazy, au N. de Fleigneux, de La Chapelle et de Muno."
                                            },
                                            {
                                                "example_id": "89d2c7e6-5ec5-4c6b-aed5-04a37c90c245",
                                                "sense_id": "8624998a-6330-34f0-b248-339ad03e2d97",
                                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. » — (Georges Blond, L'Agonie de l'Allemagne 1944-1945, Fayard, 1952, p.326)"
                                            },
                                            {
                                                "example_id": "cd86e37d-1330-4d9e-804b-a42f7001ac01",
                                                "sense_id": "8624998a-6330-34f0-b248-339ad03e2d97",
                                                "text": "On n’a entendu que quelques lambeaux de ce discours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39446192-1100-44c9-99ea-bbc8cd8cfb62",
                        "source_entry_id": "d9c31bf2-04a4-3a7f-a9c0-b154f256cacd",
                        "target_lang_word": "bribe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bribe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76345c50-255e-3ccc-bf55-6de23c886f3a",
                                        "entry_id": "182ee249-52f9-3cfd-8915-6c65c7a9a6da",
                                        "glosses": [
                                            "Petit, insignifiant morceau de pain ou de nourriture laissé à un déshérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc4071d3-5512-432b-ae8e-9055b1cee828",
                                                "sense_id": "76345c50-255e-3ccc-bf55-6de23c886f3a",
                                                "text": "Manger une bribe de pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2055f608-4e45-3356-bbba-2ed99d153b7a",
                                        "entry_id": "182ee249-52f9-3cfd-8915-6c65c7a9a6da",
                                        "glosses": [
                                            "Les restes d’un repas ou de nourriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcc62d8-528b-4edc-9721-3d49166b2dca",
                                                "sense_id": "2055f608-4e45-3356-bbba-2ed99d153b7a",
                                                "text": "Il n’avait à manger que les bribes de viande qu’on voulait bien lui laisser."
                                            },
                                            {
                                                "example_id": "637fdd12-b937-4654-8e75-d7bde8a6ba77",
                                                "sense_id": "2055f608-4e45-3356-bbba-2ed99d153b7a",
                                                "text": "Cela se changeait promptement en un déjeuner dont j’étais le pourvoyeur, et qu’il partageait avec un autre camarade ; car pour moi, très content d’en avoir quelques bribes, je ne touchais pas même à leur vin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                        "entry_id": "182ee249-52f9-3cfd-8915-6c65c7a9a6da",
                                        "glosses": [
                                            "Toute sorte de restes ou de morceaux, notamment de paroles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8607a26-0e73-4bc3-9fef-32833940c974",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "C'était [Villars] un répertoire de romans, de comédies et d’opéras dont il citait à tout propos des bribes."
                                            },
                                            {
                                                "example_id": "c71ff6f1-ed2c-4706-9134-0f482d36e804",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "Je sais qu’un homme qui fait des vers mieux que moi a récité des bribes fort jolies d’un petit poème […]"
                                            },
                                            {
                                                "example_id": "f31984e8-5be8-4184-bd5f-a6156f76c2b0",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "Si j'avais le moindre crédit, quelques bribes à leur jeter, ils seraient tous à mes pieds."
                                            },
                                            {
                                                "example_id": "481b4ded-fbd8-48df-a8bc-f8b2846751a9",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "Qu’il sût quelques bribes de latin, un peu d’histoire sainte, l’ordre des rois de France et les honnêtes légendes des règnes de Henri IV, Louis XIV et Louis XVI, avec cela les noms des huit ou dix grandes villes de l’Europe : c’était plus qu’il n’en fallait pour un homme qui n’aurait pas besoin de travailler."
                                            },
                                            {
                                                "example_id": "422562e1-9d8d-43ee-9a1c-e7c57d62d679",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "Des souvenirs lui revenaient par bribes. Il se remémorait le bonheur qu'il avait découvert à marcher dans les champs ou à travers les bois."
                                            },
                                            {
                                                "example_id": "0e7a1ef2-69cd-4304-9e60-c125f67c9cc9",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "Et puis il détourna la conversation ; il ne se livrait jamais que par toutes petites bribes et je n’insistais pas."
                                            },
                                            {
                                                "example_id": "57b714c9-8413-42ed-a97d-cbdd534409be",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "Culture du bannissement\n Cette tendance n’est pas unique aux États-Unis, bien sûr. On vit aussi chez nous les effets de ce mouvement qui, au nom du redressement de torts réels subis par certains groupes, s’empare de bribes de pouvoir à sa portée pour ostraciser les symboles de la culture dominante et faire taire toute voix qui indispose."
                                            },
                                            {
                                                "example_id": "8d658fb8-94df-462f-8754-58e6a8168b28",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "C’est un livre composé des bribes de vingt autres."
                                            },
                                            {
                                                "example_id": "4d118ed3-0727-405f-8b85-1fb8d4876f0e",
                                                "sense_id": "07da7a08-f407-3c6d-9a75-ef6247efbe66",
                                                "text": "J’étais loin de l’orateur, je n’ai eu que des bribes de son discours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39699029-d9ae-3f1d-82f1-0f081256408b",
                                        "entry_id": "182ee249-52f9-3cfd-8915-6c65c7a9a6da",
                                        "glosses": [
                                            "Dans un signal numérique formé selon une loi déterminée à partir d’un élément de donnée, une des parties émises successivement, qui possède des caractéristiques distinctes des autres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
