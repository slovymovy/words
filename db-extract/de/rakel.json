                "senses": [
                    {
                        "sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                        "entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                        "glosses": [
                            "Werkzeug, mit dem man Folien glatt streicht oder abkratzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054fb3a7-2f40-42b7-b106-aa24f7de0b3a",
                                "sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                                "text": "Der Dekorateur streicht vorsichtig die Folie mit der Rakel auf dem Schaufenster glatt, während seine Kollegin die Schutzfolie abzieht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a8a71a1b-a553-3a6d-9752-85cd77174246",
                        "entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                        "glosses": [
                            "flexibles Werkzeug, mit dem überschüssige Farbe von der Druckform abgezogen wird"
                        ],
                        "tags": [
                            "Drucktechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "5481ac5c-cba5-4e0d-8cf7-cb2243be4b8a",
                                "sense_id": "a8a71a1b-a553-3a6d-9752-85cd77174246",
                                "text": "Beim Tiefdruck dient die Rakel dazu, die überschüssige Druckfarbe von den Stegen des Druckzylinders abzustreifen, so dass nur noch die Näpfchen mit Farbe gefüllt sind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18d79a35-9f74-458a-82b2-02cba1abd4fd",
                        "source_entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                        "source_sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                        "source_sense_description": "Werkzeug, mit dem man Folien glatt streicht oder abkratzt",
                        "target_lang_word": "racloir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racloir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b56007d-a8c2-30d3-a9f9-7c3ab82f2264",
                                        "entry_id": "f305ff79-91d0-3d12-b99f-318ea637aafa",
                                        "glosses": [
                                            "Instrument destiné à racler quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b11d38e-0a9b-45f3-a1fc-45e1c9efcac3",
                                                "sense_id": "4b56007d-a8c2-30d3-a9f9-7c3ab82f2264",
                                                "text": "Racloir dont on racle un tonneau."
                                            },
                                            {
                                                "example_id": "f1799ac4-440f-4651-ac17-6a255656a0e1",
                                                "sense_id": "4b56007d-a8c2-30d3-a9f9-7c3ab82f2264",
                                                "text": "Racloir pour racler du parchemin."
                                            },
                                            {
                                                "example_id": "f515be8d-f9bf-4e89-a51a-4c029d3f075f",
                                                "sense_id": "4b56007d-a8c2-30d3-a9f9-7c3ab82f2264",
                                                "text": "Le racloir dont un jardinier se sert pour racler des allées."
                                            },
                                            {
                                                "example_id": "c1ca1e5d-96f1-4f8f-a051-c444ceed36b4",
                                                "sense_id": "4b56007d-a8c2-30d3-a9f9-7c3ab82f2264",
                                                "text": "Même un fou rire m’a pris en regardant de près mon triste visage, tandis que je passais et repassais le rasoir sur une barbe dont aucun racloir n’aura jamais raison, une vraie barbe de chemineau, de roulier…"
                                            },
                                            {
                                                "example_id": "f97ea390-ddd9-4ea6-9aba-fb037940d3ba",
                                                "sense_id": "4b56007d-a8c2-30d3-a9f9-7c3ab82f2264",
                                                "text": "Il frappe avec le poing la porte d’une de ces maisons, et, pendant qu’on vient lui ouvrir, il racle la semelle de ses bottes sur le racloir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
