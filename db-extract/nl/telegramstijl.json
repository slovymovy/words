                "senses": [
                    {
                        "sense_id": "0fbba9a0-4ecd-34f6-88c7-0e73cad5b351",
                        "entry_id": "f00c4a49-93ec-3d99-8941-d0f2c545e33a",
                        "glosses": [
                            "taalgebruik dat uitzonderlijk bondig is, doordat woorden die ertoe dienen welgevormde zinnen te genereren, maar die niet strikt noodzakelijk zijn voor het begrip van de boodschap, worden weggelaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9903519-add1-46c1-9266-c84227389524",
                                "sense_id": "0fbba9a0-4ecd-34f6-88c7-0e73cad5b351",
                                "text": "In telegramstijl mijmerde Röling in zijn dagboek: 'De stand van het huidig internationaal strafrecht kan vergeleken worden bij de stand van het nationaal strafrecht van ± 12 eeuwen geleden. Ook toen geen codificatie. Recht werd gevonden van geval tot geval, feiten en recht waren nog niet zo gescheiden als ze nu zijn, noch recht en moraal."
                            },
                            {
                                "example_id": "d33c0544-2e36-43b5-93b7-e6c8c8fd217c",
                                "sense_id": "0fbba9a0-4ecd-34f6-88c7-0e73cad5b351",
                                "text": "Ik heb alles wat ik heb geschreven schematisch ondergebracht in zo'n veertig tot vijftig uitgetypte pagina's. Ik heb notities gemaakt, in telegramstijl. Maar het is er in zijn geheel."
                            },
                            {
                                "example_id": "ec0df0e2-5fa2-4a76-a5eb-32490503e6bd",
                                "sense_id": "0fbba9a0-4ecd-34f6-88c7-0e73cad5b351",
                                "text": "Het menu is in telegramstijl: schol, rund, forel, conform de nieuwe menukaartentaal die zich afzet tegen de vorige: steeds wijdlopiger uitleg vol holle lyriek, culinaire krompraat en spelfouten. Maar dit is het andere uiterste. Schol koop je bij de visboer. We kiezen het menu 'Sensation'van zes gangen. Ook een gokje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9153bdf8-523f-4931-be12-2a73b67abc61",
                        "source_entry_id": "f00c4a49-93ec-3d99-8941-d0f2c545e33a",
                        "source_sense_id": "0fbba9a0-4ecd-34f6-88c7-0e73cad5b351",
                        "source_sense_description": "uiterst bondig taalgebruik",
                        "target_lang_word": "telegraphese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telegraphese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c2696b4-bc35-3cb5-84c1-353f9df5ecb6",
                                        "entry_id": "ae270c60-862d-35a0-831f-2e105f60ed20",
                                        "glosses": [
                                            "The terse, abbreviated writing style used in or as used in telegraph messages; speech that resembles this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "738df9f3-5076-4e23-afd4-cb3694501ba7",
                                                "sense_id": "5c2696b4-bc35-3cb5-84c1-353f9df5ecb6",
                                                "text": "Vythilingam said: \"Injection every day. Perhaps all right then.\" Anstruther had not been long in Malaya. He attributed this wog's clipped telegraphese to the shyness of one who meets socially a racial superior."
                                            },
                                            {
                                                "example_id": "8a5a9001-07bf-4c0b-8800-2410892f2a71",
                                                "sense_id": "5c2696b4-bc35-3cb5-84c1-353f9df5ecb6",
                                                "text": "Despite the new gadgetry, these journalists are actually rediscovering telegraphese — the clipped (ideally witty) style that flourished because of word limits imposed by an earlier technology, the telegraph."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
