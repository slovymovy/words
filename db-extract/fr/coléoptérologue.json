                        "glosses": [
                            "Personne spécialiste de la coléoptérologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ad87b1-d6f9-4814-b6ef-2b741fd7d668",
                                "sense_id": "a7c376a8-4884-3c70-b45b-f69488f5b95e",
                                "text": "La question géologique n’a pas encore été traitée par les coléoptérologues comme elle mérite de l'être."
                            },
                            {
                                "example_id": "2382b9d5-14ce-46bb-a67b-83b2f35846ba",
                                "sense_id": "a7c376a8-4884-3c70-b45b-f69488f5b95e",
                                "text": "Lors de notre première ou seconde séance, je l’ai interrogé à propos des insectes dans leurs cadres, et elle a accepté de m’en parler. Surtout des scarabées. Ses préférés. Elle s’est qualifiée de « coléoptérologue amateur »."
                            }
                        ]
                    }
