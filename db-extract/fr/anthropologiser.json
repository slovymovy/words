                ],
                "senses": [
                    {
                        "sense_id": "8b34cca5-2058-3157-81b9-74c00a526f8c",
                        "entry_id": "3c7cbb19-7098-3f53-b952-8f0fccf9b835",
                        "glosses": [
                            "Donner un caractère anthropologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b57890c-b555-4170-861c-0b77ae7428b9",
                                "sense_id": "8b34cca5-2058-3157-81b9-74c00a526f8c",
                                "text": "Pascal a essayé d’anthropologiser le plan idéologique ou, en d’autres termes, de réduire la problématique sociale à celle de l’éternel et de l’éphémère."
                            },
                            {
                                "example_id": "be117cf4-aedd-448c-b128-22848e16feca",
                                "sense_id": "8b34cca5-2058-3157-81b9-74c00a526f8c",
                                "text": "Si l’africanisme se targue d’observer le continent africain, son but essentiel semble avoir été d’anthropologiser les Africains tout en contribuant à dilater les dimensions de l’hexagone."
                            }
                        ]
                    }
                ],
