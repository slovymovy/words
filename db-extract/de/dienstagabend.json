                "senses": [
                    {
                        "sense_id": "fdd3c61e-b1d3-3dba-8ab0-c60bdaafaac4",
                        "entry_id": "42b1cf1b-78ae-3aec-946f-9aa8ccc07cd9",
                        "glosses": [
