                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5495dd72-0f2c-302b-94ff-65b8a2aa8819",
                                        "entry_id": "6007df4b-2769-3d79-817f-b97ee6e220d2",
                                        "glosses": [
                                            "iemand die behang aanbrengt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76feb43f-4ddb-4901-b176-70622ad9c77f",
                                                "sense_id": "5495dd72-0f2c-302b-94ff-65b8a2aa8819",
                                                "text": "Er werden plakkers en stukadoors gevraagd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf53e0e2-6d64-3599-a79c-449c1cec149b",
                                        "entry_id": "6007df4b-2769-3d79-817f-b97ee6e220d2",
                                        "glosses": [
                                            "iemand die te lang op zijn stoel blijft zitten en niet weg wil gaan"
                                        ],
                                        "tags": [
                                            "informal",
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13cea91-062d-49c1-8a3f-d314814f68e1",
                                                "sense_id": "bf53e0e2-6d64-3599-a79c-449c1cec149b",
                                                "text": "In onze kroeg spelen ze bij sluitingstijd altijd een vreselijke smartlap op vol volume om de plakkers naar huis te sturen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2475f93-512e-3d4b-b1ac-e3aedffb3c7a",
                                        "entry_id": "6007df4b-2769-3d79-817f-b97ee6e220d2",
                                        "glosses": [
                                            "een stukje materiaal dat door kleven op iets anders aangebracht wordt; ook bijv. bij medische toepassingen"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4aa28cb-411d-4057-851e-75ac0dea4cd1",
                                                "sense_id": "e2475f93-512e-3d4b-b1ac-e3aedffb3c7a",
                                                "text": "Heb je een plakker voor me? Mijn band is lek."
                                            },
                                            {
                                                "example_id": "5041c0fe-285f-4e5b-bc95-8088cd1fbec7",
                                                "sense_id": "e2475f93-512e-3d4b-b1ac-e3aedffb3c7a",
                                                "text": "Dit apparaat heeft plakkers voor op de borst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6776a2be-1c80-3a95-9235-cadd537920f2",
                                        "entry_id": "6007df4b-2769-3d79-817f-b97ee6e220d2",
                                        "glosses": [
                                            "plakplaatje, sticker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc98383e-b52c-4f00-a979-33b1126cab63",
                                                "sense_id": "6776a2be-1c80-3a95-9235-cadd537920f2",
                                                "text": "Wij verkopen leuke plakkers voor de versiering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97a5b8d-f3f4-31e9-bcdf-546151c371e5",
                                        "entry_id": "6007df4b-2769-3d79-817f-b97ee6e220d2",
                                        "glosses": [
                                            "iemand die te dicht achter een ander voertuig rijdt, bumperklever"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfbd2d01-1bff-4b53-8f99-628793a3f9b1",
                                                "sense_id": "a97a5b8d-f3f4-31e9-bcdf-546151c371e5",
                                                "text": "Op de weg had ik een plakker achter me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
