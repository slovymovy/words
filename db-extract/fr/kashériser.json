                ],
                "senses": [
                    {
                        "sense_id": "3d1a1375-aa12-3ad9-bbae-d77a7ca7a0d3",
                        "entry_id": "e89da8b1-8a4c-352e-99f7-e7e690bc2e3e",
                        "glosses": [
                            "Rendre kasher, ou rendre propre à une utilisation kasher (quelque chose qui a servi de façon non kasher)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00637d0-1fbb-4087-a40b-17412e8f28bb",
                                "sense_id": "3d1a1375-aa12-3ad9-bbae-d77a7ca7a0d3",
                                "text": "Il y a alors une tendance messianique d'Israël de se mettre au service de cette civilisation dominante pour la « kashériser », pour la sanctifier."
                            },
                            {
                                "example_id": "f68e32b9-2d95-4e1e-872a-28a4257686c8",
                                "sense_id": "3d1a1375-aa12-3ad9-bbae-d77a7ca7a0d3",
                                "text": "Pour les transplantés juifs, y a t'il un rabbin pour kashériser les organes issus des goys ?"
                            },
                            {
                                "example_id": "7e2590b5-26bc-45f5-8c6b-c911891eb4ba",
                                "sense_id": "3d1a1375-aa12-3ad9-bbae-d77a7ca7a0d3",
                                "text": "Si du vin qui n'est pas kasher (amené par des amis goyims) a été versé dans nos verres, faut-il kashériser les verres ou un simple rinçage suffit-il ?"
                            }
                        ]
                    }
                ],
