                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07306a8-70c8-4c1a-b803-8ccee8d05a38",
                                "sense_id": "c223d75a-b374-3e13-9c93-78322f3c59ed",
                                "text": "Le tongien lui-même montrerait une situation intermédiaire entre le micronésien et l’indonésien, par son aspect perfectif parfois capable d’effectuer un retournement diathétique …"
                            },
                            {
                                "example_id": "740f2440-afd3-4c1c-aa4c-2d109437467e",
                                "sense_id": "c223d75a-b374-3e13-9c93-78322f3c59ed",
                                "text": "Avec le polynésien, le micronésien et le mélanésien en tant que langue de Fiji et Rotuma se rattachent au proto-polynésien."
                            }
                        ]
                    }
