                                                "example_id": "39cc0494-c2ac-4d45-a067-68cb31739b98",
                                                "sense_id": "91385ad5-c90c-346e-8826-3ed02b0e5bb0",
                                                "text": "Een acetaat bevat ofwel het ion CH₃COO⁻ ofwel een functionele groep CH₃COO-."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8256d1a1-d732-4c81-9b56-26f9809dbc63",
                        "source_entry_id": "64e7e4c1-5a7f-3d4e-9b3f-c3c96290133b",
                        "source_sense_description": "salt or ester of acetic acid",
