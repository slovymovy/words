                        "linkage_type": "synonyms",
                        "word": "at sea"
                    }
                ]
            },
            {
                "entry_id": "8ecf0f8f-9729-3a1b-b2af-58a6ecfc49fa",
                "word": "afloat",
                "pos": "prep",
                "lang_code": "en",
                "forms": [],
