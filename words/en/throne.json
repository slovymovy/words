{
    "word_family": [
        "enthrone",
        "dethrone",
        "throneless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad0c3d94-6a55-3ba3-ad17-19d3eb7475d7",
                    "sense_definition": "An impressive seat used by a monarch, often placed on a raised platform for formal occasions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "seat_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sat on his golden <w>throne</w> to address the court.",
                            "target_lang_translations": {
                                "ru": "Король сидел на своем золотом <w>троне</w>, обращаясь к придворным.",
                                "zh": "国王坐在他金色的<w>宝座</w>上，向群臣讲话。"
                            }
                        },
                        {
                            "text": "Visitors must bow respectfully before approaching the royal <w>throne</w>.",
                            "target_lang_translations": {
                                "ru": "Посетители должны почтительно кланяться, прежде чем приблизиться к королевскому <w>трону</w>.",
                                "zh": "访客必须先恭敬行礼，才能走近皇家<w>宝座</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sit on the throne",
                        "royal throne",
                        "golden throne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впечатляющее сиденье, используемое монархом, часто установленное на возвышении для торжественных случаев.",
                        "zh": "君主使用的华丽座椅，常设在高台上，用于正式场合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трон",
                                "target_lang_sense_clarification": "предмет мебели"
                            },
                            {
                                "target_lang_word": "престол",
                                "target_lang_sense_clarification": "торжественно/устар."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝座",
                                "target_lang_sense_clarification": "君主正式就座用的华丽座椅"
                            },
                            {
                                "target_lang_word": "御座",
                                "target_lang_sense_clarification": "较书面，强调帝王座位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "571a7839-9cca-378a-91e9-b4125fb5cc4f",
                    "sense_definition": "The position of being a king or queen; the power, rank, or authority of a monarch.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "seat_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince is currently second in line to the <w>throne</w>.",
                            "target_lang_translations": {
                                "ru": "Принц в настоящее время второй в очереди на <w>престол</w>.",
                                "zh": "这位王子目前是王位的第二顺位继承人。"
                            }
                        },
                        {
                            "text": "She ascended the <w>throne</w> immediately after her father passed away.",
                            "target_lang_translations": {
                                "ru": "Она взошла на <w>престол</w> сразу после смерти отца.",
                                "zh": "她在父亲去世后立刻登上了<w>王位</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heir to the throne",
                        "ascend the throne",
                        "claim the throne",
                        "succeed to the throne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положение короля или королевы; власть, ранг или полномочия монарха.",
                        "zh": "国王或女王的身份地位，以及君主所拥有的权力、等级或统治权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "престол",
                                "target_lang_sense_clarification": "символ власти"
                            },
                            {
                                "target_lang_word": "трон",
                                "target_lang_sense_clarification": "власть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "王位",
                                "target_lang_sense_clarification": "国王或女王的地位、统治权"
                            },
                            {
                                "target_lang_word": "皇位",
                                "target_lang_sense_clarification": "特指皇帝的帝位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f73aba8c-b7ba-3496-a151-5eee919582ad",
                    "sense_definition": "A toilet.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent too much time on the <w>throne</w> reading a magazine.",
                            "target_lang_translations": {
                                "ru": "Он провел слишком много времени на <w>троне</w>, читая журнал.",
                                "zh": "他坐在<w>马桶</w>上看杂志，待了太久。"
                            }
                        },
                        {
                            "text": "The plumber came to fix the broken <w>throne</w> in the upstairs bathroom.",
                            "target_lang_translations": {
                                "ru": "Сантехник пришел починить сломанный <w>трон</w> в ванной наверху.",
                                "zh": "水管工来修楼上浴室里坏掉的<w>马桶</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toilet"
                    ],
                    "common_phrases": [
                        "on the throne"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "humorous"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Унитаз.",
                        "zh": "马桶；对厕所的幽默说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трон",
                                "target_lang_sense_clarification": "шутл."
                            },
                            {
                                "target_lang_word": "белый друг",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马桶",
                                "target_lang_sense_clarification": "口语中对厕所的幽默说法"
                            },
                            {
                                "target_lang_word": "坐便器",
                                "target_lang_sense_clarification": "更正式普通的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22c7eee2-ef42-39ee-bcca-31b724e2c908",
                    "sense_definition": "The official seat of a bishop in a cathedral.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop took his place on the <w>throne</w> during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Епископ занял свое место на <w>троне</w> во время церемонии.",
                                "zh": "仪式期间，主教坐上了自己的<w>主教座</w>。"
                            }
                        },
                        {
                            "text": "This ancient cathedral houses a beautifully carved wooden <w>throne</w>.",
                            "target_lang_translations": {
                                "ru": "В этом древнем соборе находится красиво вырезанный деревянный <w>трон</w>.",
                                "zh": "这座古老的大教堂里有一把雕刻精美的木质<w>主教座</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cathedra"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ecclesiastical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное место епископа в соборе.",
                        "zh": "大教堂中主教的正式座位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трон",
                                "target_lang_sense_clarification": "епископский"
                            },
                            {
                                "target_lang_word": "кафедра",
                                "target_lang_sense_clarification": "церковная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主教座",
                                "target_lang_sense_clarification": "大教堂中主教的正式座位"
                            },
                            {
                                "target_lang_word": "主教座椅",
                                "target_lang_sense_clarification": "教会语境中的正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c995873c-0a82-33f3-b21d-a06d7b4a133f",
                    "sense_definition": "A stool used by drummers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer adjusted the height of his <w>throne</w> before the concert began.",
                            "target_lang_translations": {
                                "ru": "Барабанщик отрегулировал высоту своего <w>стула</w> перед началом концерта.",
                                "zh": "音乐会开始前，鼓手调好了自己<w>鼓凳</w>的高度。"
                            }
                        },
                        {
                            "text": "He bought a padded <w>throne</w> to make playing for long hours more comfortable.",
                            "target_lang_translations": {
                                "ru": "Он купил мягкий <w>стул</w>, чтобы играть долгие часы было удобнее.",
                                "zh": "他买了一个带软垫的<w>鼓凳</w>，这样长时间演奏会更舒服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drum throne"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стул, используемый барабанщиками.",
                        "zh": "鼓手使用的凳子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стул",
                                "target_lang_sense_clarification": "барабанный"
                            },
                            {
                                "target_lang_word": "стульчик",
                                "target_lang_sense_clarification": "музыкальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鼓凳",
                                "target_lang_sense_clarification": "鼓手演奏时使用的专用凳子"
                            },
                            {
                                "target_lang_word": "鼓手椅",
                                "target_lang_sense_clarification": "较直白的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee011667-4453-3ec9-924e-797f515cfa19",
                    "sense_definition": "A specific rank of angels in Christian theology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Religious texts describe <w>thrones</w> as powerful celestial beings near to God.",
                            "target_lang_translations": {
                                "ru": "Религиозные тексты описывают <w>престолы</w> как могущественных небесных существ, близких к Богу.",
                                "zh": "宗教文本把<w>座天使</w>描述为接近上帝的强大天界存在。"
                            }
                        },
                        {
                            "text": "The painting depicts various orders of angels, including seraphim and <w>thrones</w>.",
                            "target_lang_translations": {
                                "ru": "На картине изображены различные чины ангелов, включая серафимов и <w>престолы</w>.",
                                "zh": "这幅画描绘了各种等级的天使，包括炽天使和<w>座天使</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "theology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый чин ангелов в христианском богословии.",
                        "zh": "基督教神学中一种特定等级的天使。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Престолы",
                                "target_lang_sense_clarification": "ангельский чин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "座天使",
                                "target_lang_sense_clarification": "基督教天使等级中的一类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0fcb0e9-3ef5-3fe1-a2c0-e3dfdbe58a1c",
                    "sense_definition": "To place someone on a royal seat or in a position of power.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The people <w>throned</w> their new leader with great celebration and ceremony.",
                            "target_lang_translations": {
                                "ru": "Народ <w>возвел на престол</w> своего нового лидера с большим торжеством и церемонией.",
                                "zh": "人们以盛大的庆典和仪式把他们的新领袖<w>拥立为王</w>。"
                            }
                        },
                        {
                            "text": "She was <w>throned</w> amidst the cheers of her loyal subjects.",
                            "target_lang_translations": {
                                "ru": "Она была <w>возведена на трон</w> под ликование своих верных подданных.",
                                "zh": "她在忠诚臣民的欢呼声中被<w>拥立为王</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать кого-либо на королевское сиденье или наделять властью.",
                        "zh": "把某人安置到王座上，或使其获得君主般的权位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возводить на престол",
                                "target_lang_sense_clarification": "церемониально"
                            },
                            {
                                "target_lang_word": "воцарять",
                                "target_lang_sense_clarification": "устар."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拥立为王",
                                "target_lang_sense_clarification": "以仪式性方式立某人为君主"
                            },
                            {
                                "target_lang_word": "立为君主",
                                "target_lang_sense_clarification": "使某人登上王位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}