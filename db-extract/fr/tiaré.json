                    {
                        "sense_id": "0419f903-e094-3753-badd-0ae9e9722da5",
                        "entry_id": "81e1156d-0822-359c-bdc6-b7ddcca369a1",
                        "glosses": [
                            "Coiffé d'une tiare, qui porte la tiare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cfd98ec-4ba5-4604-b26e-9c6fdda2ed9e",
                                "sense_id": "0419f903-e094-3753-badd-0ae9e9722da5",
                                "text": "Ce monarque rouge, tiaré d'or."
                            },
                            {
                                "example_id": "d8ea8c80-a89d-4422-a045-3d185e9b246b",
                                "sense_id": "0419f903-e094-3753-badd-0ae9e9722da5",
                                "text": "Cette idole peinte et tiarée, immobile dans son manteau d'or."
                            },
                            {
                                "example_id": "0dc48d24-cf17-4b1e-9f58-6ae820d07a1d",
                                "sense_id": "0419f903-e094-3753-badd-0ae9e9722da5",
                                "text": "Le roi dont la tête reste tiarée, les cheveux et la barbe huilés, parfumés, frisés, égorge ou étrangle avec calme le monstre."
                            },
                            {
                                "example_id": "2302e6ed-4420-4385-8f45-6d85535a6ca4",
                                "sense_id": "0419f903-e094-3753-badd-0ae9e9722da5",
                                "text": "À mi-chemin entre le folklore et le mythe, un peu effrayant et un peu bonasse, il [Dieu] se distingue mal aux yeux des enfants du Saint Nicolas également houppelandé, tiaré et barbu, qui le six décembre leur apporte des bonbons s’ils ont été sages."
                            }
                        ]
                    }
                ],
