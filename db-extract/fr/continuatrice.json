                        "source_entry_id": "3f7093d3-0e7f-3506-9b3b-9ea00f0957db",
                        "source_sense_id": "4ac9e9d5-aebe-3082-b146-3b304253aa5f",
                        "target_lang_word": "successor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successor",
