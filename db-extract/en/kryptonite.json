                    },
                    {
                        "translation_id": "0b605450-cd8d-485c-a433-2e177dce886c",
                        "source_entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "source_sense_description": "weakness",
                        "target_lang_word": "kryptonite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kryptonite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eebcbbd7-3193-31b5-b684-1d79e48cad3d",
                                        "entry_id": "e733825d-abb0-38a0-9dfc-d791ad0d859c",
                                        "glosses": [
                                            "Roche imaginaire, radioactive, d’origine météoritique pouvant affecter Superman, autrement invulnérable."
                                        ],
                                        "tags": [
                                            "Fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42b94a91-a282-4e61-9e1b-e6d5074a759c",
                                                "sense_id": "eebcbbd7-3193-31b5-b684-1d79e48cad3d",
                                                "text": "La kryptonite a tout d’abord été inventée non pas dans la version des magazines, mais dans l’émission de radio «The Adventures of Superman» en juin 1943, cette matière dangereuse sera intégrée dans les comics en novembre 1949."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70fac4ef-c2ca-3954-929a-4cf5ac4617b2",
                                        "entry_id": "e733825d-abb0-38a0-9dfc-d791ad0d859c",
                                        "glosses": [
                                            "Tout élément qui neutralise un pouvoir ou constitue un point faible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8ac69b-f3cb-4e30-bb9f-bc40deb83a44",
                                                "sense_id": "70fac4ef-c2ca-3954-929a-4cf5ac4617b2",
                                                "text": "Le problème majeur du traitement de l’allongement compensatoire dans une théorie paralléliste provient donc du Poids par Position, qui possède les mêmes effets sur l’allongement compensatoire que la kryptonite sur Superman en ce qu’elle inhibe l’expression de son pouvoir."
                                            },
                                            {
                                                "example_id": "9bbe3d83-50ee-4222-a08b-c3fe0f971ae3",
                                                "sense_id": "70fac4ef-c2ca-3954-929a-4cf5ac4617b2",
                                                "text": "Les deux aspirants premiers ministres en sont à leur premier test électoral, traînant chacun son lot de kryptonite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "147f8e28-cec4-4eeb-8266-e35a2d45924b",
                        "source_entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "source_sense_description": "weakness",
                        "target_lang_word": "Kryptonit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryptonit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b3946e-5e98-3dad-a00b-8e42e3fd4df3",
                                        "entry_id": "adf60f1d-7fb5-3e6f-b6da-462127fabc95",
                                        "glosses": [
                                            "Mineral, das nur in dem fiktiven Universum des US-amerikanischen Comic-Verlages DC Comics existiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f906c1af-76b3-4343-a159-bdfddd043fda",
                                                "sense_id": "40b3946e-5e98-3dad-a00b-8e42e3fd4df3",
                                                "text": "„Das Kryptonit hat eine wechselvolle Geschichte hinter sich. Anfangs, in einem frühen ‚Superman‘-Comic, war es einmal rot, später schimmerte es auch schon einmal bläulich-violett.“"
                                            },
                                            {
                                                "example_id": "d730b90f-57c7-4daf-8825-99a0b4903ee3",
                                                "sense_id": "40b3946e-5e98-3dad-a00b-8e42e3fd4df3",
                                                "text": "„In einer serbischen Mine wurde letztes Jahr ein Mineral entdeckt, dessen chemische Zusammensetzung dem von Kryptonit weitgehend entspricht.“"
                                            },
                                            {
                                                "example_id": "b52215bc-3621-4ae0-abfd-a968883dcfa2",
                                                "sense_id": "40b3946e-5e98-3dad-a00b-8e42e3fd4df3",
                                                "text": "„Der Comic-Held Superman ist unbezwingbar. Kugeln prallen von ihm ab wie Fliegen. Wenn aber Schurken ein grün leuchtendes Wundermaterial – genannt Kryptonit – bei sich tragen, ist Superman machtlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaa026a8-d336-4b42-8e6c-e363fe5060ad",
                        "source_entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "source_sense_description": "weakness",
                        "target_lang_word": "Achillesferse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achillesferse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad952a1e-3d9c-38f2-98d0-428f26eb095b",
                                        "entry_id": "a52b2bf0-b488-3e45-bd47-615849dd3e13",
                                        "glosses": [
                                            "schwache beziehungsweise verwundbare Stelle einer Person oder eines Systems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f72756-0522-44f5-97d0-0506cf7837bd",
                                                "sense_id": "ad952a1e-3d9c-38f2-98d0-428f26eb095b",
                                                "text": "Er ist fachlich ausgezeichnet, aber seine Präsentation gestern war sehr schlecht. Das ist eben seine Achillesferse."
                                            },
                                            {
                                                "example_id": "74caddb6-639e-42da-99f1-803a48e8c896",
                                                "sense_id": "ad952a1e-3d9c-38f2-98d0-428f26eb095b",
                                                "text": "„Indien hat eine Achillesferse, den Kashmirkonflikt, dessen Entstehung bereits beschrieben wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53bc4234-fd87-452f-8462-5a56c07a3932",
                        "source_entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "source_sense_description": "weakness",
                        "target_lang_word": "wunder Punkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5c1433f0-eb9d-4f1d-b441-0f7a0159d916",
                        "source_entry_id": "21d94e81-0568-352e-921a-b75b6f653520",
                        "source_sense_description": "weakness",
                        "target_lang_word": "Schwachstelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwachstelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "414d4d24-ccf7-35bf-b4d0-c746b784d248",
                                        "entry_id": "20e810d5-3c9c-3a01-88bd-41f647997ae9",
                                        "glosses": [
                                            "der Punkt, an dem etwas oder jemand verletzlich oder angreifbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06a90f3-cab9-41a0-8f78-91489b607d20",
                                                "sense_id": "414d4d24-ccf7-35bf-b4d0-c746b784d248",
                                                "text": "Die Schwachstelle der Burg ist die Lebensmittelzufuhr."
                                            },
                                            {
                                                "example_id": "c5e74308-eb7d-4acf-8136-1520b8f12da3",
                                                "sense_id": "414d4d24-ccf7-35bf-b4d0-c746b784d248",
                                                "text": "Bei den Untersuchungen ist eine Schwachstelle in der Spionageabwehr aufgefallen."
                                            },
                                            {
                                                "example_id": "95a36553-63d9-498a-963e-5e0cdafd3141",
                                                "sense_id": "414d4d24-ccf7-35bf-b4d0-c746b784d248",
                                                "text": "Dr. Müller ist vermutlich diejenige Person bei uns, an welche Bewerber sich anschließend noch lange erinnern werden. Er konzentriert sich ausschließlich auf die Schwachstellen im Lebenslauf, und glauben Sie mir, er findet immer etwas, oft bringt er sehr erstaunliche Zusammenhänge zum Vorschein."
                                            },
                                            {
                                                "example_id": "20eab193-9d8b-49c6-82f7-4d3749af2511",
                                                "sense_id": "414d4d24-ccf7-35bf-b4d0-c746b784d248",
                                                "text": "„Die größten Schwachstellen von mRNA-Impfstoffen sind die begrenzte Haltbarkeit und die aufwendige Lagerung. Die ersten Impfchargen hielten nur sechs Monate, mittlerweile werden sie nach neun Monaten vernichtet.“"
                                            },
                                            {
                                                "example_id": "76339d77-77fa-451a-bc3f-cb09f3c3278e",
                                                "sense_id": "414d4d24-ccf7-35bf-b4d0-c746b784d248",
                                                "text": "„Danach nutzt die Gruppe bekannte Schwachstellen aus, um sich erweiterte Zugriffsrechte in Firmennetzwerken zu verschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
