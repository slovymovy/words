                "forms": [
                    {
                        "form_id": "4d3f543f-50a5-4fac-87bd-7664c53b6a31",
                        "entry_id": "ed8695da-f511-35dd-be1f-bc2fb0abe6ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "bloedsomlopen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4e0ddc6-d981-3c62-a71d-317f2445689a",
                        "entry_id": "ed8695da-f511-35dd-be1f-bc2fb0abe6ba",
                        "glosses": [
                            "Het bloedvatenstelsel of de bloedsomloop bij de mens is het gesloten systeem van vaten waardoor bloed stroomt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92bd9b9b-f6d0-4de7-bb17-9e8616f7ef3a",
                                "sense_id": "b4e0ddc6-d981-3c62-a71d-317f2445689a",
                                "text": "Het hart zorgt voor de drijfkracht achter de bloedstroming. Het heeft een pompwerking binnen de bloedsomloop. Als het hart niet meer pompt, stopt ook de bloedcirculatie; er is sprake van circulatoire collaps waardoor reanimatie noodzakelijk wordt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133f52b2-3803-467e-bf93-b41220febc26",
                        "source_entry_id": "ed8695da-f511-35dd-be1f-bc2fb0abe6ba",
                        "source_sense_id": "b4e0ddc6-d981-3c62-a71d-317f2445689a",
                        "target_lang_word": "Kreislauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreislauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15f8a446-91ef-3b7e-af1b-10d9573de8e9",
                                        "entry_id": "52c3a319-97e5-31d7-8bdf-8ed102c18c1e",
                                        "glosses": [
                                            "das Zirkulieren des Blutes im Körper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a780fe5c-14d1-49db-b41c-dd4f606885c1",
                                                "sense_id": "15f8a446-91ef-3b7e-af1b-10d9573de8e9",
                                                "text": "Der Kreislauf des Blutes im Körper ist ein spannendes Thema in der Biologie."
                                            },
                                            {
                                                "example_id": "7e05913f-ffcf-4c25-a7bd-ffec6674bf0a",
                                                "sense_id": "15f8a446-91ef-3b7e-af1b-10d9573de8e9",
                                                "text": "„Vielleicht haben Holländer doch keinen Kreislauf.“"
                                            },
                                            {
                                                "example_id": "332546c6-124d-497f-8b03-10cd1883d7bb",
                                                "sense_id": "15f8a446-91ef-3b7e-af1b-10d9573de8e9",
                                                "text": "„Doch zu Zacharowskis Erstaunen blieb der Kreislauf stabil, der Mann erholte sich gut.“"
                                            },
                                            {
                                                "example_id": "5313308f-2920-48a4-be3a-6e7ae2ec71ab",
                                                "sense_id": "15f8a446-91ef-3b7e-af1b-10d9573de8e9",
                                                "text": "„So ein Wetterumschlag geht sensiblen Naturen auf den Kreislauf und aufs Gemüt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b70436b-d9d7-3080-ae6d-1e420db9fd34",
                                        "entry_id": "52c3a319-97e5-31d7-8bdf-8ed102c18c1e",
                                        "glosses": [
                                            "zu ihrem Ausgangspunkt zurückkehrende Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b516512-308a-40cd-9b44-cef6ce0a05db",
                                                "sense_id": "2b70436b-d9d7-3080-ae6d-1e420db9fd34",
                                                "text": "Ansaugen, verdichten, arbeiten und ausstoßen – dieser Kreislauf findet in einem Viertaktmotor viele hundert Mal in der Minute statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5e319c9-48af-4d1a-a349-0b19cdb5baef",
                        "source_entry_id": "ed8695da-f511-35dd-be1f-bc2fb0abe6ba",
                        "source_sense_id": "b4e0ddc6-d981-3c62-a71d-317f2445689a",
                        "target_lang_word": "Blutkreislauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutkreislauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                        "entry_id": "9a7e1cdb-65ea-31c6-b6ef-4717589fd814",
                                        "glosses": [
                                            "Das Strömungssystem des Blutes, das vom Herzen und einem Netz aus Blutgefäßen gebildet wird."
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd8926a7-3646-4fb2-be04-8d1a5d5ba54d",
                                                "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                                "text": "Durch Sport wird der Blutkreislauf angeregt."
                                            },
                                            {
                                                "example_id": "44823bc8-157c-4fee-b741-936e89c2e98d",
                                                "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                                "text": "„Eine neue Blutung schwemmt die Tuberkelbazillen in den Blutkreislauf und erzeugt die todbringende Meningitis.“"
                                            },
                                            {
                                                "example_id": "ed64e457-4e21-463a-9c10-a29623afab83",
                                                "sense_id": "713fbeb0-1e5c-38b8-8334-030bd3c2d9ef",
                                                "text": "„Sein Blutkreislauf kam unter den Massagen wieder in Gang, er bewegte die Arme und schließlich auch den Kopf, dann murmelte er ein paar unverständliche Worte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
