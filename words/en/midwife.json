{
    "word_family": [
        "midwifery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                    "sense_definition": "A person, usually a woman, who is trained to assist women in childbirth, but who is not a physician.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>midwife</w> arrived at the house just in time to help with the delivery.",
                            "target_lang_translations": {
                                "ru": "<w>Акушерка</w> приехала к дому как раз вовремя, чтобы помочь с родами."
                            }
                        },
                        {
                            "text": "She decided to work as a <w>certified</w> <w>midwife</w> after years of nursing experience.",
                            "target_lang_translations": {
                                "ru": "Она решила работать дипломированной <w>акушеркой</w> после многолетнего опыта работы медсестрой."
                            }
                        }
                    ],
                    "synonyms": [
                        "accoucheuse"
                    ],
                    "common_phrases": [
                        "certified midwife",
                        "community midwife",
                        "independent midwife"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (обычно женщина), имеющий специальную подготовку для оказания помощи женщинам при родах, но не являющийся врачом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акушерка",
                                "target_lang_sense_clarification": "медицинский работник среднего звена"
                            },
                            {
                                "target_lang_word": "повитуха",
                                "target_lang_sense_clarification": "традиционное или устаревшее название"
                            },
                            {
                                "target_lang_word": "повивальная бабка",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d729c07-deae-3520-9c80-9d07cdfe4681",
                    "sense_definition": "Someone who assists in bringing about some result or project.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facilitator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted as a <w>midwife</w> to the new peace treaty, ensuring both sides stayed at the table.",
                            "target_lang_translations": {
                                "ru": "Он выступил в роли <w>посредника</w> при заключении нового мирного договора, следя за тем, чтобы обе стороны оставались за столом переговоров."
                            }
                        },
                        {
                            "text": "The professor was a <w>midwife</w> to many brilliant ideas during the seminar.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>способствовал появлению</w> многих блестящих идей во время семинара."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто способствует осуществлению какого-либо результата или проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посредник",
                                "target_lang_sense_clarification": "лицо, содействующее соглашению"
                            },
                            {
                                "target_lang_word": "пособник",
                                "target_lang_sense_clarification": "тот, кто помогает в реализации (переносное)"
                            },
                            {
                                "target_lang_word": "крестный отец",
                                "target_lang_sense_clarification": "в переносном смысле о создателе идеи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "503c3eb5-446b-3a35-8edd-f2f16bb9e891",
                    "sense_definition": "To act as a <w>midwife</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>midwifed</w> hundreds of successful home births over her long career.",
                            "target_lang_translations": {
                                "ru": "За свою долгую карьеру она <w>приняла</w> сотни успешных домашних родов."
                            }
                        },
                        {
                            "text": "It is a great responsibility to <w>midwife</w> a child into the world.",
                            "target_lang_translations": {
                                "ru": "Это большая ответственность — <w>помочь</w> ребенку <w>появиться</w> на свет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять обязанности акушерки, принимать роды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акушерствовать",
                                "target_lang_sense_clarification": "заниматься акушерской практикой"
                            },
                            {
                                "target_lang_word": "принимать роды",
                                "target_lang_sense_clarification": "оказывать помощь при рождении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42300492-1348-3c30-9c33-7d44394f191b",
                    "sense_definition": "To facilitate the emergence or development of something new.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "facilitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat helped to <w>midwife</w> a democratic model that could inspire reform across the region.",
                            "target_lang_translations": {
                                "ru": "Дипломат помог <w>выработать</w> демократическую модель, которая могла бы вдохновить на реформы во всем регионе."
                            }
                        },
                        {
                            "text": "The editor <w>midwifed</w> the young author's first novel through many difficult revisions.",
                            "target_lang_translations": {
                                "ru": "Редактор <w>помог появиться на свет</w> первому роману молодого автора, пройдя через множество трудных правок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствовать появлению или развитию чего-то нового."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способствовать появлению",
                                "target_lang_sense_clarification": "помогать возникновению"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "оказывать помощь в развитии"
                            },
                            {
                                "target_lang_word": "давать жизнь",
                                "target_lang_sense_clarification": "переносное значение для идей или проектов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}