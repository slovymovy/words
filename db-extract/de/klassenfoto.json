                "senses": [
                    {
                        "sense_id": "efcf21b3-bf8b-3fea-86e3-a3a6e08d2a1a",
                        "entry_id": "32ff9ed1-8df8-38df-8321-7f1ca2a058a9",
                        "glosses": [
                            "Fotografie, auf der die Schüler einer Klasse abgebildet sind, oft zusammen mit Klassenlehrer/-in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4dcf517-3f5e-4603-aef4-76c64ffbf9be",
                                "sense_id": "efcf21b3-bf8b-3fea-86e3-a3a6e08d2a1a",
                                "text": "„Jahrelang zerriss er die Klassenfotos.“"
                            },
                            {
                                "example_id": "e371c4eb-c3c1-4f93-9453-0f67ac3e68d8",
                                "sense_id": "efcf21b3-bf8b-3fea-86e3-a3a6e08d2a1a",
                                "text": "„Eins war ein Klassenfoto, auf dem die Kinder im Klassenzimmer posierten, der Lehrer stand daneben.“"
                            },
                            {
                                "example_id": "072a50ce-c5cf-42c2-b515-bc3148c94cfd",
                                "sense_id": "efcf21b3-bf8b-3fea-86e3-a3a6e08d2a1a",
                                "text": "„An der Wand hingen Papas Zeugnisse vom Bergbaustudium in Trondheim zusammen mit seinem Doktordiplom aus Paris und einem Klassenfoto aus Steinkjer, jeder Schüler mit schwarzer Mütze mit einem Bommel an einer langen Schnur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
