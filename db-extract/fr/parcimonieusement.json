                                "target_senses": [
                                    {
                                        "sense_id": "5fad61de-ce2f-3ec0-a14a-a494b3ce0a08",
                                        "entry_id": "7763e3c6-3870-3465-ae6f-70e63b847a98",
                                        "glosses": [
                                            "In an economical manner; not wastefully; not extravagantly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                        "entry_id": "7763e3c6-3870-3465-ae6f-70e63b847a98",
                                        "glosses": [
                                            "From the perspective of economics or an economy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312ca667-52d5-4f34-a6ef-24ecfbc95f6d",
                                                "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                                "text": "Kim Jong-il, who has died aged 69, was the general secretary of the Workers party of Korea, and head of the military in the Democratic People's Republic of Korea (DPRK). He was one of the most reclusive and widely condemned national leaders of the late 20th and early 21st century, leaving his country diplomatically isolated, economically broken and divided from South Korea."
                                            },
                                            {
                                                "example_id": "e13a950a-a5ff-46b7-9cb7-e0111efe5078",
                                                "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                                "text": "More than 40% of Dominicans are economically vulnerable and are at risk of falling into poverty due to climate-related impacts and economic crises, according to the World Bank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73805b68-77f5-363f-a0f8-bee2d3dcafee",
                                        "entry_id": "7763e3c6-3870-3465-ae6f-70e63b847a98",
                                        "glosses": [
                                            "According to divine economy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c6b083a-47e5-499a-a0c1-ea1adabce6d7",
                        "source_entry_id": "9da1f4a3-588d-3c7c-bcbc-b263bfb634e4",
                        "source_sense_id": "dd64f476-f098-310c-bd74-156caf4aa09a",
                        "target_lang_word": "grudgingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grudgingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                        "entry_id": "544607ff-509c-39b0-815b-199a5d9722c3",
                                        "glosses": [
                                            "In a manner expressing resentment or lack of desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e75de4-b010-460d-92df-af28275bda88",
                                                "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                                "text": "\"This is just a cover story,\" Clay says to O5-8, not taking his eyes off Marion. \"It's a good one, but she's had it worked out in advance.\"\n\"Clay, lose the piece,\" says the O5.\nGrudgingly, Clay does so."
                                            },
                                            {
                                                "example_id": "ed6ba33c-1345-4ed7-a56c-fd953b5d8580",
                                                "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                                "text": "I was left to play my part, grudgingly, in the eternal jugalbandi of tourist life: ‘Boat, sir?’ ‘No, thank you.’ ‘Rickshaw, sir?’ ‘No, thank you.’"
                                            },
                                            {
                                                "example_id": "ef8e39bd-e06d-48cb-81b5-f0da6c47484d",
                                                "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                                "text": "Online and over Shabbat dinners, arguments about the election have grown bitter. Those grudgingly planning to vote for Labour have been called traitors to the community and self-hating Jews. Anti-Corbyn die-hards, on the other hand, have been branded the handmaidens of a hard Brexit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
