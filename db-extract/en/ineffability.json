                "senses": [
                    {
                        "sense_id": "b4cbc6ba-8995-3618-9487-0f52cc8a6cce",
                        "entry_id": "deb882d1-a399-3437-bfce-b7ff67cee695",
                        "glosses": [
                            "The quality or state of being ineffable."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "23bb9bf7-ce22-41ec-9386-537866f2a70a",
                                "sense_id": "b4cbc6ba-8995-3618-9487-0f52cc8a6cce",
                                "text": "To him, the spirit lodged within Billy, and looking out from his welkin eyes as from windows, that ineffability it was which made the dimple in his dyed cheek, suppled his joints, and dancing in his yellow curls made him preeminently the Handsome Sailor."
                            },
                            {
                                "example_id": "b8cf7854-af5f-46d7-9aac-8ec5043fc410",
                                "sense_id": "b4cbc6ba-8995-3618-9487-0f52cc8a6cce",
                                "text": "But recently, physiological studies of ritual have suggested that the ineffability of intense emotional, transformative states may be due to the dominance of right brain activity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e86b77dd-9a86-480c-8a02-9351bd0734c7",
