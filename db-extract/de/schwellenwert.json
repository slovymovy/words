                                        "entry_id": "14c958de-0966-353b-ad4b-7abab6f24e20",
                                        "glosses": [
                                            "The lowermost part of a doorway that one crosses to enter; a sill."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f8786c9-83c6-381a-af6f-198007633514",
                                        "entry_id": "14c958de-0966-353b-ad4b-7abab6f24e20",
                                        "glosses": [
                                            "An entrance; the door or gate of a house."
                                        ],
                                        "tags": [
