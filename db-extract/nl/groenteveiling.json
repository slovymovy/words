                        "glosses": [
                            "een plaats waar groentes bij afslag verkocht worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d689a89-ef59-488a-b59b-380095591ea5",
                                "sense_id": "9da9978d-0b6f-32d1-add4-5cb5e481b8d7",
                                "text": "De afslagveiling heeft dit jaar een dubbel jubileum. 125 jaar geleden, op 29 juli, 1887, werd er bij Broek op Langedijk voor het eerst in Nederland een groenteveiling bij afslag gehouden. Een tuinder verkocht zo een lading bloemkool aan de hoogste bieder."
                            },
                            {
                                "example_id": "976bc02b-410a-4b51-9721-0ea16ec04bbb",
                                "sense_id": "9da9978d-0b6f-32d1-add4-5cb5e481b8d7",
                                "text": "De gevolgen van de Russische boycot zijn ook merkbaar op de groenteveiling in Zaltbommel. In een paar dagen zijn de prijzen gekelderd, zegt een handelaar. \"Ik loop hier al 55 jaar mee. Zo slecht heb ik het nog nooit meegemaakt.\""
                            }
                        ]
                    }
