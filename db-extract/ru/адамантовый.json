                        "form": "адама́нтова"
                    },
                    {
                        "form_id": "d1ec335d-f5f9-4c77-8f05-6930ff6b58de",
                        "entry_id": "f24eb8b5-54e5-361e-8bea-74629a85f45d",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "адама́нтовы"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6176d333-6e79-325a-a16c-24531a819439",
                        "entry_id": "f24eb8b5-54e5-361e-8bea-74629a85f45d",
                        "glosses": [
                            "устар., поэт. относящийся к адаманту, адамантам; сделанный или состоящий из адаманта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368488ce-364b-42d7-8dce-28b5256ce2d0",
                                "sense_id": "6176d333-6e79-325a-a16c-24531a819439",
                                "text": "Не рать его бесчисленная устрашала полки наши — его витязи, подобные столбам адамантовым, всегда были препоною победе."
                            }
                        ]
                    },
                    {
                        "sense_id": "90d3f8b5-aecd-3b4a-a672-c3611a14eca8",
                        "entry_id": "f24eb8b5-54e5-361e-8bea-74629a85f45d",
                        "glosses": [
                            "перен. очень прочный, твёрдый или имеющий очень высокое качество"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aa5c575-1553-4d72-9eca-c44cd8efc9c7",
                                "sense_id": "90d3f8b5-aecd-3b4a-a672-c3611a14eca8",
                                "text": "А это все были адамантовы крепкие истины."
                            },
                            {
                                "example_id": "6ab81f18-945e-4acf-bd0a-c31e3ff2405c",
                                "sense_id": "90d3f8b5-aecd-3b4a-a672-c3611a14eca8",
                                "text": "Не у всех дам герцогини были сердца адамантовые."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b7ef4bc-10a1-4615-9404-3d32377cf2dc",
                        "source_entry_id": "f24eb8b5-54e5-361e-8bea-74629a85f45d",
                        "target_lang_word": "adamantine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adamantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                        "entry_id": "50d90be4-5241-3256-b8c2-ff4c081eaef4",
                                        "glosses": [
                                            "Made of adamant, or having the qualities of adamant; incapable of being broken, dissolved, or penetrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6333bf0f-d76b-4458-9c29-bd7b64320257",
                                                "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                                "text": "adamantine bonds    adamantine chains"
                                            },
                                            {
                                                "example_id": "2722bf09-0835-4158-86f5-e60aeee7ec5a",
                                                "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                                "text": "[T]o a vviſe man there can happen no iniury or offence at all, to moleſt the felicity of his minde, vvhich (in the Stoicks opinion) ought to bee imperturbable, and his heart adamantine."
                                            },
                                            {
                                                "example_id": "dcadc86a-9eee-407e-8792-04c964a475d8",
                                                "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                                "text": "Him the Almighty Power / Hurld headlong flaming from th' Ethereal Skie / With hideous ruine and combustion down / To bottomless perdition, there to dwell / In Adamantine Chains and penal Fire, / Who durst defie th' Omnipotent to Arms."
                                            },
                                            {
                                                "example_id": "63bb65e8-098f-4380-9edf-08293cb059c4",
                                                "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                                "text": "Snatch, snatch those gentle forms from war's alarms, / And throw your adamantine shield around their shrinking charms."
                                            },
                                            {
                                                "example_id": "33beb5c9-53aa-4b9f-a9f5-3f74ff04ff92",
                                                "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                                "text": "For two hours they stand; Bouillé's sword glittering in his hand, adamantine resolution clouding his brows[.]"
                                            },
                                            {
                                                "example_id": "2abad0b8-8982-4833-a15f-4e9163eec367",
                                                "sense_id": "d2f943fd-51bc-3c53-87d5-0ccb3e31c827",
                                                "text": "1984, Gayle Rubin, \"Thinking Sex\" in Carole S. Vance, Pleasure and Danger: Exploring Female Sexuality (Boston: Routledge and Kegan Paul), 267-319.\nSex law is the most adamantine instrument of sexual stratification and erotic persecution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21356caf-c787-38cd-b39e-07514f4c0717",
                                        "entry_id": "50d90be4-5241-3256-b8c2-ff4c081eaef4",
                                        "glosses": [
                                            "Like the diamond in hardness or luster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "adamantine",
                                "target_lang_code": "en",
