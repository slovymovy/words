                ],
                "senses": [
                    {
                        "sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                        "entry_id": "8cef2467-ac5d-37cd-a4f7-20ec42da3c1b",
                        "glosses": [
                            "The activation of something previously inactive or inactivated."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0adf02f2-9a50-439d-8048-7518e1fffd5c",
                                "sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                                "text": "Perhaps most alarming, reports arrive each hour of reawakened Precursor artifacts, including orbital ribbons, star roads, planetary fortresses, and citadels. Combined defense forces are inadequate to investigate and confirm all instances of these reactivations. They appear to be galaxy-wide."
                            },
                            {
                                "example_id": "2ce22744-ca0c-4591-8c00-233b3b45c619",
                                "sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                                "text": "The link also requires reactivation between South Acton Junction and Old Kew Junction (Kew Bridge). Both currently have occasional empty stock workings and excursion traffic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6431c2b9-2acf-4880-8817-dcdd0693d981",
                        "source_entry_id": "8cef2467-ac5d-37cd-a4f7-20ec42da3c1b",
                        "source_sense_id": "14a04bca-650c-3b34-be1b-9b0b2958d42c",
                        "source_sense_description": "the activation of something previously inactive or inactivated",
                        "target_lang_word": "réactivation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réactivation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c1bd1cd-fb59-36fc-ac96-f93bf28c3cf2",
                                        "entry_id": "ac8b11b3-b7a3-3ae4-af5f-bf1d2c1a6ee2",
                                        "glosses": [
                                            "Action de réactiver, remise en route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ce2ffe-7233-43a8-9f1f-9e4018a2b585",
                                                "sense_id": "5c1bd1cd-fb59-36fc-ac96-f93bf28c3cf2",
                                                "text": "Vous pouvez demander la réactivation de votre compte utilisateur au webmestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbc9c5a8-0fb0-35ed-b6c8-050d9b8e3136",
                                        "entry_id": "ac8b11b3-b7a3-3ae4-af5f-bf1d2c1a6ee2",
                                        "glosses": [
                                            "Redonner vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e557178-f85b-4891-a052-ca181694b262",
                                                "sense_id": "fbc9c5a8-0fb0-35ed-b6c8-050d9b8e3136",
                                                "text": "Plusieurs de mes patients ont eu une réactivation importante de telles angoisses au moment des attentats du 11 septembre 2001."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6bf9d8d-7831-3ac4-a048-a0f74c925ced",
                                        "entry_id": "ac8b11b3-b7a3-3ae4-af5f-bf1d2c1a6ee2",
                                        "glosses": [
                                            "Action de faire ressurgir, de façon volontaire ou involontaire, des symptômes d’un trouble ou d’une maladie qui semblait en rémission ou en voie de guérison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7e6360-d9e9-4a59-a1c1-36a221631a3e",
                                                "sense_id": "b6bf9d8d-7831-3ac4-a048-a0f74c925ced",
                                                "text": "Les hospitalisations sans consentement et les mesures qui peuvent les accompagner, comme l’isolement et la contention, peuvent générer un nombre conséquent de troubles de stress post-traumatique et induire la réactivation d’événements traumatiques antérieurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
