                        "entry_id": "84ed1bae-770d-315e-a7fa-b764c86b26a9",
                        "glosses": [
                            "een ziektebeeld dat zich kan voordoen bij mensen die, na onder verhoogde luchtdruk te hebben gewerkt, weer in een omgeving met een lagere druk terugkomen, zoals duikers of mensen in een vliegtuig na een snelle decompressie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19ff0d41-87d6-4959-ad39-4a4348dcb9d1",
                                "sense_id": "6129111e-05bc-3133-9f7d-94b47f6903af",
                                "text": "De duikers die te lang en te diep onder water hebben gewerkt en te snel weer opstijgen krijgen de decompressieziekte."
                            },
                            {
                                "example_id": "d52b28d1-79aa-4cef-9d19-57de8f3f78c7",
                                "sense_id": "6129111e-05bc-3133-9f7d-94b47f6903af",
                                "text": "Als de luchtdruk plotseling wegvalt in een vliegtuig kunnen de passagiers decompressieziekte krijgen maar meestal is dat niet de doodsoorzaak."
                            }
                        ]
                    }
