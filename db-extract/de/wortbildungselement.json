                ],
                "senses": [
                    {
                        "sense_id": "7096f029-96cf-345a-845d-f9be08a42641",
                        "entry_id": "bd07af3f-ebe7-3fdf-801c-c9a444407def",
                        "glosses": [
                            "grammatische Einheit, die der Wortbildung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3389e8c0-414a-416e-b555-f26b954cbb45",
                                "sense_id": "7096f029-96cf-345a-845d-f9be08a42641",
                                "text": "„Aus diesem Grund haben wir die wichtigsten Wortbildungselemente in das Wörterbuch aufgenommen.“"
                            },
                            {
                                "example_id": "02c9e9ca-525a-4a3b-9b66-fe7af385b678",
                                "sense_id": "7096f029-96cf-345a-845d-f9be08a42641",
                                "text": "„Die gesonderte Lemmatisierung von gebundenen Wortbildungselementen ist nach wie vor problematisch.“"
                            },
                            {
                                "example_id": "312f7481-316f-45fc-ac6f-ffeff06d6c58",
                                "sense_id": "7096f029-96cf-345a-845d-f9be08a42641",
                                "text": "„Unsere Vorfahren haben dieses Wortbildungselement ohne besonderes Interesse über Jahrhunderte mitgeschleift, ehe es plötzlich ungeheuerlich produktiv wurde.“"
                            },
                            {
                                "example_id": "2ee24284-dac1-408f-b641-8a93de6ecb80",
                                "sense_id": "7096f029-96cf-345a-845d-f9be08a42641",
                                "text": "„Wie stark der Einfluss der französischen Sprache auf das Deutsche im 12. und 13. Jahrhundert war, können wir auch daran sehen, dass nicht nur Wörter übernommen worden sind, sondern sogar bestimmte Wortbildungselemente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
