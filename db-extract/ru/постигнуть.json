                "senses": [
                    {
                        "sense_id": "8f770650-892d-348d-ba47-ca93c192b3a3",
                        "entry_id": "45a3caa2-ffcd-3184-839c-83ba8f73eaf8",
                        "glosses": [
                            "понять, уяснить смысл, значение чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a2ff63-f2c1-4a3a-83e3-50d14b3df675",
                                "sense_id": "8f770650-892d-348d-ba47-ca93c192b3a3",
                                "text": "Он всё знает, он понял мир, понял Правила, постиг тайную связь событий, постиг законы сцепления миллионов обрывков разрозненных вещей!"
                            }
                        ]
                    },
                    {
                        "sense_id": "78fddf6c-a310-382a-a9aa-4d3beec81b8f",
                        "entry_id": "45a3caa2-ffcd-3184-839c-83ba8f73eaf8",
                        "glosses": [
                            "случиться с кем-либо, выпасть на долю кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce2353b9-144b-415d-96d8-333204c7ea37",
                                "sense_id": "78fddf6c-a310-382a-a9aa-4d3beec81b8f",
                                "text": "Я понимал, какая судьба их постигла, понимал, какая судьба постигла всех, кто остался на оккупированной территории."
                            }
                        ]
                    }
                ],
