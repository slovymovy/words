                                        "glosses": [
                                            "The wife of Nabal and later of David in the Old Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a62739-bfc3-410d-ac73-a18e35cf6f90",
                                                "sense_id": "2a15f06f-89cf-3c09-9731-abaeb73e2806",
                                                "text": "Now the name of the man was Nabal; and the name of his wife Abigail: and she was a woman of good understanding, and of beautiful countenance; but the man was churlish and evil in his doings."
                                            }
                                        ]
                                    },
