    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "834e26ff-caee-33a5-9283-9f79f4cb9300",
                    "sense_definition": "Ouvrir le ventre d'un animal ou d'une personne pour en extraire les viscères ou les entrailles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pêcheur <w>éventre</w> les poissons sur la table avant de les nettoyer à grande eau."
                        },
                        {
                            "text": "Après la chasse, il faut rapidement <w>éventrer</w> le gibier pour préserver la qualité de la viande."
                        }
                    ],
                    "synonyms": [
                        "éviscérer",
                        "éboyauter"
                    ],
                    "common_phrases": [
                        "éventrer le poisson",
                        "éventrer le gibier"
                    ]
                },
                {
                    "sense_id": "bbcff066-3d73-3563-9ebe-2babd3512db5",
                    "sense_definition": "Ouvrir de force un contenant ou une structure en le déchirant ou en y perçant une large ouverture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les cambrioleurs ont <w>éventré</w> le coffre en métal avec des outils lourds pour voler l'argent."
                        },
                        {
                            "text": "Le chien a <w>éventré</w> le sac poubelle et a éparpillé les déchets partout dans la cuisine."
                        }
                    ],
                    "common_phrases": [
                        "éventrer un sac",
                        "éventrer un colis"
                    ]
                },
                {
                    "sense_id": "b6879761-c4d9-3a61-80f1-01c4fbbb9fda",
                    "sense_definition": "Blesser grièvement en fendant ou en déchirant le ventre, particulièrement au moyen d'une arme ou d'une corne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le torero a été violemment <w>éventré</w> par le taureau furieux au cours de la corrida d'hier."
                        },
                        {
                            "text": "Le soldat fut grièvement <w>éventré</w> par un coup de baïonnette lors de l'assaut."
                        }
                    ],
                    "common_phrases": [
                        "éventré par un taureau",
                        "éventré d'un coup de baïonnette"
                    ]
                }
            ]
        }
    ]
}