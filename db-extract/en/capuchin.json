                        "entry_id": "3c4dea95-5452-3124-b91a-cd3ef0e8a969",
                        "glosses": [
                            "A monk in the Order of Friars Minor Capuchin; (generally) a Franciscan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ebe884-e527-419d-991f-de83025c9efe",
                                "sense_id": "f97c732d-d8f0-32cf-a53a-f535318edf67",
                                "text": "“That is something,” said the capuchin, “but not the most essential. Are you certain that he is a Christian?”"
                            }
                        ]
                    },
                    {
                        "sense_id": "98f6e91d-7741-3792-9edd-8eca2f64b5a9",
                        "entry_id": "3c4dea95-5452-3124-b91a-cd3ef0e8a969",
                        "glosses": [
                            "A garment consisting of a cloak and hood, made in imitation of the dress of Capuchin monks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f2c25b-b09a-4e69-bfa2-ea9bacbdd6b1",
                                "sense_id": "98f6e91d-7741-3792-9edd-8eca2f64b5a9",
                                "text": "Of Ermine is his doublet — / His Capuchin gay —"
                            }
                        ]
                    },
