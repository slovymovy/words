                                        "glosses": [
                                            "zur Signalübertragung zwischen Nervenzellen dienende Verbindung zweier Zellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd893d0-44e3-4da6-98b1-622095ce201c",
                                                "sense_id": "3cecc597-72be-326d-8339-f2fe41071e36",
                                                "text": "Die synaptische Plastizität, das heißt die ständige Anpassung der Synapsen in Abhängigkeit der elektrischen Aktivität der Zellen, ist eine Voraussetzung für die bis heute nur teilweise verstandenen komplexen Funktionen des Gehirns."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
