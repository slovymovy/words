                "senses": [
                    {
                        "sense_id": "c259763d-5bb7-3aa5-9dc3-ab2e21a82ac1",
                        "entry_id": "909e4557-9159-3dd1-a6c7-d5764880f8a5",
                        "glosses": [
                            "een tand uit de eerste set tijdelijke tanden van de mens en sommige andere dieren (zoals de hond of de koe), die na verloop van tijd worden vervangen door de permanente tanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d82f7f9-e63e-4ceb-b9f6-2fe6490c4352",
                                "sense_id": "c259763d-5bb7-3aa5-9dc3-ab2e21a82ac1",
                                "text": "Onder wat gunstiger omstandigheden had ik misschien nog een paar jaar thuis kunnen blijven, maar nu verliet ik ons huis met de helft van mijn melktanden nog in mijn mond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3576c35e-8851-4202-a194-23d6631e5ce0",
                        "source_entry_id": "909e4557-9159-3dd1-a6c7-d5764880f8a5",
                        "source_sense_id": "c259763d-5bb7-3aa5-9dc3-ab2e21a82ac1",
                        "source_sense_description": "een tand uit de eerste set tijdelijke tanden van de mens en sommige andere dieren (zoals de hond of de koe), die na verloop van tijd worden vervangen door de permanente tanden",
                        "target_lang_word": "Milchzahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchzahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e2637c7-2fa3-3f82-8466-9039d0322e9b",
                                        "entry_id": "7da1ec23-f7b7-31bc-ae7e-f3ab05129392",
                                        "glosses": [
                                            "Zahn im Milchgebiss; Zahn, der bei Menschen und einigen Säugetieren im Säuglingsalter wächst und später ausfällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5bef92-ae43-41f4-bd61-5153492ba2a0",
                                                "sense_id": "0e2637c7-2fa3-3f82-8466-9039d0322e9b",
                                                "text": "Es ist wichtig, Milchzähne ebenso gut zu pflegen wie die Bleibenden, da sonst Karies entsteht, die für Kinder nicht nur schmerzhaft ist, sondern auch die Dauerzähne schädigt."
                                            },
                                            {
                                                "example_id": "cdbbbeb7-22ff-4d37-b441-06b4810769ba",
                                                "sense_id": "0e2637c7-2fa3-3f82-8466-9039d0322e9b",
                                                "text": "„Das Milchgebiss besteht aus 20 Zähnen. Diese werden auch Milchzähne genannt.“"
                                            },
                                            {
                                                "example_id": "703540c8-6905-4dab-81e4-1ad7a3b476c9",
                                                "sense_id": "0e2637c7-2fa3-3f82-8466-9039d0322e9b",
                                                "text": "„Meist sind bis zum Alter von 2 1/2 Jahren alle Milchzähne durchgebrochen.“"
                                            },
                                            {
                                                "example_id": "936cce38-cac5-480f-b14a-aa973eeb48cd",
                                                "sense_id": "0e2637c7-2fa3-3f82-8466-9039d0322e9b",
                                                "text": "„Die Milchzähne sind die Platzhalter für das kommende \"richtige\" Gebiss - sie sollten genauso gut gepflegt werden.“"
                                            },
                                            {
                                                "example_id": "778ac287-0f1e-4729-9002-74ba5f2b4630",
                                                "sense_id": "0e2637c7-2fa3-3f82-8466-9039d0322e9b",
                                                "text": "„Oben wackelte ein Milchzahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
