        "nl-extract.jsonl": [
            {
                "entry_id": "791c34d9-393a-32fb-8ae9-cb3bc920fec4",
                "word": "uitmesten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30eff4cb-ef21-378d-a56a-6981d9900213",
                        "entry_id": "791c34d9-393a-32fb-8ae9-cb3bc920fec4",
                        "glosses": [
                            "het verwijderen van de uitwerpselen van vee uit een stal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8abc158-8d41-4bff-8615-bb93f6a96a0b",
                                "sense_id": "30eff4cb-ef21-378d-a56a-6981d9900213",
                                "text": "'Die hokken hebben de jongens zelf gemaakt', zegt ze, wijzend naar een groep van zes ex-verslaafde mannen die wat onzeker om de kalfjes heen staan. Een enkeling prikt met een riek in het stro. 'Nu zijn ze bezig met het uitmesten van de stallen en het voeren.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "6c068d86-37c7-35b8-91d8-68b46b5b0406",
                        "entry_id": "791c34d9-393a-32fb-8ae9-cb3bc920fec4",
                        "glosses": [
                            "iets schoonmaken wat wel heel erg vuil is ook in overdrachtelijke zin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070bda9b-4731-42d7-b7d5-5dbe25ccec5b",
                                "sense_id": "6c068d86-37c7-35b8-91d8-68b46b5b0406",
                                "text": "Volgens Babis spant een verdorven kliek van journalisten en politici samen om te verhinderen dat hij de post-communistische elite uitmest. Als iemand corruptie wil aanpakken, is hij het wel. Hij loopt het rijtje van Tsjechische machtspartijen af: allemaal raakten ze de afgelopen decennia aangetast door schandalen en foute deals met machtige zakenlui."
                            }
                        ]
                    },
                    {
                        "sense_id": "395fb06e-54c9-3706-b48f-5d2c942159a1",
                        "entry_id": "791c34d9-393a-32fb-8ae9-cb3bc920fec4",
                        "glosses": [
                            "leeg maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e807ee2b-6b31-426e-b179-e79320833707",
                                "sense_id": "395fb06e-54c9-3706-b48f-5d2c942159a1",
                                "text": "Birgit Schuurman is eens goed haar zolder gaan uitmesten en tijdens dat huiselijke klusje kwam er een saxofoon tevoorschijn. Volgens Schuurman is er geen groot talent aan haar verloren gegaan. \"Als ik sax wil bel ik Candy wel.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94756f27-864a-4482-a521-04766b2cee11",
                        "source_entry_id": "791c34d9-393a-32fb-8ae9-cb3bc920fec4",
                        "source_sense_id": "30eff4cb-ef21-378d-a56a-6981d9900213",
                        "source_sense_description": "verwijderen van mest",
                        "target_lang_word": "dung removal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ec662a13-19d0-4a96-9023-0a2b635b7340",
                        "source_entry_id": "791c34d9-393a-32fb-8ae9-cb3bc920fec4",
                        "source_sense_id": "6c068d86-37c7-35b8-91d8-68b46b5b0406",
                        "source_sense_description": "schoonmaken",
                        "target_lang_word": "clean up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clean up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "550efe2c-9507-3cb4-b2f5-37b2a4e7c824",
                                        "entry_id": "85b2499d-147d-31b2-b75a-1bae27777c83",
                                        "glosses": [
                                            "To make an area or a thing clean; to pick up a mess; to tidy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a958b5-1921-4a60-852d-f159e670d1ba",
                                                "sense_id": "550efe2c-9507-3cb4-b2f5-37b2a4e7c824",
                                                "text": "Rhos station had been cleaned up for the occasion, and its single platform was gay with flags."
                                            },
                                            {
                                                "example_id": "1ebad521-2a39-47f7-9027-632ed22f33ae",
                                                "sense_id": "550efe2c-9507-3cb4-b2f5-37b2a4e7c824",
                                                "text": "Mr Mayor, you were elected in a campaign to clean up the city. When are you gonna start?"
                                            },
                                            {
                                                "example_id": "fddb0dfd-9972-4b9e-888c-70ff40976ded",
                                                "sense_id": "550efe2c-9507-3cb4-b2f5-37b2a4e7c824",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            },
                                            {
                                                "example_id": "92e8b8e3-10d0-4248-8e50-37d0e308da65",
                                                "sense_id": "550efe2c-9507-3cb4-b2f5-37b2a4e7c824",
                                                "text": "Clean up your room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47eb1ef3-19fe-36c7-b829-2ad47804ad7b",
                                        "entry_id": "85b2499d-147d-31b2-b75a-1bae27777c83",
                                        "glosses": [
                                            "To become clean, handsome, smart in appearance, e.g. for a special occasion, especially when it is out of character to be seen as such."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c6775e-e599-433d-8f7c-815215b262a2",
                                                "sense_id": "47eb1ef3-19fe-36c7-b829-2ad47804ad7b",
                                                "text": "He sure cleans up nice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d4f88c0-c83e-39f5-9c0f-daa971eca973",
                                        "entry_id": "85b2499d-147d-31b2-b75a-1bae27777c83",
                                        "glosses": [
                                            "To make something less corrupt or unseemly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "995bdfee-fd99-4e4f-b63c-f5720e35b5cb",
                                                "sense_id": "2d4f88c0-c83e-39f5-9c0f-daa971eca973",
                                                "text": "clean up one's act"
                                            },
                                            {
                                                "example_id": "08ced98c-aa8c-47ec-91ee-5565d0bd7e34",
                                                "sense_id": "2d4f88c0-c83e-39f5-9c0f-daa971eca973",
                                                "text": "Gays in Providence have suggested that the raid on the Club Baths was a political action. There is some belief that the newly re-elected Cianci administration wants to prove that it is \"out to clean up the city.\" During the election campaign, the Cianci administration was attacked by opponents as being \"soft on crime.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56aa6f75-6299-317e-8cf7-dd0fa97ef3f3",
                                        "entry_id": "85b2499d-147d-31b2-b75a-1bae27777c83",
                                        "glosses": [
                                            "To make a large profit; to win by a large margin, or to win a large amount, especially in gambling. Also clean house."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b5ecc9-8943-4aae-9ec4-2658f8a39418",
                                                "sense_id": "56aa6f75-6299-317e-8cf7-dd0fa97ef3f3",
                                                "text": "Man, he sure cleaned up last night at the blackjack table."
                                            },
                                            {
                                                "example_id": "318a674a-18dd-4727-a325-4eab13f14b1d",
                                                "sense_id": "56aa6f75-6299-317e-8cf7-dd0fa97ef3f3",
                                                "text": "The investors cleaned up when the stock hit the roof last year."
                                            },
                                            {
                                                "example_id": "e2e9b683-d17a-40c1-b8ff-4e932ba168a4",
                                                "sense_id": "56aa6f75-6299-317e-8cf7-dd0fa97ef3f3",
                                                "text": "And for Rodgers, who cleaned up with Celtic in Scotland, this was another significant addition to his CV, as his expert guidance of Leicester - who are in a strong position to finish in the Premier League's top four and face Chelsea again at Stamford Bridge on Tuesday - now has a tangible reward in the shape of the FA Cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6705f8-70a3-3e7f-a164-5062bd4c7bc5",
                                        "entry_id": "85b2499d-147d-31b2-b75a-1bae27777c83",
                                        "glosses": [
                                            "To intervene in a fight between two players at low health and easily kill both of them or the winner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6421fe71-7c3d-4ce5-9639-c86d764c9a1f",
                                                "sense_id": "ca6705f8-70a3-3e7f-a164-5062bd4c7bc5",
                                                "text": "The key here is to stop third partying and start cleaning up. Running to the first bullets you hear will only guarantee one thing, a fight. […] Cleaning up means only swooping in for the free kills. Is a fight over? Does Octane has his hands in a deathbox? That is when you take the zipline and catch them with their pants down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clean up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4af01a0-4b8e-329d-a30f-4e1def050cec",
