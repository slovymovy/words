                "senses": [
                    {
                        "sense_id": "515ebba8-50d2-302c-820f-7255f7d65985",
                        "entry_id": "88889516-8d06-3e02-8f4d-cb2ef3de474a",
                        "glosses": [
                            "разг. сгрести что-либо вокруг, подобрав это"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94bb08c8-a45e-47bb-bd87-67e270e1366c",
                                "sense_id": "515ebba8-50d2-302c-820f-7255f7d65985",
                                "text": "Огрести́ осыпавшиеся колосья."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f86795b-5cac-3bc4-83d5-2d92c107e785",
                        "entry_id": "88889516-8d06-3e02-8f4d-cb2ef3de474a",
                        "glosses": [
                            "перен., прост., сниж., неодобр. получить что-либо (обычно деньги) в большом количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8eb53f-6d00-42e4-9a16-2917f0508763",
                                "sense_id": "9f86795b-5cac-3bc4-83d5-2d92c107e785",
                                "text": "Огрести́ кучу денег. Огрести́ целый капитал."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e8e37f1-5781-3994-aa9d-544c8da83c1e",
                        "entry_id": "88889516-8d06-3e02-8f4d-cb2ef3de474a",
                        "glosses": [
                            "перен., прост., сниж., неодобр. получить серьёзный урон, понести суровое наказание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fdc21e-59f8-42c9-8e7f-0ce04a741bcc",
                                "sense_id": "1e8e37f1-5781-3994-aa9d-544c8da83c1e",
                                "text": "И, если чувак окажется не в духе, у меня есть хороший шанс огрести по полной за то, что его план чуть не сорвался"
                            }
                        ]
                    }
