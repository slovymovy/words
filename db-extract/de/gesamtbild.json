                    {
                        "form_id": "28bde20d-dc5e-41dd-a7da-347be26ece50",
                        "entry_id": "e7feaed4-2b67-30a8-8112-58c435306d91",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gesamtbild"
                    },
                    {
                        "form_id": "57f1af9e-ef7e-4066-bfd3-e75788ca01bc",
                        "entry_id": "e7feaed4-2b67-30a8-8112-58c435306d91",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gesamtbilder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a84a966f-9c22-3918-ad85-b2bd8a93f17d",
                        "entry_id": "e7feaed4-2b67-30a8-8112-58c435306d91",
                        "glosses": [
                            "ein Bild als Ganzes, mit allen seinen Teilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b2884f0-8481-4168-905e-158d05130eb3",
                                "sense_id": "a84a966f-9c22-3918-ad85-b2bd8a93f17d",
                                "text": "„Aus den Einzelbildern werden dann computergesteuert dreidimensionale Gesamtbilder und vor allem Filme zusammengesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f36c91e1-4621-33da-b177-98670ece5020",
                        "entry_id": "e7feaed4-2b67-30a8-8112-58c435306d91",
                        "glosses": [
                            "Eindruck, den man von jemandem/etwas insgesamt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2c792a-f2c9-4769-9a09-9fede69744e8",
                                "sense_id": "f36c91e1-4621-33da-b177-98670ece5020",
                                "text": "„Ob das Parfum schlussendlich frisch, blumig, schwer oder fruchtig duftet, tut nichts zur Sache, wenn es nur zu einem perfekten Gesamtbild führt.“"
                            },
                            {
                                "example_id": "53f84903-173f-4fe0-b6ad-f85df88c1d5f",
                                "sense_id": "f36c91e1-4621-33da-b177-98670ece5020",
                                "text": "Die Informationen aus verschiedenen Quellen ergaben ein unerwartet klares Gesamtbild der Ereignisse."
                            },
                            {
                                "example_id": "bde1ca35-55ae-4bac-9fa4-36e075e418f4",
                                "sense_id": "f36c91e1-4621-33da-b177-98670ece5020",
                                "text": "„Dennoch ergab alles ein schönes Gesamtbild, und von der Stadt strahlte Wärme aus, die das unzuverlässige Wetter wieder aufwog.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f259574-b148-4c30-872e-619c18c559eb",
                        "source_entry_id": "e7feaed4-2b67-30a8-8112-58c435306d91",
                        "source_sense_id": "a84a966f-9c22-3918-ad85-b2bd8a93f17d",
                        "source_sense_description": "ein Bild als Ganzes, mit allen seinen Teilen",
                        "target_lang_word": "big picture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "big picture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f87506-6a50-3442-8cd0-7f7c28e9f627",
                                        "entry_id": "535e4b4f-48fe-3073-a297-5a3ca6c8fc05",
                                        "glosses": [
                                            "The totality of a situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad3d429-b07b-406c-bb24-6e1ac7ac3cc0",
                                                "sense_id": "d9f87506-6a50-3442-8cd0-7f7c28e9f627",
                                                "text": "I do not care whether it is placed or not, if I get my stuff to that ship. Now, it is my job to look at the big picture."
                                            },
                                            {
                                                "example_id": "6dd46740-449f-4978-9aa4-f4c81c7d9329",
                                                "sense_id": "d9f87506-6a50-3442-8cd0-7f7c28e9f627",
                                                "text": "We need somebody who will overlook the petty details, look at the big picture, decide what is necessary to end the war, make a plan,"
                                            },
                                            {
                                                "example_id": "72237450-28c9-444c-b0dd-1bbfe2a28839",
                                                "sense_id": "d9f87506-6a50-3442-8cd0-7f7c28e9f627",
                                                "text": "I met an executive from Missouri who turned around a failing plant by sharing information with employees about the company's performance. When the employees understood the big picture, they did even better at their jobs."
                                            },
                                            {
                                                "example_id": "8239df47-a80c-49a7-828a-c8a05238084f",
                                                "sense_id": "d9f87506-6a50-3442-8cd0-7f7c28e9f627",
                                                "text": "In the prewedding whirlwind of bridal showers, dress shopping, and parties, even the most budget savvy bridesmaids can overspend by mistake. Because the events span several months, it can be easy to lose track of the big picture and splurge at each event."
                                            },
                                            {
                                                "example_id": "6038094d-7965-4807-ae3c-e63581759782",
                                                "sense_id": "d9f87506-6a50-3442-8cd0-7f7c28e9f627",
                                                "text": "Having laid out these big-picture figures, the report then begins its analysis of traffic types against route mileage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aade4d0-2e26-38d8-964c-3ca1d7839b48",
                                        "entry_id": "535e4b4f-48fe-3073-a297-5a3ca6c8fc05",
                                        "glosses": [
                                            "The main film in a double feature."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdc2f525-05b8-3eb0-ba89-9355fe616e4f",
                                        "entry_id": "535e4b4f-48fe-3073-a297-5a3ca6c8fc05",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see big, picture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
