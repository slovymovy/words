                        "examples": [
                            {
                                "example_id": "ed3f090f-edbf-4403-8174-f369d1a999b0",
                                "sense_id": "2c43ee14-a1f6-3356-b085-cf223b970e68",
                                "text": "On the summit of a hill they were seen by my fathers, my countrymen, on the top of the hill they were seen standing: they threw fire like a star,—it fell amongst the blackmen my countrymen."
                            },
                            {
                                "example_id": "576675be-0502-457b-a5a5-64fc90f410f7",
                                "sense_id": "2c43ee14-a1f6-3356-b085-cf223b970e68",
                                "text": "“Recognised and compensated,” will both these condition[s] be occupied by the blackman in the world forty years hence?"
                            },
                            {
                                "example_id": "e7736267-89f1-43a3-9817-4d43e9391c47",
                                "sense_id": "2c43ee14-a1f6-3356-b085-cf223b970e68",
                                "text": "Australia’s true history is never read, But the blackman keeps it in his head."
                            },
                            {
                                "example_id": "2b35abe3-1ed4-400f-8689-56c275934b2c",
                                "sense_id": "2c43ee14-a1f6-3356-b085-cf223b970e68",
                                "text": "It is nearly a century since DuBois described the condition of the blackman thus […]"
                            }
                        ]
                    }
