                        "entry_id": "8409728f-f2cd-35ef-a7da-8c6bbef6d256",
                        "glosses": [
                            "A scientist (often a medical doctor) who specializes in epidemiology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1e8ded-0aaf-4ab4-be8d-4128f811fb59",
                                "sense_id": "38fc93fe-686d-3e1a-a890-0f1814de4ba5",
                                "text": "In his first book since the 2008 essay collection Natural Acts: A Sidelong View of Science and Nature, David Quammen looks at the natural world from yet another angle: the search for the next human pandemic, what epidemiologists call “the next big one.”"
                            },
                            {
                                "example_id": "47318b92-aa8e-471e-ad05-532efd3b21dd",
                                "sense_id": "38fc93fe-686d-3e1a-a890-0f1814de4ba5",
                                "text": "“On the inside, it’s absolute chaos,” said one epidemiologist still employed at the CDC."
                            }
                        ]
                    }
                ],
                "translations": [
