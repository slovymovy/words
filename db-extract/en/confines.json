                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31509577-fbcc-4bb0-8816-042fe20e6a89",
                        "source_entry_id": "3189d3c5-00db-39c7-baa6-76fb01abea16",
                        "source_sense_description": "borders or limits of an area",
                        "target_lang_word": "confins",
