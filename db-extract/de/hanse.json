                "senses": [
                    {
                        "sense_id": "12bfa8a2-2488-3e55-a76a-aac61080e3b2",
                        "entry_id": "637e6762-8dab-3e4d-80fd-8c694f26fa74",
                        "glosses": [
                            "Bund deutscher Städte im Mittelalter zur Förderung ihrer Interessen, vor allem des Handels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54ec7f2f-0158-4da3-8e52-f0a54839a289",
                                "sense_id": "12bfa8a2-2488-3e55-a76a-aac61080e3b2",
                                "text": "Die Hanse war vor allem im Ostseeraum aktiv."
                            },
                            {
                                "example_id": "87209112-942d-420f-8dba-a1308279104a",
                                "sense_id": "12bfa8a2-2488-3e55-a76a-aac61080e3b2",
                                "text": "Die Blütezeit der Hanse begann in der zweiten Hälfte des 14. und endete im 15. Jahrhundert."
                            },
                            {
                                "example_id": "e1f3847f-2dc9-4b63-b5e1-53784c2bf75d",
                                "sense_id": "12bfa8a2-2488-3e55-a76a-aac61080e3b2",
                                "text": "„Sie essen überhaupt gut bei der Hanse und trinken behaglich den warmen südlichen Rotspon wie das eigene kühle Bier.“"
                            },
                            {
                                "example_id": "76a96faf-10c5-4716-8d7b-466101160ff9",
                                "sense_id": "12bfa8a2-2488-3e55-a76a-aac61080e3b2",
                                "text": "„Die Hanse hatte sogar beliebtes Fastfood à la McDonald's im Angebot: den Stockfisch.“"
                            },
                            {
                                "example_id": "d458c56d-15e7-4086-94c2-16a1d5e8623c",
                                "sense_id": "12bfa8a2-2488-3e55-a76a-aac61080e3b2",
                                "text": "„Zu den Gegnern der aufsteigenden Handelshäuser gehörte die Hanse, deren ökonomische und politische Macht seit Längerem im Niedergang begriffen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
