                        "target_lang_word": "ouah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39aeb404-dbc2-3cf2-996c-cab454551fe9",
                                        "entry_id": "edd85ebe-4715-307b-b288-38b894d9fa38",
                                        "glosses": [
                                            "Exprime la surprise, le contentement, l'admiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f239663b-797b-4d26-b83a-47da91cdc357",
                                                "sense_id": "39aeb404-dbc2-3cf2-996c-cab454551fe9",
                                                "text": "Ouah ! Super idée !"
                                            },
                                            {
                                                "example_id": "79182cd8-6024-45a6-85e7-65ca8c581c0b",
                                                "sense_id": "39aeb404-dbc2-3cf2-996c-cab454551fe9",
                                                "text": "— Oh ! cette femme-là !… Ouah !… ah ! là ! là !…"
                                            },
                                            {
                                                "example_id": "e5a6d0a8-2f96-4967-a0a5-3bc89a023980",
                                                "sense_id": "39aeb404-dbc2-3cf2-996c-cab454551fe9",
                                                "text": "Ouah ! s'exclame Derek, les yeux brillants. Vous assurez grave !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ouah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "614b7edf-c465-3ba2-b0ce-648c0a05f4f9",
                                        "entry_id": "5af48bb7-2374-3d7a-ba0f-abffbbef2119",
                                        "glosses": [
                                            "Exprime le cri du chien ; bruit de l’aboiement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81be5bc0-70f0-4f4c-90f7-87eaf5b591cd",
                                                "sense_id": "614b7edf-c465-3ba2-b0ce-648c0a05f4f9",
                                                "text": "Les sabots joints sur ce perchoir, le bouqueton était en train de croquer un morceau d'écorce, lorsqu’un petit aboiement, un ouah grêle et demi-étouffé, le fit sauter à terre."
                                            },
                                            {
                                                "example_id": "21323909-6609-40be-a2aa-e041c38d9644",
                                                "sense_id": "614b7edf-c465-3ba2-b0ce-648c0a05f4f9",
                                                "text": "Je n'ai que de la haine à lui donner : brûlures, escarres, claques et claques et claques encore, coups de fouet, coups de latte. Mon rêve le plus fou ? Faire de lui un chien. Un clébard ! Ouah ! Ouah !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
