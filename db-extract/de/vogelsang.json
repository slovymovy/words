                        ],
                        "examples": [
                            {
                                "example_id": "c8ec320d-80f9-4557-905b-2ac78d4efbb2",
                                "sense_id": "18675afe-7d72-3bd3-a6a4-af5686471c32",
                                "text": "Wohin auch das Auge blicket, / Moor und Heide nur ringsum. / Vogelsang uns nicht erquicket, / Eichen stehen kahl und krumm.",
                                "translation": "Wherever the eye may gaze, / Bog and heath all around. / No birdsong invigorates us, / Oaks are standing bare and crooked.",
                                "english": "Wherever the eye may gaze, / Bog and heath all around. / No birdsong invigorates us, / Oaks are standing bare and crooked."
                            }
                        ]
