                "senses": [
                    {
                        "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                        "entry_id": "26ba5bfb-be51-33e4-8ef6-a1a442bb0e8b",
                        "glosses": [
                            "die Jahre 00 bis 09 des gegenwärtigen oder besagten Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1d7e0e-f23a-4bea-b1ff-0638ffe794d8",
                                "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                                "text": "Die Nullerjahre des 20. Jahrhunderts brachten die Relativitätstheorie von Einstein."
                            },
                            {
                                "example_id": "64a4f1c9-2ccd-47a3-b779-bb608945fc43",
                                "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                                "text": "„Mitte der Nullerjahre, als Palmer Luckey ein Teenager war, glaubte kaum jemand an ein Comeback der Computerbrillen.“"
                            },
                            {
                                "example_id": "e9553ae4-1700-4c4f-855b-fdb50edd45bb",
                                "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                                "text": "„Als wir das erste Mal nach Köln kamen, am Anfang der Nullerjahre, liebten wir die Stadt sofort, ihre lebhafte und launische Seite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75214e0f-b498-4a00-8ae7-298a39ee01d4",
                        "source_entry_id": "26ba5bfb-be51-33e4-8ef6-a1a442bb0e8b",
                        "source_sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                        "source_sense_description": "die Jahre 00 bis 09 des gegenwärtigen oder besagten Jahrhunderts",
                        "target_lang_word": "aughts",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aughts",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90493b2c-7376-3c20-ae17-08b529ff26ba",
                                        "entry_id": "802a99f0-d5dc-35be-8521-60cad8c1d302",
                                        "glosses": [
                                            "The first decade of a century, such as 1900 to 1909 or 2000 to 2009, whose digit in the tens place is zero; the noughties."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9219c7-b5ee-411f-93fe-693622f29df8",
                                                "sense_id": "90493b2c-7376-3c20-ae17-08b529ff26ba",
                                                "text": "The 20th Century’s Aughts and Teens: OPERETTA [chapter title]"
                                            },
                                            {
                                                "example_id": "51e36e24-8eff-4411-94e7-60936d1b054e",
                                                "sense_id": "90493b2c-7376-3c20-ae17-08b529ff26ba",
                                                "text": "When the staccato, Neptunes-ian single “Boyfriend” was released in March, musical prognosticators were quick to peg the album it portended, Believe, as Justin Bieber’s Justified, a grown-and-sexy, R&B-centric departure that evolved millennial teenybopper Justin Timberlake into one of the unifying pop-music figures of the aughts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aughts",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390411e1-8c59-3c79-a4ad-ae8ce9cffa91",
                                        "entry_id": "8113ef38-ef34-31f3-b56a-7d66fb3ab781",
                                        "glosses": [
                                            "From or evoking the first through tenth years of a century (chiefly the 2000s)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5b6734-476a-492f-9e7b-fa065ea762ce",
                                                "sense_id": "390411e1-8c59-3c79-a4ad-ae8ce9cffa91",
                                                "text": "Dialup internet is so aughts."
                                            },
                                            {
                                                "example_id": "3a97413d-6d11-4513-a8f6-3f0840ac9952",
                                                "sense_id": "390411e1-8c59-3c79-a4ad-ae8ce9cffa91",
                                                "text": "Meyer and his team collected the participants in a very aughts way — through Craigslist."
                                            },
                                            {
                                                "example_id": "5e443c65-7845-49ff-ab7d-9c65ae5c62da",
                                                "sense_id": "390411e1-8c59-3c79-a4ad-ae8ce9cffa91",
                                                "text": "He's testing out new experiments with knotting and macramé too, tying up dresses and trousers for a look that feels very aughts—and very now."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f151b28-555a-48e0-bbd9-9bb3035d5016",
                        "source_entry_id": "26ba5bfb-be51-33e4-8ef6-a1a442bb0e8b",
                        "source_sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                        "source_sense_description": "die Jahre 00 bis 09 des gegenwärtigen oder besagten Jahrhunderts",
                        "target_lang_word": "noughties",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noughties",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                        "entry_id": "4b7fb802-1675-30aa-a292-1933377dceea",
                                        "glosses": [
                                            "The decade consisting of the last year of the previous century and the first nine years of the next: from 1900 to 1909, 2000 to 2009, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "capitalized",
                                            "plural",
                                            "plural-only",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf54511-520d-4296-868d-67fb770ce7b5",
                                                "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                                "text": "Our readers — and contributors — are apt to elect a good deal according to years. The seventies and eighties, we may suppose, are concerned for the large educational and cultural interests of their Alma Mater; the nineties are deep in the practical and business activities; the noughties are not naughty, but still young enough to sport a fantastic costume at reunion and let the college wag as it will; the oneties are the really wise as to what the college ought to be, especially on its athletic side, but as contributors modest."
                                            },
                                            {
                                                "example_id": "c372d49c-c691-4d89-a871-2f4f9136c662",
                                                "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                                "text": "I doubt if any modern poet can boast of as loud acclaim or as liberal reward as Longfellow received for Evangeline or Tennyson for the Idylls, but his fate today is somewhat kinder than that of Poe or Whitman, and much gentler than the stony dole dealt out to poets in the nineties and noughties."
                                            },
                                            {
                                                "example_id": "7fd7dc0e-d5dc-450b-af36-4d5b9995eb69",
                                                "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                                "text": "During the Naughty Noughties, Jim was worth between ten and twelve million dollars and his income was more than even he could reasonably spend."
                                            },
                                            {
                                                "example_id": "1f98f76b-bd07-4912-bc7e-be8f8fb08cbe",
                                                "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                                "text": "Every young woman with \"advanced\" ideas must live in Paris during the decade of the \"noughties,\" as they were dubbed by some wit."
                                            },
                                            {
                                                "example_id": "bb1311b4-ae18-442d-82d8-c3fa76c3964e",
                                                "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                                "text": "An obsession with designer handbags, at ever-spiralling prices, became a phenomenon of the mid-noughties, driven principally by Louis Vuitton."
                                            },
                                            {
                                                "example_id": "64ef3182-8dd2-4930-bb83-dcd5eb66a984",
                                                "sense_id": "c9d71c80-bcfe-3dda-9f23-a2ffcf8262be",
                                                "text": "The noughties are the bridge between the pre-internet era, and the life we live now."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
