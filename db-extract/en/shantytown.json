                    },
                    {
                        "translation_id": "8d611300-1aef-470b-88a4-7d95631a8773",
                        "source_entry_id": "87e2cc41-e2ab-3324-9995-c4baeb932438",
                        "source_sense_id": "2a10f8fb-795b-3fcd-954e-48e9e694af87",
