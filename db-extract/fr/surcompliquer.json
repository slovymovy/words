                "senses": [
                    {
                        "sense_id": "283874fa-86ad-34b7-ac1e-fb81350e8f1a",
                        "entry_id": "d725b3b0-f9ea-3a2d-a04c-6d8d9f838434",
                        "glosses": [
                            "Compliquer de façon vraiment excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82e1578-8595-4b66-bdd5-bb940196f62d",
                                "sense_id": "283874fa-86ad-34b7-ac1e-fb81350e8f1a",
                                "text": "Au fond parfois, il est inutile de surcompliquer une histoire ou de lui donner une autre allure."
                            },
                            {
                                "example_id": "230fbab5-b027-413e-aa18-4c5cd4f6aa55",
                                "sense_id": "283874fa-86ad-34b7-ac1e-fb81350e8f1a",
                                "text": "Il est facile de tomber dans le panneau et de surcompliquer les choses à en perdre l'essentiel."
                            },
                            {
                                "example_id": "a435bea3-b6d6-4a70-8b03-164fb465dd21",
                                "sense_id": "283874fa-86ad-34b7-ac1e-fb81350e8f1a",
                                "text": "Mais faut arrêter de surcompliquer tout par pitié"
                            }
                        ]
                    }
