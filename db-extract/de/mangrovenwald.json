                ],
                "senses": [
                    {
                        "sense_id": "227914c9-aded-3b27-a207-2f1b017757a4",
                        "entry_id": "c1c1931e-3777-3354-8085-eef545d5ee1b",
                        "glosses": [
                            "von vielen sogenannten Mangroven bewachsene Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96aa16cc-4d7d-4f2d-b784-12af5dbbb807",
                                "sense_id": "227914c9-aded-3b27-a207-2f1b017757a4",
                                "text": "„In den Tropen werden für Aquakulturen vielerorts die Mangrovenwälder der Küste, ein wichtiger Schutz vor Überschwemmungen, zerstört.“"
                            },
                            {
                                "example_id": "09a2f1c6-fd18-445b-a8c6-cdb6d049e2f1",
                                "sense_id": "227914c9-aded-3b27-a207-2f1b017757a4",
                                "text": "„Endlich erreichten wir das Sine-Saloum-Delta und wurden mit einer Piroge durch schmale Flussläufe entlang der Mangrovenwälder, in denen Affen herumturnten, zu unserem Camp gebracht.“"
                            },
                            {
                                "example_id": "fca06e8b-6e77-4102-8fc6-40aa6b094440",
                                "sense_id": "227914c9-aded-3b27-a207-2f1b017757a4",
                                "text": "„Im Süden verzweigt sich der Indus in einem Delta mit Mangrovenwäldern, bevor er den Indischen Ozean erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
