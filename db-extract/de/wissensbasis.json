                "senses": [
                    {
                        "sense_id": "2608c1ab-53b8-3387-996b-be2e1aa91087",
                        "entry_id": "2f56a2a6-2a4d-306e-b1ae-0bb6a3aba4c6",
                        "glosses": [
                            "Die Basis zu einem umfangreichen Wissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f93e56d-5aaf-499c-a06f-65d2231823fa",
                                "sense_id": "2608c1ab-53b8-3387-996b-be2e1aa91087",
                                "text": "„Diese verfügten nämlich nicht über diese neue Wissensbasis, die um die Wende vom 19. zum 20. Jahrhundert die moderne Kriminologie begründet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43ddd334-20f5-3612-b4b9-78629441336e",
                        "entry_id": "2f56a2a6-2a4d-306e-b1ae-0bb6a3aba4c6",
                        "glosses": [
                            "eine Wissensdatenbank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54540fe6-ed5d-4fa4-9a0c-9caf417fc349",
                                "sense_id": "43ddd334-20f5-3612-b4b9-78629441336e",
                                "text": "„Und so ist Stach gezwungen, im neusten Band auf \"einer Wissensbasis\" zu arbeiten, die er früher als \"unverantwortlich\" und \"wenig motivierend\" bezeichnet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
