                        "form_id": "34dbb1e3-fe18-46d8-9c83-96670746b976",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more notional"
                    },
                    {
                        "form_id": "3883242c-8511-45fa-80ef-59d4a7ec8cd8",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most notional"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e39654f0-bdc9-3852-b8aa-43168a8d3c02",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "glosses": [
                            "Of, containing, or being a notion; mental or imaginary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c0ebd8-a65c-4372-8414-261ca2981339",
                                "sense_id": "e39654f0-bdc9-3852-b8aa-43168a8d3c02",
                                "text": "Near-synonyms: conceptual, fancied, fanciful, ideal"
                            },
                            {
                                "example_id": "cf239d2a-c505-4c3f-80f7-9ea1d7187624",
                                "sense_id": "e39654f0-bdc9-3852-b8aa-43168a8d3c02",
                                "text": "The idea that a rooster says cock-a-doodle-doo rather than ooh ooh-ooh ooh-ooh is socially conventional even though its sound correspondence is at heart notional."
                            },
                            {
                                "example_id": "fc92e1fe-db30-418e-af42-f1f5f32935fb",
                                "sense_id": "e39654f0-bdc9-3852-b8aa-43168a8d3c02",
                                "text": "He was now receiving reports of a second suspect Anglo Leasing deal, this time for the notional provision of a state-of-the-art police forensic laboratory."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5165495-b469-32e9-90cc-eafb781cd418",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "glosses": [
                            "Speculative, theoretical, not the result of research."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e1cc70-e317-4c03-83ce-fe1b6403a06e",
                                "sense_id": "b5165495-b469-32e9-90cc-eafb781cd418",
                                "text": "This paper proposes a notional Federated Identity Management (FIM) architecture."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa054567-79f8-3467-8e12-7739ec1b428f",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "glosses": [
                            "Stubborn."
                        ],
                        "tags": [
                            "Maine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "47364102-e706-3f08-8e46-aa74c028d996",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "glosses": [
                            "Having descriptive value as opposed to a syntactic category."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "81ac5f96-325e-35d0-bee2-c90f3e6cb712",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "glosses": [
                            "Used to indicate an estimate or a reference amount"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a792be3-3c77-47a6-8268-fbc130ed7315",
                                "sense_id": "81ac5f96-325e-35d0-bee2-c90f3e6cb712",
                                "text": "Gold traded at $909.00 an ounce, up 0.2 percent from New York's notional close of $906.65 on Wednesday."
                            },
                            {
                                "example_id": "8396da7a-47e4-439c-8979-ae4b861bc780",
                                "sense_id": "81ac5f96-325e-35d0-bee2-c90f3e6cb712",
                                "text": "Under the agreements, Harvard paid the banks fixed interest rates on a total notional amount of $3.52 billion in exchange for floating-rate payments from them."
                            }
                        ]
                    },
                    {
                        "sense_id": "63550b8b-a5e7-386f-87bc-49dfa65015bb",
                        "entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "glosses": [
                            "Full of ideas or imaginings."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "98eed2cf-7eeb-41f5-8681-dcff79f72c17",
                                "sense_id": "63550b8b-a5e7-386f-87bc-49dfa65015bb",
                                "text": "She knew what Pete would say if she told him about it — he would say she was getting notional; and she did not want Pete to think of her as a notional woman. Notional women sometimes had a hard time marrying unless they had money."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88b9625d-2095-4670-8e45-2bd171327984",
                        "source_entry_id": "1cd44661-172c-3412-bdd0-591bb7e44a99",
                        "source_sense_description": "of, containing, or being a notion",
                        "target_lang_word": "notionnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01ed794b-eead-3aac-9ed3-468808592fa4",
                                        "entry_id": "a53a12a9-9d71-30e4-af12-203e1f26a3c1",
                                        "glosses": [
                                            "Relatif à une notion, théorique, mental, imaginaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b608ddec-e538-4b31-82f2-f5494dacce38",
                                                "sense_id": "01ed794b-eead-3aac-9ed3-468808592fa4",
                                                "text": "Ce que Hegel, cependant, a cherché, c'est le concept ayant ses différences conceptuellement au-dedans de lui-même et non plus au-dehors comme cela apparaît avec les théories classiques de la définition, réduisant celle-ci à la combinaison de deux moments notionnels par principe extérieurs l'un à l'autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f7537df-2c8a-3517-a154-9724ee568cd7",
                                        "entry_id": "a53a12a9-9d71-30e4-af12-203e1f26a3c1",
                                        "glosses": [
                                            "Descriptif par opposition à syntaxique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2929d96-c21b-45ed-b2d3-da576befbef2",
                                                "sense_id": "8f7537df-2c8a-3517-a154-9724ee568cd7",
                                                "text": "Le débat autour de la relativité linguistique est embrouillé par l'ambiguïté persistante autour des notions de champ notionnel et de champ sémantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d2b2fad-665a-3e96-975d-300e47bec7bf",
                                        "entry_id": "a53a12a9-9d71-30e4-af12-203e1f26a3c1",
                                        "glosses": [
                                            "De référence, référentiel en parlant de la valeur intrinsèque d'un contrat d’option."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0b9af12-84d7-46be-ab2e-a4332e6e4032",
                                                "sense_id": "9d2b2fad-665a-3e96-975d-300e47bec7bf",
                                                "text": "Dans le contrat d'option, le montant est notionnel, car le vendeur de l'option ne doit payer à l'acheteur de l'option que la différence entre le taux d'intérêt de référence et le taux d'intérêt d'exercice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "notionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0de6fe98-e637-3544-a2d7-ad325cc394f5",
                                        "entry_id": "d75ee508-d2c2-339e-92f5-1325bf5ac703",
                                        "glosses": [
                                            "Valeur nominale d'un instrument financier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab3b2b8-f84c-450e-bfa0-97337decf434",
                                                "sense_id": "0de6fe98-e637-3544-a2d7-ad325cc394f5",
                                                "text": "Le notionnel d’un instrument financier est le nominal ou la valeur faciale utilisée pour calculer les paiements effectués sur cet instrument."
                                            },
                                            {
                                                "example_id": "1c6d4e73-dae9-47ba-8c18-0f0b75f151ff",
                                                "sense_id": "0de6fe98-e637-3544-a2d7-ad325cc394f5",
                                                "text": "On le voit, comparativement aux autres actifs, le notionnel est peu volatile, contrairement à l’image qu’il véhicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
