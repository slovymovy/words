                "senses": [
                    {
                        "sense_id": "f25949ad-f9c5-3e5f-9fc9-683b8a492a25",
                        "entry_id": "4df8b7fb-2dac-3bfb-a40d-3f04d4dda3e2",
                        "glosses": [
                            "zum Verkauf von Waren genutzte Fläche in einem Geschäft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ced7e4-fd2e-448d-b4a4-d5790119e282",
                                "sense_id": "f25949ad-f9c5-3e5f-9fc9-683b8a492a25",
                                "text": "„Bei Geschäften mit einer Verkaufsfläche von bis zu 800 Quadratmetern gilt ein Richtwert von insgesamt höchstens einer Kundin oder einem Kunden pro 10 Quadratmetern Verkaufsfläche.“"
                            },
                            {
                                "example_id": "e3c0837e-e45f-4c90-b2aa-babe5fed04cc",
                                "sense_id": "f25949ad-f9c5-3e5f-9fc9-683b8a492a25",
                                "text": "„In Deutschland ist eine Zunahme der Verkaufsfläche bei gleichzeitigem Rückgang der Anzahl der Einzelhandelsunternehmen zu verzeichnen.“"
                            },
                            {
                                "example_id": "7459fe84-eb66-42bc-9d4e-6023f3dd8789",
                                "sense_id": "f25949ad-f9c5-3e5f-9fc9-683b8a492a25",
                                "text": "„So ist bei Discountern, Verbrauchermärkten und SB-Warenhäusern die Vergrößerung einer Verkaufsfläche für den Kunden attraktiver und damit verkaufsfördernder als eine entsprechende relative Vergrößerung bei einem Nachbarschaftsladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
