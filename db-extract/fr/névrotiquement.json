                "senses": [
                    {
                        "sense_id": "e66b4715-7dd0-3d12-9352-0ec7e643fe48",
                        "entry_id": "1e7c9bbe-7d90-3496-a62e-f6c0816fc0ce",
                        "glosses": [
                            "De façon névrotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38136fde-68f0-4c03-875a-fd205b4e76a8",
                                "sense_id": "e66b4715-7dd0-3d12-9352-0ec7e643fe48",
                                "text": "La femme fantasmée, névrotiquement fantasmée est en effet un être châtré, soumis et toujours exposé à l’action perverse d’un Autre, plus exactement à l’action d’un père pervers et tyrannique."
                            },
                            {
                                "example_id": "94cdee53-77e1-417c-9d2b-8b42dd761572",
                                "sense_id": "e66b4715-7dd0-3d12-9352-0ec7e643fe48",
                                "text": "L'attitude névrotiquement jalouse de sa mère, qui ne voyait pas en elle son enfant mais une rivale, l’avait induite à attendre que ses désirs soient satisfaits « à la lettre »."
                            }
                        ]
                    }
                ],
