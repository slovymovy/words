    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "33b7a1be-c4b3-3a51-adea-ba6b5a6847b8",
                    "sense_definition": "The Greek god of the underworld and ruler of the dead.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mythology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "In Greek mythology, <w>Hades</w> is the brother of Zeus and Poseidon.",
                            "target_lang_translations": {
                                "zh": "在希腊神话中，<w>哈迪斯</w>是宙斯和波塞冬的兄弟。"
                            }
                        },
                        {
                            "text": "The ancient stories describe how <w>Hades</w> kidnapped Persephone to be his queen.",
                            "target_lang_translations": {
                                "zh": "古老的故事描述了<w>哈迪斯</w>如何绑架珀耳塞福涅并让她成为自己的王后。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "希腊神话中冥界之神，死者的统治者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哈迪斯",
                                "target_lang_sense_clarification": "希腊神话中的冥王"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cfde7eb-c227-3df4-ab4d-aa26b19a47fc",
                    "sense_definition": "The underworld or the realm of the dead in Greek mythology.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mythology",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Orpheus traveled down to <w>Hades</w> to bring his wife back to the living world.",
                            "target_lang_translations": {
                                "zh": "俄耳甫斯前往<w>冥界</w>，试图将他的妻子带回人间。"
                            }
                        },
                        {
                            "text": "The hero had to cross the river Styx to enter the dark realm of <w>Hades</w>.",
                            "target_lang_translations": {
                                "zh": "英雄必须渡过斯堤克斯河才能进入<w>冥界</w>那黑暗的领域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "underworld"
                    ],
                    "target_lang_definitions": {
                        "zh": "希腊神话中的冥界或死者居住的领域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冥界",
                                "target_lang_sense_clarification": "死者居住的地下世界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa74e6c-3750-3c16-98f2-4424130ea495",
                    "sense_definition": "A place of punishment for the wicked after death; hell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher warned the congregation about the eternal fires of <w>Hades</w>.",
                            "target_lang_translations": {
                                "zh": "牧师告诫会众要警惕<w>地狱</w>的永恒之火。"
                            }
                        },
                        {
                            "text": "Many ancient cultures had their own versions of <w>Hades</w> as a place of suffering.",
                            "target_lang_translations": {
                                "zh": "许多古代文化都有各自关于<w>地狱</w>的描述，将其视为受苦之地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hell"
                    ],
                    "antonyms": [
                        "heaven"
                    ],
                    "target_lang_definitions": {
                        "zh": "死后惩罚恶人的地方；地狱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地狱",
                                "target_lang_sense_clarification": "宗教中惩罚罪人的地方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0b628e4-6293-35fa-bfe6-33568b1f0924",
                    "sense_definition": "The plural of <w>hade</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist measured the <w>hades</w> of the various fault lines in the region.",
                            "target_lang_translations": {
                                "zh": "地质学家测量了该地区各条断层的<w>断层倾角</w>。"
                            }
                        },
                        {
                            "text": "Different <w>hades</w> were recorded to determine the angle of the rock layers.",
                            "target_lang_translations": {
                                "zh": "记录了不同的<w>断层倾角</w>以确定岩层的角度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of hade"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "断层倾角（hade）的复数形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "断层倾角",
                                "target_lang_sense_clarification": "地质学中指断层面与垂直面之间的夹角"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b46a3ce1-6f3e-3588-88ff-bb3f487803d0",
                    "sense_definition": "Third-person singular simple present indicative of <w>hade</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor <w>hades</w> the vein of ore to track its downward slope.",
                            "target_lang_translations": {
                                "zh": "测量员<w>测量</w>矿脉的<w>倾角</w>以追踪其向下延伸的坡度。"
                            }
                        },
                        {
                            "text": "He <w>hades</w> the fault carefully to ensure the mining tunnel is safe.",
                            "target_lang_translations": {
                                "zh": "他仔细地<w>测量</w>断层的<w>倾角</w>，以确保矿道安全。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular simple present of hade"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "测量或确定断层倾角（hade）的第三人称单数形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "测量倾角",
                                "target_lang_sense_clarification": "地质勘探中测量断层倾斜角度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
