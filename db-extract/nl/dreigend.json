                                        "sense_id": "2a0de413-2a15-3c30-a20b-958e8349951d",
                                        "entry_id": "d20d51c7-b6c4-3636-bfad-8718a16efd4c",
                                        "glosses": [
                                            "Presenting a threat, posing a likely risk of harm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c04eb5a3-8a50-49cc-9e16-32c408f92396",
                                                "sense_id": "2a0de413-2a15-3c30-a20b-958e8349951d",
                                                "text": "Never turn your back to someone who is displaying threatening behavior."
                                            },
                                            {
                                                "example_id": "7c6a8244-5a59-428f-b2a3-10c50828b2a1",
                                                "sense_id": "2a0de413-2a15-3c30-a20b-958e8349951d",
                                                "text": "Fie, fie, vnknit that thretaning vnkinde brovv, / And dart not ſcornefull glances from thoſe eies, / To vvound thy Lord, thy King, thy Gouernour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f8ccbb-cbc6-3009-89b0-374430b13460",
                                        "entry_id": "d20d51c7-b6c4-3636-bfad-8718a16efd4c",
                                        "glosses": [
                                            "Making threats, making statements about a willingness to cause harm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
