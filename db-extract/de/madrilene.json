                                "target_senses": [
                                    {
                                        "sense_id": "8c52648c-4c2c-38d0-872d-8ab095d7f07e",
                                        "entry_id": "97fd658d-62df-3e1f-9fa9-c74820dd5204",
                                        "glosses": [
                                            "Someone from Madrid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f9034a-fb27-405d-926b-a5e2ed84544f",
                                                "sense_id": "8c52648c-4c2c-38d0-872d-8ab095d7f07e",
                                                "text": "Winter looked good on Madrileños; they took over the city center just for the fun of it, when really most shopping could be done in any of Madrid’s neighborhoods."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af934ac8-4573-4c04-a7bf-53424cecf7fe",
                        "source_entry_id": "503e8d6c-c028-3c41-aab7-c3a4b6b6254f",
                        "source_sense_id": "622f5059-f110-38f7-aeaf-cbc95ff7a2fb",
                        "source_sense_description": "Einwohner der spanischen Hauptstadt Madrid",
                        "target_lang_word": "мадридец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мадридец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a1c1c23a-6dba-3e02-8b17-e0a4d69ce93f",
                                        "entry_id": "c3dfd51b-76cc-349d-a1db-d61f533c4b54",
                                        "glosses": [
                                            "житель или уроженец Мадрида"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d2976b-8fe9-4c66-9267-add775923be1",
                                                "sense_id": "a1c1c23a-6dba-3e02-8b17-e0a4d69ce93f",
                                                "text": "Спокойствие и порядок в Мадриде были удивительные, казалось, что мадридцы готовились к большому торжеству."
                                            },
                                            {
                                                "example_id": "5e1300f9-b1e7-4f33-bb5e-ee074f138316",
                                                "sense_id": "a1c1c23a-6dba-3e02-8b17-e0a4d69ce93f",
                                                "text": "Всё получилось не так, как она рассчитывала, ― она-то думала, что в Мадриде все как сыр в масле катаются, вот и вышла за мадридца, а теперь, когда уже никуда не денешься, она наконец поняла, что ошиблась."
                                            },
                                            {
                                                "example_id": "11ecebe3-d4e4-4f36-bfc5-e07c2958e913",
                                                "sense_id": "a1c1c23a-6dba-3e02-8b17-e0a4d69ce93f",
                                                "text": "Все восхищаются Мадридом, героизмом его защитников, стойкостью его жителей. Засыпают восторженными телеграммами Хунту обороны Мадрида, но реальной помощи оружием, боеприпасами, людскими резервами пока не видно. Мадридцы вынуждены рассчитывать только на свои силы. ❬…❭ Те, кто панически бежал в Валенсию, теперь нападают на скромных защитников Мадрида, обвиняя их в зазнайстве, в том, что они — мадридцы, — мол, считают себя пупом земли, что только они и дерутся с фашизмом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
