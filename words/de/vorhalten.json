                    "sense_definition": "über einen längeren Zeitraum hinweg reichen, anhalten oder sättigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dauern",
                    "name_type": "no",
                    "examples": [
