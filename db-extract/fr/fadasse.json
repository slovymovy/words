                                    {
                                        "sense_id": "2acd0066-e00b-3cb3-ac87-c577a9fb6c2f",
                                        "entry_id": "78202b57-b634-3650-a0aa-9751739a8af9",
                                        "glosses": [
                                            "ohne Spannkraft; schlaff, matt, energielos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "344ff88d-a087-4c52-97b2-0dd2c33fe4d0",
                                                "sense_id": "2acd0066-e00b-3cb3-ac87-c577a9fb6c2f",
                                                "text": "Sein Händedruck und sein Gang waren so lasch, dass man glaubte, er würde jeden Moment zusammenklappen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fd6fbf4-2aae-3509-a3b7-7c1eb5753fa8",
                                        "entry_id": "78202b57-b634-3650-a0aa-9751739a8af9",
                                        "glosses": [
                                            "unklare, unpräzise und schwammige Ansichten"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f286201-b818-4b83-a128-294b74767a64",
                                                "sense_id": "5fd6fbf4-2aae-3509-a3b7-7c1eb5753fa8",
                                                "text": "Der Unteroffizier war in seiner Haltung und in der Disziplin gegenüber seinen Untergebenen zu lasch eingestellt."
                                            },
                                            {
                                                "example_id": "19195abe-309a-43fb-bb67-8708819672c1",
                                                "sense_id": "5fd6fbf4-2aae-3509-a3b7-7c1eb5753fa8",
                                                "text": "„Dann kamen jedoch die lascheren EG-Werte, und die ließen sich auch mit dem wesentlich billigeren ungeregelten Katalysator einhalten (ADAC-Motorwelt 9, 1986, Seite 39).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cb942656-632b-3fd1-b49a-7e0efcd0a291",
                                        "entry_id": "78202b57-b634-3650-a0aa-9751739a8af9",
                                        "glosses": [
                                            "fade, ungewürzt, schal"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a5e9358-c72f-4d58-9edc-6d9848c87200",
                                                "sense_id": "cb942656-632b-3fd1-b49a-7e0efcd0a291",
                                                "text": "Der Eintopf war dermaßen lasch, dass man glaubte eine Suppe aus 100 % Wasser zu essen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
