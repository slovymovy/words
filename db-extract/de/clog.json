                        "glosses": [
                            "Pantoffel/Schuh, dessen unterer Teil aus Holz ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c916986-c93c-49f9-84e1-65551bd2aedb",
                                "sense_id": "2b2dc339-b6ac-3312-8db9-39e14dc38554",
                                "text": "„Ich spazierte auf Clogs durch die Gassen.“"
                            },
                            {
                                "example_id": "44efe4db-b2e5-4113-9ff6-6490ad472485",
                                "sense_id": "2b2dc339-b6ac-3312-8db9-39e14dc38554",
                                "text": "„Die Wohnung strahlt die spezielle Art von häuslicher Gemütlichkeit aus, die sich einstellt, wenn man lange genug mit Clogs auf den versiegelten Dielen herumgelaufen ist, genug brennende Zigaretten auf der Tischplatte vergessen und häufig seinen Rausch auf dem Sofa ausgeschlafen hat und der schwarze Fernseher, der so groß ist wie ein Konzertflügel, das einzig Neue und Funktionierende ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
