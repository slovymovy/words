                        "entry_id": "4dfc25d7-b646-3ced-aae5-6e1448b4421d",
                        "glosses": [
                            "Lehre vom Bösen, das heißt die Reflexion über den Ursprung und die Natur des Bösen"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1ef34a9b-bcfb-4f08-aefa-0a27f077b49d",
                                "sense_id": "38fe6929-3f85-3dd3-9f66-aeab6be959a0",
                                "text": "Die Sündhaftigkeit des Menschen ist ein wichtiger Gegenstand der Ponerologie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68c0f2da-99b1-4542-be09-a055d7bee9d1",
                        "source_entry_id": "4dfc25d7-b646-3ced-aae5-6e1448b4421d",
                        "source_sense_id": "38fe6929-3f85-3dd3-9f66-aeab6be959a0",
                        "target_lang_word": "ponerology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponerology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1acdf237-275b-31ed-8936-b71a101df6c7",
                                        "entry_id": "dc9ab4e2-fe62-3890-9067-7eda541b3668",
                                        "glosses": [
                                            "The study of evil."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3db49e4f-5acc-4973-b5c0-68e348faf1e2",
                                                "sense_id": "1acdf237-275b-31ed-8936-b71a101df6c7",
                                                "text": "Christian ponerology is divided into two leading sections, that of sin or the bad participating in guilt, and that of death or the bad which has participated in the same."
                                            },
                                            {
                                                "example_id": "a49af9f2-006f-4a2a-a5fd-651cdb362454",
                                                "sense_id": "1acdf237-275b-31ed-8936-b71a101df6c7",
                                                "text": "The end for which God created the world is not an impotent thought, but an earnest one, incessantly striving to become actual in the world; for which reason it cannot be thwarted by actual sin, which is to be treated of in ethical ponerology."
                                            },
                                            {
                                                "example_id": "d1a627f9-4c88-4aa3-9006-cc1847eb4fdb",
                                                "sense_id": "1acdf237-275b-31ed-8936-b71a101df6c7",
                                                "text": "To the charlatans who so desperately strive to perpetuate these pious frauds, such a threatened warm welcome is an essential feature of their gloomy ponerology — hence the puerile solemnity with which it continues to be invoked against all who temerously thumb the nose at their bogus thaumaturgy."
                                            },
                                            {
                                                "example_id": "f59c438f-6912-4350-b48e-78fafa2e7eed",
                                                "sense_id": "1acdf237-275b-31ed-8936-b71a101df6c7",
                                                "text": "To call Mao either the saint or the devil of China is relevant only to those who see history as a branch of ponerology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
