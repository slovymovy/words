                    "frequency": "Low",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chevalier brandit sa lourde lame et menace de <w>pourfendre</w> le monstre qui terrorise le village."
