{
    "word_family": [
        "booster"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03fd6ef3-f826-371d-becd-4043ffcebca4",
                    "sense_definition": "To help something increase, improve, or become more successful.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise helps to <w>boost</w> your energy levels throughout the day.",
                            "target_lang_translations": {
                                "ru": "Регулярные упражнения помогают <w>повысить</w> уровень энергии в течение дня.",
                                "zh": "经常锻炼有助于<w>提升</w>你全天的精力水平。"
                            }
                        },
                        {
                            "text": "The new marketing campaign is designed to <w>boost</w> sales in international markets.",
                            "target_lang_translations": {
                                "ru": "Новая маркетинговая кампания призвана <w>увеличить</w> продажи на международных рынках.",
                                "zh": "新的营销活动旨在<w>促进</w>国际市场的销售。"
                            }
                        }
                    ],
                    "synonyms": [
                        "increase",
                        "improve",
                        "enhance",
                        "raise",
                        "strengthen",
                        "promote."
                    ],
                    "antonyms": [
                        "decrease",
                        "reduce",
                        "hinder"
                    ],
                    "common_phrases": [
                        "boost confidence",
                        "boost the economy",
                        "boost morale",
                        "boost sales"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помогать чему-либо расти, улучшаться или становиться более успешным.",
                        "zh": "帮助某事物增加、改善或变得更成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "увеличивать уровень, качество или количество"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "давать толчок к развитию или росту"
                            },
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "делать больше по размеру или количеству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提升",
                                "target_lang_sense_clarification": "提高水平、质量或数量"
                            },
                            {
                                "target_lang_word": "促进",
                                "target_lang_sense_clarification": "推动事物发展或进步"
                            },
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "使数量或程度变大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae6a25c0-cb94-3e44-98ce-3944cf99663a",
                    "sense_definition": "To push or lift someone or something upwards from below.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_lift_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He helped <w>boost</w> the child over the high fence so she could retrieve her ball.",
                            "target_lang_translations": {
                                "ru": "Он помог <w>подсадить</w> ребенка через высокий забор, чтобы она могла достать свой мяч.",
                                "zh": "他<w>托</w>着孩子翻过高高的栅栏，让她去捡回球。"
                            }
                        },
                        {
                            "text": "Can you <w>boost</w> me up so I can reach the top shelf?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>подсадить</w> меня, чтобы я мог дотянуться до верхней полки?",
                                "zh": "你能<w>托</w>我一把让我够到顶层的架子吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "lift",
                        "raise",
                        "hoist"
                    ],
                    "common_phrases": [
                        "boost someone up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подталкивать или приподнимать кого-то или что-то снизу вверх.",
                        "zh": "从下方推或托起某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсаживать",
                                "target_lang_sense_clarification": "помогать кому-то взобраться, приподнимая снизу"
                            },
                            {
                                "target_lang_word": "подталкивать",
                                "target_lang_sense_clarification": "толкать снизу вверх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "托",
                                "target_lang_sense_clarification": "用手掌向上支撑"
                            },
                            {
                                "target_lang_word": "推",
                                "target_lang_sense_clarification": "用力使物体移动或向上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b236a0-2513-3b43-b693-5a8e2ca4f75b",
                    "sense_definition": "To make a signal, sound, or electrical charge stronger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "amplify_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need a device to <w>boost</w> the Wi-Fi signal in the back room.",
                            "target_lang_translations": {
                                "ru": "Нам нужно устройство, чтобы <w>усилить</w> сигнал Wi-Fi в задней комнате.",
                                "zh": "我们需要一个设备来<w>增强</w>后屋的无线网络信号。"
                            }
                        },
                        {
                            "text": "The microphone is used to <w>boost</w> the singer's voice over the loud instruments.",
                            "target_lang_translations": {
                                "ru": "Микрофон используется, чтобы <w>усилить</w> голос певца на фоне громких инструментов.",
                                "zh": "麦克风被用来<w>放大</w>歌手的声音，使其盖过嘈杂的乐器声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amplify"
                    ],
                    "common_phrases": [
                        "boost the signal",
                        "boost the volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать сигнал, звук или электрический заряд сильнее.",
                        "zh": "使信号、声音或电流更强。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать мощнее (о сигнале, звуке)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增强",
                                "target_lang_sense_clarification": "使力量或强度变大"
                            },
                            {
                                "target_lang_word": "放大",
                                "target_lang_sense_clarification": "使声音或信号变强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93b3d322-967d-30c9-bb1d-9c2df672b1e4",
                    "sense_definition": "To start a vehicle with a dead battery by connecting it to the battery of another vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jumpstart_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I left my lights on and now I need someone to <w>boost</w> my car.",
                            "target_lang_translations": {
                                "ru": "Я оставил свет включенным, и теперь мне нужно, чтобы кто-то <w>дал прикурить</w> моей машине.",
                                "zh": "我忘了关车灯，现在需要有人帮我给车<w>搭火</w>。"
                            }
                        },
                        {
                            "text": "He used a set of jumper cables to <w>boost</w> the truck's dead battery.",
                            "target_lang_translations": {
                                "ru": "Он использовал комплект проводов для прикуривания, чтобы <w>реанимировать</w> разряженный аккумулятор грузовика.",
                                "zh": "他用一套搭火线给卡车没电的电池<w>搭火</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jump-start"
                    ],
                    "common_phrases": [
                        "boost a car",
                        "boost a battery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заводить автомобиль с разряженным аккумулятором, подсоединив его к аккумулятору другого автомобиля.",
                        "zh": "通过连接另一辆车的电池来启动电量耗尽的车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикуривать",
                                "target_lang_sense_clarification": "заводить машину от другого аккумулятора (разг.)"
                            },
                            {
                                "target_lang_word": "заводить",
                                "target_lang_sense_clarification": "запускать двигатель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭火",
                                "target_lang_sense_clarification": "通过连接外部电源启动汽车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "682c1470-a316-308c-a774-d3f395864792",
                    "sense_definition": "To steal something, especially by shoplifting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "steal_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenager was caught trying to <w>boost</w> a watch from the jewelry store.",
                            "target_lang_translations": {
                                "ru": "Подростка поймали при попытке <w>стащить</w> часы из ювелирного магазина.",
                                "zh": "那个少年在试图从珠宝店<w>偷窃</w>一块手表时被抓住了。"
                            }
                        },
                        {
                            "text": "They planned to <w>boost</w> a car for a joyride but got scared away.",
                            "target_lang_translations": {
                                "ru": "Они планировали <w>угнать</w> машину, чтобы покататься, но испугались и убежали.",
                                "zh": "他们本打算<w>偷</w>一辆车去兜风，但被吓跑了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steal",
                        "shoplift",
                        "swipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in criminal or informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Красть что-либо, особенно в магазинах.",
                        "zh": "偷窃某物，尤指在商店行窃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "украсть (разг.)"
                            },
                            {
                                "target_lang_word": "спереть",
                                "target_lang_sense_clarification": "украсть (груб. прост.)"
                            },
                            {
                                "target_lang_word": "угнать",
                                "target_lang_sense_clarification": "украсть транспортное средство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偷窃",
                                "target_lang_sense_clarification": "非法占有他人财物"
                            },
                            {
                                "target_lang_word": "顺走",
                                "target_lang_sense_clarification": "顺手偷走（口语）"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca09791e-2f1a-32b8-bd9b-6d70fcc5a652",
                    "sense_definition": "Something that helps, encourages, or causes an increase or improvement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the championship gave the team a huge confidence <w>boost</w>.",
                            "target_lang_translations": {
                                "ru": "Победа в чемпионате придала команде огромный <w>заряд</w> уверенности.",
                                "zh": "赢得冠军给了球队极大的信心<w>提升</w>。"
                            }
                        },
                        {
                            "text": "The tax cuts provided a much-needed <w>boost</w> to the local economy.",
                            "target_lang_translations": {
                                "ru": "Снижение налогов дало столь необходимый <w>толчок</w> местной экономике.",
                                "zh": "减税政策为当地经济提供了急需的<w>推动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "improvement",
                        "increase",
                        "help",
                        "encouragement"
                    ],
                    "antonyms": [
                        "setback"
                    ],
                    "common_phrases": [
                        "give a boost",
                        "confidence boost",
                        "economic boost",
                        "big boost"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что помогает, воодушевляет или вызывает рост или улучшение.",
                        "zh": "有助于、鼓励或引起增长或改善的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимул",
                                "target_lang_sense_clarification": "побуждение к действию"
                            },
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "импульс для развития"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "увеличение или улучшение состояния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推动",
                                "target_lang_sense_clarification": "促进事物发展的力量"
                            },
                            {
                                "target_lang_word": "提升",
                                "target_lang_sense_clarification": "改善状态或水平"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb6a15e-0ca4-382f-bd61-1b6248c76d69",
                    "sense_definition": "An act of pushing someone up from below to help them climb or reach something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_lift_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I gave him a <w>boost</w> so he could see over the tall wall.",
                            "target_lang_translations": {
                                "ru": "Я <w>подсадил</w> его, чтобы он мог видеть поверх высокой стены.",
                                "zh": "我<w>托举</w>了他一下，这样他就能看到高墙外面的情况了。"
                            }
                        },
                        {
                            "text": "She needed a <w>boost</w> to get onto the horse's back.",
                            "target_lang_translations": {
                                "ru": "Ей нужно было, чтобы ее <w>подсадили</w> на лошадь.",
                                "zh": "她需要别人<w>托</w>一把才能骑到马背上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "push",
                        "lift"
                    ],
                    "common_phrases": [
                        "give someone a boost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, когда кого-то подталкивают снизу, чтобы помочь взобраться или дотянуться до чего-либо.",
                        "zh": "从下方推某人以帮助其攀爬或够到某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсаживание",
                                "target_lang_sense_clarification": "действие по глаголу подсаживать"
                            },
                            {
                                "target_lang_word": "помощь",
                                "target_lang_sense_clarification": "поддержка при подъеме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "托举",
                                "target_lang_sense_clarification": "向上托起以提供帮助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1e8fb86-3ade-3fcb-a412-fab25ab45264",
                    "sense_definition": "Extra power or pressure produced by a turbocharger or supercharger in an engine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engine_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic adjusted the turbo <w>boost</w> to improve the car's acceleration.",
                            "target_lang_translations": {
                                "ru": "Механик отрегулировал турбо-<w>наддув</w>, чтобы улучшить разгон автомобиля.",
                                "zh": "技师调整了涡轮<w>增压</w>以改善汽车的加速性能。"
                            }
                        },
                        {
                            "text": "You can really feel the <w>boost</w> kick in when you step on the gas pedal.",
                            "target_lang_translations": {
                                "ru": "Вы действительно можете почувствовать, как включается <w>наддув</w>, когда нажимаете на педаль газа.",
                                "zh": "当你踩下油门时，真的能感觉到<w>增压</w>介入了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical context (automotive)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительная мощность или давление, создаваемое турбокомпрессором в двигателе.",
                        "zh": "发动机中由涡轮增压器产生的额外动力或压力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наддув",
                                "target_lang_sense_clarification": "повышение давления воздуха в двигателе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增压",
                                "target_lang_sense_clarification": "增加发动机进气压力"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}