                "senses": [
                    {
                        "sense_id": "0a740eb6-716a-35a0-958c-2e820b90173b",
                        "entry_id": "6308e837-ca9f-3f8c-9ef0-8ae32d4182da",
                        "glosses": [
                            "Détacher ce qui était fixé par des crapauds. (définition à vérifier)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec96f157-e7ab-4691-aec0-8fbf3de28f55",
                                "sense_id": "0a740eb6-716a-35a0-958c-2e820b90173b",
                                "text": "J'ai décrapauté un peu le moyeu arrière je n'ai pas trouvé de série de 4 chiffres pouvant indiquer l'année et le mois...."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3fd4f33-dd86-37a0-8798-db116d9f494a",
                        "entry_id": "6308e837-ca9f-3f8c-9ef0-8ae32d4182da",
                        "glosses": [
                            "Perdre son caractère de crapaud."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "aa8620f7-52db-42f2-a7a6-c5945287eedb",
                                "sense_id": "b3fd4f33-dd86-37a0-8798-db116d9f494a",
                                "text": "Au début, moi j'ai vu un crapaud mais ... plus les photos s'additionnent ... plus il se décrapaute pour se lignifier."
                            }
                        ]
                    },
                    {
                        "sense_id": "645b36d2-e9e8-30b6-b62d-1fc75236e750",
                        "entry_id": "6308e837-ca9f-3f8c-9ef0-8ae32d4182da",
                        "glosses": [
                            "Retirer les différentes épaisseurs de papier ou de carte qui constituent l’apprêture du dos."
                        ],
                        "tags": [
                            "Reliure"
                        ],
                        "examples": [
                            {
                                "example_id": "eedf4af4-8dc5-438e-9408-efafc351fa83",
                                "sense_id": "645b36d2-e9e8-30b6-b62d-1fc75236e750",
                                "text": "Si le désemboîtage ne suffit pas, le dos du volume peut être « décrapauté » : l'opération consiste à retirer (à sec, ou en appliquant un cataplasme de colle) les différentes épaisseurs de papier ou de carte qui constituent l’apprêture du dos, afin de mettre à nu les fonds de cahiers (sans altérer la couture)."
                            }
                        ]
                    }
