                {
                    "sense_id": "bd60ad9b-8ada-352b-94cb-361a4e3b66c0",
                    "sense_definition": "an den Ausgangsort oder an einen früher besuchten Ort zurückkehren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ortswechsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist schon spät, wir sollten jetzt zum Hotel <w>zurückgehen</w>."
                        },
                        {
                            "text": "Weil er seinen Schlüssel vergessen hatte, <w>ging</w> er sofort nach Hause <w>zurück</w>."
                        }
                    ],
                    "synonyms": [
                        "zurückkehren",
                        "umkehren"
                    ],
                    "antonyms": [
                        "weitergehen"
                    ],
                    "common_phrases": [
