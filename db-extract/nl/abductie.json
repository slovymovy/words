                        "cross_references": [
                            {
                                "target_word": "abduction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "126d066b-bd22-31e4-bacd-b5d7b005d456",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "Leading away; a carrying away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24dfce29-a8ae-32f9-abe7-1231d78b5740",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "The act of abducing or abducting; a drawing apart; the movement which separates a limb or other part from the axis, or middle line, of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f65f99-2f31-46f9-b145-2aec05ce6c0f",
                                                "sense_id": "24dfce29-a8ae-32f9-abe7-1231d78b5740",
                                                "text": "Abduction is performed by asking the patient to raise the arm at the side as high as they can with the examiner stabilizing the scapula by holding it down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd158362-8d1b-30dc-b212-52e2deedd612",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "A syllogism or form of argument in which the major premise is evident, but the minor is only probable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cda29555-0544-4c37-903b-47bc067fdb0b",
                                                "sense_id": "cd158362-8d1b-30dc-b212-52e2deedd612",
                                                "text": "The significance of such a step is that it is not morphologically triggered: it is a step of abduction, and what is required here is a meta-level process of reasoning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0350b3ec-f7bf-3fbd-a642-fe523225887e",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "The wrongful, and usually forcible, carrying off of a human being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe5d1e9-8ea6-4467-92cb-22d4ffedda45",
                                                "sense_id": "0350b3ec-f7bf-3fbd-a642-fe523225887e",
                                                "text": "the abduction of a child"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94e5fb9-dd19-3d3e-8f66-958ad098af4d",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "Alien abduction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49adadd8-a103-40f0-befd-4aff9e80cb75",
                                                "sense_id": "b94e5fb9-dd19-3d3e-8f66-958ad098af4d",
                                                "text": "But fear of abduction never stopped a good ufologist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "182a6d8a-071b-4383-be34-21be594b1476",
                        "source_entry_id": "be451972-fffa-3ccc-a877-4ca10c7a44f4",
                        "source_sense_description": "wegvoering",
                        "target_lang_word": "abduction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abduction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24788332-f8aa-34e0-885c-ddd69c66603a",
                                        "entry_id": "91675b92-a0a9-349d-b249-6e958a83f0f5",
                                        "glosses": [
                                            "Action des muscles qui écartent de la ligne médiane du corps les parties auxquelles ils sont attachés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7879c2-d501-479c-81b1-324cc2723619",
                                                "sense_id": "24788332-f8aa-34e0-885c-ddd69c66603a",
                                                "text": "Dans ce cas, le patient peut élever son épaule en abduction presque jusqu’à 90° en utilisant la seule mobilité scapulothoracique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b979b5e6-97db-3465-97b7-ffe9e54959a5",
                                        "entry_id": "91675b92-a0a9-349d-b249-6e958a83f0f5",
                                        "glosses": [
                                            "Action d’inférer les prémisses les plus vraisemblables permettant de parvenir, par déduction, à une conclusion concordante aux observations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b15f36f1-5028-4b76-9fa9-771370681174",
                                                "sense_id": "b979b5e6-97db-3465-97b7-ffe9e54959a5",
                                                "text": "Percy Spencer avait des bonbons chocolatés dans la poche de sa chemisette […]. Il s’aperçut qu’ils avaient fondu […]. Il n’y avait pas d’autre explication que celle qui conduisit à l’abduction suivante : ils avaient été réchauffés par les ondes du magnétron près duquel il venait de passer"
                                            },
                                            {
                                                "example_id": "47eb52c4-7c29-43a9-836d-a0e81d6f6117",
                                                "sense_id": "b979b5e6-97db-3465-97b7-ffe9e54959a5",
                                                "text": "L’abduction est utilisée pour faire des diagnostics."
                                            },
                                            {
                                                "example_id": "3d891631-167f-48fa-a830-2fdd2ed37429",
                                                "sense_id": "b979b5e6-97db-3465-97b7-ffe9e54959a5",
                                                "text": "Le raisonnement par abduction est un composant important de la démarche scientifique."
                                            },
                                            {
                                                "example_id": "2f9969d2-f588-477e-a616-3290e3189c11",
                                                "sense_id": "b979b5e6-97db-3465-97b7-ffe9e54959a5",
                                                "text": "Peirce a développé la logique de l’abduction, le raisonnement sérendipien par excellence, en s’affranchissant des limites de l’épistémologie positiviste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f078c7-78a2-3b72-842c-2eef543bb795",
                                        "entry_id": "91675b92-a0a9-349d-b249-6e958a83f0f5",
                                        "glosses": [
                                            "Procédé consistant à introduire une règle à titre d’hypothèse afin de considérer un résultat ou une observation comme un cas particulier tombant sous cette règle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed144197-5186-3233-95f9-f063ee461d6e",
                                        "entry_id": "91675b92-a0a9-349d-b249-6e958a83f0f5",
                                        "glosses": [
                                            "Forme de raisonnement intuitif qui consiste à supprimer les solutions improbables et qui s’oppose à une logique d’exploration systématique."
                                        ],
                                        "tags": [
                                            "Psychologie cognitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d306becc-ebc3-39fb-88a7-39cb2b90402c",
                                        "entry_id": "91675b92-a0a9-349d-b249-6e958a83f0f5",
                                        "glosses": [
                                            "Pour les ufologues, enlèvement d’une personne à son insu par des extraterrestres, sans souvenir de la victime après coup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aea2e83-a5b2-478c-ae05-f802263288ab",
                                                "sense_id": "d306becc-ebc3-39fb-88a7-39cb2b90402c",
                                                "text": "Les cas de contacts extraterrestres ou d’abductions (enlèvements supposés en lien direct avec un ovni) sont légions. Plusieurs milliers dans le monde et près de quatre cents en France ont été répertoriés, mais rares sont ceux à avoir été reconnus comme authentique par les autorités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13bfece1-b3cc-341b-9976-4509d5ca375f",
                                        "entry_id": "91675b92-a0a9-349d-b249-6e958a83f0f5",
                                        "glosses": [
                                            "À l’époque romaine, tactique consistant à dissoudre une troupe en ligne, afin de passer un endroit étroit."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
