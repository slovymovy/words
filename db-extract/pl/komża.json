                "senses": [
                    {
                        "sense_id": "b3d9935a-1eef-343b-92c9-fe58fd6a91df",
                        "entry_id": "98fb483f-8770-3f88-9449-0c6a598906bc",
                        "glosses": [
                            "biała szata liturgiczna, względnie krótka (do ud), o szerokich rękawach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a088f90-3a41-4b4d-bdb8-0f29ca3791be",
                                "sense_id": "b3d9935a-1eef-343b-92c9-fe58fd6a91df",
                                "text": "Przed drzwiami zakrystii stoi ojciec Piotr w komży i ze stułą."
                            },
                            {
                                "example_id": "23a9cd71-ac8f-4037-af13-0796e243bb99",
                                "sense_id": "b3d9935a-1eef-343b-92c9-fe58fd6a91df",
                                "text": "Klaryski uszyły dziesięć nowych komż."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8312b31-b466-4995-a4ae-74d467cf4e86",
                        "source_entry_id": "98fb483f-8770-3f88-9449-0c6a598906bc",
                        "source_sense_id": "b3d9935a-1eef-343b-92c9-fe58fd6a91df",
                        "target_lang_word": "surplice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surplice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03da5358-d5a5-3a88-9305-fbac9f069c50",
                                        "entry_id": "70fe82cc-88a3-330d-86dd-33aa31cbcd0f",
                                        "glosses": [
                                            "A liturgical vestment of the Christian Church in the form of a tunic of white linen or cotton material, with wide or moderately wide sleeves, reaching to the hips or knees, usually featuring lace decoration and embroidered bordures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21747ae7-7316-4e26-a1f1-48bb03140cda",
                                                "sense_id": "03da5358-d5a5-3a88-9305-fbac9f069c50",
                                                "text": "On the previous night he had taken the manuscript out of a long neglected chest, containing old shooting jackets, old Oxbridge scribbling books, his old surplice, and battered cap and gown, and other memorials of youth, school, and home."
                                            },
                                            {
                                                "example_id": "525fe05d-2f2c-449f-84b2-552d48e42183",
                                                "sense_id": "03da5358-d5a5-3a88-9305-fbac9f069c50",
                                                "text": "Beneath an old ebony table were two long carved oak chests. I lifted the lid of one, and at the top was a once-white surplice covered with dust, and beneath was a mass of tracts — Commonwealth Quartos, unbound — a prey to worms and decay."
                                            },
                                            {
                                                "example_id": "91699fa0-b03d-4744-becb-563eb43dd7df",
                                                "sense_id": "03da5358-d5a5-3a88-9305-fbac9f069c50",
                                                "text": "He was a wide man and looked wider in his surplice, especially from our pew, which was close up under the pulpit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9b6ade5-b690-44f2-abbb-5a8d0803b03e",
                        "source_entry_id": "98fb483f-8770-3f88-9449-0c6a598906bc",
                        "source_sense_id": "b3d9935a-1eef-343b-92c9-fe58fd6a91df",
                        "target_lang_word": "komže",
