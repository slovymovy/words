                "senses": [
                    {
                        "sense_id": "06eaf821-8bb7-309d-a584-33e543f2b26b",
                        "entry_id": "551f82e1-6037-3bb5-818f-e805c0271311",
                        "glosses": [
                            "Perdre de nouveau ses forces, s’affaiblir une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8253b6b3-972a-48bb-8e64-a6e703e95317",
                                "sense_id": "06eaf821-8bb7-309d-a584-33e543f2b26b",
                                "text": "Provoqués dans la plus parfaite duplicité. Nous sentir mal s'il le fallait. Redéfaillir exprès."
                            },
                            {
                                "example_id": "722ab8ac-e547-4f1d-a7ef-dc402e6d1bcc",
                                "sense_id": "06eaf821-8bb7-309d-a584-33e543f2b26b",
                                "text": "Un instant je crus redéfaillir comme dans la rivière mais mes forces restèrent."
                            }
                        ]
                    }
