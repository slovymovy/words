    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "508ffc0c-4a3b-3b41-ae8d-7cd09b7bd5c8",
                    "sense_definition": "kledingstukken of schoeisel haastig of snel aandoen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>schoot</w> snel zijn jas <w>aan</w> voordat hij naar buiten rende.",
                            "target_lang_translations": {
                                "fr": "Il <w>a enfilé</w> rapidement son manteau avant de sortir en courant."
                            }
                        },
                        {
                            "text": "Je moet even je schoenen <w>aanschieten</w>, want de taxi staat al voor de deur.",
                            "target_lang_translations": {
                                "fr": "Tu devrais vite <w>enfiler</w> tes chaussures, car le taxi est déjà devant la porte."
                            }
                        }
                    ],
                    "synonyms": [
                        "aandoen",
                        "aantrekken"
                    ],
                    "antonyms": [
                        "uittrekken"
                    ],
                    "common_phrases": [
                        "een jas aanschieten",
                        "schoenen aanschieten"
                    ],
                    "target_lang_definitions": {
                        "fr": "enfiler un vêtement ou des chaussures à la hâte ou rapidement"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "enfiler",
                                "target_lang_sense_clarification": "mettre rapidement un vêtement ou des chaussures"
                            },
                            {
                                "target_lang_word": "passer",
                                "target_lang_sense_clarification": "mettre un vêtement en vitesse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b75beb-82d7-3a8c-abcc-f797d5f413cc",
                    "sense_definition": "een dier of doelwit met een schot verwonden zonder het te doden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jager had het wilde zwijn slechts <w>aangeschoten</w>, waardoor het dier vluchtte.",
                            "target_lang_translations": {
                                "fr": "Le chasseur n'avait fait que <w>blesser</w> le sanglier, et l'animal s'est enfui."
                            }
                        },
                        {
                            "text": "Het is gevaarlijk om een <w>aangeschoten</w> dier in het bos te benaderen.",
                            "target_lang_translations": {
                                "fr": "Il est dangereux d'approcher un animal <w>blessé par balle</w> dans la forêt."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwonden"
                    ],
                    "antonyms": [
                        "doodschieten"
                    ],
                    "common_phrases": [
                        "wild aanschieten"
                    ],
                    "target_lang_definitions": {
                        "fr": "blesser un animal ou une cible avec un tir sans le tuer"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "blesser d'un coup de feu",
                                "target_lang_sense_clarification": "à la chasse ou au tir"
                            },
                            {
                                "target_lang_word": "atteindre",
                                "target_lang_sense_clarification": "toucher sans tuer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b8cefd3-2f07-3a0e-a775-f06c22151d07",
                    "sense_definition": "met grote spoed naderen of ergens snel naartoe lopen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ze het lawaai hoorden, kwamen de buren meteen <w>aangeschoten</w> om te helpen.",
                            "target_lang_translations": {
                                "fr": "En entendant le bruit, les voisins sont tout de suite <w>accourus</w> pour aider."
                            }
                        },
                        {
                            "text": "De hond zag zijn baasje en kwam direct vrolijk <w>aanschieten</w> door de tuin.",
                            "target_lang_translations": {
                                "fr": "Le chien a vu son maître et a immédiatement <w>accouru</w> joyeusement à travers le jardin."
                            }
                        }
                    ],
                    "synonyms": [
                        "toesnellen",
                        "toehasten"
                    ],
                    "target_lang_definitions": {
                        "fr": "s'approcher en grande hâte ou courir rapidement vers un endroit"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "accourir",
                                "target_lang_sense_clarification": "venir en toute hâte"
                            },
                            {
                                "target_lang_word": "arriver à toute vitesse",
                                "target_lang_sense_clarification": "s'approcher très vite"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cc1fd5f-8d57-3c6c-857d-bc36f0bd267f",
                    "sense_definition": "een lamp of apparaat plotseling of snel aandoen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de sensor beweging detecteerde, <w>schoot</w> de felle buitenlamp meteen <w>aan</w>.",
                            "target_lang_translations": {
                                "fr": "Dès que le capteur a détecté un mouvement, la puissante lampe extérieure <w>s'est allumée brusquement</w>."
                            }
                        },
                        {
                            "text": "In het donker hoorde hij iets ritselen en <w>schoot</w> hij haastig zijn zaklamp <w>aan</w>.",
                            "target_lang_translations": {
                                "fr": "Dans le noir, il a entendu un bruissement et <w>a allumé</w> précipitamment sa lampe torche."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanzetten",
                        "aandoen"
                    ],
                    "antonyms": [
                        "uitdoen",
                        "uitschakelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "allumer soudainement ou rapidement une lampe ou un appareil"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "s'allumer brusquement",
                                "target_lang_sense_clarification": "de manière soudaine, pour un éclairage"
                            },
                            {
                                "target_lang_word": "allumer d'un coup",
                                "target_lang_sense_clarification": "actionner rapidement un appareil"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}