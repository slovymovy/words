    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b4c5aa8-099f-3bef-be6e-8d4dc0ffabcb",
                    "sense_definition": "Truth or reality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>sooth</w>, I have no desire to travel in such foul weather.",
                            "target_lang_translations": {
                                "it": "In <w>verità</w>, non ho alcun desiderio di viaggiare con un tempo così brutto."
                            }
                        },
                        {
                            "text": "He spoke in good <w>sooth</w> when he warned them of the impending danger.",
                            "target_lang_translations": {
                                "it": "Parlava in tutta <w>verità</w> quando li avvertì del pericolo imminente."
                            }
                        }
                    ],
                    "synonyms": [
                        "truth",
                        "verity",
                        "reality"
                    ],
                    "antonyms": [
                        "falsehood",
                        "lie"
                    ],
                    "common_phrases": [
                        "in sooth",
                        "in good sooth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Verità o realtà."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "verità",
                                "target_lang_sense_clarification": "senso arcaico/letterario"
                            },
                            {
                                "target_lang_word": "vero",
                                "target_lang_sense_clarification": "sostantivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66c3ec93-e607-367b-8169-c5428b3ef169",
                    "sense_definition": "An omen, augury, or prognostication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "divination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elder sought a favorable <w>sooth</w> from the sudden flight of the eagles.",
                            "target_lang_translations": {
                                "it": "L'anziano cercava un <w>presagio</w> favorevole dall'improvviso volo delle aquile."
                            }
                        },
                        {
                            "text": "They believed the sudden thunder was a <w>sooth</w> of misfortune.",
                            "target_lang_translations": {
                                "it": "Credevano che il tuono improvviso fosse un <w>augurio</w> di sventura."
                            }
                        }
                    ],
                    "synonyms": [
                        "augury",
                        "portent",
                        "prognostication"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Presagio, augurio o pronostico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "presagio",
                                "target_lang_sense_clarification": "segno premonitore"
                            },
                            {
                                "target_lang_word": "augurio",
                                "target_lang_sense_clarification": "pronostico, auspicio"
                            },
                            {
                                "target_lang_word": "prodigio",
                                "target_lang_sense_clarification": "segno del destino"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fd71c38-3582-370f-9cce-1284599c4c39",
                    "sense_definition": "Sweet talk, flattering words, or cajolery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flattery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The courtier relied on gentle <w>sooth</w> to win the favor of the monarch.",
                            "target_lang_translations": {
                                "it": "Il cortigiano si affidava a dolci <w>lusinghe</w> per conquistare il favore del monarca."
                            }
                        },
                        {
                            "text": "She was not swayed by his empty <w>sooth</w> and deceitful promises.",
                            "target_lang_translations": {
                                "it": "Non si lasciò influenzare dalle sue vuote <w>adulazioni</w> e dalle sue promesse ingannevoli."
                            }
                        }
                    ],
                    "synonyms": [
                        "blandishment",
                        "cajolery",
                        "flattery"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Parole lusinghiere, adulazione o moine."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "lusinga",
                                "target_lang_sense_clarification": "parole adulatrici"
                            },
                            {
                                "target_lang_word": "adulazione",
                                "target_lang_sense_clarification": "complimenti insinceri"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc1f3203-1f28-343d-bb49-1b4704bf11e5",
                    "sense_definition": "Conforming to reality or fact; true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>sooth</w> report that reached our ears yesterday evening.",
                            "target_lang_translations": {
                                "it": "Era un resoconto <w>veritiero</w> quello che ci è giunto alle orecchie ieri sera."
                            }
                        },
                        {
                            "text": "The traveler told a <w>sooth</w> tale of distant lands and strange customs.",
                            "target_lang_translations": {
                                "it": "Il viaggiatore raccontò una storia <w>vera</w> di terre lontane e strane usanze."
                            }
                        }
                    ],
                    "synonyms": [
                        "true",
                        "veritable"
                    ],
                    "antonyms": [
                        "false",
                        "untrue"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Conforme alla realtà o ai fatti; vero."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "vero",
                                "target_lang_sense_clarification": "reale, veritiero"
                            },
                            {
                                "target_lang_word": "veritiero",
                                "target_lang_sense_clarification": "conforme a verità"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d981a9d9-2aa3-3ad3-9c3e-2fb3de677dc0",
                    "sense_definition": "Pleasing, sweet, or delightful to the senses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minstrel played a <w>sooth</w> melody that calmed the restless crowd.",
                            "target_lang_translations": {
                                "it": "Il menestrello suonò una <w>soave</w> melodia che calmò la folla agitata."
                            }
                        },
                        {
                            "text": "They enjoyed the <w>sooth</w> fragrance drifting through the summer garden.",
                            "target_lang_translations": {
                                "it": "Godevano della <w>dolce</w> fragranza che aleggiava nel giardino estivo."
                            }
                        }
                    ],
                    "synonyms": [
                        "delightful",
                        "pleasing",
                        "sweet"
                    ],
                    "antonyms": [
                        "unpleasant",
                        "harsh"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Gradevole, dolce o piacevole ai sensi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "dolce",
                                "target_lang_sense_clarification": "soave, piacevole"
                            },
                            {
                                "target_lang_word": "soave",
                                "target_lang_sense_clarification": "delicato e gradito"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "170ad7af-33f5-322f-aadb-9e67fd2eb541",
                    "sense_definition": "In truth; truly or indeed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did <w>sooth</w> perform every task he had sworn to accomplish.",
                            "target_lang_translations": {
                                "it": "Egli compì <w>davvero</w> ogni compito che aveva giurato di portare a termine."
                            }
                        },
                        {
                            "text": "I can <w>sooth</w> declare that no malice was ever intended.",
                            "target_lang_translations": {
                                "it": "Posso <w>in verità</w> affermare che non c'è mai stata alcuna cattiva intenzione."
                            }
                        }
                    ],
                    "synonyms": [
                        "truly",
                        "indeed",
                        "verily"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "In verità; davvero, per certo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "in verità",
                                "target_lang_sense_clarification": "davvero, in fede mia"
                            },
                            {
                                "target_lang_word": "davvero",
                                "target_lang_sense_clarification": "realmente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
