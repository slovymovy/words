    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51a5a64b-caf1-3af7-aae8-d3f54f13a12a",
                    "sense_definition": "An advance of funds, especially to a government service or employee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_advance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The department head submitted the monthly <w>imprest</w> report to reconcile the petty cash expenses.",
                            "target_lang_translations": {
                                "ru": "Руководитель отдела представил ежемесячный отчет по <w>авансовым средствам</w> для сверки мелких кассовых расходов."
                            }
                        },
                        {
                            "text": "He was responsible for managing the office <w>imprest</w> to cover minor daily expenditures.",
                            "target_lang_translations": {
                                "ru": "Он отвечал за управление офисным <w>подотчетным фондом</w> для покрытия мелких ежедневных расходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "advance",
                        "prepayment"
                    ],
                    "common_phrases": [
                        "imprest account",
                        "imprest fund"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "primarily used in governmental or formal accounting contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аванс или подотчетная сумма, особенно выдаваемая государственному учреждению или сотруднику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аванс",
                                "target_lang_sense_clarification": "денежные средства, выдаваемые вперед"
                            },
                            {
                                "target_lang_word": "подотчетная сумма",
                                "target_lang_sense_clarification": "деньги на мелкие расходы"
                            },
                            {
                                "target_lang_word": "импрест",
                                "target_lang_sense_clarification": "авансовый фонд в бухгалтерии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e47fcbb2-ec7b-3644-92d6-b8a21a08ad9b",
                    "sense_definition": "To advance funds on loan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_advance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treasury decided to <w>imprest</w> the necessary funds to the local authority for the emergency works.",
                            "target_lang_translations": {
                                "ru": "Казначейство решило <w>выдать авансом</w> необходимые средства местным властям для проведения аварийных работ."
                            }
                        },
                        {
                            "text": "It was unlawful to <w>imprest</w> money without proper authorization from the board.",
                            "target_lang_translations": {
                                "ru": "Было незаконно <w>выдавать подотчетные средства</w> без надлежащего разрешения со стороны правления."
                            }
                        }
                    ],
                    "synonyms": [
                        "advance",
                        "lend"
                    ],
                    "common_phrases": [
                        "imprest funds"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "primarily used in formal or historical financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдавать денежные средства в качестве аванса или займа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать аванс",
                                "target_lang_sense_clarification": "предоставлять подотчетные средства"
                            },
                            {
                                "target_lang_word": "авансировать",
                                "target_lang_sense_clarification": "выплачивать вперед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6922f1b8-b238-3e3d-a959-1b114a56339b",
                    "sense_definition": "simple past and past participle of <w>impress</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seal was <w>imprest</w> upon the hot wax to secure the confidential document.",
                            "target_lang_translations": {
                                "ru": "Печать была <w>оттиснута</w> на горячем воске, чтобы скрепить конфиденциальный документ."
                            }
                        },
                        {
                            "text": "His words were deeply <w>imprest</w> on her memory.",
                            "target_lang_translations": {
                                "ru": "Его слова глубоко <w>запечатлелись</w> в ее памяти."
                            }
                        }
                    ],
                    "synonyms": [
                        "impressed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic spelling of impressed"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола impress (отпечатывать, запечатлевать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечатанный",
                                "target_lang_sense_clarification": "о печати, штампе"
                            },
                            {
                                "target_lang_word": "запечатленный",
                                "target_lang_sense_clarification": "в памяти или сознании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
