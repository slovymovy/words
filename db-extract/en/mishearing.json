                        "examples": [
                            {
                                "example_id": "e3f57af0-726e-4eed-aed9-a0db773af907",
                                "sense_id": "136bcb56-5d90-3acd-9f42-88d8b4c9d028",
                                "text": "The title lyric [\"Bei Mir Bistu Shein\"], the only part of the original Yiddish preserved by Cahn, was a mondegreen waiting to happen—“My Mere Bits of Shame” and “My Beer, Mr. Shane” were among the earliest recorded mishearings—but the language barrier didn't […]"
                            },
                            {
                                "example_id": "46c133d4-ccc9-46f5-b59e-154a8153fd79",
                                "sense_id": "136bcb56-5d90-3acd-9f42-88d8b4c9d028",
                                "text": "Hence, rather than being the result of mishearing and assimilation, the application of Hobson-Jobson to the Muharram was intentionally disparaging."
                            }
                        ]
                    }
