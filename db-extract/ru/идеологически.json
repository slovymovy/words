                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c7daf7-6b3b-360c-9f4b-faa13ac0d6cb",
                                        "entry_id": "f88fe399-cf2d-3c79-aa6a-da87225d4e28",
                                        "glosses": [
                                            "D'une manière idéologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d6a697-fb09-41f3-96f3-6f43b1f8d3f6",
                                                "sense_id": "a7c7daf7-6b3b-360c-9f4b-faa13ac0d6cb",
                                                "text": "La méthode mussolinienne du coup de menton, un peu compromettante idéologiquement, mais les Inrocks ne sont pas dans les parages, semble à peu près fonctionner."
                                            },
                                            {
                                                "example_id": "aab842e2-df18-455a-9ae3-55c5eb7ede1a",
                                                "sense_id": "a7c7daf7-6b3b-360c-9f4b-faa13ac0d6cb",
                                                "text": "Or, en tant que telles, les études postcoloniales sont plus encore idéologiquement postnationalistes que chronologiquement postcoloniales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
