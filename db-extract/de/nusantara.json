                ],
                "senses": [
                    {
                        "sense_id": "e5564ddd-f9d2-30a5-8b70-5e3207f26c3c",
                        "entry_id": "5c74f86c-195d-3cdb-9f86-6a04bf56be2a",
                        "glosses": [
                            "alter Name für den Malaiischen Archipel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c18c812-82ce-41f8-965c-42aec033873a",
                                "sense_id": "e5564ddd-f9d2-30a5-8b70-5e3207f26c3c",
                                "text": "Nusantara ist ein alter Name für das malaiische Archipel, das neben Indonesien auch Malaysia, Singapur und Brunei umfasst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "58014cb0-6877-34e5-9f65-9b336ad4967b",
                        "entry_id": "5c74f86c-195d-3cdb-9f86-6a04bf56be2a",
                        "glosses": [
                            "Endonym für Indonesien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205a29d6-0a81-4808-9861-9dcbc9a8869c",
                                "sense_id": "58014cb0-6877-34e5-9f65-9b336ad4967b",
                                "text": "Indonesien, auch bekannt als Nusantara, ist der weltweit größte Archipelstaat mit über 17.000 Inseln."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "50ede898-f680-3eea-820d-098486b66beb",
                        "entry_id": "5c74f86c-195d-3cdb-9f86-6a04bf56be2a",
                        "glosses": [
                            "neue Hauptstadt Indonesiens auf der Insel Borneo, die 2024 die Rolle Jakartas übernehmen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40db7a32-24a5-4440-a940-a046929ae0b9",
                                "sense_id": "50ede898-f680-3eea-820d-098486b66beb",
                                "text": "Jetzt hat die neue Hauptstadt des Inselstaates auch einen Namen: Nusantara."
                            },
                            {
                                "example_id": "e139a750-d6c0-4ada-bba4-d406d915c731",
                                "sense_id": "50ede898-f680-3eea-820d-098486b66beb",
                                "text": "Schon 2024 sollen Teile der Regierung umziehen, ein Zehnjahresplan sieht vor, dass die Regierungsgeschäfte bis 2034 komplett aus Nusantara geführt werden."
                            },
                            {
                                "example_id": "5911ce70-ad0b-4c69-a4fe-eaf5df2303e6",
                                "sense_id": "50ede898-f680-3eea-820d-098486b66beb",
                                "text": "Erstmals werden die Feierlichkeiten zum Unabhängigkeitstag in Nusantara zelebriert - inmitten von Rohbauten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ba4af19-c863-45e6-82ab-1b8a6e58b555",
