                "senses": [
                    {
                        "sense_id": "59132952-5890-3137-8e61-af75bbe183ba",
                        "entry_id": "bf7ea524-c4d0-3867-9f86-d606b1ff2141",
                        "glosses": [
                            "ein kleiner Geldbeutel, insbesondere nur für Geldscheine und ohne zusätzliche Einsteckmöglichkeiten; Brieftasche"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17e5e7c3-e5d6-41b8-a342-cd1d6b7920ba",
                        "source_entry_id": "bf7ea524-c4d0-3867-9f86-d606b1ff2141",
                        "source_sense_id": "59132952-5890-3137-8e61-af75bbe183ba",
                        "source_sense_description": "Geldbeutel, nur für Geldscheine und ohne zusätzliche Einsteckmöglichkeiten",
                        "target_lang_word": "Brieftasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brieftasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a552680-47a4-3bd8-8589-b7ac6bce7a82",
                                        "entry_id": "65a4248e-517d-3d66-9f0a-725814703b40",
                                        "glosses": [
                                            "kleine Mappe für Ausweise, Papiergeld und Anderes, die man in einer Tasche der Kleidung mit sich führen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d6fa07-830c-4dd0-9b09-44ddefa15531",
                                                "sense_id": "1a552680-47a4-3bd8-8589-b7ac6bce7a82",
                                                "text": "In der Brieftasche führen viele ihren Führerschein, Personalausweis und manches andere mit sich, vielleicht auch mal einen Brief."
                                            },
                                            {
                                                "example_id": "ba7f0c00-eb41-4b95-a999-d5df4fbacc35",
                                                "sense_id": "1a552680-47a4-3bd8-8589-b7ac6bce7a82",
                                                "text": "„Ich nahm seine Brieftasche aus der Innentasche und zog fünf Hundertmarkscheine heraus, die ich mir in den BH stopfte, unter die Achseln, wo man es nicht gleich sah.“"
                                            },
                                            {
                                                "example_id": "3a96a0d5-1342-414b-8c75-0b4bdeb55a9e",
                                                "sense_id": "1a552680-47a4-3bd8-8589-b7ac6bce7a82",
                                                "text": "„Dann wollte der Däne, der Jørgensen hieß, ihnen ein Foto zeigen, und es kostete ihn einige Mühe, bis er die Brieftasche aus der Gesäßtasche gezogen und ein abgegriffenes und zerkratztes Bild herausgeholt hatte.“"
                                            },
                                            {
                                                "example_id": "dd2f93c2-c5ac-44a1-ba69-063f8ef20088",
                                                "sense_id": "1a552680-47a4-3bd8-8589-b7ac6bce7a82",
                                                "text": "„Insgeheim betete er, der Soldat möge ihm nicht die Brieftasche abverlangen.“"
                                            },
                                            {
                                                "example_id": "61503d5a-d7a2-4237-8d69-c24fe3c51e2d",
                                                "sense_id": "1a552680-47a4-3bd8-8589-b7ac6bce7a82",
                                                "text": "„Sie öffnet die Brieftasche und zieht ein abgegriffenes Passfoto hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
