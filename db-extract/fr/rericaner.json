                        "examples": [
                            {
                                "example_id": "188f1513-b149-42d3-9684-23ce049e90b6",
                                "sense_id": "dca0dde5-77b8-3c37-904a-df7e3fc2c612",
                                "text": "On prend le mandarin ; on le jette à la bête,\nQui rericane avec un rire de tempête,\nGobe le fils du Ciel, et longe gentiment,\nJaillisant, bondissant, les flancs du bâtiment."
                            },
                            {
                                "example_id": "ae0fd26c-4dea-4319-a589-2a1fc9f1cc03",
                                "sense_id": "dca0dde5-77b8-3c37-904a-df7e3fc2c612",
                                "text": "De rericaner... de reglavioter... de rallumer sa sèche..."
                            }
                        ]
