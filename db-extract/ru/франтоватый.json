                                    },
                                    {
                                        "sense_id": "1a064fcb-d2b2-3648-a322-483aa1461481",
                                        "entry_id": "e068c228-77c7-36bc-8ee2-437853344bec",
                                        "glosses": [
                                            "Se dice de alguien que presume y gusta de cuidar meticulosamente su apariencia."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e35406b6-4ffc-3ebe-b95f-a41d2be4613e",
                                        "entry_id": "e068c228-77c7-36bc-8ee2-437853344bec",
                                        "glosses": [
                                            "Que tiene goma; que tiene bastante entusiasmo por una afición o moda."
                                        ],
                                        "tags": [
                                            "Colombia",
                                            "colloquial",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8eced4-974c-4c16-9775-c41061db0246",
                                                "sense_id": "e35406b6-4ffc-3ebe-b95f-a41d2be4613e",
                                                "text": "Soy gomoso de la tecnología y ese era el nuevo modelo femenino de la famosa marca de celulares"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4f92d0f9-ee0f-3b56-babc-7cdbe8616a4a",
                                        "entry_id": "e068c228-77c7-36bc-8ee2-437853344bec",
                                        "glosses": [
                                            "Con goma o resaca, el malestar después de beber demasiado licor."
                                        ],
                                        "tags": [
                                            "El-Salvador",
                                            "Guatemala",
                                            "Honduras",
                                            "Nicaragua"
                                        ],
                                        "examples": [],
