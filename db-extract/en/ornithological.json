                        "cross_references": [
                            {
                                "target_word": "ornithologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0540df4-6892-387d-8d2b-db16e0a38403",
                                        "entry_id": "8bee6a32-e04b-3510-9b9a-70b4adb1801f",
                                        "glosses": [
                                            "aus der Sicht der Vogelkunde; die Ornithologie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4679edd5-1e3f-44ab-bd4f-f4e09e256b5a",
                                                "sense_id": "a0540df4-6892-387d-8d2b-db16e0a38403",
                                                "text": "Ornithologische Besonderheiten sind die vielen seltenen Wasser- und Küstenvögel, die auf der Insel ihre Brutreviere haben oder als Zugvögel nur zeitweise auf Sylt leben bzw. rasten."
                                            },
                                            {
                                                "example_id": "c18e274a-544e-49f7-8ad9-37741b5cd31e",
                                                "sense_id": "a0540df4-6892-387d-8d2b-db16e0a38403",
                                                "text": "Sein Vater war einer der ausgezeichnetsten Kenner und sorgfältigsten Beobachter der heimischen Vogelwelt, der unermüdlich jede freie Zeit ornithologischen Studien widmete."
                                            },
                                            {
                                                "example_id": "24d3ddd3-2211-46bd-8252-89186803da99",
                                                "sense_id": "a0540df4-6892-387d-8d2b-db16e0a38403",
                                                "text": "Die Lausitz ist entschieden der landschaftlich verschiedenartigste und unbestimmteste, zugleich aber auch der ornithologisch am besten erforschte Teil der Provinz Schlesien, …"
                                            },
                                            {
                                                "example_id": "a5936cd0-8c77-4ba3-9c81-7a3c35ed5128",
                                                "sense_id": "a0540df4-6892-387d-8d2b-db16e0a38403",
                                                "text": "„Zu dieser Zeit pflegte Stroud mit einer älteren Witwe namens Della Jones engen Briefkontakt, der sich über eine ornithologische Zeitschrift angebahnt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
