                {
                    "sense_id": "f8b7406b-f738-36bd-94f4-8ab1d329ef78",
                    "sense_definition": "Пассивный элемент направленной антенны, расположенный перед активным вибратором для усиления сигнала.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для улучшения приема сигнала инженер установил дополнительный <w>директор</w> на антенну.",
                            "target_lang_translations": {
                                "en": "To improve signal reception, the engineer installed an additional <w>director</w> on the antenna.",
                                "zh": "为了改善信号接收，工程师在天线上安装了一个额外的<w>引向器</w>。"
                            }
                        },
                        {
                            "text": "В этой конструкции антенны <w>директор</w> должен быть короче активного вибратора.",
                            "target_lang_translations": {
                                "en": "In this antenna design, the <w>director</w> must be shorter than the active element.",
                                "zh": "在这种天线结构中，<w>引向器</w>必须比有源振子短。"
                            }
                        }
                    ],
                    "antonyms": [
                        "рефлектор"
                    ],
                    "target_lang_definitions": {
                        "en": "A passive element of a directional antenna located in front of the active element to amplify the signal.",
                        "zh": "定向天线中的一种无源元件，位于有源振子前方，用于增强信号。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "director",
                                "target_lang_sense_clarification": "antenna component"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引向器",
                                "target_lang_sense_clarification": "天线中的无源元件"
                            }
                        ]
                    }
                }
            ]
