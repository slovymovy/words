                        "examples": [
                            {
                                "example_id": "794687e3-1cdc-4536-8e70-fb9591ca2bc4",
                                "sense_id": "4747b837-9a43-3e03-ade7-41802e234642",
                                "text": "Whenas the dainty and mollitious aire Had bid the Lady of the Palace, share In her refined pleasures, […]"
                            },
                            {
                                "example_id": "ced93105-0030-4d4b-a8d3-941a7125a9cd",
                                "sense_id": "4747b837-9a43-3e03-ade7-41802e234642",
                                "text": "Can lusty diet, and mollicious rest, bring forth no other fruits but faint desires, rigid thoughts, and phlegmatic conceits?"
                            },
                            {
                                "example_id": "5bcb8c00-ea09-4590-b015-d23c351b2820",
                                "sense_id": "4747b837-9a43-3e03-ade7-41802e234642",
                                "text": "And here in snowy birdskin robes they are, Sordello, here, mollitious alcoves gilt Superb as Byzant-domes that devils built — Ah, Byzant, there again !"
                            }
                        ]
                    }
