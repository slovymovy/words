                "senses": [
                    {
                        "sense_id": "6d75dfde-9eef-3b39-bd24-41ffa5a3ea35",
                        "entry_id": "91ce69ef-cef0-3d61-a8b8-eaf38babdf36",
                        "glosses": [
                            "krankhafte Angst davor, im Gesicht rot zu werden, zu erröten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98933c6f-ab5b-424e-9b67-1532637aae47",
                                "sense_id": "6d75dfde-9eef-3b39-bd24-41ffa5a3ea35",
                                "text": "„Erythrophobie heißt der Fachbegriff für ihr Leiden: die Angst vor dem Erröten.“"
                            },
                            {
                                "example_id": "6fef646a-c2fd-4630-852b-c0b3b98e0eda",
                                "sense_id": "6d75dfde-9eef-3b39-bd24-41ffa5a3ea35",
                                "text": "„Die Angst vor dem Rotwerden, die Fachleute Erythrophobie nennen, kann zur Krankheit werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f62fb210-efe3-3396-87ff-aa0bcf0c1d32",
                        "entry_id": "91ce69ef-cef0-3d61-a8b8-eaf38babdf36",
                        "glosses": [
                            "extreme Angst vor der Farbe Rot, zum Beispiel Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60569900-a05c-4ecb-951a-adb2b094d131",
                                "sense_id": "f62fb210-efe3-3396-87ff-aa0bcf0c1d32",
                                "text": "Menschen, die eine krankhafte Angst vor Blut oder roten Gegenständen haben, leiden womöglich unter einer Erythrophobie."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
