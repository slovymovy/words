                "senses": [
                    {
                        "sense_id": "59ca6d2d-3eec-3df4-9fe1-913753af6c58",
                        "entry_id": "09cbd9ee-85d3-3b17-ad62-4dc840f4b6ee",
                        "glosses": [
                            "Voyagiste, organisateur de voyages en groupe : entreprise créant et vendant des séjours touristiques avec différents niveaux de prestation (transport, hébergement, voyage organisé) à des agences de voyages ou à une clientèle directe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31930a3-e21e-4a9e-9a47-e38ffb7c929e",
                                "sense_id": "59ca6d2d-3eec-3df4-9fe1-913753af6c58",
                                "text": "Les retombées les plus faibles pour le pays d’accueil sont celle d’un voyage organisé par un tour-opérateur dans une enclave touristique, avec un avion et un hôtel appartenant au tour-opérateur […]"
                            },
                            {
                                "example_id": "af2f6d55-18b8-4f73-84c7-48c07d28a18a",
                                "sense_id": "59ca6d2d-3eec-3df4-9fe1-913753af6c58",
                                "text": "Deux options s’offrent au voyageur qui fait appel à un tour-opérateur pour organiser son voyage : confier la totalité de l’organisation de son voyage (avant et pendant et voyager sur place avec un guide) ou ne confier que la préparation partielle de son voyage (avant et non pas pendant)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d67f78dc-b309-409b-bc23-8ecea9647869",
                        "source_entry_id": "09cbd9ee-85d3-3b17-ad62-4dc840f4b6ee",
                        "source_sense_id": "59ca6d2d-3eec-3df4-9fe1-913753af6c58",
                        "target_lang_word": "Reiseveranstalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiseveranstalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca561841-2cae-33be-87eb-47fbc186e3f1",
                                        "entry_id": "3c10bb9f-3fed-3f21-bf2a-2b24a7f70d65",
                                        "glosses": [
                                            "Firma oder Person, die Reisen organisiert und veranstaltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6898ab2e-f3c5-4010-a775-25c4eb9fe00c",
                                                "sense_id": "ca561841-2cae-33be-87eb-47fbc186e3f1",
                                                "text": "Wegen des schlechten Geschäftsgangs musste der Reiseveranstalter einen Insolvenzantrag einbringen."
                                            },
                                            {
                                                "example_id": "15d7ec40-10f7-49a7-80ff-4ca3ab8e5808",
                                                "sense_id": "ca561841-2cae-33be-87eb-47fbc186e3f1",
                                                "text": "„Seit mehreren Jahren gibt es ein immer wieder aktualisiertes Reiserecht und in der Bevölkerung ein durch Zeitungsartikel und Fernsehsendungen gewachsenes Bewusstsein für weggelassene Informationen über Landschaft, Strand und Hotel, für geschönte Formulierungen, für Fehler und sogar Falschaussagen in Reisekatalogen, so dass immer mehr Touristen die Reiseveranstalter verklagen.“"
                                            },
                                            {
                                                "example_id": "a271e106-929b-477d-b21e-7a679e98b314",
                                                "sense_id": "ca561841-2cae-33be-87eb-47fbc186e3f1",
                                                "text": "„Die Muttergesellschaft des drittgrößten europäischen Reiseveranstalters stellte beim Amtsgericht München einen Antrag auf Eröffnung eines Insolvenzverfahrens. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
