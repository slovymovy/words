                        "cross_references": [
                            {
                                "target_word": "déporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa47e29-a584-3a21-ac8d-ccadd4427c86",
                                        "entry_id": "f0704df9-1a00-3c20-bba7-7e56f4c61f60",
                                        "glosses": [
                                            "Volet situé sur l’extrados d’une aile d’avion et servant au freinage aérodynamique de celui-ci par diminution de la portance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61217d3-3653-4816-a390-9bf08ca3e235",
                                                "sense_id": "8aa47e29-a584-3a21-ac8d-ccadd4427c86",
                                                "text": "Son aile « a » présente un bord d’attaque et un bord de fuite brisés, ce dernier étant doté de volets « b » et « c », d’un aileron « d » et de déporteurs « e », « f » et « g »."
                                            },
                                            {
                                                "example_id": "2a94841b-5c96-475c-bcd1-c7cfce28adfd",
                                                "sense_id": "8aa47e29-a584-3a21-ac8d-ccadd4427c86",
                                                "text": "Les déporteurs (lift dumpers) se présentent, sur chaque demi-aile, en cinq éléments : un élément perpendiculaire au plan de symétrie avion, puis quatre, situés entre le caisson de voilure et les volets […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c46fda12-3e9a-30a2-8313-edb8ca9f5d90",
                                        "entry_id": "f87844a8-8e71-3664-a651-18b498c9eb36",
                                        "glosses": [
                                            "Par juxtaposition, qui diminue la portance d’une des gouvernes d’un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d81f59d2-1ec9-414f-a1a8-760305590344",
                                                "sense_id": "c46fda12-3e9a-30a2-8313-edb8ca9f5d90",
                                                "text": "Volet, empennage déporteur."
                                            },
                                            {
                                                "example_id": "2d43b268-7024-498c-ba45-fea0c7cfdcfd",
                                                "sense_id": "c46fda12-3e9a-30a2-8313-edb8ca9f5d90",
                                                "text": "Ensuite cela agit comme des micros palettes déporteuses sur deux axes, lacet et tangage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
