                    {
                        "translation_id": "30f2f70b-21a4-4d0e-96f8-f52886a6aa09",
                        "source_entry_id": "e13f6bb7-52de-3084-bcbc-b6cab9169103",
                        "source_sense_id": "7b863eb7-c81d-3d4c-98e5-7f7c91290486",
