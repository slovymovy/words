                ],
                "translations": [
                    {
                        "translation_id": "a5e36c09-1bbc-48fd-b819-8e2e2647ad3e",
                        "source_entry_id": "cbea6264-1a57-3926-9d1f-80e231cf64ab",
                        "source_sense_id": "39770c94-d531-382d-8569-6438ebdad613",
                        "target_lang_word": "roundabout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
