                "senses": [
                    {
                        "sense_id": "1177b03d-3f72-30c8-bb94-a104f9e007d8",
                        "entry_id": "b44c5028-b4ed-3b55-8291-163e0df76de0",
                        "glosses": [
                            "het betalen van rekeningen en schulden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3feb31b-4d1b-4867-a9b5-2802ddf64917",
                                "sense_id": "1177b03d-3f72-30c8-bb94-a104f9e007d8",
                                "text": "Hij vereffende zijn schulden altijd zo snel als maar mogelijk was."
                            }
                        ]
                    },
                    {
                        "sense_id": "e24f1748-1ded-3c13-875b-3e742ca87aeb",
                        "entry_id": "b44c5028-b4ed-3b55-8291-163e0df76de0",
                        "glosses": [
                            "oplossen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bb46ba-fc68-42af-bd30-3fd0241aefe8",
                                "sense_id": "e24f1748-1ded-3c13-875b-3e742ca87aeb",
                                "text": "Na een goed gesprek hadden zijn hun conflict vereffend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07eb7d61-4c15-4e72-bce8-0766f5a7f24c",
                        "source_entry_id": "b44c5028-b4ed-3b55-8291-163e0df76de0",
                        "target_lang_word": "regulate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c34bbbc6-943d-3e22-8c89-43ab63cde1f9",
                                        "entry_id": "e9ed8f75-5f0a-3474-9a67-94755a11ca21",
                                        "glosses": [
                                            "To dictate policy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ec7d5bc-71a2-3f22-b052-f7f4f8f9dfba",
                                        "entry_id": "e9ed8f75-5f0a-3474-9a67-94755a11ca21",
                                        "glosses": [
                                            "To control or direct according to rule, principle, or law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0306a770-38b2-40f2-a1e2-dabeffbed3ce",
                                                "sense_id": "8ec7d5bc-71a2-3f22-b052-f7f4f8f9dfba",
                                                "text": "the laws which regulate the succession of the seasons"
                                            },
                                            {
                                                "example_id": "59cb28ad-7a25-42b9-8b9c-14a47d65461f",
                                                "sense_id": "8ec7d5bc-71a2-3f22-b052-f7f4f8f9dfba",
                                                "text": "The herdsmen near the frontier adjudicated their own disputes, and regulated their own police."
                                            },
                                            {
                                                "example_id": "2e4197b5-13ad-4080-9712-9ecdc79821a3",
                                                "sense_id": "8ec7d5bc-71a2-3f22-b052-f7f4f8f9dfba",
                                                "text": "But on Tuesday, Sam Altman[…] testified before members of a Senate subcommittee and largely agreed with them on the need to regulate the increasingly powerful A.I. technology being created inside his company and others like Google and Microsoft."
                                            },
                                            {
                                                "example_id": "0e136aba-7df4-478f-b998-9971188188a1",
                                                "sense_id": "8ec7d5bc-71a2-3f22-b052-f7f4f8f9dfba",
                                                "text": "The NFA has been a flashpoint for advocates, who say that silencers are not frequently used in crime and believe that the silencers and other weapons regulated under the law, including machine guns and short-barreled rifles and shotguns, are protected by the Second Amendment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3327dfa0-7831-3cc4-b07c-7ca04aebaeba",
                                        "entry_id": "e9ed8f75-5f0a-3474-9a67-94755a11ca21",
                                        "glosses": [
                                            "To adjust (a mechanism) for accurate and proper functioning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40fc9248-0994-480c-94fd-0da82256df1a",
                                                "sense_id": "3327dfa0-7831-3cc4-b07c-7ca04aebaeba",
                                                "text": "to regulate a watch, i.e. adjust its rate of running so that it will keep approximately standard time"
                                            },
                                            {
                                                "example_id": "9ae1998f-e00c-49fb-848c-0a53295e37f9",
                                                "sense_id": "3327dfa0-7831-3cc4-b07c-7ca04aebaeba",
                                                "text": "to regulate the temperature of a room, the pressure of steam, the speed of a machine, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34edb335-dc8e-3401-bd34-528b1be689f8",
                                        "entry_id": "e9ed8f75-5f0a-3474-9a67-94755a11ca21",
                                        "glosses": [
                                            "To put or maintain in order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e0d2de-5450-4c88-a107-dcfa81055aaa",
                                                "sense_id": "34edb335-dc8e-3401-bd34-528b1be689f8",
                                                "text": "to regulate the disordered state of a nation or its finances"
                                            },
                                            {
                                                "example_id": "eaaaf949-9423-4192-8d03-dc9983918b2a",
                                                "sense_id": "34edb335-dc8e-3401-bd34-528b1be689f8",
                                                "text": "to regulate one's eating habits"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a770c99-cddd-43a9-838e-dd84d2317e0c",
                        "source_entry_id": "b44c5028-b4ed-3b55-8291-163e0df76de0",
                        "target_lang_word": "strike a balance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strike a balance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9a52d80-baf5-30c0-bf49-5053019d0e84",
                                        "entry_id": "5d95cb41-3903-35a1-92c6-8f6d96055bdd",
                                        "glosses": [
                                            "To find a compromise between two conflicting things; to choose a moderate option between two extremes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c52022a9-4972-42e9-bfbe-e22712c533a4",
                                                "sense_id": "f9a52d80-baf5-30c0-bf49-5053019d0e84",
                                                "text": "You should try to strike a balance between your social life and work life."
                                            },
                                            {
                                                "example_id": "26638d66-0dbe-4788-b246-fd43667e0587",
                                                "sense_id": "f9a52d80-baf5-30c0-bf49-5053019d0e84",
                                                "text": "I like to think I strike a balance between being too strict and too lenient with my children."
                                            },
                                            {
                                                "example_id": "92d8c287-fd78-4c46-b13f-d0a601467d3a",
                                                "sense_id": "f9a52d80-baf5-30c0-bf49-5053019d0e84",
                                                "text": "Close to the window, where he could get more than his fair share of fresh air, the other twin, James—the fat and the lean of it, old Jolyon called these brothers—like the bulky Swithin, over six feet in height, but very lean, as though destined from his birth to strike a balance and maintain an average, brooded over the scene with his permanent stoop; […]"
                                            },
                                            {
                                                "example_id": "5bead284-57a1-45f7-97e9-988d4fbd2a1b",
                                                "sense_id": "f9a52d80-baf5-30c0-bf49-5053019d0e84",
                                                "text": "2004, Bridgeport Music, Inc. v. Dimension Films, opinion of the court\nThe copyright laws attempt to strike a balance between protecting original works and stifling further creativity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4fc77e9-26bd-36ce-8f1c-59ae4199a553",
                                        "entry_id": "5d95cb41-3903-35a1-92c6-8f6d96055bdd",
                                        "glosses": [
                                            "To bring out the relative state of a debtor and creditor account."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a9eaba-5999-4cca-88fe-f455d0117a34",
                                                "sense_id": "d4fc77e9-26bd-36ce-8f1c-59ae4199a553",
                                                "text": "I'd like to wind up the accounts before—before—well, this time I shan't wait till the new year to strike a balance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
