                "senses": [
                    {
                        "sense_id": "6dff6633-7ea6-34bf-9c86-97fc717e2873",
                        "entry_id": "46c8d4fc-d5b4-3aa7-8adc-b9f40bdd37df",
                        "glosses": [
                            "Form von Moral oder Tugend, die nicht aus den tiefen inneren Überzeugungen oder Prinzipien einer Person entspringt, sondern vielmehr äußerlich oder oberflächlich ist"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "38b55d48-5c6f-46de-bc88-d62e0372a879",
                                "sense_id": "6dff6633-7ea6-34bf-9c86-97fc717e2873",
                                "text": "„[…] Einer Aftermoral aber, welche lehrt, daß man nicht kämpfen solle, ist es nicht gegeben, den Kampf auszurotten.“"
                            },
                            {
                                "example_id": "075eedc4-fec1-48fa-a42f-27d2cfae5363",
                                "sense_id": "6dff6633-7ea6-34bf-9c86-97fc717e2873",
                                "text": "„Wohl kam jene Aftermoral aus dem Dunkel des Mönchthums von kinderlosen und der Kinder unwürdigen Menschen“"
                            },
                            {
                                "example_id": "d5de8e8a-b049-4b18-8949-95bab2e6c064",
                                "sense_id": "6dff6633-7ea6-34bf-9c86-97fc717e2873",
                                "text": "„Die negative These von der konventionellen Moral als Aftermoral und der angeblichen Tugend als Laster steht im Vordergrund; aber sie ist nur die eine Seite seiner Position: er setzt doch voraus, dass es eine Tugend gibt, wie könnte er sonst sagen ‚1a pitié est 1a plus aimable des passions et qu’elle approche le plus de la vertue.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
