                    {
                        "sense_id": "21571ce3-e10b-33af-bf91-f10d88bdc067",
                        "entry_id": "bc82df89-daa6-37e8-b0f6-8cca52e4ac4e",
                        "glosses": [
                            "Phase ultime de la diagenèse correspondant à l’exhumation et à la remontée des roches sédimentaires à la surface, où elles entrent à nouveau en contact avec les eaux de surface et subissent des processus d’altération liés à l’émergence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0569b431-4a36-4ca9-91fb-242fe6f8838d",
                                "sense_id": "21571ce3-e10b-33af-bf91-f10d88bdc067",
                                "text": "La télogenèse ou diagenèse tardive : processus qui se produisent lors de la remontée des roches à la surface ..."
                            },
                            {
                                "example_id": "42111c03-eec0-4d03-83f3-3c24416c60c9",
                                "sense_id": "21571ce3-e10b-33af-bf91-f10d88bdc067",
                                "text": "Une analyse diagénétique qui nous a conduit de reconstituer trois phases diagénétiques : l’éogenèse (micritisation, dolomitisation précoce), la mézogenèse (micro-fracturation, stylolitisation, microperforation, silicification, dolomitisation secondaires) et la telogenèse (dolomitisation, karstification, épigénisation)."
                            }
                        ]
                    }
                ],
