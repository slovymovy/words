        "fr-extract.jsonl": [
            {
                "entry_id": "b8c240ad-0faa-35c6-9a59-e0427bcc8253",
                "word": "implacable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7bfc35c-5f1d-487b-b105-18ebba44bbe4",
                        "entry_id": "b8c240ad-0faa-35c6-9a59-e0427bcc8253",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "implacables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                        "entry_id": "b8c240ad-0faa-35c6-9a59-e0427bcc8253",
                        "glosses": [
                            "Qui ne peut être apaisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff892ae0-830d-43a6-aad9-3fe4d5a611f1",
                                "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                                "text": "En vain l’ambassadeur de France tenta de fléchir les négociateurs américains. Ils se montrèrent implacables. Il fallait se soumettre ou faire banqueroute."
                            },
                            {
                                "example_id": "feced731-c806-416f-83c7-5e14d76037df",
                                "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                                "text": "L’œuvre de l’Industriel français qui pousse à l’association des petits contre l’implacable et mortelle concurrence des monopoleurs n’en est pas moins fort encourageable."
                            },
                            {
                                "example_id": "00071811-8553-4852-8054-74e6b3e2a801",
                                "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                                "text": "La mort de Marat ne servit qu’à rendre les haines plus implacables."
                            },
                            {
                                "example_id": "f538fbb4-d626-4687-9ac2-f9e48d3185e0",
                                "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                                "text": "Il lut et relut l’ordre implacable, sans autre sens pour lui que celui-ci, partir, quitter Yasmina."
                            },
                            {
                                "example_id": "690070fd-22ce-417f-8342-660a287acc40",
                                "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                                "text": "[…] ; mais le Bureau de Santé était implacable et livrait sans merci aux autorités administratives et judiciaires ceux qui débarquaient clandestinement, avec la complicité des terriens, des marchandises suspectes ; […]."
                            },
                            {
                                "example_id": "7bba961d-1a56-49b5-8b5a-79392e232217",
                                "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                                "text": "Le délire déporte le tortionnaire : implacable pouvoir, ineffable jouissance de donner la mort."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebbce9f1-2232-3c96-b0fc-33a18f51c253",
                        "entry_id": "b8c240ad-0faa-35c6-9a59-e0427bcc8253",
                        "glosses": [
                            "Dont la rigueur est inflexible. (définition tirée du tlfi, consulté le 14 août 2017)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19e750e-dd50-441c-a39a-132344cc6d2f",
                                "sense_id": "ebbce9f1-2232-3c96-b0fc-33a18f51c253",
                                "text": "Nous n'avons pas pu le contredire, son raisonnement était implacable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b56e7e4-a877-485d-b105-4905b12c6d6a",
                        "source_entry_id": "b8c240ad-0faa-35c6-9a59-e0427bcc8253",
                        "source_sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                        "source_sense_description": "Qui ne peut être apaisé",
                        "target_lang_word": "unversöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unversöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03572e36-5aad-302a-8c28-e0a62dfd62e7",
                                        "entry_id": "4c303567-2f95-39d6-8203-28da0853d4aa",
                                        "glosses": [
                                            "der Beendigung eines Konflikts entgegenstehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e3da9a8-8a90-4d51-89f4-0abd34d3d1c8",
                                                "sense_id": "03572e36-5aad-302a-8c28-e0a62dfd62e7",
                                                "text": "„Die ‚Radikalen‘ gerieten in einen unversöhnlichen Fraktionsgegensatz zu den teilweise nach liberalen Prinzipien, teilweise nach deutschem Muster marxistisch orientierten ‚Gemäßigten‘.“"
                                            },
                                            {
                                                "example_id": "478ba8c2-5030-47da-becb-dcbc14514be0",
                                                "sense_id": "03572e36-5aad-302a-8c28-e0a62dfd62e7",
                                                "text": "„Katholizismus und Fortschritt, der Papst und die modernen Ideen, der römische Stuhl und der heutige Staat – sind unversöhnliche Gegensätze.“"
                                            },
                                            {
                                                "example_id": "740d5160-9161-4d15-afb2-24562f40268f",
                                                "sense_id": "03572e36-5aad-302a-8c28-e0a62dfd62e7",
                                                "text": "„Er schenkte allen die Freiheit mit Ausnahme derer, die in Caesars Ermordung eingeweiht waren; diesen allein gegenüber zeigte er sich unversöhnlich.“"
                                            },
                                            {
                                                "example_id": "56dc1be7-e391-495a-8551-fc672e6c804e",
                                                "sense_id": "03572e36-5aad-302a-8c28-e0a62dfd62e7",
                                                "text": "„Vertreter extremer Positionen scheinen sich unversöhnlich gegenüberzustehen: Befürworter der Tradition und Vorkämpfer einer - mal islamisch, mal westlich geprägten - Modernisierung, Verfechter einer militärisch erzwungenen Ordnung und couragierte Anhänger der Demokratie, radikale Islamisten und liberale Säkularisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4044b05a-db12-4e9b-b86d-f1ea65b0c8f8",
                        "source_entry_id": "b8c240ad-0faa-35c6-9a59-e0427bcc8253",
                        "source_sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                        "source_sense_description": "Qui ne peut être apaisé",
                        "target_lang_word": "implacable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implacable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4392a122-a420-3a95-8809-484f13a2f5c1",
                                        "entry_id": "08b8cdc7-8950-33fa-a48d-b2ee2e8c83ef",
                                        "glosses": [
                                            "Not able to be placated or appeased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc0dd6a2-abce-4f07-920e-6cc45d230f60",
                                                "sense_id": "4392a122-a420-3a95-8809-484f13a2f5c1",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            },
                                            {
                                                "example_id": "be01791c-438e-409b-9796-136d51623123",
                                                "sense_id": "4392a122-a420-3a95-8809-484f13a2f5c1",
                                                "text": "[I]n the reign of Henry the Second, a body happening, by chance, to be dug up near Glastonbury Abbey, without any symptoms of putrefaction or decay, the Welch, the descendants of the Ancient Britons, tenacious of the dignity and reputation of that illustrious hero [King Arthur], vainly supposed it could be no other than the body of their justly-boasted Pen-Dragon; and that he had been immured in that sepulchre by the spells of some powerful and implacable inchanter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0bfc63-29fb-3723-8f10-5b6e1ccaab1a",
                                        "entry_id": "08b8cdc7-8950-33fa-a48d-b2ee2e8c83ef",
                                        "glosses": [
                                            "Impossible to prevent or stop; inexorable, unrelenting, unstoppable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34dad373-ff40-4e6f-a5f0-6d2299791b35",
                                                "sense_id": "1a0bfc63-29fb-3723-8f10-5b6e1ccaab1a",
                                                "text": "The battleships Washington and South Dakota pushed through the sea with an implacable ease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41bc514-9389-36c1-b9e8-b5f138f7a4ac",
                                        "entry_id": "08b8cdc7-8950-33fa-a48d-b2ee2e8c83ef",
                                        "glosses": [
                                            "Adamant; immovable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639fec92-9f82-43a0-92df-6835d39613a7",
                                                "sense_id": "d41bc514-9389-36c1-b9e8-b5f138f7a4ac",
                                                "text": "Indeed Cain hated his Brother, becauſe his own works were evil, and his Brothers righteous; and if thy Wife and Children have been offended with thee for this, they thereby ſhew themſelves to be implacable to good; and thou haſt delivered thy ſoul from their blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a966012a-1ab8-4fc2-9f64-4239c3b608da",
