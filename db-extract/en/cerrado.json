                                "sense_id": "ee3a7ffc-8818-3c36-9b03-d4dc38bd845e",
                                "text": "Nearly half (44%) of the Cerrado’s native vegetation, which includes scrubland, grasslands and forests, is already used for agriculture, the MapBiomas monitoring project calculates."
                            },
                            {
                                "example_id": "76babe12-fe56-4808-8585-96e5f7ee1735",
                                "sense_id": "ee3a7ffc-8818-3c36-9b03-d4dc38bd845e",
                                "text": "The Cerrado region now provides 54 percent of all soybeans harvested in Brazil, 28 percent of the country's corn, and 59 percent of its coffee."
                            }
                        ]
