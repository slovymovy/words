                                                "example_id": "b8c224d1-55c4-456d-a2ea-c69f5c87c1c2",
                                                "sense_id": "b6637b25-ada5-3741-9147-cd8da136fecf",
                                                "text": "Alexandre porta l’hellénisme jusqu’aux Indes."
                                            },
                                            {
                                                "example_id": "24c920d9-84e2-4a68-8b25-d361908a2225",
