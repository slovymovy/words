                ],
                "senses": [
                    {
                        "sense_id": "50eb9256-796a-38b1-805e-3ba55ff1c9f2",
                        "entry_id": "b16aa5b2-db90-31e2-8d75-a00bccfd0333",
                        "glosses": [
                            "Donner un caractère genré à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4385786-b9b5-4e65-9121-26c9e153392b",
                                "sense_id": "50eb9256-796a-38b1-805e-3ba55ff1c9f2",
                                "text": "Ceux-ci ne s’adressent plus guère (et encore, très modérément) qu’aux déclinaisons plus ou moins élégantes du vocable, du genre (sans jeu de mot) « avez-vous suffisamment genrisé les variables de votre enquête ? », que Thérèse a elle-même plus tendance à tancer qu’à favoriser."
                            },
                            {
                                "example_id": "9887110d-b2cb-471e-86f7-b9644e821cfb",
                                "sense_id": "50eb9256-796a-38b1-805e-3ba55ff1c9f2",
                                "text": "\"Genriser pour mieux discréditer : la ficelle est aussi vieille que le combat des femmes en politique\", ajoute le quotidien."
                            },
                            {
                                "example_id": "e6f31918-d736-4c3e-b90c-7c10c1ee394b",
                                "sense_id": "50eb9256-796a-38b1-805e-3ba55ff1c9f2",
                                "text": "Il ne faut pas genriser l’éducation, les garçons peuvent jouer à la princesse et les filles aux voitures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38b6ba3c-efe7-413e-a8bb-2bcedac0bb07",
                        "source_entry_id": "b16aa5b2-db90-31e2-8d75-a00bccfd0333",
                        "source_sense_id": "50eb9256-796a-38b1-805e-3ba55ff1c9f2",
                        "target_lang_word": "genderize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genderize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6424e49-cda2-3fb8-a0ef-1b4a381f1d6f",
                                        "entry_id": "5c583705-466f-3322-aa68-7566f3d6eec8",
                                        "glosses": [
                                            "To bestow gender upon; to make male or female, or assign masculine or feminine qualities to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9776bad2-3d61-42ed-8961-dfdf1f243f7f",
                                                "sense_id": "f6424e49-cda2-3fb8-a0ef-1b4a381f1d6f",
                                                "text": "By genderizing words, society makes sex-discrimination a requirement. Thus, when one sex is stipulated, the other is excluded."
                                            },
                                            {
                                                "example_id": "6b8af255-f289-4165-8e29-b004e41d3353",
                                                "sense_id": "f6424e49-cda2-3fb8-a0ef-1b4a381f1d6f",
                                                "text": "Yet the implications of implicitly genderizing ethical positions in these particular plays may be even more far reaching than it appears on the surface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "9bfb2b2d-8269-4386-a2e3-ad8db1fe9eee",
