        "fr-extract.jsonl": [
            {
                "entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                "word": "aide-mémoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8b848317-0307-4bcf-a028-991235719308",
                        "entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "aide-mémoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cf6e16d-dff6-366d-bde1-e50d0433d763",
                        "entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                        "glosses": [
                            "Tout ce qui aide la mémoire, moyen mnémotechnique, rappel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a381795c-d611-4c28-ad68-23d44925fb5f",
                                "sense_id": "5cf6e16d-dff6-366d-bde1-e50d0433d763",
                                "text": "La rime fut originairement un grossier artifice de mnémotechnie et le vers un aide-mémoire pour des gens qui ne savaient pas lire."
                            },
                            {
                                "example_id": "9d37160b-f2df-41bb-b353-bf052fd80aaa",
                                "sense_id": "5cf6e16d-dff6-366d-bde1-e50d0433d763",
                                "text": "Il [le maître d'hôtel] disait au garçon qui nous avait servis, avec un geste répété et apaisant du revers de la main, comme s'il voulait calmer un cheval prêt à prendre le mors aux dents : « N'allez pas trop fort (pour l'addition), allez doucement, très doucement. » Puis, comme le garçon partait muni de cet aide-mémoire, Aimé, craignant que ses recommandations ne fussent pas exactement suivies, le rappelait : « Attendez, je vais chiffrer moi-même. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "884abf8f-6c4a-347a-91a5-ee402bf238ae",
                        "entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                        "glosses": [
                            "Ouvrage consacré à un sujet particulier et contenant les renseignements essentiels (formules, listes, etc.) que la mémoire pourrait ne pas retenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86529cf6-d2c5-428d-b85c-36dc748e1a19",
                                "sense_id": "884abf8f-6c4a-347a-91a5-ee402bf238ae",
                                "text": "Aide-mémoire à l’usage des officiers d’artillerie de France, attachés au service de terre."
                            },
                            {
                                "example_id": "9cc720df-4c0b-4207-995e-221042158bd0",
                                "sense_id": "884abf8f-6c4a-347a-91a5-ee402bf238ae",
                                "text": "À quelle date précise placer tel souvenir, sans compter, comme je l’ai dit ailleurs, que les photographies et les récits d’adultes jouent leur rôle d’aide-mémoire ou de fausse mémoire ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4df63de-5bca-4a31-8fd4-24cee1643fc5",
                        "source_entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                        "target_lang_word": "Merkblatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c4cc5469-21f6-431f-9faa-f54f65f6da26",
                        "source_entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                        "target_lang_word": "Aide-Mémoire",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7bdb78ee-d594-42d0-881d-2cbaa7790ffc",
                        "source_entry_id": "97023d2e-609f-3751-92c8-a1561b9eb1c7",
                        "target_lang_word": "Notiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "kurze schriftliche Aufzeichnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f35ddfd-a578-43f9-88ba-2a6d1fcc8943",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "Der Protokollführer machte sich auf einem Notizblock seine Notizen, um sie später in Reinschrift zu übertragen."
                                            },
                                            {
                                                "example_id": "1b2be198-1b8b-4940-aac4-720611d48524",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "Der Schreibtisch war übersät mit Zettelchen, Zeitungsausschnitten, Notizen und Skizzen."
                                            },
                                            {
                                                "example_id": "ab63cb3d-5454-425d-86b4-b0454cf98f73",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Jürgen Loose sieht von seinen Notizen auf.“"
                                            },
                                            {
                                                "example_id": "c964fbc2-dfcb-4f7f-beb2-0ba004c94f20",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Doch »Paris, die Hauptstadt des 19. Jahrhunderts« blieb unvollendet, obwohl in seinem Nachlass nach dem Kriege ein großes Konvolut aus Manuskripten, Zetteln, Notizen gefunden wurde.“"
                                            },
                                            {
                                                "example_id": "f0c85930-ed58-4910-9be0-714f046b6df4",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Ich glaubte, alles von und über Kant zu kennen, in diesem Text aber stieß ich auf eine scheinbar unbedeutende Notiz, die meine Dissertation zur Makulatur werden ließ.“"
                                            },
                                            {
                                                "example_id": "2335a12f-3790-4f1a-91e4-8149c0bfd060",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Am Ausgang des Friedhofs standen die Presseleute mit Kameras und Notizblöcken, machten sich ab und zu kurze Notizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "kurze Zeitungsmeldung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517e23d9-b244-49a4-9d62-fbc2d23ed9c5",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "Im Abendblatt fand sich am nächsten Tag nur eine kleine Notiz."
                                            },
                                            {
                                                "example_id": "5c2f8ed9-5c01-449e-a1d7-afe19608b55c",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "Ich finde, sie hätten wenigstens eine Notiz über seinen Tod bringen können."
                                            },
                                            {
                                                "example_id": "e1e6b367-fb96-4f04-b839-e02123819bc6",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "„Ich las die Notiz durch.“"
                                            },
                                            {
                                                "example_id": "7a050dc1-813a-449a-91b3-7998776ac276",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "„Ich blätterte sie durch, überflog die Schlagzeilen, bis ich eine Notiz entdeckte, über die ich lachen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "Börsennotierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee11bc4-459e-4ebb-a0e6-3a297172dda2",
                                                "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                                "text": "Die amtliche Notiz ist die Festsetzung eines amtlichen Börsenkurses durch den Börsenvorstand, der diese Aufgabe aber auch auf einen Kursmakler übertragen kann."
                                            },
                                            {
                                                "example_id": "0199a5e5-4e16-4531-9bdb-c33004be0472",
                                                "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                                "text": "Die Voraussetzungen für eine Notiz im Prime Market der Wiener Börse sind nicht mehr gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf5146f7-67da-4474-babd-deeba46dcbb2",
