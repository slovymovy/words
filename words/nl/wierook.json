    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8a32cf5-5067-3274-b74b-9adb554487fb",
                    "sense_definition": "Een mengsel van aromatische organische stoffen dat na aansteken een aangename geur verspreidt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reukstof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de meditatie brandt er altijd een stokje <w>wierook</w> in de kamer.",
                            "target_lang_translations": {
                                "en": "During meditation, there is always a stick of <w>incense</w> burning in the room."
                            }
                        },
                        {
                            "text": "De geur van <w>wierook</w> vulde de hele kerk tijdens de dienst.",
                            "target_lang_translations": {
                                "en": "The smell of <w>incense</w> filled the entire church during the service."
                            }
                        }
                    ],
                    "synonyms": [
                        "reukwerk",
                        "rookwerk"
                    ],
                    "common_phrases": [
                        "wierook branden",
                        "geur van wierook"
                    ],
                    "target_lang_definitions": {
                        "en": "A mixture of aromatic organic substances that releases a pleasant fragrance when lit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incense",
                                "target_lang_sense_clarification": "aromatic biotic material that releases fragrant smoke when burned"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3e129e9-774f-3778-83b5-e3b1abff9a70",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>wieroken</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wierook</w> de kamer om een rustige sfeer te creëren.",
                            "target_lang_translations": {
                                "en": "I perfume the room <w>with incense</w> to create a peaceful atmosphere."
                            }
                        },
                        {
                            "text": "Als ik de tempel binnenga, <w>wierook</w> ik het altaar.",
                            "target_lang_translations": {
                                "en": "When I enter the temple, I <w>burn incense to</w> the altar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'wieroken' (to burn incense to, to perfume with incense)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burn incense to",
                                "target_lang_sense_clarification": "first-person singular present form"
                            },
                            {
                                "target_lang_word": "incense",
                                "target_lang_sense_clarification": "to perfume with incense, first-person singular present form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01e8a87d-5d42-3197-83f1-ce466f3e4628",
                    "sense_definition": "Gebiedende wijs van <w>wieroken</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wierook</w> de ruimte voordat de gasten arriveren!",
                            "target_lang_translations": {
                                "en": "Perfume the room <w>with incense</w> before the guests arrive!"
                            }
                        },
                        {
                            "text": "Alstublieft, <w>wierook</w> deze heilige plaats met zorg.",
                            "target_lang_translations": {
                                "en": "Please, <w>burn incense in</w> this holy place with care."
                            }
                        }
