        "fr-extract.jsonl": [
            {
                "entry_id": "1a632fdd-5eb6-3ba4-866b-d88a013141b4",
                "word": "traîne-la-patte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "551e20cb-6ece-3293-b23d-4da8ad1c327d",
                        "entry_id": "1a632fdd-5eb6-3ba4-866b-d88a013141b4",
                        "glosses": [
                            "Celui, celle qui marche lentement, avec mauvaise volonté."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9058a0b1-5e18-4d20-a10c-e9d3c0c84bb8",
                                "sense_id": "551e20cb-6ece-3293-b23d-4da8ad1c327d",
                                "text": "— Votre pied, la belle histoire !… Oui, oui, je vous autorise. Montez en voiture, montez en ballon. Nous avons assez de traîne-la-patte et de fricoteurs !"
                            },
                            {
                                "example_id": "2e489546-50d9-4177-baae-76ddaaf1580a",
                                "sense_id": "551e20cb-6ece-3293-b23d-4da8ad1c327d",
                                "text": "Souvent, il frappa des retardataires, des traîne-la-patte, de sa propre main, à coup de canne […]."
                            },
                            {
                                "example_id": "01e740a5-7c3f-4c9b-a970-cb4c67ef0362",
                                "sense_id": "551e20cb-6ece-3293-b23d-4da8ad1c327d",
                                "text": "C’était la fleur des hommes de la terre et son espoir. Il n’y avait point ici d’estropiés, de malades, de boiteux, de manchots, de faibles, de lymphatiques, de traîne-la-patte, de perd-haleine."
                            },
                            {
                                "example_id": "9b215ec8-8438-4d05-93f4-07400c3ecc6f",
                                "sense_id": "551e20cb-6ece-3293-b23d-4da8ad1c327d",
                                "text": "– Moi, mon petit, disait-il, à la guerre de 14, j’étais dans les chasseurs à pied et laisse-moi te dire que ce n’était pas une armée de traîne-la-patte !"
                            },
                            {
                                "example_id": "5270a944-6f2a-4444-8ac4-d9025d7bf09b",
                                "sense_id": "551e20cb-6ece-3293-b23d-4da8ad1c327d",
                                "text": "Il a honte, lui, sous-officier de l’armée allemande, d’être vu à la tête de ce ramassis de traîne-la-patte, de ce paquet de loques à coup sûr grouillant de vermine exotique."
                            }
                        ]
                    }
                ],
