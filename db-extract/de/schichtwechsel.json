                "senses": [
                    {
                        "sense_id": "d8bf843f-2233-3d1c-b126-25ae69ae6a01",
                        "entry_id": "d531c21e-14d7-33d5-979b-3b308155b2d7",
                        "glosses": [
                            "Übergang von einer Schicht (Arbeitsphase) zur nächsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3338eca-ebda-4bae-853b-54982d5fb2cc",
                                "sense_id": "d8bf843f-2233-3d1c-b126-25ae69ae6a01",
                                "text": "„Wenn freitags am frühen Abend der Schichtwechsel kam und sie Feierabend hatte, ging sie nicht nach Hause, sondern schlenderte, ihren kleinen Rollkoffer hinter sich herziehend, zum Parkplatz am Highway.“"
                            },
                            {
                                "example_id": "3cb3dbe6-22ce-405b-a7a5-155ac65aed94",
                                "sense_id": "d8bf843f-2233-3d1c-b126-25ae69ae6a01",
                                "text": "„In ähnlicher Weise wurden auch die Signale für Schichtwechsel und Ablösungsmannschaften gegeben.“"
                            },
                            {
                                "example_id": "7992c62e-5b56-4b03-b107-485b8f509218",
                                "sense_id": "d8bf843f-2233-3d1c-b126-25ae69ae6a01",
                                "text": "„Die Polizei machte gerade Schichtwechsel, als er bei der Station ankam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
