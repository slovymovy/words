                                        "entry_id": "5222997d-f181-3aa1-9994-df1bb2139a1f",
                                        "glosses": [
                                            "(männliche^☆) Person mit Weisungsbefugnis über nachgeordnetes Personal, Inhaber, Vorgesetzter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4a0bd5-03b0-423e-ba72-273724c5c1f9",
                                                "sense_id": "e1c4e3be-6166-39c9-82d3-4cef9c8a2a50",
                                                "text": "Ihr Chef ist ein sehr umgänglicher Mensch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca6b36b2-d777-30ef-b320-55944cfd285b",
                                        "entry_id": "5222997d-f181-3aa1-9994-df1bb2139a1f",
                                        "glosses": [
                                            "allgemein für Anführer oder Oberhaupt von Gruppen auch als Anrede"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f1945b9-af55-40d1-a1e2-aa78a8f155f9",
                                                "sense_id": "ca6b36b2-d777-30ef-b320-55944cfd285b",
                                                "text": "Nach dem Tod des Vaters ist jetzt Romero der Chef der Familie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f14ed149-18e2-4544-88a2-5c1034209d1f",
                        "source_entry_id": "fe8db4d7-9c54-3d3f-beec-c674dc38a192",
                        "source_sense_id": "1b424524-9163-3d73-a95f-ff6a92e9dad3",
                        "source_sense_description": "boss, leader",
