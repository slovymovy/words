                        "entry_id": "92a0ced2-97d8-30a1-bbbb-df35853632fa",
                        "glosses": [
                            "Action de mettre du gravillon sur une route, une place, etc."
                        ],
                        "tags": [
                            "Travaux publics"
                        ],
                        "examples": [
                            {
                                "example_id": "cd42792a-b757-4790-b743-c5c76df54f1b",
                                "sense_id": "4487477d-8166-3019-8dd4-2b4efff561ba",
                                "text": "Le répandage se fait sur une surface sèche et le gravillonnage suit d'aussi près que possible le répandage, de manière que la surface du gravillon soit bien mouillée par le liant fluide."
                            },
                            {
                                "example_id": "c05232af-6f33-41d8-b820-0bc0849537a8",
                                "sense_id": "4487477d-8166-3019-8dd4-2b4efff561ba",
                                "text": "L'enduit monocouche à double gravillonnage, qui comporte une couche de liant et deux couches de granulats, la seconde étant de classe granulaire inférieure à celle de la première."
                            },
                            {
                                "example_id": "178ce632-4375-4a27-ae53-b596080a9368",
                                "sense_id": "4487477d-8166-3019-8dd4-2b4efff561ba",
                                "text": "Non seulement elle eût son renseignement, mais elle apprit qu'il avait exercé le métier de cantonnier et participé aux premiers gravillonnages des routes environnantes, jusqu'alors empierrées."
                            }
                        ]
                    }
