                    "sense_definition": "De manière nette, saillante ou très marquée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a représenté son modèle avec des traits <w>fortement</w> marqués par l'âge.",
                            "target_lang_translations": {
                                "en": "The painter portrayed his model with features <w>clearly</w> marked by age.",
                                "ru": "Художник изобразил модель с чертами, <w>отчётливо</w> отмеченными возрастом.",
                                "de": "Der Maler stellte sein Modell mit <w>deutlich</w> vom Alter gezeichneten Zügen dar.",
                                "es": "El pintor retrató a su modelo con rasgos <w>claramente</w> marcados por la edad.",
                                "zh": "画家为他的模特作画，面部特征<w>明显</w>带着岁月的痕迹。"
                            }
                        },
                        {
                            "text": "Cette statue antique présente une musculature <w>fortement</w> dessinée dans le marbre.",
