                    {
                        "translation_id": "6f25c98d-ebae-49c4-9a36-9ff639fb8404",
                        "source_entry_id": "3b3fde19-5b83-3fef-b4e6-2594c8fea79f",
                        "source_sense_id": "d7f93d21-dfa5-3922-a48c-2c7e701e13e6",
                        "target_lang_word": "marne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d14eafdc-7267-331a-9d33-35c1a14abd2a",
                                        "entry_id": "529d6ddf-d098-3f43-996c-f79596b8f442",
                                        "glosses": [
                                            "Roche sédimentaire, mélange de calcite (CaCO₃) et d'argile dans des proportions à peu près équivalentes variant de 35 % à 65 % (autre notation : (50 ± 15) %)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd04bfe-4764-4c0a-8669-05c154f3caff",
                                                "sense_id": "d14eafdc-7267-331a-9d33-35c1a14abd2a",
                                                "text": "Marnes et calcaires marneux assez homogènes, gris-bleuâtre, à texture terreuse et à cassure sub-schisteuse."
                                            },
                                            {
                                                "example_id": "d086b6a9-a30d-4bd9-868e-dcdadbb289a3",
                                                "sense_id": "d14eafdc-7267-331a-9d33-35c1a14abd2a",
                                                "text": "Ce sont des calcaires compactes, sub-lithographiques, dont quelques-uns ont un faux aspect de calcaire grossier marin, et d’autres qui sont celluleux, alternent avec des marnes plus ou moins argileuses."
                                            },
                                            {
                                                "example_id": "e66506ee-4bb8-4263-a73d-abb6aaa540ad",
                                                "sense_id": "d14eafdc-7267-331a-9d33-35c1a14abd2a",
                                                "text": "Les marnes bleues qui constituent le substratum des alluvions avec des faciès sensiblement identiques, d’Épineau-Ies-Voves à Appoigny, méritent de retenir l’attention au point de vue stratigraphique."
                                            },
                                            {
                                                "example_id": "7304b725-d09b-4695-a5d5-5e46750c654c",
                                                "sense_id": "d14eafdc-7267-331a-9d33-35c1a14abd2a",
                                                "text": "Aux environs de Châteauneuf-le-Rouge (en bordure de la R.N. 7), cette limite est tracée dans des marnes rutilantes qui reposent sur le calcaire de Rognac au Sud et qui supportent les niveaux calcaires subordonnés aux poudingues de la Galante au Nord."
                                            },
                                            {
                                                "example_id": "0a20b8b1-443c-40e8-8a43-335509659299",
                                                "sense_id": "d14eafdc-7267-331a-9d33-35c1a14abd2a",
                                                "text": "Quand, lavé des odeurs du jour, le jardinet\nDerrière la maison, en hiver, s'illunait,\nGisant au pied d'un mur, enterré dans la marne\nEt pour des visions écrasant son œil darne,\nIl écoutait grouiller les galeux espaliers."
                                            }
                                        ]
                                    }
                                ]
                            },
