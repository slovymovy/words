                                                "sense_id": "1d076d3f-ac86-3c6e-bbbf-7de5dfa01419",
                                                "text": "In Londen rijden veel dubbeldekkers."
                                            },
                                            {
                                                "example_id": "2bf5c43a-e50e-4748-b1ba-0ec707dca33c",
                                                "sense_id": "1d076d3f-ac86-3c6e-bbbf-7de5dfa01419",
