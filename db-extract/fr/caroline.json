                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                        "entry_id": "f2972973-3335-32c6-8c0d-8ecca5039ff1",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd5e12b-532d-4056-b3cc-94f6b27472a1",
                                "sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                                "text": "Oui Caroline\n Je suis si bien dans tes bras\n Oui Caroline\n Rien ne compte autant que toi et moi."
                            },
                            {
                                "example_id": "0e1126fa-c0e5-4828-87b2-c0f2309603b1",
                                "sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                                "text": "Par rapport à la crise sanitaire, il y a un manque criant de pédagogie, relève Caroline Marchetti, fondatrice de Controverse, agence de conseil en stratégie."
                            },
                            {
                                "example_id": "a7a23ea3-896f-4931-887f-d2be48bcd754",
                                "sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                                "text": "En partenariat avec l’association Son ar Mein de Guimaëc, l’Association pour la sauvegarde de l’ancienne église du XVIᵉ siècle de Henvic a invité, mercredi, Victorien Disse et Étienne Galletier, musiciens aux théorbes et guitares baroques, accompagnés de Caroline Arnaud, soprano."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80067893-0d8b-4bce-9711-f1e4c12ec9ca",
                        "source_entry_id": "f2972973-3335-32c6-8c0d-8ecca5039ff1",
                        "source_sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                        "target_lang_word": "Caroline",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caroline",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a92db702-6710-3176-ad62-ed0ea22e439e",
                                        "entry_id": "6ca71908-a981-3d3d-a0f1-dca909b003cb",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29043493-a82a-4c00-8d89-652322278da5",
                                                "sense_id": "a92db702-6710-3176-ad62-ed0ea22e439e",
                                                "text": "»Ich glaube, Caroline, die selbst ein wenig romantisch veranlagt war, hat sich von den abenteuerlichen Plänen dieses Menschen gefangennehmen lassen. …«"
                                            },
                                            {
                                                "example_id": "9db23e8a-bf9c-4bf6-bd0f-36ffb3bf4aa8",
                                                "sense_id": "a92db702-6710-3176-ad62-ed0ea22e439e",
                                                "text": "»Liebe Caroline«, pflegte er zu sagen und sich, soweit ihm das sein Schnürleib erlaubte, über sie zu beugen, »sagen Sie mir, daß Sie sich heute viel besser befinden.«"
                                            },
                                            {
                                                "example_id": "0c9caad0-af07-40b6-bb22-fd1210e7f2cb",
                                                "sense_id": "a92db702-6710-3176-ad62-ed0ea22e439e",
                                                "text": "Mathilde: »Die Mutter sollte schon älter aussehen als die Tochter. Wenn nicht ich die Mutter spiele, muss die Tochter von Caroline gespielt werden.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b99a8635-b5e9-4bfb-a09d-f32aaed174b1",
                        "source_entry_id": "f2972973-3335-32c6-8c0d-8ecca5039ff1",
                        "source_sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                        "target_lang_word": "Caroline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caroline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc734fb8-7ce3-3e7c-8505-93c3b7c7f95b",
                                        "entry_id": "33e4fdf6-2a86-3d20-b9e2-afba141055d6",
                                        "glosses": [
                                            "Synonym of Carolean (“relating to the time of Kings Charles I and II of England or Charles III of the United Kingdom, or of the kings themselves”)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "921170a7-92cd-4e8b-a912-c0a193d9aeef",
                                                "sense_id": "bc734fb8-7ce3-3e7c-8505-93c3b7c7f95b",
                                                "text": "For that poem, though in certain ‘strange and high’ qualities it is the inferior of the best jets of the Caroline genius, is one of the most faultless and perfect things in this or indeed in any period of English poetry, and may be said to impart the Caroline essence in a form that can be (in the medical sense) ‘borne’ by all who have any feeling for poetry at all, as hardly anything else does."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Caroline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "860b4084-e2bf-31a2-86bd-c83674f62aaa",
                                        "entry_id": "f27cd58c-67c2-366e-901e-912327c5c622",
                                        "glosses": [
                                            "Synonym of Carolean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468675ea-1052-4548-8479-b251e6bb7b03",
                                                "sense_id": "860b4084-e2bf-31a2-86bd-c83674f62aaa",
                                                "text": "The shooting star, which dissolved on reaching earth into dew or ‘jelly’, is very common with Carolines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Caroline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84b2370e-1b74-3ff1-9713-a9ef6eb317ae",
                                        "entry_id": "b57d6c6c-edc1-3789-977a-0179d202cb5a",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd34b989-b78b-439c-ad23-61a9d85bcedb",
                                                "sense_id": "84b2370e-1b74-3ff1-9713-a9ef6eb317ae",
                                                "text": "- - - gentle Sophias milk your cows, and if you ask a pretty smiling girl at a cottage door to tell you her name, the rosy lips lisp out Caroline. A great number of children, amongst the lower classes, are Carolines. That does not, however, wholly proceed from the love of the appellation; though I believe that a queen Margery or a queen Sarah would have had fewer namesakes."
                                            },
                                            {
                                                "example_id": "0901d489-5df3-4f5b-a82b-65bae53d278c",
                                                "sense_id": "84b2370e-1b74-3ff1-9713-a9ef6eb317ae",
                                                "text": "I used to love saying her name. Caroline, with the \"i\" always long, because to make it short left it sounding like crinoline, a sweat-stained, mothballed Sunday hat pulled from an attic trunk. But Caroline with the \"i\" long created a sound roughly equivalent to the idea of a girl. The echo of a song in its three syllables, an age-old lyric not yet faded from memory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65ad1e38-b63e-45ee-af06-747064b631d6",
                        "source_entry_id": "f2972973-3335-32c6-8c0d-8ecca5039ff1",
                        "source_sense_id": "ad7391cd-9ea0-3f71-9fbb-5eec93476fb8",
                        "target_lang_word": "Carolyn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Carolyn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62671b82-d616-3035-a23a-50b0df5b8dca",
                                        "entry_id": "bdc9f64b-e586-3595-be51-fe32c9e8b176",
                                        "glosses": [
                                            "A female given name from the Germanic languages, a variant of Caroline used since the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d02a3393-8d78-45f1-b0de-0b051f2518eb",
                                                "sense_id": "62671b82-d616-3035-a23a-50b0df5b8dca",
                                                "text": "He never called me \"Carolyn\" until long after I'd stopped studying with him. It was always \"Caroline\", as in his Jardin aux Lilas. When at Juilliard he first learned my name, he snorted \"How affected!\" I was surprised. \"Carolyn\" affected? \"Caroline\" not? I'd always thought it was the other way around."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
