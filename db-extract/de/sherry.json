                                    {
                                        "sense_id": "02160229-b3f8-3fca-b765-adb867ace390",
                                        "entry_id": "2eeb9879-8387-3f60-bc43-bae4d3ae37ad",
                                        "glosses": [
                                            "A fortified wine produced in Jerez de la Frontera in Spain, or a similar wine produced elsewhere."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f0123b-e3ba-453c-85db-27b33525fb05",
                                                "sense_id": "02160229-b3f8-3fca-b765-adb867ace390",
                                                "text": "He gazed around until on the lid of a spinet he spotted a promising collection of bottles, gin, whiskey, vermouth and sherry, mixed with violin bows, a flute, a toppling pile of books, six volumes of Grove's Dictionary mingled with paperback thrillers, a guitar without any strings, a pair of binoculars, a meerschaum pipe and a jar half-full of wasps and apricot jam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e5255b-792f-3861-aab0-03120fb9477d",
                                        "entry_id": "2eeb9879-8387-3f60-bc43-bae4d3ae37ad",
                                        "glosses": [
                                            "A variety of sherry."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c5cdb5-d9ed-42a5-8bcd-d87bb4f82999",
                                                "sense_id": "48e5255b-792f-3861-aab0-03120fb9477d",
                                                "text": "They produce several quality sherries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cecdd610-ec01-3bc7-b52c-2b4c49189770",
                                        "entry_id": "2eeb9879-8387-3f60-bc43-bae4d3ae37ad",
                                        "glosses": [
                                            "A glass of sherry."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6a8b18f-4bbf-4074-8b4f-38861e6fabf8",
                                                "sense_id": "cecdd610-ec01-3bc7-b52c-2b4c49189770",
                                                "text": "Would you like a sherry?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e28746f-24c2-4aec-a4d0-7f983fdb0273",
                        "source_entry_id": "09267a8a-1d2f-3b2a-914b-bdb258e0bdc1",
                        "source_sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                        "source_sense_description": "gelblicher Likörwein aus Spanien",
                        "target_lang_word": "xérès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xérès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                                        "glosses": [
                                            "Vin blanc muté, sec ou doux, spécialité de Jerez de la Frontera en Andalousie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfac3e0a-0281-4ed9-b667-f0a8802b617e",
                                                "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                                "text": "Il y avait Bibulus O’Bumper. Il dit son mot sur le latour et le markbrünnen, sur le champagne mousseux et le chambertin, sur le richebourg et le saint-georges, sur le haut-brion, le léoville et le médoc, sur le barsac et le preignac, sur le grave, sur le sauterne, sur le laffite et sur le saint-péray. Il hocha la tête à l’endroit du clos-vougeot, et se vanta de distinguer, les yeux fermés, le xérès de l’amontillado."
                                            },
                                            {
                                                "example_id": "fbb8d45d-f3cf-43ca-a97d-564b3e19a3ba",
                                                "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                                "text": "Ce soir, elle et moi souperons en tête à tête ! Tu feras préparer une table dans ma chambre. Du malaga, naturellement. Aimes-tu le malaga ou préfères-tu du xérès ?"
                                            },
                                            {
                                                "example_id": "15c79b75-c9ed-4525-8523-0c5cd375e10b",
                                                "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                                "text": "Doux contrepoint, le vin de grenade d’Arménie, aux accents de porto ou de xérès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c2d359-82a0-31d2-a588-ba00fa09cd38",
                                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                                        "glosses": [
                                            "Vinaigre produit à partir de ce vin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8f6c436-6bc1-3064-aee0-f29389a20f37",
                                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                                        "glosses": [
                                            "En particulier dans le Roussillon, synonyme de listan, qui est le nom français du cépage d'origine espagnol nommé palomino fino."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
