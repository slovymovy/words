        "nl-extract.jsonl": [
            {
                "entry_id": "3f623793-4acf-3ce9-a366-9ed86ed8e327",
                "word": "dauwtrappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f91849eb-3ca1-3cc1-acac-de7b06fe6e63",
                        "entry_id": "3f623793-4acf-3ce9-a366-9ed86ed8e327",
                        "glosses": [
                            "op Hemelvaartsdag vroeg opstaan om vervolgens met een groep een wandeling of fietstocht in de natuur te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf6faf5-c2d1-4ec2-867c-aeab63fe8c37",
                                "sense_id": "f91849eb-3ca1-3cc1-acac-de7b06fe6e63",
                                "text": "Sinds vier jaar is Oortjeshekken eigendom van het echtpaar Margreet Hertsenberg-Scholten en Hent Scholten, dat elkaar twaalf jaar geleden leerde kennen tijdens een ochtendje dauwtrappen dat startte vanuit, jawel, Oortjeshekken. Hij was projectleider in de elektrotechniek, zij coachte mensen met ‘werk- en levensvragen’, en beiden waren toe aan iets nieuws. Het lijkt de goede stap te zijn geweest; zelden kom je twee stralendere horecamensen tegen."
                            },
                            {
                                "example_id": "1c1fed0c-18b9-45ea-acd9-4ce0fb7af22f",
                                "sense_id": "f91849eb-3ca1-3cc1-acac-de7b06fe6e63",
                                "text": "Inmiddels zijn er twee Friese regiosoaps en een Twentse. De Limburgse soap De Hemelpaort wordt op dit moment opgenomen en overal in het land springen ideeën voor regiosoaps als paddestoelen uit de grond. In Amsterdam hebben afgelopen week ongeveer 128.000 mensen gekeken naar de eerste aflevering van de stadssoap West Side. Ook regio’s zonder dialect of tradities als slootjespringen en dauwtrappen willen zich in een soap profileren. Er zijn bijvoorbeeld plannen in Groningen, Utrecht, Leiden/Den Haag en Rotterdam."
                            }
                        ]
                    }
