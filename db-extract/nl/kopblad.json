                        "entry_id": "1d664a18-7f7e-3087-8bb6-9a4b09342251",
                        "glosses": [
                            "een aparte editie van een krant die onder een eigen naam verschijnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "812bd5d2-e397-4844-957b-9f570ea42366",
                                "sense_id": "e3b11b7a-f1c5-3dfe-a1bc-cc6d5a313041",
                                "text": "De Dortenaar: Dit kopblad van het Algemeen Dagblad komt in 1946 voor het eerst uit en is de opvolger van het in de oorlog illegale blad De Vrije Pers. De oplagecijfers stijgen van ruim 25.000 in 1965 tot bijna 38.000 twintig jaar later. Van De Dordtenaar verschijnen nu nog dagelijks bijna 30.000 exemplaren."
                            },
                            {
                                "example_id": "1f129e1e-e297-4902-ae69-b4a4ff037428",
                                "sense_id": "e3b11b7a-f1c5-3dfe-a1bc-cc6d5a313041",
                                "text": "Zo mag De Persgroep onder meer de eerste drie jaar de titels niet omvormen tot kopblad, een inhoudelijk identiek tijdschrift aan een ander maar met een verschillende titel en voorpagina."
                            },
                            {
                                "example_id": "b63461e5-38ba-44ed-bc66-8fe57f9d172b",
                                "sense_id": "e3b11b7a-f1c5-3dfe-a1bc-cc6d5a313041",
                                "text": "An Meskens wordt hoofdredacteur van ‘Story’, ‘Dag Allemaal’ en ‘TV Familie’. Neen, het worden geen kopbladen’, verzekert De Persgroep."
                            }
                        ]
                    }
