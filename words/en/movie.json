{
    "word_family": [
        "moviegoer",
        "moviemaker",
        "moviemaking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c48f37cb-a42e-3513-a190-2d3eeb5a3f7b",
                    "sense_definition": "A recorded sequence of images displayed on a screen at a rate sufficiently fast to create the appearance of motion; a film.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "film_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is watching a crime-thriller <w>movie</w>.",
                            "target_lang_translations": {
                                "ru": "Он смотрит криминальный <w>фильм</w>.",
                                "zh": "他正在看一部犯罪惊悚<w>电影</w>。"
                            }
                        },
                        {
                            "text": "We decided to stay home and watch a scary <w>movie</w> on television.",
                            "target_lang_translations": {
                                "ru": "Мы решили остаться дома и посмотреть страшное <w>кино</w> по телевизору.",
                                "zh": "我们决定待在家里，在电视上看一部恐怖<w>电影</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flick",
                        "motion picture",
                        "picture",
                        "film"
                    ],
                    "common_phrases": [
                        "watch a movie",
                        "action movie",
                        "horror movie",
                        "movie star",
                        "make a movie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записанная последовательность изображений, демонстрируемая на экране; фильм.",
                        "zh": "记录在案并以足够快的速度在屏幕上播放以产生运动感的图像序列；影片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фильм",
                                "target_lang_sense_clarification": "произведение киноискусства"
                            },
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "разговорное, общее название"
                            },
                            {
                                "target_lang_word": "кинокартина",
                                "target_lang_sense_clarification": "формальное"
                            },
                            {
                                "target_lang_word": "кинофильм",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电影",
                                "target_lang_sense_clarification": "指电影作品或电影艺术"
                            },
                            {
                                "target_lang_word": "影片",
                                "target_lang_sense_clarification": "较正式的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d578fa5e-1166-34a0-95ed-fbb7b76b75aa",
                    "sense_definition": "A cinema; a movie theatre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "film_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's go to the <w>movies</w> this Friday night.",
                            "target_lang_translations": {
                                "ru": "Давай сходим в <w>кино</w> в пятницу вечером.",
                                "zh": "这个周五晚上我们去<w>电影院</w>吧。"
                            }
                        },
                        {
                            "text": "She loves buying popcorn and soda when she is at the <w>movies</w>.",
                            "target_lang_translations": {
                                "ru": "Она любит покупать попкорн и газировку, когда бывает в <w>кино</w>.",
                                "zh": "她喜欢在<w>电影院</w>买爆米花和汽水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cinema",
                        "theater"
                    ],
                    "common_phrases": [
                        "go to the movies",
                        "at the movies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кинотеатр; место для публичного показа фильмов.",
                        "zh": "电影院；放映电影的场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "мероприятие или место (идти в кино)"
                            },
                            {
                                "target_lang_word": "кинотеатр",
                                "target_lang_sense_clarification": "здание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电影院",
                                "target_lang_sense_clarification": "指放映电影的建筑物"
                            },
                            {
                                "target_lang_word": "电影",
                                "target_lang_sense_clarification": "指看电影这一活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb8c8ec6-9aed-39d3-9a6d-5755b47d6520",
                    "sense_definition": "An extremely fun and exciting experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every night with you is a <w>movie</w>!",
                            "target_lang_translations": {
                                "ru": "Каждая ночь с тобой — это просто <w>кино</w>!",
                                "zh": "和你在一起的每个夜晚都<w>像电影一样</w>精彩！"
                            }
                        },
                        {
                            "text": "The party last night was a total <w>movie</w> because everyone was dancing.",
                            "target_lang_translations": {
                                "ru": "Вчерашняя вечеринка была как в <w>кино</w>, потому что все танцевали.",
                                "zh": "昨晚的派对简直<w>像电影一样</w>，因为每个人都在跳舞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "life is a movie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно веселое, захватывающее или драматичное событие (сленг).",
                        "zh": "一种极其有趣、令人兴奋或戏剧性的经历（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "в значении «что-то невероятное»"
                            },
                            {
                                "target_lang_word": "сказка",
                                "target_lang_sense_clarification": "волшебное событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像电影一样",
                                "target_lang_sense_clarification": "形容经历非常精彩或戏剧化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f263020-59c3-3ebc-b0ea-5b734e14daf2",
                    "sense_definition": "Any event, especially one that is unpleasant or tiresome.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry; this isn't the first time I've been through this <w>movie</w>.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, я не первый раз прохожу через эту <w>историю</w>.",
                                "zh": "别担心，这已经不是我第一次经历这种<w>戏码</w>了。"
                            }
                        },
                        {
                            "text": "We have seen this <w>movie</w> before and we know exactly how it ends.",
                            "target_lang_translations": {
                                "ru": "Мы уже видели это <w>кино</w> раньше и точно знаем, чем оно закончится.",
                                "zh": "我们以前见过这种<w>戏码</w>，而且完全知道它会如何收场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "seen this movie before"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие или ситуация, особенно неприятная, утомительная или повторяющаяся.",
                        "zh": "指某种事件或情况，尤指令人不快、厌烦或重复发生的事情（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "история",
                                "target_lang_sense_clarification": "ситуация, случай"
                            },
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "наблюдаемая ситуация"
                            },
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "иронично о ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏码",
                                "target_lang_sense_clarification": "指重复出现的某种情况或套路"
                            },
                            {
                                "target_lang_word": "经历",
                                "target_lang_sense_clarification": "指所遭遇的事情"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}