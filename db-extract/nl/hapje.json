                                    {
                                        "sense_id": "5a38d706-9d76-33d5-bcaa-ba5538cec9af",
                                        "entry_id": "1b445535-1656-3c5b-915e-2704f83e35e8",
                                        "glosses": [
                                            "eine kleine Mahlzeit, die zwischen den Hauptmahlzeiten gegessen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3013a91c-aed6-418d-be34-87ff443fc15c",
                                                "sense_id": "5a38d706-9d76-33d5-bcaa-ba5538cec9af",
                                                "text": "Am Nachmittag nimmt sie eine Zwischenmahlzeit zu sich."
                                            },
                                            {
                                                "example_id": "40536be7-a36e-4df2-8917-9487aee48376",
                                                "sense_id": "5a38d706-9d76-33d5-bcaa-ba5538cec9af",
                                                "text": "Eine kleine Zwischenmahlzeit hält bei Laune."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e281b1f-cae4-46e0-b892-c20f21d2af60",
                        "source_entry_id": "d66e13f6-613c-3890-8bb5-8f3a85a71bea",
                        "source_sense_id": "874526f5-3ad7-3ce5-a7dc-30bfd260bd3e",
                        "source_sense_description": "(voeding) (kookkunst) klein gerechtje",
                        "target_lang_word": "Imbiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imbiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                        "entry_id": "eecbfc57-9765-3108-b7c4-9b470dba855e",
                                        "glosses": [
                                            "eine kurze Mahlzeit außerhalb der Hauptmahlzeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d250b401-dbb9-49fc-91dc-f7583e5a4155",
                                                "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                                "text": "Auf der Veranda nahmen sie einen kleinen Imbiss ein."
                                            },
                                            {
                                                "example_id": "b3bf4bb2-2534-4e02-9b9b-280a6384e1f4",
                                                "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                                "text": "„Tischchen mit Imbissen wurden aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                        "entry_id": "eecbfc57-9765-3108-b7c4-9b470dba855e",
                                        "glosses": [
                                            "Stand, Kantine, Kiosk oder Stube, wo man eine kleine Zwischenmahlzeit^([1]) kaufen und einnehmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647b0840-2df2-449c-9043-b2e9907143f7",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "Lass uns mal eben zum Imbiss gehen!"
                                            },
                                            {
                                                "example_id": "dea258a5-452c-4135-b849-763b970cf03d",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Die Tür von Henrys Imbiss ging auf, und zwei Männer kamen herein.“"
                                            },
                                            {
                                                "example_id": "34e98f89-7ce7-460c-96d6-39e268d1bc50",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Gegenüber ihrer Stammkneipe gab es einen kleinen vietnamesischen Imbiss.“"
                                            },
                                            {
                                                "example_id": "7ebe4cd9-eb3d-4b1b-99b8-52775373e2f6",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Aldís zog die Nase hoch, schnäuzte sich, suchte Zuflucht im Imbiss des Ladens, wo sie einen Hotdog bestellte, aber gar keinen Hunger verspürte und das Würstchen nach dem ersten Bissen in die Tonne warf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0e89e85-d310-49c8-afb6-e3c31c3d4c76",
                        "source_entry_id": "d66e13f6-613c-3890-8bb5-8f3a85a71bea",
