                "translations": [
                    {
                        "translation_id": "c621e46b-aaf7-4c84-8234-fe44144dfb6f",
                        "source_entry_id": "2a09e852-a3a5-3294-a76b-6c0d24dcbc00",
                        "source_sense_id": "2ab81843-1320-39ee-b368-1b0d55ced146",
                        "target_lang_word": "premise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "535322e4-904b-3bba-8d82-80ec0b0be62b",
                                        "entry_id": "e82913b0-58ae-3433-b372-5c9d3d167441",
                                        "glosses": [
                                            "A proposition antecedently supposed or proved; something previously stated or assumed as the basis of further argument; a condition; a supposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1d72b0-67c8-460e-be69-81ff68f9f492",
                                                "sense_id": "535322e4-904b-3bba-8d82-80ec0b0be62b",
                                                "text": "The premises observed,\nThy will by my performance shall be served."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00dff461-6a96-32b2-9429-00020785d7c4",
                                        "entry_id": "e82913b0-58ae-3433-b372-5c9d3d167441",
                                        "glosses": [
                                            "Any of the first propositions of a syllogism, from which the conclusion is deduced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94d42af-61d5-44e2-8bbc-af9d307519ee",
                                                "sense_id": "00dff461-6a96-32b2-9429-00020785d7c4",
                                                "text": "While the premises stand firm, 'tis impossible to shake the conclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065f6bfa-3309-3749-80c3-fcc573041939",
                                        "entry_id": "e82913b0-58ae-3433-b372-5c9d3d167441",
                                        "glosses": [
                                            "Matters previously stated or set forth; especially, that part in the beginning of a deed, the office of which is to express the grantor and grantee, and the land or thing granted or conveyed, and all that precedes the habendum; the thing demised or granted."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a86142be-fca9-3864-8bda-33bf7ad77ba4",
                                        "entry_id": "e82913b0-58ae-3433-b372-5c9d3d167441",
                                        "glosses": [
                                            "A piece of real estate; a building and its adjuncts."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54927bb8-0c6e-4526-b825-13ee5fcd66eb",
                                                "sense_id": "a86142be-fca9-3864-8bda-33bf7ad77ba4",
                                                "text": "trespass on another’s premises"
                                            },
                                            {
                                                "example_id": "45191af9-3768-43e6-a101-a4a75e03c8cb",
                                                "sense_id": "a86142be-fca9-3864-8bda-33bf7ad77ba4",
                                                "text": "On the premises is a beautiful lawn, well stocked with flowering shrubs; hard and soft water."
                                            },
                                            {
                                                "example_id": "df475d3a-b39e-42f1-b802-1a60f80e569f",
                                                "sense_id": "a86142be-fca9-3864-8bda-33bf7ad77ba4",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f7a08a-c310-31a4-839b-b361c90e2e0c",
                                        "entry_id": "e82913b0-58ae-3433-b372-5c9d3d167441",
                                        "glosses": [
                                            "The fundamental concept that drives the plot of a film or other story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44c6f00-b3d9-41cd-9aca-49627f18d57d",
                                                "sense_id": "f0f7a08a-c310-31a4-839b-b361c90e2e0c",
                                                "text": "In 1949, the simple premise of discovering ordinary people who have hidden, extraordinary talents came to prominence in the UK with Opportunity Knocks, which started out as a nationwide touring radio show, before moving onto TV in 1956."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "premise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0417a6e-5b23-3a36-9ffc-7114a82bbc65",
                                        "entry_id": "17e1509f-3126-3d1d-9277-1f3106656448",
                                        "glosses": [
                                            "To state or assume something as a proposition to an argument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8842b5ac-ca73-3b31-bb17-aecc3126db96",
                                        "entry_id": "17e1509f-3126-3d1d-9277-1f3106656448",
                                        "glosses": [
                                            "To make a premise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d04826e0-6300-3d40-b68f-617819f0d18e",
                                        "entry_id": "17e1509f-3126-3d1d-9277-1f3106656448",
                                        "glosses": [
                                            "To set forth beforehand, or as introductory to the main subject; to offer previously, as something to explain or aid in understanding what follows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae19e97-c2e0-4fa1-b489-f57e91654ecc",
                                                "sense_id": "d04826e0-6300-3d40-b68f-617819f0d18e",
                                                "text": "I premise these particulars that the reader may know that I enter upon it as a very ungrateful task."
                                            },
                                            {
                                                "example_id": "32e63f3c-632f-4da7-bc20-d7a89b86663a",
                                                "sense_id": "d04826e0-6300-3d40-b68f-617819f0d18e",
                                                "text": "Having premised thus much, we will now detain those who like our bill of fare no longer from their diet, and shall proceed directly to serve up the first course of our history for their entertainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72aabeee-7aab-32c3-99ce-d922927fb44b",
                                        "entry_id": "17e1509f-3126-3d1d-9277-1f3106656448",
                                        "glosses": [
                                            "To send before the time, or beforehand; hence, to cause to be before something else; to employ previously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "718d3308-f5ed-434c-9be4-dcef6049757b",
                                                "sense_id": "72aabeee-7aab-32c3-99ce-d922927fb44b",
                                                "text": "the premised flames of the last day"
                                            },
                                            {
                                                "example_id": "7b6c8ebb-0cfe-4acc-a1c8-1554465397a6",
                                                "sense_id": "72aabeee-7aab-32c3-99ce-d922927fb44b",
                                                "text": "1794–1796, Erasmus Darwin, Zoonomia\nif venesection can be previously performed, even to but few ounces, the effect of the opium is much more certain; and still more so, if there be time to premise a brisk cathartic, or even an emetic"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
