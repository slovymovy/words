                "senses": [
                    {
                        "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                        "entry_id": "891b7af4-a47b-34a2-93fd-36168786651b",
                        "glosses": [
                            "Elektronenröhre bestehend aus Fotokatode und Elektronenvervielfacher zum Nachweis und zur Messung schwacher Lichtsignale"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "bde1babf-aa93-4643-aece-b68c185c4221",
                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                "text": "„Die Lichtblitze werden dann von dem Fotovervielfacher erfaßt, der Spannungsimpulse erzeugt, deren Größe der Stärke der entsprechenden Lichtblitze proportional ist.“"
                            },
                            {
                                "example_id": "474fea14-9797-449e-9ea1-c530460ade08",
                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                "text": "„Die Potentiale an den einzelnen Dynoden müssen vor der ersten Inbetriebnahme eines neuen Fotovervielfachers kontrolliert und eingestellt werden.“"
                            },
                            {
                                "example_id": "56d78e2c-e52a-410f-815e-671bcb93cfd3",
                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                "text": "„Das Fenster eines Fotovervielfachers ist die für den Strahlungseintritt vorgesehene Fläche.“"
                            },
                            {
                                "example_id": "43ce2495-76d0-42eb-b0bc-586d0c56d758",
                                "sense_id": "6aa1855b-b5fc-3542-b2dd-ea9718202f68",
                                "text": "„Der Fotovervielfacher zeigt auch bei völliger Dunkelheit bereits einen Strom, den Dunkelstrom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
