                                                "sense_id": "34d77c02-b7e7-3243-9293-7500df2ab2f8",
                                                "text": "Il rend compte de sa gestion à la fin de chaque semestre."
                                            },
                                            {
                                                "example_id": "0f18a03b-915e-42db-875e-7ac1ff830e2f",
                                                "sense_id": "34d77c02-b7e7-3243-9293-7500df2ab2f8",
                                                "text": "Le second semestre de l’année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                        "entry_id": "82e5c8f6-f005-3c6f-a9e9-63981c2cb22f",
                                        "glosses": [
                                            "Rente, traitement, etc., qui se paie par semestre, à la fin de chaque semestre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf74b2b-dcd6-40d3-ad74-014c54cc7485",
                                                "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                                "text": "Payer le semestre échu."
                                            },
                                            {
                                                "example_id": "6f533a57-d737-4620-a5b3-3966dbbe95a4",
                                                "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                                "text": "Il a touché le second semestre de sa pension."
                                            },
                                            {
                                                "example_id": "9c948069-7122-4959-b98f-46242287bc73",
                                                "sense_id": "ba195b50-2f78-3a59-9a53-8d0d1b490329",
                                                "text": "Il lui est dû un semestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76357809-8f8e-3ac7-970d-b29e7940a99a",
                                        "entry_id": "82e5c8f6-f005-3c6f-a9e9-63981c2cb22f",
                                        "glosses": [
                                            "Période de certains emplois qu’on est obligé de remplir pendant la moitié de l’année."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
