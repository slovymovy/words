        "fr-extract.jsonl": [
            {
                "entry_id": "ca33b27a-6ba0-3d1d-a545-d010bc7af075",
                "word": "hyperinflation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9eb9e120-dcc0-43db-ab63-a7b6e7bea158",
                        "entry_id": "ca33b27a-6ba0-3d1d-a545-d010bc7af075",
                        "tags": [
                            "plural"
                        ],
                        "form": "hyperinflations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                        "entry_id": "ca33b27a-6ba0-3d1d-a545-d010bc7af075",
                        "glosses": [
                            "Inflation excessive."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "268e0f33-4bfb-4fa1-aa00-c0e00c39aa81",
                                "sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                                "text": "Si la hausse du déficit budgétaire se poursuit, on va connaitre l’hyperinflation."
                            },
                            {
                                "example_id": "62acc9b4-1376-4be5-a562-f209f3c64259",
                                "sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                                "text": "La devise sombre dans l’hyperinflation et un transfert massif de richesse s’'effectue vers ceux qui ont eu la prévoyance de placer leur pouvoir d’achat dans les bons actifs avant l’incendie monétaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85f700cf-cb00-4a14-ac0c-df522303cd37",
                        "source_entry_id": "ca33b27a-6ba0-3d1d-a545-d010bc7af075",
                        "source_sense_id": "6659fcbf-5e2e-395d-ac89-289d5bcc6b68",
                        "target_lang_word": "hyperinflation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperinflation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb87e5ea-b777-3736-b6a2-0c4c4a6dc754",
                                        "entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                                        "glosses": [
                                            "Excessive inflation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40ddea24-caf0-46dd-a7cd-933b15d77b88",
                                                "sense_id": "cb87e5ea-b777-3736-b6a2-0c4c4a6dc754",
                                                "text": "hyperinflation of the lungs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                        "entry_id": "34726398-8068-3bd6-a4be-637c5bd5ea62",
                                        "glosses": [
                                            "A very high rate of inflation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f67546a7-9a72-47f2-a1da-3284a0106ff6",
                                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                                "text": "Even though ten years elapsed between the German hyperinflation of 1923 and the seizure of power by Hitler, it is often suggested that the two events are causally related."
                                            },
                                            {
                                                "example_id": "17673793-296e-45c6-9e8f-5dbb75e622c5",
                                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                                "text": "Only inconvertible paper currencies can be expanded rapidly without limit to generate hyperinflation."
                                            },
                                            {
                                                "example_id": "c7d3b1e6-e042-4c97-a09c-22383618bb04",
                                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                                "text": "When hyperinflation peaked, wheelbarrows full of money were required to shop for groceries."
                                            },
                                            {
                                                "example_id": "a41fd8f6-9c52-47b9-bcaf-3afc20ea857b",
                                                "sense_id": "7b937db8-1bed-3d6c-8f13-a9ca363b4347",
                                                "text": "Javier Milei, a far-right libertarian presidential candidate, has made “dollarizing” Argentina a signature proposal of his campaign, hailing it as a cure for the country’s hyperinflation problem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
