                        "viezerik"
                    ],
                    "common_phrases": [
                        "een vieze smeerlap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Gebruikt als afkeurend scheldwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A man with distasteful, inappropriate, or boundary-crossing sexual intentions or behavior."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "creep",
                                "target_lang_sense_clarification": "an unpleasant, weird, or sexually inappropriate person"
                            },
                            {
                                "target_lang_word": "pervert",
                                "target_lang_sense_clarification": "someone whose sexual behavior is considered abnormal or unacceptable"
                            },
                            {
                                "target_lang_word": "sleazebag",
                                "target_lang_sense_clarification": "a dirty, untrustworthy, or sexually unpleasant person"
                            }
                        ]
