                ],
                "senses": [
                    {
                        "sense_id": "03a40225-77a9-3e16-aa1a-1471e9ebedda",
                        "entry_id": "c6b8fc51-1acd-3e0e-b938-34751acd01b3",
                        "glosses": [
                            "To separate (oneself); to dissolve one's association with a person, group, or situation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d10ae393-9ba4-46bc-bef7-2e07f43ac0d9",
                                "sense_id": "03a40225-77a9-3e16-aa1a-1471e9ebedda",
                                "text": "After the scandal, the political party disassociated itself from the questionable candidate."
                            },
                            {
                                "example_id": "4deb439f-a52f-4984-a532-2b76988bcf82",
                                "sense_id": "03a40225-77a9-3e16-aa1a-1471e9ebedda",
                                "text": "If the whole membership disassociates, the result will be disestablishment."
                            },
                            {
                                "example_id": "aba21f3f-3349-46cc-a50c-ff529899bf23",
                                "sense_id": "03a40225-77a9-3e16-aa1a-1471e9ebedda",
                                "text": "Young Americans for Freedom (YAF), a group that promotes conservatism on college campuses, has kicked one of its prominent speakers, Michelle Malkin, to the curb. […] YAF did exactly the right thing by disassociating itself from Malkin for coming to Fuentes’ defense."
                            }
                        ]
                    },
                    {
                        "sense_id": "df5b9459-b4bb-3f5e-9cc9-95733bf39e8d",
                        "entry_id": "c6b8fc51-1acd-3e0e-b938-34751acd01b3",
                        "glosses": [
                            "To separate into smaller discrete units, as with analysis."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "abee11ef-6e47-48f2-8528-3174bc9a1ffb",
                                "sense_id": "df5b9459-b4bb-3f5e-9cc9-95733bf39e8d",
                                "text": "The problem is easier to understand if you disassociate the variables."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f2428be-cb40-344c-a964-177052863b23",
                        "entry_id": "c6b8fc51-1acd-3e0e-b938-34751acd01b3",
                        "glosses": [
                            "To separate; to disunite; to disintegrate; to dissolve."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ff674143-1873-4de8-9291-2f6294b80ffc",
                                "sense_id": "3f2428be-cb40-344c-a964-177052863b23",
                                "text": "The fibers of this nonwoven textile disassociated when I tried to wash it."
                            }
                        ]
                    },
                    {
                        "sense_id": "48dc00fc-5162-311a-9937-5eeee1e2cd2e",
                        "entry_id": "c6b8fc51-1acd-3e0e-b938-34751acd01b3",
                        "glosses": [
                            "Alternative form of dissociate."
                        ],
