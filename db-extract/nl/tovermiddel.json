                "senses": [
                    {
                        "sense_id": "aca10892-c7e6-3b1f-baa5-fdee08cf3932",
                        "entry_id": "93710b58-defe-35f8-b1ff-42e225cbd917",
                        "glosses": [
                            "een (genees)middel dat een bovennatuurlijke werkzaamheid heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0edf66d-4141-4dcb-a2d6-d07dd7d910dd",
                                "sense_id": "aca10892-c7e6-3b1f-baa5-fdee08cf3932",
                                "text": "Het tovermiddel is het zwarte carbon. Op diverse W14-plekken schittert de lak door afwezigheid."
                            },
                            {
                                "example_id": "8a98ef4f-fffc-4f5a-8fe8-91f702011611",
                                "sense_id": "aca10892-c7e6-3b1f-baa5-fdee08cf3932",
                                "text": "Bedenker Leefbaar Rotterdam ziet dat anders. \"Het is geen tovermiddel, maar we zien in een wijk als Bloemhof dat daar eerst 40 procent van de bewoners werk had en nu 85 procent. Dat is een mooie uitkomst, dus ik snap niet dat mensen hier tegen zijn\", zegt Leefbaar-lijsttrekker Robert Simons."
                            }
                        ]
                    },
                    {
                        "sense_id": "a474b8a9-76e3-3f2d-b22f-94707983fa17",
                        "entry_id": "93710b58-defe-35f8-b1ff-42e225cbd917",
                        "glosses": [
                            "een beschermmiddel dat helpt tegen alle ziekten en ongelukken"
                        ],
