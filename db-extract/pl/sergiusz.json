                        "source_sense_id": "8f19517c-dc98-346d-af08-fb7c8e474075",
                        "target_lang_word": "Sergius",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sergius",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecac41f0-5220-327e-b59c-ad9918822767",
                                        "entry_id": "ae9587cb-f660-3911-8a11-edba8388924b",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b732f57e-57aa-4d18-a48a-e4cb941091ef",
                                                "sense_id": "ecac41f0-5220-327e-b59c-ad9918822767",
                                                "text": "Which was with the deputy of the country, Sergius Paulus, a prudent man; who called for Barnabas and Saul, and desired to hear the word of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01b2074-0d73-475c-8a1a-8cfa63a97542",
                        "source_entry_id": "e3c8210a-9f56-3b4b-a46f-40edb2727e54",
                        "source_sense_id": "8f19517c-dc98-346d-af08-fb7c8e474075",
                        "target_lang_word": "Serge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                        "entry_id": "ee3a5e8d-3cd9-3053-8012-1b67498e43e0",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b884f1a8-1a3d-458a-88e6-e2974d92453f",
                                                "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                                "text": "Sur les ondes de la radio de Radio-Canada, Serge Bouchard nous aura longtemps accompagnés de ses histoires fascinantes sur l’Amérique."
                                            },
                                            {
                                                "example_id": "df1b4b54-6177-461b-95e1-d700e4565b8d",
                                                "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                                "text": "Elle a coanimé en 1989 avec Serge Deslongchamps le tout premier bulletin d'informations de RDS, Sports 30, la première émission diffusée par ce réseau."
                                            },
                                            {
                                                "example_id": "7c743c49-dad2-44c1-8307-616df9feae35",
                                                "sense_id": "1fe26fdc-00e6-3d46-b4f4-1fd238dcbb97",
                                                "text": "Dans son ouvrage, Philippe Gasparini retrace le chemin tortueux de ce concept dont même l’initiateur du côté francophone, Serge Doubrovsky, a modifié la définition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
