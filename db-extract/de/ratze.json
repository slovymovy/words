                                        "entry_id": "6fc8012b-1d23-30aa-9fdc-585579d5686f",
                                        "glosses": [
                                            "A scab: a worker who acts against trade union policies."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ae6ad57-a9d6-3d2f-a46a-18c6c58dfd90",
                                        "entry_id": "6fc8012b-1d23-30aa-9fdc-585579d5686f",
                                        "glosses": [
                                            "A person who routinely spends time at a particular location."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f615cbdf-ac58-44cf-b0cd-b2a506c5d202",
                                                "sense_id": "4ae6ad57-a9d6-3d2f-a46a-18c6c58dfd90",
                                                "text": "Our teenager has become a mall rat."
                                            },
                                            {
                                                "example_id": "ebaf0632-7dcd-49b0-91c3-fbf292eb672d",
                                                "sense_id": "4ae6ad57-a9d6-3d2f-a46a-18c6c58dfd90",
                                                "text": "He loved hockey and was a devoted rink rat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc5d1f54-6cb7-3004-b7e4-c41eae421b6d",
