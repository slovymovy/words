                        "glosses": [
                            "Dont une partie est encollée d’une gomme adhésive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98289cce-3866-4dc5-a3f3-af7a71fb4d1e",
                                "sense_id": "fd95f56a-5f71-3b11-9ecc-6f7407618646",
                                "text": "Pourquoi notre beau lustre est-il enfermé dans un sac de toile gommée ? On croirait une montgolfière."
                            }
                        ]
                    }
