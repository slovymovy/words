                "senses": [
                    {
                        "sense_id": "286c1dda-1d40-36ee-88e7-5e8b59e38591",
                        "entry_id": "a6687675-7bd0-3548-9ce4-3a04f7b30ed0",
                        "glosses": [
                            "Speichergerät eines Computers von dem aus das Betriebssystem gestartet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57220882-8cfd-487a-9c74-c7712cecc79f",
                                "sense_id": "286c1dda-1d40-36ee-88e7-5e8b59e38591",
                                "text": "„Falls Ihr System aber kurz nach der Festplattenerkennung behauptet, es wäre kein Bootlaufwerk vorhanden, dann ist wahrscheinlich der Bootsektor der Startpartition defekt.“"
                            },
                            {
                                "example_id": "4e4ddc54-0fdf-4d4d-bb4b-efe6965db44e",
                                "sense_id": "286c1dda-1d40-36ee-88e7-5e8b59e38591",
                                "text": "„Als Beispiel sei hier nur die Limitierung des BIOS-Partitionsschemas Master Boot Record (MBR) genannt, welches nur 4 primäre Partitionen bietet und mit Festplatten über 2 TB als Bootlaufwerk gar nicht umgehen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
