                "translations": [
                    {
                        "translation_id": "22b9e98d-61a3-4e5a-bc93-f2da14a67ee1",
                        "source_entry_id": "54b669c8-c0f9-3256-8137-e78b52a7729b",
                        "source_sense_id": "e46c4f70-2785-314c-a096-4de0fdd63b32",
                        "source_sense_description": "kindermeisje (in een huishouden)",
                        "target_lang_word": "Kindermädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindermädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                        "entry_id": "a69c2644-79c6-35d4-a8b6-1f4f721a47c7",
                                        "glosses": [
                                            "(jüngere) Frau, die als Angestellte im Haushalt einer Familie die Kinder betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f277aa-a0c8-4ff0-a43f-28afafad12d8",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "Ich finde schon das richtige Kindermädchen für meine Kinder."
                                            },
                                            {
                                                "example_id": "8097a35b-0413-42a0-80fe-1cbbdcd50429",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Meine Mutter war da bei einem Patentanwalt und spielte Haushälterin, Köchin, Kindermädchen und Waschfrau zugleich, und alles für Unterkunft, Essen, abgelegte Kleider und Dankeschön.“"
                                            },
                                            {
                                                "example_id": "b86a295a-919b-4002-b71a-66be2d068443",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Sie ging das letzte Jahr zur Schule, als meine Mutter sie einlud, Kindermädchen bei uns zu sein.“"
                                            },
                                            {
                                                "example_id": "cb40ae22-6160-48bd-85bd-31691eaab3ed",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Als ich so acht oder neun war, brannte der Hof der Eltern meines Kindermädchens ab.“"
                                            },
                                            {
                                                "example_id": "182782ed-6a54-41f8-9385-a74ee7e58b9a",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Er war reicher Eltern Kind, wie er selbst sagte, aufgewachsen zwischen Kindermädchen und Dienstboten.“"
                                            },
                                            {
                                                "example_id": "5505de53-14f2-4727-a236-89ec1bb2b469",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Ja glauben die Leute hier denn, jeder hätte ein paar Autos und ein paar Kindermädchen zur Verfügung!“"
                                            },
                                            {
                                                "example_id": "c2bd2e2d-9fe1-436a-8036-b3cb6c73ae2b",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Alle drei denken sie an das getötete Kindermädchen aus Mali, aber keine wagt es, laut darüber zu sprechen.“"
                                            },
                                            {
                                                "example_id": "e929ec27-f18a-4851-b328-7fd9d18616ea",
                                                "sense_id": "7ca8d992-eae5-30f1-941e-771e8ee5191e",
                                                "text": "„Wenn du meinen Vater nach seiner Zeit als Kindermädchen fragst, wird er dir zuallererst erzählen, wie oft ich früher weggelaufen bin, mit vier, fünf Jahren schon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
