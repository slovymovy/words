                "senses": [
                    {
                        "sense_id": "c418226d-0942-33e9-a5c9-df8da6108a52",
                        "entry_id": "e98a8d9d-0bae-35f6-97aa-25af84c71c98",
                        "glosses": [
                            "техн. осуществляющий кокономотание либо имеющий к этому технологическому процессу прямое отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ccbe5a-ef88-4d83-9fbd-58aa42a919c2",
                                "sense_id": "c418226d-0942-33e9-a5c9-df8da6108a52",
                                "text": "Ежегодно кокономотальный цех подвергает переработке 500 тонн коконов шелка-сырца, производит 160 тонн высококачественного шелка."
                            },
                            {
                                "example_id": "5c6c5446-40e1-497d-a602-53a63e1cabfa",
                                "sense_id": "c418226d-0942-33e9-a5c9-df8da6108a52",
                                "text": "Кокономотальное оборудование."
                            },
                            {
                                "example_id": "b5946aab-78be-4ec9-b32c-17b6a7e18695",
                                "sense_id": "c418226d-0942-33e9-a5c9-df8da6108a52",
                                "text": "Кокономотальная машина."
                            }
                        ]
                    }
