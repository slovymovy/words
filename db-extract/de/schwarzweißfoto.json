                "senses": [
                    {
                        "sense_id": "09787eb2-66bc-3e6c-87b6-1c9232959252",
                        "entry_id": "04dce639-34e8-3d89-8b41-5df5dbee2f55",
                        "glosses": [
                            "Foto, das nur Helligkeitstöne zwischen Schwarz und Weiß, aber keine Farben wiedergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f3b1d4-d15f-4c03-bec3-175da6032ead",
                                "sense_id": "09787eb2-66bc-3e6c-87b6-1c9232959252",
                                "text": "„Bis heute sind nur eine Handvoll Schwarzweißfotos von Turing bekannt, die aber kaum Einblick in sein Privatleben geben.“"
                            },
                            {
                                "example_id": "ba918f8b-056e-45ed-ae8c-589ccbb976bf",
                                "sense_id": "09787eb2-66bc-3e6c-87b6-1c9232959252",
                                "text": "„Als der Zweite Weltkrieg in meiner Oberschule auf dem Lehrplan stand, holte meine elsässische Großmutter einen Packen Schwarzweißfotos aus einer Schublade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
