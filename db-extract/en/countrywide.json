                        "examples": [
                            {
                                "example_id": "89536b41-a496-4f7f-9f58-08f40937fc56",
                                "sense_id": "a3a3dbd4-2a75-3660-9026-417db2e5b6d8",
                                "text": "In order to provide for a large measure of rail participation in countrywide collection and delivery of small consignments—a task they were never particularly well suited to do, and which they did only because the horse and cart were worse—the railways sacrificed their main advantages."
                            },
                            {
                                "example_id": "9d93a3d6-99f9-45a6-8ba3-a14481ae51c2",
                                "sense_id": "a3a3dbd4-2a75-3660-9026-417db2e5b6d8",
                                "text": "Sure of his superiority, Chiang launched a countrywide offensive to establish his supremacy. In October, his troops occupied the important North China city of Changchiakou (Kalgan) and a number of other cities evacuated by the People's Liberation Army in accordance with its strategy of not holding cities but concentrating on wiping out enemy troops."
                            }
                        ]
                    }
