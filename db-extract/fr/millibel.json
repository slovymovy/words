                "senses": [
                    {
                        "sense_id": "a0fc724a-2928-32a1-9af3-57d897c66331",
                        "entry_id": "903cb52f-99f7-3977-8f9b-a7364a7b779b",
                        "glosses": [
                            "Unité de mesure de grandeurs logarithmiques du Système international (SI), valant 10⁻³ bel, et dont le symbole est mB."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "521653fe-12c1-475f-bcfb-a17198a88cb2",
                                "sense_id": "a0fc724a-2928-32a1-9af3-57d897c66331",
                                "text": "Le millibel exprime les rapports entre grandeurs de même espèce : 1000 millibels signifient un rapport dont le logarithme décimal est l’unité (10³ mB → 10:1) ; un millibel signifie un rapport dont le logarithme décimal vaut 10⁻³ (1 mB → 10^(0,001):1 ≈ 1,002 305:1)."
                            },
                            {
                                "example_id": "6ae28c35-1624-40de-8eac-7cfe004b3bb7",
                                "sense_id": "a0fc724a-2928-32a1-9af3-57d897c66331",
                                "text": "Le câble fabriqué est stabilisé en température (10°C ± 0,1 °C) afin de pouvoir mesurer à la pression atmosphérique, l’affaiblissement avec une très grande précision (mieux que le millibel)."
                            }
                        ]
                    }
