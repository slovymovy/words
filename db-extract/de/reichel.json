                ],
                "senses": [
                    {
                        "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                        "entry_id": "7ecfbf09-1066-3757-ab82-0cef0741b4e3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8036b8-e762-41fc-9ac4-c1fca8e73f45",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Frau Reichel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "46b9c020-fa81-4cc1-816b-0b49e74c74de",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Herr Reichel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "397af2e7-6165-41e2-be1c-94508256ae7d",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Die Reichels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1fd1901c-b8c8-4196-8f83-ed2d3ad20aaa",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Der Reichel trägt nie die Schals, die die Reichel ihm strickt."
                            },
                            {
                                "example_id": "316d2c86-7c28-46ed-8087-1999dadc1857",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reichel kommt, geht der Herr Reichel.“"
                            },
                            {
                                "example_id": "40d10e84-aaea-41e1-ab7e-79c88afc05d6",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Reichel kommt und geht."
                            },
                            {
                                "example_id": "ac5e40c2-5800-47bc-ad04-44a3dbe3a820",
                                "sense_id": "21adc089-d639-3e78-9c86-cf1ec7feb292",
                                "text": "Reichels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
