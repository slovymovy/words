                "senses": [
                    {
                        "sense_id": "5cb0fd3d-c703-35c8-9281-75359b8c5357",
                        "entry_id": "70aa781e-529c-31d4-91e7-8ab815150ae7",
                        "glosses": [
                            "небольшая, подвижная больница при войсковой части, в местах лишения свободы и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a95d89-0749-410e-8b37-ba91eab34dc6",
                                "sense_id": "5cb0fd3d-c703-35c8-9281-75359b8c5357",
                                "text": "Полковой лазарет."
                            },
                            {
                                "example_id": "01c76370-575f-4f17-92e4-1e4ac3baf3cd",
                                "sense_id": "5cb0fd3d-c703-35c8-9281-75359b8c5357",
                                "text": "Походный лазарет."
                            },
                            {
                                "example_id": "b9f83bd2-19ef-4c1f-9dfa-21079f48b41a",
                                "sense_id": "5cb0fd3d-c703-35c8-9281-75359b8c5357",
                                "text": "Лечь в лазарет."
                            }
                        ]
                    },
                    {
                        "sense_id": "284cea92-d975-3be2-b5ce-2525e8a96ae2",
                        "entry_id": "70aa781e-529c-31d4-91e7-8ab815150ae7",
                        "glosses": [
                            "устар. больница при каком-нибудь общежитии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f45b3c2-4885-499e-85aa-8a005bf4983b",
                                "sense_id": "284cea92-d975-3be2-b5ce-2525e8a96ae2",
                                "text": "В лазарете лепешкинского общежития, на Зубовском бульваре, находятся на излечении Глеб Виталиевич Цетнерский и его жена, Елена Константиновна Цетнерская."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c4fecc8-f9c3-48e4-88ea-a5ad6d56e08e",
                        "source_entry_id": "70aa781e-529c-31d4-91e7-8ab815150ae7",
                        "target_lang_word": "hospital",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                        "entry_id": "5fa140a8-dce7-33f9-b766-3fff1c8acdba",
                                        "glosses": [
                                            "A large medical facility, usually in a building with multiple floors, where seriously ill or injured patients are given extensive medical or surgical treatment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5fd76b0-2e9e-4f5e-827a-d9282fb554f1",
                                                "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                                "text": "Luckily an ambulance arrived quickly and he was rushed to hospital."
                                            },
                                            {
                                                "example_id": "ed5e6196-d474-416e-8e51-7dfb3308e1b5",
                                                "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                                "text": "Luckily an ambulance arrived quickly and he was rushed to the hospital."
                                            },
                                            {
                                                "example_id": "4bd40bbf-da3a-4080-8c58-529266bce619",
                                                "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                                "text": "This section of the Act gives the court powers to assess whether treatment is going to be beneficial and hence whether hospital is a suitable disposal option."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8b42017-7fe7-3e4c-8e2a-7e42ae70504f",
                                        "entry_id": "5fa140a8-dce7-33f9-b766-3fff1c8acdba",
                                        "glosses": [
                                            "A building founded for the long-term care of its residents, such as an almshouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ba4618-0209-4a59-8136-8d14f6b3d4a2",
                                                "sense_id": "f8b42017-7fe7-3e4c-8e2a-7e42ae70504f",
                                                "text": "The foundling hospital took in abandoned children and educated them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a329a518-323f-3933-a98a-8939ae5f0c7c",
                                        "entry_id": "5fa140a8-dce7-33f9-b766-3fff1c8acdba",
                                        "glosses": [
                                            "A place of lodging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8c8c33-40b9-4253-b6cb-a8d9f46172e8",
                                                "sense_id": "a329a518-323f-3933-a98a-8939ae5f0c7c",
                                                "text": "[…] they spide a goodly castle, plast / Foreby a riuer in a pleasaunt dale, / Which choosing for that euenings hospitale, / They thither marcht […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hospital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86dd84c6-3740-3134-9c10-4d6561a7e26f",
                                        "entry_id": "501a7e4e-2fb4-3a85-8b73-6c5566bbd591",
                                        "glosses": [
                                            "Hospitable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b472619-4f79-4dbd-80a1-cf74ab87bf8e",
                                                "sense_id": "86dd84c6-3740-3134-9c10-4d6561a7e26f",
                                                "text": "At last the Ocean, that hospital friend to the wretched, opened her capacious arms to receive him; and he instantly resolved to accept her kind invitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f932dc03-abac-43c0-a6ea-77babfaade58",
