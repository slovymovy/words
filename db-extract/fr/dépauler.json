                "senses": [
                    {
                        "sense_id": "588deb5d-4ace-3cd2-9dc7-ddf5cd4f16c6",
                        "entry_id": "188c16ed-8531-35aa-b351-78024ed611a1",
                        "glosses": [
                            "Enlever l’arme de l’épaule, ne plus épauler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9be418b6-0c33-44c8-9cda-f0061130ad99",
                                "sense_id": "588deb5d-4ace-3cd2-9dc7-ddf5cd4f16c6",
                                "text": "Le déplacement de la main étant très petit, on peut facilement tirer le contenu du magasin sans dépauler l’arme, soit qu’on se trouve debout, soit à genoux ou couché ; l’arme reste donc pendant toute la durée du tir dans la direction de l’objectif."
                            },
                            {
                                "example_id": "05c4185a-402a-41a7-bd91-2809bf95d9bd",
                                "sense_id": "588deb5d-4ace-3cd2-9dc7-ddf5cd4f16c6",
                                "text": "Quant au déplacement du centre de gravité, cet inconvénient est plus que compensé par la plus grande précision qui résulte d’un tir de plusieurs balles exécuté sans dépauler."
                            }
                        ]
                    },
                    {
                        "sense_id": "71f98050-1d3a-38d9-ac88-76e71726c698",
                        "entry_id": "188c16ed-8531-35aa-b351-78024ed611a1",
                        "glosses": [
                            "Couper une épaule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a5f893-f5f2-4a7e-8c03-da35a4aac849",
                                "sense_id": "71f98050-1d3a-38d9-ac88-76e71726c698",
                                "text": "« Dépaulez ! » et voilà le carré de côtes séparé des épaules, « Tire filet ! » et voilà celui-ci séparé de la cuisse."
                            },
                            {
                                "example_id": "dce44720-56da-4a4a-b727-ed33e37d786a",
                                "sense_id": "71f98050-1d3a-38d9-ac88-76e71726c698",
                                "text": "Si je n’étois chrétien, Commandeur effronté, Je t’aurois dépaulé, décuissé, détêté."
                            }
                        ]
                    }
