{
    "word_family": [
        "condition",
        "conditionnel",
        "conditionnement",
        "inconditionnel",
        "préconditionner",
        "reconditionner",
        "reconditionnement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b7920e13-278c-3b24-a6c6-321e1a22e090",
                    "sense_definition": "Déterminer de façon décisive le déroulement, l'évolution ou l'issue de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La météo et les récoltes vont <w>conditionner</w> le succès de notre projet agricole."
                        },
                        {
                            "text": "Les résultats financiers du premier trimestre <w>conditionnent</w> directement les choix de la direction."
                        }
                    ],
                    "synonyms": [
                        "déterminer",
                        "influencer"
                    ],
                    "common_phrases": [
                        "conditionner le succès",
                        "conditionner les choix"
                    ]
                },
                {
                    "sense_id": "0617f677-f6da-3e91-91d7-1c3941ae8219",
                    "sense_definition": "Faire dépendre la réalisation ou la validité de quelque chose d'une condition préalable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre préfère <w>conditionner</w> son accord à une réforme complète du système éducatif."
                        },
                        {
                            "text": "La banque accepte de prêter cette somme mais va <w>conditionner</w> son aide à des garanties solides."
                        }
                    ],
                    "synonyms": [
                        "subordonner"
                    ],
                    "common_phrases": [
                        "conditionner son accord"
                    ]
                },
                {
                    "sense_id": "5cf930b2-8a91-3902-be3b-536dfc269ac8",
                    "sense_definition": "Emballer et préparer des produits en vue de leur transport, de leur conservation ou de leur vente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle machine permet de <w>conditionner</w> sous vide des aliments frais."
                        },
                        {
                            "text": "Les employés de l'usine doivent <w>conditionner</w> des produits dans des cartons sécurisés."
                        }
                    ],
                    "synonyms": [
                        "emballer"
                    ],
                    "common_phrases": [
                        "conditionner sous vide",
                        "conditionner des produits"
                    ]
                },
                {
                    "sense_id": "51337d41-5582-32be-bac2-bc4fd8732476",
                    "sense_definition": "Influencer durablement le comportement, les pensées ou les réflexes d'un individu par des stimuli répétés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les campagnes publicitaires peuvent facilement <w>conditionner</w> les esprits des jeunes consommateurs."
                        },
                        {
                            "text": "L'entraîneur a su <w>conditionner</w> ses joueurs pour affronter la pression de la finale."
                        }
                    ],
                    "synonyms": [
                        "endoctriner",
                        "formater"
                    ],
                    "common_phrases": [
                        "conditionner les esprits"
                    ]
                }
            ]
        }
    ]
}