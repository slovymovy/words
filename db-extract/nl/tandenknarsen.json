                        "source_entry_id": "447609a7-ee5a-33f4-8293-689bebcc2a32",
                        "source_sense_id": "cc45a670-41a7-3cea-9573-e1754de2eae9",
                        "source_sense_description": "knarsen met de tanden",
                        "target_lang_word": "grincer des dents",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grincer des dents",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "063d0433-49fe-3212-8e9d-8b2dc191c7ea",
                                        "entry_id": "d0b77944-59b5-3952-8eeb-726d5acc3eb9",
                                        "glosses": [
                                            "Ressentir de l’agacement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923eb54c-9730-4fd3-85d1-0fddd0896b44",
                                                "sense_id": "063d0433-49fe-3212-8e9d-8b2dc191c7ea",
                                                "text": "Ainsi songeait M. Bergeret dans son fauteuil. Mais les mouvements de son âme étaient si mal réglés que, tout aussitôt, il roula des yeux sanglants, grinça des dents et serra les poings jusqu’à s’enfoncer les ongles dans les paumes."
                                            },
                                            {
                                                "example_id": "26a74934-0f08-4cec-bd47-c3868baf7304",
                                                "sense_id": "063d0433-49fe-3212-8e9d-8b2dc191c7ea",
                                                "text": "Très scrutées, les « unes » de Charlie, devenu un symbole bien au-delà des frontières françaises, font souvent grincer des dents."
                                            },
                                            {
                                                "example_id": "004a50ac-5bd4-4601-8565-85f7d97ce752",
                                                "sense_id": "063d0433-49fe-3212-8e9d-8b2dc191c7ea",
                                                "text": "Même si on grince des dents en les avouant, affranchissons-nous de ce malaise !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
