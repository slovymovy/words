                                        "sense_id": "74345ae5-1c10-3939-b74a-4f78d00842d8",
                                        "entry_id": "f9ec181f-a29c-31a1-9f28-f23d053881ff",
                                        "glosses": [
                                            "Gesamtheit der Kunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e0c803-4917-4f92-b1e8-364f82bd11a8",
                                                "sense_id": "74345ae5-1c10-3939-b74a-4f78d00842d8",
                                                "text": "„Klaus Grohmann, unterstützt von Ehefrau und Sohn, hält seine Kundschaft zwar meist auf höfliche Distanz.“"
                                            },
                                            {
                                                "example_id": "7bedfef7-0092-444d-b084-29d70fc89d27",
                                                "sense_id": "74345ae5-1c10-3939-b74a-4f78d00842d8",
                                                "text": "„Der Fetischeur hatte Kundschaft.“"
                                            },
                                            {
                                                "example_id": "bb4a419f-6926-491c-a618-fdc99153c443",
                                                "sense_id": "74345ae5-1c10-3939-b74a-4f78d00842d8",
                                                "text": "„Am Wochenende nahm sie zwei oder drei Mädchen, die ihr mit der Kundschaft halfen.“"
                                            },
                                            {
                                                "example_id": "821131c0-e6fe-492d-8d49-348e6381332b",
                                                "sense_id": "74345ae5-1c10-3939-b74a-4f78d00842d8",
                                                "text": "„Und seine Kundschaft ist zufrieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfb9b592-fff9-3699-9bad-9c8505104a4d",
