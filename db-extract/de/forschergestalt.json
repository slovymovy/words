                "senses": [
                    {
                        "sense_id": "f662a8da-4437-3208-bde4-90d3d856802a",
                        "entry_id": "7b99e585-d693-3f2c-9e7b-1a677db60c94",
                        "glosses": [
                            "Persönlichkeit (physische Erscheinung und/oder geistige Potenz) eines Forschers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18168b1c-bce8-412d-9aad-cb0510d0e963",
                                "sense_id": "f662a8da-4437-3208-bde4-90d3d856802a",
                                "text": "„Vielmehr binden sie bevorzugt mit dem Kunstgriff der »Personalisierung«, das heißt einer betonten Herausstellung der menschlichen Seiten, ihren eigentlichen, belehrenden Stoff an Forschergestalten und deren Schicksale, an den konkreten Hergang von Entdeckungen, Forschungsarbeiten oder Erfindungen, an interessante Begleitumstände und dergleichen.“"
                            },
                            {
                                "example_id": "1b36721d-6bf8-404d-9f7d-811ca767b75f",
                                "sense_id": "f662a8da-4437-3208-bde4-90d3d856802a",
                                "text": "„Die Fortschritte der Astronomie wurden meist durch herausragende Forschergestalten erzielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
