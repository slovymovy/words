                    "sense_definition": "Heavily immersed in Internet culture and trends.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is very <w>online</w> and knows about every new meme immediately.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>сидит в интернете</w> и узнает о каждом новом меме мгновенно.",
                                "pl": "On ciągle <w>siedzi w sieci</w> i natychmiast dowiaduje się o każdym nowym memie."
                            }
                        },
                        {
                            "text": "You are too <w>online</w>; you need to go outside and take a break.",
                            "target_lang_translations": {
                                "ru": "Ты слишком много <w>в сети</w>; тебе нужно выйти на улицу и отдохнуть.",
                                "pl": "Zbyt dużo czasu spędzasz <w>w internecie</w>; musisz wyjść na zewnątrz i odpocząć."
                            }
                        }
