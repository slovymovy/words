                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d6db9a5e-f029-4407-ba50-2ad22cf23347",
                        "entry_id": "8c8bb214-91ce-3a00-8f2f-59d6d78858b9",
                        "tags": [
                            "plural"
