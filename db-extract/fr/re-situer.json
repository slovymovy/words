                ],
                "senses": [
                    {
                        "sense_id": "308d2828-3f80-3ef8-a78f-a5ed37efcf7a",
                        "entry_id": "c0b96e24-1b1d-3c2f-acd6-15a6cc3fee91",
                        "glosses": [
                            "Situer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d291a57-69c8-415f-9f4c-0484d188d0aa",
                                "sense_id": "308d2828-3f80-3ef8-a78f-a5ed37efcf7a",
                                "text": "Mais il existe aussi des groupes difficiles qui nous demandent de passer beaucoup plus de temps à parler, à re-situer les limites, à ré-instaurer des échanges vivants et non destructeurs."
                            },
                            {
                                "example_id": "6c55fd13-2f1c-4c12-a21f-ee9869a99d8c",
                                "sense_id": "308d2828-3f80-3ef8-a78f-a5ed37efcf7a",
                                "text": "En mettant l’accent sur les engagements individuels et les raisons d’agir, on oublie de les re-situer dans leur contexte sociopolitique (recomposition des actions de l’État social, fort développement des associations caritatives…)."
                            }
                        ]
                    }
                ],
