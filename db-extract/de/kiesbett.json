                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e1a49f-3b3a-42e1-985b-79cf0c852057",
                                "sense_id": "4669814c-5594-3975-81f1-b95219760804",
                                "text": "„Er knallte in ein Kiesbett und gab ein Stöhnen von sich.“"
                            },
                            {
                                "example_id": "f09798ae-2e4f-45c3-a40d-8eb9684dc186",
                                "sense_id": "4669814c-5594-3975-81f1-b95219760804",
                                "text": "„So wie hier. Wo er Wasser hörte. Wo er nichts bewegen konnte. Wo er ausgestreckt auf einem kalten Kiesbett lag und ewig in den Himmel starrte.“"
                            }
                        ],
