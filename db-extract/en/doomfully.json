                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eef5ecf-c027-4695-a1e7-e7b21c4bcaa6",
                                "sense_id": "5786f11b-057e-309a-8cc8-0cc001461744",
                                "text": "And high above me now the bridge seemed to move of to where I could not see, striding like a robot, an iron man, whose iron legs clanged doomfully as it moved."
                            },
                            {
                                "example_id": "b675b2bd-f660-487c-bb5f-a9647ca5aa47",
                                "sense_id": "5786f11b-057e-309a-8cc8-0cc001461744",
                                "text": "But the old fisherman who followed her up the stairs again shook his head doomfully. \"There's no use trying to hold them off,\" he said. \"They'll just ram in the door. Then they'll slaughter the lot of us. I know them.\""
                            },
                            {
                                "example_id": "2e274341-c697-4b4c-b421-ee4c9b56fc23",
                                "sense_id": "5786f11b-057e-309a-8cc8-0cc001461744",
                                "text": "[T]he artist Richard Serra once stood at the corner of Broadway and Spring Street and doomfully predicted to the museum curator Marcia Tucker that \"one day this will all be boutiques.\""
                            }
                        ]
                    }
