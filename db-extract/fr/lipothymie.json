                        "entry_id": "de8fa12b-ea03-35f9-84ff-b62692aa3195",
                        "glosses": [
                            "Malaise sans perte de connaissance, ou avec perte de connaissance partielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14411b03-d2a0-4aa1-ab86-822c15c7f159",
                                "sense_id": "79635ebc-a205-34d8-9d37-99c2427acc39",
                                "text": "Une lipothymie est la sensation d’une perte de connaissance imminente... mais finalement sans en arriver jusqu’à la chute au sol."
                            },
                            {
                                "example_id": "8abee22c-60a9-42bf-a307-3281779b71a8",
                                "sense_id": "79635ebc-a205-34d8-9d37-99c2427acc39",
                                "text": "Plus rarement, il existe des troubles cardiaques très marqués : petitesse et fréquence extrême du pouls, lipothymies et syncopes."
                            }
                        ]
                    }
                ],
