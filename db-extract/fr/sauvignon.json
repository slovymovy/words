                "senses": [
                    {
                        "sense_id": "837513dc-3a39-3273-a1aa-de0deea3c910",
                        "entry_id": "2557b8f1-423a-3620-b8c4-b78435c1c52e",
                        "glosses": [
                            "Cépage de Charente et du Bordelais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "671acb30-9107-45c6-8629-9218ee1b875a",
                                "sense_id": "837513dc-3a39-3273-a1aa-de0deea3c910",
                                "text": "Une cuvée originale à base de cépages locaux, le sémillon en sélection massale et le sauvignon, mais également avec 20 % de chenin, cépage ligérien planté récemment."
                            },
                            {
                                "example_id": "a29939ee-49d6-4521-94bd-78d03658633f",
                                "sense_id": "837513dc-3a39-3273-a1aa-de0deea3c910",
                                "text": "A Sancerre et dans ses environs — Pouilly-Fumé, Menetou-Salon, Reuilly, Quincy — les vins sont exclusivement issus du cépage Sauvignon, planté sur un sol très dur de calcaire, identique à celui de la Champagne. Et comme là-bas, idéal pour la production de grands vins blancs."
                            },
                            {
                                "example_id": "fc078e36-659b-4762-a35e-d1e769b0d301",
                                "sense_id": "837513dc-3a39-3273-a1aa-de0deea3c910",
                                "text": "Dans la production des vins blancs, en plus du sauvignon, du colombard ou du chardonnay, nous utilisons du chauché, poursuit le viticulteur. C’est un vieux cépage qui était employé au Moyen Âge et qui a été remis au goût du jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "e088c499-00fe-363a-975d-0cba6eb526b0",
                        "entry_id": "2557b8f1-423a-3620-b8c4-b78435c1c52e",
                        "glosses": [
                            "Vin produit à partir de ce cépage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
