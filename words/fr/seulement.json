{
    "word_family": [
        "seul",
        "solitude",
        "solitaire",
        "esseuler"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "968650b6-08eb-3227-a913-59cb5fda0cb7",
                    "sense_definition": "De façon exclusive, sans rien ni personne d'autre ; uniquement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>seulement</w> dix euros dans mon portefeuille pour acheter le repas de midi."
                        },
                        {
                            "text": "Il mange <w>seulement</w> des légumes le soir pour faciliter son sommeil."
                        }
                    ],
                    "synonyms": [
                        "uniquement",
                        "rien que"
                    ],
                    "common_phrases": [
                        "non seulement"
                    ]
                },
                {
                    "sense_id": "bc688815-fbed-3b81-8a66-95c812ba7dca",
                    "sense_definition": "Au moins ; exprime un souhait ou une exigence minimale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si <w>seulement</w> tu m'avais prévenu plus tôt, nous aurions pu partir ensemble."
                        },
                        {
                            "text": "Écoute <w>seulement</w> ce que j'ai à te dire avant de refuser mon aide."
                        }
                    ],
                    "synonyms": [
                        "au moins",
                        "du moins"
                    ],
                    "common_phrases": [
                        "si seulement"
                    ]
                },
                {
                    "sense_id": "e8a6d089-41c9-3ebc-a1d6-542b574611a8",
                    "sense_definition": "Toutefois, mais ; sert à introduire une restriction ou une objection.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet me plaît beaucoup, <w>seulement</w> nous manquons de budget pour le réaliser."
                        },
                        {
                            "text": "Elle aimerait venir avec nous, <w>seulement</w> elle doit travailler très tard ce soir."
                        }
                    ],
                    "synonyms": [
                        "toutefois",
                        "cependant",
                        "mais"
                    ]
                },
                {
                    "sense_id": "1692e5aa-cd9a-376f-b057-4efc4e3da2aa",
                    "sense_definition": "À l'instant même, tout récemment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train vient <w>seulement</w> d'entrer en gare avec vingt minutes de retard."
                        },
                        {
                            "text": "Nous commençons <w>seulement</w> à comprendre les conséquences réelles de ce choix important."
                        }
                    ],
                    "synonyms": [
                        "à l'instant",
                        "tout juste"
                    ],
                    "common_phrases": [
                        "venir seulement de"
                    ]
                },
                {
                    "sense_id": "94e51e4d-3784-32a2-b767-4b82e90d7bb1",
                    "sense_definition": "Même ; s'emploie principalement avec une négation pour marquer un degré minimal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'a pas <w>seulement</w> pensé à nous remercier après toute l'aide apportée."
                        },
                        {
                            "text": "Elle n'a pas <w>seulement</w> jeté un regard sur les documents posés sur sa table."
                        }
                    ],
                    "synonyms": [
                        "même"
                    ],
                    "common_phrases": [
                        "ne pas seulement"
                    ]
                }
            ]
        }
    ]
}