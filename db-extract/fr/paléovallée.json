                        "glosses": [
                            "Vallée dont la formation géologique remonte à des temps très anciens, il y a des centaines de milliers ou des millions d’années."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f417c5f9-309b-4208-8a7d-d46c0fba9bd9",
                                "sense_id": "8404bb5f-982e-36f8-a3f5-75dd289a146e",
                                "text": "La paléovallée de la rivière Magog."
                            },
                            {
                                "example_id": "fe0d4595-e40f-457d-9ef7-9fc4761724bc",
                                "sense_id": "8404bb5f-982e-36f8-a3f5-75dd289a146e",
                                "text": "L’étude palynologique et radiocarbone d’un carottage effectué dans les alluvions d’une paléovallée fluviatile permet de décrire, avec précision, l’évolution du paysage au cours de l’Atlantique armoricain et d’apporter de nouvelles données sur la connaissance des niveaux marins."
                            }
                        ]
