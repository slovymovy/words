                        "examples": [
                            {
                                "example_id": "1dd7e1be-b816-4370-93a5-b31d8d2e1500",
                                "sense_id": "645ec182-dac4-33d9-bd99-8e13a4defbbc",
                                "text": "An diesem Sonntag endet der Fastenmonat Ramadan, und am Montag dann beginnt das jährliche Zuckerfest. Von da an wird die Bauchspeicheldrüse zum fleißigen Sisyphos: Dem gerade mühsam gesenkten Zuckerspiegel folgt der nächste Glukose-Booster."
                            }
                        ]
                    }
