                        "glosses": [
                            "iets dat bestaat uit geknoopte draden, touwen e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c7b79f-63e0-4443-bf39-f21d1071880f",
                                "sense_id": "dbdd2c76-f270-3c38-9974-b58feaa77172",
                                "text": "Vanuit de roef had hij al gezien dat het paard zeer 'droog' was: een knoopwerk van pezen, spieren en volle aders schimmerde overal door de huid."
                            }
                        ]
                    },
                    {
                        "sense_id": "e46a7c0d-3ed9-3923-99c7-5b12e28c38c4",
                        "entry_id": "02c7a646-bca5-3a91-a045-6e94216e269e",
                        "glosses": [
                            "een ingewikkeld netwerk van relaties tussen mensen en groepen mensen"
                        ],
                        "tags": [
