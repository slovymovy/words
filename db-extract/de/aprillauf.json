                ],
                "senses": [
                    {
                        "sense_id": "ff93daec-102f-3a64-8b9d-f5a3ea2b5652",
                        "entry_id": "0c016783-313b-3846-91e8-5f964a0b9c6c",
                        "glosses": [
                            "Laufen/Joggen oder Laufveranstaltung im Monat April"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d4b231b8-0064-4475-b5ba-4d5809b28e75",
                                "sense_id": "ff93daec-102f-3a64-8b9d-f5a3ea2b5652",
                                "text": "„Beim Aprillauf war sie mit 3525 m zehn Meter besser und beim Abschlusslauf im Oktober markierte sie mit 3560 m eine hervorragende Bestmarke.“"
                            },
                            {
                                "example_id": "f7b017a2-6799-46fa-ab11-31622db21967",
                                "sense_id": "ff93daec-102f-3a64-8b9d-f5a3ea2b5652",
                                "text": "„Nachdem es bereits beim Aprillauf vier neue Alterslaufbestleistungen gegeben hat, könnten auch diesmal Bestleistungen aufgestellt werden.“"
                            },
                            {
                                "example_id": "5e369356-b337-4fbd-8162-07efb2e8d572",
                                "sense_id": "ff93daec-102f-3a64-8b9d-f5a3ea2b5652",
                                "text": "„Übrigens absolvierte der Meuselwitzer Stundenlaufsieger beim Aprillauf, wo er mit 16075 Meter eine neue persönliche Bestleistung aufstellte, seinen insgesamt 60. Lauf im Profener Stadion des Friedens.“"
                            },
                            {
                                "example_id": "4024e712-8df3-49d6-afce-3eafa80add92",
                                "sense_id": "ff93daec-102f-3a64-8b9d-f5a3ea2b5652",
                                "text": "„Henry Six aus Pegau, es war sein 98. Lauf in Profen, gewann mit 12930 Meter in der Ak 50. Rainer Bachmann (VSV 77 Borna) absolvierte gegenüber dem Aprillauf 785 Meter mehr und wurde mit 10650 Meter Sieger der Ak 40. Werner Preißner (SC Frohburg) legte 555 Meter mehr als im Auftaktlauf zurück und siegte mit 8705 Meter in der Ak 65. Joachim Bachmann aus Borna steigerte sich gegenüber dem April um 1345 Meter und belegte in der stark besetzten Ak 45 Platz zwei (12955 Meter).“"
                            },
                            {
                                "example_id": "1a6d5611-f4cb-4dc0-9a08-000bb2a71448",
                                "sense_id": "ff93daec-102f-3a64-8b9d-f5a3ea2b5652",
                                "text": "„Der Aprillauf steht heute noch aus. Hier hat es mehrfach geregnet heute und die Luft (Fenster ist auf im Büro) ist einfach himmlich. Geplannt sind ca. 10 im Schlosspark. Nichts wildes einfach wieder in Tritt kommen. Ich freu mich drauf. Micha“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
