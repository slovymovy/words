                        "glosses": [
                            "A platform where candidates in an election give speeches; a husting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65679be8-e27a-4e43-82cd-546e039ac9fa",
                                "sense_id": "698fd2b4-56fe-374a-b2f1-4db7630a0cf4",
                                "text": "I now mounted the hustings, and, without any regard to decency or modesty, made as emphatical a speech in favour of the king as before I had done against him."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb2cf2ee-9937-32e8-8861-73ec7d624e3f",
