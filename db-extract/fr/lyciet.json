                "senses": [
                    {
                        "sense_id": "db3b1927-b8ec-32a4-a6f7-59113984cced",
                        "entry_id": "a94003f0-abf2-30bb-b84d-4a89d395005e",
                        "glosses": [
                            "Arbrisseau épineux et toxique de la famille des Solanacées (genre Lycium)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63cc2833-1325-4bf8-98c5-c727c96d0888",
                                "sense_id": "db3b1927-b8ec-32a4-a6f7-59113984cced",
                                "text": "La chenille dormait peut-être, moulée selon la courbe d’une branche de lyciet. Son ravage, autour d’elle, attestait sa force."
                            },
                            {
                                "example_id": "27745b8b-3bc1-4ddd-a6dc-10cb356fcc2f",
                                "sense_id": "db3b1927-b8ec-32a4-a6f7-59113984cced",
                                "text": "Pour le médecin qui comptait élaborer les Sept Trésors pour des Cheveux de Soie, il exhumait précautionneusement de leur boîte en porcelaines bleues les radicules d’angélique, pesait les fruits de lyciet de Chine et emballait les graines de sésame."
                            },
                            {
                                "example_id": "70ee033d-8e48-4de7-806a-1d0b5b25edda",
                                "sense_id": "db3b1927-b8ec-32a4-a6f7-59113984cced",
                                "text": "Le lyciet commun sert à former des haies vives."
                            }
                        ]
                    }
                ],
