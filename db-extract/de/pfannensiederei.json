                "senses": [
                    {
                        "sense_id": "9de541cb-fe9f-3e44-8ac8-1ff7cb2af272",
                        "entry_id": "ad6b554d-75d5-3a7f-bd17-cdc66fd4512d",
                        "glosses": [
                            "Betrieb oder Betriebsteil, der aus Sole durch Verdunsten in großen Pfannen Salz gewinnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91db37bd-fcd5-4209-91f3-05ab570f6572",
                                "sense_id": "9de541cb-fe9f-3e44-8ac8-1ff7cb2af272",
                                "text": "„In einer grubeneigenen Pfannensiederei des seit dessen Erschließung im 13 Jh. ältesten ununterbrochen betriebenen Salzbergwerks Europas in Bochnia bei Krakau, wird das Floris-Salz gewonnen im traditionellem Verfahren. “"
                            },
                            {
                                "example_id": "0bb7efbb-8566-4ac5-9da0-e1dbaf0a98b7",
                                "sense_id": "9de541cb-fe9f-3e44-8ac8-1ff7cb2af272",
                                "text": "„Das naturreine Thermalsolesalz der Kneipp® Badesalze wird in Europas einzig verbliebener Pfannensiederei, der Saline Luisenhall, aus reiner Natursole gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
