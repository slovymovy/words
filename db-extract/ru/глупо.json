        "ru-extract.jsonl": [
            {
                "entry_id": "5a431833-e04d-35fd-8efc-6b0ee2556fa1",
                "word": "глупо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3463b044-d01c-3400-9fa4-979341c44b74",
                        "entry_id": "5a431833-e04d-35fd-8efc-6b0ee2556fa1",
                        "glosses": [
                            "наречие к глупый"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5eb83400-8f6f-3e79-8d9c-f45f1aaf38df",
                        "entry_id": "5a431833-e04d-35fd-8efc-6b0ee2556fa1",
                        "glosses": [
                            "оценка какой-либо ситуации, чьих-либо действий как противоречащих здравому смыслу, свидетельствующих о недостатке ума"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "04b7beb6-e568-4e8d-a794-19413ce6a111",
                                "sense_id": "5eb83400-8f6f-3e79-8d9c-f45f1aaf38df",
                                "text": "Я понимал глупое положение Кузьмы, не мог сердиться на него, потому что у него есть резоны — ведь он рассказывал мне об этих резонах, передавая деревенские впечатления, и для него было простительно искать виноватого, — но всё-таки положение его было глупо и отвратительно."
                            },
                            {
                                "example_id": "48e45bde-c082-4a95-b1af-06480ecaa0ed",
                                "sense_id": "5eb83400-8f6f-3e79-8d9c-f45f1aaf38df",
                                "text": "Авария выглядит немного глупо."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "401da125-d957-406c-9199-abd43a534479",
                        "source_entry_id": "5a431833-e04d-35fd-8efc-6b0ee2556fa1",
                        "target_lang_word": "stupidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                        "entry_id": "8a1e1b10-0c95-3d8e-a4c2-c191b8cbf843",
                                        "glosses": [
                                            "In a stupid manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd8f4e5-5e9f-4877-8a6c-f1f205cda69b",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "She was so modest, so expressive, she had looked so soft in her thin white gown that he felt he had acted stupidly."
                                            },
                                            {
                                                "example_id": "d05f7205-47ce-491a-b132-0e592d73b797",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "\"Don't we behave just as stupidly in our pursuit of happiness - don't we?\" Simpson nodded dejectedly."
                                            },
                                            {
                                                "example_id": "5d0e05f0-9b21-4a34-b7c6-6025be9b0dd3",
                                                "sense_id": "9d8b94c3-56d7-30f4-b5b2-3764dd1b04e9",
                                                "text": "As I write this, drivers' union ASLEF has announced yet another series of one-day strikes, because ministers are stupidly insisting that the modest below-inflation pay rise they have offered drivers still comes with strings attached over working conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                        "entry_id": "8a1e1b10-0c95-3d8e-a4c2-c191b8cbf843",
                                        "glosses": [
                                            "To an extreme or excessive degree; absurdly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6690e55-4632-4f57-960e-1a6c0826f602",
                                                "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                                "text": "He is so—so proud of his money, and thinks every one ought to be as stupidly rich as he is himself."
                                            },
                                            {
                                                "example_id": "5fdc3d65-7d18-4e8a-8b42-033c1b8a9787",
                                                "sense_id": "dffb0331-2f94-3b90-9b29-a862b1550e07",
                                                "text": "As well as being stupidly hungry I had a raging thirst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
