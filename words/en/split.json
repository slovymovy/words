{
    "word_family": [
        "splitter",
        "splittable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0efb74ee-4df8-3334-ac22-3463113be130",
                    "sense_definition": "To divide something into two or more parts, often along a straight line or grain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a sharp axe to <w>split</w> the logs for the fire.",
                            "target_lang_translations": {
                                "ru": "Он использовал острый топор, чтобы <w>расколоть</w> поленья для костра.",
                                "zh": "他用一把锋利的斧头把木头<w>劈开</w>用来生火。"
                            }
                        },
                        {
                            "text": "The river <w>splits</w> the city into two distinct districts.",
                            "target_lang_translations": {
                                "ru": "Река <w>разделяет</w> город на два отдельных района.",
                                "zh": "这条河将城市<w>分割</w>成两个截然不同的区域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "divide",
                        "cleave",
                        "separate",
                        "break",
                        "cut"
                    ],
                    "common_phrases": [
                        "split in two",
                        "split open",
                        "split down the middle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделить что-то на две или более частей, часто по прямой линии или волокнам.",
                        "zh": "将某物分成两部分或更多部分，通常沿直线或纹理方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскалывать",
                                "target_lang_sense_clarification": "дрова, твердые предметы"
                            },
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "расщеплять",
                                "target_lang_sense_clarification": "на волокна или мелкие части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劈开",
                                "target_lang_sense_clarification": "用于木材或坚硬物体"
                            },
                            {
                                "target_lang_word": "分割",
                                "target_lang_sense_clarification": "通用意义"
                            },
                            {
                                "target_lang_word": "裂开",
                                "target_lang_sense_clarification": "物体自然或受力断裂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68669f24-6640-3cde-99f5-18e8839ab0a6",
                    "sense_definition": "To share or distribute something among different people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sharing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>split</w> the bill evenly after dinner.",
                            "target_lang_translations": {
                                "ru": "Мы решили поровну <w>разделить</w> счет после ужина.",
                                "zh": "晚饭后我们决定平摊账单，每人<w>分摊</w>一部分。"
                            }
                        },
                        {
                            "text": "The thieves agreed to <w>split</w> the money from the robbery.",
                            "target_lang_translations": {
                                "ru": "Воры договорились <w>поделить</w> деньги от ограбления.",
                                "zh": "窃贼们商定把抢来的钱<w>分掉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "share",
                        "distribute",
                        "divide"
                    ],
                    "common_phrases": [
                        "split the bill",
                        "split the cost",
                        "split the difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делить или распределять что-то между разными людьми.",
                        "zh": "在不同人之间分配或分摊某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделить",
                                "target_lang_sense_clarification": "поделиться чем-то"
                            },
                            {
                                "target_lang_word": "поделить",
                                "target_lang_sense_clarification": "распределить части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分摊",
                                "target_lang_sense_clarification": "用于费用或账单"
                            },
                            {
                                "target_lang_word": "平分",
                                "target_lang_sense_clarification": "平均分配"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d10c58e-8455-39d4-8f2a-f1ca985f1d43",
                    "sense_definition": "To end a relationship or marriage; to separate from a partner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationship_end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>split</w> after five years of marriage.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>разойтись</w> после пяти лет брака.",
                                "zh": "结婚五年后，他们决定<w>离婚</w>。"
                            }
                        },
                        {
                            "text": "Did you hear that Mark and Sarah are going to <w>split</w> up?",
                            "target_lang_translations": {
                                "ru": "Ты слышал, что Марк и Сара собираются <w>расстаться</w>?",
                                "zh": "你听说马克和莎拉要<w>分手</w>了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "break up",
                        "separate",
                        "part",
                        "split up"
                    ],
                    "common_phrases": [
                        "split with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закончить отношения или брак; расстаться с партнером.",
                        "zh": "结束一段关系或婚姻；与伴侣分开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разойтись",
                                "target_lang_sense_clarification": "прекратить отношения"
                            },
                            {
                                "target_lang_word": "расстаться",
                                "target_lang_sense_clarification": "покинуть друг друга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分手",
                                "target_lang_sense_clarification": "结束恋爱关系"
                            },
                            {
                                "target_lang_word": "离婚",
                                "target_lang_sense_clarification": "结束婚姻关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c543d2b2-3395-3230-a22f-638ab0caea45",
                    "sense_definition": "To cause a group or organization to disagree and divide into smaller factions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controversial issue threatened to <w>split</w> the political party.",
                            "target_lang_translations": {
                                "ru": "Спорный вопрос грозил <w>расколоть</w> политическую партию.",
                                "zh": "这个争议性问题威胁到了要让政党<w>分裂</w>。"
                            }
                        },
                        {
                            "text": "Disagreements over money can easily <w>split</w> a family.",
                            "target_lang_translations": {
                                "ru": "Разногласия из-за денег могут легко <w>разделить</w> семью.",
                                "zh": "金钱上的分歧很容易让一个家庭<w>分崩离析</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "divide"
                    ],
                    "antonyms": [
                        "manifold"
                    ],
                    "common_phrases": [
                        "split the party",
                        "split the vote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать разногласия в группе или организации и разделить её на фракции.",
                        "zh": "导致团体或组织产生分歧并分裂成较小的派系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расколоть",
                                "target_lang_sense_clarification": "вызвать раскол в группе"
                            },
                            {
                                "target_lang_word": "разделить",
                                "target_lang_sense_clarification": "внести разобщение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分裂",
                                "target_lang_sense_clarification": "导致组织或团体瓦解"
                            },
                            {
                                "target_lang_word": "分化",
                                "target_lang_sense_clarification": "使内部产生不同意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e180082f-2e4a-31fe-ba3a-50bb0f5d0133",
                    "sense_definition": "To leave a place, often quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This party is boring, so let's <w>split</w> and go somewhere else.",
                            "target_lang_translations": {
                                "ru": "Эта вечеринка скучная, так что давай <w>свалим</w> и пойдем куда-нибудь еще.",
                                "zh": "这个派对太无聊了，我们<w>溜走</w>去别的地方吧。"
                            }
                        },
                        {
                            "text": "He had to <w>split</w> early to catch the last train home.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>уйти</w> пораньше, чтобы успеть на последнюю электричку домой.",
                                "zh": "他必须早点<w>离开</w>去赶回家的末班车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leave",
                        "depart",
                        "take off",
                        "beat it"
                    ],
                    "common_phrases": [
                        "let's split",
                        "time to split"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уйти откуда-то, часто быстро.",
                        "zh": "离开某地，通常指快速离开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свалить",
                                "target_lang_sense_clarification": "сленг: уйти"
                            },
                            {
                                "target_lang_word": "уйти",
                                "target_lang_sense_clarification": "нейтральное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溜走",
                                "target_lang_sense_clarification": "非正式，快速离开"
                            },
                            {
                                "target_lang_word": "离开",
                                "target_lang_sense_clarification": "中性表达"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "26166768-6353-3522-9615-f3a25b3822fb",
                    "sense_definition": "A long crack or tear in a material or surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_crack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a large <w>split</w> in the wooden table where it dried out.",
                            "target_lang_translations": {
                                "ru": "В деревянном столе есть большая <w>трещина</w> там, где он рассохся.",
                                "zh": "木桌因为干燥出现了一条大<w>裂缝</w>。"
                            }
                        },
                        {
                            "text": "She noticed a <w>split</w> in the seam of her trousers.",
                            "target_lang_translations": {
                                "ru": "Она заметила <w>разрыв</w> по шву на своих брюках.",
                                "zh": "她注意到裤子的接缝处有个<w>裂口</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crack",
                        "fissure",
                        "tear",
                        "rip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная трещина или разрыв в материале или поверхности.",
                        "zh": "材料或表面上的长裂缝或破口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трещина",
                                "target_lang_sense_clarification": "в твердом материале"
                            },
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "в ткани или мягком материале"
                            },
                            {
                                "target_lang_word": "щель",
                                "target_lang_sense_clarification": "узкое отверстие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裂缝",
                                "target_lang_sense_clarification": "硬物表面的裂纹"
                            },
                            {
                                "target_lang_word": "裂口",
                                "target_lang_sense_clarification": "织物或软材料上的破损"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f8d91c7-28e9-317b-a9e5-9912f08a8789",
                    "sense_definition": "A disagreement or division within a group that causes it to separate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The argument caused a deep <w>split</w> within the committee.",
                            "target_lang_translations": {
                                "ru": "Спор вызвал глубокий <w>раскол</w> в комитете.",
                                "zh": "这场争论在委员会内部造成了严重<w>分裂</w>。"
                            }
                        },
                        {
                            "text": "After the <w>split</w>, two new political factions emerged.",
                            "target_lang_translations": {
                                "ru": "После <w>раскола</w> возникли две новые политические фракции.",
                                "zh": "分裂之后，出现了两个新的政治派别。"
                            }
                        }
                    ],
                    "synonyms": [
                        "division",
                        "rift",
                        "schism",
                        "breach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разногласие или разделение внутри группы, приводящее к её распаду.",
                        "zh": "团体内部导致其分离的分歧或分裂。"
                    },
                    "translations": {
