                                        "examples": [
                                            {
                                                "example_id": "a701dec3-4daa-437f-afb7-2afba0dd0035",
                                                "sense_id": "96882c9d-b84a-3200-b446-289cbf083e17",
                                                "text": "En effet, c’est chez lui, dans sa demeure de Kichinev, que séjourna Alexandre Pouchkine lors de son exil bessarabe forcé."
                                            },
                                            {
                                                "example_id": "5be2407d-45c5-4904-882d-a3a1bc941a91",
                                                "sense_id": "96882c9d-b84a-3200-b446-289cbf083e17",
                                                "text": "Après le terrible pogrom de Kichinev, Yankel, mon grand-père géant, s’était résolu, comme beaucoup d’autres Juifs, à fuir vers l’ouest."
                                            },
                                            {
                                                "example_id": "4d3639fa-2eb2-459c-9557-934e79ba7f28",
                                                "sense_id": "96882c9d-b84a-3200-b446-289cbf083e17",
                                                "text": "Mais le pogrome attendu de pied ferme à Odessa frappe les 6 et 7 avril, à cent cinquante kilomètres, à Kichinev, une population juive sans défense, faisant 49 morts et 500 blessés."
                                            }
                                        ]
                                    }
