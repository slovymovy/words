                                        ]
                                    },
                                    {
                                        "sense_id": "d5976c0d-eab8-34f2-88f8-66eedb2eebd0",
                                        "entry_id": "8269d64a-8363-3117-ad75-4d4ae08bbdc2",
                                        "glosses": [
                                            "Personne avec qui on est en commerce réglé de lettres, pour affaires, pour nouvelles, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36cbddad-1fe4-4360-93df-067839988ff7",
                                                "sense_id": "d5976c0d-eab8-34f2-88f8-66eedb2eebd0",
                                                "text": "— Calvâsse! vraiment? Je croyais que les correspondants parlementaires étaient détendus comme des coqs en pâte."
                                            },
                                            {
                                                "example_id": "31eebc8e-f600-46e5-bc5a-66e53882b985",
                                                "sense_id": "d5976c0d-eab8-34f2-88f8-66eedb2eebd0",
