                                        "entry_id": "c96bdb06-803b-3f84-a269-0c39ab3f3c35",
                                        "glosses": [
                                            "Titre par lequel on désignait des souverains du second ordre, subordonnés à une puissance supérieure, et ainsi nommés parce que leurs États étaient censés faire à peu près la quatrième portion d’un royaume démembré."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "069f2a4b-625e-45d4-b212-aaa076864861",
                                                "sense_id": "1df58c9f-eca7-36c9-b6a5-fb96f2a4f73d",
                                                "text": "Tout à coup, une voix lointaine, comme échappée des profondeurs de la terre, fit pâlir le Tétrarque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f6f0968-9f35-4154-9f0a-04532ed61118",
                        "source_entry_id": "8177a1c2-a231-33cc-9907-0a2e991fa8c7",
