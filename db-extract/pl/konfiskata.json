                                "target_senses": [
                                    {
                                        "sense_id": "ad331cf1-bc9b-3f4f-b264-7be3899a3458",
                                        "entry_id": "35422b10-79ae-3bf3-b819-29c31e6c8f43",
                                        "glosses": [
                                            "Féminin singulier de saisi."
                                        ],
