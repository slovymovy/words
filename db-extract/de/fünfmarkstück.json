                "senses": [
                    {
                        "sense_id": "54e279d2-09a0-36e2-b1e3-8a47734a62d6",
                        "entry_id": "ac86cc2b-e60e-3d68-9104-fee1eab910fb",
                        "glosses": [
                            "Münze mit dem Wert von fünf Mark"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "72aa884b-a163-4a3b-8f30-0146a7fc7de3",
                                "sense_id": "54e279d2-09a0-36e2-b1e3-8a47734a62d6",
                                "text": "„Die Männer und Frauen in der Bar sahen sich an wie Fünfmarkstücke.“"
                            },
                            {
                                "example_id": "910edc8f-5060-44ba-9c98-d682f9696070",
                                "sense_id": "54e279d2-09a0-36e2-b1e3-8a47734a62d6",
                                "text": "„Irgendwann würde ich so weit sein, daß ich Kinkel anpumpte, auch Sommerwild und sogar diesen Sadisten Fredebeul, der mir wahrscheinlich ein Fünfmarkstück vor die Nase halten und mich zwingen würde, danach zu springen.“"
                            },
                            {
                                "example_id": "bf59ed87-4f84-4711-8c34-68e0e0d4208a",
                                "sense_id": "54e279d2-09a0-36e2-b1e3-8a47734a62d6",
                                "text": "„Ich kann es nicht; ich habe seit zu langer Zeit kein Fünfmarkstück mehr gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
