                ],
                "senses": [
                    {
                        "sense_id": "0c2671e6-7e2f-3aea-b26b-bc7f8c6030ad",
                        "entry_id": "5357df3e-c5ee-3626-bdb8-c22838fb2a37",
                        "glosses": [
                            "Geruchswahrnehmung, die von Mandeln stammt oder diesen ähnelt, zum Beispiel vom Mandelbaum besonders in seiner Blütezeit bei der Mandelblüte; auch von der Frucht, der Mandel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03cf9f89-d6b7-48bf-bc13-8c70aa83a3c2",
                                "sense_id": "0c2671e6-7e2f-3aea-b26b-bc7f8c6030ad",
                                "text": "„Neben der oben beschriebenen Marzipanrohmasse, deren Aussehen eine gelbliche Farbe hat und die sich zudem durch einen intensiven Mandelgeruch auszeichnet, gibt es noch weitere Marzipanrohmassen, z. B. Pistazienmarzipanrohmasse.“"
                            },
                            {
                                "example_id": "56aac4c8-2bff-4a44-bb6e-cdcca46f2cc7",
                                "sense_id": "0c2671e6-7e2f-3aea-b26b-bc7f8c6030ad",
                                "text": "„Ihr leichter Röstgeschmack und der appetitliche Mandelgeruch haben unsere Tester überzeugt.“"
                            },
                            {
                                "example_id": "c3dd89b5-733d-4291-8998-a7e081e9c2eb",
                                "sense_id": "0c2671e6-7e2f-3aea-b26b-bc7f8c6030ad",
                                "text": "„Ritter Sport – Schokolade ist derzeit in aller Munde. Es geht um das beigefügte Piperonal, das für den Vanille – und Mandelgeruch sorgt.“"
                            },
                            {
                                "example_id": "a8905016-bdce-491f-98af-1a0b327c4401",
                                "sense_id": "0c2671e6-7e2f-3aea-b26b-bc7f8c6030ad",
                                "text": "„Der Braunschuppige Riesenegerling Agaricus augustus fällt durch seine enorme Größe und den angenehmen Mandelgeruch auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
