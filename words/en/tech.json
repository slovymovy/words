                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to go to <w>tech</w> to learn welding and automotive repair.",
                            "target_lang_translations": {
                                "ru": "Он решил поступить в <w>техникум</w>, чтобы научиться сварке и ремонту автомобилей.",
                                "zh": "他决定去<w>技校</w>学习焊接和汽车维修。"
                            }
                        },
                        {
                            "text": "Greenville Technical College is informally known as Greenville <w>Tech</w> by the locals.",
                            "target_lang_translations": {
                                "ru": "Технический колледж Гринвилла местные называют просто Гринвилл <w>Тек</w>.",
                                "zh": "当地人常把格林维尔技术学院简称为格林维尔<w>技校</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
