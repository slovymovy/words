                                        "entry_id": "69e498b7-144a-317c-a5e9-50b898cb0226",
                                        "glosses": [
                                            "To make poor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa52ec50-4568-34f9-b79f-7a10525aa144",
                                        "entry_id": "69e498b7-144a-317c-a5e9-50b898cb0226",
                                        "glosses": [
                                            "To weaken in quality; to deprive of some strength or richness."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "542d8857-eced-4b7c-a10e-13d32b3a7194",
                                                "sense_id": "fa52ec50-4568-34f9-b79f-7a10525aa144",
                                                "text": "That exuberant crop quickly impoverishes any fertile soil."
                                            },
                                            {
                                                "example_id": "74036b8a-9da8-42ba-b379-66f8f76c4a73",
                                                "sense_id": "fa52ec50-4568-34f9-b79f-7a10525aa144",
                                                "text": "To many of us, organized religion is obnoxious. Yet if we throw out the sense of peace, order and joy that flows from religious ritual, we impoverish ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088a5b74-0465-3198-9e66-d11e37ba062e",
                                        "entry_id": "69e498b7-144a-317c-a5e9-50b898cb0226",
                                        "glosses": [
                                            "To become poor."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5d745ce-3269-4a95-8c3c-9bbfd9b1d24c",
                        "source_entry_id": "8b8cb87e-bf14-3ed2-9f89-047614612ce7",
                        "source_sense_id": "ebd2f33b-7a12-336d-a793-b805462b7e49",
                        "target_lang_word": "pauperize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pauperize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a85ff856-328a-3875-87c4-36b23d2ee492",
                                        "entry_id": "9fbdba68-574b-33e7-a4e7-dc040a43a3ea",
                                        "glosses": [
                                            "To make someone a pauper; to impoverish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec729dc8-0b50-4b91-a4ac-89f7b330f5c1",
                                                "sense_id": "a85ff856-328a-3875-87c4-36b23d2ee492",
                                                "text": "This is an Education which consists in the outleading of the blackguardizing, pauperizing, vagrant-like, and theftuous elements of the mentality, entirely withdrawn, and apart from any moral guidance, any elevating tendency, any ameliorating influence, nay, directly under the direction of the demoralized and the abandoned."
                                            },
                                            {
                                                "example_id": "b251af4e-d109-415b-9409-540e77dff9fe",
                                                "sense_id": "a85ff856-328a-3875-87c4-36b23d2ee492",
                                                "text": "Burdocks, thistles, dwarf oaks, cottonweed, chalky holes and whitish puddles everywhere. It was all pauperized. The very bushes might have been on welfare."
                                            },
                                            {
                                                "example_id": "e4f99793-1621-47a4-90ea-58767def65cb",
                                                "sense_id": "a85ff856-328a-3875-87c4-36b23d2ee492",
                                                "text": "He (Lee Kuan Yew) and his associates jailed opponents or pauperized them through civil court cases alleging slander or other misdemeanors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
