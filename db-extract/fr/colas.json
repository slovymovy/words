                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f07a707-7323-3615-a103-d86e944a3628",
                        "entry_id": "a438dce2-7af8-38c2-9b1b-9323dc8e7fd8",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be11ceee-dc34-4f7e-9f49-831967829358",
                                "sense_id": "7f07a707-7323-3615-a103-d86e944a3628",
                                "text": "En trophée Sauffier, la paire Patrice Colas et Bastian Warin décroche elle aussi une très belle 5ᵉ place après un sans-faute lors des poules."
                            },
                            {
                                "example_id": "ffee8c70-0d29-400c-bd36-a7e040ab94db",
                                "sense_id": "7f07a707-7323-3615-a103-d86e944a3628",
                                "text": "Sortir de cet accord serait « déjà un premier pas », estime Sylvie Colas, secrétaire nationale de la Conférence paysanne et éleveuse de volailles dans le Gers qui plaide pour une sortie des accords de libre-échange."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f13866cc-f6dc-31b3-be80-9f7f555978ba",
                "word": "Colas",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a3408d6-92a4-3c97-8a65-bd6a42a052e7",
                        "entry_id": "f13866cc-f6dc-31b3-be80-9f7f555978ba",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9b81c49-2420-4966-b390-fdf16b65415d",
                        "source_entry_id": "f13866cc-f6dc-31b3-be80-9f7f555978ba",
                        "source_sense_id": "8a3408d6-92a4-3c97-8a65-bd6a42a052e7",
                        "target_lang_word": "Nick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aee706aa-2aeb-3212-9769-81c6aa982e5d",
                                        "entry_id": "8c6a88f3-603a-3b63-aadf-c5348799f7f7",
                                        "glosses": [
                                            "A diminutive of the male given name Nicholas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc98c486-e6eb-47e9-8b76-d28a7cd8ec24",
                                                "sense_id": "aee706aa-2aeb-3212-9769-81c6aa982e5d",
                                                "text": "His name is Nick. I love it. It makes him seem nice, and regular, which he is. When he tells me his name, I say, 'Now, that's a real name.'"
                                            },
                                            {
                                                "example_id": "c644e9ff-0263-4928-9acd-d0f62254e3e1",
                                                "sense_id": "aee706aa-2aeb-3212-9769-81c6aa982e5d",
                                                "text": "You look at the groypers, you look at Nick Fuentes, you look at people who are by any measure white supremacists and people we would have called the kooky Nazi right, with their Pepe the Frog memes — they all felt very ill at home in Mitt Romney’s Republican Party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e85cf5d-f853-4720-bf30-662f3b2b55c4",
                        "source_entry_id": "f13866cc-f6dc-31b3-be80-9f7f555978ba",
                        "source_sense_id": "8a3408d6-92a4-3c97-8a65-bd6a42a052e7",
                        "target_lang_word": "Коля",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Коля",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d0ab2cdd-93c4-3fc8-93fc-3b268f64af11",
                                        "entry_id": "ac491cdb-e627-3bb8-a16e-c5e0b4c375b1",
                                        "glosses": [
                                            "гипокор. к Николай"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886edace-8be3-4f7f-9c0f-605f7c582675",
                                                "sense_id": "d0ab2cdd-93c4-3fc8-93fc-3b268f64af11",
                                                "text": "Коля тотчас же возразил ей, что если б он не уважал в ней женщину, и сверх того свои убеждения, то немедленно доказал бы ей, что умеет ответить на подобное оскорбление."
                                            },
                                            {
                                                "example_id": "f14fc64d-a56a-4c62-b673-e4806246d0e9",
                                                "sense_id": "d0ab2cdd-93c4-3fc8-93fc-3b268f64af11",
                                                "text": "Лапкин вынул из кармана рубль и подал его Коле."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
