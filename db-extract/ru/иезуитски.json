                                "target_word": "jésuitiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e0ec86-f354-31f6-831f-86fc30772b45",
                                        "entry_id": "84d3fdc4-2421-30fc-9aeb-038a12e964a4",
                                        "glosses": [
                                            "À la manière des jésuites, c’est-à-dire en employant des équivoques, en usant de détours."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75c7d42f-cbe3-43b5-8c77-252de8655e0a",
                                                "sense_id": "b3e0ec86-f354-31f6-831f-86fc30772b45",
                                                "text": "— Vous aimez donc bien le colonel ? lui dit-elle.\n— J’espérais encore, répondit la vieille fille.\n— Eh ! bien, attendez, s’écria jésuitiquement mademoiselle Habert, qui savait bien que le temps ferait justice du colonel."
                                            },
                                            {
                                                "example_id": "8ad9260b-a054-493d-82c3-ab6ace462de8",
                                                "sense_id": "b3e0ec86-f354-31f6-831f-86fc30772b45",
                                                "text": "Ah ! monsieur, nous sommes bien loin de compte, dit jésuitiquement le colonel."
                                            },
                                            {
                                                "example_id": "d3970074-f0ae-4e66-872f-5815064b0ad9",
                                                "sense_id": "b3e0ec86-f354-31f6-831f-86fc30772b45",
                                                "text": "Lisbeth répondit jésuitiquement à Wenceslas, que le créancier ne lui ayant fait que de vagues promesses, elle ne comptait l’aller délivrer que le lendemain, et que leur prêteur, honteux d’une ignoble persécution, avait sans doute pris les devants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
