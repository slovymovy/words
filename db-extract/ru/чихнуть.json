                    },
                    {
                        "translation_id": "44389f68-cb8a-4919-8d45-c31643be0e40",
                        "source_entry_id": "9b3f8a7c-0cae-3507-bd85-150d9961346a",
                        "source_sense_description": "непроизвольно с резким звуком выдохнуть воздух носом при раздражении носоглотки",
                        "target_lang_word": "niesen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niesen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc5aced-485f-374d-834d-6d7dd38dfab5",
                                        "entry_id": "2443befa-63c6-39bd-8995-00c40ec990c8",
                                        "glosses": [
                                            "ruckartig und meistens laut Luft durch Nase und/oder Mund ausstoßen (als Reflex auf einen Reiz der Nasenschleimhaut), ohne darüber Kontrolle zu haben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6d8953-7a50-4651-aacc-97d64f001504",
                                                "sense_id": "dbc5aced-485f-374d-834d-6d7dd38dfab5",
                                                "text": "Entschuldigung, ich muss schon den ganzen Tag niesen! Ich habe mir wohl eine Erkältung zugezogen."
                                            },
                                            {
                                                "example_id": "93e57f14-1965-4441-b33c-808eba8337d3",
                                                "sense_id": "dbc5aced-485f-374d-834d-6d7dd38dfab5",
                                                "text": "Wenn jemand niest, dann wünscht man ihm „Gesundheit“!"
                                            },
                                            {
                                                "example_id": "c2c8a436-115b-4b37-b75c-0f73a10bf723",
                                                "sense_id": "dbc5aced-485f-374d-834d-6d7dd38dfab5",
                                                "text": "So habe ich's gerne, kaum wird's warm, tränen die Augen, läuft die Nase und geniest wird, was das Zeug hält. […] Aber ob das schon der erste 'Heuschnupfen' ist?"
                                            },
                                            {
                                                "example_id": "2454fbe5-c7ee-4400-8c90-7899d359a225",
                                                "sense_id": "dbc5aced-485f-374d-834d-6d7dd38dfab5",
                                                "text": "Eine meiner Ratten hat ein gesundheitliches Problem: sie niest häufiger und hat dann an der Nase ein bißchen rötlich-wässrigen Ausfluß."
                                            },
                                            {
                                                "example_id": "2b19a737-20bb-4573-9a6a-022515ee1d44",
                                                "sense_id": "dbc5aced-485f-374d-834d-6d7dd38dfab5",
                                                "text": "Mit seligen Nüstern athme ich wieder Berges-Freiheit! Erlöst ist endlich meine Nase vom Geruch alles Menschenwesens! Von scharfen Lüften gekitzelt, wie von schäumenden Weinen, niest meine Seele, - niest und jubelt sich zu: Gesundheit!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
