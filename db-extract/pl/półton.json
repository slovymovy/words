                    {
                        "translation_id": "b1c8b628-a22e-42b4-9c58-3c50f1093c4e",
                        "source_entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                        "source_sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                        "target_lang_word": "halftone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halftone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12c2ec52-f96e-38a6-b70b-222ca31f261d",
                                        "entry_id": "6b78e8fc-d4b5-3d17-8628-47e8fd578c04",
                                        "glosses": [
                                            "Synonym of semitone, half the interval between two notes on a scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad705c05-bcc7-461a-9461-91aed40d0a59",
                                                "sense_id": "12c2ec52-f96e-38a6-b70b-222ca31f261d",
                                                "text": "That animals utter musical notes is familiar to every one, as we may daily hear in the singing of birds. It is a more remarkable fact that an ape, one of the Gibbons, produces an exact octave of musical sounds, ascending and descending the scale by half-tones; so that this monkey “alone of brute mammals may be said to sing.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489632f9-2faf-3282-9a61-2b6a858a04f4",
                                        "entry_id": "6b78e8fc-d4b5-3d17-8628-47e8fd578c04",
                                        "glosses": [
                                            "A picture made by using the process of half-toning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd408ea-b84b-4b3b-9f46-9018f4741e82",
                                                "sense_id": "489632f9-2faf-3282-9a61-2b6a858a04f4",
                                                "text": "Before leaving New York a handsome booklet had been prepared and printed. The brochure contained the names of the commissioners, their public records, halftone portraits and a carefully prepared statement of the objects of the expedition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4b7122-2b3d-37d0-b98c-46a3acb9e343",
                                        "entry_id": "6b78e8fc-d4b5-3d17-8628-47e8fd578c04",
                                        "glosses": [
                                            "An intermediate or middle tone in a painting, engraving, photograph, etc.; a middle tint, neither very dark nor very light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c54b200-a285-4ccf-ad1c-f9c626ca5bcf",
                                                "sense_id": "dc4b7122-2b3d-37d0-b98c-46a3acb9e343",
                                                "text": "“No, I cannot enjoy it,” Cecilia said to Mrs. Devereux; “I don't mind the grey light; cloud and water, and half-tones of colour, are homely English and pleasant, and that opal where the sun should be has a suggestiveness richer than sunlight.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halftone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da11ce60-ca02-3033-9cd2-7b9e139d6946",
                                        "entry_id": "fb356677-b25a-3099-816d-420720acf8cb",
                                        "glosses": [
                                            "To reproduce a photograph or other continuous tone image by the use of dots of various sizes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
