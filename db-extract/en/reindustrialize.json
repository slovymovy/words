                        "entry_id": "55f6f808-9881-3eef-84ae-8f293bee1025",
                        "glosses": [
                            "To reintroduce industry or industrial techniques to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc3d9820-eceb-4a6d-b335-fd452fda434b",
                                "sense_id": "36595452-06c9-3602-bae3-757683134708",
                                "text": "The government plans to reindustrialize the former mining region."
                            }
                        ]
                    }
                ],
                "translations": [
