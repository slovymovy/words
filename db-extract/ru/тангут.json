                        "examples": [
                            {
                                "example_id": "6fa25327-94bc-4aaf-9b9a-45f8ee27528b",
                                "sense_id": "4a1f5c89-7edf-33f6-a150-cb1ae764e155",
                                "text": "Шаманов везде принимают с большим почетом и о чудесах их рассказывают разные небылицы, например: один тангут украл у шамана корову и только что стал варить ее мясо, как оно превратилось в грибы (грибов тангуты не едят)."
                            }
                        ]
