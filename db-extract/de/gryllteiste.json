                                        "entry_id": "be12aaf3-7613-366a-8db5-88e83f1c741a",
                                        "glosses": [
                                            "Espèce d’oiseau palmipède plongeur marin, petit guillemot au corps entièrement noir, sauf pour une large tache blanche distinctive sur le dessus de l’aile, le « miroir »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c416fbc9-d916-4f06-9525-8f4e8a7d1828",
                                                "sense_id": "014ccc86-b5ee-39f9-aadb-fdcfb58faa75",
                                                "text": "Le guillemot à miroir (Cepphus grylle) est un résident permanent, qui se reproduit sur la plupart des côtes favorables de l’archipel."
                                            },
                                            {
                                                "example_id": "83a3ff10-5c85-44d5-9ce4-4c8352537927",
                                                "sense_id": "014ccc86-b5ee-39f9-aadb-fdcfb58faa75",
                                                "text": "N’importe quoi : des écureuils\ndes guillemots à miroir\ndes petits pingouins."
                                            }
                                        ]
                                    }
                                ]
                            }
