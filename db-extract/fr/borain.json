                                "example_id": "522013fd-8b42-44ac-9209-30b653c783cc",
                                "sense_id": "12fbcd0b-5935-3d30-874a-c937a622f526",
                                "text": "« À mort, les Borains ! pas d’étrangers chez nous ! à mort ! à mort ! »"
                            },
                            {
                                "example_id": "fe148822-0cd6-47ef-b7c7-e9ad691c62ea",
                                "sense_id": "12fbcd0b-5935-3d30-874a-c937a622f526",
                                "text": "Les Borains de 1925 avaient au cœur une ardeur tenace —c’était leur principale vertu— qui parfois les soulevait et toujours, même dans les pires moments, leur laissait l’espérance."
                            }
                        ]
                    }
