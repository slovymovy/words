{
    "word_family": [
        "plasterer",
        "plastering",
        "plastery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b25289f-7910-321b-ba8f-7751858dcb44",
                    "sense_definition": "A mixture of lime or gypsum, sand, and water used for coating walls and ceilings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "building_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers began to <w>plaster</w> the walls of the new house.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter begannen, die Wände des neuen Hauses zu <w>verputzen</w>."
                            }
                        },
                        {
                            "text": "Fresh <w>plaster</w> needs time to dry before you can paint the room.",
                            "target_lang_translations": {
                                "de": "Frischer <w>Putz</w> braucht Zeit zum Trocknen, bevor man den Raum streichen kann."
                            }
                        }
                    ],
                    "synonyms": [
                        "stucco",
                        "render"
                    ],
                    "common_phrases": [
                        "wet plaster"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Mischung aus Kalk oder Gips, Sand und Wasser, die zum Verputzen von Wänden und Decken verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Putz",
                                "target_lang_sense_clarification": "Baumaterial für Wand- oder Deckenbeläge"
                            },
                            {
                                "target_lang_word": "Verputz",
                                "target_lang_sense_clarification": "Äußerer Belag auf Mauerwerk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97b1da08-61ab-3c96-9728-e4402bd877e1",
                    "sense_definition": "A small adhesive bandage used to cover a minor wound.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put a <w>plaster</w> on her finger after cutting it.",
                            "target_lang_translations": {
                                "de": "Sie klebte sich ein <w>Pflaster</w> auf den Finger, nachdem sie sich geschnitten hatte."
                            }
                        },
                        {
                            "text": "Do you have a <w>plaster</w> for this small cut?",
                            "target_lang_translations": {
                                "de": "Hast du ein <w>Pflaster</w> für diesen kleinen Schnitt?"
                            }
                        }
                    ],
                    "synonyms": [
                        "bandage"
                    ],
                    "common_phrases": [
                        "adhesive plaster"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, klebendes Pflaster zur Abdeckung kleinerer Wunden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Pflaster",
                                "target_lang_sense_clarification": "Medizinisches Hilfsmittel für kleine Wunden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e04a8516-8002-3e4b-b438-2ff2e3749e5f",
                    "sense_definition": "A hard cast made of gauze and gypsum used to support a broken bone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to wear a <w>plaster</w> on his arm for six weeks.",
                            "target_lang_translations": {
                                "de": "Er musste sechs Wochen lang einen <w>Gips</w> am Arm tragen."
                            }
                        },
                        {
                            "text": "The doctor removed the <w>plaster</w> after the bone healed.",
                            "target_lang_translations": {
                                "de": "Der Arzt entfernte den <w>Gips</w>, nachdem der Knochen geheilt war."
                            }
                        }
                    ],
                    "synonyms": [
                        "cast"
                    ],
                    "common_phrases": [
                        "plaster cast"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein harter Verband aus Gipsbinden zur Stützung eines gebrochenen Knochens."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gips",
                                "target_lang_sense_clarification": "Umgangssprachlich für einen Gipsverband"
                            },
                            {
                                "target_lang_word": "Gipsverband",
                                "target_lang_sense_clarification": "Medizinischer Stützverband"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e30c74-351f-374a-936b-52a5406f68a7",
                    "sense_definition": "A medicinal paste applied to the skin for healing purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The herbalist prepared a soothing <w>plaster</w> for the patient's back.",
                            "target_lang_translations": {
                                "de": "Der Kräuterkundige bereitete eine lindernde <w>Salbe</w> für den Rücken des Patienten zu."
                            }
                        },
                        {
                            "text": "She applied the medicated <w>plaster</w> directly to the sore area.",
                            "target_lang_translations": {
                                "de": "Sie trug die medizinische <w>Salbe</w> direkt auf die schmerzende Stelle auf."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine medizinische Paste, die zur Heilung auf die Haut aufgetragen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Salbe",
                                "target_lang_sense_clarification": "Arzneizubereitung zur Anwendung auf der Haut"
                            },
                            {
                                "target_lang_word": "Creme",
                                "target_lang_sense_clarification": "Fetthaltige Substanz zur Hautpflege"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0bfe700-685a-359b-8823-85dae58cca30",
                    "sense_definition": "A fine white powder that becomes a hard solid when mixed with water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "building_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sculptor used <w>plaster</w> to create a mold of the statue.",
                            "target_lang_translations": {
                                "de": "Der Bildhauer verwendete <w>Gips</w>, um eine Form der Statue zu erstellen."
                            }
                        },
                        {
                            "text": "He mixed the <w>plaster</w> quickly before it started to set.",
                            "target_lang_translations": {
                                "de": "Er mischte den <w>Gips</w> schnell, bevor er anfing fest zu werden."
                            }
                        }
                    ],
                    "synonyms": [
                        "gypsum"
                    ],
                    "common_phrases": [
                        "plaster of Paris"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein feines weißes Pulver, das nach dem Mischen mit Wasser zu einem harten Feststoff wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gips",
                                "target_lang_sense_clarification": "Baumaterial oder Mineral"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9db44260-1019-3b9e-b790-98e3d1ba0790",
                    "sense_definition": "To cover or coat a surface with a layer of plaster.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders will <w>plaster</w> the ceiling tomorrow morning.",
                            "target_lang_translations": {
                                "de": "Die Bauarbeiter werden die Decke morgen früh <w>verputzen</w>."
                            }
                        },
                        {
                            "text": "It is difficult to <w>plaster</w> a wall perfectly smooth.",
                            "target_lang_translations": {
                                "de": "Es ist schwierig, eine Wand perfekt glatt zu <w>verputzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "render"
                    ],
                    "common_phrases": [
                        "plaster a wall"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Oberfläche mit einer Schicht Putz oder Gips überziehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verputzen",
                                "target_lang_sense_clarification": "Einen Putz auf eine Mauer auftragen"
                            },
                            {
                                "target_lang_word": "gipsen",
                                "target_lang_sense_clarification": "Mit Gips bearbeiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c837875-36ee-3ac8-9998-1ac436c4cc0d",
                    "sense_definition": "To cover or smear a surface thickly with a sticky or viscous substance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>plastered</w> their faces with mud while playing outside.",
                            "target_lang_translations": {
                                "de": "Die Kinder <w>beschmierten</w> ihre Gesichter beim Spielen draußen mit Schlamm."
                            }
                        },
                        {
                            "text": "His hair was <w>plastered</w> down with too much gel.",
                            "target_lang_translations": {
                                "de": "Sein Haar war mit zu viel Gel <w>festgeklebt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "coat"
                    ],
                    "common_phrases": [
                        "plastered with mud"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Oberfläche dick mit einer klebrigen oder zähen Substanz bestreichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beschmieren",
                                "target_lang_sense_clarification": "Mit einer Substanz bedecken"
                            },
                            {
                                "target_lang_word": "einkleistern",
                                "target_lang_sense_clarification": "Dick mit etwas bestreichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                    "sense_definition": "To cover a surface completely with posters, advertisements, or similar items.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>plastered</w> the city with advertisements for the new movie.",
                            "target_lang_translations": {
                                "de": "Die Firma <w>zupflasterte</w> die Stadt mit Werbung für den neuen Film."
                            }
                        },
                        {
                            "text": "The walls were <w>plastered</w> with concert posters.",
                            "target_lang_translations": {
                                "de": "Die Wände waren mit Konzertplakaten <w>zugeklebt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plastered with"
                    ],
                    "common_phrases": [
                        "plastered with"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Oberfläche vollständig mit Postern oder Werbung bedecken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zupflastern",
                                "target_lang_sense_clarification": "Umgangssprachlich für das vollständige Bekleben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e561d5-0a96-3bb0-865e-724f9ad11b66",
                    "sense_definition": "To apply a medical bandage or dressing to a wound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_aid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse helped to <w>plaster</w> the patient's injured hand.",
                            "target_lang_translations": {
                                "de": "Die Krankenschwester half dabei, die verletzte Hand des Patienten zu <w>verbinden</w>."
                            }
                        },
                        {
                            "text": "You should clean and <w>plaster</w> the cut to prevent infection.",
                            "target_lang_translations": {
                                "de": "Du solltest den Schnitt reinigen und <w>pflastern</w>, um eine Infektion zu verhindern."
                            }
                        }
                    ],
                    "synonyms": [
                        "bandage"
                    ],
                    "common_phrases": [
                        "plaster a wound"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen medizinischen Verband auf eine Wunde anlegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verbinden",
                                "target_lang_sense_clarification": "Einen Verband anlegen"
                            },
                            {
                                "target_lang_word": "pflastern",
                                "target_lang_sense_clarification": "Mit einem Pflaster versehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d1d99cc-40f8-3ea6-9042-365360f5ff5c",
                    "sense_definition": "To attack or overwhelm a target with heavy gunfire or bombardment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artillery continued to <w>plaster</w> the enemy positions throughout the night.",
                            "target_lang_translations": {
                                "de": "Die Artillerie fuhr fort, die feindlichen Stellungen die ganze Nacht lang zu <w>bombardieren</w>."
                            }
                        },
                        {
                            "text": "The ships <w>plastered</w> the coast with heavy gunfire.",
                            "target_lang_translations": {
                                "de": "Die Schiffe <w>beschossen</w> die Küste mit schwerem Geschützfeuer."
                            }
                        }
                    ],
                    "synonyms": [
                        "bombard",
                        "shell"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ziel mit schwerem Artilleriefeuer oder Bombardement angreifen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bombardieren",
                                "target_lang_sense_clarification": "Mit Geschossen angreifen"
                            },
                            {
                                "target_lang_word": "beschießen",
                                "target_lang_sense_clarification": "Mit Waffen angreifen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b79b83a-f531-35de-82a7-ca6e4e56b838",
                    "sense_definition": "To smooth over or flatten something, often to hide imperfections.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>plaster</w> over the cracks in the argument with vague promises.",
                            "target_lang_translations": {
                                "de": "Er versuchte, die Risse in der Argumentation mit vagen Versprechungen zu <w>übertünchen</w>."
                            }
                        },
                        {
                            "text": "The politician attempted to <w>plaster</w> over the scandal with a press release.",
                            "target_lang_translations": {
                                "de": "Der Politiker versuchte, den Skandal mit einer Pressemitteilung zu <w>überspielen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "plaster over"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas glätten oder verdecken, oft um Mängel zu verbergen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "übertünchen",
                                "target_lang_sense_clarification": "Figurativ für das Verbergen von Konflikten"
                            },
                            {
                                "target_lang_word": "überspielen",
                                "target_lang_sense_clarification": "Etwas verbergen oder kaschieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fa851c8b-6753-3ffb-94f3-6f8c6b509f16",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named <w>Plaster</w>.",
                            "target_lang_translations": {
                                "de": "Der Autor des Buches heißt <w>Plaster</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Plaster</w> is our new neighbor.",
                            "target_lang_translations": {
                                "de": "Herr <w>Plaster</w> ist unser neuer Nachbar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "de": []
                    }
                }
            ]
        }
    ]
}