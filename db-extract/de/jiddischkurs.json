                "senses": [
                    {
                        "sense_id": "893cecda-3e25-3175-bc36-5bb9ff99c83b",
                        "entry_id": "38df91ec-8caa-3361-8907-4df291ea7477",
                        "glosses": [
                            "Unterricht, in dem Jiddisch gelehrt und gelernt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228b5d45-ce17-4c92-94da-21ecbb7d1432",
                                "sense_id": "893cecda-3e25-3175-bc36-5bb9ff99c83b",
                                "text": "„Auch wenn das gestiegene Angebot an Jiddischkursen für den Fortbestand der Sprache selbst unerheblich sein dürfte, hat das Interesse am Jiddischen dazu geführt, dass die Bedeutung des jiddischsprachigen Erbes für die jüdische wie für die europäische und amerikanische Kultur wahrgenommen und gewürdigt wird.“"
                            },
                            {
                                "example_id": "4a9ff38a-2e1c-4797-955c-dfbb7d350b30",
                                "sense_id": "893cecda-3e25-3175-bc36-5bb9ff99c83b",
                                "text": "„Am authentischen Ort in Vilnius lernt sie nun Jiddisch viel intensiver, als in Hamburg, wo sie an der Universität ebenfalls Jiddischkurse belegt hat.“"
                            },
                            {
                                "example_id": "b7fde47e-cb56-4486-8264-8f5f9552116a",
                                "sense_id": "893cecda-3e25-3175-bc36-5bb9ff99c83b",
                                "text": "„Die pensionierte Musikerin hatte vor zwei Jahren einen Jiddischkurs in Straßburg belegt und seitdem immer wieder Kontakt gehalten.“"
                            },
                            {
                                "example_id": "82a55fe0-e20b-44f2-8161-e79faa06540e",
                                "sense_id": "893cecda-3e25-3175-bc36-5bb9ff99c83b",
                                "text": "„Dass es nun sogar die Urenkel sind, die in Paula Grossmans Jiddischkurs strömen, empfindet die Pädagogin als Erleichterung und Verantwortung zugleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
