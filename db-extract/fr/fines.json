                "senses": [
                    {
                        "sense_id": "2c38f947-0ad2-309a-8a42-ef2c60dd3065",
                        "entry_id": "4c056339-589d-30f0-a8f8-000703202342",
                        "glosses": [
                            "Féminin pluriel de fin."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2312287d-d1ea-4cd0-a84c-30af153a3ffd",
                                "sense_id": "2c38f947-0ad2-309a-8a42-ef2c60dd3065",
                                "text": "Modelée comme un tanagra, statuette de chair aux petits seins pointus, hanches étroites et jambes fines, vive et souple, Lizzie inspirait un chaud désir, tempéré de tendres égards."
                            },
                            {
                                "example_id": "962b9003-0992-4d14-a763-16180de0a2b9",
                                "sense_id": "2c38f947-0ad2-309a-8a42-ef2c60dd3065",
                                "text": "Personne ne s’entendait mieux à dessiner de fines broderies sur les robes des minourez, à disposer le velours avec art sur les vestes des gros fermiers, et aussi, prétendait-on, à manier la langue."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
