        "de-extract.jsonl": [
            {
                "entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                "word": "inadvertence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7975deb4-2127-4360-831e-628db98064d4",
                        "entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "tags": [
                            "variant"
                        ],
                        "form": "inadvertency"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a805b79-ed64-32a9-82d3-4270de082965",
                        "entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "glosses": [
                            "Achtlosigkeit, Nachlässigkeit, Unachtsamkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6790b6be-1db6-4b0a-9f0a-220c073e87ab",
                                "sense_id": "0a805b79-ed64-32a9-82d3-4270de082965",
                                "text": "\"Some of our sailors, whether out of treachery or inadvertence, had informed the pilots \"that I was a stranger, and great traveller;\" whereof these gave notice to a custom-house officer, by whom I was examined very strictly upon my landing.\"",
                                "translation": "Einige unserer Matrosen, ob aus Verrat oder Unachtsamkeit, hatten die Piloten informiert, \"dass ich ein Fremder und großer Reisender war\", worüber diese einen Offizier des Zollamtes informiert haben, von dem ich sehr streng nach meiner Landung untersucht wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0d41965-6bb9-37a9-8a03-8e7f1abef7b5",
                        "entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "glosses": [
                            "Versehen, Unabsichtlichkeit als Folge von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a085d2-4da9-4a9f-99e1-ae7ac29c0b2b",
                                "sense_id": "a0d41965-6bb9-37a9-8a03-8e7f1abef7b5",
                                "text": "\"This, we find, was an inadvertence; for even we, an enemy in the political sense, could never have sanctioned anything like unfairness in the defeat of Mozart, which it now seems was perpetrated.\"",
                                "translation": "Dies finden wir, war ein Versehen, denn auch wir, ein Feind im politischen Sinne, hätten nie etwas wie Ungerechtigkeit in der Besiegung von Mozart [eine Gruppe von Delegierten der Demokratischen Partei], die jetzt anscheinend verübt wurde, sanktioniert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7216de82-1a40-4e60-8c66-a5165e68d046",
                        "source_entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "source_sense_id": "0a805b79-ed64-32a9-82d3-4270de082965",
                        "source_sense_description": "Achtlosigkeit, Nachlässigkeit, Unachtsamkeit",
                        "target_lang_word": "Achtlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achtlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99083b7e-80f7-3d39-abe9-9c87009d594a",
                                        "entry_id": "9812d3ca-c8f4-3d63-8334-987d3057a21f",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße nachlässiges, unbedachtes (achtloses) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652080b1-e7ee-4a28-aa06-142d3ee9d7b2",
                                                "sense_id": "99083b7e-80f7-3d39-abe9-9c87009d594a",
                                                "text": "Durch Ihre Achtlosigkeit ist der Schaden innerhalb der vergangenen Woche deutlich größer geworden."
                                            },
                                            {
                                                "example_id": "76b8503a-1c61-41ab-acbd-d2fba6cc1d40",
                                                "sense_id": "99083b7e-80f7-3d39-abe9-9c87009d594a",
                                                "text": "Lieblosigkeit, nicht gehaltene Versprechen und andere Achtlosigkeiten gehörten zum Alltag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70756e2f-e7b3-4e04-87a8-44a40c561972",
                        "source_entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "source_sense_id": "0a805b79-ed64-32a9-82d3-4270de082965",
                        "source_sense_description": "Achtlosigkeit, Nachlässigkeit, Unachtsamkeit",
                        "target_lang_word": "Nachlässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachlässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                        "entry_id": "2e38d0bf-628c-3271-a3b9-39eeedf6ca37",
                                        "glosses": [
                                            "kritisierbares Handeln, das darin besteht, dass etwas nicht in der an sich erforderlichen Weise getan wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a2f0a0-58d5-4c91-bdbf-90afe75fcb6f",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Es wäre eine Nachlässigkeit von mir, den Hügel nicht zu erwähnen, der sich auf der Grenze zwischen dem Moorgelände und der Hauswiese befindet.“"
                                            },
                                            {
                                                "example_id": "3e20e9f0-c18e-4bf6-bb4d-350307f8b930",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Evolutionsbiologen erläutern diese Nachlässigkeit der Natur gerne mit dem Beispiel unserer Autos.“"
                                            },
                                            {
                                                "example_id": "589906a1-7b40-4b2a-8277-bf2e08dfd7d7",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Elaine fragt sich, ob eine derartige Nachlässigkeit in der Zeichensetzung ein Hinweis auf ein fehlendes emotionales Interesse an ihrem Leben sein könnte (obwohl sie ihrem Freund davon nichts erzählt.“"
                                            },
                                            {
                                                "example_id": "b5bfa3b5-53bb-4d26-a476-82b2de56b806",
                                                "sense_id": "d3ba122f-9609-3420-8b21-9d1544b2a5fe",
                                                "text": "„Germaine war nicht fortgegangen, und Gorju kam ab und zu, um den Garten umzugraben; denn aus Nachlässigkeit, aus Gleichgültigkeit gegen die materiellen Dinge hatten sie nachgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0ef02da-bfba-492f-90b9-9b35304ba254",
                        "source_entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "source_sense_id": "0a805b79-ed64-32a9-82d3-4270de082965",
                        "source_sense_description": "Achtlosigkeit, Nachlässigkeit, Unachtsamkeit",
                        "target_lang_word": "Unachtsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unachtsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                        "entry_id": "97ce76f5-fd05-37d5-ba4a-d5433f8b38dd",
                                        "glosses": [
                                            "Handlung mit mangelnder Sorgfalt, auch deren Ursache und Ergebnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf44aae1-e653-4f80-8de5-04f588ea896d",
                                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                                "text": "„Grund für den Unfall war eine Unachtsamkeit des Fahrers, teilen nun Staatsanwaltschaft und Polizei mit.“"
                                            },
                                            {
                                                "example_id": "9e2c6509-1a0d-42ba-8905-e2ebd9ed4d36",
                                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                                "text": "„Jede Art von Unachtsamkeit kann die Ursache für Unglücke, Missgeschicke, falsche Lebensführung, Verletzung und Missachtung von Regeln und Gesetzen werden.“"
                                            },
                                            {
                                                "example_id": "554599d0-fe71-4748-9ef3-70d0495a3c60",
                                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                                "text": "„Schon die Unachtsamkeit eines einzigen Mannes beim Pfeiferauchen konnte einen Brand auslösen, von dem Übermut der Siegesfeiern, bei denen sich Wodka und französischer Wein mischten, ganz zu schweigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a50b1257-2f66-4730-a857-4ecb1f2a3a94",
                        "source_entry_id": "6712d1c1-4500-3d1c-b187-7df19f885ee7",
                        "source_sense_id": "a0d41965-6bb9-37a9-8a03-8e7f1abef7b5",
                        "target_lang_word": "Versehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fbb1966-2cdc-3835-b8b3-3d450e5dbd97",
                                        "entry_id": "74c600e8-a445-3f79-8f93-535045369d88",
                                        "glosses": [
                                            "nicht beabsichtigtes Fehlverhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71570735-9063-4606-a0fc-e19768bd3b98",
                                                "sense_id": "8fbb1966-2cdc-3835-b8b3-3d450e5dbd97",
                                                "text": "Ich habe Ihnen aus Versehen die falschen Unterlagen zukommen lassen."
                                            },
                                            {
                                                "example_id": "a9180434-92e5-42af-8cd7-280566f7968d",
                                                "sense_id": "8fbb1966-2cdc-3835-b8b3-3d450e5dbd97",
                                                "text": "Ich bitte Sie, dieses Versehen zu entschuldigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
