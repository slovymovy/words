{
    "word_family": [
        "Scottish",
        "Scots",
        "hopscotch",
        "butterscotch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d19a02df-f531-3ca2-b3b7-be15ac7e4a74",
                    "sense_definition": "Of or from Scotland; Scottish.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adj_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a traditional <w>Scotch</w> egg during our picnic in the park.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались традиционным <w>шотландским</w> яйцом во время пикника в парке.",
                                "zh": "我们在公园野餐时享用了传统的<w>苏格兰</w>蛋。"
                            }
                        },
                        {
                            "text": "The garden was filled with hardy <w>Scotch</w> pines that could withstand the cold.",
                            "target_lang_translations": {
                                "ru": "Сад был полон выносливых <w>шотландских</w> сосен, способных выдержать холод.",
                                "zh": "花园里种满了能抵御严寒的耐寒<w>苏格兰</w>松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Scottish",
                        "Scots"
                    ],
                    "common_phrases": [
                        "Scotch whisky",
                        "Scotch egg",
                        "Scotch broth",
                        "Scotch pine",
                        "Scotch mist"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "when referring to people; 'Scottish' or 'Scots' is preferred"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шотландский; относящийся к Шотландии.",
                        "zh": "指苏格兰的，或来自苏格兰的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шотландский",
                                "target_lang_sense_clarification": "относящийся к Шотландии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏格兰的",
                                "target_lang_sense_clarification": "形容词，指与苏格兰有关的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e552873b-2135-39e4-9363-826bc4dffb1c",
                    "sense_definition": "Whisky distilled in Scotland, especially from malted barley.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_whisky",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He poured himself a glass of <w>Scotch</w> and sat by the fire.",
                            "target_lang_translations": {
                                "ru": "Он налил себе стакан <w>скотча</w> и сел у камина.",
                                "zh": "他给自己倒了一杯<w>苏格兰威士忌</w>，坐在火炉旁。"
                            }
                        },
                        {
                            "text": "The bartender recommended a single malt <w>Scotch</w> for the special occasion.",
                            "target_lang_translations": {
                                "ru": "Бармен порекомендовал односолодовый <w>скотч</w> для особого случая.",
                                "zh": "调酒师为这个特殊场合推荐了一款单一麦芽<w>苏格兰威士忌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "malt",
                        "Scotch whisky"
                    ],
                    "common_phrases": [
                        "single malt Scotch",
                        "bottle of Scotch",
                        "glass of Scotch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Виски, произведенный в Шотландии.",
                        "zh": "在苏格兰蒸馏的威士忌，通常由麦芽大麦制成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скотч",
                                "target_lang_sense_clarification": "разговорное название шотландского виски"
                            },
                            {
                                "target_lang_word": "шотландский виски",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏格兰威士忌",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2cdb1ae-3331-3870-a320-869f19f88ee5",
                    "sense_definition": "Transparent adhesive tape used for fastening paper or other light materials.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_tape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you pass me the <w>Scotch</w> so I can wrap this birthday present?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты передать мне <w>скотч</w>, чтобы я упаковал этот подарок на день рождения?",
                                "zh": "能把<w>透明胶带</w>递给我吗？我要包这个生日礼物。"
                            }
                        },
                        {
                            "text": "She repaired the torn page of the book with a small piece of <w>Scotch</w>.",
                            "target_lang_translations": {
                                "ru": "Она заклеила порванную страницу книги маленьким кусочком <w>скотча</w>.",
                                "zh": "她用一小块<w>透明胶带</w>修补了书里撕破的那一页。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "roll of Scotch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозрачная клейкая лента.",
                        "zh": "用于粘贴纸张或其他轻质材料的透明胶带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скотч",
                                "target_lang_sense_clarification": "клейкая лента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "透明胶带",
                                "target_lang_sense_clarification": "日常办公用品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07d9635d-612d-3894-8d2d-b2b8ae7f3fdb",
                    "sense_definition": "A block, wedge, or prop used to prevent a wheel or other round object from moving or slipping.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver placed a <w>scotch</w> behind the rear wheel to keep the truck from rolling down the hill.",
                            "target_lang_translations": {
                                "ru": "Водитель подложил <w>тормозной башмак</w> под заднее колесо, чтобы грузовик не скатился с холма.",
                                "zh": "司机在后轮后面放了一个<w>轮挡</w>，防止卡车顺着山坡滑下去。"
                            }
                        },
                        {
                            "text": "Ensure the <w>scotch</w> is firmly in place before you disconnect the trailer.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>тормозной башмак</w> надежно установлен, прежде чем отцеплять прицеп.",
                                "zh": "在断开拖车连接前，请确保<w>轮挡</w>已牢固放置。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chock",
                        "block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Клиновидная колодка или брусок, подкладываемый под колесо для предотвращения скатывания.",
                        "zh": "用于防止轮子或其他圆形物体移动或滑动的楔形物或垫块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормозной башмак",
                                "target_lang_sense_clarification": "устройство для фиксации колес"
                            },
                            {
                                "target_lang_word": "клин",
                                "target_lang_sense_clarification": "предмет клиновидной формы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮挡",
                                "target_lang_sense_clarification": "用于固定车辆的装置"
                            },
                            {
                                "target_lang_word": "楔子",
                                "target_lang_sense_clarification": "用于卡住物体的楔形物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2416a169-ac94-36e2-ba18-74b987032acc",
                    "sense_definition": "To prevent something from being successful; to put an end to a plan or rumor.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_stop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden storm <w>scotched</w> our plans for a weekend camping trip.",
                            "target_lang_translations": {
                                "ru": "Внезапный шторм <w>сорвал</w> наши планы на поход в выходные.",
                                "zh": "突如其来的暴风雨<w>挫败</w>了我们周末露营的计划。"
                            }
                        },
                        {
                            "text": "The CEO quickly <w>scotched</w> the rumors about the company merging with a competitor.",
                            "target_lang_translations": {
                                "ru": "Генеральный директор быстро <w>пресек</w> слухи о слиянии компании с конкурентом.",
                                "zh": "首席执行官迅速<w>平息</w>了关于公司将与竞争对手合并的传言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thwart",
                        "foil",
                        "put the kibosh on"
                    ],
                    "common_phrases": [
                        "scotch a rumor",
                        "scotch a plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить конец чему-либо; пресечь (планы, слухи).",
                        "zh": "阻止某事成功；终结某项计划或谣言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пресечь",
                                "target_lang_sense_clarification": "остановить развитие чего-либо (слухов, действий)"
                            },
                            {
                                "target_lang_word": "сорвать",
                                "target_lang_sense_clarification": "нарушить планы"
                            },
                            {
                                "target_lang_word": "положить конец",
                                "target_lang_sense_clarification": "прекратить что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挫败",
                                "target_lang_sense_clarification": "使计划落空"
                            },
                            {
                                "target_lang_word": "平息",
                                "target_lang_sense_clarification": "终止谣言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d54dfbdf-34d6-3188-b9a5-2901d3395178",
                    "sense_definition": "To block a wheel or other object with a wedge to prevent it from moving.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_block",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>scotched</w> the wheels of the wagon so it wouldn't roll away.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>застопорили</w> колеса вагона, чтобы он не покатился.",
                                "zh": "工人们用楔子<w>固定</w>住了货车的轮子，以免它滑走。"
                            }
                        },
                        {
                            "text": "Make sure to <w>scotch</w> the vehicle securely when parking on such a steep incline.",
                            "target_lang_translations": {
                                "ru": "Обязательно надежно <w>зафиксируйте</w> автомобиль при парковке на таком крутом склоне.",
                                "zh": "在如此陡峭的斜坡上停车时，一定要确保将车辆<w>固定</w>好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chock",
                        "block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заблокировать колесо клином или упором.",
                        "zh": "用楔子卡住轮子或其他物体以防止其移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застопорить",
                                "target_lang_sense_clarification": "зафиксировать от движения"
                            },
                            {
                                "target_lang_word": "заблокировать",
                                "target_lang_sense_clarification": "предотвратить движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞住",
                                "target_lang_sense_clarification": "用物体卡住"
                            },
                            {
                                "target_lang_word": "固定",
                                "target_lang_sense_clarification": "防止移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ac8fffee-cc38-3629-bfd1-c5225c8d3e20",
                    "sense_definition": "The people of Scotland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_people",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "Historically, the <w>Scotch</w> were known for their resilience and strong cultural identity.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>шотландцы</w> были известны своей стойкостью и сильной культурной самобытностью.",
                                "zh": "从历史上看，<w>苏格兰人</w>以坚韧不拔和强烈的文化认同感而闻名。"
                            }
                        },
                        {
                            "text": "He proudly traced his ancestry back to the <w>Scotch</w> who settled in the region.",
                            "target_lang_translations": {
                                "ru": "Он с гордостью прослеживал свою родословную до <w>шотландцев</w>, поселившихся в этом регионе.",
                                "zh": "他自豪地追溯自己的祖先，发现他们是定居在该地区的<w>苏格兰人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Scots",
                        "Scottish"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often considered offensive; 'Scots' or 'Scottish' is preferred"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жители Шотландии.",
                        "zh": "苏格兰人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шотландцы",
                                "target_lang_sense_clarification": "народ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏格兰人",
                                "target_lang_sense_clarification": "指代苏格兰民族"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f949b194-04c4-3f2d-9b95-3aab1020c6dd",
                    "sense_definition": "The Scots language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The poet wrote his verses in broad <w>Scotch</w> to capture the local dialect.",
                            "target_lang_translations": {
                                "ru": "Поэт писал свои стихи на простом <w>шотландском</w>, чтобы передать местный диалект.",
                                "zh": "诗人用浓重的<w>苏格兰语</w>写诗，以捕捉当地的方言特色。"
                            }
                        },
                        {
                            "text": "It can be difficult for outsiders to understand when the locals speak <w>Scotch</w>.",
                            "target_lang_translations": {
                                "ru": "Посторонним бывает трудно понять, когда местные говорят на <w>шотландском</w>.",
                                "zh": "当当地人说<w>苏格兰语</w>时，外地人可能很难听懂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Scots"
                    ],
                    "common_phrases": [
                        "broad Scotch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шотландский язык (германской группы).",
                        "zh": "苏格兰语（日耳曼语族）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шотландский язык",
                                "target_lang_sense_clarification": "язык скотс"
                            },
                            {
                                "target_lang_word": "скотс",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏格兰语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}