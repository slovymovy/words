                ],
                "senses": [
                    {
                        "sense_id": "d89e191f-1d7d-3512-be37-b36a6165e2cb",
                        "entry_id": "8fe5310b-697c-36a5-8b5f-314d7a62be71",
                        "glosses": [
                            "Werkzeug aus Metall/Plastik oder Holz, das einen Handgriff hat und an der Spitze eine Kante, mit der man zum Beispiel Material entnehmen oder glattstreichen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd494fdc-33a0-4575-95f5-152dd5c1e4cf",
                                "sense_id": "d89e191f-1d7d-3512-be37-b36a6165e2cb",
                                "text": "Sie verstrich die Creme mit einem Spatel."
                            },
                            {
                                "example_id": "ce801475-8179-46cc-8846-a60dbff0514f",
                                "sense_id": "d89e191f-1d7d-3512-be37-b36a6165e2cb",
                                "text": "Der Zahnarzt drückt die Zunge mit einem Spatel nach unten."
                            },
                            {
                                "example_id": "2830824e-a5fe-472f-99f6-d5fd82a051cf",
                                "sense_id": "d89e191f-1d7d-3512-be37-b36a6165e2cb",
                                "text": "„Auf einmal platzte der Destillierkolben mit dem Knall einer Granate in zwanzig Stücke, die bis an die Decke flogen, die Kochtöpfe zersplitterten, die Schaumlöffel plattschlugen und die Gläser zerbrachen; Kohlenstücke spritzten herum, der Ofen war zertrümmert – und am nächsten Tage fand Germaine einen Spatel auf dem Hof.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae848ef2-1104-4bcb-971d-b94bfe9d6e86",
                        "source_entry_id": "8fe5310b-697c-36a5-8b5f-314d7a62be71",
                        "source_sense_id": "d89e191f-1d7d-3512-be37-b36a6165e2cb",
