                    "frequency": "Low",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai encore croisé monsieur machin <w>chouette</w> en allant faire mes courses au marché."
                        },
                        {
                            "text": "Où est-ce que tu as rangé ce bidule truc <w>chouette</w> qui sert à ouvrir les bouteilles ?"
