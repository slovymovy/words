                        "glosses": [
                            "To undo an abortion (in various senses)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3dd15b35-7378-4a8b-a2d6-52ab455d93cf",
                                "sense_id": "ee1b7cde-de2b-3d75-846c-a3ffb7218fdc",
                                "text": "Well, she can't unabort that baby."
                            },
                            {
                                "example_id": "3f5d14d4-9f1f-49ba-a25f-e3dbd3b7c5f1",
                                "sense_id": "ee1b7cde-de2b-3d75-846c-a3ffb7218fdc",
                                "text": "She can't unabort, and trying to blame a previous abortion is rather like blaming illness on that old lady next door cursing you."
                            },
                            {
                                "example_id": "cb65dc3b-160f-4e96-900b-cb5c38feb799",
                                "sense_id": "ee1b7cde-de2b-3d75-846c-a3ffb7218fdc",
                                "text": "He was practicing aborting his pilot training, but then he really did abort! By then it was too late to unabort, eh Herbot?"
                            },
                            {
                                "example_id": "e6b2db89-3c14-42fd-8641-48e73ac52bae",
                                "sense_id": "ee1b7cde-de2b-3d75-846c-a3ffb7218fdc",
                                "text": "You'll never be able to unabort the baby that was alive in your womb years ago."
                            }
                        ]
                    }
