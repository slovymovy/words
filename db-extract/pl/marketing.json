                                                "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                                "text": "Marketing umfasst mehr als nur Zeitungsanzeigen und Fernsehwerbespots für ein Produkt."
                                            },
                                            {
                                                "example_id": "97893ce8-501c-43de-99f2-a20926415f7c",
                                                "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                                "text": "Es gibt verschiedene Entwicklungsphasen des Marketing."
                                            },
                                            {
                                                "example_id": "c65dabdf-3187-4e10-84cb-2f66bb4945a2",
                                                "sense_id": "b7dd03ac-b894-3e02-8138-c7d8f379e9c1",
                                                "text": "„Und ein gutes Marketing kann auch bei künstlerischen Produkten folgenreich sein.“"
                                            }
