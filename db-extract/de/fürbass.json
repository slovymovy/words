                            {
                                "example_id": "b288d004-724e-41a3-8e6d-db1c38c49fec",
                                "sense_id": "e3a7b483-f4a2-3d47-9cc3-03ec61dbff05",
                                "text": "Ein älterer Mann sah uns: „Ihr tickt doch nicht mehr sauber!“ – sprach’s und schritt fürbass.",
                                "translation": "An older man saw us: “You must be off your heads!” – said it and walked past.",
                                "english": "An older man saw us: “You must be off your heads!” – said it and walked past."
                            },
                            {
                                "example_id": "6897faf1-030b-4912-84e7-4b8cd165ed11",
                                "sense_id": "e3a7b483-f4a2-3d47-9cc3-03ec61dbff05",
                                "text": "Ich ging fürbaß, und wie ich ging, / Da sah ich vor mir liegen, / Auf freiem Platz, ein großes Schloß, / Die Giebel hoch aufstiegen.",
                                "translation": "Book of Songs",
                                "english": "Book of Songs"
                            }
                        ]
                    }
