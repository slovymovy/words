                    {
                        "sense_id": "d8645f93-9b2f-333c-9175-57c3d604a25d",
                        "entry_id": "a0dae190-8cee-3c1c-94da-77914566dd29",
                        "glosses": [
                            "Alternative form of further. (See also the usage notes at further.)"
                        ],
                        "tags": [
