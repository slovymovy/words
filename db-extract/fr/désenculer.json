                        "glosses": [
                            "Cesser d’enculer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49debea-36a4-49d9-bef1-985471a169cf",
                                "sense_id": "dd0036ac-2aa2-37de-aac5-8dad9c21255d",
                                "text": "Je suis là pour que la marmaille désencule."
                            },
                            {
                                "example_id": "ea2352f1-8074-4ef8-9ede-502065030c79",
                                "sense_id": "dd0036ac-2aa2-37de-aac5-8dad9c21255d",
                                "text": "Tous ces Messieurs près de nous ne sont que des couillons ; je suis en état de foutre dix coups sans désenculer, quand je foutais en con, j’aurais foutu toute une communauté de religieuses sans blêmir."
                            },
                            {
                                "example_id": "8fc69e21-7de3-475d-92a8-4ef4c00ef5af",
                                "sense_id": "dd0036ac-2aa2-37de-aac5-8dad9c21255d",
                                "text": "Tout le monde se sauve, le type désenculé, froc à mi-cuisses, saute par-dessus des planches, trébuche."
                            }
                        ]
                    }
