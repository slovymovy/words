        "nl-extract.jsonl": [
            {
                "entry_id": "90240d82-534b-3345-9d2f-3a9da2910973",
                "word": "wederopbouw",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f30180c1-fd88-3c67-8e20-d1255a4afbb5",
                        "entry_id": "90240d82-534b-3345-9d2f-3a9da2910973",
                        "glosses": [
                            "periode waarin de oorlogsschade door de Tweede Wereldoorlog werd hersteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700c296f-2804-4637-b302-11a1524b6d8c",
                                "sense_id": "f30180c1-fd88-3c67-8e20-d1255a4afbb5",
                                "text": "Het begin van de periode wordt gemarkeerd door het Besluit betreffende de Wederopbouw I van 21 mei 1940 (na het bombardement op Rotterdam - dat is dus al aan het begin van de Duitse bezetting van Nederland)."
                            },
                            {
                                "example_id": "1cb1b943-f9a6-4f58-838b-d202a500f5e2",
                                "sense_id": "f30180c1-fd88-3c67-8e20-d1255a4afbb5",
                                "text": "Koning verzocht hem toen de leiding te willen nemen bij het herstel en de wederopbouw van Paleis Duimgat, iets dat Kleine Woord werkelijk niet kon weigeren en trouwens graag deed ook, want overal was wel iets van te leren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42fba03b-5201-450c-8c3c-5167e9483d46",
                        "source_entry_id": "90240d82-534b-3345-9d2f-3a9da2910973",
                        "source_sense_id": "f30180c1-fd88-3c67-8e20-d1255a4afbb5",
                        "source_sense_description": "periode waarin de oorlogsschade door de Tweede Wereldoorlog werd hersteld",
                        "target_lang_word": "Wiederaufbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederaufbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                        "entry_id": "a709bdc0-5a19-35fa-8db0-34004ffd13a3",
                                        "glosses": [
                                            "Wiedererrichtung von Zerstörtem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094a9f51-5a50-4e15-a45c-c76857583a62",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Im März beginnen die Vorarbeiten zum Wiederaufbau des Berliner Schlosses als Haus der Weltkulturen unter dem Namen Humboldt-Forum, frühestens 2018 dürfte es fertig sein.“"
                                            },
                                            {
                                                "example_id": "f0a70c3e-adaa-4f19-a771-1586b6acbf5c",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Er beschloss, sich mit aller Kraft für den Wiederaufbau des Bogens einzusetzen und sich als Urheber einer entsprechenden Kampagne einen Namen zu machen.“"
                                            },
                                            {
                                                "example_id": "cce594f3-aa6b-4cc2-84de-ab04f330b577",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Der Wiederaufbau sorgte für Ärger, aber auch für surreale Momente.“"
                                            },
                                            {
                                                "example_id": "a0f7fa9d-d624-4aa2-b1ce-6883fc52c233",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Es gab keine gesetzliche Möglichkeit, den Vertrieb ‚kulturell minderwertiger oder schädlicher Filme‘ zu untersagen, wie das für das Kinowesen zuständige Ministerium für Handel und Wiederaufbau auf Anfrage bedauernd mitteilte.“"
                                            },
                                            {
                                                "example_id": "194d6348-839b-4c4b-a75d-1c95ce90438a",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "[Hans Böckler:] „1945 begann er mit dem Wiederaufbau der Gewerkschaften in der Britischen Zone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4605959a-c498-446c-a2ef-c0de52182375",
                        "source_entry_id": "90240d82-534b-3345-9d2f-3a9da2910973",
