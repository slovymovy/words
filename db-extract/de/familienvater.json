                        "form": "den Familienvater"
                    },
                    {
                        "form_id": "736bd524-55d4-445d-b9a2-a6aa6077c8b2",
                        "entry_id": "e8b49b90-e3d5-3136-9d77-b1e8030acdd5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Familienväter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                        "entry_id": "e8b49b90-e3d5-3136-9d77-b1e8030acdd5",
                        "glosses": [
                            "ein Mann, der mindestens ein Kind hat und in der Regel zusammen mit der Mutter für dieses Kind im Rahmen einer Familie sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b5b123-6d1c-4923-bb5d-ab05b2498b88",
                                "sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                                "text": "„Ein fast 50-jähriger Familienvater geht regelmäßig fremd.“"
                            },
                            {
                                "example_id": "ec86d67a-9d1e-41b0-825b-2367d7c0aa8a",
                                "sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                                "text": "„Familiendrama mit drei Toten: Familienvater tötet Frau, Tochter und sich selbst“"
                            },
                            {
                                "example_id": "2f3957a1-3a02-418e-85bf-a32cfccf75fa",
                                "sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                            },
                            {
                                "example_id": "0f611dd9-e5bc-4b95-a09b-19054e654575",
                                "sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                                "text": "„Nur ein Familienvater hatte so verzweifelt sein können, an einem so abseits gelegenen Fleck sein Glück zu versuchen.“"
                            },
                            {
                                "example_id": "142d57e1-9ad4-40d5-8471-69eede591494",
                                "sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                                "text": "„Der Bootsmann begriff den Witz gleich. Ein guter Mann, umsichtig, schnell von Kapee und ein vorsorgender Familienvater.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "957bb25c-4c75-49b4-b78d-e8291b184985",
                        "source_entry_id": "e8b49b90-e3d5-3136-9d77-b1e8030acdd5",
                        "source_sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                        "source_sense_description": "Vater der Familie",
                        "target_lang_word": "family man",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "family man",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abb956b0-f8cd-39e2-9dcc-76848e8da09b",
                                        "entry_id": "3f572eee-5b81-365c-b5bb-24f10924a3a9",
                                        "glosses": [
                                            "An adult male with a spouse and children to whose well-being he is dedicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26892848-1c6e-4a4e-8ca7-cec4fc1ad9b9",
                                                "sense_id": "abb956b0-f8cd-39e2-9dcc-76848e8da09b",
                                                "text": "But the breakup and awkward love rectangle were a recurring topic in Google's gossip mill, adding even more tension. Page, a devout family man, didn't speak with his co-founder for some time afterward."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9be9df52-d424-4720-94dd-2c693b4e36cb",
                        "source_entry_id": "e8b49b90-e3d5-3136-9d77-b1e8030acdd5",
                        "source_sense_id": "ea820789-cc81-382a-b8e7-301c9c338ff4",
                        "source_sense_description": "Vater der Familie",
                        "target_lang_word": "père de famille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "père de famille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "803aefb0-4049-383a-b8fe-f6f2eb9af8e3",
                                        "entry_id": "6f107db8-0f2a-3c53-bb0f-b92eb5066347",
                                        "glosses": [
                                            "Homme qui a des enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9642c1f8-4e4c-4c19-8235-8420c4881bd8",
                                                "sense_id": "803aefb0-4049-383a-b8fe-f6f2eb9af8e3",
                                                "text": "Il trouva une brochure « à l’usage des pères de famille », dont l’auteur concluait en affirmant que le vice solitaire, quand il ne menait pas à une mort affreuse, conduisait inévitablement à la folie ou au suicide."
                                            },
                                            {
                                                "example_id": "8f6df197-4232-4918-9b1d-f8a23570a4cf",
                                                "sense_id": "803aefb0-4049-383a-b8fe-f6f2eb9af8e3",
                                                "text": "En Laponie, le père de famille tient à honneur que sa fille soit l’objet de toutes les gracieusetés dont peut disposer le voyageur admis à son foyer."
                                            },
                                            {
                                                "example_id": "358dba09-4bd8-4de2-b647-3b5b15b4d474",
                                                "sense_id": "803aefb0-4049-383a-b8fe-f6f2eb9af8e3",
                                                "text": "Quand je pense qu’il existe des gens assez dépensiers, des pères de famille même, pour se payer des fiacres, alors que Paris tout entier est couvert de lignes d’omnibus, eh bien ! cela ne me donne pas une haute idée de leurs vertus domestiques."
                                            },
                                            {
                                                "example_id": "501a97da-373f-4b36-b20d-f7bd42bd81c6",
                                                "sense_id": "803aefb0-4049-383a-b8fe-f6f2eb9af8e3",
                                                "text": "On vous assène, à chaque instant, sur la tête, « les prérogatives du père de famille », qui donc revendiquera contre tout le monde les droits criants de l’enfant ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7386f65-618b-41f0-8f70-69ca7ae3cbe5",
                        "source_entry_id": "e8b49b90-e3d5-3136-9d77-b1e8030acdd5",
