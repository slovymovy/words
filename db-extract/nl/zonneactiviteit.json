                        "glosses": [
                            "het uitstoten van zonnevlammen door de zon; de aanwezigheid van zonnevlekken op het zonoppervlak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676fef1d-e26c-4694-bd94-3da4677249d6",
                                "sense_id": "71703afa-4a80-3ae3-a189-e34c9e57f7dc",
                                "text": "Waarschijnlijk heeft de grote hoeveelheid zonnevlammen te maken met de steeds toenemende zonneactiviteit. Die activiteit neemt door de jaren golfsgewijs toe en af over een periode van elf jaar. De zon is nu bijna op het hoogtepunt van haar activiteit, waardoor er steeds meer krachtige zonnevlammen te zien zijn."
                            },
                            {
                                "example_id": "5e6028cf-e817-411b-8477-dea6827a93ad",
                                "sense_id": "71703afa-4a80-3ae3-a189-e34c9e57f7dc",
                                "text": "Het poollicht was zelden zo mooi. Dat is geen persoonlijke noot, maar de inschatting van experts terzake. De elfjarige 'Zonnecyclus van Schwabe' zit in het midden van zijn piek, de periode met de meeste zonneactiviteit dus, wat voor extra mooie waarnemingen van het noorder- en het zuiderlicht zorgt."
                            }
                        ]
                    }
