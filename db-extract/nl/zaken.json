                                    },
                                    {
                                        "sense_id": "f85122ce-3493-3475-9b50-03db3c571af9",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "The collective noun for a group of ferrets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4485ed3-e152-40b5-9092-b8f1a057e913",
                                                "sense_id": "f85122ce-3493-3475-9b50-03db3c571af9",
                                                "text": "I'm sure his goons will go through the ship like a business of ferrets, and they'll want to look in our baggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d8c658d-ebdd-37d3-9a0e-141bece9c508",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
