                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financiën",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De maandelijkse <w>lasten</w> voor de hypotheek zijn de afgelopen jaren gestegen.",
                            "target_lang_translations": {
                                "en": "The monthly mortgage <w>charges</w> have risen in recent years."
                            }
                        },
                        {
                            "text": "Het bedrijf probeert de vaste <w>lasten</w> zo laag mogelijk te houden.",
                            "target_lang_translations": {
                                "en": "The company tries to keep the fixed <w>costs</w> as low as possible."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vaste lasten"
                    ],
                    "target_lang_definitions": {
                        "en": "financial expenses or costs that must be paid"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "charges",
                                "target_lang_sense_clarification": "financial costs or expenses"
                            },
                            {
                                "target_lang_word": "expenses",
                                "target_lang_sense_clarification": "money spent on something"
                            },
                            {
                                "target_lang_word": "costs",
                                "target_lang_sense_clarification": "the amount of money needed for something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acf2179f-f8b3-3738-acfa-2e8fbf56cb97",
                    "sense_definition": "een officiële opdracht, plicht of bevel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opdracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat handelde in <w>last</w> van zijn cliënt.",
                            "target_lang_translations": {
                                "en": "The lawyer acted on <w>behalf</w> of his client."
                            }
                        },
                        {
                            "text": "De politie kreeg de <w>last</w> om het gebouw onmiddellijk te ontruimen.",
                            "target_lang_translations": {
                                "en": "The police were given the <w>order</w> to evacuate the building immediately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in last van"
                    ],
                    "target_lang_definitions": {
                        "en": "an official assignment, duty, or command"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "an official instruction or task"
                            },
                            {
                                "target_lang_word": "commission",
                                "target_lang_sense_clarification": "an instruction or command to act"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "an authoritative command"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd00c077-74b9-3b39-9867-a47041542d12",
                    "sense_definition": "een oude maat voor volume, gelijk aan ongeveer drie kubieke meter",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zeventiende eeuw werd de capaciteit van schepen vaak in <w>last</w> uitgedrukt.",
                            "target_lang_translations": {
                                "en": "In the seventeenth century, the capacity of ships was often expressed in <w>lasts</w>."
                            }
                        },
                        {
                            "text": "De graanhandel gebruikte de <w>last</w> als standaardmaat voor grote hoeveelheden.",
                            "target_lang_translations": {
                                "en": "The grain trade used the <w>last</w> as a standard measure for large quantities."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historische maateenheid"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an old unit of volume, equal to approximately three cubic meters"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "historical unit of weight or volume"
                            },
                            {
                                "target_lang_word": "burden",
                                "target_lang_sense_clarification": "historical measure of ship capacity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4cbd32d-989e-3a62-9499-184a84521b19",
                    "sense_definition": "tweede of derde persoon enkelvoud tegenwoordige tijd van <w>lassen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman <w>last</w> de twee metalen buizen stevig aan elkaar.",
                            "target_lang_translations": {
                                "en": "The craftsman <w>welds</w> the two metal pipes firmly together."
                            }
                        },
                        {
                            "text": "Jij <w>last</w> die onderdelen veel sneller dan de nieuwe leerling.",
                            "target_lang_translations": {
                                "en": "You <w>weld</w> those parts much faster than the new apprentice."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van lassen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second or third person singular present tense of 'to weld'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "welds",
                                "target_lang_sense_clarification": "joining metal parts by heating"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e5e0d5-51e5-3888-ad9a-d1b6d14d3be7",
                    "sense_definition": "enkelvoud tegenwoordige tijd of gebiedende wijs van <w>lasten</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>last</w> een korte pauze in om even uit te rusten.",
                            "target_lang_translations": {
                                "en": "I am <w>scheduling</w> a short break to rest for a moment."
                            }
                        },
                        {
                            "text": "<w>Last</w> onmiddellijk een vergadering in om dit probleem te bespreken!",
                            "target_lang_translations": {
                                "en": "<w>Call</w> a meeting immediately to discuss this problem!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een pauze inlasten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van lasten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular present tense or imperative of 'to schedule/insert'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "schedule",
                                "target_lang_sense_clarification": "to arrange or insert into a timeline"
                            },
                            {
                                "target_lang_word": "insert",
                                "target_lang_sense_clarification": "to put something in between"
                            }
                        ]
                    }
                }
            ]
        }
    ]
