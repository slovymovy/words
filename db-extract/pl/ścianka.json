                "senses": [
                    {
                        "sense_id": "dd4e2517-6cf1-33b7-bb42-33ab0ab46e57",
                        "entry_id": "d23f48a9-1348-3945-9a82-b0b09274cbe2",
                        "glosses": [
                            "cienka, prowizoryczna ściana; przepierzenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b99e59-0604-4008-b90b-44e70a4aeaf1",
                                "sense_id": "dd4e2517-6cf1-33b7-bb42-33ab0ab46e57",
                                "text": "Postawiliśmy w biurze ściankę, żeby wygospodarować pomieszczenie socjalne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "90656430-b50d-3204-bfbe-426ab0afd741",
                        "entry_id": "d23f48a9-1348-3945-9a82-b0b09274cbe2",
                        "glosses": [
                            "płaszczyzna ograniczająca jakiś przedmiot; bok niewielkiego przedmiotu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f588a5b9-c8b7-4cec-b8d9-39b3e5726ddb",
                                "sense_id": "90656430-b50d-3204-bfbe-426ab0afd741",
                                "text": "Nie lubię tego kubka, bo na ściankach zawsze zostaje osad z herbaty."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "c06dab11-b5c9-3410-98d0-df1047c45a57",
                        "entry_id": "d23f48a9-1348-3945-9a82-b0b09274cbe2",
                        "glosses": [
                            "bardzo strome, ale niewysokie zbocze skalne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e42fb6-fcc4-406a-9f07-d27a56520012",
                                "sense_id": "c06dab11-b5c9-3410-98d0-df1047c45a57",
                                "text": "Zrobiliśmy sobie zdjęcie przy ściance skalnej."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "ba31423e-e31b-38cb-bceb-3a2484fbcf0b",
                        "entry_id": "d23f48a9-1348-3945-9a82-b0b09274cbe2",
                        "glosses": [
                            "zob. ścianka wspinaczkowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4cedf6-2a89-4c4e-80d6-420b0cca0385",
                                "sense_id": "ba31423e-e31b-38cb-bceb-3a2484fbcf0b",
                                "text": "W wolnych chwilach chodzimy ze znajomymi na ściankę."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "bcb9fbeb-3397-3b56-a0b2-391cdb0255c9",
                        "entry_id": "d23f48a9-1348-3945-9a82-b0b09274cbe2",
                        "glosses": [
                            "powierzchnia zawierająca logo sponsorów, na tle której fotografują się gwiazdy i celebryci podczas pokazów mody"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
