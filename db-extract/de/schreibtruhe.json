                "senses": [
                    {
                        "sense_id": "05001f55-d405-34ba-8aae-5555ae3ce85d",
                        "entry_id": "38f616eb-d633-346d-9c26-79d63af23877",
                        "glosses": [
                            "Behälter für wichtige Papiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05cabd97-a04c-43ad-87c2-1b37e8cbb132",
                                "sense_id": "05001f55-d405-34ba-8aae-5555ae3ce85d",
                                "text": "„Als sie Wills Stimme auf der Treppe hörte, faltete sie das Pergament rasch zusammen und verstaute es in ihrer Schreibtruhe.“"
                            },
                            {
                                "example_id": "ab8acc20-16e4-4ef3-bc6c-cb2aca142b4e",
                                "sense_id": "05001f55-d405-34ba-8aae-5555ae3ce85d",
                                "text": "„Mit Vetter Ringwolf habe ich mir den Schlüssel besorgt zu deiner Schreibtruhe.“"
                            },
                            {
                                "example_id": "851a74a3-4ac0-45af-aed5-7cac60a50a66",
                                "sense_id": "05001f55-d405-34ba-8aae-5555ae3ce85d",
                                "text": "„Eine kleine Schreibtruhe steht unsicher auf einem Klavierhocker, und zwei Marmorlöwen sitzen vor einem Wäscheständer.“"
                            },
                            {
                                "example_id": "b6807ab6-1ff4-489b-84e6-26715d223e88",
                                "sense_id": "05001f55-d405-34ba-8aae-5555ae3ce85d",
                                "text": "„Die ‚Lade‘ ursprünglich als Schreibtruhe verwendet, in der Amtssiegel, Formulare und Gemeindekasse verwahrt wurden, wird dabei vom Haus des Altbürgermeisters im Rahmen eines Festzuges zum neuen Bürgermeister gebracht.“"
                            },
                            {
                                "example_id": "bfcaa61f-69fc-49d1-afb0-9f87effb59c5",
                                "sense_id": "05001f55-d405-34ba-8aae-5555ae3ce85d",
                                "text": "„Die Lokalisierung nach Nürnberg legt einen Auftraggeber im protestantischen Patriziat der Reichsstadt nahe, bis die kostbare Schreibtruhe zum Reliquiar umgewidmet wurde und ihren Weg in das Heiltum des Augsburger Ulrichsklosters fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
