                                        "sense_id": "838e8539-300f-381b-b67b-5560cab1bb86",
                                        "entry_id": "55d90b82-d4b4-3059-94d4-fb5690f42176",
                                        "glosses": [
                                            "Cuir préparé, buffle."
                                        ],
