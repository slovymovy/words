                ],
                "senses": [
                    {
                        "sense_id": "273277a0-4e8f-3d18-8fa7-5dbaeb1a1308",
                        "entry_id": "3d770ddc-4d47-3699-8bba-eac7d64e6bda",
                        "glosses": [
                            "Assurance permettant de constituer un fonds de secours alimenté par des cotisations et de verser des allocations de chômage en cas de perte d’emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5dee484-08a9-413c-b217-cbb0f8935b66",
                                "sense_id": "273277a0-4e8f-3d18-8fa7-5dbaeb1a1308",
                                "text": "Dans 22 associations pratiquant l’assurance-chômage, 171 membres étaient indemnisés du chef de leur chômage, tandis que 190 chômeurs ne recevaient pas d’indemnité."
                            },
                            {
                                "example_id": "64e9e575-fa05-46d4-8ac1-380f07a1d56f",
                                "sense_id": "273277a0-4e8f-3d18-8fa7-5dbaeb1a1308",
                                "text": "Bien que l’assurance-chômage soit un programme fédéral, elle est la plus importante preuve de variation interprovinciale et de convergence transfrontalière au niveau régional."
                            },
                            {
                                "example_id": "dfd565ca-cc97-4c58-99fe-42da3547c2c4",
                                "sense_id": "273277a0-4e8f-3d18-8fa7-5dbaeb1a1308",
                                "text": "Le ministre du Travail, Olivier Dussopt, a annoncé sur France 3 que la concertation sur la réforme de l’assurance-chômage, qui doit faire varier les indemnités versées en fonction de la conjoncture, sera ouverte « dans une dizaine de jours »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
