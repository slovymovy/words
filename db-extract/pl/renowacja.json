                    {
                        "translation_id": "461b17c9-7b77-48da-ac06-5613e7e17f26",
                        "source_entry_id": "7dbbb4d1-e99b-3dd5-a2e4-f86b47d78d15",
                        "source_sense_id": "6e5a5824-90ad-35b8-9f0c-38a98477c448",
                        "target_lang_word": "renovation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renovation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd2fb21-ead6-3b85-bbce-49f7d2e5605e",
                                        "entry_id": "bb2ad9d8-39b7-34d2-bf3b-fd83aff982cd",
                                        "glosses": [
                                            "An act, or the process, of renovating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6038808-1ad8-44d2-afd0-9cdcad2ac5ec",
                                                "sense_id": "1cd2fb21-ead6-3b85-bbce-49f7d2e5605e",
                                                "text": "Meronyms: (building renovation) demo, demolition, rebuilding"
                                            },
                                            {
                                                "example_id": "90f914a4-6dfc-4ff1-878e-28abf58ad179",
                                                "sense_id": "1cd2fb21-ead6-3b85-bbce-49f7d2e5605e",
                                                "text": "Near-synonym: (building renovation) remodeling"
                                            },
                                            {
                                                "example_id": "6de9a967-7daf-4e66-8b67-725f50f71f5b",
                                                "sense_id": "1cd2fb21-ead6-3b85-bbce-49f7d2e5605e",
                                                "text": "His room was currently under renovation."
                                            },
                                            {
                                                "example_id": "7bfe9575-0c56-4066-84e7-7573502c12b6",
                                                "sense_id": "1cd2fb21-ead6-3b85-bbce-49f7d2e5605e",
                                                "text": "During the course, the Cijin District Office, the frontline local government unit in charge of executing the tomb's renovation, also worked hard to communicate with the deceased's families about how to redesign the space."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bc64f0-31ec-3b26-9736-e462d8802c2e",
                                        "entry_id": "bb2ad9d8-39b7-34d2-bf3b-fd83aff982cd",
                                        "glosses": [
                                            "Regeneration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82d39f4c-0b02-4428-a481-9baa8d48c698",
                        "source_entry_id": "7dbbb4d1-e99b-3dd5-a2e4-f86b47d78d15",
                        "source_sense_id": "6e5a5824-90ad-35b8-9f0c-38a98477c448",
                        "target_lang_word": "rénovation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rénovation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5340440-4d85-3b39-8331-9a9a1a7329aa",
                                        "entry_id": "875b0394-b549-30f5-af03-4e2e2688a7c7",
                                        "glosses": [
                                            "Renouvellement, régénération physique ou morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebb818b-dbf0-4890-b781-f386baba2fc8",
                                                "sense_id": "c5340440-4d85-3b39-8331-9a9a1a7329aa",
                                                "text": "L'avènement du féminisme, mais d'un féminisme sérieux et familial, sera de toute manière indispensable à la rénovation de nos manières de vivre."
                                            },
                                            {
                                                "example_id": "8d96bf27-dbf1-474b-81b9-0124ade55845",
                                                "sense_id": "c5340440-4d85-3b39-8331-9a9a1a7329aa",
                                                "text": "En France particulièrement, deux grands géodésiens, le général François Perrier (1833-1888) et son fils le général Georges Perrier (mort en 1946), accomplirent les travaux monumentaux qui allaient aboutir à une rénovation complète de la géodésie française."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1bc013-12fa-3452-b9c7-fe14c0d3b21c",
                                        "entry_id": "875b0394-b549-30f5-af03-4e2e2688a7c7",
                                        "glosses": [
                                            "Action de rénover un bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f751e70-1a46-4363-93a0-f4b7d78c3dec",
                                                "sense_id": "2b1bc013-12fa-3452-b9c7-fe14c0d3b21c",
                                                "text": "La rénovation du Grand Palais"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8412af4-bc30-3230-a90e-f4c67f79e24f",
                                        "entry_id": "875b0394-b549-30f5-af03-4e2e2688a7c7",
                                        "glosses": [
                                            "Remplacement de pièces ou d’éléments, usagés ou non, dans une machine ou un équipement industriel, qui vise à en améliorer les performances."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f40d4d7-59af-46c0-840d-dff6f821f5e9",
                        "source_entry_id": "7dbbb4d1-e99b-3dd5-a2e4-f86b47d78d15",
                        "source_sense_id": "6e5a5824-90ad-35b8-9f0c-38a98477c448",
                        "target_lang_word": "renovatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renovatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                        "entry_id": "ca0a094e-1198-3e94-8160-72e0c1fe1032",
                                        "glosses": [
                                            "het opnieuw bewoonbaar maken van een huis of wijk door een grote verbouwing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de390080-5387-4721-be31-dbc59d0cf72a",
                                                "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                                "text": "Er worden hier momenteel renovaties uitgevoerd."
                                            },
                                            {
                                                "example_id": "f4da0c63-c03a-46a2-948c-f4a370385a94",
                                                "sense_id": "a48e5758-7493-3ee3-bcce-e0db88636305",
                                                "text": "Het museum is de komende jaren nog dicht voor renovatie. Vorig jaar opende koning Willem-Alexander het internationaal geroemde Depot Boijmans van Beuningen. Het was het eerste kunstdepot ter wereld dat toegankelijk is voor publiek en kwam mede uit de koker van Ex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32347b9b-a17e-3879-84bf-ae15d43ea1d1",
                                        "entry_id": "ca0a094e-1198-3e94-8160-72e0c1fe1032",
                                        "glosses": [
                                            "de laatste aanmaning tot betaling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4927327-30af-4f9d-bfcf-b638438a6141",
                                                "sense_id": "32347b9b-a17e-3879-84bf-ae15d43ea1d1",
                                                "text": "De renovatie is gisteren verstuurd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "253a7b5a-7889-4eb2-b0c7-192152b684c5",
                        "source_entry_id": "7dbbb4d1-e99b-3dd5-a2e4-f86b47d78d15",
                        "source_sense_id": "6e5a5824-90ad-35b8-9f0c-38a98477c448",
                        "target_lang_word": "Renovierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Renovierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1103304-c837-3513-ac6e-299c4e749e6b",
                                        "entry_id": "a4c69420-2ac9-3c28-91f8-d4c9fc3339e1",
                                        "glosses": [
                                            "originalgetreue Instandsetzung eines Bauwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2378c9-85d2-45a2-8e4a-2ff66b1c8dc6",
                                                "sense_id": "c1103304-c837-3513-ac6e-299c4e749e6b",
                                                "text": "Die Renovierung des Schlosses war sehr teuer."
                                            },
                                            {
                                                "example_id": "fc5df947-cdaf-485c-acfd-d5317ac7c8a8",
                                                "sense_id": "c1103304-c837-3513-ac6e-299c4e749e6b",
                                                "text": "„Daher übernimmt der Staat nach harten Verhandlungen 45 Millionen Francs Kosten für Leopolds bevorzugte Bauprojekte – etwa für die Renovierung seines Schlosses in Laeken bei Brüssel.“"
                                            },
                                            {
                                                "example_id": "0c390a5a-aa26-4e15-b9b7-d7b057a92618",
                                                "sense_id": "c1103304-c837-3513-ac6e-299c4e749e6b",
                                                "text": "„Die einzige seinerzeit mutige Renovierung erscheint uns heute als Vintage: In den siebziger Jahren versuchten die Pompidous das Palais aufzupeppen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
