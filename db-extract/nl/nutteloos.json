                ],
                "senses": [
                    {
                        "sense_id": "f7b462bf-e27b-3aa1-80d1-0ddbc9c1e7e8",
                        "entry_id": "2c292335-d769-3f9f-b595-eaa722b88d06",
                        "glosses": [
                            "zonder voordeel, zonder nut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a423ee-e188-4b0e-b378-81a4b4658119",
                                "sense_id": "f7b462bf-e27b-3aa1-80d1-0ddbc9c1e7e8",
                                "text": "In ieder geval waren hun eigenschappen nutteloos, want geen van beiden zou er nog langer dan een half uur plezier van hebben."
                            },
                            {
                                "example_id": "cd3f484d-883e-45b3-9af3-167c1ed75b1f",
                                "sense_id": "f7b462bf-e27b-3aa1-80d1-0ddbc9c1e7e8",
                                "text": "Wat blijft is de vraag of er eigenlijk wel sprake is van een brug. 'Folly', een nutteloos bouwwerk, is wellicht een betere term voor deze ophaalbrug, die in werkelijkheid helemaal geen ophaalbrug is, maar een veredeld lichtobject. Duizenden ledlampjes verlichten van binnenuit de twee staanders en hefbomen die je van afstand al ziet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c686c4a-40ae-47ff-9dc8-b2a50ac40cfc",
                        "source_entry_id": "2c292335-d769-3f9f-b595-eaa722b88d06",
                        "source_sense_id": "f7b462bf-e27b-3aa1-80d1-0ddbc9c1e7e8",
                        "source_sense_description": "zonder voordeel",
                        "target_lang_word": "useless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "useless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Without use or possibility to be used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d175fa6f-2a60-45fc-a2e8-111de79cbdaa",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "This fork's prongs are bent. It's useless now."
                                            },
                                            {
                                                "example_id": "a4286ea4-9aa2-4365-8c8a-bc30181c9c71",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "I'm all for opening new stations (Transport Scotland is planning another at East Linton, about halfway between Drem and Dunbar), but they are useless without a decent service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unhelpful, not useful; pointless (of an action)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20054cb-dfff-4314-a444-ed39adc34f8c",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I think it's useless to keep this discussion going. It's like talking to a brick wall."
                                            },
                                            {
                                                "example_id": "4c91d144-b3f0-4d4b-9751-fd698afdb7c4",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I tried my best to make him quit smoking, but my efforts were useless. He now smokes six packs a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Good-for-nothing; not dependable."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e7ffd5-78c9-4edf-8e3d-b659f4630d37",
                                                "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                                "text": "Bill never mows the lawn, takes out the trash or anything. He's useless, but I love him anyways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unable to do well at a particular task or thing. Useless is mildly insulting."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd42613c-721a-4d51-8927-6d02a9d9ff19",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "My brother is useless at most computer games, but he is an awesome PS2 player."
                                            },
                                            {
                                                "example_id": "4c07a921-0837-4a35-adbf-28318b15deba",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "Why do you keep trying? You're obviously useless at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7e2defa-859d-488e-9ff9-e47ea4a26b4a",
                        "source_entry_id": "2c292335-d769-3f9f-b595-eaa722b88d06",
                        "source_sense_id": "f7b462bf-e27b-3aa1-80d1-0ddbc9c1e7e8",
                        "source_sense_description": "zonder voordeel",
                        "target_lang_word": "inutile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inutile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                        "entry_id": "cdc1339b-461d-3501-9e39-576a91eab48f",
                                        "glosses": [
                                            "Qui n’est d’aucune utilité, d’aucun usage, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388580d1-bcc0-423b-ab6a-cf595d8c1ead",
                                                "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                                "text": "Ai-je besoin de vous dire, après cela, que tout notre argent était dépensé en fantaisies inutiles de toilettes ?"
                                            },
                                            {
                                                "example_id": "3c178ef4-bbb6-484a-b491-d10d372534f9",
                                                "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                                "text": "Nous avons, nous autres singes ratés, depuis la nuit des temps, inventé et célébré, continûment, l’indispensable nécessité des choses inutiles à notre survie."
                                            },
                                            {
                                                "example_id": "8e398bf0-d168-4e7c-8ff7-82bdd5673036",
                                                "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                                "text": "Des conciliabules inutiles se tiennent entre les envoyés des nations."
                                            },
                                            {
                                                "example_id": "e4047e13-e7f4-4f71-860b-13078feb0713",
                                                "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                                "text": "Pour commencer, tu devrais fermer la porte. Inutile que des oreilles indiscrètes nous entendent nous disputer."
                                            },
                                            {
                                                "example_id": "5c45b27a-59fe-4325-aec3-b40e04deddc9",
                                                "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                                "text": "Un lecteur m'écrit « La prof de français nous a dit qu'il est inutile d’apprendre à conjuguer le passé simple, car c'est un temps archaïque, aujourd'hui complètement inusité »."
                                            },
                                            {
                                                "example_id": "cb1c4de0-f39b-4ea0-9fb1-c5b82e667cbd",
                                                "sense_id": "eeda56c1-7f95-32e1-8834-3380497b657c",
                                                "text": "L’ensemble des dispositions relatives à la protection contre les « cyber-pirates » peut s’avérer parfois inutile, tant il est vrai que la frontière est mince avec le banditisme le « cyber-pirate » n’est alors rien de plus qu’un « cyber-ganster »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f28273b7-2be4-34d3-8d63-83c87281f3df",
                                        "entry_id": "cdc1339b-461d-3501-9e39-576a91eab48f",
                                        "glosses": [
                                            "Qui ne rend aucun service, en parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ea520f-07e8-44f1-82f9-0eb177f7f6a1",
                                                "sense_id": "f28273b7-2be4-34d3-8d63-83c87281f3df",
                                                "text": "Un serviteur inutile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19f50037-3d62-330a-8a5e-74d48f611c56",
                                        "entry_id": "cdc1339b-461d-3501-9e39-576a91eab48f",
                                        "glosses": [
                                            "Dont on n’emploie pas les talents, les services."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d90789-445e-4c40-a4dc-15ecf268a752",
                                                "sense_id": "19f50037-3d62-330a-8a5e-74d48f611c56",
                                                "text": "Laisser quelqu’un inutile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inutile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c7d6f34-e152-3c3c-b298-5d7f2dacc890",
                                        "entry_id": "497de079-43d0-3173-b49b-51e9149c9556",
                                        "glosses": [
                                            "Nature de ce qui n’a aucun usage, aucune utilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c91191-0cc2-4756-b5b5-cab892adfeb7",
                                                "sense_id": "2c7d6f34-e152-3c3c-b298-5d7f2dacc890",
                                                "text": "L’inutile d’une telle démarche, d’une telle requête."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inutile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "856eeec7-2c4f-3083-bef3-e937a0b12522",
                                        "entry_id": "c7b7b80b-9f72-3154-9f84-8714b1976ef5",
                                        "glosses": [
                                            "Personnage qui ne rend aucun service, dont l’activité n’apporte rien à quiconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153bfc21-4aee-48e3-8d01-51b20c8c625a",
                                                "sense_id": "856eeec7-2c4f-3083-bef3-e937a0b12522",
                                                "text": "Toute une organisation formidable d’écumeurs et d’inutiles, vivant grassement, tripatouillant, combinant, s’enrichissant, sans produire quoi que ce fût d’utile."
                                            }
                                        ]
