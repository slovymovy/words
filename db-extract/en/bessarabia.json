                    },
                    {
                        "translation_id": "cf988b6f-babf-4989-aaf8-e2820931117d",
                        "source_entry_id": "0729db0a-f8c8-366a-96aa-38b25b572a40",
                        "source_sense_id": "17e31b71-53a6-30e6-9578-ada3aa821ca6",
