{
    "word_family": [
        "спустить",
        "спуск",
        "спускать",
        "спускаться"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "f944cda0-19ef-3985-989c-fa93353c0ddf",
                    "sense_definition": "По прошествии какого-либо времени; после окончания срока.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретились с друзьями только <спустя> три года.",
                            "target_lang_translations": {
                                "en": "We met with friends only three years <later>.",
                                "zh": "我们三年<w>之后</w>才和朋友们见面。"
                            }
                        },
                        {
                            "text": "Немного <спустя> дождь прекратился, и выглянуло солнце.",
                            "target_lang_translations": {
                                "en": "A little <later> the rain stopped, and the sun came out.",
                                "zh": "不久<w>之后</w>雨就停了，太阳也出来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "через"
                    ],
                    "common_phrases": [
                        "спустя время",
                        "спустя годы",
                        "много лет спустя",
                        "неделю спустя"
                    ],
                    "target_lang_definitions": {
                        "en": "After a certain amount of time has passed; following the expiration of a period.",
                        "zh": "指经过一段时间之后；在某一段时间结束之后。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "used to indicate time occurring after a specific point"
                            },
                            {
                                "target_lang_word": "after",
                                "target_lang_sense_clarification": "preposition indicating a later time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "之后",
                                "target_lang_sense_clarification": "表示在某时间点之后"
                            },
                            {
                                "target_lang_word": "以后",
                                "target_lang_sense_clarification": "表示在某时间点以后"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9441db9-f788-382a-b8a8-1a711b11cd7d",
                    "sense_definition": "Устаревшая форма деепричастия от глагола <w>спустить</w>; опустив что-либо вниз.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он привык работать <спустя> рукава, не заботясь о качестве.",
                            "target_lang_translations": {
                                "en": "He was used to working <carelessly>, not caring about quality.",
                                "zh": "他习惯于<w>敷衍</w>了事，根本不在乎质量。"
                            }
                        },
                        {
                            "text": "Мальчик сидел на мостике, <спустя> ноги в прохладную воду.",
                            "target_lang_translations": {
                                "en": "The boy sat on the bridge, <dangling> his legs into the cool water.",
                                "zh": "小男孩坐在桥上，把双脚<w>垂</w>进凉爽的水里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "спустив"
                    ],
                    "antonyms": [
                        "подняв"
                    ],
                    "common_phrases": [
                        "спустя рукава"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устар."
                        },
                        {
                            "trait_type": "form",
                            "comment": "деепричастие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Archaic form of the gerund from the verb 'to lower'; having let something down.",
                        "zh": "动词“放下”的古旧副动词形式；指将某物垂下或放下。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "having lowered",
                                "target_lang_sense_clarification": "literal archaic meaning"
                            },
                            {
                                "target_lang_word": "dangling",
                                "target_lang_sense_clarification": "contextual usage, e.g., legs"
                            },
                            {
                                "target_lang_word": "carelessly",
                                "target_lang_sense_clarification": "figurative usage in the idiom 'спустя рукава'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垂下",
                                "target_lang_sense_clarification": "指肢体或物体向下悬挂"
                            },
                            {
                                "target_lang_word": "敷衍",
                                "target_lang_sense_clarification": "用于成语“敷衍了事”中，指工作不认真"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}