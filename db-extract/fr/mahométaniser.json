                        "examples": [
                            {
                                "example_id": "c63b7d44-4ade-466a-a57e-051ac87b4299",
                                "sense_id": "a7c8443a-e0a1-348a-8e41-ccef9b50d37e",
                                "text": "Une demi-heure passée à nous mahométaniser, nous commençâmes nos investigations."
                            },
                            {
                                "example_id": "42e79630-0f48-46bb-92c1-c688486f4db2",
                                "sense_id": "a7c8443a-e0a1-348a-8e41-ccef9b50d37e",
                                "text": "N'avez-vous toujous pas compris: Grâce à la politique criminellement aliénée des pays UE, ces pays continuent de mahométaniser."
                            },
                            {
                                "example_id": "3bf1e231-1ed5-4944-b698-8e780804f043",
                                "sense_id": "a7c8443a-e0a1-348a-8e41-ccef9b50d37e",
                                "text": "Né en Turquie...il n'a pas pu faire autrement que de se \"mahométaniser\"..."
                            }
                        ]
