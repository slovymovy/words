                            {
                                "example_id": "5a01ace1-9316-46f7-96f2-4c9f8270bb34",
                                "sense_id": "a2d538a8-f5a0-31b5-bcad-0e47ae193d02",
                                "text": "Symptôme épileptique."
                            },
                            {
                                "example_id": "e08db46c-bfd1-477a-af12-1c602a55afa3",
                                "sense_id": "a2d538a8-f5a0-31b5-bcad-0e47ae193d02",
                                "text": "Convulsions épileptiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "c48cf927-4b04-3ff6-915f-d439becbd29a",
                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                        "glosses": [
                            "Qui est sujet à l’épilepsie, atteint d’épilepsie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da65d00a-1a82-481c-8d3a-1ba064d57b2e",
                                "sense_id": "c48cf927-4b04-3ff6-915f-d439becbd29a",
                                "text": "Il a un frère épileptique. Substantivement,"
                            },
                            {
                                "example_id": "b537c8f5-1826-4d7b-982c-79a0011f4066",
                                "sense_id": "c48cf927-4b04-3ff6-915f-d439becbd29a",
                                "text": "Un, une épileptique."
                            }
                        ]
                    },
                    {
                        "sense_id": "46c0a298-8974-308e-9a1e-11be3777558d",
                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                        "glosses": [
                            "Pour indiquer une violente agitation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dce59e89-c03e-42d4-9b63-38f6cc4ea34a",
                                "sense_id": "46c0a298-8974-308e-9a1e-11be3777558d",
                                "text": "Colère épileptique."
                            }
                        ]
                    },
                    {
                        "sense_id": "c639de05-fba2-376b-9ed9-7248106bcaf6",
                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                        "glosses": [
                            "Plein de rebondissements, très inhabituel."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fb48cf7f-3ab1-4443-b9f0-61c89e6082f9",
                                "sense_id": "c639de05-fba2-376b-9ed9-7248106bcaf6",
                                "text": "« Si je descends, je te mets un coup de boule », lui avait répondu le pêcheur, donnant le ton d’un quinquennat épileptique."
                            }
                        ]
                    }
                ],
