                "senses": [
                    {
                        "sense_id": "72239126-b0c5-3226-9835-3f6be0324d58",
                        "entry_id": "687926c1-7bd0-3f08-befb-8e5ce5c86a39",
                        "glosses": [
                            "A mermaid cat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76a6bd3-b403-4842-ae9d-de56396b8463",
                                "sense_id": "72239126-b0c5-3226-9835-3f6be0324d58",
                                "text": "You can also open this project up to encompass other mercreatures, such as merdogs, mercats, or merdeer."
                            },
                            {
                                "example_id": "c3fd9183-6c83-4694-a145-1d070b4bd489",
                                "sense_id": "72239126-b0c5-3226-9835-3f6be0324d58",
                                "text": "Madeline lived in a conch shell with her merdog called Byron and her mercat called Bella."
                            },
                            {
                                "example_id": "7d505581-84bc-4922-a4e8-7180478c7f7b",
                                "sense_id": "72239126-b0c5-3226-9835-3f6be0324d58",
                                "text": "‘To be honest, being a mercat – even a royal one – isn’t my thing. Cat and fish don’t mix. I keep wanting to eat my own fish tail. It’s very tiresome!’"
                            },
                            {
                                "example_id": "a40926fe-2cb7-48ef-9f9a-187f7969d01e",
                                "sense_id": "72239126-b0c5-3226-9835-3f6be0324d58",
                                "text": "‘The mercats like the mulch!’ one of the little mermaids said, as the whole lot of them wriggled out of the seaweed basket and dived into the stuff."
                            }
                        ]
                    }
