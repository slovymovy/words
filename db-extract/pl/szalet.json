                "senses": [
                    {
                        "sense_id": "78e3ea45-6a1e-3d12-a3ab-2ac62365adec",
                        "entry_id": "c1803d15-8977-3662-87c8-49012478dced",
                        "glosses": [
                            "domek górski, domek alpejski"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd9041d-4748-4043-a45b-b9fed4c3a670",
                                "sense_id": "78e3ea45-6a1e-3d12-a3ab-2ac62365adec",
                                "text": "Przespali się w szalecie, a rano ruszyli dalej w góry"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7d0a4486-a01b-3c07-a19a-fee4e7d0d017",
                        "entry_id": "c1803d15-8977-3662-87c8-49012478dced",
                        "glosses": [
                            "budynek mieszczący publiczną ubikację"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61a8b5a3-7f61-4f66-ab77-dee250280563",
                                "sense_id": "7d0a4486-a01b-3c07-a19a-fee4e7d0d017",
                                "text": "Dokumenty musiały ci wypaść w szalecie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0210b81-6921-45b6-8a98-c6dada49c62d",
                        "source_entry_id": "c1803d15-8977-3662-87c8-49012478dced",
                        "source_sense_id": "78e3ea45-6a1e-3d12-a3ab-2ac62365adec",
                        "target_lang_word": "chalet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chalet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a99d38de-f892-3fe2-a6a3-4c878bd46be0",
                                        "entry_id": "67d1740e-77bd-385d-a495-9331c6a6a0aa",
                                        "glosses": [
                                            "An alpine style of wooden building with a sloping roof and overhanging eaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9299ccdf-587b-4768-94a5-c55ca32746e7",
                                                "sense_id": "a99d38de-f892-3fe2-a6a3-4c878bd46be0",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            },
                                            {
                                                "example_id": "14a73a3c-15bd-4fa9-a1b7-3af6ab3b74d5",
                                                "sense_id": "a99d38de-f892-3fe2-a6a3-4c878bd46be0",
                                                "text": "“I know that Perdita spends the offseason at her chalet in Gstaad, and that her mansion would be empty. And the perfect place to teach you all a valuable lesson about the importance of being nice to people who maybe aren't part of your core group but who have done a lot of nice things for you and yet you still treat them like shit.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b2ead2a-38c3-3226-bd0b-e09a6e3149f9",
                                        "entry_id": "67d1740e-77bd-385d-a495-9331c6a6a0aa",
                                        "glosses": [
                                            "A recreational lodge or small house within the grounds of a resort or country club dedicated to the uniformed services, used for events, staycations and other social gatherings."
                                        ],
                                        "tags": [
                                            "Singapore"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23838938-d083-4e8c-9ef2-8e596cc7f284",
                        "source_entry_id": "c1803d15-8977-3662-87c8-49012478dced",
                        "source_sense_id": "78e3ea45-6a1e-3d12-a3ab-2ac62365adec",
                        "target_lang_word": "chalet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chalet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d56c114-aca2-37b2-a308-82f4d965b73f",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Cabane sur l’alpage, où s’abritent les bergers pendant l’été et où ils font les fromages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e320fdd-ebb3-4b20-9701-eef4e4a7e899",
                                                "sense_id": "4d56c114-aca2-37b2-a308-82f4d965b73f",
                                                "text": "Autour de l’habitation principale dont M. d’Orbe dispose, sont épars assez loin quelques chalets, qui de leurs toits de chaume peuvent couvrir l’amour et le plaisir, amis de la simplicité rustique. Les fraîches et discrètes laitières savent garder pour autrui le secret dont elles ont besoin pour elles-mêmes."
                                            },
                                            {
                                                "example_id": "e54433c8-2085-4474-b2ae-ea35aeaa63f8",
                                                "sense_id": "4d56c114-aca2-37b2-a308-82f4d965b73f",
                                                "text": "J’étais seul [lors d’un voyage dans les Alpes] ; je voyageais à pied dans ces montagnes. Je m’arrêtai dans un chalet, et j’y passai trois jours dans une famille de bergers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c69dea8-2d6c-3beb-afb7-cb13091c2dfd",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Cabane sur l’alpage, où s’abritent les bergers pendant l’été et où ils font les fromages.",
                                            "Cabane, cabinet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "723257fb-7788-380a-9d41-788a54415309",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Maison de campagne, maison de plaisance de style rustique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4719162e-8635-4910-8936-9b5cffc03f85",
                                                "sense_id": "723257fb-7788-380a-9d41-788a54415309",
                                                "text": "Un chalet normand."
                                            },
                                            {
                                                "example_id": "db2347ea-b993-44d4-90fd-98c563be3460",
                                                "sense_id": "723257fb-7788-380a-9d41-788a54415309",
                                                "text": "Dans ce castel humble et drôlet,\nElle brode, lit et fricasse.\nQu’elle aime ce petit chalet !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e959b0-1e83-3ca6-b746-38dcabc37220",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Lampe suspendue au plafond."
                                        ],
                                        "tags": [
                                            "Auvergne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feadd1f7-24a5-4573-8939-282cce99fbbe",
                                                "sense_id": "27e959b0-1e83-3ca6-b746-38dcabc37220",
                                                "text": "On soupe à la lueur du chalet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ccaaa71-d9bb-41f0-8187-1c0dbde70f76",
                        "source_entry_id": "c1803d15-8977-3662-87c8-49012478dced",
                        "source_sense_id": "7d0a4486-a01b-3c07-a19a-fee4e7d0d017",
                        "target_lang_word": "public lavatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d8a689da-4af8-4ec0-a5ff-49574ad735f3",
                        "source_entry_id": "c1803d15-8977-3662-87c8-49012478dced",
                        "source_sense_id": "7d0a4486-a01b-3c07-a19a-fee4e7d0d017",
                        "target_lang_word": "vespasienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vespasienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12222069-0060-3850-b64b-3331dfc7d2ee",
                                        "entry_id": "c3821638-dd58-3332-9db2-0e408e4dd842",
                                        "glosses": [
                                            "Voiture qui aurait stationné sur les grandes artères de communication de Paris, selon un projet jamais réalisé (vers 1840), pour servir de lieux d’aisance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e99351-d673-49b8-a2ad-448546c1f6ce",
                                                "sense_id": "12222069-0060-3850-b64b-3331dfc7d2ee",
                                                "text": "La vespasienne parisienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                                        "entry_id": "c3821638-dd58-3332-9db2-0e408e4dd842",
                                        "glosses": [
                                            "Édicule public servant d’urinoir."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092435a7-e9ee-44d5-bf5e-ddfcf3884183",
                                                "sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                                                "text": "J’étais à la brigade de mœurs, voilà douze ans. Un jour savez-vous qui je poisse, en compagnie d’un jeune garçon boucher, dans une vespasienne ? Un vieux monsieur décoré… du meilleur monde."
                                            },
                                            {
                                                "example_id": "6db4da60-6800-4709-a78b-5e6dde73b5ff",
                                                "sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                                                "text": "À peine est-il dehors qu’il entre dans une vespasienne. Et tout à coup, des cris, grand chahut : « Vieux salaud ! Satyre !… »"
                                            },
                                            {
                                                "example_id": "f6255c84-5f80-4160-a248-738c4593afc7",
                                                "sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                                                "text": "Les « sanisettes » tentent de s’implanter : ce sont des petits fortins électroniques que l’Histoire devrait retenir sous le nom de « chiraquettes ». De l’ancienne vespasienne collective, puante et gratuite, la chiraquette individuelle, monacale, aseptisée et payante, quel chemin parcouru sur la route du Progrès !"
                                            },
                                            {
                                                "example_id": "3875382c-853c-4551-b1b9-d181662e3ce1",
                                                "sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                                                "text": "(Moi je l’ai rencontré un jour\nValéry dans les vespasiennes\net fait pipi tout près de lui\nécoutant la chanson bien douce\nqui s’écoulait de sa vessie)"
                                            },
                                            {
                                                "example_id": "aa4160b2-5d68-409d-b8ac-bf4008264571",
                                                "sense_id": "7f2b7bea-44f4-3115-8df0-66d6a31f7720",
                                                "text": "Repéré, identifié, poursuivi, il se fit cerner place de Jaude, la place centrale de Clermont-Ferrand : se voyant encerclé sans aucune échappatoire, il se réfugia dans une vespasienne — urinoir public en forme de limaçon dont les parois de fer masquaient les usagers aux yeux des passants — et au cœur même du limaçon se fit sauter la cervelle pour ne pas être pris vivant."
                                            }
