                ],
                "senses": [
                    {
                        "sense_id": "22919822-fc8b-3826-ad07-5a45413c2ac2",
                        "entry_id": "3e72dac3-735b-3371-89c4-41779f47509c",
                        "glosses": [
                            "Schicht aus Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86041eb3-ff21-478a-9c1a-a8e7c13bfde0",
                                "sense_id": "22919822-fc8b-3826-ad07-5a45413c2ac2",
                                "text": "„Woran denkt man hier, wenn man acht Stunden lang nichts anderes als eine rötliche Steinschicht im Halbdunkel sieht? \"Ans Geld!\", sagt Maschinenführer Sergej schlagfertig: \"Aber du hast nicht viel Zeit zum Träumen, weil immer unvorhergesehene Situationen zu meistern sind.“"
                            },
                            {
                                "example_id": "9791810e-2e90-4d29-b6bb-9d4ee26414d4",
                                "sense_id": "22919822-fc8b-3826-ad07-5a45413c2ac2",
                                "text": "„Der Teufelstisch aus verschiedenfarbigen Steinschichten ist Wahrzeichen des Pfälzerwaldes.“"
                            },
                            {
                                "example_id": "5c9bb130-c3db-4363-8c9a-e84992efe0ee",
                                "sense_id": "22919822-fc8b-3826-ad07-5a45413c2ac2",
                                "text": "„Auf der Insel Öland gibt es auch diese ungewöhnlichen Steinschichten. Das Kliff setzt sich aus unterschiedlichen Schiefern und Kalken zusammen, die jeweils von vergangenen Erdzeitaltern zeugen.“"
                            },
                            {
                                "example_id": "b60da8c6-8211-4296-b3ca-c389b5536b05",
                                "sense_id": "22919822-fc8b-3826-ad07-5a45413c2ac2",
                                "text": "„Im Bereich der Kraftumlenkung werden die Fugen rechtwinklig zur geplanten Kraftrichtung angeordnet. Wir können in die Steinschicht bohren und die Stahlanker vorspannen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e9c0098-3d6f-4b11-8a6b-9e92bb73b3c2",
