                        ],
                        "examples": [
                            {
                                "example_id": "4d1071f2-1b4f-4980-8a3e-bb7abaa7d024",
                                "sense_id": "b3d059a9-70d7-3a5e-b849-bc6172c7d62d",
                                "text": "„Ein aufmerksamer Lastwagenfahrer hat am Christtag im Landkreis Ludwigslust-Parchim in Mecklenburg- Vorpommern ein Trio von Betrunkenen zugeparkt und so von der Weiterfahrt abgehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9357bfa8-a4db-4cf9-8860-bb12af437712",
                        "source_entry_id": "b0fddc63-accf-3e00-b353-1850ce78b3d9",
                        "source_sense_id": "b3d059a9-70d7-3a5e-b849-bc6172c7d62d",
