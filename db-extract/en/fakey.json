                        "examples": [
                            {
                                "example_id": "ce866843-0a03-40d2-8d42-3b4c60572394",
                                "sense_id": "8d233355-578e-3dae-8113-a1042212b54e",
                                "text": "We do many before and afters at Cosmo with models (who don't look all that great before the makeup, incidentally) and civilians, and none of them ever continues to do the “after” makeup on a regular basis. Too much work, too fakey and, if you’ve pulled all the stops out every day, where would be the joy and drama when you need to look really fabulous?"
                            },
                            {
                                "example_id": "87b3dd1c-11d9-4837-a673-b1fb71677e85",
                                "sense_id": "8d233355-578e-3dae-8113-a1042212b54e",
                                "text": "It is easy to dislike many of the later videos: even as early as the late ’80s, the kind of drama he puts onto screen often looks fakey, and isn’t always rescued by his skill as a performer."
                            }
                        ]
                    }
