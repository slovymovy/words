        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ea97b692-9189-34f2-85d1-3de245ce0239",
                    "sense_definition": "Op een manier die wantrouwen wekt; vaak gebruikt om een opvallend grote mate van iets aan te duiden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adverbial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag <w>verdacht</w> stil in het huis.",
                            "target_lang_translations": {
                                "en": "It is <w>suspiciously</w> quiet in the house today.",
                                "ru": "Сегодня в доме <w>подозрительно</w> тихо.",
                                "it": "Oggi c'è un silenzio <w>sospetto</w> in casa."
                            }
                        },
                        {
                            "text": "Dat gerecht lijkt <w>verdacht</w> veel op wat we gisteren aten.",
                            "target_lang_translations": {
                                "en": "That dish looks <w>suspiciously</w> like what we ate yesterday.",
                                "ru": "Это блюдо <w>подозрительно</w> сильно напоминает то, что мы ели вчера.",
                                "it": "Quel piatto somiglia in modo <w>sospetto</w> a quello che abbiamo mangiato ieri."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verdacht veel",
                        "verdacht stil"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner that arouses distrust; often used to indicate a notably high degree of something.",
                        "ru": "Образом, вызывающим недоверие; часто используется для обозначения заметно высокой степени чего-либо.",
                        "it": "In modo da suscitare diffidenza; spesso usato per indicare un grado notevolmente alto di qualcosa."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspiciously",
                                "target_lang_sense_clarification": "in a way that arouses suspicion"
                            }
                        ],
                        "ru": [
