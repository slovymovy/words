                    },
                    {
                        "translation_id": "890609a8-2daf-4541-8abf-b36aa8c4dd5a",
                        "source_entry_id": "f1ab6cc8-6ac3-3cd8-9635-233eac709b6f",
                        "source_sense_id": "13b8b38f-2f37-39ef-9bc5-620c87b5984d",
