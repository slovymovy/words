                        "form": "poisseuse"
                    },
                    {
                        "form_id": "788d2f31-d387-4105-9b1f-5bef83e188e0",
                        "entry_id": "4636f572-34be-390b-babb-20dcae1284cd",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "poisseuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                        "entry_id": "4636f572-34be-390b-babb-20dcae1284cd",
                        "glosses": [
                            "Qui est gluant, collant comme de la poix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c89dbb-4a05-48b4-8552-264eb6708342",
                                "sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                                "text": "Puis, il n’y avait plus que des bancs, sans coussin ni tapis, le long desquels s’alignaient des tables de guinguette, où les verres des consommations laissaient des ronds poisseux."
                            },
                            {
                                "example_id": "d77d24a7-44c9-4d1e-b0ae-be57e51d05cc",
                                "sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                                "text": "Quand l’animal veut s’offrir un insecte, il lui expédie sa langue poisseuse, où il le prend comme à la glu."
                            },
                            {
                                "example_id": "ac47f5ba-cbd3-4d5a-977d-b1d5ef0a62e8",
                                "sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                                "text": "Une mèche de cheveux, poisseuse de gomina, lui pendait sur le nez, en baguette de tambour, […]."
                            },
                            {
                                "example_id": "0c9c87a3-fca8-44c4-91be-a1fea2db87da",
                                "sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                                "text": "Les réveils de midi sont lourds et poisseux comme la vie de la veille avec l’amour, l’alcool et le sommeil. On éprouve un sentiment de déchéance à cause des réveils d’autrefois où les idées étaient si claires qu’on eût dit que le sommeil les avait lavées."
                            },
                            {
                                "example_id": "0f2169c4-5d32-40d1-99aa-15db09502957",
                                "sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                                "text": "— […] et la maison semblait plongée dans un profond sommeil, sans rêves, comme poisseux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee31beb6-b38b-486b-9384-a16f148f1cc4",
                        "source_entry_id": "4636f572-34be-390b-babb-20dcae1284cd",
                        "source_sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                        "target_lang_word": "zäh klebrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9713aa69-0732-4d37-b25d-9d4c19330e80",
                        "source_entry_id": "4636f572-34be-390b-babb-20dcae1284cd",
                        "source_sense_id": "70854499-861f-34cb-b8de-079bb601c393",
                        "target_lang_word": "sticky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sticky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4efcbbd-c91a-370e-bcd1-d83f27ed6730",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Tending to stick; able to adhere via the drying of a viscous substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24670be1-af85-4508-99b9-1475641f3046",
                                                "sense_id": "e4efcbbd-c91a-370e-bcd1-d83f27ed6730",
                                                "text": "Is this tape sticky enough to stay on that surface?"
                                            },
                                            {
                                                "example_id": "17a48f43-b826-407f-9f02-6f5f7efe17bc",
                                                "sense_id": "e4efcbbd-c91a-370e-bcd1-d83f27ed6730",
                                                "text": "Particularly sticky books are cleaned with methylated spirits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8611798f-39e4-32f8-943a-6ad6851b2b6f",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Difficult, awkward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6e5d8d-52cc-42c1-97c6-1a15ed637ee1",
                                                "sense_id": "8611798f-39e4-32f8-943a-6ad6851b2b6f",
                                                "text": "This is a sticky situation. We could be in this for weeks if we're not careful."
                                            },
                                            {
                                                "example_id": "66bfe2cf-95e4-43f8-8b46-71c539dafa5d",
                                                "sense_id": "8611798f-39e4-32f8-943a-6ad6851b2b6f",
                                                "text": "GCN is not just another clipboard of polite press releases. GCN is the sticky questions, the sweet moments, and the dirty stories that make up our lives."
                                            },
                                            {
                                                "example_id": "a560bf7f-0dc1-4d55-a976-591cb71cdd02",
                                                "sense_id": "8611798f-39e4-32f8-943a-6ad6851b2b6f",
                                                "text": "Among the books Mum brought me to read when I was a child were The Secret Garden and A Little Princess, as well as their author Frances Hodgson Burnett's smash hit, Little Lord Fauntleroy. I haven't met an adult my age who has read this book but I did so several times. It's a sticky book, guided by that strange Victorian obsession with \"the little mother\" – the same obsession that Virginia Woolf, a child of Victorian parents, grappled with in her diaries and her fiction. Somehow, though, I learned to overlook the archaic, to be open to the oddnesses of different eras, and to read for something else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8684b18-f170-343f-bca3-454077ebd435",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Of a death: unpleasant, grisly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7809ff-9cf3-417d-9e4d-25ddb1f89a08",
                                                "sense_id": "b8684b18-f170-343f-bca3-454077ebd435",
                                                "text": "Salmond studied medieval Scottish history as well as economics at university so he cannot say he has not had fair warning – it was even more turbulent and bloody than England at that time – and plenty of Scotland's kings and leaders came to a sticky end. If it happens this time, it won't be dull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98be1419-6461-33f1-ae8d-7e28b811b154",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Of weather: hot and windless and with high humidity, so that people feel sticky from sweating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5533352-373a-4688-a314-7b2fcdeb0d84",
                                                "sense_id": "98be1419-6461-33f1-ae8d-7e28b811b154",
                                                "text": "The baby was due in December and the hot, sticky August weather was making Jane uncomfortable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304d9eba-d465-34b4-b548-d248347f4946",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Mawkish, sentimental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93bf3098-700c-4a10-9608-2d6d2d9a3ef8",
                                                "sense_id": "304d9eba-d465-34b4-b548-d248347f4946",
                                                "text": "Love you and miss you and wish you all the sticky things one wishes at this season for someone one loves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e512907c-a2d3-3c2b-98c2-e34d7d150899",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Tending to stay the same; resistant to change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0ea0ea-1929-4394-ab4d-a8d0c6cb1221",
                                                "sense_id": "e512907c-a2d3-3c2b-98c2-e34d7d150899",
                                                "text": "a sticky price; sticky wages"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937dd5dc-ae52-3b0d-96b1-7393ce5e1ecb",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Persistent."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f120f0d-82db-4e5f-b996-ca4601f94208",
                                                "sense_id": "937dd5dc-ae52-3b0d-96b1-7393ce5e1ecb",
                                                "text": "We should make the printing direction sticky so the user doesn't have to keep setting it."
