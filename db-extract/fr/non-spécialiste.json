                                            {
                                                "example_id": "b01af9ad-bb69-441f-b599-c4b3576d89e2",
                                                "sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                                                "text": "This engineering task is too difficult for nonspecialists."
                                            },
                                            {
                                                "example_id": "3eee8926-cdf8-4be3-b942-4ab357cd971f",
                                                "sense_id": "5c42a3ee-4c94-32d7-8f05-265cdcd979a2",
                                                "text": "\"Books,\" to us, should have 150 to 1500 published pages, almost never need color, be typesettable in house, not require fold-out maps, be predominately in English, and be titleable such that a nonspecialist could recommend it to a specialist."
                                            }
                                        ]
