                    },
                    {
                        "translation_id": "31efdac5-1dc5-47cd-ae64-62d9cd3ad6d2",
                        "source_entry_id": "a61bf6b5-6dce-3f5e-94cc-6933de227ff8",
                        "source_sense_description": "Pièce de machine à tisser",
                        "target_lang_word": "breastbeam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breastbeam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d08017-e819-3b90-9479-23c160b326a8",
                                        "entry_id": "f1e12096-1039-3e43-aab1-d60dedfc7ccb",
                                        "glosses": [
                                            "Part of a loom."
                                        ],
                                        "tags": [],
