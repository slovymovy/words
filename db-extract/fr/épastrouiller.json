                "senses": [
                    {
                        "sense_id": "e0062ad1-2298-3864-bb54-63ada6625d00",
                        "entry_id": "4714be45-a174-387e-8ce0-b33625381ee4",
                        "glosses": [
                            "Surprendre fortement, ébahir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1f5546-2154-4f68-a077-0bf47167a1a7",
                                "sense_id": "e0062ad1-2298-3864-bb54-63ada6625d00",
                                "text": "Madame est née Marie-Louise Teste de Saint-Léger. Ça ne doit pas remonter aux croisades, mais ça fait bien sur un faire-part pour épastrouiller les pacoulins."
                            },
                            {
                                "example_id": "16e59f3f-89c3-4f4f-a13a-b27b01eaf2f9",
                                "sense_id": "e0062ad1-2298-3864-bb54-63ada6625d00",
                                "text": "Quand on verra les photos des trous de 7,65 dans leurs poitrines, ça peut en épastrouiller plus d’un."
                            },
                            {
                                "example_id": "cb15d7e4-1f3e-4872-a023-99ce91ecd5d1",
                                "sense_id": "e0062ad1-2298-3864-bb54-63ada6625d00",
                                "text": "Poitiers, capitale romane, vous invite à un tête à tête épastrouillant - Épastrouillant : étonnant, merveilleux (du verbe épastrouiller « étonner »). Argot parisien du XIXe siècle."
                            }
                        ]
                    }
