                        ],
                        "examples": [
                            {
                                "example_id": "8f68b0b6-c761-48f5-8e13-f9d17ffd36cf",
                                "sense_id": "dbfad6c6-5380-3746-a9f5-711319d7173d",
                                "text": "Doe je schoeisel uit voordat je de kamer inloopt!"
                            }
                        ]
