                    {
                        "translation_id": "9805aa07-f6df-4dc6-bb05-c01cdeb49f9f",
                        "source_entry_id": "69c57501-791e-3214-8ef3-5b4a9e869a4f",
                        "source_sense_description": "in a fortuitous manner; in a manner of happening by a lucky chance; luckily; fortunately",
                        "target_lang_word": "heureusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heureusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                                        "entry_id": "bba8748d-caf4-3a7e-89d3-1ace3becc317",
                                        "glosses": [
                                            "D’une manière heureuse, qui donne lieu à du bonheur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2593d05a-d502-44d5-b2ee-e3560005233b",
                                                "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                                                "text": "Vivre heureusement."
                                            },
                                            {
                                                "example_id": "52d95e5f-da20-43b6-8186-dbd13de61b78",
                                                "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                                                "text": "Vous verrez votre crainte heureusement déçue."
                                            },
                                            {
                                                "example_id": "b84d47b8-e7df-4d74-8ba6-0a77f68b0910",
                                                "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                                                "text": "Ainsi finit heureusement la bataille la plus hasardeuse et la plus disputée qui fut jamais."
                                            },
                                            {
                                                "example_id": "4b24141c-6ada-4763-92a9-f496184042e3",
                                                "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                                                "text": "Plût au ciel que sa main heureusement cruelle\nEût fait sur moi l’essai de sa fureur nouvelle !"
                                            },
                                            {
                                                "example_id": "a52faa38-ebe5-47f6-bb89-a3bffc2ca529",
                                                "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                                                "text": "Mais un de leurs sujets heureusement coupable\nM’a fait abandonner les foyers paternels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4982215a-8b04-31e3-88b7-5da6e8aef597",
                                        "entry_id": "bba8748d-caf4-3a7e-89d3-1ace3becc317",
                                        "glosses": [
                                            "Avec succès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4844e8a-adf6-44e0-ae16-76e514ab8b37",
                                                "sense_id": "4982215a-8b04-31e3-88b7-5da6e8aef597",
                                                "text": "Il y avait un an que cette famille vivait dans la solitude, lorsque le marchand reçut une lettre par laquelle on lui mandait qu’un vaisseau sur lequel il avait des marchandises venait d’arriver heureusement."
                                            },
                                            {
                                                "example_id": "8cdc592a-2fb5-4a4e-afe6-e2e37f36600f",
                                                "sense_id": "4982215a-8b04-31e3-88b7-5da6e8aef597",
                                                "text": "Felix Sylla, l’heureux Sylla, un Alexandre VI, un duc de Borgia, ont heureusement pillé, trahi, empoisonné, ravagé, égorgé ; mais, s’ils se sont crus des scélérats, il y a grande apparence qu’ils étaient très malheureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c106de-feb5-35d1-b85a-d5ccdfae7955",
                                        "entry_id": "bba8748d-caf4-3a7e-89d3-1ace3becc317",
                                        "glosses": [
                                            "Par bonheur ; en ce sens il se met souvent en tête de la phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d957df-7a08-459b-9072-3c52a4e45c99",
                                                "sense_id": "14c106de-feb5-35d1-b85a-d5ccdfae7955",
                                                "text": "À 9 heures du soir, la barre en chêne de mon gouvernail se brisait, mais heureusement je possédais une barre de secours en fer."
                                            },
                                            {
                                                "example_id": "bbd0d27d-5ab3-4cd3-8e27-335c46c54fad",
                                                "sense_id": "14c106de-feb5-35d1-b85a-d5ccdfae7955",
                                                "text": "Son épée en vos mains heureusement laissée."
                                            },
                                            {
                                                "example_id": "4e84a802-6393-4d60-bb70-0277e37625e1",
                                                "sense_id": "14c106de-feb5-35d1-b85a-d5ccdfae7955",
                                                "text": "On a voulu priver le public de ce dictionnaire utile [l’Encyclopédie] ; heureusement on n’y a pas réussi."
                                            },
                                            {
                                                "example_id": "d1e12ce0-c6c2-4f6f-a94c-6afc11ec1ba1",
                                                "sense_id": "14c106de-feb5-35d1-b85a-d5ccdfae7955",
                                                "text": "Heureusement il y a toujours d’honnêtes gens parmi les monstres, et des gens de goût parmi les sots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "901be0a6-f446-37ad-b550-f89dad5e473c",
                                        "entry_id": "bba8748d-caf4-3a7e-89d3-1ace3becc317",
                                        "glosses": [
                                            "Par bonheur ; en ce sens il se met souvent en tête de la phrase.",
                                            "Dans ce sens, il est quelquefois suivi de « que », en sous-entendant quelque verbe d’un sens très général, comme « il arrive », « il est arrivé »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d8a431-cf27-484b-baf6-411b38f56c5b",
                                                "sense_id": "901be0a6-f446-37ad-b550-f89dad5e473c",
                                                "text": "Heureusement pour lui que son père ne l’aperçut pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce9b811-d2f0-346e-90ee-499f8ec526ce",
                                        "entry_id": "bba8748d-caf4-3a7e-89d3-1ace3becc317",
                                        "glosses": [
                                            "Avantageusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088ea992-c132-42fe-8251-e8448bcd014a",
                                                "sense_id": "1ce9b811-d2f0-346e-90ee-499f8ec526ce",
                                                "text": "La Catalogne est un des pays les plus fertiles de la terre et les plus heureusement situés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f51ce289-a13d-3289-a104-c4157592d106",
                                        "entry_id": "bba8748d-caf4-3a7e-89d3-1ace3becc317",
                                        "glosses": [
                                            "et d’arts. D’une manière habile, originale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb0a511-7866-45be-acb6-1adb31f30e8f",
                                                "sense_id": "f51ce289-a13d-3289-a104-c4157592d106",
                                                "text": "Cela est heureusement conçu, exprimé. Versifier heureusement."
                                            },
                                            {
                                                "example_id": "2180c689-18b7-481f-a510-888477d53d5b",
                                                "sense_id": "f51ce289-a13d-3289-a104-c4157592d106",
                                                "text": "Rien n’est plus difficile que de terminer heureusement une scène de politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
