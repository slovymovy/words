                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b28ba1-a782-3a66-9dca-bd3d246ba7e5",
                                        "entry_id": "5edd6e2d-7ac7-3185-898e-7914b1ddfd9b",
                                        "glosses": [
                                            "Remplir d’enthousiasme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd538fd-3cec-4b2d-86f4-fb9e6974ea78",
                                                "sense_id": "d8b28ba1-a782-3a66-9dca-bd3d246ba7e5",
                                                "text": "Il est dans le caractère français de s’enthousiasmer, de se colérer, de se passionner pour le météore du moment, pour les bâtons flottants de l’actualité."
                                            },
                                            {
                                                "example_id": "5445121b-3d3e-4122-a9ba-85c4b10ba389",
                                                "sense_id": "d8b28ba1-a782-3a66-9dca-bd3d246ba7e5",
                                                "text": "[…] ; ses opinions littéraires étaient changées : il estimait par-dessus tout la passion ; Werther, René, Frank, Lara, Lélia et d’autres plus médiocres l’enthousiasmaient presque également."
                                            },
                                            {
                                                "example_id": "f8e316f8-21dc-4dae-8079-fbad279658de",
                                                "sense_id": "d8b28ba1-a782-3a66-9dca-bd3d246ba7e5",
                                                "text": "N’oublions pas que toute la population féminine française s’enthousiasmerait le jour où elle verrait commencer une lutte vraiment résolue contre l’alcoolisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
