{
    "word_family": [
        "psychic",
        "psychical",
        "psychiatry",
        "psychology",
        "psychopath",
        "psychosis"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c99e9c32-da3a-3595-981f-a1d608a76f58",
                    "sense_definition": "The human soul, mind, or spirit, especially as the source of emotion, thought, and personality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mind_and_soul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic events had a lasting and devastating impact on the young man's <w>psyche</w>.",
                            "target_lang_translations": {
                                "ru": "Трагические события оказали длительное и разрушительное воздействие на <w>психику</w> молодого человека."
                            }
                        },
                        {
                            "text": "Understanding the human <w>psyche</w> has always been a central goal of modern psychology.",
                            "target_lang_translations": {
                                "ru": "Понимание человеческой <w>души</w> всегда было главной целью современной психологии."
                            }
                        }
                    ],
                    "synonyms": [
                        "mind",
                        "soul",
                        "spirit"
                    ],
                    "common_phrases": [
                        "human psyche",
                        "damage to the psyche"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человеческая душа, разум или дух, особенно как источник эмоций, мыслей и личности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "психика",
                                "target_lang_sense_clarification": "внутренний душевный склад, особенности мышления и восприятия"
                            },
                            {
                                "target_lang_word": "душа",
                                "target_lang_sense_clarification": "внутренний мир, эмоциональная и духовная сущность человека"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "сознание, духовное начало"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c44b84b-5993-3b1f-8ba7-193f83718a5e",
                    "sense_definition": "A small white butterfly (Leptosia nina) found primarily in parts of Asia and Australasia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butterfly_species",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delicate <w>psyche</w> fluttered gently above the wild flowering shrubs in the garden.",
                            "target_lang_translations": {
                                "ru": "Хрупкая <w>психея</w> плавно порхала над дикими цветущими кустарниками в саду."
                            }
                        },
                        {
                            "text": "They observed a small <w>psyche</w> resting calmly on a leaf during their trek.",
                            "target_lang_translations": {
                                "ru": "Во время похода они заметили маленькую <w>психею</w>, спокойно сидящую на листе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая белая бабочка (Leptosia nina), распространенная преимущественно в некоторых частях Азии и Австралазии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "психея",
                                "target_lang_sense_clarification": "вид бабочки-белянки (Leptosia nina)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34be8bd8-a6dd-3a4a-a97d-4d2497f8de6f",
                    "sense_definition": "An informal abbreviation of <w>psychology</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abbreviation_psych",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to major in <w>psyche</w> during her first semester at college.",
                            "target_lang_translations": {
                                "ru": "В первом семестре колледжа она решила выбрать в качестве специальности <w>психологию</w>."
                            }
                        },
                        {
                            "text": "The introductory <w>psyche</w> lecture was held in the large auditorium on Tuesday.",
                            "target_lang_translations": {
                                "ru": "Вводная лекция по <w>психологии</w> состоялась во вторник в большой аудитории."
                            }
                        }
                    ],
                    "synonyms": [
                        "psychology"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an informal abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение от слова «психология»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "психология",
                                "target_lang_sense_clarification": "учебный предмет или специальность"
                            },
                            {
                                "target_lang_word": "психфак",
                                "target_lang_sense_clarification": "факультет психологии (в студенческом сленге)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f7a78d86-ff9b-3292-a192-9cde65829f65",
                    "sense_definition": "The mythological personification of the soul, represented as a maiden who loved Eros.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "classical_mythology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "The ancient story of Cupid and <w>Psyche</w> explores deep themes of trust and devotion.",
                            "target_lang_translations": {
                                "ru": "Древнее сказание об Амуре и <w>Психее</w> затрагивает глубокие темы доверия и преданности."
                            }
                        },
                        {
                            "text": "Artists throughout the Renaissance frequently depicted <w>Psyche</w> with the delicate wings of a butterfly.",
                            "target_lang_translations": {
                                "ru": "Художники эпохи Возрождения часто изображали <w>Психею</w> с нежными крыльями бабочки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мифологическое олицетворение души, изображаемое в виде девушки, возлюбленной Эрота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Психея",
                                "target_lang_sense_clarification": "персонаж древнегреческой мифологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7cbf355-0399-3f6e-a191-7abadb5b4701",
                    "sense_definition": "A large, metal-rich asteroid located in the main asteroid belt, formally designated 16 Psyche.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy_asteroid",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Astronomers sent a robotic mission to explore the metallic asteroid known as <w>Psyche</w>.",
                            "target_lang_translations": {
                                "ru": "Астрономы отправили автоматическую станцию для исследования металлического астероида, известного как <w>Психея</w>."
                            }
                        },
                        {
                            "text": "Studying the composition of <w>Psyche</w> may provide clues about early planetary cores.",
                            "target_lang_translations": {
                                "ru": "Изучение состава <w>Психеи</w> может дать ключ к пониманию формирования ранних ядер планет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный богатый металлами астероид в главном поясе астероидов, официально обозначаемый как (16) Психея."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Психея",
                                "target_lang_sense_clarification": "астероид главного пояса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "546f0abd-7992-39a8-8fe6-631fc779ac03",
                    "sense_definition": "Alternative spelling of <w>psych</w>; to prepare mentally, or to intimidate or deceive someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psych_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>psyche</w> out his opponent before the championship tennis match began.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>выбить из колеи</w> своего соперника перед началом финального теннисного матча."
                            }
                        },
                        {
                            "text": "She took several deep breaths to <w>psyche</w> herself up for the job interview.",
                            "target_lang_translations": {
                                "ru": "Она сделала несколько глубоких вдохов, чтобы <w>морально настроиться</w> на собеседование."
                            }
                        }
                    ],
                    "synonyms": [
                        "psych",
                        "intimidate"
                    ],
                    "common_phrases": [
                        "psyche out",
                        "psyche up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "variant spelling of psych"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "colloquial usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова «psych»; морально готовиться либо запугивать, выбивать из колеи или обманывать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морально настраивать",
                                "target_lang_sense_clarification": "готовить к испытанию (обычно psyche up)"
                            },
                            {
                                "target_lang_word": "выбивать из колеи",
                                "target_lang_sense_clarification": "деморализовать соперника (обычно psyche out)"
                            },
                            {
                                "target_lang_word": "запугивать",
                                "target_lang_sense_clarification": "оказывать психологическое давление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "0092459f-0407-3656-bc74-7e35da47716e",
                    "sense_definition": "Alternative spelling of <w>psych</w>; used to indicate that one was joking or has tricked someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psych_intj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I brought you that concert ticket you wanted—<w>psyche</w>, just kidding!",
                            "target_lang_translations": {
                                "ru": "Я достал тебе тот билет на концерт, который ты хотел... <w>Купился</w>, да ладно, шучу!"
                            }
                        },
                        {
                            "text": "He shouted '<w>Psyche</w>!' as soon as his brother believed the practical joke.",
                            "target_lang_translations": {
                                "ru": "Он закричал: «<w>Попался</w>!», как только брат поверил в розыгрыш."
                            }
                        }
                    ],
                    "synonyms": [
                        "psych"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slang exclamation"
                        },
                        {
                            "trait_type": "form",
                            "comment": "variant spelling of psych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова «psych»; междометие, используемое, чтобы показать, что сказанное было шуткой или розыгрышем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купился",
                                "target_lang_sense_clarification": "возглас при розыгрыше"
                            },
                            {
                                "target_lang_word": "попался",
                                "target_lang_sense_clarification": "возглас после удачной шутки"
                            },
                            {
                                "target_lang_word": "пошутил",
                                "target_lang_sense_clarification": "указание на розыгрыш"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}