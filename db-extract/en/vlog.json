        "de-extract.jsonl": [
            {
                "entry_id": "bf675c8c-844d-3fab-b4a9-415c84ef8fc7",
                "word": "vlog",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab0e567e-9617-3a34-b298-b29a7709fc0b",
                        "entry_id": "bf675c8c-844d-3fab-b4a9-415c84ef8fc7",
                        "glosses": [
                            "Vlog"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "c7a0d26d-f77f-4819-aedf-50bef86bc067",
                                "sense_id": "ab0e567e-9617-3a34-b298-b29a7709fc0b",
                                "text": "He posts a vlog every week.",
                                "translation": "Jede Woche postet er ein/einen Vlog."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f23e28ea-624d-4bc1-9e87-bcd11da6b6f5",
                        "source_entry_id": "bf675c8c-844d-3fab-b4a9-415c84ef8fc7",
                        "source_sense_id": "ab0e567e-9617-3a34-b298-b29a7709fc0b",
                        "source_sense_description": "EDV: Vlog",
                        "target_lang_word": "Vlog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vlog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77150ce5-73c4-3bb6-8ab8-7cf60dbf5280",
                                        "entry_id": "7a292d5f-350d-3d15-a3e3-58ec0b0786ad",
                                        "glosses": [
                                            "Blog, das in Form eines Videos erstellt wird"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ba06f79-d635-4d18-9388-bda472d9057f",
                                                "sense_id": "77150ce5-73c4-3bb6-8ab8-7cf60dbf5280",
                                                "text": "„Kommentare möchte die Kanzlerin per E-Mail bekommen - was in deutschen Blogs mit Stirnrunzeln quittiert wird. Ein richtiges Video-Weblog, ein so genanntes Vlog, das wäre für die Kanzlerin offenbar doch noch zu experimentell.“"
                                            },
                                            {
                                                "example_id": "3892d6b6-22a5-4c3b-937c-bb0268056b9f",
                                                "sense_id": "77150ce5-73c4-3bb6-8ab8-7cf60dbf5280",
                                                "text": "„Rocketboom ist ein Videoblog, kurz: Vlog, und nicht nur irgendeins dieser sich rasant verbreitenden, jüngsten Entwicklungsstufe internetspezifischer Formate - nach normalen Blogs (von Weblogs, Internet-Tagebüchern), Fotoblogs, Moblogs (mobil erstellte Blogs) und Podcasts (selbstproduzierte Hörstücke, die man auf dem iPod abspielen kann).“"
                                            },
                                            {
                                                "example_id": "4ff97f10-eb1d-43d7-a453-a1e5da8d1c5e",
                                                "sense_id": "77150ce5-73c4-3bb6-8ab8-7cf60dbf5280",
                                                "text": "„Der Film besteht fast ausschließlich aus Material der Öffentlichkeit, aus Anrufen, aus eingesendeten Vlogs und Fotos, abgeschmeckt mit etwas Animation.“"
                                            },
                                            {
                                                "example_id": "8c8288a1-e6a5-4449-8e9e-c3b331192975",
                                                "sense_id": "77150ce5-73c4-3bb6-8ab8-7cf60dbf5280",
                                                "text": "„Alles dies aber ist nichts gegen die Innovation \"Google Base\", eine Universal-Datenbank, die nahezu alles erfassen soll, was man so an Wort, Bild und Ton in Bits und Bytes niederlegen kann: Private Verkaufsanzeigen, Coupons und Event-Termine, Jobangebote, Blogs und Vlogs ebenso wie News, Rezensionen und Kochrezepte.“"
                                            },
                                            {
                                                "example_id": "1f214baa-ae5e-462d-a73a-7a86b8dd4104",
                                                "sense_id": "77150ce5-73c4-3bb6-8ab8-7cf60dbf5280",
                                                "text": "„Bloggen, das ist vorbei. Wer setzt sich denn heute noch hin und liest, old school, Texte mit Buchstaben und so? Die Zehnerjahre gehören eindeutig dem Vlog, dem Video-Blog, der Real-Time-Selbstinszenierung im Netz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
