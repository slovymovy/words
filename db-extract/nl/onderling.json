                                        "sense_id": "77fc5862-0b05-383e-969b-b8bb735d3acd",
                                        "entry_id": "57c80ced-ca41-3313-9a6f-4cdfc5a5daf1",
                                        "glosses": [
                                            "Equidad alterna en las relaciones de entes participantes."
