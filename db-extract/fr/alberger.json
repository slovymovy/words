                "senses": [
                    {
                        "sense_id": "52314d81-c407-382d-a141-6ef0c345e08c",
                        "entry_id": "d300812c-d79b-3146-ae59-73ea916be119",
                        "glosses": [
                            "Dans le droit féodal, accorder la jouissance à un paysan pour une longue durée, moyennant une redevance annuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5855d9cf-e6d1-4b53-a7c3-0f183c186ca0",
                                "sense_id": "52314d81-c407-382d-a141-6ef0c345e08c",
                                "text": "Déjà en 1435, l'Archevêque Girard donne la permission d'\"alberger\" l'eau de Razis sur Crévoux."
                            },
                            {
                                "example_id": "796f1818-ea23-4cde-a8c9-08153845f6d5",
                                "sense_id": "52314d81-c407-382d-a141-6ef0c345e08c",
                                "text": "les sources sont atribuées à Sion qui devra alberger l’eau excédentaire à ceux des Agettes et de la Verna"
                            }
                        ]
                    }
