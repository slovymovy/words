                "senses": [
                    {
                        "sense_id": "6f0b655c-79c4-38ee-8701-0a9b90aab21c",
                        "entry_id": "3f7e0dcd-f542-3e73-a5d2-8af9471705d6",
                        "glosses": [
                            "In a diffident manner; without confidence in oneself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbad57d9-f368-4687-9fc6-3a7e4f035068",
                                "sense_id": "6f0b655c-79c4-38ee-8701-0a9b90aab21c",
                                "text": "The author too keenly feels that he has no further claims than these, and he therefore most diffidently asks for his work the indulgence of his readers."
                            },
                            {
                                "example_id": "f8aac044-a022-44f1-a3f5-79751aa12352",
                                "sense_id": "6f0b655c-79c4-38ee-8701-0a9b90aab21c",
                                "text": "The same evening John Rossitter wrote to the Bishop of Nawaub, and very humbly and diffidently offered himself, his young life, his health and his strength, his talents and energies, his younger son's portion, all that God had given him, for his Master's use;"
                            },
                            {
                                "example_id": "659982a3-0f43-4d46-953b-d0bbd7b03861",
                                "sense_id": "6f0b655c-79c4-38ee-8701-0a9b90aab21c",
                                "text": "\"May I see you sometimes?\" he asked diffidently."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73adb5a5-8cb8-457f-84cb-d2a1e796ce49",
                        "source_entry_id": "3f7e0dcd-f542-3e73-a5d2-8af9471705d6",
                        "source_sense_id": "6f0b655c-79c4-38ee-8701-0a9b90aab21c",
                        "source_sense_description": "in a diffident manner; without confidence in oneself",
                        "target_lang_word": "timidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                        "entry_id": "f9892c39-9887-3e4a-821e-c64c868ad962",
                                        "glosses": [
                                            "D’une manière timide, avec timidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d86cc84-a714-4aef-a229-9c4550135472",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Sa casquette à carreaux lui attirant des quolibets, il l'ôta timidement."
                                            },
                                            {
                                                "example_id": "396797c7-7ceb-4b3d-b0e0-631ba51d8a46",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Enfin, elle articula timidement, d'une voix aiguë et mal assurée comme un violon qui crincrine : — Vous n'auriez pas une goutte de lait ?"
                                            },
                                            {
                                                "example_id": "ef9bd7e5-ca8d-4b83-aa1c-b22dc51d4fe2",
                                                "sense_id": "d3fd4ebb-8783-3981-b338-636c510dddb8",
                                                "text": "Hélas ! le citoyen, timidement fidèle, N'oserait en ces lieux imiter ce saint zèle,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef4cf75-4e35-4031-a0f5-002e10d18464",
                        "source_entry_id": "3f7e0dcd-f542-3e73-a5d2-8af9471705d6",
                        "source_sense_id": "6f0b655c-79c4-38ee-8701-0a9b90aab21c",
