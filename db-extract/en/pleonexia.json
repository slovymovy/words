                "senses": [
                    {
                        "sense_id": "d4416cc7-d77d-30dc-a265-d693921f86bf",
                        "entry_id": "b6aeed33-e111-3a93-8130-3f9a53498731",
                        "glosses": [
                            "Excessive or insatiable greed, avarice, covetousness, the desire to have more, a greedy desire for certain goods."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5f88976f-1c5f-44c8-9316-34c7d85b9b2a",
                                "sense_id": "d4416cc7-d77d-30dc-a265-d693921f86bf",
                                "text": "There are two words in the Greek which set forth the nature of covetousness: 1. Pleonexia, which signifies an 'insatiable desire of getting the world.' Covetousness is a dry dropsy."
                            },
                            {
                                "example_id": "bcbaa44c-aa37-41ff-9983-0d6b5019feec",
                                "sense_id": "d4416cc7-d77d-30dc-a265-d693921f86bf",
                                "text": "Pleonexia, or greed, the wishing and trying for the bigger share, we know under the name of covetousness."
                            },
                            {
                                "example_id": "32eb1f99-2a68-4df6-9cd9-bfd119a01c5a",
                                "sense_id": "d4416cc7-d77d-30dc-a265-d693921f86bf",
                                "text": "Like all character traits, pleonexia comes in degrees, but in its most extreme form, pleonectics are willing to do “whatever it takes” to “get what they want” and are bound only by their fear of punishment; they do not blanch at the thought of using or manipulating people as pawns or instruments in their own schemes or at acts of disloyalty and betrayal; in fact, such behavior may be their typical modus operandi."
                            }
                        ]
                    }
