                            {
                                "example_id": "6e5212f0-675b-4c7f-9c28-eed68cf8e38c",
                                "sense_id": "105e3f2b-18e4-34d2-9043-43b31c43abdd",
                                "text": "I can only recommend you to read again Darwin's account of the horse family and its comparison with pigeons; and if that does not convince and stagger you, then you are unconvertible."
                            },
                            {
                                "example_id": "ef35e69b-ba2c-43f1-9c26-b4a3f55ab0e4",
                                "sense_id": "105e3f2b-18e4-34d2-9043-43b31c43abdd",
                                "text": "If the situation created by the War has transformed also the English circulation into unconvertible paper money, this is merely a passing fact."
                            },
                            {
                                "example_id": "d3116be0-54af-4511-8888-e77f169d4b19",
                                "sense_id": "105e3f2b-18e4-34d2-9043-43b31c43abdd",
                                "text": "Of the 196 broad-gauge locomotives in service on the Great Western Railway at the end of 1891, sixty-nine were unconvertible to the standard gauge, and were withdrawn from service when Brunel's 7 ft. gauge was finally abolished nearly five months later."
                            }
