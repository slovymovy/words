        "nl-extract.jsonl": [
            {
                "entry_id": "104dfb4f-0f21-326f-8ecd-bde38d252165",
                "word": "nietsdoen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8dd058be-f862-3873-bb41-414a0b29fa43",
                        "entry_id": "104dfb4f-0f21-326f-8ecd-bde38d252165",
                        "glosses": [
                            "ledigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "525bef59-1907-4319-aa2d-77902ff4446a",
                                "sense_id": "8dd058be-f862-3873-bb41-414a0b29fa43",
                                "text": "Nietsdoen was de specialiteit van de slampamper."
                            },
                            {
                                "example_id": "b2d75ea8-8498-4685-b362-ee779c8ec774",
                                "sense_id": "8dd058be-f862-3873-bb41-414a0b29fa43",
                                "text": "Nietsdoen is eigenlijk heel goed voor je geestelijke gezondheid als je het maar met mate doet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56abd2be-86e0-4994-b478-7ae88a5ac2f2",
                        "source_entry_id": "104dfb4f-0f21-326f-8ecd-bde38d252165",
                        "source_sense_id": "8dd058be-f862-3873-bb41-414a0b29fa43",
                        "source_sense_description": "ledigheid",
                        "target_lang_word": "Nichtstun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtstun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                        "entry_id": "2d9a7269-3493-3fcd-8624-5f7fb1707a96",
                                        "glosses": [
                                            "Verhalten ohne Aktivität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f08139e-3934-4e5f-a7eb-20e95c66a08e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "Das Unglück liegt in deinem Leben im Nichtstun."
                                            },
                                            {
                                                "example_id": "015af3da-ea34-4e25-8acd-312e47ac7dfa",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Nach drei Tagen Nichtstun und Langeweile wollte er bei den Segelmanövern mithelfen.“"
                                            },
                                            {
                                                "example_id": "9bc74844-1d7b-4aaf-9edd-53a97df6441e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Er legte sich auf eine Waldwiese und genoss das Nichtstun.“"
                                            },
                                            {
                                                "example_id": "a303774d-d915-4619-a8e7-2f8e255eccf7",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Ich blieb drei Wochen bei ihnen und war aufgrund der Prellungen, die ich erlitten hatte, zum Nichtstun verdammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f267e532-8d09-490a-a373-9eeeedee3442",
                        "source_entry_id": "104dfb4f-0f21-326f-8ecd-bde38d252165",
                        "source_sense_id": "8dd058be-f862-3873-bb41-414a0b29fa43",
                        "source_sense_description": "ledigheid",
                        "target_lang_word": "Müßiggang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müßiggang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                        "entry_id": "7733e183-599b-3535-95a7-7adbf71deb77",
                                        "glosses": [
                                            "dauerhafte Untätigkeit (in der Umgangssprache negativer besetzt als Muße)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db62650-4845-42dc-ab9a-fa863dbc87a8",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "Sein Leben bestand nur noch aus Müßiggang."
                                            },
                                            {
                                                "example_id": "af70ee62-7389-4b48-8231-984f9450662b",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Hui, der ehemals dem ehrbaren Handwerk des Schreibers obgelegen hatte, verdankte seinen Niedergang der südchinesischen Neigung zum Müßiggang.“"
                                            },
                                            {
                                                "example_id": "b6975227-8a6c-4138-93e8-527ad3be44a5",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Falls ihm an der Gunst des französischen Publikums liegt, dann hat Kravchenko – Müßiggang ist aller … Anfang! – in den Ruhetagen zwischen der letzten Sitzung der vergangenen und der ersten dieser Woche einen unfaßlichen Fehler begangen; und mancher, der da schwankte, wird jetzt überzeugt sein, daß der Held der Affäre, wie die Lettres Françaises behaupten, wirklich nicht klug genug ist, um „Ich wählte die Freiheit“ geschrieben zu haben.“"
                                            },
                                            {
                                                "example_id": "3d3be8ae-f6bf-4891-bd88-d794df7e8b28",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Wo Müßiggang und sein Genuß, aus der Öffentlichkeit verdrängt, zur Privatsache werden, hilft dem Flaneur die Maske des Begleiters.“"
                                            },
                                            {
                                                "example_id": "7db7d5d3-fab9-47cb-a7a4-2b840586c942",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Dieser Müßiggang schien mir der Gipfel menschlichen Glücks zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
