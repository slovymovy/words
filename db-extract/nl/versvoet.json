                    {
                        "sense_id": "cc99a85a-232b-39d2-aaf5-65e39dc5354e",
                        "entry_id": "08bca976-b548-39bc-9ef2-7f46c58a0b1a",
                        "glosses": [
                            "in de poëzie gebruikte term voor een combinatie van beklemtoonde en onbeklemtoonde lettergrepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0d7836-6576-4219-928d-70669d1ccb1b",
                                "sense_id": "cc99a85a-232b-39d2-aaf5-65e39dc5354e",
                                "text": "De tekstschrijver in topvorm. Famous Blue Raincoat heeft de vorm van een brief met de golvende versvoet die amfibrachys heet: een beklemtoonde lettergreep ingeklemd tussen twee onbeklemtoonde. De laatste woorden van het lied zijn de ondertekening van de brief: 'Sincerely, L. Cohen'."
                            },
                            {
                                "example_id": "8fbd7d11-9abb-4056-84a0-d224f387a4e6",
                                "sense_id": "cc99a85a-232b-39d2-aaf5-65e39dc5354e",
                                "text": "De Australische dichter Les Murray bewoont een continent. Van hem verscheen onlangs De planken kathedraal (De Harmonie, 2013), in het Engels en Nederlands mooi vertaald door Martin Elzinga. Zijn poëzie ademt de ruimte van zijn land en de wereld. Het is moeilijk om er iets uit te citeren, want alles hoort bij elkaar. Ook hij beweegt zich voort op versvoeten."
                            }
                        ]
                    }
