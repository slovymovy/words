                                        "examples": [
                                            {
                                                "example_id": "a29d488a-1632-48f3-b23d-4b5e495a20a2",
                                                "sense_id": "adab0e13-e188-30ea-b103-111c41752283",
                                                "text": "Il commence à faire frisquet, l'automne est bien arrivé."
                                            },
                                            {
                                                "example_id": "92fc8f4d-fd8e-4a2c-a004-adcec60722ac",
                                                "sense_id": "adab0e13-e188-30ea-b103-111c41752283",
                                                "text": "Une petite bise frisquette s'était levée."
                                            },
                                            {
                                                "example_id": "03df2833-35c6-4f91-add5-d8d5f6a1123c",
                                                "sense_id": "adab0e13-e188-30ea-b103-111c41752283",
                                                "text": "Elle les montera toujours sur les murs et dans les rêves des autres, même si, un matin de ce mois frisquet nous l'avons accompagnée jusqu'au feu ultime du crématorium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a0fdd60-6f3d-3774-bd33-72ffac5d6951",
                                        "entry_id": "cb0fc44b-b623-3404-8f1d-4dc21075064f",
                                        "glosses": [
                                            "Réservé, peu chaleureux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da40bebf-c63b-49de-b385-a9281da5e8b5",
                                                "sense_id": "7a0fdd60-6f3d-3774-bd33-72ffac5d6951",
                                                "text": "On peut dire que l'accueil a été frisquet!"
                                            },
                                            {
                                                "example_id": "5e70af5a-5a9c-41f5-ab90-590f40562611",
                                                "sense_id": "7a0fdd60-6f3d-3774-bd33-72ffac5d6951",
                                                "text": "Le prédécesseur de Chirac me paraissait avoir insufflé un esprit plus high-tech mais probablement plus frisquet."
                                            }
                                        ]
                                    }
                                ]
                            },
