                        "glosses": [
                            "geheel van voorschrifte en afspraken die betrekking hebben op het geleidelijk stoppen van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dae480d-73c7-48ae-b61c-b7a1aaef507e",
                                "sense_id": "e18c4931-0353-3aca-8cb2-49e3865e9fdf",
                                "text": "De rijksregeling in- en doorstroombanen eindigde op 1 januari 2004. Almelo hanteert een afbouwregeling."
                            },
                            {
                                "example_id": "7e4f8f58-aa57-4bac-9f81-b2e5f21ac9dd",
                                "sense_id": "e18c4931-0353-3aca-8cb2-49e3865e9fdf",
                                "text": "In feite wil het college alle (drink)keten in boerenschuren gewoon toestaan. De SGP gaat dat te ver. Schouwstra vroeg dan ook om een afbouwregeling. Er zijn nu 17 keten in de gemeente en dat moeten er niet méér, maar juist minder worden. Sluit een keet, dan mag er geen nieuwe komen. Verder pleitte Schouwstra er voor om de horeca al om middernacht te laten sluiten."
                            }
                        ]
