                    }
                ],
                "senses": [
                    {
                        "sense_id": "95da32a5-a9f8-3e82-9864-8cf0fa00e066",
                        "entry_id": "a4cd25a2-fa63-3aad-9c60-ac3b597b8ee5",
                        "glosses": [
                            "Stained or covered with grime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "590447eb-694f-423d-82ee-42768d4da646",
                                "sense_id": "95da32a5-a9f8-3e82-9864-8cf0fa00e066",
                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                            }
                        ]
                    },
                    {
                        "sense_id": "35a66d8e-ce4c-3947-ba54-1fabc22922c7",
                        "entry_id": "a4cd25a2-fa63-3aad-9c60-ac3b597b8ee5",
                        "glosses": [
                            "From the urban musical genre called grime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770ca43a-5162-4c63-a227-26e7568a5e22",
                                "sense_id": "35a66d8e-ce4c-3947-ba54-1fabc22922c7",
                                "text": "Riffs from older songs seem to be more popular, as only two from the past decade made it into the top 20. They were Muse's Plug In Baby, at 11, and The White Stripes' grimy Seven Nation Army at 15."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fed736c-f856-3153-972b-6a6814072996",
                        "entry_id": "a4cd25a2-fa63-3aad-9c60-ac3b597b8ee5",
                        "glosses": [
                            "Morally corrupt, malicious, vile, or selfish; base or dirty; rotten."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2596b660-554f-45f9-9c5a-cb61533df04d",
                                "sense_id": "4fed736c-f856-3153-972b-6a6814072996",
                                "text": "When I was 18 I was grimy af. I wouldn't share my food with you even if you were starving and about to die."
                            }
                        ]
                    },
                    {
                        "sense_id": "52d0f30a-bb41-3fcf-a064-52f06b744997",
                        "entry_id": "a4cd25a2-fa63-3aad-9c60-ac3b597b8ee5",
                        "glosses": [
                            "Of a beat or song, darkly atmospheric; having affinities with the style of the East Coast hip hop of the 90s, especially that of New York."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "847d03e9-1715-4116-b9a1-98ff67b2be78",
                                "sense_id": "52d0f30a-bb41-3fcf-a064-52f06b744997",
                                "text": "Pro Era are a group of young rappers (and artists) straight from the streets of Brooklyn, New York. They're headed by Joey Bada$$ who is definitely the most well known figure but as a group they stand alone as some of the top emcees and producers coming through. They've been hailed as the return of hip hop, especially the gritty, grimey New York hip hop we all know and love"
                            }
                        ]
                    }
                ],
                "translations": [
