                "senses": [
                    {
                        "sense_id": "6c27fa34-fc7b-388b-8037-40abdb31c201",
                        "entry_id": "d255dc1c-50d3-3621-b3ea-9995778bd393",
                        "glosses": [
                            "словосочетание, содержащее игру слов, основанную на использовании сходно звучащих, но различных по значению слов или разных значений одного слова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a21a8c-6d31-4fe2-8dfc-0b94c1a779a0",
                                "sense_id": "6c27fa34-fc7b-388b-8037-40abdb31c201",
                                "text": "― Рыцарь этот когда-то неудачно пошутил, ― ответил Воланд, поворачивая к Маргарите своё лицо с тихо горящим глазом, ― его каламбур, который он сочинил, разговаривая о свете и тьме, был не совсем хорош."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f34cd0ba-6cf2-4315-ae38-5a891eaa53f5",
                        "source_entry_id": "d255dc1c-50d3-3621-b3ea-9995778bd393",
                        "source_sense_id": "6c27fa34-fc7b-388b-8037-40abdb31c201",
                        "target_lang_word": "pun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2197e458-fec7-3b30-b2fe-625bf1e1bc2a",
                                        "entry_id": "4abe2dc9-3e73-382a-b22c-50fd74fe0ca8",
                                        "glosses": [
                                            "To beat; strike with force; to ram; to pound, as in a mortar; reduce to powder, to pulverize."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17af3a82-d102-4b03-b1da-50cd4586409f",
                                                "sense_id": "2197e458-fec7-3b30-b2fe-625bf1e1bc2a",
                                                "text": "He would pun thee into shivers with his fist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1071de2-4209-301d-a45e-f1511d2da281",
                                        "entry_id": "4abe2dc9-3e73-382a-b22c-50fd74fe0ca8",
                                        "glosses": [
                                            "To make or tell a pun; to make a play on words."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ebd875-aa0a-4014-aa5d-5aac48e9f2cf",
                                                "sense_id": "c1071de2-4209-301d-a45e-f1511d2da281",
                                                "text": "We punned about the topic until all around us groaned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                        "entry_id": "9fe95fa7-1c2e-3664-98e7-403031a36c4c",
                                        "glosses": [
                                            "A joke or type of wordplay in which similar definitions or sounds of two words or phrases, or different definitions of the same word, are deliberately confused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7735152a-2137-48bf-8667-4228b6c3c451",
                                                "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                                "text": "The pun is the lowest form of wit."
                                            },
                                            {
                                                "example_id": "555ce09b-890d-46f1-9172-42d131d3abdd",
                                                "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                                "text": "\"Certainly, my home at my uncle's brought me acquainted with a circle of admirals. Of Rears, and Vices, I saw enough. Now do not be suspecting me of a pun, I entreat.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4cfdbb-0f5a-3414-9025-3f7503ecd2cb",
                                        "entry_id": "cc8d4ecb-09de-36ea-b907-792c732a86c5",
                                        "glosses": [
                                            "Alternative form of bun (“Korean unit of measure”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a477e5b-e92d-3d14-a15c-df33a7c4521d",
                                        "entry_id": "39b41c9b-e2bd-3385-9874-b7ba85ffa2e6",
                                        "glosses": [
                                            "A certain number of cowries, generally 80."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f1559e-a152-48fe-a0c4-58d950b24b7e",
                                                "sense_id": "5a477e5b-e92d-3d14-a15c-df33a7c4521d",
                                                "text": "Hackeries and carriages, loaded and empty, 8 annas. Sheep, goats, &c., 1 pun of cowries each."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4a228b3-bbb4-4a9a-b7b8-640688fd5671",
                        "source_entry_id": "d255dc1c-50d3-3621-b3ea-9995778bd393",
                        "source_sense_id": "6c27fa34-fc7b-388b-8037-40abdb31c201",
                        "target_lang_word": "Kalauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                        "entry_id": "82a517f6-292e-345e-b37c-315513e14955",
                                        "glosses": [
                                            "einfaches, nicht sehr geistreiches Wortspiel; ursprünglich beruhend auf Wörtern mit gleichem Klang, aber unterschiedlicher Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44396b5d-1569-4ae8-bfad-1f1feafe2181",
                                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                                "text": "Er erzählte die ganze Zeit alberne Kalauer und langweilte uns damit."
                                            },
                                            {
                                                "example_id": "e0481f66-f9a9-4bb4-95ec-4d188b65c66e",
                                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                                "text": "Beispiel für einen Kalauer: Fährt der alte Lord fort, fährt er nur im Ford fort."
                                            },
                                            {
                                                "example_id": "16cf7766-0408-4442-9e8b-b7595bfebc41",
                                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                                "text": "„Kalauer nennt man schlechte Wortwitze…“"
                                            },
                                            {
                                                "example_id": "a0d64855-bda2-41fa-a73f-44241bb0c17b",
                                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                                "text": "„Diese Laune wurde aufgegriffen und weiter befördert durch Dr. Birgit Sekulski, Warschau, die im Dialog Sprachwitze, Kalauer, Versprecher, Verschreiber, Stilblüten und anderes vorstellte und damit ein wahres »Feuerwerk der Sprachlust« zündete.“"
                                            },
                                            {
                                                "example_id": "68920dea-5cac-454e-b9b9-1ec797dddd97",
                                                "sense_id": "8f693b9f-2680-3d33-a681-00a49b685ca1",
                                                "text": "„Und dieses Element gehört fest zu unserem Verhältnis zur Sprache, und in den Sprachwitzen und besonders in den Kalauern tritt es hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "498ad0a5-c5ae-3aa7-bb98-3912a4b56f88",
