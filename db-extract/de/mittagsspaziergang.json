                ],
                "senses": [
                    {
                        "sense_id": "78549fba-82ad-3300-ae6b-8e2fa6fb93a8",
                        "entry_id": "9c132557-d11a-3872-bcd1-59315935ce73",
                        "glosses": [
                            "Spaziergang am Mittag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614dee2a-ecc9-40e9-b410-55b9d6d3c699",
                                "sense_id": "78549fba-82ad-3300-ae6b-8e2fa6fb93a8",
                                "text": "Wir haben gestern einen Mittagsspaziergang in der Natur unternommen."
                            },
                            {
                                "example_id": "52034851-9c51-4ba4-9c1a-c66bed113902",
                                "sense_id": "78549fba-82ad-3300-ae6b-8e2fa6fb93a8",
                                "text": "„Ich kannte ihn vom Sehen her, Koerber gehörte zu den alten Wienern, die bei sonnigem Wetter ihren Mittagsspaziergang auf dem Graben und auf der Ringstraße zu machen pflegten.“"
                            },
                            {
                                "example_id": "57317f75-ea24-45b0-a41c-b939c35f71c2",
                                "sense_id": "78549fba-82ad-3300-ae6b-8e2fa6fb93a8",
                                "text": "„Am Vormittag schliefen sie nur ein halbes Stündchen, und erst beim Mittagsspaziergang lagen sie völlig erschöpft im Kinderwagen und waren auch durch das lauteste vorbeifahrende Auto nicht aufzuwecken.“"
                            },
                            {
                                "example_id": "497358ef-e610-4e04-9504-ea37a9c72ab5",
                                "sense_id": "78549fba-82ad-3300-ae6b-8e2fa6fb93a8",
                                "text": "„Da ich mich heute Morgen traurig und niedergeschlagen fühlte, ließ ich Laura bei Mrs. Vesey, um einen meiner schnellen Mittagsspaziergänge zu machen, die ich seit einiger Zeit zu oft ausgesetzt hatte.“"
                            },
                            {
                                "example_id": "696a5d31-6992-4489-94d4-6d5a4edce627",
                                "sense_id": "78549fba-82ad-3300-ae6b-8e2fa6fb93a8",
                                "text": "„Ivo wollte seinen Augen kaum trauen, als er auf dem Mittagsspaziergange den Nazi mit einem Zwerchsacke daher kommen sah; als aber Nazi winkte, sprang er ihm entgegen und fiel ihm um den Hals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
