                        ]
                    },
                    {
                        "translation_id": "b4e00003-fd51-4825-a17f-7819f7fedaf8",
                        "source_entry_id": "ea04afbd-817f-353b-91c5-f5dc2253b47d",
                        "target_lang_word": "bestialski",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bestialski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8a089e87-faa5-3c11-8877-afaec00c3e66",
                                        "entry_id": "f7836575-9085-3a8d-a3e4-6312be6abac3",
                                        "glosses": [
                                            "okrutny, niezwykle brutalny"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd0ffea-d324-4daf-803b-6f793d532a9a",
                                                "sense_id": "8a089e87-faa5-3c11-8877-afaec00c3e66",
                                                "text": "Anthony Storr pisał: „Najbardziej odrażające przykłady okrucieństwa człowieka określamy powszechnie jako zwierzęce lub bestialskie, sugerując przez użycie tych przymiotników, że zachowanie takie jest charakterystyczne dla zwierząt znajdujących się na niższym – aniżeli my – poziomie rozwoju. W rzeczywistości jednak skrajnie zwierzęce zachowanie występuje wyłącznie u człowieka (…)”"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9918a57-14e5-4373-b840-4014e2b68a96",
                        "source_entry_id": "ea04afbd-817f-353b-91c5-f5dc2253b47d",
                        "target_lang_word": "звериный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "звериный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                        "entry_id": "688fb768-b614-3339-a75f-6eeae7f475d1",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным зверь; свойственный, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8031fab-3396-4524-b34d-e61eb6281bee",
                                                "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                                "text": "Люди эти промышляли звериным и рыбным промыслом и делали то, чему научились от отцов, или сами доходили до какого-нибудь нового промысла."
                                            },
                                            {
                                                "example_id": "8dd4fa0a-2942-46d6-9b11-ccf2b393da54",
                                                "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                                "text": "Вой ветра на улицах был подобен звериному вою."
                                            },
                                            {
                                                "example_id": "907717d4-550e-4ceb-9c13-c310e51537b4",
                                                "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                                "text": "Стены комнаты украшали звериные шкуры, старинные луки, ружья, кинжалы."
                                            },
                                            {
                                                "example_id": "5cd23446-9fd1-456c-bb56-95ed5fc5bb0b",
                                                "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                                "text": "Повернув обратно, мы в зарослях ольхи наткнулись на затейливо петляющие звериные и птичьи следы."
                                            },
                                            {
                                                "example_id": "3798470d-8059-4e9a-a881-a44ce8f31b9f",
                                                "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                                "text": "Вот уж действительно на грани невозможного: железный протез в виде искусно выкованной звериной лапы!"
                                            },
                                            {
                                                "example_id": "411c556b-5781-412a-817d-94b0d1c96e75",
                                                "sense_id": "457dbf8d-35a0-3113-9f8c-ee1a44ff4962",
                                                "text": "С чувством страха и даже неприязни смотрела я на звериную жадность, с которой моя дочь поедала фрукты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e33b57-e0bb-3c89-9319-035d0e61b7d9",
                                        "entry_id": "688fb768-b614-3339-a75f-6eeae7f475d1",
                                        "glosses": [
                                            "перен. жестокий, дикий, свирепый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d912b3-5332-49a4-9976-84835491f9eb",
                                                "sense_id": "a8e33b57-e0bb-3c89-9319-035d0e61b7d9",
                                                "text": "Что же нового даёт революция, как изменяет она звериный русский быт, много ли света вносит она во тьму народной жизни?"
                                            },
                                            {
                                                "example_id": "8244d39c-7d3f-4b01-8ed2-8a2b0114bc8c",
                                                "sense_id": "a8e33b57-e0bb-3c89-9319-035d0e61b7d9",
                                                "text": "Сочетание человеческого облика со звериными нравами меня не устраивает — как, впрочем, и наоборот."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d2ceead-f2a1-31c3-bc7b-4722cb1e866d",
                                        "entry_id": "688fb768-b614-3339-a75f-6eeae7f475d1",
                                        "glosses": [
                                            "перен. очень сильный, чрезвычайный в своём проявлении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed46f6f4-71b0-414a-bb57-1e8598036e98",
                                                "sense_id": "0d2ceead-f2a1-31c3-bc7b-4722cb1e866d",
                                                "text": "Прокурор произнёс звериной силы речь, переборщив и потребовав смертной казни."
                                            },
                                            {
                                                "example_id": "d84b6469-0489-42aa-8beb-1b8ab4b5b98e",
                                                "sense_id": "0d2ceead-f2a1-31c3-bc7b-4722cb1e866d",
                                                "text": "Любопытное явление: после обеда очень скоро стал ощущать звериный голод."
                                            },
                                            {
                                                "example_id": "fe603f6e-3c6e-46c5-b40a-26ebe306e010",
                                                "sense_id": "0d2ceead-f2a1-31c3-bc7b-4722cb1e866d",
                                                "text": "Он не понимал, откуда приступ звериной тоски, ведь худшее осталось позади〈…〉"
                                            },
                                            {
                                                "example_id": "3ac1da6a-33f4-4775-a54e-3a1ac80e7b12",
                                                "sense_id": "0d2ceead-f2a1-31c3-bc7b-4722cb1e866d",
                                                "text": "Формы этой накипи чрезвычайно многообразны, и по ним можно судить, насколько неблагополучна была данная цивилизация к моменту катаклизма, но очень мало можно сказать о природе этого катаклизма, потому что самые разные катаклизмы — будь то глобальная пандемия, или всемирная война, или даже геологическая катастрофа — выплёскивают на поверхность одну и ту же накипь: ненависть, звериный эгоизм, жестокость, которая кажется оправданной, но не имеет на самом деле никаких оправданий…"
                                            }
                                        ]
                                    }
                                ]
                            }
