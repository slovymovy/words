{
    "word_family": [
        "harshly",
        "harshness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "423c1508-d5c0-3900-b3c8-1659a97d2eeb",
                    "sense_definition": "Unpleasantly severe, cruel, or demanding in nature or effect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge handed down a <w>harsh</w> penalty to the defendant after the trial.",
                            "target_lang_translations": {
                                "ru": "Судья вынес подсудимому <w>суровый</w> приговор после судебного разбирательства."
                            }
                        },
                        {
                            "text": "Living in the desert is difficult because of the <w>harsh</w> climate and lack of water.",
                            "target_lang_translations": {
                                "ru": "Жизнь в пустыне трудна из-за <w>сурового</w> климата и нехватки воды."
                            }
                        }
                    ],
                    "synonyms": [
                        "severe",
                        "stern",
                        "strict",
                        "tough",
                        "cruel",
                        "rough",
                        "hard"
                    ],
                    "common_phrases": [
                        "harsh reality",
                        "harsh conditions",
                        "harsh criticism",
                        "harsh penalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятно суровый, жестокий или требовательный по своему характеру или воздействию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о климате, наказании или условиях"
                            },
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "о мерах, критике или реальности"
                            },
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "о правилах или дисциплине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0446f7f-b1cb-3861-9ff4-32325b810144",
                    "sense_definition": "Unpleasantly rough, grating, or jarring to the physical senses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>harsh</w> light of the morning sun made him squint his eyes.",
                            "target_lang_translations": {
                                "ru": "<w>Резкий</w> свет утреннего солнца заставил его зажмуриться."
                            }
                        },
                        {
                            "text": "She found the <w>harsh</w> texture of the wool sweater very uncomfortable against her skin.",
                            "target_lang_translations": {
                                "ru": "Она нашла <w>грубую</w> текстуру шерстяного свитера очень неприятной для кожи."
                            }
                        }
                    ],
                    "synonyms": [
                        "rough",
                        "coarse",
                        "grating",
                        "jarring",
                        "abrasive"
                    ],
                    "antonyms": [
                        "genteel"
                    ],
                    "common_phrases": [
                        "harsh light",
                        "harsh voice",
                        "harsh sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятно грубый, резкий или раздражающий физические органы чувств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о свете, звуке или запахе"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "о текстуре или голосе"
                            },
                            {
                                "target_lang_word": "шершавый",
                                "target_lang_sense_clarification": "о поверхности или материале"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d3ee90e-0513-38bc-a22a-e9df2e8b5bbf",
                    "sense_definition": "To spoil or put a damper on a positive mood or atmosphere.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mood_spoiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was having a great time until his constant complaining started <w>harshing</w> my vibe.",
                            "target_lang_translations": {
                                "ru": "Я отлично проводил время, пока его постоянное нытье не начало <w>обламывать</w> мне весь настрой."
                            }
                        },
                        {
                            "text": "Please stop talking about work because you are totally <w>harshing</w> my mellow right now.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань говорить о работе, потому что ты сейчас полностью <w>портишь</w> мне расслабленную атмосферу."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoil",
                        "dampen"
                    ],
                    "common_phrases": [
                        "harshing my vibe",
                        "harshing my mellow"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in phrases like 'harsh my mellow' or 'harsh my vibe'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испортить или подавить позитивное настроение или атмосферу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обламывать",
                                "target_lang_sense_clarification": "сленг, портить кайф или настрой"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "атмосферу или настроение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7643e7c-0fbf-3d20-97b0-ea75ae63fac4",
                    "sense_definition": "To criticize someone in a negative or unkind way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no need to keep <w>harshing</w> on him for a mistake he made weeks ago.",
                            "target_lang_translations": {
                                "ru": "Нет нужды продолжать <w>наезжать</w> на него за ошибку, которую он совершил несколько недель назад."
                            }
                        },
                        {
                            "text": "Stop <w>harshing</w> on yourself just because you didn't win the first prize.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>гнобить</w> себя только из-за того, что не занял первое место."
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "diss"
                    ],
                    "common_phrases": [
