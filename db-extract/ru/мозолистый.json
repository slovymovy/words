                                        "examples": [
                                            {
                                                "example_id": "67021532-5aa2-41a2-913b-d17faec561a5",
                                                "sense_id": "1dd55819-4e16-311e-851a-46d87d80ac91",
                                                "text": "But this much can be said with surety: Hollywood is hornier than it has been in years."
                                            },
