                "translations": [
                    {
                        "translation_id": "c4c01d59-1b0c-46bc-90f2-8dcca7c73245",
                        "source_entry_id": "4b0986a4-ab14-325a-91c8-1837744fc53a",
                        "source_sense_id": "2f3e2b4d-d115-396f-91b5-2bfedc012c7b",
                        "source_sense_description": "de onderste kaak",
                        "target_lang_word": "Unterkiefer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterkiefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                        "entry_id": "6ce3587a-d7df-3cf2-8943-f6115f96e294",
                                        "glosses": [
                                            "beweglicher Knochen des Gesichtsschädels im unteren Mundbereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771594a0-c5e1-42ce-8234-2717f8840686",
                                                "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                                "text": "„Dem andern fiel der Unterkiefer herunter.“"
                                            },
                                            {
                                                "example_id": "1f9dfe1e-a89c-409d-9b86-91ca2b89dcbc",
                                                "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                                "text": "„Ihr Unterkiefer hing ein wenig herab, ein bisschen Speichel stand in ihren Mundwinkeln.“"
                                            },
                                            {
                                                "example_id": "775eb155-007b-4f3c-ac95-cc942567fd84",
                                                "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                                "text": "„Die Unterlippe hing so weit herunter, dass man das Zahnfleisch und seine gleichmäßig abgeschliffenen Zähne im Unterkiefer sah.“"
                                            },
                                            {
                                                "example_id": "3b5455ce-53fa-4168-aadb-efd0637c6987",
                                                "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                                "text": "„Im Unterkiefer fehlen zwei Schneidezähne.“"
                                            },
                                            {
                                                "example_id": "972937b1-b076-452c-959a-16fc72607c5a",
                                                "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                                "text": "„Doch näher gekommen stellt man fest, dass es sich um das Unterkiefer eines Wals (vermutlich Pottwals) handelt.“"
                                            },
                                            {
                                                "example_id": "938db042-b3c8-4159-973b-8f144693b2df",
                                                "sense_id": "c04eac30-1d78-3c10-b7f6-ed7198a27d91",
                                                "text": "„Die bei Weitem häufigste Fehlstellung ist der Rückbiss, wobei entweder das Unterkiefer zu weit hinten oder das Oberkiefer zu weit vorn steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
