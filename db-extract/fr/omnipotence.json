                "senses": [
                    {
                        "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                        "entry_id": "d5320c80-bde6-3f06-9920-0790decfd8f5",
                        "glosses": [
                            "Toute-puissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ab886e-4c19-4ff3-95dc-ccd8b4d18f12",
                                "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                "text": "Ce pamphlet contre l’homme que Diderot n’osa pas publier, le Neveu de Rameau ; ce livre, débraillé tout exprès pour montrer des plaies, est seul comparable à ce pamphlet dit sans aucune arrière-pensée, où le mot ne respecta même point ce que le penseur discute encore, où l’on ne construisit qu’avec des ruines, où l’on nia tout, où l’on n’admira que ce que le scepticisme adopte : l’omnipotence, l’omniscience, l’omniconvenance de l’argent."
                            },
                            {
                                "example_id": "45797aeb-cc17-4741-bc2a-017b29782cb5",
                                "sense_id": "367cc4ed-1e96-38ab-b501-85ba05cea855",
                                "text": "Les bourreaux doivent savourer la même omnipotence, se livrer à pareille furie, goûter une égale joie de meurtrir sans remords."
                            }
                        ]
                    },
                    {
                        "sense_id": "55ad9a31-afc1-3d49-a163-4780bf8fbf4b",
                        "entry_id": "d5320c80-bde6-3f06-9920-0790decfd8f5",
                        "glosses": [
                            "Faculté de décider souverainement en certaines matières."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7622c8d7-ea17-451b-95b0-6c492738b277",
                                "sense_id": "55ad9a31-afc1-3d49-a163-4780bf8fbf4b",
                                "text": "L’omnipotence du jury."
                            }
                        ]
                    }
                ],
                "translations": [
