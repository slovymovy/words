                                        "sense_id": "22c3fd1e-96d7-3f1a-9cdc-52dd964b0fc4",
                                        "entry_id": "e08decac-7b6d-3b84-b433-03251834f1e5",
                                        "glosses": [
                                            "Pained by the loss of someone."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de529283-4fde-466f-9d66-07d3153f709c",
                                                "sense_id": "22c3fd1e-96d7-3f1a-9cdc-52dd964b0fc4",
                                                "text": "I was utterly bereft in the months following my wife's death."
                                            },
                                            {
                                                "example_id": "809bda50-5c1e-41c5-85fb-144bd7cf9982",
                                                "sense_id": "22c3fd1e-96d7-3f1a-9cdc-52dd964b0fc4",
                                                "text": "[Oscar] Pistorius's punishment for killing her [Reeva Steenkamp] that night is but a frippery when set against the burden that her bereft parents, June and Barry, must carry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eafdea48-1e1b-32e2-8801-030b813b1360",
                                        "entry_id": "e08decac-7b6d-3b84-b433-03251834f1e5",
                                        "glosses": [
                                            "Deprived of, stripped of, robbed of."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d6119b-be25-4728-82d6-8de114843d8a",
                                                "sense_id": "eafdea48-1e1b-32e2-8801-030b813b1360",
                                                "text": "And there I strove, and there I clove through the drift of icy streams; / And there I fought, and there I sought for the pay-streak of my dreams. // So twenty years, with their hopes and fears and smiles and tears and such, / Went by and left me long bereft of hope of the Midas touch; […]"
                                            },
                                            {
                                                "example_id": "b59202d1-b95c-40ae-b907-a6a2d319501d",
                                                "sense_id": "eafdea48-1e1b-32e2-8801-030b813b1360",
                                                "text": "This parrot is no more! It has ceased to be! It’s expired and gone to meet its maker! This is a late parrot! It’s a stiff! Bereft of life, it rests in peace! If you hadn’t nailed it to the perch it would be pushing up the daisies!"
                                            },
                                            {
                                                "example_id": "cc996486-70cc-4a2b-9a49-df4a540cf137",
                                                "sense_id": "eafdea48-1e1b-32e2-8801-030b813b1360",
                                                "text": "The hosts had not lost in 12 home European games but looked shaky at the back and bereft of attacking ideas, inviting Stoke forward for further opportunities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b401a2b0-7e17-3241-9b84-5a5ecebb04f4",
                                        "entry_id": "e08decac-7b6d-3b84-b433-03251834f1e5",
                                        "glosses": [
                                            "Lacking, devoid of."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
