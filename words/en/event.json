{
    "word_family": [
        "eventful",
        "eventless",
        "eventuality",
        "eventual",
        "eventually",
        "uneventful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "422998ed-9ca0-300c-80b7-e5b869acd2e5",
                    "sense_definition": "An occurrence; something that happens.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>events</w> of his early years shaped his personality as an adult.",
                            "target_lang_translations": {
                                "ru": "<w>События</w> его ранних лет сформировали его личность как взрослого человека."
                            }
                        },
                        {
                            "text": "In the <w>event</w> of strong wind, please stay away from the coastal areas.",
                            "target_lang_translations": {
                                "ru": "В <w>случае</w> сильного ветра, пожалуйста, держитесь подальше от прибрежных зон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the event of",
                        "current events",
                        "weather event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происшествие; то, что случается или происходит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "факт общественной или личной жизни"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "происшествие или обстоятельство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8f3377b-aba8-3bb7-9e98-86bb73c13008",
                    "sense_definition": "A prearranged social activity or function.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went to a networking <w>event</w> in San Francisco last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе я посетил нетворкинг-<w>мероприятие</w> в Сан-Франциско."
                            }
                        },
                        {
                            "text": "The organizers are still deciding where the <w>social</w> <w>event</w> will be held.",
                            "target_lang_translations": {
                                "ru": "Организаторы всё ещё решают, где будет проводиться общественное <w>мероприятие</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social event",
                        "charity event",
                        "sporting event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее организованное общественное мероприятие или встреча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мероприятие",
                                "target_lang_sense_clarification": "организованная встреча или акция"
                            },
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "значимое общественное явление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd6a114d-1e95-32d5-939f-763af4fef45a",
                    "sense_definition": "One of several contests that combine to make up a competition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hundred-meter sprint is the most popular <w>event</w> at the track meet.",
                            "target_lang_translations": {
                                "ru": "Спринт на сто метров — самый популярный <w>вид программы</w> на легкоатлетических соревнованиях."
                            }
                        },
                        {
                            "text": "She is training hard to win the main <w>event</w> this weekend.",
                            "target_lang_translations": {
                                "ru": "Она усердно тренируется, чтобы выиграть главное <w>соревнование</w> в эти выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "main event",
                        "track event",
                        "field event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из нескольких видов состязаний, составляющих спортивное соревнование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вид программы",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "дисциплина",
                                "target_lang_sense_clarification": "спортивное состязание"
                            },
                            {
                                "target_lang_word": "соревнование",
                                "target_lang_sense_clarification": "отдельный этап или заезд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af15f309-3eaf-374f-bf85-70200c30c9a7",
                    "sense_definition": "A possible action that the user can perform that is monitored by an application or the operating system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer added an <w>event</w> listener to detect when the button is clicked.",
                            "target_lang_translations": {
                                "ru": "Программист добавил слушатель <w>событий</w>, чтобы определять нажатие кнопки."
                            }
                        },
                        {
                            "text": "When a mouse <w>event</w> occurs, the handler performs a specific task.",
                            "target_lang_translations": {
                                "ru": "Когда происходит <w>событие</w> мыши, обработчик выполняет определенную задачу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "event listener",
                        "event handler",
                        "mouse event"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие пользователя или системы, отслеживаемое приложением или операционной системой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60fc582e-ff42-378f-95dd-b99b8959ec68",
                    "sense_definition": "An end result or an outcome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the <w>event</w>, he turned out to have exactly what I needed anyway.",
                            "target_lang_translations": {
                                "ru": "В конечном <w>итоге</w> оказалось, что у него всё равно было именно то, что мне нужно."
                            }
                        },
                        {
                            "text": "The final <w>event</w> of the negotiations was a surprise to everyone involved.",
                            "target_lang_translations": {
                                "ru": "Финальный <w>исход</w> переговоров стал сюрпризом для всех участников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конечный результат или исход чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исход",
                                "target_lang_sense_clarification": "результат процесса"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "итог"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed7f0ab-7aed-320b-a0c3-53e76bc29126",
                    "sense_definition": "A set of some of the possible outcomes in a sample space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In probability theory, an <w>event</w> is a subset of the sample space.",
                            "target_lang_translations": {
                                "ru": "В теории вероятностей <w>событие</w> — это подмножество пространства элементарных исходов."
                            }
                        },
                        {
                            "text": "Rolling an even number is a specific <w>event</w> when tossing a die.",
                            "target_lang_translations": {
                                "ru": "Выпадение четного числа — это конкретное <w>событие</w> при бросании игральной кости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "random event",
                        "independent event"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mathematical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подмножество пространства элементарных исходов в теории вероятностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "в математике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eca4ae5a-839e-3b76-b57f-552d218b8058",
                    "sense_definition": "A point in spacetime having three spatial coordinates and one temporal coordinate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Relativity describes an <w>event</w> as a single point in the four-dimensional continuum.",
                            "target_lang_translations": {
                                "ru": "Теория относительности описывает <w>событие</w> как одну точку в четырехмерном континууме."
                            }
                        },
                        {
                            "text": "The light from that distant <w>event</w> took millions of years to reach us.",
                            "target_lang_translations": {
                                "ru": "Свету от того далекого <w>события</w> потребовались миллионы лет, чтобы достичь нас."
                            }
                        }
                    ],
                    "common_phrases": [
                        "event horizon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точка в пространстве-времени, имеющая три пространственные и одну временную координату."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "в физике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44922c02-8381-3da8-a2cb-23a822fab322",
                    "sense_definition": "To occur or take place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian described the ancient battles that <w>evented</w> in the northern territories.",
                            "target_lang_translations": {
                                "ru": "Историк описал древние битвы, которые <w>происходили</w> на северных территориях."
                            }
                        },
                        {
                            "text": "It is rare to see such strange phenomena <w>eventing</w> in this part of the world.",
                            "target_lang_translations": {
                                "ru": "Редко можно увидеть такие странные явления, <w>случающиеся</w> в этой части мира."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или иметь место (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "случаться"
                            },
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "иметь место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79b1aefd-667d-3978-ae0e-2fb11fce821f",
                    "sense_definition": "To be emitted or breathed out; to evaporate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steam <w>evented</w> from the hot spring and vanished into the cold air.",
                            "target_lang_translations": {
                                "ru": "Пар <w>испарялся</w> из горячего источника и исчезал в холодном воздухе."
                            }
                        },
                        {
                            "text": "He watched as the smoke <w>evented</w> slowly from the chimney.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как дым медленно <w>выходил</w> из трубы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделяться, испаряться или выдыхаться (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испаряться",
                                "target_lang_sense_clarification": "выходить в виде пара"
                            },
                            {
                                "target_lang_word": "выделяться",
                                "target_lang_sense_clarification": "об испарениях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}