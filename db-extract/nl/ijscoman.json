                "senses": [
                    {
                        "sense_id": "c645504a-0c3a-3088-ac2a-794300544d5c",
                        "entry_id": "006c31b9-ab4f-34cf-a517-0158949a0039",
                        "glosses": [
                            "iemand die consumptie-ijs verkoopt vanuit een ijskraam"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "a9e8149a-2b44-45ad-8ef0-b3d688b06bca",
                                "sense_id": "c645504a-0c3a-3088-ac2a-794300544d5c",
                                "text": "De trekker met een ijscokraam erachter en aanstormende kinderen is een mooi tafereel. Als ze van koude lekkernijen zijn voorzien, springt de ijscoman weer op zijn trekker en rijdt hij een paar meter verder."
                            },
                            {
                                "example_id": "b591b973-9547-47e3-8f5b-de8402e8052c",
                                "sense_id": "c645504a-0c3a-3088-ac2a-794300544d5c",
                                "text": "Toen zelfs haar liaison match made in heaven met nota bene een ijscoman mislukte, vreesde ik even dat er toch een kern van waarheid in moest zitten, maar ik houd toch liever vast aan mijn ervaringen met haar als jarenlange collega bij ‘SBS Shownieuws’."
                            }
                        ]
                    }
                ],
