        "fr-extract.jsonl": [
            {
                "entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                "word": "passionnément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ec092f3-3a6a-393a-8efc-c8fec136b56f",
                        "entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                        "glosses": [
                            "Avec beaucoup de passion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "709e5688-dedd-4677-853a-e0af95cb995b",
                                "sense_id": "1ec092f3-3a6a-393a-8efc-c8fec136b56f",
                                "text": "J'aime pour la première fois de ma vie, et j'aime passionnément, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd3c0a7-de38-30de-8cb5-dd9921b345d6",
                        "entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                        "glosses": [
                            "Avec beaucoup de désir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9d4d49-c018-4e53-bcbf-7342b5e31a8f",
                                "sense_id": "bdd3c0a7-de38-30de-8cb5-dd9921b345d6",
                                "text": "Cela donna d’extrêmes inquiétudes à la reine, qui souhaitait passionnément sa guérison […]"
                            },
                            {
                                "example_id": "bf802813-8c9a-4be5-874e-e73fd056ca08",
                                "sense_id": "bdd3c0a7-de38-30de-8cb5-dd9921b345d6",
                                "text": "Le maître [Vauban], passionnément amoureux du bien public, ne demandait qu’à faire des élèves qui l’égalassent […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e599e43-8b59-4adf-acbf-ec38ba2973a8",
                        "source_entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                        "target_lang_word": "passionately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passionately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                        "entry_id": "f7081c0d-aa9c-3e7b-b989-4532101928a9",
                                        "glosses": [
                                            "In a passionate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8e14ab-81a4-4a34-bbd6-86cdeb2d89d1",
                                                "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached ; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]”"
                                            },
                                            {
                                                "example_id": "a62cd9b0-a947-463e-8087-623cb5f902f4",
                                                "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                                "text": "And it was while all were passionately intent upon the pleasing and snake-like progress of their uncle that a young girl in furs, ascending the stairs two at a time, peeped perfunctorily into the nursery as she passed the hallway—and halted amazed."
                                            },
                                            {
                                                "example_id": "36f010e6-4648-4c28-a0ca-9f09480e2f8c",
                                                "sense_id": "bec69e54-3cb8-3897-b154-127d2008a100",
                                                "text": "Was the sorrow at Mrs. Inglethorp’s death so great? I realized that there was an emotional lack in the atmosphere. The dead woman had not the gift of commanding love. Her death was a shock and a distress, but she would not be passionately regretted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38ead981-7150-4c95-813c-dcc7cd5a348e",
                        "source_entry_id": "db1ec7cb-fe61-397b-b724-a163361dc84c",
                        "target_lang_word": "passion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c536d3d7-7156-34fe-a4f9-e50cf3d7be31",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "A true desire sustained or prolonged."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5496fa88-cf03-4287-84c3-d1e735ba82a9",
                                                "sense_id": "c536d3d7-7156-34fe-a4f9-e50cf3d7be31",
                                                "text": "An oil lamp burned upon a high, old-fashioned mantel, casting its dim rays over a dozen repulsive figures. All but one were men. The other was a woman of about thirty. Her face, marked by low passions and dissipation, might once have been lovely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Any great, strong, powerful emotion, especially romantic love or extreme hate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a0d6ff-76c7-4848-9a86-0f7686b4f18a",
                                                "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                                                "text": "We share a passion for books."
                                            },
                                            {
                                                "example_id": "76be0a94-b486-4f3a-b8dd-f6d54e55f2b5",
                                                "sense_id": "b605791c-ce0c-333d-a19f-66e0e9fb74ae",
                                                "text": "That was partly because of a swirling wind that made precision passing difficult and also a derby atmosphere where the emphasis seemed to be on passion rather than football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc4b70a-7baa-393c-a13a-3e4219b4d452",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Fervor, determination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cf55df3-e83f-3a74-8d52-7339d6e5cf3b",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "An object of passionate or romantic love or strong romantic interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a40a88-ec32-460f-83a6-719892c40909",
                                                "sense_id": "2cf55df3-e83f-3a74-8d52-7339d6e5cf3b",
                                                "text": "It started as a hobby, but now my motorbike collection has become my passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72ef527-e92a-397f-bd7c-2a0d2642fab6",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Sexual intercourse, especially when very emotional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48478e1-f2e6-431d-aab3-b8165c7babc7",
                                                "sense_id": "b72ef527-e92a-397f-bd7c-2a0d2642fab6",
                                                "text": "We shared a night of passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9a1c46-8a15-37a6-86a1-51b32bbba0ed",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "The suffering of Jesus leading up to and during his crucifixion."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8b8186-a026-4238-af5a-1faaf8c16531",
                                                "sense_id": "6a9a1c46-8a15-37a6-86a1-51b32bbba0ed",
                                                "text": "Moreouer the perfit beleue of this article, worketh in all true chriſten people, aloue to continue in this vnitie, and afeare to be caſte out of the ſame, and it worketh in them that be ſinners and repentant, great comforte, and conſolacion, to obteine remiſſion of ſinne, by vertue of Chriſtes paſſion, and adminiſtracion of his ſacramentes at the miniſters handes, ordained for that purpoſe, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d31c6a2-4e9f-3194-8771-f60e7f1ce755",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "A display, musical composition, or play meant to commemorate the suffering of Jesus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6b2b107-b66b-3ecc-bdc6-8cb4a96406e3",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Suffering or enduring of imposed or inflicted pain; any suffering or distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1014f4d5-4901-428a-89eb-35d2e2f5b522",
                                                "sense_id": "d6b2b107-b66b-3ecc-bdc6-8cb4a96406e3",
                                                "text": "a cardiac passion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb84be7-790a-3064-8691-f77ac0524e38",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "The state of being acted upon; subjection to an external agent or influence; a passive condition"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b48c38a-dbb2-46f4-a11e-5da063ba9036",
                                                "sense_id": "dcb84be7-790a-3064-8691-f77ac0524e38",
                                                "text": "A Body at reſt affords us no Idea of any active Power to move; and when it is ſet in motion its ſelf, that Motion is rather a Paſſion, than an Action in it: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1bfb5c-5335-3201-b95a-1f65f39d597a",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "The capacity of being affected by external agents; susceptibility of impressions from external agents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7540db99-d40b-4b35-99a5-2e2748ef7cfa",
                                                "sense_id": "4b1bfb5c-5335-3201-b95a-1f65f39d597a",
                                                "text": "The Differences of Impreſsible and Not Impreſsible; Figurable and Not Figurable; Mouldable and Not Mouldable; Sciſsile and Not Sciſsile; And many other Paſsions of Matter, are Plebeian Notions, applied vnto the Inſtruments and Vſes which Men ordinarily practiſe; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ff9f5c-ff6d-3159-9469-288e074e0417",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "An innate attribute, property, or quality of a thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13cc862-e0fd-4d4a-8aca-fad1fef78144",
                                                "sense_id": "48ff9f5c-ff6d-3159-9469-288e074e0417",
                                                "text": "[...] to obtain the knowledge of some passion of the circle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c690f6a1-be22-3cb0-a774-43addcd62a12",
                                        "entry_id": "83fc540a-47ac-3c6c-b1e6-70f29a070c2b",
                                        "glosses": [
                                            "Disorder of the mind; madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43508217-acdd-47f2-9fed-70220b396600",
                                                "sense_id": "c690f6a1-be22-3cb0-a774-43addcd62a12",
                                                "text": "The fit is momentary, vpon a thought / He will againe be well. If much you note him / You ſhall offend him, and extend his Paſſion, / Feed, and regard him not."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                        "entry_id": "d99d6b26-0e86-321e-be1f-c8f68fa249a7",
                                        "glosses": [
                                            "To suffer pain or sorrow; to experience a passion; to be extremely agitated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25dd6c0-9e2a-412e-a7d5-a1b2a14f5afc",
                                                "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                                "text": "Dumbly she passions, frantically she doteth."
                                            },
                                            {
                                                "example_id": "ddf822bf-dcbf-4a24-afeb-64d7a83cc653",
                                                "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                                "text": "There did I ſee that low ſpirited Swaine, [...] hight Coſtard, (Clow[ne]. O mee) ſorted and conſorted contrary to thy eſtabliſhed proclaymed Edict and continent Cannon; Which with, o with, but with this I paſſion to ſay wherewith: / Clo[wne]. With a Wench."
                                            },
                                            {
                                                "example_id": "37d7c0b7-cdd4-4868-89fa-88296746e463",
                                                "sense_id": "847d930d-1a72-3af6-a66f-73a45b2eed8c",
                                                "text": "she passioned\nTo see herself escap'd from so sore ills"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d37ece-8599-34da-afc3-2e8991578c81",
                                        "entry_id": "d99d6b26-0e86-321e-be1f-c8f68fa249a7",
                                        "glosses": [
                                            "To give a passionate character to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
