                        ],
                        "form": "неокре́пшее"
                    },
                    {
                        "form_id": "9b9573b5-eddd-43ef-b2c6-f52fa8509f12",
                        "entry_id": "bd1a3715-dba9-3e46-8934-894b25cd7fa4",
                        "tags": [
