                "senses": [
                    {
                        "sense_id": "1a6b7163-f418-3383-b121-05319295d0f5",
                        "entry_id": "38e4acbb-9b7b-38d3-b126-2fe8c5ab664b",
                        "glosses": [
                            "Großstadt in Kalifornien, USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b32e2f2-618d-4a1b-a47b-1ec8f3a77010",
                                "sense_id": "1a6b7163-f418-3383-b121-05319295d0f5",
                                "text": "„Shaw glaubte sich zu erinnern, dass einer der schlimmsten Buschbrände in der Geschichte des Staates sich in Oakland ereignet hatte, hier ganz in der Nähe.“"
                            },
                            {
                                "example_id": "40c62584-74a4-48b9-8d80-d734d40a1568",
                                "sense_id": "1a6b7163-f418-3383-b121-05319295d0f5",
                                "text": "„Der Kanzler der Universität, Judah Leib Magnes, war ein Reformrabbiner aus dem kalifornischen Oakland, wohin seine deutschsprachigen Eltern aus Polen eingewandert waren.“"
                            },
                            {
                                "example_id": "f2b7b1a0-2455-45d3-a16d-62fb35e58903",
                                "sense_id": "1a6b7163-f418-3383-b121-05319295d0f5",
                                "text": "„Da sie bei am anderen Ende der Bucht wohnten, in Oakland, und beide auf dem Heimweg waren, nahmen sie dasselbe Taxi zur Fährstelle.“"
                            },
                            {
                                "example_id": "1af593ba-d7cb-4d05-88b3-664dca919e5f",
                                "sense_id": "1a6b7163-f418-3383-b121-05319295d0f5",
                                "text": "„Anschließend wichen sie vom ursprünglichen Kurs wahlweise nach Osten ab, in Richtung Oakland, oder flogen nach Westen über den Pazifischen Ozean.“"
                            }
                        ],
