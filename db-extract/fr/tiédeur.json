                ],
                "senses": [
                    {
                        "sense_id": "f815961e-dfc5-34d8-8dda-80911d4840ce",
                        "entry_id": "281a7bff-6c18-35d7-a820-1e5cc364175d",
                        "glosses": [
                            "État de ce qui est tiède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa27ed3-664d-452d-a0c6-5ef45db4aaab",
                                "sense_id": "f815961e-dfc5-34d8-8dda-80911d4840ce",
                                "text": "Cinq ou six grabats se touchant, dans l'unique pièce où les buées d'une lessive répandaient leur tiédeur acide."
                            },
                            {
                                "example_id": "45de4428-27a7-4448-9695-dc57dd038d68",
                                "sense_id": "f815961e-dfc5-34d8-8dda-80911d4840ce",
                                "text": "L’air avait pris une tiédeur délicieuse sentant l’été, et ont eût dit qu’il s’était immobilisé à jamais, qu’il ne pouvait plus y avoir de jours sombres ni de tempêtes."
                            }
                        ]
                    },
                    {
                        "sense_id": "da30ec96-a418-3c8d-85b4-dd257bb75581",
                        "entry_id": "281a7bff-6c18-35d7-a820-1e5cc364175d",
                        "glosses": [
                            "Manque d’ardeur, de ferveur, de zèle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f6f4e118-0446-40da-9551-e11bc60f041f",
                                "sense_id": "da30ec96-a418-3c8d-85b4-dd257bb75581",
                                "text": "Agir avec tiédeur."
                            },
                            {
                                "example_id": "6127486a-aa26-41d1-be1f-3d829a98b899",
                                "sense_id": "da30ec96-a418-3c8d-85b4-dd257bb75581",
                                "text": "Servir ses amis avec tiédeur."
                            },
                            {
                                "example_id": "2c5c70f9-bc36-4a5c-8131-358cb461f90b",
                                "sense_id": "da30ec96-a418-3c8d-85b4-dd257bb75581",
                                "text": "Il y a bien du relâchement, bien de la tiédeur dans sa dévotion."
                            },
                            {
                                "example_id": "44bc2f54-8c68-4e00-9bb0-062ebb083065",
                                "sense_id": "da30ec96-a418-3c8d-85b4-dd257bb75581",
                                "text": "D’une grande ferveur, il est tombé dans une extrême tiédeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfad42e4-2631-4e40-b0e9-1353443d4127",
                        "source_entry_id": "281a7bff-6c18-35d7-a820-1e5cc364175d",
                        "source_sense_description": "état de ce qui est tiède",
                        "target_lang_word": "lukewarmness",
