                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c4a21c5-1c40-48ea-b41f-d14a1347790f",
                                                "sense_id": "a8b1df66-7a84-3252-b991-67e848fa2af0",
                                                "text": "In all 5 untreated coeliacs as well as the 3 partially treated coeliacs who were in relapse at the time of biopsy, villi were entirely absent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6364d2d-408d-40d3-85f6-43ca841bd94f",
                        "source_entry_id": "01233f70-c1a5-343e-8dc7-d752cf5d3c5b",
                        "source_sense_id": "78175666-6434-3a96-8539-91920d504d62",
                        "target_lang_word": "partly",
                        "target_lang_code": "en",
