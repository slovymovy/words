                                        "sense_id": "dcf95855-dc3c-374c-b29f-f5fc97626b0f",
                                        "entry_id": "5907fdf0-2a07-357f-91eb-0bdd1f2ad441",
                                        "glosses": [
                                            "At an indefinite but stated time in the past or future."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06541a8c-f781-49f6-83b2-d3a3ecc29d73",
                                                "sense_id": "dcf95855-dc3c-374c-b29f-f5fc97626b0f",
                                                "text": "I'll see you at the pub sometime this evening."
                                            },
                                            {
                                                "example_id": "e4a361ff-4fd7-4269-bc19-73627b06af03",
                                                "sense_id": "dcf95855-dc3c-374c-b29f-f5fc97626b0f",
                                                "text": "This will certainly happen sometime in the future."
                                            },
                                            {
                                                "example_id": "1dc6954a-c818-4816-bdf5-550f3ff173cb",
                                                "sense_id": "dcf95855-dc3c-374c-b29f-f5fc97626b0f",
                                                "text": "It happened sometime yesterday."
                                            },
                                            {
                                                "example_id": "108a3651-596c-4862-81a5-0228da273f9e",
                                                "sense_id": "dcf95855-dc3c-374c-b29f-f5fc97626b0f",
                                                "text": "But while there remains a considerable degree of consensus that the consequence of apparently losing the plot sometime between 1914 and 1918 was the cultural and economic malaise of the 1920s and 1930s, there are still some who look back on the interwar years less with criticism than with nostalgia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c334fd5e-fa29-3662-af3c-1dc56bba0e65",
                                        "entry_id": "5907fdf0-2a07-357f-91eb-0bdd1f2ad441",
                                        "glosses": [
                                            "Sometimes."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0ae68ab-6596-3b78-bb36-41bbecff9a1a",
                                        "entry_id": "5907fdf0-2a07-357f-91eb-0bdd1f2ad441",
                                        "glosses": [
                                            "At an unstated past or future time; once; formerly."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da850b16-ed09-4b22-bbc3-a7ce08f13ed2",
                                                "sense_id": "f0ae68ab-6596-3b78-bb36-41bbecff9a1a",
                                                "text": "Did they not sometime cry \"All hail\" to me?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sometime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47fbe9f6-7786-381b-8ac4-11a83ba67ff8",
                                        "entry_id": "291f5e5d-e94e-3783-a95b-79286876811d",
                                        "glosses": [
                                            "Former, erstwhile; at some previous time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b53b7721-1056-4db3-855e-afc94be391e7",
                                                "sense_id": "47fbe9f6-7786-381b-8ac4-11a83ba67ff8",
                                                "text": "my sometime friend and mentor"
                                            },
                                            {
                                                "example_id": "37d2714a-e2e3-46e5-9188-c45a4e709b58",
                                                "sense_id": "47fbe9f6-7786-381b-8ac4-11a83ba67ff8",
                                                "text": "Therefore our sometime sister, now our queen / Th' imperial jointress to this warlike state"
                                            },
                                            {
                                                "example_id": "deb08147-2436-4a11-96bc-6eb860cf6054",
                                                "sense_id": "47fbe9f6-7786-381b-8ac4-11a83ba67ff8",
                                                "text": "Ion our sometime darling, whom we prized / As a stray gift, by bounteous Heaven dismiss'd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0357ea4a-6b44-3f86-abff-444fe31f5344",
                                        "entry_id": "291f5e5d-e94e-3783-a95b-79286876811d",
                                        "glosses": [
                                            "Occasional; intermittent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "753c099b-8d43-4ac3-9d54-6a110147b477",
                                                "sense_id": "0357ea4a-6b44-3f86-abff-444fe31f5344",
                                                "text": "an author and sometime lecturer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dd82caa-9331-4570-a4b8-3399fc5887cf",
                        "source_entry_id": "4abf808c-e2d7-3a7e-b451-44349f318203",
                        "source_sense_id": "c5572fda-4558-388c-8cd1-008bac35a3dd",
