                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba666da-3334-4c7a-ad3a-a92324682113",
                                "sense_id": "631145e6-0320-33bd-8fe8-1dfe73f17a07",
                                "text": "Administrez-lui un antipyrétique, médicament contre la fièvre."
