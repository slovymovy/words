                                        "glosses": [
                                            "Ausgleich einer verminderten Leistung eines Organs durch gesteigerte Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f358386f-c480-447d-9c6e-cc34e4af5b9b",
                                                "sense_id": "77793875-affd-3219-802f-3efde1eeea06",
                                                "text": "„Diesen Inselbegabungen geht in der Regel eine Schädigung der linken Gehirnhälfte voraus, die Extremleistung ist das Ergebnis einer Kompensation der rechten Gehirnhälfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
