        "fr-extract.jsonl": [
            {
                "entry_id": "03d77033-dcd6-34a7-90ed-372ba96f8d04",
                "word": "Canberra",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "070af42c-eb3b-3dbf-9ced-203160fa0e25",
                        "entry_id": "03d77033-dcd6-34a7-90ed-372ba96f8d04",
                        "glosses": [
                            "Ville et capitale de l’Australie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "565e6b66-bebe-40db-be9d-0912761b85d8",
                                "sense_id": "070af42c-eb3b-3dbf-9ced-203160fa0e25",
                                "text": "Il y a à Canberra un extraordinaire musée de la guerre, comme il n’en existe nulle part au monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "49d1294d-d145-3005-b070-10a42dd9012c",
                        "entry_id": "03d77033-dcd6-34a7-90ed-372ba96f8d04",
                        "glosses": [
                            "Gouvernement de l’Australie."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "7650851c-fcd5-402d-973b-13400f6183dc",
                                "sense_id": "49d1294d-d145-3005-b070-10a42dd9012c",
                                "text": "On constate ici que certains pays voient maintenant plus clair dans le jeu chinois et, surtout, qu’ils osent maintenant le dire à voix haute. On pense à l’Australie, qui depuis le début de la pandémie a demandé des comptes à la Chine, laquelle a répondu par des représailles économiques sans précédent contre Canberra."
                            },
                            {
                                "example_id": "8a56d163-d4cc-45fd-a67c-21b5598b5e31",
                                "sense_id": "49d1294d-d145-3005-b070-10a42dd9012c",
                                "text": "Canberra continuera de mettre en avant le fait que les États-Unis ont depuis longtemps un excédent commercial avec l’Australie et qu’ils bénéficient de bonnes relations économiques, a-t-il relevé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9151919-54a8-4be7-809c-31723ba5e86b",
                        "source_entry_id": "03d77033-dcd6-34a7-90ed-372ba96f8d04",
                        "target_lang_word": "Canberra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
