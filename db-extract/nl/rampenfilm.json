                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6788d2c-8436-49f2-893b-5c9bf98e942d",
                                "sense_id": "12360a9f-d65c-3078-b7af-cb1cd9ff2539",
                                "text": "'s Nachts lag hij roerloos onder het beddelaken, met zijn nagels in de matras gedrukt, te wachten tot het trappenhuis zijn onbedoelde nevenfunctie als vlammenwerper zou ontplooien. Een rampenfilm, antwoordde hij, als Zwanet hem hoorde zuchten en vroeg wat er was."
                            },
                            {
                                "example_id": "2df2e648-8196-4f2b-b852-e9607fd10fa7",
                                "sense_id": "12360a9f-d65c-3078-b7af-cb1cd9ff2539",
                                "text": "Collins speelde in de jaren 60 en 70 in televisie-series als 'Perry Mason', 'Ironside' en 'The Iron Horse'. Ook had hij een gastrol in 'The Love Boat' en een kleine rol in de rampenfilm 'Airport'. Een paar jaar geleden speelde hij nog in een aflevering van de dramaserie 'Dirty Sexy Money'."
                            }
                        ]
