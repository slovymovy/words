{
    "word_family": [
        "épandage",
        "épandeur",
        "épandre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13c44752-5a7c-3271-a035-ef369508dfb9",
                    "sense_definition": "Renverser ou laisser s'écouler involontairement un liquide ou une matière hors de son contenant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liquide_matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais bien attention à ne pas <w>répandre</w> ton café sur les documents importants."
                        },
                        {
                            "text": "L'enfant a maladroitement heurté la carafe et a <w>répandu</w> de l'eau sur la nappe propre."
                        }
                    ],
                    "synonyms": [
                        "renverser"
                    ]
                },
                {
                    "sense_id": "f2480d0a-75ec-3d18-96a4-7a54d2d03cd0",
                    "sense_definition": "Faire connaître largement, propager ou faire circuler une information, une idée ou un bruit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "information_propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas chercher à <w>répandre</w> une rumeur avant d'avoir vérifié son authenticité."
                        },
                        {
                            "text": "Ce journaliste a <w>répandu</w> la nouvelle bien avant la confirmation officielle des autorités locales."
                        }
                    ],
                    "synonyms": [
                        "diffuser",
                        "divulguer",
                        "propager"
                    ],
                    "antonyms": [
                        "dissimuler",
                        "taire"
                    ],
                    "common_phrases": [
                        "répandre la nouvelle",
                        "répandre une rumeur"
                    ]
                },
                {
                    "sense_id": "8caef94b-e4d3-39e0-9f03-5d4199d88d65",
                    "sense_definition": "Dégager ou diffuser autour de soi une odeur, un parfum, une lueur ou une chaleur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission_sensorielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fleurs du jardin s'ouvrent au soleil et <w>répandent</w> un parfum délicat dans toute la maison."
                        },
                        {
                            "text": "Ce vieux poêle en fonte <w>répand</w> une douce chaleur dans le salon pendant les froides soirées d'hiver."
                        }
                    ],
                    "synonyms": [
                        "dégager",
                        "exhaler",
                        "émettre"
                    ],
                    "common_phrases": [
                        "répandre un parfum",
                        "répandre une odeur"
                    ]
                },
                {
                    "sense_id": "2c0305d1-515c-35be-bfbf-f8bb128d8b18",
                    "sense_definition": "S'exprimer longuement et avec abondance, en proférant des louanges, des plaintes ou des reproches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin de la représentation, le directeur s'est <w>répandu</w> en éloges chaleureux envers tous les artistes."
                        },
                        {
                            "text": "Particulièrement mécontent de l'accueil, le client s'est <w>répandu</w> en plaintes amères auprès du responsable."
                        }
                    ],
                    "antonyms": [
                        "se taire"
                    ],
                    "common_phrases": [
                        "se répandre en éloges",
                        "se répandre en plaintes"
                    ]
                }
            ]
        }
    ]
}