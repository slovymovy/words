                        "sense_id": "136f3e07-8e5c-3d9e-a9e8-c625db260d4f",
                        "entry_id": "b34786e1-d852-3cbc-af49-f46418a69862",
                        "glosses": [
                            "als Schiffsproviant dienender Zwieback, von Schiffsbesatzungen gegessener Zwieback"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc48a36-0263-4c01-9342-f2a7d90275bf",
                                "sense_id": "136f3e07-8e5c-3d9e-a9e8-c625db260d4f",
                                "text": "„Nachts hockte er im Lager der Treiber, aß Schiffszwieback mit Bohnen und ließ sich vom Hirtenleben erzählen.“"
                            }
                        ],
