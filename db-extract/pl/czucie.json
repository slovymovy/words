                    },
                    {
                        "translation_id": "619255d1-b6e1-4437-b7bd-934d3aa318de",
                        "source_entry_id": "e7afef8d-bfb7-34dc-9d64-f21c82ae9e14",
                        "source_sense_id": "cb4b8825-dadf-351e-8fdf-164e3badc090",
                        "target_lang_word": "Gefühl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefühl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82f5c934-14c0-3f51-b707-7e79f1033a20",
                                        "entry_id": "e66c3ad7-5867-325f-9a81-9d24c127ce45",
                                        "glosses": [
                                            "das subjektive Erleben von Erregung und hirnchemischer Aktivität"
                                        ],
                                        "tags": [
                                            "Neurologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d0acdd-dcc9-4087-9975-93c5c411e252",
                                                "sense_id": "82f5c934-14c0-3f51-b707-7e79f1033a20",
                                                "text": "Der Mandelkern und die Amygdala spielen eine entscheidende Rolle in der Verarbeitung von Gefühlen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac1bc9aa-6108-3b05-8f45-eee8f2dcaf73",
                                        "entry_id": "e66c3ad7-5867-325f-9a81-9d24c127ce45",
                                        "glosses": [
                                            "gefühlsmäßiger Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0afa6903-7186-4cda-961f-9398ce386759",
                                                "sense_id": "ac1bc9aa-6108-3b05-8f45-eee8f2dcaf73",
                                                "text": "Meine Gefühle nach diesem Verlust kann ich im Moment gar nicht beschreiben."
                                            },
                                            {
                                                "example_id": "2d52c410-4a66-48df-a2ff-737d6ff1be39",
                                                "sense_id": "ac1bc9aa-6108-3b05-8f45-eee8f2dcaf73",
                                                "text": "„Alle Teile sind von einer neuen Auswertung von Gefühlen oder Affekten geprägt.“"
                                            },
                                            {
                                                "example_id": "8dfa7208-9378-458c-8256-ddb7235fc9d8",
                                                "sense_id": "ac1bc9aa-6108-3b05-8f45-eee8f2dcaf73",
                                                "text": "„Das Gefühl übermannte mich; doch ich empfand eher Scham als Rührung.“"
                                            },
                                            {
                                                "example_id": "e5d1aca1-88bb-42fa-942b-1ded65f35a43",
                                                "sense_id": "ac1bc9aa-6108-3b05-8f45-eee8f2dcaf73",
                                                "text": "„Allein gelassen werden ist ein Gefühl, dass viele der Befragten teilen.“"
                                            },
                                            {
                                                "example_id": "f3cd7d19-e599-4b09-b17f-811e59254ec2",
                                                "sense_id": "ac1bc9aa-6108-3b05-8f45-eee8f2dcaf73",
                                                "text": "„Pécuchet war für Gefühl und Gedanken, Bouvard für Bildhaftigkeit und Farbe – bald verstanden sie einander nicht mehr; und jeder wunderte sich, daß der andere so borniert war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "efdd01a7-af47-3ef4-a60b-b6c752dd0ff1",
                                        "entry_id": "e66c3ad7-5867-325f-9a81-9d24c127ce45",
                                        "glosses": [
                                            "Einschätzung, die nicht auf Überlegung beruht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a283c2c-7d92-45e1-83b8-6e31f1032d8e",
                                                "sense_id": "efdd01a7-af47-3ef4-a60b-b6c752dd0ff1",
                                                "text": "Ich habe das Gefühl, dass hier die Falschen getroffen wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c0abc83f-dc98-3a94-a78b-e07e238cb26e",
                                        "entry_id": "e66c3ad7-5867-325f-9a81-9d24c127ce45",
                                        "glosses": [
                                            "Intuition, die Fähigkeit, bestimmte Dinge ohne viel Nachdenken richtig einzuschätzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74388c9a-4f46-4c95-9150-d70df96998c7",
                                                "sense_id": "c0abc83f-dc98-3a94-a78b-e07e238cb26e",
                                                "text": "Sie hat ein Gefühl für den richtigen Ton."
                                            },
                                            {
                                                "example_id": "ff0b824c-2f4e-4778-a031-831ab45fc2c1",
                                                "sense_id": "c0abc83f-dc98-3a94-a78b-e07e238cb26e",
                                                "text": "Das Gefühl trog den Jäger nicht: Nahe der Flussbiegung lief ihm ein kapitaler Hirsch vor die Büchse."
                                            },
                                            {
                                                "example_id": "b12360b6-44c1-4d87-accd-10864cbb5222",
                                                "sense_id": "c0abc83f-dc98-3a94-a78b-e07e238cb26e",
                                                "text": "Meinem Gefühl nach kann das nur schiefgehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fd78e799-4fe8-31a0-a6fe-073756ad8501",
                                        "entry_id": "e66c3ad7-5867-325f-9a81-9d24c127ce45",
                                        "glosses": [
                                            "Sinneswahrnehmung des Tast-, Temperatur-, Druck-, Schmerz- oder Gleichgewichtssinnes (des so genannten fünften Sinnes) oder die Fähigkeit dazu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7de9e0d-d228-4cad-a4a5-0865917df817",
                                                "sense_id": "fd78e799-4fe8-31a0-a6fe-073756ad8501",
                                                "text": "Ein Gefühl von Wärme überkam sie."
                                            },
                                            {
                                                "example_id": "4bed8040-0e4d-40ce-ba2d-01169fa8d496",
                                                "sense_id": "fd78e799-4fe8-31a0-a6fe-073756ad8501",
                                                "text": "Da sie nicht sehen kann, flicht sie die Körbe nach Gefühl."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b09c20e-3f07-4f36-b629-bdf7aab6392b",
