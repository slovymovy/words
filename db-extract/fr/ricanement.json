                            },
                            {
                                "target_word": "snigger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9110c26f-69c5-34df-8bdc-7be0e3a830a3",
                                        "entry_id": "15189575-aa26-3caa-8909-2e61b2e23d2a",
                                        "glosses": [
                                            "To emit a snigger."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80dc3685-edf8-45d6-93b2-190c2c14d311",
                                                "sense_id": "9110c26f-69c5-34df-8bdc-7be0e3a830a3",
                                                "text": "[…]presently the Mole's spirits revived again, and he was even able to give some straight back-talk to a couple of moorhens who were sniggering to each other about his bedraggled appearance."
                                            },
                                            {
                                                "example_id": "fc7502c2-7c85-4488-9c0e-a2ed4dfaabd6",
                                                "sense_id": "9110c26f-69c5-34df-8bdc-7be0e3a830a3",
                                                "text": "Peter, after the manner of man at the breakfast table, had allowed half his kedgeree to get cold and was sniggering over a letter. Sophia looked at him sharply. The only letter she had received was from her mother. Sophia's mother was not a humourist."
                                            },
                                            {
                                                "example_id": "774d56f9-e2fe-41b6-9fb3-5363488ae566",
                                                "sense_id": "9110c26f-69c5-34df-8bdc-7be0e3a830a3",
                                                "text": "That said, I still find it hard not to snigger when I hear [Travis] Kelce described as being the Kansas City Chiefs' tight end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
