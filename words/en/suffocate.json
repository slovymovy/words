{
    "word_family": [
        "suffocation",
        "suffocatingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a58feeb-f9f2-3a29-aa2b-2ae4734be4c6",
                    "sense_definition": "To suffer, or cause someone to suffer, from severely reduced oxygen intake to the body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "oxygen_deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Open the hatch, he is <w>suffocating</w> in the airlock!",
                            "target_lang_translations": {
                                "tr": "Kapağı açın, hava kilidinde <w>boğuluyor</w>!",
                                "de": "Öffne die Luke, er <w>erstickt</w> in der Luftschleuse!"
                            }
                        },
                        {
                            "text": "When <w>suffocating</w> from smoke, you must crawl along the floor to find fresh air.",
                            "target_lang_translations": {
                                "tr": "Dumandan <w>boğulurken</w>, temiz hava bulmak için yerde sürünmelisiniz.",
                                "de": "Wenn man durch Rauch <w>erstickt</w>, muss man am Boden entlang kriechen, um frische Luft zu finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "asphyxiate",
                        "choke"
                    ],
                    "common_phrases": [
                        "suffocating in smoke"
                    ],
                    "target_lang_definitions": {
                        "tr": "Oksijen yetersizliği nedeniyle nefes alamamak veya birinin nefes almasını engellemek.",
                        "de": "An Sauerstoffmangel leiden oder bei jemand anderem einen Sauerstoffmangel verursachen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boğulmak",
                                "target_lang_sense_clarification": "Nefes alamama durumu."
                            },
                            {
                                "target_lang_word": "nefesi kesilmek",
                                "target_lang_sense_clarification": "Hava alamadığı için zorlanmak."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ersticken",
                                "target_lang_sense_clarification": "Aufgrund von Sauerstoffmangel keine Luft bekommen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b15030fc-6913-3e96-a1e1-e0720e0e0c26",
                    "sense_definition": "To die due to, or kill someone by means of, insufficient oxygen supply to the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oxygen_deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trapped miners <w>suffocated</w> after the tunnel collapsed.",
                            "target_lang_translations": {
                                "tr": "Tünel çöktükten sonra mahsur kalan madenciler <w>boğularak</w> öldü.",
                                "de": "Die eingeschlossenen Bergleute <w>erstickten</w>, nachdem der Tunnel eingestürzt war."
                            }
                        },
                        {
                            "text": "He <w>suffocated</w> his victim by holding a pillow over her face.",
                            "target_lang_translations": {
                                "tr": "Yüzüne yastık bastırarak kurbanını <w>boğdu</w>.",
                                "de": "Er <w>erstickte</w> sein Opfer, indem er ihr ein Kissen auf das Gesicht drückte."
                            }
                        }
                    ],
                    "synonyms": [
                        "stifle",
                        "choke",
                        "smother"
                    ],
                    "target_lang_definitions": {
                        "tr": "Oksijen eksikliği nedeniyle ölmek veya birini bu yolla öldürmek.",
                        "de": "Aufgrund von Sauerstoffmangel sterben oder jemanden durch Entzug von Sauerstoff töten."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boğularak ölmek",
                                "target_lang_sense_clarification": "Oksijensizlikten kaynaklanan ölüm."
                            },
                            {
                                "target_lang_word": "boğmak",
                                "target_lang_sense_clarification": "Birini nefessiz bırakarak öldürmek."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ersticken",
                                "target_lang_sense_clarification": "Durch Sauerstoffmangel sterben oder jemanden töten."
                            },
                            {
                                "target_lang_word": "würgen",
                                "target_lang_sense_clarification": "Jemandem die Kehle zudrücken, um die Atmung zu unterbinden."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17bafe56-5206-366b-b645-c121044ff9b7",
                    "sense_definition": "To overwhelm, or be overwhelmed, as though with oxygen deprivation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overwhelmed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>suffocating</w> under this huge workload at the office.",
                            "target_lang_translations": {
                                "tr": "Ofisteki bu ağır iş yükü altında <w>bunalıyorum</w>.",
                                "de": "Ich <w>ersticke</w> unter diesem riesigen Arbeitspensum im Büro."
                            }
                        },
                        {
                            "text": "The city traffic is <w>suffocating</w> the local economy.",
                            "target_lang_translations": {
                                "tr": "Şehir trafiği yerel ekonomiyi <w>boğuyor</w>.",
                                "de": "Der Stadtverkehr <w>erstickt</w> die lokale Wirtschaft."
                            }
                        }
                    ],
                    "synonyms": [
                        "stifle",
                        "smother"
                    ],
                    "common_phrases": [
                        "suffocating under pressure"
                    ],
                    "target_lang_definitions": {
                        "tr": "Baskı, yoğunluk veya kısıtlanmışlık hissiyle bunalmak veya bir şeyi engellemek.",
                        "de": "Sich durch Druck, Überlastung oder Einschränkung eingeengt fühlen oder etwas in seiner Entwicklung hemmen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bunalmak",
                                "target_lang_sense_clarification": "Aşırı baskı veya yoğunluk altında hissetmek."
                            },
                            {
                                "target_lang_word": "boğmak",
                                "target_lang_sense_clarification": "Gelişimi veya özgürlüğü engellemek."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bunalmak",
                                "target_lang_sense_clarification": "Sich durch äußere Umstände oder Druck erdrückt fühlen."
                            },
                            {
                                "target_lang_word": "erdrücken",
                                "target_lang_sense_clarification": "Sich durch eine Last oder Situation psychisch oder physisch eingeengt fühlen."
                            },
                            {
                                "target_lang_word": "unterdrücken",
                                "target_lang_sense_clarification": "Die Entwicklung oder Freiheit von etwas oder jemandem behindern."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "776d3ec9-0d54-3a2f-9515-9c9d46b1fa45",
                    "sense_definition": "To destroy or extinguish something, especially a fire.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a fire blanket to <w>suffocate</w> the flames.",
                            "target_lang_translations": {
                                "tr": "Alevleri <w>boğmak</w> için yangın battaniyesi kullanın.",
                                "de": "Benutze eine Löschdecke, um die Flammen zu <w>ersticken</w>."
                            }
                        },
                        {
                            "text": "They tried to <w>suffocate</w> the fire with sand.",
                            "target_lang_translations": {
                                "tr": "Ateşi kumla <w>boğmaya</w> çalıştılar.",
                                "de": "Sie versuchten, das Feuer mit Sand zu <w>ersticken</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stifle",
                        "smother"
                    ],
                    "common_phrases": [
                        "suffocate the fire"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi, özellikle ateşi, oksijenini keserek söndürmek.",
                        "de": "Etwas, insbesondere ein Feuer, durch Entzug von Sauerstoff löschen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boğmak",
                                "target_lang_sense_clarification": "Ateşi hava almayacak şekilde kapatarak söndürmek."
                            },
                            {
                                "target_lang_word": "söndürmek",
                                "target_lang_sense_clarification": "Ateşi etkisiz hale getirmek."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ersticken",
                                "target_lang_sense_clarification": "Ein Feuer durch Abschneiden der Luftzufuhr löschen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4eabe0c4-cd58-3ff6-85ba-8efcacafcb27",
                    "sense_definition": "Suffocated or choked.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oxygen_deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>suffocate</w> victim was found in the smoke-filled room.",
                            "target_lang_translations": {
                                "tr": "Dumanla dolu odada <w>boğulmuş</w> kurban bulundu.",
                                "de": "Das <w>erstickte</w> Opfer wurde in dem rauchgefüllten Raum gefunden."
                            }
                        },
                        {
                            "text": "He felt <w>suffocate</w> in the tight, crowded space.",
                            "target_lang_translations": {
                                "tr": "Dar ve kalabalık alanda <w>boğulmuş</w> hissetti.",
                                "de": "Er fühlte sich in dem engen, überfüllten Raum <w>erstickt</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely archaic or poetic."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Nefessiz kalmış veya boğulmuş (eski kullanım).",
                        "de": "Nefessiz kalmış veya boğulmuş (eski kullanım)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boğulmuş",
                                "target_lang_sense_clarification": "Nefes alamama durumuna maruz kalmış."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erstickt",
                                "target_lang_sense_clarification": "Zustand, in dem jemandem die Luft zum Atmen genommen wurde."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}