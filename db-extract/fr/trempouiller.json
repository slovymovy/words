                ],
                "senses": [
                    {
                        "sense_id": "e3da6ff3-867e-38e0-9901-925727efc9ba",
                        "entry_id": "84df8c88-edcc-33d9-9847-ac45ce7a19ff",
                        "glosses": [
                            "Tremper (dans un liquide)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85540f07-12d3-44d8-9ce2-d3ccd8ab9f2a",
                                "sense_id": "e3da6ff3-867e-38e0-9901-925727efc9ba",
                                "text": "C’est pourquoi on passait mes quatre semaines de congé à La Rouchetière ; ensuite, Josette irait chez ses parents à Nice, pour trempouiller les gosses dans l’eau de mer et se trempouiller elle-même."
                            },
                            {
                                "example_id": "30ae250f-2281-4127-b7f6-3f8b79a88896",
                                "sense_id": "e3da6ff3-867e-38e0-9901-925727efc9ba",
                                "text": "Même assis à trempouiller délicieusement sur le bord du lagon, nous restons vigilants. Les jeunes requins vadrouillent souvent dans dix centimètres d’eau."
                            },
                            {
                                "example_id": "9fdbe642-6bf7-442c-88ae-a9aa55ab338d",
                                "sense_id": "e3da6ff3-867e-38e0-9901-925727efc9ba",
                                "text": "Moi je craque pour ces soirées cocooning au chaud en famille, un mug de lait chaud et quelques cookies à trempouiller dedans."
                            },
                            {
                                "example_id": "3128c1cc-ead8-4146-bd26-8be791b08870",
                                "sense_id": "e3da6ff3-867e-38e0-9901-925727efc9ba",
                                "text": "Je m’approchais de la chope remplie d’un mélange ocreux dans laquelle il trempouillait un permis de conduire plié en accordéon."
                            }
                        ]
                    },
                    {
                        "sense_id": "85a7075a-59f3-3ac8-bea2-3ee50a7ab6b0",
                        "entry_id": "84df8c88-edcc-33d9-9847-ac45ce7a19ff",
                        "glosses": [
                            "Tremper (être impliqué)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef73f38-d8ee-4a00-a627-47209b45b7b5",
                                "sense_id": "85a7075a-59f3-3ac8-bea2-3ee50a7ab6b0",
                                "text": "Et ton Girkas, il trempouille là-dedans ?"
                            }
                        ]
                    }
