                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huile de coprah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7cce605-c640-3655-8546-d95992b89fb1",
                                        "entry_id": "a8ff4a77-f2f8-3bea-b251-088a5fd0bf3e",
                                        "glosses": [
                                            "Huile obtenue par pression de la pulpe, coprah, de la noix de coco."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c037e3d6-9fc3-463f-9774-ec5a363cd6e3",
                                                "sense_id": "d7cce605-c640-3655-8546-d95992b89fb1",
                                                "text": "[…] certaines huiles de substitution sont pires. Ainsi, l’huile de coco (ou huile de coprah) possède 85 % d’acides gras saturés contre « seulement » 50 % pour l’huile de palme !"
                                            },
                                            {
                                                "example_id": "a85b9bfe-6aa3-49ff-b9f8-e91901f91b76",
                                                "sense_id": "d7cce605-c640-3655-8546-d95992b89fb1",
                                                "text": "Au cours des années, il n’avait cessé d’innover, ajoutant aux recettes traditionnelles des huiles de coprah, de palme ou de coton, peaufinant les conditions de séchage, modifiant l’usage des acides oléiques, etc."
                                            }
                                        ]
                                    }
