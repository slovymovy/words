                                "target_senses": [
                                    {
                                        "sense_id": "304028e6-8bbd-3e09-94ef-cc12d551651d",
                                        "entry_id": "7276a0ab-142c-37e8-b0a7-8cdf5605bc91",
                                        "glosses": [
                                            "A doll made from cloth and stuffed with rags."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0afbd91-6fa8-4738-8dbc-d66d2ac4d42b",
                                                "sense_id": "304028e6-8bbd-3e09-94ef-cc12d551651d",
                                                "text": "The tornado flung the man around like a rag doll."
                                            },
                                            {
                                                "example_id": "aea8c3ee-c6a4-48bf-acb3-36760a80226f",
                                                "sense_id": "304028e6-8bbd-3e09-94ef-cc12d551651d",
                                                "text": "Then all six foot five and 17 stone of him picks me up like a rag doll and starts throwing me around. I thought I was on the Cha Cha for a minute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
