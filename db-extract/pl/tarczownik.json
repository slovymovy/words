                                "target_senses": [
                                    {
                                        "sense_id": "5762f6c4-3fdc-34c2-a58f-19e7ebec82fd",
                                        "entry_id": "70910063-e9c9-315a-a195-82028dce3545",
                                        "glosses": [
                                            "Hombre que por su sangre es de una clase noble y distinguida."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af16cb77-8c88-4aef-b9b4-d67a30a31034",
                                                "sense_id": "5762f6c4-3fdc-34c2-a58f-19e7ebec82fd",
                                                "text": "topóme Dios con un escudero que iba por la calle con razonable vestido, bien peinado, su paso y compás en orden. Miróme, y yo a él, y díjome: “Mochacho, ¿buscas amo?” Yo le dije: “Sí, señor.” “Pues vente tras mí —me respondió— que Dios te ha hecho merced en topar comigo. Alguna buena oración rezaste hoy.”."
                                            }
                                        ],
