            {
                "entry_id": "f92f10b2-db29-3bd8-aa16-2b177a9f20e6",
                "word": "innéisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "324038e3-367d-4b17-8046-cba576591b2a",
                        "entry_id": "f92f10b2-db29-3bd8-aa16-2b177a9f20e6",
                        "tags": [
                            "plural"
