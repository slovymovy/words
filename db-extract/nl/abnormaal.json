                    },
                    {
                        "form_id": "aa038762-9dbf-4029-bd26-e96f7400d19f",
                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "abnormalers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "glosses": [
                            "ongewoon, bijzonder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52263b4c-b399-4455-8740-5c476a516e3a",
                                "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                "text": "Hij heeft een abnormaal grote interesse in alles wat met Napoleon te maken heeft."
                            },
                            {
                                "example_id": "8b6a9d89-f9e6-4995-b71f-8d675995f0aa",
                                "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                "text": "Elk geluid klonk abnormaal luid: het rammelen van haar sleutels, het zoemen van de koelkast, het blazen van Brontë."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "glosses": [
                            "licht gek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e6cba79-d6b2-40b6-8658-e18556c90f20",
                                "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                "text": "Het meisje had altijd heel abnormale kleren aan, maar ze vond zichzelf heel bijzonder."
                            },
                            {
                                "example_id": "66e5ffcb-aa26-4c0c-bb8c-123a9c30a82a",
                                "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                "text": "Ze verzachtte dat meteen: 'Ik bedoel niet dat er iets abnormaals aan was, alleen dat Adeline van mening leek te zijn dat de jongen exclusief van haar was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eaf6dbc-67b2-496c-b42e-6756848ca65d",
                        "source_entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "source_sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                        "source_sense_description": "ongewoon",
                        "target_lang_word": "abnormal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac2180a-754a-3836-b359-d5fcc16727b2",
                                        "entry_id": "bdcd3a0f-11ca-3c24-a23e-3f1be639cefa",
                                        "glosses": [
                                            "abnorm, nicht normal"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10155106-46c5-482a-a101-ad3965fd6790",
                                                "sense_id": "5ac2180a-754a-3836-b359-d5fcc16727b2",
                                                "text": "„Das Bild zeigt eine abnormale LSR [Labyrinthstellreaktion] nach rechts“"
                                            },
                                            {
                                                "example_id": "26ad021b-1542-4264-a3d3-c1b667758f27",
                                                "sense_id": "5ac2180a-754a-3836-b359-d5fcc16727b2",
                                                "text": "„Bis vor einem Jahr war das Verhältnis zwischen uns und dem Reich demnach ein abnormales, wie es zwischen Staaten, die die Pflicht haben, in Frieden miteinander zu leben, sonst nicht besteht.“"
                                            },
                                            {
                                                "example_id": "50359c28-5b2d-4261-bfa2-47effaf35bb8",
                                                "sense_id": "5ac2180a-754a-3836-b359-d5fcc16727b2",
                                                "text": "„Bei abnormalen Regenfällen oder Schneeschmelzfluten brachten die zahlreichen Seitenflüsse so viel Schutt mit, daß viele Quadratkilometer Wiesen, Aecker und Gärten mehrere Meter hoch überführt wurden oder durch Stauung langgestreckte Talseen entstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217a5510-0edf-47cc-900a-195246c4cad5",
                        "source_entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "source_sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                        "source_sense_description": "ongewoon",
                        "target_lang_word": "unnormal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unnormal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfbbbaaa-7005-353f-9c93-486800a0c908",
                                        "entry_id": "b47bcae8-4321-32d6-bf5c-fe74777dc166",
                                        "glosses": [
                                            "nicht der Norm entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241b8b4c-3e40-4bc4-9fe8-719367776d5c",
                                                "sense_id": "bfbbbaaa-7005-353f-9c93-486800a0c908",
                                                "text": "Diese unnormale Kälte macht mir zu schaffen."
                                            },
                                            {
                                                "example_id": "4b8bd633-c6ed-475d-a057-1ff1dbdf043d",
                                                "sense_id": "bfbbbaaa-7005-353f-9c93-486800a0c908",
                                                "text": "Sie trinkt unnormal viel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d488441f-5de7-4c8c-851c-13477c05c1f8",
                        "source_entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "source_sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                        "source_sense_description": "ongewoon",
                        "target_lang_word": "abnormal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba1dd450-563d-3c5e-be1b-8711cd814fff",
                                        "entry_id": "3fa13c1e-01ef-3985-bb8c-e6549de23a23",
                                        "glosses": [
                                            "Not conforming to rule or system; deviating from the usual or normal type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c85f404-53f3-495d-a494-aa98dfa39b5e",
                                                "sense_id": "ba1dd450-563d-3c5e-be1b-8711cd814fff",
                                                "text": "And then after an abnormal meal, which was either a very late breakfast or a very early lunch, they drove on to Victoria Station."
                                            },
                                            {
                                                "example_id": "97601c56-99a0-4073-a353-b42a05c4d75d",
                                                "sense_id": "ba1dd450-563d-3c5e-be1b-8711cd814fff",
                                                "text": "Here perhaps one of you might interrupt me and say, 'But what is it that you do, Socrates? How is it that you have been misrepresented like this? Surely all this talk and gossip about you would never have arisen if you had confined yourself to ordinary activities, but only if your behaviour was abnormal. Give us the explanation, if you do not want us to draw our own conclusions.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1418b528-af39-3bdd-b6dd-45c579b388a1",
                                        "entry_id": "3fa13c1e-01ef-3985-bb8c-e6549de23a23",
                                        "glosses": [
                                            "Of or pertaining to that which is irregular, in particular, behaviour that deviates from norms of social propriety or accepted standards of mental health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e47f0c-f5b0-4e15-950a-551bfc936563",
                                                "sense_id": "1418b528-af39-3bdd-b6dd-45c579b388a1",
                                                "text": "Furuseth was right; I was abnormal, an \"emotionless monster,\" a strange bookish creature, capable of pleasuring in sensations only of the mind."
                                            },
                                            {
                                                "example_id": "6a49a86c-7a4e-4781-be57-f6bb7a6930b3",
                                                "sense_id": "1418b528-af39-3bdd-b6dd-45c579b388a1",
                                                "text": "Many of the so-called rites of these secret societies were so patently ridiculous, that it is quite obvious that they were merely an excuse for men and women to indulge in sex-play and lustful gratification, frequently of an abnormal kind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abnormal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0580d170-fda7-3d80-a185-28d5a104ac70",
                                        "entry_id": "a968b3f1-3d20-317f-b482-2717b0413464",
                                        "glosses": [
                                            "A person or object that is not normal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bd2f311-2ee9-42d1-9157-063e03a7d080",
                        "source_entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                        "source_sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                        "source_sense_description": "ongewoon",
                        "target_lang_word": "anormal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                        "entry_id": "a1240d0e-2ed7-3ce2-966f-263cf39a978e",
                                        "glosses": [
                                            "Qui est contraire aux règles qui paraissent régir son genre ou son espèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5eac26-585f-4f72-9cba-fe15c358e7a4",
                                                "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                                "text": "Les savants s’occupèrent de tout dans une paix profonde, depuis la végétation anormale d'un ognon de jacinthe jusqu'aux courants électriques."
                                            },
                                            {
                                                "example_id": "31a7c8fa-bf5e-4a2b-bc25-b47f785f9dc7",
                                                "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                                "text": "L'inconscience règne parmi les autorités municipales qui ont laissé faire en fermant les yeux. Et ceux qui ont construit ou ont acheté ensuite sans s'interroger n'y ont rien vu d' anormal non plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                        "entry_id": "a1240d0e-2ed7-3ce2-966f-263cf39a978e",
                                        "glosses": [
                                            "Qui dépasse la mesure commune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659656f6-80d6-4d69-ba0c-e9fd1772bce7",
                                                "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                                "text": "Il n’est quand même pas anormal que la cellule interne qui s’occupe des violences sexuelles s’autosaisisse, quand elle est en copie, d’une lettre de suicide."
                                            },
                                            {
                                                "example_id": "e1720026-8c3c-478e-ad6e-0ffd8476feeb",
                                                "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                                "text": "Ce n’est pas une simple question d’innovation technique, mais aussi une question de compréhension de l’organisation générale dans laquelle s’insère une telle définition d’un comportement anormal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                        "entry_id": "e39fe661-41e3-3723-92c4-aa606e8f8905",
                                        "glosses": [
                                            "Personne dont l’état ou le comportement n’est pas normal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528814da-f1a9-4fbf-9d6f-b986eec3825b",
                                                "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                                "text": "Un anormal."
                                            },
                                            {
                                                "example_id": "9f2d347d-a8d1-43c7-9511-bb6b84e78216",
                                                "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                                "text": "Il se peut qu’un directeur qui a un anormal dans son école s’abstienne de le signaler."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf965f5b-c2c4-36e6-83b5-babd4b69f04e",
                                        "entry_id": "a27cbf9e-9c04-3e85-8fab-22d42b06f238",
                                        "glosses": [
                                            "Ce qui est contraire à la norme, à la règle habituelle ou commune."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3409415-3baf-4ffc-a90a-abd1bad6dad6",
                                                "sense_id": "cf965f5b-c2c4-36e6-83b5-babd4b69f04e",
                                                "text": "L’habitude est devenue ici une seconde nature. L’anormal est considéré ici comme le normal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
