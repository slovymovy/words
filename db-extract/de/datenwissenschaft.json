                        "source_entry_id": "e6f8e06f-e395-3d9a-aa52-c6399f0f920b",
                        "source_sense_id": "b3a0d2d9-0627-3d2d-b965-0796340a9159",
                        "source_sense_description": "Forschungsfeld, das sich systematisch mit der Analyse von Daten befasst",
