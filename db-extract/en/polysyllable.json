                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e149e5b-688a-3943-8aa9-0270e84c5f2d",
                        "entry_id": "e4694389-fbb9-3ca5-aa22-fc373a52f881",
                        "glosses": [
                            "A word with more than two syllables. Sometimes used in a more restricted sense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443caca4-f102-40c4-aeae-b467927c2436",
                                "sense_id": "3e149e5b-688a-3943-8aa9-0270e84c5f2d",
                                "text": "For instance, words can differ in length, and we can rhyme a monosyllable with a polysyllable, like tracks with haversacks."
                            },
                            {
                                "example_id": "2b98abf2-d4fc-440e-8b73-dc21247b8fec",
                                "sense_id": "3e149e5b-688a-3943-8aa9-0270e84c5f2d",
                                "text": "In the Phyengan dialect, wuy developed into wi but at the end of a polysyllable it often dropped the -y to become wu (ibid): Tang-nakwu = Tang-nakwi 'donkey'"
                            },
                            {
                                "example_id": "3a8a4eba-8546-4424-a32c-92224648903a",
                                "sense_id": "3e149e5b-688a-3943-8aa9-0270e84c5f2d",
                                "text": "The third syllable of provided is ed, and therefore the verb is not a polysyllable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a54a8d98-714e-47b9-bc24-ac53021df34d",
                        "source_entry_id": "e4694389-fbb9-3ca5-aa22-fc373a52f881",
