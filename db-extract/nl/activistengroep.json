                    {
                        "sense_id": "ac067214-d9d5-350e-bf2b-c1635519f80e",
                        "entry_id": "004d0b25-484f-3095-ba17-7c67aedb8e40",
                        "glosses": [
                            "een groep mensen die actie voeren om een bepaald (idealistisch) doel te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29cb58df-98a1-48bf-889a-2c4ef1c3792c",
                                "sense_id": "ac067214-d9d5-350e-bf2b-c1635519f80e",
                                "text": "Het Syrisch Observatorium voor de Mensenrechten zegt dat er bij de aanval zeker vier doden zijn gevallen. De activistengroep, die gestationeerd is in Londen, zegt dat de vliegbasis bij Homs volledig verwoest is door de raketaanval. Vier militairen, onder wie een officier zouden zijn gedood."
                            },
                            {
                                "example_id": "8cb45db5-b4d5-4296-b5da-bdb9611ab60d",
                                "sense_id": "ac067214-d9d5-350e-bf2b-c1635519f80e",
                                "text": "Bij Human Rights Watch zijn er 36 meldingen van moord binnengekomen. In elf zaken is inmiddels bevestigd dat er een verband is met de protesten. Volgens een lokale activistengroep worden nog tientallen, oplopend tot enkele honderden, demonstranten vermist. Volgens de mensenrechtenautoriteit DPC is een groot deel van deze personen inmiddels weer terecht."
                            }
                        ]
                    }
