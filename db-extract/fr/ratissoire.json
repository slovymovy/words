                        ],
                        "examples": [
                            {
                                "example_id": "be05a6b0-d437-4827-bec9-eaf6b40d1484",
                                "sense_id": "3c61cade-5bd9-3519-8343-0a36cdf58a6d",
                                "text": "À côté des instruments propres au nettoyage des terres dont nous venons de parler, il convient de faire figurer les ratissoires, qui servent spécialement à débarrasser les allées des jardins des herbes qui y croissent, mais peuvent être employées aussi au travail superficiel, de terres. Les ratissoires ont de larges lames tranchantes."
                            }
                        ]
