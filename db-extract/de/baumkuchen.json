                        "source_sense_id": "57dbaaf4-2aa8-30e8-8780-fe39ed351e96",
                        "source_sense_description": "Gebäck aus einem dünnflüssigen Teig in Schichten gebacken",
                        "target_lang_word": "gâteau à la broche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gâteau à la broche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b53166e-2a60-357c-9bf7-eaea82afb84e",
                                        "entry_id": "54f57389-bed3-31bb-a577-4aab1f5b7a9f",
                                        "glosses": [
                                            "Gâteau cuit usuellement au feu de cheminée, en versant progressivement une pâte liquide sur une broche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3eb010-6d9c-4182-b45f-2c62bf17ee70",
                                                "sense_id": "2b53166e-2a60-357c-9bf7-eaea82afb84e",
                                                "text": "Elle sursauta, voulut pivoter dans sa direction, et son coude heurta la fragile pyramide de gâteaux à la broche qui s’effondra dans un bruit sourd."
                                            },
                                            {
                                                "example_id": "a4c20882-07ac-4704-a1ac-54aa200ab887",
                                                "sense_id": "2b53166e-2a60-357c-9bf7-eaea82afb84e",
                                                "text": "Te sachant gourmande, le gâteau basque à la crème et à la cerise, ainsi que le gâteau à la broche, font partie des spécialités régionales."
                                            },
                                            {
                                                "example_id": "aa428401-2ac0-429a-9131-76947b59ec91",
                                                "sense_id": "2b53166e-2a60-357c-9bf7-eaea82afb84e",
                                                "text": "La maîtresse de maison, aidée de ses filles, avait fait le pain, des fougasses aux grattons et aux olives, pâtés truffés en terrine, fouaces, gâteaux à la broche et tartes aux pommes."
                                            }
                                        ]
                                    }
                                ]
                            }
