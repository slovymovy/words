        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1cc0bd6b-e7bc-3305-94e4-c0d98408088f",
                "word": "Aba",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "736e8356-7147-3ceb-9724-20504e7665da",
                        "entry_id": "1cc0bd6b-e7bc-3305-94e4-c0d98408088f",
                        "glosses": [
                            "Synonym of Ngawa: the Mandarin Chinese-derived name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bbb75d1-95da-4deb-b16e-4d6f32633be9",
                                "sense_id": "736e8356-7147-3ceb-9724-20504e7665da",
                                "text": "The main Tibetan areas in Sichuan are now designated as Aba (Ngawa) Tibetan Autonomous Prefecture, Garzê Tibetan Autonomous Prefecture and Muli Tibetan Autonomous County."
                            },
                            {
                                "example_id": "721425d1-5261-42ef-a811-a55101f6f91c",
                                "sense_id": "736e8356-7147-3ceb-9724-20504e7665da",
                                "text": "The notice, issued by provincial public security authorities, said foreigners were prohibited from entering the Tibetan populated prefecture of Ganzi and several counties in neighboring Aba prefecture."
                            },
                            {
                                "example_id": "86c3cd3e-8949-4cf3-8ef6-4d90153cc174",
                                "sense_id": "736e8356-7147-3ceb-9724-20504e7665da",
                                "text": "Last week, two Tibetan teenagers set themselves on fire in a double self-immolation in Aba prefecture, Tibet rights advocacy groups said. Seventeen-year-old Richen and his childhood friend Sonam Dargye, 18, were among the youngest to have died in the fiery protests."
                            }
                        ]
                    }
                ],
