            "senses": [
                {
                    "sense_id": "8e91eced-3bf5-3369-8253-fb1b8ca86f48",
                    "sense_definition": "Couper les poils ou les cheveux au ras de la peau avec un rasoir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "coupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, il utilise une mousse douce pour <w>raser</w> sa barbe avant de partir au travail."
                        },
                        {
                            "text": "Le coiffeur a proposé de lui <w>raser</w> la tête pour changer complètement son style."
                        }
                    ],
                    "common_phrases": [
                        "se raser de près",
                        "raser la barbe"
                    ]
                },
                {
                    "sense_id": "60969252-13e9-3813-b16b-055549737df4",
                    "sense_definition": "Démolir complètement une construction ou un bâtiment jusqu'au sol.",
