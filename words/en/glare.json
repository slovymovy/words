{
    "word_family": [
        "glaringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a986a06-bbac-3bd3-bc74-12e45ae170f1",
                    "sense_definition": "An intense, blinding light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glare</w> of the sun on the snow made it hard to see.",
                            "target_lang_translations": {
                                "tr": "Kardaki güneşin <w>göz kamaştırıcı ışığı</w> görmeyi zorlaştırdı.",
                                "nl": "De <w>schittering</w> van de zon op de sneeuw maakte het moeilijk om te zien.",
                                "de": "Das <w>grelle Blenden</w> der Sonne auf dem Schnee erschwerte die Sicht.",
                                "it": "Il <w>riverbero</w> del sole sulla neve rendeva difficile vedere."
                            }
                        },
                        {
                            "text": "Drivers often wear sunglasses to reduce the <w>glare</w> from the road.",
                            "target_lang_translations": {
                                "tr": "Sürücüler yoldan gelen <w>parıltıyı</w> azaltmak için genellikle güneş gözlüğü takarlar.",
                                "nl": "Bestuurders dragen vaak een zonnebril om de <w>schittering</w> van de weg te verminderen.",
                                "de": "Autofahrer tragen oft Sonnenbrillen, um die <w>Blendung</w> durch die Straße zu verringern.",
                                "it": "Gli automobilisti portano spesso occhiali da sole per ridurre il <w>bagliore</w> della strada."
                            }
                        }
                    ],
                    "synonyms": [
                        "dazzle"
                    ],
                    "common_phrases": [
                        "sun glare"
                    ],
                    "target_lang_definitions": {
                        "tr": "Göz kamaştırıcı, parlak ışık.",
                        "nl": "Een intens, verblindend licht.",
                        "de": "Ein intensives, blendendes Licht.",
                        "it": "Una luce intensa e accecante."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "göz kamaştırıcı ışık",
                                "target_lang_sense_clarification": "Yoğun ve rahatsız edici parlaklık."
                            },
                            {
                                "target_lang_word": "parıltı",
                                "target_lang_sense_clarification": "Yansımadan kaynaklanan yoğun ışık."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schittering",
                                "target_lang_sense_clarification": "Fel, vaak hinderlijk licht dat weerkaatst."
                            },
                            {
                                "target_lang_word": "verblinding",
                                "target_lang_sense_clarification": "Het effect van te fel licht waardoor men tijdelijk slecht ziet."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Blendung",
                                "target_lang_sense_clarification": "Störendes, grelles Licht, das die Sicht beeinträchtigt"
                            },
                            {
                                "target_lang_word": "grelles Licht",
                                "target_lang_sense_clarification": "Sehr helle, stechende Beleuchtung"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "bagliore",
                                "target_lang_sense_clarification": "Luce intensa e viva che colpisce la vista"
                            },
                            {
                                "target_lang_word": "riverbero",
                                "target_lang_sense_clarification": "Riflesso di luce intensa e fastidiosa da una superficie"
                            },
                            {
                                "target_lang_word": "abbagliamento",
                                "target_lang_sense_clarification": "Effetto della luce accecante che impedisce di vedere chiaramente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c0ee28-29fa-376b-9176-9a1394b90f8a",
                    "sense_definition": "An angry or fierce stare.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her an angry <w>glare</w> before walking out of the room.",
                            "target_lang_translations": {
                                "tr": "Odadan çıkmadan önce ona <w>ters bir bakış</w> attı.",
                                "nl": "Hij wierp haar een <w>boze blik</w> toe voordat hij de kamer uitliep.",
                                "de": "Er warf ihr einen wütenden <w>Blick</w> zu, bevor er den Raum verließ.",
                                "it": "Le lanciò un'<w>occhiataccia</w> prima di uscire dalla stanza."
                            }
                        },
                        {
                            "text": "She ignored his cold <w>glare</w> and continued with her work.",
                            "target_lang_translations": {
                                "tr": "Onun soğuk <w>bakışlarını</w> görmezden geldi ve işine devam etti.",
                                "nl": "Ze negeerde zijn kille <w>blik</w> en ging door met haar werk.",
                                "de": "Sie ignorierte seinen kalten <w>Blick</w> und setzte ihre Arbeit fort.",
                                "it": "Lei ignorò il suo freddo <w>sguardo truce</w> e continuò il suo lavoro."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl"
                    ],
                    "target_lang_definitions": {
                        "tr": "Öfkeli veya sert bir bakış.",
                        "nl": "Een boze of woeste blik.",
                        "de": "Ein wütender oder feindseliger Blick.",
                        "it": "Uno sguardo carico di rabbia o feroce."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ters bakış",
                                "target_lang_sense_clarification": "Hoşnutsuzluğu ifade eden sert bakış."
                            },
                            {
                                "target_lang_word": "sert bakış",
                                "target_lang_sense_clarification": "Öfke dolu, delici bakış."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "boze blik",
                                "target_lang_sense_clarification": "Een blik die woede of ongenoegen uitdrukt."
                            },
                            {
                                "target_lang_word": "starende blik",
                                "target_lang_sense_clarification": "Een indringende, vaak vijandige manier van kijken."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "böser Blick",
                                "target_lang_sense_clarification": "Finsterer, zorniger Blick"
                            },
                            {
                                "target_lang_word": "zorniger Blick",
                                "target_lang_sense_clarification": "Ein Blick, der Wut ausdrückt"
                            },
                            {
                                "target_lang_word": "entrüstetes Starren",
                                "target_lang_sense_clarification": "Empörtes, fixes Anschauen"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "sguardo truce",
                                "target_lang_sense_clarification": "Sguardo minaccioso, cupo o aggressivo"
                            },
                            {
                                "target_lang_word": "sguardo feroce",
                                "target_lang_sense_clarification": "Sguardo carico di collera o durezza"
                            },
                            {
                                "target_lang_word": "occhiataccia",
                                "target_lang_sense_clarification": "Uno sguardo severo, risentito o ostile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8272b703-a7fc-3ba8-9ce4-74e1c8106391",
                    "sense_definition": "A smooth, bright, glassy surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lake was a <w>glare</w> of ice in the winter morning.",
                            "target_lang_translations": {
                                "tr": "Göl, kış sabahında <w>buz tutmuş parlak bir yüzeydi</w>.",
                                "nl": "Het meer was een <w>glanzende ijsvlakte</w> in de winterochtend.",
                                "de": "Der See war am Wintermorgen eine <w>spiegelglatte Eisfläche</w>.",
                                "it": "Il lago era una <w>lastra</w> di ghiaccio brillante nel mattino d'inverno."
                            }
                        },
                        {
                            "text": "Walking across the <w>glare</w> of ice requires great caution.",
                            "target_lang_translations": {
                                "tr": "<w>Buzlu yüzeyde</w> yürümek büyük dikkat gerektirir.",
                                "nl": "Over de <w>gladde ijsvlakte</w> lopen vereist grote voorzichtigheid.",
                                "de": "Über die <w>spiegelglatte Eisfläche</w> zu gehen erfordert große Vorsicht.",
                                "it": "Camminare su quella <w>lastra</w> di ghiaccio richiede molta cautela."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glare of ice"
                    ],
                    "target_lang_definitions": {
                        "tr": "Pürüzsüz, parlak ve buzlu yüzey.",
                        "nl": "Een glad, helder, glasachtig oppervlak.",
                        "de": "Eine glatte, helle und spiegelnde Eisfläche.",
                        "it": "Una superficie liscia, brillante e simile al vetro, specialmente di ghiaccio."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buz tabakası",
                                "target_lang_sense_clarification": "Donmuş, parlak ve kaygan yüzey."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ijsvlakte",
                                "target_lang_sense_clarification": "Een glad en glanzend bevroren oppervlak."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spiegelglatte Eisfläche",
                                "target_lang_sense_clarification": "Glatte, glänzende Schicht aus Eis"
                            },
                            {
                                "target_lang_word": "Spiegeleis",
                                "target_lang_sense_clarification": "Völlig glattes, glänzendes Eis"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "lastra di ghiaccio",
                                "target_lang_sense_clarification": "Superficie ghiacciata liscia e scivolosa"
                            },
                            {
                                "target_lang_word": "superficie a specchio",
                                "target_lang_sense_clarification": "Distesa estremamente liscia e lucida"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ee2a842-f30a-38b4-bfd9-caea3030a0e5",
                    "sense_definition": "To stare angrily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher began to <w>glare</w> at the students who were talking.",
                            "target_lang_translations": {
                                "tr": "Öğretmen konuşan öğrencilere <w>ters ters bakmaya</w> başladı.",
                                "nl": "De leraar begon de leerlingen die aan het praten waren <w>boos aan te kijken</w>.",
                                "de": "Der Lehrer begann, die schwatzenden Schüler <w>wütend anzustarren</w>.",
                                "it": "L'insegnante cominciò a <w>guardare storto</w> gli studenti che stavano parlando."
                            }
                        },
                        {
                            "text": "He continued to <w>glare</w> at his opponent throughout the entire match.",
                            "target_lang_translations": {
                                "tr": "Maç boyunca rakibine <w>dik dik bakmaya</w> devam etti.",
                                "nl": "Hij bleef zijn tegenstander de hele wedstrijd lang <w>boos aankijken</w>.",
                                "de": "Er fuhr während des gesamten Spiels fort, seinen Gegner <w>finster anzublicken</w>.",
                                "it": "Continuò a <w>fulminare con lo sguardo</w> il suo avversario per tutta la durata della partita."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl"
                    ],
                    "target_lang_definitions": {
                        "tr": "Öfkeyle bakmak.",
                        "nl": "Boos of vijandig staren.",
                        "de": "Jemanden wütend oder finster anstarren.",
                        "it": "Fissare qualcuno con sguardo irato o minaccioso."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ters ters bakmak",
                                "target_lang_sense_clarification": "Birine öfkeyle veya düşmanca bakmak."
                            },
                            {
                                "target_lang_word": "dik dik bakmak",
                                "target_lang_sense_clarification": "Sert ve rahatsız edici bir şekilde bakmak."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "boos aankijken",
                                "target_lang_sense_clarification": "Iemand met een woedende blik fixeren."
                            },
                            {
                                "target_lang_word": "staren",
                                "target_lang_sense_clarification": "Indringend en langdurig kijken, vaak met een negatieve lading."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wütend anstarren",
                                "target_lang_sense_clarification": "Jemanden mit zornigem Blick fixieren"
                            },
                            {
                                "target_lang_word": "finster anblicken",
                                "target_lang_sense_clarification": "Jemandem einen bösen Blick zuwerfen"
                            },
                            {
                                "target_lang_word": "missbilligend anstarren",
                                "target_lang_sense_clarification": "Ablehnend oder vorwurfsvoll fixieren"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "guardare con aria truce",
                                "target_lang_sense_clarification": "Fissare qualcuno con rabbia o ostilità"
                            },
                            {
                                "target_lang_word": "fulminare con lo sguardo",
                                "target_lang_sense_clarification": "Fissare intensamente con collera"
                            },
                            {
                                "target_lang_word": "guardare storto",
                                "target_lang_sense_clarification": "Lanciare un'occhiata ostile o carica di risentimento"
                            }
                        ]
                    }
