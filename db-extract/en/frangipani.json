                    },
                    {
                        "form_id": "fb63a43f-fbb0-4601-8c33-9605d06aa61e",
                        "entry_id": "f34105fc-ff31-34c3-b47c-76633d1efd91",
                        "tags": [
                            "plural"
                        ],
                        "form": "frangipani"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc298df7-2f8b-3a4a-9fe3-f4c385c9e6d8",
                        "entry_id": "f34105fc-ff31-34c3-b47c-76633d1efd91",
                        "glosses": [
                            "Any of several tropical American shrubs and trees of the genus Plumeria, having fragrant, showy, funnel-shaped flowers of a wide range of colours from creamy to red."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bab5c048-d84b-3f9d-90b2-0191e53c20cb",
                        "entry_id": "f34105fc-ff31-34c3-b47c-76633d1efd91",
                        "glosses": [
                            "A flower of these plants."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4135cac0-4c71-40f8-a508-82afb3df2f60",
                                "sense_id": "bab5c048-d84b-3f9d-90b2-0191e53c20cb",
                                "text": "The aroma given off by flowers has an aphrodisiac effect, especially on women. This is so particularly in the case of lilies of the valley, gardenia, frangipani, and henna."
                            },
                            {
                                "example_id": "ce896f48-ec73-4e73-a980-17781c1ad71d",
                                "sense_id": "bab5c048-d84b-3f9d-90b2-0191e53c20cb",
                                "text": "I casually let this information drop as our concierge drives us through the resort in a buggy, a frangipani flower tucked behind his ear. He promises to fix the bug problem and drops us off at the lobby."
                            }
                        ]
                    },
                    {
                        "sense_id": "297c6d55-ff4d-316b-94b2-5302e3bf8167",
                        "entry_id": "f34105fc-ff31-34c3-b47c-76633d1efd91",
                        "glosses": [
                            "A perfume obtained from this plant or imitating the odour of its flowers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8a98fd10-2818-3cc8-b8fd-939c76595eb2",
                        "entry_id": "f34105fc-ff31-34c3-b47c-76633d1efd91",
                        "glosses": [
                            "Alternative form of frangipane (“cream made from ground almonds; pastry filled with this cream”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc55e7f-87c0-4eb5-ab6d-5541f32af80f",
                                "sense_id": "8a98fd10-2818-3cc8-b8fd-939c76595eb2",
                                "text": "Lahlou baked a cardamom frangipani and cut it into pieces as a base for roasted chicken. (Well, I used chicken; he used squab. Use whatever bird you fancy.) Then he topped the frangipani and poultry with kale and leaf-thin sugar-and-cardamom-sprinkled phyllo rectangles — made by baking them between baking sheets — like a savory mille-feuille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42913a86-106c-4bb8-956c-30dddcdffd2b",
                        "source_entry_id": "f34105fc-ff31-34c3-b47c-76633d1efd91",
                        "source_sense_description": "any of several tropical American shrubs and trees of the genus Plumeria",
                        "target_lang_word": "frangipanier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frangipanier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66d40e48-8309-34fa-bd81-ca572e3db7ad",
                                        "entry_id": "11f5e1dc-a0d6-3af1-aa76-bf3448bb099a",
                                        "glosses": [
                                            "Genre d’arbres et arbrisseaux originaires d’Amérique centrale et des Caraïbes au bois flexible et dont les fleurs, de couleurs, rouge, jaune ou rose selon les espèces, groupées en cymes terminales, exhalent un parfum rappelant celui de l’amande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5d2ca1-37f7-4808-968e-bf46b1f5d4e2",
                                                "sense_id": "66d40e48-8309-34fa-bd81-ca572e3db7ad",
                                                "text": "Les frangipaniers sont aujourd’hui répandus dans toute les régions tropicales. Dans certaines régions du monde, le frangipanier a la réputation d’être immortel. À Hawaï on confectionne avec ses fleurs des couronnes de bienvenue."
                                            },
                                            {
                                                "example_id": "05a8c938-7f74-4806-b346-f8885d794c84",
                                                "sense_id": "66d40e48-8309-34fa-bd81-ca572e3db7ad",
                                                "text": "Je ne sais pas pourquoi, mais j’avais imaginé une maison assez luxueuse, comme on en voit parfois à Bali, avec des bassins couverts de fleurs de lotus, sous l’ombre bienveillante des frangipaniers exhibant de grosses fleurs blanches au parfum tellement enivrant que c’en est presque impudique."
                                            },
                                            {
                                                "example_id": "0048ca82-9e0c-45f6-bb31-29f6c2dec314",
                                                "sense_id": "66d40e48-8309-34fa-bd81-ca572e3db7ad",
                                                "text": "Les après-midi d’ennui finissent enfin par expirer à petits pas fuyants et c’est dans cet intervalle, dans ces instants épuisés, que je retrouvait Gino devant son garage, sous le frangipanier odorant, et qu’on s’allongeait tous les deux sur la natte du zamu, le veilleur de nuit. — (Gaël Faye, Petit Pays, Grasset, 2016, page 83)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
