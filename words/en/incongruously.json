    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ba14132b-1961-3338-a482-803a5c2b9007",
                    "sense_definition": "In a way that is out of place, inappropriate, or not fitting with its surroundings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tiny wooden cottage sat <w>incongruously</w> among the towering steel skyscrapers.",
                            "target_lang_translations": {
                                "nl": "Een piepklein houten huisje stond <w>misplaatst</w> tussen de torenhoge stalen wolkenkrabbers.",
                                "zh": "一座小木屋<w>格格不入地</w>坐落在一座座高耸的钢铁摩天大楼之中。"
                            }
                        },
                        {
                            "text": "Jolly holiday music played <w>incongruously</w> in the background while they discussed serious financial problems.",
                            "target_lang_translations": {
                                "nl": "Vrolijke feestmuziek speelde <w>op een vreemde manier</w> op de achtergrond terwijl ze ernstige financiële problemen bespraken.",
                                "zh": "当他们讨论严肃的财务问题时，背景音乐却<w>不协调地</w>放着欢快的节日歌曲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inappropriately"
                    ],
                    "antonyms": [
                        "congruously",
                        "fittingly"
                    ],
                    "common_phrases": [
                        "sit incongruously",
                        "look incongruously"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een manier die misplaatst, ongepast is of niet past bij de omgeving.",
                        "zh": "不协调地；格格不入地；与周围环境不相称地"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "misplaatst",
