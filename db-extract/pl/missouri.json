                                    {
                                        "sense_id": "26c89a41-ba5c-3c51-8855-8c25e177dfc7",
                                        "entry_id": "781f3166-b40d-3c11-baf6-ac09832f5c1e",
                                        "glosses": [
                                            "mit 4.130 Kilometer der längste Fluss der USA, der nördlich von St. Louis an der Grenze zu Illinois in den Mississippi mündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8bfc41-bfad-4bfc-9ade-f9d385fb6132",
                                                "sense_id": "26c89a41-ba5c-3c51-8855-8c25e177dfc7",
                                                "text": "In dem kleinen, am Missouri gelegenen Ort Council Grove im Bundesstaat Kansas fällte der Tornado die mächtige Eiche neben dem Highway 56, unter deren Blätterdach einmal ein historischer Akt besiegelt worden war."
                                            },
                                            {
                                                "example_id": "837d8f52-3149-4a74-9aae-898586e2bb8a",
                                                "sense_id": "26c89a41-ba5c-3c51-8855-8c25e177dfc7",
                                                "text": "Im Jahr 1821, als der Missouri noch die Westgrenze Amerikas markierte, brach in der am Fluß gelegenen Siedlung Old Franklin ein Mann namens William Becknell mit einer kleinen Mauleselkarawane in Richtung des heutigen Neumexiko auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
