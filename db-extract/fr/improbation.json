            {
                "entry_id": "5769d75b-cb91-32e1-b0cb-aabc3859b9b8",
                "word": "improbation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2d584b13-8ea4-44d1-bb9b-9624fc415860",
                        "entry_id": "5769d75b-cb91-32e1-b0cb-aabc3859b9b8",
                        "tags": [
