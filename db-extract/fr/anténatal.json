                "senses": [
                    {
                        "sense_id": "ee357967-27c6-37e8-93cf-e7287f3b3abc",
                        "entry_id": "4ee16b45-ee94-3137-9c99-4a32c16c9a8a",
                        "glosses": [
                            "Qui concerne la période de la vie entre la conception et la naissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9897d0da-e7d6-4112-83a8-36b88f686add",
                                "sense_id": "ee357967-27c6-37e8-93cf-e7287f3b3abc",
                                "text": "Les corticostéroïdes anténatals sont prescrits pour accélérer la maturation fœtale chez les femmes présentant un risque de prématurité."
                            },
                            {
                                "example_id": "e0b94f8b-2198-4bbd-9dd0-74b7b32f1e7d",
                                "sense_id": "ee357967-27c6-37e8-93cf-e7287f3b3abc",
                                "text": "Dès lors, l’anténatal ne se réduit plus à l’anamnèse ou à la préhistoire de l’aventure humaine, mais projette au premier plan le chapitre initial de la vie qu’est la période intra-utérine."
                            }
                        ]
                    }
                ],
