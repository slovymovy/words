                        "examples": [
                            {
                                "example_id": "bf82c9ad-e1a6-427f-b6f9-483e430a11a2",
                                "sense_id": "be26c6bd-9d30-37cf-b6a2-f4aa36630fa6",
                                "text": "„Das Haus, in dem die Frauen wohnen, hat einen Türklopfer aus Kupfer und eine Katzenklappe, die mit breitem Paketband zugeklebt ist.“"
                            },
                            {
                                "example_id": "651c3e55-f787-4e41-80fe-a817e7948997",
                                "sense_id": "be26c6bd-9d30-37cf-b6a2-f4aa36630fa6",
                                "text": "„Deswegen wickle ich so lange Paketband darum, bis die Rolle zur Neige geht.“"
                            }
                        ],
