                                        "entry_id": "bbbc8ef3-6146-3fb2-b94a-c3fe207e45f9",
                                        "glosses": [
                                            "Anti-inflammatoire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca39b4f7-72f9-4a82-b5d9-67dcd9903a11",
                                                "sense_id": "a2897fda-0384-3b2f-8f1d-2b3ac0c3aa1e",
                                                "text": "Traitement antiphlogistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c9a730-1379-38b6-be37-87e0e80fb81f",
                                        "entry_id": "bbbc8ef3-6146-3fb2-b94a-c3fe207e45f9",
                                        "glosses": [
                                            "Qui s’oppose au phlogistique, c’est-à-dire qui prend en compte le rôle de l’oxygène dans les réactions de combustion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e646608c-3e74-4c56-bcd8-ace318bc11b3",
                                                "sense_id": "24c9a730-1379-38b6-be37-87e0e80fb81f",
                                                "text": "L’intervention de l’oxygène dans les réactions constituera l’essentiel de la théorie antiphlogistique, ou théorie de l’oxydation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiphlogistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9818a301-a0b6-3583-9e4c-48273cd55444",
                                        "entry_id": "df50f814-4e2c-3b31-866c-ef98226f4604",
                                        "glosses": [
                                            "Anti-inflammatoire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad06605-8d54-44e8-9c6c-9d8d62f84888",
                                                "sense_id": "9818a301-a0b6-3583-9e4c-48273cd55444",
                                                "text": "Une femme de dix-sept ans, non réglée, d’un tempérament nerveux, affectée d’une mélancolie à la suite de souffrances morales, avait été soumise sans succès, pendant plus de deux mois, aux purgatifs, aux antiphlogistiques et aux nervins."
                                            },
                                            {
                                                "example_id": "4ef0364a-870c-4734-b991-3d6e72e72403",
                                                "sense_id": "9818a301-a0b6-3583-9e4c-48273cd55444",
                                                "text": "Or, quels topiques, quels antiphlogistiques employer ? Par quels moyens détourner cette inflammation ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
