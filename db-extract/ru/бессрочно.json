                                        ]
                                    },
                                    {
                                        "sense_id": "55226941-50d6-377d-b180-09671ab27f73",
                                        "entry_id": "30d237f3-2246-3172-a464-a703443e1b3d",
                                        "glosses": [
                                            "For a long time, with no defined end."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef390a11-974e-4d53-a5e2-11fb91b1ef89",
                                                "sense_id": "55226941-50d6-377d-b180-09671ab27f73",
                                                "text": "It was a dark, horsehairy place with a sort of abandon-hope atmosphere that seemed suitable for people that had no money, and who were going indefinitely into pawn."
                                            },
                                            {
                                                "example_id": "1f77c4a5-70ae-4b4a-8e94-06514f8c1d9f",
                                                "sense_id": "55226941-50d6-377d-b180-09671ab27f73",
                                                "text": "One argument is that \"the virus has changed everything\" and that people will work from home and travel much less, easing capacity pressures.\nBut there is a counter argument whereby we may all discover that, longer-term, many jobs cannot after all be effectively carried out from home indefinitely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d896d24a-6da4-3549-8a12-6a4e14169d04",
                                        "entry_id": "30d237f3-2246-3172-a464-a703443e1b3d",
                                        "glosses": [
                                            "Forever."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa5dda9a-1731-48c6-9b8b-77d53a02387b",
                        "source_entry_id": "9db81916-810c-3f2e-a967-cb7af3b48d2d",
                        "source_sense_id": "b70d7148-a68a-3eb8-a5a9-84c445b82605",
                        "target_lang_word": "perpetually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perpetually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b19630e-9e1c-3a33-a463-03765ad48160",
                                        "entry_id": "057536ab-836a-3b32-b1b6-2e2aff212cf1",
                                        "glosses": [
                                            "Seeming to never end; endlessly; constantly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3872651e-a87a-4dc9-bad8-900e828379e7",
                                                "sense_id": "5b19630e-9e1c-3a33-a463-03765ad48160",
                                                "text": "For whiche offence oure holy fader the pope enioyned hym to make hym to be prayed for perpetually / ⁊ lyke as he had done too be taken frome hym his naturall lyfe therfore he ſholde do foũde four tapers to brẽne perpetually about his body yͭ for yͤ extynccõn of his bodely lyf his ſoule may euer be remẽbred ⁊ lyf in heuẽ in ſpyrytuall lyfe"
                                            },
                                            {
                                                "example_id": "c1d1670a-d5e1-43bd-a28b-b5f791c94540",
                                                "sense_id": "5b19630e-9e1c-3a33-a463-03765ad48160",
                                                "text": "Now her work dropped on her knee, and her book fell from her hand; she was perpetually seeking excuses for change of place; and the change brought added discomfort."
                                            },
                                            {
                                                "example_id": "11abf70b-de1d-4480-b982-35b1699f1534",
                                                "sense_id": "5b19630e-9e1c-3a33-a463-03765ad48160",
                                                "text": "But, like more than one similar North Wales beauty-spot, there had to be (at least at the time of which I write), a quarry, or ironworks, or some kind of industrial plant, which lay perpetually under a cloud of yellowish smoke—literally a blot on the landscape."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
