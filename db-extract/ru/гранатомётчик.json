                "senses": [
                    {
                        "sense_id": "e440bd0d-926a-3ab7-ad29-52e988311a3f",
                        "entry_id": "2b0d3a7c-4743-3603-a46e-8485d0013051",
                        "glosses": [
                            "воен. стрелок из гранатомёта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e2ed4e8-9e81-4eed-bbcd-7a0322d47499",
                                "sense_id": "e440bd0d-926a-3ab7-ad29-52e988311a3f",
                                "text": "После второго выстрела гранатомётчик решил сменить позицию, по всем правилам действовал ― выстрел, два, и меняй позицию."
                            },
                            {
                                "example_id": "420c805c-cc86-493d-9304-94124ab69b1d",
                                "sense_id": "e440bd0d-926a-3ab7-ad29-52e988311a3f",
                                "text": "Несколько гранатомётчиков с базуками на плече расположились за стеной полуразрушенного здания."
                            }
                        ]
                    }
