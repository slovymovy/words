                "senses": [
                    {
                        "sense_id": "d09d57a6-5cbc-3464-8fc1-1935260bfecd",
                        "entry_id": "ba08be52-d2bb-32e4-94d3-7908a5fed129",
                        "glosses": [
                            "ökologischer, umweltfreundlicher Anbau von Lebensmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c421de-a336-46fc-9e36-da3c34fc1071",
                                "sense_id": "d09d57a6-5cbc-3464-8fc1-1935260bfecd",
                                "text": "„Wer Erdäpfel aus Bioanbau kauft und grüne Stellen mit dem Zellgift Solanin großzügig wegschneidet, nutzt eine wertvolle Siliziumquelle.“"
                            },
                            {
                                "example_id": "fbc974f7-c740-42fb-8611-00541dbfc9d2",
                                "sense_id": "d09d57a6-5cbc-3464-8fc1-1935260bfecd",
                                "text": "„Achten Sie auf die Qualität Ihrer Lebensmittel und bevorzugen Sie Bioanbau.“"
                            },
                            {
                                "example_id": "ad7e5cd1-9600-484d-a210-86a75882cbbf",
                                "sense_id": "d09d57a6-5cbc-3464-8fc1-1935260bfecd",
                                "text": "„Im angeschlossenen Laden werden Kräuter, Liköre, Honig und Salze aus Bioanbau verkauft.“"
                            },
                            {
                                "example_id": "58553e0b-3035-48cb-b2b9-62b22d04e613",
                                "sense_id": "d09d57a6-5cbc-3464-8fc1-1935260bfecd",
                                "text": "„Der ungarische Boden war gut, aber für den Bioanbau musste eine Fruchtfolge ausgedacht werden, die den Boden verbessert.“"
                            },
                            {
                                "example_id": "fdddcf18-c3db-420f-8d06-26deddff1b89",
                                "sense_id": "d09d57a6-5cbc-3464-8fc1-1935260bfecd",
                                "text": "„Der wichtigste Phosphordünger im Bioanbau ist weicherdiges Rohphosphat mit rund 25 % Phosphat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
