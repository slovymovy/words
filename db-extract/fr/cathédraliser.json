                "senses": [
                    {
                        "sense_id": "14cc84b0-7c5d-3912-a97c-3df8dfdf266f",
                        "entry_id": "8c7faa6d-b618-35ae-b6a2-54a90f7a7ab3",
                        "glosses": [
                            "Donner un caractère de cathédrale à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c32124eb-8f05-4ac4-bb13-98025f6bbb09",
                                "sense_id": "14cc84b0-7c5d-3912-a97c-3df8dfdf266f",
                                "text": "Au magazine Les Inrockuptibles, il explique avoir voulu \"monumentaliser\" ou \"cathédraliser\" ces \"lieux qui le méritent\"."
                            },
                            {
                                "example_id": "d2515dbd-a530-46c4-bcda-1a5ffd8fa23a",
                                "sense_id": "14cc84b0-7c5d-3912-a97c-3df8dfdf266f",
                                "text": "Comme je disais tout à l'heure, dans un autre forum, comme si l'on voulait cathédraliser un bazar."
                            }
                        ]
                    },
                    {
                        "sense_id": "44915dbb-22dd-376f-9fc4-9532b206212f",
                        "entry_id": "8c7faa6d-b618-35ae-b6a2-54a90f7a7ab3",
                        "glosses": [
                            "Visiter des cathédrales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a78f84-5073-42af-be91-f2bb6b7256be",
                                "sense_id": "44915dbb-22dd-376f-9fc4-9532b206212f",
                                "text": "Nous allons donc pouvoir cathédraliser à notre aise, attraper des torticolis devant des portails du treizième siècle, tout grouillants de statues, ou nous laisser éblouir par des verrières éclatantes, illustrées d'archanges et de rois."
                            }
                        ]
                    }
                ],
