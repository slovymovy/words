                "word": "kno-arts",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ac2b26db-1dd7-4fdf-a694-526f1dcb05a1",
                        "entry_id": "08c8474b-ca26-35f9-9fa4-63c6817f27f4",
                        "tags": [
                            "plural"
