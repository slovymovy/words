                        "entry_id": "eb1d38f5-4543-3731-9620-2eb877e8bb19",
                        "glosses": [
                            "A language primarily spoken in the Yazd and Kerman areas of Iran."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dab1df12-08bc-43f8-bf67-6cdd1842f8e4",
                        "source_entry_id": "eb1d38f5-4543-3731-9620-2eb877e8bb19",
