                                                "sense_id": "24ba4bc4-f7c5-36fd-8e84-426e11de5e50",
                                                "text": "Nach dem Essen stellen wir unser schmutziges Geschirr in die Geschirrspülmaschine."
                                            },
                                            {
                                                "example_id": "fc51c7e7-fa38-4391-b886-e260edcf1c2e",
                                                "sense_id": "24ba4bc4-f7c5-36fd-8e84-426e11de5e50",
                                                "text": "Ich habe mir eine neue Geschirrspülmaschine gekauft!"
                                            },
                                            {
                                                "example_id": "458812c2-27ac-4142-b41c-abd4d5dd0481",
                                                "sense_id": "24ba4bc4-f7c5-36fd-8e84-426e11de5e50",
                                                "text": "Gegenstände aus Holz oder Aluminium soll man nicht in die Geschirrspülmaschine tun."
                                            }
