                        "glosses": [
                            "Variante orthographique de déstaliniser (faire perdre son caractère stalinien à)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b27d84-7abf-4fa5-91a6-620340cfd5bc",
                                "sense_id": "48628744-9333-37a7-bab8-9c48dc6cceb4",
                                "text": "Je me suis progressivement dé-napoléonisé et dé-stalinisé."
                            },
                            {
                                "example_id": "e2a449ca-2b34-46a5-a7b1-088a7c2b1fda",
                                "sense_id": "48628744-9333-37a7-bab8-9c48dc6cceb4",
                                "text": "Il faut dé-gaullifier la France comme d'autres ont dé-stalinisé leur patrie."
                            },
                            {
                                "example_id": "f9524af7-d8ec-4ee2-a2fd-6e24652aa33a",
                                "sense_id": "48628744-9333-37a7-bab8-9c48dc6cceb4",
                                "text": "C'est peut-être aussi une lutte interne à la CGT : la base des cheminots a du mal à accepter le virage de la centrale de Montreuil, et ce d'autant plus que l'homme élu à la tête du syndicat avec pour mission de \" dé-staliniser\" la CGT est issu de chez eux."
                            }
                        ]
