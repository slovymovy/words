                "senses": [
                    {
                        "sense_id": "3f7f7a16-4269-3844-9962-b4086321965a",
                        "entry_id": "042c79c8-52b9-3ba9-8086-7134f4c1034e",
                        "glosses": [
                            "Dunst aus lauter waberndem Nebel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6b0004-610f-466e-8a59-59f254446f5a",
                                "sense_id": "3f7f7a16-4269-3844-9962-b4086321965a",
                                "text": "„Als er sich aufrichtete, ertrank das Bild in den Nebelschwaden, die über den Hügeln von Borodino waberten.“"
                            },
                            {
                                "example_id": "e76c17fa-264a-48ce-a84d-f8a5d3d9eba5",
                                "sense_id": "3f7f7a16-4269-3844-9962-b4086321965a",
                                "text": "„Leichte Nebelschwaden liegen über dem Boden.“"
                            },
                            {
                                "example_id": "4587bc7d-2ea8-456b-9f9d-204af922ea38",
                                "sense_id": "3f7f7a16-4269-3844-9962-b4086321965a",
                                "text": "„Da kamen sie über die Lichtung auf ihn zu, über totes Gras, durch Nebelschwaden, da kamen sie.“"
                            },
                            {
                                "example_id": "eeef0d02-ebf1-4d4e-8313-f6dce020a77b",
                                "sense_id": "3f7f7a16-4269-3844-9962-b4086321965a",
                                "text": "„Die Nacht war stockdunkel, dichte Nebelschwaden zogen über die Erde, ganz Richmond lag im Dunst, während Schneeregen fiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
