                        "examples": [
                            {
                                "example_id": "008628e3-c12f-4fd1-a457-3c1453aa56a5",
                                "sense_id": "6965ee08-5808-342e-98bb-b88017cf348e",
                                "text": "Nach herrschender Meinung gehört die Widerrechtlichkeit des Eindringens in § 123 StGB nicht zum Tatbestand, sondern ist ein eigentlich unnötiger Hinweis auf die ohnehin erforderliche Rechtswidrigkeit der Tatbestandsverwirklichung."
                            },
                            {
                                "example_id": "9fcca049-0a6b-4836-87e6-f4a31b76873c",
                                "sense_id": "6965ee08-5808-342e-98bb-b88017cf348e",
                                "text": "Handlungen von öffentlicher Hand wie Polizeieinsätze und dergleichen fallen nicht unter die Widerrechtlichkeit."
                            }
                        ],
