                        "entry_id": "ade506f9-9cdd-3df3-b94d-d5fd988e04c1",
                        "glosses": [
                            "Espiègle, écervelé, tout fou (affectif)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b79def1d-37f7-4952-ab44-4fdb30976033",
                                "sense_id": "a5bcfb60-0f3b-31b1-a257-2dc204b88948",
                                "text": "Le jeune comte Octavian, assez foufou, assez lancé sous les jupes des dames pour être connu sous le tendre nom de « Quinquin »."
                            },
                            {
                                "example_id": "ecdbcba1-bb55-404c-9de8-ab32a5511371",
                                "sense_id": "a5bcfb60-0f3b-31b1-a257-2dc204b88948",
                                "text": "Bigle un peu le chanteur foufou… encore un qui la soigne, sa publicité."
                            },
                            {
                                "example_id": "f76ca3c0-a5cf-41f7-8781-05e4ffd267e6",
                                "sense_id": "a5bcfb60-0f3b-31b1-a257-2dc204b88948",
                                "text": "Éparpillé, impulsif et « foufou » dans l’immédiat après-2008, le maire gagna en gravitas dans les dernières années."
                            }
                        ]
                    }
                ],
