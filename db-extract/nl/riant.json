                ],
                "senses": [
                    {
                        "sense_id": "aa7f9bdb-9b9e-3888-9c6b-be1384e7b414",
                        "entry_id": "dc70ec5d-5412-39e4-9217-743f8199ef1b",
                        "glosses": [
                            "groot en daardoor aantrekkelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46afc582-be36-4319-9c38-0b375b1dca17",
                                "sense_id": "aa7f9bdb-9b9e-3888-9c6b-be1384e7b414",
                                "text": "Hij zal het nooit met zoveel woorden zeggen - daarvoor is de ex-aanvaller van Club Brugge en Anderlecht te slim - maar het zal gevoeld hebben als zoete wraak. Of hoe moet een spits zich voelen wiens voorzitter openlijk laat verstaan dat zijn prestaties niet conform zijn riante salaris zijn?"
                            },
                            {
                                "example_id": "25fe798c-8c7a-4418-bfcd-af0c714987ba",
                                "sense_id": "aa7f9bdb-9b9e-3888-9c6b-be1384e7b414",
                                "text": "De Schotse Donna Pirie (54) heeft een ongewone manier om haar huis van 1,7 miljoen pond te verkopen. Wie een kruiswoordraadsel oplost en 25 pond (bijna 28 euro) betaalt, maakt kans op haar zes kamers tellende riante stulpje in het Schotse Aberdeenshire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6192aac5-6689-4c25-8ac9-3d5787b6f416",
                        "source_entry_id": "dc70ec5d-5412-39e4-9217-743f8199ef1b",
                        "source_sense_id": "aa7f9bdb-9b9e-3888-9c6b-be1384e7b414",
                        "source_sense_description": "groot en daardoor aantrekkelijk",
                        "target_lang_word": "magnificent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnificent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6f068a-0ac8-3444-8df5-f9c5651ca5aa",
                                        "entry_id": "7d18dc65-85f0-35dd-a4b0-5af11d4abb0f",
                                        "glosses": [
                                            "Grand, elegant or splendid in appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad37072-66b7-46e2-99d0-111941e99fcb",
                                                "sense_id": "ee6f068a-0ac8-3444-8df5-f9c5651ca5aa",
                                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                                            },
                                            {
                                                "example_id": "79e197cc-f492-4eec-96ab-27849bf2120b",
                                                "sense_id": "ee6f068a-0ac8-3444-8df5-f9c5651ca5aa",
                                                "text": "Armstrong: \"Isn't that something! Magnificent sight out here.\"\nAldrin: \"Magnificent desolation.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d903716a-bb6e-37f5-af1b-406f2c5de825",
                                        "entry_id": "7d18dc65-85f0-35dd-a4b0-5af11d4abb0f",
                                        "glosses": [
                                            "Grand or noble in action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91d03734-9c8f-3a81-af77-42b8b0f44bd5",
                                        "entry_id": "7d18dc65-85f0-35dd-a4b0-5af11d4abb0f",
                                        "glosses": [
                                            "Exceptional for its kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1901beb0-5b01-414b-888b-167d086c503c",
                                                "sense_id": "91d03734-9c8f-3a81-af77-42b8b0f44bd5",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "e9c49906-4c5d-45c2-b25b-0b00026da546",
                                                "sense_id": "91d03734-9c8f-3a81-af77-42b8b0f44bd5",
                                                "text": "Substitute Edin Dzeko scrambled in a fourth and the magnificent David Silva ran clear to add another, before the Bosnian striker inflicted the final wound seconds from the end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
