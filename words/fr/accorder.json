            "senses": [
                {
                    "sense_id": "af6cf02a-448c-31fa-85f3-09ad46a6165e",
                    "sense_definition": "Donner, concéder ou octroyer quelque chose en réponse à une demande ou en vertu d'un pouvoir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "donner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé d'<w>accorder</w> un prêt avantageux à ce jeune employé méritant."
                        },
                        {
                            "text": "La mairie nous <w>accorde</w> une autorisation exceptionnelle pour organiser cette fête dans le parc."
                        }
                    ],
                    "synonyms": [
                        "concéder",
                        "octroyer"
                    ],
                    "antonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
                        "accorder un prêt",
                        "accorder une autorisation",
                        "accorder sa confiance"
                    ]
                },
                {
                    "sense_id": "151cb73e-152a-3557-a860-05e9c94f53db",
                    "sense_definition": "Régler la hauteur des sons d'un instrument de musique pour obtenir une tonalité juste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musicien prend toujours quelques minutes pour <w>accorder</w> une guitare avant le concert."
                        },
                        {
                            "text": "Un professionnel vient régulièrement chez nous pour <w>accorder</w> le piano du salon."
                        }
                    ],
                    "synonyms": [
                        "ajuster"
                    ],
                    "common_phrases": [
                        "accorder une guitare",
                        "accorder un piano"
                    ]
                },
                {
                    "sense_id": "1751233e-b098-3159-9b22-ca93f2578a71",
                    "sense_definition": "Faire correspondre des mots en genre, en nombre ou en personne selon les règles de la syntaxe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas d'<w>accorder</w> l'adjectif avec le nom qu'il qualifie dans cette phrase."
                        },
                        {
                            "text": "Les élèves apprennent à <w>accorder</w> le verbe avec son sujet dans cet exercice."
                        }
                    ],
                    "common_phrases": [
                        "accorder l'adjectif",
                        "accorder le verbe"
                    ]
                },
                {
                    "sense_id": "600dac1e-c75a-3ddd-93f9-2db5824d2d19",
                    "sense_definition": "Concilier des éléments différents ou des points de vue pour créer un ensemble cohérent et harmonieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est parfois difficile d'<w>accorder</w> ses actes avec ses paroles face aux critiques."
                        },
                        {
                            "text": "La décoratrice sait parfaitement <w>accorder</w> ces teintes vives dans une petite pièce."
                        }
                    ],
                    "synonyms": [
                        "harmoniser"
                    ],
                    "common_phrases": [
