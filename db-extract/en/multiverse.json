                                "target_senses": [
                                    {
                                        "sense_id": "5b9b30a3-3311-3246-a135-27b67d6c8729",
                                        "entry_id": "de058732-f3c9-361e-a6ec-e519260a6aaa",
                                        "glosses": [
                                            "theoretisch verondersteld geheel van een oneindig aantal parallelle heelallen die bestaan naast het heelal waar we in leven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee75c6a4-76ec-414e-81a5-0c6940301677",
                                                "sense_id": "5b9b30a3-3311-3246-a135-27b67d6c8729",
                                                "text": "Begin deze maand, krap twee weken voor zijn overlijden, legde Stephen Hawking de laatste hand aan een nieuw wetenschappelijk artikel over het multiversum. Volgens dit idee bestaan er naast ons universum oneindig veel andere universums."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d853f25-f7b3-472e-8af0-d9b3ad4a73f4",
                        "source_entry_id": "b939ae4a-2881-37c6-9501-a6bdb5df58fd",
                        "source_sense_description": "hypothetical group of all possible universes",
                        "target_lang_word": "multivers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
