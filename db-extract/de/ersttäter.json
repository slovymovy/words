                "senses": [
                    {
                        "sense_id": "74308d0a-523a-3878-b89e-a751319ecbd4",
                        "entry_id": "9bdef22c-9636-3aac-9091-7c6118ddb09e",
                        "glosses": [
                            "Person, die zum ersten Mal gesetzeswidrig handelt/eine Straftat begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45d9c40-25d6-48f7-9f04-14cf640c29eb",
                                "sense_id": "74308d0a-523a-3878-b89e-a751319ecbd4",
                                "text": "„Der träge Behördenapparat kann bislang mit den ebenso wendigen wie windigen Tätern nicht Schritt halten, weshalb die geschnappten Seriendiebe häufig behandelt werden wie harmlose Ersttäter.“"
                            },
                            {
                                "example_id": "00414208-a56a-462f-9a1e-a212184a24e0",
                                "sense_id": "74308d0a-523a-3878-b89e-a751319ecbd4",
                                "text": "„Wenn ein Ersttäter den Eindruck gewinnt, dass seine Taten keine rechtlichen Konsequenzen haben, steigt die Wahrscheinlichkeit, dass aus ihm ein Mehrfachtäter wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
