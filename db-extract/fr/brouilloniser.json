                "senses": [
                    {
                        "sense_id": "e324381b-6f29-39de-8176-40a4a52c5cde",
                        "entry_id": "94fb14e3-dcce-385f-b4a5-6689f477214b",
                        "glosses": [
                            "Produire sous forme de brouillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "068cec05-1ae2-4923-bbcd-91d63850b13e",
                                "sense_id": "e324381b-6f29-39de-8176-40a4a52c5cde",
                                "text": "Bon, j’ai brouillonisé plein d’articles sur le Japon, vous en faites pas vous aurez la suite de mon séjour, il me faut juste le temps de m’en occuper (et ça va en demander beaucoup)."
                            },
                            {
                                "example_id": "3a4219bf-28f6-4bf0-b537-0873aac57307",
                                "sense_id": "e324381b-6f29-39de-8176-40a4a52c5cde",
                                "text": "Mais à ma décharge, j’avais écrit un article lundi et que j’ai voulu le brouilloniser (même pas le poster hein !), ben bug internet, plus d’article !"
                            },
                            {
                                "example_id": "25b909da-c0ab-4edc-bf2c-74fb3f979449",
                                "sense_id": "e324381b-6f29-39de-8176-40a4a52c5cde",
                                "text": "Peut-être y aurait-il moyen de « brouilloniser » le personnage avec du trait du genre du lettrage ?"
                            }
                        ]
                    }
