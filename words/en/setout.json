                },
                {
                    "sense_id": "09194ec9-b6ac-365a-948e-47e45e173894",
                    "sense_definition": "An elaborate display, spread, or collection of things or people.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host prepared an impressive dinner <w>setout</w> with fine china and silverware.",
                            "target_lang_translations": {
                                "ru": "Хозяин подготовил впечатляющую обеденную <w>сервировку</w> с изысканным фарфором и столовым серебром."
                            }
                        },
                        {
                            "text": "He looked disapprovingly at the entire <w>setout</w> of guests gathered in the parlor.",
                            "target_lang_translations": {
                                "ru": "Он с неодобрением оглядел всё это <w>сборище</w> гостей, собравшихся в гостиной."
