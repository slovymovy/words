{
    "word_family": [
        "contredire",
        "contradiction",
        "contradictoirement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97643abe-8259-37e4-ab42-e134779de2aa",
                    "sense_definition": "Qui contient ou implique une contradiction, qui s'oppose logiquement à soi-même ou à une autre chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "opposition_logique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux témoignages sont totalement <w>contradictoires</w> et sèment la confusion chez les enquêteurs."
                        },
                        {
                            "text": "Les médias ont diffusé des informations <w>contradictoires</w> sur les causes réelles de cet accident."
                        }
                    ],
                    "synonyms": [
                        "incohérent",
                        "incompatible",
                        "opposé"
                    ],
                    "antonyms": [
                        "cohérent",
                        "compatible",
                        "concordant"
                    ],
                    "common_phrases": [
                        "signaux contradictoires",
                        "déclarations contradictoires",
                        "injonction contradictoire"
                    ]
                },
                {
                    "sense_id": "ae2ef7bf-76fa-3c7c-81a1-00e3fe73cb5d",
                    "sense_definition": "Qui a lieu en présence de toutes les parties concernées afin que chacune puisse débattre et contester les arguments adverses.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "justice_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les candidats se sont affrontés lors d'un débat <w>contradictoire</w> très suivi à la télévision."
                        },
                        {
                            "text": "Le juge a prononcé un jugement <w>contradictoire</w> après avoir entendu les avocats des deux parties."
                        }
                    ],
                    "common_phrases": [
                        "débat contradictoire",
                        "procédure contradictoire",
                        "jugement contradictoire"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b10e2759-0e41-30de-b630-e29a7672fcbf",
                    "sense_definition": "Principe de justice garantissant que chaque partie puisse exprimer sa position et contester les prétentions opposées.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal doit veiller scrupuleusement au respect du <w>contradictoire</w> pendant l'ensemble du procès."
                        },
                        {
                            "text": "Ce jugement a été annulé par la cour pour non-respect du <w>contradictoire</w>."
                        }
                    ],
                    "common_phrases": [
                        "principe du contradictoire",
                        "respect du contradictoire"
                    ]
                },
                {
                    "sense_id": "bf6d9343-5260-3364-ac4c-29885ca1e952",
                    "sense_definition": "Proposition qui nie de manière absolue une autre proposition dans un raisonnement logique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition_logique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En logique formelle, une affirmation et sa <w>contradictoire</w> ne peuvent jamais être vraies ensemble."
                        },
                        {
                            "text": "Le philosophe a immédiatement formulé la <w>contradictoire</w> pour réfuter la thèse de son collègue."
                        }
                    ]
                }
            ]
        }
    ]
}