                                "sense_id": "6f7e3066-f4e3-3a67-95f7-78d05e73d8bc",
                                "text": "Am Jahresende sind Jahresrückblicke jeglicher Themencouleur sehr beliebt",
                                "translation": "Pod koniec roku bardzo popularne są retrospekcje o wszelkim zakresie tematycznym."
                            },
                            {
                                "example_id": "44eb4eb2-be11-4f1d-a944-cc2e1c8ff0ed",
                                "sense_id": "6f7e3066-f4e3-3a67-95f7-78d05e73d8bc",
                                "text": "Jedes Mal zum Jahresende wird Bilanz gezogen",
                                "translation": "Za każdym razem na koniec roku sporządza się rozliczenie."
                            }
