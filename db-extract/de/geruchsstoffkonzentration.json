                ],
                "senses": [
                    {
                        "sense_id": "84caa816-b3f4-34c6-b010-73670a0cbd03",
                        "entry_id": "b25accfc-4f14-3bcb-97f0-6b6ee7284579",
                        "glosses": [
                            "der Gehalt an riechenden Molekülen oder Teilchen in der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43dc3ccc-8a77-4bae-ae1a-5c9589e15bd4",
                                "sense_id": "84caa816-b3f4-34c6-b010-73670a0cbd03",
                                "text": "„Die Geruchsstoffkonzentration der zu messenden Gasprobe (Einzelstoff oder Stoffgemisch) wird durch Verdünnung mit Neutralluft bis zur Geruchsschwelle bestimmt.“"
                            },
                            {
                                "example_id": "0c72ad15-655e-49c4-a36d-56e0c742f75c",
                                "sense_id": "84caa816-b3f4-34c6-b010-73670a0cbd03",
                                "text": "„Die Geruchsstoffkonzentration an der Geruchsschwelle führt bei 50 % der definierten Grundgesamtheit (Bevölkerung) zu einem Geruchseindruck. “"
                            },
                            {
                                "example_id": "98d464fa-6035-4bb1-a7f6-44bf3301055f",
                                "sense_id": "84caa816-b3f4-34c6-b010-73670a0cbd03",
                                "text": "„Bei gemessenen Geruchsstoffkonzentrationen von mehreren Tausend GE/m³ muss für eine ausreichend hohe Ableitung der Abgase gesorgt werden.“"
                            },
                            {
                                "example_id": "65e4eab6-1e83-4eb1-8b06-b0c43c9cf798",
                                "sense_id": "84caa816-b3f4-34c6-b010-73670a0cbd03",
                                "text": "„Aus dem Verhältnis der Volumenströme von Geruchsstoffprobe und Neutralluft bei Erreichen der Geruchsschwelle ergibt sich die Geruchsstoffkonzentration in GE/m³ der untersuchten Probe.“"
                            },
                            {
                                "example_id": "cc2c2d9e-40f2-474e-b9d3-6f4a5463f056",
                                "sense_id": "84caa816-b3f4-34c6-b010-73670a0cbd03",
                                "text": "„Zur Messung der Geruchsstoffkonzentration wird z.B. ein Gasbeutel mit geruchhaltiger Luft an das Olfaktometer angeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
