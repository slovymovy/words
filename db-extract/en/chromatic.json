                        "entry_id": "7b0509f0-252b-35d0-9448-67d5b992b877",
                        "glosses": [
                            "Relating to or using notes not belonging to the diatonic scale of the key in which a passage of music is written."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c2fc269e-ef9a-4a9b-92c4-cdeaf0d73d75",
                                "sense_id": "81caa716-fb87-3cd1-b6bf-347d16e745ef",
                                "text": "All the intervals of the scale that are a whole tone (step) distant from each other may be divided into half tones, (small steps), forming an entire scale of small intervals, (half tones), called the Chromatic Scale. […] All the tones (steps) of the scale being thus divided, either by means of the sharp or flat, we shall have for our Chromatic Scale thirteen intervals, of a half tone (small step) each."
                            }
                        ]
                    }
