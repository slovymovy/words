{
    "word_family": [
        "inconscience",
        "inconsciemment",
        "conscience",
        "conscient",
        "consciencieux",
        "subconscient"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7060dcf8-9f8b-3c58-9e46-271c30328842",
                    "sense_definition": "Qui a perdu connaissance ou qui n'est pas en état de percevoir la réalité extérieure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perte_de_connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa mauvaise chute à vélo, le cycliste est resté <w>inconscient</w> pendant plusieurs minutes."
                        },
                        {
                            "text": "Les pompiers ont trouvé la victime <w>inconsciente</w> sur le sol de son appartement."
                        }
                    ],
                    "synonyms": [
                        "assommé",
                        "comateux"
                    ],
                    "antonyms": [
                        "conscient"
                    ],
                    "common_phrases": [
                        "rester inconscient",
                        "retrouvé inconscient"
                    ]
                },
                {
                    "sense_id": "f14ea205-81e4-3b09-a55d-4ec52da37859",
                    "sense_definition": "Qui agit sans réfléchir aux conséquences de ses actes ou aux dangers encourus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "irresponsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est totalement <w>inconscient</w> de rouler à cette vitesse sous une pluie battante."
                        },
                        {
                            "text": "Cette décision précipitée est jugée particulièrement <w>inconsciente</w> par ses collègues de travail."
                        }
                    ],
                    "antonyms": [
                        "conscient"
                    ],
                    "common_phrases": [
                        "conduite inconsciente"
                    ]
                },
                {
                    "sense_id": "82abd750-35e8-3ce8-9db6-a4ffe1f2b61c",
                    "sense_definition": "Qui n'a pas conscience d'une situation ou d'une réalité extérieure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ignorance_du_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme semblait <w>inconscient</w> du danger qu'il faisait courir à toute l'équipe."
                        },
                        {
                            "text": "Elle marchait seule la nuit, apparemment <w>inconsciente</w> des risques dans ce quartier isolé."
                        }
                    ],
                    "antonyms": [
                        "conscient"
                    ],
                    "common_phrases": [
                        "inconscient du danger",
                        "inconscient du risque"
                    ]
                },
                {
                    "sense_id": "bad05e34-a446-3a76-ba4d-3c472de5fce8",
                    "sense_definition": "Qui s'opère ou existe sans que la personne en ait une perception consciente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "processus_psychique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fait un geste <w>inconscient</w> pour repousser la tasse avant qu'elle ne tombe."
                        },
                        {
                            "text": "Cette réaction spontanée traduit une peur <w>inconsciente</w> ancrée depuis son enfance."
                        }
                    ],
                    "antonyms": [
                        "conscient"
                    ],
                    "common_phrases": [
                        "geste inconscient",
                        "mécanisme inconscient"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef3f971d-86d4-365d-b6d7-6229765a3eb6",
                    "sense_definition": "Ensemble des phénomènes et processus psychiques qui échappent à la conscience.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la théorie psychanalytique, les rêves révèlent les désirs enfouis dans l'<w>inconscient</w>."
                        },
                        {
                            "text": "Ce souvenir d'enfance a longtemps été refoulé dans son <w>inconscient</w> avant de ressurgir."
                        }
                    ],
                    "common_phrases": [
                        "inconscient collectif",
                        "refoulé dans l'inconscient"
                    ]
                },
                {
                    "sense_id": "01adadab-63c6-39b4-b187-c4529b244c9d",
                    "sense_definition": "Personne irréfléchie qui agit sans mesurer les risques ni la portée de ses actes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_irresponsable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traverser cette rivière en crue est un acte d'<w>inconscient</w> qui aurait pu coûter cher."
                        },
                        {
                            "text": "Ces <w>inconscients</w> ont allumé un feu en pleine forêt malgré la sécheresse."
                        }
                    ],
                    "common_phrases": [
                        "bande d'inconscients"
                    ]
                }
            ]
        }
    ]
}