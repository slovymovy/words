                        "examples": [
                            {
                                "example_id": "205ddad6-547c-4f7b-ab5a-5b58927ecb4f",
                                "sense_id": "1fa3b4cc-9ed4-331d-a3a2-5b565ffda08d",
                                "text": "„Auf dem Küchentisch standen eine Müslipackung und ein offener Milchkarton neben einer halb leer gegessenen Schale Müsli.“"
                            },
                            {
                                "example_id": "7e37fed1-1ec9-47ee-9adb-215d93bfd526",
                                "sense_id": "1fa3b4cc-9ed4-331d-a3a2-5b565ffda08d",
                                "text": "„In ihrem Schatten liegt ein Typ in einem zerrissenen blauen Hemd, zerrissenen blauen Shorts und einer Mütze, die er sich aus einer Müslipackung gebastelt hat.“"
                            }
