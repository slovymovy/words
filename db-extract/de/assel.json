                "senses": [
                    {
                        "sense_id": "293b6a83-01b7-3ef6-93fe-2e5c48df53aa",
                        "entry_id": "92ecf8e8-f449-36c5-999e-e1eb0a876d64",
                        "glosses": [
                            "Mitglied der Ordnung der Asseln (Isopoda), die selbst zur Klasse der Höheren Krebse (Malacostraca) gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff29bc7-3153-412d-ba76-6251f3841ee0",
                                "sense_id": "293b6a83-01b7-3ef6-93fe-2e5c48df53aa",
                                "text": "„Obwohl diese bis zu zwei Zentimeter lange Assel ursprünglich in warmen Gewässern wie dem Mittelmeer beheimatet ist, kommt sie nun verstärkt auch in der Nordsee vor, die in den vergangenen Jahrzehnten wärmer geworden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5232d0b-2a6c-4f3b-903c-773b2550f98e",
                        "source_entry_id": "92ecf8e8-f449-36c5-999e-e1eb0a876d64",
                        "source_sense_id": "293b6a83-01b7-3ef6-93fe-2e5c48df53aa",
                        "source_sense_description": "Mitglied der Ordnung der Asseln (Isopoda)",
                        "target_lang_word": "woodlouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woodlouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d42079b-0cd4-38f4-8ba5-da01cb74d2ee",
                                        "entry_id": "956ca190-1a86-3b85-ae0c-f65c79a82baf",
                                        "glosses": [
                                            "Any of the terrestrial isopod crustaceans of suborder Oniscidea, which have a rigid, segmented exoskeleton, often being capable of rolling into a ball, and feed only on dead plant matter, usually living in damp, dark places, such as under stones or bark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18ff166-ffbd-48fc-b0b7-4f1b6d54fdda",
                                                "sense_id": "8d42079b-0cd4-38f4-8ba5-da01cb74d2ee",
                                                "text": "In addition, both the woodlouse and the crayfish possess an unpaired medial nerve which runs along the whole length of the ventral nerve cord, linking adjacent ganglia."
                                            },
                                            {
                                                "example_id": "b0087877-4ffe-4b90-b0f8-2072a37717ce",
                                                "sense_id": "8d42079b-0cd4-38f4-8ba5-da01cb74d2ee",
                                                "text": "Woodlice commonly produce offspring 1-3 times per year, with spring and autumn broods most common. Woodlice often survive for longer than a year, with longevity of 2-5 years not uncommon."
                                            },
                                            {
                                                "example_id": "8798a8c9-d141-4a4a-b72a-636e05cfacde",
                                                "sense_id": "8d42079b-0cd4-38f4-8ba5-da01cb74d2ee",
                                                "text": "The sections allow woodlice to bend and curve their armored bodies. Some types of woodlice can roll into a tight ball. They do this to protect themselves when threatened by a predator.\nFemale woodlice carry their eggs in a liquid-filled pouch under their bodies. When the young woodlice hatch from the eggs, they crawl out of the pouch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03c09493-db46-442a-b27c-61c9b138b965",
                        "source_entry_id": "92ecf8e8-f449-36c5-999e-e1eb0a876d64",
                        "source_sense_id": "293b6a83-01b7-3ef6-93fe-2e5c48df53aa",
                        "source_sense_description": "Mitglied der Ordnung der Asseln (Isopoda)",
                        "target_lang_word": "slater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24ffc3b2-d81e-3c42-859c-c1c92d1e78d0",
                                        "entry_id": "1f285322-4c57-3af8-b982-ac6fc3c390e8",
                                        "glosses": [
                                            "One who lays slates, or whose occupation is to slate buildings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "263dbabd-a249-37d3-97df-d058eb6082b0",
                                        "entry_id": "1f285322-4c57-3af8-b982-ac6fc3c390e8",
                                        "glosses": [
                                            "Any terrestrial isopod crustacean of the genus Porcellio and allied genera; a woodlouse."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dedc3a85-7d93-3781-93eb-c20fd130447c",
                                        "entry_id": "1f285322-4c57-3af8-b982-ac6fc3c390e8",
                                        "glosses": [
                                            "A harsh critic; one who slates or denigrates something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc07e89a-a9a2-47b5-811b-cc4ec01d1140",
                                                "sense_id": "dedc3a85-7d93-3781-93eb-c20fd130447c",
                                                "text": "Plain speaking, now and then, is very necessary. The author will call the critic a “blackguard slater,\" of course, but he need not be a blackguard. Ferocity of language only hurts his effect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
