                        "examples": [
                            {
                                "example_id": "8cd5c9ac-23b1-48d0-8de1-7c3131419277",
                                "sense_id": "0391d9ad-b5d1-3075-aee5-dfac41f8a23f",
                                "text": "Jeune pastourelle au blanc capulet\nQue fais-tu seulette si loin du chalet ?\nJ’ai perdu pauvrette mon joli joyau\nMa blanche agnelette fleur de mon troupeau."
                            },
                            {
                                "example_id": "28096441-ce49-46a8-9164-a629b4c9f5a7",
                                "sense_id": "0391d9ad-b5d1-3075-aee5-dfac41f8a23f",
                                "text": "Le ciel c'était diverti\nA me donner un état fleuri\nEn pleine prospérité\nJ'avais une agnelette dans mon parc\nLes rayons du soleil se cachaient\nQuand elle paraissait."
                            }
                        ]
