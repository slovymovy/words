                ],
                "senses": [
                    {
                        "sense_id": "d5544458-c836-3f8f-8e0b-d4676139e282",
                        "entry_id": "98261ad2-1e8b-3814-ac87-de173480915d",
                        "glosses": [
                            "een kamer die voor gasten per nacht te huur is in een hotel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16cb6826-da11-49b8-a14a-8cdf791e042d",
                                "sense_id": "d5544458-c836-3f8f-8e0b-d4676139e282",
                                "text": "Hij had een prachtige hotelkamer met een riant uitzicht op de Golf van Mexico."
                            },
                            {
                                "example_id": "6ba759f5-3754-4cd7-b3a8-1ec8775899b3",
                                "sense_id": "d5544458-c836-3f8f-8e0b-d4676139e282",
                                "text": "De kamer was perfect, niet omdat het een perfecte hotelkamer was, maar juist daarom."
                            },
                            {
                                "example_id": "e56a7a99-c556-446e-8969-948622b5a21c",
                                "sense_id": "d5544458-c836-3f8f-8e0b-d4676139e282",
                                "text": "Ik verlangde enorm naar de veiligheid van een eigen hotelkamer, waar ik kon bijkomen met de gordijnen dicht en ontspannen in een schoon bed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b92ca5c-9ab4-43c2-93ef-67fe8fb9d0ac",
                        "source_entry_id": "98261ad2-1e8b-3814-ac87-de173480915d",
                        "source_sense_id": "d5544458-c836-3f8f-8e0b-d4676139e282",
                        "source_sense_description": "een kamer die voor gasten per nacht te huur is in een hotel",
                        "target_lang_word": "Hotelzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hotelzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                        "entry_id": "a9d9dcf1-8b92-3585-866c-08a0d2395077",
                                        "glosses": [
                                            "Zimmer in einem Hotel, in dem die Gäste während ihres Aufenthaltes wohnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba106e4b-b4c2-4c6c-ab8c-29b26ba2fec9",
                                                "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                                "text": "Wir mussten den ganzen Urlaub über in einem Hotelzimmer voller Ungeziefer hausen."
                                            },
                                            {
                                                "example_id": "9e28c9eb-2956-40a5-ae89-c356e7783c62",
                                                "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                                "text": "„Wer sich also für sein Hotelzimmer einen Lupinenstrauß zusammenstellen will, nur zu.“"
                                            },
                                            {
                                                "example_id": "1ead9652-8923-4518-bf51-5c61cf87e9bb",
                                                "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                                "text": "„In einem Hotelzimmer ließ sich Titus gerne Zeit.“"
                                            },
                                            {
                                                "example_id": "eaea0264-39be-403b-b202-975c317166e0",
                                                "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                                "text": "„Die schwache Wärme des Hotelzimmers stellt ihn wieder her.“"
                                            },
                                            {
                                                "example_id": "967ac869-9192-44d8-9caa-41a16719009a",
                                                "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                                "text": "„Unser Hotelzimmer in Trastevere war karg.“"
                                            },
                                            {
                                                "example_id": "7378a2a9-0e5f-475a-8aec-d3c5b86641e8",
                                                "sense_id": "746541c7-c487-3135-af08-78d212d31881",
                                                "text": "„Ich liege in meinem schönen Hotelzimmer, schaue hinaus auf den Leuchtturm und frage mich: Was soll das alles?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
