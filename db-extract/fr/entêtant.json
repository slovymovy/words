                                "target_senses": [
                                    {
                                        "sense_id": "a9f1cd19-70e9-3df8-a669-f7181e428140",
                                        "entry_id": "5a895b98-6ccf-35bc-aead-5b34021e3479",
                                        "glosses": [
                                            "Intoxicating or stupefying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c88e7e-094e-424d-91ef-ec5e359b00c4",
                                                "sense_id": "a9f1cd19-70e9-3df8-a669-f7181e428140",
                                                "text": "The cocktail was a heady mixture of spirits."
                                            },
                                            {
                                                "example_id": "d68493eb-09e7-46ea-846a-37091b8ba5a3",
                                                "sense_id": "a9f1cd19-70e9-3df8-a669-f7181e428140",
                                                "text": "Lilac wine is sweet and heady, like my love / Lilac wine, I feel unsteady, like my love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af8f7496-bead-3cc0-bb50-04d6df270838",
                                        "entry_id": "5a895b98-6ccf-35bc-aead-5b34021e3479",
                                        "glosses": [
                                            "Tending to upset the mind or senses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05529ab4-75f6-4569-8b3b-981c638c339d",
                                                "sense_id": "af8f7496-bead-3cc0-bb50-04d6df270838",
                                                "text": "We looked out from a heady outcrop of rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0edcb99-7f0a-37e1-a52a-7a9c17f3dedb",
                                        "entry_id": "5a895b98-6ccf-35bc-aead-5b34021e3479",
                                        "glosses": [
                                            "Exhilarating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa26b22c-83e3-4748-81cc-ab462cd749c9",
                                                "sense_id": "e0edcb99-7f0a-37e1-a52a-7a9c17f3dedb",
                                                "text": "The rock concert was a heady mixture of their greatest hits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542f9ff4-1d14-3b59-9225-33fff14b7f29",
                                        "entry_id": "5a895b98-6ccf-35bc-aead-5b34021e3479",
                                        "glosses": [
                                            "Intellectual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "908ed222-ccf1-4bdb-be7b-92aae574ae61",
                                                "sense_id": "542f9ff4-1d14-3b59-9225-33fff14b7f29",
                                                "text": "Kierkegaard is rather heady reading for a high school student."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dec357b-ff74-3b20-a15b-aa414c7ea8ec",
                                        "entry_id": "5a895b98-6ccf-35bc-aead-5b34021e3479",
                                        "glosses": [
                                            "Rash or impetuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98bcbfc4-25e1-4918-8877-fba36681657d",
                                                "sense_id": "9dec357b-ff74-3b20-a15b-aa414c7ea8ec",
                                                "text": "He made such heady promises that when the time came, he was never able to fulfill them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
