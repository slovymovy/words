                "senses": [
                    {
                        "sense_id": "0df700fa-9bfd-3cee-a0d5-1058d1654add",
                        "entry_id": "de3cb8b1-66dd-36e4-9d09-481b65a04992",
                        "glosses": [
                            "Mensch, der eine längere Strecke im Gebirge zu Fuß zurücklegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d59e45-7c20-4fab-8abd-c122babb53de",
                                "sense_id": "0df700fa-9bfd-3cee-a0d5-1058d1654add",
                                "text": "„In der schwärmerischen Sprache der Zeit wird zum Ausdruck gebracht, was die Bergwanderer und Kletterer bewegt: […].“"
                            },
                            {
                                "example_id": "036d5c1e-996b-4e9b-a0f9-8ab4ee0b1001",
                                "sense_id": "0df700fa-9bfd-3cee-a0d5-1058d1654add",
                                "text": "„Die Primeln unserer Alpen, das Entzücken des Bergwanderers, sind fast alle für den Tieflandgarten ungeeignet.“"
                            },
                            {
                                "example_id": "5f4a7177-1ce5-4d5b-9f16-74a83987481a",
                                "sense_id": "0df700fa-9bfd-3cee-a0d5-1058d1654add",
                                "text": "„Er wirkt sichtlich verkleidet in der Rolle des Bergwanderers, der nicht wirklich Bergwanderer sein kann in dieser Menschenlawine am Berg.“"
                            },
                            {
                                "example_id": "e762da7d-fc9f-4225-8564-c953792bc850",
                                "sense_id": "0df700fa-9bfd-3cee-a0d5-1058d1654add",
                                "text": "„Der letzte Schrei unter Bergwanderern ist ein Flüssigkeitspack im Rucksack, von dem ein Trinkschlauch zum Mund des Wanderers führt.“"
                            },
                            {
                                "example_id": "6f82d1f0-4de3-4fa9-bdf3-e43927176d40",
                                "sense_id": "0df700fa-9bfd-3cee-a0d5-1058d1654add",
                                "text": "„Die Bergwanderer in der Provence feuern jeden Radfahrer, der an ihnen vorbeikriecht, mit allez! allez! an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
