                    {
                        "translation_id": "fb4f4823-9b9c-4b38-91f5-2e41e07e64b5",
                        "source_entry_id": "1ea24c4a-379a-3431-9d8c-d4a214c45e9c",
                        "source_sense_id": "83cb3e83-818a-3698-ae0e-ee1afc3f9248",
                        "target_lang_word": "destinataire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destinataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "581761fe-bf91-3ff9-8566-7cd88e25975d",
                                        "entry_id": "93ee3556-d5dc-3375-8d54-fc50b90a2066",
                                        "glosses": [
                                            "Personne à qui est destiné quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65071456-5de6-412c-b3db-6be2c177f82d",
                                                "sense_id": "581761fe-bf91-3ff9-8566-7cd88e25975d",
                                                "text": "Le destinataire du sulfatage ce jour-là est un général à la trogne taillée à coups de serpe habitant une villa cossue du Beau-Fraisier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26b8df2-d01f-3025-894b-01bbea535394",
                                        "entry_id": "93ee3556-d5dc-3375-8d54-fc50b90a2066",
                                        "glosses": [
                                            "Personne qui doit recevoir un message, un courriel, une lettre, un paquet expédiés par une autre personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "872dd2d6-8703-4cd5-bbba-380462867397",
                                                "sense_id": "e26b8df2-d01f-3025-894b-01bbea535394",
                                                "text": "Quand tu as des lettres de condoléances à expédier, ne tarde jamais, sinon le destinataire ne sait même plus de qui il s’agit."
                                            },
                                            {
                                                "example_id": "a18248cf-9024-4721-87c9-7541e2512d31",
                                                "sense_id": "e26b8df2-d01f-3025-894b-01bbea535394",
                                                "text": "On ne trouve pas la destinataire de cette lettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2dff24-ddf3-34bf-9332-db886fa31af8",
                                        "entry_id": "93ee3556-d5dc-3375-8d54-fc50b90a2066",
                                        "glosses": [
                                            "Auditeur ou lecteur, celui ou celle qui reçoit le message d’un locuteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a07005-2aad-4b48-a6c2-cc23b49d9542",
                                                "sense_id": "aa2dff24-ddf3-34bf-9332-db886fa31af8",
                                                "text": "En linguistique, l’énonciation est l’acte individuel de production d’un énoncé, adressé à un destinataire, dans certaines circonstances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
