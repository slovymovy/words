        "fr-extract.jsonl": [
            {
                "entry_id": "e1ba9e43-e0ae-3984-9198-5229a67b9a2c",
                "word": "dramatiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d53fb9d-4d8b-3714-bc02-76dcde7dd583",
                        "entry_id": "e1ba9e43-e0ae-3984-9198-5229a67b9a2c",
                        "glosses": [
                            "D’une manière dramatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e913d5-af6b-4747-aaa8-a9776af7aa68",
                                "sense_id": "8d53fb9d-4d8b-3714-bc02-76dcde7dd583",
                                "text": "Deux jours ! quand on aime, c’est l’éternité, répondit dramatiquement Vanois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "156ea9d4-9c1b-46e9-8f98-5f5fbee0273d",
                        "source_entry_id": "e1ba9e43-e0ae-3984-9198-5229a67b9a2c",
                        "source_sense_id": "8d53fb9d-4d8b-3714-bc02-76dcde7dd583",
                        "target_lang_word": "dramatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dramatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca1684df-2aef-3831-bdca-51cb7935a7b5",
                                        "entry_id": "f10d284f-2d3f-33af-86b5-6817df547d94",
                                        "glosses": [
                                            "sich auf ein Drama beziehend, das Drama (in seiner Eigenart) beschreibend, darstellend; zum Drama gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb1acfe-8232-44ba-9bdc-ee79bbc2b5b2",
                                                "sense_id": "ca1684df-2aef-3831-bdca-51cb7935a7b5",
                                                "text": "Die dramatische Aufführung zeigte die Missstände der Gesellschaft auf."
                                            },
                                            {
                                                "example_id": "fb381118-ff4b-4e2f-994d-825b41e1ad1d",
                                                "sense_id": "ca1684df-2aef-3831-bdca-51cb7935a7b5",
                                                "text": "Man konnte nur schätzen wie viel Wahrheit die dramatische Schilderung des Verkehrsunfalls enthielt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec23cd56-5128-3d0e-9149-601be5ff6497",
                                        "entry_id": "f10d284f-2d3f-33af-86b5-6817df547d94",
                                        "glosses": [
                                            "in Erregung geratend, in Erregung versetzend; voller Spannung"
                                        ],
                                        "tags": [
                                            "oft im Bezug auf Sport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d0f98e-5471-40b0-a813-0d4e21ed82db",
                                                "sense_id": "ec23cd56-5128-3d0e-9149-601be5ff6497",
                                                "text": "Das Rennen zwischen den beiden Kontrahenten war/verlief äußerst dramatisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                        "entry_id": "f10d284f-2d3f-33af-86b5-6817df547d94",
                                        "glosses": [
                                            "sehr, oft auch beunruhigend klar und deutlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e79247-973a-49c6-927d-81cf9be63984",
                                                "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                                "text": "In […] vielen deutschen Städten [ist die Zahl wohnungsloser Menschen …] in den vergangenen Jahren dramatisch gestiegen."
                                            },
                                            {
                                                "example_id": "644eb342-5bef-4833-aff7-9472388d9a0d",
                                                "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                                "text": "„Nach einer Studie deutscher, britischer und niederländischer Wissenschaftler [… hat] hat sich die Zahl der Falter, Käfer, Wespen, Bienen und aller möglichen anderen fliegenden Insekten in Deutschland in den letzten 27 Jahren dramatisch verringert - um 76 Prozent.“"
                                            },
                                            {
                                                "example_id": "8e073ba7-110b-4820-8ed7-0a76148d7ea9",
                                                "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                                "text": "[Klimakrise – Trockenheit in Südeuropa 2022:] „Dramatisch sind die Folgen für die Landwirtschaft in Italiens Nordregionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd54d62d-188d-47ae-9cc3-7e9102363eb4",
                        "source_entry_id": "e1ba9e43-e0ae-3984-9198-5229a67b9a2c",
                        "source_sense_id": "8d53fb9d-4d8b-3714-bc02-76dcde7dd583",
                        "target_lang_word": "dramatically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dramatically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "600fc3dd-51d8-371b-b1af-37733b671c1b",
                                        "entry_id": "dbdb5ed8-cc84-3c75-9a82-28deeed7ef30",
                                        "glosses": [
                                            "In a dramatic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310d0cba-f988-441b-99d6-92cbf0547d12",
                                                "sense_id": "600fc3dd-51d8-371b-b1af-37733b671c1b",
                                                "text": "“H'm !” he said, “so, so—it is a tragedy in a prologue and three acts. I am going down this afternoon to see the curtain fall for the third time on what […] will prove a good burlesque ; but it all began dramatically enough. It was last Saturday […] that two boys, playing in the little spinney just outside Wembley Park Station, came across three large parcels done up in American cloth. […]”"
                                            },
                                            {
                                                "example_id": "eddb7098-c77f-44a9-ac46-7ba6dae0f0bf",
                                                "sense_id": "600fc3dd-51d8-371b-b1af-37733b671c1b",
                                                "text": "Far from it: direct military intervention by a Western state – even if Prime Minister Nuri al-Maliki is requesting it – would dramatically worsen the situation, and ISIS, contrary to what pro-interventionists might say, would inevitably come out on top."
                                            },
                                            {
                                                "example_id": "d6cee385-f867-4606-a20f-cde690c1a77c",
                                                "sense_id": "600fc3dd-51d8-371b-b1af-37733b671c1b",
                                                "text": "But ever since the concept of \"hamartia\" recurred through Aristotle's Poetics, in an attempt to describe man's ingrained iniquity, our impulse has been to identify a telling defect in those brought suddenly and dramatically low."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9596671-665a-4bfc-84b7-d3e5793e6975",
                        "source_entry_id": "e1ba9e43-e0ae-3984-9198-5229a67b9a2c",
                        "source_sense_id": "8d53fb9d-4d8b-3714-bc02-76dcde7dd583",
                        "target_lang_word": "tragically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "966bb703-c4bd-3cb7-ab53-c981c71bcd56",
                                        "entry_id": "b3001e3c-b25e-3635-9843-10f1d1062bdb",
                                        "glosses": [
                                            "In a tragic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2064ad1-7a73-4b6c-b4b0-2f0d6304ff44",
                                                "sense_id": "966bb703-c4bd-3cb7-ab53-c981c71bcd56",
                                                "text": "The history of cast iron in railway bridges is much more grimly chequered. Brunel's misgivings were proved prudent, tragically, in the 1879 failure of Thomas Bouch's Tay bridge (once a monument to cast iron, now a memorial to many lives lost)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
