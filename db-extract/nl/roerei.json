                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214f23c2-ca4c-4cb6-b64f-6518418213ca",
                                "sense_id": "d41fafe9-433b-31be-92d4-cd15ba321c64",
                                "text": "De meeste mensen vinden een roerei lekker."
