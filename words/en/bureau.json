                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Bureau</w> family, who were prominent in the town's history.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Бюро</w>, которая занимала видное место в истории города."
                            }
                        },
                        {
                            "text": "Professor <w>Bureau</w> published a groundbreaking study on the evolution of linguistic structures.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Бюро</w> опубликовал новаторское исследование об эволюции лингвистических структур."
                            }
