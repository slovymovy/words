                "forms": [
                    {
                        "form_id": "97eeea3b-18ab-4362-a49c-33df09cce581",
                        "entry_id": "6c3f8cf8-311c-3a81-b173-306b916880e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "hémolymphes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd7e37a3-a8bf-3238-ba1a-34918911f8c5",
                        "entry_id": "6c3f8cf8-311c-3a81-b173-306b916880e7",
                        "glosses": [
                            "Équivalent du sang chez les arthropodes (insectes, araignées, etc) qui contient entre autres de l’hémocyanine et des nutriments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68fae61-8ad3-4ead-bc86-e4752e2866ff",
                                "sense_id": "bd7e37a3-a8bf-3238-ba1a-34918911f8c5",
                                "text": "L’hémolymphe du Doryphore contient des micronucléocytes au grand pouvoir phagocytant, des macronucléocytes, des oenocytoïdes, des cellules à sphérules et des gouttelettes de graisse."
                            },
                            {
                                "example_id": "3aff15f5-7b89-4084-aae9-1bf80ace3824",
                                "sense_id": "bd7e37a3-a8bf-3238-ba1a-34918911f8c5",
                                "text": "L’origine de la lésion se trouve dans l'écrasement même partiel d'un de ces insectes sur la peau, lorsque de l’hémolymphe y dépose de la pédérine."
                            },
                            {
                                "example_id": "08fd3d57-b061-4309-93b6-1a6c58716a86",
                                "sense_id": "bd7e37a3-a8bf-3238-ba1a-34918911f8c5",
                                "text": "Les œufs du parasite colonisent alors leur hémolymphe (le \"sang\" de la fourmi) et s'y développent sous forme de larves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
