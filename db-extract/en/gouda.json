                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09cae9be-0d8a-4bd6-b178-13195eeb7495",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Frau Gouda ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b0993f6e-4f64-4594-992b-bb1cf2b525b2",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Herr Gouda wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "bf970012-cf58-4c3a-a9cd-48101430a24a",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Die Goudas fahren heute nach Rotterdam."
                                            },
                                            {
                                                "example_id": "17fe16d7-6f9b-421e-b6a9-d905dac1bd96",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Der Gouda trägt nie die Pullover, die die Gouda ihm strickt."
                                            },
                                            {
                                                "example_id": "dab1f1a2-5215-4f3d-8abb-909fbb17d365",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gouda kommt, geht der Herr Gouda.“"
                                            },
                                            {
                                                "example_id": "18b7b13d-2a92-4fe7-885a-b076402d22cb",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Gouda kommt und geht."
                                            },
                                            {
                                                "example_id": "68f612dc-ead9-453e-a9b7-4c226fbbf142",
                                                "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                                "text": "Goudas kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
