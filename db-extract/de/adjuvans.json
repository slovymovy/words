                                        "entry_id": "0ddf0864-0388-3ed5-8d91-654a3ccb35f4",
                                        "glosses": [
                                            "Someone or (more commonly) something that assists, facilitates, or helps; an aid, an assistant, a helper.",
                                            "A substance enhancing the immune response to an antigen."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87bac150-a29d-4877-b76b-ddf19c816b5a",
                                                "sense_id": "7de484f8-5c66-379d-a3ec-73d352f8a0b0",
                                                "text": "The well-known tropic action of immune serum as an adjuvant to phagocytosis suggested early in our studies that we might here be dealing with a similar phenomenon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed73de73-3058-369d-a54e-12565851f6b6",
                                        "entry_id": "0ddf0864-0388-3ed5-8d91-654a3ccb35f4",
                                        "glosses": [
                                            "Someone or (more commonly) something that assists, facilitates, or helps; an aid, an assistant, a helper.",
                                            "A form of therapy or treatment which is additional or supplementary to another, or which enhances the effectiveness of another."
