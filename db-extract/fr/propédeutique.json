                "senses": [
                    {
                        "sense_id": "faf8abcf-2491-3678-9a68-6d29543898b4",
                        "entry_id": "ca200aaf-93c9-31ec-a844-cc0ec80fbb36",
                        "glosses": [
                            "Qui facilite l’apprentissage d’autres choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8baa4d7a-c09b-47d4-9504-7ba473ea0ae1",
                                "sense_id": "faf8abcf-2491-3678-9a68-6d29543898b4",
                                "text": "Des études sur l’enseignement de l’espéranto ont mis en avant une certaine valeur propédeutique à l’apprentissage d’autres langues."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed6673ba-7587-3cad-9501-a232449bd585",
                        "entry_id": "ca200aaf-93c9-31ec-a844-cc0ec80fbb36",
                        "glosses": [
                            "Se dit de périodes d’enseignements, mises en place dans certaines écoles, universités, séminaires, etc., visant à préparer l’élève pour de futurs enseignements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "050488ba-ebda-419d-acad-1b42e1c6af74",
                                "sense_id": "ed6673ba-7587-3cad-9501-a232449bd585",
                                "text": "Ce système permettait, à l’issue de l’année propédeutique, peu spécialisée, une orientation assez libre."
                            },
                            {
                                "example_id": "ebdc31c1-4675-4789-bf97-3950a274c366",
                                "sense_id": "ed6673ba-7587-3cad-9501-a232449bd585",
                                "text": "Dans quelques jours, je vais prendre le bateau pour Dieppe avec R, quitter l'Angleterre, rentrer à Yvetot et m'inscrire en propédeutique à la fac de Rouen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c14fd821-52f5-4f36-b04a-6c0a81ade932",
                        "source_entry_id": "ca200aaf-93c9-31ec-a844-cc0ec80fbb36",
                        "target_lang_word": "propaedeutic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propaedeutic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a254746d-5b2c-319a-abac-c52038dac67e",
                                        "entry_id": "3999dd81-728c-3ca7-a621-7d032d8d4c31",
                                        "glosses": [
                                            "Preparatory or introductory."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54eca7a-1b46-4120-8667-e97cf67c907f",
                                                "sense_id": "a254746d-5b2c-319a-abac-c52038dac67e",
                                                "text": "On the other hand, the German university exhibits a system in which the university course is almost wholly special; the liberal and propædeutic studies are relegated to the grammar-school."
                                            },
                                            {
                                                "example_id": "44064834-8a16-4ff7-b6ae-595fa0bcb9ad",
                                                "sense_id": "a254746d-5b2c-319a-abac-c52038dac67e",
                                                "text": "Students were not allowed to repeat the first propedeutic year more than once or to spend more than six years at universities; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "propaedeutic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54795c3a-a2a6-339f-bd7f-b49e1083e24a",
                                        "entry_id": "b0db427f-8852-3fce-a03e-0df811acc281",
                                        "glosses": [
                                            "An introductory course of instruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9068cca6-074e-4f3c-b33a-14cd4d841fba",
                                                "sense_id": "54795c3a-a2a6-339f-bd7f-b49e1083e24a",
                                                "text": "This chapter aims to be a propedeutic because there are many specific lines of argument that could, and should, be developed from the observation of the unique values-based and globalized-movement nature of co-operatives […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
