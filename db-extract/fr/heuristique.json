                                                "sense_id": "df4148de-0b69-35f3-809c-505118b081e8",
                                                "text": "„Problemspezifische Heuristiken nutzen spezielle Eigenschaften der Problemstruktur und sind deshalb bei Änderungen der Problemstellung oft nicht mehr einsetzbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
