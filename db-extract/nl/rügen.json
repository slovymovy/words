                                                "example_id": "d43bd8dc-1c61-4733-976e-7fff2345f87e",
                                                "sense_id": "08d55754-5b6f-3f68-966c-1d0404ad32a0",
                                                "text": "Rügen liegt in der Ostsee."
                                            },
                                            {
                                                "example_id": "4440a53f-4c8e-4224-8bc6-793cf2c1529e",
                                                "sense_id": "08d55754-5b6f-3f68-966c-1d0404ad32a0",
                                                "text": "Das Lagerfeuer auf Rügen erlosch erst am frühen Morgen."
                                            }
