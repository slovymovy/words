                    {
                        "sense_id": "29dcb669-ffca-369e-ba9a-a7e91dc14637",
                        "entry_id": "7b05ca4f-91bf-3d68-a986-da9418731616",
                        "glosses": [
                            "Action d’immoler une personne humaine ou animale."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "9f47b698-9a73-4327-98fa-d1ee569fc62c",
                                "sense_id": "29dcb669-ffca-369e-ba9a-a7e91dc14637",
                                "text": "Il importe de bien comprendre la nouveauté représentée par l’idée que la création s’effectue par une immolation ou une auto-immolation. Les mythologies précédentes connaissaient surtout le type de création à partir d’une substance primordiale façonnée par le dieu."
                            },
                            {
                                "example_id": "88d2c997-5c72-467d-b8de-991936a27d87",
                                "sense_id": "29dcb669-ffca-369e-ba9a-a7e91dc14637",
                                "text": "L’immolation d’Iphigénie."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfb63a2c-4c60-3be2-992c-1135d539735d",
                        "entry_id": "7b05ca4f-91bf-3d68-a986-da9418731616",
                        "glosses": [
                            "Action de s’immoler soi-même, de consentir au sacrifice de soi ; auto-immolation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c6f87c-d4f4-4ddd-a6aa-27f29f4f341c",
                                "sense_id": "bfb63a2c-4c60-3be2-992c-1135d539735d",
                                "text": "L’immolation de Jésus."
                            },
                            {
                                "example_id": "ad8f9892-51de-4034-ba89-4bc0cf130b59",
                                "sense_id": "bfb63a2c-4c60-3be2-992c-1135d539735d",
                                "text": "Sentiment d’immolation."
                            }
                        ]
