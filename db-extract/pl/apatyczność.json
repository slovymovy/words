                            {
                                "example_id": "4685718c-039d-43af-bcd5-836c9c022cc2",
                                "sense_id": "15d5a660-e1ec-3526-b58c-fbc494a94b67",
                                "text": "O ile piérwsza energiczna jest i żywa, o tyle temperament drugiéj przedstawia najpiękniejszy exemplarz flegmy i apatyczności."
                            }
