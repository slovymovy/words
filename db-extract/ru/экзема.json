                                        "glosses": [
                                            "nieinfekcyjny stan zapalny głównie wierzchniej warstwy skóry objawiający się świądem, zaczerwienieniem, pęcherzykami i złuszczaniem naskórka"
                                        ],
                                        "tags": [],
