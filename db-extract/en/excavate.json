                                    },
                                    {
                                        "sense_id": "ce896ca1-5a9e-3355-a1ce-d884293f332b",
                                        "entry_id": "58d74eee-96b8-39a4-9312-8ebc87e9b78a",
                                        "glosses": [
                                            "het wezenlijke wegnemen van"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca36bce-32c6-4b3b-b8a1-6097580cb8b1",
                                                "sense_id": "ce896ca1-5a9e-3355-a1ce-d884293f332b",
                                                "text": "De strategie van radicaal-rechts in Brussel – de EU „van binnenuit uithollen”, zoals PVV-leider Wilders die omschreef – spoort dus deels met die van Moskou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9500d2-6145-4644-8760-36ea5043575b",
                        "source_entry_id": "4dc2da7b-f95d-3ef6-9c1d-85440ad8845a",
                        "source_sense_description": "to make a hole in (something); to hollow",
                        "target_lang_word": "excaver",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excaver",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d273fe7b-0c05-355b-bcd0-2d1a3124c690",
                                        "entry_id": "398370e4-1298-3e7d-9f90-446589e2200d",
                                        "glosses": [
                                            "Creuser la terre pour ouvrir un chenal, une fosse, un tunnel, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad57be9d-6508-4dbf-b6f9-2d0cb3c89c13",
                                                "sense_id": "d273fe7b-0c05-355b-bcd0-2d1a3124c690",
                                                "text": "Ils faisaient partie de l’équipe originale qui avait excavé le fossile."
                                            },
                                            {
                                                "example_id": "c4c3ee78-f678-4d6f-b8d0-371579aa8c19",
                                                "sense_id": "d273fe7b-0c05-355b-bcd0-2d1a3124c690",
                                                "text": "Pour agrandir ces quatre fenêtres, il avait fallu excaver des murs de huit à dix pieds d’épaisseur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da6f745c-f037-30ee-9783-b1f953379124",
                                        "entry_id": "398370e4-1298-3e7d-9f90-446589e2200d",
                                        "glosses": [
                                            "Creuser, trouer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ea37a15-e316-4a21-8590-770be1e1c903",
                                                "sense_id": "da6f745c-f037-30ee-9783-b1f953379124",
                                                "text": "La moindre semence de légumineuse, souvent pas plus grosse qu’une tête d’épingle, nourrit sa Bruche, un nain, qui patiemment la gruge, l’excave en habitacle ; et lui, le dodu, l’exquis, serait épargné !"
                                            },
                                            {
                                                "example_id": "870cd016-5d08-47d1-9ed3-23a554d212f4",
                                                "sense_id": "da6f745c-f037-30ee-9783-b1f953379124",
                                                "text": "Et le pli de ruisseau asséché qui excave, après l’amour, la paupière inférieure, et cette flamme avinée qui ne s’éteint pas assez vite sur des traits mûrs qu’elle consume…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
