                                    {
                                        "sense_id": "ee209048-e52b-370f-aa03-df94a6ddc7e8",
                                        "entry_id": "9823cf0a-2509-3e2e-a0e9-57a9b70bf7dd",
                                        "glosses": [
                                            "Boldly self-assured; confident without being aggressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2decc952-0573-46c3-bd9a-c56e469d85f9",
                                                "sense_id": "ee209048-e52b-370f-aa03-df94a6ddc7e8",
                                                "text": "Hence the ubiquity of Priapus himself as a sculptural representative of the generative principle, populated the Roman gardens, assertive in ithyphallic pose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838de59d-9c80-375d-9121-cf35f3778fc2",
