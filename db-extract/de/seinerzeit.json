                            {
                                "example_id": "e09c6db2-1f46-40a3-8a14-abe00b44e1f5",
                                "sense_id": "4b28f838-b273-3f2f-8f3a-bdb8c56e2b7d",
                                "text": "1964 kamen die Beatles zum ersten Mal in die USA. Seinerzeit galt ihre Musik noch als wild."
                            },
                            {
                                "example_id": "99d780b3-cf76-4a61-b13d-dec5c06bb4de",
                                "sense_id": "4b28f838-b273-3f2f-8f3a-bdb8c56e2b7d",
                                "text": "„Ados Vater war seinerzeit einer der Pioniere.“"
                            },
                            {
                                "example_id": "5fa74ca7-0b29-4203-b41c-2d3dd7ff6e38",
                                "sense_id": "4b28f838-b273-3f2f-8f3a-bdb8c56e2b7d",
                                "text": "„Interessant ist, daß das geographische Namensgut, das die deutschen Forschungsreisenden seinerzeit vergeben hatten, heute noch Gültigkeit hat und nur die Gattungsnamen (zum Beispiel für ›Spitze‹, ›Gletscher‹ usw.) englisch wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2fe122c3-f3ea-35ff-8c9a-d2bdc439f15d",
                        "entry_id": "3813393c-ede8-3d2b-a6a8-7515ed03655d",
