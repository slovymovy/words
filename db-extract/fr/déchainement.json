                                        "entry_id": "f00988ae-735d-30f6-bf5f-3fd2eaf7c24c",
                                        "glosses": [
                                            "A sudden, often violent expression of emotion or activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c52a8c-705c-4060-9e48-73a5f6e30b19",
                                                "sense_id": "792cf6e8-7ef7-369f-8758-0f880bc61ce0",
                                                "text": "The man greeted us with an outburst of invective."
                                            },
                                            {
                                                "example_id": "77321e81-00f3-4f33-85b4-a7b424308b55",
                                                "sense_id": "792cf6e8-7ef7-369f-8758-0f880bc61ce0",
