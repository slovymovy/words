                "senses": [
                    {
                        "sense_id": "cef3d916-ae15-3e58-aa59-37a04a613952",
                        "entry_id": "9e8264ac-b4c9-3909-826d-4ed0adcf0aef",
                        "glosses": [
                            "Mannschaftskapitän, insbesondere in der Sportart Curling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257ab46e-ed88-4aa5-aeba-7ef9fb0ccf79",
                                "sense_id": "cef3d916-ae15-3e58-aa59-37a04a613952",
                                "text": "Der Fourth spielt die beiden letzten Steine. Diese Aufgabe ist besonders anspruchsvoll und wird meist vom Skip wahrgenommen."
                            },
                            {
                                "example_id": "7b866c89-2af1-45de-8a5a-fa9dc9fc21b6",
                                "sense_id": "cef3d916-ae15-3e58-aa59-37a04a613952",
                                "text": "Das Team um Skip Daniela Jentsch vom CC Füssen und Klara-Hermine Fomm vom 1. SCV Geising als Ersatz hatte in Kanada zwischenzeitlich auf die Play-offs hoffen können."
                            },
                            {
                                "example_id": "d637a492-189e-4619-b3a2-ab36cd4dde12",
                                "sense_id": "cef3d916-ae15-3e58-aa59-37a04a613952",
                                "text": "Deutschland mit Skip Andy Kapp hatte gegen die Chinesen am Freitag im Viertelfinale nach lange ausgeglichenem Spiel letztlich mit 3:8 den Kürzeren gezogen."
                            },
                            {
                                "example_id": "57c2f710-9119-4435-a57b-00b9ddc1747a",
                                "sense_id": "cef3d916-ae15-3e58-aa59-37a04a613952",
                                "text": "Der Skip (Kapitän) des österreichischen Nationalteams, der mit seiner Truppe vom Aufstieg in die Elite-Gruppe träumt, hat schon eine 3:9-Niederlage gegen Irland hinnehmen müssen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac1cab05-3024-4630-8dda-a82d11c91165",
                        "source_entry_id": "9e8264ac-b4c9-3909-826d-4ed0adcf0aef",
                        "source_sense_id": "cef3d916-ae15-3e58-aa59-37a04a613952",
