                "senses": [
                    {
                        "sense_id": "bd0f7e82-10d7-3316-8014-bfb3b3d20eb8",
                        "entry_id": "113a65c8-c3c9-3883-99c9-b1416de3ea75",
                        "glosses": [
                            "het prepareren van een hoeveelheid stof met een bekend gewicht door weging met een weegschaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287bbb2e-f4ef-4b3d-8ac6-5201fb2c672d",
                                "sense_id": "bd0f7e82-10d7-3316-8014-bfb3b3d20eb8",
                                "text": "De stoechiometrie van het reactiemengsel werd door afweging bepaald."
                            }
                        ]
                    },
                    {
                        "sense_id": "92198953-9b83-32ca-a69c-756ef83cb898",
                        "entry_id": "113a65c8-c3c9-3883-99c9-b1416de3ea75",
                        "glosses": [
                            "het nauwkeurig nagaan van de voor- en de nadelen van een bepaalde beslissing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0940b5-0778-4ff2-9a01-bcb31b5f20e3",
                                "sense_id": "92198953-9b83-32ca-a69c-756ef83cb898",
                                "text": "Helaas werd deze mogelijkheid niet in de afweging meegenomen."
                            },
                            {
                                "example_id": "7f1a415b-ad47-40fd-a13b-4edb61e69c75",
                                "sense_id": "92198953-9b83-32ca-a69c-756ef83cb898",
                                "text": "Kwam het door haar reactie daarop dat hij de andere bedreigingen nu geheim wilde houden? Maar dacht hij nou echt dat het voor die gevoelige Karin het beste was om het niet te weten? Tot het laatste moment, ongeacht hoe dat eruit zou zien? Wat zat er achter die afweging? De ene vraag leidde tot een tweede en een derde."
                            },
                            {
                                "example_id": "df75d306-8645-4046-a741-7d38837977b8",
                                "sense_id": "92198953-9b83-32ca-a69c-756ef83cb898",
                                "text": "Wat ook meespeelde in mijn afweging om mijn verblijf te verlengen, was het feit dat ik na een paar dagen in Mondriaan voor het eerst sinds het overlijden van David weer eens nachten doorsliep, en dat zelfs zonder wodka en oxazepam."
                            }
                        ]
                    }
                ],
