                ],
                "senses": [
                    {
                        "sense_id": "6d5645fe-569c-36a8-a07d-56ede36edfc8",
                        "entry_id": "9ff0c365-5fa7-3229-bcc2-d486b2dce07f",
                        "glosses": [
                            "торг. относящийся к финансированию новых, неапробированных проектов; связанный с коммерческим риском"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "408a23ac-658b-49d5-a486-8ab8ce8e8dfd",
                        "source_entry_id": "9ff0c365-5fa7-3229-bcc2-d486b2dce07f",
                        "source_sense_id": "6d5645fe-569c-36a8-a07d-56ede36edfc8",
                        "target_lang_word": "venture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "venture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d76cf40-1c42-3710-9ec1-c77ed3089f29",
                                        "entry_id": "e75b8b41-113e-340e-9904-65928fb1361b",
                                        "glosses": [
                                            "A risky or daring undertaking or journey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d17f03a-2dba-4e18-bc71-b9390b1a2bbf",
                                                "sense_id": "7d76cf40-1c42-3710-9ec1-c77ed3089f29",
                                                "text": "My heart was beating finely when we two set forth in the cold night upon this dangerous venture."
                                            },
                                            {
                                                "example_id": "16e3f3f3-a5c7-48f4-afeb-6424f50dddd2",
                                                "sense_id": "7d76cf40-1c42-3710-9ec1-c77ed3089f29",
                                                "text": "Other jobs which the governor entrusted to Ch'ao-tung dealt with the economic exploitation of the newly won mountain areas. In the Miao-li region, Ch'ao-tung headed an office for developing the petroleum resources discovered there.³⁸ Without much success during his tenure, the venture was later turned over to private entrepreneurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06516a2c-b0d3-3ec9-b88e-458029010f64",
                                        "entry_id": "e75b8b41-113e-340e-9904-65928fb1361b",
                                        "glosses": [
                                            "An event that is not, or cannot be, foreseen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2aec694-b808-4af5-b566-4d12fb5fb648",
                                                "sense_id": "06516a2c-b0d3-3ec9-b88e-458029010f64",
                                                "text": "A certain man drew a bow at a venture and smote the king of Israel between the joints of the harness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c319416-3c88-3f8d-892a-ef3be9b0ca70",
                                        "entry_id": "e75b8b41-113e-340e-9904-65928fb1361b",
                                        "glosses": [
                                            "The thing risked; especially, something sent to sea in trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1653fa2f-b5e9-4dba-a576-3e698793e06b",
                                                "sense_id": "9c319416-3c88-3f8d-892a-ef3be9b0ca70",
                                                "text": "My ventures are not in one bottom trusted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "venture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3db051-0e96-344e-9da3-da28c2dbe282",
                                        "entry_id": "38894e6f-7ad1-3c42-856b-ee9d2e71aa4c",
                                        "glosses": [
                                            "To undertake a risky or daring journey."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97059938-4599-42fb-aab9-10d0c443d755",
                                                "sense_id": "7e3db051-0e96-344e-9da3-da28c2dbe282",
                                                "text": "who freights a ship to venture on the seas"
                                            },
                                            {
                                                "example_id": "40249016-de9e-4eb3-b1d2-c839ec53b0aa",
                                                "sense_id": "7e3db051-0e96-344e-9da3-da28c2dbe282",
                                                "text": "A hero ventures forth from the world of common day into a region of supernatural wonder: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                        "entry_id": "38894e6f-7ad1-3c42-856b-ee9d2e71aa4c",
                                        "glosses": [
                                            "To risk or offer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c0ab298-0a65-4460-bfdb-6116b26d44e1",
                                                "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                                "text": "to venture funds"
                                            },
                                            {
                                                "example_id": "d6902510-5dcf-4bb4-a89b-f60e46d2f91c",
                                                "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                                "text": "to venture a guess"
                                            },
                                            {
                                                "example_id": "12f365c0-6f3b-465c-8ab8-f54810fa96c9",
                                                "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                                "text": "Nothing ventured, nothing gained."
                                            },
                                            {
                                                "example_id": "99f6ceff-efd6-4963-9f23-36f1118f8f8e",
                                                "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                                "text": "I am afraid; and yet I'll venture it."
                                            },
                                            {
                                                "example_id": "1cd3a580-9668-4685-a122-1f100dd47a6c",
                                                "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                                "text": "Till then they had only exchanged glances of the most casual but now under the brim of her new hat she ventured a look at him and the face that met her gaze there in the twilight, wan and strangely drawn, seemed to her the saddest she had ever seen."
                                            },
                                            {
                                                "example_id": "dadf7263-2ab5-47e9-8a45-f343d3a0684c",
                                                "sense_id": "2e0db767-2ea6-3041-a307-01c0a81f06dd",
                                                "text": "[...] Mrs. Bray [...] expressed amazement at the speed with which the station was completed, and ventured the opinion that private contractors could still learn something from the railway companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adfbc47d-9a5c-309d-84bf-71196fab01d1",
                                        "entry_id": "38894e6f-7ad1-3c42-856b-ee9d2e71aa4c",
                                        "glosses": [
                                            "To dare to engage in; to attempt without any certainty of success."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2def00ba-a37d-3551-9698-82762c1f318d",
                                        "entry_id": "38894e6f-7ad1-3c42-856b-ee9d2e71aa4c",
                                        "glosses": [
                                            "To put or send on a venture or chance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b397ce-2de1-4b40-9186-11b4b96650b4",
                                                "sense_id": "2def00ba-a37d-3551-9698-82762c1f318d",
                                                "text": "to venture a horse to the West Indies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "431310b6-12ee-35ba-8f81-a74b3c69ff76",
                                        "entry_id": "38894e6f-7ad1-3c42-856b-ee9d2e71aa4c",
                                        "glosses": [
                                            "To confide in; to rely on; to trust."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e848647-a17b-470d-ad51-45ee4a881f7e",
                                                "sense_id": "431310b6-12ee-35ba-8f81-a74b3c69ff76",
                                                "text": "A man would be well enough pleased to buy silks of one whom he would not venture to feel his pulse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d34c149c-1766-3ab3-b60d-e208af1dcefb",
                                        "entry_id": "38894e6f-7ad1-3c42-856b-ee9d2e71aa4c",
                                        "glosses": [
                                            "To say something; to offer an opinion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314af705-2995-45ad-b6f6-6384339d0e2f",
                                                "sense_id": "d34c149c-1766-3ab3-b60d-e208af1dcefb",
                                                "text": "“Unctuous is probably quite a good description, but there's a sweetness, too, and a mouthfeel,” ventures Heston Blumenthal, chef at the Fat Duck at Bray."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
