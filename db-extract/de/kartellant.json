                "senses": [
                    {
                        "sense_id": "aba2adbd-fc29-3772-ae32-0c402f752ec1",
                        "entry_id": "419183bf-d159-3831-b2b3-4014dcdc50e1",
                        "glosses": [
                            "an einem Kartell Beteiligter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07dc38e-a232-417c-bfab-e23b021c6f5d",
                                "sense_id": "aba2adbd-fc29-3772-ae32-0c402f752ec1",
                                "text": "„Ziel des Preisdiktates mußte es dann sein, allen Kartellanten außer einem mindestens angemessenen Gewinn auch die Erhaltung aller Anlagen einschließlich der ungenutzten Kapazitäten zu sichern.“"
                            },
                            {
                                "example_id": "41ee4f4f-48eb-443b-a7c6-4a0aab768186",
                                "sense_id": "aba2adbd-fc29-3772-ae32-0c402f752ec1",
                                "text": "„Eine Preiserhöhung wird vorgenommen, wenn die Kartellanten überzeugt sind, daß höhere Preise für Schmuckdiamanten von Dauer sind.“"
                            },
                            {
                                "example_id": "3273d987-fa34-4dae-a155-4f8c60f9411d",
                                "sense_id": "aba2adbd-fc29-3772-ae32-0c402f752ec1",
                                "text": "„Wir finden es gut und richtig, dass grundsätzlich jedem Kartellanten auch die zivilrechtliche Haftung gegenüber den Kartellopfern droht.“"
                            },
                            {
                                "example_id": "0ca06614-0208-41dd-afe6-4d8f151f5c12",
                                "sense_id": "aba2adbd-fc29-3772-ae32-0c402f752ec1",
                                "text": "„Das Bundeskartellamt kritisiert, dass die Deutsche Bahn es durch die Zusage fester Liefermengen ab 1995 den Kartellanten leicht gemacht habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
