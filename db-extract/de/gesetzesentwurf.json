                "senses": [
                    {
                        "sense_id": "b080cf27-c869-3898-b80c-7c7332a268d5",
                        "entry_id": "0f7894da-6cc9-3a1f-8b20-fc6bd6e79570",
                        "glosses": [
                            "erste Version eines Gesetzestextes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "196d9146-c96c-4b97-9c79-5d0c89cb3797",
                                "sense_id": "b080cf27-c869-3898-b80c-7c7332a268d5",
                                "text": "Der Gesetzesentwurf sieht vor, dass alle Millionäre 100 Prozent mehr Steuern bezahlen müssen und dass die Leute, die unter der Armutsgrenze leben, von der Steuer befreit sind."
                            },
                            {
                                "example_id": "21cec460-8b98-483c-a51b-7598fe1e2335",
                                "sense_id": "b080cf27-c869-3898-b80c-7c7332a268d5",
                                "text": "„Ein entsprechender Passus soll in den Gesetzesentwurf zur Modernisierung des Steuerverfahrens eingefügt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c452c3a6-37b2-4492-bc26-598deb45663f",
                        "source_entry_id": "0f7894da-6cc9-3a1f-8b20-fc6bd6e79570",
                        "source_sense_id": "b080cf27-c869-3898-b80c-7c7332a268d5",
