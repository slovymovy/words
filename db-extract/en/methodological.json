                        "cross_references": []
                    },
                    {
                        "translation_id": "ab3a5d21-4bc7-474e-b5e9-e8d917c0b486",
                        "source_entry_id": "07c80c5b-142a-3389-a583-d8c3b62bb8b7",
                        "source_sense_id": "ce9c61e4-bca1-34c0-a37d-dac97cd97089",
                        "source_sense_description": "of, pertaining to, or using methodology",
                        "target_lang_word": "méthodologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méthodologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86d81c9e-3a31-3ba7-8159-6f7e36f927a7",
                                        "entry_id": "9fec1fcc-43b1-3a48-8c49-a22a2aa19a55",
                                        "glosses": [
                                            "Qui concerne la méthodologie, la méthode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e9169c8-b166-41dc-b877-3a299f4c5a19",
                                                "sense_id": "86d81c9e-3a31-3ba7-8159-6f7e36f927a7",
                                                "text": "La science politique est l'une des sciences humaines. A ce titre elle ne saurait échapper aux embarras d'ordre épistémologique, méthodologique, zététique et autres, propres à ces disciplines, ni à leur destin."
                                            },
                                            {
                                                "example_id": "8fca2d6c-b83c-49ac-bf30-8abd7b77f773",
                                                "sense_id": "86d81c9e-3a31-3ba7-8159-6f7e36f927a7",
                                                "text": "Une telle synthétisation de la théorie implique un haut degré d'unité des explications fournies, de la cohérence philosophique, conceptuelle et méthodologique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa1c24ed-806e-461f-9b41-8bfb86c34460",
                        "source_entry_id": "07c80c5b-142a-3389-a583-d8c3b62bb8b7",
                        "source_sense_id": "ce9c61e4-bca1-34c0-a37d-dac97cd97089",
                        "source_sense_description": "of, pertaining to, or using methodology",
                        "target_lang_word": "methodologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "methodologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5d17f2-9ba4-3458-aeab-8245153eee30",
                                        "entry_id": "b934c7a7-e79c-32c3-b14d-3bb4f591c1f5",
                                        "glosses": [
                                            "die Methodologie betreffend; zur Methodenlehre gehörend; auf einer Methodologie beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98b6d751-b407-41d3-abc1-1d2750ec23ee",
                                                "sense_id": "4d5d17f2-9ba4-3458-aeab-8245153eee30",
                                                "text": "Ein Projektleiter benötigt methodologische Kompetenz um ein Projekt mit den korrekten Methoden zu leiten."
                                            },
                                            {
                                                "example_id": "d8c54ea9-6888-4967-9830-6aba86222300",
                                                "sense_id": "4d5d17f2-9ba4-3458-aeab-8245153eee30",
                                                "text": "Auch wenn die Studie methodologisch hinterfragbar wäre, weisen Statistiken der UN darauf hin, dass mittlerweile jeder Zweite an den Folgen des Konflikts leidet."
                                            },
                                            {
                                                "example_id": "c6815d2b-57dc-4b20-a741-9dde815181c4",
                                                "sense_id": "4d5d17f2-9ba4-3458-aeab-8245153eee30",
                                                "text": "Dieses Buch setzt in mancherlei Weise für die Geschichtsforschung theoretisch wie methodologisch neue Akzente und Maßstäbe."
                                            },
                                            {
                                                "example_id": "ad66fe2b-21dd-4ccb-931f-29d3fda726ae",
                                                "sense_id": "4d5d17f2-9ba4-3458-aeab-8245153eee30",
                                                "text": "„Die methodologischen Ungereimtheiten zwischen einem weiten Unentgeltlichkeitsbegriff und der Lückenschließung im Wege der Analogie zeigen sich besonders an dem Beschluß des Großen Senats des Reichsgerichts vom 30.01.1940 zum Begriff der Unentgeltlichkeit bei § 988 BGB, in dem es darum ging, ob im Rahmen des § 988 BGB die Rechtsgrundlosigkeit unter den Tatbestand der Unentgeltlichkeit zu fassen sei.“"
                                            },
                                            {
                                                "example_id": "27da4bc0-ff8c-4b15-ad73-bfaa074b9804",
                                                "sense_id": "4d5d17f2-9ba4-3458-aeab-8245153eee30",
                                                "text": "„Die Fähigkeit des Sprechers, über die Regeln der Sprache nachzudenken und somit seine eigene Sprache wie auch die der anderen zu beurteilen, hat in der linguistischen Theoriebildung methodologisch eine wichtige Rolle gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
