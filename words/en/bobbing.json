    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9799ce28-f607-30af-b385-18c821ab0a81",
                    "sense_definition": "present participle and gerund of <w>bob</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small fishing boat was <w>bobbing</w> up and down gently on the calm water.",
                            "target_lang_translations": {
                                "ru": "Небольшая рыбацкая лодка мягко <w>покачивалась</w> вверх и вниз на спокойной воде."
                            }
                        },
                        {
                            "text": "Several corks were <w>bobbing</w> near the shore after the storm passed.",
                            "target_lang_translations": {
                                "ru": "Несколько пробок <w>качались на волнах</w> у берега после того, как утих шторм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bobbing up and down"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола bob; быстро качаться или подскакивать вверх и вниз (часто на воде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качающийся",
                                "target_lang_sense_clarification": "на воде или ветру"
                            },
                            {
                                "target_lang_word": "подпрыгивающий",
                                "target_lang_sense_clarification": "вверх и вниз"
                            },
                            {
                                "target_lang_word": "покачивание",
                                "target_lang_sense_clarification": "в роли герундия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d20bb802-4d0d-3260-b624-ae9adf2c3998",
                    "sense_definition": "A repetitive, quick up-and-down or bouncing motion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rhythmic <w>bobbing</w> of the cork signaled that a fish was biting.",
                            "target_lang_translations": {
                                "ru": "Ритмичное <w>подёргивание</w> поплавка сигнализировало о том, что клюёт рыба."
                            }
                        },
                        {
                            "text": "She watched the gentle <w>bobbing</w> of the sailboats tied to the harbor pier.",
                            "target_lang_translations": {
                                "ru": "Она наблюдала за мягким <w>покачиванием</w> парусников, привязанных к пирсу в гавани."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gentle bobbing",
                        "rhythmic bobbing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторяющееся быстрое движение вверх и вниз или покачивание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покачивание",
                                "target_lang_sense_clarification": "плавное или ритмичное движение вверх-вниз"
                            },
                            {
                                "target_lang_word": "подпрыгивание",
                                "target_lang_sense_clarification": "резкие движения вверх-вниз"
                            },
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "на волнах или поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
