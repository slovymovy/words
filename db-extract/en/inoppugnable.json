                    },
                    {
                        "form_id": "9c351efe-ef20-4cfb-ad5b-dcc09a023676",
                        "entry_id": "b45acc81-2cba-3dd8-b104-3ff0894995c0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most inoppugnable"
