                        "entry_id": "11397548-5154-37e5-a580-e4ec500d4aae",
                        "glosses": [
                            "Patronen mit einem Durchmesser ab 9 Millimetern"
                        ],
                        "tags": [
                            "von Feuerwaffen"
                        ],
                        "examples": [
                            {
                                "example_id": "0a61221b-9357-47ef-afc7-87844f4b3a52",
                                "sense_id": "6c03a460-7d50-3d44-a45a-dd25da739945",
                                "text": "„Ich habe mal auf 300 Meter mit dem Großkaliber geschossen.“"
                            },
                            {
                                "example_id": "233a3fbd-5356-4cfe-b352-7be5cf6ebb98",
                                "sense_id": "6c03a460-7d50-3d44-a45a-dd25da739945",
                                "text": "„Die meisten Polizisten in Deutschland tragen 9-Millimeter-Waffen – ein Großkaliber, das stets Todesgefahr birgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "12751afe-ce12-3646-8bc3-383ddb4ef92f",
                        "entry_id": "11397548-5154-37e5-a580-e4ec500d4aae",
                        "glosses": [
                            "jemand oder etwas von besonderer Stellung oder Bedeutsamkeit"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ba99f7ea-02ed-4a18-af14-25e7168f22d6",
                                "sense_id": "12751afe-ce12-3646-8bc3-383ddb4ef92f",
                                "text": "„Auf den glücklosen Juristen Rohner folgt ein Großkaliber aus der Bankenwelt.“"
                            },
                            {
                                "example_id": "d40c7c6a-82e5-414a-aae7-9845c0008f55",
                                "sense_id": "12751afe-ce12-3646-8bc3-383ddb4ef92f",
                                "text": "„Denn ‚This is All Yours‘ ist ein Großkaliber wie schon das Debütalbum ‚An Awesome Wave‘ (2012), mit der gleichen hymnenartigen Qualität.“"
                            },
                            {
                                "example_id": "b905b75f-ec60-41d0-a6cd-70dcfae33a7c",
                                "sense_id": "12751afe-ce12-3646-8bc3-383ddb4ef92f",
                                "text": "„Unter der Glaskuppel des Grand Palais rivalisieren die internationalen Großkaliber mit Prunkwerken ihrer Klassiker […].“"
                            },
                            {
                                "example_id": "5e3d661c-1d90-4d25-95d1-ba69a47705f1",
                                "sense_id": "12751afe-ce12-3646-8bc3-383ddb4ef92f",
                                "text": "„Der FC Bayern wird im Champions-League-Achtelfinale von den Großkalibern verschont und trifft stattdessen auf Besiktas.“"
                            },
                            {
                                "example_id": "0f0daf25-6fa4-44c5-8458-184aa8711f7d",
                                "sense_id": "12751afe-ce12-3646-8bc3-383ddb4ef92f",
                                "text": "„Eintracht-Sportdirektor Bruno Hübner sprach schon am Donnerstag respektvoll von ‚Großkalibern, die wieder richtig ins Rollen gekommen sind‘.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
