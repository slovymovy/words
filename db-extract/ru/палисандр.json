                        "glosses": [
                            "спец. ценная твёрдая древесина некоторых южноафриканских тропических деревьев красивого красновато-коричневого, тёмно-розового или фиолетового цвета, которая используется для изготовления дорогих столярных изделий и музыкальных инструментов"
                        ],
