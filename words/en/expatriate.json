                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moving_abroad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regime sought to <w>expatriate</w> all political dissidents."
