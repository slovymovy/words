                "senses": [
                    {
                        "sense_id": "385f99ef-cd7f-36c7-9b40-e78212c493e8",
                        "entry_id": "42f37a4a-67e4-3c59-998f-ada540ce0de7",
                        "glosses": [
                            "Donner un caractère rappelant Kandahar à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9ed4bd-7927-4e7f-a9b6-576cd375598e",
                                "sense_id": "385f99ef-cd7f-36c7-9b40-e78212c493e8",
                                "text": "Le Maroc n’est pas l’Afghanistan et ceux qui veulent Kandahariser nos villes n’y réussiront pas."
                            },
                            {
                                "example_id": "68c00361-6c8d-4f3d-98c2-66e89a1e2ada",
                                "sense_id": "385f99ef-cd7f-36c7-9b40-e78212c493e8",
                                "text": "Une autre analyse, ils veulent kandaharisé ^([sic : kandahariser]) ou kashmirisé ^([sic : kashmiriser]) la kabyle ^([sic : Kabylie]) par un forcing islamique et répression politique, en cas d´un changement au pouvoir ou passation de regime ^([sic : régime]) à la nouvelle conquete ^([sic : conquête]) arabo-islamiste en 2012, déjà vu ^([sic : vue]) en Tunisie, Libye, Maroc, Egypte ^([sic : Égypte]) et la dernière strategie ^([sic : stratégie]) C ^([sic : c’est]) l´Algerie ^([sic : l’Algérie]) !"
                            }
                        ]
                    }
