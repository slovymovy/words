                                            {
                                                "example_id": "e59353a0-2e7e-4203-9216-4c45e8d5ec95",
                                                "sense_id": "eb13e848-6c65-34e5-afd7-b5a2e57d9fa1",
                                                "text": "Nigdy nie wyjdę za mąż, aby nie stać się niewolnicą."
