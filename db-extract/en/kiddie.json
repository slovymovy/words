                                            {
                                                "example_id": "cb1a2047-67af-4fd9-8fcb-75ea5573001f",
                                                "sense_id": "96328685-d3c6-3f5c-b697-01a7c9d83e35",
                                                "text": "τα παιδιά δεν πρέπει να παρακολουθούν σκηνές βίας"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bfcf11d-87f8-3689-8b1b-1758d8a7f6ea",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "το νεαρό άτομο που δεν έχει περάσει τα νόμιμα όρια της ενηλικίωσης"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d3e7815-cc0d-4e0b-b078-16c49e02bfe2",
                                                "sense_id": "2bfcf11d-87f8-3689-8b1b-1758d8a7f6ea",
                                                "text": "τα παιδιά δεν ψηφίζουν"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "776b6618-7de1-338d-8c8d-f015c7ee4b93",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "το νεαρό άτομο με εμφανίσιμα κι ελκυστικά χαρακτηριστικά"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c919e57d-a94d-4d2c-84cf-334c36291748",
                                                "sense_id": "776b6618-7de1-338d-8c8d-f015c7ee4b93",
                                                "text": "ο Κωνσταντίνος είναι ωραίο παιδί"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce3df24-89b9-3b94-a65e-525f7909baf0",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "το τέκνο, ο γόνος, ο γιος ή η κόρη"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d133f7e7-01ed-4fa9-ace8-446b24c785ff",
                                                "sense_id": "bce3df24-89b9-3b94-a65e-525f7909baf0",
                                                "text": "οι γονείς οφείλουν να φροντίζουν την υγεία των παιδιών τους"
                                            },
                                            {
                                                "example_id": "5ed0455b-a11b-479d-aa8b-82bca8ea9574",
                                                "sense_id": "bce3df24-89b9-3b94-a65e-525f7909baf0",
                                                "text": "(παρωχημένο) το αγόρι σε αντιδιαστολή προς το κορίτσι"
                                            },
                                            {
                                                "example_id": "7c675326-c6da-4169-a019-6908a4d781b9",
                                                "sense_id": "bce3df24-89b9-3b94-a65e-525f7909baf0",
                                                "text": "είχε δύο παιδιά και τρία κορίτσια"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7abb9048-af94-3a68-9137-f8e083f94c08",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "ο απόγονος"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c44c5e5-4620-48fb-ad69-c677d817f6d9",
                                                "sense_id": "7abb9048-af94-3a68-9137-f8e083f94c08",
                                                "text": "είμαστε παιδιά γενναίων πολεμιστών και σπουδαίων ανθρώπων"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de955ac-ddee-3a3a-bdc0-50ff1beae16a",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "το νεογνό, ο νεοσσός"
                                        ],
