                    {
                        "translation_id": "0cb8021a-982a-41b1-b72f-3aacf1617221",
                        "source_entry_id": "97396064-c911-3af8-90c7-cb0dd5d14b7a",
                        "source_sense_description": "the quality of being long-lasting, especially of life",
                        "target_lang_word": "longévité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "longévité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb93a0d-bf14-3f0a-aa3e-5be0931a9ea7",
                                        "entry_id": "4975aaab-b3f0-32e8-b9a8-244076fc832b",
                                        "glosses": [
                                            "Longue durée de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b3d4bda-fbe7-473e-a917-8e68ee15add2",
                                                "sense_id": "cdb93a0d-bf14-3f0a-aa3e-5be0931a9ea7",
                                                "text": "À l’état naturel, les résineux comme les feuillus ont une grande puissance de conquête et une grande longévité."
                                            },
                                            {
                                                "example_id": "a341e1cf-d2f9-4cf6-81f0-81080e584328",
                                                "sense_id": "cdb93a0d-bf14-3f0a-aa3e-5be0931a9ea7",
                                                "text": "En uxorilocalité par contre l’homme est mal à l’aise et la femme plus en confort : le surplus de longévité est pour cette dernière. Néolocalité mise à part on peut donc dire que chaque conjoint a, envers son espérance de vie, intérêt à établir ménage auprès de ses proches."
                                            },
                                            {
                                                "example_id": "b23e4071-522e-4bc7-854e-e1d93cc9a633",
                                                "sense_id": "cdb93a0d-bf14-3f0a-aa3e-5be0931a9ea7",
                                                "text": "Tables de longévité, tableaux statistiques concernant la durée de la vie humaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed352ac4-a8de-412b-8764-56aa98c1a18a",
                        "source_entry_id": "97396064-c911-3af8-90c7-cb0dd5d14b7a",
                        "source_sense_description": "the quality of being long-lasting, especially of life",
                        "target_lang_word": "Langlebigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langlebigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2705234-6ced-31ea-b50c-68aec48c7a50",
                                        "entry_id": "dd08fd15-6745-3c1d-8aae-509c1c322809",
                                        "glosses": [
                                            "Eigenschaft, ein langes Leben zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce370d8-ca64-4b57-bbb0-b44988d9e412",
                                                "sense_id": "a2705234-6ced-31ea-b50c-68aec48c7a50",
                                                "text": "„Im Igue-Ritual werden diese mystischen Herrscherkräfte der Fruchtbarkeit, Gesundheit und Langlebigkeit erneuert, indem man seinen Ehi stärkt.“"
                                            },
                                            {
                                                "example_id": "e788f866-9c5e-4cef-80c8-b8d28272b212",
                                                "sense_id": "a2705234-6ced-31ea-b50c-68aec48c7a50",
                                                "text": "„Eigentlich sollte man daher erwarten, dass die Gattungen der Gibbons oder kleinen Menschenaffen aufgrund ihres geringeren Körpergewichtes durchgehend niedrigere Langlebigkeiten aufweisen als die grossen Menschenaffen.“"
                                            },
                                            {
                                                "example_id": "66835ad3-61a2-4f1f-8ad3-b74cad8b0419",
                                                "sense_id": "a2705234-6ced-31ea-b50c-68aec48c7a50",
                                                "text": "„Man plauderte geraume Zeit, dann regte die Schwägerin Wu bei Frau Mondtraut an, das Kind bringen und der alten Dame zeigen zu lassen, damit sie ihm Langlebigkeit erflehe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad7db82d-f639-3041-921e-4062b427d38c",
                                        "entry_id": "dd08fd15-6745-3c1d-8aae-509c1c322809",
                                        "glosses": [
                                            "Eigenschaft, lange zu überdauern/lange zu funktionieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ebc1243-1de8-4418-92aa-ea346ecd73e7",
                                                "sense_id": "ad7db82d-f639-3041-921e-4062b427d38c",
                                                "text": "Überschrift: „Langlebigkeiten radioaktiver Substanzen lassen sich verringern.“"
                                            },
                                            {
                                                "example_id": "4c82e079-d5d7-42da-a636-b450db1f2997",
                                                "sense_id": "ad7db82d-f639-3041-921e-4062b427d38c",
                                                "text": "Die Langlebigkeit mancher Autotypen lässt noch zu wünschen übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
