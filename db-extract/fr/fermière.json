                    {
                        "sense_id": "0a7316e7-1586-3dbd-9973-910704399704",
                        "entry_id": "451f7aa0-996e-3ccc-aeae-42519fab3308",
                        "glosses": [
                            "Agricultrice, personne qui travaille la terre."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "614b87b5-00c5-4851-9c00-31210af5efb3",
                                "sense_id": "0a7316e7-1586-3dbd-9973-910704399704",
                                "text": "Je me désélégantise, je me désuavise, je vais devenir une vraie cuisinière, une fermière, ou tout ce que vous voudrez, et c’est effrayant à quel point je me trouve faite pour cela."
                            },
                            {
                                "example_id": "8c4f754d-67f8-46ab-95f0-5f7b3b3836fc",
                                "sense_id": "0a7316e7-1586-3dbd-9973-910704399704",
                                "text": "Pour avoir de beaux légumes, la fermière doit faire en sorte qu’ils n’aient jamais à souffrir de la sécheresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "eba40085-6a4d-3fa5-967c-eae9d3f42b23",
                        "entry_id": "451f7aa0-996e-3ccc-aeae-42519fab3308",
                        "glosses": [
                            "Celle qui tient à ferme une propriété agricole."
