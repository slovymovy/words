{
    "word_family": [
        "cling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1debc691-64ae-33ed-8be5-6b452b55c608",
                    "sense_definition": "Describing clothing that fits very tightly to the body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_fit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>clingy</w> dress to the party.",
                            "target_lang_translations": {
                                "cs": "Na večírek si vzala <w>přiléhavé</w> šaty."
                            }
                        },
                        {
                            "text": "The fabric of the shirt was very <w>clingy</w> after it came out of the dryer.",
                            "target_lang_translations": {
                                "cs": "Látka košile byla po vytažení ze sušičky velmi <w>přilnavá</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clinging",
                        "close-fitting"
                    ],
                    "common_phrases": [
                        "clingy fabric",
                        "clingy dress"
                    ],
                    "target_lang_definitions": {
                        "cs": "Oblečení, které těsně přiléhá k tělu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přiléhavý",
                                "target_lang_sense_clarification": "obecné označení pro těsně padnoucí oblečení"
                            },
                            {
                                "target_lang_word": "obepnutý",
                                "target_lang_sense_clarification": "zdůrazňuje, že látka těsně obepíná postavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20474b35-756c-3a7e-a65c-6b7f57e11dbe",
                    "sense_definition": "Describing a person who is overly dependent on or possessive of another person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavioral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt overwhelmed by his <w>clingy</w> partner who wanted to spend every minute together.",
                            "target_lang_translations": {
                                "cs": "Cítil se zahlcený svou <w>citově závislou</w> partnerkou, která chtěla trávit každou minutu spolu."
                            }
                        },
                        {
                            "text": "The toddler became very <w>clingy</w> when his mother tried to leave him at daycare.",
                            "target_lang_translations": {
                                "cs": "Batole se stalo velmi <w>upnutým</w>, když ho matka zkusila nechat ve školce."
                            }
                        }
                    ],
                    "synonyms": [
                        "overattached"
                    ],
                    "common_phrases": [
                        "clingy person",
                        "clingy behavior"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která je příliš závislá na druhých nebo majetnická."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "závislý",
                                "target_lang_sense_clarification": "citově závislý na jiné osobě"
                            },
                            {
                                "target_lang_word": "upnutý",
                                "target_lang_sense_clarification": "v přeneseném významu o člověku, který se někoho drží"
                            },
                            {
                                "target_lang_word": "majetnický",
                                "target_lang_sense_clarification": "v kontextu partnerských vztahů"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}