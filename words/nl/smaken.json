                            {
                                "target_lang_word": "быть на вкус",
                                "target_lang_sense_clarification": "иметь определенные вкусовые качества"
                            },
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "иметь привкус чего-либо"
                            }
                        ]
