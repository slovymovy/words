                                        "sense_id": "c088f16d-c453-332f-9505-a667a2b9556c",
                                        "entry_id": "9d43483d-b366-3775-8f39-cd4c5acfaf06",
                                        "glosses": [
                                            "bogini ogniska domowego oraz świętego i wiecznego ognia, utożsamiana z rzymską Westą, symbol domu i rodziny"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0277b8f-a904-431b-8123-613b942847ce",
                                                "sense_id": "c088f16d-c453-332f-9505-a667a2b9556c",
                                                "text": "Hestia uchodziła za córkę Kronosa i Rei oraz siostrę Zeusa, Hadesa, Posejdona, Hery i Demeter."
                                            },
                                            {
                                                "example_id": "ab859d94-48a1-4879-bd19-5caa9a8f260f",
                                                "sense_id": "c088f16d-c453-332f-9505-a667a2b9556c",
                                                "text": "Hestia ustąpiła Dionizosowi swoje miejsce w gronie dwunastu największych bóstw olimpijskich"
                                            },
                                            {
                                                "example_id": "e933929c-6459-40b7-9f7e-25a98ecbf8fb",
                                                "sense_id": "c088f16d-c453-332f-9505-a667a2b9556c",
                                                "text": "Kult Hestii sprawowano we wszystkich domostwach i w świątyniach wszystkich bogów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "4d9a4889-6fb0-377b-afcb-47ae7493f270",
                                        "entry_id": "9d43483d-b366-3775-8f39-cd4c5acfaf06",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2795e9c7-069d-4d33-971e-13d7e1563755",
                                                "sense_id": "4d9a4889-6fb0-377b-afcb-47ae7493f270",
                                                "text": "Moja babka wujeczna, która jest Polką greckiego pochodzenia, ma na imię Hestia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "7198033b-8d4c-3ddf-bc75-9648754f5b19",
                                        "entry_id": "9d43483d-b366-3775-8f39-cd4c5acfaf06",
                                        "glosses": [
                                            "planetoida o numerze katalogowym 46"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
