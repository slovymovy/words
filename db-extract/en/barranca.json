                        "sense_id": "d9734c2a-5c57-30cd-9c20-01d35b740ad0",
                        "entry_id": "0d700071-0113-361e-b083-101f76846378",
                        "glosses": [
                            "A steep-sided gulch or arroyo; a canyon or ravine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e8df58-f258-4b69-ad21-6291b56617a5",
                                "sense_id": "d9734c2a-5c57-30cd-9c20-01d35b740ad0",
                                "text": "“Well: hardly,” said the Consul, softly as before, casting a suspicious eye for his part in the other direction at some maguey growing beyond the barranca, like a battalion moving up a slope under machine-gun fire."
                            },
                            {
                                "example_id": "b34455c5-cbcf-44e2-951a-7a6dbacf18f0",
                                "sense_id": "d9734c2a-5c57-30cd-9c20-01d35b740ad0",
                                "text": "Have you ever been south of Monterey? / Barrancas carve the coastline / And the chaparral flows to the sea / 'Neath waves of golden sunshine"
                            },
                            {
                                "example_id": "274e41b4-abba-4ef0-9126-f5ff0546fb3c",
                                "sense_id": "d9734c2a-5c57-30cd-9c20-01d35b740ad0",
                                "text": "[…]his hero, the Consul, is shot and thrown down the barranca followed by a dead dog."
                            }
                        ]
                    }
                ],
