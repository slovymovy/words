                },
                {
                    "sense_id": "066bd280-2383-349e-9900-6e2b8833ecca",
                    "sense_definition": "A job or position of employment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He traveled to the city in hopes of finding a <w>situation</w> as a clerk.",
                            "target_lang_translations": {
                                "ru": "Он отправился в город в надежде найти <w>должность</w> клерка.",
                                "pl": "Udał się do miasta z nadzieją na znalezienie <w>posady</w> urzędnika."
                            }
                        },
                        {
                            "text": "The newspaper listed several vacant <w>situations</w> for experienced domestic staff.",
                            "target_lang_translations": {
                                "ru": "В газете было перечислено несколько вакантных <w>должностей</w> для опытной домашней прислуги.",
                                "pl": "W gazecie wymieniono kilka wolnych <w>miejsc</w> pracy dla doświadczonej służby domowej."
                            }
                        }
                    ],
                    "synonyms": [
                        "post",
                        "position",
                        "job",
                        "employment"
                    ],
