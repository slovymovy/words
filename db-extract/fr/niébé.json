                        "examples": [
                            {
                                "example_id": "dace3e8f-a106-4dc6-bff9-8f303e0763c3",
                                "sense_id": "c4413d69-8e87-39c9-bcf2-da4e2f5c8098",
                                "text": "Le genre Vigna est d’origine asiatique… Le niébé est parfois utilisé comme fourrage (en Inde par exemple) ou cultivé pour un usage textile (cultigroupe textilis). Les feuilles et les jeunes pousses peuvent être consommées en épinards. Les gousses sont parfois mangées en vert. Les fanes peuvent être utilisées comme fourrages… — (Cirad/Gret/MAE, Mémento de l'Agronome, 1 692 pages, page 869, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                            },
                            {
                                "example_id": "f95bafa6-aafc-4ff2-b40c-98a914572f93",
                                "sense_id": "c4413d69-8e87-39c9-bcf2-da4e2f5c8098",
                                "text": "En RDC, de plus en plus les agriculteurs s’adonnent à la culture de niébé."
                            },
                            {
                                "example_id": "6231ddad-6389-4fc9-92c7-1e81c11a042a",
                                "sense_id": "c4413d69-8e87-39c9-bcf2-da4e2f5c8098",
                                "text": "Les exportateurs sont des agents dont le rôle principal est de collecter le niébé pour le revendre sur les marchés extérieurs."
                            },
                            {
                                "example_id": "5fccfcdb-8980-4fd4-8fdd-6e899364017e",
                                "sense_id": "c4413d69-8e87-39c9-bcf2-da4e2f5c8098",
                                "text": "Dans une grande quantité de champs, les espoirs de bonne récolte pour les cultures pluviales (mil, sorgho, fonio, maïs, arachide, sésame, niébé) pourraient être compromis."
                            },
                            {
                                "example_id": "d113e319-16ef-421c-a3c7-0aeaba88d5c7",
                                "sense_id": "c4413d69-8e87-39c9-bcf2-da4e2f5c8098",
                                "text": "Consciente que cette victoire sur le coton Bt n’est qu’un répit, elle s’inquiète de la culture du niébé, un haricot riche en protéines largement consommé par la population burkinabé."
                            },
                            {
                                "example_id": "17287b4b-122f-45ab-83f6-bd2debe5c69a",
                                "sense_id": "c4413d69-8e87-39c9-bcf2-da4e2f5c8098",
                                "text": "Les gousses de niébé d’un jaune tendre se dispersent dans l’air avant de disparaître dans les herbes sèches."
                            }
                        ]
                    }
