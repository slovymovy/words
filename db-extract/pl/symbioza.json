                                        "entry_id": "5ac8fd00-fba9-3c5c-ae9c-21fc8051517a",
                                        "glosses": [
                                            "The close and long-term relationship or interaction between two or more different species in which at least one of the organisms benefit.",
                                            "The close and long-tern relationship or interaction between two or more different species in which all organisms benefit; mutualism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e966716a-9b64-4623-97a2-1291f5ced259",
                                                "sense_id": "9ea491e8-ab02-3d0d-bc44-494430c854f5",
                                                "text": "Bees and flowers display symbiosis. The bees get nectar and the flowers get pollinated"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "825fc8a0-4b64-31bd-abbc-653c0697169f",
                                        "entry_id": "5ac8fd00-fba9-3c5c-ae9c-21fc8051517a",
                                        "glosses": [
                                            "The state of people of different types, races, cultures, communities, etc., living together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bfd9cb1-b60c-3bb2-a34e-d61ef29feffd",
                                        "entry_id": "5ac8fd00-fba9-3c5c-ae9c-21fc8051517a",
                                        "glosses": [
                                            "The occurrence of two different or opposing things in the same time and place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a5c3ae-6141-4f87-ab21-56d330f5039d",
                                                "sense_id": "2bfd9cb1-b60c-3bb2-a34e-d61ef29feffd",
                                                "text": "In this peculiar and deadly symbiosis the presence of warfare stimulates trade and the presence of trade stimulates warfare."
                                            }
                                        ]
                                    }
