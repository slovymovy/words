                ],
                "senses": [
                    {
                        "sense_id": "5b18f1d4-acb1-34e0-a9bd-b2e1fe17fe5f",
                        "entry_id": "e698c0fc-b9ea-3ccc-b766-b3d747e062a9",
                        "glosses": [
                            "kleiner, schmal zulaufender Fortsatz, Endstück (bei Textilien, Kleidungsstücken oder Ähnlichem); kleiner Zipfel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb53e327-e59d-44f0-aecf-5f93e969c914",
                                "sense_id": "5b18f1d4-acb1-34e0-a9bd-b2e1fe17fe5f",
                                "text": "„Oben schaute ein Zipfelchen Hemd heraus.“"
                            },
                            {
                                "example_id": "97844d66-72fb-4ec0-9cde-705635dae169",
                                "sense_id": "5b18f1d4-acb1-34e0-a9bd-b2e1fe17fe5f",
                                "text": "„Aus der linken Faust ragte unter der Kuppe des Ringfingers ein winziges Zipfelchen hervor. Was war das? Ein Stofffetzen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "afa0311b-eabb-31fd-b762-6342f31d384f",
                        "entry_id": "e698c0fc-b9ea-3ccc-b766-b3d747e062a9",
                        "glosses": [
                            "kleines Stück, kleine Menge, kleiner Teil von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "653cc400-2910-46bd-839b-f3cf870999c1",
                                "sense_id": "afa0311b-eabb-31fd-b762-6342f31d384f",
                                "text": "„Im Vergleich zu früher ist das nur ein Zipfelchen Macht.“"
                            },
                            {
                                "example_id": "14dd133e-43f2-49d8-89ae-df7c43dc177b",
                                "sense_id": "afa0311b-eabb-31fd-b762-6342f31d384f",
                                "text": "„Das zwanzigste Jahrhundert ist ein weites Feld, auf dem sich viele Ästhetiken und Ideologien tummeln, von denen man in der Berliner Schau immer nur ein Zipfelchen zu sehen bekommt.“"
                            },
                            {
                                "example_id": "9dfd89c3-7860-40a1-b107-e631675ba84c",
                                "sense_id": "afa0311b-eabb-31fd-b762-6342f31d384f",
                                "text": "„Im Frieden von Utrecht erhielten die Engländer dieses exotische Zipfelchen am Mittelmeer zugesprochen. Gibraltar, für die Briten als Marine- und Militärstützpunkt strategisch bedeutsam – und dazu als Steuerparadies –, war immer wieder ein Stein des Anstoßes für Spanien.“"
                            },
                            {
                                "example_id": "f241d986-4994-4291-bc45-77ebe312c4be",
                                "sense_id": "afa0311b-eabb-31fd-b762-6342f31d384f",
                                "text": "„Die Insel ist ein kleines Zipfelchen Deutschland, mit dem der Wind und das Meer spielen und es andauernd ein bisschen verändern.“"
                            },
                            {
                                "example_id": "ac3e004a-c4d8-4a66-8d7b-86a73470c815",
                                "sense_id": "afa0311b-eabb-31fd-b762-6342f31d384f",
                                "text": "„Stattdessen lüftete der Regierungschef ein kleines Zipfelchen von dem Geheimnis, mit dem er die geplante Vertrauensfrage umgeben hat […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
