                "translations": [
                    {
                        "translation_id": "806ce1b8-dfae-4e48-857c-cba7b6468265",
                        "source_entry_id": "5e21c7c5-d1eb-37ec-8251-6ae8bef3699d",
                        "source_sense_id": "b47df382-baea-334f-abc6-59d0cb07bd21",
                        "source_sense_description": "Sänger mit der tiefsten männlichen Stimmlage",
                        "target_lang_word": "basse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2cc557f-dfff-3147-b39f-93a17cef8194",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Ligne mélodique qui contient les notes les plus graves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0292aaf6-e9e4-4e69-8a4d-a1e750be5456",
                                                "sense_id": "e2cc557f-dfff-3147-b39f-93a17cef8194",
                                                "text": "Lulli fut le premier en France qui fit des basses."
                                            },
                                            {
                                                "example_id": "ce00016a-6929-4c4f-929b-2f7f57e86cfd",
                                                "sense_id": "e2cc557f-dfff-3147-b39f-93a17cef8194",
                                                "text": "Composer la basse d’un air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65d60a29-4c77-36ea-89b3-f54dc45012a4",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Note la plus grave d'un accord."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Voix propre à chanter la partie de basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5226c9-c7b1-426a-8a35-98319c13727c",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "Cet homme a une belle basse."
                                            },
                                            {
                                                "example_id": "cb7a8c6d-df20-483d-a5f6-4feff6503e93",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "Et Gorillon la basse et Grandin le fausset."
                                            },
                                            {
                                                "example_id": "d742e9d0-78fe-4d25-b144-f9c8bca9a54d",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "Il m’a cité l’exemple d’un chantre de Notre-Dame (je crois que c’était une basse), à qui un rhume avait fait perdre entièrement la voix."
                                            },
                                            {
                                                "example_id": "a2f69fa2-a62d-4688-9347-d0a4ee8948ef",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "David Rizzio avait une voix de basse agréable."
                                            },
                                            {
                                                "example_id": "fcb8d816-e488-438c-8770-c3567970f29c",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "Des gros chantres, les veines du cou gonflées, faisaient sonner leurs basses profondes, ayant l’air de tirer les notes de leurs talons."
                                            },
                                            {
                                                "example_id": "b30a12a2-c316-4d0b-8b88-94b8b9c0f57d",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "Doucement, les basses !…"
                                            },
                                            {
                                                "example_id": "3985cf10-a146-4141-bfd1-732e6b64f8d8",
                                                "sense_id": "2ae7f212-d9ca-3610-94bd-e62dbc7389a6",
                                                "text": "« Si je vous dis : “Doucement les basses !” c’est doucement les basses. Le choléra est une saloperie, mais le reste est un saloperie encore pire. Ne faites pas le cocardier. » — (Jean Giono, Le hussard sur le toit, 1951, réédition Folio Plus, page 125)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74ed09d2-e819-3de0-a970-40207acf8ec1",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Personne qui a une voix de basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500f047f-d35a-442c-8cea-4c367a9be7e4",
                                                "sense_id": "74ed09d2-e819-3de0-a970-40207acf8ec1",
                                                "text": "C’est la basse qui a le rôle le plus important dans cet opéra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6b08c88-84a5-336a-a7b5-bc08d687dd26",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Violoncelle, nommé basse, parce qu’il joue le plus souvent la basse dans les symphonies et les quatuors ou trios. Ou autre instrument, comme un cuivre, qui sert à exécuter la basse dans les morceaux à plusieurs parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e908dad5-8412-43bc-922f-745050e35da1",
                                                "sense_id": "d6b08c88-84a5-336a-a7b5-bc08d687dd26",
                                                "text": "Jouer de la basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43785dc-7cd4-352b-88d8-05596903f681",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Personne qui joue de cet instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f8c1f9-a7c4-4dfc-b0bc-56ea28e6d55a",
                                                "sense_id": "f43785dc-7cd4-352b-88d8-05596903f681",
                                                "text": "C'est une bonne basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca52942-3863-3112-8c17-1ae0d79950b2",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Dans un orchestre de jazz, ellipse fréquemment utilisée pour nommer la contrebasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b44085-fe9b-4378-8d30-a893dc6a59f6",
                                                "sense_id": "fca52942-3863-3112-8c17-1ae0d79950b2",
                                                "text": "Rien de plus drôle et de plus émouvant que ce mariage forcé entre la basse et la batterie, les deux plus gros instruments (portables, ce qui exclut le piano) de l’orchestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f058c0b6-33b7-32c0-98ff-72a65697ea1a",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Abréviation de guitare basse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c2a6a60-afe3-3664-97b5-64b6418b72ab",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Grosses cordes de certains instruments."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e1a6b81-c9d0-4e01-9fde-7cac808c7ffe",
                                                "sense_id": "2c2a6a60-afe3-3664-97b5-64b6418b72ab",
                                                "text": "Les basses de ce piano ne sont pas d’accord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47601629-a4b4-3e10-aa33-d3028cd62976",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Banc de rochers ou de corail dangereux pour la navigation car situé proche de la surface de la mer sans pour autant affleurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4569769f-27bc-4de5-8346-2e1262134f3a",
                                                "sense_id": "47601629-a4b4-3e10-aa33-d3028cd62976",
                                                "text": "Entre le 21e et le 23e parallèle austral, et par quarante-quatre degrés environ de longitude occidentale du méridien de Paris, il faut se méfier d’un haut fond qui n’est marqué ni sur la carte française, ni sur la carte hollandaise. Ce sont les basses de Saint-Thomas : basses fort dangereuses de mauvais temps, le haut du banc n’ayant que de trois à quatre brasses d’eau."
                                            },
                                            {
                                                "example_id": "099172a3-0cf9-4cd2-a491-5d2adc63c483",
                                                "sense_id": "47601629-a4b4-3e10-aa33-d3028cd62976",
                                                "text": "Le Gannec était le meilleur pêcheur du Ploc’h, et le plus intrépide marin de toute la côte. Aucun dont la chaloupe fût mieux armée, aucun qui connût comme lui les basses poissonneuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5abae9-84d9-3d42-a19c-06fab052e60d",
                                        "entry_id": "d2f6a97a-034f-3bfd-9931-53481ea02c6c",
                                        "glosses": [
                                            "Vallée, surtout perpendiculaire à une vallée principale."
                                        ],
                                        "tags": [
                                            "Vosges",
                                            "Toponymie"
                                        ],
                                        "note": "prononcé localement \\bɑːs\\, parfois \\bɛs\\",
                                        "examples": [
                                            {
                                                "example_id": "d890189d-db61-4797-94e7-bc3a3fa4a8a5",
                                                "sense_id": "4b5abae9-84d9-3d42-a19c-06fab052e60d",
                                                "text": "La forêt présente un important réseau hydrographique avec deux cours d’eau principaux, le Rabodeau et la Ravine, alimentés par de nombreux ruisseaux secondaires qui prennent naissance au sein des nombreuses « basses » humides de la forêt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "basse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b021981-8fa6-38d1-b2c6-e54963ac64de",
                                        "entry_id": "a861ddd4-e105-3972-8dc0-d31e6c430112",
                                        "glosses": [
                                            "Grand baquet utiliser pour porter le raisin pendant les vendanges."
                                        ],
                                        "tags": [
                                            "Vendée",
                                            "Poitou",
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd685cc8-1577-4dee-881c-7746edf6d8d4",
                                                "sense_id": "5b021981-8fa6-38d1-b2c6-e54963ac64de",
                                                "text": "La hotte pleine, le porteur de hotte montait par la petite échelle sur la voiture et la vidait dans une basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fd495f-4c7a-3505-bdf5-d750adf41741",
