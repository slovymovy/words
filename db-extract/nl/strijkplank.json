                        "sense_id": "750760f5-0625-356d-8516-bbf95488fd8e",
                        "entry_id": "4d60bb00-ba78-3825-aded-7bd3fc59ac18",
                        "glosses": [
                            "een plankvormig voorwerp, gewoonlijk op een inklapbaar onderstel, bedoeld als ondergrond waarop kleding gestreken kan worden"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "0d066244-78b3-4309-83d4-52d28d795fad",
                                "sense_id": "750760f5-0625-356d-8516-bbf95488fd8e",
                                "text": "Ik zal even de strijkplank pakken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39a0b0b6-5922-4614-b00c-2fe4d0ea2f7d",
                        "source_entry_id": "4d60bb00-ba78-3825-aded-7bd3fc59ac18",
                        "source_sense_id": "750760f5-0625-356d-8516-bbf95488fd8e",
                        "source_sense_description": "een plankvormig voorwerp, gewoonlijk op een inklapbaar onderstel, bedoeld als ondergrond waarop kleding gestreken kan worden",
                        "target_lang_word": "Bügelbrett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bügelbrett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2dfdaba9-01ba-31af-ade2-a13e9aa2d350",
                                        "entry_id": "f3aded6a-8274-35bd-a63a-2a446b3566c7",
                                        "glosses": [
                                            "mit einem gepolsterten Stoffüberzug versehenes Brett, das als Unterlage zum Bügeln von Wäsche und Kleidung dient; das Brett ist in der Regel auf einem höhenverstellbaren und zusammenklappbaren Gestell befestigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a44a15-ebd2-4ccf-819c-1f797de8176e",
                                                "sense_id": "2dfdaba9-01ba-31af-ade2-a13e9aa2d350",
                                                "text": "„Justin leistete ihr häufig Gesellschaft und sah ihr bei ihrer Arbeit zu. Die Ellenbogen auf das lange Bügelbrett gestützt, auf dem sie plättete, betrachtete er lüstern alle die um ihn herum aufgeschichtete Damenwäsche, die Pikee-Unterröcke, die Spitzentücher, die Halskragen, die breithüftigen Unterhosen.“"
                                            },
                                            {
                                                "example_id": "62dd2638-bc48-4e63-8969-574fb595306d",
                                                "sense_id": "2dfdaba9-01ba-31af-ade2-a13e9aa2d350",
                                                "text": "„Mit zwanzig war sie verheiratet, mit 25 Mutter von zwei Töchtern, kaum ein Text über sie kommt ohne den Hinweis aus, dass ihre Schreibmaschine in der Wäschekammer stand, zwischen Waschmaschine, Trockner, Bügelbrett.“"
                                            },
                                            {
                                                "example_id": "c9c234a2-eef3-4aa7-b457-40495086e5f3",
                                                "sense_id": "2dfdaba9-01ba-31af-ade2-a13e9aa2d350",
                                                "text": "„Später, als sie in der Wäscherei wieder an ihrem Bügelbrett stand, hörte sie ihn noch einmal das sagen, was sie nicht hatte hören wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
