                    {
                        "sense_id": "40d2e951-9087-3f94-b1b8-ce5f35c0e5c5",
                        "entry_id": "ec8465f5-5927-3279-acfa-d41635b5cdc5",
                        "glosses": [
                            "To become a liquid; to liquefy."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3d4b79bc-dd3e-4f49-865d-eb6190da31fd",
                                "sense_id": "40d2e951-9087-3f94-b1b8-ce5f35c0e5c5",
                                "text": "2011, James McCreet, The Thieves' Labyrinth\nIt is, of course, the nature of the London fog to descend and liquesce at its own whim. Merely two hours later, Waterloo-bridge presented an entirely different scene."
                            }
                        ]
                    },
                    {
                        "sense_id": "f946595c-b947-31d3-82fa-6c90a586d407",
                        "entry_id": "ec8465f5-5927-3279-acfa-d41635b5cdc5",
                        "glosses": [
                            "to become more like a liquid"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9dba410f-d334-4d7e-9d56-b2db048b6706",
                                "sense_id": "f946595c-b947-31d3-82fa-6c90a586d407",
                                "text": "At many points notes liquesce like the liquid letters, so that the interval from one note to another is begun with a smooth glide and does not appear to have a stopping place en route."
                            }
                        ]
                    }
