                    {
                        "sense_id": "681e14e5-981e-3b6e-bd18-426587ef1803",
                        "entry_id": "880307f2-58dc-3376-a5e7-934fa7dcd0fd",
                        "glosses": [
                            "To be quavered or modulated; to be uttered melodiously."
