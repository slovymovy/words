                                        "sense_id": "527f8d8b-4e15-3132-a59c-64282550e163",
                                        "entry_id": "5ac1a680-e330-3eff-b277-5f0a04f1e7df",
                                        "glosses": [
                                            "A specialized piece of film equipment resembling a little cart on which a camera is mounted."
