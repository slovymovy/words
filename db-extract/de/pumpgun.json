                "senses": [
                    {
                        "sense_id": "107e6448-f9b4-3e5e-ba0f-65bb06e483f4",
                        "entry_id": "25631eab-f78f-38ed-9c86-cc217cfa4086",
                        "glosses": [
                            "mehrschüssige Flinte, bei der durch Zurückziehen des Vorderschaftes repetiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece397f0-b978-4057-85c8-01aa485c1829",
                                "sense_id": "107e6448-f9b4-3e5e-ba0f-65bb06e483f4",
                                "text": "Die Einbrecher waren mit Pumpguns bewaffnet."
                            },
                            {
                                "example_id": "d5e6d61d-883f-4ac1-9115-9e3b3fc7c8a8",
                                "sense_id": "107e6448-f9b4-3e5e-ba0f-65bb06e483f4",
                                "text": "„In den Wohnungen der Männer in Simmering und Ottakring wurden zahlreiche, teils verbotene Waffen wie eine Pumpgun, Schlagringe sowie Schlagstöcke als auch Schusswaffen sichergestellt.“"
                            },
                            {
                                "example_id": "98a8658c-5756-4bd3-ad43-6935bd744245",
                                "sense_id": "107e6448-f9b4-3e5e-ba0f-65bb06e483f4",
                                "text": "„Die Polizisten ließen die Schäferhunde los und luden ihre Pumpguns durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
