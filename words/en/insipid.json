{
    "word_family": [
        "insipidity",
        "insipidly",
        "insipidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4df1bdaa-5044-35cb-b447-376bef0c2855",
                    "sense_definition": "Lacking flavor or taste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diners were disappointed with the plain, <w>insipid</w> soup they were served.",
                            "target_lang_translations": {
                                "de": "Die Gäste waren enttäuscht von der einfachen, <w>faden</w> Suppe, die ihnen serviert wurde."
                            }
                        },
                        {
                            "text": "I drank a glass of slightly <w>insipid</w> wine that lacked any real character.",
                            "target_lang_translations": {
                                "de": "Ich trank ein Glas leicht <w>faden</w> Wein, dem es an echtem Charakter fehlte."
                            }
                        }
                    ],
                    "synonyms": [
                        "bland",
                        "flavorless",
                        "tasteless",
                        "watery"
                    ],
                    "antonyms": [
                        "savory",
                        "sapid"
                    ],
                    "common_phrases": [
                        "insipid soup",
                        "insipid wine"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Geschmack oder Aroma; fad."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "Bezieht sich auf Speisen und Getränke, die wenig oder keinen Geschmack haben."
                            },
                            {
                                "target_lang_word": "lasch",
                                "target_lang_sense_clarification": "Regional gebräuchlich für ungewürzt oder schal schmeckende Speisen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74b2155e-90b5-328c-a410-f78c7c60aa97",
                    "sense_definition": "Lacking interest, character, or excitement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The textbook had a most <w>insipid</w> presentation of the complex historical controversy.",
                            "target_lang_translations": {
                                "de": "Das Lehrbuch bot eine äußerst <w>geistlose</w> Darstellung der komplexen historischen Kontroverse."
                            }
                        },
                        {
                            "text": "The party was just a pageant of <w>insipid</w> nonsense that bored everyone present.",
                            "target_lang_translations": {
                                "de": "Die Party war nur eine Aneinanderreihung von <w>geistlosem</w> Unsinn, der alle Anwesenden langweilte."
                            }
                        }
                    ],
                    "synonyms": [
                        "boring",
                        "dull",
                        "vapid",
                        "tame"
                    ],
                    "common_phrases": [
                        "insipid nonsense",
                        "insipid presentation"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne Interesse, Charakter oder Begeisterung; langweilig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "geistlos",
                                "target_lang_sense_clarification": "Beschreibt etwas, dem es an neuen Ideen oder intellektuellem Anspruch mangelt."
                            },
                            {
                                "target_lang_word": "stumpfsinnig",
                                "target_lang_sense_clarification": "Beschreibt eine Tätigkeit oder Haltung, die durch Monotonie und Mangel an geistiger Anregung gekennzeichnet ist."
                            },
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "Kann auch auf Ereignisse oder Unterhaltungen angewendet werden, die durch mangelnde Abwechslung langweilig sind."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}