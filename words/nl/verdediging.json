                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verteidigung",
                                "target_lang_sense_clarification": "im Sport oder Militär"
                            },
                            {
                                "target_lang_word": "Abwehr",
                                "target_lang_sense_clarification": "Hintermannschaft im Sport"
                            },
                            {
                                "target_lang_word": "Defensive",
                                "target_lang_sense_clarification": "taktische Ausrichtung oder Mannschaftsteil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc3d0c87-e8a7-37e5-a327-671022707bb5",
                    "sense_definition": "De advocaat of groep advocaten die een verdachte bijstaat in een rechtszaak.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verdediging</w> vroeg de rechter om vrijspraak voor de verdachte.",
                            "target_lang_translations": {
                                "ru": "<w>Защита</w> попросила судью об оправдании обвиняемого.",
                                "en": "The <w>defense</w> asked the judge for the suspect's acquittal.",
                                "de": "Die <w>Verteidigung</w> bat den Richter um Freispruch für den Verdächtigen."
                            }
                        },
                        {
                            "text": "Na de pauze was het woord aan de <w>verdediging</w>.",
                            "target_lang_translations": {
                                "ru": "После перерыва слово было предоставлено <w>защите</w>.",
                                "en": "After the break, the <w>defense</w> had the floor.",
                                "de": "Nach der Pause hatte die <w>Verteidigung</w> das Wort."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het woord is aan de verdediging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Адвокат или группа адвокатов, представляющих обвиняемого в суде.",
                        "en": "The lawyer or group of lawyers representing a suspect in a court case.",
                        "de": "Der Anwalt oder die Gruppe von Anwälten, die einen Angeklagten in einem Gerichtsverfahren unterstützen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "defense",
                                "target_lang_sense_clarification": "legal counsel"
                            },
                            {
                                "target_lang_word": "defence",
                                "target_lang_sense_clarification": "UK spelling"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verteidigung",
                                "target_lang_sense_clarification": "Gesamtheit der Verteidiger vor Gericht"
                            },
                            {
                                "target_lang_word": "Strafverteidigung",
                                "target_lang_sense_clarification": "juristische Vertretung des Angeklagten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f2fee8-cead-327a-8ee9-c8d58f1914e6",
                    "sense_definition": "Een betoog, verklaring of geschrift bedoeld om iemand vrij te pleiten of een standpunt te rechtvaardigen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voerde dit argument aan ter <w>verdediging</w> van zijn daden.",
                            "target_lang_translations": {
                                "ru": "Он привел этот аргумент в <w>защиту</w> своих действий.",
                                "en": "He presented this argument in <w>defense</w> of his actions.",
                                "de": "Er brachte dieses Argument zur <w>Verteidigung</w> seiner Taten vor."
                            }
                        },
                        {
                            "text": "Haar <w>verdediging</w> was niet overtuigend genoeg voor de commissie.",
                            "target_lang_translations": {
                                "ru": "Ее <w>защита</w> была недостаточно убедительной для комиссии.",
                                "en": "Her <w>defense</w> was not convincing enough for the committee.",
                                "de": "Ihre <w>Verteidigung</w> war für den Ausschuss nicht überzeugend genug."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ter verdediging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Речь, заявление или текст, предназначенные для оправдания кого-либо или обоснования точки зрения.",
                        "en": "An argument, statement, or writing intended to clear someone of blame or justify a viewpoint.",
                        "de": "Eine Rede, Erklärung oder ein Schriftstück, das dazu dient, jemanden zu entlasten oder einen Standpunkt zu rechtfertigen."
                    },
