                        "glosses": [
                            "A camp or village of tents in a North African country."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5bcc79d-41aa-49db-9d19-a08abfa29e74",
                                "sense_id": "4e620846-d8ba-3c53-b690-f812d29e4e9e",
                                "text": "“A slave would be the better word,” she answered. “I was stolen in the night from my father’s douar by a band of marauders. They brought me here and sold me to the Arab who keeps this café.”"
                            },
                            {
                                "example_id": "6ba0a6b2-cfc1-44a2-bc08-48c9ad3ffc21",
                                "sense_id": "4e620846-d8ba-3c53-b690-f812d29e4e9e",
                                "text": "he communicated by telephone instead of riding out by horseback, as in the good old days, to stay overnight in the various douars."
                            },
                            {
                                "example_id": "3d60d87c-269b-4fdb-9acd-83f7796905ec",
                                "sense_id": "4e620846-d8ba-3c53-b690-f812d29e4e9e",
                                "text": "‘We burn their douars, we rape their women, we confiscate their crops, we carry out the necessary exemplary executions and we round up those who are left into what I can only call concentrations camps.’"
                            }
                        ]
                    }
