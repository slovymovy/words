{
    "word_family": [
        "loofboom",
        "loofbos",
        "loofhut",
        "beloven",
        "loven",
        "loflied",
        "lof"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e36c276b-2751-3e35-aa8a-0fb4d6ef1036",
                    "sense_definition": "Het geheel van bladeren aan bomen of planten; gebladerte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botanisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de herfst verkleurt het dichte <w>loof</w> van de eikenbomen naar prachtig goud en bruin.",
                            "target_lang_translations": {
                                "en": "In autumn, the dense <w>foliage</w> of the oak trees turns into beautiful gold and brown."
                            }
                        },
                        {
                            "text": "De vogels zochten beschutting tegen de regen onder het groene <w>loof</w>.",
                            "target_lang_translations": {
                                "en": "The birds sought shelter from the rain under the green <w>leaves</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebladerte",
                        "bladgroen"
                    ],
                    "common_phrases": [
                        "groen loof",
                        "dicht loof"
                    ],
                    "target_lang_definitions": {
                        "en": "All the leaves of trees or plants collectively; foliage or greenery."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foliage",
                                "target_lang_sense_clarification": "leaves of plants or trees"
                            },
                            {
                                "target_lang_word": "leaves",
                                "target_lang_sense_clarification": "plant foliage"
                            },
                            {
                                "target_lang_word": "greenery",
                                "target_lang_sense_clarification": "green leaves or vegetation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "540ffc3e-3516-3b61-ac42-adc5323e9223",
                    "sense_definition": "Het plantenlichaam van lagere planten of algen zonder duidelijke scheiding in wortel, stengel en blad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het platte <w>loof</w> van dit levermos hecht zich direct aan de vochtige rotsen.",
                            "target_lang_translations": {
                                "en": "The flat <w>thallus</w> of this liverwort attaches directly to the moist rocks."
                            }
                        },
                        {
                            "text": "Onder de microscoop bestudeerden de biologiestudenten de structuur van het <w>loof</w> van het korstmos.",
                            "target_lang_translations": {
                                "en": "Under the microscope, the biology students studied the structure of the lichen's <w>thallus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "thallus"
                    ],
                    "target_lang_definitions": {
                        "en": "The undifferentiated vegetative body of lower plants, fungi, or algae; thallus."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thallus",
                                "target_lang_sense_clarification": "undifferentiated plant body of algae, fungi, or lichens"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21799f82-b98e-3216-9163-b8e216429569",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>loven</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_loven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>loof</w> je inzet en toewijding tijdens dit moeilijke project ten zeerste.",
                            "target_lang_translations": {
                                "en": "I highly <w>praise</w> your effort and dedication during this difficult project."
                            }
                        },
                        {
                            "text": "In dit lied <w>loof</w> ik de schoonheid van het omringende landschap.",
                            "target_lang_translations": {
                                "en": "In this song, I <w>praise</w> the beauty of the surrounding landscape."
                            }
                        }
                    ],
                    "synonyms": [
                        "prijs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'loven' (to praise, commend)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "praise",
                                "target_lang_sense_clarification": "first-person singular form (I praise)"
                            },
                            {
                                "target_lang_word": "commend",
                                "target_lang_sense_clarification": "first-person singular form (I commend)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd48f8e8-d093-3af9-9913-c3ece2fbd228",
                    "sense_definition": "Inversievorm van de tweede persoon enkelvoud tegenwoordige tijd van <w>loven</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vorm_loven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Loof</w> je hem werkelijk om zijn werk, of wil je gewoon beleefd overkomen?",
                            "target_lang_translations": {
                                "en": "Do you really <w>praise</w> him for his work, or do you just want to appear polite?"
                            }
                        },
                        {
                            "text": "Waarom <w>loof</w> je deze schrijver zo uitbundig na zo'n matig boek?",
                            "target_lang_translations": {
                                "en": "Why do you <w>praise</w> this writer so lavishly after such a mediocre book?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud tegenwoordige tijd (inversie)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inversion form of the second-person singular present tense of 'loven' (do you praise)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "praise",
                                "target_lang_sense_clarification": "second-person present (used with 'je/jij' in questions)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36767931-f5d1-36a8-83dd-c9d8a8a39f90",
                    "sense_definition": "Gebiedende wijs enkelvoud van <w>loven</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vorm_loven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Loof</w> de Heer voor alle zegeningen die je hebt mogen ontvangen in je leven.",
                            "target_lang_translations": {
                                "en": "<w>Praise</w> the Lord for all the blessings you have been granted in your life."
                            }
                        },
                        {
                            "text": "<w>Loof</w> nooit de dag voordat de avond helemaal gevallen is.",
                            "target_lang_translations": {
                                "en": "Never <w>praise</w> the day before evening has fully fallen."
                            }
                        }
                    ],
                    "synonyms": [
                        "prijs"
                    ],
                    "common_phrases": [
                        "loof de Heer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative singular of 'loven' (praise, extol)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "praise",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "laud",
                                "target_lang_sense_clarification": "imperative form, formal or archaic"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}