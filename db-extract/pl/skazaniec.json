                                    },
                                    {
                                        "sense_id": "0cb9ba7f-593e-3e53-895b-5c84a9194bb5",
                                        "entry_id": "ec937467-2c29-3b76-bba6-f1ac5b365927",
                                        "glosses": [
                                            "The convict cichlid (Amatitlania nigrofasciata), also known as the zebra cichlid, a popular aquarium fish, with stripes that resemble a prison uniform."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "344e5cb8-9df0-3630-b774-4f8c587da95b",
                                        "entry_id": "ec937467-2c29-3b76-bba6-f1ac5b365927",
