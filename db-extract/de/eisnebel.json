                                "sense_id": "509494db-433d-3434-b0b3-3ce2a2c43ff6",
                                "text": "„Örtlich kann es Eisnebel geben und gebietsweise muss mit Straßenglätte durch überfrorene Nässe und Reif gerechnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
