                ],
                "senses": [
                    {
                        "sense_id": "68c10c07-379a-3148-b7de-30d9639b7a8d",
                        "entry_id": "9039d10d-5039-3e3e-8834-8623766236aa",
                        "glosses": [
                            "To bestow with nobility, honour or grace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c0b8fd6-3f0a-469a-a25b-9a5d2e2244de",
                                "sense_id": "68c10c07-379a-3148-b7de-30d9639b7a8d",
                                "text": "We’d like to believe that suffering instructs and ennobles."
                            },
                            {
                                "example_id": "0addbd49-51c1-436e-9f34-9bb8ea0e7322",
                                "sense_id": "68c10c07-379a-3148-b7de-30d9639b7a8d",
                                "text": "There was no shortage of dropped jaws when news came through about the appointment of the recently ennobled Lord Peter Hendy as rail minister. This was certainly a left-field move, taking everyone (perhaps even himself) by surprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "790f32a0-30b9-3c83-bf9a-814aa45bc991",
                        "entry_id": "9039d10d-5039-3e3e-8834-8623766236aa",
                        "glosses": [
                            "To perform on a fabric the industrial processes of dry-cleaning, printing and embossing, and sizing and finishing."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf65ee65-90fc-3f23-9839-8b0c744b2a65",
                        "entry_id": "9039d10d-5039-3e3e-8834-8623766236aa",
                        "glosses": [
                            "To inarch."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bd2c6cf-a622-4ed7-823b-962b54542432",
                        "source_entry_id": "9039d10d-5039-3e3e-8834-8623766236aa",
                        "source_sense_description": "To bestow with nobility, honour or grace",
                        "target_lang_word": "anoblir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anoblir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f20ab89f-51f1-3c87-9b0b-651c1bbe9cb4",
                                        "entry_id": "72bdf448-89ca-37d8-80df-1ab9d03ce901",
                                        "glosses": [
                                            "Rendre noble, donner à un roturier le titre et les droits de noblesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca7792f-d1fe-4016-af23-2f75d62db692",
                                                "sense_id": "f20ab89f-51f1-3c87-9b0b-651c1bbe9cb4",
                                                "text": "Pour le prince, Othon n’était qu’un archer, plus adroit que les autres, il est vrai ; mais l’adresse n’anoblissait point, et les nobles seuls avaient droit de porter des cheveux longs."
                                            },
                                            {
                                                "example_id": "15a50fa8-7798-4cc6-bb3d-aba5e346bc47",
                                                "sense_id": "f20ab89f-51f1-3c87-9b0b-651c1bbe9cb4",
                                                "text": "Tandis qu'on contestait aux juifs les droits de bourgeoisie, un juif parvint à se faire anoblir : Liefman Calmer, devint baron de Picquigny et vidame d'Amiens."
                                            },
                                            {
                                                "example_id": "9638a6f8-5a30-432c-ab06-495a4a59f424",
                                                "sense_id": "f20ab89f-51f1-3c87-9b0b-651c1bbe9cb4",
                                                "text": "Contrairement à ce qu'on pourrait croire, elle ne fait nul cas du prestige et de l'ancienneté des familles : celle de Charles-Augustin et la sienne lui paraissent assez bonnes pour n'y pas ajouter un éclat emprunté. Dans son langage dru de femme bien née d'ancien régime, Reine dirait que la truie n'anoblit pas le cochon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef403bd1-9ba2-34b6-b8d1-37b5af1b75cb",
                                        "entry_id": "72bdf448-89ca-37d8-80df-1ab9d03ce901",
                                        "glosses": [
                                            "Donner à quelque chose un caractère noble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c8d168-8ae5-497e-9eb1-e87ca6c40614",
                                                "sense_id": "ef403bd1-9ba2-34b6-b8d1-37b5af1b75cb",
                                                "text": "Et la vanille Bourbon, à la puissance aromatique enivrante, d’anoblir flans, macarons, riz au lait, tartes aux pommes, gaufres, crèmes pâtissières et autres vanillades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132fd586-93ef-3363-99a4-cc062c2a1618",
                                        "entry_id": "72bdf448-89ca-37d8-80df-1ab9d03ce901",
                                        "glosses": [
                                            "Devenir noble."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf9f2e72-365a-4b11-a187-917b49cc2962",
                                                "sense_id": "132fd586-93ef-3363-99a4-cc062c2a1618",
                                                "text": "Ce métal s'anoblit avec le temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75c5ea62-f5c6-45d1-8a3b-42603afc68ec",
                        "source_entry_id": "9039d10d-5039-3e3e-8834-8623766236aa",
