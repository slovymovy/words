                ],
                "senses": [
                    {
                        "sense_id": "e482ff0c-2f06-3eb0-8afb-e5dca9aa74a6",
                        "entry_id": "3ce74034-9c76-3cbf-b1fd-5023682d63b1",
                        "glosses": [
                            "van de aard van de epiek (verhalend dichten), tot de epiek behorend"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "519afc4a-2141-34aa-9391-73de7e87771b",
                        "entry_id": "3ce74034-9c76-3cbf-b1fd-5023682d63b1",
                        "glosses": [
                            "geweldig, fenomenaal"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c20e8a9f-c9cc-4766-bf5d-9a64a94cdef1",
                                "sense_id": "519afc4a-2141-34aa-9391-73de7e87771b",
                                "text": "Deze televisieserie is episch!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b65646f-02c2-4ae5-9fac-3166495c2b74",
                        "source_entry_id": "3ce74034-9c76-3cbf-b1fd-5023682d63b1",
                        "target_lang_word": "episch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "episch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "772a0d0e-7a34-30d9-a3c8-ad8fc3f7a80a",
                                        "entry_id": "cd0eb132-2bff-301a-95f4-d8f5a9e67854",
                                        "glosses": [
                                            "Poetik (Dichtungstheorie), steigerungslos: zum Epos gehörend, nach Art des Epos, die Epik betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208235d3-5f2d-4859-9c79-6c270c04d88e",
                                                "sense_id": "772a0d0e-7a34-30d9-a3c8-ad8fc3f7a80a",
                                                "text": "„In altgriechischer Zeit ist der Dichter, der episch oder dramatisch erzählt, nichts als Interpret der Sage; er interpretiert sie so, wie sie zu ihm gesprochen hat; die Sage lebt und der Dichter schafft weiter an ihr, wie das Generationen vor ihm getan haben.“"
                                            },
                                            {
                                                "example_id": "659e67d8-09c4-4d44-b194-60381ea01c6d",
                                                "sense_id": "772a0d0e-7a34-30d9-a3c8-ad8fc3f7a80a",
                                                "text": "„Als neue, zusätzliche Möglichkeit eröffnet sich den Helden im 13. und 14. Jahrhundert der Einzug in das Artus- oder das Feenreich: Rainouart geht als erster epischer Held vorübergehend, Huon de Bordeaux als erster epischer Held für dauernd in die arthurische Jenseitswelt ein.“"
                                            },
                                            {
                                                "example_id": "edd224ac-bdcd-4b08-84eb-95f5059932e8",
                                                "sense_id": "772a0d0e-7a34-30d9-a3c8-ad8fc3f7a80a",
                                                "text": "„Mit der zunehmenden Differenzierung der epischen Dichtung im 18. Jahrhundert und der Entwicklung der Prosa werden unter dem Begriff Epik alle Genres der erzählenden Literatur erfasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e94a78cf-e2f9-31a2-8686-d89ce549fc17",
                                        "entry_id": "cd0eb132-2bff-301a-95f4-d8f5a9e67854",
                                        "glosses": [
                                            "erzählend, erzählerisch, berichtend"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d578e4f-5e83-4a61-97a3-4f9cdc4cfd38",
                                                "sense_id": "e94a78cf-e2f9-31a2-8686-d89ce549fc17",
                                                "text": "„Ein Text kann rein episch erzählend, eine reine Dialogform, eine reine Monologform sein. Er kann aber auch Mischformen aufweisen, wie ‚episch mit Dialogen untermischt‘ oder ‚episch mit Monologen untermischt‘.“"
                                            },
                                            {
                                                "example_id": "908d0585-3b09-4b08-8956-cb5e544da8cf",
                                                "sense_id": "e94a78cf-e2f9-31a2-8686-d89ce549fc17",
                                                "text": "„Eine getrennte Betrachtung des epischen und des absurden Dramas ist deshalb ratsam, weil sich beide Formtypen in ihrem Welt- und Wirklichkeitsverständnis stark unterscheiden.“"
                                            },
                                            {
                                                "example_id": "32a6f752-494c-44a0-a0b7-d13421799017",
                                                "sense_id": "e94a78cf-e2f9-31a2-8686-d89ce549fc17",
                                                "text": "„Selbst in ‚Der Archipelagus‘, dem epischsten unter Hölderlins Gedichten, umfaßt die Schilderung des Angriffs der Perser und der Schlacht von Salamis nur rund 50 Verse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a8a0279f-d747-3965-ad29-08bec4167d45",
                                        "entry_id": "cd0eb132-2bff-301a-95f4-d8f5a9e67854",
                                        "glosses": [
                                            "sehr oder zu ausführlich erzählend, keine Einzelheit auslassend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13eb8f22-42a6-4f80-bef6-f004f54c0ba3",
                                                "sense_id": "a8a0279f-d747-3965-ad29-08bec4167d45",
                                                "text": "„Hinzu kam die epische Neigung der Russen, die Umständlichkeit ihrer Entscheidungsprozesse, die alles in die Länge zogen.“"
                                            },
                                            {
                                                "example_id": "14053ba9-4e66-4f70-b44f-0d7f3c1007e0",
                                                "sense_id": "a8a0279f-d747-3965-ad29-08bec4167d45",
                                                "text": "„Vieles im Film wirkt etwas sprunghaft, so als wäre das Konzept noch epischer gewesen, aber wegen der Überlänge des Films dann nicht realisiert oder geschnitten worden.“"
                                            },
                                            {
                                                "example_id": "f81c19c7-36f2-4acb-a6cd-9d3c41d7d633",
                                                "sense_id": "a8a0279f-d747-3965-ad29-08bec4167d45",
                                                "text": "„Ein Theater, das alles aufgibt, was es erst zu Theater machen würde: eine Menschenwelt zu schaffen. Hier laubsägt es nur eine Papierwelt aus. Episches Theater? Episches Gelaber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d179b98-4902-484a-ab3e-00a263e11667",
                        "source_entry_id": "3ce74034-9c76-3cbf-b1fd-5023682d63b1",
                        "target_lang_word": "epic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec00bd65-e883-3062-9b39-bc828a44acad",
                                        "entry_id": "c0b3de98-3485-3d73-a423-5b35c6b05d0f",
                                        "glosses": [
                                            "An extended narrative poem in elevated or dignified language, celebrating the feats of a deity, demigod (heroic epic), other legend or traditional hero."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0582d0ff-d7ef-46bb-bcbf-c5e6b05d6d44",
                                                "sense_id": "ec00bd65-e883-3062-9b39-bc828a44acad",
                                                "text": "The Icelandic epic took all night to recite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6651322a-267c-3674-9963-73b0bb7ee1d0",
                                        "entry_id": "c0b3de98-3485-3d73-a423-5b35c6b05d0f",
                                        "glosses": [
                                            "A series of events considered appropriate to an epic; any work of literature, film, etc. having heroic deeds and adventures as its subject matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a229e082-25e4-40db-aef2-706ed3cc4fd2",
                                                "sense_id": "6651322a-267c-3674-9963-73b0bb7ee1d0",
                                                "text": "The book was an epic in four volumes."
                                            },
                                            {
                                                "example_id": "6f03201a-0eef-435f-8de1-74b3c46bf605",
                                                "sense_id": "6651322a-267c-3674-9963-73b0bb7ee1d0",
                                                "text": "These epics nearly always had runaway trains, nincompoops floundering with the controls and a collapsed bridge just ahead!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8405fab7-7246-3437-833e-0c5df917301b",
                                        "entry_id": "c0b3de98-3485-3d73-a423-5b35c6b05d0f",
                                        "glosses": [
                                            "A large or extended user story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b1ca190-d733-403c-bfb1-91f300b17617",
                                                "sense_id": "8405fab7-7246-3437-833e-0c5df917301b",
                                                "text": "Epics are shown in a separate list from user stories. This is because it is the user stories that are developed, not epics. Epics are decomposed into child user stories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "epic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25490d23-c0b2-39cb-b931-84b73affdad9",
                                        "entry_id": "5720396d-cd50-3967-b915-7912ca2fb256",
                                        "glosses": [
                                            "Of or relating to an epic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc90b68-39d5-4eab-a067-d3b39d409627",
                                                "sense_id": "25490d23-c0b2-39cb-b931-84b73affdad9",
                                                "text": "Beowulf is an epic poem."
                                            },
                                            {
                                                "example_id": "189225f5-48b2-40fd-9aff-09a52c36898b",
                                                "sense_id": "25490d23-c0b2-39cb-b931-84b73affdad9",
                                                "text": "The main theme of epic poetry is, of course, the hero, his life, his greatness of character, his deeds and his death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65dea8e5-93ee-3030-8e67-0f3720950a49",
                                        "entry_id": "5720396d-cd50-3967-b915-7912ca2fb256",
                                        "glosses": [
                                            "Momentously heroic; grand in scale or character"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8bd418c-61a4-4e96-b60f-76566f140371",
                                                "sense_id": "65dea8e5-93ee-3030-8e67-0f3720950a49",
                                                "text": "The epic defense was rewarded with the highest military decorations"
                                            },
                                            {
                                                "example_id": "babacd12-019e-40b3-a63f-9dbf06afc2bf",
                                                "sense_id": "65dea8e5-93ee-3030-8e67-0f3720950a49",
                                                "text": "China's epic traffic jam \"vanished\" [title of article]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ba7080a-14be-3e6d-88f0-d183e59654b2",
                                        "entry_id": "5720396d-cd50-3967-b915-7912ca2fb256",
                                        "glosses": [
                                            "Extending beyond the usual or ordinary."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c837bf2c-3524-4198-b0ff-30fda38dbeb2",
                                                "sense_id": "7ba7080a-14be-3e6d-88f0-d183e59654b2",
                                                "text": "The after-prom party was truly epic."
                                            },
                                            {
                                                "example_id": "36bdf536-3a93-4961-9715-6a103333fac6",
                                                "sense_id": "7ba7080a-14be-3e6d-88f0-d183e59654b2",
                                                "text": "You made an epic mistake."
                                            },
                                            {
                                                "example_id": "593bd292-dd57-42ac-9bbf-d22a3115123d",
                                                "sense_id": "7ba7080a-14be-3e6d-88f0-d183e59654b2",
                                                "text": "Then tell him his daughter's an epic shag."
                                            }
                                        ]
                                    },
