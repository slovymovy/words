                "senses": [
                    {
                        "sense_id": "84870d49-5bf8-3faf-a297-db8d16c606a4",
                        "entry_id": "3147b7de-0a10-3353-9841-665dfe61aa35",
                        "glosses": [
                            "Jeune homme gay, fin et ayant peu ou pas de pilosité."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "25eb8828-d70b-436b-872f-fa18f238b952",
                                "sense_id": "84870d49-5bf8-3faf-a297-db8d16c606a4",
                                "text": "ls sont maigres, ils n’ont pas de poil, ils sont partout, et tout le monde veut les pécho. Longtemps relégués au rang de mecs sous-alimentés peu attrayants, les twinks sont aujourd’hui au sommet de la pyramide de la désidérabilité, du moins dans le monde gay, et bouleversent les standards et les diktats de beauté de notre époque — pour le meilleur et pour le pire."
                            }
                        ]
                    }
                ],
                "translations": [
