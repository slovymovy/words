                    }
                ],
                "senses": [
                    {
                        "sense_id": "78c5542c-c0d5-3028-a82d-56dbd452096a",
                        "entry_id": "f31c9bd5-191d-36ce-8d07-487b346de8bc",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным ухо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcced9e5-d693-4f37-bf1a-4bce6f19e6bc",
                                "sense_id": "78c5542c-c0d5-3028-a82d-56dbd452096a",
                                "text": "При серных пробках надо влить в ухо несколько капель какого-нибудь тёплого растительного масла и немного полежать, чтобы масло поглубже проникло в ушной проход."
                            },
                            {
                                "example_id": "3fef5728-8d2f-49c7-bf1e-e1ddb6ffcb0e",
                                "sense_id": "78c5542c-c0d5-3028-a82d-56dbd452096a",
                                "text": "А закладывая кусочек листа в ухо собаке или кошке, вы без особого труда избавите их от ушных клещей."
                            },
                            {
                                "example_id": "cd4422bd-a8be-4ab1-b677-267e8bc638b9",
                                "sense_id": "78c5542c-c0d5-3028-a82d-56dbd452096a",
                                "text": "У человека ушная улитка имеет форму конической спирали: в правом ухе ― правовинтовую, в левом ― левовинтовую."
                            },
                            {
                                "example_id": "b418f150-dfef-4571-b731-7d2334981505",
                                "sense_id": "78c5542c-c0d5-3028-a82d-56dbd452096a",
                                "text": "Уши так разболелись, что опять должен был позвать ушного врача."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "557dc4b3-9ca9-4a23-80fb-960171891c16",
                        "source_entry_id": "f31c9bd5-191d-36ce-8d07-487b346de8bc",
