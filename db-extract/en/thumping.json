                "translations": [
                    {
                        "translation_id": "3fce913a-22c1-4e88-8a3a-57a9e850f5af",
                        "source_entry_id": "98d657fa-7144-3f1a-83be-76a5041e76db",
                        "source_sense_id": "58080c30-cae7-3949-b90e-d8eb2b252cf1",
                        "source_sense_description": "exceptionally",
                        "target_lang_word": "uitzonderlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitzonderlijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5558ee98-544b-3d07-901c-7f889575e188",
                                        "entry_id": "54229363-f5a6-33dc-9f77-bdc621ecb21e",
                                        "glosses": [
                                            "niet alledaags, niet gewoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c7878c-ae3b-45c2-bc4f-11f08c77423d",
                                                "sense_id": "5558ee98-544b-3d07-901c-7f889575e188",
                                                "text": "Hij heeft daarmee een uitzonderlijke prestatie geleverd."
                                            },
                                            {
                                                "example_id": "2561d5fb-023f-4bf9-aff8-caf4fe76d5d8",
                                                "sense_id": "5558ee98-544b-3d07-901c-7f889575e188",
                                                "text": "NOS-weerman Marco Verhoef laat op Twitter zien dat er in Brabant lokaal windstoten met uitschieters van 110 kilometer per uur zijn gemeten. Dat is volgens hem vrij uitzonderlijk voor deze tijd van het jaar."
                                            },
                                            {
                                                "example_id": "4839a575-7062-4266-8266-f89d09e056dc",
                                                "sense_id": "5558ee98-544b-3d07-901c-7f889575e188",
                                                "text": "De eremedaille wordt toegekend aan personen met uitzonderlijke verdiensten op het gebied van kunst en wetenschap."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uitzonderlijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d1e178-05a7-3dcf-929e-ac5e80900ebe",
                                        "entry_id": "5a1b68b2-8a60-3852-852e-d756a5381810",
                                        "glosses": [
                                            "niet alledaags, niet gewoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a6ee00-2b55-4915-a847-f6f0910f92f4",
                                                "sense_id": "c4d1e178-05a7-3dcf-929e-ac5e80900ebe",
                                                "text": "Het pad liep langs het beroemde Crater Lake, een prachtige vulkaankrater gevuld met uitzonderlijk helder, blauw water."
                                            },
                                            {
                                                "example_id": "81e56a4d-5667-4a2b-9bbd-bc5cb4756534",
                                                "sense_id": "c4d1e178-05a7-3dcf-929e-ac5e80900ebe",
                                                "text": "De boeken hebben één ding gemeen: je zou ‘enorm veel missen als je ze in de originele taal zou lezen, in ieder geval de uitzonderlijk eigen stijl waarin ze geschreven zijn’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "8e38ca4e-b544-3cbb-9c15-836ca7d6c135",
                "word": "thumping",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "185a386b-1089-4002-847b-107529a6518f",
                        "entry_id": "8e38ca4e-b544-3cbb-9c15-836ca7d6c135",
                        "tags": [
                            "plural"
                        ],
                        "form": "thumpings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f13155e4-c0cb-3322-af79-515314680983",
                        "entry_id": "8e38ca4e-b544-3cbb-9c15-836ca7d6c135",
                        "glosses": [
                            "A dull, heavy sound."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9db57c73-1e4d-436c-89cb-febd6fd52780",
                                "sense_id": "f13155e4-c0cb-3322-af79-515314680983",
                                "text": "They were a regular series of thumpings from the interior of the house, occasioned by the violent rocking of a cradle upon a stone floor, to which movement a feminine voice kept time by singing, in a vigorous gallopade[.]"
                            },
                            {
                                "example_id": "2554e112-ede5-46fa-aea8-4969ac2cd069",
                                "sense_id": "f13155e4-c0cb-3322-af79-515314680983",
                                "text": "There was nothing to be seen, but he could hear loud thumpings and bumpings which seemed to come from the back of the house."
                            }
                        ]
                    },
                    {
                        "sense_id": "b920d569-a948-37f3-8f61-d60081e6766d",
                        "entry_id": "8e38ca4e-b544-3cbb-9c15-836ca7d6c135",
                        "glosses": [
                            "A beating."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "45b9e46b-497d-421d-b0b2-416a16cd9fb9",
                                "sense_id": "b920d569-a948-37f3-8f61-d60081e6766d",
                                "text": "He received a thumping from the school bully."
                            },
                            {
                                "example_id": "2c402357-c921-465e-bdae-68870f8dce93",
                                "sense_id": "b920d569-a948-37f3-8f61-d60081e6766d",
                                "text": "And in our times, in Philadelphia, there have been specimens of violent shruggings of the shoulders, and brachial twitches, and prodigious wry faces, and thumpings on the pews."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b731918-6eab-3b51-9fdd-8307e14b4a74",
                        "entry_id": "8e38ca4e-b544-3cbb-9c15-836ca7d6c135",
                        "glosses": [
                            "A heavy defeat."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "85f24c70-ec64-4822-9eee-843a6e0038ab",
                                "sense_id": "2b731918-6eab-3b51-9fdd-8307e14b4a74",
                                "text": "Grant's future has been the subject of rumour after rumour for much of the season and last week's horrific 5-0 thumping at Newcastle was the catalyst for another round of fevered speculation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ed22226-feb7-42ef-a684-618a6f6ffe2a",
                        "source_entry_id": "8e38ca4e-b544-3cbb-9c15-836ca7d6c135",
                        "source_sense_description": "dull, heavy sound",
