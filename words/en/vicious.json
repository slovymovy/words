    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a89f9a3-7701-32b2-91cd-dc0c865733a7",
                    "sense_definition": "Savage, aggressive, or dangerously intense in nature.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "aggression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers were warned about a <w>vicious</w> dog that was known to attack strangers near the trail.",
                            "target_lang_translations": {
                                "ru": "Туристов предупредили о <w>злой</w> собаке, которая, как известно, нападала на незнакомцев рядом с тропой."
                            }
                        },
                        {
                            "text": "He suffered from a <w>vicious</w> headache that made it impossible for him to focus on his work.",
                            "target_lang_translations": {
                                "ru": "Он страдал от <w>сильнейшей</w> головной боли, из-за которой не мог сосредоточиться на работе."
                            }
                        }
                    ],
                    "antonyms": [
                        "gentle",
                        "mild"
                    ],
                    "common_phrases": [
                        "vicious dog",
                        "vicious attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дикий, агрессивный или опасно интенсивный по своей природе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злой",
                                "target_lang_sense_clarification": "о собаке или характере"
                            },
                            {
                                "target_lang_word": "свирепый",
                                "target_lang_sense_clarification": "крайне агрессивный"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "о боли или физическом ощущении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46ee4534-f901-39ec-bbb9-97673cdde4dd",
                    "sense_definition": "Deliberately cruel, violent, or intended to cause serious harm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aggression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was shocked by the <w>vicious</w> rumors spread by his opponents during the election campaign.",
                            "target_lang_translations": {
                                "ru": "Политик был шокирован <w>злобными</w> слухами, которые распространяли его оппоненты во время предвыборной кампании."
                            }
                        },
                        {
                            "text": "She was trapped in a <w>vicious</w> cycle of debt and poverty that seemed impossible to escape.",
                            "target_lang_translations": {
                                "ru": "Она оказалась в <w>замкнутом</w> круге долгов и нищеты, из которого, казалось, невозможно выбраться."
                            }
                        }
                    ],
                    "synonyms": [
                        "scathy"
                    ],
                    "antonyms": [
                        "kind",
                        "benevolent"
                    ],
                    "common_phrases": [
                        "vicious cycle",
                        "vicious rumors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно жестокий, насильственный или направленный на причинение серьезного вреда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "наполненный злобой"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "причиняющий страдания"
