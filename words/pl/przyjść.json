{
    "word_family": [
        "przychodzić",
        "przychód",
        "przyszłość",
        "przybysz"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13a8ee84-9100-3c20-9e44-6cf654be81ad",
                    "sense_definition": "Dotrzeć do określonego miejsca, znajdując się w nim (zwykle poruszając się pieszo).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój najlepszy przyjaciel <w>przyszedł</w> wczoraj do mnie z wizytą.",
                            "target_lang_translations": {
                                "ru": "Мой лучший друг вчера <w>пришёл</w> ко мне в гости.",
                                "en": "My best friend <w>came</w> to visit me yesterday."
                            }
                        },
                        {
                            "text": "Musisz <w>przyjść</w> do biura punktualnie o ósmej rano.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>прийти</w> в офис ровно в восемь утра.",
                                "en": "You must <w>come</w> to the office promptly at eight in the morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "pojawić się",
                        "przybyć",
                        "dotrzeć"
                    ],
                    "antonyms": [
                        "wyjść"
                    ],
                    "common_phrases": [
                        "przyjść do domu",
                        "przyjść na spotkanie",
                        "przyjść z wizytą"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добраться до определенного места, находясь в нем (обычно передвигаясь пешком).",
                        "en": "To reach a specific place, usually by walking; to arrive or come."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "пешком"
                            },
                            {
                                "target_lang_word": "подойти",
                                "target_lang_sense_clarification": "приблизиться"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "arrive on foot or visit"
                            },
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "reach a destination"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd309dd7-f683-375e-8561-178c0967a693",
                    "sense_definition": "Nastąpić lub zacząć się (o czasie, porze roku lub wydarzeniu).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W końcu <w>przyszła</w> długo oczekiwana wiosna i zrobiło się ciepło.",
                            "target_lang_translations": {
                                "ru": "Наконец <w>наступила</w> долгожданная весна, и стало тепло.",
                                "en": "Finally, the long-awaited spring <w>arrived</w> and it became warm."
                            }
                        },
                        {
                            "text": "Nagle <w>przyszła</w> potężna burza i musieliśmy uciekać do domu.",
                            "target_lang_translations": {
                                "ru": "Внезапно <w>пришла</w> сильная гроза, и нам пришлось бежать домой.",
                                "en": "Suddenly a fierce storm <w>came</w> and we had to run home."
                            }
                        }
                    ],
                    "synonyms": [
                        "nadejść"
                    ],
                    "common_phrases": [
                        "czas przyszedł",
                        "przyszła zima",
                        "przyszła kolej"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наступить или начаться (о времени, времени года или событии).",
                        "en": "To occur or begin (said of time, a season, or an event)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наступить",
                                "target_lang_sense_clarification": "о времени/сезоне"
                            },
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "настать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "of seasons, time, or events"
                            },
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "of a time period or event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5ccb690-a127-3f9a-8a79-2a6a3953ed8c",
                    "sense_definition": "Pojawić się z powrotem w miejscu, w którym się wcześniej było.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy <w>przyszedł</w> z powrotem do pokoju, nikogo już tam nie było.",
                            "target_lang_translations": {
                                "ru": "Когда он <w>вернулся</w> обратно в комнату, там уже никого не было.",
                                "en": "When he <w>came back</w> into the room, there was no one left there."
                            }
                        },
                        {
                            "text": "Pies uciekł rano, ale <w>przyszedł</w> pod drzwi wieczorem.",
                            "target_lang_translations": {
                                "ru": "Собака убежала утром, но вечером <w>пришла</w> к двери.",
                                "en": "The dog ran away in the morning, but <w>came</w> to the door in the evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrócić"
                    ],
                    "common_phrases": [
                        "przyjść z powrotem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появиться снова в месте, где уже был ранее.",
                        "en": "To appear again in a place where one was previously; to come back."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вернуться",
                                "target_lang_sense_clarification": "возвращение"
                            },
                            {
                                "target_lang_word": "прийти обратно",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come back",
                                "target_lang_sense_clarification": "return to a place"
                            },
                            {
                                "target_lang_word": "return",
                                "target_lang_sense_clarification": "come back"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18960572-122c-34a7-b1f7-e38fdf3664fc",
                    "sense_definition": "Pojawić się w świadomości, pamięci lub odczuciach (o myśli, pomyśle, ochocie).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagle <w>przyszło</w> mi do głowy świetne rozwiązanie tego trudnego problemu.",
                            "target_lang_translations": {
                                "ru": "Вдруг мне <w>пришло</w> в голову отличное решение этой сложной проблемы.",
                                "en": "Suddenly, a great solution to this difficult problem <w>occurred to</w> me."
                            }
                        },
                        {
                            "text": "Nigdy nie <w>przyszło</w> jej na myśl, że może zostać zwolniona.",
                            "target_lang_translations": {
                                "ru": "Ей никогда не <w>приходило</w> в голову, что её могут уволить.",
                                "en": "It never <w>crossed</w> her mind that she might be fired."
                            }
                        }
                    ],
                    "synonyms": [
                        "nasunąć się"
                    ],
                    "common_phrases": [
                        "przyjść do głowy",
                        "przyjść na myśl",
                        "przyjść ochota"
                    ],
                    "target_lang_definitions": {
                        "ru": "Появиться в сознании, памяти или ощущениях (о мысли, идее, желании).",
                        "en": "To occur to someone; to enter one's mind, memory, or feelings (of a thought, idea, or urge)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "в голову/на ум"
                            },
                            {
                                "target_lang_word": "появиться",
                                "target_lang_sense_clarification": "возникнуть (о мысли)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "occur to",
                                "target_lang_sense_clarification": "of a thought or idea"
                            },
                            {
                                "target_lang_word": "come to mind",
                                "target_lang_sense_clarification": "enter thoughts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c6cdef2-6d97-3acc-9a37-4db99807afe7",
                    "sense_definition": "Zostać dostarczonym do odbiorcy (np. o liście, paczce, przelewie).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "delivery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj <w>przyszła</w> do nas paczka, na którą czekaliśmy od tygodnia.",
                            "target_lang_translations": {
                                "ru": "Вчера нам <w>пришла</w> посылка, которую мы ждали неделю.",
                                "en": "Yesterday, a package that we had been waiting for a week <w>arrived</w> for us."
                            }
                        },
                        {
                            "text": "Pieniądze z wypłaty powinny <w>przyjść</w> na twoje konto jutro rano.",
                            "target_lang_translations": {
                                "ru": "Деньги с зарплаты должны <w>поступить</w> на твой счёт завтра утром.",
                                "en": "The salary money should <w>come in</w> to your account tomorrow morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "dotrzeć"
                    ],
                    "common_phrases": [
                        "przyjść pocztą",
                        "przelew przyszedł"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть доставленным получателю (например, о письме, посылке, переводе).",
                        "en": "To be delivered to the recipient (e.g., a letter, package, or bank transfer)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "быть доставленным"
                            },
                            {
                                "target_lang_word": "поступить",
                                "target_lang_sense_clarification": "о деньгах/средствах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "of mail or parcels"
                            },
                            {
                                "target_lang_word": "come through",
                                "target_lang_sense_clarification": "of payments or deliveries"
                            },
                            {
                                "target_lang_word": "come in",
                                "target_lang_sense_clarification": "of letters or money"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edc133bd-6dd6-323e-ac8e-9ea49b8e59b9",
                    "sense_definition": "Stać się częścią jakiejś grupy lub wziąć udział w jakimś wydarzeniu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu nowych członków <w>przyszło</w> do naszego klubu w tym miesiącu.",
                            "target_lang_translations": {
                                "ru": "В этом месяце в наш клуб <w>пришло</w> много новых членов.",
                                "en": "Many new members <w>joined</w> our club this month."
                            }
                        },
                        {
                            "text": "Możesz <w>przyjść</w> do nas i pomóc w przygotowaniach do imprezy.",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>прийти</w> к нам и помочь в подготовке к вечеринке.",
                                "en": "You can <w>come over</w> to us and help with the party preparations."
                            }
                        }
                    ],
                    "synonyms": [
                        "dołączyć się",
                        "przyłączyć się"
                    ],
                    "common_phrases": [
                        "przyjść z pomocą"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать частью какой-либо группы или принять участие в каком-либо событии.",
                        "en": "To become part of a group, join an organization, or participate in an event."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "присоединиться"
                            },
                            {
                                "target_lang_word": "вступить",
                                "target_lang_sense_clarification": "стать членом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "join",
                                "target_lang_sense_clarification": "become a member of"
                            },
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "attend or participate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53edc76c-8da4-31be-b050-d2cf86cdfb73",
                    "sense_definition": "Odzyskać sprawność, zdrowie lub równowagę psychiczną (zwykle w zwrotach).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pacjent szybko <w>przyszedł</w> do siebie po skomplikowanej operacji serca.",
                            "target_lang_translations": {
                                "ru": "Пациент быстро <w>пришёл</w> в себя после сложной операции на сердце.",
                                "en": "The patient quickly <w>recovered</w> after the complicated heart surgery."
                            }
                        },
                        {
                            "text": "Minęło kilka tygodni, zanim <w>przyszła</w> do zdrowia po wypadku.",
                            "target_lang_translations": {
                                "ru": "Прошло несколько недель, прежде чем она <w>оправилась</w> после аварии.",
                                "en": "A few weeks passed before she <w>regained</w> her health after the accident."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przyjść do siebie",
                        "przyjść do zdrowia",
                        "przyjść do formy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить здоровье или душевное равновесие (обычно в устойчивых выражениях).",
                        "en": "To regain health, consciousness, or emotional composure (usually in set phrases)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "в себя/в норму"
                            },
                            {
                                "target_lang_word": "оправиться",
                                "target_lang_sense_clarification": "после болезни/шока"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "recover",
                                "target_lang_sense_clarification": "regain health or balance"
                            },
                            {
                                "target_lang_word": "come round",
                                "target_lang_sense_clarification": "regain consciousness or composure"
                            },
                            {
                                "target_lang_word": "come to",
                                "target_lang_sense_clarification": "regain consciousness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65523d09-2e5a-3bea-8f61-c0cdf2f5ea69",
                    "sense_definition": "Urodzić się (używane w stałym wyrażeniu \"przyjść na świat\").",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich pierwsze dziecko <w>przyszło</w> na świat wczesnym rankiem w niedzielę.",
                            "target_lang_translations": {
                                "ru": "Их первый ребёнок <w>появился</w> на свет рано утром в воскресенье.",
                                "en": "Their first child <w>was born</w> early on Sunday morning."
                            }
                        },
                        {
                            "text": "Mały kotek <w>przyszedł</w> na świat w bezpiecznym schronieniu pod schodami.",
                            "target_lang_translations": {
                                "ru": "Маленький котёнок <w>появился</w> на свет в безопасном укрытии под лестницей.",
                                "en": "The little kitten <w>came into the world</w> in a safe shelter under the stairs."
                            }
                        }
                    ],
                    "synonyms": [
                        "urodzić się"
                    ],
                    "common_phrases": [
                        "przyjść na świat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Родиться (используется в устойчивом выражении \"przyjść na świat\").",
                        "en": "To be born (used in the idiom \"przyjść na świat\" – to come into the world)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появиться",
                                "target_lang_sense_clarification": "на свет"
                            },
                            {
                                "target_lang_word": "родиться",
                                "target_lang_sense_clarification": "синоним"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "come into the world",
                                "target_lang_sense_clarification": "idiomatic for being born"
                            },
                            {
                                "target_lang_word": "be born",
                                "target_lang_sense_clarification": "enter life"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7711b07f-037b-3143-afe1-aa6a79610b87",
                    "sense_definition": "Być zmuszonym przez los lub okoliczności do zrobienia czegoś (forma bezosobowa).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impersonal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niestety <w>przyszło</w> mi zapłacić wysoki mandat za złe parkowanie.",
                            "target_lang_translations": {
                                "ru": "К сожалению, мне <w>пришлось</w> заплатить большой штраф за неправильную парковку.",
                                "en": "Unfortunately, I <w>had to</w> pay a heavy fine for illegal parking."
                            }
                        },
                        {
                            "text": "<w>Przyszło</w> nam żyć w bardzo ciekawych i dynamicznych czasach.",
                            "target_lang_translations": {
                                "ru": "Нам <w>довелось</w> жить в очень интересные и динамичные времена.",
                                "en": "We <w>happen</w> to live in very interesting and dynamic times."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przyszło mi",
                        "przyszło nam żyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть вынужденным судьбой или обстоятельствами сделать что-то (безличная форма).",
                        "en": "To have to or be forced by fate or circumstance to do something (impersonal)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийтись",
                                "target_lang_sense_clarification": "безличная форма (пришлось)"
                            },
                            {
                                "target_lang_word": "довестись",
                                "target_lang_sense_clarification": "выпасть на долю"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "have to",
                                "target_lang_sense_clarification": "be forced by circumstances"
                            },
                            {
                                "target_lang_word": "happen to",
                                "target_lang_sense_clarification": "end up doing through fate"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}