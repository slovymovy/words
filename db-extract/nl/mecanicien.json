                "translations": [
                    {
                        "translation_id": "522fe9be-c8ad-406f-b48b-866136d4d6fe",
                        "source_entry_id": "c73dd179-dd49-3130-8f29-680cc23bc169",
                        "source_sense_id": "3c2e33fd-9c91-36be-ace2-85618fc1081a",
                        "target_lang_word": "Mechaniker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mechaniker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1ab5c9-2755-346c-b15d-731626087871",
                                        "entry_id": "b9663fa0-e721-35b0-896e-9969ae222822",
                                        "glosses": [
                                            "jemand, der Maschinen, Bauteile und technische Geräte zusammen- oder auseinanderbaut, für deren Wartung oder Reparatur zuständig ist und deren Funktionstüchtigkeit überprüft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5808aa5-36c5-4e53-a91d-0c3ad5a7e7e5",
                                                "sense_id": "5f1ab5c9-2755-346c-b15d-731626087871",
                                                "text": "Mein Mann kann zu Hause allerhand reparieren, denn er ist Mechaniker von Beruf."
                                            },
                                            {
                                                "example_id": "0c653d2d-c760-4c6e-b44a-6fd979f33158",
                                                "sense_id": "5f1ab5c9-2755-346c-b15d-731626087871",
                                                "text": "„Davon erzählt die Geschichte des Mechanikers Ali.“"
                                            },
                                            {
                                                "example_id": "fba228b4-1b47-4685-9afa-f88193bc8503",
                                                "sense_id": "5f1ab5c9-2755-346c-b15d-731626087871",
                                                "text": "„Hélène war bereits in ein nahe gelegenes Haus gegangen, um nach einem Mechaniker zu telefonieren.“"
                                            },
                                            {
                                                "example_id": "4c36ad8e-b684-4a89-a898-33ac1bf80777",
                                                "sense_id": "5f1ab5c9-2755-346c-b15d-731626087871",
                                                "text": "„Mit Jesaja in seinem Sarg ist eine Trauergemeinde hierhergekommen, die aus den Bekannten von Juliane, die sie jetzt stützen, aus dem Pastor und dem Kirchendiener, dem Mechaniker und einer kleinen Gruppe von Dänen besteht, von denen ich nur den amtlichen Pfleger und den Assessor erkenne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b279e094-eaf7-4f85-8207-54fbdd1c7389",
                        "source_entry_id": "c73dd179-dd49-3130-8f29-680cc23bc169",
                        "source_sense_id": "3c2e33fd-9c91-36be-ace2-85618fc1081a",
                        "target_lang_word": "mechanic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mechanic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f35bc70-eef6-39d2-b664-3e53a45a6292",
                                        "entry_id": "6116b7ef-b0e2-3ce2-a867-4e310b768aa2",
                                        "glosses": [
                                            "mechanical; relating to mechanics or the laws of motion in physics"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48945454-bad1-45f7-84ed-0d80e260b2dd",
                                                "sense_id": "1f35bc70-eef6-39d2-b664-3e53a45a6292",
                                                "text": "[…] these mechanick Philosophers being in no Way able to give an Account thereof from the necessary motion of Matter, unguided by Mind for Ends […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b765e0e-bbd5-3ec0-b58e-f1a4074aeec4",
                                        "entry_id": "6116b7ef-b0e2-3ce2-a867-4e310b768aa2",
                                        "glosses": [
                                            "mechanical; precise but lifeless, as if performed by machine"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2afd92dd-7b7c-476a-a0b4-9009ca5bc299",
                                                "sense_id": "1b765e0e-bbd5-3ec0-b58e-f1a4074aeec4",
                                                "text": "But, for the unquiet heart and brain,\n⁠A use in measured language lies;\n⁠The sad mechanic exercise,\nLike dull narcotics, numbing pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e61217b-7108-36cc-8164-c4647da701bb",
                                        "entry_id": "6116b7ef-b0e2-3ce2-a867-4e310b768aa2",
                                        "glosses": [
                                            "Of or relating to a mechanic or artificer, or to the class of artisans; hence, rude; common; vulgar; base."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "534dc2db-04f8-4bbf-8667-813e249eb7d8",
                                                "sense_id": "4e61217b-7108-36cc-8164-c4647da701bb",
                                                "text": "Mechanic slaves,\nWith greasy aprons, rules, and hammers."
                                            },
                                            {
                                                "example_id": "7544d007-3fc2-4596-9e66-f4cdfbfb9f4a",
                                                "sense_id": "4e61217b-7108-36cc-8164-c4647da701bb",
                                                "text": "Authors both Sacred and Profane we see complain of the Level of Learning, with Mechanick Ignorance: [...]"
                                            },
                                            {
                                                "example_id": "8617d6d8-f14c-4676-9275-c6b3aaf87d67",
                                                "sense_id": "4e61217b-7108-36cc-8164-c4647da701bb",
                                                "text": "But then they did not wrong themſelves ſo much, / To make a God, a Hero, or a King, / (Stripp'd of his golden Crown and purple Robe) / Deſcend to a Mechanick Dialect, / Nor (to avoid ſuch meanneſs) ſoaring high / With empty ſound, and aiery notions fly; [...]"
                                            },
                                            {
                                                "example_id": "ec054c26-5577-4f60-b29e-c4418f521a03",
                                                "sense_id": "4e61217b-7108-36cc-8164-c4647da701bb",
                                                "text": "Sometimes he ply'd the ſtrong mechanic Tool, / Or rear'd the Fabrick from the fineſt Draught; [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mechanic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "635b34d1-1307-324b-9980-4432f1a7d7bd",
                                        "entry_id": "f8a400e9-0b80-3f35-9c0c-4c600e24cbce",
                                        "glosses": [
                                            "A manual worker; a labourer or artisan."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ea66d5-01fb-4719-b9ae-8b2c749bfc7e",
                                                "sense_id": "635b34d1-1307-324b-9980-4432f1a7d7bd",
                                                "text": "His noble earnestness, his fidelity, his gallant shielding of her, his generous conquest of his own wrong and his own pride for her sake, are simply honourable, manly, and true. Nothing less worthy can be seen through the lustre of such qualities in the commonest mechanic, nothing less worthy can be seen in the best-born gentleman."
                                            },
                                            {
                                                "example_id": "5f1784f2-a71f-42ee-8d88-99b97c96c1d8",
                                                "sense_id": "635b34d1-1307-324b-9980-4432f1a7d7bd",
                                                "text": "The lower orders were freer than they had ever been – free […] to choose their own lay preachers, mechanics like the rest of the congregation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4fd0b6-6d42-375a-abc4-c681982c2146",
                                        "entry_id": "f8a400e9-0b80-3f35-9c0c-4c600e24cbce",
                                        "glosses": [
                                            "Someone who builds or repairs machinery, a technician; now specifically, someone who works with and repairs the mechanical parts of a motor vehicle, aircraft or similar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17646e5e-cbfd-3207-837b-0f0263a4a8f0",
                                        "entry_id": "f8a400e9-0b80-3f35-9c0c-4c600e24cbce",
                                        "glosses": [
                                            "A device, method or means; a function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b02adc8-c425-35f5-9918-70c608091660",
                                        "entry_id": "f8a400e9-0b80-3f35-9c0c-4c600e24cbce",
                                        "glosses": [
                                            "A device, method or means; a function.",
                                            "A function, rule or other implementation that dictates gameplay; a ludeme, a feature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c8df72-0ab0-43de-9aeb-74fae53bbeeb",
                                                "sense_id": "3b02adc8-c425-35f5-9918-70c608091660",
                                                "text": "This game has a mechanic where if you run toward a ledge you automatically jump off rather than just falling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed996656-3bff-340d-ae7b-44bda13b7e67",
                                        "entry_id": "f8a400e9-0b80-3f35-9c0c-4c600e24cbce",
                                        "glosses": [
                                            "A hitman."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041a5665-7d02-4a87-884e-484ea6408336",
                                                "sense_id": "ed996656-3bff-340d-ae7b-44bda13b7e67",
                                                "text": "And from then on, his bag was silence. Silence and killing. Overnight he became the best grunt we had, a real killer, a mechanic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a2f636-cf2d-3f02-8610-cfb4ac42ded8",
                                        "entry_id": "f8a400e9-0b80-3f35-9c0c-4c600e24cbce",
                                        "glosses": [
                                            "A cheat who manipulates the cards or dice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbfad5d8-e49e-4836-aa31-a767e21c9dd6",
                                                "sense_id": "d9a2f636-cf2d-3f02-8610-cfb4ac42ded8",
                                                "text": "I can do other things beside burglarizing. I'm a first-class crap dealer, I'm a pretty good card mechanic, pretty good dice mechanic."
                                            },
                                            {
                                                "example_id": "5ded3a0e-5370-4f47-86ff-7c327014e107",
                                                "sense_id": "d9a2f636-cf2d-3f02-8610-cfb4ac42ded8",
                                                "text": "It was so obvious. I mean, all of Nicky's half-assed mechanics, they were real signal happy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad1ef150-a2d7-410d-8c06-4971f3bb3280",
                        "source_entry_id": "c73dd179-dd49-3130-8f29-680cc23bc169",
                        "source_sense_id": "3c2e33fd-9c91-36be-ace2-85618fc1081a",
                        "target_lang_word": "mécanicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mécanicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c0f1858-435d-30e3-bd7d-425e3a3926c6",
                                        "entry_id": "c7f1d222-9575-3116-9e5c-34ef101bb99a",
                                        "glosses": [
                                            "Celui qui invente, conçoit, construit des machines."
                                        ],
                                        "tags": [
                                            "Surtout par apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b10a2ccf-0a27-4485-9abb-61f23c779fff",
                                                "sense_id": "5c0f1858-435d-30e3-bd7d-425e3a3926c6",
                                                "text": "Ingénieur mécanicien. - Chef mécanicien. -"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a86571a-b21f-3f71-adcf-ca04faa99086",
                                        "entry_id": "c7f1d222-9575-3116-9e5c-34ef101bb99a",
                                        "glosses": [
                                            "Ouvrier mécanicien."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bece68ec-c9a8-4bf9-929a-573ce09890e7",
                                                "sense_id": "3a86571a-b21f-3f71-adcf-ca04faa99086",
                                                "text": "Le tuyautage de la turbine est fêlé au ras de la coque, les mécaniciens font une réparation de fortune ; […]."
                                            },
                                            {
                                                "example_id": "73d4f491-da9a-46fd-b0dd-97093c6901fc",
                                                "sense_id": "3a86571a-b21f-3f71-adcf-ca04faa99086",
                                                "text": "Mélie pareil : quatre ou cinq ans pour offrir à son Alphonse, qui est mécanicien de son métier et maquereautin d'occasion, les moyens d'ouvrir un atelier de vélocipèdes ou de bicyclettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2db84b5e-86b3-391e-a106-33ace9f5099e",
                                        "entry_id": "c7f1d222-9575-3116-9e5c-34ef101bb99a",
                                        "glosses": [
                                            "Celui qui monte, répare, règle les machines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219cc7c1-5c09-4b18-90cf-e9ab1b26b667",
                                                "sense_id": "2db84b5e-86b3-391e-a106-33ace9f5099e",
                                                "text": "On employait les mécaniciens à toutes sortes de manœuvres, sauf à l’entretien des appareils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23338a4-1840-3b53-9183-cccb91e42775",
                                        "entry_id": "c7f1d222-9575-3116-9e5c-34ef101bb99a",
                                        "glosses": [
                                            "Ouvrier qui travaille à la machine à coudre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7acfb3-9ba7-4240-acc5-c7070b5c4bbc",
                                                "sense_id": "d23338a4-1840-3b53-9183-cccb91e42775",
                                                "text": "Et il y avait du travail pour tous : bonnetiers, mécaniciens, rebrousseurs, formeuses, remailleuses, visiteuses, chacun, homme ou femme, pouvant y trouver un poste correspondant à sa condition et à ses capacités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63254e7-5680-3030-84f0-2521cd58b1c5",
                                        "entry_id": "c7f1d222-9575-3116-9e5c-34ef101bb99a",
                                        "glosses": [
                                            "Celui qui conduit une locomotive."
                                        ],
                                        "tags": [],
                                        "note": "ce terme qui date de l’époque des locomotives à vapeur continue à être utilisé de nos jours",
                                        "examples": [
                                            {
                                                "example_id": "7f325791-1003-4060-8291-3ec86419640a",
                                                "sense_id": "e63254e7-5680-3030-84f0-2521cd58b1c5",
                                                "text": "Le mécanicien redoute la machine que le voyageur admire, et les officiers étaient un peu les chauffeurs de la locomotive napoléonienne, s’ils n’en furent pas le charbon."
                                            },
                                            {
                                                "example_id": "54c93000-a6e4-4227-a374-271cd4125789",
                                                "sense_id": "e63254e7-5680-3030-84f0-2521cd58b1c5",
                                                "text": "Il va de soi que le même mécanicien et les mêmes chauffeurs ne pourraient faire un service de onze jours. On les remplace donc, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
