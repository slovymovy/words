                    ],
                    "common_phrases": [
                        "de boon groeit",
                        "bloeiende boon"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant species from the legume family that produces edible pulses.",
                        "ru": "Вид растения из семейства бобовых, дающий съедобные плоды."
                    },
                    "translations": {
