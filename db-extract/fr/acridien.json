                        "cross_references": []
                    },
                    {
                        "translation_id": "7ebf38d5-1602-4121-bd17-fc6436792f9f",
                        "source_entry_id": "24f55f67-57bb-3e53-8b51-973ebae819cb",
                        "source_sense_id": "85d68954-0a34-32ea-9846-ad3d328ff9ce",
                        "target_lang_word": "Heuschrecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heuschrecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c431a99-5bc8-30aa-9ba2-066b97d75e99",
                                        "entry_id": "f664a226-c9f8-36aa-b223-24418f917cce",
                                        "glosses": [
                                            "Vertreter einer Ordnung flugfähiger Insekten, die sich vor allem von Gräsern und anderer Vegetation ernährt (Orthoptera)"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8282c889-a2fe-4db5-a7d4-e184ebcdd2ef",
                                                "sense_id": "0c431a99-5bc8-30aa-9ba2-066b97d75e99",
                                                "text": "Heuschrecken findet man oft in Wiesen."
                                            },
                                            {
                                                "example_id": "67b5c52b-cc02-40d7-915d-8344a93cb964",
                                                "sense_id": "0c431a99-5bc8-30aa-9ba2-066b97d75e99",
                                                "text": "„Unmittelbar am Abhang aber standen Libellen in der Luft, und kleine graue Heuschrecken, die sich in der Morgenkühle von Feld und Wiese her bis an den Waldrand gewagt haben mochten, sprangen jetzt, bei sich steigernder Tagesglut, in die kühlere Kleewiese zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ea6a113-14b0-3e5d-a11d-19f865950602",
                                        "entry_id": "f664a226-c9f8-36aa-b223-24418f917cce",
                                        "glosses": [
                                            "Finanzinvestor, der Unternehmen beziehungsweise deren Mitarbeiter durch kurzfristige und/oder überzogene Renditeziele schädigt"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "205bafd1-5602-41e2-8d26-b728655d0957",
                                                "sense_id": "5ea6a113-14b0-3e5d-a11d-19f865950602",
                                                "text": "Der Schwede hat den Lastwagen- und Maschinenbaukonzern immerhin erst vor der Übernahme und Zerschlagung durch Heuschrecken gerettet und dann noch zu Rekordgewinnen geführt. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "eed0d766-b783-4502-8d82-4fa0aaa39ee3",
                                                "sense_id": "5ea6a113-14b0-3e5d-a11d-19f865950602",
                                                "text": "„Damit soll das wiederentdeckte Instrument der Verstaatlichung gleich zwei Heuschrecken in die Flucht treiben: den ausländischen Investor und den deutschen (Bank-)Manager, der es mit seiner Bereicherungswut ein wenig zu weit getrieben und uns diese böse Krise beschert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b16fba2-18f8-45b1-8f1c-11c6006eb9bc",
                        "source_entry_id": "24f55f67-57bb-3e53-8b51-973ebae819cb",
