                        "entry_id": "fa5cd83f-6799-3d9a-bfff-5fdc47ed5eb5",
                        "glosses": [
                            "Sprache, die Vertreter dieser Sprachfamilie ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f3d7fe-d87a-4b16-aefc-392423ed7012",
                                "sense_id": "46adacd5-1d0a-3d59-9b08-24f64cf3aca3",
                                "text": "„Ojibwa ist die Algonkin-Sprache mit den meisten Sprechern (10400).“"
                            }
