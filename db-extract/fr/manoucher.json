                "senses": [
                    {
                        "sense_id": "ae15838c-877e-3d7b-808a-9605df050cd1",
                        "entry_id": "9eb86e13-5047-3b67-9c8f-e00eadeabb95",
                        "glosses": [
                            "Bricoler."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "79c84605-b51b-41fb-bef1-76ac64da0f51",
                                "sense_id": "ae15838c-877e-3d7b-808a-9605df050cd1",
                                "text": "j'aime bien bricoler (vous apprendrez très vite que bricoler est pour un vague synonyme de manoucher/gitaniser)"
                            }
                        ]
                    },
                    {
                        "sense_id": "7ae61507-07fa-3742-a774-bfc0862504ed",
                        "entry_id": "9eb86e13-5047-3b67-9c8f-e00eadeabb95",
                        "glosses": [
                            "Voler, subtiliser un objet de valeur importante, et ce de manière perfide."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c3ea7409-200c-4d80-93e5-79c1be64ad27",
                                "sense_id": "7ae61507-07fa-3742-a774-bfc0862504ed",
                                "text": "Il y a quelques semaines, j'ai vu une dame se faire manoucher sa carte bleue au même endroit par 3 très jeunes filles."
                            },
                            {
                                "example_id": "2c279287-11c8-44ba-ae3f-19f49e942a5e",
                                "sense_id": "7ae61507-07fa-3742-a774-bfc0862504ed",
                                "text": "Mercredi dernier, ma copine se fait manoucher … son porte-monnaie en achetant des tickets de métro à la station Chaussée d'Antin."
                            },
                            {
                                "example_id": "0d101834-ce1a-4f0c-a512-c4e4e813257c",
                                "sense_id": "7ae61507-07fa-3742-a774-bfc0862504ed",
                                "text": "J'ai joué avec les enfants, me suis fait manoucher ma crème solaire Biafine pour le visage de bon gré, ai offert un petit bracelet à la petit fille, ai rapidement échangé avec les femmes, superbes au demeurant, en leur disant qu'elles n'avaient pas besoin de me promettre des 1000 et des 100 et une vie merveilleuse, j'étais deja assurée d'avoir avec moi une bonne étoile, \"la buena fe\"."
                            }
                        ]
                    }
                ],
