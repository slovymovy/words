                "translations": [
                    {
                        "translation_id": "56ac521f-8d7f-41a2-8331-5979703976af",
                        "source_entry_id": "32329aa2-19af-348c-9eb8-db3128125200",
                        "source_sense_id": "83d82f04-e4ec-3eb5-b6fd-d50ee7716912",
                        "source_sense_description": "a preserve or candied fruit",
                        "target_lang_word": "confiture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confiture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                        "entry_id": "70fc70bd-579f-3a39-a576-0015b72a41fa",
                                        "glosses": [
                                            "Mélange gélifié de sucre, de pulpe ou de purée d'une ou plusieurs espèces de fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab79fb1f-5869-474a-9de4-0628aa78bed3",
                                                "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                                "text": "Après ce premier exploit, les époux se partagèrent une grosse poire de Saint-Germain, et mangèrent un peu de confiture d'orange."
                                            },
                                            {
                                                "example_id": "0ed1097d-2aad-4908-b626-f450a2d44425",
                                                "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                                "text": "Fouquet commanda qu'on portât les bassins de confiture et les fontaines de liqueurs dans le salon attenant à la galerie."
                                            },
                                            {
                                                "example_id": "69b2ba6c-7406-42bd-ae97-738ec82fb115",
                                                "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                                "text": "… sur la partie haute, on voyait de la volaille, du daim, […], accompagnés de pains massifs, de galettes et de différentes confitures faites de fruits et de miel."
                                            },
                                            {
                                                "example_id": "5474a17a-362d-4882-8580-c76a96950c51",
                                                "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                                "text": "… elle lui met dans la bouche une cuillerée de confitures, en symbole des douces pensées qu’il faut apporter en passant le seuil nuptial."
                                            },
                                            {
                                                "example_id": "566da304-e014-496f-b2a4-3a8a576b8389",
                                                "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                                "text": "La préparation des confitures nous réjouissait. C'était un rite immuable. Notre mère se servait d'un grand chaudron en cuivre rouge et d’une écumoire à trous pour clarifier le jus et surveiller sa consistance. Elle mettait au fur et à mesure l'écume dans une assiette et laissait cuire jusqu'à la perle."
                                            },
                                            {
                                                "example_id": "fde70e94-ae46-4da2-9b60-6d70ca335320",
                                                "sense_id": "ec15c564-1c61-3d51-8528-b0aaba8db656",
                                                "text": "Le premier livre français sur les confitures est celui de Michel de Notre-Dame – plus connu pour ses prophéties ou « centuries » sous le nom de Nostradamus –, qui parut en 1555."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd14ec8-ddc0-306a-8e4b-6bc4b2e38a13",
                                        "entry_id": "70fc70bd-579f-3a39-a576-0015b72a41fa",
                                        "glosses": [
                                            "Couleur qui manque de naturel, de réalisme."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c29071fd-69a9-4eba-b724-09da39709ad9",
                                                "sense_id": "6dd14ec8-ddc0-306a-8e4b-6bc4b2e38a13",
                                                "text": "Sur les murs nus, on avait peint des chameaux et des palmiers, noyés dans une confiture rose et violette — (Camus - L'exil et le royaume)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a30daf50-9c26-3bbf-85e3-4552b40f2299",
                                        "entry_id": "70fc70bd-579f-3a39-a576-0015b72a41fa",
                                        "glosses": [
                                            "Galimatias."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef07658d-096f-4b23-a77d-d6aa5fd80ef1",
                                                "sense_id": "a30daf50-9c26-3bbf-85e3-4552b40f2299",
                                                "text": "Le contraste de ces confitures philosophiques et de ces sépulcrales abominations formait un plat hybride, peu comestible, mais d’un goût étrange, qui plaisait à ces jolies dames, vêtues si drôlement, avec des bagues aux orteils, la ceinture au-dessus du sein, la hanche dans un fourreau de parapluie et la tête sous une gigantesque feuille de chicorée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64396c39-67da-34a5-ad16-70872d9ded52",
                                        "entry_id": "70fc70bd-579f-3a39-a576-0015b72a41fa",
                                        "glosses": [
                                            "Substance hallucinogène."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
