                "senses": [
                    {
                        "sense_id": "b56781e1-deaf-3f08-8380-3c65238aa0f1",
                        "entry_id": "75559ebe-e73d-3a26-aba8-89840c3f2d08",
                        "glosses": [
                            "wertvolles gesegnetes Öl für Salbungen"
                        ],
                        "tags": [
                            "ostkirchlich"
                        ],
                        "examples": [
                            {
                                "example_id": "eba377b2-ece2-43a0-9e3a-53ad53bb9d1f",
                                "sense_id": "b56781e1-deaf-3f08-8380-3c65238aa0f1",
                                "text": "„Und einer der Priester nimmt das heilige Myron vom Altar und gibt es dem Bischof.“"
                            },
                            {
                                "example_id": "129ec8e2-d43c-422b-a403-c1a4e33967c3",
                                "sense_id": "b56781e1-deaf-3f08-8380-3c65238aa0f1",
                                "text": "„Sie bestand vermutlich aus einem mit Myron, heiligem Öl, getränkten Tüchlein, vielleicht auch aus geheiligter Erde.“"
                            },
                            {
                                "example_id": "c8220109-d915-437e-930c-8f35f1f8420e",
                                "sense_id": "b56781e1-deaf-3f08-8380-3c65238aa0f1",
                                "text": "„So warfen die Syrer den Armeniern den Gebrauch von Sesamöl (wenn nichts anderes zu beschaffen war) anstatt des Olivenöls für die Herstellung des Myrons vor; […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
