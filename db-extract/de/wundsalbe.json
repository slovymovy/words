                "senses": [
                    {
                        "sense_id": "ee57ae75-f39b-35e1-9a6d-e15bed5ac40a",
                        "entry_id": "32930fa9-be00-3871-b50c-efd47c1fc58b",
                        "glosses": [
                            "Salbe zur medizinischen Behandlung von Wunden; Wundheilung unterstützende Salbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26756442-1405-4242-85bc-794214e119dc",
                                "sense_id": "ee57ae75-f39b-35e1-9a6d-e15bed5ac40a",
                                "text": "Der Apotheker begann, eine Wundsalbe anzurühren."
                            },
                            {
                                "example_id": "21114f97-071b-4df2-928d-a3b8cec89d79",
                                "sense_id": "ee57ae75-f39b-35e1-9a6d-e15bed5ac40a",
                                "text": "Sie begann vorsichtig, die Wundsalbe aufzutragen."
                            },
                            {
                                "example_id": "3f9e1819-06dc-44c9-8423-fe7448282dc9",
                                "sense_id": "ee57ae75-f39b-35e1-9a6d-e15bed5ac40a",
                                "text": "Im Medizinschränkchen fand sich Verbandmaterial, Jodtinktur und eine Wundsalbe."
                            },
                            {
                                "example_id": "08bc4c5e-4c1f-4b6c-8b85-ca0fbcb32e9f",
                                "sense_id": "ee57ae75-f39b-35e1-9a6d-e15bed5ac40a",
                                "text": "Roberts Arm wird leicht verbunden, Wundsalbe appliziert, der Hemdärmel übergezogen."
                            },
                            {
                                "example_id": "e2a98318-3c64-4139-bb95-8bd7fcc4b833",
                                "sense_id": "ee57ae75-f39b-35e1-9a6d-e15bed5ac40a",
                                "text": "Dort bestrich sie sich am ganzen Leibe mit Wundsalbe und Balsam und kühlte und pflasterte vier Wochen lang, bis alles wieder heil geworden war."
                            }
                        ],
                        "sense_index_json": "\"1\""
