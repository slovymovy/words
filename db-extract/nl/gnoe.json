                                                "sense_id": "01769345-6af0-39d1-a6a3-6a10195c4020",
                                                "text": "Dassoud […] stepped forward with a lash composed of the caudal appendages of half a dozen wildebeests."
                                            },
                                            {
                                                "example_id": "1e513314-cfcd-4967-8809-e92bb556db81",
                                                "sense_id": "01769345-6af0-39d1-a6a3-6a10195c4020",
                                                "text": "Later that morning, they wrapped Ian in a wildebeest skin and buried him near a shepherd tree."
                                            },
                                            {
                                                "example_id": "09cda4da-aaac-465a-9d41-f254d974ee05",
                                                "sense_id": "01769345-6af0-39d1-a6a3-6a10195c4020",
                                                "text": "A group of wildebeest is called a confusion."
                                            }
                                        ]
