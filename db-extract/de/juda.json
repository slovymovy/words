                                "target_senses": [
                                    {
                                        "sense_id": "8c37bcb3-0df3-3488-a5ac-024d650e8ec6",
                                        "entry_id": "3dca61bd-ce62-34ff-bd18-3c601bc75237",
                                        "glosses": [
                                            "The fourth son of Jacob, by his wife Leah; the father of Perez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cce2780-ff17-4abd-984b-e9d2040cbc54",
                                                "sense_id": "8c37bcb3-0df3-3488-a5ac-024d650e8ec6",
                                                "text": "Now the sons of Jacob were twelve: ²³ The sons of Leah; Reuben, Jacob's firstborn, and Simeon, and Levi, and Judah, and Issachar, and Zebulun: ²⁴ The sons of Rachel; Joseph, and Benjamin: ²⁵ And the sons of Bilhah, Rachel's handmaid; Dan, and Naphtali: ²⁶ And the sons of Zilpah, Leah's handmaid; Gad, and Asher: these are the sons of Jacob, which were born to him in Padan-aram."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d469f0d6-bee1-30ed-98ae-1cba4ae40740",
                                        "entry_id": "3dca61bd-ce62-34ff-bd18-3c601bc75237",
                                        "glosses": [
                                            "One of the Israelite tribes, and, according to some Abrahamic religions, descended from Judah, and from which David and his lineage came."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "950492ce-27b3-3871-a2ad-1adc45ab9341",
                                        "entry_id": "3dca61bd-ce62-34ff-bd18-3c601bc75237",
                                        "glosses": [
                                            "A traditional region and ancient kingdom (c. 930 — 586 BCE) in the Land of Israel in modern Israel and Palestine; the southern Israelite kingdom which continued to be ruled by the Davidic dynasty after Solomon's death and the breakup of the united monarchy, with the northern portion keeping the name Israel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "614d8b5f-bba4-447a-b444-387c3c54f90c",
                                                "sense_id": "950492ce-27b3-3871-a2ad-1adc45ab9341",
                                                "text": "And they gave them the city of Arba the father of Anak, which city is Hebron, in the hill country of Judah, with the suburbs thereof round about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02708fff-b26b-3f35-b8da-80f881674933",
                                        "entry_id": "3dca61bd-ce62-34ff-bd18-3c601bc75237",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
