                    {
                        "sense_id": "73a66f1d-c357-3d6d-9c7b-a4b4e789fd99",
                        "entry_id": "1d076abb-243d-373f-b66d-1bd398ece024",
                        "glosses": [
                            "Vertreter einer Gattung der Menschenaffen, die während des späten Miozän in Europa lebte"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a05ba6fe-3cfa-486a-9c61-da95affc81ac",
                                "sense_id": "73a66f1d-c357-3d6d-9c7b-a4b4e789fd99",
                                "text": "„Unmittelbar neben den Fundplätzen der Danuvius-Knochen – dort, wo sich in der Epoche des mittleren Miozäns ein Fluss an einem Auwald entlangschlängelte – kamen die Überreste von Buronius zum Vorschein.“"
                            },
                            {
                                "example_id": "40651ef8-0d4e-4b1a-a475-e3a7b8076a21",
                                "sense_id": "73a66f1d-c357-3d6d-9c7b-a4b4e789fd99",
                                "text": "„Außerdem sei es sehr ungewöhnlich, dass sie Knochen von zwei verschiedenen Menschenaffen-Gruppen – also Danuvius und Buronius – in genau der gleichen Fundschicht entdeckt hätten.“"
                            }
                        ],
