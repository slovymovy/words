                "senses": [
                    {
                        "sense_id": "da8a9646-f2f2-3748-b2e6-3a6a4344d377",
                        "entry_id": "73e29650-58ee-333a-b401-95eff8928272",
                        "glosses": [
                            "Espèce de dauphin d’eau douce des bassins du Gange et du Brahmapoutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce9a7df2-8f86-4778-996c-520e3bec5835",
                                "sense_id": "da8a9646-f2f2-3748-b2e6-3a6a4344d377",
                                "text": "Le dauphin du Gange a été baptisé «susu» ou «sousouc» par les populations locales, en référence au bruit que le dauphin produit, lorsqu’il respire en surface."
                            },
                            {
                                "example_id": "fd0901e7-6095-404d-b042-57a16b929ca3",
                                "sense_id": "da8a9646-f2f2-3748-b2e6-3a6a4344d377",
                                "text": "Selon certains, il s’agirait du cadavre d’un sousouc, ou plataniste du Gange, un dauphin d’eau douce qui vit dans le bassin du Gange en Inde et qui est en voie d'extinction"
                            }
                        ]
                    }
                ],
