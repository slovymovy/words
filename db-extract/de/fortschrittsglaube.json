                            {
                                "example_id": "abaabd2e-715f-4e3c-9a16-9a102add0f11",
                                "sense_id": "b226f02e-ab91-3e53-bfac-0c3495714aef",
                                "text": "„Aufgrund der Katastrophenerfahrungen des 20. Jahrhunderts geriet der Fortschrittsglaube immer tiefer in die Krise.“"
                            },
                            {
                                "example_id": "83d25429-a574-4d3b-ae19-787f08cc659b",
                                "sense_id": "b226f02e-ab91-3e53-bfac-0c3495714aef",
                                "text": "„Fortschrittsglaube und hochfliegende Heilungsversprechen scheinen dennoch die Formulierung einer neuen Ethik zu verlangen.“"
                            },
                            {
                                "example_id": "1c3cfa8b-c9be-4847-8d0a-fa413491f6ec",
                                "sense_id": "b226f02e-ab91-3e53-bfac-0c3495714aef",
                                "text": "„Vom alten Marxismus übrig geblieben sind der Industrialismus als Heilslehre und ein unbedingter Fortschrittsglaube.“"
                            }
                        ],
