                    {
                        "sense_id": "15c3fadc-6304-365c-b266-559f1daeaa32",
                        "entry_id": "6f6cb164-093d-3c11-b2b7-5e440efd35d3",
                        "glosses": [
                            "Gewitterart, die fast ausschließlich im Sommer auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52deba72-cd79-46a0-94c5-457718790ef9",
                                "sense_id": "15c3fadc-6304-365c-b266-559f1daeaa32",
                                "text": "Am Tag war es sehr heiß und abends entlud sich ein heftiges Wärmegewitter."
                            },
                            {
                                "example_id": "2ac8fd43-f134-44a5-ae26-e1e2dcbec34d",
                                "sense_id": "15c3fadc-6304-365c-b266-559f1daeaa32",
                                "text": "„Beim Luftmassengewitter oder Wärmegewitter entsteht die hoch reichende Labilität durch eine starke Aufheizung der Erdoberfläche.“"
                            },
                            {
                                "example_id": "dd08e658-db8b-41c4-9228-b29942de7d4d",
                                "sense_id": "15c3fadc-6304-365c-b266-559f1daeaa32",
                                "text": "„Wärmegewitter entstehen durch starke Aufheizung an der Erdoberfläche bei gleichzeitig hoher Luftfeuchtigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
