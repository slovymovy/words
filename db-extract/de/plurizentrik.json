                "senses": [
                    {
                        "sense_id": "e0000353-1a74-3b63-8641-15dfa3e49d56",
                        "entry_id": "9b3aa3fe-7a38-3e3a-83fa-e7511eb5a869",
                        "glosses": [
                            "das Vorkommen einer Sprache mit jeweils eigener Ausprägung in verschiedenen Zentren, also als plurizentrische Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3990529-0cb7-4704-a34b-47e19741b70b",
                                "sense_id": "e0000353-1a74-3b63-8641-15dfa3e49d56",
                                "text": "„Die Plurizentrik zeigt sich aber nicht nur in der Lexik, sondern beispielsweise auch in der Schreibung…“."
                            },
                            {
                                "example_id": "a932e36a-e063-420d-af33-ee107b9be52b",
                                "sense_id": "e0000353-1a74-3b63-8641-15dfa3e49d56",
                                "text": "Englisch mit seinen verschiedenen Ausprägungen in den englischsprachigen Ländern ist ein deutlicheres Beispiel für Plurizentrik als etwa Deutsch."
                            },
                            {
                                "example_id": "0ae3e279-d7ca-4203-823a-e20ccde774bf",
                                "sense_id": "e0000353-1a74-3b63-8641-15dfa3e49d56",
                                "text": "„Diese Aspekte werden in den Diskussionen um die spanische Plurizentrik, die seit einiger Zeit vehement geführt werden, thematisiert.“"
                            },
                            {
                                "example_id": "29b549a7-4fef-4e3f-ae05-7414ba680cee",
                                "sense_id": "e0000353-1a74-3b63-8641-15dfa3e49d56",
                                "text": "„Das Konzept der Plurizentrik ist sicherlich, wenn es sich denn für das Spanische als noch nicht tatsächlich realisiert erweist, in der Form eines Leitbildes eine vielversprechende Folie für die sprachliche Selbstdefinition und Abgrenzung von Sprechergemeinschaften innerhalb der hispanophonen Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
