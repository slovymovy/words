                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "b1e668fd-88e4-42f1-a7c9-76b587240cb0",
                                "sense_id": "505e4b31-a708-3187-815b-6ac2a4fcd1ba",
                                "text": "Wadend bereikte ik het Palace Hotel, waar ik mij geheel doorweekt naar de bar spoedde. Garçon! Drei martini!"
                            },
                            {
                                "example_id": "f1788c4e-6884-4b26-8e6a-75d957c0b76b",
                                "sense_id": "505e4b31-a708-3187-815b-6ac2a4fcd1ba",
                                "text": "Toen het ons nog niet heel duidelijk was, hoe wij in Médan moesten komen, riepen wij de garçon erbij. Deze scheen iemand van veel ervaring en een in ieder opzicht uitstekende kelner van rijpe leeftijd."
                            }
                        ]
