                "senses": [
                    {
                        "sense_id": "171a0b33-1bfa-3174-a216-20c8ef9cc82f",
                        "entry_id": "0dd6f69c-51bf-3387-9cce-d70dc2cc2b7e",
                        "glosses": [
                            "Habitant de l’Estrémadure, en Espagne."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a036ec8f-43cc-44ee-a26d-41b3f3731ac0",
                                "sense_id": "171a0b33-1bfa-3174-a216-20c8ef9cc82f",
                                "text": "Là, siégeaient le colon des îles Philippines, le descendant des Incas, l’Espagnol du Mexique, le représentant des Tlascaltèques, à côté de l’Andaloux et du Catalan, du Murcien et du Galliègue, de l’Asturien et de l’Estrémègne, du Léonère et de l’Aragonais."
                            },
                            {
                                "example_id": "b77b8a28-8441-499a-b737-65705066f0d7",
                                "sense_id": "171a0b33-1bfa-3174-a216-20c8ef9cc82f",
                                "text": "L’Estrémègne est triste et grossier ; l’Andalous, rival irréconciliable de l’habitant de la Manche, qu’il dédaigne, est le Gascon de l’Espagne […]"
                            }
                        ]
                    }
