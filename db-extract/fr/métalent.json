                        ],
                        "examples": [
                            {
                                "example_id": "696fa849-f32a-4ffc-92b4-c1c0d8f6ae98",
                                "sense_id": "8fee376d-f293-342e-bfbd-13dd7e15413b",
                                "text": "Ses agrémens grimacent, & marquent du métalent dans l’art de s’embellir."
                            },
                            {
                                "example_id": "16f125e1-3428-4156-8867-5a4675ae3a09",
                                "sense_id": "8fee376d-f293-342e-bfbd-13dd7e15413b",
                                "text": "Elle avait été si souvent trompée dans les services qu’elle avoit rendus, qu’elle craignoit toujours de proteger le métalent effronté ou le vice artificieux aux dépens du mérite modeste ou de l’humble vertu."
                            },
                            {
                                "example_id": "956898e1-6759-4a26-8da6-de2f668f9310",
                                "sense_id": "8fee376d-f293-342e-bfbd-13dd7e15413b",
                                "text": "Je ne puis qu’accéder entièrement à tout ce que vous dites et de votre incontestable supériorité en économie politique, et de mon métalent en cette matière."
                            }
                        ]
                    }
