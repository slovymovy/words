                        "entry_id": "8e47489e-fe73-3c28-b72c-47e70c504d80",
                        "glosses": [
                            "Qui favorise la digestion, en parlant d’un produit, d’un extrait de plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf11731-4a40-4279-b09a-1a48a24b59a3",
                                "sense_id": "79f3b03f-d4f4-3906-b4c0-551cb43230c5",
                                "text": "L’anis, la menthe, la gentiane, le vin et le quinquina à doses modérées, ont des propriétés eupeptiques."
                            }
                        ]
                    }
                ],
