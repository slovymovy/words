                "senses": [
                    {
                        "sense_id": "3c437f10-9032-3ab4-9ccc-3e00e63b2f9d",
                        "entry_id": "b91e478b-d688-3be2-9584-5d9f77477321",
                        "glosses": [
                            "Dichte/Menge des Verkehrs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e03af486-36b9-4ce2-8c38-f0ad72080bf2",
                                "sense_id": "3c437f10-9032-3ab4-9ccc-3e00e63b2f9d",
                                "text": "„Das Verkehrsaufkommen dürfte sich so wie auf allen anderen Linien auch entwickelt haben.“"
                            },
                            {
                                "example_id": "7f2ae228-82eb-43b8-9de0-77a2de39300c",
                                "sense_id": "3c437f10-9032-3ab4-9ccc-3e00e63b2f9d",
                                "text": "„Die Stadt war erwacht, und noch immer erstaunte mich das Verkehrsaufkommen in Tórshavn.“"
                            },
                            {
                                "example_id": "99535d1b-70c6-46fd-a06e-d3e40d641c86",
                                "sense_id": "3c437f10-9032-3ab4-9ccc-3e00e63b2f9d",
                                "text": "„Hier verläuft das Leben ruhiger, das Verkehrsaufkommen ist gering und es gibt keine Staus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
