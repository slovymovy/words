                                        "sense_id": "5205e52e-482e-36a1-9dc6-fb655c42989e",
                                        "entry_id": "1ccd4e31-5549-31d9-80fa-d16b3e2dc581",
                                        "glosses": [
                                            "Qui fait montre d’un manque de fermeté morale."
