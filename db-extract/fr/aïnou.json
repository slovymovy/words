                                        "entry_id": "93f9086e-02e5-3b57-80cf-d1eb009c17eb",
                                        "glosses": [
                                            "A member of an ethnic group on the northern Japanese island of Hokkaido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4bd3e6d-f9ae-47b1-9799-76dedede88ec",
                                                "sense_id": "cb11c9b7-d579-3c69-bd85-8d27cf265df6",
                                                "text": "In the past, the Ainu (their selfname meaning 'person'), traditionally huntergatherers, occupied not only Hokkaido but also a considerable part of the island of Honshu until the middle the eighteenth century, […]"
                                            }
                                        ]
                                    },
