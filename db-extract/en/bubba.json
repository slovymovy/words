        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "de30548a-7f85-3615-ae2b-e6c98ce5e271",
                "word": "Bubba",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38acb544-d225-32e7-a05f-1e979f3526bb",
                        "entry_id": "de30548a-7f85-3615-ae2b-e6c98ce5e271",
                        "glosses": [
                            "The stereotypical white male; John Doe."
                        ],
                        "tags": [
                            "Southern-US"
                        ],
                        "examples": [
                            {
                                "example_id": "b2222a6d-d7be-4ba7-8289-8b71050b470d",
                                "sense_id": "38acb544-d225-32e7-a05f-1e979f3526bb",
                                "text": "German businesses wonder what Otto Normalverbraucher will buy, while US politicians fret over who Bubba will vote for in the next US election."
                            }
                        ]
                    },
                    {
                        "sense_id": "753801ce-64cf-38f5-a1e0-ca1edb572950",
                        "entry_id": "de30548a-7f85-3615-ae2b-e6c98ce5e271",
                        "glosses": [
                            "A generic nickname for any white male."
                        ],
                        "tags": [
                            "Southern-US"
                        ],
                        "examples": [
                            {
                                "example_id": "ec60bd85-914b-4ca6-b026-e0ebeb1704d9",
                                "sense_id": "753801ce-64cf-38f5-a1e0-ca1edb572950",
                                "text": "Watch it, Bubba!"
                            },
                            {
                                "example_id": "68764670-d12c-487f-b757-ab8883d05291",
                                "sense_id": "753801ce-64cf-38f5-a1e0-ca1edb572950",
                                "text": "[Bill] Clinton knew and maintained a lifelong affection for the small-town Arkansans world in which he had been reared—he relished being called Bubba—and delighted in opportunities that campaigning gave him to reconnect with places like it."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d9b1589-6364-39fd-ad28-77f173ae8d8d",
                        "entry_id": "de30548a-7f85-3615-ae2b-e6c98ce5e271",
                        "glosses": [
                            "A nickname for a brother, usually the eldest brother and initially used only by young children before sometimes spreading to become a person's general adult nickname."
                        ],
                        "tags": [
                            "Southern-US"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "23105a35-0f95-3c1f-904e-46fa34232180",
                "word": "bubba",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "46a5ae53-b5cb-4693-8f0f-bbe9b66c9855",
                        "entry_id": "23105a35-0f95-3c1f-904e-46fa34232180",
                        "tags": [
                            "plural"
                        ],
                        "form": "bubbas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b0c9530-397e-345e-8de8-89ac3988c512",
                        "entry_id": "23105a35-0f95-3c1f-904e-46fa34232180",
                        "glosses": [
                            "Brother; used as term of familiar address."
                        ],
                        "tags": [
                            "Southern-US",
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "ed7597c1-d954-44b7-b179-cf3acc0fd676",
                                "sense_id": "7b0c9530-397e-345e-8de8-89ac3988c512",
                                "text": "\"Hey, bubba, is that really you? Goddamn. I haven't heard from you in a coon's age.\" / \"Don't 'hey, bubba' me, you sonofabitch."
                            }
                        ]
                    },
                    {
                        "sense_id": "399114bd-9be4-3e08-8dcc-c7800b59e6b1",
                        "entry_id": "23105a35-0f95-3c1f-904e-46fa34232180",
                        "glosses": [
                            "A working-class white male from the southern US, stereotyped as loutish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315d761c-e855-4634-a1db-4df1efdeea8c",
                                "sense_id": "399114bd-9be4-3e08-8dcc-c7800b59e6b1",
                                "text": "Will Ferrell and his creative partner, the writer and director Adam McKay, are, let’s face it, our national poets on the subject of dimwitted, bubba arrogance and the redemptive powers of failure, their poems seemingly conceived in a midnight frenzy of brilliance on the back of a bag of Doritos."
                            },
                            {
                                "example_id": "d329ba45-dc42-4761-b3e9-5f63b2d0225a",
                                "sense_id": "399114bd-9be4-3e08-8dcc-c7800b59e6b1",
                                "text": "Their subjects were not bubbas from the bayous but affluent students at the University of Michigan who had lived in the South for at least six years."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
