{
    "word": "murmelen",
    "lang_code": "nl",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                "word": "murmelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                        "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                        "glosses": [
                            "zachtjes en onverstaanbaar praten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b71563-91bd-4ce6-8149-89cf96ce8b03",
                                "sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                                "text": "Mijn oude oma zat altijd in haar stoel te murmelen."
                            },
                            {
                                "example_id": "d81949e6-f5c1-4dec-8d79-555b648b2c7d",
                                "sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                                "text": "Centrum Gent, stralende winterdag die wel lente lijkt. Aan mijn vrolijke soldeneuforie komt prompt een eind als ik word achtervolgd door een man. Twee straten lang loopt hij achter me aan, van alles murmelend wat ik niet versta of wil verstaan. Instant angst, onderbuik in een kramp. Aan mijn auto blijft hij zich opdringen tot ik instap en wegrijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ed30f88-6eea-3c2e-bead-eac5c7d827bf",
                        "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                        "glosses": [
                            "zacht ruisen van bijvoorbeeld een beekje"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b40918fe-8995-3b28-9b0b-87ebd2f4d020",
                        "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                        "glosses": [
                            "zachtjes mopperen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be49c54f-ee35-4491-b741-9a04060ebc6a",
                                "sense_id": "b40918fe-8995-3b28-9b0b-87ebd2f4d020",
                                "text": "Na de 2-1 komt het oude euvel om de hoek kijken. We gaan te veel naar achteren lopen, het publiek begint te murmelen en de dreiging van de 2-2 ligt op de loer. Daarbij wil ik ook de complimenten aan Achilles geven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d615f2f1-33fa-4edd-b721-e6b6b98bb6a2",
                        "source_entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                        "source_sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                        "source_sense_description": "zachtjes en onverstaanbaar praten",
                        "target_lang_word": "murmur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murmur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9df9f0f9-ad28-3111-abd9-d75b5172d762",
                                        "entry_id": "8e881f8d-1d1a-3da5-a283-fcbd1b52233d",
                                        "glosses": [
                                            "Any low, indistinct sound, like that of running water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d594750-cab7-4981-a1bf-3770d5baf782",
                                                "sense_id": "9df9f0f9-ad28-3111-abd9-d75b5172d762",
                                                "text": "The delightful murmur of water running over pebbles is heard a few yards off"
                                            },
                                            {
                                                "example_id": "94686700-48f7-4133-9fba-f90a1004a213",
                                                "sense_id": "9df9f0f9-ad28-3111-abd9-d75b5172d762",
                                                "text": "1979: A translation of the Eclogues by Paul Alpers\nThe windy murmur of the breeze subsides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a97b745-3581-368b-803a-f0e0cdb93d6d",
                                        "entry_id": "8e881f8d-1d1a-3da5-a283-fcbd1b52233d",
                                        "glosses": [
                                            "Soft indistinct speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35abc8bb-79ac-4689-9016-d8c5d180cc8a",
                                                "sense_id": "5a97b745-3581-368b-803a-f0e0cdb93d6d",
                                                "text": "A murmur arose from the audience."
                                            },
                                            {
                                                "example_id": "93bb2a37-7a9f-43f8-a1f3-f528b32356e3",
                                                "sense_id": "5a97b745-3581-368b-803a-f0e0cdb93d6d",
                                                "text": "In the prison of the 'tween decks reigned a darkness pregnant with murmurs. The sentry at the entrance to the hatchway was supposed to \"prevent the prisoners from making a noise,\" but he put a very liberal interpretation upon the clause, and so long as the prisoners refrained from shouting, yelling, and fighting--eccentricities in which they sometimes indulged--he did not disturb them."
                                            },
                                            {
                                                "example_id": "3e1eeb74-058b-4461-8d74-a0aadf9f4db9",
                                                "sense_id": "5a97b745-3581-368b-803a-f0e0cdb93d6d",
                                                "text": "The moment had come for the honeyed word. I lowered my voice to a confidential murmur, but on her inquiring if I had laryngitis raised it again."
                                            },
                                            {
                                                "example_id": "63497b9e-c012-4d1d-a8ae-63583eed1a59",
                                                "sense_id": "5a97b745-3581-368b-803a-f0e0cdb93d6d",
                                                "text": "[President Trump's firing of a dozen inspectors general] seems to have violated a law requiring that he provide 30 days’ notice, and set off a rare murmur of dissent from Capitol Hill Republicans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5a8e15-bddc-31b6-b4ba-853a7ef0e79f",
                                        "entry_id": "8e881f8d-1d1a-3da5-a283-fcbd1b52233d",
                                        "glosses": [
                                            "The sound made by any condition which produces a noisy, or turbulent, flow of blood through the heart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f6421ea-bf4c-3715-b851-c2437f95699c",
                                        "entry_id": "8e881f8d-1d1a-3da5-a283-fcbd1b52233d",
                                        "glosses": [
                                            "A muttered complaint or protest; the expression of dissatisfaction in a low muttering voice; any expression of complaint or discontent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66e4ee61-3fc0-4caf-9c8b-28c32b1ad43f",
                                                "sense_id": "0f6421ea-bf4c-3715-b851-c2437f95699c",
                                                "text": "In fear of disease and in the interest of his health man will be muzzled and masked like a vicious dog, and that without any murmur of complaint."
                                            },
                                            {
                                                "example_id": "86c6642f-7719-49c9-a43b-2a4bd779be19",
                                                "sense_id": "0f6421ea-bf4c-3715-b851-c2437f95699c",
                                                "text": "Since aortic diastolic pressure is higher than pulmonary artery systolic pressure, there is continuous flow into the pulmonary circulation, creating the characteristic continuous (\"machinery\") murmur, heard best just below the left clavicle."
                                            },
                                            {
                                                "example_id": "301af5f8-d18a-434a-bbb1-5d5c7a12cb69",
                                                "sense_id": "0f6421ea-bf4c-3715-b851-c2437f95699c",
                                                "text": "Glossop will return from his afternoon off to find the awful majesty of the Law waiting for him, complete with handcuffs. We can hardly expect him to accept an exemplary sentence without a murmur, so his first move will be to establish his innocence by revealing all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "murmur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8fadaa0-06de-30d9-b1b2-2e6fb534c3a4",
                                        "entry_id": "e266ed6b-17ae-347f-800d-2b25d9c9fd52",
                                        "glosses": [
                                            "To grumble; to complain in a low, muttering voice, or express discontent at or against someone or something."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79c4d553-23de-446d-b246-84221da078a5",
                                                "sense_id": "e8fadaa0-06de-30d9-b1b2-2e6fb534c3a4",
                                                "text": "The Iewes then murmured at him because he sayde: I am that breed which is come doune from heaven."
                                            },
                                            {
                                                "example_id": "02294896-9a77-40ba-b491-984dfba4f2f3",
                                                "sense_id": "e8fadaa0-06de-30d9-b1b2-2e6fb534c3a4",
                                                "text": "And now, behold thy brothers murmur, saying it is a hard thing which I have required of them; but behold I have not required it of them, but it is a commandment of the Lord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d01376-b50c-3f9a-b953-e3d093f58746",
                                        "entry_id": "e266ed6b-17ae-347f-800d-2b25d9c9fd52",
                                        "glosses": [
                                            "To speak or make low, indistinguishable noise; to mumble, mutter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "654d476a-8055-4b3c-b271-3393c62a3e07",
                                                "sense_id": "93d01376-b50c-3f9a-b953-e3d093f58746",
                                                "text": "I couldn't hear the words; he just murmured a lot."
                                            },
                                            {
                                                "example_id": "be3bff15-9b59-47d8-bfa7-c17289df9cf1",
                                                "sense_id": "93d01376-b50c-3f9a-b953-e3d093f58746",
                                                "text": "The bees murmured in the forest. The waves murmured on the shore."
                                            },
                                            {
                                                "example_id": "d5f69307-d0f8-465b-b976-2832d869eb66",
                                                "sense_id": "93d01376-b50c-3f9a-b953-e3d093f58746",
                                                "text": "“Oh yes,” he murmured in a tone of obligatory surprise, as he proceeded to make the kind of 2 which he attributed to Margaret's style of chirography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cd0286-a0e6-352e-b0e2-b6ca3290fc80",
                                        "entry_id": "e266ed6b-17ae-347f-800d-2b25d9c9fd52",
                                        "glosses": [
                                            "To say (something) indistinctly, to mutter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51eb0ea2-f3ce-4d92-abbb-a0f37c73b7b1",
                                                "sense_id": "f5cd0286-a0e6-352e-b0e2-b6ca3290fc80",
                                                "text": "I […] heard thee murmur tales of iron wars;"
                                            },
                                            {
                                                "example_id": "209a6bb8-81fc-4710-99aa-021724a4f2f5",
                                                "sense_id": "f5cd0286-a0e6-352e-b0e2-b6ca3290fc80",
                                                "text": "Gabriel murmured a confused reply, and hastened on."
                                            },
                                            {
                                                "example_id": "e92b94fc-9a44-4f2e-bce1-8774d041d73a",
                                                "sense_id": "f5cd0286-a0e6-352e-b0e2-b6ca3290fc80",
                                                "text": "With a husky voice she murmured that he was the very dearest grandfather anyone ever had."
                                            },
                                            {
                                                "example_id": "88fac0fd-e369-42bb-b5e7-98e1d42c0d67",
                                                "sense_id": "f5cd0286-a0e6-352e-b0e2-b6ca3290fc80",
                                                "text": "“[…] Don’t look now,” he murmured, lowering his eyes demurely, “but the most handsome man in Brookfield, Connecticut, has just walked in the room.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
