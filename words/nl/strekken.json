                },
                {
                    "sense_id": "4a14e6d6-f7c4-337f-b683-e5c8e62934aa",
                    "sense_definition": "voldoende zijn of duren voor een bepaalde periode of behoefte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voldoen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze speciale aanbieding in de winkel geldt zolang de voorraad <w>strekt</w>.",
                            "target_lang_translations": {
                                "en": "This special offer in the store is valid while stocks <w>last</w>."
                            }
                        },
                        {
                            "text": "We moeten voorzichtig zijn zodat ons budget voor de hele vakantie <w>strekt</w>.",
                            "target_lang_translations": {
                                "en": "We have to be careful so that our budget <w>stretches</w> for the entire holiday."
                            }
                        }
                    ],
                    "synonyms": [
                        "reiken",
                        "volstaan"
                    ],
                    "common_phrases": [
                        "zolang de voorraad strekt"
                    ],
                    "target_lang_definitions": {
                        "en": "To be sufficient or last for a certain period or need."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch",
                                "target_lang_sense_clarification": "to make a limited resource last longer"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "to be enough for a duration"
                            },
                            {
                                "target_lang_word": "suffice",
                                "target_lang_sense_clarification": "to be adequate"
                            }
                        ]
