                "senses": [
                    {
                        "sense_id": "56d1fd20-c451-3c42-8e7c-85a32062ae84",
                        "entry_id": "8890729d-6ee9-3b22-a97b-fa54e6f66adb",
                        "glosses": [
                            "Variante minoritaire de moelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2984c0a9-efe8-451e-be47-9c52d219966d",
                                "sense_id": "56d1fd20-c451-3c42-8e7c-85a32062ae84",
                                "text": "Une brusque douleur le meurtrit. Ce fut comme s’il se vidait, comme si l’on aspirait sa mœlle et son sang."
                            },
                            {
                                "example_id": "56b6029b-4a6e-45f7-bc54-3e174faac53b",
                                "sense_id": "56d1fd20-c451-3c42-8e7c-85a32062ae84",
                                "text": "Revenons à nos auteurs qui ont testé un groupe spécial de cellules souches type NSI-566 sur la mœlle épinière."
                            },
                            {
                                "example_id": "0957c2b2-5ffb-41e9-9b5d-756d2da0b9fc",
                                "sense_id": "56d1fd20-c451-3c42-8e7c-85a32062ae84",
                                "text": "La mœlle épinière est située dans le canal rachidien qui résulte de la superposition des vertèbres de la colonne vertébrale."
                            },
                            {
                                "example_id": "e98b1255-4a66-47e2-8a23-8f87f479d8a9",
                                "sense_id": "56d1fd20-c451-3c42-8e7c-85a32062ae84",
                                "text": "Cela donne naissance à un influx nerveux qui, par les nerfs mammaires et la mœlle épinière, atteint la région spécifique du cerveau appelée l’hypothalamus."
                            }
                        ]
                    }
                ],
