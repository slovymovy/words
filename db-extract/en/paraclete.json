                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraklet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                                        "entry_id": "a9e0f03e-c78d-3fc3-a167-7887f2f9eb67",
                                        "glosses": [
                                            "mehrfach im Johannes-Evangelium verwendeter Begriff, der in der christlichen Theologie gewöhnlich mit dem Heiligen Geist identifiziert wird"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9682a2-82ff-4275-bbf0-1c27db657261",
                                                "sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                                                "text": "„Wimmernd und schluchzend heulte es seinen Fluch über den Pfuhl seiner Geburt; und er lag mit ohnmächtig klappernden Kiefern da und wehrte sich gegen die Nacht, wie ein verrückter, vom Wehklagen der Vorhölle umdrohter Paraklet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
