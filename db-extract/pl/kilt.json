                "senses": [
                    {
                        "sense_id": "742f66d4-6c5d-3596-9a50-afc9d26f354f",
                        "entry_id": "d1b4421a-ff40-3683-b3b4-a864adf88753",
                        "glosses": [
                            "krótka spódniczka w kratkę, tradycyjny strój górali szkockich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8387a9c3-12c1-4449-b41b-0a91614aa47d",
                                "sense_id": "742f66d4-6c5d-3596-9a50-afc9d26f354f",
                                "text": "Na uroczystości było kilku Szkotów w kiltach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c69ea8da-95dd-4cdd-a62f-d56c9e48979e",
                        "source_entry_id": "d1b4421a-ff40-3683-b3b4-a864adf88753",
                        "source_sense_id": "742f66d4-6c5d-3596-9a50-afc9d26f354f",
                        "target_lang_word": "kilt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a365400-35d5-3561-a9c3-cf75a58b8969",
                                        "entry_id": "db8df46b-87a0-3dcd-8664-872587cc1309",
                                        "glosses": [
                                            "To gather up (skirts) around the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf7401c-4657-4348-a38e-0e684b955bdd",
                                                "sense_id": "5a365400-35d5-3561-a9c3-cf75a58b8969",
                                                "text": "Else at her new place worked outdoor and indoor, she'd to kilt her skirts (if they needed kilting – and that was damned little with those short-like frocks) and go out and help at the spreading of dung […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "317774f3-758a-34c4-86f6-70aee090b974",
                                        "entry_id": "2361b870-0c04-30ab-9dd5-29726121f616",
                                        "glosses": [
                                            "A traditional Scottish garment, usually worn by men, having roughly the same morphology as a wrap-around skirt, with overlapping front aprons and pleated around the sides and back, and usually made of twill-woven worsted wool with a tartan pattern."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb8fc43a-56db-339e-95c3-73580dcf5958",
                                        "entry_id": "2361b870-0c04-30ab-9dd5-29726121f616",
                                        "glosses": [
                                            "Any Scottish garment from which the above lies in a direct line of descent, such as the philibeg, or the great kilt or belted plaid"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52897e4b-75db-314b-a99d-ab2d5988f6fa",
                                        "entry_id": "2361b870-0c04-30ab-9dd5-29726121f616",
                                        "glosses": [
                                            "A plaid, pleated school uniform skirt sometimes structured as a wraparound, sometimes pleated throughout the entire circumference; also worn by boys in the 19th-century United States."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39ea516-8402-4130-a181-c35812311a1b",
                                                "sense_id": "52897e4b-75db-314b-a99d-ab2d5988f6fa",
                                                "text": "I was about to say that I had known the Celebrity from the time he wore kilts. But I see I will have to amend that, because he was not a celebrity then, nor, indeed, did he achieve fame until some time after I left New York for the West."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce29fe52-6377-303c-b07b-7c66af8e9618",
                                        "entry_id": "2361b870-0c04-30ab-9dd5-29726121f616",
                                        "glosses": [
                                            "A variety of non-bifurcated garments made for men and loosely resembling a Scottish kilt, but most often made from different fabrics and not always with tartan plaid designs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d61af263-cb16-35fb-9ff5-2e991adc90f9",
                                        "entry_id": "478a279b-2cbd-34e6-9005-979ca3989801",
                                        "glosses": [
                                            "Nonstandard form of killed: simple past and past participle of kill."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "colloquial",
                                            "nonstandard",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "203bdde5-f3f4-4096-b8b0-dd6c576b40a7",
                                                "sense_id": "d61af263-cb16-35fb-9ff5-2e991adc90f9",
                                                "text": "that unspotted Lamb,\nThat for the Sins of all the World was kilt"
                                            },
                                            {
                                                "example_id": "7a04382f-f9d2-4163-ad76-f5099f7ebde5",
                                                "sense_id": "d61af263-cb16-35fb-9ff5-2e991adc90f9",
                                                "text": "But tweren’t so awful long before Marse Hampton got kilt in de big battle, and Marse Thad, too. Dey was both kilt in de charge, right dere on de breastworks, with de guns in dey hands, dem two young masters of mine, right dere in dat Gettysburg battle […] And I was eighteen in dat October after dat big fight what Marse Thad and Marse Hampton got kilt in."
                                            },
                                            {
                                                "example_id": "8c1ee052-6b9f-43f9-844b-a8894470dd27",
                                                "sense_id": "d61af263-cb16-35fb-9ff5-2e991adc90f9",
                                                "text": "She could fight, too, when I got snuffy. […] Once I come home from elk camp so drunk I couldn't hardly sit my horse, and Sylvie near to kilt me, she fought me so hard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ccf5f34-999a-4a57-b6bf-c8e29e59824b",
                        "source_entry_id": "d1b4421a-ff40-3683-b3b4-a864adf88753",
                        "source_sense_id": "742f66d4-6c5d-3596-9a50-afc9d26f354f",
                        "target_lang_word": "Kilt",
