            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c7846779-62c6-3c6b-828c-0409f1b33473",
                    "sense_definition": "Qui comporte ou présente des risques, des dangers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faire de l'escalade sans matériel adapté est une activité très <w>risquée</w>.",
                            "target_lang_translations": {
                                "en": "Climbing without proper equipment is a very <w>risky</w> activity.",
                                "ru": "Заниматься скалолазанием без подходящего снаряжения — очень <w>рискованное</w> занятие.",
                                "de": "Klettern ohne passende Ausrüstung ist eine sehr <w>riskante</w> Aktivität.",
                                "es": "Hacer escalada sin material adecuado es una actividad muy <w>peligrosa</w>.",
                                "zh": "没有合适的装备就去攀岩，是一项非常<w>危险</w>的活动。"
                            }
                        },
                        {
                            "text": "C'est un pari <w>risqué</w>, mais cette stratégie peut rapporter gros.",
                            "target_lang_translations": {
                                "en": "It's a <w>risky</w> bet, but this strategy could pay off big.",
                                "ru": "Это <w>рискованное</w> пари, но такая стратегия может хорошо окупиться.",
                                "de": "Das ist eine <w>riskante</w> Wette, aber diese Strategie könnte viel einbringen.",
                                "es": "Es una apuesta <w>arriesgada</w>, pero esta estrategia podría generar grandes beneficios.",
                                "zh": "这是一个<w>冒险</w>的赌注，但这种策略可能带来丰厚的回报。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dangereux",
                        "périlleux",
                        "hasardeux"
                    ],
                    "antonyms": [
                        "sûr",
                        "sécurisé"
                    ],
                    "common_phrases": [
                        "pari risqué",
                        "investissement risqué",
                        "choix risqué"
                    ],
                    "target_lang_definitions": {
