                "senses": [
                    {
                        "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                        "entry_id": "c4a6cfae-bdf5-33ae-9623-dcb05dedd499",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803646a3-b7a5-4189-82fa-a199206473e3",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Frau Feigle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c2a06a3f-7aaf-4828-9ca1-cc7f8958bf6d",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Herr Feigle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "de0ba201-9d98-4740-a2e4-726c20a2bea0",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Die Feigles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "58ed4e26-1fa5-4442-bd5c-04a712bdc7b1",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Der Feigle trägt nie die Schals, die die Feigle ihm strickt."
                            },
                            {
                                "example_id": "d57ddb7e-2ef9-4234-b6a3-f4912aa7bc3a",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feigle kommt, geht der Herr Feigle.“"
                            },
                            {
                                "example_id": "ae39f406-e713-4888-99d0-1da715fd4e62",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Feigle kommt und geht."
                            },
                            {
                                "example_id": "c07f5aa8-8214-4c2e-aba0-53fe4aa0474d",
                                "sense_id": "161f79b2-3a52-3f18-8806-6ba3615e498f",
                                "text": "Feigles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
