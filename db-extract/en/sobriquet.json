                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5238047-4583-4b77-be4f-69aeee58cb9f",
                        "entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "tags": [
                            "plural"
                        ],
                        "form": "sobriquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "glosses": [
                            "A familiar name for a person or thing; a nickname (sometimes assumed by the person, but often given by others) that is descriptive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87db1609-aef5-48de-8446-06b48bfa8f15",
                                "sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                                "text": "“The Bard” is a sobriquet of English playwright William Shakespeare."
                            },
                            {
                                "example_id": "e4bc98c5-4b8c-49d6-ab6e-8f9cd52adfbd",
                                "sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                                "text": "Tight quickly became a Jumeirah Jane—a sobriquet used as a caricature for non-working foreign women who live in Jumeirah, a posh part of the city, and spent their time driving kids to and from schools, shopping or meeting one another for lunch."
                            },
                            {
                                "example_id": "50310823-b79a-408b-ad66-83c733de58df",
                                "sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                                "text": "The sobriquet of Johnny Appleseed attached to him, though his real name was Chapman, in consequence of his being ever engaged in gathering and planting appleseed and cultivating nurseries of apple trees."
                            },
                            {
                                "example_id": "1a99a5d8-fe9c-4a97-9cc5-0824f7c73fae",
                                "sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                                "text": "They turned out to be speedy machines and earned the sobriquet \"Greyhounds\", giving excellent performances on the Exeter run."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9376aa1-4d98-4f87-9c39-4987b8f05b0c",
                        "source_entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "source_sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "source_sense_description": "familiar name for a person or thing",
                        "target_lang_word": "přezdívka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "přezdívka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "188b7691-0a3a-3390-b022-4febff21b0c6",
                                        "entry_id": "a8ae6234-af4d-3633-a16b-ca0fb83ed6f9",
                                        "glosses": [
                                            "pojmenování používané místo nebo vedle skutečného jména"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fa3699d-cec2-424e-9591-836c50477820",
                                                "sense_id": "188b7691-0a3a-3390-b022-4febff21b0c6",
                                                "text": "Srna byl chalupník, jenž pro hašteřivou, nepokojnou svou krev měl přezdívku Sršán."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3969c64d-5150-4cec-be12-eeeea6a38071",
                        "source_entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "source_sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "source_sense_description": "familiar name for a person or thing",
                        "target_lang_word": "bijnaam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bijnaam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "12ec87a0-a849-3d7f-af4e-6a257d91eb9a",
                                        "entry_id": "3c8fa3d6-7047-335c-bb16-d898564b0236",
                                        "glosses": [
                                            "breed bekende, niet-officiële naam van een persoon, een groep van personen of een zaak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e7717e4-720f-411e-b8fc-f850e9ac3f34",
                                                "sense_id": "12ec87a0-a849-3d7f-af4e-6a257d91eb9a",
                                                "text": "Er zijn vele bekende Nederlanders met een bijnaam, zoals \"de kromme\"."
                                            },
                                            {
                                                "example_id": "9ef5c3d1-54eb-464d-99dd-08f8b086ec1b",
                                                "sense_id": "12ec87a0-a849-3d7f-af4e-6a257d91eb9a",
                                                "text": "\"De Zwaan\" is een bekende bijnaam voor de Erasmusbrug."
                                            },
                                            {
                                                "example_id": "b0d3d531-7bd9-46c1-86f6-4c3c84939365",
                                                "sense_id": "12ec87a0-a849-3d7f-af4e-6a257d91eb9a",
                                                "text": "Volgens hem is er veel veranderd sinds Limburg een kwart eeuw geleden na een reeks smeergeldzaken de bijnaam ‘vriendenrepubliek’ kreeg."
                                            },
                                            {
                                                "example_id": "b1e8a244-dcf8-482f-98ee-1a5e6def815f",
                                                "sense_id": "12ec87a0-a849-3d7f-af4e-6a257d91eb9a",
                                                "text": "Tijdens een overtocht van de Atlantis werden in krap vier weken tijd 62 kinderen geboren. In kranten en journaals doken de bijnamen ooievaarsschip en babyschip op."
                                            },
                                            {
                                                "example_id": "38171d3b-9e43-424a-a345-c35e1469ce28",
                                                "sense_id": "12ec87a0-a849-3d7f-af4e-6a257d91eb9a",
                                                "text": "Vóór de Franse tijd waren familienamen een soort bijnamen, die pas hun beslag kregen als ze bij een officiële gelegenheid – een huwelijk of het opstellen van een contract – op papier werden gezet, zegt Brouwer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9312cfce-a542-4de3-a460-9a7eff154844",
                        "source_entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "source_sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "source_sense_description": "familiar name for a person or thing",
                        "target_lang_word": "sobriquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sobriquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b0aa277-99f5-3ed6-acfd-ae9835e3410d",
                                        "entry_id": "e6cc2578-598a-331d-b3cf-090f45c7c6bf",
                                        "glosses": [
                                            "Surnom familier donné par dérision, moquerie ou même affectueusement et qui peut être fondé sur quelque défaut de corps ou d’esprit, ou sur quelque singularité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da9a4a6-03fc-4070-8a6f-aa5896520d71",
                                                "sense_id": "9b0aa277-99f5-3ed6-acfd-ae9835e3410d",
                                                "text": "Sa mère s’appelait Jeanne Mathieu ; son père s’appelait Jean Valjean, ou Vlajean, sobriquet probablement, et contraction de Voilà Jean."
                                            },
                                            {
                                                "example_id": "97074428-437b-4178-aa80-7895f3f25a81",
                                                "sense_id": "9b0aa277-99f5-3ed6-acfd-ae9835e3410d",
                                                "text": "Il aura beau finasser, trancher du gentilhomme, payer des généalogistes pour lui attribuer une origine princière, peine perdue : le sobriquet, obstiné corbeau, croassera de toute la puissance de son gosier et dévoilera la provenance de l'oiseau."
                                            },
                                            {
                                                "example_id": "1a195603-9c05-4a99-be7a-7597931197d9",
                                                "sense_id": "9b0aa277-99f5-3ed6-acfd-ae9835e3410d",
                                                "text": "Il était prénommé Victor, mais comme il est coutume de donner aux plus jeunes des sobriquets d’amitié et qu’il était retors et rusé comme un renard, on l’avait surnommé le Tors."
                                            },
                                            {
                                                "example_id": "862cab2e-8ad6-41e1-ba48-850957f82448",
                                                "sense_id": "9b0aa277-99f5-3ed6-acfd-ae9835e3410d",
                                                "text": "Et quand en 1840, notre vin de Moselle ne fut qu'un âpre verjus, nos vignerons, par dérision et par haine du Prussien, donnèrent sarcastiquement à ce vin imbuvable le sobriquet de : Hassenpflug."
                                            },
                                            {
                                                "example_id": "3f997402-c369-481a-a3fd-2f7c140cf918",
                                                "sense_id": "9b0aa277-99f5-3ed6-acfd-ae9835e3410d",
                                                "text": "Leurs premiers mots furent des moqueries à l'encontre du boche, du chleuh, du vert-de-gris, du doryphore, chacun y allant d'un sobriquet le plus méprisant possible pour qualifier l'allemand pincé par une étrille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "138a9c6c-05b3-404b-bfc7-0ebafb6754a3",
                        "source_entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "source_sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "source_sense_description": "familiar name for a person or thing",
                        "target_lang_word": "surnom familier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "933ae7c3-a262-4aeb-8d51-dca18a5be613",
                        "source_entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "source_sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "source_sense_description": "familiar name for a person or thing",
                        "target_lang_word": "Beiname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beiname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                        "entry_id": "f31f467b-d8a3-351b-b47f-2e2a6c99da42",
                                        "glosses": [
                                            "Zusatz zum eigentlichen Namen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a227cd17-adf7-44c8-86f5-714415d0ead1",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "Manchen Herrschern verlieh man charakterisierende Beinamen: So hatte Zar Iwan IV den Beinamen „der Schreckliche“."
                                            },
                                            {
                                                "example_id": "48fa6c2b-4e22-4068-a68f-07655a02082b",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "„Die Beinamen dienen hauptsächlich der Unterscheidung von anderen Personen gleichen Namens, beziehen sich aber, anders als die späteren Familiennamen, auf eine einzelne Person; mit dieser sind sie konventionell fest verbunden.“"
                                            },
                                            {
                                                "example_id": "56ef32a1-2453-4190-a75f-59c8d43eac30",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "„Wenn ein solcher Zusatz nicht nur gelegentlich (okkasioneller Zusatz), sondern mehr oder weniger regelmäßig zur Kennzeichnung einer Person verwendet wird, bezeichnet man ihn als Beinamen.“"
                                            },
                                            {
                                                "example_id": "afc10127-bcfd-4ccb-a509-16fb43432dab",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "„Sehr viel weniger behandelt werden Beinamen, Spitznamen und Kosenamen.“"
                                            },
                                            {
                                                "example_id": "d7829afa-6722-441d-bc2b-102aa0e0d82d",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "„Lange Zeit lag der Ort »wüst« danieder, was letztendlich dazu führte, dass das Jahrzehnte später an gleicher Stelle erneut gegründete Dorf Hauterode den Beinamen Wüstheuterode erhielt.“"
                                            },
                                            {
                                                "example_id": "87d1b51b-b2bc-42b7-bc0b-076c6148e3e2",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "„Da wußte ich, daß mein Vater noch unter dem gleichen Beinamen bekannt war und sich mit den gleichen Dingen beschäftigte.“"
                                            },
                                            {
                                                "example_id": "16331a62-8a74-4f4b-8d39-7b82c895c654",
                                                "sense_id": "cb73fd03-ef58-3018-8c7a-3f743224f238",
                                                "text": "„Dort lebten die meisten Elefanten, die überall in Indien als Kriegselefanten begehrt waren. Die Könige von Orissa hatten daher den Beinamen «Gajapati» (Herr der Elefanten) und waren als solche bekannt und geachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be43edc6-6008-3154-a1f4-3303f3576cb0",
                                        "entry_id": "f31f467b-d8a3-351b-b47f-2e2a6c99da42",
                                        "glosses": [
                                            "charakterisierendes, typisierendes Adjektiv"
                                        ],
                                        "tags": [
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "713a1d19-d4c9-4a24-8d44-f10754ffdade",
                                                "sense_id": "be43edc6-6008-3154-a1f4-3303f3576cb0",
                                                "text": "„Sie erhalten als Tote den Beinamen (Epitheton) »gerechtfertigt«, der ursprünglich dem Horus gebührt.“"
                                            },
                                            {
                                                "example_id": "fa4a1522-066b-4530-bd56-62dc3944b3fe",
                                                "sense_id": "be43edc6-6008-3154-a1f4-3303f3576cb0",
                                                "text": "„Ein Beiname, dem das höchstgelegene Geysirfeld der Welt mit seinen 40 Geysiren, 60 heißen Quellen und mehr als 70 Fumarolen auf mehr als drei Quadratkilometern Fläche vollauf gerecht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da4c8154-ceed-47de-a769-ac593ac1f2cd",
                        "source_entry_id": "326c9fbf-0718-3717-8f94-0d77e297a413",
                        "source_sense_id": "d5917bbe-42f6-3276-a04b-7d87513376e7",
                        "source_sense_description": "familiar name for a person or thing",
                        "target_lang_word": "Spitzname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spitzname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c511241-d045-3c10-9a15-8438651be40d",
                                        "entry_id": "cce299b4-007c-39b1-a4ba-0c6d79cda207",
                                        "glosses": [
                                            "Übername, Beiname, den jemand einer vertrauten Person oder anderweitig verleiht und der einen positiven (freundlichen, scherzhaften) oder auch negativen (abwertenden, spöttischen) Bedeutungsaspekt enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da84e2c8-4b46-45d9-9f5a-df944ccc9c58",
                                                "sense_id": "7c511241-d045-3c10-9a15-8438651be40d",
                                                "text": "„Als Kosenamen, Necknamen oder Spottnamen bringen sie positive oder negative emotionale Einstellungen zum Ausdruck, und selbst als bloße Spitznamen stellen sie noch immer eine besondere, persönliche Beziehung zu dem damit Benannten her.“"
                                            },
                                            {
                                                "example_id": "34fd206d-c8f0-4c78-a57f-0b6eed94402c",
                                                "sense_id": "7c511241-d045-3c10-9a15-8438651be40d",
                                                "text": "„Viele achten auch darauf, daß sich der Name möglichst nicht zum Spitznamen verstümmeln läßt.“"
                                            },
                                            {
                                                "example_id": "e799a079-cced-482e-9595-9077ae5ae627",
                                                "sense_id": "7c511241-d045-3c10-9a15-8438651be40d",
                                                "text": "„Das Cognomen war seinem Ursprung nach ein persönlicher Beiname - ein Spitzname oder auch eine aufgrund hervorragender Taten erworbene auszeichnende Benennung.“"
                                            },
                                            {
                                                "example_id": "6fa15d68-956d-451b-940b-50087f1dd856",
                                                "sense_id": "7c511241-d045-3c10-9a15-8438651be40d",
                                                "text": "„Sehr viel weniger behandelt werden Beinamen, Spitznamen und Kosenamen.“"
                                            },
                                            {
                                                "example_id": "da519dec-8561-496d-8db5-d97f1dff3a92",
                                                "sense_id": "7c511241-d045-3c10-9a15-8438651be40d",
                                                "text": "„Dieser Spitzname ist weniger verletzend als gewisse gedruckte Worte, da werden sie mir sicher zustimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
