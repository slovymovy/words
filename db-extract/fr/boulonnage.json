                "senses": [
                    {
                        "sense_id": "fdef51ba-6e33-34e3-892b-f5a2b55e1c87",
                        "entry_id": "e9afd337-cc25-3f0a-a8b6-7580a09d7352",
                        "glosses": [
                            "Monter une pièce au moyen de boulon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b2b6302-a0d6-4116-831d-1f92a15b20a5",
                                "sense_id": "fdef51ba-6e33-34e3-892b-f5a2b55e1c87",
                                "text": "Pour fixer la prothèse, on peut utiliser le vissage, le cerclage ou le boulonnage."
                            },
                            {
                                "example_id": "ec0f1010-1962-4e95-bdb0-49d122904d24",
                                "sense_id": "fdef51ba-6e33-34e3-892b-f5a2b55e1c87",
                                "text": "Le renforcement des tunnels par boulonnage au front de taille est une technique récente de préconfinement visant d'une part à préserver la stabilité de l'excavation et d'autre part à contrôler les déformations et les tassements induits par le creusement."
                            },
                            {
                                "example_id": "b1e8c56b-ff9a-4f41-842b-176e6aad23c3",
                                "sense_id": "fdef51ba-6e33-34e3-892b-f5a2b55e1c87",
                                "text": "Avec le boulonnage, le soudage peut être considéré aujourd'hui comme une technique d'assemblage standard dans la construction en acier."
                            }
                        ]
                    }
                ],
