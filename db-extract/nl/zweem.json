                        ],
                        "form": "zweempjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                        "entry_id": "8949b0de-abd3-3fe7-9185-f43cd8fa9fa8",
                        "glosses": [
                            "spoor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8650c2-e05a-4313-a043-9c9fc9bec848",
                                "sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                                "text": "Er was geen zweem van berouw te herkennen."
                            },
                            {
                                "example_id": "4e832541-1054-4352-83f6-879d02288a17",
                                "sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                                "text": "Hoewel boeren in beide regelingen geld ontvangen om met hun bedrijf te stoppen, verschillen de doelen, middelen en de uitvoerder van de regeling. Wel is er één belangrijke overeenkomst: uitkopen gaat altijd vrijwillig. \"Er zal nooit een zweem van verplichting aan zitten\", verduidelijkt een woordvoerder van het Interprovinciaal Overleg (IPO)."
                            },
                            {
                                "example_id": "f6fb51d0-368c-465e-ac38-9376e56b31bb",
                                "sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                                "text": "Ik moest dat zweempje blauw te pakken krijgen, die weerschijn van het colbert in die koude staalgrijze ogen."
                            },
                            {
                                "example_id": "36f07679-4bdc-41f4-97a9-e7010be70b8b",
                                "sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                                "text": "Deze strijders, hongerig, in lompen gekleed, verborgen in grotten in de bergen en riolen onder de steden, vochten voor het laatste zweempje menselijke waardigheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2acff3b2-67bd-40d1-ae6b-4dbaa9b06236",
                        "source_entry_id": "8949b0de-abd3-3fe7-9185-f43cd8fa9fa8",
                        "source_sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                        "target_lang_word": "Spur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0df50ff0-a352-3a7b-b3a1-32be27e7be68",
                                        "entry_id": "40d5a9eb-ccf6-3e72-94e0-cfa4c1cec59c",
                                        "glosses": [
                                            "hinweisgebende Hinterlassenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7cf31a-8d7d-4204-ab38-ffb536a61745",
                                                "sense_id": "0df50ff0-a352-3a7b-b3a1-32be27e7be68",
                                                "text": "Von den Einbrechern fehlt jede Spur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "359fc986-adeb-302b-99be-712fa254642b",
                                        "entry_id": "40d5a9eb-ccf6-3e72-94e0-cfa4c1cec59c",
                                        "glosses": [
                                            "durch Fortbewegung bewirkte Markierung auf dem Boden"
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50eb52e3-cbbd-4aae-91ba-775f1603944c",
                                                "sense_id": "359fc986-adeb-302b-99be-712fa254642b",
                                                "text": "Die Spuren waren im Schnee gut sichtbar."
                                            },
                                            {
                                                "example_id": "019dcf16-d14a-4190-bf53-dec026eff476",
                                                "sense_id": "359fc986-adeb-302b-99be-712fa254642b",
                                                "text": "„Schweifende Indianer, nach mißlungenem Überfall auf weiter ostwärts abgelegene Siedlungen versprengt und desto rachsüchtiger, waren auf die sorglose Spur der Deutschen gestoßen, hatten sie verfolgt und im dichten Unterholz still umflügelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e337c143-5c78-3959-ac4e-38c4bd4e0b9c",
                                        "entry_id": "40d5a9eb-ccf6-3e72-94e0-cfa4c1cec59c",
                                        "glosses": [
                                            "sehr kleine Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c937e8-19ef-4f4d-b64d-8b90831d483b",
                                                "sense_id": "e337c143-5c78-3959-ac4e-38c4bd4e0b9c",
                                                "text": "Im Trinkwasser fanden sich Spuren von Schwermetallen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c94b38e7-58e0-389d-b04f-3e91cba5c893",
                                        "entry_id": "40d5a9eb-ccf6-3e72-94e0-cfa4c1cec59c",
                                        "glosses": [
                                            "fest vorgegebene Bahn einer Fortbewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f0ddfb-c461-482b-bac9-837a91b41f0f",
                                                "sense_id": "c94b38e7-58e0-389d-b04f-3e91cba5c893",
                                                "text": "Der letzte Wagon der Geisterbahn war aus der Spur gesprungen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "daee5b69-5319-3393-9023-e5f38825a88f",
                                        "entry_id": "40d5a9eb-ccf6-3e72-94e0-cfa4c1cec59c",
                                        "glosses": [
                                            "die Summe der Diagonalelemente einer Matrix"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35f0365-c9c3-4f62-98cf-3629e1afe289",
                                                "sense_id": "daee5b69-5319-3393-9023-e5f38825a88f",
                                                "text": "Für quadratische Matrizen A definiert man die Spur sp(A) als Summe der Einträge auf der Diagonalen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e773a87-8899-4ce3-a285-2cf978c680d1",
                        "source_entry_id": "8949b0de-abd3-3fe7-9185-f43cd8fa9fa8",
                        "source_sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                        "target_lang_word": "Hauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5aded6-e151-3c52-a982-a4a9f420c0a1",
                                        "entry_id": "8aadcd63-1b50-3179-9084-5f2591faddbf",
                                        "glosses": [
                                            "schwacher Atem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75eb356e-7e9d-4eec-80d9-8f2ab2932e07",
                                                "sense_id": "9e5aded6-e151-3c52-a982-a4a9f420c0a1",
                                                "text": "Sein Atem war nur noch als Hauch wahrnehmbar."
                                            },
                                            {
                                                "example_id": "da6b58fe-4b47-4bc4-aab3-d43f37ea5dca",
                                                "sense_id": "9e5aded6-e151-3c52-a982-a4a9f420c0a1",
                                                "text": "„Ich spüre den warmen aasigen Hauch aus seinen Nüstern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a18821e4-3b45-3e4c-8889-0e0bf5026ff7",
                                        "entry_id": "8aadcd63-1b50-3179-9084-5f2591faddbf",
                                        "glosses": [
                                            "sichtbarer Atem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "587d5410-361a-4a1c-9bf6-ef2b4c4301d2",
                                                "sense_id": "a18821e4-3b45-3e4c-8889-0e0bf5026ff7",
                                                "text": "Durch den Frost stand ihm ein deutlicher Hauch vor dem Mund."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2055633b-17d5-31ce-9a43-6c139fd90d96",
                                        "entry_id": "8aadcd63-1b50-3179-9084-5f2591faddbf",
                                        "glosses": [
                                            "leichter Luftzug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7f3bd4-623c-497e-814f-e72ac158c1d1",
                                                "sense_id": "2055633b-17d5-31ce-9a43-6c139fd90d96",
                                                "text": "Durch das Haus wehte ein leichter Hauch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2aac8ee6-9330-3a8d-bbaf-ed41c19ef511",
                                        "entry_id": "8aadcd63-1b50-3179-9084-5f2591faddbf",
                                        "glosses": [
                                            "dünne Schicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33f25ae-adfe-4d14-a1c6-5d7f268af5e9",
                                                "sense_id": "2aac8ee6-9330-3a8d-bbaf-ed41c19ef511",
                                                "text": "Auf dem Blech hatte sich ein Hauch von Kondenswasser gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "546eb11e-df68-3a62-8537-73225a74971b",
                                        "entry_id": "8aadcd63-1b50-3179-9084-5f2591faddbf",
                                        "glosses": [
                                            "leichter, schwacher Anschein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f114d813-d441-42fc-83e4-f906b6be16ba",
                                                "sense_id": "546eb11e-df68-3a62-8537-73225a74971b",
                                                "text": "Die Gesellschaft vermittelte einen Hauch von Exklusivität."
                                            },
                                            {
                                                "example_id": "7e41fb32-bced-41ff-bec8-f400589689b5",
                                                "sense_id": "546eb11e-df68-3a62-8537-73225a74971b",
                                                "text": "„Zuweilen fühlten sie ein Erschauern wie den Hauch eines Gedankens; im Augenblick, wo sie ihn greifen wollten, war er verschwunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3c4876bf-1521-3128-bad7-3709f2e2eed3",
                                        "entry_id": "8aadcd63-1b50-3179-9084-5f2591faddbf",
                                        "glosses": [
                                            "geringes Maß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ef33c4-418b-4be6-8fab-f4796d9b06d3",
                                                "sense_id": "3c4876bf-1521-3128-bad7-3709f2e2eed3",
                                                "text": "Er hatte nicht den Hauch einer Chance auf den Sieg."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c43ec411-0288-4ff0-8536-847e5f929fc0",
                        "source_entry_id": "8949b0de-abd3-3fe7-9185-f43cd8fa9fa8",
                        "source_sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
                        "target_lang_word": "Schimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b86b9e-607e-3bd8-afd6-c9f21e91bcaf",
                                        "entry_id": "367b6e51-c950-3755-892d-ecbb723e897b",
                                        "glosses": [
                                            "matter Lichtschein, schwacher Glanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da37181d-8e1d-43fa-b2df-0ef45f6c99b7",
                                                "sense_id": "13b86b9e-607e-3bd8-afd6-c9f21e91bcaf",
                                                "text": "Der matte Schimmer des Mondlichtes lag über der Landschaft."
                                            },
                                            {
                                                "example_id": "933a9efe-1093-4db4-8755-137ae4c43771",
                                                "sense_id": "13b86b9e-607e-3bd8-afd6-c9f21e91bcaf",
                                                "text": "Der Schimmer eines Lächelns flog über ihr Gesicht."
                                            },
                                            {
                                                "example_id": "a4a52c74-7ce9-42db-a07a-d08df4d9d135",
                                                "sense_id": "13b86b9e-607e-3bd8-afd6-c9f21e91bcaf",
                                                "text": "„Im Licht des Sonnenuntergangs bekam das Ocker der Ebene einen warmen, fast orangeroten Schimmer.“"
                                            },
                                            {
                                                "example_id": "3ac7fb5b-cde6-4463-a136-263a09a70acd",
                                                "sense_id": "13b86b9e-607e-3bd8-afd6-c9f21e91bcaf",
                                                "text": "„Aus ihren großen Augen strahlte ein gütiger, zart verschämter Schimmer.“"
                                            },
                                            {
                                                "example_id": "d55ce0db-9094-4e55-8e92-ac7b1acd7db3",
                                                "sense_id": "13b86b9e-607e-3bd8-afd6-c9f21e91bcaf",
                                                "text": "„Der rosige Schimmer, der sich im Café verbreitete, ging von der Gruppe Huren aus, die gewöhnlich in der Nähe des Eingangs zusammensaßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2d2555a-9080-32f0-8bc3-e2873dd2fd1e",
                                        "entry_id": "367b6e51-c950-3755-892d-ecbb723e897b",
                                        "glosses": [
                                            "geringe Kenntnis von etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f934d5c-e186-4c93-b965-8a3f266314e5",
                                                "sense_id": "c2d2555a-9080-32f0-8bc3-e2873dd2fd1e",
                                                "text": "Er hat keinen blassen Schimmer."
                                            },
                                            {
                                                "example_id": "ab28986e-3a70-41cd-ab01-b05944eaca64",
                                                "sense_id": "c2d2555a-9080-32f0-8bc3-e2873dd2fd1e",
                                                "text": "Hast Du einen Schimmer von Anlagestrategien?"
                                            },
                                            {
                                                "example_id": "8df9b9ce-f3b9-4cb5-ba33-5cfaf8449ea5",
                                                "sense_id": "c2d2555a-9080-32f0-8bc3-e2873dd2fd1e",
                                                "text": "„Die hiesigen Sprachlabore seien voll von solchen Typen, in der Regel sprächen sie selbst nicht mal Finnisch - oder wenn, dann nur sehr schlecht - und hätten also keinen Schimmer.“"
                                            },
                                            {
                                                "example_id": "92b4cdf6-ed24-4322-ab66-3b366e27826b",
                                                "sense_id": "c2d2555a-9080-32f0-8bc3-e2873dd2fd1e",
                                                "text": "„Ein eintretender Diener meldete den Rittmeister von Schach, und ein Schimmer freudiger Überraschung überflog beide Damen, als der Angemeldete gleich danach eintrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "189cc23d-3f93-42f8-be11-cd4212989e15",
                        "source_entry_id": "8949b0de-abd3-3fe7-9185-f43cd8fa9fa8",
                        "source_sense_id": "d1da3eaa-dae9-37a0-8c3d-abfa6b97b845",
