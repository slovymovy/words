                    {
                        "translation_id": "a4f78eed-d179-467a-8166-8eae1fbfe76e",
                        "source_entry_id": "189db9d9-6b6f-31e4-98dd-558277aa5fca",
                        "source_sense_description": "space where a baptismal font is located",
                        "target_lang_word": "doopkapel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doopkapel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4088b8-9c51-30c3-97ef-d61984f69629",
                                        "entry_id": "b07f1e64-26ef-3c53-b807-a7c38215d659",
                                        "glosses": [
                                            "gebouw of deel van een gebouw waar men doopt of gedoopt kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b03f6f-88e1-43fd-a337-945dc36534eb",
                                                "sense_id": "0e4088b8-9c51-30c3-97ef-d61984f69629",
                                                "text": "Het klooster staat midden tussen de opgravingen: Joodse graftombes, een Romeins badhuis en een Byzantijnse kerk met een aparte doopkapel. Die doopkapel zou gebouwd kunnen zijn op de plek van het huis van de apostel Kleopas, aldus zuster Agnes, die ons rondleidde. Zo traden wij in de voetsporen van de Emmaüsgangers over wie Lucas 24 vertelt."
                                            },
                                            {
                                                "example_id": "f2d4e4b4-8bf9-4c60-8aae-a8c142d105dd",
                                                "sense_id": "0e4088b8-9c51-30c3-97ef-d61984f69629",
                                                "text": "Parma is meer dan alleen overheerlijke ham en keiharde, smakelijke kaas, hoewel het niet zo moeilijk is om in deze Noord-Italiaanse stad een paar dagen louter etend door te brengen. Als je een wandeling maakt na een uitgebreide lunch met een vino bianco, zul je zien dat de architectuur van Parma niet zo slecht is. Neem de achtkantige doopkapel van Parma, een van de meest indrukwekkende middeleeuwse monumenten in Europa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e354efa9-6d15-4daa-8583-0dd47e2f5b5f",
                        "source_entry_id": "189db9d9-6b6f-31e4-98dd-558277aa5fca",
                        "source_sense_description": "space where a baptismal font is located",
                        "target_lang_word": "baptistère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baptistère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c974fd2e-8265-38fa-8a95-9ea659f77e38",
                                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                                        "glosses": [
                                            "Petit édifice bâti auprès des cathédrales, pour y administrer le baptême, et qui renfermait un ou plusieurs autels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b178469-a72c-41d1-b55f-ea867f2453e1",
                                                "sense_id": "c974fd2e-8265-38fa-8a95-9ea659f77e38",
                                                "text": "Le baptistère de Constantin est auprès de Saint-Jean de Latran."
                                            },
                                            {
                                                "example_id": "8297838b-ff2e-4a70-aa2c-59b5ce20037a",
                                                "sense_id": "c974fd2e-8265-38fa-8a95-9ea659f77e38",
                                                "text": "Ces églises ont donc un sens harmonique où, comprise entre le baptistère et le cimetière, s’accomplit la vie de ces hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f633460-bab1-3ce8-a843-12b80ad1ca06",
                                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                                        "glosses": [
                                            "Chapelle où sont les fonts baptismaux dans une église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c0fbe4-5c64-4317-b903-773b6fc1cf23",
                                                "sense_id": "5f633460-bab1-3ce8-a843-12b80ad1ca06",
                                                "text": "Fin juillet, le diocèse de Paris a désigné celui qui sera chargé de recréer le mobilier liturgique (autel, tabernacle, ambon, baptistère) voulu noble et simple : il s’agit du sculpteur et designer français Guillaume Bardet, 51 ans, diplômé de l’École nationale des arts décoratifs et déjà auteur de grands projets liturgiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d8c3130-6907-3a32-9b0d-eb9777f270a0",
                                        "entry_id": "884761d6-65f2-3567-8ba0-017bd842a8aa",
                                        "glosses": [
                                            "Extrait de baptême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4e66e5-aefb-4f15-9221-b1da4ff0d410",
                                                "sense_id": "9d8c3130-6907-3a32-9b0d-eb9777f270a0",
                                                "text": "Ce dimanche de février 1951, trois figures d’autorité se penchent sur le baptistère de ces enfants amérindiens : catholique, préfectorale et municipale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baptistère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18667d72-8b1e-34bd-827d-170d67f80080",
                                        "entry_id": "c7b56134-9aaf-3649-9f3c-60656ecf6686",
                                        "glosses": [
                                            "Qualifie le registre des baptisés d’une paroisse."
