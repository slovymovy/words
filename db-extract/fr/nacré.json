                "senses": [
                    {
                        "sense_id": "f6bea45c-24fe-37d3-a178-f5f4ffd9e21c",
                        "entry_id": "4fb86b22-1833-3f34-a68c-1767b5814a56",
                        "glosses": [
                            "Qui a l’apparence et l’éclat de la nacre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893164cb-b033-4075-8ca2-3b16f1e40b6a",
                                "sense_id": "f6bea45c-24fe-37d3-a178-f5f4ffd9e21c",
                                "text": "Là, au fond, dans l’ombre noire, s’ouvre peut-être la porte de diamant qui mène au royaume nacré habité par les enchanteurs."
                            },
                            {
                                "example_id": "e1b00e58-fe3b-4f69-bb80-0456d05bc825",
                                "sense_id": "f6bea45c-24fe-37d3-a178-f5f4ffd9e21c",
                                "text": "Où sont les lampes de tes yeux, les lampes nacrées comme la lune suspendue sur notre été d’amour ?"
                            },
                            {
                                "example_id": "6e4389ee-04ac-4d77-a93c-0bb65cbcc273",
                                "sense_id": "f6bea45c-24fe-37d3-a178-f5f4ffd9e21c",
                                "text": "Coquille, couleur nacrée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
