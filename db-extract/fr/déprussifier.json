                        "glosses": [
                            "Faire perdre son caractère prussien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5efc04d-e05a-4c97-afa4-4eb2ae8eee61",
                                "sense_id": "b588e6e6-cbce-334d-80a5-82e90e50475f",
                                "text": "Que l'Allemagne se désimpérialise, se démocratise, qu'elle change d'Empereur ou même rejette l'Empire, c'est son affaire, mais c'est la nôtre de la déprussifier ou de la déprussianiser."
                            },
                            {
                                "example_id": "725ff47b-9a59-456d-8b44-4a31722a1b4e",
                                "sense_id": "b588e6e6-cbce-334d-80a5-82e90e50475f",
                                "text": "Il s'agit, tout d'abord, de déprussifier l'Allemagne."
                            }
                        ]
                    }
