                "senses": [
                    {
                        "sense_id": "c31e63f8-226f-3958-931d-eed9fc791bb7",
                        "entry_id": "0f222b6a-7f19-342f-8c21-4e8a1d1309f4",
                        "glosses": [
                            "Petit bâton recouvert à chaque extrémité d’une petite boule de coton hydrophile, utilisé en particulier pour nettoyer le conduit auditif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2297ca66-432b-423c-9ba5-c44a2ea5db54",
                                "sense_id": "c31e63f8-226f-3958-931d-eed9fc791bb7",
                                "text": "Il faut se représenter que lorsqu’elle descend chez moi à quatorze heures, le mardi de chez les Arthens, le jeudi de chez les de Broglie, Manuela a peaufiné au Coton-Tige des chiottes dorées à la feuille qui, en dépit de cela, sont aussi malpropres que tous les gogues du monde […]"
                            },
                            {
                                "example_id": "9cef4a88-5bc7-49de-a3d5-3de69d4f2fe8",
                                "sense_id": "c31e63f8-226f-3958-931d-eed9fc791bb7",
                                "text": "J’auscultais le réservoir et le petit placard. Il ne contenait que des serviettes. La poubelle : des cotons-tiges. Les tuyaux d’évacuation refoulaient du goulot. C’était intenable."
                            },
                            {
                                "example_id": "d7aa5c5a-7af4-4e85-b93b-48e72d401efe",
                                "sense_id": "c31e63f8-226f-3958-931d-eed9fc791bb7",
                                "text": "– J’espère que vous ne vous trompez pas, dit Pia en tirant un coton-tige de sa poche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2535b880-bb1c-46e9-8879-ecbbac85c62d",
                        "source_entry_id": "0f222b6a-7f19-342f-8c21-4e8a1d1309f4",
