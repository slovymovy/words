                    "sense_id": "59798b2a-aaef-3755-984f-368ec8b22bc0",
                    "sense_definition": "ergens heengaan met als doel om iets of iemand mee terug te brengen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verkrijgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga even naar de supermarkt om wat melk te <w>halen</w>.",
                            "target_lang_translations": {
                                "en": "I'm just going to the supermarket to <w>get</w> some milk.",
                                "ru": "Я ненадолго схожу в супермаркет, чтобы <w>купить</w> молока."
                            }
                        },
                        {
                            "text": "Kun je de kinderen van school <w>halen</w> als je klaar bent met werken?",
                            "target_lang_translations": {
                                "en": "Can you <w>pick up</w> the children from school when you're finished with work?",
                                "ru": "Ты можешь <w>забрать</w> детей из школы, когда закончишь работать?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "boodschappen halen",
                        "iemand ophalen",
                        "water halen",
                        "adem halen"
                    ],
                    "target_lang_definitions": {
