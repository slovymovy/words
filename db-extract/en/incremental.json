                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412afecf-d140-4530-aaa5-09aa71173b13",
                                                "sense_id": "f47c7d60-a932-3818-b049-2a239ba46396",
                                                "text": "Die Spieler zählen abwechselnd inkremental, wobei jede durch drei teilbare Zahl durch das Wort „Fizz“ und jede durch fünf teilbare Zahl durch das Wort „Buzz“ ersetzt wird."
                                            }
