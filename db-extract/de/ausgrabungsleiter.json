                "senses": [
                    {
                        "sense_id": "7080e846-bf3f-3b97-badf-f242cde62f60",
                        "entry_id": "8192caf8-03c7-3736-a691-78ffb4744ea9",
                        "glosses": [
                            "Person, welche die Aufsicht bei einer Ausgrabung innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799dd8b9-8be3-431d-914d-8eda97ef8ef5",
                                "sense_id": "7080e846-bf3f-3b97-badf-f242cde62f60",
                                "text": "„Wie der Ausgrabungsleiter Dagfinn Skre mitteilte, trugen die Wikinger demnach bereits um das Jahr 800 nach Christus weiche Schuhe mit flacher Sohle, die vorne oder seitlich mit Lederriemen geschnürt wurden.“"
                            },
                            {
                                "example_id": "34a4a7e9-26c5-4a84-b753-67cf27736ae2",
                                "sense_id": "7080e846-bf3f-3b97-badf-f242cde62f60",
                                "text": "„Im Norden Chinas haben Archäologen hundert weitere Exemplare der legendären Terrakotta-Krieger freigelegt. Der sensationellste Fund sei die Figur eines Offiziers, sagte Ausgrabungsleiter Xu Weihong am Freitag der amtlichen Nachrichtenagentur Xinhua.“"
                            },
                            {
                                "example_id": "04f9466f-aef1-4ecf-b97d-260250e89cd5",
                                "sense_id": "7080e846-bf3f-3b97-badf-f242cde62f60",
                                "text": "„Für zwei Jahre hat das Archäologische Museum Hamburg den Kieler Spezialisten für Städte im Mittelalter als Ausgrabungsleiter engagiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
