                                "target_senses": [
                                    {
                                        "sense_id": "0d313ad9-43e9-3422-bd73-d6e90aee5c70",
                                        "entry_id": "fd4250af-bd00-3591-bb75-4495ad455d0e",
                                        "glosses": [
                                            "Thèse selon laquelle il existe des idées ou formes a priori."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601b1ace-88c7-431c-a55f-0ecdcbd48b6a",
                                                "sense_id": "0d313ad9-43e9-3422-bd73-d6e90aee5c70",
                                                "text": "Contre l’apriorisme kantien, Mill soutient donc que le concept de nombre a son origine dans la manipulation que nous faisons des objets et qui nous conduit à les classer et à les ordonner."
                                            }
