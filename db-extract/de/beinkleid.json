                        ]
                    },
                    {
                        "translation_id": "ab4dc748-2894-4bfb-b74f-ac2f76e9baed",
                        "source_entry_id": "16feb41d-f874-3033-8f77-150988b04078",
                        "source_sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                        "source_sense_description": "veraltet, gehoben, noch scherzhaft, meist im Plural: Hose",
                        "target_lang_word": "pantalon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pantalon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                        "entry_id": "4f611218-a4c3-31a6-b2e3-72984714888f",
                                        "glosses": [
                                            "Longue culotte qui descend jusque sur le cou-de-pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a5d18c-a039-4936-bae3-9766d1a977e7",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "À peine eurent-ils endossé l’habit national, qu’ils s’admirèrent dans ce nouvel accoutrement ; le plus mince artisan affublé d’un uniforme regardait avec dédain son confrère en habit bourgeois. Bientôt un bonnet de grenadier et un pantalon de chasseur divisèrent en trois corps la milice parisienne elle-même et l’empêchèrent de se réunir pour le salut commun."
                                            },
                                            {
                                                "example_id": "b3f658f1-d6b9-498e-99f5-577a43f53b9a",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Winckelmann paraît s'être trompé, lorsqu'il a dit que le subligaculum des acteurs romains était un pantalon comme nous disons aujourd'hui."
                                            },
                                            {
                                                "example_id": "4e164a91-792b-493e-ae2f-42f1fd1a8370",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Leur costume consistait en une grossière vareuse de laine noire […], un chapeau à vastes bords, un pantalon à liseré rouge et un morceau de cuir replié en manière de chaussure."
                                            },
                                            {
                                                "example_id": "7534ede7-962f-4609-84ce-1ae312ff9cce",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Vêtu d’un chandail humide et porteur d’une casquette spongieuse, déformée, d’un pantalon trop court et de godillots à clous, le gars tétait un authentique brûle-gueule de terre-neuva."
                                            },
                                            {
                                                "example_id": "157ea2b0-77f1-4451-9da5-f8a578a12a4f",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Ils dégraffèrent mon pantalon, baissèrent mon slip et m’accrochèrent les électrodes de chaque côté de l’aine."
                                            },
                                            {
                                                "example_id": "c35cf41e-d667-4a30-a6b1-fe6ace68d2b8",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Non seulement, il ne porte que des sabots ou des espadrilles de toile, comme un contrebandier, mais aussi un éternel pantalon avachi, tout rapetassé au fond et aux genoux."
                                            },
                                            {
                                                "example_id": "476bb24c-b257-416b-afc2-2b3707884bb2",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Saviez-vous que le pantalon était jadis un vêtement interdit à Rome ? Considéré comme l’habit des barbares, il fut longtemps rejeté avant de s’imposer, contraint par le froid du Nord."
                                            },
                                            {
                                                "example_id": "eea3c625-e461-4401-a2d3-0a9331efcd44",
                                                "sense_id": "6af72790-f795-3cb5-b9ee-63792ec00d3e",
                                                "text": "Pantalon à pieds, pantalon qui a des pieds comme en ont les bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664ba249-8399-34f4-8201-8dbb8d3f318a",
                                        "entry_id": "4f611218-a4c3-31a6-b2e3-72984714888f",
                                        "glosses": [
                                            "Pièce de lingerie féminine consistant en une culotte à jambes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc6abb19-67be-4bc9-8f36-52e4ceaa4c0e",
                                                "sense_id": "664ba249-8399-34f4-8201-8dbb8d3f318a",
                                                "text": "Quand elle achetait soit des corsets, soit des peignoirs, soit des pantalons, elle voulait toujours que ce fût moi qui passasse avec elle dans la chambre au fond et qui les lui essayasse."
                                            },
                                            {
                                                "example_id": "af002249-c828-4e24-81fc-87d1173d75ab",
                                                "sense_id": "664ba249-8399-34f4-8201-8dbb8d3f318a",
                                                "text": "Et, comme Julius allait entrer, elle s’élança d’abord dans la pièce, vers un pantalon de femme, indiscrètement étalé sur une chaise, que ne parvenant pas à dissimuler, elle s’efforça du moins de réduire."
                                            },
                                            {
                                                "example_id": "d57ad6c0-6a75-4689-8eea-658cf847fae0",
                                                "sense_id": "664ba249-8399-34f4-8201-8dbb8d3f318a",
                                                "text": "Elle met son corset, ses jarretelles, son pantalon, son jupon."
                                            },
                                            {
                                                "example_id": "edb3c25f-9287-4c26-8d07-79a43524a641",
                                                "sense_id": "664ba249-8399-34f4-8201-8dbb8d3f318a",
                                                "text": "L’intérieur, en bois plus clair, « faisait ressortir » les piles de pantalons bordés de dentelles « larges comme la main », les jupons de dessous, les camisoles à festons empesés, les gentils cache-corset, l’orgueil de Joséfa « qui avait la passion du linge »."
                                            },
                                            {
                                                "example_id": "6371d272-bc55-44f2-b235-11c067ef0971",
                                                "sense_id": "664ba249-8399-34f4-8201-8dbb8d3f318a",
                                                "text": "En passant près des filles, il leur adressa une œillade. L’une d’elles se leva, tira sur sa robe et, à travers celle-ci, sur son pantalon qui la serrait entre les fesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e90439d-4f37-3c43-aa51-aecac18b06b4",
                                        "entry_id": "4f611218-a4c3-31a6-b2e3-72984714888f",
                                        "glosses": [
                                            "Comédien ou comédienne endossant le rôle de Pantalon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036e1b91-6823-4c84-9c1a-1071793a8393",
                                                "sense_id": "1e90439d-4f37-3c43-aa51-aecac18b06b4",
                                                "text": "Les décors sont beaux, les costumes très variés, et il y a parmi les tableaux qui se succèdent dans ces trois actes une scène vraiment originale : c’est le bal masqué de la fin, où apparaissent sous leur costume pittoresque tous les types de l’ancienne commedia dell’arte, les pierrots, les pantalons, les arlequins, les colombines, dont chaque groupe danse sur un rhythme particulier ; l’ensemble est gai et d’un effet vraiment comique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ed87d9-9faa-396f-9d0c-152d6854c009",
                                        "entry_id": "4f611218-a4c3-31a6-b2e3-72984714888f",
                                        "glosses": [
                                            "Homme sans dignité, sans consistance, qui change d’opinion, d’attitude et de conduite suivant les circonstances et ce qu’il croit être son intérêt, par allusion au personnage de la comédie italienne."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66b318e8-6eef-4e2f-bd2f-f47c577eedef",
                                                "sense_id": "e2ed87d9-9faa-396f-9d0c-152d6854c009",
                                                "text": "C’est un véritable pantalon."
                                            },
                                            {
                                                "example_id": "c16ae595-a999-46cb-9f58-d49d700ed118",
                                                "sense_id": "e2ed87d9-9faa-396f-9d0c-152d6854c009",
                                                "text": "– Je t’aide de mon mieux, mon amie, reprit Anthime, d’une voix séraphique ; je t’ai maintes fois proposé, puisque je suis ingambe à présent, d’aller au marché ou de faire le ménage à ta place.\n– Ce n’est point là affaire aux pantalons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
