                "senses": [
                    {
                        "sense_id": "f972ce16-90a2-3372-8770-b1123a583f55",
                        "entry_id": "d879c3c5-60cf-3aa5-8ecb-0327b68dfd8e",
                        "glosses": [
                            "een plaats waar kinderen kunnen spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f4980a-2726-4608-8fdc-a7376f7fe78d",
                                "sense_id": "f972ce16-90a2-3372-8770-b1123a583f55",
                                "text": "Generieke programma’s vanuit gemeenten en andere overheden zijn bedoeld voor álle kinderen. Zoals het project JOGG – Jongeren op gezond gewicht, waar 114 gemeenten aan meedoen. En waarbij scholen, ouders, sportverenigingen, bedrijven en zorgverleners zich hard maken voor een gezonde omgeving. Denk aan sportkantines die geen ongezonde snacks meer aanbieden, extra speelplekken, fietspaden en scholen waar de kinderen elke ochtend eerst anderhalve kilometer gaan hardlopen. De organisatie pleit ook voor strengere regels rond kindermarketing, waarbij kinderen niet verleid worden om ongezond eten te kopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0142d46b-7574-3e8e-b4d7-cd078854d4fc",
                        "entry_id": "d879c3c5-60cf-3aa5-8ecb-0327b68dfd8e",
                        "glosses": [
                            "een plaats waar een toneelgroep kan toneelspelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80d4d78-2b3c-4fbf-ac09-0363d249ea00",
                                "sense_id": "0142d46b-7574-3e8e-b4d7-cd078854d4fc",
                                "text": "Uitbundig en ook rauw zijn de scènes van de ambachtslieden die het heerlijke liefdessprookje vertellen. Ze schmieren en maken muziek, dansen tussen het publiek. De gekte is af en toe té: zelfs de Friese Elfstedenuitroep ‘It Giet Oan!’ weerklinkt in het bos en de muzikanten spelen met veel bravoure een Mendelssohn-achtige bruiloftsmars. Maar voor het gezelschap is deze fraaie toneelruimte hoe dan ook een geweldige, nieuwe speelplek: het is of de band met de historie strak wordt aangehaald, met alle licht-onzinnige frivoliteiten die er kennelijk bij horen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15dd082f-7caf-4a8b-87d4-e06a106b97c9",
                        "source_entry_id": "d879c3c5-60cf-3aa5-8ecb-0327b68dfd8e",
                        "source_sense_id": "f972ce16-90a2-3372-8770-b1123a583f55",
                        "source_sense_description": "een plaats waar kinderen kunnen spelen",
                        "target_lang_word": "playground",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A large open space for children to play in, usually having dedicated play equipment (such as swings and slides)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89c6887-7417-4180-b43b-1840ffb6711c",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The kids have to go to the playground during recess, no matter the weather."
                                            },
                                            {
                                                "example_id": "81f8f73c-9c8b-458b-9b0a-c315e4067230",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The local council have set up a new playground, equipped with slides, swings, and a climbing wall."
                                            },
                                            {
                                                "example_id": "9296211f-5b27-42b7-9f0a-0b28bf2f263d",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "Any physical or metaphysical space in which a person or organization has free rein to do as they please."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf7cf8e-9a25-470f-9187-ac1beff6a217",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "The exclusive tropical island was a millionaire's playground."
                                            },
                                            {
                                                "example_id": "8271b7cf-89c4-4a19-9571-e910c334a078",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "Kjelsås (six miles) marks the end of the suburbs, and the line immediately plunges into Nordmarka. This vast untamed area of forest and mountain (much of it over 2,000 ft. above sea level), interspersed with innumerable lakes, large and small, is known as Oslo's playground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37c8473-d51b-3c12-aa38-3dc2ed5145b9",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A sandbox for testing calls to an application programming interface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
