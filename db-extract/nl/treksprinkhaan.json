                        "entry_id": "268e5967-547f-3596-9bf8-f9c3e565aa73",
                        "glosses": [
                            "benaming voor sprinkhanen die normaal gesproken solitair leven, maar onder bepaalde omstandigheden grote zwermen vormen"
                        ],
                        "tags": [
                            "rechtvleugeligen"
                        ],
                        "examples": [
