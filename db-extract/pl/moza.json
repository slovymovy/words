                    },
                    {
                        "translation_id": "97f84f8b-f801-4804-85ff-8f9ad4a32f4b",
                        "source_entry_id": "fe1af989-4cb8-3cbf-ad19-e7bdbbd29a24",
                        "source_sense_id": "932bc526-8db5-3451-b69b-1cf4341438c1",
                        "target_lang_word": "Meuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                        "entry_id": "a8d0bb58-c864-3a7e-8a1d-485be2e5b3bf",
                                        "glosses": [
                                            "Fleuve prenant sa source en Champagne-Ardenne en France, traversant la Belgique, et se jetant dans la mer du Nord, aux Pays-Bas."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633ce59e-8969-4508-a088-23098fecb6bd",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Mais loin de son Plateau, Arsène André étouffait. L'air résineux lui manquait, les brouillards de la Meuse lui enflammaient la gorge."
                                            },
                                            {
                                                "example_id": "2ab4c5c3-c412-45df-8425-595294335cc1",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "À l'extrémité de la route que nous suivions s'ouvrait un pont qui enjambait un canal, et donnait accès dans une sorte d'île formée par une grande courbe de la Meuse, qui dessine un oméga."
                                            },
                                            {
                                                "example_id": "99c646dc-68d4-4d57-919a-96aa6f6c8870",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Dans les vallées de la Meuse et de la Chiers, il existe également de belles prairies qui sont souvent d'une étendue immense."
                                            },
                                            {
                                                "example_id": "072a7ad7-dd88-48f5-a73e-8124addbf48d",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Parmi ces observations il en est que nous ne pourrons publier que lorsque les événements en cours, sans lesquels, d'ailleurs, nous n'eussions certainement pas vu l’embâcle de la Meuse, seront terminés."
                                            },
                                            {
                                                "example_id": "561cff25-cb63-4431-a2a1-df389829eb7b",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea920d2-f9a5-3ff6-b220-f3c9b1900361",
                                        "entry_id": "a8d0bb58-c864-3a7e-8a1d-485be2e5b3bf",
                                        "glosses": [
                                            "Département français du Grand Est, traversé par ce fleuve."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b034ec14-4bf7-4ebc-aca5-62c5d6e80bf3",
                                                "sense_id": "6ea920d2-f9a5-3ff6-b220-f3c9b1900361",
                                                "text": "Dans la Meuse, l’A4 est bloquée entre Manheulles et Haudiomont, selon les Jeunes Agriculteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50eae1e-4d84-377a-9188-d31fd0345462",
                                        "entry_id": "a8d0bb58-c864-3a7e-8a1d-485be2e5b3bf",
                                        "glosses": [
                                            "Village et ancienne commune française, située dans le département de la Haute-Marne intégrée dans la commune de Val-de-Meuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
