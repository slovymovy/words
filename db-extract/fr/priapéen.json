                                "example_id": "4cc7b0c8-0ee6-4554-962b-e58720a19775",
                                "sense_id": "8fa872cf-fe99-379b-81ac-780ba79c6f8c",
                                "text": "Vers priapéen : hexamètre coupé après le troisième pied."
