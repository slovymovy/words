                    {
                        "translation_id": "91abbaa5-5d72-43f3-b4cc-e82fc348fb0d",
                        "source_entry_id": "7f5e78f5-1a36-3800-80b8-045a994b0980",
                        "source_sense_id": "a6209b42-c5c6-3c50-a536-3f531d45c185",
                        "source_sense_description": "bepaald soort plant met blauwe vruchten, Prunus spinosa",
                        "target_lang_word": "prunellier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prunellier",
