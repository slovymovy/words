                "senses": [
                    {
                        "sense_id": "f25a338a-7439-37a1-a5f2-93cab1f79ab2",
                        "entry_id": "6aa3b386-a117-3ba5-a9af-60acbcd73742",
                        "glosses": [
                            "Personne qui parle le néerlandais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9712f66-dc7e-4596-8450-0c7d4a943e0d",
                                "sense_id": "f25a338a-7439-37a1-a5f2-93cab1f79ab2",
                                "text": "Autrement dit, le déséquilibre entre les deux communautés linguistiques est massif, tant et si bien qu’un francophone a concrètement six fois plus de chance de faire du renseignement qu’un néerlandophone."
                            },
                            {
                                "example_id": "8bade08f-ab4c-4bdb-9ec1-9b5dda16dd8f",
                                "sense_id": "f25a338a-7439-37a1-a5f2-93cab1f79ab2",
                                "text": "La volonté des néerlandophones d’Anvers d’unilinguiser la Flandre se heurtera en effet à d’autres impératifs conditionnant également le développement de la Gemeinschaft flamande."
                            }
                        ]
                    }
                ],
