                "senses": [
                    {
                        "sense_id": "fe726327-11e9-3d66-a4d8-776abba77010",
                        "entry_id": "67fc3d9e-9953-3f4d-9651-afed21b872b7",
                        "glosses": [
                            "Goutte-à-goutte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d8ce60-3ce3-4bee-9b2e-8fffa3c826c5",
                                "sense_id": "fe726327-11e9-3d66-a4d8-776abba77010",
                                "text": "Sie lag im Koma und wurde mit dem Tropf ernährt.",
                                "translation": "Elle est dans le coma et est alimentée grâce au goutte-à-goutte."
                            }
                        ]
                    },
                    {
