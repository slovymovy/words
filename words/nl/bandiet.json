                                "target_lang_sense_clarification": "Criminel ou malfaiteur."
                            },
                            {
                                "target_lang_word": "criminel",
                                "target_lang_sense_clarification": "Personne ayant commis un crime."
                            },
                            {
                                "target_lang_word": "voyou",
                                "target_lang_sense_clarification": "Personne malhonnête ou de mauvaise vie."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac2dee7-c0dc-3424-8293-b334f54ca3e7",
                    "sense_definition": "iemand die reizigers op de weg berooft",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "misdadiger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De reizigers waren bang voor een <w>bandiet</w> in het donkere bos.",
                            "target_lang_translations": {
                                "fr": "Les voyageurs avaient peur d'un <w>brigand</w> dans la forêt sombre."
                            }
                        },
                        {
                            "text": "Vroeger was de weg onveilig door elke <w>bandiet</w> die daar rondhing.",
                            "target_lang_translations": {
                                "fr": "Autrefois, la route était dangereuse à cause de chaque <w>brigand</w> qui y rôdait."
                            }
                        }
                    ],
                    "synonyms": [
                        "schobbejak"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui attaque et dépouille les voyageurs sur la route."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "brigand",
                                "target_lang_sense_clarification": "Criminel qui attaque les gens sur les routes."
                            },
                            {
                                "target_lang_word": "bandit de grand chemin",
                                "target_lang_sense_clarification": "Expression historique pour un voleur de route."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8da38c8-0489-32c6-b0fe-8d856d96eaf4",
                    "sense_definition": "ondeugend kind",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ondeugend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een klein <w>bandietje</w> is dat kind toch vandaag.",
                            "target_lang_translations": {
                                "fr": "Quel petit <w>chenapan</w> est cet enfant aujourd'hui."
                            }
                        },
                        {
                            "text": "Het kleine <w>bandietje</w> had alle koekjes uit de trommel gepakt.",
                            "target_lang_translations": {
                                "fr": "Le petit <w>chenapan</w> avait pris tous les biscuits de la boîte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "klein bandietje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak speels bedoeld voor kinderen"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Enfant turbulent ou désobéissant, souvent utilisé de manière affectueuse."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "petit voyou",
                                "target_lang_sense_clarification": "Utilisé pour un enfant turbulent."
                            },
                            {
                                "target_lang_word": "petit chenapan",
                                "target_lang_sense_clarification": "Enfant espiègle ou polisson."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdefb1a3-f503-3aed-9e3c-45d3637b0dc8",
                    "sense_definition": "iemand die uit zijn land is verbannen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieke <w>bandiet</w> mocht nooit meer terugkeren naar zijn vaderland.",
                            "target_lang_translations": {
                                "fr": "Le <w>banni</w> politique n'a jamais été autorisé à retourner dans sa patrie."
                            }
                        },
                        {
                            "text": "Als een echte <w>bandiet</w> leefde hij jarenlang in een vreemd land.",
                            "target_lang_translations": {
                                "fr": "Comme un véritable <w>exilé</w>, il a vécu pendant des années dans un pays étranger."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verwijst naar de historische betekenis van verbanning"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne bannie ou exilée de son pays."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "banni",
                                "target_lang_sense_clarification": "Personne condamnée à l'exil."
                            },
                            {
                                "target_lang_word": "exilé",
                                "target_lang_sense_clarification": "Personne contrainte de vivre hors de son pays."
                            }
                        ]
                    }
                }
            ]
        }
