                    {
                        "translation_id": "d4ea965f-1f4a-4432-933d-ebfbd040804a",
                        "source_entry_id": "930fbbd7-84ac-3599-a21b-d854a294ac00",
                        "source_sense_description": "able to be measured",
                        "target_lang_word": "meetbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meetbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9696c97c-eb6e-34a4-97e4-33bdde45d0f4",
                                        "entry_id": "3466b62a-e876-326b-ac82-fe88182089b7",
                                        "glosses": [
                                            "te bepalen in maat en getal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b526f19-4dfd-4a76-b37a-b6a84878a37c",
                                                "sense_id": "9696c97c-eb6e-34a4-97e4-33bdde45d0f4",
                                                "text": "Chemicaliën die wij in het milieu brengen, blijken tot op afgelegen plekken te traceren, beslissingen over fossiele energie zullen nog duizenden jaren meetbaar zijn. Landbouw, fossiele brandstoffen, mijnbouw, medische zorg en verstedelijking vormen echte vooruitgang, maar leiden niettemin tot onvoorziene wereldwijde gevolgen op de lange termijn. Die gevolgen waren aanvankelijk niet te overzien, maar zelfs nu ze bekend zijn, zijn we niet in staat ons aan te passen."
                                            },
                                            {
                                                "example_id": "082dd6ce-1019-4041-bf27-e18787d8c7a6",
                                                "sense_id": "9696c97c-eb6e-34a4-97e4-33bdde45d0f4",
                                                "text": "Ik zocht naar een manier om mijn nieuw verworven houding thuis vast te houden en bedacht vijf doelen met concrete, meetbare doelstellingen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "092bf6e0-d6da-4956-a277-69f6ca4de313",
                        "source_entry_id": "930fbbd7-84ac-3599-a21b-d854a294ac00",
                        "source_sense_description": "able to be measured",
                        "target_lang_word": "messbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "messbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                        "entry_id": "7ef7420b-199b-3884-b38b-134b0ddc1688",
                                        "glosses": [
                                            "so, dass es gemessen werden kann; zu messen möglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5c75aa-e220-4115-84e8-54404c5184f9",
                                                "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                                "text": "Messen, was messbar ist, und messbar machen, was nicht messbar ist."
                                            },
                                            {
                                                "example_id": "7f6d7da5-dbe9-4dc0-97a1-3a629b9663e7",
                                                "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                                "text": "[…] was Menschen wichtig ist, das ist schwer messbar."
                                            },
                                            {
                                                "example_id": "ebec2e31-9a26-4a2e-8f72-1d6763a03224",
                                                "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                                "text": "Nie zuvor wurden die Deutschen so alt wie heute. Die weitere Zunahme an Lebensjahren ist jedoch kaum noch messbar."
                                            },
                                            {
                                                "example_id": "9cdbdd3b-cdfa-473f-be1e-bbd0ec2816cd",
                                                "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                                "text": "„Das Beherrschen des Kletterns und des Fliegens, die Kontrolle über die Wand oder das Fluggerät, die Souveränität auch bei unvorhersehbaren Überraschungen, wird ständig messbar und erlebbar.“"
                                            },
                                            {
                                                "example_id": "fc85dda9-90e1-4d3c-8e2a-215eab5d4980",
                                                "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                                "text": "Immer und überall erreichbar sein, viele Aufgaben gleichzeitig erledigen, Schichtarbeit, Termin- und Leistungsdruck: All das kann zu psychischen Belastungen führen. Aber sind die auch messbar?"
                                            },
                                            {
                                                "example_id": "4a564185-e0a9-4a1b-8774-bc847c9e428b",
                                                "sense_id": "513ccf82-46f5-31c5-9edc-1cf9c14eac82",
                                                "text": "Ein Anstieg [des Weltklimas um] über zwei Grad hätte weitaus dramatischere Folgen, als die Auswirkungen, die bisher weltweit spür- und messbar sind, so Klimaexperten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bf25557-8e89-4d00-8798-864a55830137",
