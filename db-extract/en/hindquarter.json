                                                "sense_id": "cd18211b-835d-3460-8344-f9523134c9d3",
                                                "text": "Zijn slagen met de achterhand zijn niet zo goed als die met de voorhand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340610f0-3651-3c7d-8ba7-b05b030b71fc",
