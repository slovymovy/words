                                        "entry_id": "b32d134e-567a-3d83-8130-ada480e27f48",
                                        "glosses": [
                                            "To judge and form an opinion of the value of, from imperfect data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af32cdbe-6c7c-4a3e-8dee-95ce2b06edc8",
                                                "sense_id": "d5d0ad8c-c6c8-3caf-9dcd-5a1104f82916",
                                                "text": "It is by the weight of silver, and not the name of the piece, that men estimate commodities and exchange them."
                                            },
