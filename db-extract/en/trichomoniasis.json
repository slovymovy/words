                "senses": [
                    {
                        "sense_id": "2d802e18-b97b-3e95-9f2c-466b52ccf700",
                        "entry_id": "c5ff2c04-f628-36fc-8416-2c61bba49c25",
                        "glosses": [
                            "A common sexually transmitted disease caused by the parasite Trichomonas vaginalis and infecting the urinary tract or vagina."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "06010aa6-a7a4-4297-ac86-46d791a27078",
                                "sense_id": "2d802e18-b97b-3e95-9f2c-466b52ccf700",
                                "text": "Similar changes occur later after the menopause that, if not ideal for colonization by T. vaginalis they are clearly not impossible, since both prepubertal and post-menopausal trichomoniases in females are well described."
                            },
                            {
                                "example_id": "6655452b-d382-4820-bb9b-30c51fb28c5e",
                                "sense_id": "2d802e18-b97b-3e95-9f2c-466b52ccf700",
                                "text": "Trichomoniasis is the most prevalent nonviral sexually transmitted infection in humans worldwide."
                            },
                            {
                                "example_id": "61e5ed83-c249-4d81-8f8e-c26eca0fa548",
                                "sense_id": "2d802e18-b97b-3e95-9f2c-466b52ccf700",
                                "text": "2009, Sarah L. Cudmore, Gary E. Garber, Chapter 74: Diagnosis and Treatment of Metronidazole-Resistant Trichomonas vaginalis Infection, Douglas Mayers (editor), Antimicrobial Drug Resistance, Volume 2: Clinical and Epidemiological Aspects, page 1092,\nTrichomoniasis has long been considered a disease of women, but the disease can also cause significant morbidity in men."
                            }
                        ]
                    }
