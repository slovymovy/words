                        "sense_id": "37739399-2496-30d8-a4ad-66117638feed",
                        "entry_id": "3c140ceb-2776-31bf-b5cd-c1577c9a836d",
                        "glosses": [
                            "биол. созревание плода в искусственной утробе"
                        ],
                        "tags": [],
