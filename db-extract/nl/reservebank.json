                "senses": [
                    {
                        "sense_id": "6770608e-3c6a-3e04-8f3a-ac2e0ee53787",
                        "entry_id": "3921ae1d-f791-356c-8c21-751b23057a48",
                        "glosses": [
                            "de bank waarop de reservespelers zitten tijdens een wedstrijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796a9ab0-d66e-4853-a36c-9a47922c1e26",
                                "sense_id": "6770608e-3c6a-3e04-8f3a-ac2e0ee53787",
                                "text": "Treurt u om de zangcarrière die u niet heeft nagejaagd of juist om alle tijd die u op de reservebank hebt doorgebracht in de hoop op een glansrijke voetbalcarrière?"
                            },
                            {
                                "example_id": "c372582f-c28d-4fa9-8bbe-c8189b76bf6e",
                                "sense_id": "6770608e-3c6a-3e04-8f3a-ac2e0ee53787",
                                "text": "Van Beek viel dinsdag in Napels nog kort in tegen de koploper in de Serie A. Nieuwkoop verhuisde door de plotselinge blessure van Jan-Arie van der Heijden op het allerlaatste moment van de tribune naar de reservebank. De Zeeuw kwam echter niet in actie."
                            }
                        ]
                    },
                    {
                        "sense_id": "0760dffe-4ab4-3270-a8ed-527b3a52b403",
                        "entry_id": "3921ae1d-f791-356c-8c21-751b23057a48",
                        "glosses": [
                            "fictieve plaats vanwaar mensen toekijken die klaar staan om anderen te vervangen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "918a03bd-19ef-4919-959a-7b30c4578c93",
                                "sense_id": "0760dffe-4ab4-3270-a8ed-527b3a52b403",
                                "text": "Ze doen nu nog niet mee: Gert-Jan Segers (ChristenUnie) en Lodewijk Asscher (PvdA). Vanaf de reservebank kijken ze toe of het lukt met de vier partijen. Segers is de meest logische nieuwe gesprekspartner als het met GroenLinks niet lukt. Hij kan volgens betrokkenen vooral goed opschieten met Rutte. Op Rutte’s verjaardag nam Segers een charlottetaart mee naar het Torentje, van Pâtisserie Jarreau uit Den Haag. ,,Dat is een dure”, zei Rutte."
                            }
                        ]
                    }
