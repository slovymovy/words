                        "glosses": [
                            "A derivative of acetamide with two acetyl groups attached (C₄H₇NO₂)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e98fd5b-69e0-450e-9411-14aa29966d57",
                                "sense_id": "87dd6341-8f81-314d-b928-94c0c3f30bdd",
                                "text": "This is dissolved in ether and hydrochloric acid passed in, when acetamide hydrochloride separates out, whilst diacetamide remains in solution."
                            },
                            {
                                "example_id": "df9093d9-6cb3-4527-871c-b5248a19b7ea",
                                "sense_id": "87dd6341-8f81-314d-b928-94c0c3f30bdd",
                                "text": "Hydrolysis of the diacetamide with 0.33 N sulfuric acid gave L-threose."
                            },
                            {
                                "example_id": "5f8f3f71-11be-4024-ada1-b9ba92024562",
                                "sense_id": "87dd6341-8f81-314d-b928-94c0c3f30bdd",
                                "text": "Under these conditions, the diacetamide compound of the lower sugar results, and the free sugar is obtained from it by acid hydrolysis."
