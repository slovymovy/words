                            }
                        },
                        {
                            "text": "De ruwe wol moet eerst grondig worden <w>gekamd</w> voor het spinnen.",
                            "target_lang_translations": {
                                "en": "The raw wool must first be thoroughly <w>combed</w> before spinning."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gekamde katoen"
                    ],
                    "target_lang_definitions": {
                        "en": "Processed with a toothed tool, such as wool or cotton, to align fibers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "combed",
                                "target_lang_sense_clarification": "referring to textiles like cotton or wool"
                            },
                            {
                                "target_lang_word": "carded",
                                "target_lang_sense_clarification": "referring to fibers prepared for spinning"
                            }
                        ]
                    }
                }
            ]
        },
