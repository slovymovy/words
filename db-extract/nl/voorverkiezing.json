                                            },
                                            {
                                                "example_id": "c8a4e222-312d-4eac-9bb6-86c06a1dcdc7",
                                                "sense_id": "5efed1df-0b9e-3fe6-8ac4-559e54492622",
                                                "text": "most common primaries"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ff875c-42e9-3256-bd81-7ac824e2420b",
                                        "entry_id": "fee823dc-24d2-31ca-86c6-9c540dba1c84",
