                        "examples": [
                            {
                                "example_id": "7a4e2c42-4d75-40e5-87ee-f6f1d4c9b9d5",
                                "sense_id": "af6884be-2a9d-3338-ba3c-fc0efa0a1d73",
                                "text": "Als nationale zakjapanner zong CPB-baas Coen Teulings een ander liedje. Hij deed zijn mond niet open toen de woningmarkt werd vernield door overhaaste besluiten van kortzichtige regeerders. Die dachten met beperking van de hypotheekrenteaftrek de gaten in de begroting wel te kunnen dichten."
                            },
                            {
                                "example_id": "2446a9a0-8f58-49a3-acd8-2e5f95d5ef81",
                                "sense_id": "af6884be-2a9d-3338-ba3c-fc0efa0a1d73",
                                "text": "Als een kudde dolle olifanten dendert een groep adolescente regeerders door de porseleinkast van de zorg voor ouderen. De één na de andere verworvenheid wordt verkracht of om zeep geholpen."
                            },
                            {
                                "example_id": "562966f3-db50-46c5-b861-a55ffe8fabf8",
                                "sense_id": "af6884be-2a9d-3338-ba3c-fc0efa0a1d73",
                                "text": "Buiten hadden enkele tientallen betogers hebben zich verzameld om tegen de als autoritair regeerder bekend staande Poetin te betogen."
                            }
                        ]
                    }
                ],
