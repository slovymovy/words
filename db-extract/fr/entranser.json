                "senses": [
                    {
                        "sense_id": "b2fd2c17-c5d8-3e1c-a94e-dc20312bc05d",
                        "entry_id": "b02284ee-a7f6-31d0-9ab1-c437906532bb",
                        "glosses": [
                            "Mettre en transe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb08d944-6019-4a70-ac3f-bcfa8803565d",
                                "sense_id": "b2fd2c17-c5d8-3e1c-a94e-dc20312bc05d",
                                "text": "Ondes sonores intenses qui se propagent comme des vagues, vous environnent, vous dépassent, vous entraînent, vous séparent du reste du monde, vous entransent."
                            },
                            {
                                "example_id": "d9cd353a-7789-4fef-a3d9-143219ce1be7",
                                "sense_id": "b2fd2c17-c5d8-3e1c-a94e-dc20312bc05d",
                                "text": "William Crookes, le célèbre savant qui expérimenta avec le médium Florence Cook, a même pu prendre le pouls du fameux fantôme « Katie King » ; il décompta exactement 75 battements, alors que le pouls du médium entransé en atteignait 90, ce qui prouvait bien que ce n’était pas lui qui jouait au fantôme mystificateur."
                            }
                        ]
                    }
