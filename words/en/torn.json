{
    "word_family": [
        "tear",
        "tearer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fa635b4-bbe4-34f0-8ac2-f46aff331c1a",
                    "sense_definition": "Past participle of <w>tear</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old flag was <w>torn</w> by the strong wind during the storm.",
                            "target_lang_translations": {
                                "ru": "Старый флаг был <w>разорван</w> сильным ветром во время шторма.",
                                "zh": "暴风雨中，旧旗帜被大风<w>撕破</w>了。"
                            }
                        },
                        {
                            "text": "He has <w>torn</w> a page out of his notebook to write a note.",
                            "target_lang_translations": {
                                "ru": "Он <w>вырвал</w> страницу из своего блокнота, чтобы написать записку.",
                                "zh": "他从笔记本上<w>撕下</w>一页纸来写便条。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ripped",
                        "shredded"
                    ],
                    "antonyms": [
                        "mended",
                        "repaired"
                    ],
                    "common_phrases": [
                        "torn apart",
                        "badly torn",
                        "torn to pieces"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола tear (рвать).",
                        "zh": "动词 tear 的过去分词，指被撕裂或扯破。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порванный",
                                "target_lang_sense_clarification": "поврежденный, имеющий дыры"
                            },
                            {
                                "target_lang_word": "разорванный",
                                "target_lang_sense_clarification": "разделенный на части силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撕破的",
                                "target_lang_sense_clarification": "指物体被撕裂后的状态"
                            },
                            {
                                "target_lang_word": "扯破的",
                                "target_lang_sense_clarification": "指因用力拉扯而破损"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "256a7945-2764-3b32-83db-ea1e52125e02",
                    "sense_definition": "Unable to decide between two or more choices or possibilities.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>torn</w> between her loyalty to her family and her desire for independence.",
                            "target_lang_translations": {
                                "ru": "Она <w>разрывалась</w> между преданностью семье и желанием независимости.",
                                "zh": "她在对家庭的忠诚和对独立的渴望之间感到十分<w>纠结</w>。"
                            }
                        },
                        {
                            "text": "I am <w>torn</w> about whether to accept the new job offer or stay here.",
                            "target_lang_translations": {
                                "ru": "Я <w>разрываюсь</w>, не зная, принять ли новое предложение о работе или остаться здесь.",
                                "zh": "我对于是接受这份新工作还是留在这里感到<w>左右为难</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "undecided",
                        "conflicted",
                        "ambivalent"
                    ],
                    "antonyms": [
                        "decided",
                        "certain",
                        "sure"
                    ],
                    "common_phrases": [
                        "torn between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный сделать выбор между двумя или более возможностями; испытывающий внутренний конфликт.",
                        "zh": "形容人在两个选择或可能性之间难以抉择，感到内心冲突。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрывающийся",
                                "target_lang_sense_clarification": "между двумя вариантами или чувствами"
                            },
                            {
                                "target_lang_word": "в смятении",
                                "target_lang_sense_clarification": "нерешительный, сомневающийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纠结",
                                "target_lang_sense_clarification": "形容内心矛盾，难以做出决定"
                            },
                            {
                                "target_lang_word": "左右为难",
                                "target_lang_sense_clarification": "形容处于两难境地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdc9539-7034-3f33-be79-a38cee50359f",
                    "sense_definition": "Having deep and irregular incisions along the margin or edge, often used to describe leaves.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist examined the <w>torn</w> leaves of the rare plant specimen under the microscope.",
                            "target_lang_translations": {
                                "ru": "Биолог рассматривал под микроскопом <w>изрезанные</w> листья редкого образца растения.",
                                "zh": "生物学家在显微镜下观察了那株稀有植物标本<w>边缘残缺</w>的叶片。"
                            }
                        },
                        {
                            "text": "This species is characterized by its <w>torn</w> petals which give it a ragged appearance.",
                            "target_lang_translations": {
                                "ru": "Этот вид характеризуется <w>рваными</w> лепестками, которые придают ему неряшливый вид.",
                                "zh": "该物种的特征是其<w>裂缘</w>的花瓣，这使它看起来有些破损。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jagged",
                        "ragged"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий глубокие и неровные вырезы по краю (обычно о листьях или лепестках).",
                        "zh": "指边缘有深且不规则的缺口，常用于描述植物的叶片或花瓣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рваный",
                                "target_lang_sense_clarification": "с неровными краями"
                            },
                            {
                                "target_lang_word": "изрезанный",
                                "target_lang_sense_clarification": "ботанический термин для формы листа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘残缺的",
                                "target_lang_sense_clarification": "指叶片边缘不完整"
                            },
                            {
                                "target_lang_word": "裂缘的",
                                "target_lang_sense_clarification": "植物学中描述叶片边缘有裂口的术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}