                                                "sense_id": "6b1ccd3d-794d-38e1-9e11-b1a366fa9505",
                                                "text": "Er hatte ein aschfahles Gesicht."
                                            },
                                            {
                                                "example_id": "059f192e-3776-45b9-bb5f-61351cf9df3e",
                                                "sense_id": "6b1ccd3d-794d-38e1-9e11-b1a366fa9505",
                                                "text": "Als sie diese Nachricht hörte, wurde sie aschfahl im Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
