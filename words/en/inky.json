{
    "word_family": [
        "ink",
        "inkiness",
        "inkstand",
        "inkwell"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05e08696-2618-3dff-8f1b-b0ec4cd91eab",
                    "sense_definition": "Of the colour of ink, especially black ink; extremely dark.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers got lost in the forest under an <w>inky</w> black sky.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы заблудились в лесу под <w>чернильно-черным</w> небом.",
                                "pl": "Wędrowcy zgubili się w lesie pod <w>atramentowo-czarnym</w> niebem."
                            }
                        },
                        {
                            "text": "She stared into the <w>inky</w> darkness of the deep ocean water.",
                            "target_lang_translations": {
                                "ru": "Она всматривалась в <w>непроглядную</w> тьму глубоких океанских вод.",
                                "pl": "Wpatrywała się w <w>nieprzeniknioną</w> ciemność głębin oceanu."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark",
                        "black",
                        "murky"
                    ],
                    "antonyms": [
                        "bright",
                        "clear"
                    ],
                    "common_phrases": [
                        "inky darkness",
                        "inky black sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвета чернил, особенно черных; чрезвычайно темный, непроглядно-черный.",
                        "pl": "W kolorze atramentu, zwłaszcza czarnego; niezwykle ciemny, mroczny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернильный",
                                "target_lang_sense_clarification": "о цвете, темноте"
                            },
                            {
                                "target_lang_word": "чернильно-черный",
                                "target_lang_sense_clarification": "очень темный"
                            },
                            {
                                "target_lang_word": "непроглядный",
                                "target_lang_sense_clarification": "о темноте, небе"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "atramentowy",
                                "target_lang_sense_clarification": "o bardzo ciemnym, głębokim kolorze"
                            },
                            {
                                "target_lang_word": "nieprzenikniony",
                                "target_lang_sense_clarification": "o ciemności, której nie da się przejrzeć"
                            },
                            {
                                "target_lang_word": "czarny jak atrament",
                                "target_lang_sense_clarification": "opisowy, bardzo ciemny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0047564-b3d1-3e0c-8d8b-21e67460133f",
                    "sense_definition": "Spattered or stained with ink.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolboy tried to hide his <w>inky</w> fingers behind his back.",
                            "target_lang_translations": {
                                "ru": "Школьник пытался спрятать за спину свои <w>испачканные чернилами</w> пальцы.",
                                "pl": "Uczeń próbował ukryć za plecami swoje <w>poplamione atramentem</w> palce."
                            }
                        },
                        {
                            "text": "She wiped her <w>inky</w> hands on a piece of scrap paper.",
                            "target_lang_translations": {
                                "ru": "Она вытерла свои <w>чернильные</w> руки о клочок бумаги.",
                                "pl": "Wytarła swoje <w>atramentowe</w> dłonie o kawałek papieru."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inky fingers",
                        "inky hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испачканный или покрытый пятнами чернил.",
                        "pl": "Pobrudzony lub poplamiony atramentem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испачканный чернилами",
                                "target_lang_sense_clarification": "о пальцах, руках"
                            },
                            {
                                "target_lang_word": "чернильный",
                                "target_lang_sense_clarification": "в чернильных пятнах"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "poplamiony atramentem",
                                "target_lang_sense_clarification": "o dłoniach lub przedmiotach"
                            },
                            {
                                "target_lang_word": "atramentowy",
                                "target_lang_sense_clarification": "pokryty plamami atramentu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eedaf9c-1ed9-3991-a236-77ac2566b1bd",
                    "sense_definition": "Having very dark skin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old literary text described the character's <w>inky</w> complexion.",
                            "target_lang_translations": {
                                "ru": "В старом литературном тексте описывался <w>темный</w> цвет лица персонажа.",
                                "pl": "Stary tekst literacki opisywał <w>ciemną</w> karnację postaci."
                            }
                        },
                        {
                            "text": "He wrote a poem dedicated to his <w>inky</w> muse.",
                            "target_lang_translations": {
                                "ru": "Он написал стихотворение, посвященное своей <w>темнокожей</w> музе.",
                                "pl": "Napisał wiersz dedykowany swojej <w>ciemnoskórej</w> muzie."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark",
                        "black",
                        "dusky",
                        "swarthy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often literary or historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий очень темную кожу (устаревшее или литературное).",
                        "pl": "Mający bardzo ciemną karnację (użycie literackie lub przestarzałe)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темнокожий",
                                "target_lang_sense_clarification": "о цвете кожи"
                            },
                            {
                                "target_lang_word": "черный как чернила",
                                "target_lang_sense_clarification": "литературное сравнение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ciemnoskóry",
                                "target_lang_sense_clarification": "o kolorze skóry"
                            },
                            {
                                "target_lang_word": "o śniadej cerze",
                                "target_lang_sense_clarification": "literackie określenie ciemnej karnacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c5f9058d-479a-3298-8e73-e0c205b3674d",
                    "sense_definition": "The Inquisitor player character from the video game Dragon Age: Inquisition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "Many players prefer to customize their <w>Inky</w> as an elven mage.",
                            "target_lang_translations": {
                                "ru": "Многие игроки предпочитают настраивать своего <w>Инки</w> как эльфийского мага.",
                                "pl": "Wielu graczy woli dostosować swojego <w>Inki</w> jako elfiego maga."
                            }
                        },
                        {
                            "text": "I decided to make my <w>Inky</w> a very faithful believer in the game.",
                            "target_lang_translations": {
                                "ru": "Я решил сделать своего <w>Инки</w> очень искренне верующим в игре.",
                                "pl": "Postanowiłem uczynić mojego <w>Inki</w> bardzo wierzącą postacią w grze."
                            }
                        }
                    ],
                    "synonyms": [
                        "Quizzy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Gaming community slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инквизитор, игровой персонаж из видеоигры Dragon Age: Inquisition (сленг игрового сообщества).",
                        "pl": "Inkwizytor, postać gracza z gry wideo Dragon Age: Inkwizycja (slang społeczności graczy)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Инки",
                                "target_lang_sense_clarification": "прозвище Инквизитора в фандоме"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Inki",
                                "target_lang_sense_clarification": "potoczne określenie Inkwizytora w fandomie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
