                            "target_lang_translations": {
                                "ru": "Нам нужно <w>приглушить</w> яркие цвета в этой комнате.",
                                "zh": "我们需要<w>减弱</w>这个房间里明亮的颜色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "color",
                        "colour",
                        "dye",
                        "paint",
                        "tint"
                    ],
                    "common_phrases": [
                        "tone down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять цвет или качество чего-либо, часто для гармонизации.",
                        "zh": "改变某物的颜色或质量，通常是为了使其协调。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонировать",
                                "target_lang_sense_clarification": "менять оттенок или качество для гармонии"
                            },
                            {
                                "target_lang_word": "приглушать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调色",
                                "target_lang_sense_clarification": "调整颜色"
                            },
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "使颜色变柔和"
                            }
                        ]
                    }
                }
            ]
        },
        {
