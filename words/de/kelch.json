    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e994999-58d1-36b3-a3f9-926ea19874b2",
                    "sense_definition": "Schlankes Trinkgefäß mit Fuß und hohem Stiel, meist für Wein oder Schaumwein verwendet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gefaess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er goss den edlen Rotwein vorsichtig in den gläsernen <w>Kelch</w> ein."
                        },
                        {
                            "text": "Die festlich gekleideten Gäste stießen mit ihren gefüllten <w>Kelchen</w> auf das Brautpaar an."
                        }
                    ],
                    "synonyms": [
                        "Kelchglas",
                        "Pokal"
                    ],
                    "common_phrases": [
                        "ein goldener Kelch",
                        "aus dem Kelch trinken"
                    ]
                },
                {
                    "sense_id": "c9e3bc3c-166b-334d-9e8d-f5562956ca3f",
                    "sense_definition": "Liturgisches Gefäß zur Darreichung des Messweins bei der christlichen Abendmahlsfeier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Priester erhob den reich verzierten <w>Kelch</w> während des Gottesdienstes vor der versammelten Gemeinde."
                        },
                        {
                            "text": "Während der feierlichen Messe reichte der Pfarrer den Gläubigen das Brot und den <w>Kelch</w>."
                        }
                    ],
                    "common_phrases": [
                        "den Kelch segnen"
                    ]
                },
                {
                    "sense_id": "62ff2eb2-4b62-39ed-ae3d-b5c9d7abe66a",
                    "sense_definition": "Äußerer Teil einer Blütenhülle, der aus Kelchblättern besteht und die Knospe umgibt, oder kelchförmiger Teil eines Organs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die grünen Blätter bildeten einen festen <w>Kelch</w> um die noch geschlossene Knospe der Rose."
                        },
                        {
                            "text": "Bei vielen Pflanzenarten schützt der <w>Kelch</w> die empfindlichen inneren Blütenorgane vor Witterungseinflüssen."
                        }
                    ],
                    "common_phrases": [
                        "der Kelch der Blüte"
                    ]
                },
                {
                    "sense_id": "4f6b8486-d5d4-35fd-81fa-dfb6f2255e9e",
                    "sense_definition": "Stärker ausgeprägtes Fettpolster oder Hautfalte unterhalb des Kinns.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nachdem er stark an Gewicht zugenommen hatte, zeichnete sich ein deutlicher <w>Kelch</w> unter seinem Kinn ab."
                        },
                        {
                            "text": "Auf dem unvorteilhaften Porträtfoto stach sein ausgeprägter <w>Kelch</w> sofort ins Auge."
                        }
                    ],
                    "synonyms": [
                        "Doppelkinn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                }
            ]
        }
