                    {
                        "translation_id": "92b934a6-5154-4cb9-97ce-f640f21bdb46",
                        "source_entry_id": "dadc496a-2934-3f1f-a13d-e00acb8d0a9f",
                        "source_sense_id": "e9dcefad-9a6c-3c77-86fc-b4d26742feee",
                        "source_sense_description": "Abgabe einer fachmännischen Beurteilung",
                        "target_lang_word": "évaluation",
                        "target_lang_code": "fr",
