                ],
                "senses": [
                    {
                        "sense_id": "667c69b2-4097-3d40-a4a2-22d7f2db4ba4",
                        "entry_id": "26afb768-2cf8-3a71-a234-0246cebafb50",
                        "glosses": [
                            "Mädchen, das sich Unsinn ausdenkt und vollführt"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d80e75ce-c073-4d11-9d14-31a32a04df3c",
                                "sense_id": "667c69b2-4097-3d40-a4a2-22d7f2db4ba4",
                                "text": "„Die kleine Rackerin erwischen wir! Das würde mir gerade passen, wenn sie uns ausbüxt.“"
                            },
                            {
                                "example_id": "f281b2a0-ec20-4ffe-bfc1-d8c60119d829",
                                "sense_id": "667c69b2-4097-3d40-a4a2-22d7f2db4ba4",
                                "text": "„Er denkt oft an seine Kindheit, als sie noch vier Racker waren, und wünscht sich zu seinem Racker und seiner Rackerin noch zwei Racker, dass die Zahl vier ihm immer in Erinnerung bleibt.“"
                            },
                            {
                                "example_id": "27567bc6-a28a-4945-a5a1-36aff758d668",
                                "sense_id": "667c69b2-4097-3d40-a4a2-22d7f2db4ba4",
                                "text": "„‚Gucci, Gucci, Gucci‘, redeten sie ihrer Tochter den Modenamen einer Luxusmarke so lange ein, bis der kleinen Rackerin endlich eingebimst war, dass sie Gucci heißen sollte. Ein Standesbeamter hat diesen Vornamen jedoch nicht anerkannt.“"
                            },
                            {
                                "example_id": "f183d5bb-f41a-4e8d-903b-4115150a93d9",
                                "sense_id": "667c69b2-4097-3d40-a4a2-22d7f2db4ba4",
                                "text": "„Wenn der Racker oder die Rackerin den Kindle innerhalb dieses Zeitraums crasht, ersetzt ihn Amazon kostenlos und ohne Nachfrage.“"
                            },
                            {
                                "example_id": "a2abc9c9-7888-4c86-a0bf-3219249b27d9",
                                "sense_id": "667c69b2-4097-3d40-a4a2-22d7f2db4ba4",
                                "text": "„Eltern werden auch zum Ausruhen gebraucht, denn manche kleine Rackerin schafft das nicht allein und kann nur mit einem Schoßlied oder einem Bilderbuch innehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
