                        "source_entry_id": "4863d146-81ef-3397-a8ed-25699537dd3a",
                        "source_sense_id": "ab3ec1c5-4657-3bc8-8ba7-9bb8d7f1e9a9",
                        "source_sense_description": "a mineral, calcium titanate",
                        "target_lang_word": "pérovskite",
                        "target_lang_code": "fr",
