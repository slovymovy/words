                {
                    "sense_id": "6c99599f-ef44-3f8e-8f90-3e9140ec0ae6",
                    "sense_definition": "A bout of wild, irrational, or panic-stricken behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When she realized she lost her passport, she had a complete <w>freakout</w>.",
                            "target_lang_translations": {
                                "it": "Quando si è resa conto di aver perso il passaporto, ha avuto una vera e propria <w>crisi di nervi</w>."
                            }
                        },
                        {
                            "text": "Try to remain calm because any sudden <w>freakout</w> will only make the situation worse.",
                            "target_lang_translations": {
                                "it": "Cerca di mantenere la calma, perché qualsiasi improvviso <w>attacco di panico</w> non farà che peggiorare la situazione."
                            }
                        }
                    ],
                    "synonyms": [
                        "meltdown",
                        "tantrum",
                        "panic attack"
                    ],
                    "common_phrases": [
                        "total freakout",
                        "have a freakout"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or slang usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un attacco improvviso di panico, isteria o perdita di controllo emotivo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "crisi di nervi",
                                "target_lang_sense_clarification": "perdita di controllo emotivo o forte agitazione"
                            },
                            {
                                "target_lang_word": "attacco di panico",
                                "target_lang_sense_clarification": "reazione improvvisa di forte paura o ansia"
                            },
                            {
                                "target_lang_word": "scenata",
                                "target_lang_sense_clarification": "sfogo plateale o perdita della calma"
                            },
                            {
                                "target_lang_word": "sbrocco",
                                "target_lang_sense_clarification": "molto informale, perdita totale della calma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c66b2a0e-52a3-3f58-851f-936cff683f44",
                    "sense_definition": "A frightening, disorienting, or hallucinatory experience, especially caused by drugs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffered a terrifying <w>freakout</w> after taking unknown substances at the party.",
                            "target_lang_translations": {
                                "it": "Ha avuto un terrificante <w>brutto viaggio</w> dopo aver assunto sostanze sconosciute alla festa."
                            }
                        },
                        {
                            "text": "His friends stayed by his side until the drug-induced <w>freakout</w> finally passed.",
                            "target_lang_translations": {
                                "it": "I suoi amici gli sono rimasti accanto finché il <w>bad trip</w> indotto dalle droghe non è finalmente passato."
                            }
                        }
                    ],
                    "synonyms": [
                        "bad trip"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture slang"
                        }
                    ],
                    "target_lang_definitions": {
