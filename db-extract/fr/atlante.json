            {
                "entry_id": "af1e8c5f-60ef-38f3-badb-18b54e7b516f",
                "word": "atlante",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c5b5938-5ee9-40bd-92ce-0499b78300bc",
                        "entry_id": "af1e8c5f-60ef-38f3-badb-18b54e7b516f",
                        "tags": [
                            "plural"
                        ],
                        "form": "atlantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                        "entry_id": "af1e8c5f-60ef-38f3-badb-18b54e7b516f",
                        "glosses": [
                            "Figure d’homme (statue ou buste) qui soutient sur le cou et les épaules une corniche, une tribune, etc."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1a5ab8-03c0-4d81-b756-58c98c98e477",
                                "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                "text": "Louis XlV prouva l’estime qu’il réservait au maître de Toulon, à ce “bûcheur”, qui, avant d’orner ses parcs, avait décoré ses vaisseaux, dans l’orme et le tilleul, de tant d’atlantes, de tritons et de gigantes."
                            },
                            {
                                "example_id": "47d55a96-bdd2-4c67-8b0e-5606e017cbcd",
                                "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                "text": "De chacune des colonnes qui séparent les loges jaillit un atlante ou une cariatide, superbe échantillon de sculpture sur bois."
                            },
                            {
                                "example_id": "da9ee365-a6e1-48e9-a1e8-39cbea920a08",
                                "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                "text": "Un balcon soutenu par quatre atlantes."
                            }
                        ]
                    }
                ],
