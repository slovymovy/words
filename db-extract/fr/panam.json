                        ],
                        "examples": [
                            {
                                "example_id": "3d1d33c4-afa5-42a0-b25d-dd68d22cecbb",
                                "sense_id": "6ba47c44-1900-3a5c-a809-4889fe3935df",
                                "text": "Chez les Québécois à l’œuvre en cette première des 16 journées de compétition aux Jeux panam, Jocelyn Addison a été confronté à un défi de taille chez les 58 kg en taekwondo."
                            },
                            {
                                "example_id": "aad02719-2fb7-436e-a1b8-aa62d22099a1",
                                "sense_id": "6ba47c44-1900-3a5c-a809-4889fe3935df",
                                "text": "Les parties de la ronde préliminaire de la Coupe Panam se poursuivent aujourd’hui et demain, mais les Canadiens ne seront de retour en action que mercredi soir à 20 h, contre la République dominicaine."
                            },
                            {
                                "example_id": "a1ce9be3-7797-4216-805d-6b750342a41a",
                                "sense_id": "6ba47c44-1900-3a5c-a809-4889fe3935df",
                                "text": "« Même si nous n’avons aucune idée du calibre des athlètes des autres provinces canadiennes, l’objectif de Danielle est de se qualifier pour le championnat “panam” », a indiqué son entraîneur, Gilles Lachaîne, du Club de judo de Terrebonne."
                            }
                        ]
                    }
                ],
