                                "example_id": "2fc1bc6c-674d-43d8-8844-d6864b0c9916",
                                "sense_id": "a31828bc-cabf-394b-ab29-ad07ff0c33ff",
                                "text": "Sir Olof, he rode out at early day, / And so came he unto an Elve-dance gay."
                            },
                            {
                                "example_id": "e5340eb5-3b26-4642-bf56-54a662162760",
                                "sense_id": "a31828bc-cabf-394b-ab29-ad07ff0c33ff",
                                "text": "Is it the offspring of thoughtless animal spirits, or the elve of fancy continually flitting round the expected pleasure?"
                            }
                        ]
                    }
