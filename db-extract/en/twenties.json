                                "sense_id": "58f360a4-362e-393f-841e-4551713f24c2",
                                "text": "My roommates said they were hosting a party inspired by the twenties which I assumed meant the 1920s but it turned out the theme was the 1120s BCE."
                            }
                        ]
                    },
                    {
                        "sense_id": "b659e92d-c653-3ad0-9a04-b0b8caeab5ec",
                        "entry_id": "a0646b08-0748-3ff2-b8e8-65b35de2c7aa",
                        "glosses": [
                            "The decade of one's life from age 20 through age 29."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "8ef6abb6-6d9d-4ebe-b2f1-4761351e0990",
                                "sense_id": "b659e92d-c653-3ad0-9a04-b0b8caeab5ec",
                                "text": "1954 \"The Fellowship of the Ring\", J.R.R. Tolkien\nAt that time Frodo was still in his tweens, as the hobbits called the irresponsible twenties between childhood and coming of age at thirty-three."
                            },
                            {
                                "example_id": "66b2b0ec-114f-4043-b422-6ab7caaee6c2",
                                "sense_id": "b659e92d-c653-3ad0-9a04-b0b8caeab5ec",
                                "text": "The waiter was in his twenties."
                            }
                        ]
                    },
                    {
                        "sense_id": "d595c822-1a48-379e-82d9-b14d87e82b70",
                        "entry_id": "a0646b08-0748-3ff2-b8e8-65b35de2c7aa",
                        "glosses": [
                            "The range between 20 and 29."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6a4fe6-2bf9-410b-ba16-4108446d0b68",
                                "sense_id": "d595c822-1a48-379e-82d9-b14d87e82b70",
                                "text": "She shivered; twenties by the water felt different than twenties in the mountains."
                            }
                        ]
                    }
