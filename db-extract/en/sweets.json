                            {
                                "example_id": "f75c2fe9-64d8-4b77-b470-0a293f348606",
                                "sense_id": "fb9c44cd-1366-335f-b652-a68a4ce1cc29",
                                "text": "Sweets to the sweet! Farewell.\nShe scatters flowers"
                            },
                            {
                                "example_id": "f1f1cb19-e543-45ab-9870-b063cdf2dabe",
                                "sense_id": "fb9c44cd-1366-335f-b652-a68a4ce1cc29",
                                "text": "...she dropped the flowers which Evelyn had given her. Before she even perceived her loss, the King had picked them up, and was about to give them to her, when he perceived the note, and also observed that the seal was yet unbroken. \"Mademoiselle has not had time to read a letter so surrounded by sweets—pray use no ceremony.\""
                            }
                        ]
