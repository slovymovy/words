                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b789d9-6e7c-41a9-8a20-855c7ff4bdf9",
                                "sense_id": "8dc8f66c-9187-3b7a-ab96-08a24c0a883b",
                                "text": "La squelettologie, ainsi que le nom l’indique, est la partie de l’anatomie qui a pour objet l’étude, la connaissance, l’exposition ou description du squelette."
                            },
                            {
                                "example_id": "eddd402e-97f3-46ac-a1cd-e7a1a419de81",
                                "sense_id": "8dc8f66c-9187-3b7a-ab96-08a24c0a883b",
                                "text": "M. Broca voudrait-il que nos ressources nous permissent de séparer la craniologie et plus généralement la squelettologie, parce que l’étude du crâne, comme celle des os du squelette, a sa méthode, ses instruments particuliers."
                            }
                        ]
