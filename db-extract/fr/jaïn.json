                                    {
                                        "sense_id": "b5824568-b39f-33c0-966b-244d76c8bafb",
                                        "entry_id": "f628f351-5b58-3761-8e25-b6b8c1bb7d49",
                                        "glosses": [
                                            "An adherent or follower of Jainism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a159a9-787f-4d0f-8365-6f31a47502c1",
                                                "sense_id": "b5824568-b39f-33c0-966b-244d76c8bafb",
                                                "text": "Donovan, The Universal Soldier\nHe's a Catholic, a Hindu, an atheist, a Jain,\nA Buddhist and a Baptist and a Jew,\nAnd he knows he shouldn't kill,\nAnd he knows he always will"
                                            },
                                            {
                                                "example_id": "969a72fe-7245-45d6-95b8-b7270dfcdca6",
                                                "sense_id": "b5824568-b39f-33c0-966b-244d76c8bafb",
                                                "text": "While Diwali is a major religious festival for Hindus, it is also observed by Sikhs, Jains and Buddhists."
                                            }
                                        ]
                                    }
                                ]
                            },
