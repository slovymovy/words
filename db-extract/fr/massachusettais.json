                                "target_senses": [
                                    {
                                        "sense_id": "97ef7c79-a16b-356d-b5fd-e2858de8ddc3",
                                        "entry_id": "1928e6e3-393b-3051-b342-08bebcde7d3b",
                                        "glosses": [
                                            "A native or resident of Massachusetts."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1dce3f9-5b37-4fda-9e2a-7f163b0cf18e",
                                                "sense_id": "97ef7c79-a16b-356d-b5fd-e2858de8ddc3",
                                                "text": "That he was a Virginian and I a Massachusettsian."
                                            },
                                            {
                                                "example_id": "b25e8384-1e58-4c8a-bf67-c58c81eec287",
                                                "sense_id": "97ef7c79-a16b-356d-b5fd-e2858de8ddc3",
                                                "text": "A young Massachusettsian (is this correct orthography?), by name Nathaniel II. Bishop, a mere lad of seventeen, who, prompted by a love of nature, starts off from his New England home, reaches the La Plata River, and coolly \"walks\" to Valparaiso, across pampa and cordillera, a distance of more than a thousand miles !"
                                            },
                                            {
                                                "example_id": "f12198c8-f09c-41d7-98e8-8bd4ece57be9",
                                                "sense_id": "97ef7c79-a16b-356d-b5fd-e2858de8ddc3",
                                                "text": "Chadwick (54), though a Massachusettsian by birth, residence, and position is not so by preordination. He has a directness of thought, a humour, and a power of seeing himself as others see him that smack more of London or Paris than of Boston."
                                            },
                                            {
                                                "example_id": "c11d6840-bb2c-48b8-806d-93a339ca3c16",
                                                "sense_id": "97ef7c79-a16b-356d-b5fd-e2858de8ddc3",
                                                "text": "Much to the chagrin of many a Massachusettsian, on January 29, 1 842, Secretary of State Daniel Webster dispatched directions to the US ambassador to Great Britain in support of Calhoun's resolutions."
                                            },
                                            {
                                                "example_id": "c1131cfa-05ab-4f99-b2b5-7b9dafa0792c",
                                                "sense_id": "97ef7c79-a16b-356d-b5fd-e2858de8ddc3",
                                                "text": "The minor appointments were the Virginian Edmund Randolph as attorney general and the Massachusettsian Henry Knox as secretary of war."
                                            }
                                        ]
                                    }
                                ]
