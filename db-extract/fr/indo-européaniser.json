                        "glosses": [
                            "Prendre un caractère indo-européen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337bad33-7182-4494-903c-6ac7bc989601",
                                "sense_id": "03324303-3fee-33ab-a681-6c983df1c0ab",
                                "text": "Tout vocable a pu s’indo-européaniser, comme tout peut se latiniser."
                            },
                            {
                                "example_id": "af296828-f875-480c-865d-dad2fd9e32c8",
                                "sense_id": "03324303-3fee-33ab-a681-6c983df1c0ab",
                                "text": "Un autre type mésaticéphale que Schuchhardt appelle type de Bôssen, aurait contribué en même temps et plus énergiquement que les hommes de la Thuringe à indo-européaniser les territoires au sud-ouest déjà occupés par la race alpine (Ligures!) et les pays du sud-est déjà occupés par une autre race brachycéphale."
                            }
                        ]
                    }
