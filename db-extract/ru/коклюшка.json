                        "target_lang_word": "Klöppel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klöppel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a556ee2-c0a3-3c2b-abc2-1492cbb2416e",
                                        "entry_id": "3539adc8-6b29-3429-891b-f94ff1818132",
                                        "glosses": [
                                            "in eine Glocke gehängter am Ende verdickter Eisenstab, der beim Schwingen den Schlagring in der Glocke berührt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6883d2-0955-41ee-ac92-6f3acb6c14dd",
                                                "sense_id": "2a556ee2-c0a3-3c2b-abc2-1492cbb2416e",
                                                "text": "Der Klöppel der Glocke musste repariert werden."
                                            },
                                            {
                                                "example_id": "062fe8ed-b594-4213-a35e-f1f819368851",
                                                "sense_id": "2a556ee2-c0a3-3c2b-abc2-1492cbb2416e",
                                                "text": "„Der Klöppel des Glöckchens war festgebunden, die Schellen mit Papier umwickelt; der Fürst gestattete in Lysyja Gory niemandem, mit Glöckchengeläut und Schellengeklingel zu fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b18ee03-b11c-36bb-86fe-91018d6a4bf3",
                                        "entry_id": "3539adc8-6b29-3429-891b-f94ff1818132",
                                        "glosses": [
                                            "leichter Schlägel aus Holz für bestimmte Schlaginstrumente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d02815bc-e5ba-4c60-b9ee-f4b51d1899f9",
                                                "sense_id": "2b18ee03-b11c-36bb-86fe-91018d6a4bf3",
                                                "text": "Sie nahm die Klöppel in die Hand und legte los."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d8d4221d-30c6-3f44-8644-9109855ed83d",
                                        "entry_id": "3539adc8-6b29-3429-891b-f94ff1818132",
                                        "glosses": [
                                            "Hammer der Klaviermechanik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1dd1733-f9fb-4c8e-b97a-db0b202e0986",
                                                "sense_id": "d8d4221d-30c6-3f44-8644-9109855ed83d",
                                                "text": "Wenn man ein Klavier stimmt, werden alle Klöppel überprüft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b22a38c0-6231-3c78-bda8-f1fb9c0a38ff",
                                        "entry_id": "3539adc8-6b29-3429-891b-f94ff1818132",
                                        "glosses": [
                                            "Spule aus Holz zum Klöppeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea63c0f-d896-45e8-ad19-5f358e8a53d7",
                                                "sense_id": "b22a38c0-6231-3c78-bda8-f1fb9c0a38ff",
                                                "text": "Auf den Klöppel wird das Garn gewickelt."
                                            },
                                            {
                                                "example_id": "9cc24c51-24cf-468c-9564-4bb835e76782",
                                                "sense_id": "b22a38c0-6231-3c78-bda8-f1fb9c0a38ff",
                                                "text": "„Unter ihren Fingern ordneten sich die Klöppel mit dem Klappern von Kastagnetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b8310c5-2393-45b0-bc58-9a8779ae43d3",
                        "source_entry_id": "72ef827c-79c1-3558-a929-975b29296a18",
                        "source_sense_id": "26fc304b-ca3d-3742-b944-1d1fd169e173",
                        "target_lang_word": "fuseau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuseau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aafe40a2-4c45-364d-829c-0cf44f450454",
                                        "entry_id": "9cd1e0ae-73b7-3dcf-b8d3-d5133e328754",
                                        "glosses": [
                                            "Petite tige de bois renflée en son milieu, pointu à un bout et arrondi à l’autre et dont on se sert pour filer à la quenouille et tordre le fil, afin de le rouler à mesure qu’il se forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332827c2-a153-4a79-9b1d-16ce57c064cb",
                                                "sense_id": "aafe40a2-4c45-364d-829c-0cf44f450454",
                                                "text": "Tourner, remplir, vider le fuseau."
                                            },
                                            {
                                                "example_id": "b3ef35df-6237-4f76-82bd-6bbf755a96f9",
                                                "sense_id": "aafe40a2-4c45-364d-829c-0cf44f450454",
                                                "text": "Le fuseau des Parques, se dit poétiquement parce que, selon la fable, les Parques filaient la vie des hommes."
                                            },
                                            {
                                                "example_id": "545169dc-78e5-4921-8fd4-c9a0b1531493",
                                                "sense_id": "aafe40a2-4c45-364d-829c-0cf44f450454",
                                                "text": "Sa quenouille était encore attachée à son côté ; son fuseau avait roulé à terre, et le fil était rompu. Sa belle tête s’était penchée contre le rocher, et le chanvre de sa quenouille servait d’oreiller à sa joue candide. Elle était assise dans l’attitude la plus chaste, et sa main droite, pendante à son côté, avait, de temps à autre, le mouvement machinal, mais faible, de faire pirouetter le fuseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d81376-7da0-3c04-8dbb-cea7fc09fa36",
                                        "entry_id": "9cd1e0ae-73b7-3dcf-b8d3-d5133e328754",
                                        "glosses": [
                                            "Petite broche où est enroulé le fil pour faire la dentelle."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b09acbc-ecec-4f6e-b8e3-dfd0efe505d0",
                                                "sense_id": "b0d81376-7da0-3c04-8dbb-cea7fc09fa36",
                                                "text": "Déjà levée depuis longtemps, elle agitait les fuseaux de sa dentelle, qui claquaient avec un doux bruit sur le carreau vert que soutenaient ses genoux."
                                            },
                                            {
                                                "example_id": "faf70fe1-e689-4ffc-a3da-469e10efaa56",
                                                "sense_id": "b0d81376-7da0-3c04-8dbb-cea7fc09fa36",
                                                "text": "Ici, c’est le quartier des dentellières […] ; elles font marcher leurs langues tout autant, sinon plus, que leurs fuseaux : c’est un papotage sans fin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66691ff-da55-3f8b-9d9a-7120772dd73f",
                                        "entry_id": "9cd1e0ae-73b7-3dcf-b8d3-d5133e328754",
                                        "glosses": [
                                            "Chose fusiforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98283b87-c62f-4cb9-a650-56530082e915",
                                                "sense_id": "c66691ff-da55-3f8b-9d9a-7120772dd73f",
                                                "text": "Des jambes de fuseau, en fuseau, jambe menue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781d949d-688e-3ba2-b326-6b7366f8671b",
