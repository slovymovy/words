                ],
                "senses": [
                    {
                        "sense_id": "de67ea46-b40b-3540-9a08-8c59e65e2cc4",
                        "entry_id": "e02cdf39-b11a-3378-a05d-70a1b2b3621c",
                        "glosses": [
                            "Laufen/Joggen an einem Sonntag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "c9044efa-43b3-40e2-a8a4-27c3d5441baf",
                                "sense_id": "de67ea46-b40b-3540-9a08-8c59e65e2cc4",
                                "text": "„Nach 14 für einen ‚ruhigen‘ Sonntagslauf recht flotten Kilometern kamen wir beim Treffpunkt an und liefen zusammen mit Andreas V., Monika und Eyyüp weiter.“"
                            },
                            {
                                "example_id": "612625af-4a06-4cef-ada7-20eb7cdca9a0",
                                "sense_id": "de67ea46-b40b-3540-9a08-8c59e65e2cc4",
                                "text": "„Die Schnellzusammenfassung ist, dass wir von diesem Sonntagslauf an weiter regelmäßig gelaufen sind, zunächst ohne den Marathon als Ziel noch mal zu erwähnen.“"
                            },
                            {
                                "example_id": "915f4f27-3f4d-456c-9f04-6d125b39682e",
                                "sense_id": "de67ea46-b40b-3540-9a08-8c59e65e2cc4",
                                "text": "„Dank langer Sonntagsläufe mit Heinz und Stephanie und eines steifen Intervall Trainings durch Stefan waren wir pünktlich zur Abreise nach Berlin perfekt vorbereitet.“"
                            },
                            {
                                "example_id": "1ccbee79-8c2c-481a-b648-de69188e1791",
                                "sense_id": "de67ea46-b40b-3540-9a08-8c59e65e2cc4",
                                "text": "„Die LDL-Sonntagsläufe sind eine unverzichtbare Einheit für jeden Läufer und machen in der Gruppe großen Spaß. 😊 Es wird auf überwiegend flachen Routen 75 – 90 – 120 Minuten in einem moderaten Tempo gelaufen.“"
                            },
                            {
                                "example_id": "9985582a-167d-4d77-a6ca-156dce7e661b",
                                "sense_id": "de67ea46-b40b-3540-9a08-8c59e65e2cc4",
                                "text": "„Hallo liebe Läuferinnen und Läufer, ich werde auch im Winter die Tradition der Sonntagsläufe beibehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5563754-0ac0-3f29-a816-6e4f79d6279d",
                        "entry_id": "e02cdf39-b11a-3378-a05d-70a1b2b3621c",
                        "glosses": [
                            "Wettrennen, das am Sonntag stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c731b7f7-a0e2-4e2a-baf6-a44f14b6e7a7",
                                "sense_id": "d5563754-0ac0-3f29-a816-6e4f79d6279d",
                                "text": "„Das junge Fahrer-Duo hat auch den Sonntagslauf auf dem Red Bull Ring gewonnen und übernahm damit die Tabellenführung im ADAC GT Masters.“"
                            },
                            {
                                "example_id": "86687ced-f148-4b3c-85e2-653079fadfe6",
                                "sense_id": "d5563754-0ac0-3f29-a816-6e4f79d6279d",
                                "text": "„Brands Hatch war ein schwieriges Wochenende für Dinamic Motorsport, da beide Porsche in den Sonntagsläufen in Zwischenfälle verwickelt wurden.“"
                            },
                            {
                                "example_id": "74d72786-f796-48bb-8063-e19517a1521a",
                                "sense_id": "d5563754-0ac0-3f29-a816-6e4f79d6279d",
                                "text": "„Nach dem Unfall im ersten Rennen musste ich den Sonntagslauf auf Anweisung der Ärzte ausfallen lassen.“"
                            },
                            {
                                "example_id": "a1c92c18-605f-4725-a0a2-6b029fc7560c",
                                "sense_id": "d5563754-0ac0-3f29-a816-6e4f79d6279d",
                                "text": "„Im Sonntagslauf fügten Mies und Feller ihrer Erfolgsstatistik einen fünften Platz hinzu und verteidigten somit ihre Führung in der Tabelle.“"
                            },
                            {
                                "example_id": "b3756b9f-6dc0-410b-be24-6030e1136ab8",
                                "sense_id": "d5563754-0ac0-3f29-a816-6e4f79d6279d",
                                "text": "„Den gleichen Kampfgeist bewiesen auch Christopher Haase und Luci Trefz im Schwesterfahrzeug #28. Nachdem die beiden Piloten in der MANN-FILTER Mamba am Samstag noch leer ausgingen, sollte es im Sonntagslauf wieder in die Punkte gehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
