                    {
                        "translation_id": "67d985f5-13c1-4c4c-b503-1d2f08bea01d",
                        "source_entry_id": "029bb350-e5e0-37c2-b0e7-e59bf6de9640",
                        "source_sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
