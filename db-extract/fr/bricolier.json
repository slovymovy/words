                "word": "bricolier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7fb46c4a-4515-428f-a4c0-5c9be7c26106",
                        "entry_id": "40acc82c-82e2-32b2-88b1-f7be8d7c35d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "bricoliers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "752e45dd-27b9-35a3-8bac-a9285b0a267c",
                        "entry_id": "40acc82c-82e2-32b2-88b1-f7be8d7c35d1",
                        "glosses": [
                            "Cheval attelé à côté du cheval brancardier et qui porte la bricole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761ea7e2-5997-4b09-9370-8a61a3577367",
                                "sense_id": "752e45dd-27b9-35a3-8bac-a9285b0a267c",
                                "text": "Ce finaud faisait semblant de tirer, tandis que le limonier, un bai, et le bricolier de gauche, un alezan clair surnommé L’Assesseur, parce qu’il provenait de l’un de ces honorables fonctionnaires, y allaient de tout leur cœur : on lisait dans leurs yeux le plaisir qu’ils éprouvaient."
                            },
                            {
                                "example_id": "b5e46112-766a-4e49-9ec0-6709fb16a9b9",
                                "sense_id": "752e45dd-27b9-35a3-8bac-a9285b0a267c",
                                "text": "Voyant que rien n’y faisait, le père Minaï prit le père Mitiaï en croupe, tandis qu’Andriouchka montait sur le bricolier."
                            }
                        ]
                    },
                    {
                        "sense_id": "b55af244-221d-37bf-bf0c-e1d9091aafd6",
                        "entry_id": "40acc82c-82e2-32b2-88b1-f7be8d7c35d1",
                        "glosses": [
                            "Homme se proposant pour des travaux ponctuels de bricolage ou d’appoint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b979ee7b-78bc-46ec-9730-74f06bdf7e57",
                                "sense_id": "b55af244-221d-37bf-bf0c-e1d9091aafd6",
                                "text": "Des bricoliers se proposaient de fournir ceux qui n’avaient pas la possibilité de le couper eux-mêmes, veuves, instituteur, curé & autres impotents."
                            }
                        ]
                    }
