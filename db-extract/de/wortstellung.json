                "senses": [
                    {
                        "sense_id": "574e760a-5a4f-329c-bffe-5e3a2379dbc9",
                        "entry_id": "11ed2a65-6794-38ce-be36-223273eabc6f",
                        "glosses": [
                            "Die syntaktisch korrekte Platzierung (Stellung) der Wörter in einem Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0ceddc-8b2d-43e8-baa9-8ec9b56babd2",
                                "sense_id": "574e760a-5a4f-329c-bffe-5e3a2379dbc9",
                                "text": "In einem Satz wie \"Der Junge kleine ist krank.\" wäre die Wortstellung des Adjektivs \"kleine\" falsch."
                            },
                            {
                                "example_id": "a4e851e4-1a32-4b20-b9bb-b615309ac0e2",
                                "sense_id": "574e760a-5a4f-329c-bffe-5e3a2379dbc9",
                                "text": "„Den Einfluß der Wortstellung und eines Faktors wie Bejahung/ Verneinung auf die Wahl des Kasus beim Prädikatsnomen (…) untersucht HENTSCHEL (1992b).“"
                            }
                        ],
