                        "entry_id": "78f4708d-88f9-3fb2-a210-d07f4f8f7075",
                        "glosses": [
                            "Celle qui appartient au service d’une ambulance militaire ou civile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45050d4-1fb9-4b13-9591-9bb6dd42fb69",
                                "sense_id": "013c5101-7865-314d-be46-fcbe6becdc2c",
                                "text": "Arrivé sur les lieux de l’accident, le policier a appris par l’ambulancière que l’accusé était rentré chez lui et qu’elle l’avait suivi."
                            }
                        ]
                    },
                    {
