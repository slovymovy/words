                "senses": [
                    {
                        "sense_id": "058c9c2a-d4ba-3a1a-982e-10ea7edc1d6b",
                        "entry_id": "393d4340-ecd4-3c57-af69-a186d8724960",
                        "glosses": [
                            "Banlieue, faubourg."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "6e70d121-6749-4489-8078-be71511789a4",
                                "sense_id": "058c9c2a-d4ba-3a1a-982e-10ea7edc1d6b",
                                "text": "Ich wohne in einem seelenlosen Vorort.",
                                "translation": "J'habite dans une banlieue sans âme."
                            },
                            {
                                "example_id": "408253df-5798-4116-8da3-afd8dd01788e",
                                "sense_id": "058c9c2a-d4ba-3a1a-982e-10ea7edc1d6b",
                                "text": "Er hatte den Alten untersucht und saß jetzt mitten in diesem ärmlichen Esszimmer. Ja, er hatte Angst. Er wusste, dass ihn am nächsten Morgen in ebendieser Vorstadt ein Dutzend über ihren Beulen zusammengekrümmte Kranke erwarten würden.",
                                "translation": "Il avait examiné le vieux et maintenant il était assis au milieu de cette salle à manger misérable. Oui, il avait peur. Il savait que dans le faubourg même une dizaine de malades l’attendraient, le lendemain matin, courbés sur leurs bubons."
                            }
                        ]
                    }
                ],
