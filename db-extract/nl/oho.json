                    },
                    {
                        "sense_id": "d3c779fe-5a17-3900-bdc7-631753db0829",
                        "entry_id": "f08d603e-7bba-3355-8530-3af63a211265",
                        "glosses": [
                            "uitroep als een ander regels overtreedt"
