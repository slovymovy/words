                "forms": [],
                "senses": [
                    {
                        "sense_id": "5367618e-78dd-3412-8541-579878c36692",
                        "entry_id": "0eadb590-2f81-3e9d-9927-ced3cd87e628",
                        "glosses": [
                            "Indique la temporalité, l’action de la principale se déroule chaque fois qu’intervient celle de la subordonnée = immer wenn, jedes Mal wenn - Lorsque, quand, toutes les fois que."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324f7ee3-ebc9-47c0-b750-ee0a905cc865",
                                "sense_id": "5367618e-78dd-3412-8541-579878c36692",
                                "text": "Sooft ich ihm begegne, grüßt er mich freundlich. - Chaque fois que je le rencontre, il me salue aimablement."
                            },
                            {
                                "example_id": "12e6ac60-2d10-441b-8135-5285b467752e",
                                "sense_id": "5367618e-78dd-3412-8541-579878c36692",
                                "text": "Ich besuche dich, sooft du es wünschst. - J’irai te voir toutes les fois que tu le désireras."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
