                "senses": [
                    {
                        "sense_id": "816e0ad2-8056-3b75-a2db-85a125f6b40e",
                        "entry_id": "e5134cf2-cd3e-3c4b-9463-68834e01ef94",
                        "glosses": [
                            "Bécoter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134302d3-f524-46b5-ac52-1b62cdb82ea8",
                                "sense_id": "816e0ad2-8056-3b75-a2db-85a125f6b40e",
                                "text": "On voit, en enfilade, du trottoir jusqu’au fond des brasseries, des commères en cheveux, soutenant, sur leurs gros bras nus, un marmot tôt éveillé, tôt rendormi ; puis des garçons et des filles essoufflés par la danse, qui se bécotent et rebécotent, par-dessus leurs chopes, en haletant."
                            },
                            {
                                "example_id": "48252503-b266-45f5-92f2-52c502913b24",
                                "sense_id": "816e0ad2-8056-3b75-a2db-85a125f6b40e",
                                "text": "Arriver au foyer, s'expliquer, s'excuser. Et se rebécoter."
                            }
                        ]
                    }
