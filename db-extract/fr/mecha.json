            {
                "entry_id": "bdd4bf1a-9fd7-32fe-a3bb-08bb8b0e2460",
                "word": "mecha",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e6e7e4c-3aba-4837-9680-5ab676bc421c",
                        "entry_id": "bdd4bf1a-9fd7-32fe-a3bb-08bb8b0e2460",
                        "tags": [
                            "plural"
                        ],
                        "form": "mechas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad888433-60a9-3c55-b93c-386a27400e6f",
                        "entry_id": "bdd4bf1a-9fd7-32fe-a3bb-08bb8b0e2460",
                        "glosses": [
                            "Thème de science-fiction, mettant en scène des personnages utilisant ou incarnant des armures robotisées, généralement de forme humanoïde."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "d907a9c8-18d9-423a-8312-1ad14d68dcad",
                                "sense_id": "ad888433-60a9-3c55-b93c-386a27400e6f",
                                "text": "[…] l’auteur mêle ici avec brio l’univers des mechas japonais à l’ambiance d’Alien de Ridley Scott."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ff56fc-bfc1-39bd-8a4e-89787e3ac39c",
                        "entry_id": "bdd4bf1a-9fd7-32fe-a3bb-08bb8b0e2460",
                        "glosses": [
                            "Armure sophistiquée, ou robot en tant que tel dont la fonction principale est généralement le combat."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "92cbb66e-7123-41ee-84a2-e0e1771d180e",
                                "sense_id": "19ff56fc-bfc1-39bd-8a4e-89787e3ac39c",
                                "text": "Dans l’univers des mangas, sont également hybrides les nombreux robots : mecha — robots animés —, cyborgs et autres « transhumains » aux formes fragiles transformés en corps puissants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0975290f-5ba5-4afc-805b-095a875fcb57",
                        "source_entry_id": "bdd4bf1a-9fd7-32fe-a3bb-08bb8b0e2460",
                        "source_sense_id": "ad888433-60a9-3c55-b93c-386a27400e6f",
                        "source_sense_description": "Genre",
                        "target_lang_word": "Mech",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "01cb7283-d73e-4efe-b013-85d12e94e79e",
                        "source_entry_id": "bdd4bf1a-9fd7-32fe-a3bb-08bb8b0e2460",
                        "source_sense_id": "ad888433-60a9-3c55-b93c-386a27400e6f",
