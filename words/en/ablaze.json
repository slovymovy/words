    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26895063-5888-3d5c-9851-0081a7c9148a",
                    "sense_definition": "Burning fiercely; brightly on fire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Firefighters arrived quickly because the old warehouse was already <w>ablaze</w>.",
                            "target_lang_translations": {
                                "ru": "Пожарные прибыли быстро, потому что старый склад был уже <w>охвачен пламенем</w>."
                            }
                        },
                        {
                            "text": "The dry grass caught fire quickly, leaving the entire field <w>ablaze</w>.",
                            "target_lang_translations": {
                                "ru": "Сухая трава быстро загорелась, и вскоре всё поле было <w>в огне</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afire",
                        "aflame"
                    ],
                    "common_phrases": [
                        "set ablaze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объятый пламенем, ярко горящий сильным огнём."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пылающий",
                                "target_lang_sense_clarification": "объятый ярким пламенем"
                            },
                            {
                                "target_lang_word": "горящий",
                                "target_lang_sense_clarification": "находящийся в огне"
                            },
                            {
                                "target_lang_word": "в огне",
                                "target_lang_sense_clarification": "охваченный пожаром"
                            }
                        ]
