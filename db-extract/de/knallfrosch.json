                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c68c504b-3879-3b45-b8d0-45486f2e609a",
                                        "entry_id": "050a5af1-0e31-363c-bbd4-56c604a2c9c7",
                                        "glosses": [
                                            "An individual who is quick-tempered, rambunctious, or unpredictable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0605314-597f-4ad2-84df-65cf5d4853bf",
                                                "sense_id": "c68c504b-3879-3b45-b8d0-45486f2e609a",
                                                "text": "Jude Bellingham became the nation’s second youngest World Cup scorer behind Michael Owen when he started the rout – the centrepiece of a performance of power, skill and precision – while Bukayo Saka deserved his two goals, the first a firecracker, as he radiated menace with his every involvement."
                                            }
