                {
                    "sense_id": "6356b334-dd72-363a-9f7c-d77afc67846f",
                    "sense_definition": "Pièce de bois ou de plastique de forme allongée que l'on dresse sur le sol et que l'on tente de renverser avec une boule.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a réussi à faire tomber chaque <w>quille</w> avec son premier lancer."
                        },
                        {
                            "text": "Les joueurs installent les <w>quilles</w> avec soin avant de commencer la partie."
                        }
                    ],
                    "common_phrases": [
