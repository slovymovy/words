                "senses": [
                    {
                        "sense_id": "f68a4db2-5f95-3060-b661-b7510fa58d7e",
                        "entry_id": "33d7894c-ca60-39cc-bc95-805a6f57db82",
                        "glosses": [
                            "miejsce zamieszkane, siedziba"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "df6007d2-7b0f-3722-a930-23e62c0d5b33",
                        "entry_id": "33d7894c-ca60-39cc-bc95-805a6f57db82",
                        "glosses": [
                            "prymitywny budynek znajdujący się na odludziu, odosobnione domostwo"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "75c9037d-2ce9-46a7-9542-74873c98c6cb",
                                "sense_id": "df6007d2-7b0f-3722-a930-23e62c0d5b33",
                                "text": "Sadyba Dutkowskiego była to na pozór zwykła chata kmieca słomą poszyta, wapnem obielona, o małych oknach, pęcherzami zaciągniętych, sieni długiej a wąskiej, dzielącej ją na dwie części"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a2a9cc5-7b08-4d90-a213-fe6cc40ed03b",
                        "source_entry_id": "33d7894c-ca60-39cc-bc95-805a6f57db82",
                        "source_sense_id": "f68a4db2-5f95-3060-b661-b7510fa58d7e",
                        "target_lang_word": "усадьба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "усадьба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "418f5f01-7ddd-3387-b85c-26089fb69bb0",
                                        "entry_id": "0b359349-45dc-3400-8bc8-835a97cf76a0",
                                        "glosses": [
                                            "совокупность строений (включая жилой дом, надворные постройки) и примыкающих угодий (сада, огорода и т. п.), представляющих отдельное хозяйство (преимущественно в сельской местности)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45cc7a2f-7caf-3312-9f44-17b6d314312a",
                                        "entry_id": "0b359349-45dc-3400-8bc8-835a97cf76a0",
                                        "glosses": [
                                            "истор. помещичий дом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ed22b0-f0cb-4be5-b1d9-b86038dd48a2",
                                                "sense_id": "45cc7a2f-7caf-3312-9f44-17b6d314312a",
                                                "text": "Около господской усадьбы, стоявшей к улице задом, происходило, что́ обыкновенно происходит около господских усадеб: девки в полинялых ситцевых платьях шныряли взад и вперёд; дворовы́е люди брели по грязи, останавливались и задумчиво чесали свои спи́ны; привязанная лошадь десятского лениво махала хвостом и, высоко задравши морду, глодала забор; курицы кудахтали; чахоточные индейки беспрестанно перекликивались."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dbdd7b5-52a9-353a-ab9f-bcfdf9d082a0",
                                        "entry_id": "0b359349-45dc-3400-8bc8-835a97cf76a0",
                                        "glosses": [
                                            "с.-х. посёлок, место, где расположены жилые дома и хозяйственные постройки совхоза, колхоза и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b758f5-756d-4cf6-86c2-29f48ac99188",
                                                "sense_id": "4dbdd7b5-52a9-353a-ab9f-bcfdf9d082a0",
                                                "text": "Энергетики разместились в палаточном городке, остальные ребята — в деревне, где находилась центральная усадьба совхоза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ace2ecd9-bc15-3e67-a043-b582514458a2",
                                        "entry_id": "0b359349-45dc-3400-8bc8-835a97cf76a0",
                                        "glosses": [
                                            "земельный участок отдельного хозяйства"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b26850a8-bf41-3a4a-9914-f938c71bb3ae",
                                        "entry_id": "0b359349-45dc-3400-8bc8-835a97cf76a0",
                                        "glosses": [
                                            "земельный участок около до́ма, занятый садом, огородом и т. п."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
