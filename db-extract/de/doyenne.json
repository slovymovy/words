                "senses": [
                    {
                        "sense_id": "cbe52fc6-857d-3d73-97a0-ac73b294fd66",
                        "entry_id": "afae861e-6da5-34ee-a03c-a436527bde20",
                        "glosses": [
                            "dienstälteste Diplomatin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6a75b6-671f-4016-9960-e5e43f6194c9",
                                "sense_id": "cbe52fc6-857d-3d73-97a0-ac73b294fd66",
                                "text": "„Und so richtete bei dem Empfang im Rathaus neben Bürgermeister Vojko Obersnel, dem kroatischen Minister für Tourismus sowie der Doyenne des diplomatischen Korps, auch die stellvertretende Bürgermeisterin aus Neuss im Namen aller Partnerstädte einige Grußworte an die Ehrengäste im Rathaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c204d7e3-b117-3af8-a726-db146d6ec38c",
                        "entry_id": "afae861e-6da5-34ee-a03c-a436527bde20",
                        "glosses": [
                            "weibliche Person, die einen bestimmten Bereich geprägt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37895bd1-f61d-44c6-9599-3e7750622295",
                                "sense_id": "c204d7e3-b117-3af8-a726-db146d6ec38c",
                                "text": "„Die Königin der Volksschauspielerinnen, als geliebte und geehrte Doyenne des Ohnsorg Theaters bereits zwei Jahre zuvor zurückgetreten, empfing noch einmal öffentlich die Zuneigung ihres Publikums.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
