                                "example_id": "afa7f0a4-df72-4990-aa6f-35a6bd24d285",
                                "sense_id": "421d1ca3-484a-323e-b6c4-58e35e673084",
                                "text": "Voogdij krachtens testament.",
                                "translation": "Tutelle testamentaire."
