                        "loom",
                        "futloos",
                        "langzaam"
                    ],
                    "antonyms": [
                        "actief",
                        "snel",
                        "energiek"
                    ],
                    "common_phrases": [
                        "een slome computer",
                        "je sloom voelen"
                    ],
                    "target_lang_definitions": {
