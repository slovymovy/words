                        "translation_id": "d0d8cc95-c6c8-4e53-b2c3-38b89fae250a",
                        "source_entry_id": "e04a93a2-f705-393d-a70a-e5aede0020b6",
                        "source_sense_id": "3666f140-7424-3339-b130-ae4ed164bc35",
