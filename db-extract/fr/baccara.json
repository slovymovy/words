                                        "glosses": [
                                            "ein Kartenglücksspiel, bei dem mit zwei oder drei Karten neun Punkte erzielt werden müssen, oder man zumindest näher an neun Punkte herankommen muss als der Gegner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c15951-634b-4527-af5e-46e7c0bb67b8",
                                                "sense_id": "f8739528-9472-3045-ba33-87264dac226b",
                                                "text": "„Er spielte Baccarat und hatte keine Ahnung, wie das Spiel vor sich ging.“"
                                            }
