                "senses": [
                    {
                        "sense_id": "76604c4f-dfc6-3ce4-8398-66d966e6a1cb",
                        "entry_id": "de16f4f9-c735-3d87-b133-dde7c340c869",
                        "glosses": [
                            "weibliche Person, die Kleinst- und Kleinkinder während der Abwesenheit ihrer Eltern meist gegen Bezahlung hütet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd5474c-adbd-4653-abad-a7c1ceb85e72",
                                "sense_id": "76604c4f-dfc6-3ce4-8398-66d966e6a1cb",
                                "text": "„Empirische Daten über Babysitterinnen in der Bundesrepublik liegen nicht vor. Die Anzahl der Babysitterinnen und der Umfang ihres Einsatzes in der Kinderbetreuung von Kleinkindern und jüngeren Schulkindern in der Bundesrepublik sind bisher nicht erfaßt worden.“"
                            },
                            {
                                "example_id": "4c8cb3a8-a996-48c4-a275-8f25402ea0f7",
                                "sense_id": "76604c4f-dfc6-3ce4-8398-66d966e6a1cb",
                                "text": "„Sie liebte es die entzückten Gesichter der Eltern zu sehen, die, wenn sie heimkamen, feststellten, dass sie zur Babysitterin gratis noch eine Putzfrau dazubekommen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d59e441d-3520-4a9f-9c27-6dace6df3cfb",
                        "source_entry_id": "de16f4f9-c735-3d87-b133-dde7c340c869",
                        "source_sense_id": "76604c4f-dfc6-3ce4-8398-66d966e6a1cb",
                        "source_sense_description": "weibliche Person, die Kleinst- und Kleinkinder hütet",
                        "target_lang_word": "babysitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babysitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782c8fb3-0945-3215-9233-426d8c1cc6fc",
                                        "entry_id": "4c53f76b-2386-3288-ab95-0d0c55919386",
                                        "glosses": [
                                            "A person who cares for one or more babies or children for a short period of time in place of their legal guardians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee6c99e-fc87-4c01-b547-74b51e3f05f8",
                                                "sense_id": "782c8fb3-0945-3215-9233-426d8c1cc6fc",
                                                "text": "My neighbor is sometimes a babysitter for other mothers’ children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbcde27-3290-31ee-b29e-37a9133516f6",
                                        "entry_id": "4c53f76b-2386-3288-ab95-0d0c55919386",
                                        "glosses": [
                                            "A person who has to watch or attend to anything or anyone unnecessarily closely; a coddler or handholder."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0881a27-1ef9-4e03-bc67-27f5f07c1938",
                                                "sense_id": "dfbcde27-3290-31ee-b29e-37a9133516f6",
                                                "text": "He said he did not want to be on tenterhooks worrying about us and having to act as a babysitter for grown men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe8af8f5-860e-47c0-a889-f2cba23e5af6",
                        "source_entry_id": "de16f4f9-c735-3d87-b133-dde7c340c869",
