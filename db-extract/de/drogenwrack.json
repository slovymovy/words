                "senses": [
                    {
                        "sense_id": "ca093c86-46f7-3fa3-bc8b-f57b92359e79",
                        "entry_id": "e1f03efc-d62a-3cd2-bf1b-286f836b6868",
                        "glosses": [
                            "durch Drogenkonsum gezeichnete, gesundheitlich in Mitleidenschaft gezogene Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "259799d8-8ff5-4cbe-9aad-fca24c1c1a52",
                                "sense_id": "ca093c86-46f7-3fa3-bc8b-f57b92359e79",
                                "text": "„Aber sie war nicht noch mal ins Haus zurückgegangen, um weitere Sachen zu packen, was bedeutete, dass sie entweder ein kaputtes Drogenwrack war oder auf keinen Fall noch mal nach Hause gewollt hatte.“"
                            },
                            {
                                "example_id": "18ef77b4-8af5-400d-84f1-5931e6184bda",
                                "sense_id": "ca093c86-46f7-3fa3-bc8b-f57b92359e79",
                                "text": "„Wieso ist der idiotische kleine Jude für euch so wichtig, dass ihr sogar um eine Audienz bei zwei Drogenwracks wie Abel und mir bittet. Wieso könnt ihr die Sache nicht selbst herausfinden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
