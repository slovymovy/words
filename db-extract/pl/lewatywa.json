                "senses": [
                    {
                        "sense_id": "5e7e7678-cad4-3ad7-9479-cb9268ad8cfb",
                        "entry_id": "5d58272a-c649-3f6c-bc9a-48fc0c46024d",
                        "glosses": [
                            "zabieg leczniczy polegający wprowadzenie do odbytnicy ciepłej wody, czasem z dodatkiem leków lub soli, w celu wywołania wypróżnienia"
                        ],
                        "tags": [],
