                "senses": [
                    {
                        "sense_id": "2fb843ef-0d7b-310e-ad4f-6e59f54a6ca6",
                        "entry_id": "2a2dd138-5c5d-3c82-8ca6-3a430856f619",
                        "glosses": [
                            "Wörterbuch, das in gedruckter Form veröffentlicht wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1921b70-dbe6-49c7-87b2-a56ef4a29318",
                                "sense_id": "2fb843ef-0d7b-310e-ad4f-6e59f54a6ca6",
                                "text": "„Die größte Neuerung gegenüber dem früheren Printwörterbuch stellen die Recherchemöglichkeiten dar.“"
                            },
                            {
                                "example_id": "0b2629ab-b602-4dea-9609-7d27a6f1719b",
                                "sense_id": "2fb843ef-0d7b-310e-ad4f-6e59f54a6ca6",
                                "text": "„Sie bestehen aus einem Printwörterbuch und einer CD-ROM, die auf dieses Printwörterbuch zurückgeht,…“"
                            },
                            {
                                "example_id": "bf95a8e6-a5da-4a11-bf55-e5a5c4738984",
                                "sense_id": "2fb843ef-0d7b-310e-ad4f-6e59f54a6ca6",
                                "text": "„Die Phraseologie wird in greifbaren deutsch-tschechischen Allgemeinwörterbüchern in der Regel vernachlässigt, u.a. aus Platzgründen – das traditionelle Printwörterbuch als Medium stößt hier offensichtlich auf seine fest umrissenen Grenzen, wenn es weder quantitativ noch qualitativ befriedigende Aufbereitung des betreffenden Wortgutes ermöglicht, während bestehende spezielle deutsch-tschechische und tschechisch-deutsche phraseologische Nachschlagewerke entweder veraltet (z.B. Schönová 1975) oder lückenhaft sind bzw. bei der Inventarisierung der Phraseme programmatisch selektiv verfahren (z.B. Mrhačová et al. 2000). “"
                            },
                            {
                                "example_id": "09d3549f-4c94-4640-8304-0282bd21f3f4",
                                "sense_id": "2fb843ef-0d7b-310e-ad4f-6e59f54a6ca6",
                                "text": "„Plädoyer für übersichtliche Printwörterbücher im Zeitalter der Neuen Medien.“"
                            },
                            {
                                "example_id": "aab66b4c-8d96-4175-afc1-a21732e3ae34",
                                "sense_id": "2fb843ef-0d7b-310e-ad4f-6e59f54a6ca6",
                                "text": "„Haben Printwörterbücher noch eine Berechtigung?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
