        "nl-extract.jsonl": [
            {
                "entry_id": "62f9e779-c802-3199-89d1-1ddfc7a5f1d6",
                "word": "bewondering",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                        "entry_id": "62f9e779-c802-3199-89d1-1ddfc7a5f1d6",
                        "glosses": [
                            "het bekijken met enig ontzag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78ce297-52a9-4f0f-bd6e-a30452d8f3eb",
                                "sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                                "text": "Ik heb erg veel bewondering voor hem."
                            },
                            {
                                "example_id": "ef559b67-55c0-4cf0-9ebd-ba2a30fd1bac",
                                "sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                                "text": "Er klonken kreten van bewondering uit de menigte."
                            },
                            {
                                "example_id": "1f8e603e-f03e-4ade-9dc2-613bef6df41c",
                                "sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                                "text": "Volgens de Twentse pastoor onderscheidt de christelijke gemeenschap op Sri Lanka zich door hun sterk verzoenende houding jegens andere religies. „Ze vormen slechts een kleine minderheid, - zo’n zeven procent van de bevolking- maar zijn zeer verdraagzaam. Zo heb ik het meegemaakt dat tijdens een misviering de buren van het boeddhistische gebedshuis opzettelijk lawaai begonnen te maken om het geluid van biddende christenen te overstemmen. Ik heb bewondering voor hun lankmoedigheid.”"
                            },
                            {
                                "example_id": "264985e5-f8c2-45eb-9d60-f8255ed59090",
                                "sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                                "text": "Smallegange roemt het werkethos van Boer. \"Hij was een ondernemer pur sang.\" Ook Van de Laar spreekt vol bewondering over hoe Boer erin slaagde naast De Librije ook andere succesvolle restaurants te openen. Onder meer Brass Boer Thuis in Zwolle was een van die zaken. Ook met die horecagelegenheid verdiende hij een Michelinster."
                            },
                            {
                                "example_id": "c67c2f30-751b-44e3-8ee6-a1a0d5056e04",
                                "sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                                "text": "Ze maakten vooral heel veel lawaai, dus zocht ik de stilte op en liep naar de krater. Hier was het rustiger en vol bewondering keek ik naar het blauwe water van de vulkaankrater."
                            }
                        ]
                    },
                    {
                        "sense_id": "33fdecc1-e0a4-3183-8d7b-68340c7e73a2",
                        "entry_id": "62f9e779-c802-3199-89d1-1ddfc7a5f1d6",
                        "glosses": [
                            "bekijken met enig genoegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482cebbb-84a8-4b19-9929-3b40fef0cba9",
                                "sense_id": "33fdecc1-e0a4-3183-8d7b-68340c7e73a2",
                                "text": "De man glimlachte van bewondering naar het rapport van zijn zoon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebf67e94-3863-4b11-a2d9-18a917733e81",
                        "source_entry_id": "62f9e779-c802-3199-89d1-1ddfc7a5f1d6",
                        "source_sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                        "source_sense_description": "het bekijken met enig ontzag",
                        "target_lang_word": "Bewunderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewunderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c91c8b56-706e-389e-90d5-9c1605a90958",
                                        "entry_id": "a1d618a1-cca6-3bd0-ae9d-ccb180935516",
                                        "glosses": [
                                            "das Bewundern; Empfindung für jemanden/etwas, der/das als außergewöhnlich angesehen wird und besondere Anerkennung verdient"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8ca90c-c943-444c-b6bd-6ed60bdf2f7a",
                                                "sense_id": "c91c8b56-706e-389e-90d5-9c1605a90958",
                                                "text": "Das Publikum lauschte dem Sänger voller Bewunderung."
                                            },
                                            {
                                                "example_id": "2bf90b80-9296-45df-b0b0-5b9edddebb3a",
                                                "sense_id": "c91c8b56-706e-389e-90d5-9c1605a90958",
                                                "text": "„Mit Bewunderung und Vergnügen begegnete Franz jetzt immer seinem Reinhold.“"
                                            },
                                            {
                                                "example_id": "7d6e4d71-bc62-4dc2-805e-972a19caddd3",
                                                "sense_id": "c91c8b56-706e-389e-90d5-9c1605a90958",
                                                "text": "„Dann schleicht sich Bewunderung ein für diese Hemmungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "fd28d6a5-467a-4814-b00e-aab857f4f544",
                                                "sense_id": "c91c8b56-706e-389e-90d5-9c1605a90958",
                                                "text": "„In diesem Zusammenhang müssen wir aus übervollem Herzen ein Wort des Dankes und der Bewunderung an unsere wackeren Winzer richten, denen wir unser edelstes Teil verdanken: den Wein.“"
                                            },
                                            {
                                                "example_id": "fa4ecabe-2839-4b75-8d62-b0d2871791bd",
                                                "sense_id": "c91c8b56-706e-389e-90d5-9c1605a90958",
                                                "text": "„Trotz der offenbaren Überspanntheit dieser Reise nötigte sie mir Bewunderung ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea9200cf-1655-45c9-8013-a82753bf3a75",
                        "source_entry_id": "62f9e779-c802-3199-89d1-1ddfc7a5f1d6",
                        "source_sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                        "source_sense_description": "het bekijken met enig ontzag",
                        "target_lang_word": "admiration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admiration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                        "entry_id": "a0eabd36-5cfd-3d5c-9f4f-dfd50eeecbdc",
                                        "glosses": [
                                            "A positive emotion including wonder and approbation; the regarding of another as being wonderful"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d9eb30-9ee9-415d-9e4a-d59250a946a5",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "admiration of a war hero"
                                            },
                                            {
                                                "example_id": "d3dc2194-1201-4a6d-b7b1-04a86ddbfada",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "They looked at the landscape in admiration."
                                            },
                                            {
                                                "example_id": "29f2a30c-0e3c-4f70-bb31-dd221ba67901",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "For in this Instance, Life most exactly resembles the Stage, since it is often the same Person who represents the Villain and the Heroe; and he who engages your Admiration To-day, will probably attract your Contempt To-Morrow."
                                            },
                                            {
                                                "example_id": "dccfab99-4e33-4092-861c-70230f2d9466",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "A lady’s imagination is very rapid; it jumps from admiration to love, from love to matrimony in a moment."
                                            },
                                            {
                                                "example_id": "ed40b1b2-2ced-4087-96e2-e39dd6804ea5",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "Dr. Veraswami had a passionate admiration for the English, which a thousand snubs from Englishmen had not shaken."
                                            },
                                            {
                                                "example_id": "1368c8a3-526b-407b-bffe-4c651cc2880e",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "[I]n the towns, the storekeepers hated them because they had no money to spend. There is no shorter path to a storekeeper’s contempt, and all his admirations are exactly opposite. The town men, little bankers, hated Okies because there was nothing to gain from them."
                                            },
                                            {
                                                "example_id": "f9a47d2a-d8bd-4c09-9d0f-c77e5cdb3e52",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "Equally I can stand in a station like Lucerne in Switzerland, and watch with ill-concealed admiration the majestic entry of one of the latest Gotthard \"Ae 6/6\" electrics, packing 6,000 horsepower within its 60 ft. of length and 121 tons of weight, with its sleek dark green sides and handsome stainless steel bands and front wings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                        "entry_id": "a0eabd36-5cfd-3d5c-9f4f-dfd50eeecbdc",
                                        "glosses": [
                                            "Wondering or questioning (without any particular positive or negative attitude to the subject)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27228389-42ce-4b58-ae9d-0865cad9cf11",
                                                "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                                "text": "Lear. Your name, fair gentlewoman?\nGoneril. This admiration, sir, is much o’ th’ savour\nOf other your new pranks."
                                            },
                                            {
                                                "example_id": "693604c0-4e68-4cc3-8bf3-5764c9608de4",
                                                "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                                "text": "And I saw the woman drunken with the blood of the saints, and with the blood of the martyrs of Jesus: and when I saw her, I wondered with great admiration."
                                            },
                                            {
                                                "example_id": "433c2d56-58db-46a3-b7d0-b28462524fc8",
                                                "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                                "text": "[…] Admiration seized\nAll Heaven, what this might mean, and whither tend,\nWondering;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f748cfe3-68bd-3b50-b958-900d0abd8eab",
                                        "entry_id": "a0eabd36-5cfd-3d5c-9f4f-dfd50eeecbdc",
                                        "glosses": [
                                            "Cause of admiration; something to excite wonder, or pleased surprise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e94a9e4-a1a7-425e-8879-ee4ccc90e033",
                                                "sense_id": "f748cfe3-68bd-3b50-b958-900d0abd8eab",
                                                "text": "Now, good Lafeu,\nBring in the admiration; that we with thee\nMay spend our wonder too, or take off thine\nBy wondering how thou took’st it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "516e5fee-b380-4033-b37b-597fa3a4c68b",
                        "source_entry_id": "62f9e779-c802-3199-89d1-1ddfc7a5f1d6",
                        "source_sense_id": "6b959568-4029-3f06-bbec-a060b4f76d33",
                        "source_sense_description": "het bekijken met enig ontzag",
                        "target_lang_word": "admiration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admiration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                                        "entry_id": "97fdd4da-b234-353e-8e98-71645dc303dc",
                                        "glosses": [
                                            "Sentiment fort éprouvé à l’égard d’une personne ou d’une manifestation humaine ou animale que l’on considère comme dotée de qualités exceptionnelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a9e9c8-abf6-46cb-8303-f5d373df6392",
                                                "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                                                "text": "— Je déteste l’admiration ; c’est le principe de trop de mauvaises actions. On la donne à trop bon marché à présent, et à tout le monde ; nous devons bien nous garder d’admirer légèrement."
                                            },
                                            {
                                                "example_id": "64d59b70-4afd-4c71-b73d-fc8c8810a7bd",
                                                "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                                                "text": "Le phénomène de la croyance ou de l’admiration, qui n’est qu’une croyance éphémère, s’établit difficilement en concubinage avec l’idole."
                                            },
                                            {
                                                "example_id": "035e901d-671e-4109-bcf7-68bb0fd45b5d",
                                                "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                                                "text": "Une longue période d’admiration pour l’art médiéval et de mépris pour les temps voltairiens sembla menacer de ruine l’idéologie nouvelle ; […]."
                                            },
                                            {
                                                "example_id": "c322bb90-d19b-46cc-b307-935936b7d977",
                                                "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                                                "text": "En longeant l'atoll, j’étais rempli d’admiration et d’étonnement pour l’extraordinaire travail des madrépores."
                                            },
                                            {
                                                "example_id": "dc1037e8-1533-40eb-8184-9adcb2c13b04",
                                                "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                                                "text": "À la manière dont Charlotte en parle, l'admiration semble être un sous-produit de l'incompréhension, comme si elle disait : « J'admire la patience de ces moines qui prient toute la journée », comme si elle disait : « En tout cas, moi, je ne ferais pas ce que tu fais », comme si elle disait : « Et donne-moi d'autres exemples des incongruités qui régissent les rapports entre humains dans ta lointaine tribu primitive. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4178fa40-bc06-3bd2-95b2-c3b58a7324b4",
                                        "entry_id": "97fdd4da-b234-353e-8e98-71645dc303dc",
                                        "glosses": [
                                            "Action de regarder en trouvant exceptionnellement beau ou digne d'éloges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "470fb437-f7dc-4342-9172-62e93cbe4bd1",
                                                "sense_id": "4178fa40-bc06-3bd2-95b2-c3b58a7324b4",
                                                "text": "Vous n'êtes pas une femme, vous êtes la femme ! Et, comme suprême parangon de grâces et de beauté, vous vous devez à l’admiration de tous."
                                            },
                                            {
                                                "example_id": "55eee816-d65d-4eba-a934-3293c45604a0",
                                                "sense_id": "4178fa40-bc06-3bd2-95b2-c3b58a7324b4",
                                                "text": "Le neveu du cheikh Gaafar, qui, tout jeune homme avait lorgné avec une admiration jalouse l'épouse de son oncle, s'enhardit jusqu'à demander sa main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe4d75c8-a6b2-3be9-82c4-1032d794ae3f",
                                        "entry_id": "97fdd4da-b234-353e-8e98-71645dc303dc",
                                        "glosses": [
                                            "L’objet même qu’on admire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b4c28e-0a05-4d2a-a4a5-e0ec68cbdcf1",
                                                "sense_id": "fe4d75c8-a6b2-3be9-82c4-1032d794ae3f",
                                                "text": "Il y a des chimistes à la Erlich qui confondent dans la même admiration les mortiers colossaux et le salvarsan, le 420 et le 606."
                                            },
                                            {
                                                "example_id": "80e18a76-7686-4307-b4c8-99571291c3ed",
                                                "sense_id": "fe4d75c8-a6b2-3be9-82c4-1032d794ae3f",
                                                "text": "On tient à ses vieilles admirations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
