                "senses": [
                    {
                        "sense_id": "3618e67a-4897-3435-acc0-7ec984eb5ec0",
                        "entry_id": "fae2b01c-2921-35bb-8aba-e93bf5036d92",
                        "glosses": [
                            "człowiek zachowujący się niekulturalnie, ordynarnie"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4008098a-7f6c-4a89-b811-bac3ec6c9a35",
                                "sense_id": "3618e67a-4897-3435-acc0-7ec984eb5ec0",
                                "text": "Przyzwyczajony do prostoty jestem, niech mi świat pozwoli umrzeć poczciwym grubianinem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89ebf30c-731e-4906-8f94-6649346663e8",
                        "source_entry_id": "fae2b01c-2921-35bb-8aba-e93bf5036d92",
                        "source_sense_id": "3618e67a-4897-3435-acc0-7ec984eb5ec0",
                        "target_lang_word": "boor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A peasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727ef383-6011-412f-bf44-52e4bd91464f",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "Not swear it, now I am a gentleman? Let boors and franklins say it, I’ll swear it."
                                            },
                                            {
                                                "example_id": "b67d62d7-5486-48f7-ab27-8d45fcce7b0c",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "For all the rich array and goodly port and countenance of Corinius, he seemed but a very boor beside the Lord Brandoch Daha, and dearly did each hate the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d40eac4-4fbe-3175-a746-2bc8b1ce1695",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A Boer, white South African of Dutch or Huguenot descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00a94902-5c40-3d3f-bde6-4367bc52b1a6",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A yokel, country bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "An uncultured person; a vulgarian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367635d2-d061-48ea-8df1-fe3e60ebf3de",
                                                "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                                "text": "I question if any man ever saw his absent friend more clearly than did Shakespeare his Falstaff, for instance, or Scott his Balfour of Burleigh. But does it, therefore, follow that either of these great writers would, when hungry, have summoned up before him a clearer picture of his approaching dinner, than does the equally hungry or very much hungrier boor? This I doubt; and on the same principle I doubt if the said boor would see his dinner more clearly than a wolf, bear, or tiger would theirs when in quest of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
