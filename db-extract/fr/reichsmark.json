                        "sense_id": "5a7616b3-3175-35bb-8559-8b96be9d507f",
                        "entry_id": "0cade8b0-67f0-3b88-b789-ba9cae271736",
                        "glosses": [
                            "Monnaie de l’Allemagne de 1924 (quand il remplace le mark-papier) à 1948 (quand il est remplacé par le deutschemark en République fédérale d’Allemagne et par l’ostmark ou mark est-allemand, en République démocratique allemande)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c3afcb-aec4-45cf-bfec-487983ba9358",
                                "sense_id": "5a7616b3-3175-35bb-8559-8b96be9d507f",
                                "text": "La substitution du Saarmark au Reichsmark était une opération délicate, car il fallait opérer une discrimination entre les capitaux sarrois et les capitaux allemands réfugiés en Sarre en 1945-1946 ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db065f38-2e2b-47f0-b223-3ebea5a37090",
                        "source_entry_id": "0cade8b0-67f0-3b88-b789-ba9cae271736",
                        "source_sense_id": "5a7616b3-3175-35bb-8559-8b96be9d507f",
                        "source_sense_description": "monnaie allemande",
                        "target_lang_word": "Reichsmark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reichsmark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                        "entry_id": "add286a2-8b93-3980-95fe-880dbc0662af",
                                        "glosses": [
                                            "Währung des Deutschen Reiches von 1924 bis 1948"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0997d2b1-219a-44b7-86e6-2adcb6589f42",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "Sein Opa zeigte ihm verschiedene Reichsmark-Münzen."
                                            },
                                            {
                                                "example_id": "210fba42-e32e-45a5-b3ca-f24c6c50a473",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "Während der Weimarer Republik zahlte man mit Reichsmark."
                                            },
                                            {
                                                "example_id": "bbe702ac-5530-46ca-9cd7-8148b10eb44a",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„Aber Zigaretten waren eine Kostbarkeit an sich, pro Stück fünfzehn Reichsmark wert.“"
                                            },
                                            {
                                                "example_id": "443d800b-1b12-4c4e-81cb-a2f44ef00a7f",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„Nunmehr kostete die Fünftagereise, leicht erhöht, fünfundvierzig Reichsmark.“"
                                            },
                                            {
                                                "example_id": "4c46e68d-6334-4036-97fc-357feb572b14",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„Insgesamt hatte Horst 242 Reichsmark angespart.“"
                                            },
                                            {
                                                "example_id": "540e96cc-429b-4997-916c-eefeb3a658c2",
                                                "sense_id": "bf866fea-f98a-34c7-b4ef-ef5fce123f59",
                                                "text": "„In meinen betagten, von Flicken verzierten Trainingsanzug werden zweitausend Reichsmark eingenäht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
