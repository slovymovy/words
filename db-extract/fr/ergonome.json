                "senses": [
                    {
                        "sense_id": "66d02339-1a81-3bdf-a372-9216077b3f43",
                        "entry_id": "09e0a57f-4788-3f5b-acb9-c9a0a029740e",
                        "glosses": [
                            "Spécialiste de l'ergonomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c1cbc3-4235-40c2-8395-dd3b49712ff8",
                                "sense_id": "66d02339-1a81-3bdf-a372-9216077b3f43",
                                "text": "Il faut citer Jacques Christol qui a été le premier ergonome praticien vivant de son activité de conseil auprès des entreprises, à partir du début des années 1970. (Wikipédia - Ergonomie)"
                            },
                            {
                                "example_id": "a32f6fdb-620a-4c71-8858-ecf6fa66e922",
                                "sense_id": "66d02339-1a81-3bdf-a372-9216077b3f43",
                                "text": "A priori, la demande adressée à l’ergonome est donc matérielle : améliorer les ambiances, notamment le bruit, la surveillance et l’hygiène."
                            },
                            {
                                "example_id": "df8ca56e-0e93-4194-baaf-204d551c65c2",
                                "sense_id": "66d02339-1a81-3bdf-a372-9216077b3f43",
                                "text": "On ne se blesse pas parce qu’on est mal assis, mais parce qu’on est assis trop longtemps, éclaire Antoine Gioria, kinésithérapeute et ergonome expert du sujet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb6d7ea6-9a25-45a3-ad55-bf23beb63626",
                        "source_entry_id": "09e0a57f-4788-3f5b-acb9-c9a0a029740e",
                        "source_sense_id": "66d02339-1a81-3bdf-a372-9216077b3f43",
