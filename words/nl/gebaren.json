{
    "word_family": [
        "gebaar",
        "gebarentaal",
        "gebaard"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba4914a3-419e-3985-b2cb-776989a810ea",
                    "sense_definition": "communiceren door het maken van bewegingen met de handen of het lichaam",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>gebaarde</w> mij dat ik dichterbij moest komen.",
                            "target_lang_translations": {
                                "en": "He <w>gestured</w> to me that I should come closer."
                            }
                        },
                        {
                            "text": "De boze speler <w>gebaarde</w> wild naar de scheidsrechter na de beslissing.",
                            "target_lang_translations": {
                                "en": "The angry player <w>gesticulated</w> wildly at the referee after the decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "gesticuleren",
                        "wenken",
                        "tekens geven"
                    ],
                    "common_phrases": [
                        "wild gebaren",
                        "met de handen gebaren"
                    ],
                    "target_lang_definitions": {
                        "en": "to communicate by making movements with the hands or the body"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gesture",
                                "target_lang_sense_clarification": "to make a movement to express an idea or feeling"
                            },
                            {
                                "target_lang_word": "motion",
                                "target_lang_sense_clarification": "to direct someone with a movement of the hand"
                            },
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "to give a sign to someone"
                            },
                            {
                                "target_lang_word": "gesticulate",
                                "target_lang_sense_clarification": "to make wild or dramatic movements"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0da617fb-087d-3280-83b7-e22d55edb8f9",
                    "sense_definition": "gebruikmaken van een specifieke gebarentaal om te communiceren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kan heel snel <w>gebaren</w> omdat ze met dove ouders is opgegroeid.",
                            "target_lang_translations": {
                                "en": "She can <w>sign</w> very quickly because she grew up with deaf parents."
                            }
                        },
                        {
                            "text": "Tijdens de toespraak stond er een tolk naast de minister om te <w>gebaren</w>.",
                            "target_lang_translations": {
                                "en": "During the speech, an interpreter stood next to the minister to <w>sign</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "spreken"
                    ],
                    "common_phrases": [
                        "vloeiend gebaren"
                    ],
                    "target_lang_definitions": {
                        "en": "to use a specific sign language to communicate"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sign",
                                "target_lang_sense_clarification": "to use sign language"
                            },
                            {
                                "target_lang_word": "use sign language",
                                "target_lang_sense_clarification": "to communicate via signs"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e6f65de-8751-348a-9e6d-8400948dcab7",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>gebaar</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte een paar eenvoudige <w>gebaren</w> om de weg te wijzen.",
                            "target_lang_translations": {
                                "en": "He made a few simple <w>gestures</w> to show the way."
                            }
                        },
                        {
                            "text": "Zonder woorden begrepen ze elkaar door middel van kleine <w>gebaren</w>.",
                            "target_lang_translations": {
                                "en": "Without words, they understood each other through small <w>gestures</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vriendelijke gebaren",
                        "eenvoudige gebaren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of gebaar"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'gesture'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gestures",
                                "target_lang_sense_clarification": "plural of a movement made to express something"
                            },
                            {
                                "target_lang_word": "signs",
                                "target_lang_sense_clarification": "plural of a signal or movement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}