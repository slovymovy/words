                                                "example_id": "6fc887c6-7266-4b08-ae21-cff28863f991",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "pure awesome"
                                            },
                                            {
                                                "example_id": "9720fd11-3e42-453c-8c62-701630337cfb",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "made of awesome"
                                            },
                                            {
                                                "example_id": "a83fe395-fe5b-4cf6-8986-f492c0f7d8eb",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "Plus, her patent leather boots were made of awesome. They made her legs look longer and leaner."
                                            },
                                            {
                                                "example_id": "2a3bce17-577a-4499-bfe0-0af967fae5df",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "Swayze, of course, is the being of pure awesome who has by now conquered all of Heaven."
                                            },
                                            {
                                                "example_id": "87b2b898-cdc7-415f-b5d5-99a504b3fac4",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "“Your grandmother,” he mumbles into my hair as we cuddle on the couch, “is made of awesome.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66627fd9-cb8f-3b25-aaaa-bb79ac4ab146",
                                        "entry_id": "d56502b8-6c11-321a-839d-e29e432a791d",
                                        "glosses": [
                                            "A person who is awesome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43f6fb2-2c3e-4e8f-9ca8-028f74a822fd",
                                                "sense_id": "66627fd9-cb8f-3b25-aaaa-bb79ac4ab146",
                                                "text": "When an awesome is dreadful and making even the living of a common person miserable then someone from the community must stand up to resist the dreadful and check the excesses."
                                            },
                                            {
                                                "example_id": "05802221-5b5b-484a-b599-519b45c3ac52",
                                                "sense_id": "66627fd9-cb8f-3b25-aaaa-bb79ac4ab146",
                                                "text": "“Or as I like to think of it, the wusses versus the awesomes.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
