                    {
                        "sense_id": "bf79707e-0aca-3eef-963b-1d7f89ebd8dd",
                        "entry_id": "b8cad042-6a11-3971-8006-1f6727defee7",
                        "glosses": [
                            "iemand die voor het eerst ergens aan deelneemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eafbd92d-1cc2-4ec1-9df6-695f8a3e7b9c",
                                "sense_id": "bf79707e-0aca-3eef-963b-1d7f89ebd8dd",
                                "text": "Op de Indianapolis Motor Speedway gold Van Kalmthout, die bezig is aan zijn tweede seizoen in de IndyCar, als een van de favorieten. De Nederlander werd in zijn debuutjaar uitgeroepen tot 'rookie of the year' en loste die belofte twee weken geleden in door voor het eerst een race te winnen."
                            },
                            {
                                "example_id": "cafb22b7-6646-48aa-993f-ce83468ebc21",
                                "sense_id": "bf79707e-0aca-3eef-963b-1d7f89ebd8dd",
                                "text": "In 2015 kneedde u Verstappen, dit jaar doet u hetzelfde met de Japanse 'rookie': Yuki Tsunoda. Lijken ze op elkaar?"
                            },
                            {
                                "example_id": "8bae459f-49cb-4264-8efe-51a2d55f008c",
                                "sense_id": "bf79707e-0aca-3eef-963b-1d7f89ebd8dd",
                                "text": "In de maanden januari tot en met maart wist ’the rookie’ bijna net zoveel dollars los te peuteren bij het grote publiek als de gewezen first lady. Senator Clinton uit New York laat in de peilingen haar tegenstrever echter weer ruim achter zich."
                            }
                        ]
                    }
