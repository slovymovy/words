                {
                    "sense_id": "afc02e5e-7a85-32ec-b394-2e4e6664267b",
                    "sense_definition": "Een aangename geur, vaak afkomstig van bloemen, planten of andere natuurlijke bronnen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rozen in de tuin verspreiden een heerlijk <w>parfum</w>.",
                            "target_lang_translations": {
                                "en": "The roses in the garden spread a lovely <w>fragrance</w>.",
                                "ru": "Розы в саду источают чудесный <w>аромат</w>.",
                                "pl": "Róże w ogrodzie roztaczają cudowny <w>aromat</w>.",
                                "de": "Die Rosen im Garten verbreiten einen herrlichen <w>Duft</w>.",
                                "fr": "Les roses dans le jardin diffusent un <w>parfum</w> délicieux.",
                                "it": "Le rose in giardino diffondono un <w>profumo</w> delizioso.",
                                "cs": "Růže v zahradě šíří nádhernou <w>vůni</w>.",
                                "tr": "Bahçedeki güller harika bir <w>koku</w> yayıyor.",
                                "es": "Las rosas en el jardín desprenden un <w>aroma</w> delicioso.",
                                "zh": "花园里的玫瑰散发着迷人的<w>香气</w>。"
                            }
                        },
                        {
                            "text": "Het <w>parfum</w> van de dennenbomen was in het hele bos te ruiken.",
                            "target_lang_translations": {
                                "en": "The <w>scent</w> of the pine trees could be smelled throughout the forest.",
                                "ru": "<w>Аромат</w> сосен чувствовался во всём лесу.",
                                "pl": "<w>Woń</w> drzew iglastych była wyczuwalna w całym lesie.",
                                "de": "Der <w>Duft</w> der Tannenbäume war im ganzen Wald zu riechen.",
                                "fr": "La <w>senteur</w> des pins se faisait sentir dans toute la forêt.",
                                "it": "Il <w>profumo</w> dei pini si poteva sentire in tutto il bosco.",
                                "cs": "<w>Vůně</w> borovic byla cítit v celém lese.",
                                "tr": "Çam ağaçlarının <w>kokusu</w> tüm ormanda hissedilebiliyordu.",
                                "es": "El <w>aroma</w> de los pinos se podía oler en todo el bosque.",
                                "zh": "整个森林里都能闻到松树的<w>芬芳</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zoet parfum",
                        "heerlijk parfum",
                        "parfum van bloemen"
                    ],
                    "target_lang_definitions": {
                        "en": "A pleasant smell, often originating from flowers, plants, or other natural sources.",
                        "ru": "Приятный запах, часто исходящий от цветов, растений или других природных источников.",
                        "pl": "Przyjemny zapach, często pochodzący od kwiatów, roślin lub innych naturalnych źródeł.",
                        "de": "Ein angenehmer Geruch, der oft von Blumen, Pflanzen oder anderen natürlichen Quellen stammt.",
                        "fr": "Une odeur agréable, souvent issue de fleurs, de plantes ou d'autres sources naturelles.",
                        "it": "Un odore gradevole, spesso proveniente da fiori, piante o altre fonti naturali.",
                        "cs": "Příjemná vůně, často pocházející z květin, rostlin nebo jiných přírodních zdrojů.",
                        "tr": "Genellikle çiçeklerden, bitkilerden veya diğer doğal kaynaklardan gelen hoş koku.",
                        "es": "Un olor agradable, a menudo proveniente de flores, plantas u otras fuentes naturales.",
                        "zh": "一种令人愉悦的气味，通常来自花朵、植物或其他自然来源。"
