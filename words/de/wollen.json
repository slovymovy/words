            "senses": [
                {
                    "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                    "sense_definition": "die Absicht oder den festen Plan haben, eine bestimmte Handlung auszuführen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "absicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich <w>will</w> heute Abend meine Hausaufgaben rechtzeitig fertig machen."
                        },
                        {
                            "text": "Wir <w>wollen</w> im kommenden Sommer für zwei Wochen nach Italien fahren."
                        }
                    ],
                    "synonyms": [
                        "beabsichtigen",
                        "anstreben"
                    ],
                    "antonyms": [
                        "ablehnen"
                    ],
                    "common_phrases": [
