                },
                {
                    "sense_id": "16a65852-c658-3dc3-ac9d-ae1daa76e342",
                    "sense_definition": "Słowo wtrącone w potocznej mowie, służące do podtrzymania uwagi rozmówcy lub upewnienia się, że jest się słuchanym.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To był, <w>rozumiesz</w>, bardzo dziwny i niespodziewany dzień.",
                            "target_lang_translations": {
                                "ru": "Это был, <w>понимаешь</w>, очень странный и неожиданный день.",
                                "en": "It was, <w>you know</w>, a very strange and unexpected day.",
                                "zh": "那天，<w>你懂的</w>，过得特别离奇又出乎意料。"
                            }
                        },
                        {
                            "text": "Musisz tam iść i, <w>rozumiesz</w>, załatwić to osobiście z kierownikiem.",
                            "target_lang_translations": {
                                "ru": "Ты должен пойти туда и, <w>понимаешь</w>, решить это лично с руководителем.",
                                "en": "You have to go there and, <w>you know</w>, handle it personally with the manager.",
                                "zh": "你必须去那一趟，<w>明白吧</w>，跟经理当面把事情解决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wiesz"
                    ],
                    "traits": [
                        {
