                ],
                "senses": [
                    {
                        "sense_id": "fb20ea78-edfa-36d7-922b-0ceb0cc89612",
                        "entry_id": "66cacaa7-6133-34cd-a841-ae75291bae8a",
                        "glosses": [
                            "Petite excroissance qui se forme à la surface de la peau, surtout au visage et aux mains."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bdfbb292-cc9d-3704-882e-611c0072c430",
                        "entry_id": "66cacaa7-6133-34cd-a841-ae75291bae8a",
                        "glosses": [
                            "Rajout considéré comme mal intégré à l’ensemble."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5d294eda-66c1-41e2-bb38-f36d2d724683",
                                "sense_id": "bdfbb292-cc9d-3704-882e-611c0072c430",
                                "text": "Voici bientôt quarante ans que le Louvre crie par toutes les gueules de ces murs éventrés, de ces fenêtres béantes : Extirpez ces verrues de ma face !"
                            },
                            {
                                "example_id": "d1f511f4-4b1a-4751-93c8-93453ac425dc",
                                "sense_id": "bdfbb292-cc9d-3704-882e-611c0072c430",
                                "text": "C’est un passage étroit, bordé de maisons bâties comme on bâtit par spéculation, qui débouche rue de Bondy, dans cette partie de la rue obombrée par l’immense théâtre de la Porte-Saint-Martin, une des verrues de Paris."
                            },
                            {
                                "example_id": "f2d53cc1-f7dd-4fcd-9c73-b176958ffbee",
                                "sense_id": "bdfbb292-cc9d-3704-882e-611c0072c430",
                                "text": "Je l’aime tendrement, j’aime jusqu’à ses verrues et ses taches."
                            },
                            {
                                "example_id": "51558e31-7fe6-4265-b178-d15d91645d03",
                                "sense_id": "bdfbb292-cc9d-3704-882e-611c0072c430",
                                "text": "J’aurais supprimé quelques verrues, que je n’ai pas pris la peine, n’étant que laïque, d’extirper sérieusement, mais qu’il n’eût dépendu que de moi d’arracher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dab2e78-47ba-4a83-bc57-86fd11a7f58c",
                        "source_entry_id": "66cacaa7-6133-34cd-a841-ae75291bae8a",
                        "source_sense_description": "excroissance sur le corps",
                        "target_lang_word": "Warze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6638cf-13d1-30a7-8bc2-c14162ec9920",
                                        "entry_id": "d7c2ebc8-fa83-3049-b777-09fb70d2b442",
                                        "glosses": [
                                            "Geschwulst, knotige Erhebung der obersten Hautschichten, die meist durch Viren hervorgerufen werden und oft ansteckend sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5661aa9c-7771-4b18-ad3f-b65e029fad58",
                                                "sense_id": "6b6638cf-13d1-30a7-8bc2-c14162ec9920",
                                                "text": "Ich hatte eine kleine Warze am Augenlid."
                                            },
                                            {
                                                "example_id": "852076a3-f64d-4875-837b-83865595903e",
                                                "sense_id": "6b6638cf-13d1-30a7-8bc2-c14162ec9920",
                                                "text": "Ich habe meine Warzen durch Vereisen entfernen lassen."
                                            },
                                            {
                                                "example_id": "08d05851-b2d2-48bd-8715-ac3be0606ffd",
                                                "sense_id": "6b6638cf-13d1-30a7-8bc2-c14162ec9920",
                                                "text": "„Ágúst hatte keinen Zahn mehr im Mund und war zu nichts mehr zu gebrauchen, und Árelía war so krumm wie ein umgedrehtes U und hatte zwei große, mit dicken schwarzen Haaren bewachsene Warzen im Gesicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d745ec81-b18b-352f-8399-7359bdd0ff3b",
                                        "entry_id": "d7c2ebc8-fa83-3049-b777-09fb70d2b442",
                                        "glosses": [
                                            "Brustwarze"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92704d17-dfd1-404d-b880-633b49fa73a5",
                                                "sense_id": "d745ec81-b18b-352f-8399-7359bdd0ff3b",
                                                "text": "Man kann ja ihre Warzen unter dem T-Shirt sehen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cad79aa6-79c9-438e-9344-c1f2dd867d8c",
