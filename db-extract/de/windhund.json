                                "target_senses": [
                                    {
                                        "sense_id": "afa3ce16-1ad5-30b7-9fdf-919063395893",
                                        "entry_id": "1f967431-eb9a-32f4-b933-e95d6c35620a",
                                        "glosses": [
                                            "A hound that primarily hunts by sight and speed, instead of by scent and endurance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0fca6c0-f216-4312-8a83-bb6187a53575",
                        "source_entry_id": "cb2721fb-4904-3399-b36c-5983feaf546e",
                        "source_sense_id": "3d07d88f-02f9-3df6-b1ab-9ca573a72fc1",
                        "source_sense_description": "Vertreter einer Gruppe schlanker, hochbeiniger Hunderassen",
                        "target_lang_word": "gazehound",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazehound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05e780ed-8444-3559-b993-098de6326478",
                                        "entry_id": "5354584c-9ee2-35d8-bbe1-ef68a25f1633",
                                        "glosses": [
                                            "Synonym of sighthound (“a hound that primarily hunts by sight and speed, instead of by scent and endurance”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f032721c-ef67-4e03-8113-090e65791ac1",
                                                "sense_id": "05e780ed-8444-3559-b993-098de6326478",
                                                "text": "And foresters, in green-wood trim, / Lead in the leash the gaze-hounds grim, / Attentive, as the bratchet's bay / From the dark covert drove the prey, / To slip them as he broke away."
                                            },
                                            {
                                                "example_id": "391d77d9-6e62-4403-a7da-48bd91d71454",
                                                "sense_id": "05e780ed-8444-3559-b993-098de6326478",
                                                "text": "I entered the house with some wrath upon me at seeing the gazehounds in the yard; for it seems a cruel thing to me to harass the birds in the breeding-time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eedd294d-0c33-4e4e-af14-4f5cd62d0132",
                        "source_entry_id": "cb2721fb-4904-3399-b36c-5983feaf546e",
                        "source_sense_id": "3d07d88f-02f9-3df6-b1ab-9ca573a72fc1",
                        "source_sense_description": "Vertreter einer Gruppe schlanker, hochbeiniger Hunderassen",
                        "target_lang_word": "lévrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lévrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                        "entry_id": "314a16ac-13c8-39f3-ab66-c01da6708f93",
                                        "glosses": [
                                            "Sorte de chien haut monté sur jambes, qui a la tête longue et menue, le corps délié."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22fbf3e6-345c-4927-b4ab-eceeece410b0",
                                                "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                                "text": "Prince ! Prince ! cria le garde ; et il siffla, resiffla, point de lévrier."
                                            },
                                            {
                                                "example_id": "11ebf4d7-72e2-4066-89cc-a80dfafbf393",
                                                "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                                "text": "Et quand il y fut, le sénéchal tança d’une verte manière les deux lévriers qui se disputaient un os de jambon."
                                            },
                                            {
                                                "example_id": "7aae50e6-3831-4844-827d-664b9d9f748d",
                                                "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                                "text": "Puis encore les lévriers charnaigres, qui bondissent ; les lévriers harpés, sans ventre ; les lévriers nobles, au râble large ; les lévriers gigotés, aux os éloignés ; les lévriers nobles, de longue encolure ; les lévriers œuvres, au palais noir."
                                            },
                                            {
                                                "example_id": "9beab1fa-d9db-4893-b8f7-988ca5d1f32c",
                                                "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                                "text": "Catherine se leva aussitôt et prit le chemin de la chambre où se tenaient, sur des tapis de Turquie et des coussins de velours, les lévriers favoris du roi."
                                            },
                                            {
                                                "example_id": "39b9531c-cc6e-4b1b-8989-330458747dc6",
                                                "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                                "text": "Car la région que nous traversons est assez giboyeuse, et les grands nemrods de la m’halla, […], qui ont emmené des meutes de lévriers et des faucons chasseurs, font des hécatombes de lièvres, de perdrix, de poules de Carthage, de renards et de chacals."
                                            },
                                            {
                                                "example_id": "147be6d8-b7a3-41fe-857c-5b1a803231b2",
                                                "sense_id": "95d2f994-73f2-3b87-ab63-18ae32f69c23",
                                                "text": "Maigre comme un Lévrier d’attache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f498cf4-20c0-3f05-89b9-45495f1aa546",
                                        "entry_id": "314a16ac-13c8-39f3-ab66-c01da6708f93",
                                        "glosses": [
                                            "Personne qu’on lance à la poursuite de quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b58dcf-b81b-426b-ac18-f762f1b8ff64",
                                                "sense_id": "1f498cf4-20c0-3f05-89b9-45495f1aa546",
                                                "text": "La police a mis ses lévriers aux trousses de ce bandit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3719765a-f870-3513-8195-0749f6480963",
                                        "entry_id": "314a16ac-13c8-39f3-ab66-c01da6708f93",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il est représenté avec un collier dont on doit blasonner la couleur. À rapprocher de chien, goupil, levrette, loup et renard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c80355-e6ee-40e1-92e4-ae0a726a4cac",
                                                "sense_id": "3719765a-f870-3513-8195-0749f6480963",
                                                "text": "De gueules au lévrier rampant d’argent colleté d’azur, accompagné de six billettes du même ordonnées en orle, qui est de Pleaux du Cantal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3080972f-438d-4494-b1e5-6ec5fb3fa0b7",
                        "source_entry_id": "cb2721fb-4904-3399-b36c-5983feaf546e",
