                ],
                "senses": [
                    {
                        "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                        "entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                        "glosses": [
                            "Femme avec qui l’on converse, qui participe à une conversation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c570ebe8-28d8-45a0-b976-b47773574158",
                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                "text": "– Ciao Valentina, come va ? demanda l’Italien en reconnaissant son interlocutrice, une spécialiste en histoire de l’art.\n– Bonjour messieurs, répondit-elle …."
                            },
                            {
                                "example_id": "6df9e61d-bc0b-469a-a8ff-4b019caa9c47",
                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                "text": "Le juge vit la déception sur le visage de son interlocutrice et comprit qu'il avait mis dans le mille."
                            },
                            {
                                "example_id": "79c278d5-c7fd-460a-879c-484b60b222db",
                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                "text": "Là-dessus, mon interlocutrice s’avança vers le feu, toute tremblante et portant la main à son côté."
                            },
                            {
                                "example_id": "42f443f8-3fa2-4d91-a731-efcf0cf46712",
                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                "text": "Les joues de Miss Bell rosissent. Assise sur le bord de sa chaise, le buste rigide, elle lui lance un regard indigné. Cox s’excuse pour la crudité de ses propos, ils ne sont pas dignes d’une interlocutrice de son rang, qu’elle le pardonne, ses nerfs sont à vif, il croule sous les doléances."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc9f3b09-f4f0-32e3-b363-ea61184c8485",
                        "entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                        "glosses": [
                            "Femme qu’un écrivain introduit dans un dialogue."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "465456da-41f5-4290-92ec-f4c645ee972a",
                        "source_entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                        "target_lang_word": "Gesprächspartnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesprächspartnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                        "entry_id": "707b435d-ed55-35ce-a3a1-3ce1190ab5b8",
                                        "glosses": [
                                            "weibliche Person, die sich mit (einer) anderen Person im Gespräch befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ba0e7e0-a18b-4ce2-8163-9a5089bc5afd",
                                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                                "text": "„Ich stand erstaunt vor der Weisheit, der Mäßigung und der sachlichen Genauigkeit, mit der meine Gesprächspartnerin sich bemühte, die Rolle der Frau klarzulegen.“"
                                            },
                                            {
                                                "example_id": "37ac0cde-acae-4a41-a805-4a6a8fe73f62",
                                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                                "text": "„Führe ich das Gespräch, werde ich oft nicht als gleichwertige Gesprächspartnerin akzentiert.“"
                                            },
                                            {
                                                "example_id": "5a80a3be-08be-488a-ab91-57d94d198f87",
                                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                                "text": "„In diesem Kontext gehen wir, wenn auch nur knapp, auch auf den (körperlichen) Emotionsausdruck der Gesprächspartnerinnen ein.“"
                                            },
                                            {
                                                "example_id": "f9835e41-310c-4bad-8f02-c8e944a6d171",
                                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                                "text": "„Der Moderator Jake Tapper hielt seiner Gesprächspartnerin immer wieder Falschaussagen der US-Administration vor, die er dann mit Fakten konterkarierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
