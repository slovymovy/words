                "senses": [
                    {
                        "sense_id": "4e65f2b1-1a1a-3476-a2e4-7f2597b68e7a",
                        "entry_id": "9618d2dd-4c4c-319d-bd45-a75f29154021",
                        "glosses": [
                            "Dégager une odeur nauséabonde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d94fcca-d01e-47b3-9812-c256b56bebbb",
                                "sense_id": "4e65f2b1-1a1a-3476-a2e4-7f2597b68e7a",
                                "text": "De toutes parts, des excrétions nauséabondent, pendulant comme des sphères aplaties aux deux pôles, qui auraient un peu le tournis."
                            },
                            {
                                "example_id": "90aa5a4a-517b-41f4-980a-7bd4d4135e85",
                                "sense_id": "4e65f2b1-1a1a-3476-a2e4-7f2597b68e7a",
                                "text": "Détourne les yeux, vite, ferme les yeux feins d'ignorer le ricanement de toutes ces choses qui nauséabondent"
                            },
                            {
                                "example_id": "c72ac47b-520d-4037-a042-c5d677d22e34",
                                "sense_id": "4e65f2b1-1a1a-3476-a2e4-7f2597b68e7a",
                                "text": "(...) que j'aime désormais pour mien et pour lequel, cependant, je ne me sens pas d'entonner un dithyrambe à grand renfort d'opinions qui nauséabondent : « vivre en poésie » est une expression inepte."
                            }
                        ]
                    }
                ],
