                        "examples": [
                            {
                                "example_id": "598539c6-17f2-4494-9a4a-342ba42854cd",
                                "sense_id": "f23b89bb-f0b5-3e06-8835-5e608da9b1cc",
                                "text": "Dick venait d’exhumer de sa mémoire un souvenir du temps où il apprenait, lui aussi, l’électricité sous la férule d’un joyeux compagnon. Un rouquin terrible sur la chagatte, et qui, dans les chantiers de petits dépannages, loupait pas une boniche sur dix."
                            },
                            {
                                "example_id": "ada30516-99da-4f47-8f69-827dd887de81",
                                "sense_id": "f23b89bb-f0b5-3e06-8835-5e608da9b1cc",
                                "text": "La voiture embaumait la chagatte de grand luxe, façon archiduchesse."
                            },
                            {
                                "example_id": "d30625b6-7e67-4ded-a0c6-64f812342a5d",
                                "sense_id": "f23b89bb-f0b5-3e06-8835-5e608da9b1cc",
                                "text": "A Saint-Ouen celles qui en avaient goûté, jeunes ou viocques, gravosses ou pucelles, en avaient la chagatte toute nostalgique pour le restant de leurs jours. Enfin ce qu'il disait, vous êtes au courant."
                            }
                        ]
                    }
