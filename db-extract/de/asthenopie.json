                "senses": [
                    {
                        "sense_id": "6df0daa4-ccfe-3e96-b504-6073b199c011",
                        "entry_id": "2d392e84-7413-3610-9043-e58c95b8d68f",
                        "glosses": [
                            "auftretende Missempfindungen und Unwohlsein im Zusammenhang mit einer Belastung der Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68ffa2b-8f39-446a-92a4-a2219d97b9aa",
                                "sense_id": "6df0daa4-ccfe-3e96-b504-6073b199c011",
                                "text": "„Der Asthenopie liegt oft eine Überanstrengung zugrunde.“"
                            },
                            {
                                "example_id": "e5c1d7c6-616d-4b88-a720-48d2dbf06884",
                                "sense_id": "6df0daa4-ccfe-3e96-b504-6073b199c011",
                                "text": "„Zu diesem Unvermögen, anhaltend geistig zu arbeiten, gesellen sich noch subjektive Druckempfindungen im Auge, die sogenannte neurasthenische Asthenopie.“"
                            },
                            {
                                "example_id": "a64bf863-05b9-4b9d-81f6-894c92b55a39",
                                "sense_id": "6df0daa4-ccfe-3e96-b504-6073b199c011",
                                "text": "„Bei allen Patienten mit Asthenopie ist daher neben Visusbestimmung und Refraktion eine Untersuchung des Binokularsehens erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
