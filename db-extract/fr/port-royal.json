                    {
                        "sense_id": "d7a3c7e9-4cf9-3e92-ad35-c4d486936d58",
                        "entry_id": "1356daab-740c-3b71-a1a9-59b6806ce4d3",
                        "glosses": [
                            "Ancienne abbaye située dans la commune de Magny-les-Hameaux (Yvelines)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d4f8008-137f-4409-86a1-5ac2b9693481",
                                "sense_id": "d7a3c7e9-4cf9-3e92-ad35-c4d486936d58",
                                "text": "Port-Royal nous manque, je veux dire que Port-Royal correspondait exactement aux besoins d’une certaine race d’âmes qui n’étaient pas du tout hérétiques et telles qu’on en trouverait encore beaucoup."
                            },
                            {
                                "example_id": "cc94fb0d-fd09-4f28-85fe-aec9340d8fc4",
                                "sense_id": "d7a3c7e9-4cf9-3e92-ad35-c4d486936d58",
                                "text": "Sans doute, son devoir de chrétienne était-il de se soumettre à sa mère ; mais, lisant un livre sur Port-Royal, elle avait été frappée par un mot de Nicole, suggérant que l’obéissance aussi peut être un piège du démon."
                            }
                        ]
                    }
