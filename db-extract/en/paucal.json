                "senses": [
                    {
                        "sense_id": "8c476793-d083-3627-b921-24c4a9c44091",
                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                        "glosses": [
                            "Characterized by having a small number, greater than two, of (usually equivalent) components."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                        "glosses": [
                            "Pertaining to a language form referring to a few or a couple of something (typically three to around ten), e.g. a small group of people."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "480a3b90-c9a4-4b33-8687-3af141dbf60e",
                                "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                "text": "first-person paucal"
                            },
                            {
                                "example_id": "68c2275b-6815-433f-bccc-632e64c40667",
                                "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                "text": "paucal number"
                            },
                            {
                                "example_id": "84559a0b-b2da-46ec-96fc-ab72a0236fac",
                                "sense_id": "24899df1-f317-3e76-9001-8bee9409bf0b",
                                "text": "paucal and plural pronouns"
                            }
                        ]
                    },
                    {
                        "sense_id": "b0f066cc-99e2-3ca7-9a05-76f3725bef8c",
                        "entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                        "glosses": [
                            "Expressing a relatively small quantity or degree."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b21cea2-d54b-440c-837a-3ee12c40fbb8",
                                "sense_id": "b0f066cc-99e2-3ca7-9a05-76f3725bef8c",
                                "text": "But too much can occur in the negative with a paucal meaning when there is no explicit or implicit infinitival complement: I didn't enjoy it too much is simply an informal alterant of I didn't enjoy it very much."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "328187c3-e119-498d-b791-cb4537fd00c7",
                        "source_entry_id": "aa841fe1-db9c-3bef-ae96-fc25e38074f5",
                        "source_sense_description": "paucal (adjective)",
                        "target_lang_word": "paucal",
