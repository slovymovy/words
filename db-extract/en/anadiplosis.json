                        "glosses": [
                            "A figure of speech in which a word or phrase used at the end of a clause or expression is repeated near the beginning of the next clause or expression."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
