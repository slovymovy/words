                    "frequency": "Low",
                    "semantic_group_id": "denial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had to <w>disavow</w> the controversial statements made by his campaign manager."
                        },
                        {
                            "text": "He chose to <w>disavow</w> all knowledge of the secret project to <w>disavow</w> responsibility."
                        }
                    ],
