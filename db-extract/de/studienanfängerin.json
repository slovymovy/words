                ],
                "senses": [
                    {
                        "sense_id": "8543a300-6071-34bb-900c-6aeb2807125b",
                        "entry_id": "3bc2a7f2-d03c-37c8-a63d-16bcef6b9538",
                        "glosses": [
                            "weibliche Person, die ihre höhere Ausbildung, zum Beispiel an einer Universität, Hochschule oder Akademie beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf6ee88f-f5bc-47b4-8377-86e84dc03742",
                                "sense_id": "8543a300-6071-34bb-900c-6aeb2807125b",
                                "text": "„Durch die Beratung von Drehbuchautoren soll das Thema MINT-Berufe in Fernsehserien untergebracht werden - und so vielleicht auch die eine oder andere Studienanfängerin angesprochen werden.“"
                            },
                            {
                                "example_id": "6da0de7e-14d8-44f3-9221-2a89fbf91fd8",
                                "sense_id": "8543a300-6071-34bb-900c-6aeb2807125b",
                                "text": "„Taugt das Gymnasium dazu, eifrige Primarschulkinder in sechs Jahren zu tüchtigen Studierenden zu formen? Ein Mittelschul- und ein ehemaliger Hochschulrektor, eine Schulleiterin und Schulpräsidentin, eine Studienanfängerin und eine Gymnasiastin haben Schülern und Lehrpersonen der Kantonsschule Hohe Promenade Zürich im Rahmen der Jubiläumsveranstaltungen vom Podium herunter versichert, dass dem grundsätzlich so sei.“"
                            },
                            {
                                "example_id": "30aa5321-4883-4d3a-b1ab-7082daed5702",
                                "sense_id": "8543a300-6071-34bb-900c-6aeb2807125b",
                                "text": "„Wenn es das Ausbildungsziel des betreffenden Studienganges erfordert, haben Studienanfängerinnen und Studienanfänger mit einer einschlägigen beruflichen Qualifikation Zusatzprüfungen nachzuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
