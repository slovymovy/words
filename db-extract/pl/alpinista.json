                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "альпинист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44fafe0d-c09a-38b9-9d79-34451476a5e1",
                                        "entry_id": "5a69d908-4d92-37ed-8a88-891b14d368bb",
                                        "glosses": [
                                            "тот, кто занимается альпинизмом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776d7d7b-34f3-4409-aab3-b2d6e5769e3a",
                                                "sense_id": "44fafe0d-c09a-38b9-9d79-34451476a5e1",
                                                "text": "Я достал принесённую верёвку, на захваченный с собою крепкий брусок навязал петлю и продел в неё сложенную вдвойне верёвку для спуска известным альпинистам способом, называемым дюльфером."
                                            },
                                            {
                                                "example_id": "5372feb8-610b-4ac9-8e3e-0903a5c85a0e",
                                                "sense_id": "44fafe0d-c09a-38b9-9d79-34451476a5e1",
                                                "text": "В этом историческом восхождении участвовало 18 альпинистов, из них 5 женщин."
                                            },
                                            {
                                                "example_id": "840eb03e-503e-495a-8104-0518af421d6c",
                                                "sense_id": "44fafe0d-c09a-38b9-9d79-34451476a5e1",
                                                "text": "Последние иностранцы, посетившие Кавказ, были егеря знаменитой дивизии «Эдельвейс», герои сражений в Норвегии и на Кипре, альпинисты и горнолыжники высокой выучки, прекрасно научившиеся убивать в горах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
