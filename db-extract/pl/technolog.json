                                        "sense_id": "f58cfa9b-8e8c-397e-9e9e-b577c0a0088b",
                                        "entry_id": "4f4d58be-3d3e-3153-a6ab-e1eb5424eab7",
                                        "glosses": [
                                            "A scientist, engineer, or technician who specializes in a particular technology, or who uses technology in a particular field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a51901-689d-4111-9831-4fac85ce073b",
                                                "sense_id": "f58cfa9b-8e8c-397e-9e9e-b577c0a0088b",
                                                "text": "The technologist must be careful not to overmoisten the disk, as false negative results can occur due to dilution of the end product."
                                            },
                                            {
                                                "example_id": "3e034a69-2baf-441b-b833-8c692527a70d",
                                                "sense_id": "f58cfa9b-8e8c-397e-9e9e-b577c0a0088b",
                                                "text": "Gravity, heat, [and] electromagnetism…are the natural phenomena that scientists study and that engineers and technologists use to make their tools."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
