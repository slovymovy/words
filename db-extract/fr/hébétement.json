                    {
                        "sense_id": "317cbb47-03f7-3b2a-b6c8-a679434e20cc",
                        "entry_id": "c99f835b-8502-30c3-8600-878790ab9821",
                        "glosses": [
                            "Variante orthographique de hébètement."
                        ],
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "examples": [
                            {
                                "example_id": "5793a0dd-e4ad-46b7-aa91-2b6f31a6a599",
                                "sense_id": "317cbb47-03f7-3b2a-b6c8-a679434e20cc",
                                "text": "Ce toucher la réveilla, et elle considéra l'objet d'un regard noyé, avec cet hébétement des sommeils interrompus."
                            },
                            {
                                "example_id": "fe05f613-74bb-4751-bd61-29bb7a8f49d9",
                                "sense_id": "317cbb47-03f7-3b2a-b6c8-a679434e20cc",
                                "text": "Engourdie par une sorte d’hébétement, Marthe ne cherchait même pas de raisons pour s’expliquer le départ de Pierre, pour justifier son silence."
                            },
                            {
                                "example_id": "f251a5b2-ee54-41c7-b3f9-1c6e9fd17471",
                                "sense_id": "317cbb47-03f7-3b2a-b6c8-a679434e20cc",
                                "text": "Et une tristesse rêveuse, un hébétement l’envahissait, qui remplaçait le premier paroxysme de la douleur."
                            },
                            {
                                "example_id": "ffcfef6f-2504-4611-9850-9667cede895f",
                                "sense_id": "317cbb47-03f7-3b2a-b6c8-a679434e20cc",
                                "text": "Sans voir dans son hébétement autre chose qu’une joie submergeante, elles le poussèrent vers le berceau où l’enfant dormait, la tête déjà couverte d’un bonnet de lin."
                            }
                        ]
                    }
                ],
