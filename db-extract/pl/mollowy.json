                        ],
                        "form": "mollowe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32d5df39-188f-3990-bd76-488a0bfb609b",
                        "entry_id": "c5d16e9b-a2e0-33af-af33-f33e36597e81",
                        "glosses": [
                            "w skali muzycznej opartej na gamie z małą tercją między pierwszym a trzecim stopniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b20ab7a-e7d1-40a5-99a8-41e7d8c9b0b8",
                                "sense_id": "32d5df39-188f-3990-bd76-488a0bfb609b",
                                "text": "Lutni \"młodych\" braknie mollowych akordów, tych pełnych, rzewnych dźwięków, które przemawiają do serca, do uczucia."
                            },
                            {
                                "example_id": "295043a6-d314-41b4-a5d3-dd4d76d3cd42",
                                "sense_id": "32d5df39-188f-3990-bd76-488a0bfb609b",
                                "text": "Szeregi są ułożone według koła kwintowego, dwa pierwsze rzędy wydobywają dźwięki pojedyncze, rząd trzeci akordy durowe, czwarty akordy mollowe, piąty czterodźwięki septymowe, szósty trójdźwięki zmniejszone, siódmy trójdźwięki zwiększone."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "08df8457-58ba-3da8-a355-9da026356601",
                        "entry_id": "c5d16e9b-a2e0-33af-af33-f33e36597e81",
                        "glosses": [
                            "wynikający z przygnębienia i niechęci do działania"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "bf53c90e-e035-4b22-bb2c-3ca9405b0537",
                                "sense_id": "08df8457-58ba-3da8-a355-9da026356601",
                                "text": "A rozterki uczonych odbijały się na grze aktorskiej. Wystarczy przypomnieć idealizującą, mollową kreację [Aleksandra] Zelwerowicza i drapieżną sylwetkę [Jana] Kurnakowicza."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48807909-8413-4890-afdf-a1150bfbc269",
                        "source_entry_id": "c5d16e9b-a2e0-33af-af33-f33e36597e81",
                        "source_sense_id": "32d5df39-188f-3990-bd76-488a0bfb609b",
                        "target_lang_word": "moll",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d7bd951-b0e5-3bc4-8927-91620cd3944a",
                                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                                        "glosses": [
                                            "A female companion of a gangster, especially a former or current prostitute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6505bc89-7cbf-4750-a68c-765f5b459654",
                                                "sense_id": "5d7bd951-b0e5-3bc4-8927-91620cd3944a",
                                                "text": "The Bat—they called him the Bat.[…]. He[…]played a lone hand,[…]. Most lone wolves had a moll at any rate—women were their ruin—but if the Bat had a moll, not even the grapevine telegraph could locate her."
                                            },
                                            {
                                                "example_id": "b0acde3d-80d6-4f3c-9a76-44730d848743",
                                                "sense_id": "5d7bd951-b0e5-3bc4-8927-91620cd3944a",
                                                "text": "The nostalgic canonization of the Kennedy presidency, the perfect antidote to the Nixon stench, was befouled by the revelation of Jack Kennedy’s mob-moll paramour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "209462bd-45ad-3cf1-a826-652d75c5ae13",
                                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                                        "glosses": [
                                            "A prostitute or woman with loose sexual morals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f043126c-070c-3686-bd36-7bcacbee9d7e",
                                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                                        "glosses": [
                                            "Bitch, slut; an insulting epithet applied to a female."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47cd53be-9ce0-334d-b225-76bf00f3ce6b",
                                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                                        "glosses": [
                                            "A girlfriend of a bikie."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b38678f-3652-4feb-8a30-67da6169f48a",
                                                "sense_id": "47cd53be-9ce0-334d-b225-76bf00f3ce6b",
                                                "text": "The bikies ‘molls’ included Susan Lloyd as Tart; Victoria Anoux as Flossie; and Rosalind Talamini as Sunshine."
                                            },
                                            {
                                                "example_id": "b2408bfb-0e56-453a-99d8-5272c0fd162a",
                                                "sense_id": "47cd53be-9ce0-334d-b225-76bf00f3ce6b",
                                                "text": "‘Oh God!’ groans Julie who once was a bikie moll back in the early seventies. ‘Hope it′s no one I know.’ But the Machismos turn out to be based on a New Zealand gang, which assembled in Australia after her time."
                                            },
                                            {
                                                "example_id": "2e979287-d728-412e-b66a-0481b098bf7c",
                                                "sense_id": "47cd53be-9ce0-334d-b225-76bf00f3ce6b",
                                                "text": "Gilling first appeared as the biker′s moll Vanessa in Stone (1974) and the beautiful, evil cabin attendant in Number 96 (1974)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5ddfb1c-209c-3128-8c04-31dcd724cea6",
                                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                                        "glosses": [
                                            "A girlfriend of a surfie; blends with pejorative sense."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3947b239-0f21-3107-9cc6-6e743b021ac7",
                                        "entry_id": "a10b17cc-835e-3cf6-9e64-52f43167383f",
                                        "glosses": [
                                            "A female fan of extreme metal, grunge or hardcore punk, especially the girlfriend of a musician of those aforementioned genres."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
