                                "target_senses": [
                                    {
                                        "sense_id": "5a6eb50a-44bb-3384-8ffa-095a5838f516",
                                        "entry_id": "e84974e2-8862-3326-8867-243fc47008e7",
                                        "glosses": [
                                            "Discipline créative et technique consistant à concevoir et organiser des éléments visuels — images, typographies, couleurs, mises en page — afin de communiquer un message ou une identité sur divers supports imprimés ou numériques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a61a607-10cc-4028-b1af-c9ec5e8f547d",
                                                "sense_id": "5a6eb50a-44bb-3384-8ffa-095a5838f516",
                                                "text": "Diplômé de l’université de Yale en architecture et design graphique en 1956, il rejoint trois ans plus tard la société de typographie Mergenthaler Linotype Company."
                                            }
                                        ]
                                    }
                                ]
                            }
