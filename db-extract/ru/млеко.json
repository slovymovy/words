                "senses": [
                    {
                        "sense_id": "707ef960-a828-30a8-bf67-cade0eb45f4c",
                        "entry_id": "d21ad2aa-fddf-31cd-85a4-c9228c84d988",
                        "glosses": [
                            "устар., церк.-книжн., трад.-поэт. то же, что молоко (в знач. «секрет грудной железы», «пища»)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4307b6bd-67d2-46e3-97b8-f4ff05eb2a0b",
                                "sense_id": "707ef960-a828-30a8-bf67-cade0eb45f4c",
                                "text": "Младая лань, своих лишась любезных чад, // Еще сосцы млеко́м имея отягченны, // Нашла в лесу двух малых волченят // И стала выполнять долг матери священный, // Своим питая их млеко́м."
                            },
                            {
                                "example_id": "364a937a-cc35-4190-9e7d-981bd1572acd",
                                "sense_id": "707ef960-a828-30a8-bf67-cade0eb45f4c",
                                "text": "Недугом суетных забот // Сердца счастливцев не страдали: // Млеко овец, душистый мед // Их жизнь бродячую питали."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d9ab946-749e-45e1-b3e7-da6ed5a5e5a8",
                        "source_entry_id": "d21ad2aa-fddf-31cd-85a4-c9228c84d988",
                        "source_sense_id": "707ef960-a828-30a8-bf67-cade0eb45f4c",
                        "target_lang_word": "leche",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leche",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "34eae711-16f5-348f-afe6-eaa95a29336f",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Sustancia líquida de color blanco y de alto valor nutritivo que se produce en las mamas de las hembras de los mamíferos para alimentar a sus crías. Para consumo humano es común emplear la producida por vacas, ovejas, búfalas o cabras."
                                        ],
                                        "tags": [
                                            "Bebidas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c662264c-c403-4e35-9c2b-0ae5bd071df4",
                                                "sense_id": "34eae711-16f5-348f-afe6-eaa95a29336f",
                                                "text": "ningut mantenimiento non le cumple tanto commo la leche & la mejor de las leches es la dela muger & mamandola es mejor & la segunda de las asnas & la terçera delas cabras."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e2a7e28-b2f6-3d83-8354-1b3aa46ee33d",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Por extensión, zumo blanco que tienen algunas plantas, frutos o semillas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbbeb32-dab8-4f73-ade2-fe8a3b2b271a",
                                                "sense_id": "1e2a7e28-b2f6-3d83-8354-1b3aa46ee33d",
                                                "text": "No se cura sino con aguas de rostro de leches de dormideras, pepitas de calabaça, taragontia, alcanfor, borrax, alquitira y otros adherentes."
                                            },
                                            {
                                                "example_id": "16b72a6c-5be6-482d-b431-39db09a283de",
                                                "sense_id": "1e2a7e28-b2f6-3d83-8354-1b3aa46ee33d",
                                                "text": "La contoya es una delgada vara de hojas largas, cuyas flores provocan el estornudo. El pecíolo desgajado rezuma una leche blanca y tres gotas de ella purgan el vientre del hombre."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ad1a8b1-592a-3a02-bc9f-71543cb5a835",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Primera enseñanza que se da a un niño."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "43729ba6-893d-35cb-b529-0de6ce9b5c5b",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Suerte o fortuna que tiene uno en algún asunto, especialmente si muy favorable."
                                        ],
                                        "tags": [
                                            "Ecuador",
                                            "El-Salvador",
                                            "Guatemala",
                                            "Honduras",
                                            "Nicaragua",
                                            "Río-de-la-Plata",
                                            "Venezuela",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19766de-262c-41b7-a749-b5b1c901ddfd",
                                                "sense_id": "43729ba6-893d-35cb-b529-0de6ce9b5c5b",
                                                "text": "—Fue después. A Tico se le ocurrió dar curvas en marcha atrás por Atocongo. Se tiró contra un poste. ¿Ves esta cicatriz? Y él no se hizo nada, no es justo. ¡Tiene una leche!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "bbde950f-1989-39d6-bb2c-4db7aabb926a",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Líquido viscoso y blanquecino producido por las glándulas del tracto urogenital masculino que es excretado por el pene durante la eyaculación que acompaña al orgasmo del macho de los mamíferos."
                                        ],
                                        "tags": [
                                            "Mexico",
                                            "Río-de-la-Plata",
                                            "Spain",
                                            "Venezuela",
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4ee00b-9029-4ff4-92c8-8f2e004f1776",
                                                "sense_id": "bbde950f-1989-39d6-bb2c-4db7aabb926a",
                                                "text": "Deseaba quitarle esas playeras, masturbarme con ellas y correrme dentro para que la niña, al volver a introducir su pie sudoroso, tomara contacto directo con mi leche."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "83b0a53e-bf67-36d3-8140-623f5066f3ce",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Preparado cosmético de consistencia cremosa y ligera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f66160c-c12c-40de-8cf7-19c6a5bb6dec",
                                                "sense_id": "83b0a53e-bf67-36d3-8140-623f5066f3ce",
                                                "text": "Se puso el traje de baño, se cubrió con un kimono y metió en un nécessaire una leche hidratante para protegerse la piel del traicionero sol del trópico."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "dc0e629b-50be-38a6-b0fc-12a4ea1c0ff8",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Golpe que se hace en la cara con la palma de la mano."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8325c756-2a04-4f0f-b1cd-d7cecfd8430b",
                                                "sense_id": "dc0e629b-50be-38a6-b0fc-12a4ea1c0ff8",
                                                "text": "—No me des el día —le gritó Rafael—. Si me cabreas, de una leche te pongo los dientes por peineta."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "38599869-e7bd-3511-b889-dd8375050b86",
                                        "entry_id": "033abc99-51dd-33d1-b8fb-6bf771387f34",
                                        "glosses": [
                                            "Golpe fortuito."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27ad797-47b4-4c4b-be1d-f5879aadba38",
                                                "sense_id": "38599869-e7bd-3511-b889-dd8375050b86",
                                                "text": "¿Qué ta pasao en ese ojo? —Preguntó el chico sorprendido. —Me pegué una leche contra el pomo de la puerta. Nada grave."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            },
                            {
                                "target_word": "leche",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "889e2b33-58a7-353f-a07a-7e31e9120ffd",
                                        "entry_id": "fb4ff374-f7ff-3e86-8008-4336120eaa04",
                                        "glosses": [
                                            "Úsase para expresar enfado, disgusto o decepción."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "539b26d1-f943-4c41-a9b1-04dd58a36485",
                                                "sense_id": "889e2b33-58a7-353f-a07a-7e31e9120ffd",
                                                "text": "—¡Claro, hombre, leche! ¡Está más claro que la hostia!"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
