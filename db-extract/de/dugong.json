                                    {
                                        "sense_id": "4d63a0fd-89ed-3284-80eb-961956188d6d",
                                        "entry_id": "36bc0f36-6bb2-3145-bbb6-8eb9a375cdbe",
                                        "glosses": [
                                            "mammifero marino erbivoro, di notevoli dimensioni, che può raggiungere i 4 metri di lunghezza e i 500 Kg e la spessa pelle è di colore grigio; l'apertura boccale è composta da placche e setole, rischia l'estinzione; la sua classificazione scientifica è Dugong dugon ( tassonomia)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36bcecbe-e166-443e-b285-0407819a1683",
                        "source_entry_id": "7199dca1-d6c6-33f9-8e4d-ec808c7c1362",
                        "source_sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                        "source_sense_description": "herbivores Säugetier, das pazifische Küstengewässer sowie die des Roten Meeres bewohnt",
                        "target_lang_word": "doejong",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doejong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "130d0f1a-e967-3b06-ae67-a0c3d76099f8",
                                        "entry_id": "7c23de78-fd9b-3064-9016-171a6a0b49a6",
                                        "glosses": [
                                            "bepaald soort in het water levend zoogdier, Dugong dugon, dat voorkomt langs de kusten van de Indische Oceaan en het zuidwesten van de Stille Oceaan"
                                        ],
                                        "tags": [
                                            "zeekoeien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c273f2-0382-4c40-aefd-41e875082367",
                                                "sense_id": "130d0f1a-e967-3b06-ae67-a0c3d76099f8",
                                                "text": "In het donker zag je doejongs, grijze zeekoeien van een meter of drie lang, als donkere gestalten langs je boot glijden, het maanlicht weerkaatste op hun brede ruggen."
                                            },
                                            {
                                                "example_id": "513169a4-8640-45ee-8adb-f390446c096f",
                                                "sense_id": "130d0f1a-e967-3b06-ae67-a0c3d76099f8",
                                                "text": "De uitgestrekte zeegrasvelden voor de kust van de Indonesische eilanden vormen het terrein van de doejong, of Indische zeekoe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
