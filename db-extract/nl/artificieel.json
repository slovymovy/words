                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d42d75f-4356-32af-bcc0-8d384501a6d1",
                        "entry_id": "8cc3cee6-93a8-3485-b444-aa9484e13472",
                        "glosses": [
                            "kunstmatig (ook )"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b9628f-8a95-450f-900d-28e7b5f9a19a",
                                "sense_id": "7d42d75f-4356-32af-bcc0-8d384501a6d1",
                                "text": "Boven de rand van de artificiële Nijl doken de hoofden van Max en Dennis gelijktijdig op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fd2af5c-5886-4b33-8b12-112af5015c54",
                        "source_entry_id": "8cc3cee6-93a8-3485-b444-aa9484e13472",
                        "source_sense_id": "7d42d75f-4356-32af-bcc0-8d384501a6d1",
                        "source_sense_description": "kunstmatig",
                        "target_lang_word": "artificial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artificial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e9ae31c-b54f-3a8b-956c-e0b5bea99fa4",
                                        "entry_id": "7c9981b7-7a72-38b4-97a8-bfd8331732fc",
                                        "glosses": [
                                            "Man-made; made by humans; of artifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d15504-2d4e-463a-800b-c1d4ccc7089b",
                                                "sense_id": "2e9ae31c-b54f-3a8b-956c-e0b5bea99fa4",
                                                "text": "The flowers were artificial, and he thought them rather tacky."
                                            },
                                            {
                                                "example_id": "32c1c2dc-c002-4a89-ad24-397962486e07",
                                                "sense_id": "2e9ae31c-b54f-3a8b-956c-e0b5bea99fa4",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ff560d-3ef6-3e7b-939b-418ec6e3972a",
                                        "entry_id": "7c9981b7-7a72-38b4-97a8-bfd8331732fc",
                                        "glosses": [
                                            "Insincere; fake, forced, or feigned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca2287f2-1e3c-488a-adcf-1a5fa1f1c6c9",
                                                "sense_id": "28ff560d-3ef6-3e7b-939b-418ec6e3972a",
                                                "text": "Her manner was somewhat artificial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                                        "entry_id": "7c9981b7-7a72-38b4-97a8-bfd8331732fc",
                                        "glosses": [
                                            "Not natural or normal: imposed arbitrarily or without regard to the specifics or normal circumstances of a person, a situation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb7a225-1bce-4a2d-8422-acd7d513aabe",
                                                "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                                                "text": "“How quickly have I fallen!” thought Tarzan; but in his heart he did not consider it a fall—rather, he pitied the poor creatures of Paris, penned up like prisoners in their silly clothes, and watched by policemen all their poor lives, that they might do nothing that was not entirely artificial and tiresome."
                                            },
                                            {
                                                "example_id": "4182aef8-7f76-43b3-b2da-08cfa4e8aafd",
                                                "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                                                "text": "This results in an artificial conflation of the individual crises experienced by Western European states and leads to imprecise judgements on the impact of Marshall. This confusing conflation is not simply the product of retrospection."
                                            },
                                            {
                                                "example_id": "c33a1a77-0c85-47c8-aae9-383a87fb99f8",
                                                "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                                                "text": "[If] the economic literature of the eighteenth century is examined in terms other than the narrow categories of free trade and protection, the artificial division between the seventeenth and the eighteenth centuries would break down ."
                                            },
                                            {
                                                "example_id": "1ae026ea-1655-46a4-904a-b6bad4d0e5a6",
                                                "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                                                "text": "In Alberta, for example, policy documents reinforce an artificial distinction between leadership-related activity and management."
                                            },
                                            {
                                                "example_id": "1ed75bfe-7d0f-4228-8f0d-c07d84efe028",
                                                "sense_id": "fadd9dd9-f91d-322f-8d06-f2a2fa141204",
                                                "text": "The method of suppression is generally either an artificial conflation of public and private, in which the public is represented as private, or an artificial separation of public from private, which distracts attention from the public[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db5a8e3a-0a33-312e-943a-c0aa2493e2f4",
                                        "entry_id": "7c9981b7-7a72-38b4-97a8-bfd8331732fc",
                                        "glosses": [
                                            "Based on characteristics useful for identification, without regard for the formal differences used in classification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a8aa40-9841-47dc-860d-f255e568d22f",
                                                "sense_id": "db5a8e3a-0a33-312e-943a-c0aa2493e2f4",
                                                "text": "Artificial keys are devised purely to facilitate determination […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816cf6c2-ed0d-3899-ab70-44023d2f1ea8",
                                        "entry_id": "7c9981b7-7a72-38b4-97a8-bfd8331732fc",
                                        "glosses": [
                                            "Conveying some meaning other than the actual contents of one's hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d178f04-be0f-4880-9e96-22e14a327ae5",
                                                "sense_id": "816cf6c2-ed0d-3899-ab70-44023d2f1ea8",
                                                "text": "An artificial bid doesn't necessarily show length in the suit being bid, it has an altogether different meaning."
                                            },
                                            {
                                                "example_id": "99e6a6ed-f727-48ed-af9a-9118481d99f0",
                                                "sense_id": "816cf6c2-ed0d-3899-ab70-44023d2f1ea8",
                                                "text": "North makes an artificial call of 3♧, the cheapest suit at the 3 level, to show a very poor hand. What North holds in clubs doesn't matter at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a0439cc-1aac-49b6-ad14-67a3ef436737",
                        "source_entry_id": "8cc3cee6-93a8-3485-b444-aa9484e13472",
                        "source_sense_id": "7d42d75f-4356-32af-bcc0-8d384501a6d1",
                        "source_sense_description": "kunstmatig",
                        "target_lang_word": "artificiel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artificiel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "882b8be2-74b7-365c-95fa-f5736f7abffc",
                                        "entry_id": "143beae0-cd9b-322b-8f5a-a50aa9201771",
                                        "glosses": [
                                            "Qui remplace la nature par l’art ou l’artifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b784ad5-5c0f-48a6-9360-44054bbead68",
                                                "sense_id": "882b8be2-74b7-365c-95fa-f5736f7abffc",
                                                "text": "Les variétés d’eau de table artificielles qui pourront se produire dans la suite feront l’objet d’une réglementation spéciale."
                                            },
                                            {
                                                "example_id": "d682434b-93ad-479b-95ea-a968d4b25984",
                                                "sense_id": "882b8be2-74b7-365c-95fa-f5736f7abffc",
                                                "text": "Les pois égouttés doivent présenter la couleur normale caractéristique des pois secs trempés en conserve, compte tenu de toute adjonction de colorants artificiels."
                                            },
                                            {
                                                "example_id": "ba19c6bd-f638-4e1d-8664-8821a6514fd5",
                                                "sense_id": "882b8be2-74b7-365c-95fa-f5736f7abffc",
                                                "text": "Je me souviens vaguement des traits de la gamine, une blondine coiffée d’un chapeau de paille orné de cerises artificielles, avec une robe en lingerie blanche, percée de trou-trous ourlés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b5e12f3-362e-3c6f-a58b-1e1fcd0493fb",
                                        "entry_id": "143beae0-cd9b-322b-8f5a-a50aa9201771",
                                        "glosses": [
                                            "Peu naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e095646b-5489-4320-9715-ce0b86c292a5",
                                                "sense_id": "0b5e12f3-362e-3c6f-a58b-1e1fcd0493fb",
                                                "text": "La limite de l’Olivier, bien qu’artificielle, puisque c’est une plante cultivée, est la meilleure limite de la flore méditerranéenne en France."
                                            },
                                            {
                                                "example_id": "00d8e091-3737-4b1f-ab01-2e06884d632c",
                                                "sense_id": "0b5e12f3-362e-3c6f-a58b-1e1fcd0493fb",
                                                "text": "Beauté artificielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca851a37-814f-3962-96df-8f559d1c7c26",
                                        "entry_id": "143beae0-cd9b-322b-8f5a-a50aa9201771",
                                        "glosses": [
                                            "Créé par l’Homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546875e1-5d40-4c0f-ad46-18d53f7bd9b1",
                                                "sense_id": "ca851a37-814f-3962-96df-8f559d1c7c26",
                                                "text": "De nombreux jaunes, par exemple, qu’ils soient d’origine naturelle (flavoniques) ou artificielle (azoïques) présentent une fluorescence non négligeable."
                                            },
                                            {
                                                "example_id": "bebbdb96-25af-4f95-8261-3d02872e9f4d",
                                                "sense_id": "ca851a37-814f-3962-96df-8f559d1c7c26",
                                                "text": "Au nez et à la barbe des habitants, le vert envahit Paris, concurrence les lumières artificielles dont le pare l’hiver et qui s’en trouvent flétries."
                                            },
                                            {
                                                "example_id": "ab71075f-32f7-4396-b660-589145e44af6",
                                                "sense_id": "ca851a37-814f-3962-96df-8f559d1c7c26",
                                                "text": "Bien que nous parlions de céréaliculteur, il faut se rappeler que l’exploitant de la Plaine ne pratique aucunement la monoculture des céréales. Si l’essentiel de son revenu est procuré par les grains, le reste provient de cultures industrielles, tel le colza, et de l’élevage rendu possible par l’extension des prairies artificielles."
                                            },
                                            {
                                                "example_id": "7291d572-a991-4a28-a0c3-fdbe3a6dd4e5",
                                                "sense_id": "ca851a37-814f-3962-96df-8f559d1c7c26",
                                                "text": "Au sens littéral, « artificiel » signifie fait par l’art, c’est-à-dire par l’habileté, par l’adresse humaine, et non par la nature. Intelligence artificielle signifie donc « intelligence fabriquée »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "205d64aa-5158-3015-a4ff-3693a865ba17",
                                        "entry_id": "143beae0-cd9b-322b-8f5a-a50aa9201771",
                                        "glosses": [
                                            "Créé de toutes pièces, inventé, programmé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb81dc8d-0b05-32e8-bcae-65c68af7a809",
                                        "entry_id": "143beae0-cd9b-322b-8f5a-a50aa9201771",
                                        "glosses": [
                                            "Qualifie les langues fabriquées par les philologues."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b21eafb-a8a7-462f-a10d-fc7fbce37dc6",
                                                "sense_id": "bb81dc8d-0b05-32e8-bcae-65c68af7a809",
                                                "text": "Il faut une langue commune pour permettre vraiment des discussions. A cet effet il serait précieux d’avoir une langue aisée à apprendre et qui n’avantagerait personne. Seule, une langue artificielle répond à cette double exigence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6842e791-ae1e-334d-80f4-a0ecc9ce659e",
                                        "entry_id": "143beae0-cd9b-322b-8f5a-a50aa9201771",
                                        "glosses": [
                                            "Qui n’est pas selon la nature, qui est factice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bf616bc-63a5-4d06-8bf2-52efe2da8eb8",
                                                "sense_id": "6842e791-ae1e-334d-80f4-a0ecc9ce659e",
                                                "text": "Mener une vie artificielle."
                                            },
                                            {
                                                "example_id": "6076790a-2ea7-4afe-8cd5-6b0bdd8b8df8",
                                                "sense_id": "6842e791-ae1e-334d-80f4-a0ecc9ce659e",
                                                "text": "Un enthousiasme artificiel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
