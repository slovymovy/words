                "senses": [
                    {
                        "sense_id": "9fca2583-223d-393e-b6db-1013a26ee014",
                        "entry_id": "39937df9-d240-3821-b290-40607d2c0c24",
                        "glosses": [
                            "US-amerikanische Drogenbekämpfungsbehörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77b17361-2e85-406c-8c51-727f3fb82edb",
                                "sense_id": "9fca2583-223d-393e-b6db-1013a26ee014",
                                "text": "„Der Agent der DEA hieß McIntyre.“"
                            },
                            {
                                "example_id": "12775789-3532-4101-bb2b-ea4d8ac18cba",
                                "sense_id": "9fca2583-223d-393e-b6db-1013a26ee014",
                                "text": "„Pablo flüchtete nach Managua, und unterwegs wäre er beinahe der DEA in die Hände gefallen.“"
                            },
                            {
                                "example_id": "33c73a3a-c4f2-49a1-afa8-bd5bfaba1a0c",
                                "sense_id": "9fca2583-223d-393e-b6db-1013a26ee014",
                                "text": "„Die beiden führten in dieser Sache zwei Jahre lang Ermittlungen für die DEA.“"
                            },
                            {
                                "example_id": "860af125-d495-4815-ae6f-71360f71df1b",
                                "sense_id": "9fca2583-223d-393e-b6db-1013a26ee014",
                                "text": "„›Ich darf euch Special Agent Chris Lombardi der DEA vorstellen‹, sagte Beukes und deutete auf den Mann mit der roten Krawatte.“"
                            },
                            {
                                "example_id": "813c3365-d7b8-4684-94bf-3760ac542291",
                                "sense_id": "9fca2583-223d-393e-b6db-1013a26ee014",
                                "text": "„Es gab ganz offensichtlich einen Interessenkonflikt zwischen der DEA und dem CIA, der jede peinliche Enthüllung über Drogenverbindungen zwischen den ›heroischen‹ Mudschaheddin und pakistanischen Beamten und Drogenhändlern und der eigenen Organisation meiden wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
