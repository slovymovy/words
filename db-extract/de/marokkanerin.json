                "senses": [
                    {
                        "sense_id": "bd2c6620-a115-31c5-a979-f106002799ab",
                        "entry_id": "62df375b-2106-3626-a77d-ca26aadd7f5e",
                        "glosses": [
                            "Staatsbürgerin von Marokko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff40dd5-efa9-470f-8553-32745f1ece75",
                                "sense_id": "bd2c6620-a115-31c5-a979-f106002799ab",
                                "text": "Von ihren Reisen brachte Theos Schwester viele Fotos von Marokkanerinnen mit, die sie in Marrakesch gemacht hatte."
                            },
                            {
                                "example_id": "ccbfdec9-3a60-481e-80b2-fc6ebd05b7bd",
                                "sense_id": "bd2c6620-a115-31c5-a979-f106002799ab",
                                "text": "„Nein, dachte ich, mit Marokkanerinnen hat Rudi wirklich kein Glück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "953f3eed-eaba-4a2d-8888-2d9ba18c8ee5",
                        "source_entry_id": "62df375b-2106-3626-a77d-ca26aadd7f5e",
                        "source_sense_id": "bd2c6620-a115-31c5-a979-f106002799ab",
                        "source_sense_description": "Staatsbürgerin von Marokko",
                        "target_lang_word": "Moroccan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moroccan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2af2beb4-2bef-31f4-a2a5-8605899ce06d",
                                        "entry_id": "7d6e1b0f-5858-37be-9631-16218b976c6a",
                                        "glosses": [
                                            "A person from Morocco or of Moroccan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67862d36-4d45-4238-ae9c-0d22e4afbec1",
                                                "sense_id": "2af2beb4-2bef-31f4-a2a5-8605899ce06d",
                                                "text": "The group is accused of defaming the state after a British nonprofit, Privacy International, wrote a report based on the testimony of four Moroccans who say they were targets of cybersurveillance by the government."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Moroccan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea84c4f-2a64-344a-869e-b8b764cc3e27",
                                        "entry_id": "a7ea4d8e-138f-386e-8413-2c81d818dc5f",
                                        "glosses": [
                                            "Of, from, or pertaining to Morocco or the Moroccan people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b8f351-079a-455d-9dfb-540876a64e2d",
                                                "sense_id": "7ea84c4f-2a64-344a-869e-b8b764cc3e27",
                                                "text": "Another sauce, mainly used as a condiment, is harissa, made from pulverised chillies, garlic, salt and olive oil. Harissa is not generically Moroccan, but nevertheless is often found accompanying tajines and couscous."
                                            },
                                            {
                                                "example_id": "cda29019-6296-4960-8ba5-0c9b29c35d77",
                                                "sense_id": "7ea84c4f-2a64-344a-869e-b8b764cc3e27",
                                                "text": "Moroccan curried crab and streaks of minty, lemony yogurt add luxury to a supersimple zucchini soup ($14)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eafe6b5a-7642-4452-87b5-55676a4665dd",
                        "source_entry_id": "62df375b-2106-3626-a77d-ca26aadd7f5e",
                        "source_sense_id": "bd2c6620-a115-31c5-a979-f106002799ab",
                        "source_sense_description": "Staatsbürgerin von Marokko",
                        "target_lang_word": "Marocaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marocaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe502c8-d127-3fd9-a45a-188055940b99",
                                        "entry_id": "421cee08-ea4b-3fb7-a93d-dbb59ca2d575",
                                        "glosses": [
                                            "Habitante du Maroc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a95819-3d3e-4a63-8579-92b65ef282c9",
                                                "sense_id": "ffe502c8-d127-3fd9-a45a-188055940b99",
                                                "text": "Au Maroc, une large majorité de Marocaines a affirmé ne pas souhaiter la réforme du ta’sib, cette très ancienne règle qui stipule que les femmes doivent hériter moitié moins que les hommes."
                                            },
                                            {
                                                "example_id": "34e5ecb5-d625-4441-a3bb-62a8e765b188",
                                                "sense_id": "ffe502c8-d127-3fd9-a45a-188055940b99",
                                                "text": "De l’autre côté, le duo Eugénie Le Sommer - Kadidiatou Diani va confronter enfin sa connexion à une défense plus agressive emmenée par la Lyonnaise Ellie Carpenter, après avoir fait beaucoup de mal à celle plus faible des Marocaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
