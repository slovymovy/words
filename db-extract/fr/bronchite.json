                                        "entry_id": "bc61a1d0-1c26-3033-833d-e0e1e579be47",
                                        "glosses": [
                                            "An inflammation of the bronchi of the lungs, that causes the cilia of the bronchial epithelial cells to stop functioning."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c923332-dfee-418a-b500-d7110e9e9f6f",
                                                "sense_id": "65e8690c-1ab5-38a6-b80e-81c582a2d629",
                                                "text": "Histological examination showed neutrophilic or pleocellular proliferative necrotizing bronchitis and bronchiolitis in all (6 out of 6) infected steers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5564c1a1-3a4c-399d-9041-a465d74f7091",
                                        "entry_id": "bc61a1d0-1c26-3033-833d-e0e1e579be47",
                                        "glosses": [
                                            "An occurrence of, a case (patient) of, or a type of bronchitis."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
