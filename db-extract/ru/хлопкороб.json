                "senses": [
                    {
                        "sense_id": "af387cb9-f641-34f3-bd16-0d011313b9ba",
                        "entry_id": "53cf53a6-40fb-3f0a-b623-9efc9ec815de",
                        "glosses": [
                            "тот, кто занимается выращиванием хло́пка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "873e93c4-e6e2-4a55-87e6-190dad7b0ea9",
                                "sense_id": "af387cb9-f641-34f3-bd16-0d011313b9ba",
                                "text": "После дождей хивинские хлопкоробы жалуются на низкую воду в Аму-Дарье остановившую поливку полей."
                            },
                            {
                                "example_id": "199faff2-4b5c-4640-8733-1f6a78620906",
                                "sense_id": "af387cb9-f641-34f3-bd16-0d011313b9ba",
                                "text": "Смуглые настороженные лица, спаленные до черноты шеи, грубые мужицкие руки ― руки трактористов, кетменщиков, хлопкоробов."
                            }
                        ]
                    }
