                "senses": [
                    {
                        "sense_id": "3ca2587b-d36e-303c-8926-c239ec09cfb4",
                        "entry_id": "83316338-9ff3-393e-a9c8-776c8704c384",
                        "glosses": [
                            "Not cooperating; rebellious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40d586c-4af6-4384-968a-bd06379434fe",
                                "sense_id": "3ca2587b-d36e-303c-8926-c239ec09cfb4",
                                "text": "It was directed toward a program, \"Tuesday's Child,\" which endorses systematic, unquestioning rejection by parents of the program-created noncompliant behaviors in their eighteen-month- to five-year-old children."
                            }
                        ]
                    },
                    {
                        "sense_id": "f890fb86-a137-3294-8084-de8f8c64ca00",
                        "entry_id": "83316338-9ff3-393e-a9c8-776c8704c384",
                        "glosses": [
                            "Not complying with certain rules or regulations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5bc030-bb5c-492a-92d9-82d7283028eb",
                                "sense_id": "f890fb86-a137-3294-8084-de8f8c64ca00",
                                "text": "We just need to finish up a couple of things on the project, to make sure nothing's left noncompliant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f727085-7e1a-45e1-af1b-359c99439969",
                        "source_entry_id": "83316338-9ff3-393e-a9c8-776c8704c384",
                        "source_sense_description": "not compliant, wayward, insubordinate, rebellious",
                        "target_lang_word": "ungehorsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungehorsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                        "entry_id": "a2dc76a2-059e-3d7d-b6b4-332b6368f946",
                                        "glosses": [
                                            "nicht bereit, einem Befehl/einer Anordnung/einer Aufforderung zu folgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb959eb9-bf16-4a01-80ba-5e37bd4957ab",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "„Wenn Du weiter so ungehorsam bist, gibt’s eine Woche Fernsehvebot!“"
                                            },
                                            {
                                                "example_id": "b597c0f1-a7a4-4dca-a6bf-f773d7b94f2e",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "In seinem umstrittenen Buch [Struwwelpeter] erzählt [Heinrich] Hoffmann in mehreren kurzen Geschichten von ungehorsamen Kindern, die alle am Ende eine schlimme Strafe erwartet."
                                            },
                                            {
                                                "example_id": "7469d8fa-56ef-4c1f-aab5-30e57e67b515",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "Im Kloster soll früher jemand, der ungehorsam war, dadurch bestraft worden sein, dass er auf dem Fußboden oder an einem niedrigen Tisch, dem Katzentisch, sitzen musste."
                                            },
                                            {
                                                "example_id": "cd0bc88a-c27d-4cf9-9c51-b87f425a4c62",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "[Schlagzeile:] Ungehorsame Pfarrer wollen Reform - Geschiedene Katholiken, die wieder heiraten, sind laut römischem Kirchenrecht Ehebrecher. Pfarrern ist verboten, ihnen die Kommunion auszuteilen. Eine Freiburger Pfarrerinitiative opponiert gegen die Regel."
                                            },
                                            {
                                                "example_id": "7483cd98-01d8-475f-a489-0602cb298dd0",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "Weigert ihr euch aber und seid ungehorsam, so sollt ihr vom Schwert gefressen werden; […]"
                                            },
                                            {
                                                "example_id": "d33aed9d-a38d-457e-98b6-6a9dc94e4ff7",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "Er [Salafistenprediger Mohammed al Arifiaus aus Saudi-Arabien] propagiert etwa Körperstrafen für „ungehorsame“ Frauen oder Homosexuelle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
