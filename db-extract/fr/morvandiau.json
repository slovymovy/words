                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf5d5bc5-a8dd-3bbf-b663-aac161ceabce",
                        "entry_id": "a143e413-879a-3097-9c24-9bad5b3f7a03",
                        "glosses": [
                            "Morvandeau."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "daf079a0-223a-4f5d-acbb-cc26ec8b75e8",
                                "sense_id": "bf5d5bc5-a8dd-3bbf-b663-aac161ceabce",
                                "text": "Voilà une existence qui n'a rien à voir avec celle que j'ai connue dans un bourg morvandiau, au milieu des toucheurs de bœufs et des mineurs."
                            },
                            {
                                "example_id": "b2179e88-5454-44e0-bb74-f5d22f9b3028",
                                "sense_id": "bf5d5bc5-a8dd-3bbf-b663-aac161ceabce",
                                "text": "Une illusion de printemps fait gazouiller depuis quelques jours dans les bosquets morvandiaux, et cette reverdie prématurée […] m'incite une fois de plus à vous parler d'oiseaux."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d1a5d3ce-b82d-33c2-9a68-904ddb431b2a",
                "word": "Morvandiau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a98c0220-2264-4b02-a65f-6639c61160c4",
                        "entry_id": "d1a5d3ce-b82d-33c2-9a68-904ddb431b2a",
