                        "source_sense_id": "88a4f8fd-52aa-33e3-9564-ab22b2eec1ee",
                        "target_lang_word": "charitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charitable",
