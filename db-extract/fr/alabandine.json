                        "examples": [
                            {
                                "example_id": "fcea0028-3438-4b0e-9179-77021d29c177",
                                "sense_id": "66adeec6-5b55-375f-bbc0-52ef789acfc5",
                                "text": "Elle est vêtue d’un ample manteau de lin brun que ferme une grosse broche pisciforme sertie d’alabandines."
                            },
                            {
                                "example_id": "48022a22-6856-44d3-97df-86f8d65d12fb",
                                "sense_id": "66adeec6-5b55-375f-bbc0-52ef789acfc5",
                                "text": "D’après Sales et Meyer, cet élément se retrouve dans la zone périphérique où l’on observe la transformation de carbonate de manganèse (rhodocrocite) en sulfure de manganèse (alabandine)."
                            }
                        ]
                    }
