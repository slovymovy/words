        "fr-extract.jsonl": [
            {
                "entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
                "word": "spontanément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                        "entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
                        "glosses": [
                            "D’une manière spontanée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef8fc77-9dc0-460f-9086-295bf6d1c5aa",
                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                "text": "Les uns admettent que l'atmosphère transporte les germes du corps vibrionnaire; les autres pensent, au contraire, que ces germes se forment spontanément dans la matière fermentescible."
                            },
                            {
                                "example_id": "0a42b946-2148-4d21-a117-433f98e0932f",
                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                "text": "À l'époque du frai, il pousse spontanément un petit cri peu harmonieux, qui participe de l'aboiement du roquet et du pépiement du poussin."
                            },
                            {
                                "example_id": "38db0772-4fdb-426a-aeeb-12b029398e25",
                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                "text": "Il faut que tous les incidents qui font sortir le caractère, soient naturellement amenés, de façon que chaque circonstance paraisse naître spontanément pour seconder l’intention du peintre,"
                            },
                            {
                                "example_id": "d17b111a-e10b-4fd9-92dd-a9db5850fd2a",
                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                "text": "Ce jour-là, au moment de la séparation, spontanément, avec un sourire heureux, Yasmina lui donna un baiser, le premier..."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e3a0d25-3fb2-31a6-9c97-21f9911f5f78",
                        "entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
                        "glosses": [
                            "D'une manière naturelle ; sans intervention humaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107f3dfe-b7c9-4296-82b4-9f27ce7a39e0",
                                "sense_id": "6e3a0d25-3fb2-31a6-9c97-21f9911f5f78",
                                "text": "Et pourtant les figuiers s'obstinent à pousser spontanément parmi les gravats et je me gorge, sans rien payer, de leurs fruits cramoisis."
                            },
                            {
                                "example_id": "747386a1-1b7f-4e2a-9d5b-54eb6bfd2ce3",
                                "sense_id": "6e3a0d25-3fb2-31a6-9c97-21f9911f5f78",
                                "text": "[…]; d'autre part, la nature d'un terrain non agricole, spontanément, ce n'est pas le bois, mais la broussaille, la friche, la lande, la ginestaie, la garrigue, la genévraie, le maquis, la pelouse rase... ou le désert !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30f499e3-a217-43a8-b1a2-61c16c7efbd0",
                        "source_entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
                        "target_lang_word": "spontaneously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontaneously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                                        "entry_id": "bc55a7bc-f2c6-3dd2-b284-35a37bf9da46",
                                        "glosses": [
                                            "In a spontaneous manner; naturally; voluntarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5dc00a-ae09-4b97-8605-448f6289a92f",
                                                "sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                                                "text": "The idea that the body could spontaneously ignite was promoted by the 19th-century temperance movement."
                                            },
                                            {
                                                "example_id": "ed3d3799-255f-4f6b-bed8-1847f5aa1a03",
                                                "sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                                                "text": "Smaller-scale isolated deaf-education programs had existed previously in 20th-century Nicaragua, Shepard-Kegl says, but the critical mass needed to spontaneously develop Nicaraguan Sign Language only occurred with the opening of Melania Morales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bab02d7-ed36-409e-95de-fba89a0b380c",
                        "source_entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
