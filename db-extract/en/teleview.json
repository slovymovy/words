                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6b8cdf7d-b3f0-4bd0-a109-4d8e4cd47220",
                                "sense_id": "9ae35fde-7d59-37cd-b10a-cf31a25d6164",
                                "text": "Do children having sets at home do better school work when their parents closely control their televiewing?"
                            },
                            {
                                "example_id": "f7f19656-4cf5-4ca9-ba82-3f0e6f3de6dd",
                                "sense_id": "9ae35fde-7d59-37cd-b10a-cf31a25d6164",
                                "text": "I had a similar experience many years later as I televiewed the Philadelphia Phillies and saw them execute a triple play. Fabulous! Amazing!"
                            }
                        ]
                    }
