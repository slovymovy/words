                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle portait une écharpe rouge assortie à sa chevelure <w>rousse</w>.",
                            "target_lang_translations": {
                                "en": "She wore a red scarf that matched her <w>red</w> hair.",
                                "ru": "Она носила красный шарф, подходивший к её <w>рыжей</w> шевелюре.",
                                "de": "Sie trug einen roten Schal, der zu ihrem <w>roten</w> Haar passte.",
                                "es": "Llevaba una bufanda roja que combinaba con su cabellera <w>pelirroja</w>.",
                                "zh": "她围着一条红围巾，与她<w>红棕色</w>的头发十分相配。"
                            }
                        },
                        {
                            "text": "Une petite chatte <w>rousse</w> dormait paisiblement sur le rebord de la fenêtre.",
                            "target_lang_translations": {
                                "en": "A small <w>ginger</w> she-cat was sleeping peacefully on the windowsill.",
                                "ru": "Маленькая <w>рыжая</w> кошка мирно спала на подоконнике.",
                                "de": "Eine kleine <w>rotbraune</w> Katze schlief friedlich auf dem Fensterbrett.",
                                "es": "Una pequeña gata <w>rojiza</w> dormía tranquilamente en el alféizar de la ventana.",
                                "zh": "一只<w>橘红色</w>的小母猫正安静地在窗台上睡觉。"
