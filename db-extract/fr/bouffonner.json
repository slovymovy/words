                ],
                "senses": [
                    {
                        "sense_id": "24607ab2-29bb-3bd4-a231-e158a4f543dd",
                        "entry_id": "1f09f2a5-3d89-3c07-b54a-e02f63fd1c56",
                        "glosses": [
                            "Faire ou dire des bouffonneries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdf1dcd6-c1b6-48ad-b9ed-a1d8dcd0d503",
                                "sense_id": "24607ab2-29bb-3bd4-a231-e158a4f543dd",
                                "text": "Cet homme ne fait que bouffonner."
                            },
                            {
                                "example_id": "bbedb5d6-d224-4394-9ec1-2f50cc1b76f3",
                                "sense_id": "24607ab2-29bb-3bd4-a231-e158a4f543dd",
                                "text": "Ainsi bouffonnant, il poussait Fleurissoire au travers du vestibule, vers un jardin intérieur formant terrasse où, sous la treille, un repas était préparé."
                            },
                            {
                                "example_id": "251de960-ec4f-4575-ad42-c14cfe9176b8",
                                "sense_id": "24607ab2-29bb-3bd4-a231-e158a4f543dd",
                                "text": "José récitait, en bouffonnant, les passages qu’il trouvait « loufoques »."
                            },
                            {
                                "example_id": "76d6757c-47c4-42d3-8ebd-b131573ede12",
                                "sense_id": "24607ab2-29bb-3bd4-a231-e158a4f543dd",
                                "text": "Il bouffonna avec plus d’extravagance encore que de coutume : « Tu n’as pas fini de faire le fou ! » lui disait sa mère en riant."
                            }
                        ]
                    }
                ],
