                        "entry_id": "26eb433d-4676-3e5a-8655-e857b9d3dba6",
                        "glosses": [
                            "The people elected to government or employed in the civil service."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21d88fad-943b-4f71-bfa6-b95f6cec94f0",
                                "sense_id": "0fe32460-f753-388e-a9d8-17aeee8f65cb",
                                "text": "[Magazine staffer:] In the bag may be the next chief—a wedding to one of officialdom's family will assure certainty."
                            },
                            {
                                "example_id": "5cbff79b-c092-4a6d-b331-6fc7112af6a6",
                                "sense_id": "0fe32460-f753-388e-a9d8-17aeee8f65cb",
                                "text": "An enormous amount of off-book money sloshes around Chinese business and officialdom, and some of it runs into handbags."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb453239-e71e-3e58-a7c6-417b6cb7eb34",
                        "entry_id": "26eb433d-4676-3e5a-8655-e857b9d3dba6",
                        "glosses": [
                            "The state of being official"
                        ],
                        "tags": [
