{
    "word_family": [
        "вина",
        "винить",
        "виновник",
        "виновность",
        "повинность",
        "обвинение",
        "обвинять"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86fe6a5f-aba6-3c91-b96e-69c07d868239",
                    "sense_definition": "Совершивший проступок или преступление, несущий ответственность за что-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они <w>виноваты</w> во всём, что произошло вчера.",
                            "target_lang_translations": {
                                "en": "They are <w>to blame</w> for everything that happened yesterday."
                            }
                        },
                        {
                            "text": "Суд решил, что обвиняемый действительно <w>виноват</w>.",
                            "target_lang_translations": {
                                "en": "The court decided that the defendant was indeed <w>guilty</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "виновный",
                        "повинный"
                    ],
                    "antonyms": [
                        "невиноватый",
                        "невиновный",
                        "непричастный"
                    ],
                    "common_phrases": [
                        "чувствовать себя виноватым",
                        "признать себя виноватым"
                    ],
                    "target_lang_definitions": {
                        "en": "Having committed a wrongdoing or crime, or being responsible for something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guilty",
                                "target_lang_sense_clarification": "responsible for a wrongdoing or having been found to have committed a crime"
                            },
                            {
                                "target_lang_word": "at fault",
                                "target_lang_sense_clarification": "responsible for a mistake or a negative situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18a05357-b8be-382d-bf4d-976342f888ab",
                    "sense_definition": "Являющийся причиной чего-либо нежелательного или неприятного.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Плохая погода <w>виновата</w> в том, что наш рейс задержали.",
                            "target_lang_translations": {
                                "en": "Bad weather is <w>to blame</w> for our flight being delayed."
                            }
                        },
                        {
                            "text": "Сам <w>виноват</w> в своих неудачах, потому что не готовился.",
                            "target_lang_translations": {
                                "en": "You are <w>to blame</w> for your own failures because you didn't prepare."
                            }
                        }
                    ],
                    "antonyms": [
                        "правый"
                    ],
                    "common_phrases": [
                        "сам виноват"
                    ],
                    "target_lang_definitions": {
                        "en": "Being the cause of something undesirable or unpleasant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to blame",
                                "target_lang_sense_clarification": "responsible for a negative outcome or situation"
                            },
                            {
                                "target_lang_word": "responsible",
                                "target_lang_sense_clarification": "the cause of a particular event or state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e5a62c5-320e-3417-afcb-f7565a605dfa",
                    "sense_definition": "Выражающий сознание своей вины, смущение или раскаяние.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он посмотрел на меня с <w>виноватым</w> видом.",
                            "target_lang_translations": {
                                "en": "He looked at me with a <w>guilty</w> expression."
                            }
                        },
                        {
                            "text": "У неё был такой <w>виноватый</w> голос, что я сразу всё простил.",
                            "target_lang_translations": {
                                "en": "She had such a <w>guilty</w> tone of voice that I forgave everything immediately."
                            }
                        }
                    ],
                    "antonyms": [
                        "невинный"
                    ],
                    "common_phrases": [
                        "виноватый вид",
                        "виноватая улыбка"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing a sense of guilt, embarrassment, or remorse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guilty",
                                "target_lang_sense_clarification": "showing or feeling a sense of guilt"
                            },
                            {
                                "target_lang_word": "sheepish",
                                "target_lang_sense_clarification": "showing embarrassment from shame or a lack of self-confidence"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}