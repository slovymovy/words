{
    "word_family": [
        "chatterbox",
        "chattery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                    "sense_definition": "Meaningless or unimportant talk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting was delayed by idle <w>chatter</w> among the staff.",
                            "target_lang_translations": {
                                "tr": "Toplantı, personel arasındaki boş <w>gevezelikler</w> yüzünden gecikti.",
                                "ru": "Встреча задержалась из-за пустой <w>болтовни</w> среди сотрудников."
                            }
                        },
                        {
                            "text": "Ignore the office <w>chatter</w> and focus on your work.",
                            "target_lang_translations": {
                                "tr": "Ofisteki <w>dedikoduları</w> görmezden gel ve işine odaklan.",
                                "ru": "Игнорируй офисные <w>разговоры</w> и сосредоточься на работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "prattle",
                        "small talk",
                        "twaddle"
                    ],
                    "common_phrases": [
                        "idle chatter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Anlamsız veya önemsiz konuşma.",
                        "ru": "Бессмысленный или неважный разговор."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gevezelik",
                                "target_lang_sense_clarification": "Boş, anlamsız veya gereksiz konuşma."
                            },
                            {
                                "target_lang_word": "çene çalma",
                                "target_lang_sense_clarification": "Gelişigüzel, havadan sudan konuşma."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "Пустые, никчёмные разговоры."
                            },
                            {
                                "target_lang_word": "трёп",
                                "target_lang_sense_clarification": "Разговорный, сниженный термин для обозначения пустых разговоров."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                    "sense_definition": "The vocal sounds made by birds or other animals.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning was filled with the <w>chatter</w> of birds in the trees.",
                            "target_lang_translations": {
                                "tr": "Sabah, ağaçlardaki kuşların <w>cıvıltılarıyla</w> doluydu.",
                                "ru": "Утро было наполнено <w>щебетанием</w> птиц на деревьях."
                            }
                        },
                        {
                            "text": "We heard the distant <w>chatter</w> of monkeys deep in the jungle.",
                            "target_lang_translations": {
                                "tr": "Ormanın derinliklerinden gelen uzak maymun <w>seslerini</w> duyduk.",
                                "ru": "Мы слышали далекий <w>стрекот</w> обезьян в глубине джунглей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bird chatter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kuşların veya diğer hayvanların çıkardığı sesler.",
                        "ru": "Звуки, издаваемые птицами или другими животными."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cıvıltı",
                                "target_lang_sense_clarification": "Kuşların çıkardığı neşeli, hızlı sesler."
                            },
                            {
                                "target_lang_word": "ötüşme",
                                "target_lang_sense_clarification": "Hayvanların ses çıkarma eylemi."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "щебетание",
                                "target_lang_sense_clarification": "Характерные звуки, издаваемые птицами."
                            },
                            {
                                "target_lang_word": "стрекот",
                                "target_lang_sense_clarification": "Резкие, повторяющиеся звуки, издаваемые некоторыми животными или насекомыми."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                    "sense_definition": "An intermittent noise caused by vibration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine produced a loud <w>chatter</w> during operation.",
                            "target_lang_translations": {
                                "tr": "Makine çalışırken yüksek bir <w>tıkırtı</w> çıkardı.",
                                "ru": "Во время работы машина издавала громкое <w>дребезжание</w>."
                            }
                        },
                        {
                            "text": "Proper maintenance will help to reduce the <w>chatter</w> in the engine.",
                            "target_lang_translations": {
                                "tr": "Doğru bakım, motordaki <w>tıkırtıyı</w> azaltmaya yardımcı olacaktır.",
                                "ru": "Правильное обслуживание поможет уменьшить <w>стук</w> в двигателе."
                            }
                        }
                    ],
                    "synonyms": [
                        "clatter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Titreşimden kaynaklanan kesintili gürültü.",
                        "ru": "Прерывистый шум, вызванный вибрацией."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tıkırtı",
                                "target_lang_sense_clarification": "Mekanik bir parçanın titreşiminden gelen ses."
                            },
                            {
                                "target_lang_word": "çatırtı",
                                "target_lang_sense_clarification": "Sert parçaların birbirine çarpmasıyla oluşan ses."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дребезжание",
                                "target_lang_sense_clarification": "Звук, возникающий при вибрации механических деталей."
                            },
                            {
                                "target_lang_word": "стук",
                                "target_lang_sense_clarification": "Ритмичный или прерывистый звук ударов."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                    "sense_definition": "Communication between individuals or groups, often monitored for intelligence purposes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Intelligence agencies reported increased <w>chatter</w> on encrypted channels.",
                            "target_lang_translations": {
                                "tr": "İstihbarat teşkilatları, şifreli kanallarda artan bir <w>haberleşme trafiği</w> bildirdi.",
                                "ru": "Разведывательные службы сообщили об усилении <w>переговоров</w> по зашифрованным каналам."
                            }
                        },
                        {
                            "text": "The security alert was based on intercepted <w>chatter</w> from known suspects.",
                            "target_lang_translations": {
                                "tr": "Güvenlik alarmı, bilinen şüphelilerden ele geçirilen <w>istihbarat verilerine</w> dayanıyordu.",
                                "ru": "Предупреждение о безопасности было основано на перехваченных <w>сообщениях</w> известных подозреваемых."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intercepted chatter"
                    ],
                    "target_lang_definitions": {
                        "tr": "İstihbarat amaçlı izlenen, bireyler veya gruplar arasındaki iletişim.",
                        "ru": "Общение между людьми или группами, часто отслеживаемое в целях разведки."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "istihbarat akışı",
                                "target_lang_sense_clarification": "İzlenen iletişim trafiği."
                            },
                            {
                                "target_lang_word": "haberleşme trafiği",
                                "target_lang_sense_clarification": "İstihbarat birimlerince takip edilen iletişim."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переговоры",
                                "target_lang_sense_clarification": "Обмен информацией, часто перехватываемый спецслужбами."
                            },
                            {
                                "target_lang_word": "радиообмен",
                                "target_lang_sense_clarification": "Связь, осуществляемая по техническим каналам."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "599b4609-7d6c-3e56-8cac-d0c4010e3afc",
                    "sense_definition": "A person who talks frequently or excessively.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is such a <w>chatter</w> that she never lets anyone else speak.",
                            "target_lang_translations": {
                                "tr": "O kadar <w>geveze</w> ki, kimsenin konuşmasına asla izin vermiyor.",
                                "ru": "Она такая <w>болтушка</w>, что никогда не дает никому другому сказать ни слова."
                            }
                        },
                        {
                            "text": "The group of <w>chatters</w> kept the whole room awake.",
                            "target_lang_translations": {
                                "tr": "O <w>geveze</w> grubu tüm odayı uyanık tuttu.",
                                "ru": "Группа <w>болтунов</w> не давала спать всей комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "babbler"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sürekli veya aşırı konuşan kişi.",
                        "ru": "Человек, который говорит часто или чрезмерно много."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geveze",
                                "target_lang_sense_clarification": "Çok konuşan kimse."
                            },
                            {
                                "target_lang_word": "lâfazan",
                                "target_lang_sense_clarification": "Çok ve boş konuşan kişi."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "болтун",
                                "target_lang_sense_clarification": "Тот, кто много и часто говорит."
                            },
                            {
                                "target_lang_word": "трепач",
                                "target_lang_sense_clarification": "Разговорный термин для человека, который много говорит пустого."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                    "sense_definition": "To talk in an idle or informal way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat in the cafe to <w>chatter</w> about their weekend plans.",
                            "target_lang_translations": {
                                "tr": "Hafta sonu planları hakkında <w>çene çalmak</w> için kafede oturdular.",
                                "ru": "Они сидели в кафе и <w>болтали</w> о своих планах на выходные."
                            }
                        },
                        {
                            "text": "The students <w>chattered</w> excitedly before the teacher arrived.",
                            "target_lang_translations": {
                                "tr": "Öğrenciler öğretmen gelmeden önce heyecanla <w>gevezelik ettiler</w>.",
                                "ru": "Студенты возбужденно <w>болтали</w> до прихода учителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "chat",
                        "natter"
                    ],
                    "common_phrases": [
                        "chatter away"
                    ],
                    "target_lang_definitions": {
                        "tr": "Boş veya gayriresmi bir şekilde konuşmak.",
                        "ru": "Разговаривать в праздной или неформальной манере."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gevezelik etmek",
                                "target_lang_sense_clarification": "Boş yere veya çok konuşmak."
                            },
                            {
                                "target_lang_word": "çene çalmak",
                                "target_lang_sense_clarification": "Havadan sudan, gayriresmi konuşmak."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "Вести непринужденный, часто пустой разговор."
                            },
                            {
                                "target_lang_word": "трепаться",
                                "target_lang_sense_clarification": "Разговорный, сниженный стиль для обозначения пустой болтовни."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                    "sense_definition": "To make a rattling sound due to rapid collisions, often from cold or fear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His teeth began to <w>chatter</w> because of the freezing wind.",
                            "target_lang_translations": {
                                "tr": "Dondurucu rüzgar yüzünden dişleri <w>takırdamaya</w> başladı.",
                                "ru": "Его зубы начали <w>стучать</w> из-за ледяного ветра."
                            }
                        },
                        {
                            "text": "She was so nervous that her teeth were <w>chattering</w> uncontrollably.",
                            "target_lang_translations": {
                                "tr": "O kadar gergindi ki dişleri kontrolsüzce <w>takırdıyordu</w>.",
                                "ru": "Она так нервничала, что ее зубы неконтролируемо <w>стучали</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "teeth chatter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Soğuk veya korku nedeniyle hızlı çarpışmalardan kaynaklanan tıkırtı sesi çıkarmak.",
                        "ru": "Издавать дребезжащий звук из-за быстрых столкновений, часто от холода или страха."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "takırdamak",
                                "target_lang_sense_clarification": "Dişlerin soğuktan birbirine çarpması."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "О зубах, которые ударяются друг о друга от холода или страха."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}