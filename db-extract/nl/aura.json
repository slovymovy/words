                                                "example_id": "e2e23c64-2486-4f21-a8a8-cee8b5537b7b",
                                                "sense_id": "179b5431-a40c-3493-a5e9-69efb8a018a8",
                                                "text": "how can he still have aura even without showing his face"
                                            },
                                            {
