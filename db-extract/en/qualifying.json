                "senses": [
                    {
                        "sense_id": "00e39b72-0395-3348-a87f-392cbb9b5170",
                        "entry_id": "34dbf2b7-3c45-39b4-8d73-bcafb5bfe938",
                        "glosses": [
                            "A qualification or added condition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37f9247-710f-47a9-9597-13aa680b8647",
                                "sense_id": "00e39b72-0395-3348-a87f-392cbb9b5170",
                                "text": "No expostulations! No buts, girl! No qualifyings, I will be obeyed, I tell you; and chearfully too!"
                            }
                        ]
                    },
                    {
                        "sense_id": "13fc7a25-c893-3792-91fa-f40e1a80153f",
                        "entry_id": "34dbf2b7-3c45-39b4-8d73-bcafb5bfe938",
                        "glosses": [
                            "An examination that must be taken in order to qualify."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f99ec9-731a-4e2d-bbb4-e07cdd4a8644",
                                "sense_id": "13fc7a25-c893-3792-91fa-f40e1a80153f",
                                "text": "Despite possible lore among graduate students to the contrary, most faculty members dread having to fail a student in the qualifyings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f3a84c2-2db4-445a-97b8-ec3495fb263d",
                        "source_entry_id": "34dbf2b7-3c45-39b4-8d73-bcafb5bfe938",
                        "source_sense_description": "A qualification",
                        "target_lang_word": "Qualifikation",
                        "target_lang_code": "de",
