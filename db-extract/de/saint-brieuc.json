                            {
                                "example_id": "508f33d9-9a0e-4031-9a32-6f18b895b6b2",
                                "sense_id": "a670f4dc-a995-3dc5-98c8-98d2a51a39e4",
                                "text": "Saint-Brieuc ist nur drei Kilometer von der Atlantikküste entfernt."
                            },
                            {
                                "example_id": "70feb70f-a44a-4650-85cc-b63d0742425c",
                                "sense_id": "a670f4dc-a995-3dc5-98c8-98d2a51a39e4",
                                "text": "Das mittelalterliche Saint-Brieuc kann man nördlich der Kathedrale noch erahnen."
                            }
                        ],
