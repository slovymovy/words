                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87662af3-b4db-4771-82ff-73566ead9e1b",
                                "sense_id": "5ea6f804-ce57-3572-81d7-f62966a9ad8b",
                                "text": "\"In bepaalde gebieden kan het gewoon echt niet meer. Het verstoort bijvoorbeeld broedende vogels waardoor je minder broedsucces hebt\", zei de Zeeuwse gedeputeerde Anita Pijpelink in september."
                            },
                            {
                                "example_id": "acbb7cdd-51cd-48b3-a88d-966b44b98fac",
                                "sense_id": "5ea6f804-ce57-3572-81d7-f62966a9ad8b",
                                "text": "\"Het is heel uniek dat het nu eindelijk in het zuiden van het land gebeurt\", aldus Verrijt. De kraanvogel, die groter is dan een ooievaar, heeft zich sinds 2015 definitief gehuisvest in de Peel. Dit is daar het eerste broedsucces."
                            }
