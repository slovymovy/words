                "senses": [
                    {
                        "sense_id": "0adc0e88-dba0-3a23-87fe-5f64fe6b8119",
                        "entry_id": "bc9c4c9f-e126-3d09-8621-1f3b3487eb0f",
                        "glosses": [
                            "Having the shape or characteristics of a sine wave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf599b61-b2e7-4813-9a39-4efde080bfa8",
                                "sense_id": "0adc0e88-dba0-3a23-87fe-5f64fe6b8119",
                                "text": "An averager of the sort described earlier would operate such that, as the frequency of sinusoidal variation of ITD was increased, more and more samples of the dynamically varying ITD would fall within the averaging window and the effective ITD would tend toward their mean of zero."
                            }
                        ]
                    },
                    {
                        "sense_id": "622746b2-9e93-36ce-b56e-b808a2eb217d",
                        "entry_id": "bc9c4c9f-e126-3d09-8621-1f3b3487eb0f",
                        "glosses": [
                            "Relating to any of several channels (the sinusoids) through which venous blood passes in various organs."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f97522f-3bea-4d21-9ddf-49ab25c4278b",
                        "source_entry_id": "bc9c4c9f-e126-3d09-8621-1f3b3487eb0f",
                        "source_sense_description": "in the form of a sine wave",
                        "target_lang_word": "sinusoïdal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinusoïdal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01175045-cb02-3ae0-a015-7571b55b39eb",
                                        "entry_id": "2c164c0a-54e5-3ebc-ace6-94d3cf22008f",
                                        "glosses": [
                                            "En forme de sinusoïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a326013-1c90-4b2c-90b4-1241b4441114",
                                                "sense_id": "01175045-cb02-3ae0-a015-7571b55b39eb",
                                                "text": "Sous une grosse souche, le terrier y avait été creusé. Je n’avais pas besoin de voir celui-là pour savoir avec quel soin il avait été fouillé suivant une ligne sinusoïdale, de façon que l’eau ne risquât point d’inonder le logement de la louve."
                                            },
                                            {
                                                "example_id": "0453e560-7023-4080-ba13-d7ddd99e4164",
                                                "sense_id": "01175045-cb02-3ae0-a015-7571b55b39eb",
                                                "text": "Il n’est point de Révolution que bientôt ne suive une réaction, suivant ce rythme sinusoïdal qui semble la démarche éternelle de l’esprit humain."
                                            },
                                            {
                                                "example_id": "3f3dc177-530e-4d67-bd82-7e0b8e239c46",
                                                "sense_id": "01175045-cb02-3ae0-a015-7571b55b39eb",
                                                "text": "Si plusieurs vibrations sinusoïdales se produisent ensemble, elles se superposent pour donner naissance à des courbes de plus en plus compliquées. Leur superposition donne lieu au « timbre » des divers instruments de musique."
                                            },
                                            {
                                                "example_id": "609f7e6b-dfc6-4d96-9470-47e832e5c193",
                                                "sense_id": "01175045-cb02-3ae0-a015-7571b55b39eb",
                                                "text": "Le courant alternatif est de type sinusoïdal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
