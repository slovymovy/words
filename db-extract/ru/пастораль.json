                                                "sense_id": "c1d6ddd7-da77-3143-abbd-047809bdc159",
                                                "text": "She was in the country, painting her first pastorale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f73b023-13a2-3086-bb88-0d13e83dc318",
