                        ],
                        "examples": [
                            {
                                "example_id": "3d10650a-e2b8-40f2-9abd-96c06bd9b3be",
                                "sense_id": "1fac0fb6-961d-39f1-845d-0010fdaaaa9d",
                                "text": "Le guérisseur de Louvigny de Montigny était bien spécial: secourable aux gens et aux bêtes, il détournait aussi prestement une fluxion de poitrine qu’il soulageait les bestiaux de la gourme, des dartres laiteuses ou du vertigo.tait bien spécial:"
                            },
                            {
                                "example_id": "46f35a27-8908-4e9f-9de1-0805fd34a021",
                                "sense_id": "1fac0fb6-961d-39f1-845d-0010fdaaaa9d",
                                "text": "Ce cheval a le vertigo."
                            },
                            {
                                "example_id": "41135d8b-145a-4ce9-a7dc-554aab4a91f2",
                                "sense_id": "1fac0fb6-961d-39f1-845d-0010fdaaaa9d",
                                "text": "Son cheval est mort du vertigo."
                            }
                        ]
                    },
                    {
                        "sense_id": "206536d4-0d5d-3c4e-a518-f5422afc5b05",
                        "entry_id": "3cdfca3e-d407-304e-b837-be9194a4a9d3",
                        "glosses": [
                            "Caprice, fantaisie."
                        ],
                        "tags": [
