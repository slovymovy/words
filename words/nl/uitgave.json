                {
                    "sense_id": "d421c477-c5c9-3a77-911d-8497efbfc9d2",
                    "sense_definition": "De handeling of het proces van het publiceren van een werk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "publicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitgave</w> van het nieuwe boek is door onvoorziene omstandigheden met twee weken vertraagd.",
                            "target_lang_translations": {
                                "en": "The <w>publication</w> of the new book has been delayed by two weeks due to unforeseen circumstances.",
                                "ru": "<w>Выпуск</w> новой книги был отложен на две недели из-за непредвиденных обстоятельств."
                            }
                        },
                        {
                            "text": "De uitgeverij bereidt de <w>uitgave</w> van een nieuwe reeks studieboeken voor.",
                            "target_lang_translations": {
