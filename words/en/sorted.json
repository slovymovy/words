    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "093fe025-cd27-37eb-ae2a-f3a879ef2d84",
                    "sense_definition": "simple past and past participle of <w>sort</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sort_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>sorted</w> the mail into neat stacks before leaving the office.",
                            "target_lang_translations": {
                                "nl": "Ze <w>sorteerde</w> de post in nette stapels voordat ze het kantoor verliet."
                            }
                        },
                        {
                            "text": "We <w>sorted</w> all the recyclable items into different bins.",
                            "target_lang_translations": {
                                "nl": "We <w>sorteerden</w> alle recyclebare spullen in verschillende bakken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van sort (sorteren)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "sorteerde",
                                "target_lang_sense_clarification": "verleden tijd enkelvoud"
                            },
                            {
                                "target_lang_word": "sorteerden",
                                "target_lang_sense_clarification": "verleden tijd meervoud"
                            },
                            {
                                "target_lang_word": "gesorteerd",
                                "target_lang_sense_clarification": "voltooid deelwoord"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46bef0e8-dba5-392a-a34a-86ed8a684014",
                    "sense_definition": "Arranged or organized into a specific sequence or order.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer program displayed a <w>sorted</w> list of files by date.",
                            "target_lang_translations": {
                                "nl": "Het computerprogramma toonde een op datum <w>gesorteerde</w> lijst met bestanden."
                            }
                        },
                        {
                            "text": "Please keep these documents in <w>sorted</w> order so we can easily find them.",
                            "target_lang_translations": {
                                "nl": "Houd deze documenten alsjeblieft in <w>gesorteerde</w> volgorde, zodat we ze gemakkelijk kunnen terugvinden."
                            }
                        }
                    ],
                    "synonyms": [
                        "ordered",
                        "organized"
                    ],
                    "antonyms": [
                        "unsorted",
                        "disordered"
                    ],
                    "common_phrases": [
                        "sorted list",
                        "sorted array",
                        "sorted order"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gerangschikt of geordend in een specifieke volgorde."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gesorteerd",
                                "target_lang_sense_clarification": "in een bepaalde volgorde geplaatst"
                            },
                            {
                                "target_lang_word": "geordend",
                                "target_lang_sense_clarification": "overzichtelijk gerangschikt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93792c8d-a5c8-3d1a-9962-35f1953dcd67",
                    "sense_definition": "Properly arranged, resolved, or under control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once our accommodation is fully <w>sorted</w>, we can start planning our daily activities.",
                            "target_lang_translations": {
                                "nl": "Zodra onze accommodatie helemaal <w>geregeld</w> is, kunnen we beginnen met het plannen van onze dagelijkse activiteiten."
                            }
                        },
                        {
                            "text": "He needs a few more days to get his personal finances <w>sorted</w>.",
                            "target_lang_translations": {
                                "nl": "Hij heeft nog een paar dagen nodig om zijn persoonlijke financiën <w>op orde te krijgen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "settled",
                        "resolved"
                    ],
                    "common_phrases": [
                        "get it sorted",
                        "all sorted"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "predominantly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Goed geregeld, opgelost of onder controle."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geregeld",
                                "target_lang_sense_clarification": "in orde gemaakt"
                            },
                            {
                                "target_lang_word": "in orde",
                                "target_lang_sense_clarification": "afgehandeld"
                            },
                            {
                                "target_lang_word": "opgelost",
                                "target_lang_sense_clarification": "verholpen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbae5b91-89e9-3f7e-8eac-92dbbef82caa",
                    "sense_definition": "Provided with or in possession of an adequate supply, especially of illegal drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "narcotics_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent hours in the city trying to get <w>sorted</w> for the party.",
                            "target_lang_translations": {
                                "nl": "Ze brachten uren door in de stad in een poging zich te <w>voorzien</w> voor het feest."
                            }
                        },
                        {
                            "text": "He arrived at the music festival already completely <w>sorted</w>.",
                            "target_lang_translations": {
                                "nl": "Hij kwam op het muziekfestival aan terwijl hij al volledig <w>voorzien</w> was."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British drug slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van een voldoende voorraad, met name van illegale drugs."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorzien",
                                "target_lang_sense_clarification": "in het bezit van drugs/spullen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c18d25e0-7b2c-3c53-b94a-a87c5d987529",
                    "sense_definition": "Used to express that an issue has been successfully dealt with or resolved.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interjection_completion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spoke to the mechanic about the car and it is all fixed, so that is that: <w>sorted</w>!",
                            "target_lang_translations": {
                                "nl": "Ik heb met de monteur over de auto gesproken en hij is helemaal gerepareerd, dus dat is dat: <w>geregeld</w>!"
                            }
                        },
                        {
                            "text": "\"Have you managed to find us a table for tonight?\" \"Yes, <w>sorted</w>!\"",
                            "target_lang_translations": {
                                "nl": "\"Is het je gelukt om voor vanavond een tafel te vinden?\" \"Ja, <w>voor elkaar</w>!\""
                            }
                        }
                    ],
                    "synonyms": [
                        "done",
                        "settled"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Gebruikt om aan te geven dat een probleem of taak succesvol is afgehandeld."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geregeld",
                                "target_lang_sense_clarification": "uitroep: de zaak is afgehandeld"
                            },
                            {
                                "target_lang_word": "klaar",
                                "target_lang_sense_clarification": "uitroep: het is gedaan"
                            },
                            {
                                "target_lang_word": "voor elkaar",
                                "target_lang_sense_clarification": "uitroep: het is gelukt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
