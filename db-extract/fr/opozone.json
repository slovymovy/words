                "senses": [
                    {
                        "sense_id": "72fc8d0e-5b35-3ad4-a673-5387daed9909",
                        "entry_id": "1c8ce4df-0be3-334d-9572-07a99df33f93",
                        "glosses": [
                            "Préparation pharmaceutique opothérapique à base de tissu animal frais déshydraté en présence de phosphate de sodium anhydre. Ce produit à disparu de la pharmacopée française dans les années 1960."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3678b127-0012-4d04-aaba-6cdadb8fd3b6",
                                "sense_id": "72fc8d0e-5b35-3ad4-a673-5387daed9909",
                                "text": "J'ai prié la maison Lumière de Lyon , de me préparer un opozone de glande lacrymale de bœuf."
                            },
                            {
                                "example_id": "39d464c8-6972-43f3-83a0-99a7203da77b",
                                "sense_id": "72fc8d0e-5b35-3ad4-a673-5387daed9909",
                                "text": "Les opozones constituent une forme de médicaments organothérapiques dans lesquels la dessiccation est opérée rapidement et à froid, pour éviter les oxydations, phénomènes d'autolyse, etc."
                            },
                            {
                                "example_id": "65d08b23-af6d-4b2c-a9c3-bf1fa61502ae",
                                "sense_id": "72fc8d0e-5b35-3ad4-a673-5387daed9909",
                                "text": "Par un curieux procédé de dessiccation instantané à froid, M. Lumière est arrivé à préparer des extraits organothérapiques, qui, sous le nom d'Opozones, sont de plus en plus appréciés par le Corps médical."
                            }
                        ]
                    }
