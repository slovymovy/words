                "senses": [
                    {
                        "sense_id": "4dfe48b1-d828-3826-b156-4ad6b339704d",
                        "entry_id": "db8886c3-c8f5-31e3-b079-bda2f0294d9c",
                        "glosses": [
                            "D’une manière vaste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faaee8c8-cfaf-4fac-b07c-97bce30878b8",
                                "sense_id": "4dfe48b1-d828-3826-b156-4ad6b339704d",
                                "text": "D'Aguesseau, un des plus beaux et des plus lumineux esprits de son siècle, et, c'est peu dire, vastement et profondément savant."
                            },
                            {
                                "example_id": "358037a8-7389-470a-bead-a8dd09350c7c",
                                "sense_id": "4dfe48b1-d828-3826-b156-4ad6b339704d",
                                "text": "Sans le savoir, nous découvrions une des fonctions essentielles du conte, et, plus vastement, de l’art en général, qui est d’imposer une trêve au combat des hommes."
                            },
                            {
                                "example_id": "9460f58d-8443-45f0-b46f-a55b4c6a3a66",
                                "sense_id": "4dfe48b1-d828-3826-b156-4ad6b339704d",
                                "text": "On pourrait aussi parler du rapport pathologique aux armes à feu, et plus vastement, à la violence d’un pays où les fusillades sont presque devenues un phénomène culturel banal."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
