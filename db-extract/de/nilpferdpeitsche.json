                "senses": [
                    {
                        "sense_id": "73706bb5-0b28-31fd-9c0c-046acc68185a",
                        "entry_id": "9211e038-bbd7-36ab-a9fb-09349f77cc03",
                        "glosses": [
                            "Peitsche aus Nilpferdhaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2aca19-515d-4332-89cd-b5e27f367981",
                                "sense_id": "73706bb5-0b28-31fd-9c0c-046acc68185a",
                                "text": "„Wer nach dem Gutdünken der Aufseher nicht ordentlich arbeitete, bekam es mit der Nilpferdpeitsche zu tun.“"
                            },
                            {
                                "example_id": "fde50c75-e33a-4ac4-8deb-16609aa2eae7",
                                "sense_id": "73706bb5-0b28-31fd-9c0c-046acc68185a",
                                "text": "„Nicht nur in den deutschen Kolonien war der Einsatz der sogenannten Nilpferdpeitsche, hergestellt aus Nilpferd- oder Nashornhaut, zur Züchtigung der afrikanischen Bevölkerung alltäglich.“"
                            },
                            {
                                "example_id": "78651550-fb1f-475a-84df-05e3fa2e6aae",
                                "sense_id": "73706bb5-0b28-31fd-9c0c-046acc68185a",
                                "text": "„Während in Deutsch-Ostafrika und Deutsch-Südwestafrika mit der Nilpferdpeitsche, auch »Kiboko« oder »Schambock« genannt, geprügelt wurde, kamen in Kamerun und Togo Tauenden zum Einsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
