                                "de": "Du ziehst <w>also</w> morgen wirklich um?",
                                "fr": "Tu déménages <w>donc</w> vraiment demain ?",
                                "it": "<w>Quindi</w> domani ti trasferisci davvero?",
                                "cs": "<w>Takže</w> se zítra opravdu stěhuješ?",
                                "tr": "<w>Yani</w> yarın gerçekten taşınıyor musun?",
                                "es": "¿<w>Entonces</w> de verdad te mudas mañana?"
