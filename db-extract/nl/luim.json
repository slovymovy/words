                        ],
                        "form": "luimpje"
                    },
                    {
                        "form_id": "44e781e8-1b35-415d-b387-51efc10a244f",
                        "entry_id": "96d4d94d-32c3-3af9-ba1d-c1a1e66dda73",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "luimpjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f126e9b9-d4b3-3139-bfdf-4bfc0af44535",
                        "entry_id": "96d4d94d-32c3-3af9-ba1d-c1a1e66dda73",
                        "glosses": [
                            "de stemming van een persoon op een bepaald tijdstip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91580b2f-c598-4c72-b2c2-2084cfe95b4b",
                                "sense_id": "f126e9b9-d4b3-3139-bfdf-4bfc0af44535",
                                "text": "Zeven nummers speelden ze uit de nieuwe plaat, maar dat vonden we dus echt niet erg; en zeven uit American Idiot, waaronder ‘Holiday’. Als u belooft het niet verder te vertellen: ik neem ‘Holiday’ wel eens mee op vakantie, om dan pakweg een Portugese boer te doen opschrikken uit zijn siesta met mijn krachtig mee gescandeerde ‘hey!’ Mooie herinneringen, goede luim: Armstrong weet dat we daarvoor van zijn band houden. Pas na vijf nummers sprak hij de zaal toe: ‘vanavond gaat het om passie en medeleven. Er is zoveel negativiteit tegenwoordig; ik kan zelfs niet naar het nieuws kijken. Ik weet niet meer wat waar is en wat gelogen.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "be8ffc30-5ba7-3629-82e6-8e38a20f029e",
                        "entry_id": "96d4d94d-32c3-3af9-ba1d-c1a1e66dda73",
                        "glosses": [
                            "vrolijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5dded1-b5da-476e-b0b3-d796ff7f53ff",
                                "sense_id": "be8ffc30-5ba7-3629-82e6-8e38a20f029e",
                                "text": "Het programma omvatte verschillende onderdelen van het ambacht schrijven en stond in het teken van ernst en luim. „Het schrijven van een boek vergelijk ik altijd met het bouwen van een huis”, legde Hendriksen beeldend uit. „Je begint met de fundering, je bouwt, bekijkt en voegt toe.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e06b6f76-4aa6-418a-bb5e-2a2bb89faeeb",
                        "source_entry_id": "96d4d94d-32c3-3af9-ba1d-c1a1e66dda73",
                        "source_sense_id": "f126e9b9-d4b3-3139-bfdf-4bfc0af44535",
                        "source_sense_description": "de stemming van een persoon op een bepaald tijdstip",
                        "target_lang_word": "Stimmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stimmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c63a916e-f5a5-39de-9cbd-cd4a92c665fc",
                                        "entry_id": "32c41024-0559-368a-8802-a75e144c0fe4",
                                        "glosses": [
                                            "Gefühlszustand eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d0c5b7d-e11b-4c25-af7d-dac33259d810",
                                                "sense_id": "c63a916e-f5a5-39de-9cbd-cd4a92c665fc",
                                                "text": "Er ist in einer guten Stimmung."
                                            },
                                            {
                                                "example_id": "91de7b53-04da-402c-949e-6eae4b484c43",
                                                "sense_id": "c63a916e-f5a5-39de-9cbd-cd4a92c665fc",
                                                "text": "„Explosive Stimmung herrschte im Kieler Landtag.“"
                                            },
                                            {
                                                "example_id": "96bcddc1-91a5-4272-b86e-685f48bcc33c",
                                                "sense_id": "c63a916e-f5a5-39de-9cbd-cd4a92c665fc",
                                                "text": "„Die fremdenfeindliche Stimmung im Land entsprang aus der Mitte der Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "79c328f4-764c-4d7a-8433-e7b6e026daa1",
                                                "sense_id": "c63a916e-f5a5-39de-9cbd-cd4a92c665fc",
                                                "text": "„Die schwankenden Stimmungen Schlegels mögen ihren Grund darin gehabt haben, dass er in Paris nicht die Erfüllung fand, die er sich gewünscht hatte.“"
                                            },
                                            {
                                                "example_id": "8ce7b257-f386-4ebc-8ecf-d9484b74452d",
                                                "sense_id": "c63a916e-f5a5-39de-9cbd-cd4a92c665fc",
                                                "text": "„Die triste Stimmung im Raum war ansteckend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "548f20bb-743d-3aca-ad58-6ba98b9622fe",
                                        "entry_id": "32c41024-0559-368a-8802-a75e144c0fe4",
                                        "glosses": [
                                            "die verbindliche Festlegung eines Instrumentes hinsichtlich seiner Tonhöhe"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328c3920-800d-4a2f-a52c-94d8d4d65553",
                                                "sense_id": "548f20bb-743d-3aca-ad58-6ba98b9622fe",
                                                "text": "Die Stimmung des Klaviers soll von einem Spezialisten gemacht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bee5b9a7-d066-3f8d-96d5-5d93991e6529",
                                        "entry_id": "32c41024-0559-368a-8802-a75e144c0fe4",
                                        "glosses": [
                                            "das Gestimmt- oder Verstimmtsein eines Instrumentes"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30acd1cc-69a1-453a-8bd0-9fe4b6aec5e7",
                                                "sense_id": "bee5b9a7-d066-3f8d-96d5-5d93991e6529",
                                                "text": "Die Stimmung des Klaviers klingt ein bisschen zu niedrig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
