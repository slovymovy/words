                "senses": [
                    {
                        "sense_id": "62b00fc9-6016-3d5f-b05b-9201db6edd2c",
                        "entry_id": "f4146b6e-a287-35db-9cfb-2502372a1a57",
                        "glosses": [
                            "A small orange saltine-like cracker shaped in the form of a fish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8842978-210e-4c1b-bbde-a00c6471c397",
                                "sense_id": "62b00fc9-6016-3d5f-b05b-9201db6edd2c",
                                "text": "They were both working on their second and The Bad Czech was threatening to break the pub record for eating Goldfish, previously held by the chairman of the division of chemistry. […] He took the little fish-shaped cracker and held it in fingers as big as 50-milliliter test tubes."
                            },
                            {
                                "example_id": "a4cd81e9-9ebe-4579-8ca9-116053adf984",
                                "sense_id": "62b00fc9-6016-3d5f-b05b-9201db6edd2c",
                                "text": "No tomato soup with the toasted cheese? And I'd put mustard on the sandwich too, and parmesan cheese Goldfishes on the soup."
                            },
                            {
                                "example_id": "c88bf748-dcd8-48d3-80f2-132ae7e9cbb4",
                                "sense_id": "62b00fc9-6016-3d5f-b05b-9201db6edd2c",
                                "text": "For me, Goldfish crackers were always a comfort food growing up."
                            }
                        ]
                    }
                ],
