                ],
                "senses": [
                    {
                        "sense_id": "36ca2714-1d35-387e-91fd-c2875fd5ea82",
                        "entry_id": "cc03648e-c609-3793-a62e-862fcbd68892",
                        "glosses": [
                            "disruption of movement, disturbance of movement, interruption of movement"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "5b5e71fe-2054-4dbc-92e3-308189483c8e",
                                "sense_id": "36ca2714-1d35-387e-91fd-c2875fd5ea82",
                                "text": "„Immerhin hat man schon bei einigen nahen Fixsternen Bewegungsstörungen gefunden, die auf Gravitationseinflüsse von Weltkörpern schließen lassen von der Größe unseres Jupiters, d. h. aber von der Größe eines Planeten.“ —Kuno Fladt, Hans Seitz: Astronomie. Klett, Stuttgart 1957, page 170 (GoogleBooks; retrieved December 27, 2012)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f9823ac-8d3f-3f78-9ce5-30227c3a1b4f",
                        "entry_id": "cc03648e-c609-3793-a62e-862fcbd68892",
                        "glosses": [
                            "movement disorder"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "651399a4-eb7c-4fb1-b47e-4a0d2880679a",
                                "sense_id": "7f9823ac-8d3f-3f78-9ce5-30227c3a1b4f",
                                "text": "„Unter Bewegungsstörungen werden unterschiedliche Krankheitsbilder verstanden, welche die Ausführung von willkürlichen und unwillkürlichen Bewegungen sowie die Körperhaltung beeinträchtigen und nicht primär aufgrund von Lähmungen, epileptischen Störungen oder orthopädischen Erkrankungen entstehen.“ —Charité. Klinik für Neurologie, retrieved December 27, 2012."
                            }
                        ]
                    }
