            {
                "entry_id": "39b732ae-1881-3ed9-853a-cdaac2f34a9f",
                "word": "longanime",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7407198-0d4e-3efa-bc5d-3b16e429fe51",
                        "entry_id": "39b732ae-1881-3ed9-853a-cdaac2f34a9f",
                        "glosses": [
                            "Qui fait preuve de patience dans l’épreuve, dans le malheur (peu usité, sens avant tout religieux)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b96a2743-fa28-4c7a-aa91-9957b5df3e8b",
                                "sense_id": "e7407198-0d4e-3efa-bc5d-3b16e429fe51",
                                "text": "La charité est longanime ; la charité est serviable ; elle n’est pas envieuse ; la charité ne fanfaronne pas, ne se gonfle pas ;"
                            },
                            {
                                "example_id": "6580bfdb-88d8-4aa1-b5af-fa63d9891dde",
                                "sense_id": "e7407198-0d4e-3efa-bc5d-3b16e429fe51",
                                "text": "Abraham était, certes, longanime, très implorant et repentant."
                            }
                        ]
                    }
                ],
                "translations": [
