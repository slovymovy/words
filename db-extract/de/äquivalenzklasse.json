                "senses": [
                    {
                        "sense_id": "7ff266b8-6283-3ad3-b59b-d04e2fef7f9c",
                        "entry_id": "58398b17-5ce4-3dbc-bb86-7785ff0af723",
                        "glosses": [
                            "Teilmenge von Elementen, die eine gemeinsame Eigenschaft haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450c7bc8-ec42-4aba-a33c-b32e6bb270b0",
                                "sense_id": "7ff266b8-6283-3ad3-b59b-d04e2fef7f9c",
                                "text": "Eine Äquivalenzklasse ist eine Untermenge eines Wertebereichs von Aus- und Eingaben, bei denen ein gleichartiges Verhalten der Komponente oder des Systems während des Softwaretests angenommen wird."
                            },
                            {
                                "example_id": "0ccad848-7a07-445e-ab68-6e3de24f9b42",
                                "sense_id": "7ff266b8-6283-3ad3-b59b-d04e2fef7f9c",
                                "text": "Man kann Äquivalenzklassen sowohl für gültige als auch ungültige Daten oder Ergebnisse bilden."
                            },
                            {
                                "example_id": "31d418fb-3626-4db8-8c11-f6ed1640f036",
                                "sense_id": "7ff266b8-6283-3ad3-b59b-d04e2fef7f9c",
                                "text": "„Ist unsere obige Definition für Äquivalenzklassen korrekt im Sinne, dass [x]=[y] wenn x und y äquivalent zueinander sind?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
