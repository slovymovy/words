                                    {
                                        "sense_id": "22531779-e6d4-3351-9f98-1fdad8f0cbf7",
                                        "entry_id": "2e7b230e-ac5a-3467-9801-5e73c045d419",
                                        "glosses": [
                                            "The edible red berry of that shrub."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1528a92-9690-491a-aef9-263304fb6eee",
                                                "sense_id": "22531779-e6d4-3351-9f98-1fdad8f0cbf7",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a00b8558-07c3-332e-9566-4714bcd338c4",
                                        "entry_id": "2e7b230e-ac5a-3467-9801-5e73c045d419",
                                        "glosses": [
                                            "An intense red colour, like that of a cranberry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cranberry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b77d9f84-b2fe-3cca-a500-86a301f1e719",
                                        "entry_id": "e5f62f74-89e9-37e1-9072-99c19746d7b3",
                                        "glosses": [
                                            "Of the intense red colour of a cranberry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f870633d-3cf4-4d13-9dec-bf661ef3c26e",
                                                "sense_id": "b77d9f84-b2fe-3cca-a500-86a301f1e719",
                                                "text": "Leon was in his most resplendent, gaudiest, Day-Glo getup, including a purple felt fez with multiple hangy-downs and a cranberry vestment with gold collar, appliquéd with every religious symbol known to man […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
