                    },
                    {
                        "sense_id": "b4b72c6a-912a-351e-bf31-16e10ff3e27d",
                        "entry_id": "9a411b95-9a5b-37f7-b8e2-c3def58c74d9",
                        "glosses": [
                            "Suffering from frustration; dissatisfied, agitated, discontent and/or slightly angry because one is unable to perform an action or fulfill a desire, or something happened or someone else did something in a way one did not hope for, expect, or desire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11e79a6-9178-4415-a22c-597522ffcbf6",
                                "sense_id": "b4b72c6a-912a-351e-bf31-16e10ff3e27d",
                                "text": "She easily gets frustrated when it comes to financial matters."
                            },
                            {
                                "example_id": "794105ff-e877-4196-b991-5f5adf90f327",
                                "sense_id": "b4b72c6a-912a-351e-bf31-16e10ff3e27d",
                                "text": "Alan Pardew finished by far the most frustrated man at the Emirates, blaming fatigue for the fact that Arsenal were able to kill his team off in the dying minutes."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb78ad89-ff43-3c28-9b87-fb5b68d2b4df",
                        "entry_id": "9a411b95-9a5b-37f7-b8e2-c3def58c74d9",
                        "glosses": [
                            "Imperfect form of execution of a crime in that, despite performing all the acts that should produce it, the crime fails to be consummated."
                        ],
                        "tags": [
                            "Philippines",
                            "form-of",
                            "imperfect"
                        ],
                        "examples": [
                            {
                                "example_id": "71471231-9fe8-4283-a264-42de967e120c",
                                "sense_id": "eb78ad89-ff43-3c28-9b87-fb5b68d2b4df",
                                "text": "A frustrated robbery may financially cripple the company or lead it to recover; a frustrated homicide or murder leaves the victim injured or wounded, not killed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0acf3a2d-f99c-45d6-9bd6-7debfa2f198d",
                        "source_entry_id": "9a411b95-9a5b-37f7-b8e2-c3def58c74d9",
                        "source_sense_description": "foiled, stopped, disappointed",
                        "target_lang_word": "frustriert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frustriert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                        "entry_id": "e3fe1d69-4aa0-38d2-81bf-6883bdef10f1",
                                        "glosses": [
                                            "die Wirklichkeit / eine Situation so wahrnehmend, dass man davon enttäuscht ist; voller Frustration"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f1550e9-abb0-4e6d-a11b-a25518b77f72",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "„Ich bin ziemlich frustriert, auf jede meiner Bewerbungen bekomme ich eine Absage.“"
                                            },
                                            {
                                                "example_id": "2077753c-0f51-45a7-a966-5ed0d82e9893",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "„Nach der 0:5 Niederlage waren wir total frustriert. Wir hatten vorher geglaubt, das Spiel zu gewinnen, und wären dann Meister gewesen.“"
                                            },
                                            {
                                                "example_id": "a66e66c2-54e7-43dd-beb6-0dfa5c70071a",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "[Die Veganerin und Besitzerin eines von ihr neu eröffneten Cafés mit ausschließlich veganen Speisen und Getränken, Anke Cox:] \"Ich war frustriert von ewigen Diskussionen mit Kellnern und Köchen und davon, nur Beilagen essen zu können\", erzählt sie."
                                            },
                                            {
                                                "example_id": "dd368012-87e3-4c93-80b0-b4c6f0d6ac16",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "Frustriert durch die Hysterie der Öffentlichkeit hörte die Band [Beatles] Mitte der Sechziger auf live zu spielen."
                                            },
                                            {
                                                "example_id": "d7be6934-25e7-446e-8075-cb3b723fa674",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "Bei der Bahn macht die Arbeit den meisten keinen Spaß: 70 Prozent sind sogar regelrecht frustriert, wie eine Umfrage herausfand. Probleme seien zum Beispiel die Strukturen und alte Computer."
                                            },
                                            {
                                                "example_id": "ee84e38f-19d1-4024-83a9-78d4d3960d4b",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "Nach mehrfachen Änderungen durch andere Benutzer hat es schon mancher Autor bereut, einen [Wikipedia-]Artikel initiiert zu haben, und verärgert und frustriert selbst einen Löschantrag zu diesem Artikel gestellt. Oft wird dieser dann übrigens abgelehnt."
                                            },
                                            {
                                                "example_id": "7508be0f-cdd2-4ec8-bbc7-a6a86d19c31b",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "Bridget Jones ist frustriert, denn sie ist über 30 Jahre alt, immer noch Single und übergewichtig."
                                            },
                                            {
                                                "example_id": "e2b49f8b-3e7b-477e-afcf-cae1a768d87e",
                                                "sense_id": "f19c887a-7e2e-329e-bd79-fd424bbc4703",
                                                "text": "Die Regierungswebsite \"Healthcare.gov\", die am 1. Oktober mit Pauken und Trompeten starten sollte, zündete nicht, sondern wurde ein Flopp. Millionen frustrierte Amerikaner hoffen bis heute [November 2013] vergeblich auf die angekündigte Krankenversicherung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d575c2b-770b-3c8e-b4a5-7d9f91f77e8c",
                                        "entry_id": "e3fe1d69-4aa0-38d2-81bf-6883bdef10f1",
                                        "glosses": [
                                            "ohne Nutzen, keinen oder nur sehr wenig Nutzen bringend, ohne die angestrebte Wirkung"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ebc12ec-22be-4f03-9ab3-26a10649fc1d",
                                                "sense_id": "0d575c2b-770b-3c8e-b4a5-7d9f91f77e8c",
                                                "text": "„Als ‚frustrierte Aufwendungen‘ werden im Allgemeinen Aufwendungen bezeichnet, die durch das Schadensereignis zwar nicht selbst verursacht wurden, durch dieses aber nutzlos geworden sind.“"
                                            },
                                            {
                                                "example_id": "d953d8e0-0e46-4964-b6d7-37ee0645651d",
                                                "sense_id": "0d575c2b-770b-3c8e-b4a5-7d9f91f77e8c",
                                                "text": "„Stand aufgrund des vertragswidrigen Verhaltens des Schuldners den Aufwendungen des Gläubigers, die er auch bei vertragsgetreuem Verhalten des Schuldners zu machen hatte, keine entsprechende Gegenleistung gegenüber, so ist der so frustrierte Aufwand als Nichterfüllungsschaden zu ersetzen, wenn der Schuldner nicht beweist, daß sich der Vertrag bei ordnungsgemäßer Erfüllung durch ihn als Verlustgeschäft erwiesen hätte.“"
                                            },
                                            {
                                                "example_id": "bcb3bf4d-d9f9-4507-9d4a-cecb0cd54c1f",
                                                "sense_id": "0d575c2b-770b-3c8e-b4a5-7d9f91f77e8c",
                                                "text": "„Wird schuldhaft ein unrichtiges Gutachten erstattet, kann der Besteller, der bei Kenntnis des Mangels das Honorar nicht bezahlt hätte, jedenfalls dann, wenn der vom Gutachten zu vermittelnde Wissensstand im Zeitpunkt seiner Erlangung wertlos geworden ist, vom Sachverständigen neben den Mangelfolgeschäden auch den sinnlos bezahlten (frustrierten) Werklohn nach Schadenersatzregeln verlangen.“"
                                            },
                                            {
                                                "example_id": "eaaa0bd2-cb49-4278-a387-2c15ba094db6",
                                                "sense_id": "0d575c2b-770b-3c8e-b4a5-7d9f91f77e8c",
                                                "text": "„Die Kläger hätten nicht vorgebracht, ideellen Schadenersatz für entgangene Urlaubsfreude (§ 31e Abs 3 KSchG) zu fordern, sondern Ersatz dafür, dass ihnen ein Tag des gebuchten Urlaubs entgangen sei und deshalb die dafür gezahlten Kosten frustriert seien. Es gehe also um Ersatz frustrierter Aufwendungen.“"
                                            },
                                            {
                                                "example_id": "97d31444-6da0-4dac-8aa7-9dda7bf7d709",
                                                "sense_id": "0d575c2b-770b-3c8e-b4a5-7d9f91f77e8c",
                                                "text": "„Der Gesetzgeber hat mit Einführung des § 284 BGB dem Gläubiger einen Anspruch auf Ersatz seiner frustrierten Aufwendungen zur Seite gestellt, der unabhängig von den Voraussetzungen der von der Rechtsprechung praktizierten und als unbefriedigend empfundenen Rentabilitätsvermutung eingreifen soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
