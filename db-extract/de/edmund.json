                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf5bf2b1-58af-4181-b729-f373467334f2",
                        "source_entry_id": "cbbc5b56-d4d1-3895-9fca-c061f1a00036",
                        "source_sense_id": "9c3e519e-3b49-3e64-b2aa-092027f35cf8",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Edmund",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edmund",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60e5f2c5-931e-346d-ac40-f28364ac7ca1",
                                        "entry_id": "c1b673f3-c72f-3dd5-bb41-d95584f5a682",
                                        "glosses": [
                                            "A male given name from Old English, borne by early English kings and saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eddb8dd-faed-4ef2-8fbf-274a408f38c4",
                                                "sense_id": "60e5f2c5-931e-346d-ac40-f28364ac7ca1",
                                                "text": "This Edmund, in the reign of Bolingbroke, / As I have read, laid claim unto the crown; / And but for Owen Glendower, had been king, / Who kept him in captivity till he died."
                                            },
                                            {
                                                "example_id": "fa01da87-2964-41cd-8975-6e613baa20cf",
                                                "sense_id": "60e5f2c5-931e-346d-ac40-f28364ac7ca1",
                                                "text": "To me, the sound of Mr. Bertram is so cold and nothing-meaning—so entirely without warmth or character!—It just stands for a gentleman, and that's all. But there is nobleness in the name of Edmund. It is a name of heroism and renown—of kings, princes, and knights; and seems to breathe the spirit of chivalry and warm affections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "475c3320-96ef-4307-865f-e7e8ba5c9f7c",
                        "source_entry_id": "cbbc5b56-d4d1-3895-9fca-c061f1a00036",
                        "source_sense_id": "9c3e519e-3b49-3e64-b2aa-092027f35cf8",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Edmond",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edmond",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "451ea8b6-beb7-307a-8886-212e6525ff39",
                                        "entry_id": "33acd8f4-7c09-30f8-99f6-4027099d40d8",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebac960e-3b85-4559-b594-ace5e79c33aa",
                                                "sense_id": "451ea8b6-beb7-307a-8886-212e6525ff39",
                                                "text": "Les comédiens Marie-Laudes Edmond et Gilles Martin, accompagnés des élèves de l’atelier théâtre de l’ECLA donneront à entendre des extraits de romans et de pièces de théâtre sur le thème de la peur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Edmond",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71188f96-f8ef-3a6f-9b7d-5efedf8f2b05",
                                        "entry_id": "6eaf93e4-4792-3597-8dfb-29ccd0dd3537",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2506d4-d500-4a3a-ae3d-e2b236357aca",
                                                "sense_id": "71188f96-f8ef-3a6f-9b7d-5efedf8f2b05",
                                                "text": "Madame Debreuil se taisait elle aussi ; finalement, ce fut Edmond qui aborda le sujet, ne pouvant deviner à quel stade les sympathies progermaniques du père en étaient arrivées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
