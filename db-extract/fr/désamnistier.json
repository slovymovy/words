                "senses": [
                    {
                        "sense_id": "dc9f3b7a-7b68-36d4-839c-779ad2ed2435",
                        "entry_id": "1e432b5c-c448-3af3-a1f1-8fff6cac3bf2",
                        "glosses": [
                            "Annuler l’amnistie de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "111b538b-0f12-48c9-9762-d79174a72c67",
                                "sense_id": "dc9f3b7a-7b68-36d4-839c-779ad2ed2435",
                                "text": "Faites-moi désamnistier, et dans mon cachot immérité, j’aurai bien vite fait la biographie rêvée !"
                            },
                            {
                                "example_id": "8f9b2cf7-6bbd-4a6b-acd4-bbaf53ab3d9f",
                                "sense_id": "dc9f3b7a-7b68-36d4-839c-779ad2ed2435",
                                "text": "C’est bien ce que je me disais, du coup on ne pourrait pas la désamnistier non si des éléments vraiment accablants ressortaient, non ?"
                            },
                            {
                                "example_id": "9e40c6ff-693b-4fe3-a18f-5f97f190c29d",
                                "sense_id": "dc9f3b7a-7b68-36d4-839c-779ad2ed2435",
                                "text": "2013, un socialiste, dans le cinquième pays le plus riche du monde, porte atteinte aux retraites, à la Sécu, invente l’ANI qui licencie, « désamnistie » ceux qui se battent pour la dignité, rogne le quotient familial, poursuit licenciements et casse sociale…"
                            }
                        ]
                    }
