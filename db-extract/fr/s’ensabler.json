                        "cross_references": [
                            {
                                "target_word": "versanden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc3ca34-ff9d-3795-82a8-7471544df5b1",
                                        "entry_id": "67700574-71fc-31cb-b8ac-d6e56a1ac582",
                                        "glosses": [
                                            "zu nichts führen, langsam, aber sicher aufhören oder auch verschwinden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3c0b4f9-25ca-4576-9a68-2c6f22633d83",
                                                "sense_id": "ecc3ca34-ff9d-3795-82a8-7471544df5b1",
                                                "text": "„Doch jetzt … ich verrinne, ich versande in mir selbst.“"
                                            },
                                            {
                                                "example_id": "3df8e78a-c19d-415f-9975-9f3ae378c36a",
                                                "sense_id": "ecc3ca34-ff9d-3795-82a8-7471544df5b1",
                                                "text": "„Nach Angaben von Zhaos Galeristen Christophe Mao versanden Bemühungen, Informationen zu den beschlagnahmten Arbeiten zu erhalten bzw. sie zurückzubekommen, regelmäßig in den Mühlen der staatlichen Organe.“"
                                            },
                                            {
                                                "example_id": "11c80f6d-5550-43eb-8ae7-3fbd9ad448f2",
                                                "sense_id": "ecc3ca34-ff9d-3795-82a8-7471544df5b1",
                                                "text": "Die Spur versandete im Nichts."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b068141-9314-38dc-a0d4-2471c10036ac",
                                        "entry_id": "67700574-71fc-31cb-b8ac-d6e56a1ac582",
                                        "glosses": [
                                            "sich zunehmend mit Sand füllen (und so seinen ehemaligen Zweck nicht mehr erfüllen)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27fa1a0f-78e2-4810-82f0-c72916747b1b",
                                                "sense_id": "7b068141-9314-38dc-a0d4-2471c10036ac",
                                                "text": "„Doch jetzt … ich verrinne, ich versande in mir selbst.“"
                                            },
                                            {
                                                "example_id": "57cba507-261e-4cfa-a9a4-47d4fd8eef4a",
                                                "sense_id": "7b068141-9314-38dc-a0d4-2471c10036ac",
                                                "text": "„Auch Chinguetti, die älteste Universitätsstadt Afrikas, droht zu versanden. Den ältesten Teil, aus dem Jahr 770, hat sich die Wüste schon geholt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
