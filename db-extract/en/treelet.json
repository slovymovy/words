                                                "sense_id": "2b0b0a21-9704-32fb-9714-57a5930f5ed5",
                                                "text": "Dieses Bäumchen werde ich hinten auf die Wiese setzen."
                                            },
                                            {
                                                "example_id": "9da1f573-faa9-4378-815a-abaed68a9c7f",
                                                "sense_id": "2b0b0a21-9704-32fb-9714-57a5930f5ed5",
                                                "text": "„Eines der berühmtesten Artefakte ist ein künstliches, mit Blattgold überzogenenes Bäumchen von 70 Zentimeter Höhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
