                "senses": [
                    {
                        "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                        "entry_id": "716f9b2b-b054-3c02-8ec8-b1cf80ccd498",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1b8aa7-04a6-4afa-a1e7-9d9c480cef96",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Frau Feyerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6a1aa460-86e5-413a-bb73-68dadf69158f",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Herr Feyerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5a0b96e9-c581-4822-96a7-d9a9cf9f9d6e",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Die Feyerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a5187887-96eb-492f-a2a5-f8f5e283eb65",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Der Feyerle trägt nie die Pullover, die die Feyerle ihm strickt."
                            },
                            {
                                "example_id": "2e0c64d3-0813-4351-a5fb-d5d453e5839c",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feyerle kommt, geht der Herr Feyerle.“"
                            },
                            {
                                "example_id": "d5f8d75d-9448-442d-af1d-0db04379c8f5",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Feyerle kommt und geht."
                            },
                            {
                                "example_id": "dbc220e3-e8b6-4cdb-bfc1-649606d51042",
                                "sense_id": "11b47dac-d4ad-3d4c-a02c-67301cbda60d",
                                "text": "Feyerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
