                "senses": [
                    {
                        "sense_id": "f269e018-0b40-36ec-a931-2b4ce0532d33",
                        "entry_id": "7d0399c4-4743-334f-8126-7e19b8aa9988",
                        "glosses": [
                            "Verband, der durch mechanischen Druck auf blutende Gefäße eine Blutstillung bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139ab39b-aae0-4921-be6e-4fd9bb201372",
                                "sense_id": "f269e018-0b40-36ec-a931-2b4ce0532d33",
                                "text": "„Häufig erweist sich ein Kompressionsverband, der eine Verengung des Veneninneren, Schließung der Venenklappen und Festhalten der Gerinnsel bewirkt, als gut.“"
                            },
                            {
                                "example_id": "398c91bb-6b5a-43bf-b03f-19800cbb608b",
                                "sense_id": "f269e018-0b40-36ec-a931-2b4ce0532d33",
                                "text": "„Neben Cold-Pack, Pflaster, Kompressionsverband und Wunddesinfektion sind schmerzstillende, entzündungshemmende und abschwellende Mittel notwendig."
                            },
                            {
                                "example_id": "c35f0b5e-8ac7-49e1-9b38-731505c0f214",
                                "sense_id": "f269e018-0b40-36ec-a931-2b4ce0532d33",
                                "text": "„Er legte einen Kompressionsverband an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
