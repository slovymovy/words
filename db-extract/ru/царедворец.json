                                "target_senses": [
                                    {
                                        "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person in attendance at a royal court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a3d2814-dd7a-4361-81b8-a9f1b2e23413",
                                                "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                                "text": "By the Lord, Horatio, this three years I have taken note of it, the age is grown so picked that the toe of the peasant comes so near the heel of the courtier he galls his kibe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person who flatters in order to seek favour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7325b74b-79b5-452c-ac6c-e79c9f087bfc",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "People shouted cheerfully and flinched, but the Prime Minister didn't flinch, she fortified her voice with a firm diapason as if rising to the challenge of a rowdy Chamber. Around her her courtiers started like pheasants."
                                            },
                                            {
                                                "example_id": "6ab65732-a2ba-492e-96a1-0983138231d5",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "The world’s richest person, not known for his humility, is still learning the cutthroat courtier politics of Donald Trump’s inner circle — and his ultimate influence remains an open question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ff811f-55f9-311f-b6ac-94619565a68d",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the Asian genus Sephisa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
