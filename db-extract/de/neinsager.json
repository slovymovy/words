                "senses": [
                    {
                        "sense_id": "801cae88-26e5-3d1d-88a1-f1b335901ada",
                        "entry_id": "fad61a52-f4c6-32c2-8c22-2b1ff2f44f51",
                        "glosses": [
                            "jemand, der Vorschläge immer wieder ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893ff580-0de7-4350-adb6-a2e169dc7e15",
                                "sense_id": "801cae88-26e5-3d1d-88a1-f1b335901ada",
                                "text": "Als Neinsager hat man potentiell einen schlechteren Ruf."
                            },
                            {
                                "example_id": "953b91df-7519-452f-9359-90f2cfb728dd",
                                "sense_id": "801cae88-26e5-3d1d-88a1-f1b335901ada",
                                "text": "„Unsere Schule […] war nur dumm. Sie sah nicht, daß die Zeit Neinsager brauchte, sie sah überhaupt nichts voraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a730bff1-05af-4672-bd9d-5f75d5e84d32",
                        "source_entry_id": "fad61a52-f4c6-32c2-8c22-2b1ff2f44f51",
                        "source_sense_id": "801cae88-26e5-3d1d-88a1-f1b335901ada",
                        "source_sense_description": "jemand, der Vorschläge immer wieder ablehnt",
                        "target_lang_word": "naysayer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naysayer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "307486b8-2610-3144-82b0-280028d84686",
                                        "entry_id": "17aaf869-eab1-3ba3-b5cf-dd238b092713",
                                        "glosses": [
                                            "One who consistently denies, criticizes, or doubts; a detractor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445334cb-460d-4bc9-8a8c-8e42966f2ba7",
                                                "sense_id": "307486b8-2610-3144-82b0-280028d84686",
                                                "text": "He ignored the naysayers and succeeded with his idea."
                                            },
                                            {
                                                "example_id": "2e61d341-0339-4833-81d7-c30055036af9",
                                                "sense_id": "307486b8-2610-3144-82b0-280028d84686",
                                                "text": "As for the IRP, Secretary of State Grant Shapps continues to peddle snake oil, smoke and mirrors. His reaction to near-universal IRP condemnation from politicians, local and national media, and all but a few rail specialists was to dismiss the lot of us (in the condescending and patronising tone we have now come to expect) as \"critics and naysayers\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
