            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3149ebbd-a21d-3db0-b0e6-b9916f16275b",
                    "sense_definition": "met een kam haar of vacht in orde brengen of ontwarren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is elke ochtend lang bezig haar lange haar te <w>kammen</w>.",
                            "target_lang_translations": {
                                "en": "She spends a long time every morning <w>combing</w> her long hair."
                            }
                        },
                        {
                            "text": "Je moet je haren <w>kammen</w> voordat we naar het feestje gaan.",
                            "target_lang_translations": {
                                "en": "You need to <w>comb</w> your hair before we go to the party."
                            }
                        }
                    ],
                    "synonyms": [
                        "borstelen",
                        "kappen"
                    ],
                    "common_phrases": [
                        "haren kammen",
                        "baard kammen"
                    ],
                    "target_lang_definitions": {
                        "en": "to tidy or untangle hair or fur using a comb"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "comb",
                                "target_lang_sense_clarification": "to groom hair with a toothed tool"
                            },
                            {
                                "target_lang_word": "brush",
                                "target_lang_sense_clarification": "to tidy hair with a brush"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "494a900c-9ed1-3860-9988-fb544dd356f1",
                    "sense_definition": "het bewerken van materiaal, zoals wol of vlas, met een kamvormig werktuig",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer moest de wol <w>kammen</w> om alle onzuiverheden te verwijderen.",
                            "target_lang_translations": {
                                "en": "The farmer had to <w>comb</w> the wool to remove all impurities."
                            }
                        },
                        {
                            "text": "In de oude fabriek zag ik hoe ze vroeger handmatig vlas gingen <w>kammen</w>.",
                            "target_lang_translations": {
                                "en": "In the old factory, I saw how they used to <w>comb</w> flax manually."
                            }
                        }
                    ],
                    "synonyms": [
                        "kaarden"
                    ],
                    "common_phrases": [
                        "wol kammen",
                        "vlas kammen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "processing material, such as wool or flax, with a comb-like tool"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "comb",
                                "target_lang_sense_clarification": "to separate fibers like cotton or wool"
                            },
                            {
                                "target_lang_word": "card",
                                "target_lang_sense_clarification": "to disentangle fibers before spinning"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8869b1c8-1921-3a8a-9872-2e70636dfbcf",
                    "sense_definition": "meervoud van <w>kam</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voorwerpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lade van de kapper liggen verschillende soorten <w>kammen</w>.",
                            "target_lang_translations": {
                                "en": "There are different types of <w>combs</w> in the barber's drawer."
                            }
                        },
                        {
                            "text": "De hanen op de boerderij hebben allemaal felrode <w>kammen</w> op hun kop.",
                            "target_lang_translations": {
                                "en": "The roosters on the farm all have bright red <w>combs</w> on their heads."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of comb; tools for hair or fleshy crests on birds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "combs",
                                "target_lang_sense_clarification": "plural of the hair tool or bird's crest"
                            }
