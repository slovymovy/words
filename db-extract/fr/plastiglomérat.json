                                        "entry_id": "c25d2c26-b7eb-3c05-88c2-af171fa27219",
                                        "glosses": [
                                            "A type of rock with plastic inclusions"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e415d4-c117-43cf-96f2-ca80c84cc5a2",
                                                "sense_id": "89c7f592-cc62-3854-bdb1-3eff93a4b7b8",
                                                "text": "Plastiglomerates are a marker for Anthropocene rocks."
                                            },
                                            {
                                                "example_id": "0127af30-5c8f-4321-ad81-fdfa38d4fe92",
                                                "sense_id": "89c7f592-cc62-3854-bdb1-3eff93a4b7b8",
                                                "text": "Santos and her team ran chemical tests to find out what kind of plastics are in the rocks called \"plastiglomerates\" because they are made of a mixture of sedimentary granules and other debris held together by plastic."
                                            }
                                        ]
                                    }
                                ]
                            }
