                "senses": [
                    {
                        "sense_id": "0d3b7d9c-4c54-329e-8eb6-1dd18126a70e",
                        "entry_id": "d1240a93-e284-3ce6-b7d1-56afdd2747e1",
                        "glosses": [
                            "Schriftsteller, der Horrorliteratur schreibt, dessen Werke sich dem Horrorgenre zuordnen lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad86624-d8de-4b9b-84f2-53c6547fb864",
                                "sense_id": "0d3b7d9c-4c54-329e-8eb6-1dd18126a70e",
                                "text": "„Natürlich würde Lovecraft noch lange brauchen, um seine Theorie und Praxis des phantastischen Erzählens auszubilden, doch seine Jugendträume - und ein Jahr vor seinem Tod bekannte er, dass noch die Schlimmsten seiner späteren Albträume ›sich gegenüber dem Original von 1896 blass ausnahmen‹ - lassen seine Laufbahn als Horrorschriftsteller schicksalhaft vorherbestimmt erscheinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
