                                                "sense_id": "6ed7c4ed-a0bf-356b-8182-9c98e2632f63",
                                                "text": "In der Kriegsmarine war der Rang des Admirals der dritthöchste."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "b6983e25-b421-3837-a14a-cbf34b8d7c58",
                                        "entry_id": "eb097d45-8db9-3060-a0c6-da0ce7553e26",
