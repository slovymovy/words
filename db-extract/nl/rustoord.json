                    }
                ],
                "senses": [
                    {
                        "sense_id": "eec5783a-145f-3196-a917-a0651d9a2692",
                        "entry_id": "b52c918e-7638-39ac-9449-b0accc263a7a",
                        "glosses": [
                            "stille omgeving waar je je kunt ontspannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1799553-e766-47fc-84df-d83eb22d5fa5",
                                "sense_id": "eec5783a-145f-3196-a917-a0651d9a2692",
                                "text": "Paphos is een rustoord voor de toerist."
                            }
                        ]
                    },
                    {
                        "sense_id": "32c0b3e1-f70c-30bc-89a3-13d9696c7e3a",
                        "entry_id": "b52c918e-7638-39ac-9449-b0accc263a7a",
                        "glosses": [
                            "instelling waar men verblijft om van ziekte of andere uitputting kan herstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f1e0f9-fc39-4acf-b1c9-370878d1fdea",
                                "sense_id": "32c0b3e1-f70c-30bc-89a3-13d9696c7e3a",
                                "text": "De dokter heeft me aangeraden een tijdje in een rustoord bij te komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8765d4da-3432-301c-9634-a07f8b0eab72",
                        "entry_id": "b52c918e-7638-39ac-9449-b0accc263a7a",
                        "glosses": [
                            "huisvesting voor mensen na hun werkzame leven"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7d30f960-ebda-4bb0-8a01-dd6d6407bbc3",
                                "sense_id": "8765d4da-3432-301c-9634-a07f8b0eab72",
                                "text": "De wantoestanden in Brussel worden in de hand gewerkt door de soepele wetgeving inzake bejaardenzorg, die in Vlaanderen en Wallonië wel goed geregeld is. Daardoor kan vrijwel iedereen, ook zonder enige opleiding, in de hoofdstad zijn eigen rustoord beginnen en hoeft zon huis geen speciale voorzieningen voor de vaak immobiele bejaarden te hebben."
                            },
                            {
                                "example_id": "93697465-6a9f-4ba5-8c9d-80c09e509682",
                                "sense_id": "8765d4da-3432-301c-9634-a07f8b0eab72",
                                "text": "Door mijnen letterkundigen arbeid, vooral door mijne Makrobiotiek en het Tijdschrift, had ik een kapitaal overgewonnen van 10,000 thalers; hiervoor kocht ik het landgoed Haenlein, aan de dusgenoemde Bergstraat. Dit zoude het rustoord voor mijnen ouden dag worden."
                            },
                            {
                                "example_id": "229b926b-f0c1-4304-83ac-4459cc2a4c3e",
                                "sense_id": "8765d4da-3432-301c-9634-a07f8b0eab72",
                                "text": "Zoals in het rustoord is ook in de servicecenters van Toyota de ziekteuitval veel minder groot dan in het acht urensysteem, vertelde algemeen directeur Martin Banck onlangs aan de Brtise krant The Guardian ."
                            }
                        ]
                    }
                ],
