                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dungeons & Dragons is one of the most famous <w>tabletop</w> role-playing games.",
                            "target_lang_translations": {
                                "es": "Dungeons & Dragons es uno de los juegos de rol <w>de mesa</w> más famosos."
