                "forms": [],
                "senses": [
                    {
                        "sense_id": "164c62b5-e83d-3d62-aad6-9b9609950748",
                        "entry_id": "d868e9e4-5234-327b-b23f-60d57a9c1113",
                        "glosses": [
                            "snelheid verminderend of groei vertragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d281390e-09bd-4b27-8cd7-270d84772173",
                                "sense_id": "164c62b5-e83d-3d62-aad6-9b9609950748",
                                "text": "De regering doet ook te weinig om de bouw van woningen aan te jagen en de gemeenten en provincies worden als remmende factoren gezien, blijkt uit de enquête."
                            },
                            {
                                "example_id": "2f352398-9b63-418d-96c1-d93223fe85ee",
                                "sense_id": "164c62b5-e83d-3d62-aad6-9b9609950748",
                                "text": "Mijn Toyota Yaris Hybride remt soms zelf een beetje af als ik het gaspedaal loslaat, om uit de remmende werking extra energie te winnen."
                            },
                            {
                                "example_id": "ced72bb9-ddb5-4d50-bac2-90a10d9b1c2e",
                                "sense_id": "164c62b5-e83d-3d62-aad6-9b9609950748",
                                "text": "De dienst prijst ook de oplettendheid van de automobilisten, die goed vooruit hebben gekeken. ,,Er waren wel wat remmende auto’s, maar iedereen was goed aan het opletten gelukkig.’’"
                            }
                        ]
                    }
