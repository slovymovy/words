                        "examples": [
                            {
                                "example_id": "d0446ef8-ec80-4e4a-b95c-cb1c7467b0bb",
                                "sense_id": "91379442-f92b-35c6-b0c9-82320d49a852",
                                "text": "От \"тишки\"― \" детишки\"… А какая искусница, выдумщица! Изобретательная, ловкая."
                            },
                            {
                                "example_id": "3afd0a07-3d23-41ac-ba11-f730ff72093c",
                                "sense_id": "91379442-f92b-35c6-b0c9-82320d49a852",
                                "text": "Она ― искусница развлекать мужскую компанию, создавать у людей ощущение праздника."
                            }
                        ]
                    }
