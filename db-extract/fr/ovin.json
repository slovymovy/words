                    }
                ],
                "senses": [
                    {
                        "sense_id": "781c5cdf-a298-3781-aa90-1a63b778fba4",
                        "entry_id": "ac70afdf-e481-37b1-abd2-6ba384853808",
                        "glosses": [
                            "Qui concerne les moutons ou les autres ovins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a020f8-1414-416b-bfe0-b2bd96e1fc05",
                                "sense_id": "781c5cdf-a298-3781-aa90-1a63b778fba4",
                                "text": "Un éleveur du centre de la France, M. Malingié , désirait créer une race ovine qui pût , par la qualité de sa chair et de sa laine, rémunérer son élevage, tout en conservant le sang des races locales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ecae99c-d692-41f0-b3a6-68e4ee903303",
                        "source_entry_id": "ac70afdf-e481-37b1-abd2-6ba384853808",
                        "source_sense_id": "781c5cdf-a298-3781-aa90-1a63b778fba4",
                        "target_lang_word": "ovine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ac6adb-38f2-3c1f-bd5b-45181d4b7094",
                                        "entry_id": "161ca4c0-85ef-39c5-a304-5ca0449e0e0d",
                                        "glosses": [
                                            "Of, being, pertaining to, or resembling a sheep; also, (not comparable) of an animal: from the genus Ovis."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5722fcc-4071-4bc4-b528-bbcee61407df",
                                                "sense_id": "e0ac6adb-38f2-3c1f-bd5b-45181d4b7094",
                                                "text": "[…] Dr. [Mauro] Legni reported to him a month afterward that the ovination had been successful, and that no marked differences had been observable between the vesicles produced by the ovine and those produced by the vaccine lymph. Dr. Legni added, that he had continued to propagate the ovine lymph on children."
                                            },
                                            {
                                                "example_id": "949a132c-7d47-4c1c-a979-0b8788710cd1",
                                                "sense_id": "e0ac6adb-38f2-3c1f-bd5b-45181d4b7094",
                                                "text": "Satyr was a gleam of classical memory on the part of Moreau,—his face ovine in expression, like the coarser Hebrew type; his voice a harsh bleat"
                                            },
                                            {
                                                "example_id": "3420d079-adc4-46b0-ad34-4d2115a8a5d0",
                                                "sense_id": "e0ac6adb-38f2-3c1f-bd5b-45181d4b7094",
                                                "text": "Thus, in general, cattle sperm are reasonably robust, but sheep much less so. Antelope, evolutionarily speaking, are somewhere between cattle and sheep: some are cattle-like, and some are more ovine."
                                            },
                                            {
                                                "example_id": "d67e95aa-f61e-46bc-81af-c97d5c2d68c4",
                                                "sense_id": "e0ac6adb-38f2-3c1f-bd5b-45181d4b7094",
                                                "text": "Ovine meat currently averages 25% of meat production in these countries, but over the projections period, the strongest production gains are expected in the poultry meat sector, contributing 41% to their meat output gains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcba4aaf-cd9a-3b75-866a-645825feaf1c",
                                        "entry_id": "161ca4c0-85ef-39c5-a304-5ca0449e0e0d",
                                        "glosses": [
                                            "Resembling a sheep in character; acquiescent, easily influenced, passive, or willing to follow a leader blindly."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2374d60a-ef6e-4496-ab57-ea1ed51e2d70",
                                                "sense_id": "fcba4aaf-cd9a-3b75-866a-645825feaf1c",
                                                "text": "The Patient from being Maniacl, or raging mad, became vvholly Ovine or Sheepiſh; he bleated perpetually, and chevv'd the Cud: […]"
                                            },
                                            {
                                                "example_id": "75d07db3-6a4b-45e2-af35-ba00a7748f89",
                                                "sense_id": "fcba4aaf-cd9a-3b75-866a-645825feaf1c",
                                                "text": "At present, municipal councillors play at party politics by organizing the ovine members who do not know how to vote until a Party Whip tells them, and opposing independent candidates at the elections."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ovine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a100dcf-1b96-3dbf-8268-20ce6d603ab4",
                                        "entry_id": "02edc579-fe8c-3c65-8ee2-8e7cefe2ee96",
                                        "glosses": [
                                            "An animal from the genus Ovis; a sheep."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "939695d0-59da-3d48-8663-9d4c497e0fff",
                                        "entry_id": "02edc579-fe8c-3c65-8ee2-8e7cefe2ee96",
                                        "glosses": [
                                            "A person regarded as resembling a sheep in character; one who is acquiescent, easily influenced, passive, or willing to follow a leader blindly; a sheep."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a79fca4-cd17-4540-ade2-da4ae078a306",
                                                "sense_id": "939695d0-59da-3d48-8663-9d4c497e0fff",
                                                "text": "At present, municipal councillors play at party politics by organizing the ovine members who do not know how to vote until a Party Whip tells them, and opposing independent candidates at the elections. The remedy for this is the exclusion of ovines from the municipal panel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
