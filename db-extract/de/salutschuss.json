                ],
                "senses": [
                    {
                        "sense_id": "13ea4f9b-e70c-3fe3-ba89-130d918ff716",
                        "entry_id": "cdca3c1d-7ddb-3458-8556-566928b4ad3a",
                        "glosses": [
                            "Schuss, mit dem jemand oder etwas begrüßt oder geehrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6233ede-43c8-41f3-96e5-289d74f3ea11",
                                "sense_id": "13ea4f9b-e70c-3fe3-ba89-130d918ff716",
                                "text": "„[…]; am linken Bildrand eine gestürzte (damit den topographischen Verhältnissen entsprechende) Ansicht Wiens von der Donauseite (die Stadt ist infolge der offenbar zahlreichen Salutschüsse in Rauch und Wolken gehüllt, dennoch sind die Befestigungen und die mit Namen versehenen wichtigen Gebäude von St. Jakob im Osten bis zu den Schotten im Westen gut zu sehen); […]“"
                            },
                            {
                                "example_id": "5e9a97d6-b2fc-4e45-abda-c0f5056562f4",
                                "sense_id": "13ea4f9b-e70c-3fe3-ba89-130d918ff716",
                                "text": "„Dies bestätigten einige Zeugen, sie erklärten, keine Personen zum Zeitpunkt der Salutschüsse neben der Kanone gesehen zu haben, andere dagegen erinnerten sich an das Gegenteil.“"
                            },
                            {
                                "example_id": "915a92b5-07c0-48c0-aefe-73299245cf47",
                                "sense_id": "13ea4f9b-e70c-3fe3-ba89-130d918ff716",
                                "text": "„Wenn die einundzwanzig Salutschüsse zu seinem Amtsantritt abgefeuert sind, ist er Gefangener hinter dreihundert Jahre alten Mauern.“"
                            },
                            {
                                "example_id": "4373108a-1675-43d0-963e-18eacee2e69e",
                                "sense_id": "13ea4f9b-e70c-3fe3-ba89-130d918ff716",
                                "text": "„Dies bot ein fröhliches Schauspiel, und wir bekamen reichlich Musik und jede Menge Salutschüsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
