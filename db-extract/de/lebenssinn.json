                "senses": [
                    {
                        "sense_id": "5c9bc79f-0d8a-31ff-8b53-a8fb2ea39a79",
                        "entry_id": "489bbfec-b754-3a20-8126-aeacd8a4bc68",
                        "glosses": [
                            "Zweck, Grund seines eigenen Lebens, der eigenen Existenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dee3eff-ef50-4f8b-9e0d-9bb18223687f",
                                "sense_id": "5c9bc79f-0d8a-31ff-8b53-a8fb2ea39a79",
                                "text": "„Henry Quantum ist ein großer Grübler – vom generellen Zustand der Welt über den Lebenssinn des Saxofonisten am Straßenrand, irgendetwas schafft es immer, die Aufmerksamkeit des liebenswerten Sonderlings auf sich zu ziehen.“"
                            },
                            {
                                "example_id": "650b4f3c-35f8-4883-9531-92b49195fe6d",
                                "sense_id": "5c9bc79f-0d8a-31ff-8b53-a8fb2ea39a79",
                                "text": "„Das Großvater-Sein eröffnet Männern eine zweite Lebens- und Entwicklungschance: Sie können im Rentenalter neuen Lebenssinn und Erfüllung erfahren und das nachholen, was sie in der Beziehung zu ihren eigenen Kindern versäumt haben.“"
                            },
                            {
                                "example_id": "9dd6fb69-079f-4e41-b5c0-1703556dbcd6",
                                "sense_id": "5c9bc79f-0d8a-31ff-8b53-a8fb2ea39a79",
                                "text": "„Buchhandlungen und Boulevardblätter sind voll von Glücksratgebern und Tipps zur Suche nach Lebenssinn und Leichtigkeit.“"
                            },
                            {
                                "example_id": "1a7a1f84-c144-4b9f-91f8-1e132d58145b",
                                "sense_id": "5c9bc79f-0d8a-31ff-8b53-a8fb2ea39a79",
                                "text": "„Anfangs werden vier Dimensionen von Lebenssinn dargelegt, um dann die Idee des sogenannten Sinnsystems näher zu betrachten und den sozio-kulturellen Einfluss auf das persönliche Sinnsystem zu unterstreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87d16769-7ff6-4bc8-a7e1-3289989dc751",
                        "source_entry_id": "489bbfec-b754-3a20-8126-aeacd8a4bc68",
                        "source_sense_id": "5c9bc79f-0d8a-31ff-8b53-a8fb2ea39a79",
                        "source_sense_description": "Zweck, Grund seines eigenen Lebens, der eigenen Existenz",
                        "target_lang_word": "meaning of life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meaning of life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d3919f7-81b8-375a-8122-642aa5009cf9",
                                        "entry_id": "aa285ecd-5c20-3778-a65c-a41397a9e27e",
                                        "glosses": [
                                            "A hypothetical answer to all of life's ultimate questions; the purpose or raison d'être of human life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ee9654-ba49-4fd8-8551-521ce52d9261",
                                                "sense_id": "1d3919f7-81b8-375a-8122-642aa5009cf9",
                                                "text": "The meaning of life here on earth might be defined as consisting in this: To unfold your self, to work what thing you have the faculty for. It is a necessity for the human being, the first law of our existence."
                                            },
                                            {
                                                "example_id": "e58feaa3-2724-4810-a692-ded6420783fb",
                                                "sense_id": "1d3919f7-81b8-375a-8122-642aa5009cf9",
                                                "text": "I asked myself if this were the meaning of life—to be a work-beast? I knew of no horse in the city of Oakland that worked the hours I worked."
                                            },
                                            {
                                                "example_id": "e3538e92-7616-4699-b820-93268dbf3cc6",
                                                "sense_id": "1d3919f7-81b8-375a-8122-642aa5009cf9",
                                                "text": "But he was no nearer to the meaning of life than he had been before. Why the world was there and what men had come into existence for at all was as inexplicable as ever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
