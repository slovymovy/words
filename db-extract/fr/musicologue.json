                        "examples": [
                            {
                                "example_id": "9ae4af2b-7d71-4b9c-9d37-c1f3b3abe854",
                                "sense_id": "e503ef83-3627-38c0-b832-d06f480ae923",
                                "text": "L’élégant musicologue, peinturologue et psychanalyste consacre six pages et demie à arabesquer de façon très chic sur Mᵐᵉ Bouchot, que Stendhal faillit épouser à Civitavecchia et qu’il appelle Faus (fausse, fosse, etc.), sur sa mort « sans comédie, mais théâtrale », […]."
                            },
                            {
                                "example_id": "27a9c0b3-c171-4cfb-a37b-b46b2e2b1886",
                                "sense_id": "e503ef83-3627-38c0-b832-d06f480ae923",
                                "text": "Le musicologue argentin Carlos Vega a identifié dans le Cancionero musical des XVᵉ et XVIᵉ siècles un morceau présentant le rythme de base de la habanera."
                            }
                        ]
                    }
