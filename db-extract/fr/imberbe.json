                "senses": [
                    {
                        "sense_id": "0eccb78a-1619-36d8-b91b-7b840b522087",
                        "entry_id": "1f246b7d-96c1-3744-8ffb-960d1bd2323d",
                        "glosses": [
                            "Jeune homme qui n'a pas encore de barbe, éphèbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a7dac0-7af8-427f-bc21-15b781a1eeb7",
                                "sense_id": "0eccb78a-1619-36d8-b91b-7b840b522087",
                                "text": "Claire m’est témoin que je n’étais qu’un imberbe mâle dont la vanité roucoulait à hauteur du sexe, au pied du lit des performances d’alcôve."
                            },
                            {
                                "example_id": "da1d5608-e5c6-423e-81ff-42ac75850ebd",
