                        ],
                        "form": "die Anlaute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "031a1241-fad3-3e8d-bfae-c57fd67e158b",
                        "entry_id": "d5719313-2b13-361a-8320-6498c2333531",
                        "glosses": [
                            "erster Laut eines Wortes oder einer Silbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfffcea6-8308-467f-9aff-7f581c8c0c92",
                                "sense_id": "031a1241-fad3-3e8d-bfae-c57fd67e158b",
                                "text": "Der Laut [h] kommt im Deutschen nur im Anlaut einer Silbe vor."
                            },
                            {
                                "example_id": "f224e748-bbb5-4461-b427-22d66bcc5465",
                                "sense_id": "031a1241-fad3-3e8d-bfae-c57fd67e158b",
                                "text": "„In der Standardlautung ist die Stimmhaftigkeitskorrelation gültig für Anlaut und Inlaut, während sie im Auslaut aufgehoben ist.“"
                            },
                            {
                                "example_id": "b287092b-e4cd-40dc-bbcc-ae244931e986",
                                "sense_id": "031a1241-fad3-3e8d-bfae-c57fd67e158b",
                                "text": "„…; ähnlich vermehrte die Lenisierung das Auftreten von stimmhaften Verschlußlauten, indem sie stimmlose Verschlußlaute im An- und Inlaut stimmhaft werden ließ,…“"
                            },
                            {
                                "example_id": "30a62b3f-a25d-45de-bbbb-eb4e35199b6a",
                                "sense_id": "031a1241-fad3-3e8d-bfae-c57fd67e158b",
                                "text": "„Dieser Verlust ist wahrscheinlich vor Konsonant eingetreten, während der betreffende Laut (Halbvokal, Nasal, Liquida) bei vokalischem Anlaut des folgenden Wortes erhalten blieb.“"
                            },
                            {
                                "example_id": "6b781259-6911-4f42-b8ac-ecd4a295d4ec",
                                "sense_id": "031a1241-fad3-3e8d-bfae-c57fd67e158b",
                                "text": "„Durch die bevorzugte Betonung auf der ersten Silbe bot sich für das einprägsame und gedichtete Wort der Reim auf dem Anlaut an, der Stabreim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
