                        "entry_id": "7317101c-c90f-3fb6-addc-0fdb4fb3caad",
                        "glosses": [
                            "ислам. высший духовный титул у шиитов; лицо, имеющее этот титул"
                        ],
                        "tags": [],
                        "examples": [
                            {
