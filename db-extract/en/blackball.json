                    {
                        "sense_id": "022b4822-7316-3c59-a571-75f8d837ebde",
                        "entry_id": "e79cf506-9d10-3512-a7d4-05f1de95cdb5",
                        "glosses": [
                            "A black ball used to indicate such a negative vote."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "1afedc35-612e-4bf4-82d3-3e4cba8ffc86",
                                "sense_id": "022b4822-7316-3c59-a571-75f8d837ebde",
                                "text": "Regardless how many other people may have voted to approve a candidate for membership, a single blackball will reject the candidate."
                            }
                        ]
                    },
                    {
                        "sense_id": "436f3d40-a48c-3afa-b57b-bcca15d8e16d",
