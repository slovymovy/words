{
    "word_family": [
        "reconstruction",
        "reconstructive",
        "reconstructor",
        "construct"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ede096ae-1556-385f-acc7-64f13d0ce0bb",
                    "sense_definition": "To build or create something again after it has been damaged or destroyed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city had to <w>reconstruct</w> the bridge after the flood destroyed the original structure.",
                            "target_lang_translations": {
                                "ru": "Городу пришлось <w>восстановить</w> мост после того, как наводнение разрушило первоначальное сооружение."
                            }
                        },
                        {
                            "text": "It is often very expensive to <w>reconstruct</w> a historic building using original materials.",
                            "target_lang_translations": {
                                "ru": "Зачастую очень дорого <w>реконструировать</w> историческое здание, используя оригинальные материалы."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebuild",
                        "restore",
                        "re-create"
                    ],
                    "antonyms": [
                        "demolish",
                        "destroy",
                        "dismantle"
                    ],
                    "common_phrases": [
                        "reconstruct a building",
                        "reconstruct the past",
                        "reconstruct the site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Построить или создать что-либо заново после того, как оно было повреждено или разрушено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реконструировать",
                                "target_lang_sense_clarification": "производить перестройку или переоборудование"
                            },
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "приводить в прежнее состояние"
                            },
                            {
                                "target_lang_word": "отстраивать заново",
                                "target_lang_sense_clarification": "строить повторно после разрушения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "547e422b-3890-3a4b-8b37-f27ef603cf7a",
                    "sense_definition": "To form a picture of a past event by collecting and analyzing evidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Detectives are trying to <w>reconstruct</w> the crime scene to understand what happened that night.",
                            "target_lang_translations": {
                                "ru": "Детективы пытаются <w>воссоздать</w> место преступления, чтобы понять, что произошло той ночью."
                            }
                        },
                        {
                            "text": "The police will <w>reconstruct</w> the events leading up to the accident using witness statements.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>восстановит</w> события, предшествовавшие аварии, используя показания свидетелей."
                            }
                        }
                    ],
                    "synonyms": [
                        "re-enact",
                        "piece together"
                    ],
                    "common_phrases": [
                        "reconstruct the events",
                        "reconstruct the crime",
                        "reconstruct the timeline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воссоздать картину прошлого события путем сбора и анализа улик или свидетельств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воссоздавать",
                                "target_lang_sense_clarification": "восстанавливать в памяти или по описаниям"
                            },
                            {
                                "target_lang_word": "реконструировать",
                                "target_lang_sense_clarification": "восстанавливать ход событий по остаткам или следам"
                            },
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "собирать воедино детали происшествия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}