                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ef9c4ce-923c-4329-b67c-3a992d8fb4d8",
                                                "sense_id": "e478c3ff-b308-39aa-8e10-77faf771a5e9",
                                                "text": "Les matières premières, suif, saindoux, huiles, etc., que la savonnerie emploie dans sa fabrication sont impures ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "235bb7a2-8b0b-3c68-99c7-580dba20d9a8",
                                        "entry_id": "7aa580f9-e30e-3a2d-947f-9a074f64ff8b",
                                        "glosses": [
                                            "Lieu où l’on fait le savon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728eca6e-4e14-439a-8061-40f905642e03",
                                                "sense_id": "235bb7a2-8b0b-3c68-99c7-580dba20d9a8",
                                                "text": "Dès qu'il quittait la savonnerie, il filait à l'entraînement, servait de sparring-partner à qui le lui proposait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "savonnerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d468a32-eef9-30f3-889a-6f5604082454",
                                        "entry_id": "683520cf-52d7-3c5b-9fac-fe508789158b",
                                        "glosses": [
                                            "Style de tapis venant, ou imitant ceux de la manufacture de la Savonnerie. On écrit aussi Savonnerie pour qualifier ce style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e132b5-e18d-4869-b586-7559092519b4",
                                                "sense_id": "0d468a32-eef9-30f3-889a-6f5604082454",
                                                "text": "… la manufacture de Tournai nous fournit les tapis de pied, les tapis savonnerie fabriqués à la main, imitation de tapis de Smyrne, les tapis moquette, les tapis veloutés, etc."
                                            },
                                            {
                                                "example_id": "7041c1c0-2db1-4602-b42b-cd0752c79f7a",
                                                "sense_id": "0d468a32-eef9-30f3-889a-6f5604082454",
                                                "text": "Tapis Louis XVI, savonnerie fine, 1er qualité.\nTapis savonnerie fine , 2e qualité.\nTapis savonnerie gros point.\nTapis de Smyrne."
                                            }
                                        ]
                                    }
                                ]
                            }
