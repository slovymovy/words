                                    {
                                        "sense_id": "3a6d9902-d128-3fc9-89fa-ef1f2f8868d3",
                                        "entry_id": "04028e3b-6c9b-3203-8794-16bf9f872dcc",
                                        "glosses": [
                                            "virtueller Stellvertreter eines realen Benutzers im Cyberspace"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578da994-5111-43e1-ba00-d212291ef826",
                                                "sense_id": "3a6d9902-d128-3fc9-89fa-ef1f2f8868d3",
                                                "text": "Der Avatar darf nicht breiter als 80 Pixel sein."
                                            },
                                            {
                                                "example_id": "1cc5b17e-8ca8-4751-bd1c-8b2b2e985185",
                                                "sense_id": "3a6d9902-d128-3fc9-89fa-ef1f2f8868d3",
                                                "text": "Mein Avatar bei ‚World of Warcraft‘ sollte sich einmal andere Kleidung beschaffen."
                                            },
                                            {
                                                "example_id": "144e2bba-20d7-4125-b140-dd7d1e15a4fe",
                                                "sense_id": "3a6d9902-d128-3fc9-89fa-ef1f2f8868d3",
                                                "text": "„Er sieht selbstverständlich keine wirklichen Menschen. Dies gehört alles zu der beweglichen Graphik, die sein Computer gemäß Informationen, erstellt, die über das Glasfaserkabel hereinkommen. Die Menschen sind Softwareteile, die man Avatar nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c984f79-43dd-3a41-8a03-7645f558cd2b",
                                        "entry_id": "04028e3b-6c9b-3203-8794-16bf9f872dcc",
                                        "glosses": [
                                            "virtuelle, grafische Repräsentation einer Kunstfigur in einem eigenen Universum"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Avatar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
