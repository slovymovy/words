        "fr-extract.jsonl": [
            {
                "entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                "word": "galapiat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b828b19-b5d0-43d2-9dfc-47967610aba7",
                        "entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "tags": [
                            "plural"
                        ],
                        "form": "galapiats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                        "entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "glosses": [
                            "Homme grossier et sans valeur."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5b046758-9586-4ad2-bc1d-62cbf2686ad6",
                                "sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                                "text": "Quarante de galapiats, hurla-t-il rageusement en jetant quatre valets sur la table."
                            },
                            {
                                "example_id": "532db3fd-3dba-4a1f-bee2-9b1d719be53c",
                                "sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                                "text": "Comment ! Voilà un galapiat, un traîneur de rapière en chambre, qui non seulement manquerait de respect à ma femme, mais viendrait par-dessus le marché mettre la zizanie chez moi ?"
                            },
                            {
                                "example_id": "804526d8-e118-4262-bbe8-6183bf6a9228",
                                "sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                                "text": "Ce n'est pas rendre visite aux pigeons qu'il fallait faire, c'est les plumer et les rôtir dans la cuisine, galapiat ! gronda Mr Bennett."
                            },
                            {
                                "example_id": "8f06a479-acec-4c1e-aaaf-5d8cdfec39d5",
                                "sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                                "text": "Certes, le galapiat ne manque pas d’importuner son entourage, mais il bénéficie toutefois dans l’opinion d’un crédit de sympathie."
                            },
                            {
                                "example_id": "d5fc0d33-972b-4652-851c-092c876d2f0a",
                                "sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                                "text": "Tonton Gabriel, s'écria Zazie, je te jure que c'est hà moi les bloudjinnzes. Faut mdéfendre, tonton Gabriel. Faut mdéfendre. Qu'est-ce qu'elle dira ma moman si elle apprenait que tu me laisses insulter par un galapiat, un gougnafier et peut-être même un conducteur du dimanche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbeb22db-b732-4b58-961a-fbadc5f14cd2",
                        "source_entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "source_sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                        "target_lang_word": "Taugenichts",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taugenichts",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                        "entry_id": "d8f790fb-3b15-3ff8-913e-869ab404e4c5",
                                        "glosses": [
                                            "Person, die zu nichts nützlich oder brauchbar ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7da229c1-7a5d-4842-9796-9839bd88ae7a",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "Er war schon immer ein Taugenichts."
                                            },
                                            {
                                                "example_id": "7a4d9162-034b-4c14-b4fe-a992adc1a212",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "Dein Sohn ist ein richtiger Taugenichts; er hat nur Unfug im Sinn."
                                            },
                                            {
                                                "example_id": "2fe6fde3-81d4-43fc-91d9-bbdc42629fda",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„So einen löblichen Vatter Wenceslaus gehabt, so wenig ahmte er doch demselben in seiner Regierung nach, indem ihn nichts, als seine Faulheit, Tyranney, und Unmäßigkeit der Nachwelt bekant gemacht haben, uṅ [und] er, mit einem Wort, ein rechter Taugenichts gewesen ist.“"
                                            },
                                            {
                                                "example_id": "8fe3fd79-b318-48fd-8fb1-4e336b0a6b64",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Wir bringen es leicht fertig, die Armen, die von staatlichen Zuwendungen leben, als Taugenichtse zu beschimpfen.“"
                                            },
                                            {
                                                "example_id": "d33f8e77-55ef-455b-9a21-b0a80ead9ae7",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Daß wir hier schon zahlreiche Vorgänger gehabt hatten, verrieten die Wände, die als Fremdenbuch dienten und auf die alle Taugenichtse der Welt ihren Namen geschrieben oder geritzt hatten.“"
                                            },
                                            {
                                                "example_id": "079748a7-efde-49dd-ae36-a89bc3beb42d",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Han's jüngerer Bruder Han Dau-gwe (das ist der Faselhans) war ein Spieler und Taugenichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74688996-29cc-4395-b891-5829671990ef",
                        "source_entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "source_sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                        "target_lang_word": "Nichtsnutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtsnutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                        "entry_id": "6a4be8ca-7a3c-3cfe-9eab-d82069cc776e",
                                        "glosses": [
                                            "Person, die zu nichts nützlich und brauchbar ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4acf4750-dab8-4330-ba71-e16916c10cc2",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "„Ach, Herr Jesu Christ, verdient er jetzt nicht die ärgste Tracht Prügel, die nur auf seinem Buckel Platz hat, der verdammte Nichtsnutz!“"
                                            },
                                            {
                                                "example_id": "f571e095-f26f-4b08-a651-8cc810fe14c8",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "Ihr Nichtsnutze könntet auch mal in den Garten gehen und Laub harken!"
                                            },
                                            {
                                                "example_id": "129e1dc8-38c6-4093-aeb9-77f119dad14b",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "„Ohne diesen Aberglauben, der lediglich der Furcht entsprang, wäre ich nicht eine Minute länger geblieben; meine Flucht hätte dann Capitani und Francia verraten, daß ich bei weitem kein Magier, sondern ganz einfach ein rechter Nichtsnutz war.“"
                                            },
                                            {
                                                "example_id": "a219e82e-9b6a-4f33-9f9b-4c21385abf06",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "„Der Sanguiniker Mirabeau lebt aus dem vollen, er ist ein Nichtsnutz, aber gesund an Temperament und immer natürlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59a66616-c97d-4f5e-8784-388241c8b788",
                        "source_entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "source_sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                        "target_lang_word": "Strolch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strolch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "794dc99c-5560-3cff-8614-ff2969b544c0",
                                        "entry_id": "c12f5bac-299c-3d2d-abe4-8722733202e5",
                                        "glosses": [
                                            "kleinkriminelle Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d033b71-5a8e-404e-919a-e6ceb634e6fa",
                                                "sense_id": "794dc99c-5560-3cff-8614-ff2969b544c0",
                                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                                            },
                                            {
                                                "example_id": "f26d7ec7-5511-482b-bb27-56109f3513ba",
                                                "sense_id": "794dc99c-5560-3cff-8614-ff2969b544c0",
                                                "text": "„Er wollte anständig sein, aber da sind Schufte und Strolche und Lumpen, darum will Franz Biberkopf nichts mehr sehen und hören von der Welt, und wenn er Penner wird, er versauft den letzten Pfennig von seinem Geld.“"
                                            },
                                            {
                                                "example_id": "838269ef-380b-4eda-8d07-681e97ecfc01",
                                                "sense_id": "794dc99c-5560-3cff-8614-ff2969b544c0",
                                                "text": "„Sooft ich wieder nach Padua kam, um mein Rechtsstudium zu beenden, wohnte ich bei ihm; aber jedesmal kränkte es mich, wenn ich Bettina mit dem Strolch sah, der sie heiraten sollte und für den sie mir nicht geschaffen zu sein schien.“"
                                            },
                                            {
                                                "example_id": "ed49e3aa-4c7a-45a3-aa26-9be340a1ffcb",
                                                "sense_id": "794dc99c-5560-3cff-8614-ff2969b544c0",
                                                "text": "„Dieser Strolch war dreißig Jahre alt, rothaarig, sehr kräftig gebaut, ein rechter Bauer, der nur Mönch geworden war, um ohne körperliche Anstrengungen zu leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d37fedc5-3b45-3326-8ff3-f28206c1bee9",
                                        "entry_id": "c12f5bac-299c-3d2d-abe4-8722733202e5",
                                        "glosses": [
                                            "kleiner, raffinierter Junge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "870725e8-97a9-4c16-a943-5a8022ccf335",
                                                "sense_id": "d37fedc5-3b45-3326-8ff3-f28206c1bee9",
                                                "text": "Die kleinen Strolche haben uns wieder einmal einen Streich gespielt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f836957c-aac4-4e90-9482-851331b247e9",
                        "source_entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "source_sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                        "target_lang_word": "smeerlap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smeerlap",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                                        "glosses": [
                                            "vette lap waarmee men iets insmeert om wrijving te verminderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6dd82b3-f61a-4c4b-a4c8-f21fcf58342c",
                                                "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                                                "text": "De smeerlap kwam van pas zodra het droog weer was (alleen met sneeuw verliep het traject soepeltjes), waardoor het paard de kar niet meer kon trekken. De sleper smeerde de wielen in met de vette lap zodat de kar weer verder kon worden getrokken."
                                            },
                                            {
                                                "example_id": "f7d0b90a-728e-4774-8b0c-039078384b92",
                                                "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                                                "text": "De sleepkoets werd meestal voortgetrokken door een paard, waarvan de menner genoodzaakt was naast het vehikel te lopen en zo nu en dan met zijn smeerlap de glij-ijzers wat gladder te maken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f56f1c7-df97-3068-aaa3-03b95725f1ca",
                                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                                        "glosses": [
                                            "man die wangedrag vertoont"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acb15241-a8ab-3909-bae8-af838f2bcae3",
                                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                                        "glosses": [
                                            "man die wangedrag vertoont",
                                            "man die zichzelf of zijn omgeving vies maakt"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83d1456b-07bd-469a-a18c-38f4e94e4911",
                                                "sense_id": "acb15241-a8ab-3909-bae8-af838f2bcae3",
                                                "text": "Hij keek me aan alsof ik de goorste smeerlap was die hij in jaren was tegengekomen. „Een blower?!” riep hij uit. „Die maakt het alleen maar nóg veel viezer.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8778174a-adf7-3b8f-a288-7a33ed9496d1",
                                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                                        "glosses": [
                                            "man die wangedrag vertoont",
                                            "man die gemene dingen doet"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f56a5c0c-d16a-407a-9b0a-b36705a650f6",
                                                "sense_id": "8778174a-adf7-3b8f-a288-7a33ed9496d1",
                                                "text": "‘Ja, hou hem vast. Hou die smeerlap vast.’ Sommigen konden zich amper inhouden en schopten de overvaller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3440525-ea77-3af7-b103-7d69fd601afd",
                                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                                        "glosses": [
                                            "man die wangedrag vertoont",
                                            "man met onsmakelijke seksuele voorkeuren"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357aadd7-6ccb-4c15-8cf1-1e4340d1dc14",
                                                "sense_id": "e3440525-ea77-3af7-b103-7d69fd601afd",
                                                "text": "Het meisje graait wat, ze grinnikt: „Ik kan geen stier melken.” En dat is dat. Jeugd en ouderdom. Kind en ouwe smeerlap. Kracht en impotentie, leven en dood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42edd838-2c88-4c39-b9e4-baeb98859aa9",
                        "source_entry_id": "6719f72e-442d-3179-a819-dc9365f5019b",
                        "source_sense_id": "fe9ee704-a864-32ec-88b7-3bfd616178e5",
                        "target_lang_word": "boef",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boef",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "da73add3-545f-313b-b890-def222939cc9",
                                        "entry_id": "f76b6d68-815b-3058-a442-f420654dbab9",
                                        "glosses": [
                                            "iemand die zich misdadig gedraagt"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1cda7fd-133b-4760-a68e-c2b2080ac90b",
                                                "sense_id": "da73add3-545f-313b-b890-def222939cc9",
                                                "text": "De boeven werden op heterdaad betrapt."
                                            },
                                            {
                                                "example_id": "961b14f5-4a58-4db6-ac5b-e9fb66545350",
                                                "sense_id": "da73add3-545f-313b-b890-def222939cc9",
                                                "text": "Hij was zowel boef als bevrijder. Tijdens het bestuur van de rechtse Boigny, een stamhoofd en de zoon van een rijke plantagehouder, belichaamde de linkse Gbagbo de hoop op een breuk met het koloniale verleden. Nergens in Afrika had een oud-kolonisator zo veel invloed als Frankrijk in Ivoorkust. Gbagbo presenteerde zijn oppositie tegen Boigny als antikoloniale strijd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e7088a-1847-3d1b-8258-5a061845e979",
                                        "entry_id": "f76b6d68-815b-3058-a442-f420654dbab9",
                                        "glosses": [
                                            "ondeugend kind"
                                        ],
                                        "tags": [
                                            "in afgezwakte vorm; schertsend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ac1c82-23c4-41bb-a25c-9c82e8e99ea3",
                                                "sense_id": "76e7088a-1847-3d1b-8258-5a061845e979",
                                                "text": "Jij kleine boef, wat heb je nu weer gedaan?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "566353e1-4f72-4a32-8bc7-de2b79b26426",
