                    ],
                    "antonyms": [
                        "zumachen",
                        "schließen"
                    ],
                    "common_phrases": [
                        "jemandem die Tür aufmachen",
                        "jemandem aufmachen"
                    ]
                },
                {
                    "sense_id": "218c6073-15d1-328a-9996-e248f3208e1a",
