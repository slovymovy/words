                    {
                        "translation_id": "8411d3d8-8b35-472a-ad6f-2643359c77b4",
                        "source_entry_id": "86df907b-7f83-3d5b-ad70-1e814e63fc11",
                        "source_sense_id": "c59fec2f-6966-3426-b754-fed3caaa39cf",
                        "target_lang_word": "absehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absehbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                        "entry_id": "fecbfd30-a872-300b-a9ec-ce7f3b8a0b23",
                                        "glosses": [
                                            "sich im Vorhinein erkennen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a370ce3-fc6d-4ad0-81cb-13223c81c315",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "Die Folgen seines Handelns sind noch nicht absehbar."
                                            },
                                            {
                                                "example_id": "8b5fad68-4c16-4a4a-b191-6647413d3d16",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "Es war absehbar, dass er absagen würde."
                                            },
                                            {
                                                "example_id": "3ae93fd3-7f85-4a11-a752-9c57a2b57078",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "Die ersten Veränderungen sollten in absehbarer Zeit eintreten."
                                            },
                                            {
                                                "example_id": "f4d4efca-eaa8-4356-a9f7-517d641ecc6b",
                                                "sense_id": "4012f785-8028-33a4-a60b-e4ca4666a342",
                                                "text": "„Diese grausame Trennung ohne absehbare Zukunft brachte uns aus der Fassung und lieferte uns wehrlos den Erinnerungen an jene noch so greifbar nahe und doch so ferne Gegenwart aus, die nun unsere Tage erfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3f98c3f-c2a9-4a8f-b2d2-aba287acf0bf",
                        "source_entry_id": "86df907b-7f83-3d5b-ad70-1e814e63fc11",
                        "source_sense_id": "c59fec2f-6966-3426-b754-fed3caaa39cf",
                        "target_lang_word": "übersehbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übersehbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                        "entry_id": "dbb034bc-2b51-39e4-a8f0-83204c8257b3",
                                        "glosses": [
                                            "so geartet, dass sich etwas gut überblicken, durchschauen, absehen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d4ff76-1359-41f9-a952-adf718dd57b1",
                                                "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                                "text": "„Es darf nur so schnell gefahren werden, dass innerhalb der übersehbaren Strecke gehalten werden kann.“"
                                            },
                                            {
                                                "example_id": "fec44877-166f-4b86-8b80-87342e35adbc",
                                                "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                                "text": "„Die Menge der Aufgaben war nicht mehr übersehbar; das gesamte Projekt muss übersehbar bleiben.“"
                                            },
                                            {
                                                "example_id": "e90c30a4-96c4-4563-8fd2-e4ab28cfc264",
                                                "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                                "text": "„Dabei wird unterstellt, daß die sich begegnenden Fahrzeuge mit gleicher Geschwindigkeit fahren, sich also in der Mitte der übersehbaren Strecke begegnen.“"
                                            },
                                            {
                                                "example_id": "103bd50a-6be8-40a4-94d3-f1ac045e1ecd",
                                                "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                                "text": "„Beamte, so scheinen, genießen im Vergleich zu gemeinen Angestellten eine kaum übersehbare Zahl von Privilegien.“"
                                            },
                                            {
                                                "example_id": "7419d428-4e1f-4fbc-be43-0e99d33a325c",
                                                "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                                "text": "„Ebenso unglaublich ist, daß führende amerikanische Medien fast eine Woche lang nur wenige und leicht übersehbare Zeilen zu dem Thema brachten.“"
                                            },
                                            {
                                                "example_id": "982c536b-4d6a-4b2d-a4df-35117c462404",
                                                "sense_id": "cd397cf1-e035-31d5-8bfa-5caf19d6e5f2",
                                                "text": "„Aus Häfen sind schneeweiß lackierte, hohe und somit kaum übersehbare Kreuzfahrtschiffe in der Corona-Pandemie weitgehend verschwunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
