                        "examples": [
                            {
                                "example_id": "853bfa13-effc-4dcd-b73c-0696311c21f9",
                                "sense_id": "ff78b818-3cd3-3e2d-9a7a-1d49ba809a16",
                                "text": "Sommigen zeggen dat het de oplossing is tegen de eikenprocessierups. Hang nestkastjes in de bomen voor koolmezen, want die hebben de rups als lekkernij op hun menu staan. “Maar dat is helemaal niet bewezen”, zegt wethouder Mariska ten Heuw."
                            },
                            {
                                "example_id": "2de374dc-7d23-4f9d-82e5-f4dde1d9fed6",
                                "sense_id": "ff78b818-3cd3-3e2d-9a7a-1d49ba809a16",
                                "text": "Medewerkers van de gemeente Apeldoorn gaan de komende twee weken de strijd aan met de eikenprocessierups. Die doen ze niet alleen overdag, maar ook 's nachts."
                            }
                        ]
                    }
