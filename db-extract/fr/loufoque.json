        "fr-extract.jsonl": [
            {
                "entry_id": "77a48c58-8c80-3c59-8d1e-dd0333790689",
                "word": "loufoque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1989f6f-ab08-488d-a305-b843b26fee49",
                        "entry_id": "77a48c58-8c80-3c59-8d1e-dd0333790689",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "loufoques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                        "entry_id": "77a48c58-8c80-3c59-8d1e-dd0333790689",
                        "glosses": [
                            "Fou."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f90a7acb-20c7-4a44-a899-d98e1a6fddbc",
                                "sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                                "text": "Partant de cette idée de loufoque, et grâce à son immense fortune, elle s'entourait des objets plus ou moins authentiques ayant appartenu à la reine guillotinée par la Révolution française..."
                            },
                            {
                                "example_id": "cdda3a1c-9aae-4b36-a38c-013cb71712d4",
                                "sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                                "text": "Quelle fricassée d’enfants ! Vous serez bientôt sourde et loufoque."
                            },
                            {
                                "example_id": "bdfb3ea4-d913-4015-9891-576b5c0360a7",
                                "sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                                "text": "On a vu tourner, sur les réseaux sociaux, ces derniers jours, cette scène loufoque où des hommes et des femmes, rassemblés à la Place Rosemère, un centre commercial de la Rive-Nord de Montréal, dansent ensemble, pour braver la COVID et les règles sanitaires."
                            },
                            {
                                "example_id": "b0dbd250-e07d-4625-8186-d2f26edad5ab",
                                "sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                                "text": "San Francisco est l’une des villes américaines les plus à gauche et il n’est pas étonnant d’y retrouver des manifestations particulièrement loufoques de ce qu’on surnomme le « wokisme »."
                            }
                        ]
                    },
                    {
                        "sense_id": "500a01c4-5905-32ee-b412-c27f17eee773",
                        "entry_id": "77a48c58-8c80-3c59-8d1e-dd0333790689",
                        "glosses": [
                            "D’une drôlerie surprenante."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "efabd205-178c-4e71-9edf-0e3e8271fd8b",
                                "sense_id": "500a01c4-5905-32ee-b412-c27f17eee773",
                                "text": "Dans le cadre des « Estivales de Haute-Saintonge », la compagnie Bardo propose son spectacle loufoque « Qué Bardo » demain au parc Mysterra."
                            },
                            {
                                "example_id": "73d433a5-43a7-4ebf-84ab-20c0cb35fede",
                                "sense_id": "500a01c4-5905-32ee-b412-c27f17eee773",
                                "text": "Complètement loufoque ce raisonnement ! Prenez l'animal avant vos vacances ! ! ! tout simplement !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3b1aec5-444f-4185-8234-dd6ec8aec69b",
                        "source_entry_id": "77a48c58-8c80-3c59-8d1e-dd0333790689",
                        "source_sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                        "source_sense_description": "Fou",
                        "target_lang_word": "zany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                        "entry_id": "079340dd-4516-3c88-93f2-b8058055d771",
                                        "glosses": [
                                            "Unusual and awkward in a funny, comical manner; outlandish; clownish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12dd1329-88ab-4429-916c-cece2be055f2",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "And I will admit now but never then that, more than once, listening to the Viennese chattering their zany German on the pavements, or taking himself to one of the struggling small theatres that were cropping up in cellars and bombed houses..."
                                            },
                                            {
                                                "example_id": "69331169-2ad1-4dd8-81c4-1e103d313128",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "Press articles emphasized his [Dizzy Gillespie's] ambassadorial role and drew attention to the paradox that he was a shrewd musician and leader despite his zany image."
                                            },
                                            {
                                                "example_id": "1287dc13-a0c9-4038-8d64-1ab2e543556a",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "When playing for Connie Mack, Rube [Waddell]'s pattern after one of his zany outbursts usually involved promises of good behavior and a spurt of excellent pitching."
                                            },
                                            {
                                                "example_id": "d391d21f-86f6-4870-99c0-f529eb93db38",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "This runs counter to the play, where Grandpa is always benignly indulgent of all his zany progeny and their equally zany spouses, and is even somewhat zany himself."
                                            },
                                            {
                                                "example_id": "6f924c84-e138-4b59-b171-51653b980692",
                                                "sense_id": "b48d2e5a-da61-3ea7-90b1-999369ab5989",
                                                "text": "The montage goes on to show scenes of Carla singing, dancing, meditating, breaking the tension amongst her co-cheftestants with sing-a-longs and “hootie-hoo” lessons, and ultimately wooing the judges with a combination of her zany personality and solid cooking skills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1bb0b6-f375-3860-bf3d-da1ec59ce069",
                                        "entry_id": "079340dd-4516-3c88-93f2-b8058055d771",
                                        "glosses": [
                                            "Ludicrously or incongruously comical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "zany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                        "entry_id": "d72600c0-3241-39a8-b28c-549f098ebc76",
                                        "glosses": [
                                            "A fool or clown, especially one whose business on the stage is to imitate foolishly the actions of the principal clown."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e030596f-54a0-4579-86e7-1315aa4feef9",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "Then write that I may follow, and so be / Thy echo, thy debtor, thy foil, thy zany."
                                            },
                                            {
                                                "example_id": "3cdffa59-a6ff-4b8a-a132-0d6fae769141",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "O great restorer of the good old stage, / Preacher at once, and Zany of thy age!"
                                            },
                                            {
                                                "example_id": "16e487a3-d41a-4993-b17c-6a1645b150b5",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "So there he caught me lying like a zany on the ground. You may guess I stood at attention soon enough, but told him I was looking at the founds to see if they wanted underpinning from the floods."
                                            },
                                            {
                                                "example_id": "968df767-6d69-43bc-a75d-e10dbf6dd71f",
                                                "sense_id": "90a9c6f6-2dff-3d5b-a97f-a4825413851c",
                                                "text": "Part of the illusory world is the 'quack' or mountebank who can be seen standing on his own special platform in the centre of the crowd[…]. Such a person travelled round to fairs and markets selling his nostrums or medicines. This character is dressed in a lace hat, long periwig and embroidered coat with lace cuffs, and is attended by his zany, who is wearing a chequered harlequin outfit and is 'quacking' or 'puffing' his master's wares. No seventeenth- or eighteenth-century mountebank was complete without his zany or 'Merry Andrew' – a term originally applied to Dr Andrew Boorde, physician to Henry VIII and noted for his ready wit and humour, who was the subject of many broadside ballads."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b20e260-756f-3b3b-97d2-12e390103636",
                                        "entry_id": "998e0e41-f8ea-3862-a27a-6c1ca44e4d05",
                                        "glosses": [
                                            "To mimic foolishly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7def459-d8a5-446b-b3c3-9f539eaa20a5",
                        "source_entry_id": "77a48c58-8c80-3c59-8d1e-dd0333790689",
                        "source_sense_id": "2a0eeb24-73c3-3a71-be9a-886b84d7ca3d",
                        "source_sense_description": "Fou",
                        "target_lang_word": "wacky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wacky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "944696cd-ce79-397d-9219-ced9339d5d0f",
                                        "entry_id": "4fa681fb-226f-3363-91bd-7f8573537bb5",
                                        "glosses": [
                                            "Zany; eccentric."
                                        ],
                                        "tags": [
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd18466-d079-4b06-8f09-41332a65bb8b",
                                                "sense_id": "944696cd-ce79-397d-9219-ced9339d5d0f",
                                                "text": "Though the idea of placing wacky made-up characters in a real-life context was carried over from Da Ali G Show—wherein Buzz Aldrin was once asked if he was upset that Michael Jackson got all the credit for inventing the moonwalk—Sacha Baron Cohen’s Borat felt like something new, an attempt to square an improvised, guerrilla style of underground comedy with reality-TV stunt shows like Jackass or Fear Factor."
                                            },
                                            {
                                                "example_id": "7fa84e90-4312-4c74-ba30-e9aa6f803c80",
                                                "sense_id": "944696cd-ce79-397d-9219-ced9339d5d0f",
                                                "text": "How do artists and curators come up with titles for exhibitions? They seem to get wackier all the time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wacky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dda104e3-7abe-3af4-9d53-79902af1e278",
                                        "entry_id": "ab6b3ef7-a42c-3048-83d0-c3d8523a1ca0",
                                        "glosses": [
                                            "Alternative form of wacke."
