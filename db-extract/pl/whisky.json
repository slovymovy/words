                                        "examples": [
                                            {
                                                "example_id": "0e450106-8ba4-4989-8b3b-db88a8e995fc",
                                                "sense_id": "5efc9efc-9be4-3d2d-b39d-9f1179aaac9d",
                                                "text": "The exceſſive drinking of ſpirituous liquours, eſpecially whiſkey, is now become ſo common, that more people are killed by them, than by ſmall-pox, fevers, broken limbs, accidents, and all other diſtempers put together. And we are credibly informed, that in one dram ſhop only in this town, there are 120 gallons of that accurſed ſpirit, whiſkey, ſold."
                                            }
                                        ]
                                    },
