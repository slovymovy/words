                                "target_senses": [
                                    {
                                        "sense_id": "6b9ee2b0-8df4-3d04-bcd3-f4e53d266ffa",
                                        "entry_id": "58aa4824-7942-3174-953c-b4a3428e9c33",
                                        "glosses": [
                                            "A form of Japanese theatre in which elaborately costumed male performers use stylized movements, dances, and songs in order to enact tragedies and comedies."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8dd5558-0800-4700-8211-73e53a77d735",
                                                "sense_id": "6b9ee2b0-8df4-3d04-bcd3-f4e53d266ffa",
                                                "text": "Despite its self-consciously assumed irreverence toward traditional practices, “Hokaibo” incorporates all the essential elements of classic Kabuki: the all-male company of actors, exaggerated makeup, the stomping dances, the arresting, cross-eyed poses at moments of high drama that are recognized and applauded."
                                            },
                                            {
                                                "example_id": "2fda51b0-64d1-4e47-9988-ddcc10d115c2",
                                                "sense_id": "6b9ee2b0-8df4-3d04-bcd3-f4e53d266ffa",
                                                "text": "Ichikawa, whose real name is Takahiko Kinoshi, made his kabuki debut in 1980 and went on to become one of the country’s most renowned performers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e330e7c0-f55e-3ff5-9514-2a345255a24a",
                                        "entry_id": "58aa4824-7942-3174-953c-b4a3428e9c33",
                                        "glosses": [
                                            "A stylized, pretentious, and often hollow performance; (especially) political posturing."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810d7970-c108-4da2-ac24-bf12f6c205f7",
                                                "sense_id": "e330e7c0-f55e-3ff5-9514-2a345255a24a",
                                                "text": "The whole \"weapons of mass destruction\" concern was phony from the start, and the drama about inspections was just kabuki: going through the motions."
                                            },
                                            {
                                                "example_id": "203a7068-48a6-4e5b-8b35-34c1b098918f",
                                                "sense_id": "e330e7c0-f55e-3ff5-9514-2a345255a24a",
                                                "text": "Health care reform recently brought Kabuki to mind for both Rush Limbaugh—“what you have here is ‘Kabuki theater’”—and New York Times columnist Frank Rich: “[I]f I were to place an incautious bet on which political event will prove the most significant of February 2010, I wouldn’t choose the kabuki health care summit.”"
                                            },
                                            {
                                                "example_id": "edaff2b5-3f3a-4f1d-b232-e86640d27023",
                                                "sense_id": "e330e7c0-f55e-3ff5-9514-2a345255a24a",
                                                "text": "The boy tells her she will find iPhone chargers if she takes five steps back. Here the performance shifts from mere stiltedness to a kind of hateful Kabuki, an affected defiance of how people naturally act: She walks backward, counting her steps, then turns and slaps her forehead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
