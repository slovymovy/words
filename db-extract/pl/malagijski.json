                                                "sense_id": "c9f30ca6-8959-33ef-955c-15cdea84864c",
                                                "text": "Η θερμοκρασία θα κυμανθεί από 25 ως 28 βαθμούς."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37830645-425f-38f1-ae7c-f8972dae87ca",
                                        "entry_id": "64b12f07-1ba8-3392-a18d-516d12fc9fe1",
