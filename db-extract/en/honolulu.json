                                            {
                                                "example_id": "e7d21c99-306a-48c4-a985-addb5a9a29bf",
                                                "sense_id": "392c7e46-95c2-3beb-9cf3-f8f4304066fe",
                                                "text": "Vingt jours plus tard, le Rendeer fit à Honolulu, capitale des îles Sandwich, une relâche fort gaie qui dura deux mois."
                                            }
                                        ]
                                    }
                                ]
                            }
