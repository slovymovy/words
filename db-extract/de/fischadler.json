                        "entry_id": "5d7f37a8-bb09-353d-965f-c093798d6c07",
                        "glosses": [
                            "Raubvogel der Art Pandion haliaetus, der Fisch frisst und weißes Gefieder an der Bauchseite hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da3439f-708a-4746-92c6-c45019d0ce12",
                                "sense_id": "71166e2f-c9e2-34a1-b9a9-6c7313a452d0",
                                "text": "„Ein Fischadler stieß auf den See herab.“"
                            },
                            {
                                "example_id": "e05e06b1-3f1b-4580-90f2-78f546938040",
                                "sense_id": "71166e2f-c9e2-34a1-b9a9-6c7313a452d0",
                                "text": "„Ich sehe den Fischadler – Kalasääski – seit man ihn hier auf den Inseln erwähnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
