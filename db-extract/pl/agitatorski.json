                                        "examples": [
                                            {
                                                "example_id": "07c02913-2ef1-43cf-a311-9fe61860c4ca",
                                                "sense_id": "652531d8-dd7d-3c4c-a64a-2ae4a5b9a54b",
                                                "text": "„In der folgenden Stunde wurde die Klasse gleich von zwei Lehrern agitatorisch bearbeitet.“"
                                            },
                                            {
                                                "example_id": "6d9fe10a-b4d1-4a4f-9381-7529f84d6f8a",
                                                "sense_id": "652531d8-dd7d-3c4c-a64a-2ae4a5b9a54b",
                                                "text": "„Männer wie Surendranath Banerjee waren Abgeordnete geworden und übten sich nun in parlamentarischen Debatten statt in agitatorischen Reden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
