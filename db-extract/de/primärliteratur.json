                "senses": [
                    {
                        "sense_id": "3d4514e4-72e4-3bba-9cde-010f118bd081",
                        "entry_id": "61f8eeee-0a22-3e72-bcf9-c10cd5ede072",
                        "glosses": [
                            "Text(e) ohne Vorgängertext(e); Texte, denen das vorrangige Interesse gilt und die man sich gegebenenfalls mit Hilfe von Unterricht oder Sekundärliteratur erschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4202df2-c012-4a65-9035-d6a61146225e",
                                "sense_id": "3d4514e4-72e4-3bba-9cde-010f118bd081",
                                "text": "„Der Bericht sammelt Stellungnahmen, die wiederum andere Gremien und Behörden (sogenannte \"Aggregatoren\") aus aller Welt aus dem Studium wissenschaftlicher Primärliteratur zusammengetragen und der Öffentlichkeit zur Verfügung gestellt haben.“"
                            },
                            {
                                "example_id": "796ceb17-de72-4a39-98e0-e5000b31e55a",
                                "sense_id": "3d4514e4-72e4-3bba-9cde-010f118bd081",
                                "text": "„Schließlich empfahl er mir, ich solle meine arabischen Wörterbücher zur Seite legen, philosophische Lexika kaufen und möglichst viel Sekundärliteratur lesen, bevor ich überhaupt mit der Primärliteratur anfinge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
