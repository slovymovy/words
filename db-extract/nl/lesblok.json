                        "examples": [
                            {
                                "example_id": "82a5d42a-a1b8-44b9-8e23-418150704216",
                                "sense_id": "13e57d74-c117-31c5-ade2-fa726a8b74e1",
                                "text": "Ieder jaar worden leerlingen van groep 7 naar het Parkstad Limburg Stadion gehaald voor lesblokken over ’Voeding & Gezondheid’, ’Weerbaarheid’ en ’Financiële Gezondheid’."
                            },
                            {
                                "example_id": "95b4591b-3c08-4f4b-899e-cc5dec6e918c",
                                "sense_id": "13e57d74-c117-31c5-ade2-fa726a8b74e1",
                                "text": "Naast de gewone vakken krijgen ze drie tot vier keer gericht onderwijs over gamen en e-sport. Het gaat dan om lesblokken van bijna twee uur. In het schooljaar 2017-2018 moet de opleiding plaats bieden aan ongeveer dertig leerlingen."
                            },
                            {
                                "example_id": "932c65e4-54e0-4a6f-b1c7-f69b5037304c",
                                "sense_id": "13e57d74-c117-31c5-ade2-fa726a8b74e1",
                                "text": "Om het gebrek aan stageplaatsen op te vangen, hebben de hogescholen geschoven met de lesblokken. Blokken met theorie zijn naar voren gehaald, of juist naar achter geschoven als iemand wel op stage kon. Stages zijn verkort, zodat er meer mensen mee konden lopen."
                            }
                        ]
                    }
