{
    "word_family": [
        "lacerate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "efae1d88-41ee-3ed6-8670-7401a8973330",
                    "sense_definition": "A deep cut or tear in the skin or flesh.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor carefully cleaned and stitched the deep <w>laceration</w> on his forearm.",
                            "target_lang_translations": {
                                "ru": "Врач аккуратно очистил и зашил глубокую <w>рваную рану</w> на его предплечье."
                            }
                        },
                        {
                            "text": "Paramedics treated several victims for severe <w>lacerations</w> caused by flying glass.",
                            "target_lang_translations": {
                                "ru": "Парамедики оказали помощь нескольким пострадавшим с тяжёлыми <w>рваными ранами</w>, полученными от осколков стекла."
                            }
                        }
                    ],
                    "synonyms": [
                        "gash",
                        "wound",
                        "cut"
                    ],
                    "common_phrases": [
                        "deep laceration",
                        "severe lacerations",
                        "minor lacerations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий порез или рваная рана на коже или плоти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рваная рана",
                                "target_lang_sense_clarification": "повреждение тканей с неровными краями"
                            },
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "место механического нарушения целостности ткани"
                            },
                            {
                                "target_lang_word": "глубокий порез",
                                "target_lang_sense_clarification": "глубокая рана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77ddf1dc-66cd-305f-be00-42f0f88b13e4",
                    "sense_definition": "The act or process of tearing or deeply cutting something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe <w>laceration</w> of soft tissue occurred during the violent impact.",
                            "target_lang_translations": {
                                "ru": "Сильный <w>разрыв</w> мягких тканей произошёл во время мощного удара."
                            }
                        },
                        {
                            "text": "Surgeons managed to stop the bleeding caused by the <w>laceration</w> of an artery.",
                            "target_lang_translations": {
                                "ru": "Хирургам удалось остановить кровотечение, вызванное <w>разрывом</w> артерии."
                            }
                        }
                    ],
                    "synonyms": [
                        "tearing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс разрывания или глубокого рассечения ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "процесс нарушения целостности"
                            },
                            {
                                "target_lang_word": "разрывание",
                                "target_lang_sense_clarification": "действие по разрыванию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}