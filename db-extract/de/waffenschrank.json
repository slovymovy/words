                "senses": [
                    {
                        "sense_id": "47880c92-2c25-3d17-b824-32c5a00c20a2",
                        "entry_id": "a957a31d-bbb3-344b-8ed4-8ac77caeb197",
                        "glosses": [
                            "verschließbarer Schrank zur sicheren Aufbewahrung von Waffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f560ffce-0148-4aa3-bc08-d6304d009e04",
                                "sense_id": "47880c92-2c25-3d17-b824-32c5a00c20a2",
                                "text": "„Außerdem spreche vieles dafür, dass Tim K. Zugang zum Waffenschrank und zum Munitionsschrank hatte, ohne dass dies sein Vater wusste: […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a486b0ec-5e19-4883-8570-8372e4689293",
                        "source_entry_id": "a957a31d-bbb3-344b-8ed4-8ac77caeb197",
                        "source_sense_id": "47880c92-2c25-3d17-b824-32c5a00c20a2",
                        "source_sense_description": "verschließbarer Schrank zur sicheren Aufbewahrung von Waffen",
                        "target_lang_word": "armoire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armoire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b79da4-65fb-34b8-9df7-edb94ec5a37c",
                                        "entry_id": "fd09acd8-8274-3f5c-a1fc-ce3524e1f4b9",
                                        "glosses": [
                                            "A type of cupboard, cabinet, or wardrobe, originally used for storing weapons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a185844c-9e96-4163-96e8-c1bf3e8b638c",
                                                "sense_id": "b3b79da4-65fb-34b8-9df7-edb94ec5a37c",
                                                "text": "The furnishing of this Blue Room was solid and Victorian, it having been the GHQ of my Uncle Tom's late father, who liked things substantial. There was a four-poster bed, a chunky dressing-table, a massive writing table, divers chairs, pictures on the walls of fellows in cocked hats bending over females in muslin and ringlets and over at the far side a cupboard or armoire in which you could have hidden a dozen corpses."
                                            },
                                            {
                                                "example_id": "73476f8b-611c-4e36-98e7-4ea39fdfb74b",
                                                "sense_id": "b3b79da4-65fb-34b8-9df7-edb94ec5a37c",
                                                "text": "Downing the drink in a single gulp, I move over to the Anatolian white-oak armoire where I keep a brand-new nail gun I bought last week at a hardware store near my office in Wall Street."
                                            },
                                            {
                                                "example_id": "5a7a94fe-9153-4e7e-a5f5-a87223481bb5",
                                                "sense_id": "b3b79da4-65fb-34b8-9df7-edb94ec5a37c",
                                                "text": "She got up without lighting the lamp, felt around in the armoire for an archaic revolver that no one had fired since the War of a Thousand Days, and located in the darkness not only the place where the door was but also the exact height of the lock."
                                            },
                                            {
                                                "example_id": "73809257-0bab-499d-a815-c05b93079615",
                                                "sense_id": "b3b79da4-65fb-34b8-9df7-edb94ec5a37c",
                                                "text": "In 2003, at Neal Auction Company in New Orleans, an 1810s mahogany armoire inlaid with ribbons and vines brought $140,000 (the presale estimate was $30,000 to $50,000)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
