                "translations": [
                    {
                        "translation_id": "dc4b0854-fa80-4b2a-b933-2ca9ac3ebb6d",
                        "source_entry_id": "deadb021-3362-35dc-a440-25784bb62ec4",
                        "source_sense_id": "88adf260-4597-3be7-a1bd-594d4c97a19c",
                        "source_sense_description": "(plantkunde) (voeding) nootjes waarmee apen graag verwend worden: pinda'sde nootachtige vrucht van Arachis hypogaea, die onder de grond groeit",
                        "target_lang_word": "arachide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arachide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41952f47-7f46-3c76-a2a2-9c5ef48bd853",
                                        "entry_id": "3335e8f9-3ba2-3808-9bfa-f51d4d978373",
                                        "glosses": [
                                            "Légumineuse originaire du Mexique, cultivée dans les régions tropicales, sub-tropicales et tempérées, et dont les fruits enterrés après la fécondation contiennent des graines oléagineuses qui fournissent par la pression une huile blanche, d’une saveur agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded03912-e89a-4cb7-85ee-9896f9715657",
                                                "sense_id": "41952f47-7f46-3c76-a2a2-9c5ef48bd853",
                                                "text": "L’arachide est consommée soit en graine, soit sous forme d’huile, soit sous des formes plus ou moins élaborées issues du marché de l’arachide de bouche et de confiserie : beurre, pâte, farine, confiserie, etc. Les sous-produits donnent lieu à des utilisations diverses :\n- fourrage pour les pailles,\n- combustible, compost, panneaux d’agglomérés pour les coques vides,\n- alimentation humaine ou animale pour les tourteaux…\nL’arachide est originaire du bassin amazonien […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a4f641-5ff1-3a4e-9c3b-b6917e04baa1",
                                        "entry_id": "3335e8f9-3ba2-3808-9bfa-f51d4d978373",
                                        "glosses": [
                                            "Le mot arachide peut aussi désigner le fruit de l'arachide, en tant que synonyme de cacahuète."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "133db35a-1c18-4728-a020-bfac63dbfcc6",
                                                "sense_id": "93a4f641-5ff1-3a4e-9c3b-b6917e04baa1",
                                                "text": "Plus frais dans l'bocal, que l'arachide dans l'écale."
                                            },
                                            {
                                                "example_id": "a12c73e3-7745-4eb2-b5e6-7f5475ae01d6",
                                                "sense_id": "93a4f641-5ff1-3a4e-9c3b-b6917e04baa1",
                                                "text": "Dans chaque trou ou jette une ou deux arachides, on renverse de la terre que l'on tasse simplement avec le pied."
                                            },
                                            {
                                                "example_id": "935e875e-5f04-4b01-8cc3-b0fe10b882a0",
                                                "sense_id": "93a4f641-5ff1-3a4e-9c3b-b6917e04baa1",
                                                "text": "Reste plus frais dans le bocal que l'arachide dans l'écale,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3aeb7c39-fc53-409a-8495-53f52214b3ec",
                        "source_entry_id": "deadb021-3362-35dc-a440-25784bb62ec4",
                        "source_sense_id": "88adf260-4597-3be7-a1bd-594d4c97a19c",
                        "source_sense_description": "(plantkunde) (voeding) nootjes waarmee apen graag verwend worden: pinda'sde nootachtige vrucht van Arachis hypogaea, die onder de grond groeit",
                        "target_lang_word": "cacahuète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacahuète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c42f10a-9e36-3531-a008-a50d7891f5c9",
                                        "entry_id": "bb6e62c7-0db2-35fc-a828-af5bfa3fb6f5",
                                        "glosses": [
                                            "Fruit ou graine de l’arachide, dont on extrait de l’huile ou que l’on consomme torréfié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96c30ef-fa54-439c-a3b9-ba1c565e84d9",
                                                "sense_id": "4c42f10a-9e36-3531-a008-a50d7891f5c9",
                                                "text": "Il faisait trop beau pour s’enfermer, exception faite d’un pauvre gars accoudé au comptoir et déjà à moitié ivre qui grignotait des cacahuètes."
                                            },
                                            {
                                                "example_id": "e5c6ce2b-c824-41f4-80dd-9e27c8109e35",
                                                "sense_id": "4c42f10a-9e36-3531-a008-a50d7891f5c9",
                                                "text": "Le roi de la fête était vêtu d’une chemisette vert kaki sous une veste beige. Un index replié sur une cacahuète, il accueillait ses invités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd0e8a1f-d506-3ad9-91d7-034ab6bcdf99",
                                        "entry_id": "bb6e62c7-0db2-35fc-a828-af5bfa3fb6f5",
                                        "glosses": [
                                            "Testicule."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f1601cc-e3dc-328e-a939-9ee344e6910c",
                                        "entry_id": "bb6e62c7-0db2-35fc-a828-af5bfa3fb6f5",
                                        "glosses": [
                                            "Presque rien."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aac1d54-797c-4381-8744-1a3aa3cd899f",
                                                "sense_id": "1f1601cc-e3dc-328e-a939-9ee344e6910c",
                                                "text": "D’ailleurs, Jean-Marie Le Pen l’a toujours dit, on n’en veut pas aux immigrés, on en veut à ceux qui les ont fait venir pour faire baisser les salaires et les payer des cacahuètes, comme il dit, voilà, hein !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
