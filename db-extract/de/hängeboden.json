                ],
                "senses": [
                    {
                        "sense_id": "a948f65b-1834-3336-8370-2057753d7bc4",
                        "entry_id": "76da525b-85e9-3a51-a4e8-0377e6009137",
                        "glosses": [
                            "Konstruktion (oft aus Holz), die unter das Dach oder die Decke gehängt wird als eine Art zweite Decke, beispielsweise für Stauraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1e77b7-4005-4fe0-8595-3db2d32f5b4e",
                                "sense_id": "a948f65b-1834-3336-8370-2057753d7bc4",
                                "text": "Ich habe in meiner Wohnung zu wenig Platz für mein Werkzeug, meine Koffer und Wintersachen. Ich werde mir einen Hängeboden in den Flur einbauen."
                            },
                            {
                                "example_id": "cd344ee9-79e7-48a0-99ab-419d9a8f55a8",
                                "sense_id": "a948f65b-1834-3336-8370-2057753d7bc4",
                                "text": "[Mietwohnung:] „Ziemlich unstrittig ist, dass man ohne Zustimmung eine Zwischendecke als Hängeboden einziehen darf, um dort Dinge zu lagern, die man nicht täglich braucht (Landgericht Berlin vom 18. Mai 2001 – 65 S 503/00).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                        "entry_id": "76da525b-85e9-3a51-a4e8-0377e6009137",
                        "glosses": [
                            "der durch [1] entstehende Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a04004-753d-4e63-bc3b-2ed071f2deae",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "Auf meinem Hängeboden liegt soviel Krempel rum, den räume ich jetzt auf."
                            },
                            {
                                "example_id": "9ffc40d2-a2e9-47ea-a719-f81a6ac4fe6d",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "Ich habe Anfang Mai meine Sommersachen vom Hängeboden geholt."
                            },
                            {
                                "example_id": "f36097a4-e3ce-40df-ac37-8911256d7cb1",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Ich habe eine Kammer, in der meine Wanderschuhe stehen. Und einen Bergschrank, in dem alles Mögliche an Equipment lagert: Steigeisen, Biwaksäcke, Gamaschen. Die Rucksäcke passen da schon nicht mehr rein, die sind auf dem Hängeboden.“"
                            },
                            {
                                "example_id": "84fca146-0dad-4496-84b7-fca49ae48444",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Der große Koffer mit den eingebündelten Seidenstoffen steht immer noch auf dem Hängeboden,“ […]."
                            },
                            {
                                "example_id": "885399d8-3d7b-4271-b1bc-47e9ddae6b6b",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Da oben auf dem Hängeboden, da müssten noch alte Fotos sein.“"
                            },
                            {
                                "example_id": "7139b26c-faac-4fd9-8a78-8512c4042a97",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Eine Menge Bananenkisten und Stoffsäcke waren auf dem Hängeboden gestapelt.“"
                            },
                            {
                                "example_id": "c79f18aa-de7c-4d54-ac9a-da68d077ac54",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Es war ein großer Hängeboden. Daniel hatte ihn gebaut, nachdem sie eingezogen waren.“"
                            },
                            {
                                "example_id": "1235385d-9d6a-42eb-be40-613c11de12e8",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„»Als du vorgestern abend fortgegangen warst, da ließ ich von den beiden Mädchen die Körbe, in denen meine Kostüme liegen, vom Hängeboden herunterholen.«“"
                            },
                            {
                                "example_id": "55200de6-9db4-4b5b-9fed-6619a792a9da",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "[Dienstmädchen um 1900:] „Von Berliner Dienstmädchen weiß man, dass sie oft noch nicht einmal eine eigene Kammer hatten, sondern auf so genannten Hängeböden schliefen, einer kleinen Fläche von etwa zwei mal zwei Metern bei einer Raumhöhe von etwa 1,50 Metern.“"
                            },
                            {
                                "example_id": "f280f276-4301-4aed-bdab-9015d1e970f1",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "[Oft kam die Haushälterin] „als junges Mädchen vom Land in die Stadt, schuftete bereits als 14-Jährige 15 Stunden und mehr am Tag, putzte, wusch Wäsche, schleppte Wasser, räumte auf und schlief in der Küche oder im Hängeboden.“"
                            },
                            {
                                "example_id": "85fa09f6-d3f5-440f-b79d-6ec9783b16f9",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Während man noch oben auf der Leiter stand und in den Hängeboden sah, fragte man sich jedenfalls, ob hier früher einmal wirklich Dienstmädchen untergebracht worden waren“ […]."
                            },
                            {
                                "example_id": "5985089a-1373-4ea0-94b2-e9b2e53c8ef6",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Auf dem Hängeboden wurde ein zweiter, 29jähriger Mann entdeckt, der sich in einem Pappkarton verstecken wollte.“"
                            },
                            {
                                "example_id": "5f29cd96-0bda-4b80-a575-0258b6c6b69c",
                                "sense_id": "0fa5ffa4-29f2-303a-b822-74a56ef2b7f7",
                                "text": "„Er deutet auf einen Hängeboden unter dem Dach, der nur durch eine einziehbare Leiter zu erreichen ist. Der Jude kriecht hinein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
