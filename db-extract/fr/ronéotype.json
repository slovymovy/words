                        "sense_id": "ee70857c-c582-3432-b594-14ea63accab9",
                        "entry_id": "1bbb159f-8b60-37eb-9e32-d2ed1ad6fc25",
                        "glosses": [
                            "Machine destinée à faire des copies de documents en grand nombre en ronéotypie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74126bc5-9d65-40d8-b3b3-a7bad6c64fb6",
                                "sense_id": "ee70857c-c582-3432-b594-14ea63accab9",
                                "text": "La machine à écrire sur la consolette Louis XV, la ronéotype sur le bureau Napoléon III, des paquets de papier partout sur un vestige de tapis de la Savonnerie, et des cendriers pleins de clopes dans tous les coins."
                            },
                            {
                                "example_id": "ce9f4e89-6985-40ef-90ee-d93fb102b8fc",
                                "sense_id": "ee70857c-c582-3432-b594-14ea63accab9",
                                "text": "En janvier 1952, la section du Centre signale qu'il lui faut rembourser la fédération, acheter une ronéotype et une machine à écrire, faire face à des frais de fonctionnement accrus et payer le loyer de son local."
                            }
                        ]
                    }
