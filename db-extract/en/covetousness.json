                        "target_lang_word": "pożądliwość",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pożądliwość",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b7a1ef5-06a0-31ca-a05a-ef8a493ced6c",
                                        "entry_id": "de48141e-a39c-3079-b562-6ea08a8c3f7c",
                                        "glosses": [
                                            "cecha tego, co pożądliwe; cecha tych, którzy są pożądliwi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0221ec5-053a-4b70-8abe-bdbf48d4d9e3",
                                                "sense_id": "8b7a1ef5-06a0-31ca-a05a-ef8a493ced6c",
                                                "text": "Świat zaś przemija, a z nim jego pożądliwość; kto zaś wypełnia wolę Bożą, ten trwa na wieki."
                                            },
                                            {
                                                "example_id": "b73583f3-4f98-476e-b0b5-ef0bb0f1e6d8",
                                                "sense_id": "8b7a1ef5-06a0-31ca-a05a-ef8a493ced6c",
                                                "text": "Patrzył jak ból pożądliwości, niezaspokojonej pożądliwości rozrywa mnie wprost na strzępy, kawałkuje, rozdziera."
