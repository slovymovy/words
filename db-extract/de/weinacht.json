                "senses": [
                    {
                        "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                        "entry_id": "4ebe4998-d325-31ed-a0b0-51d004d1288c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a92c7da7-403e-47bb-8a40-5387cf9d8d71",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Frau Weinacht ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c303aaec-fd7e-4042-955e-93c85bb9ba55",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Herr Weinacht wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "784642ea-9511-4655-9a2c-c133d33ecc00",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Die Weinachts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d6354ddf-d657-4647-a1b0-ef2418386505",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Der Weinacht trägt nie die Schals, die die Weinacht ihm strickt."
                            },
                            {
                                "example_id": "8c2c8a72-30dd-4fcc-9819-583f97fef449",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weinacht kommt, geht der Herr Weinacht.“"
                            },
                            {
                                "example_id": "cd1df2c7-ada7-41c0-b73b-c5613bfcaa83",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Weinacht kommt und geht."
                            },
                            {
                                "example_id": "9babed72-f389-4f85-b277-82823468491d",
                                "sense_id": "6874b0a6-a282-3574-94cc-13bfd052eb64",
                                "text": "Weinachts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
