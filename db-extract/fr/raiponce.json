                "forms": [],
                "senses": [
                    {
                        "sense_id": "dcc6ed3f-fa4a-3eb7-9f42-cd3117e1d63a",
                        "entry_id": "1bbd76b5-6b0a-366d-96dc-289bc6fbbac0",
                        "glosses": [
                            "Conte allemand, des frères Grimm, racontant l’histoire d’une jeune fille emprisonnée dans une tour qui laisse tomber sa longue chevelure pour qu’un sauveur puisse l’escalader."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "edf21eb4-df78-3a36-89f4-9c1f28ed5401",
                        "entry_id": "1bbd76b5-6b0a-366d-96dc-289bc6fbbac0",
                        "glosses": [
                            "Personnage principal du conte."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1647d7cf-7378-4df6-a33f-03b8edfa497a",
                        "source_entry_id": "1bbd76b5-6b0a-366d-96dc-289bc6fbbac0",
                        "target_lang_word": "Rapunzel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rapunzel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c9d27d-f3cb-310f-8bc7-f7ac51c40f99",
                                        "entry_id": "eac4ed05-bdfa-3073-b59a-368dd82795f3",
                                        "glosses": [
                                            "A German fairy tale about a girl imprisoned in a tower who lets down her long hair for a rescuer to climb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "590404d1-7231-3e0b-8d73-3af9fb5d4f45",
                                        "entry_id": "eac4ed05-bdfa-3073-b59a-368dd82795f3",
                                        "glosses": [
                                            "The fictional girl who is the protagonist and title character of the fairy tale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f71e0c2-db19-461c-91cd-3a3909facaa9",
                                                "sense_id": "590404d1-7231-3e0b-8d73-3af9fb5d4f45",
                                                "text": "[…] as they loll in pairs or trios, looking down from the windows like Rapunzels and carpet-knights, while they eat bruised apricots, tomorrow is always on their lips as honey to come."
                                            },
                                            {
                                                "example_id": "44bc69ea-0452-4cf3-807b-66677ec5436e",
                                                "sense_id": "590404d1-7231-3e0b-8d73-3af9fb5d4f45",
                                                "text": "I spot Sleeping Beauty in a thorn forest. Two of them, only they are more like Rapunzels who’ve fallen from their tower."
                                            },
                                            {
                                                "example_id": "f9670327-6aa5-40c9-bdc6-d3b49899065e",
                                                "sense_id": "590404d1-7231-3e0b-8d73-3af9fb5d4f45",
                                                "text": "He keeps all three of us locked up like Rapunzels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
