        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b6c1ac4-754b-3e70-bcd1-f8f86538383d",
                    "sense_definition": "An out-of-control sliding motion of a vehicle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sliding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car went into a <w>skid</w> on the icy road.",
                            "target_lang_translations": {
                                "cs": "Auto na zledovatělé silnici <w>dostalo smyk</w>.",
                                "nl": "De auto raakte in een <w>slip</w> op de ijzige weg.",
                                "fr": "La voiture est partie en <w>dérapage</w> sur la route verglacée."
                            }
                        },
                        {
                            "text": "The driver lost control and the car ended up in a dangerous <w>skid</w>.",
                            "target_lang_translations": {
                                "cs": "Řidič ztratil kontrolu a auto skončilo v nebezpečném <w>smyku</w>.",
                                "nl": "De bestuurder verloor de controle en de auto belandde in een gevaarlijke <w>slippartij</w>.",
                                "fr": "Le conducteur a perdu le contrôle et la voiture a fini dans un dangereux <w>dérapage</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go into a skid"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekontrolovaný klouzavý pohyb vozidla.",
                        "nl": "Een ongecontroleerde glijdende beweging van een voertuig.",
                        "fr": "Glissade incontrôlée d'un véhicule."
                    },
                    "translations": {
