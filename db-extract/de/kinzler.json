                ],
                "senses": [
                    {
                        "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                        "entry_id": "f4821c1a-01d7-3258-9e5b-2adf4bbd2c5a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe908037-6196-403d-8c27-8b01ac9b3105",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Frau Kinzler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4efb9b7c-fd74-481d-9100-15623ffd659d",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Herr Kinzler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6fd2babd-1ac7-4ed2-a6c0-021983295e0a",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Die Kinzlers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1b19d47e-27a3-4023-bc8c-1afbb952f1b9",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Der Kinzler trägt nie die Schals, die die Kinzler ihm strickt."
                            },
                            {
                                "example_id": "8fd69386-b044-45b3-a936-c9d497e4f2c5",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kinzler kommt, geht der Herr Kinzler.“"
                            },
                            {
                                "example_id": "c4faf9e2-9ee0-49e9-a8af-95a3ad47bea1",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Kinzler kommt und geht."
                            },
                            {
                                "example_id": "76e9bb7b-2f77-49c1-82a3-47ae121f4f6d",
                                "sense_id": "d7fec238-63b8-3179-9d86-e5b0a9b0b5c0",
                                "text": "Kinzlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
