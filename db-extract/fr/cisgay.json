                                "target_senses": [
                                    {
                                        "sense_id": "b15430b3-68e5-3c83-86ad-4941dedfd516",
                                        "entry_id": "25035b25-2e96-3867-8716-bc72fef4bec5",
                                        "glosses": [
                                            "Cisgender and gay."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9ab452-3ab5-4f54-a6d7-8e486ff5e113",
                                                "sense_id": "b15430b3-68e5-3c83-86ad-4941dedfd516",
                                                "text": "Unfortunately, the film also falls into the trap of connecting a non-passing body with unavoidable consequences of violence in a scene in which [trans man] Lukas has to escape a rape attempt by one of his cis-gay colleagues."
                                            },
                                            {
                                                "example_id": "f8528b63-0402-4012-91c1-211ffaec5f72",
                                                "sense_id": "b15430b3-68e5-3c83-86ad-4941dedfd516",
                                                "text": "A nation is considered progressive insofar as its gay population has access to same-sex marriage, can serve in the military, and can adopt children – mainly the experience of white cisgay men in the United States (Puar, 2013, 337)."
                                            },
                                            {
                                                "example_id": "1392ae96-3e46-4f83-b56d-5d9ed104e1c0",
                                                "sense_id": "b15430b3-68e5-3c83-86ad-4941dedfd516",
                                                "text": "Thus, when I refer to phallocentrism in cisgay porn, I am being quite literal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
