                        "cross_references": [
                            {
                                "target_word": "supper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ffaf249-c107-34d1-b74c-b799d6811b5f",
                                        "entry_id": "39ec5ed8-3635-3b12-9193-03f275d68ced",
                                        "glosses": [
                                            "Food consumed before going to bed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433c9eab-d0b5-49ae-b3ee-fcfc0e240212",
                                                "sense_id": "9ffaf249-c107-34d1-b74c-b799d6811b5f",
                                                "text": "There he stood, with admirable patience, […] longing to go to rest for hours past; aware that suppers disagreed with him […] so tired and longing for bed!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a076aef7-da5e-30a9-8f06-1d7534616e95",
                                        "entry_id": "39ec5ed8-3635-3b12-9193-03f275d68ced",
                                        "glosses": [
                                            "Any meal eaten in the evening; dinner eaten in the evening, rather than at noon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "770ef549-1677-4602-b06d-4ecedcbcb945",
                                                "sense_id": "a076aef7-da5e-30a9-8f06-1d7534616e95",
                                                "text": "We normally have supper at 7."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a87f272f-6aad-3810-8d08-386a2a3657c2",
                                        "entry_id": "39ec5ed8-3635-3b12-9193-03f275d68ced",
                                        "glosses": [
                                            "A meal from a chip shop consisting of a deep-fried food with chips."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Northern-Ireland",
                                            "Scotland",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c206300-ac9f-411f-8cfe-f21b02224b12",
                                                "sense_id": "a87f272f-6aad-3810-8d08-386a2a3657c2",
                                                "text": "a fish supper"
                                            },
                                            {
                                                "example_id": "05f4b819-7e9a-4aca-ba7d-23c52cd11700",
                                                "sense_id": "a87f272f-6aad-3810-8d08-386a2a3657c2",
                                                "text": "Roisin the savior paraded into the front room with three fish suppers, one sausage supper, one single fish, one single chips, a single sausage, a chicken and chips, and three curry and chips."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ccbcf9-1a84-33d9-824b-93e85a024e03",
                                        "entry_id": "225035a6-6d08-361b-b1bc-fae8c382730a",
                                        "glosses": [
                                            "To consume a snack before going to bed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b542473f-d741-30f6-aa51-8800fa9222c2",
                                        "entry_id": "225035a6-6d08-361b-b1bc-fae8c382730a",
                                        "glosses": [
                                            "To eat dinner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                        "entry_id": "225035a6-6d08-361b-b1bc-fae8c382730a",
                                        "glosses": [
                                            "To provide (a person or animal) with supper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6779f29d-5dc1-43c1-ac0d-5522153b1259",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "Horns in the night-season are heard a great way off, and in the winter-season were blown at every farmer’s house about eight at night when they suppered the horses and cows; […]"
                                            },
                                            {
                                                "example_id": "2aab7b8f-23a2-4dfa-9dd2-3e3bc10a195b",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "I went to supper up my horses, and heard somebody; […] After suppering the horses, I went into the house, and saw Stacey, who asked me if I had suppered the horses."
                                            },
                                            {
                                                "example_id": "f325621f-819f-4cb1-95ad-c0e4349ccf9e",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "Foreigners, and deaf-mutes especially, who are not familiar with what we call “good usage,” frequently fall into ludicrous mistakes in framing sentences out of the elements that have been given them. One writes: […] “My friend suppered me” instead of gave me supper. Such expressions are according to rule, and appear singular only because they have not come into general use."
                                            },
                                            {
                                                "example_id": "b2289afc-bf13-43d0-ad18-33ef3d6adf81",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "It was Friday when this idea suggested itself to my mind, and, so soon as I had suppered the horses, I dashed into the wood, disturbing pheasants right and left, and forcing the lively rabbits, out for the evening’s sports, to beat a hasty retreat!"
                                            },
                                            {
                                                "example_id": "833d6575-a94c-41ef-b72d-b8e3ccf8e79b",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "My birthday was a “Fourth of July” from early a. m., when your sweet gift greeted me, till 2 a. m., when “The Players” “suppered” me gorgeously."
                                            },
                                            {
                                                "example_id": "740e76cb-4248-4ae4-b07e-78fdfc4b6b95",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "In his new employment it was agreed that David should be allowed to go on winter nights at eight o’clock, after he had suppered the horses, to a night school at a place called Millwell, perhaps about three miles or so distant, to take lessons in arithmetic."
                                            },
                                            {
                                                "example_id": "728ab7e7-b407-40ed-ad6d-c6fcf5c1b2d7",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "Ronald went out to Dougal after dinner and stood by him while he suppered the pony."
                                            },
                                            {
                                                "example_id": "292fcc8c-8d1a-4c37-bbd4-829984a88c03",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "[W]hile the prospect of being the gudewife of one of the neighbouring farms, where the farmer held the plough, suppered the horses, turned out and brought in the “kye” when the herd was absent on an errand, and smelt habitually of the stable and the byre, no prospect could have been more odious to her."
                                            },
                                            {
                                                "example_id": "18cf6f2e-8c71-4644-9003-e2ce3ff98f90",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "Snapdragon: […] What wind blew thee hither? / The Beetle: No wind; but that sweet leaf which suppered me / Last eve, and music of our cricket friend, / Who still persists in serenading thee."
                                            },
                                            {
                                                "example_id": "6eb5c207-6127-4059-9790-0d070d005a10",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "His Honour and Mrs Abbott graciously suppered me at Darwin’s Government House in a cool and wholesome lounge room."
                                            },
                                            {
                                                "example_id": "ad51ce26-cc47-43d9-a307-32f7372e4bd9",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "However, once the calves have been suppered, the dogs must be fed too."
                                            },
                                            {
                                                "example_id": "df726cde-1fcf-4586-ade6-5cf5f4600f3f",
                                                "sense_id": "2207c326-49e4-3aad-98f7-c03e65322188",
                                                "text": "Most nights the boy they called Tynan suppered us with scrapple from a can."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supper",
