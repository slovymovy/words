                "senses": [
                    {
                        "sense_id": "f48b393e-2071-35e2-9fee-78b98f7bd53b",
                        "entry_id": "300314c9-e539-327f-8378-39ba3425bb7f",
                        "glosses": [
                            "с.-х. жгут из соломы для перевязки снопов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234f81f9-81fe-4f58-a775-1326a7e6a9cd",
                                "sense_id": "f48b393e-2071-35e2-9fee-78b98f7bd53b",
                                "text": "Когда сноп обхватывали тугим перевяслом в жару, сухое зерно высыпалось из колосьев на пыльную, изборожденную трещинами землю."
                            },
                            {
                                "example_id": "3bd941d6-02a9-42d8-9f27-87a40854f27d",
                                "sense_id": "f48b393e-2071-35e2-9fee-78b98f7bd53b",
                                "text": "без столба и забор не стоит, без перевясла и веник рассыпается"
                            }
                        ]
                    },
                    {
                        "sense_id": "02a62fd8-4d5e-315c-ad3c-03c7aa0af1af",
                        "entry_id": "300314c9-e539-327f-8378-39ba3425bb7f",
                        "glosses": [
                            "устар., с.-х. небольшое одноручное коромысло"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "60d70f7e-0e44-357c-ad43-bcd4f7c97399",
                        "entry_id": "300314c9-e539-327f-8378-39ba3425bb7f",
                        "glosses": [
                            "устар. дужка на посудине, на ведре, на корзине; также дужка у калача"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
