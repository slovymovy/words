                                "sense_id": "1b029b3c-5ba6-3f0a-8190-c22145e5c8e3",
                                "text": "Runter mit den Spendierhosen, Unsichtbarer!",
                                "translation": "Show what you've got [runter mit den Hosen] / stop being so generous [Spendierhosen], invisible one!",
                                "english": "Show what you've got [runter mit den Hosen] / stop being so generous [Spendierhosen], invisible one!"
                            },
                            {
