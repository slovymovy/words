                                            {
                                                "example_id": "6757f07e-af0b-4872-8d0e-e2509a7849a4",
                                                "sense_id": "b9e62c65-9fda-30e7-9a4a-855afe4bf79e",
                                                "text": "Obě ženy nyní poletí zpátky do Kazaně, kam poputuje také tělo Muchametšina."
