{
    "word_family": [
        "inspirer",
        "inspirateur",
        "inspiratrice"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e07ad73-2e97-3a36-bd76-560bccdfcf18",
                    "sense_definition": "Élan créateur ou idée soudaine qui stimule l'activité artistique ou intellectuelle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creativite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre attend patiemment que l'<w>inspiration</w> vienne avant de commencer une nouvelle toile."
                        },
                        {
                            "text": "Cet auteur a une soudaine <w>inspiration</w> pour la fin surprenante de son roman."
                        }
                    ],
                    "common_phrases": [
                        "manquer d'inspiration",
                        "avoir une inspiration",
                        "trouver l'inspiration"
                    ]
                },
                {
                    "sense_id": "522e873a-f9c7-3920-b390-f0644c22945a",
                    "sense_definition": "Action d'aspirer l'air extérieur dans les voies respiratoires et les poumons.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a demandé de prendre une lente et profonde <w>inspiration</w> pendant l'examen."
                        },
                        {
                            "text": "Chaque <w>inspiration</w> d'air pur au sommet de la montagne lui redonnait immédiatement des forces."
                        }
                    ],
                    "synonyms": [
                        "inspir"
                    ],
                    "antonyms": [
                        "expiration"
                    ],
                    "common_phrases": [
                        "inspiration profonde"
                    ]
                },
                {
                    "sense_id": "82147b64-c2dd-31ee-b78f-ea7e808e34b6",
                    "sense_definition": "Chose ou personne qui suscite des idées nouvelles ou guide une création.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creativite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nature sauvage reste une constante source d'<w>inspiration</w> pour beaucoup de poètes."
                        },
                        {
                            "text": "Cette styliste puise son <w>inspiration</w> dans l'artisanat traditionnel de sa région natale."
                        }
                    ],
                    "common_phrases": [
                        "source d'inspiration",
                        "puiser son inspiration"
                    ]
                },
                {
                    "sense_id": "6e842677-99d3-3037-9bf6-cacc72fafa4a",
                    "sense_definition": "Influence ou impulsion surnaturelle attribuée à Dieu ou à une puissance divine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spiritualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la tradition religieuse, ces textes sacrés ont été rédigés sous l'<w>inspiration</w> directe de Dieu."
                        },
                        {
                            "text": "Les croyants voient dans cette décision remarquable la marque indéniable d'une <w>inspiration</w> céleste."
                        }
                    ],
                    "common_phrases": [
                        "inspiration divine",
                        "inspiration céleste"
                    ]
                }
            ]
        }
    ]
}