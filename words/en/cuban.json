                    "sense_id": "f930b84b-5059-3794-aabd-5ed6065de132",
                    "sense_definition": "Relating to Cuba, its people, or its culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
