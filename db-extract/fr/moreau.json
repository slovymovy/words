                "senses": [
                    {
                        "sense_id": "8d0c7c95-487b-3e39-9b63-ddefbe13ba2f",
                        "entry_id": "6c2377e5-8d40-3e89-a8cc-a1e496cc5da0",
                        "glosses": [
                            "Qui a le poil d’un noir foncé, vif et luisant, en parlant d’un cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1842ef-2750-47f3-9e26-8d1b00628637",
                                "sense_id": "8d0c7c95-487b-3e39-9b63-ddefbe13ba2f",
                                "text": "Aux abords de la forêt, le domaine agreste,\nho ! voici que vient le seigneur, il revient encore\nsur son fougueux cheval moreau,\nles fers sonnent joyeusement,\ndroit vers la cabane."
                            },
                            {
                                "example_id": "10dcc38a-54e2-4655-a2cc-32cf182727e5",
                                "sense_id": "8d0c7c95-487b-3e39-9b63-ddefbe13ba2f",
                                "text": "Un cheval moreau galopait à sa suite, à toute allure, et sur le cheval se tenait un cavalier en armure noire, portant un heaume orné des ailes d’un rapace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fc8ea14-f4ad-4883-b1b3-9422ba42da2d",
                        "source_entry_id": "6c2377e5-8d40-3e89-a8cc-a1e496cc5da0",
                        "source_sense_id": "8d0c7c95-487b-3e39-9b63-ddefbe13ba2f",
