                                "target_senses": [
                                    {
                                        "sense_id": "0deeeacc-2e63-3f0a-a630-774f4ce0356d",
                                        "entry_id": "353c77a6-54a3-37bd-b3e9-d9a2526e531c",
                                        "glosses": [
                                            "Générateur électrochimique produisant de l’électricité grâce à l'oxydation sur une électrode d'un combustible réducteur couplée à la réduction sur l'autre électrode d'un oxydant."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "152563db-d4d5-463e-bf4a-a51fe026ce70",
                                                "sense_id": "0deeeacc-2e63-3f0a-a630-774f4ce0356d",
                                                "text": "Grâce à une pile à combustible, qui transforme l’hydrogène en électricité, tous les types de transport ­(bateau, poids lourd, avion, etc.) pourraient se passer du fioul, du diesel, du kérosène ou de l’essence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
