                "senses": [
                    {
                        "sense_id": "eaf6d5bd-9f58-3db4-a6eb-333df9e40eb3",
                        "entry_id": "613e4484-480a-331d-8320-b07d7b1f925f",
                        "glosses": [
                            "Gesamtheit der Straßen, die miteinander verbunden ein bestimmtes Gebiet erschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142bda37-cf1f-4c85-a2f9-26dee8adc78b",
                                "sense_id": "eaf6d5bd-9f58-3db4-a6eb-333df9e40eb3",
                                "text": "„Swakopmund ist eine kleine germanische Küstenstadt mit rechtwinkligem Straßennetz.“"
                            },
                            {
                                "example_id": "d27685e5-4cad-42f8-9cf2-0d304f3f80c1",
                                "sense_id": "eaf6d5bd-9f58-3db4-a6eb-333df9e40eb3",
                                "text": "„Kurios: Im Stadtentwurf von Aalto und seinem Team erkennt man im Straßennetz als Grundform den Kopf eines Rentiers wieder.“"
                            },
                            {
                                "example_id": "2f8739d5-9bc3-4549-8cfe-5bb3670b7291",
                                "sense_id": "eaf6d5bd-9f58-3db4-a6eb-333df9e40eb3",
                                "text": "„Letzterer war am Reißbrett entstanden und zeichnete sich durch einheitliche Ziegelhäuser mit Wellblechdächern und ein rechtwinkliges Straßennetz aus.“"
                            },
                            {
                                "example_id": "a896126f-fa29-422d-ae7f-834f4b5aa34d",
                                "sense_id": "eaf6d5bd-9f58-3db4-a6eb-333df9e40eb3",
                                "text": "„Wir müssen uns ebenfalls ein dichtes und gut gebautes Straßennetz in Süddeutschland vorstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
