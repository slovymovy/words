{
    "word_family": [
        "sheathe",
        "sheathing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8553cbcb-df21-3e21-b6b4-a4c2b1d6641f",
                    "sense_definition": "A protective case or cover for a sword or knife blade",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protective_cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight pulled his sword from its <w>sheath</w> before the battle began.",
                            "target_lang_translations": {
                                "ru": "Рыцарь вытащил свой меч из <w>ножен</w> перед началом битвы."
                            }
                        },
                        {
                            "text": "He carefully placed the sharp blade back into its leather <w>sheath</w>.",
                            "target_lang_translations": {
                                "ru": "Он осторожно вложил острое лезвие обратно в кожаные <w>ножны</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "case",
                        "cover"
                    ],
                    "common_phrases": [
                        "sword sheath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитный чехол или ножны для клинка меча или ножа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ножны",
                                "target_lang_sense_clarification": "специальный чехол для холодного оружия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57a7232c-04a8-34f1-8218-6c17fc75ff1e",
                    "sense_definition": "The protective outer layer of an electrical cable",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protective_cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plastic <w>sheath</w> protects the internal wires from damage.",
                            "target_lang_translations": {
                                "ru": "Пластиковая <w>оболочка</w> защищает внутренние провода от повреждений."
                            }
                        },
                        {
                            "text": "Inspect the cable <w>sheath</w> for any signs of wear or cracking.",
                            "target_lang_translations": {
                                "ru": "Осмотрите <w>оболочку</w> кабеля на наличие признаков износа или трещин."
                            }
                        }
                    ],
                    "synonyms": [
                        "casing",
                        "covering"
                    ],
                    "common_phrases": [
                        "cable sheath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитная внешняя оболочка электрического кабеля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "внешний защитный слой кабеля"
                            },
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "защитный слой, предотвращающий повреждение проводов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f66557a-5558-3c55-a760-7af944cbddc0",
                    "sense_definition": "A dress that fits closely to the body",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a simple black <w>sheath</w> to the formal dinner party.",
                            "target_lang_translations": {
                                "ru": "На официальный ужин она надела простое черное <w>платье-футляр</w>."
                            }
                        },
                        {
                            "text": "The elegant <w>sheath</w> highlighted her tall and slender figure.",
                            "target_lang_translations": {
                                "ru": "Элегантное <w>платье-футляр</w> подчеркивало ее высокую и стройную фигуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sheath dress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Платье облегающего кроя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платье-футляр",
                                "target_lang_sense_clarification": "узкое, плотно прилегающее к фигуре платье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9de9f4e5-8315-3c59-bc3f-0d45e95da5ff",
                    "sense_definition": "A thin rubber cover used as a contraceptive",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protective_cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using a <w>sheath</w> is an effective way to prevent sexually transmitted infections.",
                            "target_lang_translations": {
                                "ru": "Использование <w>презерватива</w> — эффективный способ предотвращения инфекций, передающихся половым путем."
                            }
                        },
                        {
                            "text": "Public health campaigns encourage the consistent use of a <w>sheath</w>.",
                            "target_lang_translations": {
                                "ru": "Кампании в области общественного здравоохранения поощряют постоянное использование <w>презервативов</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "condom",
                        "rubber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкое резиновое изделие, используемое в качестве средства контрацепции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презерватив",
                                "target_lang_sense_clarification": "средство барьерной контрацепции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d28a6b36-1ed0-3f2d-8a86-d30202aa8cf9",
                    "sense_definition": "To put a sword or knife into its protective case",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "protective_cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier decided to <w>sheath</w> his sword after the fight ended.",
                            "target_lang_translations": {
                                "ru": "Солдат решил <w>вложить</w> свой меч <w>в ножны</w> после окончания боя."
                            }
                        },
                        {
                            "text": "He paused to <w>sheath</w> his blade before approaching the king.",
                            "target_lang_translations": {
                                "ru": "Он остановился, чтобы <w>вложить</w> клинок <w>в ножны</w>, прежде чем подойти к королю."
                            }
                        }
                    ],
                    "antonyms": [
                        "unsheath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вкладывать меч или нож в ножны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладывать в ножны",
                                "target_lang_sense_clarification": "действие по помещению оружия в чехол"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "spelling: usually 'sheathe'"
                        }
                    ]
                }
            ]
        }
    ]
}