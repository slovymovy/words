                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktinometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f56dc55f-61a0-38c3-ae15-6072bd8448c9",
                                        "entry_id": "5fde0527-e452-3305-b853-a11932a54ee6",
                                        "glosses": [
                                            "Apparat zur Messung der direkten Sonneneinstrahlung (Direktstrahlung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e793921-7d01-49c8-802f-29b753508663",
                                                "sense_id": "f56dc55f-61a0-38c3-ae15-6072bd8448c9",
                                                "text": "„Die Lichtwirkung wird mittels des von Besson und Thurneyssen verbesserten Berlanischen Aktinometers gemessen.“"
                                            },
                                            {
                                                "example_id": "304b9e9d-905c-451c-8e63-8ebaa0956417",
                                                "sense_id": "f56dc55f-61a0-38c3-ae15-6072bd8448c9",
                                                "text": "„Gelegentlich einer Untersuchung des STEWART’schen Aktinometers ergiebt sich das Resultat, dass der Wärmegewinn in einem Quecksilberthermometer nur in geringerem Maasse der Absorption im Glase zuzuschreiben sei.“"
                                            },
                                            {
                                                "example_id": "b6e240bb-6b91-4df5-8434-069d0ac05d72",
                                                "sense_id": "f56dc55f-61a0-38c3-ae15-6072bd8448c9",
                                                "text": "„Chwolson zeigt, daß er bis auf 1 % genau mittels dieses Aktinometers den Betrag der Sonnenstrahlung ermitteln könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
