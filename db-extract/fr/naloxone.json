                "word": "naloxone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a708b30a-5933-4362-93c6-f32763fd158b",
                        "entry_id": "643823e5-859a-30b6-add0-aeeb6e548854",
                        "tags": [
                            "plural"
                        ],
