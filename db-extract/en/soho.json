                                "sense_id": "e62611d8-6209-3f2d-887a-66a698e5552d",
                                "text": "When he heard about Omnipork at the Food’s Future Summit in Hong Kong last year, he contacted Right Treat to give it a try, and eventually added it to the vegetarian mapo tofu at his restaurant in the city’s SoHo district."
                            },
                            {
                                "example_id": "2f6ee5af-0482-4115-af10-04ae0850777c",
                                "sense_id": "e62611d8-6209-3f2d-887a-66a698e5552d",
                                "text": "At No. 3 Staunton Street in the city’s SoHo district, the roughly 1,300 square-foot ground floor was once used as a parking space for a Ferrari."
                            },
                            {
                                "example_id": "389f2d0e-11d6-491c-83cb-11f7593cc431",
                                "sense_id": "e62611d8-6209-3f2d-887a-66a698e5552d",
                                "text": "The fire started in a flat at No 9 on Gough Street at Shun King Building in the SoHo area of Sheung Wan at about 10.20pm."
                            }
                        ]
                    }
