                    "sense_id": "dfa270b6-7a8b-3b34-84b4-fac43dfe5aac",
                    "sense_definition": "Een persoon die een voertuig bestuurt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_operator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bestuurder</w> verloor de macht over het stuur en raakte van de weg.",
                            "target_lang_translations": {
                                "ru": "<w>Водитель</w> потерял управление и съехал с дороги.",
                                "en": "The <w>driver</w> lost control of the wheel and went off the road.",
                                "pl": "<w>Kierowca</w> stracił panowanie nad kierownicą i wypadł z drogi.",
                                "de": "Der <w>Fahrer</w> verlor die Kontrolle über das Lenkrad und kam von der Straße ab.",
                                "fr": "Le <w>conducteur</w> a perdu le contrôle du volant et a quitté la route.",
                                "it": "Il <w>conducente</w> ha perso il controllo del volante ed è uscito di strada.",
                                "cs": "<w>Řidič</w> ztratil kontrolu nad volantem a vyjel ze silnice.",
                                "tr": "<w>Sürücü</w> direksiyon hakimiyetini kaybetti ve yoldan çıktı.",
                                "es": "El <w>conductor</w> perdió el control del volante y se salió de la carretera.",
                                "zh": "<w>司机</w>失去了对方向盘的控制，冲出了路面。"
                            }
                        },
                        {
                            "text": "De politie hield de <w>bestuurder</w> van de auto aan voor een controle.",
                            "target_lang_translations": {
                                "ru": "Полиция остановила <w>водителя</w> автомобиля для проверки.",
                                "en": "The police stopped the <w>driver</w> of the car for a check.",
                                "pl": "Policja zatrzymała <w>kierowcę</w> samochodu do kontroli.",
                                "de": "Die Polizei hielt den <w>Fahrer</w> des Autos für eine Kontrolle an.",
                                "fr": "La police a arrêté le <w>conducteur</w> de la voiture pour un contrôle.",
                                "it": "La polizia ha fermato il <w>conducente</w> dell'auto per un controllo.",
                                "cs": "Policie zastavila <w>řidiče</w> auta ke kontrole.",
                                "tr": "Polis, araç <w>sürücüsünü</w> kontrol için durdurdu.",
                                "es": "La policía detuvo al <w>conductor</w> del coche para un control.",
                                "zh": "警察拦下了这辆车的<w>司机</w>进行检查。"
                            }
                        }
