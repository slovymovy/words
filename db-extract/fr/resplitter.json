                "senses": [
                    {
                        "sense_id": "deaf52ac-d8ef-3c61-a915-4e0f51425dd7",
                        "entry_id": "24c69d8a-d09b-304a-903b-2bf08b694b29",
                        "glosses": [
                            "Splitter de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8345d363-f7b9-4385-b750-9884481e4dc3",
                                "sense_id": "deaf52ac-d8ef-3c61-a915-4e0f51425dd7",
                                "text": "Par contre si j'ai à le resplitter, je vais le faire à partir de câble Illico, afin d'avoir une connexion directe pour internet."
                            },
                            {
                                "example_id": "099f25ce-75d2-438d-90dc-82b1af8cd4dc",
                                "sense_id": "deaf52ac-d8ef-3c61-a915-4e0f51425dd7",
                                "text": "Y a toujours moyen de \"désplitter\" le tout et de \"resplitter\" dans l'ordre qu'on veut mais c'est vite lourd comme procédé."
                            },
                            {
                                "example_id": "4e733843-5ad1-47a0-a017-3aa5e3c3c83d",
                                "sense_id": "deaf52ac-d8ef-3c61-a915-4e0f51425dd7",
                                "text": "Maintenant tu me dit de \"resplitter\" pour supprimer le.htm (qui est effectivement présent), mais là encore tu dois bien imaginer ma tête ! — (tete corrigé en tête)"
                            }
                        ]
                    }
