                "senses": [
                    {
                        "sense_id": "a8514f9c-aeed-309b-aa9b-60871c5f00af",
                        "entry_id": "dee1572d-9d2b-3b43-8b6a-43ee22a991c2",
                        "glosses": [
                            "eines von sieben ungelösten mathematischen Problemen, für die ein US-amerikanisches Institut ein Preisgeld von je einer Million US-Dollar ausgelobt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "363a4e31-9f10-47eb-8adf-e8647cf8cd79",
                                "sense_id": "a8514f9c-aeed-309b-aa9b-60871c5f00af",
                                "text": "„Ob der Kasache tatsächlich das Millenniumsproblem gelöst hat, wird wohl erst feststehen, wenn seine Arbeit von unabhängiger Seite geprüft wurde.“"
                            },
                            {
                                "example_id": "532cb410-7876-4a18-a89c-54f5723b58f2",
                                "sense_id": "a8514f9c-aeed-309b-aa9b-60871c5f00af",
                                "text": "„In dem hier vorzustellenden Milleniumsproblem handelt es sich um eine zahlentheoretische Fragestellung aus dem 19. Jahrhundert, die seit ein paar Jahren auch überraschende Zusammenhänge zu anderen Gebieten der Mathematik und der theoretischen Physik erkennen lässt.“"
                            },
                            {
                                "example_id": "b26e18cd-9b11-4b08-a775-f5f99116ca9c",
                                "sense_id": "a8514f9c-aeed-309b-aa9b-60871c5f00af",
                                "text": "„Mit der Lösung der Poincaré-Vermutung gilt erstmals ein Millenniumsproblem als gelöst.“"
                            },
                            {
                                "example_id": "b410f992-9f69-4cb7-8d07-1ad12de43f35",
                                "sense_id": "a8514f9c-aeed-309b-aa9b-60871c5f00af",
                                "text": "„Im Jahr 2000 hat das Clay Mathematics Institute im amerikanischen Cambridge Preise von je einer Million US-Dollar für die Lösung der sieben Millenniumsprobleme ausgeschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
