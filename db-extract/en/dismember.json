                "senses": [
                    {
                        "sense_id": "57563f05-6f6b-3c75-9799-97d7ae39f01a",
                        "entry_id": "2f47db0f-02a1-3427-8bfb-5f1caffacf19",
                        "glosses": [
                            "To remove the limbs of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b12abfa7-b2dc-4cc7-a74c-8586be804eac",
                                "sense_id": "57563f05-6f6b-3c75-9799-97d7ae39f01a",
                                "text": "Death by drawing and quartering usually dismembered the condemned person."
                            }
                        ]
                    },
                    {
                        "sense_id": "0685e5a6-2221-3ec9-9797-0aef7fbc722d",
                        "entry_id": "2f47db0f-02a1-3427-8bfb-5f1caffacf19",
                        "glosses": [
                            "To cut or otherwise divide something into pieces."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a84a04d-21a6-4078-b8ac-2b1968f61bb0",
                                "sense_id": "0685e5a6-2221-3ec9-9797-0aef7fbc722d",
                                "text": "The killer methodically dismembered the bodies of his victims."
                            },
                            {
                                "example_id": "e6530d02-7e9f-4357-9710-603a56d22b0e",
                                "sense_id": "0685e5a6-2221-3ec9-9797-0aef7fbc722d",
                                "text": "The American Civil War nearly dismembered the Union."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fb5ac67-6055-4ad0-97f6-0c744c8db380",
                        "source_entry_id": "2f47db0f-02a1-3427-8bfb-5f1caffacf19",
                        "source_sense_description": "remove limbs",
                        "target_lang_word": "démembrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démembrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7509cfbe-c5db-3075-98dc-dc95ff7a0198",
                                        "entry_id": "ae8f8f49-d2b1-3911-9730-6d39d9e0ecd6",
                                        "glosses": [
                                            "Mutiler en arrachant les membres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec79ad2-103a-4b58-ac5e-7b8269c3cc75",
                                                "sense_id": "7509cfbe-c5db-3075-98dc-dc95ff7a0198",
                                                "text": "M. Khashoggi, qui vivait aux États-Unis, était un critique fréquent du régime saoudien. Il a été battu à mort et démembré, et des parties de son corps ont été dissoutes dans l'acide."
                                            },
                                            {
                                                "example_id": "32cdc537-ab6c-403e-b73c-8e6476c4a928",
                                                "sense_id": "7509cfbe-c5db-3075-98dc-dc95ff7a0198",
                                                "text": "Les bacchantes déchirèrent et démembrèrent Penthée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553b9351-12fb-30dd-97ab-d4a3de687128",
                                        "entry_id": "ae8f8f49-d2b1-3911-9730-6d39d9e0ecd6",
                                        "glosses": [
                                            "Diminuer un tout d’une ou plusieurs de ses parties."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dab8889a-de6b-49a8-8fb8-857ff5027338",
                                                "sense_id": "553b9351-12fb-30dd-97ab-d4a3de687128",
                                                "text": "Entre les escabeaux, les fauteuils démembrés, les tables pourries, il y avait une façon de sentier dans lequel s'engagea Léonora."
                                            },
                                            {
                                                "example_id": "713e3be1-77cc-43ba-b2ac-0d8854d6f409",
                                                "sense_id": "553b9351-12fb-30dd-97ab-d4a3de687128",
                                                "text": "En laissant Hitler démembrer la Tchécoslovaquie, annexer la Bohème, la Moravie et la Silésie, nous ne lui avons rien montré d’autre qu’une certaine faiblesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f734032-4b23-42aa-a692-66897e8c0f45",
                        "source_entry_id": "2f47db0f-02a1-3427-8bfb-5f1caffacf19",
                        "source_sense_description": "remove limbs",
                        "target_lang_word": "dépecer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépecer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48ac044e-794d-3825-9e1b-7df150d943eb",
                                        "entry_id": "a45ee657-b398-3287-a2bc-dc594bc74c9a",
                                        "glosses": [
                                            "Enlever la peau, mettre en pièces, couper en quartiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db69975-3a7d-4c6d-97c8-11cbdd9c65f3",
                                                "sense_id": "48ac044e-794d-3825-9e1b-7df150d943eb",
                                                "text": "Les cadavres de leurs ennemis furent étendus sur l’herbe et dépecés par un de leurs prêtres."
                                            },
                                            {
                                                "example_id": "c3940d31-ee33-4733-89da-c34cd8422fc5",
                                                "sense_id": "48ac044e-794d-3825-9e1b-7df150d943eb",
                                                "text": "D’un geste auguste, il jetait le chat aux pieds de la cuisinière, qui disait : « Oh ! la sale bête ! » et, aussitôt, se mettait à le dépecer, gardant la viande pour les mendiants, faisant sécher, au bout d’un bâton, la peau qu’elle vendait aux Auvergnats."
                                            },
                                            {
                                                "example_id": "68eced31-a7d0-4cac-920f-6a7672848f3c",
                                                "sense_id": "48ac044e-794d-3825-9e1b-7df150d943eb",
                                                "text": "Drôle d’époque ! Lorsqu’un collègue est tué par balle, on estime que c’est ce qui pouvait lui arriver de mieux - au vu des cadavres horriblement dépecés qui jalonnent la malheureuse terre d’Algérie."
                                            },
                                            {
                                                "example_id": "0fdf2184-cf60-421a-a145-5cebe175291e",
                                                "sense_id": "48ac044e-794d-3825-9e1b-7df150d943eb",
                                                "text": "Dépecer un vieux bateau."
                                            },
                                            {
                                                "example_id": "c335da35-ff2d-407b-80e3-663f697ada0a",
                                                "sense_id": "48ac044e-794d-3825-9e1b-7df150d943eb",
                                                "text": "Tout ce qu’elle put obtenir après beaucoup de paroles, ce fut une augmentation de deux francs cinquante sur le prix offert, et l’engagement que la roulotte ne serait dépecée qu’après leur départ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cb7f694-8796-4eba-996e-d69b0abe2153",
