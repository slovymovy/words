                "senses": [
                    {
                        "sense_id": "eff4d0cd-224a-32ed-9380-4daa2b0c9116",
                        "entry_id": "486db74c-ea6e-3cc1-a4d9-fc4a1dccf1a4",
                        "glosses": [
                            "unzureichende Menge an Nährstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f48a70d-b755-4294-9abd-496864c0b40a",
                                "sense_id": "eff4d0cd-224a-32ed-9380-4daa2b0c9116",
                                "text": "„Gerade bei kleinen Kindern verursacht der Nährstoffmangel dauerhafte Schäden.“"
                            },
                            {
                                "example_id": "cab93409-101f-442d-bbcf-a720d6b34dd7",
                                "sense_id": "eff4d0cd-224a-32ed-9380-4daa2b0c9116",
                                "text": "„Bereits jetzt leiden mehr als zwei Milliarden Menschen weltweit nach Angaben der Weltgesundheitsorganisation (WHO) an Nährstoffmangel.“"
                            },
                            {
                                "example_id": "38c421d1-2806-4c9e-9530-e4bbf69b9fff",
                                "sense_id": "eff4d0cd-224a-32ed-9380-4daa2b0c9116",
                                "text": "„Falten kommen zwar zwangsläufig mit dem Alter, Nährstoffmangel verursacht sie jedoch verfrüht und prägt sie deutlicher aus.“"
                            },
                            {
                                "example_id": "fc57098c-8e9e-4864-bff2-e7cbc231000e",
                                "sense_id": "eff4d0cd-224a-32ed-9380-4daa2b0c9116",
                                "text": "„Handelt es sich zum Beispiel um einen Nährstoffmangel, der dem Rasen zu schaffen macht, müssen Sie diesen ausgleichen. Dazu braucht es eine regelmäßige Düngung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
