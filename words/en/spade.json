{
    "word_family": [
        "spadework"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f8a370e-4c56-3b6b-a5cd-b8812531a414",
                    "sense_definition": "A garden tool with a handle and a flat blade for digging.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a heavy <w>spade</w> to dig a hole for the new rose bush.",
                            "target_lang_translations": {
                                "ru": "Он использовал тяжелую <w>лопату</w>, чтобы выкопать яму для нового куста роз."
                            }
                        },
                        {
                            "text": "You should use a garden <w>spade</w> to turn the soil before planting seeds.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать садовую <w>лопату</w>, чтобы перекопать почву перед посадкой семян."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garden spade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Садовый инструмент с рукояткой и плоским лезвием для копания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопата",
                                "target_lang_sense_clarification": "общий термин для инструмента"
                            },
                            {
                                "target_lang_word": "штыковая лопата",
                                "target_lang_sense_clarification": "плоская лопата для копания"
                            },
                            {
                                "target_lang_word": "заступ",
                                "target_lang_sense_clarification": "устаревшее или специальное название лопаты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f99f9fd1-ae31-3b98-8bc8-77dab90122d9",
                    "sense_definition": "A playing card marked with the black symbol ♠.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ace of <w>spades</w> is often considered the most important card in the deck.",
                            "target_lang_translations": {
                                "ru": "Туз <w>пик</w> часто считается самой важной картой в колоде."
                            }
                        },
                        {
                            "text": "I only have one <w>spade</w> left in my hand after that last round.",
                            "target_lang_translations": {
                                "ru": "После последнего раунда у меня на руках осталась только одна <w>пика</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ace of spades"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игральная карта, помеченная черным символом ♠."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пика",
                                "target_lang_sense_clarification": "одна карта этой масти"
                            },
                            {
                                "target_lang_word": "пики",
                                "target_lang_sense_clarification": "название масти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b1fae5b-2b90-3c17-8f90-c72a835041c6",
                    "sense_definition": "A device for terminating an electrical conductor resembling a small spade.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician attached a <w>spade</w> connector to the end of the speaker wire.",
                            "target_lang_translations": {
                                "ru": "Техник прикрепил <w>вилочный наконечник</w> к концу акустического кабеля."
                            }
                        },
                        {
                            "text": "Ensure the <w>spade</w> terminal is securely fastened to the battery post.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>вилочная клемма</w> надежно закреплена на клемме аккумулятора."
                            }
                        }
                    ],
                    "synonyms": [
                        "spade connector",
                        "spade terminal"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Устройство для оконцевания электрического проводника, напоминающее маленькую лопатку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вилочный наконечник",
                                "target_lang_sense_clarification": "электротехническая клемма"
                            },
                            {
                                "target_lang_word": "клемма-вилка",
                                "target_lang_sense_clarification": "тип электрического разъема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41a6dc07-6627-32a6-ae1e-411d33df093a",
                    "sense_definition": "A cutting instrument used in flensing a whale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whalers used a long-handled <w>spade</w> to strip the blubber from the carcass.",
                            "target_lang_translations": {
                                "ru": "Китобои использовали <w>лопату</w> на длинной ручке, чтобы снимать жир с туши."
                            }
                        },
                        {
                            "text": "Historical maritime museums often display the heavy <w>spade</w> used in the whaling industry.",
                            "target_lang_translations": {
                                "ru": "В исторических морских музеях часто выставляют тяжелые <w>лопаты</w>, использовавшиеся в китобойном промысле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Режущий инструмент, используемый при разделке кита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "китобойная лопата",
                                "target_lang_sense_clarification": "инструмент для снятия жира"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3073fd66-7f8d-34e0-bf67-53360b0f9f59",
                    "sense_definition": "A black person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel uses the term <w>spade</w> in a way that reflects the era's slang.",
                            "target_lang_translations": {
                                "ru": "В романе термин <w>черномазый</w> используется в манере, отражающей сленг той эпохи."
                            }
                        },
                        {
                            "text": "In modern contexts, using the word <w>spade</w> to refer to a person is highly offensive.",
                            "target_lang_translations": {
                                "ru": "В современном контексте использование слова <w>spade</w> по отношению к человеку является крайне оскорбительным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive and ethnic slur"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "found in mid-20th century literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное обозначение чернокожего человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черномазый",
                                "target_lang_sense_clarification": "крайне оскорбительное расистское ругательство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a0717aa-09c1-377d-b4f7-956651326110",
                    "sense_definition": "To turn over soil with a spade to loosen the ground for planting.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gardening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is time to <w>spade</w> the garden beds before the spring planting begins.",
                            "target_lang_translations": {
                                "ru": "Пришло время <w>перекопать</w> садовые грядки перед началом весенних посадок."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>spading</w> the earth to prepare for the vegetables.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>вскапывая</w> землю, чтобы подготовить ее для овощей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dig"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перекапывать почву лопатой, чтобы разрыхлить землю для посадки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копать",
                                "target_lang_sense_clarification": "обрабатывать землю лопатой"
                            },
                            {
                                "target_lang_word": "перекапывать",
                                "target_lang_sense_clarification": "рыхлить почву"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20f36354-0278-3066-8952-18dfee825e5b",
                    "sense_definition": "simple past and past participle of <w>spay</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian confirmed that the female cat had been <w>spaded</w> last year.",
                            "target_lang_translations": {
                                "ru": "Ветеринар подтвердил, что кошка была <w>стерилизована</w> в прошлом году."
                            }
                        },
                        {
                            "text": "She had her dog <w>spaded</w> to prevent any unwanted litters of puppies.",
                            "target_lang_translations": {
                                "ru": "Она <w>стерилизовала</w> свою собаку, чтобы предотвратить появление нежелательного потомства."
                            }
                        }
                    ],
                    "synonyms": [
                        "spayed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "variant spelling of spayed"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от слова spay (стерилизовать животное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стерилизованная",
                                "target_lang_sense_clarification": "о самке животного"
                            }
                        ]
                    }
                }
            ]
        },
        {
