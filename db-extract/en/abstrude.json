                                        "glosses": [
                                            "sich von etwas (oft einem Fixpunkt) wegstoßen, wegschieben oder wegdrücken; sich durch einen Stoß von etwas wegbewegen (eventuell auf einem beweglichen Transportmittel)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a20be18e-c76e-3c51-8226-f6282f1d7fb7",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "mittels mechanischer Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad54cfb-c982-4ad1-8711-e068fba091ee",
                                                "sense_id": "a20be18e-c76e-3c51-8226-f6282f1d7fb7",
                                                "text": "Er stieß das Boot mit Hilfe des Rudes vom Ufer ab."
                                            },
                                            {
                                                "example_id": "b7245cc7-9edd-4630-9c01-ddaa05d04b51",
                                                "sense_id": "a20be18e-c76e-3c51-8226-f6282f1d7fb7",
                                                "text": "Das Schiff stößt vom Ufer ab."
                                            },
                                            {
                                                "example_id": "02a7ada6-3f0b-4a80-87a3-fb47e93145cc",
                                                "sense_id": "a20be18e-c76e-3c51-8226-f6282f1d7fb7",
                                                "text": "Der Schwimmer stieß sich bei der Wende kräftig vom Beckenrand ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ca40aac0-3d5f-3c6d-88f5-2c800f1eab75",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "mittels magnetischen oder elektromagnetischen Feldern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f84c8c4-38ff-4a1d-90a8-dde442fa25ff",
                                                "sense_id": "ca40aac0-3d5f-3c6d-88f5-2c800f1eab75",
                                                "text": "Negative Ladungen stoßen sich gegenseitig ab."
                                            },
                                            {
                                                "example_id": "d14eccb8-848e-41a3-b638-b47d6fd4ef1d",
                                                "sense_id": "ca40aac0-3d5f-3c6d-88f5-2c800f1eab75",
                                                "text": "Die beiden magnetischen Pole stoßen sich ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "28f296f7-544b-31d7-9b11-b11db5d1a455",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "etwas durch einen Stoß beschädigen; Formverlust durch Stöße (besonders an den Kanten)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "86e464b5-e181-3f92-b6f6-09d928f597cd",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "etwas durch einen Stoß abschlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5947d8-d619-4d09-b7f4-6f9665ac9956",
                                                "sense_id": "86e464b5-e181-3f92-b6f6-09d928f597cd",
                                                "text": "Der Koffer hatte abgestoßene Ecken."
                                            },
                                            {
                                                "example_id": "e0a2dab4-9a03-49b6-af27-65fcd3279d6a",
                                                "sense_id": "86e464b5-e181-3f92-b6f6-09d928f597cd",
                                                "text": "Der Schreibtisch hatte schon abgestoßene Ecken."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "db6e547a-a6d5-33bc-8be1-186e2e45923a",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "etwas durch einen oder mehrere Stöße abnutzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bcb1eee-892c-4af8-a923-7211b16003f2",
                                                "sense_id": "db6e547a-a6d5-33bc-8be1-186e2e45923a",
                                                "text": "Bei einem Pelzmantel sind es meist nur die Ärmel und Vorderkanten, die sich abstoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "68ae687a-7bd8-3036-b720-d96a1b923e0f",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "etwas (oft mit Verlust oder eilig) verkaufen oder loswerden (wobei der Aspekt betont wird, dass man es danach nicht mehr hat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4837dfb3-4324-4ffd-9daf-de46dba029ff",
                                                "sense_id": "68ae687a-7bd8-3036-b720-d96a1b923e0f",
                                                "text": "Er wollte seine Aktien um jeden Preis abstoßen."
                                            },
                                            {
                                                "example_id": "fc00ce80-8a31-442e-83bb-bd571638a62f",
                                                "sense_id": "68ae687a-7bd8-3036-b720-d96a1b923e0f",
                                                "text": "Er musste diesen wichtigen Kunden abstoßen, da dieser wegen einer bevorstehenden Insolvenz zahlungsunfähig zu werden drohte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "747d3b17-b9dd-34ea-96c5-fc0a77ebe101",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "Widerwillen (durch Äußeres oder Benehmen) erregen; jemanden nicht gut finden; jemanden eklig finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e20d4862-76ce-42a1-9a4b-e03c637f8389",
                                                "sense_id": "747d3b17-b9dd-34ea-96c5-fc0a77ebe101",
                                                "text": "Sein ungepflegtes Äußeres wirkte sofort auf alle abstoßend."
                                            },
                                            {
                                                "example_id": "ef2e06e8-f940-40a5-9bc1-cadc823fc1bd",
                                                "sense_id": "747d3b17-b9dd-34ea-96c5-fc0a77ebe101",
                                                "text": "Sein Benehmen stößt mich ab."
                                            },
                                            {
                                                "example_id": "5a67bd5a-4620-43f7-b9dc-f95abc1d23cb",
                                                "sense_id": "747d3b17-b9dd-34ea-96c5-fc0a77ebe101",
                                                "text": "Er stößt alle durch seine Grobheit und sein Äußeres ab."
                                            },
                                            {
                                                "example_id": "ba19fe2f-1507-4f54-958d-070c68c65da7",
                                                "sense_id": "747d3b17-b9dd-34ea-96c5-fc0a77ebe101",
                                                "text": "Seine großen Ohren und seine Tätowierungen stießen mich ab."
                                            },
                                            {
                                                "example_id": "34ba6bc1-bb95-4a23-b6e8-b17f600929bc",
                                                "sense_id": "747d3b17-b9dd-34ea-96c5-fc0a77ebe101",
                                                "text": "Er hat so ein abstoßendes Lachen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8adec781-ec53-3d79-a366-cd0e496118e6",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "biologische Schutzreaktion des Körpers, der als Schutzreaktion Teile von sich absondert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61878213-e586-4889-b734-51e2a1fafe82",
                                                "sense_id": "8adec781-ec53-3d79-a366-cd0e496118e6",
                                                "text": "Das tote Gewebe der erfrorenen Nase wurde vom Körper abgestoßen."
                                            },
                                            {
                                                "example_id": "7995c3e0-0ee8-41dc-aa10-7b4c581a04b4",
                                                "sense_id": "8adec781-ec53-3d79-a366-cd0e496118e6",
                                                "text": "Das transplantierte Knochenmark wurde vom Körper abgestoßen."
                                            },
                                            {
                                                "example_id": "ff24f04e-0870-40f4-90f4-53d692c1a9ca",
                                                "sense_id": "8adec781-ec53-3d79-a366-cd0e496118e6",
                                                "text": "Das Implantat wurde vom Körper abgestoßen."
                                            },
                                            {
                                                "example_id": "911dcb6b-f6fc-4461-9282-d9a74e6b50aa",
                                                "sense_id": "8adec781-ec53-3d79-a366-cd0e496118e6",
                                                "text": "Die toten Hautschuppen werden abgestoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "73fa68da-3abc-35e2-9ea6-0a1c51770559",
                                        "entry_id": "b3f3ea6a-a702-3df4-9002-ddd337d6e649",
                                        "glosses": [
                                            "etwas nicht eindringen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9f88e4-8557-4d77-9d19-a4fb7e3352f2",
                                                "sense_id": "73fa68da-3abc-35e2-9ea6-0a1c51770559",
                                                "text": "Das Teil ist mit einer wasserabweisenden Schicht überzogen, die das Wasser abstößt."
                                            }
