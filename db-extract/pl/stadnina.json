                    }
                ],
                "translations": [
                    {
                        "translation_id": "99bfcfab-4eae-4d25-aa73-d8097ad05ec4",
                        "source_entry_id": "a8145fac-ccf2-323c-9133-a53e3d1d366b",
                        "source_sense_id": "e1562a5f-d2d4-33a3-95ed-2cc94ed4ade3",
                        "target_lang_word": "stud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e842cf4-7eab-3b40-bce1-c2323bcff700",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "A male animal, especially a stud horse (stallion), kept for breeding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d7059a8-044c-3cdc-b202-8bfea0422460",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "A female animal, especially a studmare (broodmare), kept for breeding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab6513aa-0867-39b6-a648-426578405141",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "A group of such animals, also of locomotives."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a8ff8f-bfb8-40f0-a8f7-ad2ea4525144",
                                                "sense_id": "ab6513aa-0867-39b6-a648-426578405141",
                                                "text": "He had the finest stud in England, and his delight was to win plates from Tories."
                                            },
                                            {
                                                "example_id": "6b7de92d-f6a7-4f24-ad6b-04179de6676b",
                                                "sense_id": "ab6513aa-0867-39b6-a648-426578405141",
                                                "text": "In freight working a considerable stud of ex-N.E.R. 3-cylinder 4-6-0s of Class \"B16\" is used, some of which include the Thompson modifications to the front end."
                                            },
                                            {
                                                "example_id": "67f01018-fd46-4f4e-b3ca-7014aaf5b6dc",
                                                "sense_id": "ab6513aa-0867-39b6-a648-426578405141",
                                                "text": "At that time, therefore, L.M.S. motive power for the increased loads of the Birmingham trains was less than adequate, whereas the G.W.R. route had an ample stud of Churchward and Collett 4-6-0s, and timekeeping was good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e043b90-2008-37d7-b4a3-886485ab35d3",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "An animal (usually livestock) that has been registered and is retained for breeding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89c35494-e5ed-3ce0-b335-f55d78531fd9",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "A place, such as a ranch, where such animals are kept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8eefc48-c95f-425f-a354-da82d4440251",
                                                "sense_id": "89c35494-e5ed-3ce0-b335-f55d78531fd9",
                                                "text": "In the studs of persons of quality in Ireland, where care is taken, […]we see horses bred of excellent shape, vigour, and size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5e999d-f40e-31a7-88d3-e2c1d0512fb4",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "A sexually attractive, promiscuous male."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fa0ced3-3a47-4f3a-8101-c9f400795c17",
                                                "sense_id": "cb5e999d-f40e-31a7-88d3-e2c1d0512fb4",
                                                "text": "Well, I'll tell you the truth now. I ain't a for-real cowboy, but I am one hell of a stud!"
                                            },
                                            {
                                                "example_id": "5e8a6ab7-e211-48ba-a2b8-ba50553a8917",
                                                "sense_id": "cb5e999d-f40e-31a7-88d3-e2c1d0512fb4",
                                                "text": "Maverick, you big stud… Take me to bed or lose me forever."
                                            },
                                            {
                                                "example_id": "f4ef3abe-6da6-4d75-a398-ad507943e2c2",
                                                "sense_id": "cb5e999d-f40e-31a7-88d3-e2c1d0512fb4",
                                                "text": "Wow, Julia! Sounds like to me like you got your pick of any man in this room to dance with so I want you to take your time and find amongst all these young studs here tonight the coolest, most un-losery guy in the bunch"
                                            },
                                            {
                                                "example_id": "0accfc8d-e374-4b58-a1c3-1c943166c99a",
                                                "sense_id": "cb5e999d-f40e-31a7-88d3-e2c1d0512fb4",
                                                "text": "Those soap-opera studs and studettes sliding between satin sheets in the afternoon?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "153fba0a-c498-305b-85fe-705bcadc9fd8",
                                        "entry_id": "ec96be2d-ae8b-365f-9670-4c9e5e87e168",
                                        "glosses": [
                                            "A sexually dominant lesbian, chiefly African-American."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e25c3a-cb43-42cc-814c-ae3de535ac1a",
                                                "sense_id": "153fba0a-c498-305b-85fe-705bcadc9fd8",
                                                "text": "Down and lonely stud, 23 years old, wants comfort from sweet-hearted fem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29fe6409-1dff-36a8-aca1-82a5a05c1b23",
                                        "entry_id": "203a9933-3d1f-3433-8877-ab450e29c22e",
                                        "glosses": [
                                            "A small object that protrudes from something; an ornamental knob."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "649d538f-f81f-40aa-ba49-168a4fb9b74d",
                                                "sense_id": "29fe6409-1dff-36a8-aca1-82a5a05c1b23",
                                                "text": "a collar with studs"
                                            },
                                            {
                                                "example_id": "f5e452f1-a282-432a-8720-a316d57fa079",
                                                "sense_id": "29fe6409-1dff-36a8-aca1-82a5a05c1b23",
                                                "text": "A belt of straw and ivy buds, / With coral clasps and amber studs."
                                            },
                                            {
                                                "example_id": "dd48a1ef-a5e8-4dcd-b509-ac90d2d4245f",
                                                "sense_id": "29fe6409-1dff-36a8-aca1-82a5a05c1b23",
                                                "text": "Crystal and myrrhine cups, embossed with gems / And studs of pearl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5c2e2f-2682-340b-8bc6-53f181c19a51",
                                        "entry_id": "203a9933-3d1f-3433-8877-ab450e29c22e",
                                        "glosses": [
                                            "A style of earring where the decorative element is mounted on a straight post."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd508c7f-877e-4361-b31d-bc679d13cd5f",
                                                "sense_id": "eb5c2e2f-2682-340b-8bc6-53f181c19a51",
                                                "text": "She's wearing studs in her ears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dc09622-04de-3b0d-87c8-30c11436fea2",
                                        "entry_id": "203a9933-3d1f-3433-8877-ab450e29c22e",
                                        "glosses": [
                                            "A vertical post, especially one of the small uprights in the framing for lath and plaster partitions, and furring, and upon which the laths are nailed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f90aef15-dfa3-3610-abbd-0d31085ec9da",
                                        "entry_id": "203a9933-3d1f-3433-8877-ab450e29c22e",
                                        "glosses": [
                                            "A cleat on a shoe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc57208d-d5e4-3a66-adeb-57e065a4fa6f",
                                        "entry_id": "203a9933-3d1f-3433-8877-ab450e29c22e",
                                        "glosses": [
                                            "A stem; a trunk."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "065bff48-b7b7-4efc-ac18-40c248d82c0d",
                                                "sense_id": "fc57208d-d5e4-3a66-adeb-57e065a4fa6f",
                                                "text": "Seest not this same hawthorn stud?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a8c738-dd3b-3905-9a68-4f3d3f91e379",
                                        "entry_id": "203a9933-3d1f-3433-8877-ab450e29c22e",
                                        "glosses": [
                                            "A type of poker in which the player cannot discard, and some of the cards are exposed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24516b7f-de4b-4237-95fb-9e1f315e026d",
                                                "sense_id": "f5a8c738-dd3b-3905-9a68-4f3d3f91e379",
                                                "text": "At an old saloon on a street of mud / There at a table, dealing stud / Sat the dirty, mangy dog that named me \"Sue\""
                                            }
                                        ]
                                    },
