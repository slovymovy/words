{
    "word_family": [
        "fluctuate",
        "fluctuation",
        "fluctuating"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9eddc9c2-013a-3632-b3f6-a274c02a4686",
                    "sense_definition": "Characterized by constant change or instability.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fluctuant</w> nature of the stock market makes long-term planning difficult for many investors.",
                            "target_lang_translations": {
                                "zh": "股市<w>波动</w>的特性使得许多投资者难以进行长期规划。"
                            }
                        },
                        {
                            "text": "Economic policies often struggle to stabilize the <w>fluctuant</w> prices of essential goods.",
                            "target_lang_translations": {
                                "zh": "经济政策往往难以稳定生活必需品<w>波动</w>的价格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "variable",
                        "unsteady"
                    ],
                    "antonyms": [
                        "stable",
                        "constant"
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物处于不断变化或不稳定的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "波动的",
                                "target_lang_sense_clarification": "形容数值或状态上下起伏、不稳定。"
                            },
                            {
                                "target_lang_word": "不稳定的",
                                "target_lang_sense_clarification": "形容缺乏稳定性，容易发生变化。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb6cc8a1-dc2b-3381-99d0-2b0d0d4643b7",
                    "sense_definition": "Describing a fluid-filled mass that moves like a wave when pressed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted that the abscess was <w>fluctuant</w> during the physical examination.",
                            "target_lang_translations": {
                                "zh": "医生在体检时注意到该脓肿<w>有波动感</w>。"
                            }
                        },
                        {
                            "text": "A <w>fluctuant</w> swelling often indicates the presence of an underlying collection of pus.",
                            "target_lang_translations": {
                                "zh": "<w>有波动感</w>的肿胀通常预示着皮下有积脓。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指医学上触诊时有波动感的肿块，通常含有液体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有波动感的",
                                "target_lang_sense_clarification": "医学术语，指按压肿块时能感觉到内部液体的流动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}