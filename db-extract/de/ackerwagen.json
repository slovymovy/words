                        "entry_id": "6be8ecc9-7579-3220-8b95-d5c67f9f6626",
                        "glosses": [
                            "Wagen, der meist von Pferden gezogen als Anhänger für die Feldarbeit dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90221b6-4945-48e0-9fb6-db0e053e8271",
                                "sense_id": "e3fd0ca5-5cec-3e8c-aac7-31a32c383bd3",
                                "text": "„Auf einem Ackerwagen sprach Pastor Mönnich ein Dankgebet, daß der Pilot sein Leben geopfert habe, um die 2500 Seelen des Dorfes vor einer Katastrophe zu bewahren.“"
                            },
                            {
                                "example_id": "e1967da8-7845-4e14-a366-7d34251808b5",
                                "sense_id": "e3fd0ca5-5cec-3e8c-aac7-31a32c383bd3",
                                "text": "„Russische Bauern könnten die Leichen mit ihren Ackerwagen abfahren.“"
                            }
                        ],
