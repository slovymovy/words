                "senses": [
                    {
                        "sense_id": "7e7cccb4-ba74-3950-bdec-6585ab73e825",
                        "entry_id": "7f984050-0f0c-359a-8670-e18fc6ce3a23",
                        "glosses": [
                            "Technik, die dazu dient, eine Lagerstätte wirtschaftlich optimal und zielgerichtet auszubeuten beziehungsweise abzubauen"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "a5faffec-ac7f-4f57-b566-1dbe0b4356f3",
                                "sense_id": "7e7cccb4-ba74-3950-bdec-6585ab73e825",
                                "text": "„Die Abbaukosten bei der Anwendung verschiedener Abbauverfahren sind im allgemeinen beim Tiefbau höher als beim Tagebau […] Für die Gewinnung des Erzes im Tiefbau werden verschiedene Abbauverfahren angewendet, durch welche ein mehr oder […]“"
                            },
                            {
                                "example_id": "8ad74df3-1b1c-4aca-a733-4b5682c8e450",
                                "sense_id": "7e7cccb4-ba74-3950-bdec-6585ab73e825",
                                "text": "„Je nach Ausbildung der Lagerstätte sind verschiedene Abbauverfahren üblich . Hinsichtlich der Behandlung des Hangenden (Nebengestein )unterscheidet man Abbauverfahren mit Stützung des Hangenden durch Gebirgsfesten, Abbauverfahren mit […]“"
                            },
                            {
                                "example_id": "f442b80f-e449-4ee6-9442-bf88be16bb08",
                                "sense_id": "7e7cccb4-ba74-3950-bdec-6585ab73e825",
                                "text": "„Bei vom Bergbau aufgefahrenen Hohlräumen ist deren Standfestigkeit und Stehzeit, geologisch bedingt, abhängig vom gewählten Abbauverfahren, von der gewählten Art des Abstützens und von der ungesicherten Stützweite.“"
                            },
                            {
                                "example_id": "3f7c1625-f3bd-4074-b38b-f364b32b5565",
                                "sense_id": "7e7cccb4-ba74-3950-bdec-6585ab73e825",
                                "text": "„Dementsprechend müssen sich die Sprengverfahren den Abbauverfahren anpassen, aber auch umgekehrt beeinflussen die Sprengverfahren die Abbauverfahren. Für die Sprengverfahren gilt grundsätzlich die Anlage von möglichst langen und zu […]“"
                            },
                            {
                                "example_id": "93ec94cc-52c1-4bc8-85d8-b40125ef7e4d",
                                "sense_id": "7e7cccb4-ba74-3950-bdec-6585ab73e825",
                                "text": "„Bei der Wahl des günstigsten Abbauverfahrens sind die konkreten Bedingungen ausschlaggebend. Eine allgemeine Rangfolge der Abbauverfahren für alle Flußspatlagerstätten kann nicht ermittelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f181f67-f4d9-3a0b-84b1-d019a536a842",
                        "entry_id": "7f984050-0f0c-359a-8670-e18fc6ce3a23",
                        "glosses": [
                            "chemisches oder biologisches Verfahren zur Zerlegung/Zersetzung von Materialien oder Substanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d60df58-fb6f-437d-8777-b0fe8e5f9786",
                                "sense_id": "7f181f67-f4d9-3a0b-84b1-d019a536a842",
                                "text": "„Die thermisch-pyrolytischen Abbauverfahren werden hauptsächlich zur Analyse von Polymerisaten eingesetzt, die sich hydrolytisch nicht oder nicht vollständig abbauen lassen.“"
                            },
                            {
                                "example_id": "1e20c204-281c-4dbd-8bde-c1c93be97ed0",
                                "sense_id": "7f181f67-f4d9-3a0b-84b1-d019a536a842",
                                "text": "„Abbauverfahren: Wir unterscheiden zwischen biologischen (Mithilfe von Organismen) und chemisch/thermischen Abbauverfahren. Abbauverfahren können auf der Produktseite zu petrochemischen Zwischenprodukten, zu Rohstoffen oder zu Energie […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
