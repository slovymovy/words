                        "examples": [
                            {
                                "example_id": "cd10ebf9-139f-4bac-a16e-32aa94f29e15",
                                "sense_id": "30888702-e5ef-3847-8e4a-d8076e651195",
                                "text": "Aujourd’hui, le flambeau est fièrement repris par de talentueuses réalisatrices d’un porno joyeux et féministe : Madison Young, Erika Lust, Lucie Blush… Mais au fond, un porno féministe, c’est quoi ?"
                            },
                            {
                                "example_id": "4a4b9398-8eac-4a7a-9938-4f96d0ef8bf9",
                                "sense_id": "30888702-e5ef-3847-8e4a-d8076e651195",
                                "text": "Maintenant que tu en as vu un, selon toi quelle est la différence entre un film porno fait par une femme et un porno habituel ?\nDans un porno habituel je bande, dans ton porno féministe mon sexe attend la permission."
                            },
                            {
                                "example_id": "1398f589-35f0-4d3a-ac2c-2201cb06083c",
                                "sense_id": "30888702-e5ef-3847-8e4a-d8076e651195",
                                "text": "L’ordi du poto diffuse un film de boule dans lequel un type positionné en doggy se fait fister par un barbu boosté aux stéroïdes. Erik change de vidéo, balance un porno hétéro."
                            }
                        ]
                    },
                    {
                        "sense_id": "d655ec18-1dce-3071-8894-49178c86df34",
                        "entry_id": "5f49b5cb-e8bd-388a-9e28-32743eb8876e",
                        "glosses": [
                            "Domaine des films pornographiques."
