                    ]
                },
                {
                    "sense_id": "0dbd2a83-818b-3fac-88d0-a21fc84dbaba",
                    "sense_definition": "Aus dem Gleichgewicht geraten und zur Seite oder nach hinten stürzen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der morsche Zaun wackelte im starken Wind und <w>kippte</w> schließlich zur Seite."
                        },
                        {
                            "text": "Als er von seinem großen Lottogewinn erfuhr, wäre er fast vom Stuhl <w>gekippt</w>."
