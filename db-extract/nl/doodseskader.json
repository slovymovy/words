        "nl-extract.jsonl": [
            {
                "entry_id": "94a4320a-7d68-3b35-a42c-2dc6a28f1f32",
                "word": "doodseskader",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a7577ecf-9bea-43d2-ae85-1c362ba14675",
                        "entry_id": "94a4320a-7d68-3b35-a42c-2dc6a28f1f32",
                        "tags": [
                            "plural"
                        ],
                        "form": "doodseskaders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e055323d-1b51-3d42-8e86-bbd4df119f5b",
                        "entry_id": "94a4320a-7d68-3b35-a42c-2dc6a28f1f32",
                        "glosses": [
                            "bende die gevormd is om een of meerdere personen te doden\\nVeel doodseskaders zijn militaire of paramilitaire groeperingen en worden door een bepaalde organisatie of regering om politieke redenen gevormd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418d97db-cb04-497d-b08e-59df013b83d6",
                                "sense_id": "e055323d-1b51-3d42-8e86-bbd4df119f5b",
                                "text": "Amnesty International maakte melding van moorden op en grof geweld tegen straatkinderen door politieagenten en doodseskaders in o.m. Brazilië, Guatemala, Kenia en Roemenië"
                            },
                            {
                                "example_id": "a7a7ae16-f03a-44f9-9a1a-ab9cd297a000",
                                "sense_id": "e055323d-1b51-3d42-8e86-bbd4df119f5b",
                                "text": "Het aantal slachtoffers van het Braziliaanse doodseskader is sinds zondag tot negen gestegen. Nog twee lijken, welke doorzeefd waren met kogels van groot kaliber, werden gisteren gevonden in een landbouwstreek bij de stad Guararema, 70 km ten oosten van Sao Paolo"
                            }
                        ]
                    },
                    {
                        "sense_id": "01a15f0c-4700-31ac-9407-256e1c5e1def",
                        "entry_id": "94a4320a-7d68-3b35-a42c-2dc6a28f1f32",
                        "glosses": [
                            "in vijandelijk gebied gedropt commando dat sabotage- en verkenningsacties moest uitvoeren en dat daarom een zekere dood tegemoet ging"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "368c1e64-d3f5-43a5-bb96-ac0275ed3b4d",
                                "sense_id": "01a15f0c-4700-31ac-9407-256e1c5e1def",
                                "text": "Het juiste aantal der vrouwelijke piloten is niet te verkrijgen, maar het wordt op meer dan 500 geschat. Sommige maken deel uit van de parachutisten-afdeeling „het doodsch-eskader.” Dit eskader dient om achter de vijandelijke linies te worden neergelaten, teneinde bruggen op te blazen en verkenningen te doen. In alle takken van de luchtmacht zijn vrouwen werkzaam en zijn niet te vergelijken met Kerenski’s „bataljon des doods”, dat in 1917 het tsaristische winterpaleis verdedigde tegen de bolsjewieken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "218d35f0-7398-41e7-8d94-ab4a2354f865",
                        "source_entry_id": "94a4320a-7d68-3b35-a42c-2dc6a28f1f32",
                        "source_sense_id": "e055323d-1b51-3d42-8e86-bbd4df119f5b",
                        "source_sense_description": "bende die gevormd is om een of meerdere personen te doden",
                        "target_lang_word": "Todesschwadron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Todesschwadron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9824501d-ff85-3b01-bfdd-a1888e7ab398",
                                        "entry_id": "ed2cf6a8-378f-33ee-9f6a-bb19beaf246e",
                                        "glosses": [
                                            "paramilitärische Gruppe, die damit beauftragt ist, Gegner zu eliminieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b037f019-2e70-4460-95b4-001bd40ade1c",
                                                "sense_id": "9824501d-ff85-3b01-bfdd-a1888e7ab398",
                                                "text": "„Hier, glaubten viele, würde die Polizei ihn nie zu fassen kriegen, konnten sie ihn nicht fassen, auch nicht mit ihren Todesschwadronen und ihren ganzen Gringo-Dollars und ihren Spionageflugzeugen und wer weiß was noch.“"
                                            },
                                            {
                                                "example_id": "4bf6b34f-8aaf-4002-926a-920b4fd1d682",
                                                "sense_id": "9824501d-ff85-3b01-bfdd-a1888e7ab398",
                                                "text": "„Im Fernsehen beschwichtigte Talbott Reynolds Ängste, er wiederholte, dass die Todesschwadronen ihre Arbeit beendet hätten.“"
                                            },
                                            {
                                                "example_id": "a3dc658a-83a2-48c1-a72f-a338e1519704",
                                                "sense_id": "9824501d-ff85-3b01-bfdd-a1888e7ab398",
                                                "text": "„Ich habe mir sagen lassen, viele von denen stammen aus Nicaragua. Sandinisten. Todesschwadronen und so.“"
                                            },
                                            {
                                                "example_id": "182d5d8a-25a0-49ec-9bfa-e8f8bb0a471a",
                                                "sense_id": "9824501d-ff85-3b01-bfdd-a1888e7ab398",
                                                "text": "„Wir hatten immer vermutet, dass er für die Todesschwadronen arbeitete.“"
                                            },
                                            {
                                                "example_id": "f2c1d4d6-573b-49b9-b139-e1072ba83451",
                                                "sense_id": "9824501d-ff85-3b01-bfdd-a1888e7ab398",
                                                "text": "„Ein paar Jahre lang galten sie als beste Todesschwadron, die die CIA je hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
