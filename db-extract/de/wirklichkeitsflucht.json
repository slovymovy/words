                "senses": [
                    {
                        "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                        "entry_id": "8da66f27-fb14-3766-9dd8-7527159fb9fe",
                        "glosses": [
                            "Flucht, Rückzug aus der Wirklichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8480ff89-6c8f-4d84-b72b-408dc4082c16",
                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                "text": "„Es wäre einseitig anzunehmen, Unterhaltung befriedige lediglich Wünsche nach Zerstreuung und Entspannung, nach Wirklichkeitsflucht und Ablenkung.“"
                            },
                            {
                                "example_id": "50a83835-394c-445e-9ed6-739d9727b661",
                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                "text": "„Kein Wunder, dass sich Zyniker über Heuchler in der Kirche beklagen und Glaube als Wirklichkeitsflucht diskreditieren.“"
                            },
                            {
                                "example_id": "87d19079-1fba-4a88-a38c-b97c50c0f4b0",
                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                "text": "„Thomas hielt Seriengucken außerdem für Wirklichkeitsflucht.“"
                            },
                            {
                                "example_id": "6c8e9bf2-334f-4013-bfb9-7a126317885f",
                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                "text": "„Der ‚ästhetische Staat‘ ist nicht ein Staat der Wirklichkeitsflucht, sondern der Wirklichkeitssuche.“"
                            },
                            {
                                "example_id": "c283cd14-c3fc-4a6d-98a9-5a48bb5ed87c",
                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                "text": "„In der Gegenwart zeigt sich auch bei den Magyaren Widerstreit zwischen Naturtreue und Wirklichkeitsflucht, Sozialismus und Individualismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
