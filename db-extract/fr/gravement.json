                    {
                        "translation_id": "bb450c1b-5ec1-49ce-99f3-0171d35cf6c2",
                        "source_entry_id": "ef30683f-38af-345e-8f80-938d33ade2d4",
                        "target_lang_word": "serieus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
