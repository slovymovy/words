    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "033a02d6-97a7-30e4-b3ae-ec4c940ed64a",
                "word": "sunken",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7035e8d7-d033-345f-b6cc-a5ec878b6bee",
                        "entry_id": "033a02d6-97a7-30e4-b3ae-ec4c940ed64a",
                        "glosses": [
                            "caused, by natural or unnatural means, to be depressed (lower than the surrounding area) or submerged"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "06aac1cd-83bd-4b35-94ea-8d4fa53af084",
                                "sense_id": "7035e8d7-d033-345f-b6cc-a5ec878b6bee",
                                "text": "The sunken ship lay at a depth of 100 feet"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1ab1dae-824a-3f01-9878-197be8aaab84",
                        "entry_id": "033a02d6-97a7-30e4-b3ae-ec4c940ed64a",
                        "glosses": [
                            "Seeming to have fallen deeper back into the face due to tiredness, illness, or old age."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "65690004-0bd8-4365-bf76-2924422b6573",
                                "sense_id": "e1ab1dae-824a-3f01-9878-197be8aaab84",
                                "text": "She looked old and thin with sunken cheeks and hollow eyes."
                            },
                            {
                                "example_id": "1dae38ef-ff12-461c-97a7-ab4300e80f17",
                                "sense_id": "e1ab1dae-824a-3f01-9878-197be8aaab84",
                                "text": "The heartbreak will take some getting over; the sunken forms of the players at the full-time whistle said as much."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "485118e8-7215-4b01-95b3-d3c2e425fafc",
