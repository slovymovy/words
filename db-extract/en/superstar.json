                    },
                    {
                        "translation_id": "65598638-5ad0-4953-9f65-2c15b80c873f",
                        "source_entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                        "source_sense_description": "very famous person",
                        "target_lang_word": "superster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                        "entry_id": "54ace890-4ccc-3cac-b2db-23677b34a950",
                                        "glosses": [
                                            "iemand die buitengewoon beroemd en populair is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500560a9-d181-4f47-8ca6-cd1910736bc4",
                                                "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                                "text": "Voetballers en artiesten voelen zich soms eerder een superster dan ze in werkelijk zijn."
                                            },
                                            {
                                                "example_id": "3cd4f435-bb0f-499b-ad37-898c6f0b393c",
                                                "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                                "text": "Als er supersterren bestaan, dan is Johan Cruijff er zeker één van."
                                            },
                                            {
                                                "example_id": "ddfb86ec-6ad3-4384-8b9b-f44e85f5d3c2",
                                                "sense_id": "2149db8a-14a4-31f5-9c16-90a3eea26914",
                                                "text": "In het begin van het jaar werd een zangeres in de tienerleeftijd die Carola heette van de ene dag op de andere een superster toen ze het Nationale Songfestival won. Het was een doorbraak die exceptioneel veel aandacht trok. Vanzelfsprekend werd ze daarmee ook een van de vaste gespreksonderwerpen van het land. Dat was ook zo onder de strafpleiters, deze jonge Carola was werkelijk onweerstaanbaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed785bfe-4d91-4aef-bcbe-75717662d4b6",
                        "source_entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                        "source_sense_description": "very famous person",
                        "target_lang_word": "superstar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superstar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3e5981aa-13ee-354e-bcdd-4756379ce42c",
                                        "entry_id": "6fb71231-0eae-326d-87cb-37f1afc47cca",
                                        "glosses": [
                                            "iemand die heel erg beroemd is omdat hij of zij iets heel goed kan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e58aa7-ff93-4da6-9c17-c6c76614706d",
                                                "sense_id": "3e5981aa-13ee-354e-bcdd-4756379ce42c",
                                                "text": "De rockopera ”Jesus Christ Superstar” is deze maand te zien in Den Haag. Zo’n optreden staat haaks op het beeld dat de Bijbel van Jezus tekent. Impliceert een afwijzing tevens een algeheel verbod om de Heere Jezus af te beelden? Hoeveel ruimte zit er tussen toneel en penseel?"
                                            },
                                            {
                                                "example_id": "22636f72-b336-4754-aaae-97983da8de0b",
                                                "sense_id": "3e5981aa-13ee-354e-bcdd-4756379ce42c",
                                                "text": "Eind vorig jaar leek de samenwerking tussen de presentatrice en de zender nog voorbij. Toen werd Sylvie vervangen als het vaste gezicht van de Duitse versie van Let's Dance. In het verleden was Sylvie ook te zien als jurylid in Deutschland Sucht Den Superstar. Das Supertalent begint op 6 augustus."
                                            },
                                            {
                                                "example_id": "bd3c076c-af63-494e-8c31-0414bc4d9281",
                                                "sense_id": "3e5981aa-13ee-354e-bcdd-4756379ce42c",
                                                "text": "Geen 'superstar' of 'ninja' in de vacature en veel meer vrouwen solliciteren: Vacatures voor IT-functies barsten vaak van de ‘mannelijke’ woorden, zoals rockstar, ninja of superheld. Softwarebedrijf Atlassian gebruikt sinds twee jaar neutrale woorden in vacatures en ziedaar: ze namen 50 procent meer vrouwen aan dan daarvoor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "399a11af-5109-424f-8f9f-c73c93a93278",
                        "source_entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                        "source_sense_description": "very famous person",
                        "target_lang_word": "superstar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
