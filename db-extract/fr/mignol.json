                        "tags": [],
                        "examples": [
                            {
                                "example_id": "894cfebb-3f05-4a28-b963-e9098a09e5f4",
                                "sense_id": "736646ff-95f7-30ff-8301-cfc1bc973c77",
                                "text": "En la Province de Budomel il croist un arbre, lequel rend tous les jours un certain just, ou suc appellé Mignol."
                            },
                            {
                                "example_id": "0a5e2811-2fd7-497c-842a-c9ae4abf05e8",
                                "sense_id": "736646ff-95f7-30ff-8301-cfc1bc973c77",
                                "text": "Cette liqueur, qu'ils [les indigènes du Sénégal] appellent mignol, en sort toute l'année. Il n'est question que de faire deux ou trois ouvertures au tronc, et d'y suspendre des calebasses pour recevoir une eau brune qui coule fort lentement."
                            }
                        ]
                    }
