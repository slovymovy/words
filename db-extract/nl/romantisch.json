                        "form": "romantischers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b41eb17c-a3ff-3e71-b234-3380db4cddf7",
                        "entry_id": "2392b6c2-acfb-3311-8247-107e988154b2",
                        "glosses": [
                            "mooi en lieflijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d20ac8-73db-401b-b2b1-8e692838f5ad",
                                "sense_id": "b41eb17c-a3ff-3e71-b234-3380db4cddf7",
                                "text": "Zijn romantische kijk op de zaken hangt me goed de keel uit."
                            },
                            {
                                "example_id": "f1505e0c-f534-4832-92ca-93dec9a17c2c",
                                "sense_id": "b41eb17c-a3ff-3e71-b234-3380db4cddf7",
                                "text": "Het drong langzaam tot me door wat het woord ‘wildernis’ eigenlijk betekende: niet romantisch en mooi, maar zwaar, droog, verlaten en pijnlijk."
                            },
                            {
                                "example_id": "36eca67d-dce5-4f23-b3ed-939ac2f90c2b",
                                "sense_id": "b41eb17c-a3ff-3e71-b234-3380db4cddf7",
                                "text": "Voor Lauritz was het licht minder romantisch. In de midzomertijd werd als het weer het toeliet het hooi binnengehaald op Osteroy."
                            }
                        ]
                    },
                    {
                        "sense_id": "f17d1547-eb60-3c8d-9b22-1c8908e3f9e6",
                        "entry_id": "2392b6c2-acfb-3311-8247-107e988154b2",
                        "glosses": [
                            "met betrekking tot de hofmakerij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df4de8c-683c-4446-bf59-fa84b019ba46",
                                "sense_id": "f17d1547-eb60-3c8d-9b22-1c8908e3f9e6",
                                "text": "Ze hadden een heel romantisch avondje op de boulevard bij maanlicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73c0bee4-39a0-4c38-a1b8-1d041a6ea42b",
                        "source_entry_id": "2392b6c2-acfb-3311-8247-107e988154b2",
                        "target_lang_word": "romantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc38d145-3ebd-36e2-ae7a-7ac9830dc193",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Of a work of literature, a writer etc.: being like or having the characteristics of a romance, or poetic tale of a mythic or quasi-historical time; fantastic."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a990b00-f14c-399c-b618-cf4776894f24",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Fictitious, imaginary."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12fb997e-a3e4-3a2f-b3e0-738d99b2250c",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Fantastic, unrealistic (of an idea etc.); fanciful, sentimental, impractical (of a person)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b09b57df-a090-441f-9aed-f3c064e32571",
                                                "sense_id": "12fb997e-a3e4-3a2f-b3e0-738d99b2250c",
                                                "text": "Mary sighed, knowing her ideals were far too romantic to work in reality."
                                            },
                                            {
                                                "example_id": "2df96186-f689-4630-8d9f-c754695ca102",
                                                "sense_id": "12fb997e-a3e4-3a2f-b3e0-738d99b2250c",
                                                "text": "R. Jeeves: In my experience, ladies who spell Gladys with a W are seldom noted for their reliability, sir. It gives them romantic notions.\nB.W. Wooster: With a W, Jeeves? No, no, no, no. You spell it with a G.\nR. Jeeves: If I might draw your attention to the signature on the portrait, sir.\nB.W. Wooster: Good Lord! G-W?\nR. Jeeves: I blame Alfred Lord Tennyson and his Idylls of the King. It also accounts for Kathryn, Ysabel, and Ethyl, all spelt with a Y, but Gwladys is a particularly virulent form, sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23952586-96de-3c21-bdfe-9ff58c528c95",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Having the qualities of romance (in the sense of something appealing deeply to the imagination); invoking on a powerfully sentimental idea of life; evocative, atmospheric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eddbeba-f3d6-46bb-b4af-594ac835d070",
                                                "sense_id": "23952586-96de-3c21-bdfe-9ff58c528c95",
                                                "text": "But here is an artist. He desires to paint you the dreamiest, shadiest, quietest, most enchanting bit of romantic landscape in all the valley of the Saco."
                                            },
                                            {
                                                "example_id": "14d64b1b-f9b4-41ed-b7a7-b14e41ca4971",
                                                "sense_id": "23952586-96de-3c21-bdfe-9ff58c528c95",
                                                "text": "Somehow she wasn't a real sister, but that only made her the more romantic."
                                            },
                                            {
                                                "example_id": "a209fd0f-f505-439d-8b6e-d1e7be156e1c",
                                                "sense_id": "23952586-96de-3c21-bdfe-9ff58c528c95",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae92a5ac-d045-3ea8-adb4-8ccc33ec4801",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Pertaining to an idealised form of love (originally, as might be felt by the heroes of a romance); conducive to romance; loving, affectionate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68a27d7-f5bb-4a2a-b0f7-72aa27271ed4",
                                                "sense_id": "ae92a5ac-d045-3ea8-adb4-8ccc33ec4801",
                                                "text": "Their kiss started casually, but it slowly turned romantic."
                                            },
                                            {
                                                "example_id": "812b9a2f-6f69-4c40-a85c-6a1fe48bdd79",
                                                "sense_id": "ae92a5ac-d045-3ea8-adb4-8ccc33ec4801",
                                                "text": "Contrary to the popular perception that love typically sparks from passion, a new study finds two-thirds of romantic relationships begin as long-term friendships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4620247c-1919-3419-a1e8-d9f3ad248bee",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Alternative letter-case form of Romantic"
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6db04981-b1d1-3082-928a-952126db8a94",
                                        "entry_id": "075eb3b3-fd14-3a89-b755-183faa6b09c3",
                                        "glosses": [
                                            "Experiencing romantic attraction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89fcb86c-2cdc-411d-9997-e17fd4046b16",
                                                "sense_id": "6db04981-b1d1-3082-928a-952126db8a94",
                                                "text": "Elsewhere, I describe that, in addition to an asexual identity, another salient identity for asexual individuals may be a romantic or aromantic identity, which designates an interest (or lack thereof) in monogamous, intimate relationships (Scherrer, 2008)."
                                            },
                                            {
                                                "example_id": "072852d2-1389-4fb2-a118-a35b340504e3",
                                                "sense_id": "6db04981-b1d1-3082-928a-952126db8a94",
                                                "text": "What is relatively “new” is the formation of communities around the common language of asexuality as it is understood today—communities in which new categories exist around the concept of asexuality or “being ace,” where people can discuss romantic or aromantic orientations in relation to or apart from sexual desires or non-desires."
                                            },
                                            {
                                                "example_id": "9f141063-0322-472c-9425-d3af58253249",
                                                "sense_id": "6db04981-b1d1-3082-928a-952126db8a94",
                                                "text": "Grayromantic asexual people are between romantic and aromantic and less likely to experience romantic attraction compared to most people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "romantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d9143ff-0027-3b81-8130-1d826f506aec",
                                        "entry_id": "765d9ee3-54ee-3589-9da8-b380df7e2560",
                                        "glosses": [
                                            "A person with romantic character (a character like those of the knights in a mythic romance)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf9d3767-3951-3234-bcb3-fc0285b91e0e",
                                        "entry_id": "765d9ee3-54ee-3589-9da8-b380df7e2560",
                                        "glosses": [
                                            "A person who is behaving romantically (in a manner befitting someone who feels an idealized form of love)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4605e61b-1830-4919-8d1a-71415f56ccbf",
                                                "sense_id": "cf9d3767-3951-3234-bcb3-fc0285b91e0e",
                                                "text": "Kaldor is an interesting lyricist, and it is easy to identify with her imagery. She's also an unabashed romantic of the most extreme kind, with lines like \"For we can talk without speaking/we can see without light/I'll never leave you....\""
                                            },
                                            {
                                                "example_id": "0fda7ad1-d423-44df-bfa3-ee33d220f889",
                                                "sense_id": "cf9d3767-3951-3234-bcb3-fc0285b91e0e",
                                                "text": "Oh, flowers! You're such a romantic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
