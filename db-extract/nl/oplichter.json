                        "target_lang_word": "Hochstapler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochstapler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57bfaccd-35d3-38ab-8b36-634cc3e0e8ba",
                                        "entry_id": "e62f80cb-7e8a-317b-bf29-b701dc2b988a",
                                        "glosses": [
                                            "eine Person, die bewusst (mit oder ohne betrügerische Absicht) vorgibt, eine Person höheren Ansehens (meist akademischer Grad) zu sein, um persönliche Vorteile daraus zu ziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a3f2c8-3b94-42ed-a48b-79160269e0e7",
                                                "sense_id": "57bfaccd-35d3-38ab-8b36-634cc3e0e8ba",
                                                "text": "Der Heiratsschwindler war ein begabter Hochstapler, dem die Frauen glaubten, er sei Freiherr und Richter und dass er ein größeres Erbe zu erwarten hatte."
                                            },
                                            {
                                                "example_id": "54265fe1-2e50-4cb1-a1a6-79f1228da109",
                                                "sense_id": "57bfaccd-35d3-38ab-8b36-634cc3e0e8ba",
                                                "text": "Auch in der Tierwelt gibt es Hochstapler."
                                            },
                                            {
                                                "example_id": "31026b64-31f2-45f2-9e2c-f5bbac45c677",
                                                "sense_id": "57bfaccd-35d3-38ab-8b36-634cc3e0e8ba",
                                                "text": "„Das Stuttgarter Landgericht urteilt über einen Hochstapler, der es mit Hauptschulabschluss bis an den Operationstisch schaffte.“"
                                            },
                                            {
                                                "example_id": "56c11ee7-c224-48dc-b9f6-672e0c296bb6",
                                                "sense_id": "57bfaccd-35d3-38ab-8b36-634cc3e0e8ba",
                                                "text": "„Er war allein mit mir mürrisch gewesen, als sei ich hier nur ein Hochstapler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9af8f86d-10b0-3c1c-a0ef-10ce71980a71",
                                        "entry_id": "e62f80cb-7e8a-317b-bf29-b701dc2b988a",
                                        "glosses": [
                                            "Angeber"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf3e90f-16cb-4add-8d45-f8ca2cb47bb1",
                                                "sense_id": "9af8f86d-10b0-3c1c-a0ef-10ce71980a71",
                                                "text": "Was für ein Hochstapler!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
