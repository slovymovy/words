                                        "sense_id": "62c4220a-a4c9-3716-b96a-60969c0fed7b",
                                        "entry_id": "a2e2f1bd-0c6b-3d12-a5dd-b1770b13211e",
                                        "glosses": [
                                            "kühl machen; Temperatur (von etwas, das warm oder heiß ist) vermindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fed9ce3-0efc-42dd-95d3-5d29b7cd1454",
                                                "sense_id": "62c4220a-a4c9-3716-b96a-60969c0fed7b",
                                                "text": "Wir sollten die Getränke kühlen, damit wir nicht warme Limonade trinken müssen."
                                            },
                                            {
                                                "example_id": "82462c0b-44a2-4be2-8132-6e4e9ee19990",
                                                "sense_id": "62c4220a-a4c9-3716-b96a-60969c0fed7b",
                                                "text": "„Organe [werden] auf dem Weg vom Spender zum Empfänger auf etwa vier Grad gekühlt.“"
                                            },
                                            {
                                                "example_id": "46e1ee8c-78b9-4f45-abbb-327066a549f9",
                                                "sense_id": "62c4220a-a4c9-3716-b96a-60969c0fed7b",
                                                "text": "„Mehrzweckschiffe und ein Seenotrettungskreuzer kühlten den Tanker mit großen Mengen Wasser und bekämpften den Brand von außen.“"
                                            }
