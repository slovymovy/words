{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d8e7d86-c9f8-30b7-b0ce-a2bd8787dbfc",
                    "sense_definition": "A small, squalid, or wretchedly poor house or hut.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family lived in a wretched <w>hovel</w> on the outskirts of the town.",
                            "target_lang_translations": {
                                "de": "Die Familie lebte in einer elenden <w>Bruchbude</w> am Stadtrand."
                            }
                        },
                        {
                            "text": "They were forced to live in a miserable <w>hovel</w> without running water or heating.",
                            "target_lang_translations": {
                                "de": "Sie waren gezwungen, in einer elenden <w>Hütte</w> ohne fließendes Wasser oder Heizung zu leben."
                            }
                        }
                    ],
                    "synonyms": [
                        "shack",
                        "shanty"
                    ],
                    "common_phrases": [
                        "miserable hovel",
                        "wretched hovel"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, elendes oder ärmliches Haus bzw. eine Hütte."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hütte",
                                "target_lang_sense_clarification": "einfaches, ärmliches Gebäude"
                            },
                            {
                                "target_lang_word": "Bruchbude",
                                "target_lang_sense_clarification": "Gebäude in sehr schlechtem Zustand"
                            },
                            {
                                "target_lang_word": "Baracke",
                                "target_lang_sense_clarification": "primitives, elendes Gebäude"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52f9a910-e541-31e0-802a-1761dca3aebb",
                    "sense_definition": "An open shed used for sheltering cattle or protecting crops from the weather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers built a simple <w>hovel</w> to keep the cattle safe from the rain.",
                            "target_lang_translations": {
                                "de": "Die Bauern bauten einen einfachen <w>Unterstand</w>, um das Vieh vor dem Regen zu schützen."
                            }
                        },
                        {
                            "text": "They stored the leftover hay inside an old wooden <w>hovel</w>.",
                            "target_lang_translations": {
                                "de": "Sie lagerten das restliche Heu in einem alten <w>Holzschuppen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein offener Schuppen zum Unterstellen von Vieh oder zum Schutz von Ernten vor dem Wetter."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Unterstand",
                                "target_lang_sense_clarification": "Schutzdach für Vieh oder Geräte"
                            },
                            {
                                "target_lang_word": "Schuppen",
                                "target_lang_sense_clarification": "einfacher Unterstand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cd51824-9a0b-3ca1-8ada-b005046d73c2",
                    "sense_definition": "A large, conical brick structure surrounding porcelain-firing kilns.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Workers monitored the temperature inside the brick <w>hovel</w> during the firing process.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter überwachten die Temperatur in der gemauerten <w>Brennofenhaube</w> während des Brennvorgangs."
                            }
                        },
                        {
                            "text": "The old pottery factory retained its traditional conical <w>hovel</w>.",
                            "target_lang_translations": {
                                "de": "Die alte Töpferei behielt ihre traditionelle kegelförmige <w>Brennofenhaube</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Brennofenhaube; eine große, kegelförmige Ziegeleinfassung für Porzellanbrennöfen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Brennofenhaube",
                                "target_lang_sense_clarification": "Haube über Porzellanbrennöfen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0193a5-afb9-3fc0-af5a-d1f7c58be6ea",
                    "sense_definition": "A straitjacket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was restrained in a heavy <w>hovel</w> to prevent self-harm.",
                            "target_lang_translations": {
                                "de": "Der Patient wurde in einer schweren <w>Zwangsjacke</w> ruhiggestellt, um Selbstverletzung zu verhindern."
                            }
                        },
                        {
                            "text": "Guards secured the prisoner with a canvas <w>hovel</w>.",
                            "target_lang_translations": {
                                "de": "Die Wachen sicherten den Gefangenen mit einer <w>Zwangsjacke</w> aus Segeltuch."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage for straitjacket"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Zwangsjacke (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Zwangsjacke",
                                "target_lang_sense_clarification": "historische/veraltete Bezeichnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96e7304d-a9bf-30c4-b58c-6b7bd5ad7555",
                    "sense_definition": "To put or shelter in a hovel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the violent storm, they were forced to <w>hovel</w> the livestock in a temporary shed.",
                            "target_lang_translations": {
                                "de": "Während des heftigen Unwetters waren sie gezwungen, das Vieh in einem provisorischen Schuppen <w>unterzubringen</w>."
                            }
                        },
                        {
                            "text": "The villagers <w>hoveled</w> together against the harsh winter cold.",
                            "target_lang_translations": {
                                "de": "Die Dorfbewohner <w>kauerten</w> zusammen gegen die strenge Winterkälte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or literary verbal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In einem elenden Schuppen oder Unterstand unterbringen oder Zuflucht suchen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unterbringen",
                                "target_lang_sense_clarification": "in einem Notquartier/Schuppen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e4a4a7-5f1f-3c5e-8807-6a444290d559",
                    "sense_definition": "To construct a chimney top in a way that prevents smoking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason decided to <w>hovel</w> the chimney to stop downdrafts.",
                            "target_lang_translations": {
                                "de": "Der Maurer beschloss, den Schornstein <w>mit einer Kaminhaube zu versehen</w>, um Fallwinde zu verhindern."
                            }
                        },
                        {
                            "text": "They had to <w>hovel</w> the stone structure to keep smoke from blowing back into the house.",
                            "target_lang_translations": {
                                "de": "Sie mussten die Steinkonstruktion <w>mit einem Rauchfang versehen</w>, um zu verhindern, dass Rauch zurück ins Haus geblasen wird."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Schornsteinaufsatz bauen, der das Rauchen des Kamins verhindert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mit einer Kaminhaube versehen",
                                "target_lang_sense_clarification": "Schornstein rauchsicher gestalten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}