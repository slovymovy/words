                    {
                        "sense_id": "92367a49-18af-3218-aecb-3a52929bc8a8",
                        "entry_id": "2a5a0835-ee0b-3c20-8b91-6ffc3e516b74",
                        "glosses": [
                            "An organized group of people or entities who collaborate towards a particular goal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903648e7-a4b7-4b50-8151-bb1d12182bb7",
                                "sense_id": "92367a49-18af-3218-aecb-3a52929bc8a8",
                                "text": "1895, (no by-line), \"In The Halls of Learning: Columbian University\", The Evening Times (Washington, DC) (19 October 1895, page 2) -- this appears to be a unique usage; very difficult to find non-adjectival uses prior to the 1970s\nIn the literature class, which is conducted by Prof. George J. Smith, lately of Central High School, and which is a collaborative of Dr. Farquhar's course, the students are pursuing their new course."
                            },
                            {
                                "example_id": "9674091a-24f5-4441-8d34-b28617f2ec46",
                                "sense_id": "92367a49-18af-3218-aecb-3a52929bc8a8",
                                "text": "Concern over possible conflict between their collaborative and one set up a year ago ...."
                            },
                            {
                                "example_id": "726927bc-534c-4aec-b9d2-a89f4352308a",
                                "sense_id": "92367a49-18af-3218-aecb-3a52929bc8a8",
                                "text": "These collaboratives would consist of a team of managers, researchers, and consultants from a variety of organizations whose aim would be to better understand problems in effective health care management […]"
                            },
                            {
                                "example_id": "40c26c90-33f1-415d-884e-1d1df5b1409e",
                                "sense_id": "92367a49-18af-3218-aecb-3a52929bc8a8",
                                "text": "This collaborative aims at discussing ways in which patients can participate in the FDA's regulatory discussions about medical products."
                            }
                        ]
                    }
