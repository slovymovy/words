                                "target_senses": [
                                    {
                                        "sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                                        "entry_id": "6031d366-6a41-3a41-b376-57eb9366e7c3",
                                        "glosses": [
                                            "Personne pratiquant le snowboard, sport de glisse pratiqué sur la neige."
                                        ],
                                        "tags": [
                                            "Snowboard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8926f31e-7f98-44ef-a433-ed7eb7d2c5f8",
                                                "sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                                                "text": "Ils sont fidèles, elle et son amoureux, le snowboardeur australien Scotty James, médaillé deux fois aux Olympiques."
                                            },
                                            {
                                                "example_id": "39a095fa-40e8-42e1-9d16-e73601c94aaf",
                                                "sense_id": "0478c293-8892-3ea1-9c5b-6468b8a5d93b",
                                                "text": "Une œuvre aussi spectaculaire que décalée, avec le skieur suisse Sam Anthamatten et le snowboardeur savoyard Victor de Le Rue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
