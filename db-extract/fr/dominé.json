                    {
                        "sense_id": "c3e4d40d-7a1a-3028-8981-9a8d1675e230",
                        "entry_id": "4f49d0a4-67d1-39b3-9dc7-773c61d13474",
                        "glosses": [
                            "Qui subit un pouvoir, une autorité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8665cb51-81f8-47e0-a43c-9c4773e59354",
                                "sense_id": "c3e4d40d-7a1a-3028-8981-9a8d1675e230",
                                "text": "[Le mot amour] n’est prononcé d’ailleurs que par des dominants culpabilisés par leur bien-être et qui devinent la haine des dominés, ou par des dominés qui se sont brisé les os contre la froide indifférence des dominances."
                            }
                        ]
                    },
                    {
                        "sense_id": "11a17ca3-abb7-352b-9230-c3e6665dd48b",
                        "entry_id": "4f49d0a4-67d1-39b3-9dc7-773c61d13474",
                        "glosses": [
                            "Arbre dominé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04405914-10cd-413a-b57b-13d08e63016a",
                                "sense_id": "11a17ca3-abb7-352b-9230-c3e6665dd48b",
                                "text": "Les estimations affichées peuvent être définies sur des sous-ensembles de l’inventaire total en cochant les lignes-essence correspondantes : seulement l’essence principale, exclusion des dominés…"
                            }
                        ]
                    }
