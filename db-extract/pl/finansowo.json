                                    {
                                        "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                        "entry_id": "1f30828a-dc5e-33e6-9cdc-d612be612a09",
                                        "glosses": [
                                            "die Finanzen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60f7b21-3c52-4669-b02b-a26aa97f7609",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "Mein Hunger hat ganz eindeutig eine finanzielle Ursache."
                                            },
                                            {
                                                "example_id": "3397d238-bdea-48ba-9394-88fb5218a864",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "Die Begriffe Stipendien (\"scholarships\") und finanzielle Förderung (\"financial aid\") werden oft im selben Sinne verwendet, aber eigentlich ist ein Stipendium eine auf Leistungen basierende finanzielle Auszeichnung, einschliesslich ausgezeichneter akademischer Leistungen, besonderer Talente […]."
                                            },
                                            {
                                                "example_id": "f1203d2e-c85e-4efc-aa82-e5ff9e8ad2a8",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Dem Freiherrn selber jedoch war die Popularität als Lügenbaron eher peinlich, zudem erwies sich sein zweifelhafter Ruf bei einem späteren Scheidungsprozess, der ihn finanziell ruinierte, als wenig vorteilhaft.“"
                                            },
                                            {
                                                "example_id": "e82ce59c-6d43-46d8-8b32-ce534d663f48",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Am 17. April 1374 traf sich der Braunschweiger Stadtrat in der Brüdernkirche mit den Gildemeistern, um unter anderem über die finanziellen Probleme der Stadt zu beraten.“"
                                            },
                                            {
                                                "example_id": "4b730a08-fb53-4093-aa8d-48982f439a44",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Für eine Weile bringt ihn die Welt wieder mit Spitzensport in Verbindung und nicht mit finanziellen Sorgen.“"
                                            },
                                            {
                                                "example_id": "6078a0d5-fec2-4c18-8c01-bbf28b2b0fc9",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Ein Teil von uns ist finanziell nicht auf-, sondern abgestiegen.“"
                                            },
                                            {
                                                "example_id": "9ec521c8-8b07-4eb3-89cf-4f842bfd66d4",
                                                "sense_id": "32524a5c-414d-351b-a4a5-6138ad0e987f",
                                                "text": "„Nur die, denen es finanziell gut geht, gehen in ein Restaurant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
