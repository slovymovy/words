                                            {
                                                "example_id": "5e08bd64-604d-4de0-b8c9-38ea6aded01d",
                                                "sense_id": "9371f055-5e58-33fb-8e39-e7d199d97c9c",
                                                "text": "Ein bekanntes Beispiel für Binokulare auch Binokel genannt ist das Fernglas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Binokel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3929c21-93fb-32f2-98c8-f431fe3e17e6",
                                        "entry_id": "80a14c32-b42d-32eb-a99e-c6f572223db6",
                                        "glosses": [
                                            "ist ein regionales Kartenspiel aus dem württembergischen Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e099127a-6545-47f9-aa9a-550e1c16675d",
                                                "sense_id": "f3929c21-93fb-32f2-98c8-f431fe3e17e6",
                                                "text": "Wir treffen uns jeden zweiten Sonntag zum Binokel spielen."
                                            },
                                            {
                                                "example_id": "9d6e6eec-3178-45cb-99aa-250583660cf1",
                                                "sense_id": "f3929c21-93fb-32f2-98c8-f431fe3e17e6",
                                                "text": "„Die Frauen hatten ihre Mahjong-Runden, die Männer spielten in der Küche Binokel und alberten herum, und im Sommer veranstalteten die Familien gemeinsame Picknicks in der South Mountains Reservation; dort spielte man Softball, warf Hufeisen und hörte sich in einem »knisternden, rauschenden Kofferradio, das jemand mitgebracht hatte«, ein Baseballspiel an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10daf965-7005-4588-9901-5d5cbd661ce7",
                        "source_entry_id": "7abcb3e0-3770-3b89-a14e-432647c511b9",
                        "source_sense_id": "b16c5a84-a23c-3008-82a8-b5b7fe338430",
