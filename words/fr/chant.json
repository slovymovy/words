                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "litterature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous a demandé de commenter le premier <w>chant</w> de l'épopée grecque."
