                "senses": [
                    {
                        "sense_id": "b42656af-f275-3278-861f-135a6f6d4f11",
                        "entry_id": "b56eb01b-2666-3b38-b747-bafad424ca38",
                        "glosses": [
                            "Faire subir une co-immunoprécipitation à quelque chose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6c85a4d-1c64-457e-91a8-df44e896c2bb",
                                "sense_id": "b42656af-f275-3278-861f-135a6f6d4f11",
                                "text": "Elle utilise un anticorps pour immunoprécipiter l’antigène (protéine “appât”) et pour co-immunoprécipiter les protéines interagissantes (protéines “proie”)."
                            },
                            {
                                "example_id": "adbfa55d-3cc6-4c29-91d6-b40196a37396",
                                "sense_id": "b42656af-f275-3278-861f-135a6f6d4f11",
                                "text": "Elles forment la plupart du temps des complexes multiprotéiques. En gardant les complexes intactes avant de faire l’immunoprécipitation, il est possible de co-immunoprécipiter les autres protéines du complexe."
                            }
                        ]
                    }
                ],
