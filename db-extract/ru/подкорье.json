                                        "entry_id": "a75a5997-1213-3ae1-9713-6e4361c9ce73",
                                        "glosses": [
                                            "To compress or restrict (oneself) into a small space; to squeeze."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3647d8e-b8c6-46d2-9c5d-7e0709f25706",
                                                "sense_id": "b14a2b85-56e3-340c-85a0-d55ff6337de9",
                                                "text": "Somehow, she squashed all her books into her backpack, which was now too heavy to carry."
                                            },
                                            {
                                                "example_id": "79a4f64f-13df-4391-82f5-6d618a270c7a",
                                                "sense_id": "b14a2b85-56e3-340c-85a0-d55ff6337de9",
                                                "text": "We all managed to squash into Mum's tiny car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae99d7a-e29e-3f9c-aaf2-a8f319415f46",
                                        "entry_id": "a75a5997-1213-3ae1-9713-6e4361c9ce73",
                                        "glosses": [
                                            "To suppress; to force into submission."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d057964-c5aa-4e7a-862c-bebcbcb3d4cc",
                                                "sense_id": "fae99d7a-e29e-3f9c-aaf2-a8f319415f46",
                                                "text": "A somewhat popular myth about the Whiskey Rebellion is that Washington personally led the troops into western Pennsylvania and squashed the rebellion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squash",
