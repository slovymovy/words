                        "entry_id": "bf152852-4dab-3f86-a2a0-bf5079b43d45",
                        "glosses": [
                            "Tourmaline généralement brune dont la formule est NaMg₃Al₆(BO₃)₃Si₆O₁₈(OH)₄."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d4b2383-b50e-4cf7-804c-784e3df72386",
                                "sense_id": "bafb5168-ec71-30bf-8175-e94aeda6aa8d",
                                "text": "On trouve de la dravite en Tanzanie."
                            },
                            {
                                "example_id": "f89a173c-c6a2-4b57-8e1e-b8895e117cfe",
                                "sense_id": "bafb5168-ec71-30bf-8175-e94aeda6aa8d",
                                "text": "On réserve le nom de dravite aux variétés brunes, mais des cristaux jaunes ou même incolores sont aussi connus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0df714c-95e0-4669-951a-f63fcc5e16e3",
                        "source_entry_id": "bf152852-4dab-3f86-a2a0-bf5079b43d45",
                        "source_sense_id": "bafb5168-ec71-30bf-8175-e94aeda6aa8d",
                        "target_lang_word": "Dravit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dravit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba966dc-bd20-34ce-ab88-54fbf26178af",
                                        "entry_id": "92439018-68de-355a-bf7f-ecaa01917d4d",
                                        "glosses": [
                                            "Mineral, welches reich an Magnesium und eine Abart des Turmalins ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5db95f-700b-4d33-aa50-1ff527fc6f86",
                                                "sense_id": "6ba966dc-bd20-34ce-ab88-54fbf26178af",
                                                "text": "„Die Turmalinreihe besteht aus Elbait, Dravit, Schörl, Buergerit, Tsilaisit, Uvit und Liddicoatit. […] Dravit umfaßt braune bis grünliche und braunschwarze Mg-reiche Turmaline.“"
                                            },
                                            {
                                                "example_id": "9a4ab751-ea4f-4e8f-a5ea-09ff50bfe050",
                                                "sense_id": "6ba966dc-bd20-34ce-ab88-54fbf26178af",
                                                "text": "„Turmalin hat viele Varietäten von verschiedener Farbe: Achroit (farblos oder zartgrün), Buergerit (fast schwarz), Dravit (braun bis grünlich und braunschwarz, sehr Mg-reich), Indigolith (blau), Liddicoatit (dunkelbraun), Mohrenkopf (ein Achroit mit schwarzen Enden), Rubellit (rot), Schörl (schwarz), Tsilaisit (dunkelgelb), Uvit (braun), Verdelith (grün), ferner noch vanadium- bzw. chromhaltige Turmaline.“"
                                            },
                                            {
                                                "example_id": "2b750a7c-3970-4f0e-a764-56d458e7f8eb",
                                                "sense_id": "6ba966dc-bd20-34ce-ab88-54fbf26178af",
                                                "text": "„Turmaline bilden säulige oder nadelige, farbenfrohe Mineralien, wie z.B. Achroit (farblos bis blaßgrün), Dravit (braun bis grün), Rubellit (rosa bis rot), Schörl (farblos bis tiefgrün, rot, blau), Verdelith (grün) und Chrom-Turmalin (smaragdgrün).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
