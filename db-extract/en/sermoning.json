                        "examples": [
                            {
                                "example_id": "30bc6944-efca-4fd9-b91d-0927ba0f446f",
                                "sense_id": "4695706e-95fd-3bdd-b62e-9b12d21984af",
                                "text": "now have things been so reformed with a witness, or rather a vengeance, that Sermoning carries all afore it, bears all down to little or nothing."
                            },
                            {
                                "example_id": "9a9ad776-31fb-4eaf-962b-3dd3e37c53af",
                                "sense_id": "4695706e-95fd-3bdd-b62e-9b12d21984af",
                                "text": "What need these assiduous pryaers, these frequent sermonings, these importune communicatings?"
                            },
                            {
                                "example_id": "3ce37c2c-0f50-4c28-a8a5-fe61665b3e28",
                                "sense_id": "4695706e-95fd-3bdd-b62e-9b12d21984af",
                                "text": "You needn't tell me, 'cause I know all about it without any sermoning."
                            },
                            {
                                "example_id": "7a4ef92f-00d9-4c73-b022-79343e92ecc0",
                                "sense_id": "4695706e-95fd-3bdd-b62e-9b12d21984af",
                                "text": "Or so said the bishops, whose self-righteous interolerance of any beliefs, save their own, made me doubt the sincerity in all their philanthropic sermonings to others."
                            }
                        ]
                    }
                ],
