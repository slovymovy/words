{
    "word_family": [
        "sloe-berry",
        "sloe-gin",
        "sloe-thorn"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0b2735b-9129-36e3-a21e-afb99ce1cf7f",
                    "sense_definition": "The small, sour, dark-purple wild fruit of the blackthorn bush.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sloe</w> is often used to make a sweet liqueur.",
                            "target_lang_translations": {
                                "pl": "<w>Tarnina</w> jest często używana do wyrobu słodkiego likieru."
                            }
                        },
                        {
                            "text": "We gathered a basket of wild <w>sloes</w> along the hedgerow.",
                            "target_lang_translations": {
                                "pl": "Zebraliśmy koszyk dzikiej <w>tarniny</w> wzdłuż żywopłotu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sloe gin"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mały, cierpki, ciemnofioletowy dziki owoc krzewu tarniny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tarnina",
                                "target_lang_sense_clarification": "owoc tarniny (często używane w liczbie pojedynczej zbiorczo)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fed13116-de58-3f7e-b1bc-cdd155998e39",
                    "sense_definition": "A thorny shrub or small tree, Prunus spinosa, that produces small dark fruit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sloe</w> is commonly found growing in wild hedgerows.",
                            "target_lang_translations": {
                                "pl": "<w>Tarnina</w> często rośnie w dzikich żywopłotach."
                            }
                        },
                        {
                            "text": "Birds often nest in the dense branches of the <w>sloe</w>.",
                            "target_lang_translations": {
                                "pl": "Ptaki często wiją gniazda w gęstych gałęziach <w>tarniny</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blackthorn"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ciernisty krzew lub małe drzewo (Prunus spinosa), które wytwarza małe, ciemne owoce."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tarnina",
                                "target_lang_sense_clarification": "krzew tarniny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e81d862-31d7-3ebd-86af-ab0214b432a0",
                    "sense_definition": "Any of various other shrubs or small trees in the genus Prunus that bear dark-purple fruit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This specific variety of <w>sloe</w> is native to the Appalachian region.",
                            "target_lang_translations": {
                                "pl": "Ta konkretna odmiana <w>śliwy</w> pochodzi z regionu Appalachów."
                            }
                        },
                        {
                            "text": "The small <w>sloe</w> tree produces fruit similar to a plum.",
                            "target_lang_translations": {
                                "pl": "Małe drzewo <w>tarniny</w> rodzi owoce podobne do śliwek."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Inne krzewy lub małe drzewa z rodzaju Prunus, które rodzą ciemnofioletowe owoce."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "śliwa",
                                "target_lang_sense_clarification": "ogólne określenie drzewa z rodzaju Prunus"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}