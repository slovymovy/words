                    {
                        "translation_id": "c3f058c8-210a-46d8-8eb0-4edbf8f24b9a",
                        "source_entry_id": "12662678-d1e7-30fe-876f-048bfc9f4fe4",
                        "source_sense_id": "eae635cc-fb5c-3412-b3e0-4146b74cda03",
