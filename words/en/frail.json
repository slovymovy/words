                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть на струнном инструменте (обычно на банджо), ударяя по струнам ногтем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бренчать",
