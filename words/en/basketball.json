                {
                    "sense_id": "3ef33f39-8ab4-3a64-96c2-fe863cda7eed",
                    "sense_definition": "A sport in which two opposing teams of five players strive to put a ball through a hoop.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We play <w>basketball</w> every Saturday at the local park.",
