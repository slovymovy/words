                        "source_sense_id": "be583e9e-2097-32a1-8fd1-5e9a0879b274",
                        "source_sense_description": "Region im Westen von Rumänien: Siebenbürgen, Transsilvanien",
                        "target_lang_word": "Transylvanie",
