{
    "word_family": [
        "volatility",
        "volatilize",
        "volatilization"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd6b74ec-ccb0-3671-af1e-a219bb7274f7",
                    "sense_definition": "Liable to change rapidly and unpredictably, especially for the worse.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market has been highly <w>volatile</w> this week, causing concern among investors.",
                            "target_lang_translations": {
                                "ru": "Фондовый рынок был крайне <w>нестабильным</w> на этой неделе, что вызвало беспокойство среди инвесторов.",
                                "pl": "Giełda była w tym tygodniu wysoce <w>niestabilna</w>, co wywołało niepokój wśród inwestorów."
                            }
                        },
                        {
                            "text": "Because fuel prices are so <w>volatile</w>, it is difficult to predict the cost of the trip.",
                            "target_lang_translations": {
                                "ru": "Поскольку цены на топливо так <w>изменчивы</w>, трудно предсказать стоимость поездки.",
                                "pl": "Ponieważ ceny paliw są tak <w>zmienne</w>, trudno przewidzieć koszt podróży."
                            }
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "erratic",
                        "unpredictable",
                        "variable"
                    ],
                    "antonyms": [
                        "stable",
                        "steady",
                        "constant",
                        "predictable"
                    ],
                    "common_phrases": [
                        "volatile market",
                        "highly volatile",
                        "volatile prices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к быстрым и непредсказуемым изменениям, особенно в худшую сторону",
                        "pl": "Podatny na szybkie i nieprzewidywalne zmiany, zwłaszcza na gorsze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "об обстановке, рынках или ценах"
                            },
                            {
                                "target_lang_word": "изменчивый",
                                "target_lang_sense_clarification": "часто меняющийся"
                            },
                            {
                                "target_lang_word": "волатильный",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niestabilny",
                                "target_lang_sense_clarification": "o sytuacji, rynkach lub cenach"
                            },
                            {
                                "target_lang_word": "zmienny",
                                "target_lang_sense_clarification": "często ulegający zmianom"
                            },
                            {
                                "target_lang_word": "chwiejny",
                                "target_lang_sense_clarification": "niepewny, podatny na wahania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a3917fc-5a80-3209-89e8-dffcc3ce5809",
                    "sense_definition": "Likely to become dangerous, violent, or explosive suddenly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protests created a <w>volatile</w> situation that could have turned violent at any moment.",
                            "target_lang_translations": {
                                "ru": "Протесты создали <w>взрывоопасную</w> ситуацию, которая в любой момент могла перерасти в насилие.",
                                "pl": "Protesty stworzyły <w>napiętą</w> sytuację, która w każdej chwili mogła przerodzić się w przemoc."
                            }
                        },
                        {
                            "text": "Diplomats are trying to ease tensions in the <w>volatile</w> region.",
                            "target_lang_translations": {
                                "ru": "Дипломаты пытаются снизить напряженность в этом <w>нестабильном</w> регионе.",
                                "pl": "Dyplomaci próbują złagodzić napięcia w tym <w>niestabilnym</w> regionie."
                            }
                        }
                    ],
                    "synonyms": [
                        "explosive",
                        "tense",
                        "charged",
                        "unstable"
                    ],
                    "antonyms": [
                        "peaceful",
                        "stable",
                        "calm"
                    ],
                    "common_phrases": [
                        "volatile situation",
                        "volatile region",
                        "volatile atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный внезапно становиться опасным, агрессивным или выходить из-под контроля",
                        "pl": "Mogący nagle stać się niebezpiecznym, agresywnym lub wymknąć się spod kontroli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывоопасный",
                                "target_lang_sense_clarification": "о ситуации или обстановке"
                            },
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "угрожающий безопасности"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "napięty",
                                "target_lang_sense_clarification": "o sytuacji grożącej konfliktem"
                            },
                            {
                                "target_lang_word": "wybuchowy",
                                "target_lang_sense_clarification": "o sytuacji, która może gwałtownie eskalować"
                            },
                            {
                                "target_lang_word": "niestabilny",
                                "target_lang_sense_clarification": "zagrażający bezpieczeństwu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7c81854-a55e-3992-9871-eb14c75f9560",
                    "sense_definition": "Liable to display rapid changes of emotion; quick to become angry.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "instability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>volatile</w> temper, so it is best not to argue with him.",
                            "target_lang_translations": {
                                "ru": "У него <w>вспыльчивый</w> характер, поэтому с ним лучше не спорить.",
                                "pl": "Ma <w>wybuchowy</w> charakter, więc najlepiej z nim nie dyskutować."
                            }
                        },
                        {
                            "text": "The manager was known for his <w>volatile</w> personality, often shouting one minute and laughing the next.",
                            "target_lang_translations": {
                                "ru": "Менеджер был известен своим <w>неуравновешенным</w> характером: одну минуту он кричал, а следующую — смеялся.",
                                "pl": "Kierownik był znany ze swojej <w>niezrównoważonej</w> osobowości; często w jednej chwili krzyczał, a w następnej się śmiał."
                            }
                        }
                    ],
                    "synonyms": [
                        "temperamental",
                        "explosive",
                        "moody",
                        "fickle"
                    ],
                    "antonyms": [
                        "calm",
                        "stable",
                        "even-tempered",
                        "composed"
                    ],
                    "common_phrases": [
                        "volatile temper",
                        "volatile nature",
                        "volatile personality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к резким переменам настроения; легко выходящий из себя",
                        "pl": "Skłonny do gwałtownych zmian nastroju; łatwo wpadający w gniew."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспыльчивый",
                                "target_lang_sense_clarification": "быстро приходящий в гнев"
                            },
                            {
                                "target_lang_word": "неуравновешенный",
                                "target_lang_sense_clarification": "о характере или личности"
                            },
                            {
                                "target_lang_word": "непостоянный",
                                "target_lang_sense_clarification": "часто меняющий настроение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "współczynnik wybuchowy",
                                "target_lang_sense_clarification": "o charakterze"
                            },
                            {
                                "target_lang_word": "niezrównoważony",
                                "target_lang_sense_clarification": "o osobowości"
                            },
                            {
                                "target_lang_word": "zmienny",
                                "target_lang_sense_clarification": "o nastrojach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "488fcc23-afea-3bbb-8649-ba69f2b3bbe7",
                    "sense_definition": "Evaporating or vaporizing readily under normal conditions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Acetone is a <w>volatile</w> liquid that dries very quickly when exposed to air.",
                            "target_lang_translations": {
                                "ru": "Ацетон — это <w>летучая</w> жидкость, которая очень быстро высыхает на воздухе.",
                                "pl": "Aceton to <w>lotna</w> ciecz, która bardzo szybko wysycha pod wpływem powietrza."
                            }
                        },
                        {
                            "text": "The laboratory handles many <w>volatile</w> substances that require proper ventilation.",
                            "target_lang_translations": {
                                "ru": "Лаборатория работает со многими <w>летучими</w> веществами, требующими надлежащей вентиляции.",
                                "pl": "Laboratorium pracuje z wieloma <w>lotnymi</w> substancjami, które wymagają odpowiedniej wentylacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "evaporative"
                    ],
                    "antonyms": [
                        "non-volatile"
                    ],
                    "common_phrases": [
                        "volatile organic compounds",
                        "volatile liquid",
                        "volatile oil",
                        "volatile substance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко испаряющийся при нормальных условиях",
                        "pl": "Łatwo parujący w normalnych warunkach."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "летучий",
                                "target_lang_sense_clarification": "о жидкости или веществе"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "lotny",
                                "target_lang_sense_clarification": "o substancji chemicznej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55c246e9-f565-3cb3-9762-065fda59b815",
                    "sense_definition": "Relating to computer memory that loses its data when the power is turned off.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Random access memory is a type of <w>volatile</w> storage used by computers.",
                            "target_lang_translations": {
                                "ru": "Оперативная память — это тип <w>энергозависимого</w> хранилища, используемого компьютерами.",
                                "pl": "Pamięć RAM to rodzaj <w>ulotnej</w> pamięci używanej przez komputery."
                            }
                        },
                        {
                            "text": "Data stored in <w>volatile</w> memory will be lost if the system crashes unexpectedly.",
                            "target_lang_translations": {
                                "ru": "Данные, хранящиеся в <w>энергозависимой</w> памяти, будут потеряны при неожиданном сбое системы.",
                                "pl": "Dane przechowywane w <w>ulotnej</w> pamięci zostaną utracone w przypadku nieoczekiwanej awarii systemu."
                            }
                        }
                    ],
                    "antonyms": [
                        "non-volatile"
                    ],
                    "common_phrases": [
                        "volatile memory",
                        "volatile storage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к компьютерной памяти, которая теряет данные при отключении питания",
                        "pl": "Dotyczący pamięci komputerowej, która traci dane po wyłączeniu zasilania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энергозависимый",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ulotny",
                                "target_lang_sense_clarification": "w kontekście pamięci komputerowej"
                            },
                            {
                                "target_lang_word": "energozależny",
                                "target_lang_sense_clarification": "termin techniczny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f356f32-640d-3f64-a2ab-d0ec55155d3c",
                    "sense_definition": "A chemical or compound that changes into a gas easily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist analyzed the <w>volatiles</w> released by the heating process.",
                            "target_lang_translations": {
                                "ru": "Ученый проанализировал <w>летучие вещества</w>, выделившиеся в процессе нагревания.",
                                "pl": "Naukowiec przeanalizował <w>substancje lotne</w> uwolnione w procesie ogrzewania."
                            }
                        },
                        {
                            "text": "Certain <w>volatiles</w> in the plant give it a distinctive strong scent.",
                            "target_lang_translations": {
                                "ru": "Определенные <w>летучие вещества</w> в этом растении придают ему характерный сильный запах.",
                                "pl": "Niektóre <w>substancje lotne</w> w roślinie nadają jej charakterystyczny, silny zapach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическое вещество или соединение, которое легко превращается в газ",
                        "pl": "Substancja chemiczna lub związek, który łatwo przechodzi w stan gazowy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "летучее вещество",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "substancja lotna",
                                "target_lang_sense_clarification": "rzeczownik"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}