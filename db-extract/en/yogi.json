                        "form_id": "85b9809c-f2e0-441e-afa9-c2d5ebdd7d52",
                        "entry_id": "f942b5ff-9200-317d-9da2-fa43105e7e26",
                        "tags": [
                            "plural"
                        ],
                        "form": "Yogis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "badbea0e-8743-38f9-b5f2-c57e0e70d131",
                        "entry_id": "f942b5ff-9200-317d-9da2-fa43105e7e26",
                        "glosses": [
                            "Alternative letter-case form of yogi."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d4e0d069-dfec-4da6-8a73-d4a6f805cdb5",
                                "sense_id": "badbea0e-8743-38f9-b5f2-c57e0e70d131",
                                "text": "Whoever has not abandoned desire for fruits of action and still have self-centered objectives can never become a Yogi or a practitioner of spiritual communion through work."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "df3e25d5-6d8b-3b30-98ae-f5d9b8f28701",
