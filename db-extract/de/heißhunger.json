                ],
                "senses": [
                    {
                        "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                        "entry_id": "15a63f26-c995-3bb3-a4a9-754c992180ee",
                        "glosses": [
                            "starker, plötzlicher Appetit auf etwas Bestimmtes zu essen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "160dd7f2-4daf-493e-8c51-758ec4c219e2",
                                "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                                "text": "Ich hatte wieder mal Heißhunger auf Schokolade."
                            },
                            {
                                "example_id": "94a39382-a6b3-4b20-b361-f2b9f72d37e7",
                                "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                                "text": "„Mein Frau ist schwanger. Die hat plötzlich Heißhunger auf Gurken, Matjes und Lakritze. Das aß sie früher gar nicht.“"
                            },
                            {
                                "example_id": "7809d5fe-b703-40bb-b316-2047dadf2250",
                                "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                                "text": "Alkoholische Getränke sind fürs Abnehmen - oder auch für das Halten des Gewichts - […] doppelt verheerend: Sie haben nicht nur viele Kalorien, sondern führen auch noch zu Heißhunger."
                            },
                            {
                                "example_id": "0d3753ce-7510-41fc-bc26-0aead873c2bc",
                                "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                                "text": "[Winterdepression:] Die klassischen Symptome sind ein extremes Schlafbedürfnis, eine unerklärliche Traurigkeit und Heißhunger auf Süßes und Kohlenhydrate, der zur Gewichtszunahme führt."
                            },
                            {
                                "example_id": "7c54bacc-6ebb-417c-a373-26335c898023",
                                "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                                "text": "\"Esau und Jakob.\" Sie sind Zwillinge. Esau nur Minuten älter als sein Bruder. Dennoch ist er der Erbe. Der Brauch seines Volkes regelt das glasklar. Weil Esau aber gerade Heißhunger auf eine Speise hat, die Jakob gekocht hat, verkauft er ihm dieses Erbe. Für das Linsengericht."
                            },
                            {
                                "example_id": "0f4a6ab1-9fab-4937-a065-48fe85bf5d38",
                                "sense_id": "8f487522-b01b-34c6-8a02-aeb5c87dce9d",
                                "text": "„Nachher aßen beide mit Heißhunger, ließen es sich so richtig schmecken, tranken Whisky, redeten Unsinn, sprachen auch über ernste Dinge, sprachen vor allem: von einem neuen Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
