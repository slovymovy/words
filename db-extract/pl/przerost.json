                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f069371-4234-415a-81b0-db0ee463c9cc",
                                                "sense_id": "971a3a35-c725-3d74-bded-fe2f71ef87cc",
                                                "text": "Tumorartige Auswüchse am Stamm verleihen dieser Eiche ein besonders urwüchsiges Aussehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fba1ed4f-e06a-3411-8987-3411120fab73",
                                        "entry_id": "20cde9ea-2ae0-364c-a1d2-7315777c8c02",
                                        "glosses": [
                                            "vorzeitige Keimung von Getreidekörnern"
                                        ],
                                        "tags": [
                                            "Getreideanbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac2ccf7-b63a-466f-a84f-45186c11e49f",
                                                "sense_id": "fba1ed4f-e06a-3411-8987-3411120fab73",
                                                "text": "Auswuchs beeinträchtigt die Mehlqualität."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dec4d7b7-678d-349e-a96d-ad9c4282db93",
                                        "entry_id": "20cde9ea-2ae0-364c-a1d2-7315777c8c02",
                                        "glosses": [
                                            "unkontrollierte, unerwartete, übertriebene und meist ungewollte Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6be5b7-1f14-4f1a-813e-65491d71360d",
                                                "sense_id": "dec4d7b7-678d-349e-a96d-ad9c4282db93",
                                                "text": "Die Partei versprach im Wahlkampf, gegen die neuesten Auswüchse des Finanzkapitalismus vorzugehen."
                                            },
                                            {
                                                "example_id": "820c7bc7-3ce1-4ef7-86a7-1bc9e7c1759e",
                                                "sense_id": "dec4d7b7-678d-349e-a96d-ad9c4282db93",
                                                "text": "„Abgesehen von den Auswüchsen einer allzu gefühlsseligen oder gar chauvinistischen Deutschtümelei, wie sie sich besonders um die Jahrhundertwende und dann während des Faschismus breitmachte, ist das Zurückgreifen auf gute alte Wörter zur Bereicherung des Wortbestandes sehr zu begrüßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18638bba-7079-4127-a74a-369c7e6a5f08",
                        "source_entry_id": "f07f91cf-8baf-3d72-ab8b-2fcc6aaa0a25",
                        "source_sense_id": "589a1ae3-1738-33b7-a992-86b0344a1e67",
                        "target_lang_word": "Übermaß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übermaß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                        "entry_id": "4a51715f-8d42-3d7b-8c97-49d6f838fed3",
                                        "glosses": [
                                            "ein Umfang, eine Menge, Größe, die unangemessen übersteigert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f878b098-c78f-4201-aa81-50bfe08c4345",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "Hier liegt eindeutig ein Übermaß an Bürokratie vor."
                                            },
                                            {
                                                "example_id": "d2548fb6-cd97-490b-a481-d3cceae44009",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Den Abschluss bildete der abendliche Ball mit Feuerwerk und hurrapatriotischen Reden im Übermaß.“"
                                            },
                                            {
                                                "example_id": "0b3e4465-e099-409d-9dcc-c7efa5fee3aa",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Aufgrund eines Übermaßes an Heißwasser und Energie leisten sich die Isländer in nahezu jedem noch so kleinen Kaff ein Schwimmbad (Sundlaugar).“"
                                            },
                                            {
                                                "example_id": "157dc75f-1bab-454f-9ede-47ce48b7fc64",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Und wie Remarque bekämpft er seine Ängste und künstlerischen Selbstzweifel durch ein Übermaß an Alkohol.“"
                                            },
                                            {
                                                "example_id": "d5785dd8-357a-4f62-8d67-eaa0d0f92a62",
                                                "sense_id": "440a75ad-89f0-39e9-9b43-15bd8a0f88d2",
                                                "text": "„Das Übermaß an Abortdünger schadete den Erdbeerpflanzen, und die Tomaten litten unter dem Mangel an Beschneidung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61a2f5ce-f79b-46f6-ab81-54269d33722b",
                        "source_entry_id": "f07f91cf-8baf-3d72-ab8b-2fcc6aaa0a25",
