                                        "entry_id": "84eb7f8a-b35a-3663-aeaa-daa97d78a26d",
                                        "glosses": [
                                            "in tropischen und subtropischen Meeren verbreitete Schildkröte mit fünf Paar Rippenschilden"
                                        ],
                                        "tags": [],
