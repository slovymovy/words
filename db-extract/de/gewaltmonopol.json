                    {
                        "sense_id": "7a9fed50-eca3-3731-8d51-6a3d5e9ef782",
                        "entry_id": "33b58fcc-dcb6-39af-8943-d6d5100345cb",
                        "glosses": [
                            "„ausschließlich staatlichen Organen vorbehaltene Legitimation, physische Gewalt auszuüben oder zu legitimieren“"
                        ],
                        "tags": [
                            "Staatsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "e5e51771-8b7e-4c2c-ac51-8f8fd7e15182",
                                "sense_id": "7a9fed50-eca3-3731-8d51-6a3d5e9ef782",
                                "text": "„Die Erfahrungen mit Paramilitarismus in der Weimarer Republik, aber auch die aktuellen Entgrenzungen kriegerischer Gewalt durch selbst ernannte Warlords zeigen, wie gefährlich die Aufkündigung des staatlichen Gewaltmonopols ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
