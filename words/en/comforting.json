                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pocieszający",
                                "target_lang_sense_clarification": "dający nadzieję, podnoszący na duchu"
                            },
                            {
                                "target_lang_word": "pokrzepiający",
                                "target_lang_sense_clarification": "dodający otuchy"
                            },
                            {
