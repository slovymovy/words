                ],
                "senses": [
                    {
                        "sense_id": "9aea4f0c-3bd4-3649-9593-dad02c3f34c6",
                        "entry_id": "6273b452-9ff9-30fc-8c15-97fbd5f64e84",
                        "glosses": [
                            "zum Gedächtnis am Haus, der Straße oder am Todesort aufgestellte Totenbretter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0e6b1a-b721-47f8-91b4-12ab859d0c2a",
                                "sense_id": "9aea4f0c-3bd4-3649-9593-dad02c3f34c6",
                                "text": "„Danach führt der Wege wieder an einer Totenbrettergruppe vorbei bis in den Wald.“"
                            },
                            {
                                "example_id": "714c8d9a-842e-41b9-b54c-030a61849501",
                                "sense_id": "9aea4f0c-3bd4-3649-9593-dad02c3f34c6",
                                "text": "„Nach dem Gottesdienst, den Kaplan Eldivar Coelho Pereira zelebrierte und zu dem die Blaskapelle Weißenregen die Begleitmusik lieferte, zogen die Aktiven, die ehemaligen Schirmherrn und die Führungsspitze der Feuerwehren im Landkreis zur Totenbrettergruppe beim Anwesen Schillitz.“"
                            },
                            {
                                "example_id": "fd7ba6b9-a631-4703-8e55-c4e71c5a83a8",
                                "sense_id": "9aea4f0c-3bd4-3649-9593-dad02c3f34c6",
                                "text": "„Auf Initiative der Dorfgemeinschaft ist eine Totenbrettergruppe in der Nähe errichtet worden.“"
                            },
                            {
                                "example_id": "ee61866e-7c05-4abc-b83d-96534c3fac03",
                                "sense_id": "9aea4f0c-3bd4-3649-9593-dad02c3f34c6",
                                "text": "„Zu den Naturdenkmälern des Lallinger Winkels gehören die vielen Totenbrettergruppen, die in Dörfern, an Wegrändern, bei Kapellen und Aussichtspunkten stehen und an die verstorbenen Bewohner erinnern.“"
                            },
                            {
                                "example_id": "059940c8-3457-4fc5-ad7f-1d8c8d206639",
                                "sense_id": "9aea4f0c-3bd4-3649-9593-dad02c3f34c6",
                                "text": "„An der Totenbrettergruppe wurden im Anschluss an den Gottesdienst aller verstorbenen Pfingstakteure mit einem \"Vater unser\" gedacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
