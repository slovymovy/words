                    },
                    {
                        "translation_id": "9c8aa499-75a6-4ee2-9938-f774bed92e36",
                        "source_entry_id": "d89116d0-4f95-3da0-9686-6ccdca3eb703",
                        "source_sense_id": "c701e005-a1ca-3082-9ad5-b340c026b2c4",
