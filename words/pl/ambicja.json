                            },
                            {
                                "target_lang_word": "гордость",
                                "target_lang_sense_clarification": "личное достоинство, честь"
                            },
                            {
                                "target_lang_word": "амбиция",
                                "target_lang_sense_clarification": "задетое достоинство, спесь"
                            }
                        ]
                    }
                }
            ]
        }
