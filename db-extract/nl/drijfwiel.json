                    {
                        "translation_id": "e56aff2d-aec0-4336-9f35-c87bd08d4a75",
                        "source_entry_id": "0d32cd22-c724-31a6-a472-62d5017f3a11",
                        "source_sense_id": "1f6f2347-d04c-3be8-9b37-deed389a7f26",
