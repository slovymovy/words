    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06be0652-ccb3-37e0-b54b-623a1ac58937",
                    "sense_definition": "het annuleren van een geplande afspraak, evenement of regeling",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "annuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet helaas onze afspraak vanmiddag <w>afzeggen</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I have to <w>cancel</w> our appointment this afternoon."
                            }
                        },
                        {
                            "text": "Zij moest de vergadering op het laatste moment <w>afzeggen</w>.",
                            "target_lang_translations": {
                                "en": "She had to <w>cancel</w> the meeting at the last minute."
                            }
                        }
                    ],
                    "synonyms": [
                        "annuleren"
                    ],
                    "antonyms": [
                        "bevestigen",
                        "doorgaan"
                    ],
                    "common_phrases": [
                        "een afspraak afzeggen",
                        "op het laatste moment afzeggen"
                    ],
                    "target_lang_definitions": {
                        "en": "cancelling a planned appointment, event, or arrangement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "to call off a planned event or meeting"
                            },
                            {
                                "target_lang_word": "call off",
                                "target_lang_sense_clarification": "to decide that something will not happen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fac5900-6521-3cb8-b4f3-3859b7374560",
                    "sense_definition": "formeel of informeel laten weten dat men niet aanwezig zal zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "annuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb dat feest <w>afgezegd</w> omdat ik me niet goed voelde.",
                            "target_lang_translations": {
                                "en": "I <w>cancelled</w> on that party because I wasn't feeling well."
                            }
                        },
                        {
                            "text": "Als je niet kunt komen, moet je op tijd <w>afzeggen</w>.",
                            "target_lang_translations": {
                                "en": "If you can't come, you must <w>cancel</w> in time."
                            }
                        },
                        {
                            "text": "Ik heb <w>afgezegd</w> voor het feest omdat ik een andere afspraak had.",
                            "target_lang_translations": {
                                "en": "I <w>declined</w> the party because I had another appointment."
                            }
                        }
                    ],
                    "synonyms": [
                        "annuleren"
                    ],
                    "antonyms": [
                        "toezeggen"
                    ],
                    "common_phrases": [
                        "afzeggen voor een feest",
                        "tijdig afzeggen"
                    ],
                    "target_lang_definitions": {
                        "en": "formally or informally letting someone know that you will not be attending"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "to notify that you cannot attend"
                            },
                            {
                                "target_lang_word": "decline",
                                "target_lang_sense_clarification": "to politely say no to an invitation"
                            },
                            {
                                "target_lang_word": "back out",
                                "target_lang_sense_clarification": "to withdraw from a commitment or social plan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}