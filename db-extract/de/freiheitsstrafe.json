                "senses": [
                    {
                        "sense_id": "d33e2ab1-cfc6-36c3-b89e-43cbac89aa1e",
                        "entry_id": "b824fbc8-d994-30b1-b43a-66a0f2b1d220",
                        "glosses": [
                            "Strafe, die darin besteht, dass dem verurteilten Straftäter seine Fortbewegungsfreiheit dadurch entzogen wird, dass er eine gewisse Zeit in einer Justizvollzugsanstalt verbringen muss"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "000ae455-4f3c-4128-80f3-af8b43810898",
                                "sense_id": "d33e2ab1-cfc6-36c3-b89e-43cbac89aa1e",
                                "text": "„Der Mörder wird mit lebenslanger Freiheitsstrafe bestraft.“"
                            },
                            {
                                "example_id": "f7baead0-cae1-4549-8b45-8fe0e7f2a2b6",
                                "sense_id": "d33e2ab1-cfc6-36c3-b89e-43cbac89aa1e",
                                "text": "„Während die Politiker nach einem Kompromiss suchen, drohen den tausend Anlegern Geld- und Freiheitsstrafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4287c82c-f20e-35cb-a854-f23acfb67b01",
                        "entry_id": "b824fbc8-d994-30b1-b43a-66a0f2b1d220",
                        "glosses": [
                            "Oberbegriff für verschiedene Arten des Freiheitsentzuges durch Einsperren"
                        ],
                        "tags": [
                            "rechtshistorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "6aced22e-9626-41d4-a203-1fb60ca2f3a5",
                                "sense_id": "4287c82c-f20e-35cb-a854-f23acfb67b01",
                                "text": "1969 wurden in Deutschland die vier unterschiedlichen Freiheitsstrafen vereinheitlicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
