                    },
                    {
                        "form_id": "4c37cb63-7a36-4562-bc87-0fa1aef3ecb5",
                        "entry_id": "679b2a9a-e759-3117-8daa-66885b0cd8f4",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind undressierbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cec36cb1-9e6c-30a2-b988-c386fff621ae",
                        "entry_id": "679b2a9a-e759-3117-8daa-66885b0cd8f4",
                        "glosses": [
                            "so, dass es nicht dressiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e938de-a03f-4f06-be6f-902f63eeb580",
                                "sense_id": "cec36cb1-9e6c-30a2-b988-c386fff621ae",
                                "text": "„Eine undressierbar wilde Katze. / Die beugt sich zurück und zieht – / Gott weiß wie – wunderliche, / Unvergleichbar sichre Zauberstriche.“"
                            },
                            {
                                "example_id": "4b5bb38b-b641-4a2b-9dc8-4e9c9b4d647c",
                                "sense_id": "cec36cb1-9e6c-30a2-b988-c386fff621ae",
                                "text": "„Hunde sind zum Gehorsam dressierte Nachfahren der Wölfe, denen das Wolfsein für immer vergangen ist. Katzen dagegen sind undressierbar.“"
                            },
                            {
                                "example_id": "58c696c1-aa8c-4316-9358-3a83f1bb8e65",
                                "sense_id": "cec36cb1-9e6c-30a2-b988-c386fff621ae",
                                "text": "„… bis er erkannte: Dass es Tiere gibt, die die Reaktion auf den negativen Verstärker nicht in ihrem Verhaltensprogramm haben und somit undressierbar sind.“"
                            },
                            {
                                "example_id": "601c55e4-6b0d-4752-87a8-3b644e44c0ce",
                                "sense_id": "cec36cb1-9e6c-30a2-b988-c386fff621ae",
                                "text": "„Jeder Katzenfan weiß, dass die Samtpfoten als eigenwillig und undressierbar gelten. Wer jedoch eine Vorstellung in Dimitri Kuklachevs Katzentheater verfolgt, wird schnell vom Gegenteil überzeugt.“"
                            },
                            {
                                "example_id": "eb4dc427-05bb-4766-9686-84b1249944e1",
                                "sense_id": "cec36cb1-9e6c-30a2-b988-c386fff621ae",
                                "text": "„Der Schwabe ist gutmütig, fleißig, aber auch undressierbar, mal grob, mal zärtlich, sparsam, grüblerisch, schleckig und leicht verletzbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
