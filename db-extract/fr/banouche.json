                "senses": [
                    {
                        "sense_id": "9b721f7f-c0bc-3a8c-8382-0084cb137c36",
                        "entry_id": "97a44fca-2925-31a3-9926-60411247bc93",
                        "glosses": [
                            "Bouillie de farine de maïs, cuite avec de la crème fraîche et couverte avec des champignons ou des lardons et du fromage de brebis (brynza) : plat typique de l’ouest ukrainien et des Carpates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb1ca18-bee6-4fc9-ab77-717f509b0a9b",
                                "sense_id": "9b721f7f-c0bc-3a8c-8382-0084cb137c36",
                                "text": "Parmi les spécialités des Carpates on trouve le brynza (fromage de brebis frais) et une sorte de polenta appelée banouche. Ce plat typiquement carpatien est fait à base de farine de maïs, crème fraîche, lardons, champignons et brynza. Le banouche se décline à l’infini et les restaurants locaux pourront vous le confirmer."
                            },
                            {
                                "example_id": "a394747b-f415-4c79-a854-9c3b2b8a74a6",
                                "sense_id": "9b721f7f-c0bc-3a8c-8382-0084cb137c36",
                                "text": "Envie de spécialités locales comme l’incontournable banouche (une bouillie crémeuse de farine de maïs, cuite avec de la crème fraîche, et servie avec des lardons grillés et du fromage de brebis) ou plutôt le potage local de champignons ?"
                            }
                        ]
                    }
                ],
