                            {
                                "example_id": "4c095c83-5b60-4d96-a02b-b936ca0e5138",
                                "sense_id": "fc7ee975-5e36-3450-9655-1ff2e63c6a7a",
                                "text": "Не испортить бы.",
                                "translation": "Żeby tylko nie zepsuć."
                            }
                        ],
