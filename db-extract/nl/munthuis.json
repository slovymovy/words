                                        "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "A vast sum of money; (by extension) a large amount of something."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab34a659-56fa-4736-97e0-3498faf02b42",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "That house is worth a mint."
                                            },
                                            {
                                                "example_id": "eb50f654-9460-4e77-a0a5-acea0ca8d131",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "It must have cost a mint to produce!"
                                            },
                                            {
                                                "example_id": "7de6744e-aaa6-46a4-ae90-2e46b8477013",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "to make a mint"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f38b23-cdd2-31f3-b21c-a08d7b645032",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "Any place regarded as a source of unlimited supply; the supply itself."
