                        ],
                        "form": "die Grabmäler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                        "entry_id": "f129d6f4-a9a4-3383-b38c-8430ce4076b9",
                        "glosses": [
                            "Stein oder Denkmal auf einem Grab mit Angaben zur beerdigten Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3acc16f-0f9c-49bd-bc9b-a1ccb3253a50",
                                "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                                "text": "Auf einem Grabmal stehen Name und Lebensdaten zur Erinnerung an den/ die Verstorbene(n)."
                            },
                            {
                                "example_id": "b48531f1-2315-40c0-b1d4-edfac281612a",
                                "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                                "text": "„Das bescheidene Grabmal eines sorbischen Militärpfarrers steht als Fremdkörper inmitten der geschichtlichen Marginalien, ist aber auch ein Verweis auf die Toleranz, die in Sachsen bis 1918 noch möglich war.“"
                            },
                            {
                                "example_id": "b82d2aea-e314-476e-a67f-91299a86fea4",
                                "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                                "text": "„Auf meinem Weg hindurch kam ich an weiteren, noch älteren Grabmalen vorüber, solchen aus hellenistischer Zeit.“"
                            },
                            {
                                "example_id": "197100c6-d5f8-4a50-8a17-c1eecdb99101",
                                "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                                "text": "„Das Grabmal ruhte auf Granitstufen.“"
                            },
                            {
                                "example_id": "9286e7d5-96b8-468d-9375-20883473d5dd",
                                "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                                "text": "„Hinterm Grabmal für Hugo Karl Anton hatten wir die Steine eingegraben, natürlich in der richtigen Reihenfolge.“"
                            },
                            {
                                "example_id": "764cf8ae-1097-4720-9c37-0c7531d93315",
                                "sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                                "text": "„Der Aufstieg der Stadt spiegelt sich außer in den urbanen Großvillen mit ihren figürlichen Wandmalereien und Fußbodenmosaiken in den Grabmälern wider, die einst die Ausfallstraßen vor der Stadtmauer säumten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82d76e9a-24df-452e-bbd4-035a62e02532",
                        "source_entry_id": "f129d6f4-a9a4-3383-b38c-8430ce4076b9",
                        "source_sense_id": "894a85e8-5da1-3f62-95e5-64d5f757dfd0",
                        "source_sense_description": "Stein oder Denkmal auf einem Grab mit Angaben zur beerdigten Person",
                        "target_lang_word": "tombstone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tombstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1408d1d0-53f7-3ad1-b42f-693c14d9fb5d",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A grave marker, a stone slab or similar object marking a person's grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68ba237-b813-47e1-b1e0-aff530a8bd57",
                                                "sense_id": "1408d1d0-53f7-3ad1-b42f-693c14d9fb5d",
                                                "text": "True, there's no harm in crying for one's husband, and the tombstone, though plain, was a solid piece of work, and on summer's days when the widow brought her boys to stand there one felt kindly towards her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b28fdf7-e5d7-361f-8fa3-e748eecd529a",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "The symbol \\\"∎\\\" marking the end of a proof."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f17a75b8-6e59-30f1-9d84-ac21c9833cdd",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A marker that takes the place of deleted data, allowing for replication of the deletion across servers etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375974b4-2ac4-4c14-8d6b-f83ee487babf",
                                                "sense_id": "f17a75b8-6e59-30f1-9d84-ac21c9833cdd",
                                                "text": "If you attempt to restore a backup that is older than the tombstone lifetime, it may introduce objects that were deleted […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f30cd57e-fc37-3d11-8d20-03d3045b05b2",
                                        "entry_id": "5e8550fc-642e-3215-b1f6-6f902e25e064",
                                        "glosses": [
                                            "A crashdump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202e4942-2e74-45ba-acce-2509fbda38aa",
                                                "sense_id": "f30cd57e-fc37-3d11-8d20-03d3045b05b2",
