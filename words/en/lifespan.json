{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c605c09-403d-39e8-97f4-1ad4cc2252a9",
                    "sense_definition": "The length of time for which a person, animal, or other organism lives.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration of life or existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some species of tortoises have an average <w>lifespan</w> of over one hundred years.",
                            "target_lang_translations": {
                                "zh": "某些种类的陆龟平均<w>寿命</w>超过一百年。"
                            }
                        },
                        {
                            "text": "Medical advances have greatly increased the human <w>lifespan</w> over the past century.",
                            "target_lang_translations": {
                                "zh": "在过去一个世纪里，医疗进步极大地延长了人类的<w>寿命</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lifetime"
                    ],
                    "common_phrases": [
                        "average lifespan",
                        "human lifespan"
                    ],
                    "target_lang_definitions": {
                        "zh": "人、动物或其他生物生存的时间长度；寿命。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "寿命",
                                "target_lang_sense_clarification": "指生物的生命周期长度"
                            },
                            {
                                "target_lang_word": "预期寿命",
                                "target_lang_sense_clarification": "指生物预计可以生存的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb1628fb-c9ed-3086-aeff-21c71ec4fe20",
                    "sense_definition": "The period of time during which an object, product, or system is expected to function or exist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration of life or existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular maintenance can help extend the <w>lifespan</w> of your car's engine.",
                            "target_lang_translations": {
                                "zh": "定期保养有助于延长汽车发动机的<w>使用寿命</w>。"
                            }
                        },
                        {
                            "text": "The battery has an expected <w>lifespan</w> of about three to five years.",
                            "target_lang_translations": {
                                "zh": "该电池的预期<w>寿命</w>约为三到五年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "extend the lifespan",
                        "expected lifespan"
                    ],
                    "target_lang_definitions": {
                        "zh": "物品、产品或系统预计能够正常运转或存在的时间长度；使用寿命。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使用寿命",
                                "target_lang_sense_clarification": "指器械、零件或产品能正常使用的年限"
                            },
                            {
                                "target_lang_word": "寿命",
                                "target_lang_sense_clarification": "指物品或系统的有效存在期"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}