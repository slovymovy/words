                ],
                "senses": [
                    {
                        "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                        "entry_id": "56dc3989-c47e-3c7a-b93f-0a41f5f1cc0d",
                        "glosses": [
                            "männliche Person, die beruflich filmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c77569e-3183-4ecf-8ba0-68f2c687beed",
                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                "text": "Der Kameramann begleitet den Reporter auf Schritt und Tritt."
                            },
                            {
                                "example_id": "e027b3ad-cc5a-424b-89a4-ea126f2df969",
                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                "text": "„Als die Kameraleute das Flugzeug verlassen hatten, schaute ich zu der Landkarte auf dem Bildschirm, auf der nun Asien im Mittelpunkt stand.“"
                            },
                            {
                                "example_id": "bcfd4963-6813-4917-bc2f-02cb025873b2",
                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                "text": "„Aber als der erste Kameramann sich an ihm vorbeizwängte, gab er auf.“"
                            },
                            {
                                "example_id": "113b9b4c-64d3-45c3-8a51-e4d6689c2fc6",
                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                "text": "„Zwei Kameramänner und zwei Tontechniker waren gekommen, und auch ein Ansager in grünem Blazer, auf dem auf der linken Brusttasche das WSOU-TV-Zeichen aufgestickt war.“"
                            },
                            {
                                "example_id": "910041ab-940a-49a8-be6d-a76493db886a",
                                "sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                                "text": "„Danach filmte Brack in einem solchen Tempo zu Ende, daß der Kameramann nach der letzten Einstellung mit Nervenzusammenbruch in die Klinik gebracht werden mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d193962b-13d0-4a87-aa80-bc587c158b7c",
                        "source_entry_id": "56dc3989-c47e-3c7a-b93f-0a41f5f1cc0d",
                        "source_sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                        "source_sense_description": "männliche Person, die beruflich filmt",
                        "target_lang_word": "cameraman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cameraman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3134f669-962b-3994-afdc-1e540b07c585",
                                        "entry_id": "26464e59-ef30-3b00-840f-54c898756a6a",
                                        "glosses": [
                                            "Somebody who operates a movie camera or television camera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8943b747-7b7b-49b9-b7ac-d041ab4d2579",
                                                "sense_id": "3134f669-962b-3994-afdc-1e540b07c585",
                                                "text": "‘We were getting a grand shot of a charging rhino when the cameraman got scared and bolted. The fathead!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "613d3ca3-a946-4ed0-9c8d-517c7db4061a",
                        "source_entry_id": "56dc3989-c47e-3c7a-b93f-0a41f5f1cc0d",
                        "source_sense_id": "6fb02dca-d81c-39cf-8fd2-9c350ce9f087",
                        "source_sense_description": "männliche Person, die beruflich filmt",
                        "target_lang_word": "оператор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оператор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "54ce367a-6638-3503-b270-1129c9cc30fc",
                                        "entry_id": "1c95c9e2-9cf9-3343-a2ac-9b2032ceadf4",
                                        "glosses": [
                                            "мед. врач-хирург, делающий операции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbcaa594-df50-4f2e-b988-e93cabb1b0f7",
                                                "sense_id": "54ce367a-6638-3503-b270-1129c9cc30fc",
                                                "text": "На лице Анны Михайловны было гордое выражение оператора, окончившего трудную ампутацию и вводящего публику для того, чтоб она могла оценить его искусство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba41a85d-c356-36d8-b93c-772617e8902d",
                                        "entry_id": "1c95c9e2-9cf9-3343-a2ac-9b2032ceadf4",
                                        "glosses": [
                                            "специалист, работающий на каком-либо устройстве, аппарате, агрегате"
                                        ],
                                        "tags": [
                                            "+ род. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "684581d1-c547-46d4-a875-800c1d6eaa83",
                                                "sense_id": "ba41a85d-c356-36d8-b93c-772617e8902d",
                                                "text": "Оператор ЭВМ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec949db3-b59f-3282-bef6-b57afaed529a",
                                        "entry_id": "1c95c9e2-9cf9-3343-a2ac-9b2032ceadf4",
                                        "glosses": [
                                            "кино то же, что кинооператор, специалист, непосредственно осуществляющий кино- или телесъёмку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a542b115-f397-4e10-825d-6b38b69742de",
                                                "sense_id": "ec949db3-b59f-3282-bef6-b57afaed529a",
                                                "text": "Оператор-постановщик."
                                            },
                                            {
                                                "example_id": "5a64f950-fc54-44dd-876a-d6cc1c0b9a6e",
                                                "sense_id": "ec949db3-b59f-3282-bef6-b57afaed529a",
                                                "text": "День за днём операторы фильма снимали различные эпизоды борьбы, закончившейся для советских войск — славой, для немцев — неслыханным позором."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507ac399-114a-3862-be4b-f3771656507f",
                                        "entry_id": "1c95c9e2-9cf9-3343-a2ac-9b2032ceadf4",
                                        "glosses": [
                                            "техн. компания или организация, предоставляющая специализированные услуги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc04886-48ad-460a-8ef6-46fcac81049a",
                                                "sense_id": "507ac399-114a-3862-be4b-f3771656507f",
                                                "text": "Оператор сотовой связи."
                                            },
                                            {
                                                "example_id": "d9e504b0-5213-4586-a23d-30a8a7f95ef0",
                                                "sense_id": "507ac399-114a-3862-be4b-f3771656507f",
                                                "text": "Кабельный оператор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cccda5c3-6432-3191-adfd-770a3f0637bf",
                                        "entry_id": "1c95c9e2-9cf9-3343-a2ac-9b2032ceadf4",
