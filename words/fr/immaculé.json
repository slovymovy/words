            "senses": [
                {
                    "sense_id": "0adfdfb7-9995-3665-bb4d-696f42d0a69d",
                    "sense_definition": "Prénom inspiré du culte marial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Immaculée</w> a fêté son anniversaire entourée de ses proches."
                        },
                        {
                            "text": "J'ai reçu une lettre amicale de la part d'<w>Immaculée</w> ce matin."
