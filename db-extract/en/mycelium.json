                    {
                        "translation_id": "bb147ddf-eb27-4880-b998-b7fb456d0d42",
                        "source_entry_id": "acba2fcd-5ced-3891-ab21-afd82213caf4",
                        "source_sense_id": "2fcf6245-e8a0-3505-a634-b71668e0652c",
