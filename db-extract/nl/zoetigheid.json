                            {
                                "example_id": "1f2c5cd4-680c-4952-bf0a-288084cac41c",
                                "sense_id": "290d3fd5-3802-362a-b33e-7118280cb799",
                                "text": "Wil je wat zoetigheid op de boterham of liever iets hartigs?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a717eb65-daa7-48dc-a337-385044c79216",
                        "source_entry_id": "f2a92d6f-91a4-3013-b908-b10821925457",
                        "source_sense_id": "290d3fd5-3802-362a-b33e-7118280cb799",
                        "source_sense_description": "etenswaar met een zoete smaak",
                        "target_lang_word": "Süßigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Süßigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                        "entry_id": "087dbcef-a7a1-3ed0-bc0b-2219ef95cb35",
                                        "glosses": [
                                            "Lebensmittel, das süß ist und als Naschzeug verwendet wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c2c69b-5d93-45d6-b213-a18a3cc854d8",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "Zu Süßigkeiten gehören z. B. Lutscher, Schokolade, Eis und so weiter."
                                            },
                                            {
                                                "example_id": "a6ad0504-59d9-4f6e-95f3-f0719a5c1ffb",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "Man sollte nicht zu viele Süßigkeiten essen."
                                            },
                                            {
                                                "example_id": "6ec23afc-6669-486c-bbcf-3b28bc5bd632",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Als die Gäste kamen, erklärte Helena, sie würden einen ganz besonderen Abend bei Kerzenlicht verbringen, ohne warmes Essen, nur mit Süßigkeiten.“"
                                            },
                                            {
                                                "example_id": "366dbd2c-e789-4f05-b0a6-c9dfd40c3d69",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Die fuchsiafarbene Süßigkeit versetzte ihre Geschmacksnerven in Ekstase.“"
                                            },
                                            {
                                                "example_id": "0ffcb71e-cb9a-4346-8036-5a23493902bd",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Er stellt die Schale mit den Süßigkeiten auf den Wohnzimmertisch aus weißem Marmor und lässt sich auf das Ledersofa fallen.“"
                                            },
                                            {
                                                "example_id": "2ed6b45e-100a-40e9-954d-e3b426f79e48",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Ich esse gern Süßigkeiten und sehe mich daher hin und wieder gezwungen, einen Zahnarzt aufzusuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4f3656e-f220-3702-81b3-6718e35952b7",
                                        "entry_id": "087dbcef-a7a1-3ed0-bc0b-2219ef95cb35",
                                        "glosses": [
                                            "der Zustand, süß zu sein, eine angenehme (liebliche) Empfindung hervorrufend"
                                        ],
                                        "tags": [
                                            "kein Plural; veraltend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff520c0f-73e0-4391-8667-b89fd4fb3af0",
                                                "sense_id": "d4f3656e-f220-3702-81b3-6718e35952b7",
                                                "text": "„Die Milch ist das Symbol des ersten Aspekts der Liebe, dem der Fürsorge und Bestätigung. Der Honig symbolisiert die Süßigkeit des Lebens, die Liebe zum Leben und das Glück zu leben.“"
                                            },
                                            {
                                                "example_id": "c2f417ea-34e7-4570-88d7-34a913978374",
                                                "sense_id": "d4f3656e-f220-3702-81b3-6718e35952b7",
                                                "text": "„Die Süßigkeit der Melodien schmeichelte sich in ihr Herz und machte sie unruhig, sie wußte selbst nicht, warum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
