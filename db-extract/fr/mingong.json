                        "glosses": [
                            "En Chine, migrant des campagnes vers la ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5817b95-bcc4-418f-9e42-922d4356ed55",
                                "sense_id": "de24e39e-1357-33cc-8a98-55b6b8c5493c",
                                "text": "Avec son épouse, Xie travaillait pour l’école Hongxing d’enfants de « mingong », les migrants, dans le nord-ouest de Pékin, où leur fils et fille de 5 et 6 ans suivaient la classe."
                            },
                            {
                                "example_id": "d8c27aeb-c346-4f6f-9525-410e37cb0a20",
                                "sense_id": "de24e39e-1357-33cc-8a98-55b6b8c5493c",
                                "text": "Les mingongs, c’est ainsi qu’on les appelle, sont en plus soumis à des cadences infernales de travail de dix à douze heures par jour."
                            }
                        ]
                    }
                ],
