                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c9b3c7-d559-4833-b98c-327e92e9aea1",
                                "sense_id": "37e07da5-36d0-3246-b343-0ce331ce7e3b",
                                "text": "Cela va me décafarder car le guignon me poursuit."
                            },
                            {
                                "example_id": "c99620b1-98b1-4621-9996-02e7db750566",
                                "sense_id": "37e07da5-36d0-3246-b343-0ce331ce7e3b",
                                "text": "Pour me « décafarder » et changer un peu, j’assiste à un concert donné et exécuté par les plus anciens au camp."
                            },
                            {
                                "example_id": "8ddf1ee4-1959-49d1-a15c-176e5184efb3",
                                "sense_id": "37e07da5-36d0-3246-b343-0ce331ce7e3b",
                                "text": "La nuit venue, on décafarde."
                            }
                        ]
                    }
