                "senses": [
                    {
                        "sense_id": "08068efb-0224-3fcb-a60b-59ece17d3b6e",
                        "entry_id": "8938daed-ad7f-3d3f-8c0f-b5a70d2d0c7e",
                        "glosses": [
                            "dowolny obiekt, do którego zastosowanie danej nazwy ma sens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81028228-fc37-4849-813a-ae0f38e0a86a",
                                "sense_id": "08068efb-0224-3fcb-a60b-59ece17d3b6e",
                                "text": "Ten konkretny pies z obrazka jest desygnatem nazwy „pies”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39594e86-e407-4a3c-9d03-a662419b794b",
                        "source_entry_id": "8938daed-ad7f-3d3f-8c0f-b5a70d2d0c7e",
                        "source_sense_id": "08068efb-0224-3fcb-a60b-59ece17d3b6e",
                        "target_lang_word": "designatum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "designatum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59196d52-3c03-3b06-ab72-bf8d83d665a5",
                                        "entry_id": "aa5d5396-cfec-3e4b-98c5-9b76d1542b05",
                                        "glosses": [
                                            "That which is named or designated by a linguistic term."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d94602-d050-463a-97cf-e7d31b7342ac",
                                                "sense_id": "59196d52-3c03-3b06-ab72-bf8d83d665a5",
                                                "text": "I am inclined to hold that if there is a plurality of objects that fall under the designatum of a term, then that should be sufficient (though not necessary) to conclude that that is a general term, even when it has a singular occurrence in a sentence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa4e6e3e-872f-4397-84b4-79bb981758b5",
                        "source_entry_id": "8938daed-ad7f-3d3f-8c0f-b5a70d2d0c7e",
                        "source_sense_id": "08068efb-0224-3fcb-a60b-59ece17d3b6e",
                        "target_lang_word": "referent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "referent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c61104-6759-3c56-ae2b-b188898d15de",
                                        "entry_id": "20985f4a-ee69-3a53-bb0c-eaa503f5f2e0",
                                        "glosses": [
                                            "The specific entity in the world that a word or phrase identifies or denotes: what it refers to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537370fa-7d21-449b-9fa5-94bc29a687e5",
                                                "sense_id": "e0c61104-6759-3c56-ae2b-b188898d15de",
                                                "text": "For quotations using this term, see Citations:referent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93f3c1ad-515a-3a30-8489-0b11dd73eed4",
                                        "entry_id": "20985f4a-ee69-3a53-bb0c-eaa503f5f2e0",
                                        "glosses": [
                                            "That which is referenced."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68444723-fce0-40c6-ad3a-dd7162f43af4",
                        "source_entry_id": "8938daed-ad7f-3d3f-8c0f-b5a70d2d0c7e",
                        "source_sense_id": "08068efb-0224-3fcb-a60b-59ece17d3b6e",
                        "target_lang_word": "Referent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Referent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                                        "entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                                        "glosses": [
                                            "Person, die etwas referiert, ein Referat hält"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf782f8-34be-4a24-aefb-2f144b8891d5",
                                                "sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                                                "text": "Der Referent hielt einen sehr langweiligen Vortrag."
                                            },
                                            {
                                                "example_id": "a756e2e2-d19b-42ac-8dd6-ba821bcf05f4",
                                                "sense_id": "4a1e1f99-3afe-34d3-ab66-2a0c10587801",
                                                "text": "„Dass dies jedoch nicht immer der Fall ist, illustrierte der Referent anhand einiger Beispiele.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a806e676-39a3-3ec3-9cfd-16dcf2e266d1",
                                        "entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                                        "glosses": [
                                            "Person, die in einer Organisation für einen Sachbereich zuständig ist"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce72c3d-9d0e-4ab9-a85e-9cf6fcf4d560",
                                                "sense_id": "a806e676-39a3-3ec3-9cfd-16dcf2e266d1",
                                                "text": "Der neue Referent muss sich erst noch richtig einarbeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                        "entry_id": "0187d8a0-2c49-3f1d-9245-9a8d152ca2da",
                                        "glosses": [
                                            "der Gegenstand, auf den ein sprachlicher Ausdruck sich bezieht, auf den eine Referenz (Bezugnahme) gerichtet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e6d642-e07b-4492-a815-57af5c13ba6c",
                                                "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                                "text": "Der Referent eines Ausdrucks wie \"Hans\" ist eine Person."
                                            },
                                            {
                                                "example_id": "6a93ecef-1234-425d-96af-7e05b696bd72",
                                                "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                                "text": "„Zwischen Symbol und Referent besteht kein unmittelbarer Zusammenhang.“"
                                            },
                                            {
                                                "example_id": "343ca2fa-6137-4fcd-a07b-06a890639044",
                                                "sense_id": "7ad11bbb-a78e-31dc-8db7-2235dccd5501",
                                                "text": "„Dann redet man auch, mehr oder weniger gleichbedeutend mit Referent, vom Designat oder Designatum (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b63e438-91e0-4349-91ed-d1dfeeafcbc4",
                        "source_entry_id": "8938daed-ad7f-3d3f-8c0f-b5a70d2d0c7e",
                        "source_sense_id": "08068efb-0224-3fcb-a60b-59ece17d3b6e",
                        "target_lang_word": "Denotat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denotat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c15bf179-088b-3c9d-a775-aa484adcd2de",
                                        "entry_id": "851eaca1-37e1-3961-a319-1b5c761f4aab",
                                        "glosses": [
                                            "Sachverhalt, den ein Sprecher/ Schreiber bei Verwendung eines Wortes meint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00164edb-bc2f-4616-8f01-e305c5b9177d",
                                                "sense_id": "c15bf179-088b-3c9d-a775-aa484adcd2de",
                                                "text": "Das Denotat des Wortes \"Venus\" ist einer der Planeten und stimmt mit dem von „Abendstern“ und „Morgenstern“ überein. Es ist der gleiche Gegenstand gemeint."
                                            },
                                            {
                                                "example_id": "9e4d5ea8-7bcd-422f-bd0c-3fd62aa7831b",
                                                "sense_id": "c15bf179-088b-3c9d-a775-aa484adcd2de",
                                                "text": "„Nur bei Berücksichtigung lautlicher und semantischer Übereinstimmungen, gleicher oder ähnlicher Denotate (Bezeichnungsobjekte und Objektklassen) und des soziokulturellen Zusammenhangs kann die Etymologie zu gültigen Ergebnissen gelangen.“"
                                            },
                                            {
                                                "example_id": "a552b568-30f2-447f-9508-c2c7b51c151b",
                                                "sense_id": "c15bf179-088b-3c9d-a775-aa484adcd2de",
                                                "text": "„Seit Mitte des vorigen Jahrhunderts nehmen dabei umfangreiche Mehrfachkomposita überhand, mit denen versucht wird, die Nomination als Kurzbeschreibung des Denotats einzusetzen und Selbstdeutigkeit der Termini zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b27b503-b98f-34a2-92ca-60b19c099ada",
                                        "entry_id": "851eaca1-37e1-3961-a319-1b5c761f4aab",
                                        "glosses": [
                                            "Bedeutung, Inhalt eines Wortes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c9df2e-6fe1-4ded-8eae-bbbb6f9c6a65",
                                                "sense_id": "4b27b503-b98f-34a2-92ca-60b19c099ada",
                                                "text": "Das Denotat des Wortes \"Venus\" ist ein anderes als das von „Abendstern“ und „Morgenstern“. Auch wenn die drei Wörter denselben Planeten meinen, unterscheiden sie sich in ihrer Bedeutung."
                                            },
                                            {
                                                "example_id": "4a063303-3ea4-44ed-9c4f-645a32138e66",
                                                "sense_id": "4b27b503-b98f-34a2-92ca-60b19c099ada",
                                                "text": "„Diese denotative Bedeutung wird oft auch als die Grundbedeutung eines Wortes bezeichnet, was darauf hindeutet, daß zusätzliche Bedeutungskomponenten existieren, die über das Denotat hinausweisen.“"
                                            },
                                            {
                                                "example_id": "89e2f69d-334a-4f83-bc4b-29bfbeaf819a",
                                                "sense_id": "4b27b503-b98f-34a2-92ca-60b19c099ada",
                                                "text": "„Da ist zunächst die Frage, ob EN wie App ein Denotat haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
