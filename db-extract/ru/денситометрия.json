                "senses": [
                    {
                        "sense_id": "6c589d06-2051-3879-b2b9-88ef4a4bd39c",
                        "entry_id": "22d050d7-44c7-3b9e-9b2a-a532845a226e",
                        "glosses": [
                            "спец. совокупность технологий, методов и средств для измерения оптической плотности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a3df2f-9a99-409b-8d94-e4fe80653d62",
                                "sense_id": "6c589d06-2051-3879-b2b9-88ef4a4bd39c",
                                "text": "Денситометрия занимается измерением поглощения и рассеяния света хроматографическими слоями, подвергшимися проявлению или иной обработке."
                            },
                            {
                                "example_id": "c8f5d8b2-c989-4cc1-89b0-c900758f147b",
                                "sense_id": "6c589d06-2051-3879-b2b9-88ef4a4bd39c",
                                "text": "Денситометрия — метод, основанный на измерении плотности."
                            }
                        ]
                    }
