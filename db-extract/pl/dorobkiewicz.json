                ],
                "senses": [
                    {
                        "sense_id": "59d5a699-86eb-3bcf-8c60-fd589b09da5a",
                        "entry_id": "2c6b179f-f0a6-3ea4-9591-d12e7cbd2a7a",
                        "glosses": [
                            "osoba bogata lub o wysokiej pozycji społecznej osiągniętej z wykorzystaniem sprzyjających okoliczności"
                        ],
                        "tags": [
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "84ac2944-92d7-47a5-8b6c-731a036d5639",
                                "sense_id": "59d5a699-86eb-3bcf-8c60-fd589b09da5a",
                                "text": "Sztuka, napisana z dużym humorem i wdziękiem, opowiada o perypetiach młodego szlachcica starającego się o rękę córki tytułowego dorobkiewicza, ten jednak usiłuje wydać ją za księcia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5356b348-6372-42b4-9924-97b8826f4fd9",
                        "source_entry_id": "2c6b179f-f0a6-3ea4-9591-d12e7cbd2a7a",
                        "source_sense_id": "59d5a699-86eb-3bcf-8c60-fd589b09da5a",
                        "target_lang_word": "nuevo rico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuevo rico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b74c3e-7c7f-3006-b784-54c90770cada",
                                        "entry_id": "3f1483e5-1eea-3e6c-9faa-f65684d90eba",
                                        "glosses": [
                                            "Una persona que anteriormente pertenecía a un menor extracto social, pero que recientemente logró enriquecerse y alcanzar la movilidad social, y por lo tanto no tiene el refinamiento y las costumbres características de las personas que nacieron ricas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a1ff764-2f0f-4fa7-87e1-af945bdd6117",
                        "source_entry_id": "2c6b179f-f0a6-3ea4-9591-d12e7cbd2a7a",
                        "source_sense_id": "59d5a699-86eb-3bcf-8c60-fd589b09da5a",
                        "target_lang_word": "Emporkömmling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emporkömmling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                        "entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                                        "glosses": [
                                            "jemand, der irgendwie in kurzer Zeit zu Geld und Einfluss gekommen ist, ohne bereits als dazugehörig akzeptiert zu werden"
                                        ],
                                        "tags": [
                                            "mit negativer Konnotation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee04f577-28cf-466a-8806-bafb63cbd863",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "Er ist ein kleiner Emporkömmling, der meint, er müsse seinen Reichtum jedem auf die Nase binden."
                                            },
                                            {
                                                "example_id": "86eb52f6-dd39-408f-8e8e-bd4010e42d6c",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Ein Spottname, den der Präsident, von der Höhe seines Amtes herab, den Emporkömmlingen aus der Sechs-Parteien-Allianz »Georgischer Traum« verpasst.“"
                                            },
                                            {
                                                "example_id": "de35c183-0437-416a-87ca-99e53602abce",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Der Emporkömmling musste am weiteren Aufstieg gehindert werden, und so ordnete der Stadtrat Pater Pintos Verhaftung an und ermächtigte seinen Gegenspieler Andrade, zu den Waffen zu greifen.“"
                                            },
                                            {
                                                "example_id": "822d8d10-2d34-4c6f-8f2e-50c5eb97ad37",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Es liegt auf der Hand, ein Emporkömmling muß man nicht erst werden, man kann bereits als Emporkömmling zur Welt kommen.“"
                                            },
                                            {
                                                "example_id": "d99bd79d-bb96-43f6-b978-785b857f0ee2",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Die Kerle, die in den verschiedenen Kerkern folterten, waren kleine Emporkömmlinge, die man hier und da in einem der zahlreichen Befreiungskriege aufgelesen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
