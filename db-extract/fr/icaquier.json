                "senses": [
                    {
                        "sense_id": "cdd7f91b-3fae-3805-9219-d87c8835e96e",
                        "entry_id": "f23b2706-688f-352e-9dbc-9b7c6c37fbd8",
                        "glosses": [
                            "Nom usuel de Chrysobalanus icaco, arbuste de la famille des Chrysobalanaceae, originaire des zones tropicales d’Amérique et d’Afrique. dont le fruit comestible est l’icaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249fc1f3-332f-4fd7-8259-3a7627d84b1c",
                                "sense_id": "cdd7f91b-3fae-3805-9219-d87c8835e96e",
                                "text": "L’Icaquier est un arbrisseau qui croit naturellement aux Antilles dans les endroits frais, sur les mornes humides, près des rivières et des anses qui avoisinent les rivages de la mer."
                            },
                            {
                                "example_id": "bf0f640d-6d98-4122-b240-146808935cff",
                                "sense_id": "cdd7f91b-3fae-3805-9219-d87c8835e96e",
                                "text": "Il cueille à un icaquier quelques fruits à peine mûrs, les fourre dans la légère besace nouée à sa taille."
                            },
                            {
                                "example_id": "afcd8129-342c-4581-a05e-00fdf129e097",
                                "sense_id": "cdd7f91b-3fae-3805-9219-d87c8835e96e",
                                "text": "Elle faisait le croquis des icaquiers et des pépins de corossol."
                            }
                        ]
                    }
                ],
