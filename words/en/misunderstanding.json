{
    "word_family": [
        "understand",
        "understanding",
        "misunderstand",
        "understandable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d4251e7-53c2-39ad-a70f-d94cbfc8ca5a",
                    "sense_definition": "A failure to understand something correctly; a mistake in meaning or interpretation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>misunderstanding</w> about the time of the meeting.",
                            "target_lang_translations": {
                                "ru": "Произошло <w>недоразумение</w> по поводу времени встречи.",
                                "zh": "关于会议时间，大家产生了一些<w>误会</w>。"
                            }
                        },
                        {
                            "text": "We need to talk to clear up a <w>misunderstanding</w> before it causes more problems.",
                            "target_lang_translations": {
                                "ru": "Нам нужно поговорить, чтобы разрешить <w>недоразумение</w>, пока оно не вызвало новых проблем.",
                                "zh": "我们需要谈谈以消除<w>误解</w>，以免造成更多问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misconception",
                        "confusion",
                        "mistake",
                        "error",
                        "mix-up"
                    ],
                    "antonyms": [
                        "understanding",
                        "comprehension",
                        "clarity"
                    ],
                    "common_phrases": [
                        "clear up a misunderstanding",
                        "slight misunderstanding",
                        "cause a misunderstanding",
                        "avoid misunderstanding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибка в понимании или интерпретации чего-либо; неверное толкование.",
                        "zh": "对某事物的理解或解释出现偏差；误解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоразумение",
                                "target_lang_sense_clarification": "ситуация, возникшая из-за ошибки в понимании"
                            },
                            {
                                "target_lang_word": "неправильное понимание",
                                "target_lang_sense_clarification": "процесс или факт неверного толкования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误解",
                                "target_lang_sense_clarification": "指对某人或某事理解错误"
                            },
                            {
                                "target_lang_word": "误会",
                                "target_lang_sense_clarification": "指因理解偏差而产生的错误认识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dfd327c-994b-3240-9423-c6d934aae4ec",
                    "sense_definition": "A disagreement or slight argument between people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had a <w>misunderstanding</w> over money and have not spoken since.",
                            "target_lang_translations": {
                                "ru": "У них вышла <w>размолвка</w> из-за денег, и с тех пор они не разговаривают.",
                                "zh": "他们因为钱的问题产生了<w>误会</w>，从那以后就没再说过话。"
                            }
                        },
                        {
                            "text": "Hopefully, they can resolve their <w>misunderstanding</w> and become friends again.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, они смогут разрешить свое <w>недоразумение</w> и снова стать друзьями.",
                                "zh": "希望他们能化解<w>误会</w>，重归于好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disagreement",
                        "quarrel",
                        "dispute",
                        "argument"
                    ],
                    "antonyms": [
                        "agreement",
                        "harmony",
                        "accord"
                    ],
                    "common_phrases": [
                        "have a misunderstanding",
                        "resolve a misunderstanding",
                        "serious misunderstanding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разногласие или небольшая ссора между людьми.",
                        "zh": "人与人之间产生的分歧或小争执。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоразумение",
                                "target_lang_sense_clarification": "в значении легкой ссоры или конфликта"
                            },
                            {
                                "target_lang_word": "размолвка",
                                "target_lang_sense_clarification": "небольшая ссора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误会",
                                "target_lang_sense_clarification": "指人际交往中因沟通不畅产生的隔阂"
                            },
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "指意见不一致导致的争论"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "864254c4-4f5e-3c3a-96f1-fcfdee8c1637",
                    "sense_definition": "Present participle and gerund of <w>misunderstand</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is constantly <w>misunderstanding</w> my simple instructions.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>неправильно понимает</w> мои простые инструкции.",
                                "zh": "他总是<w>误解</w>我简单的指示。"
                            }
                        },
                        {
                            "text": "<w>Misunderstanding</w> the question led him to give the wrong answer.",
                            "target_lang_translations": {
                                "ru": "<w>Неправильное понимание</w> вопроса привело к тому, что он дал неверный ответ.",
                                "zh": "对问题的<w>误解</w>导致他给出了错误的答案。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола misunderstand (неправильно понимать).",
                        "zh": "动词 misunderstand 的现在分词或动名词形式，意为理解错误。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправильное понимание",
                                "target_lang_sense_clarification": "герундий"
                            },
                            {
                                "target_lang_word": "неправильно понимая",
                                "target_lang_sense_clarification": "деепричастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误解",
                                "target_lang_sense_clarification": "作为动名词使用"
                            },
                            {
                                "target_lang_word": "理解错误",
                                "target_lang_sense_clarification": "描述理解过程中的偏差"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}