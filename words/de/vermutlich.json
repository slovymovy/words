                    "sense_id": "ce8e0234-e3d1-34a8-bfaf-3870908b5fd4",
                    "sense_definition": "wie man annehmen kann; aller Wahrscheinlichkeit nach",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wahrscheinlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Morgen wird es <w>vermutlich</w> den ganzen Tag regnen.",
                            "target_lang_translations": {
                                "en": "Tomorrow it will <w>probably</w> rain all day.",
                                "ru": "Завтра, <w>вероятно</w>, целый день будет идти дождь.",
                                "nl": "Morgen zal het <w>vermoedelijk</w> de hele dag regenen.",
                                "pl": "Jutro <w>prawdopodobnie</w> będzie padać przez cały dzień.",
                                "fr": "Demain, il va <w>probablement</w> pleuvoir toute la journée.",
                                "it": "Domani <w>probabilmente</w> pioverà tutto il giorno.",
                                "cs": "Zítra bude <w>pravděpodobně</w> pršet celý den.",
                                "tr": "Yarın <w>muhtemelen</w> bütün gün yağmur yağacak.",
                                "es": "Mañana <w>probablemente</w> lloverá todo el día.",
                                "zh": "明天<w>大概</w>会下一整天的雨。"
                            }
                        },
                        {
                            "text": "Er hat seinen Schlüssel <w>vermutlich</w> im Büro vergessen.",
                            "target_lang_translations": {
                                "en": "He <w>probably</w> forgot his key at the office.",
                                "ru": "Он, <w>по-видимому</w>, забыл свой ключ в офисе.",
                                "nl": "Hij is zijn sleutel <w>vermoedelijk</w> op kantoor vergeten.",
                                "pl": "<w>Prawdopodobnie</w> zapomniał klucza w biurze.",
                                "fr": "Il a <w>sans doute</w> oublié sa clé au bureau.",
                                "it": "Ha <w>probabilmente</w> dimenticato la chiave in ufficio.",
                                "cs": "<w>Pravděpodobně</w> si zapomněl klíč v kanceláři.",
                                "tr": "Anahtarını <w>büyük ihtimalle</w> ofiste unuttu.",
                                "es": "<w>Probablemente</w> olvidó su llave en la oficina.",
                                "zh": "他<w>大概</w>把钥匙忘在办公室了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wahrscheinlich"
                    ],
                    "antonyms": [
