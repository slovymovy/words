                    {
                        "translation_id": "0d057b6f-ddd9-4775-8bc6-7ec49c273d8c",
                        "source_entry_id": "e086392c-23b8-3ddb-ba7b-36937cfcfd89",
                        "source_sense_id": "071673d9-b23e-3458-910a-354f8ba05301",
                        "source_sense_description": "railroad freight car without sides and roof",
                        "target_lang_word": "ваго́н-платфо́рма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ваго́н-платфо́рма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e65087e9-fdfe-3887-bc6f-746b488e8de0",
                                        "entry_id": "a2b4c825-e183-3a6d-9e61-848aae4f11b2",
                                        "glosses": [
                                            "товарный вагон открытого типа для перевозки навалочных грузов, а также предметов, не боящихся дождя, снега и пыли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e0ceb8-0183-451c-aaa0-3779360a7f07",
                                                "sense_id": "e65087e9-fdfe-3887-bc6f-746b488e8de0",
                                                "text": "На вагон-платформу помещают 40-50 ульев в 1 ярус, иногда же ставят на платформу до 100 ульев в 2 яруса."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e3c33cb-26b8-4189-b3c0-68060015c850",
                        "source_entry_id": "e086392c-23b8-3ddb-ba7b-36937cfcfd89",
                        "source_sense_id": "071673d9-b23e-3458-910a-354f8ba05301",
                        "source_sense_description": "railroad freight car without sides and roof",
                        "target_lang_word": "платфо́рма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "платфо́рма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c91f87ab-f83e-3d4b-9209-9225ada2e794",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "возвышенная площадка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5306b3-bd4b-42aa-a40a-da85ced70e8c",
                                                "sense_id": "c91f87ab-f83e-3d4b-9209-9225ada2e794",
                                                "text": "Прямо перед нами трон, он возвышается на платформе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c597ac3-e08c-37bf-b936-be379879cbe4",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "трансп. специально оборудованная на маршруте транспортного средства площадка для посадки-высадки пассажиров; перрон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2ba8cb-1a13-4dc9-b38e-a57820c0ba85",
                                                "sense_id": "4c597ac3-e08c-37bf-b936-be379879cbe4",
                                                "text": "Ветер как будто только ждал её, радостно засвистал и хотел подхватить и унести её, но она сильной рукой взялась за холодный столбик и, придерживая платье, спустилась на платформу и зашла за вагон."
                                            },
                                            {
                                                "example_id": "cd43a149-16ad-4b79-90b6-ec08269aaee9",
                                                "sense_id": "4c597ac3-e08c-37bf-b936-be379879cbe4",
                                                "text": "Он засмеялся и поставил чемодан на платформу."
                                            },
                                            {
                                                "example_id": "6ab756b0-d320-4483-a44e-ada1061dc3c1",
                                                "sense_id": "4c597ac3-e08c-37bf-b936-be379879cbe4",
                                                "text": "На платформе — никого, кроме негров-носильщиков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4acac62e-6187-3f9c-b161-16bc938f776e",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "ж.-д. небольшой остановочный пункт, из инфраструктуры имеющий только платформу [2] — без вокзала и боковых путей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720d6acd-ad73-4647-bf9a-f2aca138c4d2",
                                                "sense_id": "4acac62e-6187-3f9c-b161-16bc938f776e",
                                                "text": "Вдали показались три огненные глаза. На платформу вышел начальник полустанка. На рельсах там и сям замелькали сигнальные огни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a386d1a8-1706-3ffa-ad8e-355116caa10c",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "трансп. вагон, прицеп, полуприцеп или часть кузова с плоской горизонтальной площадкой без борто́в или снабжённый бортами для перевозки крупных штучных грузов, а также длинномерных грузов наподобие рельсов или брёвен"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42fd8976-6dc2-4d98-9549-1f93febc7705",
                                                "sense_id": "a386d1a8-1706-3ffa-ad8e-355116caa10c",
                                                "text": "Солдаты разводили костры, чтобы обжигать стальную проволоку, ею закрепляли технику на платформах."
                                            },
                                            {
                                                "example_id": "a7820a84-6839-4bbd-97d8-610d975171c5",
                                                "sense_id": "a386d1a8-1706-3ffa-ad8e-355116caa10c",
                                                "text": "За ней проехал огромный семитрейлер с серией новеньких машин на платформе."
                                            },
                                            {
                                                "example_id": "5e36c7db-4813-450f-a340-dae1f973355f",
                                                "sense_id": "a386d1a8-1706-3ffa-ad8e-355116caa10c",
                                                "text": "Рядом, за кустами, снова забрехали псы, казалось, никуда от них не спастись, когда вновь прогудела «кукушка» и выскочил из-за поворота паровозик с тремя открытыми платформами, на платформах скученно сидели люди."
                                            },
                                            {
                                                "example_id": "517b3e8c-d68b-435b-9610-d3c763e57363",
                                                "sense_id": "a386d1a8-1706-3ffa-ad8e-355116caa10c",
                                                "text": "Нам на тест достались платформа под тентом и панельный фургон полностью отечественного производства, а также собранная у нас из корейских комплектующих бортовая платформа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61b0aaee-d078-318d-a0d3-05e8c181171d",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "техн. общий набор агрегатов, конструкторских и технологических решений, на основе которого делаются различные типы автомобилей и других механизмов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7061d7a7-3b2b-4565-bc2e-718a3d8735f9",
                                                "sense_id": "61b0aaee-d078-318d-a0d3-05e8c181171d",
                                                "text": "Испанский компактный вэн «СЕАТ-Альтеа» построен на платформе «Ауди-А3» и должен угодить тем, кого привлекает сочетание спортивного стиля, динамичности и практичности."
                                            },
                                            {
                                                "example_id": "025e1c4e-dcb8-4154-8b10-d9ef0dc7546b",
                                                "sense_id": "61b0aaee-d078-318d-a0d3-05e8c181171d",
                                                "text": "Ведь у автомобилей, построенных на платформе «Фольксвагена-Гольф IV», всегда было тесновато на заднем сиденье."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4001275a-e686-3083-8640-cdeb1bea17c3",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "комп. совокупность технологий и спецификаций, обеспечивающая аппаратную и/или программную совместимость различных продуктов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6bd738-6456-4e41-b7c5-651f344ce40e",
                                                "sense_id": "4001275a-e686-3083-8640-cdeb1bea17c3",
                                                "text": "Клиентские рабочие места организованы на базе современных рабочих станций на платформе Intel."
                                            },
                                            {
                                                "example_id": "2a1b6f98-93c6-437f-ac90-9a62bb22b998",
                                                "sense_id": "4001275a-e686-3083-8640-cdeb1bea17c3",
                                                "text": "Телефон является флагманским решением компании на платформе Windows Phone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e028bf44-71ec-3b25-9a26-1e7ec222456c",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "геол. устойчивый блок континентальной земной коры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f629f9c6-bc9b-4bf6-bc1d-eeafdfde13d1",
                                                "sense_id": "e028bf44-71ec-3b25-9a26-1e7ec222456c",
                                                "text": "Формирование основного по мощности палеозойского комплекса осадочного чехла приходится на этап развития древней платформы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83b6221a-cb56-3430-8ca9-355e705705dc",
                                        "entry_id": "947ac7b4-c8e2-3653-9d3a-8dd5b8497b49",
                                        "glosses": [
                                            "толстая подошва обуви"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36d7092-ef78-4664-b2c5-3defe551f0f2",
                                                "sense_id": "83b6221a-cb56-3430-8ca9-355e705705dc",
                                                "text": "Потом я уже всё вместе на себя не надевал, а потихоньку стал внедрять, то штаны в клетку, то туфли на «платформе»."
                                            },
                                            {
                                                "example_id": "02da04ad-d7c7-4361-a872-617ac32de416",
                                                "sense_id": "83b6221a-cb56-3430-8ca9-355e705705dc",
                                                "text": "Теперь в почёте длинные волосы и туфли на платформе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
