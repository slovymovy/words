                ],
                "senses": [
                    {
                        "sense_id": "4c1aca5e-0aa1-3d43-975d-0f5269731dbb",
                        "entry_id": "6cc34b86-1b70-32f3-9561-01f1c51c1fb1",
                        "glosses": [
                            "тяжёлое время, пора невзгод"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c855df39-dd66-40ae-9fe4-74e005883b9f",
                                "sense_id": "4c1aca5e-0aa1-3d43-975d-0f5269731dbb",
                                "text": "Я не знаю ни имен их, ни судьбы: всех разметало по лицу земли, многих погубило русское безвременье."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac092723-3b02-397d-95dc-05334f5e925b",
                        "entry_id": "6cc34b86-1b70-32f3-9561-01f1c51c1fb1",
                        "glosses": [
                            "период общественного и культурного застоя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00e7fd9-ebae-4198-aac3-3dd0b60eeccf",
                                "sense_id": "ac092723-3b02-397d-95dc-05334f5e925b",
                                "text": "Культурная деятельность топталась на одном месте, как белка в колесе. На всем была печать безвременья."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2f75cd1-a997-3e5c-ab63-e411d1c35809",
                        "entry_id": "6cc34b86-1b70-32f3-9561-01f1c51c1fb1",
                        "glosses": [
                            "разг. период смены времен года"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84146fb6-ef3c-40c3-af1f-3b9576ee43b9",
                                "sense_id": "f2f75cd1-a997-3e5c-ab63-e411d1c35809",
                                "text": "В темноте и в холоде комнаты Оленю казалось, что это не люлька, а лодка на реке, осенью, в безвременье, а он ― старый и усталый лодочник."
                            },
                            {
                                "example_id": "2460a401-ebc5-4f62-b2d7-e21948fbfe76",
                                "sense_id": "f2f75cd1-a997-3e5c-ab63-e411d1c35809",
                                "text": "А пока безвременье продолжалось, и хотя зима уже сваливала потихоньку на весну, морозы все еще были сильны."
                            }
                        ]
                    }
                ],
