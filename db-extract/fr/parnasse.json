                    {
                        "sense_id": "79d0ae97-6700-3826-bcbe-6d54c80681b6",
                        "entry_id": "40240ef0-7678-3678-9822-fafff60e2d3b",
                        "glosses": [
                            "Montagne du centre de la Grèce qui surplombe la cité de Delphes."
                        ],
