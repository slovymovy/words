{
    "word_family": [
        "lend",
        "lending",
        "loan"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                    "sense_definition": "A person or organization, such as a bank, that provides money to others on the condition that it will be paid back.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lender</w> approved the mortgage application after reviewing the credit history.",
                            "target_lang_translations": {
                                "ru": "<w>Кредитор</w> одобрил заявку на ипотеку после проверки кредитной истории."
                            }
                        },
                        {
                            "text": "It is important to compare interest rates from every potential <w>lender</w> before signing a contract.",
                            "target_lang_translations": {
                                "ru": "Важно сравнить процентные ставки каждого потенциального <w>кредитора</w> перед подписанием контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "loaner"
                    ],
                    "antonyms": [
                        "borrower"
                    ],
                    "common_phrases": [
                        "private lender",
                        "mortgage lender",
                        "money lender"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или организация (например, банк), предоставляющие денежные средства в долг на условиях их возврата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кредитор",
                                "target_lang_sense_clarification": "официальный термин для банка или лица, выдающего кредит"
                            },
                            {
                                "target_lang_word": "заимодавец",
                                "target_lang_sense_clarification": "юридический термин для стороны, предоставляющей заём"
                            },
                            {
                                "target_lang_word": "ссудодатель",
                                "target_lang_sense_clarification": "лицо, предоставляющее ссуду"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9b6b3afa-8851-31f4-bff8-2d7ac312ab49",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Lender</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Лендер</w>, которая пожертвовала землю."
                            }
                        },
                        {
                            "text": "Professor <w>Lender</w> published several papers on historical linguistics during his career.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Лендер</w> за свою карьеру опубликовал несколько работ по исторической лингвистике."
                            }
                        }
                    ],
                    "traits": [
