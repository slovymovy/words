                                    },
                                    {
                                        "sense_id": "1dd8de90-998f-330b-9cca-efcda71a7fee",
                                        "entry_id": "d27d1de7-8f96-368d-8475-ad31e5de4c5b",
                                        "glosses": [
                                            "To put into a chapter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8963032-a42f-3f53-bf51-4f65565ff906",
                                        "entry_id": "d27d1de7-8f96-368d-8475-ad31e5de4c5b",
                                        "glosses": [
                                            "To use administrative procedure to remove someone."
                                        ],
                                        "tags": [
                                            "with \\\"out\\"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96051d05-2c0e-4aff-a6ca-e5da6ba6ace0",
                                                "sense_id": "a8963032-a42f-3f53-bf51-4f65565ff906",
                                                "text": "If you're a single parent [soldier] and you can't find someone to take care of your children, they will chapter you out [administrative elimination from the service]. And yet if you use someone not certified, they get mad."
                                            },
                                            {
                                                "example_id": "b94b1b7b-3f1f-45c0-b8c3-cb8be1fd3b58",
                                                "sense_id": "a8963032-a42f-3f53-bf51-4f65565ff906",
                                                "text": "\"He also wanted me to give you a message. He said that if you don't get your shit ready for this deployment, then he will chapter you out of his freakin' army.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1805212-4583-30ee-a967-2b3e41a7fd17",
                                        "entry_id": "d27d1de7-8f96-368d-8475-ad31e5de4c5b",
                                        "glosses": [
                                            "To take to task."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7d93445-c72f-4de5-ace4-9b4307386e68",
                        "source_entry_id": "92a868b2-0370-3701-bce6-a265a2a44d60",
                        "source_sense_id": "914e164d-bfcc-374f-9ec3-c49c20ccdbe1",
                        "target_lang_word": "chapitre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapitre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abc4499e-f79b-309f-a33d-5461b2cfc062",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Division"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3618e960-86f3-3a0a-883d-3d0549acf903",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Division",
                                            "D’un livre, d’un traité, d’un récit, destinée à le structurer ou à en faciliter la lecture."
                                        ],
                                        "tags": [
                                            "Livre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c8d4051-13e9-4a9e-868f-788c2f73e15e",
                                                "sense_id": "3618e960-86f3-3a0a-883d-3d0549acf903",
                                                "text": "Il nous a semblé superflu, au début de ce chapitre, de rappeler la terminologie employée par l’École zuricho-montpelliéraine, […]."
                                            },
                                            {
                                                "example_id": "e9ea26d9-9836-47fd-ad2a-fb7aef8ca169",
                                                "sense_id": "3618e960-86f3-3a0a-883d-3d0549acf903",
                                                "text": "Ce faisant, et en guise d’introduction aux chapitres suivants, j’essaie de cerner davantage la problématique du masque, telle qu’elle se présente dans les premières comédies de Molière."
                                            },
                                            {
                                                "example_id": "688c108a-1e44-4d39-8a82-cd39dcef021d",
                                                "sense_id": "3618e960-86f3-3a0a-883d-3d0549acf903",
                                                "text": "On pense que les herbicides solubles dans l’eau tels que l’aminotriazole, le diquat, le paraquat, le difenzoquat, le glufosinate et le glyphosate pénètrent dans les organes aériens des végétaux, empruntant la voie aqueuse dont il a été question au chapitre I."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb8930d-de1e-3b31-907f-89e4db76b01b",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Division",
                                            "Divisions d’un code, d’une loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d115e53a-785d-4844-9c1b-d17f09169922",
                                                "sense_id": "2bb8930d-de1e-3b31-907f-89e4db76b01b",
                                                "text": "Le code est divisé en titres et les titres en chapitres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4099d01-e850-38ea-8abe-958eae36b359",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Division",
                                            "Division de compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5658c29d-f6e9-46fb-b53a-aacdeedae612",
                                                "sense_id": "f4099d01-e850-38ea-8abe-958eae36b359",
                                                "text": "Le budget est divisé par chapitres. - Chapitres de recettes. - Chapitres de dépenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e34be2c4-cb0f-3859-8ec5-84d79cd362fb",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Division",
                                            "(parfois) Division d’une organisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9e51ed7-2011-3a2d-b983-54b51e859d67",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Matière, sujet dont on parle, propos sur lequel on est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff05289-2fa9-4255-bb92-e8dca98026cb",
                                                "sense_id": "e9e51ed7-2011-3a2d-b983-54b51e859d67",
                                                "text": "Puisque nous sommes sur ce chapitre, je vous dirai que… - On en était sur votre chapitre, on parlait de vous. - La conversation tomba insensiblement sur le chapitre de ces gens-là."
                                            },
                                            {
                                                "example_id": "acfe0b7a-cb7a-4eee-99c2-4d114e08cdd7",
                                                "sense_id": "e9e51ed7-2011-3a2d-b983-54b51e859d67",
                                                "text": "Lucienne. — Assez, monsieur ! assez, sur ce chapitre !"
                                            },
                                            {
                                                "example_id": "d2bae70b-2325-4922-9ee6-77df48a834c6",
                                                "sense_id": "e9e51ed7-2011-3a2d-b983-54b51e859d67",
                                                "text": "Il n’avait fait jusque-là que de petites dettes. Mais il avait une fausse réputation à soutenir et il n’avait pas voulu être en reste avec sa femme sur le chapitre des dépenses. Ils avaient donc si bien fait l’un et l’autre qu’ils étaient vite arrivés à une sorte de gêne. Et cela n’avait pas peu ajouté à leurs autres difficultés."
                                            },
                                            {
                                                "example_id": "bd86ca57-317d-484d-b785-7a98aa385f24",
                                                "sense_id": "e9e51ed7-2011-3a2d-b983-54b51e859d67",
                                                "text": "« Vos idées sont intéressantes et je vois que vous ne badinez pas sur le chapitre de la morale. »"
                                            },
                                            {
                                                "example_id": "06bc71a7-883e-4f26-b01e-afb9c2a0eb3e",
                                                "sense_id": "e9e51ed7-2011-3a2d-b983-54b51e859d67",
                                                "text": "Le père avait toujours été ferme sur ce chapitre, acceptant d’être montré du doigt, bien que respecté, avec ses douze chevaux et ses blés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82479af9-9e4c-3883-9b46-dba6e830074a",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Assemblée locale que les chanoines, les religieux (par exemple les chanoines d’une cathédrale, les moines d’une abbaye) tiennent pour traiter de leurs affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aae6a77-fa13-420f-a61d-53876e9705be",
                                                "sense_id": "82479af9-9e4c-3883-9b46-dba6e830074a",
                                                "text": "Le comte de Toulouse Raimond V, conscient de ces enjeux, écrivit en 1177 au chapitre général de Cîteaux pour dénoncer l’hérésie qui sévissait sur ses terres, mais surtout sur celles de ses principaux vassaux, et pour en appeler à l’aide du roi."
                                            },
                                            {
                                                "example_id": "e1ae8d3e-f539-49b6-b1fc-8d68e8535995",
                                                "sense_id": "82479af9-9e4c-3883-9b46-dba6e830074a",
                                                "text": "Quant au chapitre même de Chartres, il aurait été fondé au VIᵉ siècle, par saint Lubin. Il était alors composé de soixante-douze chanoines et le nombre s’accrut encore, […]."
                                            },
                                            {
                                                "example_id": "a3a4a6d5-55c2-49ec-a5c9-6ee222c4a0e9",
                                                "sense_id": "82479af9-9e4c-3883-9b46-dba6e830074a",
                                                "text": "L’abbé a renouvelé maintes fois ses supplications, pour que le chapitre de Notre Dame, en considération des immenses travaux qu’il se voit forcé d’entreprendre, affranchisse le monastère des dîmes qu’il paie sur les biens que nous venons de mentionner: […]."
                                            },
                                            {
                                                "example_id": "77210a8e-6db3-4c59-9314-6763ba58b995",
                                                "sense_id": "82479af9-9e4c-3883-9b46-dba6e830074a",
                                                "text": "Ce que nous disons, Sire, n’est pas une hyperbole, ni un discours cérébrin ; nous l’avons vu, en l’année 1612, au chapitre général des jacobins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20a5fcf-153e-3579-9547-e360613c5382",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Membre de cette assemblée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75afef00-e5f1-4df1-b5ab-90e1304ea3d4",
                                                "sense_id": "c20a5fcf-153e-3579-9547-e360613c5382",
                                                "text": "Tous les chapitres de ton ordre apprendront que, comme un hérétique, tu as péché avec une juive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cb227b5-997d-3a7a-ba39-3085c521e866",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Lieu où se tient cette assemblée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9547841-1c2c-3911-9b02-d106199303c7",
                                        "entry_id": "768bc302-366e-33ee-8049-56aa944ad943",
                                        "glosses": [
                                            "Assemblée pendant laquelle on délibère comme par exemple l’assemblée d’un ordre royal ou militaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
