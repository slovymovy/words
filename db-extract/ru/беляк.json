                "senses": [
                    {
                        "sense_id": "f0fc5a14-d841-31c2-8848-94480e705b02",
                        "entry_id": "1df9b4b2-19cb-305a-be37-045540999219",
                        "glosses": [
                            "зоол. вид зайца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553bf008-e67b-4248-81f3-f0a195a031f7",
                                "sense_id": "f0fc5a14-d841-31c2-8848-94480e705b02",
                                "text": "На белом цвете основана охота на беляков «в узёрку», производимая по черностопу, т. е. пока ещё не выпал снег."
                            }
                        ]
                    },
                    {
                        "sense_id": "1efe9c20-a24d-36f1-8858-621b9c83057d",
                        "entry_id": "1df9b4b2-19cb-305a-be37-045540999219",
                        "glosses": [
                            "истор. военнослужащий какой-либо из армий Белого движения во время гражданской войны в России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faec726f-73b5-4b0f-b50b-fcee83cedf3a",
                                "sense_id": "1efe9c20-a24d-36f1-8858-621b9c83057d",
                                "text": "Красных было не слыхать, беляки заглядывали в Сараны редко ― боялись заразы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "798c80d1-ab20-43d0-a7f1-ba5d9e218fcd",
                        "source_entry_id": "1df9b4b2-19cb-305a-be37-045540999219",
                        "source_sense_description": "заяц",
                        "target_lang_word": "mountain hare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mountain hare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40563f5d-e3e1-3150-8c46-6b412b9a73ef",
                                        "entry_id": "c1808ef7-5c13-384a-8e36-01549c8d7693",
                                        "glosses": [
                                            "A Eurasian hare of species Lepus timidus, found mainly in tundra regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f86f84-9ba7-4466-966a-e0698c822d14",
                                                "sense_id": "40563f5d-e3e1-3150-8c46-6b412b9a73ef",
                                                "text": "Mountain hares reproduce quickly, with each female having three litters of two or three pups between February and September."
                                            },
                                            {
                                                "example_id": "906c412a-2735-4c5f-b61d-af4b9d6d5e13",
                                                "sense_id": "40563f5d-e3e1-3150-8c46-6b412b9a73ef",
                                                "text": "The new livery features the native mountain hare and its predator the eagle, reflecting the wildlife of the mountain most known for their speed and agility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b50e0bb-5181-3e12-8809-863e205e284e",
                                        "entry_id": "c1808ef7-5c13-384a-8e36-01549c8d7693",
                                        "glosses": [
                                            "Any of various hares found in mountainous country, especially a snowshoe hare (Lepus americanus) or a white-tailed jackrabbit (Lepus townsendi)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
