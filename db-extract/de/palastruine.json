                "senses": [
                    {
                        "sense_id": "82cead77-ddc1-31e1-953b-3d71de6cc925",
                        "entry_id": "e49f7c41-1880-33be-9270-8927e2323e2f",
                        "glosses": [
                            "teilweise eingestürzter, verfallener oder zerstörter Palast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27ba02c1-ef4e-41f0-9a90-459c390fad21",
                                "sense_id": "82cead77-ddc1-31e1-953b-3d71de6cc925",
                                "text": "„Zwei lächelnde, kurvenreiche Mädchen in roten Miniröcken, beide kaum älter als achtzehn, tanzten auf den Bögen einer weinüberwachsenen Palastruine.“"
                            },
                            {
                                "example_id": "190514e3-dbd8-44cc-b77a-a342b229902b",
                                "sense_id": "82cead77-ddc1-31e1-953b-3d71de6cc925",
                                "text": "„Auch die materiellen Hinterlassenschaften längst verschollener Einwohner, vor allem die Pyramiden in Teōtihuahcān, die sie als Kultstätten nutzten, und die Palastruinen in Tōllān, der Hauptstadt der Tolteken, nötigten ihnen große Bewunderung ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
