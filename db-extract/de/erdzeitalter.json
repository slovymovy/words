                "senses": [
                    {
                        "sense_id": "94a8a02d-616e-3558-971f-6ac63146bf11",
                        "entry_id": "c4a07ee5-b852-348f-b1e1-7764c028c731",
                        "glosses": [
                            "Untereinheiten der Äonen, also Zeitabschnitte von vielen Jahrmillionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2947b2e1-9562-4042-8034-17151394894e",
                                "sense_id": "94a8a02d-616e-3558-971f-6ac63146bf11",
                                "text": "Die Erdzeitalter sind in Perioden unterteilt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d551d7b5-3ffd-43a5-a6d1-6890233e2a34",
                        "source_entry_id": "c4a07ee5-b852-348f-b1e1-7764c028c731",
                        "source_sense_id": "94a8a02d-616e-3558-971f-6ac63146bf11",
                        "source_sense_description": "Geologie: Untereinheiten der Äonen, also Zeitabschnitte von vielen Jahrmillionen",
                        "target_lang_word": "era",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "era",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c0472d-4018-3a6f-96bc-950f8f3dcf61",
                                        "entry_id": "9ad962b0-b112-36e9-9b57-4946a4906f5a",
                                        "glosses": [
                                            "A time period of indeterminate length, generally more than one year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2533f0e6-3906-4548-a113-1222e8afb192",
                                                "sense_id": "d1c0472d-4018-3a6f-96bc-950f8f3dcf61",
                                                "text": "Even in an era when individuality in dress is a cult, his clothes were noticeable. He was wearing a hard hat of the low round kind favoured by hunting men, and with it a black duffle-coat lined with white."
                                            },
                                            {
                                                "example_id": "873e9f51-a55e-4716-93e7-0ea9a1c9036c",
                                                "sense_id": "d1c0472d-4018-3a6f-96bc-950f8f3dcf61",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89a34ef1-2399-3aa3-977f-7e6c330bb566",
                                        "entry_id": "9ad962b0-b112-36e9-9b57-4946a4906f5a",
                                        "glosses": [
                                            "A geochronologic unit of tens to hundreds of millions of years; a subdivision of an eon, and subdivided into periods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9bc339b-cd1f-3c35-8c44-6409153fa3c9",
                                        "entry_id": "9ad962b0-b112-36e9-9b57-4946a4906f5a",
                                        "glosses": [
                                            "An indefinite period of time in one’s life characterized by a particular interest."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b14a4d64-23cb-4f3b-8ee4-8ebc1ec567f0",
                        "source_entry_id": "c4a07ee5-b852-348f-b1e1-7764c028c731",
                        "source_sense_id": "94a8a02d-616e-3558-971f-6ac63146bf11",
                        "source_sense_description": "Geologie: Untereinheiten der Äonen, also Zeitabschnitte von vielen Jahrmillionen",
                        "target_lang_word": "ère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9053d881-c627-3de2-bc4e-89128aba415e",
                                        "entry_id": "3333820c-2b9e-3142-9ba7-a575c8caf96f",
                                        "glosses": [
                                            "Point fixe d’où l’on commence à compter les années."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d84562c-c6a9-4ee6-bcf7-8be041cd8c92",
                                                "sense_id": "9053d881-c627-3de2-bc4e-89128aba415e",
                                                "text": "Voulant que tout datât de la Révolution, la Convention avait institué une ère nouvelle. L'an premier dut commencer le 22 septembre 1792, jour de proclamation de la République."
                                            },
                                            {
                                                "example_id": "edc03041-ff0d-4313-a243-62fcd141988b",
                                                "sense_id": "9053d881-c627-3de2-bc4e-89128aba415e",
                                                "text": "C'est vers le milieu du XIᵉ siècle que parait avoir été établie la première exploitation de la houille dans les environs de Newcastle en Angleterre, du moins en ce qui concerne l'Europe, car, d'après les récits des missionnaires, les Chinois se seraient servis de ce combustible bien avant notre ère."
                                            },
                                            {
                                                "example_id": "ec5c4a57-9ad1-4354-9439-d0d779213e56",
                                                "sense_id": "9053d881-c627-3de2-bc4e-89128aba415e",
                                                "text": "Selon une légende qui a longtemps eu cours dans le Midi, des Hébreux seraient venus se fixer à Narbonne au temps du roi David, soit au XIᵉ siècle avant l'ère chrétienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3619b6f6-4061-3126-aeec-250adc543c65",
                                        "entry_id": "3333820c-2b9e-3142-9ba7-a575c8caf96f",
                                        "glosses": [
                                            "Époque très remarquable où un nouvel ordre de choses s’établit, commence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ced86d0-64be-4ca2-bee4-e5448f36ab86",
                                                "sense_id": "3619b6f6-4061-3126-aeec-250adc543c65",
                                                "text": "Le 4 février 2022, un nouveau modèle démocratique mondial pour le XXIe siècle est né. Conçu pour « une nouvelle ère », il prône le développement durable pour la planète, le dialogue, la justice, la liberté, l’égalité, la confiance mutuelle."
                                            },
                                            {
                                                "example_id": "9c026c52-8868-483c-bb67-c8c77d0d48e0",
                                                "sense_id": "3619b6f6-4061-3126-aeec-250adc543c65",
                                                "text": "Étrange préoccupation dont l'honneur ou le blâme appartient à l’ère si improprement appelée Renaissance, et que, pour notre part, et pour diverses raisons, nous nommerions volontiers l’ère rétrograde."
                                            },
                                            {
                                                "example_id": "188c8b85-36ce-4ae8-9ab5-7e2770ed8038",
                                                "sense_id": "3619b6f6-4061-3126-aeec-250adc543c65",
                                                "text": "Marx comparait le changement d’ère historique à une succession civile ; les temps nouveaux héritent des acquisitions antérieures."
                                            },
                                            {
                                                "example_id": "2ec6c875-e5e8-402d-aef4-6ee2d03783f5",
                                                "sense_id": "3619b6f6-4061-3126-aeec-250adc543c65",
                                                "text": "L’Australie entre dans l’ère des autoroutes intelligentes"
                                            },
                                            {
                                                "example_id": "33e87fd9-787e-40b3-ad99-23b3edc073f4",
                                                "sense_id": "3619b6f6-4061-3126-aeec-250adc543c65",
                                                "text": "Quand le monde apprend que les Soviétiques ont lancé, le 4 octobre 1957, un satellite artificiel de la Terre, c'est l’étonnement et l’admiration chez beaucoup, qui prennent conscience que l’ère spatiale commence vraiment, et c’est la panique chez les Américains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc98f96-ef39-3651-ae8b-f18c04d0ab55",
                                        "entry_id": "3333820c-2b9e-3142-9ba7-a575c8caf96f",
                                        "glosses": [
                                            "Subdivision, seconde par durée après l'éon, de l'échelle des temps géologiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "423dae3d-c860-4146-a48b-b2e8b4ee2fa5",
