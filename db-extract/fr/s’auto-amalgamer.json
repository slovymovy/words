                "senses": [
                    {
                        "sense_id": "43edf159-2a57-3e34-87b4-579ed7777d42",
                        "entry_id": "c1488209-e4c3-3c1a-8f97-52cdaffbb5b2",
                        "glosses": [
                            "S’amalgamer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e32a05b-54c8-4069-a479-93f314e1caa5",
                                "sense_id": "43edf159-2a57-3e34-87b4-579ed7777d42",
                                "text": "Porte-diapositve selon la revendication 7, où le joint étanche (1) comprend, sur les surfaces internes de l'ouverture, une bande pouvant s'auto-amalgamer."
                            },
                            {
                                "example_id": "de506e6b-b5ce-49ea-9823-7a05ecc1eb17",
                                "sense_id": "43edf159-2a57-3e34-87b4-579ed7777d42",
                                "text": "Dans la plupart des cas, il s'auto-amalgame en quelques secondes et établit une fusion permanente en 1 ou 2 minutes."
                            },
                            {
                                "example_id": "74ecaaf8-3c4b-4bfa-b215-3c342e303c5a",
                                "sense_id": "43edf159-2a57-3e34-87b4-579ed7777d42",
                                "text": "Rapide et facile à utiliser, s'auto-amalgame, pas besoin d'adhésifs ni chaleur ni produits chimiques."
                            }
                        ]
                    }
