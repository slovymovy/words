                                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                                "text": "Persister dans la désobéissance."
                                            },
                                            {
                                                "example_id": "2f43cfb9-4317-43e6-b19e-1cf2ffba8a52",
                                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                                "text": "Acte de désobéissance."
                                            },
                                            {
                                                "example_id": "ed0281e6-4727-4df8-87a9-8af6d86c3535",
                                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                                "text": "Tant que la désobéissance est couronnée de succès, je préfère la considérer comme de l'initiative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ef6d00-4c43-3bb0-97ad-9acba6a7e79f",
                                        "entry_id": "70bfe010-f7d0-3838-8598-1bda8ddf853e",
                                        "glosses": [
