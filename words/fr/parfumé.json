                    "sense_id": "72a1a3a4-2387-3905-a683-9f0eecc64fcf",
                    "sense_definition": "Qui a une odeur agréable ou qui est imprégné de parfum.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai allumé une bougie <w>parfumée</w> à la vanille dans le salon.",
                            "target_lang_translations": {
                                "en": "I lit a candle <w>scented</w> with vanilla in the living room.",
                                "ru": "В гостиной зажгли <w>ароматическую</w> свечу с ванилью.",
                                "de": "Ich habe im Wohnzimmer eine <w>duftende</w> Vanillekerze angezündet.",
                                "es": "He encendido una vela <w>perfumada</w> de vainilla en el salón.",
                                "zh": "我在客厅里点了一支<w>芳香</w>的香草蜡烛。"
                            }
                        },
                        {
                            "text": "Ce thé vert très <w>parfumé</w> dégage des notes subtiles de jasmin.",
                            "target_lang_translations": {
