                    {
                        "form_id": "befc8ec5-9475-4115-afaa-5cdfa4cc42a7",
                        "entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "chronologischers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                        "entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                        "glosses": [
                            "naar tijdstip gerangschikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a757f7-6c2d-42b6-996c-fba8088354c2",
                                "sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                                "text": "We hebben ons niet strikt aan de chronologische volgorde gehouden."
                            },
                            {
                                "example_id": "0864b2ac-a3e4-45ff-bffe-575e0b4a9ac4",
                                "sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                                "text": "Er werkten veel en uiteenlopende Rubensspecialisten mee, meer dan aan bijvoorbeeld het Rembrandt Research Project, waarmee het Antwerpse project vaak wordt vergeleken. McGrath: „Dat onderzoek was veel kleiner, werkte chronologisch en focuste ook meer op toeschrijving van.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "baf8f249-e88a-3395-a69b-a7ae5bb2dca6",
                        "entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                        "glosses": [
                            "tijdrekenkundig"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dfc53a8-8217-48a4-aec3-2dd3e081999c",
                        "source_entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                        "source_sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                        "source_sense_description": "naar tijdstip gerangschikt",
                        "target_lang_word": "chronological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f220adc-7922-3faa-8850-27a4d6ffd290",
                                        "entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                                        "glosses": [
                                            "Relating to time, or units of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d44cee-902c-4f5d-bdd9-8634d682ef4e",
                                                "sense_id": "5f220adc-7922-3faa-8850-27a4d6ffd290",
                                                "text": "He is 67 in chronological age, but has the mind and body of someone 55."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "270ad794-9522-39fc-a0b5-497fb300a698",
                                        "entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                                        "glosses": [
                                            "In order of time from the earliest to the latest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfafc0f1-8183-4c2f-8af1-47d699f27e17",
                                                "sense_id": "270ad794-9522-39fc-a0b5-497fb300a698",
                                                "text": "The live report lists all the events in chronological order."
                                            },
                                            {
                                                "example_id": "87722076-04f8-4795-aee9-e13697a782f9",
                                                "sense_id": "270ad794-9522-39fc-a0b5-497fb300a698",
                                                "text": "A Book of Death and Fish is about one Peter MacAulay, an unremarkable individual who has the sea and its promises always with him, experiencing the usual strains of growing up and growing old – the death of a friend, his parents, marriage and children – all set out in chronological order and divided into two books, Migration and Turbulence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0fc064-a4e1-3b34-8c11-82a0a3db95aa",
                                        "entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                                        "glosses": [
                                            "In order of time from the earliest to the latest.",
                                            "Relating to the arrangement of events in the order in which they occur within a story, rather than the order in which they are released."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53eb5461-1e6a-4dd0-a7c4-98fe62a8b9dd",
                        "source_entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                        "source_sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                        "source_sense_description": "naar tijdstip gerangschikt",
                        "target_lang_word": "chronologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                        "entry_id": "88009291-be3c-3693-908c-d9b1a7a2953e",
                                        "glosses": [
                                            "Relatif à la chronologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ea9aac-0090-4456-810b-c8f530fa63a8",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "C'est l’annaliste L. Calpurnius Pison (suivi par Denys) qui, à la suite de calculs chronologiques, faisait de Tarquin l’Ancien l’aïeul de Lucius."
                                            },
                                            {
                                                "example_id": "a76e0df0-5450-406d-9b62-fc4a77067bca",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "Nous avons présenté cette histoire, non dans une successivité véritablement chronologique, mais dans un ordre d’heuristicité croissante."
                                            },
                                            {
                                                "example_id": "6875e992-691e-4a22-bdc7-d25edd17a490",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "Nous proposons alors une approche chronologique en nous appuyant sur une nouvelle datation et sur la corrélation avec les stades des Alpes orientales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
