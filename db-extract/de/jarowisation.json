                "senses": [
                    {
                        "sense_id": "cffb04fa-2beb-3f4a-a272-f0a2ca03300d",
                        "entry_id": "c5ab9c20-2423-31d8-a8be-8a3c98d622bb",
                        "glosses": [
                            "künstliche Anwendung von Licht- und Temperaturreizen auf gequollene Pflanzensamen, die Keimung, Blüte und Fruchtansatz unter schwierigeren klimatischen Bedingungen begünstigen oder beschleunigen (sollen)"
                        ],
                        "tags": [
                            "Agrarbiologie",
                            "Pflanzenphysiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c471b5d8-cf16-483d-a57e-8eaab9f80f9f",
                                "sense_id": "cffb04fa-2beb-3f4a-a272-f0a2ca03300d",
                                "text": "Das Verfahren der Jarowisation hat es in Rußland angeblich erlaubt, den Getreideanbau um mehrere Grad weiter nach Norden in Gebiete mit kürzeren Vegetationsperioden vorzuschieben."
                            },
                            {
                                "example_id": "e729f766-85ed-4b99-80bb-1abd252d0842",
                                "sense_id": "cffb04fa-2beb-3f4a-a272-f0a2ca03300d",
                                "text": "Ernst zu nehmende Pflanzenzüchter und Experimentatoren vertreten die Auffassung, dass die Jarowisation in den meisten Fällen den Ernteertrag nicht erhöht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abfa7010-825b-414e-a363-eb16c3b8edec",
                        "source_entry_id": "c5ab9c20-2423-31d8-a8be-8a3c98d622bb",
