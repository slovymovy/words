                                "target_senses": [
                                    {
                                        "sense_id": "d0fa7d2d-c757-3f63-8f31-037088466826",
                                        "entry_id": "d3e7edc2-31d8-37aa-b70c-6d79248915dc",
                                        "glosses": [
                                            "In a strong or substantial manner; considerably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d362f9d-32b5-43ea-9473-087bae6e0eb6",
                                                "sense_id": "d0fa7d2d-c757-3f63-8f31-037088466826",
                                                "text": "For the first time since the Great Depression, median family income has fallen substantially over an entire decade. Income grew slowly through most of the last decade, except at the top of the distribution, before falling sharply when the financial crisis began."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3496e83-9765-3863-ba2b-9fd3cabd3148",
