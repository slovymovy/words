                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3a36f1-bb58-4d59-84f0-021af68a0c4f",
                                "sense_id": "9cf806da-2820-339a-a441-04f99bda17ff",
                                "text": "La caisse de résonance de la gadoulka est de forme piriforme en murier et possède trois ou quatre cordes en boyau."
                            },
                            {
                                "example_id": "e7b8b6cf-4e3b-4784-9676-7a178f189837",
                                "sense_id": "9cf806da-2820-339a-a441-04f99bda17ff",
                                "text": "D’un coup de patte, il envoie valser la gadoulka du bohémien, dont la musique grinçante et lancinante doit avoir le don d’exaspérer tout autant le plantigrade que le bipède."
                            }
                        ]
                    }
