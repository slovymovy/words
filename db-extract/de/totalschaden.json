                                                "example_id": "7b928a30-d72b-4f62-9979-4d3487893edc",
                                                "sense_id": "b5ade86e-4c1d-3813-8776-2fd13375b69b",
                                                "text": "Het voormalig Hof in Noord Holland besliste in overeenstemming met de Amsterdamsche rechtbank, dat hier niet het geval van general average, ook wel genaamd total loss bestond, dat evenwel volgens de Engelsche conditie noodig was om de verplichting tot schadevergoeding te doen bestaan; en dat ook evenmin door den verzekerde was bewezen, dat de schade een noodwendig gevolg was van een der oorzaken, waar tegen verzekerd was, met name van oorlogsgevaar of schuld van den schipper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98d0724d-de32-333b-b6b6-2cd1679603f8",
                                        "entry_id": "65c29b8b-919d-341b-af8b-002f9420d114",
                                        "glosses": [
                                            "geval waarin beschadiging van een voertuig zo ernstig is dat het economisch niet meer verantwoord is te repareren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da0ffbba-85ce-4f48-a4d6-b66c14ed2031",
                                                "sense_id": "98d0724d-de32-333b-b6b6-2cd1679603f8",
                                                "text": "Ik zei: 'Het is niet zo erg, want ik heb die foto's laten afdrukken.' Stelt u zich een garagehouder voor die de eigenaar van een total loss informeert over de tarieven van een vervangende auto en te horen krijgt: 'Hoeft niet, ik heb mijn koets nog'. Dan u weet ongeveer hoe die jongen keek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4779f992-5486-3362-94b7-31f69e7fc9f8",
                                        "entry_id": "65c29b8b-919d-341b-af8b-002f9420d114",
                                        "glosses": [
                                            "product dat zo'n slechte reputatie heeft gekregen dat het onverkoopbaar is"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7745e156-ad6d-4281-be39-0e6d2a1f7204",
                                                "sense_id": "4779f992-5486-3362-94b7-31f69e7fc9f8",
                                                "text": "Een wondermiddel of een total loss: Duizenden kinderen krijgen tegen agressie het antipsychoticum risperidon. Dit gold mede door gemanipuleerd onderzoek lang als een wondermiddel: effectief en zonder veel bijwerkingen. Nu blijkt dat jonge kinderen er gevaarlijk dik van worden. „We zijn van de regen in de drup geraakt.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11284365-e93a-3d78-a7ea-81c64861f16e",
                                        "entry_id": "65c29b8b-919d-341b-af8b-002f9420d114",
                                        "glosses": [
                                            "iemand die helemaal is uitgeput of een geestelijke wrak is geworden"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f1e8ed-efa5-4076-8244-d97c5705e9f5",
                                                "sense_id": "11284365-e93a-3d78-a7ea-81c64861f16e",
                                                "text": "Menno ter Braak kwam uit Eibergen en stond model voor Otto Verbeek in Een wonderkind of een total loss van Hermans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "total loss",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e719da-a208-375c-a44e-66c53ca3570b",
                                        "entry_id": "c454f104-35a1-3142-aa2c-81028a0dbfbe",
                                        "glosses": [
                                            "onherstelbaar beschadigd, in een staat van total loss zn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884af8f5-aeda-466b-9b3b-dd44171ef8ef",
                                                "sense_id": "c7e719da-a208-375c-a44e-66c53ca3570b",
                                                "text": "Vorig jaar reed hij zijn taxi total loss tegen een meterkast."
                                            },
                                            {
                                                "example_id": "4ae146b8-0f72-47c4-a8c7-43bd565ee64c",
                                                "sense_id": "c7e719da-a208-375c-a44e-66c53ca3570b",
                                                "text": "De dagen na zo’n sessie voel je je juist slechter, ben je mentaal total loss en wil je alleen nog maar in een foetushouding liggen met de gordijnen dicht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
