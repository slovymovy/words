                        "glosses": [
                            "Wettbewerb, an dem mehrere Personen oder Mannschaften aus einem Land/Bundesland teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249e58ee-2cd9-4fd3-b7fd-4d11e5a15e73",
                                "sense_id": "ed7cde2e-760e-3a13-b2d1-4977e58b94be",
                                "text": "„Rostock, Jena, Halle, Kassel, Osnabrück und Pirmasens dürfen nach dem Sieg im jeweiligen Landespokal am DFB-Pokal teilnehmen.“"
                            },
                            {
                                "example_id": "9d0cd326-561c-45a2-9e58-2dad40790a77",
                                "sense_id": "ed7cde2e-760e-3a13-b2d1-4977e58b94be",
                                "text": "„Erst zweieinhalb Wochen vor der Auslosung begann der wegen Corona verschobene Wettbewerb im Landespokal.“"
                            }
                        ],
