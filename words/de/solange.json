                    "sense_id": "36522ce7-da90-36d2-8b35-8dbdee4229d4",
                    "sense_definition": "während der gesamten Zeitspanne, in der ein Zustand oder Vorgang andauert",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich werde dich immer unterstützen, <w>solange</w> ich lebe.",
                            "target_lang_translations": {
                                "en": "I will always support you <w>as long as</w> I live.",
                                "ru": "Я буду всегда поддерживать тебя, <w>пока</w> я жив.",
                                "nl": "Ik zal je altijd steunen, <w>zolang</w> ik leef.",
                                "pl": "Będę cię zawsze wspierać, <w>dopóki</w> żyję.",
                                "fr": "Je te soutiendrai toujours <w>tant que</w> je vivrai.",
                                "it": "Ti sosterrò sempre, <w>finché</w> vivrò.",
                                "cs": "Budu tě vždy podporovat, <w>dokud</w> budu žít.",
                                "tr": "Yaşadığım <w>sürece</w> seni her zaman destekleyeceğim.",
                                "es": "Te apoyaré siempre <w>mientras</w> viva.",
                                "zh": "<w>只要</w>我还活着，就一定会一直支持你。"
                            }
                        },
                        {
                            "text": "Du kannst gerne bei uns bleiben, <w>solange</w> du möchtest.",
                            "target_lang_translations": {
                                "en": "You are welcome to stay with us <w>as long as</w> you want.",
                                "ru": "Ты можешь спокойно оставаться у нас, <w>пока</w> хочешь.",
                                "nl": "Je mag gerust bij ons blijven, <w>zolang</w> je wilt.",
                                "pl": "Możesz śmiało u nas zostać, <w>jak długo</w> chcesz.",
                                "fr": "Tu peux volontiers rester chez nous <w>aussi longtemps que</w> tu le souhaites.",
                                "it": "Puoi rimanere volentieri da noi <w>finché</w> vuoi.",
                                "cs": "Můžeš u nás klidně zůstat, <w>dokud</w> budeš chtít.",
                                "tr": "İstediğin <w>sürece</w> bizde kalabilirsin.",
                                "es": "Puedes quedarte con nosotros <w>mientras</w> quieras.",
                                "zh": "<w>只要</w>你愿意，可以一直住在我们家。"
                            }
                        }
                    ],
