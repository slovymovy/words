                                                "sense_id": "e16d05bc-2832-39ba-9b75-1ada0f10cccf",
                                                "text": "Er überredete sie zu bleiben."
                                            },
                                            {
                                                "example_id": "166e9c26-7134-46a3-b73d-d6d3935c52b3",
                                                "sense_id": "e16d05bc-2832-39ba-9b75-1ada0f10cccf",
                                                "text": "„Aber die Hohenpriester und die Ältesten überredeten das Volk, dass sie um Barabbas bitten, Jesus aber umbringen sollten.“"
                                            },
                                            {
                                                "example_id": "5c604dfb-09e3-44d0-ae73-17a7a7f2d764",
                                                "sense_id": "e16d05bc-2832-39ba-9b75-1ada0f10cccf",
                                                "text": "„Alternativ besticht oder überredet die Gruppe Mitarbeiter von Mobilfunkunternehmen, ihnen fremde Handynummern auf ihre eigenen Geräte zu übertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
