                        "glosses": [
                            "Qui renferme les cendres d’un mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e04dcb-3134-4619-8592-0d1af696778c",
                                "sense_id": "59a07249-888a-3d9c-86b4-6b4a45f38e40",
                                "text": "Nous fûmes saisis d’une attaque d’archéologie foudroyante et nous voulûmes faire des fouilles pour découvrir des médailles, des ossements, des haches druidiques, des celtae, des vases cinéraires et des sarcophages."
                            }
                        ]
