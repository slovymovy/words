                                "sense_id": "ca1d841f-f62e-37ab-bcb0-be776514e8c3",
                                "text": "„Eichinger, mittlerweile Ö3-Sportreporter, verbindet mit Kleinmann \"eine Hassliebe.“"
                            },
                            {
                                "example_id": "87648340-4488-4901-a6a0-21339b35385c",
                                "sense_id": "ca1d841f-f62e-37ab-bcb0-be776514e8c3",
                                "text": "„Am Freitagmorgen ist der Sportreporter, Kolumnist und Buchautor im 91. Lebensjahr gestorben.“"
                            },
                            {
                                "example_id": "cdb57d9a-9672-4707-a440-0913a284458b",
                                "sense_id": "ca1d841f-f62e-37ab-bcb0-be776514e8c3",
                                "text": "„Fußball kann auch Sportreporter zu höchster Kreativität anregen.“"
                            }
                        ],
