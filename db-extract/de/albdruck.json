                "senses": [
                    {
                        "sense_id": "79159c58-e1b2-38d3-8e13-d55ba14e1520",
                        "entry_id": "65bb2b12-f8ea-3da5-96e4-05c2b7b0c8f5",
                        "glosses": [
                            "Albtraum mit Angstgefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27cdd793-4214-4d57-a1bd-80373f0f95ba",
                                "sense_id": "79159c58-e1b2-38d3-8e13-d55ba14e1520",
                                "text": "Ich hatte heute einen schlimmen Albdruck, bis meine Freundin mich geweckt hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9106f85e-baa5-41bc-8c05-12eddf866dc8",
                        "source_entry_id": "65bb2b12-f8ea-3da5-96e4-05c2b7b0c8f5",
                        "source_sense_id": "79159c58-e1b2-38d3-8e13-d55ba14e1520",
                        "source_sense_description": "Albtraum mit Angstgefühl",
                        "target_lang_word": "nightmare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nightmare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68dd55c7-41d1-3322-a573-0e951191c685",
                                        "entry_id": "9a1310f9-8539-3d62-a0bc-b035d100f101",
                                        "glosses": [
                                            "A very unpleasant or frightening dream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6baf1d4-8d0a-498e-8992-6866098bdbcd",
                                                "sense_id": "68dd55c7-41d1-3322-a573-0e951191c685",
                                                "text": "I had a nightmare that I tried to run but could neither move nor breathe."
                                            },
                                            {
                                                "example_id": "025a91d8-6209-40cf-bd66-c9378c2f7b7c",
                                                "sense_id": "68dd55c7-41d1-3322-a573-0e951191c685",
                                                "text": "July 18 2012, Scott Tobias, AV Club The Dark Knight Riseshttp://www.avclub.com/articles/the-dark-knight-rises-review-batman,82624/\nWith his crude potato-sack mask and fear-inducing toxins, The Scarecrow, a “psychopharmacologist” at an insane asylum, acts as a conjurer of nightmares, capable of turning his patients’ most terrifying anxieties against them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a86de30-8e99-380d-833d-69f3f1631b49",
                                        "entry_id": "9a1310f9-8539-3d62-a0bc-b035d100f101",
                                        "glosses": [
                                            "Any bad, miserable, difficult or terrifying situation or experience that arouses anxiety, terror, agony or great displeasure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4408c306-9af4-43f0-9216-fd98ab44cfa3",
                                                "sense_id": "2a86de30-8e99-380d-833d-69f3f1631b49",
                                                "text": "Cleaning up after identity theft can be a nightmare of phone calls and letters."
                                            },
                                            {
                                                "example_id": "421d40be-bc0c-45bf-b33b-6509fa05ed8f",
                                                "sense_id": "2a86de30-8e99-380d-833d-69f3f1631b49",
                                                "text": "If Euston is not typically English, St. Pancras is. Its façade is a nightmare of improbable Gothic. It is fairly plastered with the aesthetic ideals of 1868, and the only beautiful thing about it is Barlow's roof. It is haunted by the stuffier kind of ghost. Yet there is something about the ordered whole of St. Pancras that would make demolition a terrible pity."
                                            },
                                            {
                                                "example_id": "ef5e3bd4-2499-4a51-a5ce-d8eda95a5502",
                                                "sense_id": "2a86de30-8e99-380d-833d-69f3f1631b49",
                                                "text": "The Red Holocaust is best interpreted in this light as the bitter fruit of an^([sic]) utopian gambit that was socially misengineered into a dystopic nightmare by despots in humanitarian disguise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89833a5-c40d-3d52-b63b-93895438010b",
                                        "entry_id": "9a1310f9-8539-3d62-a0bc-b035d100f101",
                                        "glosses": [
                                            "A demon or monster, thought to plague people while they slept and cause a feeling of suffocation and terror during sleep."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2bf872b-7e92-430a-86f6-09f086a4a9dc",
                                                "sense_id": "e89833a5-c40d-3d52-b63b-93895438010b",
                                                "text": "It haunted me, however, more than once, like a night-mare."
                                            },
                                            {
                                                "example_id": "52a2e4ed-3873-4a83-ad22-b565f72ca4ce",
                                                "sense_id": "e89833a5-c40d-3d52-b63b-93895438010b",
                                                "text": "I started, hourly, from dreams of unutterable fear, to find the hot breath of the thing upon my face, and its vast weight—an incarnate Night-Mare that I had no power to shake off—incumbent eternally upon my heart!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd582b58-c633-3c5d-bbac-d3e2abc97f69",
                                        "entry_id": "9a1310f9-8539-3d62-a0bc-b035d100f101",
                                        "glosses": [
                                            "A feeling of extreme anxiety or suffocation experienced during sleep; sleep paralysis."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b18b85-8f0a-4b5c-be42-af688e7cd05a",
                                                "sense_id": "cd582b58-c633-3c5d-bbac-d3e2abc97f69",
                                                "text": "The Night-mare generally ſeizes people ſleeping on their backs, and often begins with frightful dreams, which are ſoon ſucceeded by a difficult reſpiration, a violent oppreſſion on the breaſt, and a total privation of voluntary motion."
                                            },
                                            {
                                                "example_id": "62d79246-43ef-4dae-b34b-da21eaff2eab",
                                                "sense_id": "cd582b58-c633-3c5d-bbac-d3e2abc97f69",
                                                "text": "Had been afflicted in the night with that strange complaint called the nightmare."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nightmare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f063dbeb-999e-37ba-b4d2-ac4d12cff14d",
                                        "entry_id": "effd81fc-0815-3b7b-80da-23d7f4aa6f23",
                                        "glosses": [
                                            "To experience a nightmare."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2569e1b0-96b3-4fc1-b986-b96a181d9cf7",
                                                "sense_id": "f063dbeb-999e-37ba-b4d2-ac4d12cff14d",
                                                "text": "Brother Fary of Omaha was nightmaring the rest of the night."
                                            },
                                            {
                                                "example_id": "3a6ae685-aaa4-45f1-814e-52e7d1aad3c1",
                                                "sense_id": "f063dbeb-999e-37ba-b4d2-ac4d12cff14d",
                                                "text": "It’s been 21,900 hours, 912 days, 130 Saturday nights, 30 months, 3 years since October 16, 1988 when I was stunned awake, straddled by a man I did not know. First I think I’m nightmaring."
                                            },
                                            {
                                                "example_id": "c26f491b-736c-43c0-93dc-26542c97953f",
                                                "sense_id": "f063dbeb-999e-37ba-b4d2-ac4d12cff14d",
                                                "text": "Every night, Liesel would nightmare."
                                            },
                                            {
                                                "example_id": "362dcff7-ea15-43d6-a17b-224075df945b",
                                                "sense_id": "f063dbeb-999e-37ba-b4d2-ac4d12cff14d",
                                                "text": "He must be imagining that behind the rain of leaves was a dark-haired man sitting in his chair, smiling away. He must be so fed up with himself that he was nightmaring while awake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e305ff43-049a-346e-a0e8-8d1b8a5ca0e0",
                                        "entry_id": "effd81fc-0815-3b7b-80da-23d7f4aa6f23",
                                        "glosses": [
                                            "To imagine (someone or something) as in a nightmare."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af27d55-ed86-4da7-b265-215f4f519fa1",
                                                "sense_id": "e305ff43-049a-346e-a0e8-8d1b8a5ca0e0",
                                                "text": "She was the last person I’d expected to see, although I had not expected to see anyone at all. For a moment I thought it was a nightmare, and that I was nightmaring the whole thing."
                                            },
                                            {
                                                "example_id": "1aaf88c3-2337-4898-961e-57aacdc8323f",
                                                "sense_id": "e305ff43-049a-346e-a0e8-8d1b8a5ca0e0",
                                                "text": "Stars have no need of intimidation, which makes them mightier than all the godheads nightmared by mere humanity."
                                            },
                                            {
                                                "example_id": "511e0e8c-ccbf-42dc-8280-e9dd91b9798d",
                                                "sense_id": "e305ff43-049a-346e-a0e8-8d1b8a5ca0e0",
                                                "text": "I hurried through the arch, was dipped into shadow, and was glad to have my screaming eyes rinsed clean of this vision of a scrabbling, gibbering hell, worse than any nightmared by Bosch or Goya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                                        "entry_id": "effd81fc-0815-3b7b-80da-23d7f4aa6f23",
                                        "glosses": [
                                            "To trouble (someone or something), as by a nightmare."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed012b96-7c41-4fee-a2c2-951309d2a38f",
                                                "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                                                "text": "THe day is broke! Melpomene, be gone; / Hag of my Fancy, let me now alone: / Night-mare my ſoul no more; Go take thy flight / Where Traytors Ghoſts keep an eternal night; […]"
                                            },
                                            {
                                                "example_id": "f2fcb235-63bb-4587-96b5-139fda17d626",
                                                "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                                                "text": "Thou things imponderable dost price and weigh / By scales untrue ’gainst the gewgaws and gauds / O’ the World; thy ledger ’neath thy head dost lay / For pillow, nightmared with dreams of thy hoards."
                                            },
                                            {
                                                "example_id": "45782e0d-07ab-48d5-9f1f-a0225ab956ff",
                                                "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                                                "text": "And in my sleep a vision nightmared me:— / The steeds I tended, and at Rhesus’ side / Drave in the car, I saw as in a dream / Mounted of wolves that rode upon their backs; / And with their tails these lashed the horses’ flanks, / Scourging them on."
                                            },
                                            {
                                                "example_id": "4fa0a03a-cda0-4a02-9e49-490bd6cada7e",
                                                "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                                                "text": "[…] I slept fitfully—it was hot, the very pillows seemed to sweat—and when I did fall off in sleep, I tossed and tossed, disturbed, I think, by the call of old-new affinities, nightmared by the tall Sudanese who paced my dreams, veiled in a yashmak, stuttering."
                                            },
                                            {
                                                "example_id": "765cbbe3-aa29-4e95-ac33-29afc8185b98",
                                                "sense_id": "1575b5c5-64ca-3709-85bf-54ac91387be6",
                                                "text": "The thing beckoned to me, grinning horrible out of its gape-agog slit-face, and it whispered to me, about things that I . . . well, never you mind that part. / “It was that powder, I tell you, as was nightmaring me. So I took the jar out behind-house and I dropped it down the convenience. Yes, the earth-closet. I went back to bed, but I still couldn’t kip much."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f125c5-3ed1-4dcf-afc9-3d4e70fd707c",
                        "source_entry_id": "65bb2b12-f8ea-3da5-96e4-05c2b7b0c8f5",
                        "source_sense_id": "79159c58-e1b2-38d3-8e13-d55ba14e1520",
                        "source_sense_description": "Albtraum mit Angstgefühl",
                        "target_lang_word": "cauchemar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cauchemar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "696057bc-9e20-392d-a27d-8dbf2bb8ae19",
                                        "entry_id": "19296657-375b-38e9-a9f3-e62cef8b5a54",
                                        "glosses": [
                                            "Oppression ou étouffement qui survient quelquefois durant le sommeil, mais qui cesse dès qu’on se réveille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602f6484-51c0-4bfe-8900-fd5eaef3d7cf",
                                                "sense_id": "696057bc-9e20-392d-a27d-8dbf2bb8ae19",
                                                "text": "Être sujet au cauchemar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087cbb83-b8ac-3442-aee0-4e712798392e",
                                        "entry_id": "19296657-375b-38e9-a9f3-e62cef8b5a54",
                                        "glosses": [
                                            "Rêve pénible ou effrayant, provoquant l'angoisse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6743560c-5783-48ec-a418-40fcde3be0a2",
                                                "sense_id": "087cbb83-b8ac-3442-aee0-4e712798392e",
                                                "text": "Elle eut peur ainsi qu’on a peur la nuit dans les cauchemars mauvais, dans les remords, quand l’ombre est dense et pèse, après le crime, comme un châtiment. Elle fut honteuse à cause de son passé, le revit d’un seul coup avec éblouissement et pensa : Je suis la dernière des dernières."
                                            },
                                            {
                                                "example_id": "e142bbda-447f-44f0-a149-a923f47b5e30",
                                                "sense_id": "087cbb83-b8ac-3442-aee0-4e712798392e",
                                                "text": "Il m’arrivait de me réveiller la nuit, au milieu d’un cauchemar où les poteaux sinistres et le blême tranchet de la guillotine semblait attendre que mon tour arrivât de faire connaissance avec eux."
                                            },
                                            {
                                                "example_id": "f236171e-685f-437c-87d3-343cd29ffb23",
                                                "sense_id": "087cbb83-b8ac-3442-aee0-4e712798392e",
                                                "text": "Durant la même nuit, Feempje qui n’avait jamais de cauchemar s’était débattu, en grognant et en poussant des plaintes, contre il n’aurait pu dire quelles terrifiantes figures."
                                            },
                                            {
                                                "example_id": "7764b437-e88b-4ee8-96db-af1a90e73712",
                                                "sense_id": "087cbb83-b8ac-3442-aee0-4e712798392e",
                                                "text": "[…] ce cauchemar dont j’avais si peur et que j’identifiais plus ou moins avec le ronflement de mon père, souffle rauque entendu parfois la nuit, bruit sinistre qui me semblait venir directement d’outre-tombe et que je confonds maintenant avec le râle de son agonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e566cd6-8180-3c94-8a73-06f09c2e775b",
                                        "entry_id": "19296657-375b-38e9-a9f3-e62cef8b5a54",
                                        "glosses": [
                                            "Situation qui laisse un mauvais souvenir ou que l'on redoute."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d97f8f03-f30a-42a1-8a1c-09f5f29fda17",
                                                "sense_id": "3e566cd6-8180-3c94-8a73-06f09c2e775b",
                                                "text": "Ma myopie renforçait encore l’impression d’irréel, de cauchemar que je ressentais et contre laquelle je m’efforçais de lutter, dans la crainte de voir se briser ma volonté."
                                            },
                                            {
                                                "example_id": "0b281117-6d21-4ae8-889f-fac38be35bc8",
                                                "sense_id": "3e566cd6-8180-3c94-8a73-06f09c2e775b",
                                                "text": "Et les cédilles, ça ressemblait à rien ces zigouigouis, quant au verbe avoir qui s’accordait tantôt avec le complément d’objet direct tantôt pas, c’était un cauchemar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c7d9b35-e198-3027-9470-24005c82e709",
                                        "entry_id": "19296657-375b-38e9-a9f3-e62cef8b5a54",
                                        "glosses": [
                                            "Personne ou chose très ennuyeuse, très importune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "164cd082-684d-4df4-b0cc-56636f81dd11",
                                                "sense_id": "7c7d9b35-e198-3027-9470-24005c82e709",
                                                "text": "Cette obligation est mon cauchemar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
