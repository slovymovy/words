                        "glosses": [
                            "The protoplasm of a spore, particularly in the myxospores."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d36a9e-2889-49f8-8145-55b196fb7174",
                                "sense_id": "ce19624f-662a-3823-8e90-36f8f8488f2a",
                                "text": "Sporoplasm varying considerably in size and shape, and sometimes filling all the extra-capsular portion of the shell cavity; in this condition presenting no evidence of segmentation."
                            },
                            {
                                "example_id": "b010a29f-ea84-49a7-bbb9-b25013dd5997",
                                "sense_id": "ce19624f-662a-3823-8e90-36f8f8488f2a",
                                "text": "The posterior half portion of the spore is filled with sporoplasm."
                            },
                            {
                                "example_id": "745bc526-9dbd-4c6c-ba4d-aebc8aac6a9c",
                                "sense_id": "ce19624f-662a-3823-8e90-36f8f8488f2a",
                                "text": "Under appropriate conditions inside a suitable host, the polar tube is discharged through the thin anterior end of the spore, which penetrates the host cell, and is used to inoculate the infective sporoplasm and nucleus (one or two) into the host cell."
                            }
                        ]
                    }
