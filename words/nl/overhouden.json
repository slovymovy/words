                },
                {
                    "sense_id": "72774d9e-24ce-3e13-8cd3-d1dcf8023e1a",
                    "sense_definition": "scholieren na afloop van de gewone lestijd langer op school houden als straf",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onderwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar besloot de hele klas een uur <w>over te houden</w> vanwege het lawaai.",
                            "target_lang_translations": {
                                "en": "The teacher decided to <w>give</w> the whole class an hour of <w>detention</w> because of the noise."
                            }
                        },
                        {
                            "text": "Als je je huiswerk niet maakt, moet ik je helaas <w>overhouden</w>.",
                            "target_lang_translations": {
                                "en": "If you don't do your homework, I'm afraid I'll have to <w>keep</w> you <w>in</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nablijven"
                    ],
                    "common_phrases": [
                        "leerlingen overhouden"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in Nederland gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to keep students at school after regular hours as a punishment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to give detention",
                                "target_lang_sense_clarification": "school punishment"
                            },
                            {
                                "target_lang_word": "to keep in",
                                "target_lang_sense_clarification": "after school"
                            }
                        ]
                    }
                },
                {
