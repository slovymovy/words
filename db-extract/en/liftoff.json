                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "050cf75e-f898-4428-a6dd-68a8b7606ef4",
                        "entry_id": "f7a88e05-a77f-3254-a42a-bf6d304ed357",
