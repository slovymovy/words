                "senses": [
                    {
                        "sense_id": "71e0abd3-04cc-3633-9b2c-3f061931006e",
                        "entry_id": "ed033632-f04d-3a8a-ab01-aa5e8e636599",
                        "glosses": [
                            "Rendre absent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99475d02-c21d-4c35-a4ee-4937e1c436f5",
                                "sense_id": "71e0abd3-04cc-3633-9b2c-3f061931006e",
                                "text": "La pulsion de vie est écartée au profit de pulsions de mort partielles venant absentéiser l’image fonctionnelle du corps d’une partie."
                            },
                            {
                                "example_id": "0c0d3db9-34a5-4e32-89f8-399188abdb2c",
                                "sense_id": "71e0abd3-04cc-3633-9b2c-3f061931006e",
                                "text": "Sans cette aptitude à rendre présent l’absent ou à absentéiser une présence, le fonctionnement psychique se binarise et s’aliène au pendant pragmatique de l’activité perceptive."
                            }
                        ]
                    },
                    {
                        "sense_id": "585651ab-b646-3c73-9397-35602f724993",
                        "entry_id": "ed033632-f04d-3a8a-ab01-aa5e8e636599",
                        "glosses": [
                            "Être absent quelque part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c3b068-7e1c-430d-b3d3-d25fe19cf4e8",
                                "sense_id": "585651ab-b646-3c73-9397-35602f724993",
                                "text": "Toutefois là tu parles d'absentéiser un cours jusqu'à la fin du semestre en fait ?"
                            }
                        ]
