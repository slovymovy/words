                "senses": [
                    {
                        "sense_id": "585e75ff-d0ca-3ee9-91f9-5868a7a88a6a",
                        "entry_id": "14c6f998-d6d7-3530-9e08-2e5b4a1134bc",
                        "glosses": [
                            "mutant (that has undergone genetic mutation)"
                        ],
                        "tags": [
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "173176ea-6622-4d00-a921-baa2dbbda3aa",
                                "sense_id": "585e75ff-d0ca-3ee9-91f9-5868a7a88a6a",
                                "text": "Er sagt, er glaubt nicht, dass ich eine Mutantin bin, aber manche Mutanten erkennt man schwer."
                            }
                        ]
                    },
                    {
                        "sense_id": "583cafb6-06b9-3279-8c7e-ae60cdaa3438",
                        "entry_id": "14c6f998-d6d7-3530-9e08-2e5b4a1134bc",
                        "glosses": [
                            "A boy (especially a choirboy) whose voice is breaking due to puberty."
                        ],
                        "tags": [
                            "Austria",
                            "Bavaria",
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "dbafc03d-129e-40a4-9e1d-81d65abc32c6",
                                "sense_id": "583cafb6-06b9-3279-8c7e-ae60cdaa3438",
                                "text": "Ich habe kein Zuhause mehr, ich habe meine Mutter verloren, meine Stimme dazu. Ich bin ein Mutant.",
                                "translation": "I don't have a home anymore, I lost my mother, my voice too. I am a mutant.",
                                "english": "I don't have a home anymore, I lost my mother, my voice too. I am a mutant."
                            },
                            {
                                "example_id": "f42b60ad-eb26-49b6-a40e-f3ceb36b95f3",
                                "sense_id": "583cafb6-06b9-3279-8c7e-ae60cdaa3438",
                                "text": "Dann änderte sich alles. „Man spürt, wie die Stimme anders wird, wie sie beim Singen einbricht“, sagt Simon. Er traf auf einmal nicht mehr sicher alle Töne. […] Simon wurde mit 14 Jahren zum „Mutant“.",
                                "translation": "Then everything changed. \"You can feel how your voice is changing, how it breaks when you're singing,\" said Simon. He suddenly couldn't hit all the notes […] Simon became a \"mutant\" at 14 years old.",
                                "english": "Then everything changed. \"You can feel how your voice is changing, how it breaks when you're singing,\" said Simon. He suddenly couldn't hit all the notes […] Simon became a \"mutant\" at 14 years old."
                            },
                            {
                                "example_id": "31f63be5-1324-40a7-a7f3-b448a1e0e95b",
                                "sense_id": "583cafb6-06b9-3279-8c7e-ae60cdaa3438",
                                "text": "Es kann vermutet werden, dass Mutanten, die bereits im Kindesalter stimmliche Betreuung oder gezieltes Stimmtraining erhalten haben, die körperlichen Veränderungen leichter bewältigen können.",
                                "translation": "It can be assumed that mutants that had already received vocal coaching or voice training in childhood can handle these physical changes more easily.",
                                "english": "It can be assumed that mutants that had already received vocal coaching or voice training in childhood can handle these physical changes more easily."
                            },
                            {
                                "example_id": "d23dba24-01fb-45a2-968a-02ff3eb7dc85",
                                "sense_id": "583cafb6-06b9-3279-8c7e-ae60cdaa3438",
                                "text": "Er aber froh sein würde, mit 14 Jahren endlich Mutant zu werden...endlich in den Stimmbruch zu kommen.",
                                "translation": "But he would be happy to finally become a mutant at age 14...for his voice to finally break.",
                                "english": "But he would be happy to finally become a mutant at age 14...for his voice to finally break."
                            },
                            {
                                "example_id": "7e6372ca-db4f-4e82-bf66-5439153e0788",
                                "sense_id": "583cafb6-06b9-3279-8c7e-ae60cdaa3438",
                                "text": "Gerade am Anfang hatte ich mit Heimweh zu kämpfen. Blöd war auch der Stimmbruch. Da gilt man dann plötzlich als Mutant und ist erst mal nicht mehr im Chor dabei.",
                                "translation": "At the beginning I was struggling with homesickness. And my voice breaking sucked too. Suddenly, you're considered a mutant and aren't in the choir anymore.",
                                "english": "At the beginning I was struggling with homesickness. And my voice breaking sucked too. Suddenly, you're considered a mutant and aren't in the choir anymore."
                            }
                        ]
                    }
                ],
