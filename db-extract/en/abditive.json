                        "examples": [
                            {
                                "example_id": "6363c9a9-188b-4cf8-bc6b-ca34122dfc9f",
                                "sense_id": "b10e70bc-c94d-362a-b464-73305defdd1d",
                                "text": "The abditive nature of the heavy foliage protected the nest."
                            },
                            {
                                "example_id": "404036b9-d83c-48c9-a89a-8010ee446f65",
                                "sense_id": "b10e70bc-c94d-362a-b464-73305defdd1d",
                                "text": "There is also a species of wit which may be termed abditive; for it conceals or lessens the dignity attached to rank or character."
                            },
                            {
                                "example_id": "b69eb6cb-e9c1-439a-98c9-85f632c3a8fb",
                                "sense_id": "b10e70bc-c94d-362a-b464-73305defdd1d",
                                "text": "Concepts are either abditive or inabditive; the former being those that do, and the latter those that do not, hide the plurality of the kind they symbolise."
                            }
                        ]
                    }
                ],
