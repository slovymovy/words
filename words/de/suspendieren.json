                        "die Mitgliedschaft suspendieren"
                    ]
                },
                {
                    "sense_id": "773da84e-7076-305b-80f1-7a4cf77a38dd",
                    "sense_definition": "feste Teilchen ungelöst und feinst verteilt in einer Flüssigkeit in der Schwebe halten",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "Naturwissenschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spezielle chemische Zusätze helfen dabei, die Farbpigmente gleichmäßig im Lösungsmittel zu <w>suspendieren</w>."
                        },
                        {
                            "text": "Das feine Pulver lässt sich nur unter starkem Rühren in Wasser <w>suspendieren</w>."
                        }
                    ],
                    "common_phrases": [
                        "Teilchen suspendieren"
                    ]
                },
                {
                    "sense_id": "8f84bdbf-53eb-34c8-a849-a579a76007ca",
                    "sense_definition": "einen verletzten Körperteil schwebend aufhängen oder lagern",
