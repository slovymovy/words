                                "target_lang_word": "track down",
                                "target_lang_sense_clarification": "to find after an active search"
                            },
                            {
                                "target_lang_word": "spot",
                                "target_lang_sense_clarification": "to detect or identify visually or by equipment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a2ec853-3190-3f40-a1db-a95db57fc500",
                    "sense_definition": "przyzwyczajać się do nowej sytuacji, otoczenia lub uświadamiać sobie własną tożsamość i powołanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finding_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody pracownik z trudem <w>odnajduje</w> się w dużej korporacji międzynarodowej.",
                            "target_lang_translations": {
                                "en": "The young employee is having a hard time <w>finding his feet</w> in a large international corporation."
                            }
                        },
                        {
                            "text": "Ona szybko <w>odnajduje</w> się w nowej roli lidera zespołu projektowego.",
                            "target_lang_translations": {
                                "en": "She is quickly <w>settling into</w> her new role as a project team leader."
                            }
                        }
                    ],
                    "synonyms": [
                        "aklimatyzować się"
                    ],
                    "common_phrases": [
                        "odnajdywać się w nowej roli",
                        "odnajdywać się w sytuacji"
                    ],
                    "target_lang_definitions": {
                        "en": "to adapt to a new situation or surroundings, or to discover one's purpose or identity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "find one's feet",
                                "target_lang_sense_clarification": "to become confident in a new situation"
                            },
                            {
                                "target_lang_word": "settle in",
                                "target_lang_sense_clarification": "to adapt to new surroundings"
                            },
                            {
                                "target_lang_word": "fit in",
                                "target_lang_sense_clarification": "to feel comfortable in an environment"
                            }
                        ]
                    }
                },
                {
