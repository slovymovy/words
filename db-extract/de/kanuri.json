                "senses": [
                    {
                        "sense_id": "964acb4d-249a-361b-b641-bcd2a5fd2a26",
                        "entry_id": "588caf5f-c600-363f-a1f6-89c19951f781",
                        "glosses": [
                            "eine saharanische Sprache oder Sprachgruppe, die von etwa 4,5 Millionen Menschen in der Tschadsee-Region gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24002ca7-ba21-4638-b0fe-e1dfb2b65597",
                                "sense_id": "964acb4d-249a-361b-b641-bcd2a5fd2a26",
                                "text": "„Kanuri wird von etwa zehn Millionen Menschen in Nigeria, Kamerun, Niger und Tschad gesprochen.“"
                            },
                            {
                                "example_id": "f2906170-a439-4f25-b90f-0f5c78ff8ad9",
                                "sense_id": "964acb4d-249a-361b-b641-bcd2a5fd2a26",
                                "text": "„Als er zum ersten Mal auf Kanuri stieß, war der Deutsch-Österreicher Cyffer verwundert, dass einer so weit verbreiteten Sprache bisher kaum wissenschaftliche Aufmerksamkeit zuteil geworden war.“"
                            },
                            {
                                "example_id": "31cfef2e-53d5-4866-9a4b-e6efa67739f6",
                                "sense_id": "964acb4d-249a-361b-b641-bcd2a5fd2a26",
                                "text": "[Er verbrachte] „mehr als vier Jahrzehnte mit dem Studium der Grammatik, der Sprachdokumentation und der Rolle von Kanuri als Zweitsprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
