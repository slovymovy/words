                        "examples": [
                            {
                                "example_id": "db9e22ec-de80-4a5c-b6ad-ba85db36c8eb",
                                "sense_id": "7cd6c261-924f-3eb0-ba5a-3c17e5b77de2",
                                "text": "„Großfußhühner schichten Haufen von Pflanzenteilen auf und lassen die darin vergrabenen Eier durch die Zersetzungswärme der Fäulnis ausbrüten.“"
                            },
                            {
                                "example_id": "f4b04983-6b19-4412-9ff4-9e1805418afb",
                                "sense_id": "7cd6c261-924f-3eb0-ba5a-3c17e5b77de2",
                                "text": "„Zu allen Zeiten und in allen Kulturen nutzte der Mensch Pflanzen oder Pflanzenteile, um Geschmack und Aroma von Speisen und Getränken zu verbessern.“"
                            }
                        ],
