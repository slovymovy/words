                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "d4fd4ea5-f287-49ba-ab66-1f61d659516f",
                                "sense_id": "181dc474-3b5d-37d3-aadc-669934869eb4",
                                "text": "Le nganga lui avait sans doute redonné la place perdue dans l’ordre cosmique, social et familial antérieur, mais avait échoué à armer ce jeune homme pour la vie de collège et donc son avenir."
                            },
                            {
                                "example_id": "97d15e23-b510-43fa-8a5b-3b5f6db9c844",
                                "sense_id": "181dc474-3b5d-37d3-aadc-669934869eb4",
                                "text": "Le pouvoir des nganga est emblématique au Congo comme d’ailleurs dans toute l’Afrique."
                            },
                            {
                                "example_id": "0324a023-a93a-43a2-970f-07e863379b99",
                                "sense_id": "181dc474-3b5d-37d3-aadc-669934869eb4",
                                "text": "Bien que teinté des préjugés de son époque, Cavazzi indique sans équivoque que le nganga est l’intermédiaire entre les hommes et les idoles."
                            }
                        ]
                    }
