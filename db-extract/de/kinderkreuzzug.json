                "senses": [
                    {
                        "sense_id": "738d4398-356f-35a3-8793-df2f30540014",
                        "entry_id": "ad0111df-4d7c-3d13-8722-ced5786819c7",
                        "glosses": [
                            "Children's Crusade (episode of popular crusading in 1212, traditionally misunderstood as mainly perpetrated by children)"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "83a2c258-6d5c-432e-9cf7-f94ef33d32d9",
                                "sense_id": "738d4398-356f-35a3-8793-df2f30540014",
                                "text": "Schnee fiel, als man sich's erzählte / In einer östlichen Stadt / Von einem Kinderkreuzzug / Der in Polen begonnen hat."
                            },
                            {
                                "example_id": "fad7a821-e208-4a6e-bc45-8c0d7d9a09d4",
                                "sense_id": "738d4398-356f-35a3-8793-df2f30540014",
                                "text": "Ihr moralischer Eifer, die sektenhafte Gewissheit, die humorfreie Klarheit, für die richtige Sache zu kämpfen, wirken wie ein hipper Öko-Kinderkreuzzug."
                            }
                        ]
                    }
                ],
