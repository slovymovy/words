                "senses": [
                    {
                        "sense_id": "1cc89305-19ec-3b99-b7bf-fc4991c046f9",
                        "entry_id": "4caa2b6b-b7ba-3c77-bb79-7f8fd7b6d433",
                        "glosses": [
                            "Teich in einem Dorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd190666-f522-44f0-9d32-508c9ff4e54f",
                                "sense_id": "1cc89305-19ec-3b99-b7bf-fc4991c046f9",
                                "text": "„Der Weg zum Hof führt am Dorfteich vorbei.“"
                            },
                            {
                                "example_id": "ad899d6c-c613-4714-b592-812c631aaa18",
                                "sense_id": "1cc89305-19ec-3b99-b7bf-fc4991c046f9",
                                "text": "„Die Häuschen und Gehöfte gruppieren sich um eine Asphaltstraße, die sich hinter dem Dorfteich gabelt: ein ehemaliges Gutsdorf mit Försterei ohne eigene Kirche und Kretscham.“"
                            },
                            {
                                "example_id": "376b5f8c-77a8-448d-8c02-1aac82000bc8",
                                "sense_id": "1cc89305-19ec-3b99-b7bf-fc4991c046f9",
                                "text": "„Am vermoderten Dorfteich haben wir im Sommer zwei oder drei Libellen.“"
                            },
                            {
                                "example_id": "ce098f53-55d7-40a8-a030-49aae7b38052",
                                "sense_id": "1cc89305-19ec-3b99-b7bf-fc4991c046f9",
                                "text": "„Auf dem zugefrorenen Dorfteich kamen die Schlittschuhe zu Ehren, am Hang der Fohlenkoppel die Rodelschlitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
