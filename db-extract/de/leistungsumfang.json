                        "source_sense_id": "9e09cae0-885f-3cf1-8d88-c1f31912bcee",
                        "source_sense_description": "Art und Menge der zu erbringenden Dienstleistungen oder Waren",
                        "target_lang_word": "service level",
                        "target_lang_code": "en",
