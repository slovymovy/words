                {
                    "sense_id": "b3db1895-b31a-3dc9-8a86-ef42816b564a",
                    "sense_definition": "Осознать, понять что-либо или обнаружить какое-то качество.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты скоро <увидишь>, что я был прав в этом споре.",
                            "target_lang_translations": {
                                "en": "You will soon <w>see</w> that I was right in this argument.",
                                "de": "Du wirst bald <w>sehen</w>, dass ich in diesem Streit recht hatte.",
                                "zh": "你很快就会<w>明白</w>我在这次争论中是对的。",
                                "nl": "Je zult snel <w>zien</w> dat ik gelijk had in deze discussie.",
                                "pl": "Wkrótce <w>zrozumiesz</w>, że miałem rację w tym sporze.",
                                "fr": "Tu <w>verras</w> bientôt que j'avais raison dans cette dispute.",
                                "it": "Presto <w>vedrai</w> che avevo ragione in questa discussione.",
                                "cs": "Brzy <w>uvidíš</w>, že jsem měl v té hádce pravdu.",
                                "tr": "Bu tartışmada haklı olduğumu yakında <w>göreceksin</w>.",
                                "es": "Pronto <w>verás</w> que tenía razón en esta discusión."
                            }
                        },
                        {
                            "text": "В его поступке можно <увидеть> глубокий смысл.",
                            "target_lang_translations": {
                                "en": "One can <w>see</w> deep meaning in his action.",
                                "de": "In seiner Handlung kann man einen tiefen Sinn <w>erkennen</w>.",
                                "zh": "在他的行为中可以<w>看出</w>深层的含义。",
                                "nl": "In zijn daad kun je een diepere betekenis <w>zien</w>.",
                                "pl": "W jego czynie można <w>dostrzec</w> głęboki sens.",
                                "fr": "On peut <w>voir</w> un sens profond dans son action.",
                                "it": "Nel suo gesto si può <w>vedere</w> un significato profondo.",
                                "cs": "V jeho činu lze <w>uvidět</w> hluboký smysl.",
                                "tr": "Onun davranışında derin bir anlam <w>görebilirsin</w>.",
                                "es": "En su acción se puede <w>ver</w> un significado profundo."
                            }
                        }
