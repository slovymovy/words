                ],
                "senses": [
                    {
                        "sense_id": "f3f0eabe-fce2-3aec-99e8-c2f7047a02a2",
                        "entry_id": "4ddcb6e1-422b-3def-8b68-d5b9109939a6",
                        "glosses": [
                            "Eigenschaft, frech, respektlos und dumm zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec64dd7-55c6-4be4-ac4b-ba337c4606be",
                                "sense_id": "f3f0eabe-fce2-3aec-99e8-c2f7047a02a2",
                                "text": "„Bei alle dem war dieser eine ein unbesonnener Mensch, seine That war nicht Kühnheit, sondern Dummdreistigkeit.“"
                            },
                            {
                                "example_id": "310b0bdf-2c9b-4ac3-95e5-225a3d3ca9d0",
                                "sense_id": "f3f0eabe-fce2-3aec-99e8-c2f7047a02a2",
                                "text": "„Eine ihm ganz eigenthümliche Dummdreistigkeit und Tölpelhaftigkeit machte ihn in Rollen, wo diese angebracht waren, unwiderstehlich.“"
                            },
                            {
                                "example_id": "7a4765db-c1f9-46b5-b6dd-b9834c333682",
                                "sense_id": "f3f0eabe-fce2-3aec-99e8-c2f7047a02a2",
                                "text": "„Er beklagte die Leichtfertigkeit und Dummdreistigkeit, mit der man seinen Standpunkt verurteilte, ohne ihn zu kennen.“"
                            },
                            {
                                "example_id": "5c4819d8-e0ce-4b7f-a52a-24e2b72d6062",
                                "sense_id": "f3f0eabe-fce2-3aec-99e8-c2f7047a02a2",
                                "text": "„Bremens Antwort kam von Willi Lemke: ‚Seine Aussagen sind eine Frechheit und an Dummdreistigkeit nicht zu überbieten. […]‘“"
                            },
                            {
                                "example_id": "6ba6d1ca-8078-42a4-b524-c35fbd8fd813",
                                "sense_id": "f3f0eabe-fce2-3aec-99e8-c2f7047a02a2",
                                "text": "„Der fraktionslose Europaabgeordnete Sonneborn nannte den Bescheid ‚offensichtlich Unsinn‘, er sei von Unkenntnis und Dummdreistigkeit geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6bfb04e5-d6f7-3545-b612-8c2e4835a40e",
                        "entry_id": "4ddcb6e1-422b-3def-8b68-d5b9109939a6",
                        "glosses": [
                            "etwas, das Frechheit, Respektlosigkeit und Dummheit zum Ausdruck bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dcb3a97-ab61-40fc-8e69-897fb869d403",
                                "sense_id": "6bfb04e5-d6f7-3545-b612-8c2e4835a40e",
                                "text": "„Nicht einmal laut lachen oder spotten über die Arroganz, Lächerlichkeiten, Frechheiten und Dummdreistigkeiten anderer dürfen wir, Toleranz heißt das Wort!“"
                            },
                            {
                                "example_id": "9f8e4f94-ffac-491e-8a8a-e3665882d9a5",
                                "sense_id": "6bfb04e5-d6f7-3545-b612-8c2e4835a40e",
                                "text": "„Alle Alpenkenner stimmen darin überein, daß es zwei Arten von Dummdreistigkeiten giebt, welche den schärfsten Tadel verdienen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
