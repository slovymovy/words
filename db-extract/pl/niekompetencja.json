                "senses": [
                    {
                        "sense_id": "a5ed0263-51bd-3449-bc65-68711454c35c",
                        "entry_id": "2a51ae48-b111-3547-90d4-d28a46f6c93c",
                        "glosses": [
                            "brak odpowiednich kompetencji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bda6215-9585-4ff3-bb63-8405df7977ea",
                                "sense_id": "a5ed0263-51bd-3449-bc65-68711454c35c",
                                "text": "Takiej tępoty, połączonej z niekompetencją, bezinteresownym szkodnictwem lub zawiścią, zakłamaniem i zwykłym łajdactwem dawno nie widziałem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc982a0e-f1a6-491d-9361-0226978ba24d",
                        "source_entry_id": "2a51ae48-b111-3547-90d4-d28a46f6c93c",
                        "source_sense_id": "a5ed0263-51bd-3449-bc65-68711454c35c",
                        "target_lang_word": "incompetence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incompetence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                        "entry_id": "a1c4bc9b-77ec-3e7a-8c7f-4015bb17ed40",
                                        "glosses": [
                                            "Inability to perform; lack of competence; ineptitude."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7f77d79-a925-484e-8f07-f0ff5bc90ffa",
                                                "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                                "text": "... at the head of a crew, too, chiefly made up of mongrel renegades, and castaways, and cannibals--morally enfeebled also, by the incompetence of mere unaided virtue or right-mindedness in Starbuck"
                                            },
                                            {
                                                "example_id": "385e0352-ebbf-4b20-9739-c967ac365621",
                                                "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                                "text": "Winston did not know why Withers had been disgraced. Perhaps it was for corruption or incompetence. Perhaps Big Brother was merely getting rid of a too-popular subordinate."
                                            },
                                            {
                                                "example_id": "1b0bb71f-3ee4-46fc-81ec-2b24a3e7e719",
                                                "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                                "text": "The factory where she worked was a poisonous mass of incompetence, favoritism, and sabotage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66efadfc-2d97-435f-8edc-f16bcbfbbe13",
                        "source_entry_id": "2a51ae48-b111-3547-90d4-d28a46f6c93c",
                        "source_sense_id": "a5ed0263-51bd-3449-bc65-68711454c35c",
