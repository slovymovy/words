                                            {
                                                "example_id": "cb1d086a-2377-4934-a6e3-8ea6730bade6",
                                                "sense_id": "c3cb2de9-dff9-3d07-a9cc-5ef625f329f5",
                                                "text": "Die Salbe enthält ein(en) Extrakt aus Orchideenblüten."
                                            },
                                            {
                                                "example_id": "60aa2ce0-d10a-40ac-9f26-c3ca35edad90",
                                                "sense_id": "c3cb2de9-dff9-3d07-a9cc-5ef625f329f5",
                                                "text": "„Anfang dieses Jahres war Eugen auf die Idee verfallen, einen Extrakt aus der Wurzel dem Kollodion beizumischen, mit dem er die photographischen Platten behandelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17a3f46d-9b31-374d-b3fa-0afc1c81a5fa",
                                        "entry_id": "c1c758a6-98f8-3205-97ee-5066425b3f43",
                                        "glosses": [
