                        "ru": [
                            {
                                "target_lang_word": "вратарская площадка",
                                "target_lang_sense_clarification": "в хоккее или лакроссе"
                            },
                            {
                                "target_lang_word": "площадь ворот",
                                "target_lang_sense_clarification": "зона перед воротами"
