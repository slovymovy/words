{
    "word_family": [
        "wegen",
        "weging",
        "beweging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a162334-d1e7-311c-befc-3f50f54647e0",
                    "sense_definition": "Veranderen van positie of houding; in beweging komen of brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilde niet <w>verwegen</w> toen de storm opstak. ",
                            "target_lang_translations": {
                                "en": "She did not want to <w>move</w> when the storm blew up."
                            }
                        },
                        {
                            "text": "Je moet geen vinger <w>verwegen</w> tijdens het nemen van de foto.",
                            "target_lang_translations": {
                                "en": "You must not <w>stir</w> a finger while taking the photo."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegen",
                        "verroeren"
                    ],
                    "common_phrases": [
                        "geen vinger verwegen",
                        "niet kunnen verwegen"
                    ],
                    "target_lang_definitions": {
                        "en": "To change position or posture; to set or get into motion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to change position"
                            },
                            {
                                "target_lang_word": "budge",
                                "target_lang_sense_clarification": "to make a slight movement"
                            },
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to begin to move"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a51f1aa-d878-305f-a8db-00ab272e6775",
                    "sense_definition": "Van plaats veranderen; lichtjes bewegen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze konden met al hun inspanning de zware stang verwikken noch <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "Despite all their effort, they could neither budge nor <w>move</w> the heavy bar."
                            }
                        },
                        {
                            "text": "Het paard weigerde ook maar een stap te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "The horse refused to <w>budge</w> even a single step."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegen",
                        "verroeren"
                    ],
                    "common_phrases": [
                        "verwikken noch verwegen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "wordt meestal gebruikt in de vaste uitdrukking 'verwikken noch verwegen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To change location slightly; to make a small movement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "budge",
                                "target_lang_sense_clarification": "to move even a little"
                            },
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to make a slight motion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4100d2b3-f1d4-3c1a-bb05-feba17485463",
                    "sense_definition": "Opnieuw of nog een keer wegen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De apotheker moest het ingrediënt <w>verwegen</w> om zeker te zijn van de dosis.",
                            "target_lang_translations": {
                                "en": "The pharmacist had to <w>reweigh</w> the ingredient to be sure of the dose."
                            }
                        },
                        {
                            "text": "Na de controle besloot men het pakket te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "After the check, they decided to <w>weigh</w> the package <w>again</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "opnieuw verwegen"
                    ],
                    "target_lang_definitions": {
                        "en": "To weigh again or one more time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reweigh",
                                "target_lang_sense_clarification": "to weigh something again"
                            },
                            {
                                "target_lang_word": "weigh again",
                                "target_lang_sense_clarification": "to measure weight a second time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a815e7a9-1f59-3548-acb3-7df21e83e28e",
                    "sense_definition": "Te veel wegen; het toegestane of verwachte gewicht overschrijden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het voertuig bleek bij de controle ernstig te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "During the inspection, the vehicle turned out to <w>be</w> severely <w>overweight</w>."
                            }
                        },
                        {
                            "text": "De koffer mag niet <w>verwegen</w> om extra kosten te vermijden.",
                            "target_lang_translations": {
                                "en": "The suitcase must not <w>exceed weight limits</w> to avoid extra costs."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To weigh too much; to exceed the allowed or expected weight."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overweigh",
                                "target_lang_sense_clarification": "to exceed weight limit"
                            },
                            {
                                "target_lang_word": "be overweight",
                                "target_lang_sense_clarification": "to weigh more than allowed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed4ddd06-438d-3a8f-886d-428d2d551452",
                    "sense_definition": "Zwaarder zijn dan iets of iemand anders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het eerste voorstel lijkt het tweede duidelijk te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "The first proposal clearly seems to <w>outweigh</w> the second."
                            }
                        },
                        {
                            "text": "In massa kan deze steen alle andere <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "In mass, this stone can <w>outweigh</w> all the others."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be heavier than another thing or person; to outweigh."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outweigh",
                                "target_lang_sense_clarification": "to be heavier than"
                            },
                            {
                                "target_lang_word": "overweigh",
                                "target_lang_sense_clarification": "to exceed in weight"
                            }
                        ]
