                "senses": [
                    {
                        "sense_id": "042ba67f-4ee4-3c99-aa0a-84e11fc07cba",
                        "entry_id": "44312a54-251a-3b75-ae23-2c22cb715c21",
                        "glosses": [
                            "страд. прич. прош. вр. от потрепать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "3b5dd6d7-5d5c-49d7-8dc5-f59dbdac9401",
                                "sense_id": "042ba67f-4ee4-3c99-aa0a-84e11fc07cba",
                                "text": "В руках у него был бархатный берет с петушьим потрёпанным пером."
                            },
                            {
                                "example_id": "609b1f2b-0f8d-40ec-8fc2-73e167c739fe",
                                "sense_id": "042ba67f-4ee4-3c99-aa0a-84e11fc07cba",
                                "text": "Стеклов, не заглядывая в толстый, потрёпанный жизнью талмуд, сказал знакомое: «Продляем на неделю галоперидол и хинидин», — и отодвинул карту на край стола."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d38e320-787b-47f4-ba89-de4dcccdafc6",
                        "source_entry_id": "44312a54-251a-3b75-ae23-2c22cb715c21",
                        "source_sense_id": "042ba67f-4ee4-3c99-aa0a-84e11fc07cba",
                        "target_lang_word": "tattered",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tattered",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15aded6d-c922-3e75-bc1c-91fa6b963f01",
                                        "entry_id": "d6839904-1f8d-3c3c-b2e2-de2d42d43c62",
                                        "glosses": [
                                            "Rent in tatters, torn, hanging in rags; ragged."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f08b9c-c402-475e-b445-14d189ae980c",
                                                "sense_id": "15aded6d-c922-3e75-bc1c-91fa6b963f01",
                                                "text": "The chattering, irrational brute of the subconscious clothes itself in the tattered garments of rationality and idealism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97ba671-58e6-3b5e-ac08-d3279be65d53",
                                        "entry_id": "d6839904-1f8d-3c3c-b2e2-de2d42d43c62",
                                        "glosses": [
                                            "Dressed in tatters or rags; ragged."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7739066-caf2-44f4-9349-23f6440c559f",
                                                "sense_id": "d97ba671-58e6-3b5e-ac08-d3279be65d53",
                                                "text": "This is the Prieſt all ſhaven and ſhorn, that married the man all tattered and torn[.]"
                                            },
                                            {
                                                "example_id": "085901f1-4b0b-443c-b9ac-e4e67ceef281",
                                                "sense_id": "d97ba671-58e6-3b5e-ac08-d3279be65d53",
                                                "text": "The tattered man waved his hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87acfd54-8da3-3a54-a2d0-53df06f15fc2",
                                        "entry_id": "d6839904-1f8d-3c3c-b2e2-de2d42d43c62",
                                        "glosses": [
                                            "Dilapidated; showing gaps or breaks; jagged; broken."
