                ],
                "senses": [
                    {
                        "sense_id": "0d35cd93-27cc-32ee-b3e6-5865b02a8026",
                        "entry_id": "a7805737-5722-379f-915f-cf6d9cffadbc",
                        "glosses": [
                            "cecha tego, kto jest bezmyślny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "040ce47e-d2bf-499f-8f85-71daccfee582",
                                "sense_id": "0d35cd93-27cc-32ee-b3e6-5865b02a8026",
                                "text": "Nie dość, że pił, to jeszcze nie zapiął pasów i jechał bez włączonych świateł – to podręcznikowy przykład bezmyślności za kierownicą samochodu!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "877f346f-e2cf-4c8f-92dc-2db5b36ad7a6",
                        "source_entry_id": "a7805737-5722-379f-915f-cf6d9cffadbc",
                        "source_sense_id": "0d35cd93-27cc-32ee-b3e6-5865b02a8026",
                        "target_lang_word": "Gedankenlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedankenlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7783d21a-a1b5-33a0-a750-209765a17385",
                                        "entry_id": "dbc11627-52e7-3130-ac9b-e19f7f48ac31",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße ein Verhalten frei von Rücksichten und Verantwortungsübernahme zeigt, das zudem frei von Gedanken an negative Konsequenzen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59291098-0ed3-4121-a79f-7aa7d812bcab",
                                                "sense_id": "7783d21a-a1b5-33a0-a750-209765a17385",
                                                "text": "Aus Gedankenlosigkeit knallte sie die Kellertür einfach hinter sich zu, vergessend, dass diese dann von außen nicht mehr zu öffnen war."
                                            },
                                            {
                                                "example_id": "418e5b35-cc0f-4de1-8d28-77d3da16da28",
                                                "sense_id": "7783d21a-a1b5-33a0-a750-209765a17385",
                                                "text": "„Später ist es mir wie Schuppen von den Augen gefallen: All die Lieblosigkeiten: dieser dämliche Ehetest zum Beispiel, oder die Gedankenlosigkeiten: das goldene Feuerzeug zu meinem Geburtstag. Ich und ein protziges Feuerzeug!“"
                                            },
                                            {
                                                "example_id": "2a4ae24d-2909-4bee-b1cf-11c22f556db0",
                                                "sense_id": "7783d21a-a1b5-33a0-a750-209765a17385",
                                                "text": "„In den Witzen, die wir bisher von Graf Bobby erzählten, beruhte die Pointe auf seiner Gedankenlosigkeit.“"
                                            },
                                            {
                                                "example_id": "ddbba8fd-4326-419d-a27f-78098d249ce5",
                                                "sense_id": "7783d21a-a1b5-33a0-a750-209765a17385",
                                                "text": "„Während wir an sonnigen Septembertagen mit der Gedankenlosigkeit des Massenmenschen im Freien Kaffee trinken, stehen seine Schaufensterpuppen bereits bis an die Knie im Pulverschnee und kämpfen mit Ohrenschützern, schafwollenen Fäustlingen und gewinnendem Lächeln gegen polare Frosteinbrüche.“"
                                            },
                                            {
                                                "example_id": "131d86a5-55e5-45f4-b2ce-dcf05b4d05a4",
                                                "sense_id": "7783d21a-a1b5-33a0-a750-209765a17385",
                                                "text": "„Ich konnte mich damals in einen Zustand künstlicher Gedankenlosigkeit versetzen, der fast etwas mit Autosuggestion zu tun hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40315b36-9445-4d72-8251-b900f067b58a",
                        "source_entry_id": "a7805737-5722-379f-915f-cf6d9cffadbc",
                        "source_sense_id": "0d35cd93-27cc-32ee-b3e6-5865b02a8026",
                        "target_lang_word": "легкомыслие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "легкомыслие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab639ba-d1c2-39fb-a27e-afb31372cffb",
                                        "entry_id": "1081a48b-daf1-32a2-bf30-6c460f9fc00c",
                                        "glosses": [
                                            "необдуманность, несерьёзность, опрометчивость в словах и поступках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db40d1b4-b0e4-4268-91ba-e43b1521c881",
                                                "sense_id": "9ab639ba-d1c2-39fb-a27e-afb31372cffb",
                                                "text": "…Я просто спешил прожить день до вечера; зато ночью я спал… детское легкомыслие мне помогало."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b6a9795-cbee-3964-bcb1-605d743256ca",
                                        "entry_id": "1081a48b-daf1-32a2-bf30-6c460f9fc00c",
                                        "glosses": [
                                            "отсутствие моральной твёрдости, строгости в поведении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff15d3c7-9229-42d2-b835-0f929217a4ef",
                                                "sense_id": "8b6a9795-cbee-3964-bcb1-605d743256ca",
                                                "text": "Ничто не могло сравниться с вольным легкомыслием, безумством и роскошью французов того времени."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
