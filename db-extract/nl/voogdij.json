                            {
                                "example_id": "87e2051d-6e7a-4ab1-9abe-3b19cc4e6abf",
                                "sense_id": "421d1ca3-484a-323e-b6c4-58e35e673084",
                                "text": "Onder voogdij plaatsen.",
                                "translation": "Placer, mettre sous tutelle."
                            },
                            {
                                "example_id": "c20ad59d-66e6-40ac-9fec-ef5eaa5ee3cc",
                                "sense_id": "421d1ca3-484a-323e-b6c4-58e35e673084",
                                "text": "Van de voogdij ontslaan.",
                                "translation": "Décharger de la tutelle."
                            },
