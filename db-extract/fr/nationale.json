                ],
                "senses": [
                    {
                        "sense_id": "14d92561-0685-399a-adfe-8955b0a7afda",
                        "entry_id": "a40454f8-895d-3135-a1dd-5c5541b9588c",
                        "glosses": [
                            "Femme membre d’une nation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4950c797-e612-38ef-b4a2-04411bacd394",
                        "entry_id": "a40454f8-895d-3135-a1dd-5c5541b9588c",
                        "glosses": [
                            "Route nationale."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "03d8e213-5f69-4ebd-a6b9-a520b52c4e55",
                                "sense_id": "4950c797-e612-38ef-b4a2-04411bacd394",
                                "text": "La Nationale 59 bis, c'est d'elle qu'il s'agit, est bonne, sans cailloux ou nids de poules, car les Ponts et Chaussées l'ont dotée d'un tapis de goudron en 1929 mettant fin à un chemin de terre, renforcé de temps en temps par des cylindrages."
                            },
                            {
                                "example_id": "1808538e-f6fb-4e22-9301-9437d52987da",
                                "sense_id": "4950c797-e612-38ef-b4a2-04411bacd394",
                                "text": "La vraie panique surgit lorsque je me rendis compte que je ne traversais plus que des villages coupés en deux par la nationale, où les commerces se faisaient rares, à peine un café de temps en temps ou une baraque à frites, et que, autour de moi la verdure gagnait, […]."
                            },
                            {
                                "example_id": "e82ac0cc-8451-4963-a3de-efe58cfec63f",
                                "sense_id": "4950c797-e612-38ef-b4a2-04411bacd394",
                                "text": "Quand l’ennemi majeur devint l’Allemagne, la Marne fut le chemin stratégique des armées et la nationale 7, celui des premiers vacanciers venus du Nord laborieux.."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f65d884-5dd2-38fa-baea-720882ac7732",
                        "entry_id": "a40454f8-895d-3135-a1dd-5c5541b9588c",
                        "glosses": [
                            "La Bibliothèque Nationale, à Paris."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "edff8f95-0d16-4ec4-afba-739e6b639ef0",
                                "sense_id": "8f65d884-5dd2-38fa-baea-720882ac7732",
                                "text": "Mais après une journée passée à la Nationale ou à la Sorbonne, je supportais mal de m’enfermer à la maison."
                            },
                            {
                                "example_id": "346e763a-bbe5-424a-a154-bd3e8d70f6d3",
                                "sense_id": "8f65d884-5dd2-38fa-baea-720882ac7732",
                                "text": "Elle ne remarquerait pas d’abord, flambant sur un rayon de la Nationale, le petit volume tout neuf qui porterait son nom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b97fdc7-ef04-48d3-87ea-d2b7b634f256",
                        "source_entry_id": "a40454f8-895d-3135-a1dd-5c5541b9588c",
                        "source_sense_description": "route",
                        "target_lang_word": "rijksweg",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rijksweg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aca735b1-d91f-3904-b271-8bd9f3b7f675",
                                        "entry_id": "5007bc65-7c61-36bb-b7fd-be803d4a29b6",
                                        "glosses": [
                                            "een meestal grote doorgaande weg die in beheer is van de centrale overheid van een land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32587536-9cd0-47e4-94ef-8fe0d738f1a9",
                                                "sense_id": "aca735b1-d91f-3904-b271-8bd9f3b7f675",
                                                "text": "„De gebiedscommissie stelt zich op het standpunt dat op de … locaties [Charloisse Poort en Vaanplein] plaatsing van een windturbine onacceptabel is. De stapeling van huidige geluids- en stankoverlast en veilligheidsrisicio’s van spoor, rijksweg en havencomplex is nu al dermate belastend voor het woon- en leefmilieu dat plaatsing van een windturbine de problemen alleen maar vergroot. Daarnaast past plaatsing van een windturbine op geen enkele wijze bij de voorgenomen woningbouw …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
