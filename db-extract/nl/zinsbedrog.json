        "nl-extract.jsonl": [
            {
                "entry_id": "9fb7452b-43c1-3b9b-8c37-5d8b3dfb4e3a",
                "word": "zinsbedrog",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc9218e7-1fed-3b40-b6e1-b60462f785a1",
                        "entry_id": "9fb7452b-43c1-3b9b-8c37-5d8b3dfb4e3a",
                        "glosses": [
                            "valse waarneming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cfad9cc-6b60-46fe-b076-fba3dca24709",
                                "sense_id": "bc9218e7-1fed-3b40-b6e1-b60462f785a1",
                                "text": "”Schaduw van de wolf”, haar nieuwe roman, deelt met ”Laatste nacht” het gegeven dat er een bijna onoverbrugbare vreemdheid tussen de romanpersonages bestaat, dat vertrouwdheid en intimiteit vrijwel altijd op inbeelding en zinsbedrog berusten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b7e5dc-7ad4-4be5-8387-81abcd79ee60",
                        "source_entry_id": "9fb7452b-43c1-3b9b-8c37-5d8b3dfb4e3a",
                        "source_sense_id": "bc9218e7-1fed-3b40-b6e1-b60462f785a1",
                        "source_sense_description": "valse waarneming",
                        "target_lang_word": "illusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "Anything that seems to be something that it is not."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3a5635-8004-4b5a-b502-78f5e9c4b120",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "We saw what looked like a tiger among the trees, but it was an illusion caused by the shadows of the branches."
                                            },
                                            {
                                                "example_id": "eb910563-fcd8-4937-b977-c8a6ea0fe405",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "Using artificial additives, scientists can create the illusion of fruit flavours in food."
                                            },
                                            {
                                                "example_id": "26133d74-a744-4879-bfbd-642f05e55509",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "You realize the sun don't go down it's just an illusion caused by the world spinning round."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5153a0d3-f76d-3082-a3e2-0c8ece5c221a",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "A misapprehension; a belief in something that is in fact not true."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a97ead-2363-4097-a53a-659db02e1dc2",
                                                "sense_id": "5153a0d3-f76d-3082-a3e2-0c8ece5c221a",
                                                "text": "Jane has this illusion that John is in love with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d66cfc-17aa-3876-976f-e9d1100c9e72",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "A magician’s trick."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9fd934d-9a22-3943-81fb-5938b9275e4f",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "The state of being deceived or misled."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8a56a7f-8129-4000-a3ed-46019ff31ac6",
                        "source_entry_id": "9fb7452b-43c1-3b9b-8c37-5d8b3dfb4e3a",
                        "source_sense_id": "bc9218e7-1fed-3b40-b6e1-b60462f785a1",
                        "source_sense_description": "valse waarneming",
                        "target_lang_word": "delusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b65c5f67-0aad-3119-891c-416703c18f47",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "A false belief that is resistant to confrontation with actual facts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "The state of being deluded or misled, or process of deluding somebody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb910c6-d85e-452e-a554-79315d527f0b",
                                                "sense_id": "9b48afde-fd00-3bab-a31a-8ebc35a3c155",
                                                "text": "It is far better to grasp the universe as it really is than to persist in delusion, however satisfying and reassuring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "That which is falsely or delusively believed or propagated; false belief; error in belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc44280-25f4-4eed-9fff-eb781113fa77",
                                                "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                                "text": "Hess, always a muddled man though not so doltish as Rosenberg, flew on his own to Britain under the delusion that he could arrange a peace settlement."
                                            },
                                            {
                                                "example_id": "ba01b9b7-0d6d-43e4-9140-a86db0b3ecfd",
                                                "sense_id": "948fe042-766f-3be2-93ea-09570c54c1db",
                                                "text": "“Project Greenlight,” however, bore down on the soft underbelly of the movie business, focusing on the delusions and colossal blunders of first-time directors, seemingly selected as much for their unlovability as their talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6f4064-0880-3ecd-b9f0-70cef3bffd97",
                                        "entry_id": "01f2ba35-7b53-37a6-b287-bf57d0e04947",
                                        "glosses": [
                                            "A fixed, false belief, that will not change, despite evidence to the contrary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
