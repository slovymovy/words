                            {
                                "example_id": "3ccaf394-ae7c-4588-b8b6-654c234eb06d",
                                "sense_id": "c529d97b-99f4-3a11-93e7-a330880fd2c6",
                                "text": "Wenn das Holzfällerhemd überhaupt eine Message hatte, so die, dass man zur Arbeiterklasse gehörte und sich dessen nicht unbedingt schämte.",
                                "translation": "Si la chemise de bûcheron avait un message, c'était que l'on appartenait à la classe ouvrière et que l'on n'en avait pas forcément honte."
                            },
                            {
                                "example_id": "e5ed7be0-c4ea-44dc-9a5e-1c25492ca0bd",
                                "sense_id": "c529d97b-99f4-3a11-93e7-a330880fd2c6",
                                "text": "Dies Wohnzimmer, eine große und freundliche Mansarde mit zwei Fenstern, sah schon nach wenigen Tagen anders aus als zur Zeit, da es von andern Mietern bewohnt gewesen war.",
                                "translation": "Celle-ci, une mansarde spacieuse et agréable, éclairée par deux fenêtres, prit en peu de jours seulement un aspect différent de celui qu’elle avait lorsqu’elle était occupée par d’autres locataires."
                            },
                            {
                                "example_id": "55f4af52-7c46-4fa1-8ef1-4f7aa38b569f",
                                "sense_id": "c529d97b-99f4-3a11-93e7-a330880fd2c6",
                                "text": "Viele Menschen gehen nicht nur wegen akuter Beschwerden zur Zahnärztin oder zum Zahnarzt, sondern auch zu regelmäßigen Vorsorgeuntersuchungen.",
                                "translation": "Beaucoup de gens consultent leur dentiste non seulement pour des problèmes aigus, mais aussi pour des examens préventifs réguliers."
                            }
                        ]
                    }
