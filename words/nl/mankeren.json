{
    "word_family": [
        "mankement",
        "mank"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9595041d-ee6b-39a7-a224-736f413b600b",
                    "sense_definition": "mis zijn of niet in orde zijn met iets of iemand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probleem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat <w>mankeert</w> er met jou vandaag, je kijkt zo verdrietig?",
                            "target_lang_translations": {
                                "en": "What <w>is wrong</w> with you today, you look so sad?"
                            }
                        },
                        {
                            "text": "Ik weet niet wat er <w>mankeert</w> aan deze computer, maar hij start niet op.",
                            "target_lang_translations": {
                                "en": "I don't know what <w>is the matter</w> with this computer, but it won't start."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat mankeert er",
                        "iets mankeren aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to be wrong or not in order with something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be wrong",
                                "target_lang_sense_clarification": "to be incorrect or problematic"
                            },
                            {
                                "target_lang_word": "be the matter",
                                "target_lang_sense_clarification": "to be a problem or issue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0c85eaa-6340-3352-a7bc-a85d3b64bfc0",
                    "sense_definition": "een lichamelijke klacht, ziekte of gebrek hebben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezondheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man <w>mankeert</w> veel aan zijn benen en kan moeilijk lopen.",
                            "target_lang_translations": {
                                "en": "The old man <w>has a lot wrong</w> with his legs and has difficulty walking."
                            }
                        },
                        {
                            "text": "Deze hond <w>mankeert</w> iets aan zijn staart en moet naar de dierenarts.",
                            "target_lang_translations": {
                                "en": "There <w>is something wrong</w> with this dog's tail and he needs to go to the vet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iets mankeren aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a physical complaint, illness, or defect"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be wrong with",
                                "target_lang_sense_clarification": "referring to a physical ailment"
                            },
                            {
                                "target_lang_word": "ail",
                                "target_lang_sense_clarification": "to suffer from a physical problem"
                            },
                            {
                                "target_lang_word": "have something wrong",
                                "target_lang_sense_clarification": "to have a medical or physical issue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73344ac4-2687-3d9f-bfee-df0d654882dc",
                    "sense_definition": "een tekort hebben aan iets noodzakelijks",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>mankeert</w> hun aan een goed leerboek om de taal te leren.",
                            "target_lang_translations": {
                                "en": "They <w>lack</w> a good textbook to learn the language."
                            }
                        },
                        {
                            "text": "Het <w>mankeerde</w> hem aan doorzettingsvermogen om de zware studie af te maken.",
                            "target_lang_translations": {
                                "en": "He <w>lacked</w> the perseverance to finish the difficult study."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mankeren aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a shortage or lack of something necessary"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lack",
                                "target_lang_sense_clarification": "to be short of something needed"
                            },
                            {
                                "target_lang_word": "be lacking",
                                "target_lang_sense_clarification": "to be missing a required quality or item"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a02336b9-b99b-3bb3-87f5-fbc690c2d64d",
                    "sense_definition": "niet op tijd zijn voor een vervoermiddel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "missen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij liep heel hard naar het station, maar <w>mankeerde</w> toch de trein.",
                            "target_lang_translations": {
                                "en": "He ran very fast to the station, but still <w>missed</w> the train."
                            }
                        },
                        {
                            "text": "Door de file <w>mankeerden</w> we de laatste bus naar huis.",
                            "target_lang_translations": {
                                "en": "Because of the traffic jam, we <w>missed</w> the last bus home."
                            }
                        }
                    ],
                    "synonyms": [
                        "missen"
                    ],
                    "common_phrases": [
                        "de trein mankeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vaker gebruikt in bepaalde dialecten of regio's"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to fail to catch a means of transport (regional/dialect)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "to fail to catch a train or bus"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}