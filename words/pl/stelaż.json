                    "sense_definition": "konstrukcja z półek i stojaków służąca do eksponowania towarów lub materiałów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "konstrukcja",
                    "name_type": "no",
                    "examples": [
                        {
