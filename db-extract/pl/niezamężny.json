                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea1461be-4b6c-419e-adbb-bec23ea2f015",
                        "source_entry_id": "c6b49400-2d94-3146-a023-6e1d7a26d0f4",
                        "source_sense_id": "3c6042a4-29b3-3cdc-85c2-5a28007e9346",
                        "target_lang_word": "célibataire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "célibataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                        "entry_id": "efe7bae0-9a11-3fdf-8d3b-9fb59b20a398",
                                        "glosses": [
                                            "Personne en âge d’être mariée, mais qui ne l’est pas et qui ne l’a jamais été."
                                        ],
                                        "tags": [
                                            "Famille",
                                            "Droit administratif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b08f721-e931-4b62-a801-e180da08b0d4",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "N’y aurait-il pas de moyens d’y mettre ordre, de faire en sorte d’encourager les mariages, et de diminuer le nombre excessif des célibataires dans toutes les classes de citoyens ?"
                                            },
                                            {
                                                "example_id": "6a829539-d3a1-4c54-85a2-69012a52072a",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "Par suite de leur isolement, et poussés par cette nécessité morale de s’intéresser à quelque chose, les célibataires sont conduits à remplacer les affections naturelles par des affections factices, à aimer des chiens, des chats, des serins, leur servante ou leur directeur."
                                            },
                                            {
                                                "example_id": "31f0a86c-6566-4cea-835a-0144cfcfbc74",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "Ce portrait de femme, coécrit avec François Decodts, laisse la part belle aux hommes visitant la vie de cette célibataire qui a tenté de mener de front carrière et maternité."
                                            },
                                            {
                                                "example_id": "ef6547b7-137c-4736-9f44-f697726623eb",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "Cet intérieur de célibataire, tout de même, ça manquait de ménage. Cette table de bois nu, lamais lessivée sans doute, et ce papier des murs méritait d'être changé."
                                            },
                                            {
                                                "example_id": "1cfbb6d1-6e80-4f08-9b5f-63777970ca31",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "Les gens mariés vieillissent plus vite que les célibataires. C'est l’histoire de la goutte d’eau qui, tombant sans relâche à la même place, finit par creuser le granit."
                                            },
                                            {
                                                "example_id": "dc60ed20-3a6b-4c6d-83e8-4d6e7ef0cab4",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "L’éminent gastronome Grimod de la Reynière fait chorus, qui déconseille le céleri aux timides, mais le recommande chaudement aux célibataires."
                                            },
                                            {
                                                "example_id": "81e020f9-7945-4da1-910a-97e9264d4098",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "Pendant une soirée entre célibataires, on rigole un bon coup sur les perversions ou lacunes des hommes qu'on a rencontrés. Certaines rêvent de leur prince charmant. Selon la plus délurée d'entre d'elles, il me faut un sexfriend."
                                            },
                                            {
                                                "example_id": "41666078-cdbf-4ed0-80ce-1aac24f48d09",
                                                "sense_id": "d805b753-e689-3d05-abbb-5fefed4df2b4",
                                                "text": "«Même en matière de couple, quand on discute avec les gens [les femmes] qui se plaignent d'être éternellement célibataires, on se rend compte qu'en réalité on s’intéresse à elles, simplement ce n'est pas réciproque.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31f1fa8-620d-35be-a6ab-051159b09b0e",
                                        "entry_id": "efe7bae0-9a11-3fdf-8d3b-9fb59b20a398",
                                        "glosses": [
                                            "Personne sans partenaire amoureux ou sans relation stable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "célibataire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b29cf667-ac6c-3bc7-9cf6-2a1068d85c30",
                                        "entry_id": "5a49a29e-aefc-3900-8ef3-5be12b5adc7a",
                                        "glosses": [
                                            "Qui n’est pas marié, qui ne l'a jamais été et qui est en âge légal de pouvoir l'être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aebad945-8995-4da8-ad7a-f3544e3601e4",
                                                "sense_id": "b29cf667-ac6c-3bc7-9cf6-2a1068d85c30",
                                                "text": "[…]; sans doute, ils ont, eux aussi, certains du moins, des ascendants névrosiques, mais la mysophobie atteint le plus souvent des gens minutieux ou méticuleux par tempérament, par exemple, des vieilles filles ou des garçons âgés, célibataires."
                                            }
                                        ]
                                    },
