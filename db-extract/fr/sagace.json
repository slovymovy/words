                "senses": [
                    {
                        "sense_id": "368c1158-1be8-3eff-9263-77887f7f8fd1",
                        "entry_id": "53e2572a-f58b-3c66-aa08-21e9588f1b75",
                        "glosses": [
                            "Qui est doué de pénétration d’esprit, de sagacité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e899500d-0fe2-47e2-9456-4225c33a15d2",
                                "sense_id": "368c1158-1be8-3eff-9263-77887f7f8fd1",
                                "text": "Ces sagaces animaux devinaient le piège qui leur était tendu, et le plus souvent, creusant le sol près de la trappe, ils parvenaient à s'emparer de l'appât […]."
                            },
                            {
                                "example_id": "ce10ac76-dc83-4fea-a95f-f5ef5b28c67d",
                                "sense_id": "368c1158-1be8-3eff-9263-77887f7f8fd1",
                                "text": "Cette sagace entente de la vie pratique n’a aucun rapport avec les vésanies et les délires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13b23d81-aa9c-4792-926d-1cecb384c845",
                        "source_entry_id": "53e2572a-f58b-3c66-aa08-21e9588f1b75",
