                ],
                "senses": [
                    {
                        "sense_id": "ae2d8ea7-476a-3679-9232-ad963f566543",
                        "entry_id": "11c3282d-450d-38f8-bb67-c4fa03fa8dc6",
                        "glosses": [
                            "ein großer Junge, ältester Sohn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e287e5bf-3f91-4dd6-ba8b-c373c77345b2",
                                "sense_id": "ae2d8ea7-476a-3679-9232-ad963f566543",
                                "text": "Unser Großer hat nur gute Zensuren auf seinem Zeugnis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df4da7f6-0879-38aa-8cad-8a6a5be9bdc6",
                        "entry_id": "11c3282d-450d-38f8-bb67-c4fa03fa8dc6",
                        "glosses": [
                            "ältere, oft erwachsene Person"
                        ],
                        "tags": [
                            "Kindersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "ca64458f-f410-4dea-80bf-ad64157bf587",
                                "sense_id": "df4da7f6-0879-38aa-8cad-8a6a5be9bdc6",
                                "text": "Ich gehe nicht mehr gerne auf den Fußballplatz, die Großen schießen immer so doll."
                            },
                            {
                                "example_id": "da2f4535-6a13-480d-bedf-1daaceaae3a5",
                                "sense_id": "df4da7f6-0879-38aa-8cad-8a6a5be9bdc6",
                                "text": "Wenn die Großen mit dem Kaffeetrinken fertig sind, dürfen wir endlich mit ihnen Fußball spielen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6766a019-525e-3264-8591-2d80a24a033f",
                        "entry_id": "11c3282d-450d-38f8-bb67-c4fa03fa8dc6",
                        "glosses": [
                            "eine große – gesellschaftlich angesehene oder berühmte – Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e380e7-3300-4fa0-83a2-299b9910abf2",
                                "sense_id": "6766a019-525e-3264-8591-2d80a24a033f",
                                "text": "„Wenn ein Großer der Modewelt noch auf handgefertigte Modelle setzt, hat die Haute Couture Zukunft.“"
                            },
                            {
                                "example_id": "45b267b8-95bb-463d-ab81-817b228aba9e",
                                "sense_id": "6766a019-525e-3264-8591-2d80a24a033f",
                                "text": "„Felix Neureuther (20), Sohn von Rosi Mittermaier und Christian Neureuther, stand schon als Kleinkind auf Skiern und ist als Slalom-Spezialist heute ein ganz Großer.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ef674c72-41b4-381c-a1b8-6f3b7db6d9ae",
                        "entry_id": "11c3282d-450d-38f8-bb67-c4fa03fa8dc6",
                        "glosses": [
                            "Beiname als Titel und Würdenbezeichnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1e71ad-4aa8-4e0c-a875-ec3dcfae60ed",
                                "sense_id": "ef674c72-41b4-381c-a1b8-6f3b7db6d9ae",
                                "text": "„Als Beschützer des Papstes und des christlichen Glaubens war Karl der Große sehr darauf bedacht, dass in seinem Reich jeder das Pater Noster (Vaterunser) kannte. Zeitweilig standen “"
                            },
                            {
                                "example_id": "db2db5dd-4937-48c9-b0b8-6ce2f06ed4c7",
                                "sense_id": "ef674c72-41b4-381c-a1b8-6f3b7db6d9ae",
                                "text": "„Friedrich der Große stand während seiner Regierungszeit nachweislich nur einmal im Jahre 1763 einem Künstler als Modell zur Verfügung“"
                            },
                            {
                                "example_id": "a74c92d7-8fde-4409-a221-d91803dfa980",
                                "sense_id": "ef674c72-41b4-381c-a1b8-6f3b7db6d9ae",
                                "text": "Man hat ihn Alexander den Großen genannt, weil er das macedonische Weltreiche gegründet hat."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
