                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "funktionsstoerung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch das schwere Gewitter in der Nacht <w>fiel</w> in mehreren Stadtteilen der Strom <w>aus</w>."
                        },
                        {
                            "text": "Wenn das System plötzlich <w>ausfällt</w>, können die Mitarbeiter ihre Arbeit nicht fortsetzen."
                        }
                    ],
                    "common_phrases": [
