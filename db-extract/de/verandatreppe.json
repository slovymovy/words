                        "examples": [
                            {
                                "example_id": "b537eca0-fa2e-426e-8d28-a51e881a1fda",
                                "sense_id": "5856bece-55a2-3129-a31c-33c059faf0ce",
                                "text": "„Ein Weilchen saß er auf der Verandatreppe.“"
                            },
                            {
                                "example_id": "d51941cb-e59e-4c86-94d7-93bb4e7a9bb4",
                                "sense_id": "5856bece-55a2-3129-a31c-33c059faf0ce",
                                "text": "„Er humpelte die Verandatreppe wieder hinauf, zielte mit der Pistole über die Balustrade und eröffnete das Feuer auf die Männer.“"
                            },
                            {
                                "example_id": "95e9332b-9e41-4e60-9256-c6722f939be0",
                                "sense_id": "5856bece-55a2-3129-a31c-33c059faf0ce",
                                "text": "„Er hörte, wie Lisa die Verandatreppe heraufkam.“"
                            }
                        ],
