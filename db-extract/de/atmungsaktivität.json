                "senses": [
                    {
                        "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                        "entry_id": "f3f49887-044c-31d0-ac6c-25fef0171bb0",
                        "glosses": [
                            "Vorgang, bei dem Wasserdampf durch ein Material hindurch nach außen gelangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bbd5696-f465-4571-9339-924152e6a870",
                                "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                                "text": "„Achten Sie auf eine hohe Atmungsaktivität, die in Gramm pro Quadratmeter pro 24 Stunden (g/m²/24h) angegeben wird.“"
                            },
                            {
                                "example_id": "88618dc7-7366-4300-84f5-ce389eeeebeb",
                                "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                                "text": "„Das Obermaterial dieses Tennisschuhs ist mit einer speziellen Mesh Technologie ausgestattet, die vor allem die Atmungsaktivität fördern soll.“"
                            },
                            {
                                "example_id": "9c3f7604-a1a2-41c2-9bb3-0f8d0f5cdd1a",
                                "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                                "text": "„Zusammengerechnet mit dem Luftdurchlässigkeitsgrad der Membran wurde die Atmungsaktivität berechnet.“"
                            },
                            {
                                "example_id": "79c9d8dd-6925-48db-9764-2ed8e40fe3be",
                                "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                                "text": "„Mit einer Wassersäule von 20.000 mm und einer Atmungsaktivität von 15.000 g/m² garantiert das Texapore Ecosphere Pro Stretch Textile Waste 3L Material zudem Wetterschutz, Komfort und Bewegungsfreiheit.“"
                            },
                            {
                                "example_id": "8abd79e7-982f-4d69-ae55-61c06e454fb4",
                                "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                                "text": "„Hinsichtlich der Materialeigenschaften zeichnet sich die M10 Storm Pants durch Atmungsaktivität, geringes Gewicht, Recyclingfähigkeit und Wasserdichtigkeit aus.“"
                            },
                            {
                                "example_id": "6608b4cb-88c8-4e4d-8333-0d8b11cc9881",
                                "sense_id": "8d78482a-42e0-3c9b-98cf-7732f0276410",
                                "text": "„Mit mehrschichtigen Konstruktionen und integrierten Atmungsmembranen garantieren wir zuverlässigen Schutz vor Wind, ohne dabei die Atmungsaktivität zu beeinträchtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
