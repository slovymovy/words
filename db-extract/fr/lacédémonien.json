                    },
                    {
                        "form_id": "6eee8cbf-da61-4775-99e4-e75963ff3472",
                        "entry_id": "3d96debe-3254-3af4-bfc1-8e06c203770e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Lacédémonienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                        "entry_id": "3d96debe-3254-3af4-bfc1-8e06c203770e",
                        "glosses": [
                            "Habitant de Lacédémone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a35af9-1457-4684-aa08-6b6153ac76d6",
                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                "text": "L’orchestre était doux et faible, par ordre de l’Empereur ; voulant peut-être, comme les Lacédémoniens, être apaisé plutôt qu’excité par la musique."
                            },
                            {
                                "example_id": "68bf06a3-4e8a-4666-b546-1eae6af9936b",
                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                "text": "À Sparte, le vol était pratiqué et honoré : c’était une institution hiératique, un complément indispensable à l’éducation de tout Lacédémonien sérieux."
                            },
                            {
                                "example_id": "b805f153-7f26-4962-9320-e50bc99116ef",
                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                "text": "Au cours de la guerre du Péloponnèse, Thucydide reproduit le discours des Corinthiens aux Lacédémoniens."
                            },
                            {
                                "example_id": "0cc4090a-b8ed-4899-b807-db176327ef9e",
                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                "text": "Si la Grèce, parmi ses artistes, ne compte aucun Lacédémonien, n’est-ce point parce que Sparte précipitait aux oubliettes ses enfants chétifs ?"
                            }
                        ]
                    }
                ],
