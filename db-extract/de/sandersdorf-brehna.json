                                "sense_id": "12eb7d34-5ccf-3ccc-95cf-96f42526d5e2",
                                "text": "Wir haben in Sandersdorf-Brehna unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "1e92095a-12a8-4b74-8c6b-6eab4ec1257c",
                                "sense_id": "12eb7d34-5ccf-3ccc-95cf-96f42526d5e2",
                                "text": "Nach Sandersdorf-Brehna führen viele Wege."
                            },
                            {
                                "example_id": "84ee316a-51c1-4745-880f-034625f30a04",
                                "sense_id": "12eb7d34-5ccf-3ccc-95cf-96f42526d5e2",
                                "text": "Sandersdorf-Brehna liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "1c6ceb6a-6896-4745-8c20-63dd2bd7ed02",
                                "sense_id": "12eb7d34-5ccf-3ccc-95cf-96f42526d5e2",
                                "text": "Das Sandersdorf-Brehna des 18. Jahrhunderts war noch auf keiner Karte zu finden."
