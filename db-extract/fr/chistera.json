                    {
                        "form_id": "baa6691c-9594-4c2c-a7e1-77de8f7b789b",
                        "entry_id": "0d6f6dc0-ba3d-3b0a-8e2d-9611e601199c",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "chistéra"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a8ac61f-a388-383e-8e9b-7a35e58baa0c",
                        "entry_id": "0d6f6dc0-ba3d-3b0a-8e2d-9611e601199c",
                        "glosses": [
                            "Sorte de panier d’osier, fixé au poignet par l'intermédiaire d'un gant plat en cuir, pour renvoyer la balle, au jeu de la pelote basque. Le masculin est souvent d'usage en français malgré sa terminaison en -a et l'influence du féminin en espagnol : una chistera. Un « grand chistera » est toujours au masculin."
                        ],
                        "tags": [
                            "Pays basque",
                            "Pelote basque"
                        ],
                        "examples": [
                            {
                                "example_id": "71cef4b5-cf5e-44e3-b081-9a33c684e184",
                                "sense_id": "1a8ac61f-a388-383e-8e9b-7a35e58baa0c",
                                "text": "Un dernier exemple en 1954 concerne le Sporting : l'organisation du premier championnat de France professionnel à grand chistera."
                            }
                        ]
                    },
                    {
                        "sense_id": "912cf5ce-8afe-3a1d-8e9c-114c7fcec688",
                        "entry_id": "0d6f6dc0-ba3d-3b0a-8e2d-9611e601199c",
                        "glosses": [
                            "Le jeu de pelote basque lui-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f55fb25b-928b-45db-9b4f-d782edf8af7a",
                                "sense_id": "912cf5ce-8afe-3a1d-8e9c-114c7fcec688",
                                "text": "Les matches se disputaient au milieu d'un grand vacarme produit par les cris des parieurs comme les parties de chistera en Espagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f14356c-2f35-3de0-8948-f96610547f88",
                        "entry_id": "0d6f6dc0-ba3d-3b0a-8e2d-9611e601199c",
                        "glosses": [
                            "féminin Une passe effectuée dans le dos, en jetant le bras vers l’arrière, généralement par un demi de mêlée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0b57b589-9e52-40a9-9f87-80474654330d",
                                "sense_id": "7f14356c-2f35-3de0-8948-f96610547f88",
                                "text": "La chistera géniale de Nolann Le Garrec pour Thomas Ramos est l’illustration parfaite de la fraîcheur que voulait apporter Fabien Galthié en faisant entrer huit joueurs dans son XV de départ face au Pays de Galles."
                            }
                        ]
                    }
