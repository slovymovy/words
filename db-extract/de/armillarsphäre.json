                "senses": [
                    {
                        "sense_id": "1988e867-fe63-3bab-ad7d-9598c78a9179",
                        "entry_id": "ef869953-9148-3564-b26e-64d436f0a542",
                        "glosses": [
                            "astronomisches Gerät, das zur Messung von Koordinaten am Himmel und der Darstellung der Bewegung von Himmelskörpern dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a393dddf-73cf-48ee-b62d-b375fb10d92f",
                                "sense_id": "1988e867-fe63-3bab-ad7d-9598c78a9179",
                                "text": "Die Armillarsphäre war lange Zeit das wichtigste astronomische Beobachtungsgerät."
                            },
                            {
                                "example_id": "26f39565-7357-4a00-8b9f-51ae877dbb15",
                                "sense_id": "1988e867-fe63-3bab-ad7d-9598c78a9179",
                                "text": "„Auf seiner Sternwarten-Insel ließ er haushohe Quadranten, Sextanten und Armillarsphären errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52b5108f-0b30-45dc-8b58-bec0d9b3b8e9",
                        "source_entry_id": "ef869953-9148-3564-b26e-64d436f0a542",
                        "source_sense_id": "1988e867-fe63-3bab-ad7d-9598c78a9179",
                        "source_sense_description": "astronomisches Gerät",
                        "target_lang_word": "armillary sphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armillary sphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b15276db-e904-3a22-8ce3-9b0c0e55c942",
                                        "entry_id": "8b5e9661-4431-3b2c-9316-f93415884dfe",
                                        "glosses": [
                                            "An instrument consisting of graduated metal circles used to represent the motions of celestial bodies around the earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b84086b-a6e0-4760-919e-b7a661d0225e",
                                                "sense_id": "b15276db-e904-3a22-8ce3-9b0c0e55c942",
                                                "text": "Most of this bench is covered with tiles of Moorish design, but on the front each is stamped with an armillary sphere in which the axis is yellow, the lines of the equator and tropics green, and the rest blue. These one would certainly take to be of Dom Manoel's time, for the armillary sphere was his emblem, but they are said to be older."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b6998fa-3104-4c2f-a395-e2b8f7fa65d5",
                        "source_entry_id": "ef869953-9148-3564-b26e-64d436f0a542",
                        "source_sense_id": "1988e867-fe63-3bab-ad7d-9598c78a9179",
                        "source_sense_description": "astronomisches Gerät",
                        "target_lang_word": "sphère armillaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphère armillaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a372b58-5d86-3085-bc2b-2967b98dd579",
                                        "entry_id": "5f6e4787-42cf-3f9a-8e27-633a797560b0",
                                        "glosses": [
                                            "Dispositif rond et mobile, composé de divers anneaux ou cercles qui représentent ce que les astronomes anciens imaginaient dans le ciel."
                                        ],
                                        "tags": [
                                            "Archéoastronomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52cdbfd2-ea63-4c86-a452-438a457714cb",
                                                "sense_id": "0a372b58-5d86-3085-bc2b-2967b98dd579",
                                                "text": "Un vieillard vêtu d’une robe de martre leva son visage penché sur un astrolabe fait en manière de sphère armillaire, et clignota de ses paupières rougies, comme un antique oiseau de nuit effaré dans son repaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8c7707-293a-3a83-be76-2da409dc153c",
                                        "entry_id": "5f6e4787-42cf-3f9a-8e27-633a797560b0",
                                        "glosses": [
                                            "Meuble représentant le dispositif du même nom dans les armoiries. Plusieurs représentations se font concurrence mais globalement, elle est représentée par une sphère indiquant les méridiens et les parallèles ainsi qu’un axe posé en bande symbolisant l’écliptique. À rapprocher de globe, monde et sphère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02f5bb0-caa8-4f6a-8bec-1b14766b8da0",
                                                "sense_id": "dd8c7707-293a-3a83-be76-2da409dc153c",
                                                "text": "D’azur à une sphère armillaire d’or, qui est du royaume du Brésil de 1815 à 1822 → voir illustration « armoiries avec une sphère armillaire »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
