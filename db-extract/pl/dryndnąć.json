                        "translation_id": "03c7fae0-c7f1-4a69-9c4e-69d127633276",
                        "source_entry_id": "f9711cb4-2e0a-3d07-83f3-e6769e1291a3",
                        "source_sense_id": "ca5336c4-3d69-36dd-9b3a-62016e817c59",
                        "target_lang_word": "звякнуть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "звякнуть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fb090edc-af34-3186-a7e7-571e7093c6aa",
                                        "entry_id": "a4b88b07-3157-3932-a4a4-8d752a57eff1",
                                        "glosses": [
                                            "однокр. к звякать; издать короткий звонкий звук при ударе (о металлических, стеклянных предметах)"
                                        ],
                                        "tags": [
                                            "semelefactive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2535bb-b647-4cde-8e98-f8d2ee6c6d79",
                                                "sense_id": "fb090edc-af34-3186-a7e7-571e7093c6aa",
                                                "text": "Как только звякнул жестяной звук колокольчика, ему вдруг как будто почудилось, что в комнате пошевелились."
                                            },
                                            {
                                                "example_id": "e4c558ac-4be4-4004-aaaf-054a0adbc082",
                                                "sense_id": "fb090edc-af34-3186-a7e7-571e7093c6aa",
                                                "text": "Вот тётушкины пальцы зашлёпали по ситу, вот звякнули в шкафу тарелки, вот мамалыжная лопатка в чугунке заходила, ― и все эти звуки, я чувствую, означают не только приближение ужина, а что-то большее, может быть, уют домашнего очага, древнюю песню вечернего сбора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b798a98b-7058-3e8a-8944-49a046d525f8",
                                        "entry_id": "a4b88b07-3157-3932-a4a4-8d752a57eff1",
                                        "glosses": [
                                            "однокр. к звякать; произвести, вызвать короткий звонкий звук ударом по металлическому, стеклянному предмету, а также нажав кнопку звонка и т. п."
                                        ],
                                        "tags": [
                                            "semelefactive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "060ca6db-fb55-4165-b40d-7dc9d2d6d684",
                                                "sense_id": "b798a98b-7058-3e8a-8944-49a046d525f8",
                                                "text": "Человечек звякнул ключом и преувеличенным жестом пригласил именитую пару к лифту."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ab68a2-673b-3ebc-bcca-282a343bc2f5",
                                        "entry_id": "a4b88b07-3157-3932-a4a4-8d752a57eff1",
                                        "glosses": [
                                            "однокр. к звякать; разг. позвонить по телефону кому-либо"
                                        ],
                                        "tags": [
                                            "semelefactive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce79428d-e2b5-4a01-8d44-d044923ff3aa",
                                                "sense_id": "59ab68a2-673b-3ebc-bcca-282a343bc2f5",
                                                "text": "— Давай его телефон, я сам ему вечерком звякну."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
