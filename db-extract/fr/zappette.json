                        "cross_references": [
                            {
                                "target_word": "zapper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1336c59a-3e6c-3f09-a535-e5a44ec04bc4",
                                        "entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                                        "glosses": [
                                            "A remote control for a television."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c01e89c5-3438-40ed-bb63-6a2a7b89231b",
                                                "sense_id": "1336c59a-3e6c-3f09-a535-e5a44ec04bc4",
                                                "text": "The news is starting on the other channel; hand me the zapper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98733a9d-6d71-3ab4-a786-c48ea02d9c79",
                                        "entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                                        "glosses": [
                                            "A device that electrifies or electrocutes."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "091b655b-1bf4-40a1-b6ca-222bf244fb1d",
                                                "sense_id": "98733a9d-6d71-3ab4-a786-c48ea02d9c79",
                                                "text": "Miranda is not the sort of person to carry a zapper but she has an oar that would cause a dog a lot more grief if it caught it full on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acf64952-1d96-35c1-ae27-182191c95d28",
                                        "entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                                        "glosses": [
                                            "Anything that exterminates."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0776e3-1eb2-4b61-83f0-2085169186b5",
                                                "sense_id": "acf64952-1d96-35c1-ae27-182191c95d28",
                                                "text": "If games are your life, the choice of a joystick is desperately important. Casual alien-zappers can get by with the cheapest generic Taiwanese clone-stick […]"
                                            },
                                            {
                                                "example_id": "152778ad-f426-4228-9719-4ee8e72f44d9",
                                                "sense_id": "acf64952-1d96-35c1-ae27-182191c95d28",
                                                "text": "You are going to go from being a toxic-thought overreactor to a toxic-thought zapper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc1c11ec-085c-3979-8ed1-3fb74cc80a29",
                                        "entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                                        "glosses": [
                                            "A microwave oven."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ad81dff-17c1-4f83-b56f-907a19d5ad82",
                                                "sense_id": "cc1c11ec-085c-3979-8ed1-3fb74cc80a29",
                                                "text": "I hate to spoil your microwave testimonial, but they were actually cooked in the regular oven this morning and just re-heated in the zapper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
