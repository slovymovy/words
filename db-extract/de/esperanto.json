                ],
                "senses": [
                    {
                        "sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                        "entry_id": "abb25b54-a624-354f-91ec-456551d5dc87",
                        "glosses": [
                            "bedeutendste Plansprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171a13fb-d71b-41df-8271-699e4b2b3c23",
                                "sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                                "text": "Esperanto ist eine Plansprache."
                            },
                            {
                                "example_id": "d3b2e124-86db-47d5-9c69-0dfb32c6c64f",
                                "sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                                "text": "Wie heißt das auf Esperanto?"
                            },
                            {
                                "example_id": "f27b374f-b961-4fde-8d5a-eeee2bbdb5d9",
                                "sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                                "text": "„Niemand muß sich mehr mit Volapük und Esperanto abquälen, wir haben doch das globale Englisch!“"
                            },
                            {
                                "example_id": "f6a96edd-a88d-40c3-a638-39af59d3e853",
                                "sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                                "text": "„Leibniz denkt bei dieser ungeheuerlichen Idee nur nebenher an den Nutzen, den eine einheitliche Menschensprache gewähren könnte; man darf seinen Plan wirklich nicht auf eine Stufe stellen mit den albernen Bestrebungen unserer kleinen Zeitgenossen, die ein Volapük oder Esperanto erfinden, wie Kinder sich eine Erbsensprache erfinden, und die damit wirklich so weit kommen, wie ein Missionar, der das Vaterunser ins Hottentottische übersetzt.“"
                            },
                            {
                                "example_id": "68dc5d64-f7f9-417b-baca-550adb1da52e",
                                "sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                                "text": "„Im Gegensatz zum Volapük bietet Esperanto auch die Möglichkeit, für ästhetische oder literarische Zwecke eingesetzt zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cda64aab-a322-49d9-b401-014364385af3",
                        "source_entry_id": "abb25b54-a624-354f-91ec-456551d5dc87",
                        "source_sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                        "source_sense_description": "bedeutendste Plansprache",
                        "target_lang_word": "Esperanto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esperanto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14722003-b1ad-3c8d-a935-bc7a52292b29",
                                        "entry_id": "e282aba5-c538-3219-9968-c33055396c81",
                                        "glosses": [
                                            "An international auxiliary language designed by L. L. Zamenhof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e453862-db2b-4701-89f8-fbae23cf34a9",
                                                "sense_id": "14722003-b1ad-3c8d-a935-bc7a52292b29",
                                                "text": "Speakers of toki pona have formed a large online community. On Discord, the largest toki pona community claims approximately 13,000 members (as of February 1, 2024), more than the largest Na’vi community at approximately 9,600 members, the largest Interslavic community at approximately 8,000 members, or the largest Esperanto community at approximately 7,400 members."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                        "entry_id": "e282aba5-c538-3219-9968-c33055396c81",
                                        "glosses": [
                                            "Anything that is used as a single international medium in place of plural distinct national media."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b9bd06f-1b9b-45aa-aade-bf3465356cd5",
                                                "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                                "text": "The U.S. dollar is the Esperanto of currency."
                                            },
                                            {
                                                "example_id": "67c4df19-a043-401d-ad59-ed581305335b",
                                                "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                                "text": "[Compared] to the Esperanto of the Eye, [cinema], [Esperanto's] conquest of the Earth is painfully slow[.]"
                                            },
                                            {
                                                "example_id": "594f741c-d889-45cd-ae55-ee096fbd2e64",
                                                "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                                "text": "I think there is increasingly a homogenized voice, an Esperanto in the ear."
                                            },
                                            {
                                                "example_id": "95ab472e-199e-4a76-a9b1-c1f261f422b0",
                                                "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                                "text": "[…]making its usual explicit request in the Esperanto of brutality."
                                            },
                                            {
                                                "example_id": "90eae0dd-0341-471c-814f-59368d722110",
                                                "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                                "text": "The instrument of this dumbing down in Nineteen Eighty-Four was Newspeak, the official language of the English Socialist Party (Ingsoc). Newspeak was a sort of Totalitarian Esperanto that sought gradually to diminish the range of what was thinkable by eliminating, contracting and manufacturing words."
                                            },
                                            {
                                                "example_id": "4c871468-b910-4650-8a27-fadb43ad0bde",
                                                "sense_id": "eb310023-5114-3ba5-b137-c8880e1b6330",
                                                "text": "There may have been a few slippages when the show's American English was translated for foreign audiences—Alerte à Malibu! Mishmar Ha-Mifratz!—but the theme song was pure Esperanto, a joyous surge of energy and desire that was instantly comprehensible from Quito to Tehran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd507f92-963b-442c-b198-944ca87adb25",
                        "source_entry_id": "abb25b54-a624-354f-91ec-456551d5dc87",
                        "source_sense_id": "4898f0b9-3154-3495-9d18-294cd756ca1c",
                        "source_sense_description": "bedeutendste Plansprache",
                        "target_lang_word": "espéranto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espéranto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c24c0b5b-264d-3ff1-ac94-a156b0794cda",
                                        "entry_id": "3f9ff23c-3122-349e-918b-563ad870dde1",
                                        "glosses": [
                                            "Langue construite internationale la plus répandue, amorcée par Ludwik Lejzer Zamenhof dans le but de résoudre les problèmes de communication entre les peuples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c288466-9ae8-4ad8-9778-eada69184258",
                                                "sense_id": "c24c0b5b-264d-3ff1-ac94-a156b0794cda",
                                                "text": "Comme l’écrivait en 1889 Léopold Eistein, un volapükiste allemand passé à l’Esperanto dès l’apparition de cette langue, le progrès de l’humanité est jalonné par sept inventions qui devraient être considérées comme les sept merveilles du Monde, et qui sont : écrire, imprimer, sténographier, […]."
                                            },
                                            {
                                                "example_id": "518282be-158c-478d-b113-3f33b9e33853",
                                                "sense_id": "c24c0b5b-264d-3ff1-ac94-a156b0794cda",
                                                "text": "Sigismond du Ferrus, après avoir cru à l’espéranto, à l’Atlantide, au grand sympathique, au tunnel sous la Manche, au Masque de Fer, à la divination par les nombres, au lavage des sables aurifères de l’Ariège et au reboisement du Sahara, croyait maintenant à la photographie en couleurs."
                                            },
                                            {
                                                "example_id": "5697d50f-f2a9-4400-94f9-ffab2fbb65e0",
                                                "sense_id": "c24c0b5b-264d-3ff1-ac94-a156b0794cda",
                                                "text": "Il y a des gens qui savent ce qu’est l’espéranto, mais ils sont assez rares, et ceux qui savent exactement ce que c’est, ils sont encore plus rares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a8ea8e-2cf0-3969-8c63-52da66c08035",
                                        "entry_id": "3f9ff23c-3122-349e-918b-563ad870dde1",
                                        "glosses": [
                                            "Peut désigner toute technique permettant ou promettant de faciliter les échanges entre des entités qui se comprennent difficilement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33a498e-b06a-4265-bd63-127c7fbef1aa",
                                                "sense_id": "f2a8ea8e-2cf0-3969-8c63-52da66c08035",
                                                "text": "Le puzzle se révèle plus cosmopolite que jamais, langue des langues, sorte d’espéranto miraculeux dans un monde que guette l’incommunicabilité."
                                            },
                                            {
                                                "example_id": "289d47f1-2093-416a-9d6e-4a02a8969e66",
                                                "sense_id": "f2a8ea8e-2cf0-3969-8c63-52da66c08035",
                                                "text": "Cette anglicisation à marche forcée n’est ni un nouvel espéranto ni un trissotinisme mais un fait de société : une révolution. L’affaire ne date pas d’aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5cbd52c-b4cb-4f0b-8f19-9b6d2e906e86",
                        "source_entry_id": "abb25b54-a624-354f-91ec-456551d5dc87",
