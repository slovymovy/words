                                                "sense_id": "06adb9e0-c72d-3bf8-8c5b-6a71af8630c5",
                                                "text": "Гассан-бей — паша, предводитель турецкого флота."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бей",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8629c494-e2c0-35b3-8e76-c44ea6733562",
                                        "entry_id": "32d08c74-3155-3179-b033-7d310d38bb4b",
                                        "glosses": [
