                "senses": [
                    {
                        "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                        "entry_id": "fe254b3c-8823-3fb8-9448-9c78ba533c19",
                        "glosses": [
                            "Mother."
                        ],
                        "tags": [
                            "Canada",
                            "South-Africa",
                            "US",
                            "West-Midlands",
                            "colloquial",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "26db4349-eff0-4119-ae75-6c98e4c16e13",
                                "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                                "text": "To find out what moms really want this year, we turned to the best source possible: our own mothers."
                            },
                            {
                                "example_id": "33316b96-ce3e-4c58-815f-6435f75b7229",
                                "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                                "text": "At a very early age, Knowles says she was taught not to draw any attention to herself. “Pretty is as pretty does,” her mom used to say."
                            }
                        ]
                    },
                    {
                        "sense_id": "49be5914-d432-3d0b-884f-a41855368176",
                        "entry_id": "fe254b3c-8823-3fb8-9448-9c78ba533c19",
                        "glosses": [
                            "Mother.",
                            "used as a term of address for one's wife"
                        ],
                        "tags": [
                            "Canada",
                            "South-Africa",
                            "US",
                            "West-Midlands",
                            "broadly",
                            "colloquial",
                            "informal"
                        ],
                        "examples": [
