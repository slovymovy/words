                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d099503-8e0d-4620-b350-cc295762461b",
                        "source_entry_id": "ae046391-dac3-3897-9716-efdf6e4d1638",
                        "source_sense_id": "759972e2-1402-3fcb-ac00-757365a42e3c",
                        "target_lang_word": "ensign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ensign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c2dff11-c2a2-304b-afff-7be75d846ab7",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "A badge of office, rank, or power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "777b01b6-23eb-48d1-8b2f-9384257e46bf",
                                                "sense_id": "5c2dff11-c2a2-304b-afff-7be75d846ab7",
                                                "text": "The Ensigns of our Power about we bear; / And every Land pays Tribute to the Fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44848886-f6a9-3b32-a35e-c1f93a09796d",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "The lowest grade of commissioned officer in the United States Navy, junior to a lieutenant junior grade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da88d550-9075-42c5-b72d-12f6b4a12878",
                                                "sense_id": "44848886-f6a9-3b32-a35e-c1f93a09796d",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c33bc52a-9925-305c-bbac-a525ac609b1a",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "A flag or banner carried by military units; a standard or color/colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b185c453-b2c6-43b3-990f-8119956822ac",
                                                "sense_id": "c33bc52a-9925-305c-bbac-a525ac609b1a",
                                                "text": "Hang up your ensigns, let your drums be still,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe5146c5-c92d-34fb-ba4e-63091665ed1a",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "The principal flag or banner flown by a ship (usually at the stern) to indicate nationality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f584b1-9209-46bc-9dd4-c7b92619909c",
                                                "sense_id": "fe5146c5-c92d-34fb-ba4e-63091665ed1a",
                                                "text": "But Alcibiades swiftly ran up the Athenian ensign on his flagship and bore down on that part of the Peloponnesian fleet which held the advantage and was pursuing the Athenians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d247f084-f790-3dc9-bf83-e056fc3c77ec",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "Any prominent flag or banner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c86f8e-0790-45c1-8602-6bcb29c30a8b",
                                                "sense_id": "d247f084-f790-3dc9-bf83-e056fc3c77ec",
                                                "text": "Ten thousand thousand ensigns high advanced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885a0fb2-6531-359b-ad54-3d7a67ac9119",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "A junior commissioned officer in the 18th and 19th centuries whose duty was to carry the unit's ensign."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ensign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad532b4-d578-38cd-9830-08b9b18fd5a4",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To designate as by an ensign."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022819d2-64a1-4cef-97ac-9de9fd2f4701",
                                                "sense_id": "8ad532b4-d578-38cd-9830-08b9b18fd5a4",
                                                "text": "HENRY but ioyn’d the Roses, that ensign’d / Particular families, but this hath ioyn’d / The Rose and Thistle,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ba62f6-a21d-387e-a427-c338f1d3846e",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To distinguish by a mark or ornament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58e81534-a74c-3dfe-bb5e-0c2e8823b9ef",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To distinguish by an ornament, especially by a crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce63c4e-133d-4449-ba04-12d3f25970c8",
                                                "sense_id": "58e81534-a74c-3dfe-bb5e-0c2e8823b9ef",
                                                "text": "Any charge which has a crown immediately above or upon it, is said to be ensigned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23bb74fe-f86f-46a4-8cee-2862f26d6081",
                        "source_entry_id": "ae046391-dac3-3897-9716-efdf6e4d1638",
                        "source_sense_id": "759972e2-1402-3fcb-ac00-757365a42e3c",
                        "target_lang_word": "officer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "officer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f64d50a2-8942-3bd8-8fe1-ec37378169b5",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "One who has a position of authority in a hierarchical organization, especially in military, police or government organizations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aadc738-c2e7-40ba-8f9a-d41b83a3fb17",
                                                "sense_id": "f64d50a2-8942-3bd8-8fe1-ec37378169b5",
                                                "text": "Huerta was arrested while law enforcement officers were executing a federal search warrant at a Los Angeles business suspected of hiring illegal immigrants and falsifying employment papers, a special agent for Homeland Security Investigations, which is part of Immigration and Customs Enforcement, wrote in a federal court filing. […] A law enforcement officer approached Huerta and told him to leave, then put his hands on Huerta to move him out of the way of a vehicle, the agent wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd200d3a-5328-3eb5-80de-594d6dead8ab",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "A respectful term of address for an officer, especially a police officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffe08ca-6018-458e-938f-05c23dd7b30b",
                                                "sense_id": "dd200d3a-5328-3eb5-80de-594d6dead8ab",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d290c2-c22d-3095-bc78-0054df4555da",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "One who holds a public office."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfbe0503-98c5-37cf-809a-cd00e56ec3ad",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "An agent or servant imparted with the ability, to some degree, to act on initiative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adad8a56-d33d-350a-8353-269bc3c0daa0",
                                        "entry_id": "12d7c5b1-e43d-3578-990c-ed2f505ea01b",
                                        "glosses": [
                                            "A commissioned officer."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "officer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1b59cb4-f07e-36d1-b953-c58d08f29115",
                                        "entry_id": "f429cb25-6674-3f3f-84ce-37ec8a504758",
                                        "glosses": [
                                            "To supply with officers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                        "entry_id": "f429cb25-6674-3f3f-84ce-37ec8a504758",
                                        "glosses": [
                                            "To command as or like an officer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cabb891-9d49-4758-af9c-ebcd7071f1b3",
                                                "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                                "text": "Many of our journals are officered by Irish gentlemen, and their gallant brigade does the penning among us, as their ancestors used to transact the fighting in Europe; and engage under many a flag, to be good friends when the battle is over."
                                            },
                                            {
                                                "example_id": "c8ce4fa4-cd70-485b-aa9c-14254b8993ec",
                                                "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
                                                "text": "The regular battalions of the regiment, though officered mainly by Anglo-Welshmen of county families, did not normally contain more than about one Welshman in fifty in the ranks."
                                            },
                                            {
                                                "example_id": "d6579792-5756-4a46-91a1-6125d144cc81",
                                                "sense_id": "4e2133a4-bfe6-33d7-9a86-44d62a405315",
