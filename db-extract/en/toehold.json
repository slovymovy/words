                                                "sense_id": "f383e862-6150-303a-8cb9-440d1a27b57e",
                                                "text": "Où y a-t-il une prise pour que je puisse recharger mon portable ?"
                                            },
                                            {
                                                "example_id": "8cec17fb-7181-4eec-bcbd-43bc755da552",
                                                "sense_id": "f383e862-6150-303a-8cb9-440d1a27b57e",
                                                "text": "Cette prise USB ne marche plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dddc9640-986c-3dfc-963c-26eb99eae860",
                                        "entry_id": "745d3fca-6004-3004-8ed7-0b565a29759d",
                                        "glosses": [
                                            "Fiche (électrique, ou de câble de données)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
