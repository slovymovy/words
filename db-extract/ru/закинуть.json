                                "sense_id": "c6ce7283-5658-3729-a9d0-f2e6543e25b8",
                                "text": "Закинуть голову кверху."
                            },
                            {
                                "example_id": "212a4071-c833-4ae8-adf5-4093cad5b9ce",
                                "sense_id": "c6ce7283-5658-3729-a9d0-f2e6543e25b8",
                                "text": "Закинуть руку за голову."
                            },
                            {
                                "example_id": "146763b1-3894-4870-908d-c48ca28f9bb0",
                                "sense_id": "c6ce7283-5658-3729-a9d0-f2e6543e25b8",
