                ],
                "senses": [
                    {
                        "sense_id": "4808891c-b14d-3ded-baeb-1b349898c401",
                        "entry_id": "885dd337-7fec-379a-8c22-e4f2e791c11b",
                        "glosses": [
                            "qualifizierte Person, die für den Bauherrn in sämtlichen Angelegenheiten an dessen Stelle handelt und beratend verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7cdac2-d03d-4d6b-8fb5-8a463fdd5934",
                                "sense_id": "4808891c-b14d-3ded-baeb-1b349898c401",
                                "text": "„Ein Bauherrenvertreter wird mit der neutralen und unabhängigen Wahrnehmung von Bauherrenaufgaben – in organisatorischer, technischer und wirtschaftlicher Hinsicht beauftragt.“"
                            },
                            {
                                "example_id": "53d3f19d-c51a-44f3-b875-2694fa7eff06",
                                "sense_id": "4808891c-b14d-3ded-baeb-1b349898c401",
                                "text": "„In der Rolle als Projektleiter Bauherr und Bauherrenvertreter wahren wir Ihre Interessen mit führungsstarken Persönlichkeiten. “"
                            },
                            {
                                "example_id": "117b6614-95c6-4f3c-b640-51f35476b46d",
                                "sense_id": "4808891c-b14d-3ded-baeb-1b349898c401",
                                "text": "„Die Bezirksverwaltung des Bezirks Oberbayern sucht zum nächstmöglichen Zeitpunkt eine/n Bauherrenvertreter/in.“"
                            },
                            {
                                "example_id": "2a837aa8-7fd3-4240-a2ff-a4b5c8a9a8c9",
                                "sense_id": "4808891c-b14d-3ded-baeb-1b349898c401",
                                "text": "„Die Tätigkeit des Bauherrenvertreters beginnt mit der grundsätzlichen Idee des Bauherren. Die Rolle des Bauherrenvertreters ist als proaktives Bindeglied zwischen dem Bauherren und dem Projektteam zu verstehen. Die Gesamtleistung der Bauherrenvertretung inkludiert idealerweise die klassischen Leistungsbilder der Projektentwicklung und des Projektmanagements (inkl. Projektleitung und Projektsteuerung).“"
                            },
                            {
                                "example_id": "f7fd289d-fbcb-4e10-96c1-546cd7fcbecb",
                                "sense_id": "4808891c-b14d-3ded-baeb-1b349898c401",
                                "text": "„Als Bauherrenvertreter sind wir Ihr neutraler Interessenvertreter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
