                "senses": [
                    {
                        "sense_id": "a543b63e-ecea-3cac-873e-1b8c5cf7fd49",
                        "entry_id": "f22ae08b-c19a-3259-9064-7f9762746b7d",
                        "glosses": [
                            "Donner des cauchemars à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8670d028-d799-4e67-a3cb-7983b8b84109",
                                "sense_id": "a543b63e-ecea-3cac-873e-1b8c5cf7fd49",
                                "text": "Faites attention cependant à ne pas choquer : vous devez faire rêver, pas cauchemardiser."
                            },
                            {
                                "example_id": "f51fd469-83c6-4e33-8af2-921f7c82d0b0",
                                "sense_id": "a543b63e-ecea-3cac-873e-1b8c5cf7fd49",
                                "text": "Différentes analyses ont montré, depuis l'éclosion du culte, que les causes LGBTQ+ sont associées à la cauchemardisée «cabale pédosatanique» qui gouvernerait le monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae7291a1-a902-3664-becb-cb9cdc6b18a0",
                        "entry_id": "f22ae08b-c19a-3259-9064-7f9762746b7d",
                        "glosses": [
                            "Cauchemarder, avoir des cauchemars."
                        ],
                        "tags": [],
                        "examples": [
                            {
