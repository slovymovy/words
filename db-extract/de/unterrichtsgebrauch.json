                ],
                "senses": [
                    {
                        "sense_id": "f7683948-ccd9-3007-8ae9-3e13be98671b",
                        "entry_id": "40482782-4048-3f48-8a7f-e38d289248b0",
                        "glosses": [
                            "Verwendung von etwas für den Schulunterricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a56c84fa-bf0e-4bd2-bfac-452b5b23864b",
                                "sense_id": "f7683948-ccd9-3007-8ae9-3e13be98671b",
                                "text": "„Von dieser Druckvorlage ist die Vervielfältigung für den eigenen Unterrichtsgebrauch gestattet.“"
                            },
                            {
                                "example_id": "52d74090-fe9d-4b49-b2d0-b15630f2aafc",
                                "sense_id": "f7683948-ccd9-3007-8ae9-3e13be98671b",
                                "text": "„Beispielsweise stellen sie diverse Onlineangebote für den Unterrichtsgebrauch ins Internet oder beliefern, wie der Bundesverband deutscher Banken, Schulen unentgeltlich mit aufwendig gestalteten Broschüren.“"
                            },
                            {
                                "example_id": "d185022f-f08c-4ba0-b8b4-8554a2760d79",
                                "sense_id": "f7683948-ccd9-3007-8ae9-3e13be98671b",
                                "text": "„Vervielfältigung zum eigenen Schulgebrauch gilt nicht für Werke, die ihrer Beschaffenheit und Bezeichnung nach zum Schul- oder Unterrichtsgebrauch bestimmt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cebe0efe-5121-37fc-91bd-810512440414",
                        "entry_id": "40482782-4048-3f48-8a7f-e38d289248b0",
                        "glosses": [
                            "Gepflogenheit im Schulunterricht"
                        ],
                        "tags": [
                            "im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "12650f53-7336-4b1a-9a97-73e91cfb5200",
                                "sense_id": "cebe0efe-5121-37fc-91bd-810512440414",
                                "text": "„Ein schöner Bericht, der uns zeigt, was wir im Schulwesen von unseren westlichen Nachbarn lernen können, der aber auch in gerechter Weise die guten deutschen Unterrichtsgebräuche würdigt.“"
                            },
                            {
                                "example_id": "d9ae992f-bd8a-49ac-99f6-c78007fa9a9e",
                                "sense_id": "cebe0efe-5121-37fc-91bd-810512440414",
                                "text": "„In den Provinzen galt es hie und da einen förmlichen Kampf gegen gewisse verrottete akademische Unterrichtsgebräuche.“"
                            },
                            {
                                "example_id": "52a70107-0f7e-4112-aa01-1e9bedaed134",
                                "sense_id": "cebe0efe-5121-37fc-91bd-810512440414",
                                "text": "„Und diesen Erfolg hat Spieß nur durch die innere Umwandlung der Betriebs- und Unterrichtsweise in engster Anlehnung an die Unterrichtsgebräuche der Schule erreichen können.“"
                            },
                            {
                                "example_id": "23970e3d-746c-4d45-a450-a9508bf1379e",
                                "sense_id": "cebe0efe-5121-37fc-91bd-810512440414",
                                "text": "„Die Unterrichtsgebräuche bleiben an die volkstümliche Überlieferung aus der alten Heimat gebunden.“"
                            },
                            {
                                "example_id": "6ba982c6-4c79-49ce-803b-e197eefba4c3",
                                "sense_id": "cebe0efe-5121-37fc-91bd-810512440414",
                                "text": "„Die Hervorhebung der Pflanzen und Tiere, die als Krankheitserreger in Frage kommen, entspricht den heutigen Unterrichtsgebräuchen, die der Hygiene weiten Spielraum lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
