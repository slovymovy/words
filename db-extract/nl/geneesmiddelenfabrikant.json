                        "examples": [
                            {
                                "example_id": "b7aeb259-ccde-4743-ac2e-d0e1103fdea2",
                                "sense_id": "641bed7f-85fb-3506-9b90-70ae846b7ea0",
                                "text": "Geneesmiddelenfabrikant MSD, het voormalige Organon, schrapt de komende drie jaar ongeveer 140 banen in Oss. Door de strengere regels in de geneesmiddelenindustrie, wordt de productie van hormonale en niet-hormonale medicijnen gescheiden."
                            },
                            {
                                "example_id": "aba40195-cc5f-4aa3-9b8f-a7f57ac131f3",
                                "sense_id": "641bed7f-85fb-3506-9b90-70ae846b7ea0",
                                "text": "Binnenkort kan iedereen op internet zien welke financiële afspraken artsen en apothekers hebben gemaakt met geneesmiddelenfabrikanten. De Stichting Code Geneesmiddelenreclame heeft daarover een akkoord gesloten met de betrokken organisaties."
                            }
                        ]
                    }
