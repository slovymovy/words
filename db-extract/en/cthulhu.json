    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e0b6afb3-23a4-39db-91e0-ac34cf64d382",
                "word": "Cthulhu",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "04ba4f97-54d6-3498-a532-0bc7fa639660",
                        "entry_id": "e0b6afb3-23a4-39db-91e0-ac34cf64d382",
                        "glosses": [
                            "A gigantic fictional humanoid alien god being described with a head resembling an octopus and dragon wings and claws, around whom an insane cult developed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494fd17c-601d-4007-92ae-6ea538703283",
                                "sense_id": "04ba4f97-54d6-3498-a532-0bc7fa639660",
                                "text": "Then, bolder than the storied Cyclops, great Cthulhu slid greasily into the water and began to pursue with vast wave-raising strokes of cosmic potency."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ff65542-aa16-458b-9a9d-8ba0a9bd3806",
                        "source_entry_id": "e0b6afb3-23a4-39db-91e0-ac34cf64d382",
                        "source_sense_id": "04ba4f97-54d6-3498-a532-0bc7fa639660",
