{
    "word_family": [
        "along",
        "side",
        "beside",
        "inside",
        "outside",
        "sideways",
        "roadside",
        "broadside"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "31dad896-d9e5-3c51-8815-3f5570badf20",
                    "sense_definition": "Close to the side of; next to.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new bicycle path runs <w>alongside</w> the main road.",
                            "target_lang_translations": {
                                "ru": "Новая велосипедная дорожка проходит <w>вдоль</w> главной дороги.",
                                "de": "Der neue Fahrradweg verläuft <w>entlang</w> der Hauptstraße.",
                                "zh": "新的自行车道<w>沿着</w>主路延伸。"
                            }
                        },
                        {
                            "text": "He parked his car <w>alongside</w> the curb to answer the phone.",
                            "target_lang_translations": {
                                "ru": "Он припарковал машину <w>вдоль</w> бордюра, чтобы ответить на звонок.",
                                "de": "Er parkte sein Auto <w>neben</w> dem Bordstein, um zu telefonieren.",
                                "zh": "他把车停在路缘石<w>旁边</w>接电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "next to",
                        "beside",
                        "by the side of",
                        "parallel to"
                    ],
                    "common_phrases": [
                        "park alongside",
                        "run alongside",
                        "walk alongside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рядом с чем-то или вдоль чего-то.",
                        "de": "In unmittelbarer Nähe zu etwas oder parallel entlang einer Seite verlaufend.",
                        "zh": "在某物旁边或沿着某物的边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдоль",
                                "target_lang_sense_clarification": "в направлении длины чего-либо"
                            },
                            {
                                "target_lang_word": "рядом с",
                                "target_lang_sense_clarification": "в непосредственной близости"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "neben",
                                "target_lang_sense_clarification": "räumlich angrenzend, in unmittelbarer Nähe"
                            },
                            {
                                "target_lang_word": "entlang",
                                "target_lang_sense_clarification": "an einer Linie oder Fläche entlangführend"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沿着",
                                "target_lang_sense_clarification": "顺着某物的长度方向"
                            },
                            {
                                "target_lang_word": "在……旁边",
                                "target_lang_sense_clarification": "在空间上紧邻某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13ffadd0-3fb9-39eb-8841-ed28d05f49cb",
                    "sense_definition": "Together with or in cooperation with someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cooperation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse worked <w>alongside</w> the doctor to save the patient.",
                            "target_lang_translations": {
                                "ru": "Медсестра работала <w>бок о бок с</w> врачом, чтобы спасти пациента.",
                                "de": "Die Krankenschwester arbeitete <w>an der Seite</w> des Arztes, um den Patienten zu retten.",
                                "zh": "护士与医生<w>并肩</w>工作以挽救病人。"
                            }
                        },
                        {
                            "text": "Local volunteers fought <w>alongside</w> the fire department to control the blaze.",
                            "target_lang_translations": {
                                "ru": "Местные добровольцы боролись с огнем <w>вместе с</w> пожарными.",
                                "de": "Örtliche Freiwillige kämpften <w>zusammen mit</w> der Feuerwehr gegen den Brand.",
                                "zh": "当地志愿者与消防部门<w>并肩</w>作战以控制火势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beside"
                    ],
                    "common_phrases": [
                        "work alongside",
                        "serve alongside",
                        "fight alongside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вместе или в сотрудничестве с кем-либо.",
                        "de": "Gemeinsam mit jemandem oder in enger Zusammenarbeit.",
                        "zh": "与某人一起工作或合作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бок о бок с",
                                "target_lang_sense_clarification": "в тесном сотрудничестве"
                            },
                            {
                                "target_lang_word": "вместе с",
                                "target_lang_sense_clarification": "совместно"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "an der Seite von",
                                "target_lang_sense_clarification": "in Unterstützung oder Zusammenarbeit mit jemandem"
                            },
                            {
                                "target_lang_word": "zusammen mit",
                                "target_lang_sense_clarification": "gemeinsam, kooperativ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "与……并肩",
                                "target_lang_sense_clarification": "在合作中紧密配合"
                            },
                            {
                                "target_lang_word": "和……一起",
                                "target_lang_sense_clarification": "共同协作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e5ff0495-c342-3289-812f-f07697c8e21b",
                    "sense_definition": "At or to the side of someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police car pulled <w>alongside</w> and signaled for us to stop.",
                            "target_lang_translations": {
                                "ru": "Полицейская машина пристроилась <w>рядом</w> и подала нам сигнал остановиться.",
                                "de": "Das Polizeiauto fuhr <w>daneben</w> und gab uns ein Signal zum Anhalten.",
                                "zh": "警车<w>靠拢</w>过来，示意我们停车。"
                            }
                        },
                        {
                            "text": "A small boat came <w>alongside</w> to unload the passengers.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка встала <w>борт о борт</w>, чтобы высадить пассажиров.",
                                "de": "Ein kleines Boot legte <w>längsseits</w> an, um die Passagiere aussteigen zu lassen.",
                                "zh": "一艘小船<w>靠拢</w>过来卸下乘客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abreast",
                        "level"
                    ],
                    "common_phrases": [
                        "pull alongside",
                        "come alongside",
                        "draw alongside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбоку от кого-то или чего-то; на одной линии.",
                        "de": "Seitlich von jemandem oder etwas; auf gleicher Höhe.",
                        "zh": "在某人或某物的侧面，或移动到与某物平行的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рядом",
                                "target_lang_sense_clarification": "поблизости, сбоку"
                            },
                            {
                                "target_lang_word": "борт о борт",
                                "target_lang_sense_clarification": "совсем рядом (обычно о судах или машинах)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "längsseits",
                                "target_lang_sense_clarification": "an der langen Seite, oft nautisch oder bei Fahrzeugen"
                            },
                            {
                                "target_lang_word": "daneben",
                                "target_lang_sense_clarification": "an einer anderen Stelle, seitlich davon"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在旁边",
                                "target_lang_sense_clarification": "位于侧面位置"
                            },
                            {
                                "target_lang_word": "靠拢",
                                "target_lang_sense_clarification": "移动至与某物平行或相邻"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}