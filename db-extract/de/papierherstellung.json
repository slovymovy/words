                                                "sense_id": "2d172c88-e725-3a61-ae55-ae73c00031ea",
                                                "text": "Seules les régions où les activités de la verrerie, de la papèterie et des forges offrent des ressources complémentaires aux ruraux."
                                            },
                                            {
                                                "example_id": "7c75827d-d389-4625-86e4-1d4a98819567",
                                                "sense_id": "2d172c88-e725-3a61-ae55-ae73c00031ea",
                                                "text": "Il est en train de souper avec quatre autres garçons papetiers, qui « travaillent de même profession à la papèterie de Jean François Mervans » installée au village."
                                            },
                                            {
                                                "example_id": "eb20689d-beb2-4286-b380-8e0104acca15",
                                                "sense_id": "2d172c88-e725-3a61-ae55-ae73c00031ea",
                                                "text": "Il y a une fort belle papèterie et un moulin à bois de Brésil."
                                            }
                                        ]
                                    }
