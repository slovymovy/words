                        "glosses": [
                            "Nickname for San Francisco: a major city in California, United States."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "515e3146-e337-468e-9f81-a1d1ce831414",
                                "sense_id": "34870c7f-81f0-32c7-874b-4620432d3262",
                                "text": "Whoever after due and proper warning shall be heard to utter the abominable word \"Frisco,\" which has no linguistic or other warrant, shall be deemed guilty of a High Misdemeanor, and shall pay into the Imperial Treasury as penalty the sum of twenty-five dollars."
                            },
                            {
                                "example_id": "ba346837-488b-480d-a36b-5f5cac061590",
                                "sense_id": "34870c7f-81f0-32c7-874b-4620432d3262",
                                "text": "Left my home in Georgia, headed for the Frisco Bay,\nI had nothin' to live for, looks like nothin's gonna come my way,\nI'm just sittin' on the dock of the bay, watchin' the tide roll away,\nsittin' on the dock of the bay, wastin' time."
                            },
                            {
                                "example_id": "33e5becd-c7a6-44f4-834a-8b8cf8b0f6f9",
                                "sense_id": "34870c7f-81f0-32c7-874b-4620432d3262",
                                "text": "My baby's always dancin' and it wouldn't be a bad thing / But I don't get no lovin' and that's no lie / We spent the night in Frisco at every kinda disco / From that night, I kissed our love goodbye"
                            },
                            {
                                "example_id": "3f32aeac-c847-4a69-9c9c-9dffdc946857",
                                "sense_id": "34870c7f-81f0-32c7-874b-4620432d3262",
                                "text": "I fed a fish to a pelican at Frisco Bay"
                            }
                        ]
                    },
