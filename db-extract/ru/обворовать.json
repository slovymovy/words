                ],
                "senses": [
                    {
                        "sense_id": "91556880-aa9e-3d24-a150-9d67ebf941a5",
                        "entry_id": "cd4b32d7-e457-3291-acce-961203614541",
                        "glosses": [
                            "лишить всего имущества или значительной его части, совершив воровство, кражу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5986cd7-e629-4ba9-b021-cf56f0787eeb",
                                "sense_id": "91556880-aa9e-3d24-a150-9d67ebf941a5",
                                "text": "[Платон, муж] Я вор, я за яблоками, я хотел весь сад обворовать."
                            },
                            {
                                "example_id": "698ca260-42b7-40cb-b3fd-98a6f0b02aed",
                                "sense_id": "91556880-aa9e-3d24-a150-9d67ebf941a5",
                                "text": "Один приказчиком был, хозяина обворовал и на воровские деньги в люди вышел."
                            },
                            {
                                "example_id": "2b9d48ac-6015-4278-812f-df2ad140a71b",
                                "sense_id": "91556880-aa9e-3d24-a150-9d67ebf941a5",
                                "text": "[Шпак Антон Семёнович, муж] Человека до ниточки обобрали, а он горный дубняк пьёт!.. Меня артистка обворовала!.. [Иоанн Грозный, муж] Ты опять здесь?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58090074-4c6a-42ff-ba30-a37b6de7e973",
                        "source_entry_id": "cd4b32d7-e457-3291-acce-961203614541",
                        "source_sense_id": "91556880-aa9e-3d24-a150-9d67ebf941a5",
                        "target_lang_word": "robar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1baad1-f319-34f9-85b1-afdf6cc69b51",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Quitar o tomar para sí lo ajeno usando la fuerza."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf872721-dbf8-3f1a-9662-4732aa8324f4",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Por extensión, tomar para sí lo ajeno por medio del engaño o la astucia."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "264e795b-1486-319f-8ec4-03c9a302d5e8",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Raptar.^([definición imprecisa])."
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f133fc4e-fac9-42cf-868f-416e7097a7fd",
                                                "sense_id": "264e795b-1486-319f-8ec4-03c9a302d5e8",
                                                "text": "… yo haré que Arnaldo quede sin Celia, si puede ser. Yo he hecho aquesta jornada, trayéndole mi rescate, y porque no se rescate de la que traigo ordenada. Y es que yo la he de robar y ha de ser en esta hora, porque él con otra señora está fuera del lugar. (Juan de la Cueva - Comedia del degollado)."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "89f496ed-05e0-38ab-ac50-d2cee6f96155",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Retener a una persona contra su voluntad para exigir un rescate."
                                        ],
                                        "tags": [
                                            "Central-America",
                                            "Cuba"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4fd682d1-2137-352c-9df2-d90d3ae5a3f3",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Quitarle algo a una cosa."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b26ce28c-7889-4c5a-a509-21c1c300df89",
                                                "sense_id": "4fd682d1-2137-352c-9df2-d90d3ae5a3f3",
                                                "text": "Robarle el sol un árbol a una planta."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7637a09b-d918-3010-ab1d-f522e00176ce",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Llevarse el agua de un río, o las olas del mar, las tierras o arenas de un borde fluvial o de una playa."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "58f9d2bf-d831-3b57-8981-e63675edf486",
                                        "entry_id": "5a10c72a-e999-31d5-a9c1-87e81b2756d3",
                                        "glosses": [
                                            "Capturar los sentimientos o atraer la atención de alguien."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d369108f-08b7-4431-bed8-6d49bc6447a0",
                                                "sense_id": "58f9d2bf-d831-3b57-8981-e63675edf486",
                                                "text": "… me robó mi corazón, o, más bien, Yo, Jesús, robé el suyo para la eternidad en el Cielo... (El buen ladrón en el Calvario)."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "932c9b63-3ec0-3720-80c6-960852897b66",
