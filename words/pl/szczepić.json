    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9e3a239-2415-3b2c-86e8-c410d8763d76",
                    "sense_definition": "podawać szczepionkę człowiekowi lub zwierzęciu w celu uodpornienia na chorobę",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz w przychodni <w>szczepi</w> pacjentów przeciwko grypie sezonowej.",
                            "target_lang_translations": {
                                "ru": "Врач в поликлинике <w>прививает</w> пациентов от сезонного гриппа."
                            }
                        },
                        {
                            "text": "Każdego roku weterynarz regularnie <w>szczepi</w> nasze psy przeciw wściekliźnie.",
                            "target_lang_translations": {
                                "ru": "Каждый год ветеринар регулярно <w>прививает</w> наших собак от бешенства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "szczepić przeciw grypie",
                        "szczepić dzieci",
                        "szczepić zwierzęta"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать прививку человеку или животному для выработки иммунитета к болезни"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прививать",
                                "target_lang_sense_clarification": "вводить вакцину человеку или животному"
                            },
                            {
                                "target_lang_word": "вакцинировать",
                                "target_lang_sense_clarification": "проводить вакцинацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33de5592-9925-3827-b718-fcdbb0df1310",
                    "sense_definition": "poddawać się zabiegowi podania szczepionki",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu ludzi chętnie <w>szczepi</w> się przed nadejściem zimy.",
                            "target_lang_translations": {
                                "ru": "Многие люди охотно <w>прививаются</w> перед наступлением зимы."
                            }
                        },
                        {
                            "text": "Przed wyjazdem do Afryki trzeba koniecznie <w>szczepić</w> się na żółtą febrę.",
                            "target_lang_translations": {
                                "ru": "Перед поездкой в Африку необходимо обязательно <w>привиться</w> от жёлтой лихорадки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "szczepić się na grypę",
                        "szczepić się przeciw chorobie"
                    ],
                    "target_lang_definitions": {
                        "ru": "подвергаться процедуре вакцинации, делать себе прививку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прививаться",
                                "target_lang_sense_clarification": "делать себе прививку"
                            },
                            {
                                "target_lang_word": "вакцинироваться",
                                "target_lang_sense_clarification": "проходить вакцинацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "776b60d7-fa58-3003-855e-661edd443574",
                    "sense_definition": "łączyć fragment pędu lub pąk jednej rośliny z drugą w celu wyhodowania nowej odmiany",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ogrodnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ogrodnik <w>szczepi</w> młode drzewa owocowe na początku każdej wiosny.",
                            "target_lang_translations": {
                                "ru": "Садовод <w>прививает</w> молодые плодовые деревья в начале каждой весны."
                            }
                        },
                        {
                            "text": "Mój dziadek chętnie <w>szczepił</w> jabłonie, aby uzyskać smaczniejsze owoce.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка охотно <w>прививал</w> яблони, чтобы получить более вкусные плоды."
                            }
                        }
                    ],
                    "synonyms": [
                        "okulizować"
                    ],
                    "common_phrases": [
                        "szczepić drzewa owocowe",
                        "szczepić jabłonie"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединять побег или почку одного растения с другим для выведения нового сорта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прививать",
                                "target_lang_sense_clarification": "о растениях, деревьях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7806c7a7-a05f-3a49-ba96-031a96537aae",
                    "sense_definition": "wpajać, przekazywać lub szerzyć idee, zasady lub wartości",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciele starają się <w>szczepić</w> miłość do ojczystego języka wśród uczniów.",
                            "target_lang_translations": {
                                "ru": "Учителя стараются <w>прививать</w> ученикам любовь к родному языку."
                            }
                        },
                        {
                            "text": "Rodzice od najmłodszych lat <w>szczepili</w> w dzieciach szacunek dla innych.",
                            "target_lang_translations": {
                                "ru": "Родители с самых ранних лет <w>прививали</w> детям уважение к другим."
                            }
                        }
                    ],
                    "synonyms": [
                        "wpajać",
                        "krzewić",
                        "zasiewać"
                    ],
                    "common_phrases": [
                        "szczepić wartości",
                        "szczepić miłość"
                    ],
                    "target_lang_definitions": {
                        "ru": "внушать, передавать или распространять идеи, принципы, ценности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прививать",
                                "target_lang_sense_clarification": "внушать ценности, чувства, привычки"
                            },
                            {
                                "target_lang_word": "внушать",
                                "target_lang_sense_clarification": "воспитывать, насаждать взгляды или правила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7e0cb4a-bcb9-33ec-8c35-8b3b199bda01",
                    "sense_definition": "całować się namiętnie",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młodzi ludzie schowali się w ciemnym korytarzu i długo się <w>szczepili</w>.",
                            "target_lang_translations": {
                                "ru": "Молодые люди спрятались в тёмном коридоре и долго <w>целовались взасос</w>."
                            }
                        },
                        {
                            "text": "Para bez przerwy <w>szczepiła</w> się na oczach wszystkich przechodniów.",
                            "target_lang_translations": {
                                "ru": "Пара без перерыва <w>лизалась</w> на глазах у всех прохожих."
                            }
                        }
                    ],
                    "synonyms": [
                        "całować się"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w języku potocznym lub slangu młodzieżowym"
                        }
                    ],
                    "target_lang_definitions": {
