                    }
                ],
                "senses": [
                    {
                        "sense_id": "a03688cc-964f-332b-b479-829711c8ef4d",
                        "entry_id": "1dfc1338-d939-30d3-83fc-7322c04cef3d",
                        "glosses": [
                            "Nom donné à différents alliages d’antimoine, d’étain ou de plomb."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c4998120-ce96-353b-84b9-0ea497739bd8",
                        "entry_id": "1dfc1338-d939-30d3-83fc-7322c04cef3d",
                        "glosses": [
                            "Dans le milieu de la brocante et des antiquités, appellation impropre mais usuelle d’un alliage de zinc de couleur grise, dit aussi zinc d’art ou bronze-imitation car sa patine imite souvent le bronze."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55986386-88a4-4dd0-8706-8e6d70b4af49",
                                "sense_id": "c4998120-ce96-353b-84b9-0ea497739bd8",
                                "text": "Facile à mettre en œuvre et économique, le régule a été très employé à la fin du XIXᵉ siècle et au début du XXᵉ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5043ee77-3472-34dc-9c32-801ecb60a38b",
                        "entry_id": "1dfc1338-d939-30d3-83fc-7322c04cef3d",
                        "glosses": [
                            "Alliage ou revêtement antifriction servant à garnir les pièces de mécanique soumises au frottement (coussinets de paliers et de bielles)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50b1f47-e4d0-45d2-aa3b-fad6f8330094",
                                "sense_id": "5043ee77-3472-34dc-9c32-801ecb60a38b",
                                "text": "Au fur et à mesure du dépeçage, ils avaient découvert que le joint de culasse était fendu, les soupapes et les filtres encrassés, la chaîne de distribution détendue, la pompe à huile striée de profondes rayures probablement causées par des morceaux de régule arrachés des coussinets."
                            }
                        ]
                    },
                    {
                        "sense_id": "82146932-aa29-3ee3-8136-8b6f0c0f66a5",
                        "entry_id": "1dfc1338-d939-30d3-83fc-7322c04cef3d",
                        "glosses": [
                            "Petit roi."
                        ],
                        "tags": [
                            "obsolete",
                            "pejorative"
                        ],
                        "examples": []
                    }
                ],
