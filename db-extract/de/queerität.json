                "senses": [
                    {
                        "sense_id": "b5255681-22a8-3e91-82d9-3badd45d2c89",
                        "entry_id": "3d0fb38a-cade-3c82-8316-42c09389eb92",
                        "glosses": [
                            "Eigenschaft oder Art, queer – also nicht heterosexuell und binär cisident – zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4f7d52-c3b6-42a5-a03a-3840b6220311",
                                "sense_id": "b5255681-22a8-3e91-82d9-3badd45d2c89",
                                "text": "„Die Geschichte erkundet einfühlsam die Themen Queerität und Selbstakzeptanz in einer unterstützenden Gemeinschaft.“"
                            },
                            {
                                "example_id": "325c133c-6d51-42c8-938e-671b94e981b5",
                                "sense_id": "b5255681-22a8-3e91-82d9-3badd45d2c89",
                                "text": "„Das heutige subkulturelle Gebaren vieler Aktivist_innen [sic] (Musik, Kleidung, Veganismus, Queerität etc.) hätte viele Altanarchist_innen [sic] ebenso befremdet.“"
                            },
                            {
                                "example_id": "587627c3-a201-47a5-ab9a-7d0bad80b761",
                                "sense_id": "b5255681-22a8-3e91-82d9-3badd45d2c89",
                                "text": "„MeatGirls der einzig wahre DragQueen Podcast ist aus den Sommerferien zurück, mit brandneuen Episoden rund um Queeritäten, heißem Tea und dramatischem Oversharing!“"
                            },
                            {
                                "example_id": "a2e7ae06-753e-4400-9bf2-7f9800ee80ec",
                                "sense_id": "b5255681-22a8-3e91-82d9-3badd45d2c89",
                                "text": "„Die Farben der überlappenden Dreiecke stellen Anziehungskraft auf beide, oder alle, Geschlechte [sic] dar, symbolisiert durch rosa und blau, traditionell mit Mädchen und Jungen in den USA verbunden; und Lavendel stellt die Queerität der Bisexualität dar […]“"
                            },
                            {
                                "example_id": "4d807295-60ca-431f-bc90-430224a669e0",
                                "sense_id": "b5255681-22a8-3e91-82d9-3badd45d2c89",
                                "text": "„Laut Outsports […] nehmen 191 Athleten an den Spielen teil, die sich publik zu ihrer Homosexualität, […] Bisexualität, Transsexualität, Queerität und Nichtbinärität bekennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
