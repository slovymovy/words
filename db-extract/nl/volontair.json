                                        "entry_id": "f381583d-e390-3499-8b3c-f1b4e812aeb0",
                                        "glosses": [
                                            "Qui veut fermement arriver à réaliser sa volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a40ca49-480c-4dee-b931-7b73e0ba2506",
                                                "sense_id": "66194fcc-2acc-3879-8665-a68046a2e0e1",
                                                "text": "Ce petit garçon est très volontaire."
                                            }
                                        ]
                                    }
                                ]
