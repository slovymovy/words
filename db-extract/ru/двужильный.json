                ],
                "senses": [
                    {
                        "sense_id": "c48d666f-15b4-32e7-995d-85c5058a46a0",
                        "entry_id": "8f8d560e-b071-395c-b1fa-05783c60794a",
                        "glosses": [
                            "состоящий из двух жил, нитей и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d6a4ae-f7d3-4285-8653-04eabbb9dd92",
                                "sense_id": "c48d666f-15b4-32e7-995d-85c5058a46a0",
                                "text": "Это могут быть силовые провода (высокое напряжение), двужильная витая пара или информационные шины (4 — 8 жил)."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4bfd1f9-970d-3625-a31b-53208763bd3f",
                        "entry_id": "8f8d560e-b071-395c-b1fa-05783c60794a",
                        "glosses": [
                            "перен., прост. крепкий, сильный, выносливый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adc95033-c398-4bec-b78f-02cf518b7298",
                                "sense_id": "a4bfd1f9-970d-3625-a31b-53208763bd3f",
                                "text": "Но так как я существо не двужильное, то вся эта история измучила меня, и я не мог совсем работать и приготовить Вам очерки."
                            }
                        ]
                    },
                    {
                        "sense_id": "46f777bf-47d2-3541-879b-ae7f6006f68e",
                        "entry_id": "8f8d560e-b071-395c-b1fa-05783c60794a",
                        "glosses": [
                            "перен. тяжёлый, требующий большой затраты сил, энергии (от труде, работе)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
