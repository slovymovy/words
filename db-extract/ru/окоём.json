                "senses": [
                    {
                        "sense_id": "4ec43f78-6fa1-3418-91f7-476d35e53d5c",
                        "entry_id": "391e571e-1878-3121-88ff-9a590bcc68db",
                        "glosses": [
                            "поэт. пространство, которое можно окинуть взглядом, горизонт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28767e8-b982-4dc4-bdba-f159d8b1ea49",
                                "sense_id": "4ec43f78-6fa1-3418-91f7-476d35e53d5c",
                                "text": "Разгораясь по всему окоёму, мерцало дымное зарево."
                            },
                            {
                                "example_id": "1c054b04-2aff-4c3a-97ab-d0b66fb1eca3",
                                "sense_id": "4ec43f78-6fa1-3418-91f7-476d35e53d5c",
                                "text": "Трудно сказать, насколько степь широкая, раздольная, как величает её песня, своим простором, которому конца-краю нет, воспитывала в древнерусском южанине чувство шири и дали, представление о просторном горизонте, окоёме, как говорили в старину."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db358cf-3e2f-4be5-b5b1-753e491652eb",
                        "source_entry_id": "391e571e-1878-3121-88ff-9a590bcc68db",
                        "source_sense_id": "4ec43f78-6fa1-3418-91f7-476d35e53d5c",
                        "target_lang_word": "horizon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horizon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4639c284-dbc1-3623-9a55-dce0844dd6fb",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Ligne circulaire dont l’observateur est le centre et où le ciel et la terre semblent se joindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a25a21-6085-428e-8231-9ecec1b59608",
                                                "sense_id": "4639c284-dbc1-3623-9a55-dce0844dd6fb",
                                                "text": "Le soleil s’abaissait rapidement à l’horizon, la nuit n’allait pas tarder à venir, les cavaliers envoyés aux environs étaient tous de retour."
                                            },
                                            {
                                                "example_id": "01e77bb3-4857-4b79-8af1-e9b0cc565f84",
                                                "sense_id": "4639c284-dbc1-3623-9a55-dce0844dd6fb",
                                                "text": "L'arbre, destiné à transmettre le mouvement aux meules, n'est pas tout-à-fait horizontal, et il fait avec l’horizon un angle d'environ 15°."
                                            },
                                            {
                                                "example_id": "ea2574a5-5919-4a06-9f46-7b6b40546742",
                                                "sense_id": "4639c284-dbc1-3623-9a55-dce0844dd6fb",
                                                "text": "Quelques blancheurs commencent à nuancer l’horizon vers l’est. Les nuages du zénith en reçoivent une première coloration."
                                            },
                                            {
                                                "example_id": "c1995c46-b7e7-4125-82b6-949bfa66059b",
                                                "sense_id": "4639c284-dbc1-3623-9a55-dce0844dd6fb",
                                                "text": "Voici la route en sable doux ; des barques ancrées sur le canal bleu ont un grincement plaintif, qui redemande les vagues hautes et le large horizon."
                                            },
                                            {
                                                "example_id": "e15ebe44-cb90-4d6a-9e3b-84f0ae0f52a0",
                                                "sense_id": "4639c284-dbc1-3623-9a55-dce0844dd6fb",
                                                "text": "Un solarigraphe Volochine occupait le sommet d’un monticule à 150 m à l’Est de la baraque. De ce point l’horizon était dégagé dans tous les secteurs. Le même support servait à la mise en station de l’actinomètre de Linke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53126c67-770f-3cfc-93da-9d32f9515709",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Partie de la surface terrestre où se termine notre vue ; et souvent la partie du ciel qui en est voisine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d93f1d-3089-422a-91f0-32f0cd00da12",
                                                "sense_id": "53126c67-770f-3cfc-93da-9d32f9515709",
                                                "text": "Un joli bois de pins tout étincelant de lumière dégringole devant moi jusqu’au bas de la côte. À l’horizon, les Alpilles découpent leurs crêtes fines… Pas de bruit…"
                                            },
                                            {
                                                "example_id": "c6789a70-d468-4b5a-84b4-28ffb7e5f04b",
                                                "sense_id": "53126c67-770f-3cfc-93da-9d32f9515709",
                                                "text": "Ces crêtes barrant l’horizon ressemblaient à d’anciennes falaises marines ; […]."
                                            },
                                            {
                                                "example_id": "16b7e1ac-429e-47ea-b206-73859937005c",
                                                "sense_id": "53126c67-770f-3cfc-93da-9d32f9515709",
                                                "text": "Il pleuvait presque sans discontinuer depuis la Toussaint et quand, d’aventure, l’horizon se décrassait, les vents du large opprimaient tout l’espace […]."
                                            },
                                            {
                                                "example_id": "56f40b9f-5f54-4de2-ad7f-bed12648ae31",
                                                "sense_id": "53126c67-770f-3cfc-93da-9d32f9515709",
                                                "text": "[…] mais on voyait assez clair pour découvrir, à l’horizon — […] — la ligne ocre des sables. Elle se silhouettait sur le ciel rose, avec une précision, une netteté de morsure à l’eau-forte, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Limite subjective (spatiale, temporelle ou morale), depuis un point de vue particulier."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae283244-ded8-4a87-ae1a-fb7e21b71b8b",
                                                "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                                "text": "[…] Tous les gueux se réconcilient à la gamelle. Ce maudit Observateur littéraire. Que le diable l'eût emporté, lui et ses feuilles. C'est ce chien de petit prêtre avare, puant et usurier qui est la cause de mon désastre. Il parut sur notre horizon, hier, pour la première fois. Il arriva à l'heure qui nous chasse tous de nos repaires, l'heure du dîner."
                                            },
                                            {
                                                "example_id": "dfca9db6-6858-4369-afd4-bc3f269ad306",
                                                "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                                "text": "– Je dis que les pires gens trouvent toujours quelque personnage à mettre en mouvement, et que ce M. Deplot a cherché jusqu’au fond de son horizon ce qu’il avait de meilleur, de plus riche, de plus fort…"
                                            },
                                            {
                                                "example_id": "2f9b714f-cc84-4dfa-ba76-55f2f790cdaf",
                                                "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                                "text": "Peu préparé à la politique, mais d’opinions légitimistes, il se révèle politicien sans horizon. Les de Broglie et Cie n'ont pas de peine à le circonvenir."
                                            },
                                            {
                                                "example_id": "d91697f6-05b0-4f8e-a85c-d795def47a15",
                                                "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                                "text": "Nous laissons beaucoup trop les Alsaciens « cuire dans leur jus », nous les abandonnons trop à l’horizon confiné de ce couloir d’entre Vosges et Rhin où la fermentation d’un particularisme fanatique finit par exhaler une agressive odeur de renfermé."
                                            },
                                            {
                                                "example_id": "62139529-e1fa-43c3-8b96-857cea3b6ec7",
                                                "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                                "text": "Une des manières d’assumer le fait qu’elle est mal intégrée à la société, c’est d’en dépasser les horizons bornés."
                                            },
                                            {
                                                "example_id": "789c2f71-1d52-4c1b-9d2e-caa6b266b2a1",
                                                "sense_id": "2962a40a-ec8f-30d7-b83c-585cb04082ea",
                                                "text": "(Littéraire) La diva, dans la grande tradition, se situe toujours aux abords de l'abîme ; elle se tient au plus près des zones non tempérées par l'ordre phallique de la loi du père, aux frontières qui ouvrent sur le royaume des divinités maternelles toutes-puissantes. […] À l’horizon du ravissement esthétique poussé à son acmè, il y a le risque de la bascule dans l'horreur du cri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f19e28bd-bb74-370f-9427-7fb4dbaa81e3",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Cercle de la sphère qui divise sa partie visible de sa partie invisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6a440b-74c0-47cb-8c81-59a6aed7737e",
                                                "sense_id": "f19e28bd-bb74-370f-9427-7fb4dbaa81e3",
                                                "text": "Prendre la hauteur d’un astre sur l’horizon."
                                            },
                                            {
                                                "example_id": "1f395c98-6760-48b3-9d54-43455900547c",
                                                "sense_id": "f19e28bd-bb74-370f-9427-7fb4dbaa81e3",
                                                "text": "Il doit y avoir une éclipse sur notre horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ee0ae3f-6ec8-3010-b611-e08467e98901",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Endroit d’un tableau où, selon l’ordre des plans, le ciel succède à la terre."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2549ce3e-4d23-32c8-a1a2-fb77659ecf64",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Hauteur à laquelle le peintre a placé le point de vue."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22f7c58-81aa-41cb-b988-cdc67b25d425",
                                                "sense_id": "2549ce3e-4d23-32c8-a1a2-fb77659ecf64",
                                                "text": "L’horizon est trop haut, est trop bas, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Couche du sol meuble, homogène et parallèle à la surface, proche de la surface, qui présente des altérations par rapport aux roches antérieures et qui contient en général de la matière organique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed05b42-fa17-4a32-9d6c-a4a5caf5125d",
                                                "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                                "text": "Les horizons. Ce sont des volumes pédologiques plus ou moins parallèles à la surface du terrain. Chaque horizon se décrit en terme d’un ou plusieurs types d’assemblages et de leurs relations. Son épaisseur varie de quelques centimètres à plusieurs mètres."
                                            },
                                            {
                                                "example_id": "6aa33d98-fa1e-4fe0-bb32-ed9adca9c820",
                                                "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                                "text": "Pour un premier boisement derrière prairie par exemple, il est impératif de décompacter l’horizon de surface."
                                            },
                                            {
                                                "example_id": "fbdf6aad-66f4-438e-b20a-b59b3bd820f2",
                                                "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                                "text": "Les solonetz vertiques brun ont un horizon Ah, Ahe ou Ap dont la luminosité de couleur est supérieure à 4,5, à l’état sec, […]."
                                            },
                                            {
                                                "example_id": "d78908cb-85b4-4ed4-930d-a7e15804a9e1",
                                                "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                                "text": "Par conséquent, le substratum (horizon C des pédologues) n'est pas la craie, sauf dans les rendzines blanches, qui sont l'exception."
                                            },
                                            {
                                                "example_id": "25b62162-c2d1-4334-9861-6008f7bfc31e",
                                                "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                                "text": "Des revêtements organo-argileux sont présents dans les horizons BAg et B21L. Les caractères d’accumulation d’argile semblent donc mieux exprimés dans ces horizons que dans ceux du planosol vertique."
                                            },
                                            {
                                                "example_id": "48b751be-7873-4f30-8fd6-1d6c38a14e84",
                                                "sense_id": "effe49fa-a5b5-3d9d-8018-db31f636c01c",
                                                "text": "Le sarclage de prélevée à plat, et dans une moindre mesure l'enfouissement de matière organique par le sarclobuttage de prélevée accélèrent le dessèchement par évaporation de l’horizon de surface, comparés au sarclobuttage de prélevée seul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63d29fac-755b-3573-b1ff-587079deec9a",
                                        "entry_id": "80438780-eb21-3693-b619-6e9d3bd2e154",
                                        "glosses": [
                                            "Horizon des événements. Pour un trou noir, désigne la distance limite à partir de laquelle toute matière ou rayonnement est irrémédiablement absorbé par son champ gravitationnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124648b3-8b2d-4b2f-8d98-a72274a1522d",
                                                "sense_id": "63d29fac-755b-3573-b1ff-587079deec9a",
                                                "text": "Un hypothétique observateur situé au voisinage de l’horizon remarquera que le temps s’écoule différemment pour lui et pour un observateur situé loin du trou noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
