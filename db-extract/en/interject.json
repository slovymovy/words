                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921605d0-bd2a-4c95-b270-6ce54c3ec3ed",
                        "source_entry_id": "fc876822-c7ef-3533-9239-973722e0e216",
                        "source_sense_description": "to interpose onseself",
                        "target_lang_word": "intervenir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intervenir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7938b60-f4cd-31e3-8ead-a6a80ee3d0d3",
                                        "entry_id": "f8029c3a-1af3-3757-b3a5-3f4f644ba5e9",
                                        "glosses": [
                                            "Prendre part à une chose, entrer dans une affaire par quelque intérêt, par quelque obligation, par quelque nécessité que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "342aecb8-c11c-4daf-9fc9-81e2feae2801",
                                                "sense_id": "c7938b60-f4cd-31e3-8ead-a6a80ee3d0d3",
                                                "text": "L’acétylcholine n'est qu'un maillon d'une chaîne métabolitique où interviennent divers systèmes enzymatiques sur lesquels les insecticides peuvent aussi agir."
                                            },
                                            {
                                                "example_id": "3ec5a801-103c-452b-9511-06734e445a84",
                                                "sense_id": "c7938b60-f4cd-31e3-8ead-a6a80ee3d0d3",
                                                "text": "De leur côté, Louis VII et son fils, Philippe Auguste (1180-1223), jouèrent la carte de la déstabilisation, en intervenant dans les comtés d'Auvergne et de Toulouse, ou en soutenant la révolte de Jean et Richard contre leur père Henri II."
                                            },
                                            {
                                                "example_id": "9fc97431-1d09-4192-9d33-b0d20da09448",
                                                "sense_id": "c7938b60-f4cd-31e3-8ead-a6a80ee3d0d3",
                                                "text": "L’autorité intervint dans cette affaire et fit cesser les troubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d61de3-6512-325d-a91e-e61e5f4e8713",
                                        "entry_id": "f8029c3a-1af3-3757-b3a5-3f4f644ba5e9",
                                        "glosses": [
                                            "Demander d’être reçu dans une procédure."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba8a829-c0ff-4e4b-b2fd-104315ba0011",
                                                "sense_id": "a6d61de3-6512-325d-a91e-e61e5f4e8713",
                                                "text": "Intervenir dans un procès, au procès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e55935a-ebe5-33c6-8cf8-8f274e332c98",
                                        "entry_id": "f8029c3a-1af3-3757-b3a5-3f4f644ba5e9",
                                        "glosses": [
                                            "Se rendre médiateur dans une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71aa55f4-664a-4ae5-a348-c5f49f9a0a19",
                                                "sense_id": "3e55935a-ebe5-33c6-8cf8-8f274e332c98",
                                                "text": "Le pape intervint dans le différend de ces deux princes pour les accorder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32dde8bd-fd4f-39c2-96a1-bf6943ebf502",
                                        "entry_id": "f8029c3a-1af3-3757-b3a5-3f4f644ba5e9",
                                        "glosses": [
                                            "Survenir au milieu de, surtout dans un procès, dans une affaire, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751c0499-c896-41a0-b383-b84eb73db41c",
                                                "sense_id": "32dde8bd-fd4f-39c2-96a1-bf6943ebf502",
                                                "text": "Il est plus que certain que des transactions sont intervenues entre les deux parties, au grand dam du Trésor."
                                            },
                                            {
                                                "example_id": "94f3cdf4-f99a-44ee-a7e2-cecda891d5d0",
                                                "sense_id": "32dde8bd-fd4f-39c2-96a1-bf6943ebf502",
                                                "text": "Il serait long de dire tous les incidents qui intervinrent durant cette affaire."
                                            },
                                            {
                                                "example_id": "d8617f74-923e-4c63-aecd-6f46fe58cae9",
                                                "sense_id": "32dde8bd-fd4f-39c2-96a1-bf6943ebf502",
                                                "text": "Une ordonnance intervint, qui régla la manière de procéder en pareil cas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
