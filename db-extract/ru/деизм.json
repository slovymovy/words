                                        "glosses": [
                                            "pogląd filozoficzny zakładający istnienie jakiejś nieokreślonej dokładnie duchowej siły sprawczej, która stworzyła świat materialny i prawa nim rządzące, jednak nie ingeruje ona bezpośrednio w jego działanie"
                                        ],
                                        "tags": [],
