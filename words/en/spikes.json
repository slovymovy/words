                            {
                                "target_lang_word": "шипы",
                                "target_lang_sense_clarification": "острые выступы на поверхности"
                            },
                            {
                                "target_lang_word": "острия",
                                "target_lang_sense_clarification": "острые концы предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6082514f-ba07-3107-929e-984eb165f5ba",
                    "sense_definition": "A pair of athletic shoes equipped with spikes on the sole and heel for better traction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner tightened his <w>spikes</w> before the final race.",
                            "target_lang_translations": {
                                "ru": "Бегун затянул свои <w>шиповки</w> перед финальным забегом."
                            }
                        },
                        {
                            "text": "She wore <w>spikes</w> to get a better grip on the wet track.",
                            "target_lang_translations": {
                                "ru": "Она надела <w>шиповки</w>, чтобы лучше держаться на мокрой дорожке."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleats",
                        "studs"
                    ],
                    "common_phrases": [
                        "track spikes",
                        "running spikes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивная обувь с шипами на подошве для лучшего сцепления с поверхностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шиповки",
                                "target_lang_sense_clarification": "специальная спортивная обувь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9c6fe6c-6a81-3670-b2b2-a83ce9302224",
                    "sense_definition": "A device placed on a road to puncture the tires of a vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police deployed <w>spikes</w> to stop the fleeing car.",
                            "target_lang_translations": {
                                "ru": "Полиция применила <w>шипованную ленту</w>, чтобы остановить машину преступников."
                            }
                        },
                        {
                            "text": "The car tires were destroyed after driving over the <w>spikes</w>.",
                            "target_lang_translations": {
                                "ru": "Шины автомобиля были уничтожены после того, как он проехал по <w>шипам</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spike strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, размещаемое на дороге для прокола шин автомобиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шипованная лента",
                                "target_lang_sense_clarification": "полицейское устройство для остановки машин"
                            },
                            {
                                "target_lang_word": "ежи",
                                "target_lang_sense_clarification": "заграждение с острыми шипами"
                            }
                        ]
                    }
                }
            ]
        },
