                                                "sense_id": "d6fe2d26-28f0-356d-b73f-bcc24071e178",
                                                "text": "[…] this quiz with all the strange old terms in it, curtilage and messuage and socage and fee simple and fee tail and feoffee and copyhold and customary freehold and mortmain and devises and lex loci rei sitae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b35a4a00-1279-4c55-83b5-bb5fb6694fb3",
                        "source_entry_id": "1ba4786a-bc74-37a0-bd9b-e10ca871b886",
                        "source_sense_id": "6fd37670-5d81-33dc-b85c-7ae6d8450abc",
                        "target_lang_word": "liege",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb8d9fc-a10f-36d5-92af-2c62d759c102",
                                        "entry_id": "afa69073-fa7b-37b2-8bd5-ca96a40276b9",
                                        "glosses": [
                                            "A free and independent person; specifically, a lord paramount; a sovereign."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                                        "entry_id": "afa69073-fa7b-37b2-8bd5-ca96a40276b9",
                                        "glosses": [
                                            "A king or lord."
                                        ],
                                        "tags": [
                                            "in full liege lord"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca62e7f0-17ae-4eac-8a02-073ca4cd075c",
                                                "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                                                "text": "More health and happiness betide my liege / Than can my care-tuned tongue deliver him!"
                                            },
                                            {
                                                "example_id": "ff64b170-cfb4-4444-ae16-1c217e238a07",
                                                "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                                                "text": "Kings, my liege, may take a lesson from him"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee11a75-8e03-3b31-a7de-7449698f721c",
                                        "entry_id": "afa69073-fa7b-37b2-8bd5-ca96a40276b9",
                                        "glosses": [
                                            "The subject of a sovereign or lord; a liegeman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "liege",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                                        "entry_id": "9305acbd-c12f-3fe0-b504-879a442e1388",
                                        "glosses": [
                                            "Sovereign; independent; having authority or right to allegiance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973ae7de-face-4cc6-8060-e294c5d7458c",
                                                "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                                                "text": "a liege lord"
                                            },
                                            {
                                                "example_id": "4b97541b-ff38-4dc3-82a5-3a0358d05cf5",
                                                "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                                                "text": "She look'd as grand as doomsday and as grave: / And he, he reverenced his liege lady there;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a00fb2f-fb5e-3b06-90bc-dc8fb2c69308",
                                        "entry_id": "9305acbd-c12f-3fe0-b504-879a442e1388",
                                        "glosses": [
                                            "Serving an independent sovereign or master; bound by a feudal tenure; obliged to be faithful and loyal to a superior, such as a vassal to his lord; faithful."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd04b50-386c-480e-baa8-a1aa5504533d",
                                                "sense_id": "5a00fb2f-fb5e-3b06-90bc-dc8fb2c69308",
                                                "text": "a liege man; a liege subject"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48751a5c-ff62-367e-ba9b-3cb7f80a8dd5",
                                        "entry_id": "9305acbd-c12f-3fe0-b504-879a442e1388",
                                        "glosses": [
                                            "Full; perfect; complete; pure."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e82d762-ca1b-43bd-8fad-ce1fea6e3cbd",
                                                "sense_id": "48751a5c-ff62-367e-ba9b-3cb7f80a8dd5",
                                                "text": "it was a release by Katherine de Ros in her liege widowhood to Sir Thomas de Stirkeland"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8624c94-61d0-481e-9166-8143db07abf9",
                        "source_entry_id": "1ba4786a-bc74-37a0-bd9b-e10ca871b886",
                        "source_sense_id": "6fd37670-5d81-33dc-b85c-7ae6d8450abc",
                        "target_lang_word": "liegeman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liegeman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06881a88-a608-3300-90cf-92b1947b0231",
                                        "entry_id": "beb58f3a-be83-39f3-ab65-968687198891",
                                        "glosses": [
                                            "A male vassal (subject of a sovereign or lord)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e709b28-0fc1-4414-94ce-779b56636191",
                                                "sense_id": "06881a88-a608-3300-90cf-92b1947b0231",
                                                "text": "Three belied you, three betrayed you! One you betrayed was three times true! Lord Voryn Dagoth, Dagoth Ur, steadfast liegeman, faithful friend, bids you come and climb Red Mountain!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72857fa8-23ad-4148-a5a2-7ed14d36f489",
                        "source_entry_id": "1ba4786a-bc74-37a0-bd9b-e10ca871b886",
                        "source_sense_id": "6fd37670-5d81-33dc-b85c-7ae6d8450abc",
                        "target_lang_word": "vassal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "The grantee of a fief, a subordinate granted use of a superior's land and its income in exchange for vows of fidelity and homage and (typically) military service."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a965f84-2c43-4e99-82d9-0803ca37d772",
                                                "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                                "text": "The manor's vassals owed first fruits and a tithe to the parish church, another 10% to the lord (including at least 50 eels), a week or two each year of service in the manor's upkeep, and service in the local fyrd."
                                            },
                                            {
                                                "example_id": "b4b799b3-b741-4e22-ab2c-89cfc1e74be3",
                                                "sense_id": "5f3222de-57d0-3346-a120-615884c5edae",
                                                "text": "It was superimposed on rules of conduct evolved at an earlier date as the spontaneous expression of class consciousness; rules that pertained to the fealty of vassals (the transition appears clearly, towards the end of the eleventh century, in the Book of the Christian Life by Bishop Bonizo of Sutri, for whom the knight is, first and foremost, an enfeoffed vassal ) and constituted above all a class code of noble and 'courteous' people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e9627d-c5b2-37ab-9964-c0811cf65e98",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "Any direct subordinate bound by such vows to a superior."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987d95d0-2643-4277-a848-5049827766ff",
                                                "sense_id": "43e9627d-c5b2-37ab-9964-c0811cf65e98",
                                                "text": "The king ordered his vassals to join him on the crusade unless they had a written note signed by the archbishop or pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8cbdcf-b007-31cc-b5f9-0ad851c0a846",
                                        "entry_id": "476e4507-2ce2-3bd3-8139-49600dc71310",
                                        "glosses": [
                                            "Any subordinate bound by similar close ties."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9bd31b-b214-4e7f-9a35-2079ca74482f",
                                                "sense_id": "df8cbdcf-b007-31cc-b5f9-0ad851c0a846",
                                                "text": "The vassals of his anger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef0cbb18-91ef-3599-af3e-329eba5d61ef",
                                        "entry_id": "9b8a8a31-c627-390d-bf12-3de04a253adb",
                                        "glosses": [
                                            "Resembling a vassal; slavish; servile."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b896ca3f-6443-48a1-b504-57c03e438497",
                                                "sense_id": "ef0cbb18-91ef-3599-af3e-329eba5d61ef",
                                                "text": "Did they, quoth you? / Who sees the heavenly Rosaline / That, like a rude and savage man of Inde / At the first opening of the gorgeous east / Bows not his vassal head and strucken blind / Kisses the base ground with obedient breast?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vassal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc7bc11-dd6d-3cff-b506-003f13825228",
                                        "entry_id": "22fcb951-a5a4-322e-9f35-5bf78ae9ccea",
                                        "glosses": [
                                            "To treat as a vassal or to reduce to the position of a vassal; to subject to control; to enslave."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5d5eb00-d17e-306c-a467-8fc8dfa63dd8",
                                        "entry_id": "22fcb951-a5a4-322e-9f35-5bf78ae9ccea",
                                        "glosses": [
                                            "To subordinate to someone or something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
