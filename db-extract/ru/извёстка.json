                    {
                        "translation_id": "9461b1c4-f322-401b-851b-26c591c14865",
                        "source_entry_id": "59abeae1-5fd9-3a82-ace8-e35e06f9a0d1",
                        "source_sense_description": "раствор извести",
                        "target_lang_word": "Mörtel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mörtel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "041ac0fa-d9fc-3b62-9431-3301b242a5ef",
                                        "entry_id": "96fc8318-5ad2-31cf-a7e7-e15f80bb5074",
                                        "glosses": [
                                            "Mittel zur festen Verbindung von Steinen sowie zum Schutz vor Witterungseinflüssen von Mauerwerken im Außenbereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864ad712-e3a0-43c5-8a95-ccd24766aeb7",
                                                "sense_id": "041ac0fa-d9fc-3b62-9431-3301b242a5ef",
                                                "text": "Mörtel besteht aus Sand und Kalk als Bindemittel und enthält Zuschlagsstoffe wie Gips und Zement."
                                            },
                                            {
                                                "example_id": "464b1442-e126-4785-ac4f-ced47944cb67",
                                                "sense_id": "041ac0fa-d9fc-3b62-9431-3301b242a5ef",
                                                "text": "„Ihre monumentalen Steinbauten beeindrucken durch bis zu elf Meter hohe Mauern, die ohne Mörtel aus Granitblöcken zusammengefügt sind.“"
                                            },
                                            {
                                                "example_id": "623976ca-de75-4686-b3e4-e9b7731f2713",
                                                "sense_id": "041ac0fa-d9fc-3b62-9431-3301b242a5ef",
                                                "text": "„Graeber schob den Mörtel weg und kroch an dem eingestürzten Teil des Kellers entlang.“"
                                            },
                                            {
                                                "example_id": "07f38d3a-c423-4ced-99f7-d5584f08fe31",
                                                "sense_id": "041ac0fa-d9fc-3b62-9431-3301b242a5ef",
                                                "text": "„Der Boden wurde durch die Balken gebildet, die den Dachstuhl trugen, und dazwischen gab es nur dünne Latten und Mörtel, so daß man von Balken zu Balken treten mußte, wenn man sich dort oben bewegen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
