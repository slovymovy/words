                    {
                        "translation_id": "eb43c920-ca40-40ee-b3ed-33fe823b2c0d",
                        "source_entry_id": "58cbb79f-7124-36af-8585-44840462d793",
                        "source_sense_id": "8045e043-4de3-3453-b41b-8402e2f7b5bf",
                        "target_lang_word": "отцеубийца",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отцеубийца",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c79bd9c0-531e-3607-a17f-31a15133ef8b",
                                        "entry_id": "d5dad67d-2810-3346-99c5-9a4066fafd8c",
                                        "glosses": [
                                            "книжн. тот, кто убил своего отца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e2c4d5-5be3-4bac-95e6-4404c15f6c0a",
                                                "sense_id": "c79bd9c0-531e-3607-a17f-31a15133ef8b",
                                                "text": "Он знал о заговоре, стало быть участвовал в убийстве отца; короче, был отцеубийцею."
                                            },
                                            {
                                                "example_id": "f355fcfb-0db8-4a8e-b4e7-39996eaccbd2",
                                                "sense_id": "c79bd9c0-531e-3607-a17f-31a15133ef8b",
                                                "text": "Теперь отцеубийца сознался, объяснив, что покончил с отцом из-за споров при разделе имущества."
                                            },
                                            {
                                                "example_id": "1554e5e5-d513-46e6-993b-83dfeffc90eb",
                                                "sense_id": "c79bd9c0-531e-3607-a17f-31a15133ef8b",
                                                "text": "Упорствуя в их отыскании, Александр I ускользал от страшного для себя признания: реформы, ради которых он принял царство (и во многом ради которых стал вольным или невольным отцеубийцей!)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
