                                        "entry_id": "857c8a81-f6c6-337d-a575-61497c75af40",
                                        "glosses": [
                                            "für die Jagd trainierter Falke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a7ec13-670d-4e44-a680-41d38388369c",
                                                "sense_id": "cbbd34e0-3369-3371-8eba-d19b8c73a576",
                                                "text": "„Stell dir Tor Baz einfach als deinen Jagdfalken vor.“"
                                            },
                                            {
                                                "example_id": "8481a9dd-fc02-4be1-a9c3-4e56ea6bc932",
                                                "sense_id": "cbbd34e0-3369-3371-8eba-d19b8c73a576",
                                                "text": "„Er war dabei, die gebrochene Schwungfeder eines verkappten Jagdfalken zu richten und ging dabei so feinfühlig vor wie ein Elfenbeinschnitzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
