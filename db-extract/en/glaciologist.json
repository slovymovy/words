    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "96d37f07-080e-3b18-89f9-aae29c4e187c",
                "word": "glaciologist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5eb17199-d4b2-4547-8ad1-91db7f6a12d0",
                        "entry_id": "96d37f07-080e-3b18-89f9-aae29c4e187c",
                        "tags": [
