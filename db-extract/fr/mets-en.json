                "word": "mets-en",
                "pos": "phrase",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da1a2c39-4003-3218-b18e-fcb4b5d19130",
                        "entry_id": "0d0ba44d-ae27-3c00-864f-062c143a9963",
                        "glosses": [
                            "Oui, énormément, absolument, assurément."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "note": "S’utilise rarement au pluriel",
                        "examples": [
                            {
                                "example_id": "fc2bf102-b205-4f5a-afb8-ae89f6ba5926",
                                "sense_id": "da1a2c39-4003-3218-b18e-fcb4b5d19130",
                                "text": "Ça a dû faire mal ? — Mets-en !"
                            },
                            {
                                "example_id": "48a09d12-213a-4264-b735-7f761dfa65b4",
                                "sense_id": "da1a2c39-4003-3218-b18e-fcb4b5d19130",
                                "text": "Il a vraiment raté son coup. — Mets-en !"
                            },
                            {
                                "example_id": "cadb6dc9-f7a6-4692-bd9d-68db4ac8adff",
                                "sense_id": "da1a2c39-4003-3218-b18e-fcb4b5d19130",
                                "text": "Ça fait longtemps qu’on s’est vus. — Mets-en, que ça fait longtemps !"
                            },
                            {
                                "example_id": "b3821cb3-f15f-4171-904c-0e35abf8a5cd",
                                "sense_id": "da1a2c39-4003-3218-b18e-fcb4b5d19130",
                                "text": "• \"Je suis d'accord, mets-en!\""
                            },
                            {
                                "example_id": "2d757c39-425a-46c1-9dce-0f102c9da739",
                                "sense_id": "da1a2c39-4003-3218-b18e-fcb4b5d19130",
                                "text": "Il comprends rien pantoute ! Mets-en !"
                            }
                        ]
                    }
                ],
