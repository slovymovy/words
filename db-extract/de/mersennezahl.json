                        "examples": [
                            {
                                "example_id": "7fcd5a84-b121-4c5e-927c-bf0ee18c3645",
                                "sense_id": "1b5b9587-b485-3810-b05f-ce3a04aae2ee",
                                "text": "Die ersten Mersennezahlen sind 0, 1, 3, 7, 15, 31, 63, 127 und 255."
                            },
                            {
                                "example_id": "a8bd7b5b-9563-4f6e-8f43-b9f32a71a387",
                                "sense_id": "1b5b9587-b485-3810-b05f-ce3a04aae2ee",
                                "text": "„Ob eine Mersennezahl prim ist, ergibt, auch für große Zahlen, ziemlich schnell eine Prüfmethode, die dem Franzosen Edouard Lucas 1876 eingefallen und inzwischen mehrfach verbessert worden ist.“"
                            }
                        ],
