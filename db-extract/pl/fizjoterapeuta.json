                    {
                        "translation_id": "42d9e524-0981-46f6-a58d-2078208de1b4",
                        "source_entry_id": "f4a71c14-fc88-3b9f-b0c3-3669efdcfb5d",
                        "source_sense_id": "57d49d17-8e87-3a61-b554-c77418e123ee",
