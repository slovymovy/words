                        "glosses": [
                            "gebouw waar ambtenaren van de belastingdienst werkzaam zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053fea51-1ad2-44ff-b77f-8ea0247651e0",
                                "sense_id": "775df10f-fec0-30bb-a15f-56efb53975ed",
                                "text": "Circa 300 medewerkers van het belastingkantoor in Arnhem leggen voor anderhalf uur hun werk neer. Dit doen ze omdat minister Ollongren van Binnenlandse Zaken volgens hen hun looneis van 3,5 procent erbij heeft afgewezen. Het ultimatum van de vakbonden FNV Overheid, AC Rijksvakbonden, CNV Overheid en CMHF liep vorige week af."
                            },
                            {
                                "example_id": "c41c4f9d-3fa7-48a2-9efc-28ad451bf130",
                                "sense_id": "775df10f-fec0-30bb-a15f-56efb53975ed",
                                "text": "Er waren ook bommeldingen bij. Zo werden eerder deze week het belastingkantoor in Gelsenkirchen en het hoofdstation in Luebeck ontruimd na een bommelding. Explosieven werden niet gevonden."
                            }
                        ]
                    }
