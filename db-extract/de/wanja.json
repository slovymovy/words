                "senses": [
                    {
                        "sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                        "entry_id": "da0cb32a-44be-3f1b-ac71-2436bebc8b87",
                        "glosses": [
                            "männlicher Vorname; Koseform, Kurzform von Iwan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a77b2f-866b-4987-82e4-3087b714d7b3",
                                "sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                                "text": "Mein Kollege heißt Wanja."
                            },
                            {
                                "example_id": "db68a253-86b7-4826-a831-acf6d4143191",
                                "sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                                "text": "Anna und Wanja haben sieben Kinder."
                            },
                            {
                                "example_id": "030248ee-fd37-4fc8-8bc5-ebc60cb69775",
                                "sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                                "text": "Wanja spielt gern."
                            },
                            {
                                "example_id": "48fb24bc-5428-4e42-8cc1-0b7c3410fac4",
                                "sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                                "text": "Wanja Müller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f4f1b64d-61f2-4b9e-9466-7a30899d63c3",
                                "sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                                "text": "Kennen sie den Vornamen Wanja?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a145ca2a-8c6e-4ec8-a867-1987e75f7fe9",
                        "source_entry_id": "da0cb32a-44be-3f1b-ac71-2436bebc8b87",
                        "source_sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                        "source_sense_description": "männlicher Vorname; Koseform, Kurzform von Iwan",
                        "target_lang_word": "Vania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d12e90e-d59e-3565-8c9f-07e90ff94c3e",
                                        "entry_id": "dd6e7a97-9f92-3117-b66f-3da137a68beb",
                                        "glosses": [
                                            "Alternative spelling of Vanya."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44efc11b-1ce6-412c-9c62-98ff792af502",
                                                "sense_id": "5d12e90e-d59e-3565-8c9f-07e90ff94c3e",
                                                "text": "Vania, whose name derives from a Bulgarian father, turns toward another inlet on the Sontea Branch, almost entirely masked by willows."
                                            },
                                            {
                                                "example_id": "f389c390-5980-453c-a52b-87d209d9069a",
                                                "sense_id": "5d12e90e-d59e-3565-8c9f-07e90ff94c3e",
                                                "text": "Bodrov Jr. plays a young crew-cut recruit named Vania, first glimpsed being inducted assembly-line style into the Russian army."
                                            },
                                            {
                                                "example_id": "ae52e594-62ad-4ce5-a49c-a61f771132f6",
                                                "sense_id": "5d12e90e-d59e-3565-8c9f-07e90ff94c3e",
                                                "text": "Chekhov had four brothers and one sister - Aleksandr, Kolia, Vania, Misha and Masha."
                                            },
                                            {
                                                "example_id": "463f5605-5e12-4ee6-846d-b695a352f5d5",
                                                "sense_id": "5d12e90e-d59e-3565-8c9f-07e90ff94c3e",
                                                "text": "The Russians clinched the victory when Vera Zvonareva rallied to defeat Vania King, 4-6, 6-3, 6-2, in the first reverse singles match, giving her team a 3-0 lead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b68ccf4-3932-495f-a9d3-bfdc5e1255f0",
                        "source_entry_id": "da0cb32a-44be-3f1b-ac71-2436bebc8b87",
                        "source_sense_id": "ba284ff0-67b6-3046-9548-28c9fafd95b6",
                        "source_sense_description": "männlicher Vorname; Koseform, Kurzform von Iwan",
                        "target_lang_word": "Vanya",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vanya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a4cabf3-de78-372e-ad58-741915e89c4f",
                                        "entry_id": "ac52daee-1115-3828-ab25-20765ca671fb",
                                        "glosses": [
                                            "A transliteration of the pet form of the Russian male given name from Russian or Ukrainian Ива́н (Iván), Іван (Ivan)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0e2cda1-9852-395d-84bd-775eb9801d75",
                                        "entry_id": "ac52daee-1115-3828-ab25-20765ca671fb",
                                        "glosses": [
                                            "A female given name"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4f41292-ed22-43fa-8c69-cecc8575fe7c",
                                                "sense_id": "e0e2cda1-9852-395d-84bd-775eb9801d75",
                                                "text": "Aditi introduced him to Vanya, her five-year-old daughter. He could not meet her yesterday as she had gone for her drawing classes at that time. Vanya, dropping the crayons that she was busy coloring with, looked up at him and[…]"
                                            },
                                            {
                                                "example_id": "de570cc1-a11a-42c8-886b-48328264b672",
                                                "sense_id": "e0e2cda1-9852-395d-84bd-775eb9801d75",
                                                "text": "Nia looked at Vanya, her brown eyes searching her sister-in-law's face."
                                            },
                                            {
                                                "example_id": "e22e84b2-2148-4fd0-b483-0358ce4bf429",
                                                "sense_id": "e0e2cda1-9852-395d-84bd-775eb9801d75",
                                                "text": "Allison's words of warning to her sister Vanya express a common and everyday concern for many women."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ef3816d-59ae-3166-9d57-cfdf0474a2b8",
                                        "entry_id": "ac52daee-1115-3828-ab25-20765ca671fb",
                                        "glosses": [
                                            "A Russian."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e314dfb4-be30-4202-b2a2-c053fc57881f",
                                                "sense_id": "7ef3816d-59ae-3166-9d57-cfdf0474a2b8",
                                                "text": "Vanya had a drunken brawl with his friends at 3am."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
