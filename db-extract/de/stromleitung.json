                ],
                "senses": [
                    {
                        "sense_id": "74f1ef1c-d8f6-3a12-a19c-68e0b8caaf92",
                        "entry_id": "5ade1a58-272d-3c5c-a42d-b03a1b7450d5",
                        "glosses": [
                            "stromführende, elektrische Leitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4e79ad-0843-4ab7-9a4b-3b172df11a79",
                                "sense_id": "74f1ef1c-d8f6-3a12-a19c-68e0b8caaf92",
                                "text": "„Im Winter können Äste und Stromleitungen nach einem Regenguss plötzlich über und über mit Eis bedeckt sein.“"
                            },
                            {
                                "example_id": "2947afc0-e5eb-4bd1-8348-3101adf04df6",
                                "sense_id": "74f1ef1c-d8f6-3a12-a19c-68e0b8caaf92",
                                "text": "„Entlang der Hauptstraßen werden elektrische Laternen installiert, in alle Häuser, an denen Gäste vorüberkommen können, verlegen Arbeiter Stromleitungen.“"
                            },
                            {
                                "example_id": "335647ea-cc0e-45d6-ab4e-f2daafcfb1a4",
                                "sense_id": "74f1ef1c-d8f6-3a12-a19c-68e0b8caaf92",
                                "text": "„Oft führt weder eine Stromleitung noch eine asphaltierte Straße zu den Streusiedlungen.“"
                            },
                            {
                                "example_id": "7ccf665c-3e8b-42cd-9a4a-42ef6cd6e862",
                                "sense_id": "74f1ef1c-d8f6-3a12-a19c-68e0b8caaf92",
                                "text": "„Wir waren ungefähr 250 Kilometer gefahren, dem urbanisierten Norden entflohen und nun in der unendlichen Weite angekommen, obwohl immer noch Stromleitungen den Straßenrand säumten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
