                "senses": [
                    {
                        "sense_id": "78920a95-35c3-3179-9ceb-5df6e84cf9f5",
                        "entry_id": "17b85717-d9c9-30bb-87d4-fa82a0386627",
                        "glosses": [
                            "das, was sich im Krieg ereignet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08590553-8487-405a-b28e-e28db05a2f29",
                                "sense_id": "78920a95-35c3-3179-9ceb-5df6e84cf9f5",
                                "text": "„Durch die Kriegsereignisse waren über 30 Fahrzeuge schwer beschädigt, aber reparaturwürdig.“"
                            },
                            {
                                "example_id": "5d227555-8681-44ec-ab3b-6cc09a7a6594",
                                "sense_id": "78920a95-35c3-3179-9ceb-5df6e84cf9f5",
                                "text": "„Die damaligen Kriegsereignisse mit den militärischen Zwangseinquartierungen waren für Koblenz und seine Bürger eine enorme Belastung.“"
                            },
                            {
                                "example_id": "c9807d42-e438-4841-80e9-dc2dc33e0cbd",
                                "sense_id": "78920a95-35c3-3179-9ceb-5df6e84cf9f5",
                                "text": "„Auch die noch nicht lange zurückliegenden Kriegsereignisse spiegelten sich wider.“"
                            },
                            {
                                "example_id": "a6d70062-ebe8-49f0-8385-35ae69074147",
                                "sense_id": "78920a95-35c3-3179-9ceb-5df6e84cf9f5",
                                "text": "„Mit gierigem Eifer verfolgte man die Kriegsereignisse und verbreitete die für unsere Armee am günstigsten lautenden Gerüchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
