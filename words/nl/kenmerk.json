                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe <w>kenmerk</w> je de stijl van deze schilder?",
                            "target_lang_translations": {
