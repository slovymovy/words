                    {
                        "sense_id": "9abd99b2-c549-365b-a686-1eccd2c0e083",
                        "entry_id": "c2079ab4-419a-348f-b92e-855906b70a7c",
                        "glosses": [
                            "Antidouleur."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "b3ed045b-6437-4dff-8240-11c059824984",
                                "sense_id": "9abd99b2-c549-365b-a686-1eccd2c0e083",
                                "text": "Le laser classique est utilisé par les kinésithérapeutes ; il s'agit de laser à diode infrarouge qui a un effet anti-inflammatoire et antalgique."
                            },
                            {
                                "example_id": "e921e610-442a-4fc5-9ac6-e483f66f6912",
                                "sense_id": "9abd99b2-c549-365b-a686-1eccd2c0e083",
                                "text": "La sauge est œstrogénique, antioxydante, antalgique, anti-inflammatoire, neuro-protectrice, anti-asthénique et antiseptique localement."
                            },
                            {
                                "example_id": "7703e225-18d7-4c28-aaf2-efc6517eabde",
                                "sense_id": "9abd99b2-c549-365b-a686-1eccd2c0e083",
                                "text": "Parmi les nombreux composés retrouvés dans le cannabis, deux molécules retiennent l’attention pour leurs propriétés relaxantes et antalgiques : le cannabidiol (CBD) et le tétrahydrocannabinol (THC)."
                            }
                        ]
                    }
