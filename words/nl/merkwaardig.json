            "senses": [
                {
                    "sense_id": "53f52b40-8f37-3652-a1a5-9d2b1ef76546",
                    "sense_definition": "anders dan wat je verwacht en daarom een beetje vreemd of raar",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vreemd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een <w>merkwaardig</w> verhaal dat ik gisteren van mijn buurman hoorde.",
                            "target_lang_translations": {
                                "en": "It is a <w>strange</w> story that I heard from my neighbor yesterday."
                            }
                        },
                        {
                            "text": "Ik vind het een <w>merkwaardige</w> gewoonte om midden in de nacht te gaan sporten.",
                            "target_lang_translations": {
                                "en": "I think it's a <w>peculiar</w> habit to start exercising in the middle of the night."
                            }
                        }
                    ],
                    "synonyms": [
