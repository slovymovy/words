                                "target_senses": [
                                    {
                                        "sense_id": "f95b6c86-7f08-3a10-a037-3c32e4f3afe1",
                                        "entry_id": "71a4c4f8-77af-3fa5-b8f6-913e0a4ec4ce",
                                        "glosses": [
                                            "Alternative spelling of somberness."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7b0d6d-8228-4f22-9eb9-64974fde0aa2",
                                                "sense_id": "f95b6c86-7f08-3a10-a037-3c32e4f3afe1",
                                                "text": "The idleness of a passenger, my isolation amongst all these men with whom I had no point of contact, the oily and languid sea, the uniform sombreness of the coast, seemed to keep me away from the truth of things within the toil of a mournful and senseless delusion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "816c7566-f4e4-473a-af06-8fd2492e9e91",
                        "source_entry_id": "c02e9e95-c9dc-3391-b3ad-281fc8b6fdad",
                        "source_sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                        "target_lang_word": "somberness",
                        "target_lang_code": "en",
