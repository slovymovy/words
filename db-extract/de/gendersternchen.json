                ],
                "senses": [
                    {
                        "sense_id": "5e614d1f-ccf7-3331-a93a-e1fc933ea3d0",
                        "entry_id": "c31b5120-2371-3d99-b052-f21c3137f019",
                        "glosses": [
                            "Asterisk, der bei Personenbezeichnungen zwischen dem Wortstamm und dem femininen Suffix steht (zum Beispiel Student*in); er soll alle möglichen Geschlechter oder Geschlechtsidentitäten (besonders auch solche jenseits von männlich und weiblich) repräsentieren. Seine Verwendung ist jedoch nicht Bestandteil der amtlichen Rechtschreibung."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fd02d4-c764-4e22-99b8-fb32781beef6",
                                "sense_id": "5e614d1f-ccf7-3331-a93a-e1fc933ea3d0",
                                "text": "Die Grünen nutzen das Gendersternchen seit 2015."
                            },
                            {
                                "example_id": "d154b32f-79f6-47ca-8379-a091d9a6e68d",
                                "sense_id": "5e614d1f-ccf7-3331-a93a-e1fc933ea3d0",
                                "text": "Er gendert seine Texte mit dem Gendersternchen."
                            },
                            {
                                "example_id": "2457b220-0536-43ee-877e-90a3706ad194",
                                "sense_id": "5e614d1f-ccf7-3331-a93a-e1fc933ea3d0",
                                "text": "Der Leitfaden schreibt die Verwendung des Gendersternchens vor."
                            },
                            {
                                "example_id": "83cdf6b3-386e-4134-9779-2d4dd89e7072",
                                "sense_id": "5e614d1f-ccf7-3331-a93a-e1fc933ea3d0",
                                "text": "„Wenn es Sie tröstet: Ich habe das Gendersternchen beim Schreiben des Buches konsequent genutzt und habe es zugunsten des Redeflusses von Hand wieder entfernen müssen, was sehr viel Zeit in Anspruch nahm.“"
                            },
                            {
                                "example_id": "0b1c5823-f4c5-4929-98be-e008498e6e51",
                                "sense_id": "5e614d1f-ccf7-3331-a93a-e1fc933ea3d0",
                                "text": "„Wenn ich für Gleichberechtigung eintrete, kann ich dennoch Vorbehalte gegenüber dem Gendersternchen haben, das Binnen-I ablehnen oder mich auch für den grammatikalischen Unterschied zwischen ‚dem Leser‘ und ‚dem Lesenden‘ starkmachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
