                "translations": [
                    {
                        "translation_id": "37d2dd88-e287-4c88-8746-af2166bbad8d",
                        "source_entry_id": "430767db-7892-336c-9733-45c82e337d34",
                        "source_sense_id": "1a3b0860-ea1a-31c5-ac20-d8b87d5f040b",
                        "source_sense_description": "een persoon die rechtspreekt",
                        "target_lang_word": "Magistrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magistrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dae5d33-1b66-3224-8879-b93d16286c15",
                                        "entry_id": "63974bbc-7819-370b-8f66-74dcbbc6bc1f",
                                        "glosses": [
                                            "ein Amt oder eine Behörde für Verwaltungsaufgaben der Bevölkerung einer Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a0e6e3-359b-4cfb-bad8-d0582bb869b6",
                                                "sense_id": "9dae5d33-1b66-3224-8879-b93d16286c15",
                                                "text": "Der Magistrat besteht aus dem (Ober-)Bürgermeister sowie haupt- und ehrenamtlichen Stadträten."
                                            },
                                            {
                                                "example_id": "f23f0923-001e-42c4-9d5c-72639d91f1cb",
                                                "sense_id": "9dae5d33-1b66-3224-8879-b93d16286c15",
                                                "text": "Um die für 2011 vom Magistrat beschlossene Schließung der Bibliothek abzuwenden, habe der Förderverein das Gespräch mit Stadtverordneten der CDU gesucht."
                                            },
                                            {
                                                "example_id": "1f2cf914-3613-46f9-ae20-af13055e5de3",
                                                "sense_id": "9dae5d33-1b66-3224-8879-b93d16286c15",
                                                "text": "„Dem Magistrat obliegen insbesondere außer den ihm sonst zugewiesenen Angelegenheiten die im § 105 Abs. 3 der Verfassung der Bundeshauptstadt Wien angeführten Aufgaben.“"
                                            },
                                            {
                                                "example_id": "3dffdcea-4c29-4f78-aa22-0889afd030c6",
                                                "sense_id": "9dae5d33-1b66-3224-8879-b93d16286c15",
                                                "text": "„Die Gemeindewahlbehörden, in Wien der Magistrat, haben zugleich mit der Festsetzung der besonderen Wahlsprengel auch zu bestimmen, wieviele besondere Wahlbehörden gemäß § 73 eingerichtet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Magistrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7808af63-ea10-36cb-ab57-809b887cd9d5",
                                        "entry_id": "a261759f-7aec-37ea-b3c1-10640aec07e7",
                                        "glosses": [
                                            "gewählter städtischer Amtsträger"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7589fc6-07d7-4953-9fd7-c177aca2b505",
                        "source_entry_id": "430767db-7892-336c-9733-45c82e337d34",
                        "source_sense_id": "1a3b0860-ea1a-31c5-ac20-d8b87d5f040b",
                        "source_sense_description": "een persoon die rechtspreekt",
                        "target_lang_word": "magistrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magistrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82434e02-da99-3306-8797-fa0988fb3eaf",
                                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                                        "glosses": [
                                            "A judicial officer with limited authority to administer and enforce the law. A magistrate's court may have jurisdiction in civil or criminal cases, or both."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a9e480-f0e3-427c-a1f0-8f3b93884ac0",
                                                "sense_id": "82434e02-da99-3306-8797-fa0988fb3eaf",
                                                "text": "In any case, however, I saw that part of her injuries might easily have been redressed, and I urged her often and earnestly to lay her complaint before a magistrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c813584-352b-30e2-a908-6147d3b3d571",
                                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                                        "glosses": [
                                            "A high official of the state or a municipality in ancient Greece or Rome."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec5a7821-e8af-3f5e-be14-c4d24e182cf8",
                                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                                        "glosses": [
                                            "A comparable official in medieval or modern institutions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1442b933-0289-4c75-b8a5-77b14847485f",
                                                "sense_id": "ec5a7821-e8af-3f5e-be14-c4d24e182cf8",
                                                "text": "Like other civil servants, Ashok Kumar started his career as an Assistant Collector cum Sub-divisional Magistrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0eb660d-db94-366e-b7b5-cb6d3be5be3f",
                                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                                        "glosses": [
                                            "A master's degree."
                                        ],
                                        "tags": [
                                            "Quebec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fdd45dd-a688-4162-9320-88daa560c68c",
                        "source_entry_id": "430767db-7892-336c-9733-45c82e337d34",
                        "source_sense_id": "1a3b0860-ea1a-31c5-ac20-d8b87d5f040b",
                        "source_sense_description": "een persoon die rechtspreekt",
                        "target_lang_word": "magistrat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magistrat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8da02ca-bc4d-3b20-86c7-c08943cda6b0",
                                        "entry_id": "a0bcd57c-16e3-3324-9355-98f79f1fc00e",
                                        "glosses": [
                                            "Officier civil revêtu d’une autorité administrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a89bc6-1f78-4a9f-aeae-96fa2d0fb770",
                                                "sense_id": "d8da02ca-bc4d-3b20-86c7-c08943cda6b0",
                                                "text": "On trouverait aujourd'hui étrange que des magistrats se missent à la tête de bandes armées, comme cela avait lieu à Rome durant les dernières années de la République."
                                            },
                                            {
                                                "example_id": "b25daf25-1833-482f-b3d4-53411fbd32c3",
                                                "sense_id": "d8da02ca-bc4d-3b20-86c7-c08943cda6b0",
                                                "text": "Le maire, premier magistrat de la ville, est le représentant de l'Etat dans la commune."
                                            },
                                            {
                                                "example_id": "71b14fde-e6ec-46af-82b4-833716382478",
                                                "sense_id": "d8da02ca-bc4d-3b20-86c7-c08943cda6b0",
                                                "text": "Dès que j'ai mis le pied à Rouen, j'ai eu le premier magistrat de la ville sur le dos : Éric Lenabre, une tête de vainqueur ! Il m'est tombé dessus chez les collègues, […]."
                                            },
                                            {
                                                "example_id": "dcab69c7-8c5a-44b6-8138-aa2a930c6b74",
                                                "sense_id": "d8da02ca-bc4d-3b20-86c7-c08943cda6b0",
                                                "text": "Les préfets, les sous-préfets sont les magistrats de chaque département."
                                            },
                                            {
                                                "example_id": "ee00353b-73c7-4193-8e8c-4f55c104ee01",
                                                "sense_id": "d8da02ca-bc4d-3b20-86c7-c08943cda6b0",
                                                "text": "Octobre 1962, la première dissolution de De Gaulle. La presse n’est pas tendre à l’époque. A la une du Monde, on peut lire ceci : « A partir du moment où le premier magistrat de France jette son pays, comme par jeu, dans le trouble et le déchirement, on peut se demander (…) si sa présence est toujours utile. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4aa5578-5cfa-3edb-8d9a-dbd56d7bace7",
                                        "entry_id": "a0bcd57c-16e3-3324-9355-98f79f1fc00e",
                                        "glosses": [
                                            "Celui qui rend la justice ou la requiert (juge, procureur ou conseiller)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435ef7e6-4d78-4f6d-be50-57ad762ea54d",
                                                "sense_id": "a4aa5578-5cfa-3edb-8d9a-dbd56d7bace7",
                                                "text": "Un riche propriétaire, M. Roudier, au visage grassouillet et insinuant, y discourait des heures entières, avec la passion d’un orléaniste que la chute de Louis-Philippe avait dérangé dans ses calculs. C’était un bonnetier de Paris retiré à Plassans, ancien fournisseur de la cour, qui avait fait de son fils un magistrat, comptant sur les Orléans pour pousser ce garçon aux plus hautes dignités."
                                            },
                                            {
                                                "example_id": "9e880e71-0f04-4e53-8346-d39db0a9e980",
                                                "sense_id": "a4aa5578-5cfa-3edb-8d9a-dbd56d7bace7",
                                                "text": "Les magistrats acquirent bientôt la conviction que l’empoisonneur était... une empoisonneuse : la propre mère du petit Henri, Charlotte Lamarche, […]."
                                            },
                                            {
                                                "example_id": "023e56dd-0063-406a-bc33-df6812e10400",
                                                "sense_id": "a4aa5578-5cfa-3edb-8d9a-dbd56d7bace7",
                                                "text": "Dans la logique mentale de leur temps, les magistrats l'accusent et la condamnent de « sorcellerie », crime pour lequel le bourreau l’énuque avec la « hart » de la potence (corde d'infamie)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7921493-9f27-34de-9205-4ad85bf1d8ab",
                                        "entry_id": "a0bcd57c-16e3-3324-9355-98f79f1fc00e",
                                        "glosses": [
                                            "Juge."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "note": "Les autres sens ne sont pas vraiment en usage au Canada, sauf en parlant d'autres pays",
                                        "examples": [
                                            {
                                                "example_id": "5b157882-f3eb-49e9-9c01-1aab2b287001",
                                                "sense_id": "d7921493-9f27-34de-9205-4ad85bf1d8ab",
                                                "text": "Le magistrat n'a pas jugé que la preuve établissait hors de tout doute qu'ils étaient liés à un même groupe criminel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14df1e63-47ae-3b55-8d46-45279367e82c",
                                        "entry_id": "a0bcd57c-16e3-3324-9355-98f79f1fc00e",
                                        "glosses": [
                                            "Administration municipale sous forme collégiale de certaines villes européennes du Moyen-Âge au XVIIIᵉ siècle."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "note": "Le plus souvent écrit « Magistrat », avec une majuscule",
                                        "examples": [
                                            {
                                                "example_id": "7611a621-5700-47a2-bdf2-d14c6fbf4e2d",
                                                "sense_id": "14df1e63-47ae-3b55-8d46-45279367e82c",
                                                "text": "Cette réunion à l’hôtel de ville devait se tenir après l’approbation de la pharmacopée par le censeur royal de Paris, qui fut accordée le 8 juillet 1731. La ratification en fut donnée par le magistrat de Douai le 29 mai 1732."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9fee9c-6a05-3313-8ee2-fc2cd4137236",
                                        "entry_id": "a0bcd57c-16e3-3324-9355-98f79f1fc00e",
                                        "glosses": [
                                            "Colobe magistrat."
                                        ],
                                        "tags": [
                                            "Primatologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
