{
    "word_family": [
        "stomper",
        "stomping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "427030b6-64fa-3b5f-9248-ce568c45f4e0",
                    "sense_definition": "To walk with heavy, forceful steps, often to show anger or to make noise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry customer began to <w>stomp</w> toward the double doors after the argument.",
                            "target_lang_translations": {
                                "ru": "Разгневанный покупатель начал <w>топать</w> к двойным дверям после спора."
                            }
                        },
                        {
                            "text": "I could hear him <w>stomp</w> upstairs because the floorboards are very thin.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как он <w>топочет</w> наверху, потому что половицы очень тонкие."
                            }
                        }
                    ],
                    "synonyms": [
                        "stamp",
                        "clomp"
                    ],
                    "common_phrases": [
                        "stomp upstairs",
                        "stomp around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти тяжелыми, решительными шагами, часто выражая гнев или создавая шум."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топать",
                                "target_lang_sense_clarification": "идти с шумом"
                            },
                            {
                                "target_lang_word": "топотать",
                                "target_lang_sense_clarification": "громко шагать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "412b27bd-ae87-3e6f-bce5-bc174f8efa91",
                    "sense_definition": "To bring down one's foot forcibly onto the ground or an object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child started to <w>stomp</w> his feet in a temper tantrum.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал <w>топать</w> ногами в приступе гнева."
                            }
                        },
                        {
                            "text": "You need to <w>stomp</w> on the pedal to make the machine start.",
                            "target_lang_translations": {
                                "ru": "Вам нужно сильно <w>наступить</w> на педаль, чтобы запустить машину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomp your feet",
                        "stomp on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить ногой по земле или какому-либо предмету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топнуть",
                                "target_lang_sense_clarification": "однократное действие ногой"
                            },
                            {
                                "target_lang_word": "наступить",
                                "target_lang_sense_clarification": "с силой нажать ногой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0fa64c8-767e-30e2-ab46-7da943499916",
                    "sense_definition": "To crush grapes with one's feet as a traditional method of making wine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "crushing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, workers would <w>stomp</w> grapes in large wooden vats.",
                            "target_lang_translations": {
                                "ru": "В прежние времена рабочие <w>давили</w> виноград в больших деревянных чанах."
                            }
                        },
                        {
                            "text": "The festival allows tourists to <w>stomp</w> grapes just like they did centuries ago.",
                            "target_lang_translations": {
                                "ru": "Фестиваль позволяет туристам <w>топтать</w> виноград точно так же, как это делали столетия назад."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomp grapes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давить виноград ногами как традиционный метод виноделия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давить",
                                "target_lang_sense_clarification": "ногами виноград"
                            },
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "приминать ногами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091f5f44-58c8-3215-934e-ea5c329ca65f",
                    "sense_definition": "To completely defeat or overwhelm an opponent, especially in a competition or sports.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "victory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team managed to <w>stomp</w> the competition in the final round of the tournament.",
                            "target_lang_translations": {
                                "ru": "Нашей команде удалось <w>разгромить</w> конкурентов в финальном раунде турнира."
                            }
                        },
                        {
                            "text": "They expected a close game, but the home team proceeded to <w>stomp</w> their rivals.",
                            "target_lang_translations": {
                                "ru": "Они ожидали равной игры, но хозяева поля <w>растоптали</w> своих соперников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stomp the competition"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe a decisive victory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью победить или разгромить противника, особенно в соревновании или спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "одержать полную победу"
                            },
                            {
                                "target_lang_word": "растоптать",
                                "target_lang_sense_clarification": "переносное значение поражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b01e890-ea83-34c2-b30b-b237108217f8",
                    "sense_definition": "To severely beat someone physically or figuratively.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully threatened to <w>stomp</w> anyone who got in his way.",
                            "target_lang_translations": {
                                "ru": "Хулиган угрожал <w>избить</w> любого, кто встанет у него на пути."
                            }
                        },
                        {
                            "text": "The critics will <w>stomp</w> that movie because the acting is so poor.",
                            "target_lang_translations": {
                                "ru": "Критики <w>растопчут</w> этот фильм, потому что актерская игра очень слабая."
                            }
                        }
                    ],
                    "synonyms": [
                        "crush"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often implies physical violence or harsh criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко избить кого-либо физически или подвергнуть резкой критике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избивать",
                                "target_lang_sense_clarification": "физическое насилие"
                            },
                            {
                                "target_lang_word": "растоптать",
                                "target_lang_sense_clarification": "жестоко раскритиковать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d68b1b8e-d03b-362a-895b-755d2bccc0fb",
                    "sense_definition": "A deliberate heavy footfall or the sound made by it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She obliterated the cockroach with one heavy <w>stomp</w> of her boot.",
                            "target_lang_translations": {
                                "ru": "Она уничтожила таракана одним тяжелым <w>ударом</w> сапога."
                            }
                        },
                        {
                            "text": "The giant's every <w>stomp</w> made the ground shake beneath our feet.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>топот</w> великана заставлял землю дрожать под нашими ногами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "one heavy stomp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренный тяжелый шаг или звук, издаваемый им."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топот",
                                "target_lang_sense_clarification": "звук шагов"
                            },
                            {
                                "target_lang_word": "удар ногой",
                                "target_lang_sense_clarification": "тяжелое приземление стопы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a8f8168-26c7-3907-b756-81467c830d09",
                    "sense_definition": "A social gathering or party where dancing is the main activity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We’re going to a <w>stomp</w> tonight to celebrate the end of the semester.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы идем на <w>вечеринку</w>, чтобы отпраздновать окончание семестра."
                            }
                        },
                        {
                            "text": "The local community center is hosting a <w>stomp</w> for the teenagers this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные местный общественный центр устраивает <w>танцы</w> для подростков."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in certain dialects to refer to a dance party"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественное собрание или вечеринка, где танцы являются основным занятием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танцевальная вечеринка",
                                "target_lang_sense_clarification": "мероприятие с танцами"
                            },
                            {
                                "target_lang_word": "пляски",
                                "target_lang_sense_clarification": "разговорное обозначение танцев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2260ef05-70e5-3327-bb08-b16844b0ee11",
                    "sense_definition": "A type of dance characterized by repeated heavy, rhythmic steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performers did the <w>stomp</w> with incredible energy and precision.",
                            "target_lang_translations": {
                                "ru": "Исполнители танцевали <w>стомп</w> с невероятной энергией и точностью."
                            }
                        },
                        {
                            "text": "He learned how to do the <w>stomp</w> while visiting the southern states.",
                            "target_lang_translations": {
                                "ru": "Он научился танцевать <w>стомп</w>, когда посещал южные штаты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "do the stomp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип танца, характеризующийся повторяющимися тяжелыми ритмичными шагами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стомп",
                                "target_lang_sense_clarification": "название танца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "933abfb5-9088-3ba7-a57c-b2bc96dc354b",
                    "sense_definition": "A style of jazz music from the early twentieth century intended for rhythmic dancing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a classic <w>stomp</w> that got everyone on the dance floor.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла классический <w>стомп</w>, который вывел всех на танцпол."
                            }
                        },
                        {
                            "text": "Early jazz history is filled with various forms of the <w>stomp</w>.",
                            "target_lang_translations": {
                                "ru": "Ранняя история джаза наполнена различными формами <w>стомпа</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a specific historical musical era"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль джазовой музыки начала двадцатого века, предназначенный для ритмичных танцев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стомп",
                                "target_lang_sense_clarification": "джазовый стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e044ec02-48d9-33b0-8962-633b630f68d6",
                    "sense_definition": "A specific piece of music composed in the jazz stomp style.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist performed a famous <w>stomp</w> composed in the 1920s.",
                            "target_lang_translations": {
                                "ru": "Пианист исполнил знаменитый <w>стомп</w>, написанный в 1920-х годах."
                            }
                        },
                        {
                            "text": "King Porter <w>Stomp</w> remains one of the most influential recordings of that era.",
                            "target_lang_translations": {
                                "ru": "King Porter <w>Stomp</w> остается одной из самых влиятельных записей той эпохи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical musical compositions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное музыкальное произведение, написанное в стиле джазового стомпа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стомп",
                                "target_lang_sense_clarification": "музыкальная пьеса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}