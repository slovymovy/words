                "senses": [
                    {
                        "sense_id": "4814c135-3910-354c-b09a-923c1717ef6f",
                        "entry_id": "d3a38102-16e1-3ffa-9df6-53cd07b6bb8b",
                        "glosses": [
                            "eine Lichtanlage, die in einem Fotostudio oder auch in Verkaufsräumen Tageslicht simuliert"
                        ],
                        "tags": [
                            "Fotografie",
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "e08cc921-24fa-42c7-bf9d-f643fd05458d",
                                "sense_id": "4814c135-3910-354c-b09a-923c1717ef6f",
                                "text": "Die qualitativ hochwertige, elektronisch regelbare Tageslichtanlage mit Infrarotfernbedienung läßt auch im Winter keine trübe Stimmung aufkommen."
                            },
                            {
                                "example_id": "24ae243d-e4aa-4e2b-b3be-4fffa7588a75",
                                "sense_id": "4814c135-3910-354c-b09a-923c1717ef6f",
                                "text": "Neben dem rein energetisch positiven Ergebnis belegt das Gutachten zudem, dass der Umsatz in den Bereichen mit Tageslicht signifikant höher ist, als in den Bereichen ohne. … Allein diese Tatsache lässt die Amortisation auf den Moment der Inbetriebnahme einer Tageslichtanlage zusammenschrumpfen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b91d4e7-78a9-3358-bc38-b5c4d79fd1ff",
                        "entry_id": "d3a38102-16e1-3ffa-9df6-53cd07b6bb8b",
                        "glosses": [
                            "eine Lichtanlage am Auto oder am Motorrad, die tagsüber während der Fahrt aus Sicherheitsgründen (Motto: Besser gesehen werden!) eingeschaltet ist"
                        ],
                        "tags": [
                            "Automobil- und Motorradbau"
                        ],
                        "examples": [
                            {
                                "example_id": "ec186451-2ac5-42fc-94e6-57e2a9278ed8",
                                "sense_id": "6b91d4e7-78a9-3358-bc38-b5c4d79fd1ff",
                                "text": "\"Die tollen EU-Kommisare beraten doch über eine generelle Tageslichtanlage bei Autos wie es bei Motorrädern ja schon lange Pflicht ist.\""
                            },
                            {
                                "example_id": "272c647c-c3d0-4bfc-bbbb-22a7c5442789",
                                "sense_id": "6b91d4e7-78a9-3358-bc38-b5c4d79fd1ff",
                                "text": "Neuere Automodelle haben oft eine Tageslichtanlage auf Basis der LED-Technik."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
