                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                        "entry_id": "538b54d7-77fc-3f6d-a266-f71d03562a2c",
                        "glosses": [
                            "Mathématiques."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9416c27d-457e-4759-9484-eb78ded63690",
                                "sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                                "text": "Voilà qui étaient vraiment nos polytechniciens. Des polymagiciens de pacotille, forts en maths, certes, mais sans un sou de jugeote."
                            },
                            {
                                "example_id": "127ec670-c0de-4502-a614-feafec5f0516",
                                "sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                                "text": "« Au temps pour moi », concède ma prof de maths quand quelqu'un relève une erreur au tableau."
                            },
                            {
                                "example_id": "cc661f27-4e54-42a3-b788-97d97ca23be7",
                                "sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                                "text": "Toutes ces réflexions accompagnant mon recopiage appliqué du DM de maths, je loupe une ligne. Excédée, je blancote à tout-va et fais de ma copie un torchon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec0521ae-422f-4a7f-8a7f-f9682e91d8a9",
                        "source_entry_id": "538b54d7-77fc-3f6d-a266-f71d03562a2c",
                        "source_sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                        "target_lang_word": "Mathe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mathe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2228ece-7d25-3c3f-91de-8405ac826462",
                                        "entry_id": "86f86e16-4cee-3d14-adba-38feb6702f48",
                                        "glosses": [
                                            "(das Schulfach) Mathematik"
                                        ],
                                        "tags": [
                                            "schülersprachlich",
                                            "meist ohne Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606a36c2-0f70-4df2-8a5f-6b8e5d4223ae",
                                                "sense_id": "e2228ece-7d25-3c3f-91de-8405ac826462",
                                                "text": "Abgesehen von Mathe ist mein Zeugnis ziemlich gut."
                                            },
                                            {
                                                "example_id": "dc443ec2-1910-4b61-8141-7e63c7d42f37",
                                                "sense_id": "e2228ece-7d25-3c3f-91de-8405ac826462",
                                                "text": "„Der Mathematiklehrer, ein Deutscher, erklärte uns den Stundenplan: zwei Stunden Bio, zwei Stunden Englisch, zwei Stunden Geschichte, zwei Stunden Französisch und zum Abschluss eine Stunde Mathe.“"
                                            },
                                            {
                                                "example_id": "c8bbc8d3-2f22-42f3-8a15-09af15525ee9",
                                                "sense_id": "e2228ece-7d25-3c3f-91de-8405ac826462",
                                                "text": "„Mein Bruder ist ein Rechengenie, er hat später sogar Mathematik studiert – darum war ich in Mathe immer schlecht.“"
                                            },
                                            {
                                                "example_id": "d8a0dd45-49df-4c49-a141-10c7aabed86a",
                                                "sense_id": "e2228ece-7d25-3c3f-91de-8405ac826462",
                                                "text": "„Ich hatte den Biologieunterricht verschlafen, und in Mathe war ich immer schwach gewesen.“"
                                            },
                                            {
                                                "example_id": "a9cd647b-adfa-42e8-92df-13dc8b15b271",
                                                "sense_id": "e2228ece-7d25-3c3f-91de-8405ac826462",
                                                "text": "„[Interviewer:] »Sie meinen, mit Mathe werden Schüler ausgesiebt?« [R. Yogeshwar:] »Richtig, Mathematik wird für Prüfungszwecke missbraucht.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94932053-1360-41ba-bae9-9c264938cc51",
                        "source_entry_id": "538b54d7-77fc-3f6d-a266-f71d03562a2c",
                        "source_sense_id": "e3f0c917-9594-3523-8e99-f6212178e09a",
                        "target_lang_word": "maths",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maths",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d35732ae-46c5-3236-9fc1-c7d4d9420862",
                                        "entry_id": "802db2fa-b40e-3ea9-9808-912f7f10dfe0",
                                        "glosses": [
                                            "Clipping of mathematics."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Commonwealth",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "040f6e24-2828-4e7e-b42a-92101cd93afa",
                                                "sense_id": "d35732ae-46c5-3236-9fc1-c7d4d9420862",
                                                "text": "The conventional “commonsense” view now is that girls are conditioned both by family and teachers to believe that maths is a subject at which males excel, and that they believe they cannot be expected to comprehend its subtleties — so they don′t."
                                            },
                                            {
                                                "example_id": "5354b1f8-ac30-4df9-8fc7-742a8150e996",
                                                "sense_id": "d35732ae-46c5-3236-9fc1-c7d4d9420862",
                                                "text": "At age 10, Ian was based with the Grade 6 students but was allowed to take maths with Grade 10 – a four-year grade advancement."
                                            },
                                            {
                                                "example_id": "31ed4278-bb1a-43f9-b5fd-f4c33ade9e8b",
                                                "sense_id": "d35732ae-46c5-3236-9fc1-c7d4d9420862",
                                                "text": "Most people who are forced to use maths have little idea what it is really about."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maths",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95be3297-4132-3e06-81cb-63d77f2805ed",
                                        "entry_id": "ed90433d-1c28-3499-8b30-b29308312e72",
