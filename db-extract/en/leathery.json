                                                "sense_id": "c6b84347-3235-32ab-b1e1-fdcfe92ce049",
                                                "text": "Er war mit sich selbst sehr zufrieden, denn er hatte sein erstes Fell geledert und das Resultat war hervorragend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9612e4f8-c120-3542-b2c1-0a197d1fadfd",
                                        "entry_id": "cacb2f44-e493-324e-baa6-9dfefd81c060",
                                        "glosses": [
                                            "mit Leder versehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a146107-7cce-44de-af78-0844b95533b7",
                                                "sense_id": "9612e4f8-c120-3542-b2c1-0a197d1fadfd",
                                                "text": "Wir ledern unsere Sofas mit den besten Fellen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
