        "fr-extract.jsonl": [
            {
                "entry_id": "17363ea8-dc09-3e65-aca1-3fb837184ec2",
                "word": "héliocentrique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5d58722-3c7d-488b-b049-32abd7c6a169",
                        "entry_id": "17363ea8-dc09-3e65-aca1-3fb837184ec2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "héliocentriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5e298b1-4408-38ab-9a18-5a27dc28ada8",
                        "entry_id": "17363ea8-dc09-3e65-aca1-3fb837184ec2",
                        "glosses": [
                            "Qui a pour centre le soleil (et plus précisément le centre de celui-ci), ou qui est mesuré dans un référentiel centré sur lui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4783204-96cd-496b-ab75-18d0e8f7daa8",
                                "sense_id": "d5e298b1-4408-38ab-9a18-5a27dc28ada8",
                                "text": "La position d’une planète dans un référentiel héliocentrique. Les coordonnées héliocentriques, la distance, l'orbite héliocentrique d’une planète."
                            }
                        ]
                    },
                    {
                        "sense_id": "61cf7d8b-15a4-3471-8996-f45b8555dadf",
                        "entry_id": "17363ea8-dc09-3e65-aca1-3fb837184ec2",
                        "glosses": [
                            "Qui place le soleil au centre du système planétaire, par opposition au géocentrisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b356f1bf-7799-427d-932d-379ab12d46cd",
                                "sense_id": "61cf7d8b-15a4-3471-8996-f45b8555dadf",
                                "text": "Aristarque de Samos (310–230 av. J.-C.) est le premier savant dans la Grèce antique à proposer un modèle héliocentrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a87ec02-b3c7-4100-97da-aed06b339045",
                        "source_entry_id": "17363ea8-dc09-3e65-aca1-3fb837184ec2",
                        "target_lang_word": "heliocentric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heliocentric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                        "entry_id": "4de74f67-40bb-3807-b239-6cb46a9cd8aa",
                                        "glosses": [
                                            "Having the sun at the center/centre; usually in reference to a coordinate system or orbit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2f0af8-b9e1-4b70-b522-6dbf55e8e16d",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "a heliocentric coordinate system"
                                            },
                                            {
                                                "example_id": "bacbbf33-43a5-4e2e-82ba-5897f7446e48",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "a heliocentric orbit"
                                            },
                                            {
                                                "example_id": "0392baa7-d1d0-4547-a8e0-ec2ec3768cfc",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "To make the Catalogue of Eclipses, as also the Table of the Parallaxes of [Jupiter], it was necessary first to make a Table of [Jupiter]' Heliocentrick places, to which the Parallaxes being applied, give the Geocentrick."
                                            },
                                            {
                                                "example_id": "12517051-27f6-492f-8a48-de227842beaf",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "Apollyon, who, as god of the sun, has a certain stake in the matter, teaches the Prior the truth of what the Greeks, Pythagoras' disciples, knew many years before— the nature of the heliocentric (or pyrocentric) planetary system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3c9020-4a6b-3853-965c-1bc44b55ad8d",
                                        "entry_id": "4de74f67-40bb-3807-b239-6cb46a9cd8aa",
                                        "glosses": [
                                            "Of or relating to heliocentrism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
