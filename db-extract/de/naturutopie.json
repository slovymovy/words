                "senses": [
                    {
                        "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                        "entry_id": "588ab364-1368-360b-b861-82976d152027",
                        "glosses": [
                            "utopische Vorstellung einer von der Natur beherrschten Welt oder Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed3c6a0-8eb9-49fb-85d7-d21bec8e2e22",
                                "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                                "text": "„Diese Wucht der Natur erscheint in den Naturutopien als zu bejahende, anstatt zu zähmende Kraft.“"
                            },
                            {
                                "example_id": "9bf787a8-6a93-4c4b-be6e-472bb997b211",
                                "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                                "text": "„Drückt sich im Märchenzauber der Erzählung eine Naturutopie als Zivilisationskritik aus?“"
                            },
                            {
                                "example_id": "722e9ce7-8a31-4d31-ab09-9b6c827d20bf",
                                "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                                "text": "„Paradiesische Naturutopien ermöglichen psychologisch eine starke Identifikation von Mensch und Natur.“"
                            },
                            {
                                "example_id": "2f52d6e1-b35e-4878-b995-8380aa1046e3",
                                "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                                "text": "„Wirkt eine rousseauistische Naturutopie im Text als antihistorischer Gegenentwurf für eine bessere Menschheit?“"
                            },
                            {
                                "example_id": "0f00e3cc-55ce-47fa-96f8-91dc493b8214",
                                "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                                "text": "„Nicht zu leisten ist die Einpassung des neuen Typus ‚Naturutopie‘ in die konkurrierenden Gattungsforrnen des Natürlichen.“"
                            },
                            {
                                "example_id": "ca83397b-e17b-45de-8d0f-153901d2daff",
                                "sense_id": "74eb2caf-725f-3f95-876f-e6aefade37ee",
                                "text": "„Nach Preisgabe der alten Naturutopie hatte die ärztliche Naturheilkunde nichts Vergleichbares mehr vorzuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
