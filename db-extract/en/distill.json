                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f99e56-50e5-424a-b8e1-86506bf006c6",
                                "sense_id": "f91ec28d-dd27-3e11-86b1-18fb5a87e6e3",
                                "text": "They distill essential oils from herbs.",
                                "translation": "Αποστάζουν αιθέρια έλαια από βότανα."
                            },
                            {
                                "example_id": "95ee1fa2-0045-4ec1-98fd-f116c25f634e",
                                "sense_id": "f91ec28d-dd27-3e11-86b1-18fb5a87e6e3",
                                "text": "Whisky is distilled in copper stills.",
                                "translation": "Το ουίσκι αποστάζεται σε χάλκινους άμβυκες."
                            },
                            {
                                "example_id": "06374a02-e028-4ba6-9bcf-61996e2d4bda",
                                "sense_id": "f91ec28d-dd27-3e11-86b1-18fb5a87e6e3",
                                "text": "distilled water - αποσταγμένο νερό"
                            }
                        ]
                    },
                    {
                        "sense_id": "ef28c649-9a2d-3747-9f6f-37c0c58d5575",
