                "senses": [
                    {
                        "sense_id": "5b4e45f2-a67a-3a56-936c-39f73ab3c002",
                        "entry_id": "86b7c1d4-bff9-353f-b065-ae7e01600a18",
                        "glosses": [
                            "Qui se fait au détriment de ; qui porte atteinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e7ec0cc-623f-4e27-b9d9-57cc8d88a4fa",
                                "sense_id": "5b4e45f2-a67a-3a56-936c-39f73ab3c002",
                                "text": "Les grands propriétaires ont, naturellement, été les premiers à se servir d'un outillage perfectionné : cela leur a permis de produire et, par cela aussi, de vendre meilleur marché. Il en est résulté une baisse des prix, détrimentaire aux intérêts des moyens et des petits producteurs."
                            },
                            {
                                "example_id": "318ac201-55b3-4834-a4c8-fe4cdbc402d3",
                                "sense_id": "5b4e45f2-a67a-3a56-936c-39f73ab3c002",
                                "text": "Rappelons que pour les produits sur lesquels l'incidence du fret est importante sur les prix de revient, une tarification exagérée pourrait inciter les acheteurs, pour l'éviter, à rechercher d'autres sources de production, ce qui serait détrimentaire aux intérêts de la Conférence."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bc43388-8fa2-36a1-aba2-1b7ccd97b810",
                        "entry_id": "86b7c1d4-bff9-353f-b065-ae7e01600a18",
                        "glosses": [
                            "Se dit de l’actant de la phrase au détriment duquel se fait le processus verbal."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b936b32f-2818-4434-9815-488a8660a0c5",
                        "source_entry_id": "86b7c1d4-bff9-353f-b065-ae7e01600a18",
                        "target_lang_word": "detrimental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detrimental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaafaa02-bd62-3be0-abd1-40abbf79e9ca",
                                        "entry_id": "85ce8d9e-2192-3867-80e6-bed0b3bc9561",
                                        "glosses": [
                                            "Causing damage or harm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ab46f4-a5ce-4ffa-a2f0-3e1012fc13af",
                                                "sense_id": "aaafaa02-bd62-3be0-abd1-40abbf79e9ca",
                                                "text": "Smoking tobacco can be detrimental to your health."
                                            },
                                            {
                                                "example_id": "3684d1b6-9895-469f-a822-de729cfa5e38",
                                                "sense_id": "aaafaa02-bd62-3be0-abd1-40abbf79e9ca",
                                                "text": "\"The fact is,\" continued he, \"Lady Anne fears that my visits here may prove detrimental to what she considers your best interests. I thought myself an old, safe friend; but, as that cannot be explained to every body, she fears that I may keep off other and more eligible lovers.\""
                                            },
                                            {
                                                "example_id": "6017fd74-ed11-4187-9ec9-19ca60a94c56",
                                                "sense_id": "aaafaa02-bd62-3be0-abd1-40abbf79e9ca",
                                                "text": "It agrees that redundant services should not be continued but is not unmindful of the fact that too much retrenchment of rail services now may ultimately prove detrimental to the economy of the country."
                                            },
                                            {
                                                "example_id": "cec003da-af4b-42d2-a939-aa92869212c0",
                                                "sense_id": "aaafaa02-bd62-3be0-abd1-40abbf79e9ca",
                                                "text": "Decisions made at the DfT inevitably reflect a London-centric experience, with a comparison being made with the closure of ticket offices throughout the London Underground network. This is not judged to have been detrimental, but there is a simple zonal fares system that is hardly comparable with the range of ticket types used on the national rail network."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "detrimental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b50acf36-64cd-38ba-9529-749e6946e57c",
                                        "entry_id": "2defbc47-37f1-32e0-8cca-01b7164f0f80",
                                        "glosses": [
                                            "Anything harmful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83be9c50-0058-4aa0-adb1-c996eacf6904",
                                                "sense_id": "b50acf36-64cd-38ba-9529-749e6946e57c",
                                                "text": "The definition of a parasite is a microbe that lives in you or on you to its benefit and to your detriment. In other words, the detrimentals suck the life out of you."
                                            },
                                            {
                                                "example_id": "8589ae8e-b19b-49df-8d30-cb2f311ec7fa",
                                                "sense_id": "b50acf36-64cd-38ba-9529-749e6946e57c",
                                                "text": "I'm afraid it may be the detrimentals, the poets, and æsthetes, and impressionist painters, who will rave about her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
