                "senses": [
                    {
                        "sense_id": "2d3c2cc8-be23-3445-bcee-bc2c26873f6d",
                        "entry_id": "e84a74dc-ec39-38bb-b356-c917b710746b",
                        "glosses": [
                            "der heutige Mensch sowie die bereits ausgestorbenen menschlichen Vorformen als Angehörige der Unterfamilie der Hominiden mit den Merkmalen der Bipedie (zweifüßigen Ganges), eines vergrößerten Schädels und eines vergrößerten Gehirns"
                        ],
                        "tags": [
                            "Biologische Anthropologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e1436628-3ea0-4c0c-8b60-b517dcf3302a",
                                "sense_id": "2d3c2cc8-be23-3445-bcee-bc2c26873f6d",
                                "text": "Das postkraniale Skelett zeigt, dass bei diesen Homininen bereits die wesentlichen Anpassungen an den aufrechten Gang vollzogen waren."
                            },
                            {
                                "example_id": "5f232848-dede-4e54-b068-168197ad6883",
                                "sense_id": "2d3c2cc8-be23-3445-bcee-bc2c26873f6d",
                                "text": "Innerhalb dieser Zeitspanne wurden die Homininen (Gattung Homo plus Vorfahren) von Gejagten zu Jägern."
                            },
                            {
                                "example_id": "35e43fa1-9b83-47e9-8f99-0671784e7a29",
                                "sense_id": "2d3c2cc8-be23-3445-bcee-bc2c26873f6d",
                                "text": "Egeland zuckt die Achseln: „Ob die Homininen die Jäger waren, oder ob sie die Raubtiere von frisch gerissener Beute verscheuchten und sich dann vom Leibe hielten, ist zunächst unerheblich. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
