                                        "sense_id": "92a30516-fbe4-3ddc-a16e-ad5f6c42ca74",
                                        "entry_id": "0f46b33e-539d-32d0-b76c-42775737b3e3",
                                        "glosses": [
                                            "A Staffordshire bull terrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe383c3-18f4-4cbf-af7e-f99f531a76c0",
                                                "sense_id": "92a30516-fbe4-3ddc-a16e-ad5f6c42ca74",
                                                "text": "Staffords are a loyal and lovable breed that are great with children. Digger had a great time on the walk playing with the other dogs and enjoying the lovely weather."
                                            },
                                            {
                                                "example_id": "12da4b0b-d38a-4c0c-9585-d3947f528e2d",
                                                "sense_id": "92a30516-fbe4-3ddc-a16e-ad5f6c42ca74",
                                                "text": "Like all terriers, Staffords are diggers, so it is important to reinforce fences by embedding them in concrete or burying chicken wire at the bottom to prevent escapes."
                                            },
                                            {
                                                "example_id": "375bfe3e-6798-4ecf-8f14-f815ecb0fc44",
                                                "sense_id": "92a30516-fbe4-3ddc-a16e-ad5f6c42ca74",
                                                "text": "Staffords are an amazing breed to own and to be invited to compete at crufts is an honour."
                                            }
                                        ]
                                    }
