                "senses": [
                    {
                        "sense_id": "b1cf69aa-8a6b-3e18-bcde-a992fe9bc468",
                        "entry_id": "bb6bcac2-df89-3cfe-99ec-a7c0d5eedb53",
                        "glosses": [
                            "einfacher, ungefederter, meist offener, vierrädriger russischer Pferdewagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d4e862a-5e6f-40ca-89df-8b2654bab95d",
                                "sense_id": "b1cf69aa-8a6b-3e18-bcde-a992fe9bc468",
                                "text": "Das Fuhrwerk ist ein offener, sehr massiver, backtrogähnlicher Karren, Telege genannt, fest auf der Achse liegend und bei jedem Stoss durch alle Sehnen dröhnend."
                            },
                            {
                                "example_id": "af616878-87f2-40d6-9421-64e6ee7135a9",
                                "sense_id": "b1cf69aa-8a6b-3e18-bcde-a992fe9bc468",
                                "text": "Die Courriere haben aber gegen die Dröhnung breite, starke Gurte und eine Ledermaschine zum Sitzen, die sie an die Telege schnallen, und die man in Petersburg für zehn Rubel in den Buden kaufen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45732b5b-0ee3-4d81-bbb5-89ef7b3c0445",
                        "source_entry_id": "bb6bcac2-df89-3cfe-99ec-a7c0d5eedb53",
                        "source_sense_id": "b1cf69aa-8a6b-3e18-bcde-a992fe9bc468",
