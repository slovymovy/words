                        "entry_id": "07ab09bf-54fd-32ae-8a4f-85c34c26bb7e",
                        "glosses": [
                            "A female given name from Latin in quiet use since the 18th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047a44a5-1171-4e39-a111-59537b1ebbe6",
                                "sense_id": "b8c71fce-aab8-330a-9125-1dbca0dc4080",
                                "text": "Ah! boy ; Cornelia never with more care / Read to her sons, than she hath read to thee / Sweet poetry and Tully's Orator."
                            }
                        ]
                    }
                ],
