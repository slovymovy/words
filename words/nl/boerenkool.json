                                "target_lang_sense_clarification": "the specific variety with crinkly leaves"
                            },
                            {
                                "target_lang_word": "borecole",
                                "target_lang_sense_clarification": "less common name for kale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17a117a7-0341-3de4-a23f-f9b1e4b70fe3",
                    "sense_definition": "Een traditioneel Nederlands gerecht gemaakt van gestampte aardappelen en boerenkool, vaak geserveerd met rookworst.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gerecht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als het buiten koud is, eten we graag warme <w>boerenkool</w> met worst.",
                            "target_lang_translations": {
                                "en": "When it is cold outside, we like to eat hot <w>kale mash</w> with sausage."
                            }
                        },
                        {
                            "text": "Zij maakt de lekkerste <w>boerenkool</w> volgens een oud familierecept.",
                            "target_lang_translations": {
