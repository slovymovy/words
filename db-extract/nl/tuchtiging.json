        "nl-extract.jsonl": [
            {
                "entry_id": "84e4142c-1621-338c-82eb-e2da360963c6",
                "word": "tuchtiging",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f2c7b568-cc17-4c5a-a739-f2be1b4426c1",
                        "entry_id": "84e4142c-1621-338c-82eb-e2da360963c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "tuchtigingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "420f2272-cd82-3e32-82ed-2bf38b08f581",
                        "entry_id": "84e4142c-1621-338c-82eb-e2da360963c6",
                        "glosses": [
                            "bestraffing"
                        ],
                        "tags": [
                            "lichamelijk"
                        ],
                        "examples": [
                            {
                                "example_id": "e62cfec9-03dc-435c-a206-4c03cbe4002b",
                                "sense_id": "420f2272-cd82-3e32-82ed-2bf38b08f581",
                                "text": "Quispel had zich nooit kunnen voorstellen dat mensen door lichamelijke tuchtiging sexueel opgewonden konden raken, maar met die lange, blonde streng van Zwanet wilde hij wel zacht geranseld worden, tenminste als hij er de geur van haar hoofdhuid bij mocht ruiken."
                            },
                            {
                                "example_id": "afd520c4-7bb6-43a2-baad-7c25f37f1c3a",
                                "sense_id": "420f2272-cd82-3e32-82ed-2bf38b08f581",
                                "text": "Het had veel weg van een publiekelijke tuchtiging. De Twente-fans spraken middels een openbare brief hun afkeuring uit over de technische staf. Maar de handdoek gooit Alfred Schreuder nog lang niet. Hij blijft met Twente jagen op Europees voetbal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b75d8bb3-db7e-4d99-aed8-77383a2891f3",
                        "source_entry_id": "84e4142c-1621-338c-82eb-e2da360963c6",
                        "source_sense_id": "420f2272-cd82-3e32-82ed-2bf38b08f581",
                        "source_sense_description": "(lichamelijk) bestraffing",
                        "target_lang_word": "chastisement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chastisement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                        "entry_id": "fd09b30f-74c4-3936-9029-e7e9fe370c7a",
                                        "glosses": [
                                            "The act of chastising; rebuke; punishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b26656f-31fa-4604-b28b-0f74c74541c2",
                                                "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                                "text": "Besides, the King hath wasted all his rods\nOn late offenders, that he now doth lack\nThe very instruments of chastisement;\nSo that his power, like to a fangless lion,\nMay offer, but not hold."
                                            },
                                            {
                                                "example_id": "3fda40b6-43bf-4446-84d3-7e11f4b7f526",
                                                "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                                "text": "But he was wounded for our transgressions, he was bruised for our iniquities: the chastisement of our peace was upon him; and with his stripes we are healed."
                                            },
                                            {
                                                "example_id": "0ced9c07-f9da-407c-9997-15aab41562d4",
                                                "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                                "text": "All this he called “doing his duty by their parents;” and he never inflicted a chastisement without following it by the assurance, so consolatory to the smarting urchin, that “he would remember it and thank him for it the longest day he had to live.”"
                                            },
                                            {
                                                "example_id": "98d7b283-8919-4018-8a43-4ca5a874e74a",
                                                "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                                "text": "Into the details of the infamy at which I thus connived (for even now I can scarce grant that I committed it) I have no design of entering; I mean but to point out the warnings and the successive steps with which my chastisement approached."
                                            },
                                            {
                                                "example_id": "4f93e3b7-c5a6-436d-8e0b-2759b21bae78",
                                                "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                                "text": "It seems to me that as he does not respond to this extremely conciliatory treatment it may be well to try whether a change of treatment might not produce a more satisfactory result. If praise and courtesy only result in narrow, bitter partisanship, perhaps a little well-merited chastisement may procure some geniality."
                                            },
                                            {
                                                "example_id": "c74a7215-f9ad-4aa1-97ee-5fa01375985d",
                                                "sense_id": "8db3dcf5-931c-39d8-b6de-47e92f9a9e57",
                                                "text": "Abolition of defence of reasonable chastisement"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb066e05-d8f4-437c-b628-2f2375b98133",
                        "source_entry_id": "84e4142c-1621-338c-82eb-e2da360963c6",
                        "source_sense_id": "420f2272-cd82-3e32-82ed-2bf38b08f581",
                        "source_sense_description": "(lichamelijk) bestraffing",
                        "target_lang_word": "castigation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "castigation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a2cbbe4-cbbf-30c6-ab0d-30b5cbfe8ceb",
                                        "entry_id": "bff0e5d2-ffdc-3974-98c7-d80c5a1bbc31",
                                        "glosses": [
                                            "Corrective punishment; chastisement; reproof"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13b43e9-7f19-4598-a26c-df4e5f53e1a1",
                                                "sense_id": "3a2cbbe4-cbbf-30c6-ab0d-30b5cbfe8ceb",
                                                "text": "He was seasoned wood, and took the world pretty wisely; not reckless of castigation, as some boys become, nor oversensitive as to dehonour, as his friend and comrade beside him was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0f3de8-d716-3b38-85ec-f819028a2709",
                                        "entry_id": "bff0e5d2-ffdc-3974-98c7-d80c5a1bbc31",
                                        "glosses": [
                                            "severe criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9746401a-cffc-3a75-a537-499f5875f42f",
                                        "entry_id": "bff0e5d2-ffdc-3974-98c7-d80c5a1bbc31",
                                        "glosses": [
                                            "Emendation; correction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6036663-73ae-4a54-a4f2-26cbeb8a0a1d",
                        "source_entry_id": "84e4142c-1621-338c-82eb-e2da360963c6",
                        "source_sense_id": "420f2272-cd82-3e32-82ed-2bf38b08f581",
                        "source_sense_description": "(lichamelijk) bestraffing",
                        "target_lang_word": "punishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4868c314-bddf-3fc9-a65f-dad22b405d2f",
                                        "entry_id": "3a8bbdce-82e2-3513-af4c-d6b870f86099",
                                        "glosses": [
                                            "The act (action) or process of punishing, imposing and/or applying a sanction, typically by an authority or a person in authority (for example: a parent or teacher), especially when disappointed or dissatisfied with the behavior or actions of a child, student, or someone else being looked after."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2129e698-6b37-412c-a94f-71fc383e01b6",
                                                "sense_id": "4868c314-bddf-3fc9-a65f-dad22b405d2f",
                                                "text": "The naughty children were given a punishment by their teachers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e369cd54-d74b-319b-8207-a9f1450a1cac",
                                        "entry_id": "3a8bbdce-82e2-3513-af4c-d6b870f86099",
                                        "glosses": [
                                            "A penalty to punish wrongdoing, especially for crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50af39a-bc0f-4b80-a434-5981d37ec2ff",
                                                "sense_id": "e369cd54-d74b-319b-8207-a9f1450a1cac",
                                                "text": "a light punishment"
                                            },
                                            {
                                                "example_id": "315d1bd4-d537-4c1e-8d37-132b6167ac50",
                                                "sense_id": "e369cd54-d74b-319b-8207-a9f1450a1cac",
                                                "text": "a harsh punishment"
                                            },
                                            {
                                                "example_id": "605df402-e5e1-430c-a9ef-6768859bcb05",
                                                "sense_id": "e369cd54-d74b-319b-8207-a9f1450a1cac",
                                                "text": "But officials here maintain that their methods do make a difference, and they follow it up with post-release programs. The aim of Bastoy is not to punish or seek revenge, Nilsen said. The only punishment is to take away the prisoner’s right to be a free member of society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5867289-a3f0-3be0-a2ba-d099f5e35458",
                                        "entry_id": "3a8bbdce-82e2-3513-af4c-d6b870f86099",
                                        "glosses": [
                                            "A suffering by pain or loss imposed as retribution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af29d161-4687-3004-a744-ffe460fe142a",
                                        "entry_id": "3a8bbdce-82e2-3513-af4c-d6b870f86099",
                                        "glosses": [
                                            "Any harsh treatment or experience; rough handling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70d23bda-7bba-47fc-b01d-a0d283e81b91",
                                                "sense_id": "af29d161-4687-3004-a744-ffe460fe142a",
                                                "text": "a vehicle that can take a lot of punishment"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
