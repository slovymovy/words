                ],
                "senses": [
                    {
                        "sense_id": "bb04a107-34a4-3003-8555-617a5f38d6db",
                        "entry_id": "31e5a910-ec07-308b-9b93-0a5c45f0887e",
                        "glosses": [
                            "Festin sacré que l’on offrait aux principaux dieux dont les statues étaient placées sur des banquettes autour d’une table (n.b. les Romains mangeaient couchés lors des festins)."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "8d8d5297-e632-4e99-bbf4-fdbdaa65f70e",
                                "sense_id": "bb04a107-34a4-3003-8555-617a5f38d6db",
                                "text": "On ordonnait les lectisternes dans les calamités publiques."
                            },
                            {
                                "example_id": "b87448eb-67dd-473c-beb9-0bc79cf0f540",
                                "sense_id": "bb04a107-34a4-3003-8555-617a5f38d6db",
                                "text": "En vain le Grand Pontife a fait un lectisterne."
                            },
                            {
                                "example_id": "3f058615-1ccf-48f7-852b-8f44c8c81631",
                                "sense_id": "bb04a107-34a4-3003-8555-617a5f38d6db",
                                "text": "La même année on célébra dans Rome un lectisterne, pour la cinquième fois depuis la fondation de la ville, et toujours afin d’apaiser les dieux."
                            },
                            {
                                "example_id": "c86d46b8-fd80-4c11-bc62-b8afc2ad8d73",
                                "sense_id": "bb04a107-34a4-3003-8555-617a5f38d6db",
                                "text": "les dieux du lectisterne gisaient sans honneur au pied de leur lit de pourpre."
                            }
                        ]
                    }
                ],
