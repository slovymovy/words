                "senses": [
                    {
                        "sense_id": "90d9b89c-57ff-3788-a8cd-dae3abcb4893",
                        "entry_id": "79174072-043a-37a8-8e11-1a60f7a4ec5f",
                        "glosses": [
                            "donkergrijs of zwart glas dat afkomstig is uit vulkanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ef8a6c-31e0-486c-b4b9-83d814c31a81",
                                "sense_id": "90d9b89c-57ff-3788-a8cd-dae3abcb4893",
                                "text": "Volgens het OM zijn op het terrein van Edelchemie grote hoeveelheden gevaarlijke stoffen opgeslagen, zoals obsidiaan, gips, fotografisch afval en latex. Het OM verdenkt Edelchemie ervan niet genoeg gedaan te hebben om weglekken te voorkomen. Daardoor zouden de stoffen in het grondwater terecht kunnen zijn gekomen. Edelchemie ligt dicht bij een waterwingebied."
                            },
                            {
                                "example_id": "5355acd6-683b-4cc2-bdfe-d555ec5673a8",
                                "sense_id": "90d9b89c-57ff-3788-a8cd-dae3abcb4893",
                                "text": "Uit een vulkaan kunnen verschillende soorten gesteenten en mineralen komen. „Zowel het lichte puimsteen, het vulkanische glas obsidiaan als donkergrijs basalt.” De aardrijkskundeleraar bekent dat hij eerst niet begreep hoe dat kon, totdat een hoogleraar het hem uitlegde."
                            }
                        ]
                    }
                ],
