    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44109215-e093-3ac7-9a1b-8ab6a87e0fe2",
                    "sense_definition": "To reduce the vividness or intensity of a color, often making it appear more gray or muted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photo editor used a filter to <w>desaturate</w> the background, highlighting the subject."
                        },
                        {
                            "text": "If you <w>desaturate</w> the image completely, it will become black and white."
                        }
                    ],
                    "synonyms": [
                        "mute"
                    ],
                    "antonyms": [
                        "saturate"
                    ],
                    "common_phrases": [
                        "desaturate an image",
                        "desaturate the colors"
                    ]
                },
                {
                    "sense_id": "cd7df6ce-0423-3da5-acdc-984a3350cd5e",
                    "sense_definition": "To lose color intensity or vividness, becoming paler or more gray.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Left in direct sunlight for months, the bright fabrics slowly began to <w>desaturate</w>."
                        },
                        {
                            "text": "As the antique rug aged over decades, the vivid red dyes started to <w>desaturate</w>."
                        }
                    ],
                    "synonyms": [
                        "fade"
                    ]
                },
                {
                    "sense_id": "b97d0e8e-04ff-33bc-a697-b492ab1b464e",
                    "sense_definition": "To make a market, group, or space less crowded, concentrated, or full.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce_concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "City officials introduced strict regulations to <w>desaturate</w> the crowded taxi market."
                        },
                        {
                            "text": "The company diversified its products to <w>desaturate</w> its reliance on a single sector."
                        }
                    ],
                    "antonyms": [
                        "saturate"
                    ],
                    "common_phrases": [
                        "desaturate the market"
                    ]
                },
                {
                    "sense_id": "3e5a8fab-3a69-3a5d-9182-bd771c0676e9",
                    "sense_definition": "To experience a decline in the oxygen saturation level of the blood.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_oxygen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>desaturate</w> rapidly when disconnected from supplemental oxygen."
                        },
                        {
                            "text": "During deep sleep, people with severe sleep apnea often <w>desaturate</w> dangerously."
                        }
                    ],
                    "common_phrases": [
                        "desaturate during sleep"
                    ]
                },
                {
                    "sense_id": "1dc3aad1-485c-3742-9926-5058316257f2",
                    "sense_definition": "Of blood oxygen levels: to drop or decrease.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_oxygen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nurses were warned that the patient's oxygen levels might <w>desaturate</w> overnight."
                        },
                        {
                            "text": "Whenever his oxygen saturations <w>desaturate</w> below ninety percent, the alarm sounds."
                        }
                    ],
                    "synonyms": [
                        "drop"
                    ]
                },
                {
                    "sense_id": "4284e5bd-e4cc-3e62-8ba8-a734848b6248",
                    "sense_definition": "To convert a chemically saturated compound into an unsaturated one by removing hydrogen atoms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Specific enzymes are required to <w>desaturate</w> fatty acids within plant cells."
                        },
                        {
                            "text": "Mammals cannot naturally <w>desaturate</w> certain essential fatty acids on their own."
                        }
                    ],
                    "common_phrases": [
                        "desaturate fatty acids"
                    ]
                }
            ]
        }
    ]
