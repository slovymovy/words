                        "examples": [
                            {
                                "example_id": "31cb2b48-0338-40cb-b87b-e45dee32a6c5",
                                "sense_id": "f53ad17a-e4b1-3503-b4db-cbd67dedade6",
                                "text": "De Onderzoeksraad schrijft verder dat er geen vergunning was afgegeven voor de vreugdevuren. De gemeente en de bouwers hadden jaren geleden afspraken gemaakt over onder meer de bouwmethode, de maximale omvang van de stapels en de risico's. Maar de bouwers hielden zich daar niet aan en de afspraken zijn nooit geactualiseerd en niet allemaal goed vastgelegd."
                            },
                            {
                                "example_id": "d4229bf1-6e2b-4aaa-b221-5b2af5067924",
                                "sense_id": "f53ad17a-e4b1-3503-b4db-cbd67dedade6",
                                "text": "Met die bouwmethode wil de zakenman ook het hoogste gebouw ter wereld realiseren. Nu is dat de 828 meter hoge Burj Khalifa in Dubai, die in ongeveer vijf jaar werd gebouwd. Zhang wil zijn 'Sky City' van 928 meter in zeven maanden klaar hebben."
                            }
                        ]
                    }
