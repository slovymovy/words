                "senses": [
                    {
                        "sense_id": "0f1f88c3-7aa0-38d7-87d4-9baa0eaa3b2e",
                        "entry_id": "748edc56-99cd-3894-9fb6-67adc10a08a0",
                        "glosses": [
                            "устар. относящийся к повиванию, оказанию помощи при родах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de84f78-b881-41d2-8708-05627bfaea5f",
                                "sense_id": "0f1f88c3-7aa0-38d7-87d4-9baa0eaa3b2e",
                                "text": "Андрей Михайлыч Клоус в том же 1791 году переехал в Москву и поступил в Воспитательный дом преподавателем повивального искусства."
                            },
                            {
                                "example_id": "3705e545-a467-4499-8d13-0f63a0c5651d",
                                "sense_id": "0f1f88c3-7aa0-38d7-87d4-9baa0eaa3b2e",
                                "text": "Madame Виргинская занималась у нас в городе повивальною профессией."
                            }
                        ]
                    }
