        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b5aa206b-173b-3dd7-b470-27c79abf3231",
                "word": "hells",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c0ceeb7-03ec-3b74-afce-b41797938d1a",
                        "entry_id": "b5aa206b-173b-3dd7-b470-27c79abf3231",
                        "glosses": [
                            "Synonym of hell."
                        ],
                        "tags": [
                            "colloquial",
                            "sometimes",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "3854cabf-f566-4a4e-b2e2-6fae94db8b43",
                                "sense_id": "1c0ceeb7-03ec-3b74-afce-b41797938d1a",
                                "text": "We rarely did the sort of things you lot seem to get landed in. Hells, you’ve all had more ‘adventures’ than me!"
                            },
                            {
                                "example_id": "737ed42a-68ae-4dd4-83ea-be4facdf5cba",
                                "sense_id": "1c0ceeb7-03ec-3b74-afce-b41797938d1a",
                                "text": "They know you. Your reputation among the nomads is . . . hells, you’re fucking feared. And with good reason."
                            },
                            {
                                "example_id": "70538ae8-1ce3-4a50-ab8d-e89d0dd9e482",
                                "sense_id": "1c0ceeb7-03ec-3b74-afce-b41797938d1a",
                                "text": "Even if it means going against every wish in my heart crying out that he’s back, he’s not really. If I was the one in his place, I’d want to feel safe first. Build trust second. Hells, that’s how I learned to love him in the first place."
                            }
                        ]
                    }
