                        ],
                        "examples": [
                            {
                                "example_id": "04a31d8d-eae1-4f6b-be77-65bb769ca5d2",
                                "sense_id": "e4d43dc3-78de-3c7d-8c5e-c40524bf0973",
                                "text": "Sperrrad, n. 1) koło zapadkowe, zatrzymowe, koło pieskowe, schodkowe, kółko zaporcze (u dźwiga); 2) kółko wchwytowe, zaporowe, tamujące, hamulcowe (zeg.).",
                                "translation": "Sperrrad, n. 1) ratchet wheel, stop wheel, dog wheel, stepped wheel, barrier wheel (on a crane); 2) capture wheel, dam wheel, blocking wheel, brake wheel (clockmaking).",
                                "english": "Sperrrad, n. 1) ratchet wheel, stop wheel, dog wheel, stepped wheel, barrier wheel (on a crane); 2) capture wheel, dam wheel, blocking wheel, brake wheel (clockmaking)."
                            },
                            {
                                "example_id": "8fe75ba4-4eb4-43d1-b9cc-610854dffe3b",
                                "sense_id": "e4d43dc3-78de-3c7d-8c5e-c40524bf0973",
                                "text": "Warstwy inwersyjne, a w mniejszym stopniu i warstwy izotermiczne są warstwami zaporowymi, które hamują ruchy pionowe w troposferze.",
                                "translation": "Inversion layers, and to a lesser extent isothermal layers are dam layers, that inhibit vertical movements in the troposphere.",
                                "english": "Inversion layers, and to a lesser extent isothermal layers are dam layers, that inhibit vertical movements in the troposphere."
                            }
                        ]
