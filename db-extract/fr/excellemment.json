                                                "example_id": "13e7ccf4-cc60-4598-856c-e2fb22b24fa7",
                                                "sense_id": "e00e7a87-7a75-3dab-aff6-1e39bc818cc9",
                                                "text": "Looking back, Yewdale Crag stands finely over the waterhead; Brantwood is opposite."
                                            }
                                        ]
                                    }
                                ]
                            }
