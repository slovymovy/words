                "senses": [
                    {
                        "sense_id": "14dcfbc0-9296-3d0f-831a-c1816e308b63",
                        "entry_id": "deea6f68-6a59-3984-b405-64d4a2694030",
                        "glosses": [
                            "verlossing waarbij het kind met een chirurgische operatie uit de baarmoeder wordt gehaald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "958f0a88-edd4-4a46-8d11-cc38727db9c7",
                                "sense_id": "14dcfbc0-9296-3d0f-831a-c1816e308b63",
                                "text": "Bij de gentle sectio kan de moeder de geboorte via het doorzichtige operatiedoek zelf volgen. De omstandigheden in de normaal kille operatiekamer worden aangepast aan het heuglijke feit dat er een kindje wordt geboren."
                            },
                            {
                                "example_id": "370fb791-9b5a-4140-ac76-83d3194d8483",
                                "sense_id": "14dcfbc0-9296-3d0f-831a-c1816e308b63",
                                "text": "Het Sint Lucas Andreas Ziekenhuis heeft de primeur in Nederland als het gaat om de 'vriendelijke keizersnede'. Deze 'gentle sectio' zou de binding tussen moeder en kind verbeteren, minder stress veroorzaken en minder pijnbestrijding vereisen bij het hechten."
                            }
                        ]
                    },
                    {
                        "sense_id": "e98f3310-7850-3c69-91f3-7f68dcc7db6e",
                        "entry_id": "deea6f68-6a59-3984-b405-64d4a2694030",
                        "glosses": [
                            "rang lager dan ondergeslacht (subgenus), of een taxon in die rang"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "35dfa19f-6337-3eff-8b5d-f15c0c59d8f6",
                        "entry_id": "deea6f68-6a59-3984-b405-64d4a2694030",
                        "glosses": [
                            "afgezonderd deel van een lijn of vlak"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "432189ec-7d16-4bf4-836f-eb2b0d556af9",
                                "sense_id": "35dfa19f-6337-3eff-8b5d-f15c0c59d8f6",
                                "text": "⧖ Doorsneede, Sectio, Word in de Geometrie de Grootte genoemd, welke uitkomt als eene andere Groote na believen doorgesneeden word."
                            }
                        ]
                    }
