                "senses": [
                    {
                        "sense_id": "a5647a93-ee50-3abe-91c1-cfe6a3e5c888",
                        "entry_id": "b9994869-4425-328a-9937-21e31f34586d",
                        "glosses": [
                            "A merger of rivers, or the place where rivers merge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ca74ce-ae2d-4d7f-b91e-ea07b52a60e7",
                                "sense_id": "a5647a93-ee50-3abe-91c1-cfe6a3e5c888",
                                "text": "It stands on the conflux of two rivers—the Chelmer, whence the town is called, and the Cann."
                            }
                        ]
                    },
                    {
                        "sense_id": "bec2126c-91fd-3604-a03c-2583b4a3a443",
                        "entry_id": "b9994869-4425-328a-9937-21e31f34586d",
                        "glosses": [
                            "A convergence or moving gathering of forces, people, or things."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78776d6e-d40f-4233-bb6c-e1d3709545db",
                                "sense_id": "bec2126c-91fd-3604-a03c-2583b4a3a443",
                                "text": "Thence to the gates caſt round thine eye, and ſee / What conflux iſſuing forth, or entring in: / Pretors, Proconſuls to thir Provinces / Haſting or on return, in robes of State; / Lictors and rods the enſigns of thir power; / Legions and Cohorts, turmes of horſe and wings: […]"
                            },
                            {
                                "example_id": "a1233161-07a6-4017-8b66-f0e426d43d72",
                                "sense_id": "bec2126c-91fd-3604-a03c-2583b4a3a443",
                                "text": "There was a conflux of emotions and thoughts in him that would not let him either give thorough way to his anger or persevere with simple rigidity of resolve."
                            },
                            {
                                "example_id": "2875aabe-63af-4028-9c94-5e1cdfdbc5a1",
                                "sense_id": "bec2126c-91fd-3604-a03c-2583b4a3a443",
                                "text": "So great was the conflux of torches, the flash and gleam of weapons, and the babel of sounds that it wrought on the mind the impression of a fire blazing up in the night."
                            }
                        ]
                    }
                ],
