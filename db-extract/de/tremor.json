                                "target_senses": [
                                    {
                                        "sense_id": "d4294134-4608-383b-ab40-09ec1ed406e0",
                                        "entry_id": "53372a1a-3ae3-35a7-b358-a4ae2e990281",
                                        "glosses": [
                                            "A shake, quiver, or vibration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af0b8a3-6eb1-4b8f-a6a1-b79ef7ec01fa",
                                                "sense_id": "d4294134-4608-383b-ab40-09ec1ed406e0",
                                                "text": "She felt a tremor in her stomach before going on stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0da6f531-f7d2-3863-8053-44f8c2eecf72",
                                        "entry_id": "53372a1a-3ae3-35a7-b358-a4ae2e990281",
                                        "glosses": [
                                            "A shake, quiver, or vibration.",
                                            "A rhythmic, uncontrollable shaking of all or part of the body due to partial muscle contractions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c03bf206-341c-42bf-aef4-73fffec72537",
                                                "sense_id": "0da6f531-f7d2-3863-8053-44f8c2eecf72",
                                                "text": "The optometrist has been losing patients ever since he developed tremors in his hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7239b2b1-db7b-3dee-89c7-33a0f13ccfb6",
                                        "entry_id": "53372a1a-3ae3-35a7-b358-a4ae2e990281",
                                        "glosses": [
                                            "An earthquake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9cbf4dc-edd8-4171-9f66-2f6a52704c22",
                                                "sense_id": "7239b2b1-db7b-3dee-89c7-33a0f13ccfb6",
                                                "text": "Did you feel the tremor this morning?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tremor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad18f60-a9dc-3c78-a12d-6dd8aa702d4c",
                                        "entry_id": "2c0bdab3-6365-3597-ade2-457e663e8204",
                                        "glosses": [
                                            "To shake or quiver excessively and rapidly or involuntarily; to tremble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db44469-41e4-42c1-9ca5-a75c5bb17c5d",
                                                "sense_id": "9ad18f60-a9dc-3c78-a12d-6dd8aa702d4c",
                                                "text": "The ground tremored under their big boots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85379fab-9dfc-4377-9e69-cdab0628a780",
                        "source_entry_id": "fac23af5-4e6f-3907-8ba4-52f422476ad1",
                        "source_sense_id": "2bcbbc1a-e882-3aab-aa6e-69f37d382e2d",
                        "source_sense_description": "Medizin: unfreiwilliges, rhythmisches, wiederholtes Zusammenziehen der Muskeln",
                        "target_lang_word": "tremblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tremblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                        "entry_id": "29c5f28d-d6b1-30bd-91f2-977209ffb5e4",
                                        "glosses": [
                                            "Agitation de ce qui tremble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c2340d-d5d4-42e9-a516-0757c5a841d0",
                                                "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                                "text": "Il y avait un tremblement involontaire dans la voix de cette noble femme et une expression de tendresse dans son accent qui peut-être eût trahi ce qu’elle ne voulait pas exprimer."
                                            },
                                            {
                                                "example_id": "33ae0506-ebd6-4228-bda6-769528cd334a",
                                                "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                                "text": "Le prieur. – S’il faut parler franchement, j’ai trouvé le sermon trop beau ; j’ai prêché quelquefois, et je n’ai jamais tiré grande gloire du tremblement des vitres ; mais une petite larme sur la joue d’un brave homme m’a toujours été d’un grand prix."
                                            },
                                            {
                                                "example_id": "fc51a009-fdf0-4cf2-a253-a090401184e6",
                                                "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                                "text": "Depuis l’aube, les troupes passaient la Moselle. C'était, sur le tremblement des ponts de bois, l’avalanche interminable des régiments."
                                            },
                                            {
                                                "example_id": "e42815e3-d99d-4fa0-8967-147c81177717",
                                                "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                                "text": "Je percevais au tremblement de leur voix, au miel de leurs paroles, cette terrible servitude qui les liait à ce qu'on nomme l'amour, d'un mot trop doux parce qu'on ne veut pas lui donner son véritable visage de bestialité et d'animalité."
                                            },
                                            {
                                                "example_id": "b3e1c23a-e1cf-4419-bd49-928dc9f92372",
                                                "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                                "text": "Cette prédiction les laissa pétrifiés. Le maître d’hôtel lui-même avait un tremblement en présentant le carré d’agneau."
                                            },
                                            {
                                                "example_id": "c39788cc-7e4c-409f-8620-9c31bc2a877d",
                                                "sense_id": "47adc70d-4e24-35ce-80af-efb49363a7d1",
                                                "text": "Il s'ensuit diverses sensations physiques (p. ex., rougissements, tremblements, transpiration) et une contre-performance des fonctions cognitives (p. ex., problèmes de concentration, trous de mémoire)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96c0bfa-1661-3d22-9bcb-7c709c18f76d",
                                        "entry_id": "29c5f28d-d6b1-30bd-91f2-977209ffb5e4",
                                        "glosses": [
                                            "Grande crainte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d032e73-222c-45cf-833e-d36f4522fe61",
                                                "sense_id": "b96c0bfa-1661-3d22-9bcb-7c709c18f76d",
                                                "text": "C’est une âme inquiète qui vit dans le tremblement."
                                            },
                                            {
                                                "example_id": "5861dcee-2f14-4332-89ed-05e762c4f1cc",
                                                "sense_id": "b96c0bfa-1661-3d22-9bcb-7c709c18f76d",
                                                "text": "C’était dans l’habitude une nature enflammée, violente, exagérée, aimant les cris, la casse et les tonnerres ; au fond, un très excellent homme, ayant seulement la main leste, le verbe haut et l’impérieux besoin de donner le tremblement à tout ce qui l’entourait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88ead2b-8796-3253-9268-10b201eed7e8",
                                        "entry_id": "29c5f28d-d6b1-30bd-91f2-977209ffb5e4",
                                        "glosses": [
                                            "Vibrations aéroélastiques, irrégulières et de basse fréquence, affectant la cellule d’un avion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ac90c93-f655-3292-a623-716df8783c5a",
                                        "entry_id": "29c5f28d-d6b1-30bd-91f2-977209ffb5e4",
                                        "glosses": [
                                            "Trille."
                                        ],
                                        "tags": [
                                            "Renaissance",
                                            "Baroque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "819913e7-1889-48a3-b20b-5c267fe6f7c7",
                                                "sense_id": "1ac90c93-f655-3292-a623-716df8783c5a",
                                                "text": "Je n’ay point démontré l’Ut Diézis tout enbas, dans ma Tablature, parce que ce demi-Ton, ne ſe faiſant que par artifice, n’a point de poſition de main particuliere. On le fait comme le Ré, (Note premiére) en bouchant tous les trous ; on tourne l’Embouchure en dedans ſuffiſamment pour gagner un demi-Ton ; & l’on fait le tremblement comme ſur le Ré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
