                    },
                    {
                        "translation_id": "b6342878-83e2-431d-8764-b735177fda0e",
                        "source_entry_id": "2f68a0c4-1a7b-3cfb-a7fb-9156ebf42834",
                        "source_sense_id": "ec6826fd-9ca6-311e-8e17-b8ddfd8cb034",
                        "target_lang_word": "empreinte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empreinte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Figure empreinte, impression, marque obtenue par pression."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8deea9-ff86-406c-9302-a647028a4f18",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "Marbre et Sabine avaient obtenu de leur lieutenant la permission de suivre quelques traces fraîches […]. Ces empreintes étaient évidemment dues au passage récent d'une demi-douzaine de daims de grande taille."
                                            },
                                            {
                                                "example_id": "d40ba11e-06da-4c71-9022-265a9811b826",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "A Beduaram il entre dans cette vaste et monotone plaine saharienne, sans végétation et où l’empreinte même de l’animal ne laisse qu’une trace insensible que le moindre vent efface."
                                            },
                                            {
                                                "example_id": "f5828c03-6522-4340-bb53-866e480e6a23",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "Nous campons sur sa rive droite, dans un terrain spongieux, où chaque pas laisse une empreinte profonde qui se remplit d’eau, […]."
                                            },
                                            {
                                                "example_id": "3feaff4e-f20c-448d-a520-d8cdecd55891",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "[…], ils me font toujours souvenir du ciel gris de chaleur, de la poussière qui portait l’empreinte de pieds nus et des touffes immobiles des hauts papayers lisses […]."
                                            },
                                            {
                                                "example_id": "c39d39ff-9d9d-4300-9b01-e8d767ad9e6d",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "À son arrivée, on lui avait demandé une empreinte de sa carte de crédit, et elle l’avait donnée, elle ne voyait pas comment refuser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e629efd-8ea6-3959-a92f-d94e2e6e1053",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Figure de plantes, d’insectes, de poissons, etc., qu’on trouve empreintes sur certaines pierres."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d96979-f0d3-4283-b2f9-e6f1041728f1",
                                                "sense_id": "0e629efd-8ea6-3959-a92f-d94e2e6e1053",
                                                "text": "Empreintes de fougère. Empreintes de poissons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a52080b-63df-348d-9404-245ddc95df9b",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Forme en creux à l'intérieur d'un moule qui permet d'obtenir une pièce."
                                        ],
                                        "tags": [
                                            "Fonderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be80e00-f8a1-4d10-bef5-79a66a21caf3",
                                                "sense_id": "7a52080b-63df-348d-9404-245ddc95df9b",
                                                "text": "Un moule peut contenir plusieurs empreintes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38721055-9807-36bf-bd71-7c63f7c36d28",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Trace laissée par un contact de la peau sur un objet."
                                        ],
                                        "tags": [
                                            "Anthropométrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a7c4df8-e879-4ee0-ad29-588bc1e0b22a",
                                                "sense_id": "38721055-9807-36bf-bd71-7c63f7c36d28",
                                                "text": "« Oui, j'ai bien un pouce ici », confirme la dactylo-technicienne. Elle repose poudre et pinceau pour saisir un carré de transfert transparent qu'elle vient appliquer avec soin sur l’empreinte à relever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3aca11f-799f-35ac-921e-2441aa12b7cd",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Marque distinctive et durable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4281ba26-6331-4925-9362-640e4bd3561a",
                                                "sense_id": "c3aca11f-799f-35ac-921e-2441aa12b7cd",
                                                "text": "Le style du chantre d’Ulysse n’est pas un style d’école et de pratique ; et l’ongle du lion, la divine empreinte du génie y est partout manifeste, et aussi évidente, sinon aussi brûlante, que dans le style du chantre d’Achille."
                                            },
                                            {
                                                "example_id": "96b4c6cb-503e-4c0c-bf4d-b16f771db44f",
                                                "sense_id": "c3aca11f-799f-35ac-921e-2441aa12b7cd",
                                                "text": "Qu’il s’agisse d’une entrée ou d’une sortie de prison, d’une libération ou d’un transfèrement, ou simplement de la notification d’une décision administrative ou judiciaire (comme un arrêté d’expulsion, par exemple), le but est toujours le même : conserver une empreinte suffisante de la personnalité pour pouvoir identifier la description présente avec celle que l’on pourrait être amené à relever ultérieurement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18a1067-d880-38f4-8a42-cc808cbf6df5",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Fixation du nouveau-né sur le premier objet qui se présente à lui."
                                        ],
                                        "tags": [
                                            "Éthologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ba2f327-53f3-3885-b3e4-558eae89fad5",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Résultat d'une fonction de hachage qui permet d’identifier la donnée initiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba3be0e-0f1e-4a43-9b0a-a7d87af55946",
                                                "sense_id": "3ba2f327-53f3-3885-b3e4-558eae89fad5",
                                                "text": "La technique visant à assurer l’intégrité d’un message consiste à réduire celui-ci à un « condensat » (empreinte) qui est une information de longueur fixe obtenue à l’aide d’un algorithme réducteur, le « hachage »."
                                            },
                                            {
                                                "example_id": "7e5474b6-ad00-4f3a-b05b-ab07789c4587",
                                                "sense_id": "3ba2f327-53f3-3885-b3e4-558eae89fad5",
                                                "text": "Le mineur fait passer dans la fonction de hachage (SHA-256 dans le cas du Bitoin, Script pour d’autres cryptomonnaies), obtenant en retour un hash, ou somme de contrôle, ou empreinte, qui est en l’occurrence un arbre de Merkle."
                                            }
                                        ]
                                    }
                                ]
                            },
