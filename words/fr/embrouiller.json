            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2dd0c1e3-cb03-321c-9b38-f0c2c68d224e",
                    "sense_definition": "Troubler quelqu'un en rendant ses pensées confuses ou en lui faisant perdre le fil.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confusion_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces explications contradictoires ne font qu'<w>embrouiller</w> les étudiants.",
                            "target_lang_translations": {
                                "en": "All these contradictory explanations do nothing but <w>confuse</w> the students.",
                                "ru": "Все эти противоречивые объяснения только <w>путают</w> студентов.",
                                "de": "Alle diese widersprüchlichen Erklärungen <w>verwirren</w> die Studenten nur.",
                                "es": "Todas estas explicaciones contradictorias no hacen más que <w>confundir</w> a los estudiantes.",
                                "zh": "这些相互矛盾的解释只会把学生们<w>弄糊涂</w>。"
                            }
                        },
                        {
                            "text": "Arrête de parler en même temps, tu vas m'<w>embrouiller</w> l'esprit.",
                            "target_lang_translations": {
                                "en": "Stop talking at the same time, you're going to <w>muddle</w> my mind.",
                                "ru": "Перестань говорить одновременно, ты меня совсем <w>запутаешь</w>.",
                                "de": "Hör auf, gleichzeitig zu reden, du <w>verwirrst</w> mir ja noch den Kopf.",
                                "es": "¡Deja de hablar a la vez, que me vas a <w>confundir</w> las ideas!",
                                "zh": "别同时说话了，你这是要把我的脑子<w>弄糊涂</w>啊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emberlificoter"
                    ],
                    "antonyms": [
                        "débrouiller"
                    ],
                    "common_phrases": [
                        "embrouiller l'esprit",
                        "embrouiller les idées"
                    ],
                    "target_lang_definitions": {
                        "en": "To confuse someone by making their thoughts unclear or causing them to lose the thread of what they are saying.",
                        "ru": "Делать чьи-либо мысли неясными или заставлять терять нить разговора.",
                        "de": "Jemandem die Gedanken verwirren oder ihn den Gesprächsfaden verlieren lassen.",
                        "es": "Alterar a alguien haciendo que sus pensamientos se vuelvan confusos o que pierda el hilo de lo que dice.",
                        "zh": "使某人思路混乱、头脑不清，或让人跟不上话题。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confuse",
                                "target_lang_sense_clarification": "with contradictory explanations or information"
                            },
                            {
                                "target_lang_word": "bewilder",
                                "target_lang_sense_clarification": "unable to think straight"
                            },
                            {
                                "target_lang_word": "muddle",
                                "target_lang_sense_clarification": "mixing up someone's thoughts"
                            }
                        ],
