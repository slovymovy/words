    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae7619cd-b75e-394f-8621-3a8b154d3f9f",
                    "sense_definition": "De omlijsting van een raam of deur waarin het glas of de deur zelf is bevestigd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bouwconstructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder is de hele middag bezig geweest om het houten <w>kozijn</w> van het keukenraam te schuren.",
                            "target_lang_translations": {
                                "en": "The painter spent the whole afternoon sanding the wooden <w>window frame</w> of the kitchen window."
                            }
                        },
                        {
                            "text": "Bij het plaatsen van de nieuwe ruit bleek het <w>kozijn</w> helaas verrot te zijn door achterstallig onderhoud.",
                            "target_lang_translations": {
                                "en": "When installing the new pane, the <w>frame</w> unfortunately turned out to be rotten due to overdue maintenance."
                            }
                        }
                    ],
                    "synonyms": [
                        "raamwerk"
                    ],
                    "common_phrases": [
                        "houten kozijn",
                        "kunststof kozijn",
                        "kozijn schilderen"
                    ],
                    "target_lang_definitions": {
                        "en": "The framework of a window or door in which the glass or the door itself is fixed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "window frame",
                                "target_lang_sense_clarification": "the framework around a window"
                            },
                            {
                                "target_lang_word": "door frame",
                                "target_lang_sense_clarification": "the framework around a door"
                            },
                            {
                                "target_lang_word": "casing",
                                "target_lang_sense_clarification": "the decorative molding or frame around a door or window"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0667b86-538a-3f7e-b46b-a344ef9817bf",
                    "sense_definition": "De zoon van iemands oom of tante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ging gisteren bij mijn <w>kozijn</w> op bezoek om zijn nieuwe woning in Antwerpen te bekijken.",
                            "target_lang_translations": {
                                "en": "I went to visit my <w>cousin</w> yesterday to see his new home in Antwerp."
                            }
                        },
                        {
                            "text": "Tijdens het familiefeest sprak ik uitgebreid met mijn <w>kozijn</w> over onze gezamenlijke grootouders.",
                            "target_lang_translations": {
                                "en": "During the family party, I spoke at length with my <w>cousin</w> about our common grandparents."
                            }
                        }
                    ],
                    "synonyms": [
                        "neef"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België/Vlaanderen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The son of one's uncle or aunt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cousin",
                                "target_lang_sense_clarification": "the child of an uncle or aunt"
                            },
                            {
                                "target_lang_word": "male cousin",
                                "target_lang_sense_clarification": "specifically a male relative from an uncle or aunt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
