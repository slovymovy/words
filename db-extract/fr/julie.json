        "fr-extract.jsonl": [
            {
                "entry_id": "3964cc57-0324-38e2-8daa-8bc5dcf9fad0",
                "word": "Julie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9116dc1d-2ea2-4ed3-9fd0-08199082fa08",
                        "entry_id": "3964cc57-0324-38e2-8daa-8bc5dcf9fad0",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Jules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
                        "entry_id": "3964cc57-0324-38e2-8daa-8bc5dcf9fad0",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690112d0-b816-4a2c-a0df-4ddaa059fbb9",
                                "sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
                                "text": "Ne m’en veuillez pas, dit-il à voix rapide. Mais… j’aimais Julie."
                            },
                            {
                                "example_id": "68089f5f-386a-42f6-88d7-b375b435edd4",
                                "sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
                                "text": "Donc, aujourd’hui, après le départ de ce pendard (il désignait Manfred), je songeais tout doucement à une foule de choses, et déjà j’échafaudais dans ma tête quelque chapitre bien et dûment philosophé à ajouter au livre de Pantagruel, lorsque… mais que diable sentent donc les casseroles de dame Julie ?"
                            },
                            {
                                "example_id": "8aa9ef14-216c-47c3-b86d-f67d33f31ddf",
                                "sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
                                "text": "La rencontre avec Julie Ledru, découverte sur Instagram, a été déterminante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac797033-efa5-429f-9e84-72e2c5a4d981",
                        "source_entry_id": "3964cc57-0324-38e2-8daa-8bc5dcf9fad0",
                        "source_sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
                        "target_lang_word": "Julia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Julia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d64d93f-609f-4dbe-b68a-4c44cd57cdfb",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "Salute Philologus & Iulia, Nereus, and his sister, and Olympas, and all the Saints which are with them."
                                            },
                                            {
                                                "example_id": "09289f31-c7bd-4809-8144-a7d3143a4159",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "\"Julia!\" when alone he would exclaim; \"what a sweet sounding and romantic name: Julia! what music and magic in its sound! 'tis a name worthy only the fairest and purest of creation!"
                                            },
                                            {
                                                "example_id": "ae793d68-b9a3-4e4f-ac9e-30557646b2d0",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "“Why, I mean,” I replied, recoiling, “I mean—in short—that—in other words—I didn't know your name was Julia.”"
                                            },
                                            {
                                                "example_id": "bdf262cd-cf64-4841-a535-ab428bdd43e0",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "\"Why did you name her Julia?\" Amy asked, letting the orange ice cream melt down the backs of her hands.\n\"Because it sounds dignified.\""
                                            },
                                            {
                                                "example_id": "45f33836-a7c8-4dcf-9c02-75705c8eb7e2",
                                                "sense_id": "d43b459c-ec9e-3101-84f2-332b1a2a1920",
                                                "text": "In an order issued Tuesday evening in the ongoing lawsuit Orr v. Trump, Massachusetts District Judge Julia Kobick expanded the preliminary injunction she issued in April, which required the State Department to issue passports that match the plaintiffs’ gender identities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1833133-945b-3668-b048-aa9d23924d81",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "89 Julia, a main belt asteroid; named for Saint Julia of Corsica."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eed35034-2bae-389a-812a-dc700f2478af",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A village in central Poland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c19bb966-ff03-36a1-a850-ceb1fd70dd78",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A French surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06ba3227-e815-393c-92d0-0bd0d92c7705",
                                        "entry_id": "aec30d97-2bf2-3733-802e-8d4d4911c5f8",
                                        "glosses": [
                                            "A programming language suited for numerical analysis and scientific computing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848b7430-24be-4793-b89a-3a569ae9de34",
                                                "sense_id": "06ba3227-e815-393c-92d0-0bd0d92c7705",
                                                "text": "And then came Julia, a general purpose programming language designed according to the requirements of scientific and technical computing, providing performance comparable to C/C++, and with an environment productive enough for prototyping like the high-level dynamic language of Python."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aae35cd-2b07-445e-9c1b-6a4d34b95281",
                        "source_entry_id": "3964cc57-0324-38e2-8daa-8bc5dcf9fad0",
                        "source_sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
                        "target_lang_word": "Julie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Julie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf374731-8f99-39e2-90fa-b4b910469523",
                                        "entry_id": "ea5308a6-fd30-3411-8e8a-34b65a0cc0f2",
                                        "glosses": [
                                            "A female given name from French Julie, popular in the latter half of the 20th century, equivalent to English Julia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a8d6a0-164e-40e4-8663-d8d3532036dd",
                                                "sense_id": "bf374731-8f99-39e2-90fa-b4b910469523",
                                                "text": "The first-born Child had every dawning Grace / And promis'd Beauty in her form and face. / \"We'll call her Julie if you please, my dear,\" / The Mother cry'd, \"I doat on Julie Vere.\" / \"What! no Remembrance of her Aunt! for Shame! / You doat indeed! be Barbara her name!\""
                                            },
                                            {
                                                "example_id": "f816af40-cba7-4198-a0a0-a5af74390a00",
                                                "sense_id": "bf374731-8f99-39e2-90fa-b4b910469523",
                                                "text": "\"I loathe the name of Julia. Julie, in the French way, is quite pretty, but Julia! - \"\n\"Call her Cousin Julie then; I've no doubt she'll prefer it. She's nothing if not progressive, I believe.\""
                                            },
                                            {
                                                "example_id": "cf5ec9f2-22db-4606-b59c-0eeff84ce584",
                                                "sense_id": "bf374731-8f99-39e2-90fa-b4b910469523",
                                                "text": "They were called Jim & Julie, professionally. It seemed such a waste to deal in fantasy, in illusion and pretend, and not christen one's endeavor more suggestively. Kate wondered if their real names were Letitia and Sylvester, or Cleopatra and Mandrake; perhaps they'd gone undercover with white-bread names in quest of posh children's parties and Yankee suitability."
                                            },
                                            {
                                                "example_id": "c7770ff6-4da2-424e-9bcc-28de96953da1",
                                                "sense_id": "bf374731-8f99-39e2-90fa-b4b910469523",
                                                "text": "But Republicans and Porter's Democratic primary opponents have seized on an interview from last month that widely surfaced the week of Oct. 6 in which she reprimands CBS News California journalist Julie Watts multiple times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9235a5-a649-34ba-86ea-f49cd1cac22b",
                                        "entry_id": "ea5308a6-fd30-3411-8e8a-34b65a0cc0f2",
                                        "glosses": [
                                            "A diminutive of the female given name Julia."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d02761a-62c9-485c-94bf-239df4c6e0f9",
                        "source_entry_id": "3964cc57-0324-38e2-8daa-8bc5dcf9fad0",
                        "source_sense_id": "46afa442-457d-3cff-a0fd-a9d362af6f27",
