                "forms": [],
                "senses": [
                    {
                        "sense_id": "1fc52fea-5ed0-3ec4-bb18-5ecb9240a125",
                        "entry_id": "2fc62588-fd81-30ea-8f4f-2b77c49731f6",
                        "glosses": [
                            "van lippen dat ze tot een tuitje zijn samengeknepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9365e346-59cd-4c61-b883-9195eaaa91a5",
                                "sense_id": "1fc52fea-5ed0-3ec4-bb18-5ecb9240a125",
                                "text": "De combinatie met wat Everon el F. nog meer deed, maakte zijn gedrag wél strafbaar. Hij plofte naast een van de vrouwen neer op een bankje. Ze schoof meteen een meter op. En ook de andere vrouwen maakten er geen geheim van dat ze niet gediend waren van Everon el F.’s toenaderingspogingen, zijn getuite lippen, kus- en andere gebaren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfc2640a-c76a-475e-a9c0-77e54ac87fa7",
                        "source_entry_id": "2fc62588-fd81-30ea-8f4f-2b77c49731f6",
                        "source_sense_id": "1fc52fea-5ed0-3ec4-bb18-5ecb9240a125",
                        "target_lang_word": "spout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abb62945-b06f-35dd-926c-1415b61737f6",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "A tube or lip through which liquid or steam is poured or discharged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01fc22bb-1d62-41e5-bbb8-3e9125aaa9eb",
                                                "sense_id": "abb62945-b06f-35dd-926c-1415b61737f6",
                                                "text": "I dropped my china teapot, and its spout broke."
                                            },
                                            {
                                                "example_id": "d637de79-87ea-4dd7-b923-762213d48919",
                                                "sense_id": "abb62945-b06f-35dd-926c-1415b61737f6",
                                                "text": "I put a spout in the maple tree to collect its sap"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c720fd-5228-3436-a88d-6beed3d1b521",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "A waterspout (“channel through which water is discharged, especially from the gutters of a roof”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f02cbfe7-473a-3d83-acd8-25fe1f31a256",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "A stream or discharge of liquid, typically with some degree of force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf6c0ce-0d84-4c16-b03c-8fecfd221932",
                                                "sense_id": "f02cbfe7-473a-3d83-acd8-25fe1f31a256",
                                                "text": "A spout of blood flew from his mouth, spattering Smichov's linen trousers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cda6368-c181-33fc-b385-0d865482d273",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "A stream of water that falls from higher to lower; a (typically thin) waterfall."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3495ad33-eb56-4063-af75-a238f95b8754",
                                                "sense_id": "5cda6368-c181-33fc-b385-0d865482d273",
                                                "text": "[…] the river rushes over the Auchinlilie Lin or Spout, a tremendous chataract^([sic]); after which it proceeds in a more quiet course, and is navigable to the village of Carron Shore."
                                            },
                                            {
                                                "example_id": "cd26d61d-23d2-445c-b898-e37dc6047d74",
                                                "sense_id": "5cda6368-c181-33fc-b385-0d865482d273",
                                                "text": "The Spout of Garnock is a wild and romantic waterfall upon that stream in the moors of Kilbirnie parish. The rock here is also porphyry. The porphyry upon the east side of the fall is much rent, and has fallen forward[…]"
                                            },
                                            {
                                                "example_id": "f64188b7-d037-4216-b29b-95e3483b0fc6",
                                                "sense_id": "5cda6368-c181-33fc-b385-0d865482d273",
                                                "text": "[…] a streamlet made a little spout over some stones to serve me for a water-tap."
                                            },
                                            {
                                                "example_id": "f650d1b8-9f26-4188-8ba9-23478da960af",
                                                "sense_id": "5cda6368-c181-33fc-b385-0d865482d273",
                                                "text": "[…] you can follow a footpath from the fine Victorian Mallyan Spout Hotel to the national park's most famous waterfalls – the 80ft-high Mallyan Spout. When you get to the beck, turn left, and the waterfall is a couple of hundred yards along the bank; it can be wet underfoot[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12052730-5fde-39bf-8eb9-27b02ec3a731",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "A similar stream or fall of earth, rock, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4d0c74-f3b5-42cd-a982-180dd310d553",
                                                "sense_id": "12052730-5fde-39bf-8eb9-27b02ec3a731",
                                                "text": "The great spout of broken mineral, which had damned the canyon up."
                                            },
                                            {
                                                "example_id": "0155f0ee-8d22-48c0-ac23-e17f280546d1",
                                                "sense_id": "12052730-5fde-39bf-8eb9-27b02ec3a731",
                                                "text": "From the side of the hill … a spout of gravel was dislodged.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae9fe78-4c72-3bd6-b25e-b8695b89cfce",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "A waterspout (“whirlwind or tornado that forms over water”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20417cc7-0730-4831-8c15-25246844a747",
                                                "sense_id": "5ae9fe78-4c72-3bd6-b25e-b8695b89cfce",
                                                "text": "He ought to haue expert coniecture of Stormes, Tempestes, and Spoutes: and such lyke Meteorologicall effectes, daungerous on Sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a4780b4-b5ad-3fbb-b13e-9278e5d45e6c",
                                        "entry_id": "954adc3e-55e7-3a71-842b-16b5983e2461",
                                        "glosses": [
                                            "The mixture of air and water thrown up from the blowhole of a whale."
