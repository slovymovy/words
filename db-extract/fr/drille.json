                "senses": [
                    {
                        "sense_id": "19759539-7b45-39c2-83a1-ade2720475ea",
                        "entry_id": "a0b1214d-ccc2-3a9d-b5d7-b09f7a82079b",
                        "glosses": [
                            "Lambeau de chiffon de chanvre ou de lin utilisé pour la fabrication du papier."
                        ],
                        "tags": [
                            "Papeterie"
                        ],
                        "examples": [
                            {
                                "example_id": "b31144a4-bf73-43f2-bf5c-6b785a799c06",
                                "sense_id": "19759539-7b45-39c2-83a1-ade2720475ea",
                                "text": "Le Recueil authentique des anciennes ordonnances de Lorraine, par François de Neufchâteau (Nancy, C. S. Lamort. 1784. In-4°), mentionne, à la page 77, une ordonnance ducale du 27 octobre 1599, qui a dû être imprimée par Blaise Andréa. Elle porte défense aux papetiers de s’expatrier, et, à toutes personnes, d’exporter les drapeaux, frapouilles, drilles, etc."
                            },
                            {
                                "example_id": "f3f48f38-2341-4c96-ae6f-7fbc2c75fedf",
                                "sense_id": "19759539-7b45-39c2-83a1-ade2720475ea",
                                "text": "Le gerlon désignait la cuve dans laquelle on procédait au pourrissage des chiffons - les drilles - que l’on remuait avec un râteau, le fauchet. Le floran était le pilon utilisé pour raffiner de la pâte."
                            }
                        ]
                    }
                ],
