            {
                "entry_id": "7aa49344-628a-3528-8bfb-9e1def74eaa3",
                "word": "sherpa",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ed35845e-4c0c-42be-871d-3cba6946dc50",
                        "entry_id": "7aa49344-628a-3528-8bfb-9e1def74eaa3",
                        "tags": [
                            "plural",
