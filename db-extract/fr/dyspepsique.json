                "translations": [
                    {
                        "translation_id": "fd067404-0544-4636-8eb9-48e32c686a02",
                        "source_entry_id": "2236d9d2-9aea-31e1-80bf-eb2c37fcf0fd",
                        "source_sense_id": "2eda7f41-dc6c-3a26-901e-8c8926d3ccf4",
                        "target_lang_word": "dyspeptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dyspeptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f8d93fc-cefc-331a-a92e-ebc087bf9308",
                                        "entry_id": "c0d1f2a1-068d-3a49-9a96-e96879ef365d",
                                        "glosses": [
                                            "Of, relating to, or having dyspepsia or indigestion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89ee0bc-c5f2-4ebe-bc70-5349e02e5e7e",
                                                "sense_id": "2f8d93fc-cefc-331a-a92e-ebc087bf9308",
                                                "text": "...but Lady Anne could not be deceived—in five years' time he would become dyspeptic, be surrounded by physicians, consigned to all the Badens in Germany, and think much more of a renovating draught than a beautiful young wife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e27c8a5c-3f9b-33e5-94e8-d155eb23210b",
                                        "entry_id": "c0d1f2a1-068d-3a49-9a96-e96879ef365d",
                                        "glosses": [
                                            "Irritable or morose."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edeb49d4-5941-4fb5-b11e-e23c1f947084",
                                                "sense_id": "e27c8a5c-3f9b-33e5-94e8-d155eb23210b",
                                                "text": "He was a sallow, dyspeptic man, with a premature shock of grey hair, attached to the stage as an occupation but not a vocation. His only passion was gambling on the race-course, which was attended with perpetual bad luck, though that appeared to act as a stimulus rather than to dampen his fervour."
                                            },
                                            {
                                                "example_id": "96302318-3ceb-4b31-b842-4dcc9d9ef13b",
                                                "sense_id": "e27c8a5c-3f9b-33e5-94e8-d155eb23210b",
                                                "text": "Sir Maurice made a rough, dyspeptic sound, as if chewing a mint."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dyspeptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd44a36e-4380-3c56-990e-72517e2262cc",
                                        "entry_id": "d5235de3-4e6d-3b82-820d-8f10c5472517",
                                        "glosses": [
                                            "A dyspeptic person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9972ff51-d801-4374-afdf-4524655bc6a0",
                                                "sense_id": "bd44a36e-4380-3c56-990e-72517e2262cc",
                                                "text": "Medical management of peptic ulcers is employed along with psychotherapy to greater advantage than the multitude of operations employed twenty years ago for the unfortunate dyspeptic."
                                            },
                                            {
                                                "example_id": "61858949-3fb5-4550-a409-1398be50d7e0",
                                                "sense_id": "bd44a36e-4380-3c56-990e-72517e2262cc",
                                                "text": "There is, for example, the hamburg-steak, of which the alliaceousness can seduce all but saints and the worst of dyspeptics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
