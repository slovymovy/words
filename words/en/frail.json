{
    "word_family": [
        "frailty",
        "frailly",
        "frailness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8c4cd6a-d245-39ec-b8b0-1a0d43fa28af",
                    "sense_definition": "In an infirm state leading one to be easily subject to disease or other health problems, especially regarding the elderly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frail</w> old man needed assistance just to walk across the living room.",
                            "target_lang_translations": {
                                "ru": "<w>Немощному</w> старику требовалась помощь, просто чтобы перейти гостиную.",
                                "pl": "<w>Niedołężny</w> staruszek potrzebował pomocy, żeby po prostu przejść przez salon."
                            }
                        },
                        {
                            "text": "She became increasingly <w>frail</w> in her later years, requiring full-time care.",
                            "target_lang_translations": {
                                "ru": "В преклонном возрасте она становилась все более <w>слабой</w>, требуя постоянного ухода.",
                                "pl": "Na starość stawała się coraz bardziej <w>wątła</w>, co wymagało całodobowej opieki."
                            }
                        }
                    ],
                    "antonyms": [
                        "robust",
                        "strong",
                        "healthy"
                    ],
                    "common_phrases": [
                        "frail elderly",
                        "frail health"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в немощном состоянии, из-за которого человек легко подвержен болезням или другим проблемам со здоровьем, особенно в отношении пожилых людей.",
                        "pl": "W stanie niedołęstwa, sprawiającym, że dana osoba jest podatna na choroby lub inne problemy zdrowotne, zwłaszcza w odniesieniu do osób starszych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дряхлый",
                                "target_lang_sense_clarification": "о пожилом человеке"
                            },
                            {
                                "target_lang_word": "немощный",
                                "target_lang_sense_clarification": "слабый здоровьем"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "физически ослабленный"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wątły",
                                "target_lang_sense_clarification": "słabego zdrowia, drobnej budowy"
                            },
                            {
                                "target_lang_word": "niedołężny",
                                "target_lang_sense_clarification": "o osobie starszej, pozbawionej sił"
                            },
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "osłabiony fizycznie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86fecc0e-1f87-3169-8d9f-85ca54d89f37",
                    "sense_definition": "Easily broken physically; not firm or durable; liable to fail and perish.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird built its nest out of the <w>frailest</w> twigs it could find.",
                            "target_lang_translations": {
                                "ru": "Птица свила гнездо из самых <w>хрупких</w> веточек, какие только смогла найти.",
                                "pl": "Ptak uwił gniazdo z <w>najbardziej kruchych</w> gałązek, jakie zdołał znaleźć."
                            }
                        },
                        {
                            "text": "Be careful with that <w>frail</w> wooden structure, as it might collapse under pressure.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны с этой <w>непрочной</w> деревянной конструкцией, так как она может рухнуть под тяжестью.",
                                "pl": "Ostrożnie z tą <w>kruchą</w> drewnianą konstrukcją, ponieważ może runąć pod naciskiem."
                            }
                        }
                    ],
                    "synonyms": [
                        "farasola",
                        "flail"
                    ],
                    "antonyms": [
                        "sturdy",
                        "durable",
                        "strong"
                    ],
                    "common_phrases": [
                        "frail structure",
                        "frail bridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко ломающийся физически; непрочный или недолговечный; склонный к разрушению.",
                        "pl": "Łatwy do uszkodzenia lub złamania; nietrwały, podatny na zniszczenie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "легко ломающийся"
                            },
                            {
                                "target_lang_word": "непрочный",
                                "target_lang_sense_clarification": "ненадежный, легко разрушающийся"
                            },
                            {
                                "target_lang_word": "ломкий",
                                "target_lang_sense_clarification": "легко ломающийся при сгибании"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "łatwo ulegający zniszczeniu lub pęknięciu"
                            },
                            {
                                "target_lang_word": "nietrwały",
                                "target_lang_sense_clarification": "nieodporny na uszkodzenia"
                            },
                            {
                                "target_lang_word": "wątły",
                                "target_lang_sense_clarification": "o konstrukcji lub materii"
                            },
                            {
                                "target_lang_word": "arcydelikatny",
                                "target_lang_sense_clarification": "niezwykle delikatny i wrażliwy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1861365-cb49-35cd-9c17-9778c4195f5b",
                    "sense_definition": "Weak; infirm.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>frail</w> grandmother could no longer climb the stairs without help.",
                            "target_lang_translations": {
                                "ru": "Её <w>слабая</w> здоровьем бабушка уже не могла подниматься по лестнице без посторонней помощи.",
                                "pl": "Jej <w>wątła</w> babcia nie mogła już wchodzić po schodach bez pomocy."
                            }
                        },
                        {
                            "text": "His voice sounded <w>frail</w> and hesitant over the telephone line.",
                            "target_lang_translations": {
                                "ru": "Его голос звучал <w>слабо</w> и нерешительно по телефону.",
                                "pl": "Jego głos w słuchawce telefonu brzmiał <w>słabo</w> i niepewnie."
                            }
                        }
                    ],
                    "antonyms": [
                        "strong",
                        "powerful"
                    ],
                    "common_phrases": [
                        "frail voice",
                        "frail light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, едва заметный или немощный (о голосе, свете, дыме).",
                        "pl": "Słaby, nikły lub ledwo dostrzegalny (np. o głosie, świetle)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о голосе, свете, звуке"
                            },
                            {
                                "target_lang_word": "тихий",
                                "target_lang_sense_clarification": "о голосе"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "едва уловимый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wątły",
                                "target_lang_sense_clarification": "słaby, ledwo wyczuwalny"
                            },
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "o niewielkim natężeniu"
                            },
                            {
                                "target_lang_word": "cichy",
                                "target_lang_sense_clarification": "o głosie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02c732d5-a858-384b-ad7d-f70a3b332d82",
                    "sense_definition": "Mentally fragile.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the traumatic event, his <w>frail</w> state of mind was apparent to everyone.",
                            "target_lang_translations": {
                                "ru": "После травмирующего события его <w>хрупкое</w> душевное состояние было очевидно для всех.",
                                "pl": "Po tym traumatycznym wydarzeniu jego <w>kruchy</w> stan psychiczny był dla wszystkich widoczny."
                            }
                        },
                        {
                            "text": "She possessed a <w>frail</w> ego that could not handle even constructive criticism.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>ранимое</w> эго, которое не переносило даже конструктивной критики.",
                                "pl": "Miała <w>kruche</w> ego, które nie potrafiło znieść nawet konstruktywnej krytyki."
                            }
                        }
                    ],
                    "antonyms": [
                        "resilient",
                        "strong-minded"
                    ],
                    "common_phrases": [
                        "frail mind",
                        "frail ego"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически или душевно ранимый, хрупкий.",
                        "pl": "Wrażliwy, kruchy lub niestabilny psychicznie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о душевном состоянии или эго"
                            },
                            {
                                "target_lang_word": "неустойчивый",
                                "target_lang_sense_clarification": "о психике"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о силе духа"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "o psychice lub poczuciu własnej wartości"
                            },
                            {
                                "target_lang_word": "chwiejny",
                                "target_lang_sense_clarification": "niestabilny emocjonalnie"
                            },
                            {
                                "target_lang_word": "wrażliwy",
                                "target_lang_sense_clarification": "łatwy do zranienia psychicznie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87c5a8e8-7599-34af-b218-e21620bea803",
                    "sense_definition": "Liable to fall from virtue or be led into sin; not strong against temptation; weak in resolution; unchaste.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Human nature is notoriously <w>frail</w> when confronted with sudden wealth.",
                            "target_lang_translations": {
                                "ru": "Человеческая природа, как известно, весьма <w>слаба</w> перед лицом внезапного богатства.",
                                "pl": "Ludzka natura jest powszechnie znana z tego, że bywa <w>ułomna</w> w obliczu nagłego bogactwa."
                            }
                        },
                        {
                            "text": "He acknowledged his <w>frail</w> resolution and avoided places of temptation.",
                            "target_lang_translations": {
                                "ru": "Он признал свою <w>слабую</w> решимость и избегал мест искушения.",
                                "pl": "Zdawał sobie sprawę ze swojego <w>słabego</w> postanowienia i unikał miejsc pokusy."
                            }
                        }
                    ],
                    "antonyms": [
                        "resolute",
                        "virtuous"
                    ],
                    "common_phrases": [
                        "frail human nature",
                        "frail resolution"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary or moral contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к грехопадению или пороку; слабый перед искушением; нерешительный; малодушный.",
                        "pl": "Podatny na pokusy, grzech lub ułomność moralną; o słabej woli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "перед искушением"
                            },
                            {
                                "target_lang_word": "бренный",
                                "target_lang_sense_clarification": "о человеческой природе"
                            },
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "легко поддающийся греху"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ułomny",
                                "target_lang_sense_clarification": "o naturze ludzkiej, podatny na błędy"
                            },
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "w obliczu pokusy, o słabej woli"
                            },
                            {
                                "target_lang_word": "kruchy",
                                "target_lang_sense_clarification": "o charakterze lub postanowieniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ed05371-bc81-30e7-96d4-5e84f897c4c5",
                    "sense_definition": "A girl or young woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective noticed a tall, quiet <w>frail</w> sitting alone at the corner table.",
                            "target_lang_translations": {
                                "ru": "Детектив заметил высокую, тихую <w>цыпочку</w>, сидевшую в одиночестве за угловым столиком.",
                                "pl": "Detektyw zauważył wysoką, cichą <w>panienkę</w> siedzącą samotnie przy stoliku w rogu."
                            }
                        },
                        {
                            "text": "He introduced the young lady as his <w>frail</w> to the rest of the gang.",
                            "target_lang_translations": {
                                "ru": "Он представил молодую леди остальным членам банды как свою <w>девушку</w>.",
                                "pl": "Przedstawił młodą damę reszcie gangu jako swoją <w>dziewczynę</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "mid-20th century American slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девушка или молодая женщина (устаревший американский сленг).",
                        "pl": "Dziewczyna lub młoda kobieta (dawny slang amerykański)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цыпочка",
                                "target_lang_sense_clarification": "сленг, девушка"
                            },
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "сленг, молодая женщина"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "laseczka",
                                "target_lang_sense_clarification": "slang, dziewczyna"
                            },
                            {
                                "target_lang_word": "panienka",
                                "target_lang_sense_clarification": "potocznie, młoda kobieta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e28f1d9d-a849-3bf0-a5e2-202c887f89ae",
                    "sense_definition": "A basket made of rushes, used chiefly to hold figs and raisins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baskets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant packed the dried raisins carefully into a woven <w>frail</w>.",
                            "target_lang_translations": {
                                "ru": "Торговец аккуратно уложил сушеный изюм в плетеную <w>корзину</w>.",
                                "pl": "Kupiec ostrożnie zapakował suszone rodzynki do plecionego <w>kosza</w>."
                            }
                        },
                        {
                            "text": "They carried a large <w>frail</w> filled with fresh figs from the orchard.",
                            "target_lang_translations": {
                                "ru": "Они несли большую <w>корзину</w>, наполненную свежим инжиром из сада.",
                                "pl": "Nieśli z sadu duży <w>kosz</w> wypełniony świeżymi figami."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a specific basket"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корзина из камыша, используемая в основном для хранения инжира и изюма.",
                        "pl": "Kosz pleciony z sitowia, używany głównie do przechowywania suszonych fig i rodzynek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плетенка",
                                "target_lang_sense_clarification": "корзина из камыша"
                            },
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "для сухофруктов"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kosz",
                                "target_lang_sense_clarification": "pleciony z sitowia"
                            },
                            {
                                "target_lang_word": "plecionka",
                                "target_lang_sense_clarification": "koszyk z sitowia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "533b88a0-7699-3e02-9543-6b7ab0ab3dcd",
                    "sense_definition": "The quantity of fruit or other items contained in a frail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baskets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe required a full <w>frail</w> of raisins to make the traditional cake.",
                            "target_lang_translations": {
                                "ru": "Для приготовления традиционного пирога по рецепту требовалась целая <w>корзина</w> изюма.",
                                "pl": "Przepis wymagał pełnego <w>kosza</w> rodzynek do upieczenia tradycyjnego ciasta."
                            }
                        },
                        {
                            "text": "They purchased a <w>frail</w> of figs at the local market.",
                            "target_lang_translations": {
                                "ru": "Они купили <w>корзину</w> инжира на местном рынке.",
                                "pl": "Kupili <w>kosz</w> fig na lokalnym targu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical unit of measure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество фруктов или других предметов, содержащихся в такой корзине.",
                        "pl": "Ilość owoców lub innych towarów mieszcząca się w takim koszu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "мера веса или объема"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kosz",
                                "target_lang_sense_clarification": "jako jednostka miary objętości"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dca61d28-e1ed-39f3-a78a-cc877f3c74f6",
                    "sense_definition": "A rush used for weaving baskets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baskets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weavers gathered <w>frail</w> along the riverbank to prepare for their work.",
                            "target_lang_translations": {
                                "ru": "Ткачи собирали <w>камыш</w> по берегу реки, чтобы подготовиться к работе.",
                                "pl": "Plecione zbierały <w>sitowie</w> wzdłuż brzegu rzeki, aby przygotować się do pracy."
                            }
                        },
                        {
                            "text": "This type of <w>frail</w> is highly valued for its strength and flexibility.",
                            "target_lang_translations": {
                                "ru": "Этот вид <w>рогоза</w> высоко ценится за свою прочность и гибкость.",
                                "pl": "Ten rodzaj <w>sitowia</w> jest bardzo ceniony za swoją wytrzymałość i elastyczność."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical botanical/weaving term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Камыш, используемый для плетения корзин.",
                        "pl": "Sitowie używane do wyplatania koszy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "камыш",
                                "target_lang_sense_clarification": "для плетения"
                            },
                            {
                                "target_lang_word": "рогоз",
                                "target_lang_sense_clarification": "материал для корзин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sitowie",
                                "target_lang_sense_clarification": "materiał plecionkarski"
                            },
