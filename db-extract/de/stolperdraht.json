                ],
                "senses": [
                    {
                        "sense_id": "aa903994-965d-397a-92f8-ae5f94f9ddf2",
                        "entry_id": "b9a4e1c2-5c9a-3dd5-b8cb-eaf941099a07",
                        "glosses": [
                            "knapp über dem Erdboden gespannter Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c00b598-2c2c-42e0-ad99-3cf18304695e",
                                "sense_id": "aa903994-965d-397a-92f8-ae5f94f9ddf2",
                                "text": "„Vor ihnen liegen tiefgestaffelte Verteidigungslinien der Russen. Vor ihnen liegen vor allem undurchdringliche Minenfelder. Tellerminen, Tretminen, Pfeifminen. Und zwischen Stolperdrähten die tückischen Reißminen.“"
                            },
                            {
                                "example_id": "39d07bb0-1a95-4634-826a-1298b7e006b4",
                                "sense_id": "aa903994-965d-397a-92f8-ae5f94f9ddf2",
                                "text": "„Bei einem Stolperdraht handelt es sich um eine Verbindung, die meist knapp über dem Boden (in etwa Knöchel- bis Kniehöhe) von einem festen Verankerungspunkt zu einem Zündmechanismus geführt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d89b053a-b5e6-45f9-be19-8fe705db0bdd",
                        "source_entry_id": "b9a4e1c2-5c9a-3dd5-b8cb-eaf941099a07",
                        "source_sense_id": "aa903994-965d-397a-92f8-ae5f94f9ddf2",
                        "source_sense_description": "knapp über dem Erdboden gespannter Draht",
                        "target_lang_word": "tripwire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tripwire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "119e1b77-a513-3784-86cb-2f1efc53a175",
                                        "entry_id": "4d917626-0c45-39c5-a8f1-bde9d00860f5",
                                        "glosses": [
                                            "A cord or wire arranged so that when snagged or pulled by an intruder, it will trigger a detector or trap or a device, such as a land mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f44be2f-e301-400f-be68-c04596edbe4b",
                                                "sense_id": "119e1b77-a513-3784-86cb-2f1efc53a175",
                                                "text": "Seeing the tripwire of a nearby bouncing Betty gave us cold chills, and we moved all the more slowly through the woods."
                                            },
                                            {
                                                "example_id": "8245c41a-f013-46d5-9e81-bda0b29ac56b",
                                                "sense_id": "119e1b77-a513-3784-86cb-2f1efc53a175",
                                                "text": "They watched the two ghost-hunters run own the corridor and go crashing over the trip-wire."
                                            },
                                            {
                                                "example_id": "eb8eea3e-47be-42dc-8075-63c9c4e7d881",
                                                "sense_id": "119e1b77-a513-3784-86cb-2f1efc53a175",
                                                "text": "Thirteen people were injured in August 1957 when this Bristol freighter skidded on the runway at Southend Airport when landing with a flight from Calais. It ploughed through the boundary fence, but thankfully stopped short of the railway and the 1,500V overhead wires. A tripwire was installed on this section of Shenfield-Southend line to warn train drivers of instances such as this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee4516a-f92a-331f-ae46-d18cbef74761",
                                        "entry_id": "4d917626-0c45-39c5-a8f1-bde9d00860f5",
                                        "glosses": [
                                            "Any means of detecting intruders or attackers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac87d96d-e31d-4d7f-aae6-1e47001ce20a",
                                                "sense_id": "aee4516a-f92a-331f-ae46-d18cbef74761",
                                                "text": "The continued presence of U.S. troops as a tripwire force in Macedonia is an increasingly risky venture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tripwire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a98ddfa1-8958-3983-91c6-a637f7550702",
                                        "entry_id": "4d6d9630-6c8a-3acf-b64b-665d38918d54",
                                        "glosses": [
                                            "To set a tripwire mechanism in (a location)."
                                        ],
