                        ],
                        "examples": [
                            {
                                "example_id": "1a215e55-2a61-4c7c-a11b-ae8ab5ed684f",
                                "sense_id": "0d73cda1-f705-3c25-821a-0bcf56c4a1da",
                                "text": "Sa causticité lui a fait bien des ennemis."
                            },
                            {
                                "example_id": "0d7114be-7e6b-4cb0-a895-72118a084dcc",
                                "sense_id": "0d73cda1-f705-3c25-821a-0bcf56c4a1da",
                                "text": "J’avoue franchement que si les deux Muses de la causticité et de l’ironie m’accordaient toujours leurs faveurs, c’est dans ce style que j’écrirais maintenant tous mes articles."
                            }
                        ]
                    },
