                        "examples": [
                            {
                                "example_id": "2cd12b1a-03f2-427d-9e86-c57cb273e16b",
                                "sense_id": "7d64d285-abcf-346f-bba2-2159c7b4abc6",
                                "text": "La Marie Bonheur demandait :\n— T’y as donné six cents balles ?\n— Comme aux autres, disait Bouve… et ça m’épate un peu qu’un môme de son âge, avec ses six faffes, y soye déjà raide comme un passe-lacet…"
                            }
                        ]
