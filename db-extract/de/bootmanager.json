                "senses": [
                    {
                        "sense_id": "45d981cc-3393-363e-bbab-29c7f56ee107",
                        "entry_id": "a517fe36-b08d-3c23-8793-7899ed3c5425",
                        "glosses": [
                            "eine Software, durch die man beim Starten des Computers ein Betriebssystem auswählen und laden lassen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3fd4a9d-bd44-4982-b46c-b8cbbf7155a0",
                                "sense_id": "45d981cc-3393-363e-bbab-29c7f56ee107",
                                "text": "„Windows XP zerstört bei der Installation den Bootmanager von Windows Vista, erkennt aber in seinem eigenen Bootmanager Windows Vista nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d85ba98d-aaca-4c64-aecf-b481cb0030f8",
                        "source_entry_id": "a517fe36-b08d-3c23-8793-7899ed3c5425",
                        "source_sense_id": "45d981cc-3393-363e-bbab-29c7f56ee107",
                        "source_sense_description": "Software, durch die man ein Betriebssystem auswählen und laden lassen kann",
                        "target_lang_word": "boot loader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boot loader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fec5306f-1f53-303f-b39a-b805d3a6244e",
                                        "entry_id": "86fa6948-6d86-38cf-ab58-dcb30922846a",
                                        "glosses": [
                                            "A small program that initiates the bootstrap process by loading the operating system proper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38cbc5c2-0a34-4366-87ac-8f0ea5da81ba",
                                                "sense_id": "fec5306f-1f53-303f-b39a-b805d3a6244e",
                                                "text": "In the case of a PC that runs nothing but Windows, the boot loader in the MBR is hard-coded to check for a secondary boot loader in the active primary partition. This secondary boot loader directly loads the Windows kernel."
                                            },
                                            {
                                                "example_id": "5bd4e127-55de-46cf-b95f-42c763318c86",
                                                "sense_id": "fec5306f-1f53-303f-b39a-b805d3a6244e",
                                                "text": "It was a thought that returned to me days later while reading an article about Elon Musk, one of the loudest voices calling to reopen the economy–a man who once referred to humanity as the “biological bootloaders” for AI."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
