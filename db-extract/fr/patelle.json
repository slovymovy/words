        "fr-extract.jsonl": [
            {
                "entry_id": "b28ea274-ba15-3337-8ba7-ec62fbf281a9",
                "word": "patelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5de3b6c3-d76e-44b5-9f07-970f487169c3",
                        "entry_id": "b28ea274-ba15-3337-8ba7-ec62fbf281a9",
                        "tags": [
                            "plural"
                        ],
                        "form": "patelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b1b1522-7f54-3b8a-967f-81b2948cd6eb",
                        "entry_id": "b28ea274-ba15-3337-8ba7-ec62fbf281a9",
                        "glosses": [
                            "Mollusque gastéropode prosobranche qui vit dans la zone de balancement des marées dont la coquille, en forme de chapeau chinois, est appliquée aux rochers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157bfc3b-e3ae-4b8e-873f-366358c5f535",
                                "sense_id": "9b1b1522-7f54-3b8a-967f-81b2948cd6eb",
                                "text": "Les enfans détachent du rocher les patelles, les turbos, les buccins, espèces de colimaçons de mer, les haliotides à l'écaille nacrée, ou les moules réunies en grappes à l'aide des fils tissés par l'animal."
                            },
                            {
                                "example_id": "76cd60fe-7727-4327-8752-0b4d2d025c74",
                                "sense_id": "9b1b1522-7f54-3b8a-967f-81b2948cd6eb",
                                "text": "On privilégiera les abords de la Cotinière, sur Oléron, pour les étrilles, les oursins, les bigorneaux et les patelles."
                            },
                            {
                                "example_id": "eb293b02-58a8-4ee7-bef3-b5a32b553972",
                                "sense_id": "9b1b1522-7f54-3b8a-967f-81b2948cd6eb",
                                "text": "Je préférais alors vivre pour mon compte et aller sur le bord de la mer ramasser des patelles et pêcher des crabes."
                            },
                            {
                                "example_id": "54a8feeb-437f-41c5-9ac5-fa55c88cca86",
                                "sense_id": "9b1b1522-7f54-3b8a-967f-81b2948cd6eb",
                                "text": "Ma grand-mère se moque de moi, si peureuse, toujours agrippée à la jupe maternelle, suspendue à sa vie silencieuse ; un « brennig » sur son rocher, dit-elle : en breton, une patelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5538a726-1676-4edd-a5e1-5e69c2193590",
                        "source_entry_id": "b28ea274-ba15-3337-8ba7-ec62fbf281a9",
                        "source_sense_id": "9b1b1522-7f54-3b8a-967f-81b2948cd6eb",
                        "target_lang_word": "limpet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d900d9bd-6615-3440-a376-cbe0fa89716c",
                                        "entry_id": "56273fea-3307-3434-9664-01763a46a778",
                                        "glosses": [
                                            "Any of various gastropods with a conical shell shape patelliform and a strong, muscular foot that they use to create strong suction to cling onto rocks or other hard surfaces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd1f0f51-8b9c-3b87-a768-b1a057c00b74",
                                        "entry_id": "56273fea-3307-3434-9664-01763a46a778",
                                        "glosses": [
                                            "Someone clingy or dependent; someone disregarding or ignorant of another's personal space."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dae61c9-253e-427c-b27a-687c58f29342",
                                                "sense_id": "bd1f0f51-8b9c-3b87-a768-b1a057c00b74",
                                                "text": "He stuck to me like a limpet all day!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "limpet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23f9d6da-8acf-3e46-9cc8-3cc09c6e73f6",
                                        "entry_id": "1c665c1d-b187-3c0d-b91b-ff01cc7c9de2",
                                        "glosses": [
                                            "To gather limpets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4b78e5-6073-4c0f-b676-888a24d3ea52",
                                                "sense_id": "23f9d6da-8acf-3e46-9cc8-3cc09c6e73f6",
                                                "text": "Mother visited the little cottage over the hill, and found Lisette's story to be quite correct; and many times the Frenchwoman blessed the day when Margie went limpeting and Lisette lent the old knife to the golden-haired little English lady."
                                            },
                                            {
                                                "example_id": "5cde6f07-12fb-4138-beff-70b8a59a9284",
                                                "sense_id": "23f9d6da-8acf-3e46-9cc8-3cc09c6e73f6",
                                                "text": "Razor-fishing, sand-eeling and limpeting used to be popular activities but have declined in importance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
