                        ],
                        "form": "die Absteigen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bd0799c-e548-36d8-b988-9c1ffddae0e8",
                        "entry_id": "609c97de-d8bf-3d22-bff9-e74c004f4531",
                        "glosses": [
                            "schlichte, minderwertige oder übel beleumundete Unterkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641440d4-1f54-4e95-97d5-affab4ec0b6f",
                                "sense_id": "6bd0799c-e548-36d8-b988-9c1ffddae0e8",
                                "text": "„Die Suche nach ihm in Bordellen und sonstigen, der Militärpolizei bekannten Absteigen blieb erfolglos; dem Boot fehlte der Kapitän.“"
                            },
                            {
                                "example_id": "cbca8e70-d6a1-4ac5-90b0-d8ec196e7ee2",
                                "sense_id": "6bd0799c-e548-36d8-b988-9c1ffddae0e8",
                                "text": "„Was heute eine drittklassige Absteige wäre, war damals für uns Besucher aus Deutschland unfassbarer Luxus, der hier in dieser Hochfestung einer intakt gebliebenen Großbürgerlichkeit ohne Krieg und Hitler durch Europas barbarische Kriegsjahre gekommen war.“"
                            },
                            {
                                "example_id": "3caa6dce-3d29-4a4a-a8a3-5888b108c72f",
                                "sense_id": "6bd0799c-e548-36d8-b988-9c1ffddae0e8",
                                "text": "„Die Solidarität unter Liebeskranken führte dazu, dass ich für ihn in meiner Absteige ein Zimmer mietete.“"
                            },
                            {
                                "example_id": "462561a6-f0c8-4d88-82cb-76158ba0fed0",
                                "sense_id": "6bd0799c-e548-36d8-b988-9c1ffddae0e8",
                                "text": "„Es war um Jimmy Foxx gegangen, den man tot in einer billigen Absteige aufgefunden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ae43a59-1cc9-49cb-b455-f4edfbad5b0a",
                        "source_entry_id": "609c97de-d8bf-3d22-bff9-e74c004f4531",
                        "source_sense_id": "6bd0799c-e548-36d8-b988-9c1ffddae0e8",
                        "source_sense_description": "schlichte, minderwertige oder übel beleumundete Unterkunft",
                        "target_lang_word": "flophouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flophouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                        "entry_id": "85fb3bab-9a21-378c-81a7-0e533529bcf8",
                                        "glosses": [
                                            "A cheap hotel or boarding house where many people sleep in large rooms."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa3f270-655a-474e-b8cb-868dfaa739f3",
                                                "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                                "text": "In one of [Cincinnati’s] slum districts stands the Silver Moon, a “flop house” (i.e., a house where the occupants are “flopped” out of their hanging bunks by letting down the ropes)."
                                            },
                                            {
                                                "example_id": "04301a4b-1dc9-40aa-9315-45ebbc6e70ee",
                                                "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                                "text": "We even visited some drunken seamen in a flophouse on Mission Street that she knew; they offered us whisky."
                                            },
                                            {
                                                "example_id": "fa39bcae-de2f-4007-9094-f7aa0296ec7e",
                                                "sense_id": "0216d216-327e-351b-9f44-3c4e10c23301",
                                                "text": "He was born out back of a twopenny flophouse in what the wags called “The Holy Land” […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flophouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01e1adae-bcf9-3c8d-bb67-3dcf4039964e",
                                        "entry_id": "a01d49d8-10f4-3cfb-b5ae-d29d6fa7bee7",
                                        "glosses": [
                                            "To stay in a flophouse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c70d41a-bff3-4a64-b4aa-ebb16a44a21c",
                                                "sense_id": "01e1adae-bcf9-3c8d-bb67-3dcf4039964e",
                                                "text": "August was aware of Robert's strange quirk of flophousing away from home and that he often spent weekends at the Diana."
                                            },
                                            {
                                                "example_id": "f369417b-1005-4d80-88d1-d6b445c2c701",
                                                "sense_id": "01e1adae-bcf9-3c8d-bb67-3dcf4039964e",
                                                "text": "I kept going nowhere, bummed the country, boxcar'd it, breadlined it, flophoused it, that cruddy dying by inches in jungles when, Christ-o, outa the knocked-out black and blue I'm told I gotta go to war, gotta fight for freedom."
                                            },
                                            {
                                                "example_id": "e2111525-43cd-4ab4-acca-ee818f33f2dc",
                                                "sense_id": "01e1adae-bcf9-3c8d-bb67-3dcf4039964e",
                                                "text": "For old time's sake we plan to flophouse with you over the parturient period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ae8da8a-3794-4008-a9b7-dfc8e7e13ce6",
                        "source_entry_id": "609c97de-d8bf-3d22-bff9-e74c004f4531",
