                                        "glosses": [
                                            "Inclusive; affecting the whole world."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "725d8180-1982-33b7-b6e8-b19891b375ed",
                                        "entry_id": "7531db46-eff2-34a3-81ee-d72e958be0a3",
                                        "glosses": [
                                            "Composed of people from all over the world."
                                        ],
                                        "tags": [
                                            "of a place or institution"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dec2d52e-bfcb-338e-a1d0-e486e308d353",
                                        "entry_id": "7531db46-eff2-34a3-81ee-d72e958be0a3",
                                        "glosses": [
                                            "At ease in any part of the world; having a wide experience with many cultures."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6974f8dc-fc0a-4469-bbb7-4b0671dff4d3",
                                                "sense_id": "dec2d52e-bfcb-338e-a1d0-e486e308d353",
                                                "text": "The philosophy of cosmopolitanism underlies theories of global citizenship. Cosmopolitanism is the ability to balance a local and global identity. A cosmopolitan individual engages meaningfully with different cultures and feels at home in the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6cad35-7ca1-3555-9148-469967ab6d26",
                                        "entry_id": "7531db46-eff2-34a3-81ee-d72e958be0a3",
                                        "glosses": [
                                            "Growing or living in many parts of the world; widely distributed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa81f35c-28a1-4acb-a5dd-fe1eda12b666",
                                                "sense_id": "7c6cad35-7ca1-3555-9148-469967ab6d26",
                                                "text": "Domestication and the evolution of anthrophilic traits in houseflies and some drosophilids have allowed certain species to attain cosmopolitan status."
                                            }
                                        ]
                                    }
                                ]
                            },
