                                                "example_id": "7a79f3b2-1c4d-4660-8f57-50edcc4c4ae2",
                                                "sense_id": "b319d7fc-73b0-3625-a850-c0a875a291da",
                                                "text": "Заводская вонь и заводские едкие дымы сюда никогда не доходили, так же, впрочем, как и городская канализация."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6208708b-7750-3680-bee5-2f514423a5c9",
                                        "entry_id": "ec6a369a-9f4c-36d5-ad93-21ea31d9a5b7",
                                        "glosses": [
                                            "строительство сети каналов (обычно соединяющих несколько водных бассейнов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d75979f-9a0d-4210-9b96-6f7519da6de7",
                                                "sense_id": "6208708b-7750-3680-bee5-2f514423a5c9",
                                                "text": "Встаёт новая задача ― канализация самой канализационной станции."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
