                        "source_sense_id": "0f21c6bd-515b-37aa-9b76-ccebe577edf6",
                        "source_sense_description": "saftreiche Pflanze, die an besondere Klima- und Bodenverhältnisse angepasst ist",
                        "target_lang_word": "vetplant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
