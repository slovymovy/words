                                    {
                                        "sense_id": "d6385ecf-3827-3855-8d5c-186c625c5aec",
                                        "entry_id": "31dc445a-b33a-31a7-8a9f-c99b68588a80",
                                        "glosses": [
                                            "grüner Farbstoff in Zellen von Pflanzen und einiger Mikroorganismen, der für die Fotosynthese zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c82d5b-4d8b-4424-9cb6-4010c72b2d9e",
                                                "sense_id": "d6385ecf-3827-3855-8d5c-186c625c5aec",
                                                "text": "Das Blattgrün ist das Kraftwerk der Pflanze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6315d7a4-4232-3ce9-ae17-fb6dd2e7cf61",
                                        "entry_id": "31dc445a-b33a-31a7-8a9f-c99b68588a80",
                                        "glosses": [
                                            "Farbton, der dem Grün eines Blattes einer Pflanze gleicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8318471a-a301-4bbc-b7e2-408f24fc0038",
                                                "sense_id": "6315d7a4-4232-3ce9-ae17-fb6dd2e7cf61",
                                                "text": "Blattgrün ist nicht der gewünschte Farbton."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64317f3d-86fb-4c36-a7f1-0439d43f05bc",
                        "source_entry_id": "82667f58-e89e-3985-9356-13d04f8af623",
