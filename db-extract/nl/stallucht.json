                "senses": [
                    {
                        "sense_id": "dfaa68e8-2916-311b-b7b8-72e73f9f2d19",
                        "entry_id": "fe472185-08ff-320e-9037-8ca761931522",
                        "glosses": [
                            "de geur en de atmosfeer in een stal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624b65be-b763-49ce-8fe3-10a0f35b4702",
                                "sense_id": "dfaa68e8-2916-311b-b7b8-72e73f9f2d19",
                                "text": "Al die megastallen hebben ook voordelen. \"Als er overlast is, bijvoorbeeld van stank, dan is dit lokaal\", vertelt Van Os. \"Vroeger waren er veel kleine boerderijen die op veel verschillende plekken de stallucht verspreidden.\""
                            },
                            {
                                "example_id": "2cb40c95-4d14-486e-a0b2-6162fa04efcc",
                                "sense_id": "dfaa68e8-2916-311b-b7b8-72e73f9f2d19",
                                "text": "De belangrijkste bron van agrarische stikstofemissies is het gasvormige ammoniak dat uit dierlijke mest vrijkomt. Volgens diverse onderzoeken is meer dan de helft van de agrarische stikstofemissie terug te voeren op de melkveehouderij. Het grootste deel komt vrij in de stallen, een kleiner deel bij het uitrijden van mest. Tot voor kort kon de concentratie ammoniak in stallucht alleen met zeer specialistische, dure apparatuur en kostbare analyses worden bepaald. „Voor de gemiddelde dierhouder was het meten van de concentratie ammoniak in de stallucht eenvoudig veel te duur”, zegt Franklin Stump van Estede Scientific. „Ons gebruikersvriendelijke systeem is wat dat betreft een doorbraak.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5ad7181-29f4-4efa-aa0e-3a9b64353c0d",
                        "source_entry_id": "fe472185-08ff-320e-9037-8ca761931522",
                        "source_sense_id": "dfaa68e8-2916-311b-b7b8-72e73f9f2d19",
                        "source_sense_description": "de geur en de atmosfeer in een stal",
                        "target_lang_word": "Stallgeruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stallgeruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d44e851-77fb-36d5-a2d3-4c5108732ac1",
                                        "entry_id": "8cc4bbea-a70e-34a1-b3e6-63f5b3264c29",
                                        "glosses": [
                                            "die typische Art, wie es in einem (Vieh-)Stall riecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8e0a6c-a359-4daf-90a7-737155a50770",
                                                "sense_id": "0d44e851-77fb-36d5-a2d3-4c5108732ac1",
                                                "text": "Zum Urlaub auf dem Bauernhof gehört Stallgeruch einfach dazu."
                                            },
                                            {
                                                "example_id": "9f4d120f-5fa2-4a27-9d02-d870eaa3cc56",
                                                "sense_id": "0d44e851-77fb-36d5-a2d3-4c5108732ac1",
                                                "text": "„Es hatte nicht besonders gut gerochen – aber sogar der Stallgeruch war besser gewesen als dieser Geruch nach feuchtem Zement.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6217b00-9c86-35cc-8bbd-b4e3fb1023da",
                                        "entry_id": "8cc4bbea-a70e-34a1-b3e6-63f5b3264c29",
                                        "glosses": [
                                            "die Verbundenheit mit einem bestimmten Milieu, das Dazugehören zu einem gewissen Kreis"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c637662-976c-48d3-a6f9-b36a784c8c24",
                                                "sense_id": "e6217b00-9c86-35cc-8bbd-b4e3fb1023da",
                                                "text": "„Erfahrung in der Personalarbeit ist nicht unbedingt Voraussetzung für die Arbeit des Disponenten, dafür aber Fachkenntnisse und der Stallgeruch der jeweiligen Branche.“"
                                            },
                                            {
                                                "example_id": "75038fd0-692d-4596-bd4a-54267d4eedd8",
                                                "sense_id": "e6217b00-9c86-35cc-8bbd-b4e3fb1023da",
                                                "text": "„Zwar fehlt vielen Genossen der Stallgeruch, die fachliche Kompetenz stellt aber nicht einmal der politische Gegner in Frage.“"
                                            },
                                            {
                                                "example_id": "2682193b-ca5d-40f1-8cec-c73d13533013",
                                                "sense_id": "e6217b00-9c86-35cc-8bbd-b4e3fb1023da",
                                                "text": "„Im Laufe meiner Karriere habe ich gesehen, dass der richtige Stallgeruch entscheidend ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
