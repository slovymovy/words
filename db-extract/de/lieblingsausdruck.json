                        "examples": [
                            {
                                "example_id": "7ec948f5-d946-4ab5-8e87-857e033c9ae5",
                                "sense_id": "7e8b4ab8-8d0e-3044-856e-36b0e49c56d1",
                                "text": "„Amit warnte vor einem ›Domino-Effekt‹ und benutzte damit den Lieblingsausdruck der CIA zur Rechtfertigung des Krieges in Vietnam.“"
                            },
                            {
                                "example_id": "1a2153e0-b627-49f4-a0b2-feaa352888c1",
                                "sense_id": "7e8b4ab8-8d0e-3044-856e-36b0e49c56d1",
                                "text": "„›Yeah, das sollten wir genauer beleuchten‹, hatte Pope gesagt und den Ausdruck übernommen, weil er den Eindruck hatte, dass es sich vielleicht um einen von Gantts Lieblingsausdrücken handelte.“"
                            },
                            {
                                "example_id": "4ce587bf-cd09-4cb0-acc8-8b29e9a7f090",
                                "sense_id": "7e8b4ab8-8d0e-3044-856e-36b0e49c56d1",
                                "text": "„Aus ihrer Liste liest sie vor: ›Was war in deiner Jugend dein Lieblingsausdruck?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
