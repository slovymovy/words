                                "target_senses": [
                                    {
                                        "sense_id": "eea35b72-efa9-35b9-b36e-49745fd482f6",
                                        "entry_id": "f31a7ba3-c846-395d-bbfa-769c4e7e8b1f",
                                        "glosses": [
                                            "Organe unitaire d’un train d’atterrissage équipé d’éléments (roue, patin, flotteur) sur lesquels un aéronef se repose lorsqu’il est au sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "336ac624-ad1c-4a53-9ab3-44ab8719d918",
                                                "sense_id": "eea35b72-efa9-35b9-b36e-49745fd482f6",
                                                "text": "Ne quittons pas les trains d’atterrissage sans noter, que, sagement, les maisons qui fabriquent des atterrisseurs à relevage électrique, se sont entendues pour rationaliser leur production."
                                            },
                                            {
                                                "example_id": "bd8236df-a18f-43f0-b113-ae65b677ad7c",
                                                "sense_id": "eea35b72-efa9-35b9-b36e-49745fd482f6",
                                                "text": "L’atterrisseur principal comprenait deux roues de grand diamètre dont les jambes oléo-pneumatiques Messier se prolongeaient jusqu’aux fuseaux-moteurs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b53d4e-530b-38db-9055-0dc4817e4430",
                                        "entry_id": "f31a7ba3-c846-395d-bbfa-769c4e7e8b1f",
                                        "glosses": [
                                            "Sonde spatiale destinée à atterrir sur un astre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fecd43e-1db4-48bd-92f9-4129cf99e377",
                                                "sense_id": "62b53d4e-530b-38db-9055-0dc4817e4430",
                                                "text": "L’atterrisseur, qui transporte de multiples instruments, a utilisé mercredi son bras robotisé pour déposer le sismomètre sur le sol, à 1,64 mètre en face de lui, a détaillé la Nasa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
