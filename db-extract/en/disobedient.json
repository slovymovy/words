                        "translation_id": "bea115e1-40a2-4dfd-844b-32d3c094e38a",
                        "source_entry_id": "1eedcad3-18f7-3ef6-b194-538a5b9a279e",
                        "source_sense_id": "c5f3e7d7-427d-3f78-9c63-3a897ce8ad4e",
