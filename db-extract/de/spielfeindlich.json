                    {
                        "form_id": "e030d469-d6ab-4e2a-96e2-df2183236bef",
                        "entry_id": "58392b11-287e-3cd5-a130-aa72e5b90aa9",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind spielfeindlich"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20427087-d2e2-35dd-8fe6-051b7f0223b2",
                        "entry_id": "58392b11-287e-3cd5-a130-aa72e5b90aa9",
                        "glosses": [
                            "negativ gegenüber dem Spiel beziehungsweise dem Spielen eingestellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cafd94b-3ef5-4a80-bd9e-5db442794762",
                                "sense_id": "20427087-d2e2-35dd-8fe6-051b7f0223b2",
                                "text": "„Wer sich jedoch eine Basiskompetenz im Spielen angeeignet hat, gerät auch an scheinbar spielfeindlichen, anregungsarmen Orten, auch ohne jegliches Spielgerät, auch ohne Mitspieler, nicht in Verlegenheit, zu sinnvollem Spiel zu finden.“"
                            },
                            {
                                "example_id": "6375d48b-4736-4359-991e-3e11ff58e296",
                                "sense_id": "20427087-d2e2-35dd-8fe6-051b7f0223b2",
                                "text": "„In einem Interview gefragt, ob das Christentum spielfeindlich sei, bejahte der Schweizer Philosoph Hans Saner die Frage ausdrücklich.“"
                            },
                            {
                                "example_id": "e5f80261-04ce-42b4-8957-1f4814db9fe9",
                                "sense_id": "20427087-d2e2-35dd-8fe6-051b7f0223b2",
                                "text": "„Christentum, Judentum und gerade auch der Islam sind spielfeindliche Religionen.“"
                            },
                            {
                                "example_id": "3cdfa35a-8939-4d6e-8a4b-3c75b8eb2a01",
                                "sense_id": "20427087-d2e2-35dd-8fe6-051b7f0223b2",
                                "text": "„An der Spannung von spielfreundlichen und spielfeindlichen Zügen in der Kunst zeichnet sich Gorsen zufolge ein Konflikt gegenüber der warenproduzierenden Gesellschaft ab […].“"
                            },
                            {
                                "example_id": "f93acdea-1f23-4c67-9b21-871b6a94cdee",
