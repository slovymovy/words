                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0f62326-5ccd-3138-be9f-0bc0d278fc45",
                        "entry_id": "2c8e0498-b3e4-37ef-8630-17414719f7a0",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным томат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "957123f2-852e-427c-80e9-f357bf3dd1ed",
                                "sense_id": "c0f62326-5ccd-3138-be9f-0bc0d278fc45",
                                "text": "Разведение томатной рассады лучше всего начать с конца декабря или начала января с тем, чтобы через один-полтора месяца перевести растение на доращивание при естественном освещении."
                            }
                        ]
                    },
                    {
                        "sense_id": "e84770e8-ba17-3329-b7c5-4b321b223d50",
                        "entry_id": "2c8e0498-b3e4-37ef-8630-17414719f7a0",
                        "glosses": [
                            "свойственный томату, характерный для него"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "24319d34-9519-3ba3-913f-796b1e12e286",
                        "entry_id": "2c8e0498-b3e4-37ef-8630-17414719f7a0",
                        "glosses": [
                            "приготовленный из томатов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e1a12a-3407-4617-b189-29033e7c0f15",
                                "sense_id": "24319d34-9519-3ba3-913f-796b1e12e286",
                                "text": "На столах были расставлены бутылочки с маслом, уксусом, томатным соусом и различными острыми приправами."
                            },
                            {
                                "example_id": "754eb2f1-9684-4faa-be90-565e6f89b128",
                                "sense_id": "24319d34-9519-3ba3-913f-796b1e12e286",
                                "text": "Неудачную покупку сделал я, купив томатное пюре, уже испортившееся, точнее испорченное."
                            },
                            {
                                "example_id": "8dafd383-aa94-48ee-bd44-3d52f5d55cbd",
                                "sense_id": "24319d34-9519-3ba3-913f-796b1e12e286",
                                "text": "Почти все обитатели барака собрались у костра, где жарится рыба с макаронами и томатной подливкой."
                            },
                            {
                                "example_id": "206b939c-b4ab-4ab0-aef7-a6ba86f60a1e",
                                "sense_id": "24319d34-9519-3ba3-913f-796b1e12e286",
                                "text": "А потом он затопил печку, открыл банку завалявшихся консервов — килька в томатном соусе, — сам её и съел."
                            }
                        ]
                    }
                ],
