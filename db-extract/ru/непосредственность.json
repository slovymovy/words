                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ce99949-d1c3-3ca5-b309-a4212002c202",
                                        "entry_id": "c2f34911-3b82-3ceb-b707-a049e4941c71",
                                        "glosses": [
                                            "An ingenuous behavior."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa6991a-cd84-4dde-ad5a-e97cabdbe200",
                                                "sense_id": "6ce99949-d1c3-3ca5-b309-a4212002c202",
                                                "text": "Time passed; Moira grew up, chronologically; but Sir Watney went on treating her as a spoilt child, went on being enchanted by her birdy chirrupings and ingenuousnesses and impertinent enfant-terrible-isms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
