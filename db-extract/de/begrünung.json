                        "form": "die Begrünung"
                    },
                    {
                        "form_id": "323a0781-cd79-4b49-9e2f-0f9683b7f4a5",
                        "entry_id": "889b6070-e593-3986-acfd-d3bd45ac923d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Begrünungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                        "entry_id": "889b6070-e593-3986-acfd-d3bd45ac923d",
                        "glosses": [
                            "Bepflanzen mit Sträuchern oder Bäumen, beispielsweise bei Bauwerken an Fassaden und auf Dächern oder in Grünanlagen"
                        ],
                        "tags": [
                            "Umwelt",
                            "Städtebau"
                        ],
                        "examples": [
                            {
                                "example_id": "a0c0547e-503c-432a-8d4a-9e80e41da90e",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Graue Klötze in Wohn- und Gewerbegebieten bestimmen das Bild unserer Umgebung. Dabei kann die Begrünung der Wände Klima, Artenvielfalt und Häuser schützen und zudem noch unser Auge erfreuen.“"
                            },
                            {
                                "example_id": "025fef31-b33a-4c11-9a83-3351767f48a4",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "[…] „die Begrünung der Außenwände“ [ist] „immer noch selten, obwohl diese in einigen Kommunen gefördert wird.“"
                            },
                            {
                                "example_id": "44f0dc6c-5c85-4a14-aff5-684ce7de9448",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Auch Ansbach in Mittelfranken, München unterstützen die Begrünung von Fassaden.“"
                            },
                            {
                                "example_id": "f9a2cb09-5dda-493f-ac82-b40f065aa492",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„»Aber auch die lokale Begrünung ist eine Option, also an Fassaden oder auf Dächern. Dann wird es auch in den Gebäuden selbst kühler.«““"
                            },
                            {
                                "example_id": "1c98fce3-cfc0-48ce-863c-edb3a6a3822e",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "[Spitzahorn:] „Aufgrund seiner Widerstandsfähigkeit gegen Industriebelastung erfreut er sich wachsender Beliebtheit bei der Begrünung von Städten.“"
                            },
                            {
                                "example_id": "4b914149-aff7-45c5-9b0a-fee82b6c5e3f",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„»Es ist schon eine Verpflichtung. Ich glaube, es ist jetzt hoffentlich schwerer geworden, einfach ein normales Haus ohne Begrünung irgendwohin zu stellen. Das ist das, was wir erreichen wollen.«“"
                            },
                            {
                                "example_id": "cef2422f-2b13-427c-9040-39730ab17afd",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Auf der Agenda steht zudem die Begrünung von Dächern und Fassaden. Auch Böden werden entsiegelt; Asphalt zugunsten des natürlichen Bodens entfernt.“"
                            },
                            {
                                "example_id": "c10c345b-76ba-4689-87f5-af897d0fb2ae",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Eine in Ljubljana durchgeführte Studie, welche die Veränderungen der Außenwandtemperatur durch die Begrünung untersuchte, ergab eine Temperatursenkung von 8,5 °C an einem westlich ausgerichteten Gebäude.“"
                            },
                            {
                                "example_id": "3f17f2a2-8403-4718-9a35-15cabf3e39c8",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "[Dachbegrünung:] „Sicherheitshalber sollte die Dachlast vor der Begrünung von einem Experten geprüft werden.“"
                            },
                            {
                                "example_id": "7989b690-cafd-4fe1-9a3a-584c77a3f739",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Die Begrünung von innerstädtischen Flächen trägt zu einer Reduktion von Treibhausgasemissionen bei – in erster Linie durch die isolierende Wirkung.“"
                            },
                            {
                                "example_id": "946db03d-66a6-492c-b116-7b04e399c580",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Bei einer extensiven Begrünung eines Daches liegt die Höhe der Vegetations-/Substratschicht zwischen wenigen bis hin zu 15 Zentimetern.“"
                            },
                            {
                                "example_id": "acbbce7b-626b-4458-b024-4027d32da50e",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Bei der Bepflanzung von extensiven Gründächern empfehlen Experten zur schnelleren Begrünung immer auch sogenannte Sedumsprossen, also Triebe von Sedumpflanzen, zu säen.“"
                            },
                            {
                                "example_id": "e49ee626-8736-4760-8074-9b287585d467",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Bei der Bepflanzung der Allee kommen Begonien zum Einsatz – eine der dankbarsten Pflanzen für die Begrünung von schattigen Plätzen.“"
                            },
                            {
                                "example_id": "895e6ed5-4cea-4058-83fb-578925a2b73f",
                                "sense_id": "43984009-01b1-3ded-a6f4-bed9e98d5ece",
                                "text": "„Es gibt zwei gängige Methoden zur Begrünung eines Sportplatzes: Einsaat und Verwendung von Rollrasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d23368b8-21ef-36d0-a428-cf8038428624",
                        "entry_id": "889b6070-e593-3986-acfd-d3bd45ac923d",
                        "glosses": [
                            "alle Pflanzen, die etwas an einem Ort begrünen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74433fac-eb98-4434-8db3-346314a9c6bf",
                                "sense_id": "d23368b8-21ef-36d0-a428-cf8038428624",
                                "text": "Eine Fassade ohne Begrünung ist günstiger, als mit. Schließlich müssen die Pflanzen gewässert und beschnitten werden."
                            },
                            {
                                "example_id": "841a2270-439f-40b4-9bbb-6a118705ec92",
                                "sense_id": "d23368b8-21ef-36d0-a428-cf8038428624",
                                "text": "„Wer keinen Garten hat, muss nicht auf Begrünung verzichten, denn die meisten Pflanzen lassen sich problemlos im Kübel auf dem Balkon kultivieren.“"
                            },
                            {
                                "example_id": "244f137f-ee0c-4e13-bfd7-8afdc1cd7eb1",
                                "sense_id": "d23368b8-21ef-36d0-a428-cf8038428624",
                                "text": "„Die firmeneigene Begrünung soll also einen minimalen Beitrag zu einem besseren Stadtklima leisten.“"
                            },
                            {
                                "example_id": "98545a84-5f72-41e4-a745-57b74a2bfb55",
                                "sense_id": "d23368b8-21ef-36d0-a428-cf8038428624",
                                "text": "„Die Universität Bern untersucht mit dem Projekt, wie die Begrünung die Temperaturen, die Biodiversität und den Wasserhaushalt beeinflusst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
