                        "examples": [
                            {
                                "example_id": "9630e96c-6c38-47d9-bd2f-46514a58e163",
                                "sense_id": "d793b595-2e5f-3af0-a00e-c600e2ecaca5",
                                "text": "Ortiz, the burly, bonhomous bar-keeper with the hooked, prize-fighter nose […], epitomised the pied noir with his emotional vehemence."
                            }
                        ]
