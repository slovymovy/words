                                                "sense_id": "f53fd8db-3d9d-345c-b871-8571a3f083b1",
                                                "text": "If anybody hurts my little brother, I will get upset."
                                            },
                                            {
                                                "example_id": "d3967160-fd68-4388-90fd-7491dbc28a81",
                                                "sense_id": "f53fd8db-3d9d-345c-b871-8571a3f083b1",
                                                "text": "This injection might hurt a little. Your arm will be hurting you for a while."
                                            }
