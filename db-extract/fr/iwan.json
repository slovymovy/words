                                        "entry_id": "7664fa1e-2cbf-3f88-9f0f-91124532c2f9",
                                        "glosses": [
                                            "Russe, Angehöriger der russischen oder historisch der sowjetischen Armee"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18eb0887-844f-43aa-a8ad-de272274cfe3",
                                                "sense_id": "43024b6c-1fbb-3a48-8904-67c62318f96b",
                                                "text": "„Wenn uns aber erst der Iwan dorthin zurückschlägt, dann ist es zu spät. Dann ist auch am Dnjepr nichts mehr zu halten.“"
                                            },
                                            {
                                                "example_id": "f725ebd0-13c6-4711-9672-533994b72b07",
                                                "sense_id": "43024b6c-1fbb-3a48-8904-67c62318f96b",
                                                "text": "„Aber ich traute dem Iwan nicht. Und ich wollte auch nicht beim Iwan bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18fb3226-dd7c-3379-a8c8-4a7115c61b97",
                                        "entry_id": "7664fa1e-2cbf-3f88-9f0f-91124532c2f9",
                                        "glosses": [
                                            "Ethnophaulismus, kein Plural, Gesamtheit aller Russen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f599cce-32d8-43eb-90e7-bfc0c4cdc880",
                                                "sense_id": "18fb3226-dd7c-3379-a8c8-4a7115c61b97",
                                                "text": "Der Iwan hat auch seine Vorzüge."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
