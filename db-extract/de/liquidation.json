                    {
                        "form_id": "7fed2a46-d795-4c24-b8ce-2176a65c3251",
                        "entry_id": "fb299b2b-905b-34b3-8e85-a8b22cb8c3b9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Liquidationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e80d7b37-38d6-3bd3-8461-945fa55f0e73",
                        "entry_id": "fb299b2b-905b-34b3-8e85-a8b22cb8c3b9",
                        "glosses": [
                            "Auflösung einer Handelsgesellschaft, eines Vereins oder einer Genossenschaft, wobei kein Grund für die Einleitung eines Konkurs- oder Vergleichsverfahrens vorliegt und bei der alle Vermögenswerte verkauft werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463a325f-c0d6-41e2-8e16-75072065b260",
                                "sense_id": "e80d7b37-38d6-3bd3-8461-945fa55f0e73",
                                "text": "Die Liquidation eines Unternehmens findet dann statt, wenn die Eigentümer mehrheitlich beschlossen haben, die Gesellschaft aufzulösen."
                            },
                            {
                                "example_id": "c3053cfb-73e8-41fe-81ab-0f82105033d0",
                                "sense_id": "e80d7b37-38d6-3bd3-8461-945fa55f0e73",
                                "text": "Die Liquidation, an deren Ende die Löschung der Gesellschaft im Handelsregister steht, setzt zunächst deren Auflösung voraus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0b84095c-65e7-3ad1-b1b8-ecf53fd4a13b",
                        "entry_id": "fb299b2b-905b-34b3-8e85-a8b22cb8c3b9",
                        "glosses": [
                            "Rechnung für Leistungen in freien Berufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc20cc36-4ce1-4cea-9619-9254e442ba54",
                                "sense_id": "0b84095c-65e7-3ad1-b1b8-ecf53fd4a13b",
                                "text": "Eine privatärztliche Liquidation ist im Rahmen einer Gebührenordnung geregelt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e6d511b5-5856-3603-9487-0df5ae7c9c89",
                        "entry_id": "fb299b2b-905b-34b3-8e85-a8b22cb8c3b9",
                        "glosses": [
                            "politisch oder ähnlich motivierter Mord, Auslöschung"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "0e5dcf9f-0087-4262-bd15-1778375c0412",
                                "sense_id": "e6d511b5-5856-3603-9487-0df5ae7c9c89",
                                "text": "Die Wehrmacht meldete die Liquidation mehrerer Partisanenkämpfer nach Berlin."
                            },
                            {
                                "example_id": "e2c52629-806f-47bc-9c82-2f2fa4e1b20d",
                                "sense_id": "e6d511b5-5856-3603-9487-0df5ae7c9c89",
                                "text": "„Das muß nun ein für allemal aufhören, dachte Käthe, daß ich jemandem von der Liquidation meiner Eltern erzähle.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2feb0d31-3a4a-4390-82a7-4603d310f6e3",
                        "source_entry_id": "fb299b2b-905b-34b3-8e85-a8b22cb8c3b9",
