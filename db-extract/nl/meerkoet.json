                                        "sense_id": "0083f092-f4d3-3feb-98ea-aab5172a9403",
                                        "entry_id": "e6c2b889-c84a-3103-b4b8-97ba2392e8d5",
                                        "glosses": [
                                            "schwarzer Wasservogel mit weißem Stirnfleck und Schnabel (Fulica atra)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4bf3be-f973-4e6d-885b-ecb3ca45c2bb",
                                                "sense_id": "0083f092-f4d3-3feb-98ea-aab5172a9403",
                                                "text": "„Wasserhühner verschiedener Art, besonders das Bläßhuhn, Schwäne und mancherlei andre Schwimmvögel belebten die tieferen Gewässer, während in den Sümpfen Reiher (besonders bei Freienwalde), Kraniche, Rohrdommeln, Störche und Kibitze in ungeheurer Zahl fischten und Jagd machten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93eed655-1974-4e92-aaec-20700dcfacf6",
                        "source_entry_id": "cc2fe383-f2d8-3dce-8f7a-59ef9ba7f870",
                        "source_sense_id": "8f63b871-b7ff-31a5-b5ad-66db8f3854dd",
                        "source_sense_description": "bepaald soort watervogel, Fulica atra",
                        "target_lang_word": "coot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bd2d83f-0705-3c6e-9e77-7a6c01f9b8c2",
                                        "entry_id": "2943de62-18e0-37aa-b59d-02566d0e2964",
                                        "glosses": [
                                            "Any of various aquatic birds of the genus Fulica that are mainly black with a prominent frontal shield on the forehead."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                        "entry_id": "2943de62-18e0-37aa-b59d-02566d0e2964",
                                        "glosses": [
                                            "A foolish or eccentric fellow"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8969c2c8-65ae-4ce6-9247-0ee410a3109f",
                                                "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                                "text": "A silly coot"
                                            },
                                            {
                                                "example_id": "0fd203a5-e163-45b4-92f0-d5976b549a6e",
                                                "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                                "text": "An old coot"
                                            },
                                            {
                                                "example_id": "db68f199-72a5-45ef-9ddc-3cc55500c5a3",
                                                "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                                "text": "A rich coot"
                                            },
                                            {
                                                "example_id": "b8a80f48-ca42-44c7-af86-6fb871208d7b",
                                                "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                                "text": "Once more he thought aloud. / \"Tom wouldn't lie to me, so it wasn't gin. Now, I wonder. I wonder if that old coot has got what they call 'delusions of grandeur'?\""
                                            },
                                            {
                                                "example_id": "f6d61b14-8622-4de9-b9cd-866e6c0bf572",
                                                "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                                "text": "Your clerks would come in and see you aswingin' and aswayin' there and one of them would say: \"Well, the old coot's hung himself!\""
                                            },
                                            {
                                                "example_id": "c9be61ae-c88a-404d-b504-2d50170e169f",
                                                "sense_id": "37ff2e82-977d-3d74-a320-2c89246c87d4",
                                                "text": "“You'll be able now to give it as your considered opinion that [Wilbert Cream] is as loony as a coot, Sir Roderick.” A pause ensued during which [the psychiatrist] appeared to be weighing this, possibly thinking back to coots he had met in the course of his professional career and trying to estimate their dippiness as compared with that of W. Cream."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
