                "senses": [
                    {
                        "sense_id": "00e9142a-a1c3-3e97-b74c-a28c29288fee",
                        "entry_id": "9969de25-8085-3b1d-bcbe-9d3798c7b22f",
                        "glosses": [
                            "to misstep"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "9ebf8bee-d75f-491b-8a90-7eb5af8a54d8",
                                "sense_id": "00e9142a-a1c3-3e97-b74c-a28c29288fee",
                                "text": "Om mezelf rond te kunnen bewegen, moest ik over flinke bergen afval heen stappen. Soms verstapte ik me en zakte ik er zo doorheen.",
                                "translation": "In order to move around, I had to step over large piles of rubbish. Sometimes I misstepped and sunk right through.",
