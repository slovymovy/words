{
    "word_family": [
        "representation",
        "representative",
        "misrepresent",
        "representational"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77fe9501-a5ba-3bf4-8977-0ca538edf0ce",
                    "sense_definition": "To serve as a sign, symbol, or embodiment of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "symbolism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fifty stars on the American flag <w>represent</w> the fifty states.",
                            "target_lang_translations": {
                                "ru": "Пятьдесят звезд на американском флаге <w>символизируют</w> пятьдесят штатов.",
                                "zh": "美国国旗上的五十颗星<w>象征</w>着五十个州。"
                            }
                        },
                        {
                            "text": "In this novel, the main character is meant to <w>represent</w> the struggle for freedom.",
                            "target_lang_translations": {
                                "ru": "В этом романе главный герой призван <w>олицетворять</w> борьбу за свободу.",
                                "zh": "在这部小说中，主角旨在<w>代表</w>对自由的追求。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "represent a change",
                        "represent a challenge",
                        "represent a threat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить знаком, символом или воплощением чего-либо.",
                        "zh": "作为某事物的标志、象征或体现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "символизировать",
                                "target_lang_sense_clarification": "быть символом"
                            },
                            {
                                "target_lang_word": "олицетворять",
                                "target_lang_sense_clarification": "быть воплощением"
                            },
                            {
                                "target_lang_word": "обозначать",
                                "target_lang_sense_clarification": "значить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象征",
                                "target_lang_sense_clarification": "作为符号或标志"
                            },
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "作为体现或缩影"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b1bda31-35b1-3e72-92bc-ff497083692c",
                    "sense_definition": "To act or speak officially for someone else or for a group of people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "agency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The union was established to <w>represent</w> the interests of all the workers.",
                            "target_lang_translations": {
                                "ru": "Профсоюз был создан, чтобы <w>представлять</w> интересы всех рабочих.",
                                "zh": "工会的成立是为了<w>代表</w>所有工人的利益。"
                            }
                        },
                        {
                            "text": "She was proud to <w>represent</w> her country in the Olympic Games.",
                            "target_lang_translations": {
                                "ru": "Она гордилась тем, что <w>представляла</w> свою страну на Олимпийских играх.",
                                "zh": "她为能<w>代表</w>国家参加奥运会而感到自豪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "represent a client",
                        "represent a country",
                        "represent the company"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать или говорить официально от имени кого-либо или группы людей.",
                        "zh": "正式地为某人或某群体行事或发言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "действовать от имени"
                            },
                            {
                                "target_lang_word": "выступать от имени",
                                "target_lang_sense_clarification": "говорить за кого-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "作为代理人行事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e3c5640-8dc2-3883-bd05-2803b5cbe286",
                    "sense_definition": "To constitute or make up a particular amount or part of a whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "constitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Women <w>represent</w> forty percent of the workforce in this industry.",
                            "target_lang_translations": {
                                "ru": "Женщины <w>составляют</w> сорок процентов рабочей силы в этой отрасли.",
                                "zh": "女性在这一行业中<w>占</w>劳动力的百分之四十。"
                            }
                        },
                        {
                            "text": "This new discovery <w>represents</w> a significant step forward for medical science.",
                            "target_lang_translations": {
                                "ru": "Это новое открытие <w>представляет собой</w> значительный шаг вперед для медицинской науки.",
                                "zh": "这一新发现<w>是</w>医学科学向前迈出的重要一步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "form",
                        "make up",
                        "compose"
                    ],
                    "common_phrases": [
                        "represent a share",
                        "represent a fraction",
                        "represent an increase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Составлять определенное количество или часть целого; являться чем-либо.",
                        "zh": "构成整体中的特定数量或部分；是某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "о количестве или части"
                            },
                            {
                                "target_lang_word": "представлять собой",
                                "target_lang_sense_clarification": "являться чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占",
                                "target_lang_sense_clarification": "关于比例或数量"
                            },
                            {
                                "target_lang_word": "是",
                                "target_lang_sense_clarification": "构成或等同于"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4be882e7-0702-3fd2-9050-6e8af5eb5eea",
                    "sense_definition": "To show or describe something or someone in a picture, sculpture, or other artistic work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "depiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painting <w>represents</w> a famous battle from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "Картина <w>изображает</w> знаменитую битву восемнадцатого века.",
                                "zh": "这幅画<w>描绘</w>了十八世纪的一场著名战役。"
                            }
                        },
                        {
                            "text": "In classical art, the king is often <w>represented</w> as a powerful lion.",
                            "target_lang_translations": {
                                "ru": "В классическом искусстве короля часто <w>изображают</w> в виде могучего льва.",
                                "zh": "在古典艺术中，国王常被<w>表现</w>为一头威猛的狮子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "represented in art",
                        "graphically represent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать или описывать что-либо или кого-либо на картине, в скульптуре или другом художественном произведении.",
                        "zh": "在绘画、雕塑或其他艺术作品中展示或描述某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "в искусстве"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "демонстрировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "描绘",
                                "target_lang_sense_clarification": "在艺术中表现"
                            },
                            {
                                "target_lang_word": "表现",
                                "target_lang_sense_clarification": "通过艺术形式呈现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2eb027a-3c60-3514-8e27-d572693805e0",
                    "sense_definition": "To describe something or someone in a particular way, often formally or with a specific intent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>represented</w> himself as an expert in the field to get the job.",
                            "target_lang_translations": {
                                "ru": "Он <w>представил</w> себя экспертом в этой области, чтобы получить работу.",
                                "zh": "为了得到这份工作，他把自己<w>描述</w>成该领域的专家。"
                            }
                        },
                        {
                            "text": "The situation was <w>represented</w> to us as being under control, which was not true.",
                            "target_lang_translations": {
                                "ru": "Ситуация была <w>представлена</w> нам как находящаяся под контролем, что было неправдой.",
                                "zh": "情况被<w>描述</w>为一切尽在掌控，但事实并非如此。"
                            }
                        }
                    ],
                    "antonyms": [
                        "misrepresent"
                    ],
                    "common_phrases": [
                        "represent oneself as"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывать что-либо или кого-либо определенным образом, часто официально или с определенным намерением.",
                        "zh": "以特定方式描述某人或某事，通常是正式的或带有特定意图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "описывать, подавать"
                            },
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "создавать видимость"
                            },
                            {
                                "target_lang_word": "изображать",
                                "target_lang_sense_clarification": "притворяться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "描述",
                                "target_lang_sense_clarification": "以某种方式呈现"
                            },
                            {
                                "target_lang_word": "声称",
                                "target_lang_sense_clarification": "自称或被描述为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}