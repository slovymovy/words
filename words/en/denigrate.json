    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97e61cf9-4269-3f69-90f9-7aa194ed5a70",
                    "sense_definition": "To treat as lacking value or importance; to belittle or disparage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have no right to <w>denigrate</w> people and things that you have no personal experience with."
                        },
                        {
                            "text": "It is unfair to <w>denigrate</w> their achievements simply because you dislike their methods."
                        }
                    ],
                    "synonyms": [
                        "belittle",
                        "disparage"
                    ],
                    "antonyms": [
                        "extol",
                        "praise"
                    ],
                    "common_phrases": [
                        "denigrate someone's efforts",
                        "denigrate someone's achievements"
                    ]
                },
                {
                    "sense_id": "ba6f178d-c116-320f-a027-1c0e290b9db8",
                    "sense_definition": "To criticize unfairly in order to damage someone's reputation; to defame or traduce.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposition party launched a campaign to <w>denigrate</w> the character of the prime minister."
                        },
                        {
                            "text": "Critics attempted to <w>denigrate</w> her reputation by spreading malicious rumors about her past."
                        }
                    ],
                    "synonyms": [
                        "defame",
                        "slander",
                        "traduce"
                    ],
                    "antonyms": [
                        "acclaim",
                        "laud"
                    ],
                    "common_phrases": [
                        "denigrate someone's character",
                        "denigrate someone's reputation"
                    ]
                },
                {
                    "sense_id": "3d38f7b1-41e8-311a-8717-337a966247df",
                    "sense_definition": "To physically make dark or black.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "blacken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat from the furnace began to <w>denigrate</w> the surface of the stone."
                        },
                        {
                            "text": "Heavy soot from the chimneys would quickly <w>denigrate</w> the freshly painted white walls."
                        }
                    ],
                    "synonyms": [
                        "blacken",
                        "darken"
                    ],
                    "antonyms": [
