                        "glosses": [
                            "pracownik zajmujący się zmywaniem naczyń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba8fcae-1a2e-4718-b1fc-8db22f6db7f0",
                                "sense_id": "1997f294-f773-36dd-b8d5-b38e312f12c4",
