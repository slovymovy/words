        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6559b9a6-2e02-3b70-83e9-d9ee1cccd5ec",
                    "sense_definition": "voltooid deelwoord van <w>tikken</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zachtjes op het raam <w>getikt</w> om mijn aandacht te trekken.",
                            "target_lang_translations": {
                                "en": "He <w>tapped</w> gently on the window to get my attention."
                            }
                        },
                        {
                            "text": "De klok heeft de hele nacht hoorbaar in de gang <w>getikt</w>.",
                            "target_lang_translations": {
                                "en": "The clock <w>ticked</w> audibly in the hallway all night long."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op het raam getikt",
                        "op de schouder getikt"
                    ],
                    "traits": [
                        {
