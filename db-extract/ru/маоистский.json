                                                "sense_id": "9e5bfbbe-5fe7-355a-bc0d-14d23dbc4a47",
                                                "text": "„Friedrichs Ausflug in eine maoistische Gruppierung wie die KPD/ML währte kaum zwei Wochen.“"
                                            },
                                            {
                                                "example_id": "70b90831-6a32-417c-b3cc-01066723b5c7",
                                                "sense_id": "9e5bfbbe-5fe7-355a-bc0d-14d23dbc4a47",
                                                "text": "„Dies wäre eine Propaganda der Tat nach maoistischem Muster gewesen, wo die Landverteilung das wichtigste Mittel war, die Bauern dauerhaft auf die Seite der Guerilla zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
