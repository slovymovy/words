                                "example_id": "68329b2b-0004-4125-9061-4565f9c9e460",
                                "sense_id": "317ad957-dad6-3903-9e46-060b3d4695b0",
                                "text": "And do you, Georgy, contrive to tell Penrhyn all the particulars of this drowning affair; for I remember the bare facts being mentioned at Lord Penrhyns, and he will tell them with effect, avoiding rhodomontade without omitting pathos."
                            },
                            {
                                "example_id": "a362cca1-af70-4ead-9c82-f78f07611c22",
                                "sense_id": "317ad957-dad6-3903-9e46-060b3d4695b0",
                                "text": "Not a glimpse can you get of the merits or defects of the performers: they are hidden in a profusion of barbarous epithets and wilful rhodomontade."
                            },
                            {
                                "example_id": "e1d49ec6-0b7e-4831-b898-945bbea97654",
                                "sense_id": "317ad957-dad6-3903-9e46-060b3d4695b0",
                                "text": "He addressed himself directly to his guest with a torrent of rhodomontade; and the young man, reduced to helpless silence and shy, nodded his head at intervals to show that he took an intelligent interest."
                            }
                        ]
                    }
