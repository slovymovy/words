                                        "glosses": [
                                            "To put forth ears in growing; to form ears, as grain does."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69f0d5d9-9ab2-4fd8-87e2-e66f851c3b67",
                                                "sense_id": "def3e0e8-15b4-3fc5-a7fa-955fba1b843b",
                                                "text": "This corn ears well."
