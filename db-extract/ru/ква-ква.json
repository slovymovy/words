                                    },
                                    {
                                        "sense_id": "b9543c4e-9b1b-3def-a6d0-c13e68d7a3a3",
                                        "entry_id": "24c60541-bdf5-3c74-a7d8-fa896f58dca4",
                                        "glosses": [
                                            "To kill someone or something."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd10f6c6-5a66-4331-a2f3-ea7ec9d66a69",
                                                "sense_id": "b9543c4e-9b1b-3def-a6d0-c13e68d7a3a3",
                                                "text": "If Wilton croaked the criminal he did a jolly good day's work, and there's an end of it."
                                            },
                                            {
                                                "example_id": "3723c753-2e4d-4382-8d97-f25f8f9f3f90",
                                                "sense_id": "b9543c4e-9b1b-3def-a6d0-c13e68d7a3a3",
                                                "text": "He'd seen my face, so I had to croak him."
                                            },
                                            {
                                                "example_id": "79725138-ea8d-4b1b-9c10-b3b2e43833b5",
                                                "sense_id": "b9543c4e-9b1b-3def-a6d0-c13e68d7a3a3",
                                                "text": "\"It was me. And I'm glad, damned glad, I didn't croak him. With this slick guy after me, it would be me for the chair.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c97e005-9010-35ab-81cf-a2deeee64458",
                                        "entry_id": "24c60541-bdf5-3c74-a7d8-fa896f58dca4",
                                        "glosses": [
                                            "To complain; especially, to grumble; to forebode evil; to utter complaints or forebodings habitually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf071f1-53ea-46ce-bee6-580e6310ea76",
                                                "sense_id": "2c97e005-9010-35ab-81cf-a2deeee64458",
                                                "text": "Marat […] croaks with such reasonableness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67460981-a7a3-391e-8fc6-9bdfc893b8ad",
                                        "entry_id": "24c60541-bdf5-3c74-a7d8-fa896f58dca4",
                                        "glosses": [
                                            "To abort the current program indicating a user or caller error."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
