    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f33a4755-9919-33df-bae1-4afbacbc5d8c",
                    "sense_definition": "One's mental faculties, sanity, or the ability to think clearly and remain calm, especially in a difficult situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise was so terrifying that it almost scared me out of my <w>wits</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум был настолько пугающим, что я чуть не лишился <w>рассудка</w> от страха."
                            }
                        },
                        {
                            "text": "Even in the middle of the crisis, she managed to keep her <w>wits</w> about her and lead the team to safety.",
                            "target_lang_translations": {
                                "ru": "Даже в разгар кризиса ей удалось сохранить <w>самообладание</w> и вывести команду в безопасное место."
                            }
                        }
                    ],
                    "synonyms": [
                        "sanity",
                        "reason",
                        "marbles"
                    ],
                    "common_phrases": [
                        "keep your wits",
                        "scared out of your wits",
                        "at your wits end"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умственные способности, рассудок или способность мыслить ясно и сохранять спокойствие, особенно в сложной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассудок",
                                "target_lang_sense_clarification": "способность здраво мыслить"
                            },
                            {
                                "target_lang_word": "ум",
                                "target_lang_sense_clarification": "способность соображать"
                            },
                            {
                                "target_lang_word": "самообладание",
                                "target_lang_sense_clarification": "способность сохранять спокойствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30e11180-e771-365f-a681-e3ae962c1611",
                    "sense_definition": "The natural ability to perceive, understand, or judge things; one's basic intelligence or senses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to live by his <w>wits</w> on the streets of the city for several months.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось несколько месяцев выживать на улицах города благодаря своей <w>смекалке</w>."
                            }
                        },
                        {
                            "text": "The detective used all his <w>wits</w> to solve the complex mystery before the suspect could escape.",
                            "target_lang_translations": {
                                "ru": "Детектив использовал весь свой <w>ум</w>, чтобы раскрыть сложную тайну до того, как подозреваемый успеет сбежать."
                            }
                        }
                    ],
                    "synonyms": [
                        "intelligence",
                        "shrewdness",
                        "acumen"
                    ],
                    "common_phrases": [
                        "live by your wits",
                        "sharpen your wits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Природная способность воспринимать, понимать или судить о вещах; базовая сообразительность или смекалка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смекалка",
                                "target_lang_sense_clarification": "сообразительность и находчивость"
                            },
                            {
                                "target_lang_word": "ум",
                                "target_lang_sense_clarification": "интеллектуальные способности"
                            },
                            {
                                "target_lang_word": "находчивость",
                                "target_lang_sense_clarification": "умение быстро находить выход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae493f6c-c850-3a41-a842-b61d3d5c8f08",
                    "sense_definition": "The plural form of <w>wit</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gathering was full of the great <w>wits</w> of the century, all sharing clever stories.",
                            "target_lang_translations": {
                                "ru": "Собрание было полно величайших <w>острословов</w> века, и каждый делился остроумными историями."
                            }
                        },
                        {
                            "text": "She was known for her sharp <w>wits</w> and her ability to make anyone laugh.",
                            "target_lang_translations": {
                                "ru": "Она была известна своим острым <w>остроумием</w> и способностью рассмешить любого."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число слова «wit» (остроумие); люди, обладающие острым умом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острословы",
                                "target_lang_sense_clarification": "люди, умеющие шутить"
                            },
                            {
                                "target_lang_word": "остроумие",
                                "target_lang_sense_clarification": "способность к тонким шуткам"
                            },
                            {
                                "target_lang_word": "умы",
                                "target_lang_sense_clarification": "выдающиеся интеллектуалы"
                            }
                        ]
                    }
                }
            ]
        }
