                "forms": [],
                "senses": [
                    {
                        "sense_id": "24eae5d4-2989-3c51-904d-c5255a3c48d0",
                        "entry_id": "9932aa78-705d-34d6-bbb8-d3e421f1ae6c",
                        "glosses": [
                            "zich ~: denken dat iets wat onmogelijk is toch waar is"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "6543e7c4-3fae-4064-8ba3-799020ff948c",
                                "sense_id": "24eae5d4-2989-3c51-904d-c5255a3c48d0",
                                "text": "Hij beeldde zich in dat hij een machtig man was."
                            },
                            {
                                "example_id": "b7cdffd6-cf87-4bdf-8aa0-f794e615431d",
                                "sense_id": "24eae5d4-2989-3c51-904d-c5255a3c48d0",
                                "text": "Dan had ik hem doodgeschoten. Die pompeuze, bloeddorstige.... soms beeld ik me in dat alle Engelsen één gemeenschappelijke keel zouden hebben en dat ik mijn vingers eromheen had liggen."
                            }
                        ]
                    }
                ],
