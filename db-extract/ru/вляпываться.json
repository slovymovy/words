                "senses": [
                    {
                        "sense_id": "d0d02391-155a-37eb-beab-66bc6473cf12",
                        "entry_id": "1acefd49-7ca1-35e3-8225-1215752f1e78",
                        "glosses": [
                            "прост. попадать, наступать во что-либо вязкое, пачкающее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f733f0-ca13-48d4-9ff5-6cf4ce16a34e",
                                "sense_id": "d0d02391-155a-37eb-beab-66bc6473cf12",
                                "text": "Он всплеснул руками и, босой, всклокоченный, вляпываясь пятками в куриный помёт, вывалился из избы."
                            }
                        ]
                    },
                    {
                        "sense_id": "63c97c69-1cef-39d6-b385-2d7598068fdd",
                        "entry_id": "1acefd49-7ca1-35e3-8225-1215752f1e78",
                        "glosses": [
                            "перен. прост. попадать в неприятное, затруднительное положение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b43bda3-7f5a-44bb-9f29-61b1961358db",
                                "sense_id": "63c97c69-1cef-39d6-b385-2d7598068fdd",
                                "text": "Второй раз из-за тебя вляпываюсь: то в трактире шпики проследили, то на засаду у старухи нарвался!"
                            }
                        ]
                    }
