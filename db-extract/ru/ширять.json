                        ],
                        "form": "ширя́вши"
                    },
                    {
                        "form_id": "764c4318-7d22-465d-9ffd-92db4fb8a1f4",
                        "entry_id": "6e25860d-4103-3d9d-aa7b-0658167c16a5",
