                        "glosses": [
                            "In an impressionistic manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd6e793-5c89-42b4-a7d3-b4480bed9318",
                                "sense_id": "5ee2348e-69d9-376c-9dcb-9f88543c041e",
                                "text": "I make no claim to understanding it, I treat it merely impressionistically."
                            },
                            {
                                "example_id": "4828e279-0ab4-4256-b214-06d3334dc1c0",
                                "sense_id": "5ee2348e-69d9-376c-9dcb-9f88543c041e",
                                "text": "Bertha's description of her as having flat red hair, a receding chin and long ear-rings was impressionistically accurate."
                            },
                            {
                                "example_id": "429c9eae-cccf-4894-b616-0075d2528162",
                                "sense_id": "5ee2348e-69d9-376c-9dcb-9f88543c041e",
                                "text": "Separation Sunday and The Sunset Tree both work because their story cycles are composed not with conventional conflict-and-resolution plot mechanics but of emotional snapshots that work together impressionistically."
                            }
                        ]
                    }
