                                                "sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
                                                "text": "I only had ten cents in my pocket, so I couldn't use the payphone to call a cab."
                                            },
                                            {
                                                "example_id": "5954bf04-671b-48c0-bc2a-9fca9e69dea9",
                                                "sense_id": "eb011784-f440-36ae-a4d1-e3993750a077",
                                                "text": "You called me from a payphone / They still got payphones / It costs a dollar a minute / To tell me you're getting sober"
                                            }
