            "senses": [
                {
                    "sense_id": "246781ff-7c0a-3755-8bec-6769b12eed9e",
                    "sense_definition": "Couler en arrière ou vers son point d'origine, en parlant des eaux ou d'un liquide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la crue, les eaux de la rivière ont lentement <w>reflué</w> vers leur lit."
                        },
                        {
                            "text": "À marée descendante, la vague ralentit et l'eau se met à <w>refluer</w> doucement vers le large."
                        }
                    ],
                    "synonyms": [
                        "recouler"
                    ],
                    "common_phrases": [
                        "faire refluer les eaux",
                        "refluer vers la mer"
                    ]
                },
                {
                    "sense_id": "ca6d8e5f-bd4e-3d8c-b3b1-fa641405ff4e",
                    "sense_definition": "Reculer ou se retirer en masse, en parlant d'une foule, d'un groupe ou de troupes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant l'avancée de la police, la foule a rapidement <w>reflué</w> vers les rues adjacentes."
                        },
                        {
                            "text": "Repoussés par la contre-attaque, les assaillants <w>refluèrent</w> en désordre vers leurs tranchées."
                        }
                    ],
                    "common_phrases": [
                        "faire refluer la foule",
                        "refluer vers la sortie"
                    ]
                }
            ]
        }
