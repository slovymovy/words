{
    "word_family": [
        "mingle",
        "comminglement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93710ea3-342a-3639-932c-3b46fb1d51f3",
                    "sense_definition": "To combine or mix different things together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was disbarred after he chose to <w>commingle</w> client funds with his own personal savings.",
                            "target_lang_translations": {
                                "ru": "Адвоката лишили статуса после того, как он решил <w>смешать</w> средства клиентов со своими личными сбережениями."
                            }
                        },
                        {
                            "text": "Her unique artistic style <w>commingles</w> classical painting techniques with modern digital art.",
                            "target_lang_translations": {
                                "ru": "Её уникальный художественный стиль <w>сочетает</w> классические техники живописи с современным цифровым искусством."
                            }
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "mix",
                        "merge",
                        "amalgamate"
                    ],
                    "antonyms": [
                        "separate",
                        "segregate",
                        "isolate"
                    ],
                    "common_phrases": [
                        "commingle funds",
                        "commingle assets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять или смешивать различные вещи или элементы вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "соединять разные вещи, средства, стили"
                            },
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "объединять в одно целое"
                            },
                            {
                                "target_lang_word": "совмещать",
                                "target_lang_sense_clarification": "сочетать различные элементы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c78e0872-a41b-37cd-be97-06a6e3183525",
                    "sense_definition": "To blend or become mixed with something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aromas of roasting garlic and fresh bread <w>commingle</w> pleasantly throughout the kitchen.",
                            "target_lang_translations": {
                                "ru": "Ароматы жареного чеснока и свежего хлеба приятно <w>смешиваются</w> по всей кухне."
                            }
                        },
                        {
                            "text": "Feelings of pride and sadness began to <w>commingle</w> as she watched her son pack for college.",
                            "target_lang_translations": {
                                "ru": "Чувства гордости и грусти начали <w>переплетаться</w>, когда она смотрела, как её сын собирает вещи в колледж."
                            }
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "intermingle",
                        "fuse",
                        "mingle"
                    ],
                    "antonyms": [
                        "separate"
                    ],
                    "common_phrases": [
                        "commingle with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сливаться воедино, смешиваться с чем-либо другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешиваться",
                                "target_lang_sense_clarification": "о запахах, чувствах, звуках"
                            },
                            {
                                "target_lang_word": "переплетаться",
                                "target_lang_sense_clarification": "тесно соединяться между собой"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "образовывать единое целое"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}