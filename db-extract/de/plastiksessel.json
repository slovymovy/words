                        "entry_id": "215ad61e-f1ce-3cae-86d9-0d415940c3f1",
                        "glosses": [
                            "aus Kunststoff (Plastik) hergestellter Sessel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3401e7d0-065f-477d-be21-6628268febe7",
                                "sense_id": "615ca26a-2c54-398d-81c8-44f48ddf546d",
                                "text": "„Harte Plastiksessel im Wartezimmer, Neonlicht und Desinfektionsmittelspender an den Wänden.“"
                            },
                            {
                                "example_id": "994fd765-499d-43e4-a8f8-8802565a55e0",
                                "sense_id": "615ca26a-2c54-398d-81c8-44f48ddf546d",
                                "text": "„In dem kleinen Plastiksessel in Block W 8 hat es das koreanische Kind schön bequem.“"
                            },
                            {
                                "example_id": "49edb22e-1703-4d18-ac62-cde6e5304645",
                                "sense_id": "615ca26a-2c54-398d-81c8-44f48ddf546d",
                                "text": "„Der Hof ist gemütlich eingerichtet im Sommer, mit Blumenstöcken, einem großen Gartentisch, einer Holzbank und Plastiksesseln und einem Sonnenschirm.“"
                            }
                        ],
