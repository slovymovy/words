                "senses": [
                    {
                        "sense_id": "eaaaff98-104d-3f46-9497-ab68827c22e9",
                        "entry_id": "b1f5e9f9-d507-3963-aa14-8846614bf692",
                        "glosses": [
                            "historisch: Die Rüstung eines Ritters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d8983ca-5075-4de2-b38d-7732bbbdaab7",
                                "sense_id": "eaaaff98-104d-3f46-9497-ab68827c22e9",
                                "text": "„Das Immunsystem eines Hundbesitzers ist wie eine Ritterrüstung, an der sich Bakterien und Viren die Köpfe einrennen.“"
                            },
                            {
                                "example_id": "e28740f1-5412-483d-b1bd-ac27538d73a8",
                                "sense_id": "eaaaff98-104d-3f46-9497-ab68827c22e9",
                                "text": "„Geradezu bewundernd blickt man auf die einsam über den heißen Sand krabbelnden Ameisen, deren silbrig glänzender Tarnüberzug aussieht wie eine winzige Ritterrüstung.“"
                            },
                            {
                                "example_id": "c4f3cd62-6f1e-4d75-afc9-3092754c8b00",
                                "sense_id": "eaaaff98-104d-3f46-9497-ab68827c22e9",
                                "text": "Zu einer Ritterrüstung gehören meistens Panzerhandschuhe, Beinschienen, Stahlstiefel, ein Helm sowie ein Brustpanzer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
