                        "glosses": [
                            "ontwerper van dans en balletvoorstellingen die verbonden is aan één bepaald dansgezelschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e64d108b-0f11-4c6a-a566-501f38ad4812",
                                "sense_id": "cb451c9d-b510-3e23-9588-2d67e17bce00",
                                "text": "Van Dantzig was huischoreograaf van het Nationaal Ballet en maakte meer dan vijftig balletten, die over de hele wereld zijn uitgevoerd. Zijn werk staat nog steeds bij vele buitenlandse gezelschappen op het repertoire. Bekende choreagrafieën van hem zijn 'Vier letzte Lieder' en 'Monument voor een gestorven jongen'."
                            },
                            {
                                "example_id": "6353e598-d22e-4ed2-8e0d-9e6e183bb3c7",
                                "sense_id": "cb451c9d-b510-3e23-9588-2d67e17bce00",
                                "text": "In die tijd stond het ballet onder leiding van huischoreograaf Ed Wubbe die regelmatig voor muzikale verrassingen zorgde door bijvoorbeeld zijn samenwerking met John Cale van de Velvet Underground en gastchoreografen als Krisztina de Châtel en Itzik Galili. Wubbe zette Scapino ook internationaal op de kaart."
                            }
                        ]
                    }
