                "senses": [
                    {
                        "sense_id": "07120b6b-239a-3964-8e0e-5f0221bf0c42",
                        "entry_id": "584809e7-b677-39ea-b255-a28422155606",
                        "glosses": [
                            "Spielkategorie mit der Zielsetzung, Aggressionen, Spannungen, Stress und Konflikte abzubauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6049bc-6c25-48ea-bdab-b491ba454b2a",
                                "sense_id": "07120b6b-239a-3964-8e0e-5f0221bf0c42",
                                "text": "„Entspannungsspiele sind Spiele die zur Verringerung von seelischer/geistiger und körperlicher Erregung oder Anspannung führen sollen.“"
                            },
                            {
                                "example_id": "a2502655-03d8-40bb-b755-d6252b9a81ee",
                                "sense_id": "07120b6b-239a-3964-8e0e-5f0221bf0c42",
                                "text": "„Je nach dem geistigen Anspruch und den physischen Möglichkeiten erfüllt das vorliegende Buch die Wünsche der Älteren durch sein Arsenal an ansprechenden Kontaktspielen, Ratespielen, Denkspielen, Entspannungsspielen, Gesellschaftsspielen oder Tanzspielen.“"
                            },
                            {
                                "example_id": "2100d949-11f5-420a-9900-9d90800040a8",
                                "sense_id": "07120b6b-239a-3964-8e0e-5f0221bf0c42",
                                "text": "„Von den Amerikanern, deren ‚arms-control’-Dispositiv von einer pragmatischen Konzeption zu einer dogmatischen Ideologie erstarrte, heftig in die neue Richtung gedrängt, spielten die Europäer das Entspannungsspiel mit, um nicht überspielt zu werden, und übertrafen bald ihre amerikanischen Lehrmeister.“"
                            },
                            {
                                "example_id": "fe611666-de8c-4684-92c6-8193932f84a0",
                                "sense_id": "07120b6b-239a-3964-8e0e-5f0221bf0c42",
                                "text": "„Beruhigungs- oder Entspannungsspiele bringen den Kindern nach einer aktionsreichen Geburtstagsparty Ruhe und Entspannung.“"
                            },
                            {
                                "example_id": "cdb9afd5-14b7-4c23-bf99-0d60e61c65d6",
                                "sense_id": "07120b6b-239a-3964-8e0e-5f0221bf0c42",
                                "text": "„Entspannungsspiele und –geschichten dienen neben dem aktuellen Wohlbefinden und einer langfristigen Entwicklung der Entspannungsfähigkeit häufig auch anderen Zielen wie der Anbahnung sozialer Fähigkeiten, einer Verbesserung der Körper-wahrnehmung und Sensibilisierung der Sinne sowie dem Aufbau eines positiven Selbstkonzepts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
