                "senses": [
                    {
                        "sense_id": "ced3d771-6021-3fe8-95b2-fe3ab2be0897",
                        "entry_id": "4ef48167-ae5a-3b9d-aa7f-6fd3added060",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft, an sich selbst oder an der Substanz, der von Zimt stammt; explizite Zuordnung eines natürlichen Geruchsstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "866cd871-76b6-411c-b315-815a272c92ff",
                                "sense_id": "ced3d771-6021-3fe8-95b2-fe3ab2be0897",
                                "text": "„Im Gebäude angekommen, steigt dem Lüner auch schon ein angenehmer Zimtgeruch in die Nase.“"
                            },
                            {
                                "example_id": "a295f395-034d-4adb-b7f8-b53bf887b9ad",
                                "sense_id": "ced3d771-6021-3fe8-95b2-fe3ab2be0897",
                                "text": "„Nach einer eingehenden Untersuchung und mehreren Versuchsreihen stellte sich heraus, dass eine Umwandlung des in den Zimtstangen enthaltenen Zimtaldehyds (C6H5-CH=CH-CHO), welches den typischen Zimtgeruch und -geschmack hervorruft, in das chemisch artverwandte Styrol (C6H5-CH=CH2) stattgefunden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
