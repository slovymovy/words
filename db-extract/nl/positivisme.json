        "nl-extract.jsonl": [
            {
                "entry_id": "60a06694-b040-3807-9497-53523017d018",
                "word": "positivisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a6526f8-e229-3cf6-8fcf-6fd513bccc64",
                        "entry_id": "60a06694-b040-3807-9497-53523017d018",
                        "glosses": [
                            "de opvatting dat alleen de empirische wetenschappen geldige kennis opleveren"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c6ebee36-7f73-333d-90ba-d2b8cfadea47",
                        "entry_id": "60a06694-b040-3807-9497-53523017d018",
                        "glosses": [
                            "een levensinstelling waarbij je ervan uitgaat dat alles goed komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4709728c-3ff4-4fff-b83d-2726e087bb16",
                                "sense_id": "c6ebee36-7f73-333d-90ba-d2b8cfadea47",
                                "text": "Het zijn vreemde tijden, waarin haat en extreem positivisme een soort titanenstrijd voeren. De NPO kiest een beetje partij door een maandlang dagelijks in gezamenlijke zendtijd het journaal Mijlpalen voor Parijs uit te zenden over de voettocht van milieuactivist Marjan Minnesma naar de klimaattop in de Franse hoofdstad. Ze is al bij de Biesbosch. Opmerkelijk, en niet zo klef als al die andere loop- en fietsevenementen voor een goed doel."
                            },
                            {
                                "example_id": "bbe1fb05-9c8f-40b3-bb7c-08aa8cb6ce78",
                                "sense_id": "c6ebee36-7f73-333d-90ba-d2b8cfadea47",
                                "text": ",,Op mijn linkerbovenarm heb ik een grote tatoeage van Anne Frank. Die heb ik anderhalf jaar geleden laten zetten, ik wilde het al heel lang. Waarom? Zij is iemand die zo veel positivisme heeft nagelaten."
                            },
                            {
                                "example_id": "94daafe0-5e0b-485b-aae9-a95ab1a6a6d0",
                                "sense_id": "c6ebee36-7f73-333d-90ba-d2b8cfadea47",
                                "text": "Als je met 3-1 achter staat en uiteindelijk alsnog gelijkspeelt, voelt dat als een overwinning. Dan heerst er positivisme en optimisme over het derde punt in uitduels dit seizoen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b468d6bf-7abf-4dac-86de-82690ce24b1b",
                        "source_entry_id": "60a06694-b040-3807-9497-53523017d018",
                        "source_sense_id": "9a6526f8-e229-3cf6-8fcf-6fd513bccc64",
                        "source_sense_description": "de opvatting dat alleen de empirische wetenschappen geldige kennis opleveren",
                        "target_lang_word": "positivism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positivism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8d3c4ea-0193-340e-abb5-9a583d37268c",
                                        "entry_id": "efbdc25d-96ba-36aa-bf74-5e321342ddc6",
                                        "glosses": [
                                            "A doctrine that states that the only authentic knowledge is scientific knowledge, and that such knowledge can only come from positive affirmation of theories through strict scientific method, refusing every form of metaphysics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e1a54a-9854-4144-9ae4-972c0bd82623",
                                                "sense_id": "b8d3c4ea-0193-340e-abb5-9a583d37268c",
                                                "text": "The goal of positivism is to construct an objective, empirical and systematic foundation for knowledge. Given the above five tenets, it follows that positivists would hold that the world is composed of ‘facts’, or ‘sense data’ (or ‘atoms’)."
                                            },
                                            {
                                                "example_id": "062aae18-c6a9-4252-9815-361debccaab8",
                                                "sense_id": "b8d3c4ea-0193-340e-abb5-9a583d37268c",
                                                "text": "History, and its literary expression, narrative, were not scientific, and so did not deserve the attention that true sciences did. Only science could yield positive knowledge—hence the passion for positivism, and the origin of the term."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489d102b-81e5-34aa-90db-deede540674f",
                                        "entry_id": "efbdc25d-96ba-36aa-bf74-5e321342ddc6",
                                        "glosses": [
                                            "A school of thought in jurisprudence in which the law is seen as separated from moral values; i.e. the law is posited by lawmakers (humans)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
