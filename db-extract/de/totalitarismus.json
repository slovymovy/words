                ],
                "senses": [
                    {
                        "sense_id": "3ab92c0f-34e3-3fe9-878e-88d2f58dce37",
                        "entry_id": "78878593-9570-32bc-b15e-f0ab6588d15e",
                        "glosses": [
                            "Unterdrückung jeglicher abweichender Ideen/Vorstellungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d95a256b-8337-407d-b82f-19e9906b5077",
                                "sense_id": "3ab92c0f-34e3-3fe9-878e-88d2f58dce37",
                                "text": "„Das ist es, was man unter Totalitarismus versteht.“"
                            },
                            {
                                "example_id": "7ac3daed-358f-4823-b2bf-31aaea3ba5b3",
                                "sense_id": "3ab92c0f-34e3-3fe9-878e-88d2f58dce37",
                                "text": "„In Prag wurde ich, was ich heute bin: als Journalist ein Bewahrer des literarischen Widerstands gegen die beiden Totalitarismen des vergangenen Jahrhunerts in Mitteleuropa.“"
                            },
                            {
                                "example_id": "05d4695a-84f6-40f2-bfe9-fb9204ac20ea",
                                "sense_id": "3ab92c0f-34e3-3fe9-878e-88d2f58dce37",
                                "text": "„Ob im Dienste der Freiheit oder des Totalitarismus, es ist unumstritten, dass das ! uns packt und schüttelt, damit wir endlich aufwachen und erkennen, dass etwas Bedeutendes passiert ist oder uns kurz bevorsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
