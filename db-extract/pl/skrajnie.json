        "pl-extract.jsonl": [
            {
                "entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                "word": "skrajnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                        "entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                        "glosses": [
                            "w sposób skrajny, wielce, bardzo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c46f60-dc7f-43fe-893d-68b19f23915c",
                                "sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                                "text": "Trudno jednak wskazać urządzenie spełniające skrajnie różne wymagania użytkowników"
                            },
                            {
                                "example_id": "5e32b174-dc1b-407b-9c6b-0b9fab7bce3e",
                                "sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                                "text": "Protestowała także – z odmiennych pobudek – niewielka grupa skrajnie lewicowa, która nie chciała, by żołnierz polski szedł w służbę kontrrewolucji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5090077d-d272-445e-bc7b-5a07a635ee32",
                        "source_entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                        "source_sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                        "target_lang_word": "extremely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                        "entry_id": "e5bf5b87-4cf8-366d-9216-d93d791e806f",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b11ba7-cbeb-4ade-a797-8de651f7a86b",
                                                "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                                "text": "The National Center for Health Statistics' latest data indicate that quintuplets are extremely rare, with 66 reported sets of five or more babies in 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fef089f-88cf-40a8-9070-9b1c40f38ffe",
                        "source_entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                        "source_sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                        "target_lang_word": "extrêmement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrêmement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "D’une manière extrême, au dernier degré, au dernier point, à la dernière limite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48543cca-7f7d-4e41-af03-76f3d2b9fee7",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Marseille, quand elle est belle, est extrêmement belle, mais, dans ses hideurs, elle va au paroxysme."
                                            },
                                            {
                                                "example_id": "d5dbd535-3a57-4288-91ab-e952c939f786",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Il vous aime extrêmement."
                                            },
                                            {
                                                "example_id": "d226ccdd-1a39-4ca7-8865-3610276101cc",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Il compose extrêmement vite."
                                            },
                                            {
                                                "example_id": "ddd51335-80c6-4a8f-b0d6-24022290337f",
                                                "sense_id": "71045a72-9799-3900-8f17-0c8fae388635",
                                                "text": "Peut-être dans la classe des gens supérieurs, est-il plus facile de trouver des gens extrêmement vertueux que des hommes extrêmement sages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "Très ; beaucoup ; fort."
                                        ],
                                        "tags": [
                                            "Souvent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94ae2b5-e267-407a-a710-6f7fc247cfbf",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "L’administration romaine était extrêmement dure pour tout homme qui lui semblait susceptible de troubler la tranquillité publique et surtout pour tout accusé qui bravait sa majesté."
                                            },
                                            {
                                                "example_id": "82722a3d-3753-464d-809f-7910d639958a",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Enfin les îles sorties des eaux (atolls) portent une flore extrêmement pauvre, venue par des apports lointains."
                                            },
                                            {
                                                "example_id": "45c49830-4b6b-4a4b-abe1-ed45c85e3b8d",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Il y a en ce lieu de certains animaux qui ont la forme du corps fort agréable et la peau extrêmement douce, souples, éveillées et plaisantes, fort aisées à apprivoiser et naturellement amies des hommes."
                                            },
                                            {
                                                "example_id": "2ef7a782-9ba6-4162-bc2a-ebfc2b23ac40",
                                                "sense_id": "86897a17-4462-3ecc-a5b4-280596375d8d",
                                                "text": "Je ne sais pas bien certainement qui vous êtes ; mais je suis assuré que la lettre que j’ai reçue ne peut être que d’un extrêmement honnête homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b823ce84-afba-34da-af9d-dc6a3a314578",
                                        "entry_id": "bec77ccd-7cf0-345d-9471-2083d2c2e27f",
                                        "glosses": [
                                            "Un nombre extrême de. Une quantité extrême de. Extrêmement beaucoup de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efd58365-fd17-41a8-bb93-ed43c04fe997",
                                                "sense_id": "b823ce84-afba-34da-af9d-dc6a3a314578",
                                                "text": "Je vais à Vannes, Monsieur ; j’y deviens amoureux d’une femme de condition, jolie veuve, assez jeune, ayant extrêmement d’esprit et beaucoup de goût pour les lettres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5acbadf-48ed-4ef1-8384-d38e375ed669",
                        "source_entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                        "source_sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                        "target_lang_word": "excessivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excessivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Avec excès, à un degré excessif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1446cec1-285f-4672-a3aa-78348edd0437",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Ma tante n’est plus si excessivement mal."
                                            },
                                            {
                                                "example_id": "fb624ef6-68d2-42e3-b395-b8364a2ec69c",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Puisqu’il en est question, je vous dirai tout net que cette liberté me déplaît excessivement."
                                            },
                                            {
                                                "example_id": "4bcb185d-9f65-4217-80d1-10f5bab19033",
                                                "sense_id": "ac6bce3b-13c7-38d4-a067-b1aa1e7b2430",
                                                "text": "Elle est devenue excessivement difficile pour sa chaussure, elle veut faire valoir son pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Extrêmement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1e2fd7-e34c-481b-bbf9-fbde01a18be4",
                                                "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                                "text": "On fabrique actuellement des tubes capillaires en verre excessivement fins. Ceux-ci, étirés par des ouvriers spéciaux, ont d’ordinaire une ouverture de deux dixièmes de millimètre."
                                            },
                                            {
                                                "example_id": "c559f0b3-fb2d-4d06-900c-7c684c9e8b87",
                                                "sense_id": "03cdfa1f-f829-366b-b96a-82e0c63aef88",
                                                "text": "Pendant la première semaine, la brise fut très légère et excessivement variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00988ee2-94fb-34ad-abb6-48b44d068273",
                                        "entry_id": "207977c7-7bc3-3c48-8617-fe8351fdfb30",
                                        "glosses": [
                                            "Un nombre excessif de, une quantité excessive de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db215b9a-32fd-4f3b-b52f-d4f7a24f4a2b",
                                                "sense_id": "00988ee2-94fb-34ad-abb6-48b44d068273",
                                                "text": "Face à des besoins d’argent pour répondre à la demande, les autorités monétaires ont créé excessivement de monnaie, entraînant un déséquilibre de la balance des paiements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7711de8-a84e-4f3d-bf86-08bb346f0fb0",
                        "source_entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                        "source_sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
                        "target_lang_word": "vachement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vachement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6256c1-d6c3-3e32-a955-6e0d31031ee3",
                                        "entry_id": "7abe8ab5-c59f-3eea-b78f-22f99ea06c34",
                                        "glosses": [
                                            "D’une manière vache, méchante."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f6cca96-88c2-41f5-9248-23f0fe8633dd",
                                                "sense_id": "bf6256c1-d6c3-3e32-a955-6e0d31031ee3",
                                                "text": "Pierre s’approcha de son frangin et, vachement, à plusieurs reprises, le gifla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bf9ee20-ce1a-3cf8-af26-d8a3922e435d",
                                        "entry_id": "7abe8ab5-c59f-3eea-b78f-22f99ea06c34",
                                        "glosses": [
                                            "Extrêmement ; drôlement ; très."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4a4789b-e33c-4488-8292-582f2afef0ff",
                                                "sense_id": "6bf9ee20-ce1a-3cf8-af26-d8a3922e435d",
                                                "text": "Membre du directoire de la BCE, la Banque centrale européenne, il était de passage à Paris (« Le Parisien », 3/4), invité par un organisme vachement sérieux, le Club de gestion financière d’associés en finance."
                                            },
                                            {
                                                "example_id": "14a0fd28-b90a-43f4-84c7-6193085f97c2",
                                                "sense_id": "6bf9ee20-ce1a-3cf8-af26-d8a3922e435d",
                                                "text": "Hé, dis-donc ! c’est normal que ça ralentisse comme ça quand tu passes la quatrième ?\n— Ben ouais, ça fait ça sur toutes les dianes.\n— La deux-chevaux de mon beauf, elle a vachement plus la patate.\n— Ouais… mais ton beauf, c’est pas pareil."
                                            },
                                            {
                                                "example_id": "94d2a80f-f638-4f8c-80f9-24075a6d4742",
                                                "sense_id": "6bf9ee20-ce1a-3cf8-af26-d8a3922e435d",
                                                "text": "Les vieux qui entendaient «vachement», quand ce mot est apparu, disaient que ça n’avait aucun sens ! Et c’est vrai, quand on y pense. Qu’est-ce que les vaches ont à faire là-dedans ? Aujourd’hui, les jeunes utilisent «trop» ou «de ouf» à la place de «vachement»."
                                            },
                                            {
                                                "example_id": "ab34596e-070c-4f2a-875a-a9f08c3a277c",
                                                "sense_id": "6bf9ee20-ce1a-3cf8-af26-d8a3922e435d",
                                                "text": "Reprends ta vie en main. - Oui, m'expulser va vachement m'y aider."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5bcc821-f1e8-3c62-a623-d6dad4ba9f99",
                                        "entry_id": "7abe8ab5-c59f-3eea-b78f-22f99ea06c34",
                                        "glosses": [
                                            "Beaucoup de."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256b5569-ed84-4588-a6cf-329f225347f4",
                                                "sense_id": "e5bcc821-f1e8-3c62-a623-d6dad4ba9f99",
                                                "text": "N’empêche qu’il a dépensé vachement d’argent pour installer tout ça."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80ea6512-8777-4377-8865-1537224f37ee",
                        "source_entry_id": "6b256806-c131-3a3c-8296-7e1eb08b2627",
                        "source_sense_id": "9082ae1d-a6ef-3938-9a4d-79683e32918a",
