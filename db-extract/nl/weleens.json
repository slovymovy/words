        "nl-extract.jsonl": [
            {
                "entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                "word": "weleens",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee2d340d-ed0c-3476-aae5-42a44363de21",
                        "entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                        "glosses": [
                            "drukt een lage frequentie uit"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "70205e9d-64a5-3e88-be63-69d218d9777b",
                        "entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                        "glosses": [
                            "drukt een lage frequentie uit",
                            "een enkele keer (maar vaker is niet uitgesloten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1cdca1-7004-41f1-a0e4-154389857ed0",
                                "sense_id": "70205e9d-64a5-3e88-be63-69d218d9777b",
                                "text": "Zij had als kind weleens een konijn gehad."
                            },
                            {
                                "example_id": "343e6189-7c74-4ee3-9399-8378863eea7a",
                                "sense_id": "70205e9d-64a5-3e88-be63-69d218d9777b",
                                "text": "Als je maar genoeg loten koopt, zul je weleens de hoofdprijs winnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fa38f63-1f5c-3399-a938-09f7361e43ae",
                        "entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                        "glosses": [
                            "drukt een lage frequentie uit",
                            "minstens één keer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b577872-cd43-4f6c-a888-f4a029f5055f",
                                "sense_id": "5fa38f63-1f5c-3399-a938-09f7361e43ae",
                                "text": "De meeste Nederlanders zijn weleens in Amsterdam geweest."
                            },
                            {
                                "example_id": "04a0a29e-ca39-4b99-a7f7-70a077c01a81",
                                "sense_id": "5fa38f63-1f5c-3399-a938-09f7361e43ae",
                                "text": "Nu ik in Deventer ben, wil ik de Deventer koek weleens proberen."
                            },
                            {
                                "example_id": "ddf20e3b-24ff-495c-9693-02e77ceed34c",
                                "sense_id": "5fa38f63-1f5c-3399-a938-09f7361e43ae",
                                "text": "Ik zou het ooit weleens proberen en een afgelegen plek zoeken om me terug te trekken."
                            }
                        ]
                    },
                    {
                        "sense_id": "09d0a801-b1ee-30de-b780-53e468f1f57d",
                        "entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                        "glosses": [
                            "drukt een lage frequentie uit",
                            "meermaals, maar niet heel vaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acdbacd-ebcc-4ca4-9105-d7473af247fb",
                                "sense_id": "09d0a801-b1ee-30de-b780-53e468f1f57d",
                                "text": "Op zondag ging hij weleens wandelen met zijn vrouw."
                            },
                            {
                                "example_id": "eaaadad2-97f3-4df2-926b-dd7ef6d6f923",
                                "sense_id": "09d0a801-b1ee-30de-b780-53e468f1f57d",
                                "text": "Ik moet weleens terugdenken aan mijn schooltijd."
                            },
                            {
                                "example_id": "bb16124a-aa04-4d72-a33b-6198c7638879",
                                "sense_id": "09d0a801-b1ee-30de-b780-53e468f1f57d",
                                "text": "Sneeuw komt in het Midden-Oosten weleens voor, maar dat is wel bijzonder."
                            }
                        ]
                    },
                    {
                        "sense_id": "6068afad-690b-346e-8942-5fa782a9d4fb",
                        "entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                        "glosses": [
                            "als versterking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d351048c-c209-4bf5-9a1e-e0d23b828b91",
                                "sense_id": "6068afad-690b-346e-8942-5fa782a9d4fb",
                                "text": "Kun jij op je handen lopen? Dat wil ik weleens zien."
                            },
                            {
                                "example_id": "099e5893-ed38-4b0e-9f4f-b5c4aac6bfb7",
                                "sense_id": "6068afad-690b-346e-8942-5fa782a9d4fb",
                                "text": "Ga je niet mee? Dat had je weleens eerder mogen zeggen."
                            },
                            {
                                "example_id": "0672842c-3d0b-4644-940b-b616fe059ecf",
                                "sense_id": "6068afad-690b-346e-8942-5fa782a9d4fb",
                                "text": "Hij kan er weleens spijt van krijgen dat hij in Amsterdam is gaan wonen."
                            },
                            {
                                "example_id": "e202c948-e0a6-4b86-bae7-d301581f0e67",
                                "sense_id": "6068afad-690b-346e-8942-5fa782a9d4fb",
                                "text": "Tot mijn verbazing wist ik deze zes weken durende tocht zonder noemenswaardige problemen te voltooien, waardoor ik voor het eerst echt begon te geloven dat mijn ‘American Dream’ weleens in vervulling zou kunnen gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a7e980b-3081-43f9-9da8-19f66fa70835",
                        "source_entry_id": "569b6a79-08fd-365a-b318-2c18799060ae",
                        "target_lang_word": "déjà",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déjà",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                        "entry_id": "b15b79f5-da7b-3b01-a881-3de87ec12ac1",
                                        "glosses": [
                                            "Indique un changement d’état ou une atteinte du critère jusqu’à présent ou jusqu’alors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22d98a00-a40c-42c4-b9b3-3d1a101521c5",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "Le kébab doit être servi brûlant. Quand la bouche peut le tolérer, il est déjà trop froid."
                                            },
                                            {
                                                "example_id": "f646c8a6-26f6-4f1b-a220-064ae59dac43",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "– Comment, vous voilà, cher ami ? Déjà ! fit le directeur général avec un bon sourire.\nDéjà ! C'est presque toujours par cette irritante formule que sont accueillis les gens qui redoutent d'avoir indûment prolongé leur absence."
                                            },
                                            {
                                                "example_id": "384c0d08-e3f4-4463-a538-79793e9c33b3",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "Le courrier est-il déjà arrivé ?"
                                            },
                                            {
                                                "example_id": "cc0b01e9-50b1-4d16-8905-9610258c772e",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "Il y a déjà trois heures que nous marchons."
                                            },
                                            {
                                                "example_id": "ac597171-0575-474a-b56b-31cf6c36cdd2",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "Cet enfant marche déjà."
                                            },
                                            {
                                                "example_id": "602176d6-5bac-4f27-b490-fcfe8d981043",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "Déjà le soleil était sur l’horizon."
                                            },
                                            {
                                                "example_id": "a5d9431f-22d8-49da-9330-7550efa6628e",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "La place était déjà prise quand il arriva."
                                            },
                                            {
                                                "example_id": "ac00a082-668e-40f0-a81d-0f73d1f73817",
                                                "sense_id": "deffa3ef-8ecd-3281-a668-38cc3e641ff9",
                                                "text": "Ça fait déjà cinq ans que les deux se connaissent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce04abc1-156f-3607-b761-1a123ebc3312",
                                        "entry_id": "b15b79f5-da7b-3b01-a881-3de87ec12ac1",
                                        "glosses": [
                                            "Auparavant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc620a4-4f31-4187-9a88-eed293e98638",
                                                "sense_id": "ce04abc1-156f-3607-b761-1a123ebc3312",
                                                "text": "Je suis déjà allé chez vous pour vous voir. — Je vous ai déjà dit ce que je pensais."
                                            },
                                            {
                                                "example_id": "ca1c5fd3-edc8-463c-ac21-49f8140af557",
                                                "sense_id": "ce04abc1-156f-3607-b761-1a123ebc3312",
                                                "text": "Jacque était immobile, et regardait Marie.\nJe ne sais ce qu’avait cette femme endormie\nD’étrange dans ses traits, de grand, de déjà vu."
                                            },
                                            {
                                                "example_id": "e2e9bcd7-757b-448d-b6bc-fd52444d4442",
                                                "sense_id": "ce04abc1-156f-3607-b761-1a123ebc3312",
                                                "text": "— Bon, d'accord, tu veux être cascadeuse dans les films d'action, super. Mais en réalité tu es déjà bien partie pour le devenir, Dove, vu qu'en gros tu es déjà une cascadeuse, alors que pour moi c'est pas pareil, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ee39efb-e364-387a-a1a0-b738e00d1ad0",
                                        "entry_id": "b15b79f5-da7b-3b01-a881-3de87ec12ac1",
                                        "glosses": [
                                            "Utilisé quand on demande une information qu’on connaissait mais qu’on a oubliée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35ab00c3-0a9b-48bd-a059-a074b7f40f92",
                                                "sense_id": "1ee39efb-e364-387a-a1a0-b738e00d1ad0",
                                                "text": "Quel est son nom déjà ? Spliugry ?… Spadugry ?…"
                                            },
                                            {
                                                "example_id": "4091151d-bffe-4275-b87c-cda9b57f76d1",
                                                "sense_id": "1ee39efb-e364-387a-a1a0-b738e00d1ad0",
                                                "text": "Que disions-nous, déjà ? La mairie de Paris, c'est ça. Et bien, la mairie de Paris se contenta de m'indiquer les coordonnées d'une société de dépigeonnage et me raccrocha au nez sans autre forme de procès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
