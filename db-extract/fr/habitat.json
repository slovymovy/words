        "fr-extract.jsonl": [
            {
                "entry_id": "0a2d1e92-ece3-3fe3-b15c-d7542ae9c009",
                "word": "habitat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d35ebffa-3fd4-485e-b1c0-01c80c59996e",
                        "entry_id": "0a2d1e92-ece3-3fe3-b15c-d7542ae9c009",
                        "tags": [
                            "plural"
                        ],
                        "form": "habitats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c52d47e-4fc5-3822-be95-fe43393174de",
                        "entry_id": "0a2d1e92-ece3-3fe3-b15c-d7542ae9c009",
                        "glosses": [
                            "Milieu naturel offrant à une espèce vivante (animale, végétale, fongique, etc.) les conditions nécessaires à sa survie, son développement et sa reproduction."
                        ],
                        "tags": [
                            "Sciences de l’environnement"
                        ],
                        "examples": [
                            {
                                "example_id": "8ac70e7f-d8ae-423d-874e-b348396b93cb",
                                "sense_id": "8c52d47e-4fc5-3822-be95-fe43393174de",
                                "text": "Sur certaines essences autres que le Chêne, les chandelles constituent un habitat vital pour des espèces rares : comme Dicerca berolinensis ou Isorhipis marmottani."
                            },
                            {
                                "example_id": "b78c9d43-1a4c-4322-b582-31d97862d1e6",
                                "sense_id": "8c52d47e-4fc5-3822-be95-fe43393174de",
                                "text": "En dehors des buttes de Hautil et du marais de Buthiers, où ses habitats ont été irrémédiablement transformés, le piment royal se maintient relativement bien dans le massif de Rambouillet, son fief historique, où son abondance locale est parfois traduite dans la toponymie (pimentière)."
                            },
                            {
                                "example_id": "6fd6f736-8f55-4940-9dc7-a2144ab85937",
                                "sense_id": "8c52d47e-4fc5-3822-be95-fe43393174de",
                                "text": "Cette destruction des habitats et des vivants n’est pas un accident, ou un simple dommage collatéral. Il s’agit d’une administration méthodique de la mort, scientifique, au coût faramineux – qu’on peut nommer « nécropolitique » et qui est le vrai nom du « développement »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9ac1b3f-0da6-3996-9999-6052d63361e4",
                        "entry_id": "0a2d1e92-ece3-3fe3-b15c-d7542ae9c009",
                        "glosses": [
                            "Ensemble des habitations ; mode ou style d’habitation caractéristique d’une région, d’un groupe social ou d’une époque."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "25f25fed-ca34-4473-b177-81946ae5bd4a",
                                "sense_id": "a9ac1b3f-0da6-3996-9999-6052d63361e4",
                                "text": "Les types de maisons qu'on verra décrits plus loin nous ont été légués par le XIXᵉ siècle, et même par le XVIIIᵉ. Mais il serait faux de croire à l’immuabilité de l’habitat à travers les âges pour un pays donné."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd2eef23-dfb0-3501-b1a4-19fd09632080",
                        "entry_id": "0a2d1e92-ece3-3fe3-b15c-d7542ae9c009",
                        "glosses": [
                            "Demeure d’une personne, considérée comme lieu de vie auquel elle est attachée."
                        ],
                        "tags": [
                            "broadly",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f1306d40-33e9-4db1-aa8d-0103bbdf68d1",
                                "sense_id": "cd2eef23-dfb0-3501-b1a4-19fd09632080",
                                "text": "Impossible de rencontrer un homme mieux assorti à son habitat que ne l’était ce petit campagnard à son vieux château. L’un et l’autre sortaient bien du même sol ; ils étaient presque de la même couleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fcac219-638a-46bd-b2f3-599cae474b4f",
                        "source_entry_id": "0a2d1e92-ece3-3fe3-b15c-d7542ae9c009",
                        "target_lang_word": "Lebensraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15562c61-e1c8-3cfb-8cdc-9b0f974e21a0",
                                        "entry_id": "7bcbd7ca-c808-3258-abcd-a0e19922406f",
                                        "glosses": [
                                            "ein Raum, in dem Leben und die Entfaltung desselben möglich ist und wirklich wird"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf722de-2856-4c52-99d6-b2a959f96fc2",
                                                "sense_id": "15562c61-e1c8-3cfb-8cdc-9b0f974e21a0",
                                                "text": "In der Stadt ist der Lebensraum beschränkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                        "entry_id": "7bcbd7ca-c808-3258-abcd-a0e19922406f",
                                        "glosses": [
                                            "der charakteristische Wohnort bzw. Standort einer Tier- oder Pflanzenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e8f57f-e59e-4bfa-8ecb-ee9509e1b5c4",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "Der Lebensraum des Menschen ist die Kultur."
                                            },
                                            {
                                                "example_id": "eff6c5c7-c2bd-470d-9fec-ec7221cfb664",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Im Oberen Mittelrheintal wurden durch den wirtschaftenden Menschen neben den von Natur aus offenen Felsbiotopen neue, durch Rodung und Beweidung ebenfalls offene Lebensräume geschaffen, in denen sich eine Wärme liebende, europaweit außergewöhnliche Artenvielfalt entwickelt hat.“"
                                            },
                                            {
                                                "example_id": "6cdb5ddd-8649-4cc4-99d3-7f5a1437bbf4",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Leider beschränkt sich der Lebensraum des Nilkrokodils, wie sein Name vielleicht vermuten lässt, nicht auf den Nil.“"
                                            },
                                            {
                                                "example_id": "fe10d1b6-6d23-4017-aff4-31166a859cae",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Trotzdem wurde der Wald zum Lebensraum von Vögeln wie Amsel, Rotdrossel und Türkentaube, die auf den Färöern selten sind.“"
                                            },
                                            {
                                                "example_id": "ee277f89-ca94-42c8-bc29-6ba5aa598b2f",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Moore sind wertvolle Lebensräume für seltene Tiere und Pflanzen und speichern viel ⁠CO2⁠.“"
                                            },
                                            {
                                                "example_id": "cfed552a-decc-4ab7-8bd1-081991cbc7c0",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„»Seegraswiesen dienen vielen Meeresbewohnern als Lebensraum. So können sich Muscheln, Seesterne und Krebse dort verstecken. Viele Fische ziehen dort ihren Nachwuchs auf.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6413a0d-fd3a-3da4-9696-bc1dbdc92305",
                                        "entry_id": "7bcbd7ca-c808-3258-abcd-a0e19922406f",
                                        "glosses": [
                                            "der Wohnort von Menschen bzw. Völkern; der geopolitisch umgedeutete Begriff Lebensraum diente vor allem in der ersten Hälfte des 20. Jahrhunderts in Anlehnung an Friedrich Ratzels Werk \\\"Der Lebensraum\\\" (1901) zur Begründung von Gebietsforderungen. Die Gedanken Ratzels wurden von dem Geografen Karl Haushofer, der persönliche, über Rudolf Heß vermittelte Kontakte zu Adolf Hitler besaß, weiterentwickelt und von Hitler rezipiert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0607e2-892b-47d4-9cdb-7aa92ed52521",
                                                "sense_id": "c6413a0d-fd3a-3da4-9696-bc1dbdc92305",
                                                "text": "Friedrich Ratzel beschrieb die Geschichte der Menschheit als einen permanenten Kampf um Lebensraum."
                                            },
                                            {
                                                "example_id": "2f6449af-88ca-4c7a-95ea-716106847b57",
                                                "sense_id": "c6413a0d-fd3a-3da4-9696-bc1dbdc92305",
                                                "text": "„Ich sollte sie einfach abschießen – wie ihr Mann, der wahrscheinlich beim SD ist, russische Kulaken abschießt, um seinem Führer diesen berüchigten Lebensraum zu erobern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbec995b-e990-4368-b4c3-fbbd8a04d433",
