                        "entry_id": "6eeda602-3a00-321c-bfad-e9ee0d8e0827",
                        "glosses": [
                            "to read (repeatedly or frequently); iterative of чита́ть (čitátʹ)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "82aa97ff-0328-4d6c-ade4-e1be5d064b38",
                                "sense_id": "34d1308d-5027-3e66-ac42-cf7f7b130644",
                                "text": "Когда́-то я чи́тывал э́ти кни́ги.",
                                "translation": "I used to read these books.",
                                "english": "I used to read these books."
                            },
                            {
                                "example_id": "fa8f1dd0-9a0e-48be-ae61-d859cde2cbea",
                                "sense_id": "34d1308d-5027-3e66-ac42-cf7f7b130644",
                                "text": "Я о́троду ничего́ не чи́тывал, сестри́ца! Бог меня́ изба́вил э́той ску́ки.",
                                "translation": "Denis Fonvizin",
                                "english": "Denis Fonvizin"
                            }
                        ]
                    }
