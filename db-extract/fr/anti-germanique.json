                    {
                        "sense_id": "8ae44323-ef04-32a0-b9a7-16014715d94c",
                        "entry_id": "59fb478c-efb0-32f0-88ba-c765ca0bfbba",
                        "glosses": [
                            "Qui s’oppose aux Allemands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e956100-f762-4059-b6a8-7ab2dc79986d",
                                "sense_id": "8ae44323-ef04-32a0-b9a7-16014715d94c",
                                "text": "Partout, l’idée anti-germanique prend corps, et l’esprit slave, si longuement tenu sous séquestre, affirme sa vitalité."
                            },
                            {
                                "example_id": "4c236782-014f-42cd-b596-ba05c921da4a",
                                "sense_id": "8ae44323-ef04-32a0-b9a7-16014715d94c",
                                "text": "Finalement, ils défendent l’idée de l’inexistence d’un parti anti-germanique, vu qu’il n’existait pas non plus de parti pro-germanique."
                            },
                            {
                                "example_id": "1b7959e1-de6c-4183-9992-3f53970e24b7",
                                "sense_id": "8ae44323-ef04-32a0-b9a7-16014715d94c",
                                "text": "La création de cette ligue était la réplique au Portugal des ligues anti-germaniques créées en France et vraisemblablement proches des forces politiques comme l’Action Française."
                            }
                        ]
                    }
