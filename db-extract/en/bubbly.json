                                "sense_id": "bea17108-22d6-3adf-800b-7f47dba2f034",
                                "text": "The architecture of the conservatory was bubbly."
                            }
                        ]
                    },
                    {
                        "sense_id": "a862b778-789b-3a6d-b10b-7ce57c7da9b4",
                        "entry_id": "8235d3ca-ee30-3a0d-8809-4a694dfeee9f",
                        "glosses": [
                            "Having the characteristics of economic bubbles."
                        ],
                        "tags": [],
                        "examples": [
                            {
