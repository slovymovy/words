                    },
                    {
                        "form_id": "74b36514-04a7-40c8-91d2-356cca3dfb3e",
                        "entry_id": "5b38a0ba-6500-3271-b0ef-5bcadd12f2db",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Grabhügel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
                        "entry_id": "5b38a0ba-6500-3271-b0ef-5bcadd12f2db",
                        "glosses": [
                            "Erdaufschüttung über einer Grabstelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07770ce7-e64c-4e31-a29b-a3a964a375d9",
                                "sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
                                "text": "„So finden wir kleine Grabhügel von etwa 1 bis 2 m Höhe und einem Durchmesser von 10 bis 20 m, aber auch sogenannte Fürstengräber mit mehr als 100 m Durchmesser und einer Höhe von über 10 m.“"
                            },
                            {
                                "example_id": "ee4e8e3c-0bc3-48d5-8a1d-888f9fa1a710",
                                "sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
                                "text": "„Er wollte einen kleineren machen, der besser zum Grabhügel gepaßt hätte, aber selbst für Billy konnte er keine besondere Form herstellen und mußte die normale benutzen.“"
                            },
                            {
                                "example_id": "84365414-da11-49dc-bfbb-78b5aef1974a",
                                "sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
                                "text": "„Dort grub 1913 der Ortspfarrer Rudolf Herold ein Grabhügelfeld aus, und vor einem der größten Grabhügel aus der Zeit von 800 bis 500 vor Christus entdeckte er ein rechteckiges, mit hochkant gestellten Steinplatten umzäuntes Steinpflaster mit fünf Menhiren oder Stelen.“"
                            },
                            {
                                "example_id": "348b02f1-a2d7-4817-a196-73364cae3235",
                                "sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
                                "text": "„Der kugelförmige Grabhügel sei einst knapp vier Meter hoch gewesen, inzwischen aber nur noch zwei, vermerkte Jefferson.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e876bdb9-205c-45ce-8bee-b1677cefb15e",
                        "source_entry_id": "5b38a0ba-6500-3271-b0ef-5bcadd12f2db",
                        "source_sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
                        "source_sense_description": "Erdaufschüttung über einer Grabstelle",
                        "target_lang_word": "tumulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                        "entry_id": "a5015688-2b6f-3cab-87c9-5ddb78e24830",
                                        "glosses": [
                                            "A mound of earth, especially one placed over a prehistoric tomb; a barrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6714367-1008-4295-b7f9-3f26c5e71c95",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "They planted the cannon on the tumuli, sole elevations in this level country, and formed themselves into column and hollow square."
                                            },
                                            {
                                                "example_id": "de10fb13-0132-45cc-95fe-0cebb9279147",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "Near Smeinogorsk an octagonal tumulus has been found containing the corpse of a horse near a rectangular one with a human corpse, both within stone circles."
                                            },
                                            {
                                                "example_id": "6f94b876-29c9-427b-845d-0875d9a022cd",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "The delicate white body will be covered to-day,\nThe tumulus be reared, the green sod give way:\nAnd there, oh Cynvarch, thy son they will lay."
                                            },
                                            {
                                                "example_id": "4422d69b-30c3-45d3-beaf-8b8a75fd742a",
                                                "sense_id": "2895deb1-ada7-3a4e-a374-7c1400104fab",
                                                "text": "The tumulus is one of mankind's oldest burial monuments, dating back to 4,000 to 5,000 years B.C. […] Examples of tumuli can be seen peppering the landscape all over Western Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35c21d2f-fd0c-4d8b-b6a9-0106f421ca39",
                        "source_entry_id": "5b38a0ba-6500-3271-b0ef-5bcadd12f2db",
                        "source_sense_id": "5d500327-d6a9-3cb9-bdef-5ab09c420eb6",
