                ],
                "senses": [
                    {
                        "sense_id": "e96c78e4-7848-3ba0-b1be-23a539592209",
                        "entry_id": "576d554d-a47f-3db7-a3a5-2d42c6a242cb",
                        "glosses": [
                            "a fermented drink made from wheat or millet"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2a95380-7b92-44ee-b41b-ef58e7c2efa6",
                        "source_entry_id": "576d554d-a47f-3db7-a3a5-2d42c6a242cb",
                        "source_sense_id": "e96c78e4-7848-3ba0-b1be-23a539592209",
                        "source_sense_description": "fermented drink",
                        "target_lang_word": "буза́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "буза́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "54ff9bb0-3bb4-3976-8f9b-edeed6f948ab",
                                        "entry_id": "87bed5b3-aba5-323e-93ba-32f7c0212d16",
                                        "glosses": [
                                            "слабоалкогольный напиток из проса, гречихи, ячменя, распространённый главным образом в Крыму и на Кавказе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d52194-cc36-48fa-8005-8a5d525239ba",
                                                "sense_id": "54ff9bb0-3bb4-3976-8f9b-edeed6f948ab",
                                                "text": "— Да вот хоть черкесы, — продолжал он, — как напьются бузы на свадьбе или на похоронах, так и пошла рубка."
                                            },
                                            {
                                                "example_id": "46e52897-2669-4a31-9a5d-dd68884d09b2",
                                                "sense_id": "54ff9bb0-3bb4-3976-8f9b-edeed6f948ab",
                                                "text": "За спинами у всех пуховые подушки подложены, а перед ними на круглой дощечке блины просяные, и масло коровье распущено в чашке, и пиво татарское — буза, в кувшинчике."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "буза́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "83a07a2a-d10b-376f-9dc0-6f7e98185599",
                                        "entry_id": "4f9b0682-1314-374f-8432-1b13468ac0ab",
                                        "glosses": [
                                            "разг. то же, что каменная соль (в твёрдых комьях)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a36302-17a6-4c1e-8c3a-e3b9ea455f48",
                                                "sense_id": "83a07a2a-d10b-376f-9dc0-6f7e98185599",
                                                "text": "Буза — комовая каменная соль (главным образом Илецких месторождений) в виде больших кусков, большей или меньшей чистоты."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "буза́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f6293e3d-43a1-3e8d-b028-d86726e7d530",
                                        "entry_id": "2d1e0071-b3b2-3744-982b-0870a30e830f",
                                        "glosses": [
                                            "русское боевое искусство, включающее в себя боевой пляс, рукопашный бой, а также бой с оружием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a93cd776-5d7e-424e-86a3-c1c96f955349",
                                                "sense_id": "f6293e3d-43a1-3e8d-b028-d86726e7d530",
                                                "text": "Буза существовала в северо-западных регионах России, на землях современных Тверской, Новгородской, Псковской, Вологодской областей. Это народное единоборство имело множество названий, из которых «буза» — наиболее употребляемое. Традицию боя в различных местах называли по наименованию боевой пляски, под музыку которой происходила драка. Существуют такие варианты, как «буза», «галаниха», «семьдесят четвёртая», «шараевка», «весёлого», «под-драку», «скобарь», «горбатого», «собака», «мамонька». «Буза» — самое частое в употреблении название, и вместе с бойцовской мелодией и пляской это понятие обозначало как саму драку, так и боевую технику. Впервые о бузе, как об искусстве, упоминается в книге «Ода кулачному бойцу» И. С. Баркова, датируемой 1750 годом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a84d88-887b-30b1-bc6b-68be6d03abee",
                                        "entry_id": "2d1e0071-b3b2-3744-982b-0870a30e830f",
                                        "glosses": [
                                            "разг. возня; драка; шум, гам, скандал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dab9c2e-9839-4dd2-b0f2-d0009bf83556",
                                                "sense_id": "11a84d88-887b-30b1-bc6b-68be6d03abee",
                                                "text": "У кинжала ручка ала, // Ручка вьётся, как змея! // Заведу бузу большую, — // Выручай, кинжал, меня!"
                                            },
                                            {
                                                "example_id": "d7aec427-a619-4fbf-8945-4ae26f119b35",
                                                "sense_id": "11a84d88-887b-30b1-bc6b-68be6d03abee",
                                                "text": "Во второй половине матча в секторе наших болельщиков началась буза."
                                            },
                                            {
                                                "example_id": "20298c78-39bd-46e8-9fc7-d4dd063997fc",
                                                "sense_id": "11a84d88-887b-30b1-bc6b-68be6d03abee",
                                                "text": "Но и попадать в крайне неприятные истории ему приходится ничуть не реже, чем самому затевать бузу."
                                            },
                                            {
                                                "example_id": "b004ac1c-c8e9-467a-990b-fb6fde501d3e",
                                                "sense_id": "11a84d88-887b-30b1-bc6b-68be6d03abee",
                                                "text": "Зачем же бузу заваривать? Я за хорошее дело взялся, ты меня поддержать должен, помочь, а ты скандалишь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381b0a91-a458-3c0f-9480-10a84f43c6ab",
                                        "entry_id": "2d1e0071-b3b2-3744-982b-0870a30e830f",
                                        "glosses": [
                                            "разг. глупость; вздор; ложь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4a7005-ce98-442d-bca1-d77b78a6a2ed",
                                                "sense_id": "381b0a91-a458-3c0f-9480-10a84f43c6ab",
                                                "text": "Ванька подсел к костерику и прочёл им сказку про серебряное блюдечко и наливное яблочко. Страшная буза! Я и не подозревал никогда, что такая буза может быть в книжке напечатана. 〈…〉 Говорили, что она и самоубивалась из-за меня, но это буза."
                                            },
                                            {
                                                "example_id": "962d3f62-4af3-4764-a266-25318358ba91",
                                                "sense_id": "381b0a91-a458-3c0f-9480-10a84f43c6ab",
                                                "text": "Книжек Тюменцев читал много и каждую, прочитав, заносил в список с краткими замечаниями, например: «Буза, время зря потратил»."
                                            },
                                            {
                                                "example_id": "332cfc17-f716-49d9-b672-30efd96db358",
                                                "sense_id": "381b0a91-a458-3c0f-9480-10a84f43c6ab",
                                                "text": "Ну, я тут и жахнул: «Философия, говорю, это одно пустобрёхство и наводка теней. Я, товарищи, этой бузой заниматься не имею никакой охоты. Вот насчёт истории партии всей душой бы рад»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "буза́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f0e0f7b9-6b5c-339d-be5e-4b5865c499fd",
                                        "entry_id": "b01bc65c-e06f-3a3f-a2e5-c4feb60736cc",
                                        "glosses": [
                                            "разг. то же, что бузотёр"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7ddfa1-4a4a-465b-9f08-fb94dcebcd6a",
                                                "sense_id": "f0e0f7b9-6b5c-339d-be5e-4b5865c499fd",
                                                "text": "— Ты! Буза! Невероятное нахальство — делать замечания отцу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
