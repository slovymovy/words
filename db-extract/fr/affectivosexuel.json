                        "glosses": [
                            "Relatif aux aspects affectif et sexuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0e27eb-141e-4e1a-b34b-38f92e532380",
                                "sense_id": "62683581-bd7f-33ac-ad1f-181908c42583",
                                "text": "Son déficit mental (qui ne touchait pourtant absolument pas sa fonction désirante), ajouté à la différence d’âge, ajouté au fait que cela était une relation homosexuelle, a totalement brouillé leurs représentations, et c’était désespérant de les voir tous se foutre du bien-être affectivosexuel de mon patient pour ne s’intéresser qu’à leur image de pourfendeurs de pédophiles."
                            },
                            {
                                "example_id": "deab570c-d3da-431e-8e34-440f55da44a1",
                                "sense_id": "62683581-bd7f-33ac-ad1f-181908c42583",
                                "text": "Sa vie affectivosexuelle est ponctuée de plusieurs rencontres."
                            },
                            {
                                "example_id": "68641359-33fa-4f7f-821a-d5bbbee46db8",
                                "sense_id": "62683581-bd7f-33ac-ad1f-181908c42583",
                                "text": "La dépendance au téléphone portable peut être destructrice. Elle réduit notre sensibilité, modifie notre rapport à la réalité, atrophie nos liens affectivosexuels, notre créativité mais aussi notre connexion avec la nature."
                            }
                        ]
                    }
