        "fr-extract.jsonl": [
            {
                "entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                "word": "polythéiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "478fa45d-f654-4b48-8950-b24b194f3eca",
                        "entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "polythéistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31406671-0af7-3bdf-8008-0c120da4d631",
                        "entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                        "glosses": [
                            "Caractérisé par la croyance en plusieurs divinités (et non en une seule ou aucune)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344e5d63-0f5d-442a-a29e-bd0082e61c88",
                                "sense_id": "31406671-0af7-3bdf-8008-0c120da4d631",
                                "text": "Les religions polythéistes."
                            },
                            {
                                "example_id": "af1616c1-c076-4b61-8a00-835d756b10a6",
                                "sense_id": "31406671-0af7-3bdf-8008-0c120da4d631",
                                "text": "Les Hébreux retomberont à plusieurs reprises dans ces « travers » polythéistes, occasionnant chaque fois la punition de ce dieu exclusif."
                            }
                        ]
                    },
                    {
                        "sense_id": "87804ae4-44ef-3b31-b37b-6f84ec19fc60",
                        "entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                        "glosses": [
                            "Adepte du polythéisme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "21e03549-6d8e-42ff-aa01-d19afbb0d867",
                                "sense_id": "87804ae4-44ef-3b31-b37b-6f84ec19fc60",
                                "text": "On risque autant à croire trop, qu’à croire trop peu. Il n’y a ni plus ni moins de danger à être polythéiste qu’athée : or, le scepticisme peut seul garantir également, en tout temps et en tout lieu, de ces deux excès opposés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15740136-3984-4cc6-9f0c-a9a4c92c3ad6",
                        "source_entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                        "target_lang_word": "polytheistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polytheistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f0f275-876e-3adf-896e-f3e4eb1f7608",
                                        "entry_id": "d2ae67b3-4976-3769-a259-3c5c6afccd8b",
                                        "glosses": [
                                            "sich auf den Polytheismus beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "397b19a9-a7ef-4096-8bdb-c5fae2a16abc",
                                                "sense_id": "f6f0f275-876e-3adf-896e-f3e4eb1f7608",
                                                "text": "„Aristophanes lebte in einer Zeit, in der der Glaube an die polytheistische Götterwelt der Antike zerfiel.“"
                                            },
                                            {
                                                "example_id": "73009a20-3d92-433f-99bd-f862c3cc74dd",
                                                "sense_id": "f6f0f275-876e-3adf-896e-f3e4eb1f7608",
                                                "text": "„Das Christentum lehnte er wie alle Mohammedaner als polytheistisch ab.“"
                                            },
                                            {
                                                "example_id": "158f50b1-4691-4b9e-a062-d394d4d1b67c",
                                                "sense_id": "f6f0f275-876e-3adf-896e-f3e4eb1f7608",
                                                "text": "„Zudem gefährdete, so Bollmann, der von den monotheistischen Religionen des Vorderen Orients, dem Judentum und dem Christentum, erhobene Ausschließlichkeitsanspruch, die Toleranz der polytheistischen Stadtreligionen, die bis dahin unter dem Dach des Imperiums eine friedliche Symbiose eingegangen waren.“"
                                            },
                                            {
                                                "example_id": "97c6f842-7ad9-4579-a9c1-224e6422f01c",
                                                "sense_id": "f6f0f275-876e-3adf-896e-f3e4eb1f7608",
                                                "text": "„Das Spiel beginnt damit, daß die Heidenschaft ihren polytheistischen, die Synagoge ihren mißleiteten monotheistischen, die Kirchen ihren christlichen Standpunkt darlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc262014-394c-4795-a778-bbe4445d8ce6",
                        "source_entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
                        "target_lang_word": "polytheistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polytheistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "795c33cc-b439-3d0e-96d8-a4218c52ab90",
                                        "entry_id": "4539f694-3e4d-33d9-ad9a-ceb2cbc8a47c",
                                        "glosses": [
                                            "Of or relating to polytheism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8769b10-8c31-47e4-b98e-617f435c6ce4",
                                                "sense_id": "795c33cc-b439-3d0e-96d8-a4218c52ab90",
                                                "text": "The mystic is one to whom the unitive, pantheistic, or at least the panentheistic, aspects of the divinity are as congenial as the deistic, polytheistic, and anthropomorphic aspects are to the institutional mind."
                                            },
                                            {
                                                "example_id": "0a601dfd-33de-4ffe-a9a3-0824a24805b3",
                                                "sense_id": "795c33cc-b439-3d0e-96d8-a4218c52ab90",
                                                "text": "The horse stood still till he had finished the hymn, which Jude repeated under the sway of a polytheistic fancy that he would never have thought of humouring in broad daylight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f161af7-db6e-404f-809d-92a26cb90085",
                        "source_entry_id": "3a962b55-68a2-327a-95d2-d189ca6fe711",
