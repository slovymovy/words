                                    },
                                    {
                                        "sense_id": "758a632f-d14b-3164-b42a-1c16209545f6",
                                        "entry_id": "c10ee447-462a-3a58-be27-4f4e7c5048e7",
                                        "glosses": [
                                            "A turn of work; a labour or item of business."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84d0d604-805f-3625-bc5f-725232d0342a",
                                        "entry_id": "c10ee447-462a-3a58-be27-4f4e7c5048e7",
                                        "glosses": [
                                            "An odd job, a chore or piece of housework."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd9f9b8-a841-47e5-9f4a-5f6ec845a70a",
                                                "sense_id": "84d0d604-805f-3625-bc5f-725232d0342a",
                                                "text": "When thou hast done this chare, I’ll give thee leave to play till doomsday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e9f4931-744c-300d-9148-6b5c081afb3d",
                                        "entry_id": "c10ee447-462a-3a58-be27-4f4e7c5048e7",
                                        "glosses": [
                                            "A charlady, a woman employed to do housework; cleaning lady."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b7b88e4-1d90-4e1f-9a69-4ac44658487d",
                                                "sense_id": "8e9f4931-744c-300d-9148-6b5c081afb3d",
                                                "text": "I had to scrub the kitchen today, because the char couldn't come."
                                            },
                                            {
                                                "example_id": "b5f2ec06-d60e-4738-86e6-b3951d757368",
                                                "sense_id": "8e9f4931-744c-300d-9148-6b5c081afb3d",
                                                "text": "But there was nobody at Kig and Kadgit's except the charwoman wiping over the “lino” in the passage. “Nobody here yet, Miss,” said the char."
                                            },
                                            {
                                                "example_id": "28241750-7cbc-43af-9edf-0eb6f23dbd63",
                                                "sense_id": "8e9f4931-744c-300d-9148-6b5c081afb3d",
                                                "text": "The rollers wore grooves in the nursery floors and the chars complained of getting splinters in their hands while scrubbing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "char",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95e58404-bf9b-34ce-83ee-97e4ec86d8b3",
                                        "entry_id": "4e511327-5b05-331d-a1b1-762aca590bf7",
                                        "glosses": [
                                            "To turn, especially away or aside."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "623a9b17-99b0-3e8c-b793-98ae9fffb36d",
                                        "entry_id": "4e511327-5b05-331d-a1b1-762aca590bf7",
                                        "glosses": [
                                            "To work, especially to do housework; to work by the day, without being a regularly hired servant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbbd2a1-9654-4066-948f-14cc7f8dda50",
                                                "sense_id": "623a9b17-99b0-3e8c-b793-98ae9fffb36d",
                                                "text": "She explained that she was the commissionaire's wife, who did the charing, and I gave her the order for the coffee."
                                            },
                                            {
                                                "example_id": "13e70d9b-8844-4f1b-a54f-1a2b5d8d7498",
                                                "sense_id": "623a9b17-99b0-3e8c-b793-98ae9fffb36d",
                                                "text": "Her husband had been a soldier, and from a grateful country she received a pension large enough to keep her from starvation, and by charring and doing such odd jobs as she could get she earned a little extra to supply herself with liquor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22847472-0bd1-33d0-a462-a963cab0cd18",
                                        "entry_id": "4e511327-5b05-331d-a1b1-762aca590bf7",
                                        "glosses": [
                                            "To perform; to do; to finish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7adca6d3-1ff4-4eea-b465-2ec153fe53e6",
                                                "sense_id": "22847472-0bd1-33d0-a462-a963cab0cd18",
                                                "text": "All's chared when he is gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357cf358-aad2-302d-bba5-1ac699e815e4",
                                        "entry_id": "4e511327-5b05-331d-a1b1-762aca590bf7",
                                        "glosses": [
