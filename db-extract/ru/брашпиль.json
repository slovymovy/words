                                    {
                                        "sense_id": "40aa5c83-a03b-3db7-a190-c0fa6f1c66e2",
                                        "entry_id": "145d39b8-7878-30ca-83b2-4159a0826c2f",
                                        "glosses": [
                                            "Any of various forms of winch, in which a rope or cable is wound around a cylinder, used for lifting heavy weights"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cbc2fe9-3867-3294-907f-eaf02b3a6d64",
                                        "entry_id": "145d39b8-7878-30ca-83b2-4159a0826c2f",
                                        "glosses": [
                                            "A winding and circuitous way; a roundabout course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2077fa6f-dabd-4f50-94c3-b10f4f0315b4",
                                                "sense_id": "5cbc2fe9-3867-3294-907f-eaf02b3a6d64",
                                                "text": "With windlasses and with assays of bias, / By indirections find directions out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14193a94-c5a8-37d1-a6bc-b5876e12f71a",
                                        "entry_id": "145d39b8-7878-30ca-83b2-4159a0826c2f",
                                        "glosses": [
                                            "An apparatus resembling a winch or windlass, for bending the bow of an arblast, or crossbow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "windlass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae624265-34f5-3e13-b1f9-6bf08202bb00",
                                        "entry_id": "60d01d72-e4fa-34aa-a549-75f459ede026",
                                        "glosses": [
                                            "To raise with, or as if with, a windlass; to use a windlass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecca0899-9b61-4dd9-a75d-6a062bf03933",
                                                "sense_id": "ae624265-34f5-3e13-b1f9-6bf08202bb00",
                                                "text": "A favoring breeze enabled us to sail all the way down the lake, and (having been windlassed across the haul-over) even down the canals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3506ca8b-4161-3560-9168-f307cded999f",
                                        "entry_id": "60d01d72-e4fa-34aa-a549-75f459ede026",
                                        "glosses": [
                                            "To take a roundabout course; to work warily or by indirect means."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45894b47-e2c6-4d28-9b0e-95c95bb152b5",
                                                "sense_id": "3506ca8b-4161-3560-9168-f307cded999f",
                                                "text": "He could not expect to allure him forward, and therefore drives him as far back as he can; that so he may be the more sure of him at the rebound; as a skilful woodsman, that by windlassing presently gets a shoot, which, without taking a compass and thereby a commodious stand, he could never have obtained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
