                                "target_lang_word": "zmienny",
                                "target_lang_sense_clarification": "niestabilny"
                            },
                            {
                                "target_lang_word": "chwiejny",
                                "target_lang_sense_clarification": "niepewny, często się zmieniający"
                            }
