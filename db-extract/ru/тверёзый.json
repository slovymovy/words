                "senses": [
                    {
                        "sense_id": "f8cc8271-8e6d-3342-9601-4cf1eed2dc21",
                        "entry_id": "93af063f-3fc0-33f8-94e0-4c700939fd6d",
                        "glosses": [
                            "прост. то же, что трезвый; не пьяный или не пьющий спиртное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7c8a7a-016e-4d44-b57e-a23249083590",
                                "sense_id": "f8cc8271-8e6d-3342-9601-4cf1eed2dc21",
                                "text": "Прежде честный и тверёзый был, а теперь и попивать и поворовывать начал."
                            },
                            {
                                "example_id": "58bc9c74-e219-4d5f-9e3c-c2341cf47d95",
                                "sense_id": "f8cc8271-8e6d-3342-9601-4cf1eed2dc21",
                                "text": "В Волкояре иной раз и пьяному-то совестно смотреть на Божий свет, а ежели человек тверезый… и-и-их!"
                            },
                            {
                                "example_id": "5030b8de-ec46-4ce4-b13c-636fe89c9159",
                                "sense_id": "f8cc8271-8e6d-3342-9601-4cf1eed2dc21",
                                "text": "На пьянаго поклепъ, а тверезый укралъ"
                            }
                        ]
                    }
                ],
