                "translations": [
                    {
                        "translation_id": "c0d42b5d-eead-4cd2-adf4-08d06a935f76",
                        "source_entry_id": "ce5a12a5-319d-3031-9a87-35bc9e42c737",
                        "source_sense_id": "9b7e6f74-4f07-3a94-a26f-55266e063b59",
                        "target_lang_word": "twentysomething",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twentysomething",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee518e2-c2e7-3500-a72d-6606bcf58216",
                                        "entry_id": "8c8fd3cc-fa5e-3ba1-a56f-66028ff79234",
                                        "glosses": [
                                            "A person whose age is between twenty and twenty-nine years, inclusive; someone in their twenties."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b866a56-dcc4-4f35-91c1-c0b6321600ab",
                                                "sense_id": "8ee518e2-c2e7-3500-a72d-6606bcf58216",
                                                "text": "This is the twentysomething generation, those 48 million young Americans ages 18 through 29 who fall between the famous baby boomers and the boomlet of children the baby boomers are producing."
                                            },
                                            {
                                                "example_id": "faddcbba-24ea-4efe-a775-e839dffeb590",
                                                "sense_id": "8ee518e2-c2e7-3500-a72d-6606bcf58216",
                                                "text": "A 2025 phenomenon involving teenagers and masturbatory twentysomethings with limited education and experience given the authority to tell five-star generals, former presidents, cabinet secretaries, academics, and ambassadors how to do their jobs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twentysomething",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6dbb5a8-0276-3490-8ba4-d9688bc9aa61",
                                        "entry_id": "0c69a626-ea4e-36ce-8cea-84f9894dbd81",
                                        "glosses": [
                                            "Aged between twenty and thirty."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c0facfb-f5fb-4bbb-8132-72d9f6921fa5",
                                                "sense_id": "d6dbb5a8-0276-3490-8ba4-d9688bc9aa61",
                                                "text": "You may feel as inexperienced as a twentysomething woman just starting out, but it’s not too late to make changes."
                                            },
                                            {
                                                "example_id": "4c94ece3-9383-4420-a045-a83f090bc8bd",
                                                "sense_id": "d6dbb5a8-0276-3490-8ba4-d9688bc9aa61",
                                                "text": "The members of The Dope Show are pretty normal looking twentysomething guys and gals with nothing to prove."
                                            },
                                            {
                                                "example_id": "600ad24e-8d94-49f2-8b35-7038f966fe96",
                                                "sense_id": "d6dbb5a8-0276-3490-8ba4-d9688bc9aa61",
                                                "text": "Coristine is one of a team of teenage and twentysomething software engineers, apparently conscripted by Musk in his largely unchecked war against bureaucracy."
                                            }
                                        ]
                                    }
                                ]
                            },
