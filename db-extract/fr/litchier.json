                "senses": [
                    {
                        "sense_id": "62cb8313-7ccf-34ab-9268-08f95ebfac9b",
                        "entry_id": "c0c19dd2-558b-3a6f-af7b-f1fed82eb501",
                        "glosses": [
                            "Arbre produisant les litchis."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "26f54e80-ebf1-46ca-8666-d06ce11f8531",
                                "sense_id": "62cb8313-7ccf-34ab-9268-08f95ebfac9b",
                                "text": "Plongeant leurs mains dans le panier en osier dans lequel ils les transportaient, ils saisirent par poignées ces petits êtres apeurés dont certains étaient morts sans doute d'étouffement depuis longtemps, puis les projetèrent par terre et contre le tronc du litchier à l’ombre duquel on était assis."
                            },
                            {
                                "example_id": "7cbe7d7e-3c40-4c20-b08b-d083121af6d0",
                                "sense_id": "62cb8313-7ccf-34ab-9268-08f95ebfac9b",
                                "text": "La taille dite de formation se pratique sur certaines espèces comme le litchier et les agrumes, pendant les trois premières années en sélectionnant les branches qui constituent l’ossature de l'arbre."
                            }
                        ]
                    }
                ],
