                "senses": [
                    {
                        "sense_id": "fe117f9d-0c38-374b-a021-aadd9fafda2d",
                        "entry_id": "59a0d0d4-1c4b-341e-81d2-c91753e8fe41",
                        "glosses": [
                            "One who carries the keys to a place; a keyholder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4861a3f3-bfc5-4cbb-b3e2-09ab0c923751",
                                "sense_id": "fe117f9d-0c38-374b-a021-aadd9fafda2d",
                                "text": "They were incensed that the claviger Bernat Mola not only slept in the church, but that by night he allowed “dishonest people and tricksters” in to gamble."
                            },
                            {
                                "example_id": "de169308-1422-4cf2-a00f-ec724ca795a0",
                                "sense_id": "fe117f9d-0c38-374b-a021-aadd9fafda2d",
                                "text": "Hugh of Tadcaster remarked that he had been claviger before being admitted as a brother of the Order, and that he had asked the master – presumably he meant the grand commander of England - to admit him as a brother:"
                            }
                        ]
                    }
