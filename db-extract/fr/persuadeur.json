                        "glosses": [
                            "Celui qui persuade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22487bd2-f9eb-42d8-96db-c8f50c39e3a5",
                                "sense_id": "d5a79b29-bde3-3bda-b825-7cbb9758faa3",
                                "text": "Mais assez bon persuadeur [je] me tiens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8104ad3-99b0-4dae-899f-564099548cfc",
                        "source_entry_id": "f341473e-0fb5-3029-acbe-29e7501bc104",
                        "source_sense_id": "d5a79b29-bde3-3bda-b825-7cbb9758faa3",
                        "target_lang_word": "persuader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persuader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a884ebd-bc09-37d5-9d49-44f29ca0d468",
                                        "entry_id": "77654b67-84c5-37c1-89b0-57ba7e5eab9c",
                                        "glosses": [
                                            "One who, or that which, persuades, literally or figuratively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4599c25-345b-44b0-808e-9dce7e9f94aa",
                                                "sense_id": "5a884ebd-bc09-37d5-9d49-44f29ca0d468",
                                                "text": "[…] purſued his vnneighbourly purpoſe in ſuch ſort: that hee being the ſtronger perſwader, and ſhe (belike) too credulous in beleeuing or elſe ouer-feeble in reſiſting, from priuate imparlance, they fell to action; and continued their cloſe fight a long while together, vnſeene and vvithout ſuſpition, no doubt to their equall ioy and contentment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f7a614-5699-3e35-a078-cc556e55d54e",
                                        "entry_id": "77654b67-84c5-37c1-89b0-57ba7e5eab9c",
                                        "glosses": [
                                            "One who, or that which, persuades, literally or figuratively.",
                                            "A hammer; any tool used improvisationally to strike a recalcitrant object."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c22a9ea-a68d-49dd-b79a-afd09ab7cbc4",
                                                "sense_id": "00f7a614-5699-3e35-a078-cc556e55d54e",
                                                "text": "It's true that a good worker doesn't misuse a hammer, and it's also true that a good worker knows that sometimes using a persuader to expedite a task is appropriate for efficiency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "972eae8a-cbf7-3eaf-8e6a-a02cd0bcbf14",
                                        "entry_id": "77654b67-84c5-37c1-89b0-57ba7e5eab9c",
                                        "glosses": [
                                            "One who, or that which, persuades, literally or figuratively.",
                                            "A tool used to pack the type into the form."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d91b2d-7599-4e72-ba98-6603d35c5e22",
                                                "sense_id": "972eae8a-cbf7-3eaf-8e6a-a02cd0bcbf14",
                                                "text": "Next fit the quoins, using the “persuader” to squeeze in the pages, and tap up all around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b2569e-5afb-3f1e-b64d-05feb98bfc81",
                                        "entry_id": "77654b67-84c5-37c1-89b0-57ba7e5eab9c",
                                        "glosses": [
                                            "One who, or that which, persuades, literally or figuratively.",
                                            "An electrode that directs electrons into a multiplier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1d55da-cef0-4375-b014-416d3ae33feb",
                                                "sense_id": "28b2569e-5afb-3f1e-b64d-05feb98bfc81",
                                                "text": "These electrons are guided to the second dynode by the resultant electric field of this dynode and the persuader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb2dfbe-5d69-3256-85a7-541c38f39a25",
                                        "entry_id": "77654b67-84c5-37c1-89b0-57ba7e5eab9c",
                                        "glosses": [
                                            "One who, or that which, persuades, literally or figuratively.",
                                            "A spur (for riding a horse)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11f1927a-50b7-495b-98ff-c0d2a8b925c1",
                                                "sense_id": "deb2dfbe-5d69-3256-85a7-541c38f39a25",
                                                "text": "He had very long legs, which he carried far back, and made most liberal use of his persuaders, so that what with his weight, and what with his style of riding, his horses were far from enjoying a sinecure."
                                            },
                                            {
                                                "example_id": "2a9272e4-2b0b-4c9d-bf5a-d35d7d504034",
                                                "sense_id": "deb2dfbe-5d69-3256-85a7-541c38f39a25",
                                                "text": "The Squire laboured under a similar difficulty, and his persuaders were as busily at play as Jacob's. When, however, the horses had caught their second wind, they mended the places of their riders, and carried them closer to the flying chase."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
