                        "entry_id": "6f6e5be2-5c0b-3b22-933d-eca3cbcc9597",
                        "glosses": [
                            "To gather windfalls or small apples left on trees."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "119a9d03-5702-385b-abeb-8c9583085ab5",
                        "entry_id": "6f6e5be2-5c0b-3b22-933d-eca3cbcc9597",
                        "glosses": [
                            "To steal fruit, especially apples, from a garden or orchard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e29d2a-ed8d-490c-9572-580c954cc046",
                                "sense_id": "119a9d03-5702-385b-abeb-8c9583085ab5",
                                "text": "(we've all seen trees, and arent Adam and Eve condemned for having gone scrumping?; interestingly a great philosopher recalled Saint Augustine spent a lot of his long life being racked with guilt for having gone scrumping for some pears when he was a boy! ...)"
                            },
                            {
                                "example_id": "bfbb8e17-d18d-4da7-81fd-c6719a7cfaa4",
                                "sense_id": "119a9d03-5702-385b-abeb-8c9583085ab5",
                                "text": "[I]t was something that every schoolboy of my generation almost `had' to do, as obligatory a proof of impending manliness as scrumping apples or pulling girls' pigtails.\nI told myself I'd never scrump gooseberries again, or go scrumping apples with Huw and Moi ..."
                            },
                            {
                                "example_id": "b5b460fc-2e65-452b-9b88-c4479fd97583",
                                "sense_id": "119a9d03-5702-385b-abeb-8c9583085ab5",
                                "text": "Scrumping itself is a mot juste of unusual economy. It doesn’t just mean stealing: it specifically means stealing apples and only apples."
                            }
                        ]
                    },
                    {
                        "sense_id": "10b43455-63ae-3732-8385-a90d333d84cf",
                        "entry_id": "6f6e5be2-5c0b-3b22-933d-eca3cbcc9597",
                        "glosses": [
