                "senses": [
                    {
                        "sense_id": "9b450605-a9a3-3f7f-990c-867c1a88a424",
                        "entry_id": "8c0430fc-9e73-39bc-8924-c2b4237d81ac",
                        "glosses": [
                            "großer Einrichtungsgegenstand aus Polymer"
                        ],
                        "tags": [
                            "Singular ungebräuchlich"
                        ],
                        "examples": [
                            {
                                "example_id": "3a230234-c797-44dd-b2a1-a02314373384",
                                "sense_id": "9b450605-a9a3-3f7f-990c-867c1a88a424",
                                "text": "„Kunststoffmöbel für den Garten sind in jedem Fall eine preisgünstige Variante, um sich ein stilvolles Paradies im Freien zu kreieren.“"
                            },
                            {
                                "example_id": "c49f4815-50d3-4d86-8691-80b1c3fd9fe1",
                                "sense_id": "9b450605-a9a3-3f7f-990c-867c1a88a424",
                                "text": "„Meist zeichnen sich Kunststoffmöbel auch durch Funktionalität aus, wie Verstellen der Rückenlehnen von Stühlen bzw. Sesseln in verschiedene Positionen oder Platz sparend zusammenklappbare Tische. Kunststoffmöbel sind wetterfest, relativ einfach zu pflegen. Sie lassen sich auch mit handelsüblichen Allzweckreiniger behandeln.“"
                            },
                            {
                                "example_id": "9114b239-652f-4d67-b80e-e8958173ec8e",
                                "sense_id": "9b450605-a9a3-3f7f-990c-867c1a88a424",
                                "text": "„Farbenfrohe und filigran anmutende Kunststoffmöbel sind derzeit bei der Gestaltung der Außenbereiche von Cafés und Restaurants besonders angesagt.“"
                            },
                            {
                                "example_id": "3aec9007-ace4-4239-bd0c-4f84943814de",
                                "sense_id": "9b450605-a9a3-3f7f-990c-867c1a88a424",
                                "text": "„Besonders in Wohnungen erleben Kunststoffmöbel ein Revival und sind wieder schicke Eyecatcher.“"
                            },
                            {
                                "example_id": "5c5aa427-2e53-4398-a8b9-a71e637c17a0",
                                "sense_id": "9b450605-a9a3-3f7f-990c-867c1a88a424",
                                "text": "Kunststoffmöbel sind oft modische und kurzlebige Wegwerfprodukte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
