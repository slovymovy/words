                    },
                    {
                        "translation_id": "d9028736-5177-450c-9ae5-cfee7b8d3f2d",
                        "source_entry_id": "3f088544-b53e-3b25-9d70-638e8d8069cf",
                        "source_sense_id": "c0b0e42e-3a4b-3d9f-be66-32e530700284",
                        "target_lang_word": "Loreley",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
