                {
                    "sense_id": "58acda8e-b564-38d9-8632-c8b7abebf077",
                    "sense_definition": "Afficher de manière visible une expression sur son visage ou manifester une attitude particulière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entrant dans la salle de réunion, elle <w>arborait</w> un large sourire confiant."
                        },
                        {
                            "text": "Malgré la fatigue du voyage, le vainqueur <w>arbore</w> un air fier devant la foule."
                        }
                    ],
                    "synonyms": [
