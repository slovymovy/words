                "senses": [
                    {
                        "sense_id": "d89ef7dd-2e72-3c4e-a010-2304561fa70f",
                        "entry_id": "fd693c15-32cd-359f-8525-f948a6f67ec3",
                        "glosses": [
                            "Refroidir excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6640dd-7136-4216-870b-4352e247936f",
                                "sense_id": "d89ef7dd-2e72-3c4e-a010-2304561fa70f",
                                "text": "Ne pas sur-refroidir le centre informatique."
                            },
                            {
                                "example_id": "11571cc0-1fd9-42ef-a08a-da21b3f7eb8c",
                                "sense_id": "d89ef7dd-2e72-3c4e-a010-2304561fa70f",
                                "text": "Equilibrer le réseau évite de sur-refroidir certaines zones pour refroidir correctement les zones mal irriguées."
                            },
                            {
                                "example_id": "40716758-63e0-4a99-9f22-21f0fb29853c",
                                "sense_id": "d89ef7dd-2e72-3c4e-a010-2304561fa70f",
                                "text": "Cela à pour effet de surchauffer ou de sur-refroidir les pièces aux endroits les plus favorisés des bâtiments."
                            },
                            {
                                "example_id": "5ecd0e4a-4391-4395-a171-04b39f619c1b",
                                "sense_id": "d89ef7dd-2e72-3c4e-a010-2304561fa70f",
                                "text": "Le laminova utilise l'eau moteur pour refroidir l'huile alors il ne peut pas la sur-refroidir."
                            }
                        ]
                    },
