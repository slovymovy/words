                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d1dfe48-5cf3-40ba-8df1-d0956ba3723a",
                                "sense_id": "afef41a3-144d-3e7c-87f5-dc03caeca595",
                                "text": "Die Modelleisenbahn umfasst mehrere Strecken, eine künstliche Landschaft, Züge mit Waggons und Straßenfahrzeugen."
                            },
                            {
                                "example_id": "baa5fbbe-0d1f-44d2-82ac-472d92fecd5b",
                                "sense_id": "afef41a3-144d-3e7c-87f5-dc03caeca595",
                                "text": "„Benno will, weil er es auch soll, für die von ihm gewünschte Modelleisenbahn sparen, das meiste dafür wird sein Patenonkel bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
