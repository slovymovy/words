                                        "sense_id": "0e58584f-deee-30a0-8afb-b02f262e1111",
                                        "entry_id": "6e68f843-e0a5-3755-9176-7e4dad6029c9",
                                        "glosses": [
                                            "Used to separate clauses in place of stops."
