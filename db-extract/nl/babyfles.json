                        "sense_id": "c1b57e7d-4994-3b6c-9c05-6e8701a36097",
                        "entry_id": "910546c9-65c6-3385-b1f0-ab0e25357073",
                        "glosses": [
                            "een fles uitgerust met een speen, waaruit baby's vloeistoffen kunnen drinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90db79b-46ed-4493-90d8-e6c7e02922ee",
                                "sense_id": "c1b57e7d-4994-3b6c-9c05-6e8701a36097",
                                "text": "Merk op dat een van de normale flessen van Dr. Brown’s past op de Medela-moedermelkpompen, waardoor het een geweldig alternatief is voor de Medela-moedermelkfles. Over het algemeen is dit een uitstekende babyfles, maar we raden de glazen versie aan als je hem kunt vinden."
                            }
                        ]
                    }
                ],
