                "senses": [
                    {
                        "sense_id": "c5407385-a573-392a-ab85-fc5994feda03",
                        "entry_id": "cccd4b34-87bd-3a5f-92fe-fd74ba546a11",
                        "glosses": [
                            "Joueur évoluant au centre de la première ligne de mêlée, portant généralement le numéro 2."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e32037-cf74-4cae-baa1-170f96e441c3",
                                "sense_id": "c5407385-a573-392a-ab85-fc5994feda03",
                                "text": "Le talonneur Peato Mauvaka, l’arrière Melvyn Jaminet, l’ailier Matthis Lebel et le centre Pierre-Louis Barassi ont été ménagés lors de la séance d’entraînement du XV de France, mardi, à quelques jours d’affronter l’Angleterre dans le Tournoi des VI Nations."
                            },
                            {
                                "example_id": "c1c1d761-0185-4153-86a0-bb83ec1b1c11",
                                "sense_id": "c5407385-a573-392a-ab85-fc5994feda03",
                                "text": "Les doutes autour de l’état de santé de Dan Sheehan persistent, le talonneur du Leinster est resté à Dublin pour évaluer la gravité de sa blessure au pied qui l’avait contraint à quitter le terrain en première mi-temps contre l’Angleterre."
                            },
                            {
                                "example_id": "70d572a3-ae28-4850-a573-1656d828f8c9",
                                "sense_id": "c5407385-a573-392a-ab85-fc5994feda03",
                                "text": "Le talonneur Pierre Bourgarit se distingue avec cinq essais sur ballons portés."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c26b430-eadd-343b-a4a2-dfbd110431c9",
                        "entry_id": "cccd4b34-87bd-3a5f-92fe-fd74ba546a11",
                        "glosses": [
                            "Désigne un chien ou une race de chien de berger ou bouvier qui pince les jarrets du bétail pour le conduire."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
