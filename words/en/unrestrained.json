{
    "word_family": [
        "restrain",
        "restrained",
        "restraint",
        "unrestrainedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f962df5d-97de-38b1-877f-aa896fa47531",
                    "sense_definition": "Not held back, secured, or confined by physical restraints or safety devices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The safety inspector noticed that several <w>unrestrained</w> boxes were sliding around in the cargo area.",
                            "target_lang_translations": {
                                "es": "El inspector de seguridad notó que varias cajas <w>sueltas</w> se estaban deslizando por la zona de carga."
                            }
                        },
                        {
                            "text": "During an emergency stop, <w>unrestrained</w> passengers are at serious risk of being thrown forward.",
                            "target_lang_translations": {
                                "es": "Durante una frenada de emergencia, los pasajeros <w>sin sujetar</w> corren un grave riesgo de salir despedidos hacia adelante."
                            }
                        }
                    ],
                    "synonyms": [
                        "unbound"
                    ],
                    "antonyms": [
                        "bound",
                        "constrained",
                        "restrained"
                    ],
                    "common_phrases": [
                        "unrestrained passengers"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no está sujeto, asegurado o retenido por medidas de seguridad o ataduras físicas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "suelto",
                                "target_lang_sense_clarification": "no asegurado o fijado físicamente"
                            },
                            {
                                "target_lang_word": "sin sujetar",
                                "target_lang_sense_clarification": "sin cinturón, amarre o dispositivo de sujeción"
                            },
                            {
                                "target_lang_word": "sin atar",
                                "target_lang_sense_clarification": "libre de ataduras físicas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "834a8fea-f5a0-3a9c-ac87-e3b16b28bbb9",
                    "sense_definition": "Expressed openly, spontaneously, and without inhibition or emotional holding back.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the team won the final match, the stadium erupted in <w>unrestrained</w> joy.",
                            "target_lang_translations": {
                                "es": "Cuando el equipo ganó el partido final, el estadio estalló en una alegría <w>desbordante</w>."
                            }
                        },
                        {
                            "text": "She could not help bursting into <w>unrestrained</w> laughter after hearing the ridiculous story.",
                            "target_lang_translations": {
                                "es": "No pudo evitar estallar en una risa <w>incontenida</w> tras escuchar la absurda historia."
                            }
                        }
                    ],
                    "synonyms": [
                        "genuine",
                        "heartfelt",
                        "sincere",
                        "unconstrained"
                    ],
                    "antonyms": [
                        "forced",
                        "insincere",
                        "restrained",
                        "rigid",
                        "stiff"
                    ],
                    "common_phrases": [
                        "unrestrained joy",
                        "unrestrained laughter"
                    ],
                    "target_lang_definitions": {
                        "es": "Expresado abiertamente, de forma espontánea y sin inhibiciones ni contención emocional."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desenfrenado",
                                "target_lang_sense_clarification": "sin freno ni contención emocional"
                            },
                            {
                                "target_lang_word": "desbordante",
                                "target_lang_sense_clarification": "emoción intensa e incontenible"
                            },
                            {
                                "target_lang_word": "incontenido",
                                "target_lang_sense_clarification": "que no se reprime"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54cc60f0-080f-3e1c-b7b6-218d1d934778",
                    "sense_definition": "Excessive, immoderate, and not kept within proper limits or control.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excessive_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper criticized the minister for his <w>unrestrained</w> spending during the recent campaign.",
                            "target_lang_translations": {
                                "es": "El periódico criticó al ministro por su gasto <w>desmedido</w> durante la reciente campaña."
                            }
                        },
                        {
                            "text": "Without proper regulation, the factory expanded with completely <w>unrestrained</w> growth.",
                            "target_lang_translations": {
                                "es": "Sin una regulación adecuada, la fábrica se expandió con un crecimiento completamente <w>descontrolado</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "excessive",
                        "extravagant",
                        "extreme",
                        "immoderate",
                        "intemperate",
                        "unreasonable"
                    ],
                    "antonyms": [
                        "moderate",
                        "restrained"
                    ],
                    "common_phrases": [
                        "unrestrained spending",
                        "unrestrained growth"
                    ],
                    "target_lang_definitions": {
                        "es": "Excesivo, inmoderado y que no se mantiene dentro de los límites o el control adecuados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "descontrolado",
                                "target_lang_sense_clarification": "fuera de control o regulación"
                            },
                            {
                                "target_lang_word": "desmedido",
                                "target_lang_sense_clarification": "excesivo o sin moderación"
                            },
                            {
                                "target_lang_word": "desenfrenado",
                                "target_lang_sense_clarification": "sin límites ni moderación"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffdaafd5-059b-3b29-91e6-9477cbfbf0e3",
                    "sense_definition": "simple past and past participle of <w>unrestrain</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer quietly <w>unrestrained</w> the suspect after discovering that a mistake had been made.",
                            "target_lang_translations": {
                                "es": "El agente <w>liberó</w> discretamente al sospechoso tras descubrir que se había cometido un error."
                            }
                        },
                        {
                            "text": "Having <w>unrestrained</w> the excited dog, the trainer let it run freely across the park.",
                            "target_lang_translations": {
                                "es": "Tras haber <w>desatado</w> al emocionado perro, el adiestrador lo dejó correr libremente por el parque."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio pasado de unrestrain; liberar de ataduras o restricciones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "liberar",
                                "target_lang_sense_clarification": "quitar ataduras o restricciones físicas"
                            },
                            {
                                "target_lang_word": "desatar",
                                "target_lang_sense_clarification": "soltar de ligaduras"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}