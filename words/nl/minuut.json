                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De notaris bewaart de <w>minuut</w> van de akte zorgvuldig in het archief.",
                            "target_lang_translations": {
                                "en": "The notary carefully keeps the <w>minute</w> of the deed in the archive.",
                                "ru": "Нотариус бережно хранит <w>подлинник</w> акта в архиве.",
                                "pl": "Notariusz starannie przechowuje <w>oryginał</w> aktu w archiwum.",
                                "de": "Der Notar bewahrt die <w>Urschrift</w> der Urkunde sorgfältig im Archiv auf.",
                                "fr": "Le notaire conserve soigneusement la <w>minute</w> de l'acte dans les archives.",
                                "it": "Il notaio conserva accuratamente la <w>minuta</w> dell'atto nell'archivio.",
                                "cs": "Notář pečlivě uchovává <w>originál</w> listiny v archivu.",
                                "tr": "Noter, senedin <w>aslını</w> arşivde özenle saklar.",
                                "es": "El notario conserva cuidadosamente la <w>minuta</w> de la escritura en el archivo."
                            }
                        },
                        {
                            "text": "Van de oorspronkelijke <w>minuut</w> kunnen officiële afschriften worden gemaakt.",
                            "target_lang_translations": {
                                "en": "Official copies can be made from the original <w>minute</w>.",
                                "ru": "С исходного <w>подлинника</w> могут быть сделаны официальные копии.",
                                "pl": "Z oryginalnego <w>aktu</w> można sporządzić oficjalne odpisy.",
                                "de": "Vom ursprünglichen <w>Original</w> können offizielle Abschriften angefertigt werden.",
                                "fr": "Des copies officielles peuvent être faites à partir de la <w>minute</w> originale.",
                                "it": "Dall'originale <w>minuta</w> si possono trarre copie ufficiali.",
                                "cs": "Z původního <w>prvopisu</w> lze pořizovat úřední odpisy.",
                                "tr": "Orijinal <w>asıldan</w> resmi suretler çıkarılabilir.",
                                "es": "Se pueden hacer copias oficiales a partir de la <w>minuta</w> original."
                            }
                        }
