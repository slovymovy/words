                                "sense_id": "8c47cd96-1a12-35b1-b346-53283980eeed",
                                "text": "„Eine Vorentscheidung zu all diesen Fragen könnte bereits an diesem Sonntag fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8cdea195-6aea-3f04-82bb-37a6ac821f7f",
