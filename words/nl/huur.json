                    "sense_id": "0d9e5a4d-049d-3aa6-9b68-ba0345da18f8",
                    "sense_definition": "Het geldbedrag dat men periodiek betaalt om iets te mogen gebruiken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>huur</w> van mijn appartement is deze maand verhoogd.",
                            "target_lang_translations": {
                                "ru": "<w>Арендная плата</w> за мою квартиру в этом месяце повысилась.",
                                "en": "The <w>rent</w> of my apartment has been increased this month.",
                                "pl": "<w>Czynsz</w> za moje mieszkanie został w tym miesiącu podniesiony.",
                                "de": "Die <w>Miete</w> für meine Wohnung wurde diesen Monat erhöht.",
                                "fr": "Le <w>loyer</w> de mon appartement a augmenté ce mois-ci.",
                                "it": "L'<w>affitto</w> del mio appartamento è aumentato questo mese.",
                                "cs": "<w>Nájemné</w> za můj byt se tento měsíc zvýšilo.",
                                "tr": "Dairemin <w>kirası</w> bu ay artırıldı.",
                                "es": "El <w>alquiler</w> de mi apartamento ha subido este mes."
                            }
                        },
                        {
                            "text": "Wij betalen elke maand netjes de <w>huur</w> aan de huisbaas.",
                            "target_lang_translations": {
                                "ru": "Мы каждый месяц исправно платим <w>аренду</w> хозяину.",
                                "en": "We pay the <w>rent</w> to the landlord punctually every month.",
                                "pl": "Co miesiąc regularnie płacimy właścicielowi <w>czynsz</w>.",
                                "de": "Wir zahlen dem Vermieter jeden Monat pünktlich die <w>Miete</w>.",
                                "fr": "Nous payons sagement le <w>loyer</w> au propriétaire chaque mois.",
                                "it": "Paghiamo regolarmente l'<w>affitto</w> al proprietario ogni mese.",
                                "cs": "Každý měsíc řádně platíme majiteli <w>nájem</w>.",
                                "tr": "Her ay ev sahibine <w>kirayı</w> düzenli olarak ödüyoruz.",
                                "es": "Pagamos puntualmente el <w>alquiler</w> al casero todos los meses."
                            }
                        }
                    ],
                    "common_phrases": [
                        "huur betalen",
                        "hoge huur",
                        "inclusief huur",
                        "exclusief huur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, которую периодически платят за право пользования чем-либо.",
                        "en": "The amount of money paid periodically for the right to use something.",
                        "pl": "Kwota pieniędzy, którą płaci się okresowo za możliwość korzystania z czegoś.",
                        "de": "Der Geldbetrag, den man regelmäßig zahlt, um etwas nutzen zu dürfen.",
                        "fr": "Le montant d'argent que l'on paie périodiquement pour pouvoir utiliser quelque chose.",
                        "it": "La somma di denaro che si paga periodicamente per poter utilizzare qualcosa.",
                        "cs": "Částka peněz, kterou člověk pravidelně platí za možnost něco užívat.",
                        "tr": "Bir şeyi kullanabilmek için periyodik olarak ödenen para miktarı.",
                        "es": "La cantidad de dinero que se paga periódicamente para poder utilizar algo."
                    },
