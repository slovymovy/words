                                "target_senses": [
                                    {
                                        "sense_id": "7a888039-5b2d-3cba-ab3c-72c2c08df259",
                                        "entry_id": "b2a9247b-6eb0-383f-af1c-ec0a17a436b8",
                                        "glosses": [
                                            "Gobierno encabezado por las peores personas, o las menos capacitadas, de un país."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f25908-13c5-4161-80a9-e8f42407fdd2",
                                                "sense_id": "7a888039-5b2d-3cba-ab3c-72c2c08df259",
                                                "text": "La caquistocracia es el gobierno de los peores, es decir, el empeoramiento conjunto en la calidad de los sujetos políticos caracterizados por la ignorancia, la mediocridad (frecuentemente vulgar), el prejuicio, la ausencia de escrúpulos, la mala fe, la presunción, la ingenuidad, la astucia y la no profesionalización en sus haberes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
