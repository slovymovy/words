{
    "word_family": [
        "разовый",
        "разок",
        "разик",
        "разом"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2afa45d5-afb4-30e1-89ba-eebc350ec782",
                    "sense_definition": "Единичный случай, событие или проявление какого-либо действия.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "instance_occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, прочитай этот текст ещё <w>раз</w>.",
                            "target_lang_translations": {
                                "en": "Please read this text one more <w>time</w>.",
                                "de": "Bitte lies diesen Text noch ein <w>Mal</w>."
                            }
                        },
                        {
                            "text": "В этот <w>раз</w> мы решили остаться дома.",
                            "target_lang_translations": {
                                "en": "This <w>time</w> we decided to stay home.",
                                "de": "Dieses <w>Mal</w> haben wir beschlossen, zu Hause zu bleiben."
                            }
                        },
                        {
                            "text": "Я уже много <w>раз</w> говорил тебе об этом.",
                            "target_lang_translations": {
                                "en": "I have told you about this many <w>times</w>.",
                                "de": "Ich habe dir das schon viele <w>Male</w> gesagt."
                            }
                        }
                    ],
                    "synonyms": [
                        "случай"
                    ],
                    "common_phrases": [
                        "ещё раз",
                        "в этот раз",
                        "на этот раз",
                        "много раз",
                        "ни разу"
                    ],
                    "target_lang_definitions": {
                        "en": "A single instance, occurrence, or repetition of an action or event.",
                        "de": "Ein einzelner Fall, ein Ereignis oder das Auftreten einer Handlung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "instance or occurrence"
                            },
                            {
                                "target_lang_word": "occasion",
                                "target_lang_sense_clarification": "specific event"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mal",
                                "target_lang_sense_clarification": "einzelnes Ereignis oder Vorkommen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "fd6a465c-66d6-3b19-816b-bd137a618616",
                    "sense_definition": "Союз, вводящий придаточное предложение причины или условия; соответствует по значению словам «если», «поскольку».",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "condition_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Раз</w> ты обещала помочь, нужно выполнять обещание.",
                            "target_lang_translations": {
                                "en": "<w>Since</w> you promised to help, you must keep your promise.",
                                "de": "<w>Da</w> du versprochen hast zu helfen, musst du dein Versprechen auch halten."
                            }
                        },
                        {
                            "text": "Мы не пойдём в парк, <w>раз</w> на улице идёт дождь.",
                            "target_lang_translations": {
                                "en": "We won't go to the park <w>since</w> it is raining outside.",
                                "de": "Wir gehen nicht in den Park, <w>wenn</w> es draußen regnet."
                            }
                        }
                    ],
                    "synonyms": [
                        "если",
                        "коли",
                        "коль"
                    ],
                    "common_phrases": [
                        "раз так",
                        "раз уж"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction used to introduce a reason or condition, indicating that given a certain fact, a consequence follows.",
                        "de": "Konjunktion, die einen Kausal- oder Konditionalsatz einleitet; entspricht in der Bedeutung „da“, „weil“ oder „wenn“."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "since",
                                "target_lang_sense_clarification": "reason or cause"
                            },
                            {
                                "target_lang_word": "if",
                                "target_lang_sense_clarification": "condition"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "da",
                                "target_lang_sense_clarification": "Grund oder Ursache"
                            },
                            {
                                "target_lang_word": "wenn",
                                "target_lang_sense_clarification": "Bedingung"
                            },
                            {
                                "target_lang_word": "wo doch",
                                "target_lang_sense_clarification": "da ja"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "18b41941-3837-3cf2-b28e-47309d6a256a",
                    "sense_definition": "Слово, используемое при счёте для обозначения числа «один».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "counting_one",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На счёт <w>раз</w> мы все вместе прыгнем.",
                            "target_lang_translations": {
                                "en": "On the count of <w>one</w> we will all jump together.",
                                "de": "Bei <w>eins</w> springen wir alle zusammen."
                            }
                        },
                        {
                            "text": "<w>Раз</w>, два, три, четыре, пять — я иду искать!",
                            "target_lang_translations": {
                                "en": "<w>One</w>, two, three, four, five — I'm coming to find you!",
                                "de": "<w>Eins</w>, zwei, drei, vier, fünf – ich komme!"
                            }
                        }
                    ],
                    "synonyms": [
                        "один"
                    ],
                    "common_phrases": [
                        "раз, два, три"
                    ],
                    "target_lang_definitions": {
                        "en": "The number one, typically used when counting rhythmically or starting a count.",
                        "de": "Wort, das beim Zählen verwendet wird, um die Zahl „eins“ darzustellen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one",
                                "target_lang_sense_clarification": "number used in counting"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eins",
                                "target_lang_sense_clarification": "Zahlwort beim Zählen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f8c546-5e37-33e3-b120-fdc767d1a7db",
                    "sense_definition": "Минимальный заказ в некоторых карточных играх (например, в преферансе).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "card_game_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Игрок объявил <w>раз</w>, надеясь выиграть эту партию.",
                            "target_lang_translations": {
                                "en": "The player bid <w>one</w>, hoping to win this game.",
                                "de": "Der Spieler reizte <w>Eins</w> in der Hoffnung, dieses Spiel zu gewinnen."
                            }
                        },
                        {
                            "text": "В этой ситуации лучше заказать <w>раз</w>, чем рисковать.",
                            "target_lang_translations": {
                                "en": "In this situation, it is better to bid <w>one</w> than to risk it.",
                                "de": "In dieser Situation ist es besser, <w>Eins</w> anzusagen, als ein Risiko einzugehen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "card games context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A specific bid or contract level in certain card games like Preference.",
                        "de": "Das Mindestgebot in bestimmten Kartenspielen (z. B. Präferenz)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one",
                                "target_lang_sense_clarification": "card game bid"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Eins",
                                "target_lang_sense_clarification": "Gebot im Kartenspiel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9878a6fd-ec1e-33ce-a6be-a8a549acbf49",
                    "sense_definition": "В какой-то момент в прошлом; однажды.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "past_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Раз</w> вечером мы сидели у камина и разговаривали.",
                            "target_lang_translations": {
                                "en": "<w>One</w> evening we were sitting by the fireplace and talking.",
                                "de": "Eines Abends saßen wir <w>mal</w> am Kamin und unterhielten uns."
                            }
                        },
                        {
                            "text": "Я <w>раз</w> видел его в магазине, но не подошёл.",
                            "target_lang_translations": {
                                "en": "I saw him in the store <w>once</w>, but didn't approach him.",
                                "de": "Ich habe ihn <w>einmal</w> im Laden gesehen, bin aber nicht hingegangen."
                            }
                        }
                    ],
                    "synonyms": [
                        "однажды",
                        "как-то раз",
                        "как-то"
                    ],
                    "antonyms": [
                        "всегда"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "conversational style"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "At some indefinite moment in the past; on a single occasion.",
                        "de": "Zu einem unbestimmten Zeitpunkt in der Vergangenheit; einmal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "once",
                                "target_lang_sense_clarification": "at one time in the past"
                            },
                            {
                                "target_lang_word": "one day",
                                "target_lang_sense_clarification": "indefinite past time"
                            },
                            {
                                "target_lang_word": "one time",
                                "target_lang_sense_clarification": "on a specific past occasion"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einmal",
                                "target_lang_sense_clarification": "zu einem Zeitpunkt in der Vergangenheit"
                            },
                            {
                                "target_lang_word": "mal",
                                "target_lang_sense_clarification": "umgangssprachlich für einmal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92c65eb3-4755-3b4b-b9b4-de3ea2dd54de",
                    "sense_definition": "Обозначение резкого, неожиданного и быстрого действия.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sudden_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Свет мигнул и — <w>раз</w> — внезапно погас.",
                            "target_lang_translations": {
                                "en": "The light flickered and — <w>snap</w> — suddenly went out.",
                                "de": "Das Licht flackerte und – <w>zack</w> – ging es plötzlich aus."
                            }
                        },
                        {
                            "text": "Он замахнулся и <w>раз</w> по мячу со всей силы!",
                            "target_lang_translations": {
                                "en": "He swung and — <w>wham</w> — hit the ball with all his strength!",
                                "de": "Er holte aus und – <w>wumm</w> – traf den Ball mit aller Kraft!"
                            }
                        }
                    ],
                    "synonyms": [
                        "оп"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "expressive usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to describe a sudden, quick, unexpected, or instantaneous action.",
                        "de": "Ausdruck für eine plötzliche, unerwartete und schnelle Handlung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snap",
                                "target_lang_sense_clarification": "sudden sound or action"
                            },
                            {
                                "target_lang_word": "wham",
                                "target_lang_sense_clarification": "sudden impact"
                            },
                            {
                                "target_lang_word": "just like that",
                                "target_lang_sense_clarification": "sudden occurrence"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schwupps",
                                "target_lang_sense_clarification": "plötzliche Bewegung oder Handlung"
                            },
                            {
                                "target_lang_word": "zack",
                                "target_lang_sense_clarification": "schnelle, plötzliche Aktion"
                            },
                            {
                                "target_lang_word": "auf einmal",
                                "target_lang_sense_clarification": "plötzlich"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}