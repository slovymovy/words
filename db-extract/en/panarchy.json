                ],
                "senses": [
                    {
                        "sense_id": "fb5e99d1-d68a-3d0b-81b9-2268b52dbd14",
                        "entry_id": "9c32e3ea-a6b5-3888-a2d9-065c86df9e91",
                        "glosses": [
                            "The individual's right to choose any form of government without being forced to move from their current locale."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dac6033f-24e3-4eca-85a8-549e5888d07d",
                                "sense_id": "fb5e99d1-d68a-3d0b-81b9-2268b52dbd14",
                                "text": "1860 article by “Panarchy” de Puydt"
                            }
                        ]
                    },
                    {
                        "sense_id": "248db3a7-8500-36de-8e68-9ec5ffa080af",
                        "entry_id": "9c32e3ea-a6b5-3888-a2d9-065c86df9e91",
                        "glosses": [
                            "Dynamic symmetry across multiple scales."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c7408f0-f7be-4965-992b-2bd08cda9ca7",
                                "sense_id": "248db3a7-8500-36de-8e68-9ec5ffa080af",
                                "text": "In panarchies, transformational change can be generated from below or from above."
                            }
                        ]
                    },
                    {
                        "sense_id": "406336ef-9a69-3aa4-89de-4c1d449142a0",
                        "entry_id": "9c32e3ea-a6b5-3888-a2d9-065c86df9e91",
                        "glosses": [
                            "An inclusive, multilateral system in which all parties may participate meaningfully."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e280c85-5276-4de1-a899-9fafbe6fd52f",
                                "sense_id": "406336ef-9a69-3aa4-89de-4c1d449142a0",
                                "text": "The overlapping governance networks of panarchy have facilitated a context conducive to the above competing multilateralisms."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9d1a101-926d-3b4b-99a6-5db5587ec27e",
                        "entry_id": "9c32e3ea-a6b5-3888-a2d9-065c86df9e91",
                        "glosses": [
                            "Rule by all; a system of governance in which each person has absolute power."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "189be2fd-cc29-4b1b-9750-395f182c597e",
                                "sense_id": "d9d1a101-926d-3b4b-99a6-5db5587ec27e",
                                "text": "If everyone all at once wanted to know who won the Stanley Cup in 1968 they could have the information simultaneously; cyberspace as the site of Unamuno's panarchy, where each one is king."
                            }
                        ]
                    },
                    {
                        "sense_id": "c583822a-ec30-313e-86fb-17a6c8ed13e5",
                        "entry_id": "9c32e3ea-a6b5-3888-a2d9-065c86df9e91",
                        "glosses": [
                            "Rule of all; absolute or total rule."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b22b3d54-de7f-4ce1-8a2a-19d204e6bd36",
                                "sense_id": "c583822a-ec30-313e-86fb-17a6c8ed13e5",
                                "text": "These contentions give rise to systems of political philosophy which range all the way from anarchy to panarchy; from the doctrine that government should do nothing to the doctrine that it should do everything."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4a6ea7c-df32-3d1d-a5ed-4691f2543b43",
                        "entry_id": "9c32e3ea-a6b5-3888-a2d9-065c86df9e91",
                        "glosses": [
                            "An all-encompassing realm."
                        ],
                        "tags": [
                            "countable",
                            "poetic",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6868f016-c536-4334-b8f7-662edcc9f744",
                                "sense_id": "f4a6ea7c-df32-3d1d-a5ed-4691f2543b43",
                                "text": "Some held that God, and all the heavenly powers, / As with the starry panarchy of space, / Were of one essence, like divine and high;"
                            }
                        ]
                    }
                ],
