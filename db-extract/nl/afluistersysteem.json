                        "entry_id": "8775f5dc-57de-3195-984c-7c76d2c96c51",
                        "glosses": [
                            "beleid betreffende het afluisteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d844987-8103-44cd-85e7-61835b794f52",
                                "sense_id": "081d320c-9851-3de8-b479-54b183f97b1e",
                                "text": "De bedrijven noemen vijf principes op basis waarvan het afluistersysteem moet veranderen, waaronder een beperking van de mogelijkheiden van de overheid om gebruikersdata te verzamelen en openheid over de wensen van de overheid."
                            }
