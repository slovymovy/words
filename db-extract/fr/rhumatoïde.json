                                        "entry_id": "140c0e90-653b-3887-a9cf-f07edfed7d76",
                                        "glosses": [
                                            "Involving or pertaining to rheumatism, especially rheumatoid arthritis."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f73f7e3-0049-4e50-84ad-0af8d263edf4",
                                                "sense_id": "b6e0397e-f289-34e4-92e7-6c425cf7984c",
                                                "text": "Rheumatoid sufferers have such pain and discomfort every day of their lives that they live eternally in high hopes of something effective turning up."
                                            },
                                            {
                                                "example_id": "fd1bd7f9-372e-468b-8358-7747839a7b5a",
                                                "sense_id": "b6e0397e-f289-34e4-92e7-6c425cf7984c",
                                                "text": "Juvenile rheumatoid arthritis (JRA), often referred to by doctors today as juvenile idiopathic arthritis (JIA), is a type of arthritis that causes joint inflammation and stiffness for more than six weeks in a child aged 16 or younger. It affects approximately 50,000 children in the United States. Inflammation causes redness, swelling, warmth, and soreness in the joints, although many children with JRA do not complain of joint pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76bb154c-8b8e-32bc-9e3b-58d652ce4958",
                                        "entry_id": "140c0e90-653b-3887-a9cf-f07edfed7d76",
                                        "glosses": [
                                            "Presenting analogies with rheumatism."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
