                                                "sense_id": "4bd45687-cd18-357f-a51a-6239ae6444b4",
                                                "text": "Der voreingenommene Journalist schrieb einen äußerst subjektiven Bericht über die Gerichtsverhandlung."
                                            },
                                            {
                                                "example_id": "f81568b2-e0d2-48d5-8129-ae26acd062b3",
                                                "sense_id": "4bd45687-cd18-357f-a51a-6239ae6444b4",
                                                "text": "Sich seine voreingenommenen Sichtweisen bewusst zu machen, ist ein wichtiger Schritt zur Veränderung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4cf6baa-6fac-4002-bfdb-86fe74bc0b06",
                        "source_entry_id": "8119e417-ba73-3ffa-95e2-03006ca9b298",
