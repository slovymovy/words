                                        "glosses": [
                                            "struttura altamente specializzata che consente la comunicazione delle cellule del tessuto nervoso tra loro (neuroni) o con altre cellule (cellule muscolari, sensoriali o ghiandole endocrine)"
                                        ],
                                        "tags": [],
