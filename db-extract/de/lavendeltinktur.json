                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d6aa86-717c-45bb-894c-f1f9b328476d",
                                "sense_id": "ba89cdf6-6d0b-3228-8a20-86c01e5cc125",
                                "text": "„Dank der Lavendeltinktur auf meinem Kopfkissen hatte ich keine Albträume mehr, auch meine Haare fielen nicht mehr so schnell aus.“"
                            },
                            {
                                "example_id": "ca7286e1-d184-4275-9861-acc6fe1d6437",
                                "sense_id": "ba89cdf6-6d0b-3228-8a20-86c01e5cc125",
                                "text": "„Mein Kopf schmerzte, und ich holte ein Fläschchen mit Lavendeltinktur aus meiner Reisetasche.“"
                            },
                            {
                                "example_id": "00115ba0-61b7-4623-8b98-9f64cfa5d4a0",
                                "sense_id": "ba89cdf6-6d0b-3228-8a20-86c01e5cc125",
                                "text": "„Schließlich gab sie dem Mann ein paar Tropfen Lavendeltinktur in den Tee und wusch sich anschließend die Hände.“"
                            },
                            {
                                "example_id": "58dbeec3-b235-404e-ae2c-458c1f5b2f30",
                                "sense_id": "ba89cdf6-6d0b-3228-8a20-86c01e5cc125",
                                "text": "„Im realen Leben stieß ich einige Zeit später auf die Empfehlung, gegen nervöse Magen-Darm-Beschwerden Lavendeltinktur zu probieren.“"
                            },
                            {
                                "example_id": "782b1697-4fd4-4a46-8a06-af15d2fa4c5b",
                                "sense_id": "ba89cdf6-6d0b-3228-8a20-86c01e5cc125",
                                "text": "„Zuerst benötigen Sie einen Frischpflanzenauszug aus Lavendel oder eine Lavendeltinktur.“"
                            }
                        ],
