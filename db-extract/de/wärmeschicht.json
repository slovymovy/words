                "senses": [
                    {
                        "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                        "entry_id": "d6c64c8c-fcf9-3529-ba1d-bbfa2cbb71a8",
                        "glosses": [
                            "Schicht aus einem wärmeisolierenden Material, einem Kleidungsstück oder Ähnlichem, die Wärme speichert und vor Kälte schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb4df52-0049-4262-8ff8-4c45cb7cc764",
                                "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                                "text": "„Direkt auf der Haut, als zweite Schicht über einem Unterhemd, oder als zusätzliche Wärmeschicht unter einer Isolationsjacke - Nicht nur perfekt für Outdooraktivitäten.“"
                            },
                            {
                                "example_id": "972ac04e-1efe-498d-8d8f-cc306b368f48",
                                "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                                "text": "„Für den Schutz gegen kalte Finger ist wichtig, dass du ein ausreichend großes Modell wählst, sodass sich zwischen Hand und Stoff eine Wärmeschicht bilden kann.“"
                            },
                            {
                                "example_id": "73546727-cf2b-4789-80be-10d54ef0dd0a",
                                "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                                "text": "„Ob als Alljahresjacke oder als zusätzliche Wärmeschicht beim Zwiebelprinzip an kälteren Tagen, die MIUtec Iso Jacke ist der ideale Begleiter.“"
                            },
                            {
                                "example_id": "b45d95b6-a816-4ff2-902d-2e2134dc08ba",
                                "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                                "text": "„Dieses Material, das für Schrumpfverpackungen entwickelt wurde und häufig als zweite Wärmeschicht für Fenster verwendet wird, ist äußerst widerstandsfähig.“"
                            },
                            {
                                "example_id": "7dfaf96a-1aa0-4209-a584-ca4c179bb667",
                                "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                                "text": "„Die Wärmeschicht ist recht dünn und verleiht der Decke nur zusätzliche Dicke, Weichheit und ein wenig Wärme.“"
                            },
                            {
                                "example_id": "607a5367-e4c7-4f9f-874b-2e0c468ca34d",
                                "sense_id": "5388b3e6-072f-3918-9dad-aec1f6bbb73b",
                                "text": "„Sie eignet sich perfekt als leichte Wärmeschicht über dem Baselayer oder Fleece.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
