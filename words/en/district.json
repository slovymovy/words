{
    "word_family": [
        "redistrict",
        "subdistrict",
        "districting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e29848ea-e7ab-3806-8ca3-32234ca128c4",
                    "sense_definition": "An administrative division of an area, such as a country, city, or county, managed by a local government.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "administrative_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new school <w>district</w> includes three elementary schools and one high school.",
                            "target_lang_translations": {
                                "ru": "Новый школьный <w>округ</w> включает в себя три начальные школы и одну старшую.",
                                "tr": "Yeni okul <w>bölgesi</w> üç ilkokul ve bir liseyi kapsıyor.",
                                "zh": "新的学<w>区</w>包括三所小学和一所高中。"
                            }
                        },
                        {
                            "text": "She works in the financial <w>district</w>, where most of the banks are located.",
                            "target_lang_translations": {
                                "ru": "Она работает в финансовом <w>районе</w>, где расположено большинство банков.",
                                "tr": "Bankaların çoğunun bulunduğu finans <w>bölgesinde</w> çalışıyor.",
                                "zh": "她在金融<w>区</w>工作，那里集中了大多数银行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zone",
                        "sector",
                        "precinct",
                        "ward",
                        "region",
                        "administrative area"
                    ],
                    "common_phrases": [
                        "school district",
                        "financial district",
                        "business district",
                        "electoral district"
                    ],
                    "target_lang_definitions": {
                        "ru": "Административно-территориальная единица (страны, города или графства), управляемая местной администрацией.",
                        "tr": "Bir bölgenin, şehrin veya ülkenin yerel yönetim tarafından yönetilen idari birimi.",
                        "zh": "由地方政府管理的行政区域，如城市、县或国家的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "административная единица города или области"
                            },
                            {
                                "target_lang_word": "округ",
                                "target_lang_sense_clarification": "административная единица (напр. избирательный, школьный)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilçe",
                                "target_lang_sense_clarification": "idari yönetim birimi"
                            },
                            {
                                "target_lang_word": "bölge",
                                "target_lang_sense_clarification": "yönetim alanı"
                            },
                            {
                                "target_lang_word": "semt",
                                "target_lang_sense_clarification": "şehir içi idari alan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区",
                                "target_lang_sense_clarification": "行政划分的区域"
                            },
                            {
                                "target_lang_word": "行政区",
                                "target_lang_sense_clarification": "具有行政职能的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58affa51-a7e3-32cf-a1c5-85984f9e0669",
                    "sense_definition": "An area or region marked by some distinguishing feature, character, or activity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "administrative_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tourists love to visit the historic <w>district</w> to see the old architecture.",
                            "target_lang_translations": {
                                "ru": "Туристы любят посещать исторический <w>район</w>, чтобы посмотреть на старинную архитектуру.",
                                "tr": "Turistler eski mimariyi görmek için tarihi <w>semti</w> ziyaret etmeyi çok sever.",
                                "zh": "游客们喜欢参观历史<w>街区</w>，欣赏古老的建筑。"
                            }
                        },
                        {
                            "text": "We went shopping in the fashion <w>district</w> downtown.",
                            "target_lang_translations": {
                                "ru": "Мы отправились за покупками в модный <w>квартал</w> в центре города.",
                                "tr": "Şehir merkezindeki moda <w>bölgesinde</w> alışverişe çıktık.",
                                "zh": "我们去市中心的时尚<w>区域</w>购物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neighborhood",
                        "locality",
                        "quarter",
                        "area",
                        "zone",
                        "part of town"
                    ],
                    "common_phrases": [
                        "historic district",
                        "theater district",
                        "shopping district",
                        "lake district"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория или часть города, выделяющаяся какой-либо характерной чертой или видом деятельности.",
                        "tr": "Belirgin bir özelliği, karakteri veya faaliyeti ile öne çıkan bölge veya alan.",
                        "zh": "具有某种显著特征、性质或特定活动的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "часть города с определенной характеристикой"
                            },
                            {
                                "target_lang_word": "квартал",
                                "target_lang_sense_clarification": "часть города, выделенная по профессиональному или иному признаку"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölge",
                                "target_lang_sense_clarification": "belirli bir özelliğe sahip alan"
                            },
                            {
                                "target_lang_word": "semt",
                                "target_lang_sense_clarification": "belirgin nitelikteki şehir bölümü"
                            },
                            {
                                "target_lang_word": "mahalle",
                                "target_lang_sense_clarification": "yerleşim veya etkinlik alanı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区域",
                                "target_lang_sense_clarification": "具有特定特征的范围"
                            },
                            {
                                "target_lang_word": "街区",
                                "target_lang_sense_clarification": "城市中具有特定功能的区域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e99d3b36-f113-3938-9024-37a56f466f14",
                    "sense_definition": "The District of Columbia, the federal district of the United States.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proper_name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He commutes into the <w>District</w> every morning for his government job.",
                            "target_lang_translations": {
                                "ru": "Каждое утро он ездит на работу в <w>Округ</w> на государственную службу.",
                                "tr": "Devlet memuriyeti için her sabah <w>Bölge'ye</w> gidip geliyor.",
                                "zh": "他每天早上都通勤去<w>特区</w>做政府工作。"
                            }
                        },
                        {
                            "text": "Living in the <w>District</w> can be expensive compared to the suburbs.",
                            "target_lang_translations": {
                                "ru": "Жизнь в <w>Округе</w> может быть дорогой по сравнению с пригородами.",
                                "tr": "<w>Bölge'de</w> yaşamak banliyölere kıyasla pahalı olabilir.",
                                "zh": "与郊区相比，住在<w>特区</w>可能会很贵。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Округ Колумбия, федеральный округ США.",
                        "tr": "Amerika Birleşik Devletleri'nin federal bölgesi olan Kolumbiya Bölgesi (District of Columbia).",
                        "zh": "哥伦比亚特区，美国的联邦直辖区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Округ",
                                "target_lang_sense_clarification": "сокращенное название Округа Колумбия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Bölge",
                                "target_lang_sense_clarification": "Kolumbiya Bölgesi'nin kısaltması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特区",
                                "target_lang_sense_clarification": "指代哥伦比亚特区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8980a7e8-f4d0-32d5-ac06-0ab187d074db",
                    "sense_definition": "The District Line of the London Underground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "proper_name_transit",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "You should take the <w>District</w> to get to Wimbledon quickly.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит сесть на <w>Дистрикт</w>, чтобы быстро добраться до Уимблдона.",
                                "tr": "Wimbledon'a hızlıca ulaşmak için <w>District</w> hattına binmelisin.",
                                "zh": "你应该乘坐<w>区域线</w>去温布尔登，这样比较快。"
                            }
                        },
                        {
                            "text": "The <w>District</w> is colored green on the standard tube map.",
                            "target_lang_translations": {
                                "ru": "Линия <w>Дистрикт</w> обозначена зеленым цветом на стандартной карте метро.",
                                "tr": "<w>District</w> hattı standart metro haritasında yeşil renkle gösterilir.",
                                "zh": "在标准的地铁图上，<w>区域线</w>被标为绿色。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия Дистрикт лондонского метрополитена.",
                        "tr": "Londra metrosunun District Hattı.",
                        "zh": "伦敦地铁的区域线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дистрикт",
                                "target_lang_sense_clarification": "название линии метро"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "District",
                                "target_lang_sense_clarification": "metro hattı adı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区域线",
                                "target_lang_sense_clarification": "伦敦地铁线路名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d522402-e8f1-3997-a5b9-d0eb62f4d8e3",
                    "sense_definition": "To divide a region into administrative or other districts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>district</w> the city to ensure fair representation.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>районировать</w> город, чтобы обеспечить справедливое представительство.",
                                "tr": "Komite, adil temsili sağlamak amacıyla şehri <w>bölgelere ayırmaya</w> karar verdi.",
                                "zh": "委员会决定对城市进行<w>划分区域</w>，以确保公平代表权。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>district</w> such a densely populated area effectively.",
                            "target_lang_translations": {
                                "ru": "Трудно эффективно <w>разделить на округа</w> такую густонаселенную территорию.",
                                "tr": "Bu kadar yoğun nüfuslu bir alanı etkili bir şekilde <w>bölgelere ayırmak</w> zordur.",
                                "zh": "很难有效地对这样一个人口稠密的地区进行<w>划分区域</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zone",
                        "partition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять регион на административные или иные округа.",
                        "tr": "Bir bölgeyi idari veya başka türden bölgelere ayırmak.",
                        "zh": "将一个地区划分为行政区或其他区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "районировать",
                                "target_lang_sense_clarification": "делить на районы"
                            },
                            {
                                "target_lang_word": "делить на округа",
                                "target_lang_sense_clarification": "распределять по округам"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölgelere ayırmak",
                                "target_lang_sense_clarification": "idari bölümlere ayırmak"
                            },
                            {
                                "target_lang_word": "bölgelemek",
                                "target_lang_sense_clarification": "bölge sınırları belirlemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "划分区域",
                                "target_lang_sense_clarification": "进行行政或地理上的分区"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "342c599c-a7e8-3087-aad1-ab2d249f195c",
                    "sense_definition": "Rigorous, stringent, or harsh in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient laws were enforced with <w>district</w> severity.",
                            "target_lang_translations": {
                                "ru": "Древние законы исполнялись со <w>строгой</w> суровостью.",
                                "tr": "Eski yasalar <w>sert</w> bir acımasızlıkla uygulanırdı.",
                                "zh": "古代法律的执行带有<w>严厉</w>的苛刻性。"
                            }
                        },
                        {
                            "text": "He ruled the clan with a <w>district</w> hand that allowed no opposition.",
                            "target_lang_translations": {
                                "ru": "Он управлял кланом <w>суровой</w> рукой, не допускавшей никаких возражений.",
                                "tr": "Klanı hiçbir muhalefete izin vermeyen <w>katı</w> bir elle yönetti.",
                                "zh": "他以<w>严厉</w>的手段统治着部落，不允许任何反对意见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strict",
                        "severe",
                        "stern"
                    ],
                    "antonyms": [
                        "lenient",
                        "lax"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строгий, суровый или жесткий по характеру (устаревшее).",
                        "tr": "Sert, katı veya amansız nitelikte (eskimiş kullanım).",
                        "zh": "性质上严厉、苛刻或严酷的（已过时）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "не допускающий отклонений"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "жесткий, беспощадный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sert",
                                "target_lang_sense_clarification": "katı, müsamahasız"
                            },
                            {
                                "target_lang_word": "katı",
                                "target_lang_sense_clarification": "şiddetli, tavizsiz"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严厉",
                                "target_lang_sense_clarification": "态度或手段强硬"
                            },
                            {
                                "target_lang_word": "苛刻",
                                "target_lang_sense_clarification": "过于严酷"
                            }
                        ]
                    }
                }
            ]
        }
    ]
