                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Robotisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04501e16-391b-3b68-b3a5-35d206f8f7c3",
                                        "entry_id": "4c86b968-4e8c-32b9-8413-8f736935efeb",
                                        "glosses": [
                                            "Prozess der Einführung von Robotertechnik in der Produktion, bei Dienstleistungen und in der Verwaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d5333e-da9c-4b3a-a941-1223aeba80be",
                                                "sense_id": "04501e16-391b-3b68-b3a5-35d206f8f7c3",
                                                "text": "„In Tschechien und der Slowakei ist die Robotisierung weiter fortgeschritten als im Rest der EU, Ungarn und Polen wollen dieses Niveau auch erreichen.“"
                                            },
                                            {
                                                "example_id": "996bc25b-2044-4378-a94e-d7c085a47ee4",
                                                "sense_id": "04501e16-391b-3b68-b3a5-35d206f8f7c3",
                                                "text": "„In enger Verbindung damit steht die weiter zunehmende Mechanisierung, der Einsatz von Informations- und Kommunikationstechnologien bei der Robotisierung (z.B. Melk- und Pflugroboter), des ‚precision farmings‘, bei der Nutzung von betriebsspezifischen Wettervorhersagen oder bei farbsensor- und kameragesteuerten Erntevorrichtungen (z.B. für Tomaten, Blumenkohl und Salat).“"
                                            },
                                            {
                                                "example_id": "e4ce3e5a-fda3-4784-84fa-cacde2b54eaa",
                                                "sense_id": "04501e16-391b-3b68-b3a5-35d206f8f7c3",
                                                "text": "„Hinzu kommen der rasante Wandel in Digitalisierung, Automatisierung, Robotisierung sowie Revolutionen am Arbeitsmarkt und die damit verbundene Zukunftsungewissheit, die endemisch wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
