    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fc2a245-2a6e-309e-b404-295831c037f4",
                    "sense_definition": "Réponse vive ou argumentée faite à une personne au cours d'un échange.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a trouvé une <w>réplique</w> brillante qui a immédiatement fait rire toute l'assemblée."
                        },
                        {
                            "text": "Face à cette critique injuste, sa <w>réplique</w> cinglante ne s'est pas fait attendre."
                        }
                    ],
                    "synonyms": [
                        "riposte",
                        "réponse"
                    ],
                    "common_phrases": [
                        "avoir de la réplique",
                        "réplique cinglante"
                    ]
                },
                {
                    "sense_id": "ec6cd6ce-5ffd-3156-88db-194822e97062",
                    "sense_definition": "Parole ou ensemble de phrases qu'un acteur doit prononcer en réponse à un autre comédien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune comédien a oublié sa <w>réplique</w> en plein milieu du deuxième acte."
                        },
                        {
                            "text": "Sur scène, elle sait donner la <w>réplique</w> à ses partenaires avec un grand talent."
                        }
                    ],
                    "common_phrases": [
                        "donner la réplique",
                        "manquer sa réplique"
                    ]
                },
                {
                    "sense_id": "e334c98f-00da-342e-a494-e92b14e26920",
                    "sense_definition": "Copie ou reproduction très fidèle d'un objet original ou d'une œuvre d'art.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "copie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée présente une <w>réplique</w> exacte d'un navire de guerre du dix-septième siècle."
                        },
                        {
                            "text": "Il conserve dans son bureau une <w>réplique</w> miniature de la célèbre sculpture."
                        }
                    ],
                    "synonyms": [
                        "copie",
                        "reproduction"
                    ],
                    "antonyms": [
                        "original"
                    ],
                    "common_phrases": [
