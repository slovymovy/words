                                ]
                            },
                            {
                                "target_word": "geminate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359e38ad-4f1b-3799-83b2-f63a8244c563",
                                        "entry_id": "3e06f69f-95e4-3390-aa58-ce60b4ad48a5",
                                        "glosses": [
                                            "A doubled or repeated letter or speech sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27385d08-70b1-4db0-98e5-6c22c9630401",
                                                "sense_id": "359e38ad-4f1b-3799-83b2-f63a8244c563",
                                                "text": "The attested forms show variation in the unstressed vowels (Srd. lèppere, lèpporo, lèppore, léppuri etc.) but agree on the labial geminate. We can thus reconstruct *leppVr-."
                                            }
                                        ]
                                    }
