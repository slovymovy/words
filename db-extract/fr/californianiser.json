                "senses": [
                    {
                        "sense_id": "ccfa7240-d8c5-3b1f-90f5-e145149afea7",
                        "entry_id": "a2cdbd28-c752-3014-9e55-0c8b9ff7276a",
                        "glosses": [
                            "Donner un caractère californien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e942362f-e5d2-42eb-9ceb-3d24931e2218",
                                "sense_id": "ccfa7240-d8c5-3b1f-90f5-e145149afea7",
                                "text": "La semaine prochaine, les aprems de ma chère maman seront libres et nous pourrons filer a la plage, histoire de se californianiser."
                            },
                            {
                                "example_id": "769a3358-113d-4b14-aa42-5402c17dfd32",
                                "sense_id": "ccfa7240-d8c5-3b1f-90f5-e145149afea7",
                                "text": "Cependant notre héros a commis une erreur : pensant qu'il ne s'adressait qu'à une Texane californianisée, il n'a pas pris la peine de verrouiller ses alibis, d'où cette confusion sur les fuseaux horaires."
                            },
                            {
                                "example_id": "292e7570-3338-4d60-a8d5-f5da5d859a92",
                                "sense_id": "ccfa7240-d8c5-3b1f-90f5-e145149afea7",
                                "text": "Restaurant japonais de la désormais célèbre chaine lancée par sbe et le chef Katsu-ya en 2006 avec Starck, les sushi et « rolls » sont inventifs et « californianisés »."
                            }
                        ]
                    }
