                "senses": [
                    {
                        "sense_id": "d3423d58-3089-32be-893c-99740e50bfa2",
                        "entry_id": "6cd1dac9-603e-326b-ac3c-f9b51f81443a",
                        "glosses": [
                            "freier Blick auf große Entfernung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15471c7-440e-4b4c-93b3-212ba5a80653",
                                "sense_id": "d3423d58-3089-32be-893c-99740e50bfa2",
                                "text": "Von diesem Standort aus hat man eine hervorragende Fernsicht in die Landschaft."
                            },
                            {
                                "example_id": "e504ebd5-0367-496a-bfba-e825fa72b555",
                                "sense_id": "d3423d58-3089-32be-893c-99740e50bfa2",
                                "text": "„Die weite Fernsicht, die sich von der Höhe erschloss, auf der die zum Schutz der Brücke bestimmten russischen Batterien standen, wurde plötzlich von dem durchsichtigen Schleier eines schräg fallenden Regens verhüllt, bald öffnete sie sich wieder dem Blick ebenso plötzlich, und man konnte im Sonnenschein selbst die fernsten Gegenstände glänzen sehen, als seien sie mit Lack überzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e3eebb06-3ae5-3917-aaa6-e73ae48a825a",
                        "entry_id": "6cd1dac9-603e-326b-ac3c-f9b51f81443a",
                        "glosses": [
                            "die Qualität, in der weit entfernte Gegenstände zu sehen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25347516-1bda-4ee0-aacd-c6e40f519489",
                                "sense_id": "e3eebb06-3ae5-3917-aaa6-e73ae48a825a",
                                "text": "Das Rückseitenwetter zeichnet sich durch besonders gute Fernsicht aus."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
