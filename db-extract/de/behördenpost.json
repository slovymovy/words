                    {
                        "sense_id": "7098da06-afb9-33e9-84f7-01f17b9a141d",
                        "entry_id": "07f29776-fb68-37be-800f-71d878ba8366",
                        "glosses": [
                            "Beförderung der Post von Behörden in der ehemaligen Sowjetischen Besatzungszone und danach der DDR"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b9a7cd-02da-4e29-8b2f-ec31cd23eefc",
                                "sense_id": "7098da06-afb9-33e9-84f7-01f17b9a141d",
                                "text": "„In der DDR wurde unter »Behördenpost« eine besonders gesicherte und schnellere Beförderungsart für Sendungen staatlicher Dienststellen verstanden, die von 1948 bis zu ihrer Ablösung durch den Zentralen Kurierdienst 1955 Bestand hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de4dd8cb-7c71-3d6f-8abc-643111ad9ea4",
                        "entry_id": "07f29776-fb68-37be-800f-71d878ba8366",
                        "glosses": [
                            "Beförderung der Post von Behörden zwischen West-Berlin und der Bundesrepublik Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8597567-74b6-4fb7-8efb-80dc999ee6c3",
                                "sense_id": "de4dd8cb-7c71-3d6f-8abc-643111ad9ea4",
                                "text": "„Eine weitere Variante der Behördenpost soll im Folgenden behandelt werden: Die Post zwischen Bundes- und Landesbehörden im Verkehr von West-Berlin in die Bundesrepublik Deutschland vor der Zeit der deutschen Wiedervereinigung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a3d3371b-f018-3d22-9e0a-7cb44a47508c",
                        "entry_id": "07f29776-fb68-37be-800f-71d878ba8366",
                        "glosses": [
                            "allgemein: Post von und an Behörden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c44024c4-f641-4434-aa01-14fd578c760c",
                                "sense_id": "a3d3371b-f018-3d22-9e0a-7cb44a47508c",
                                "text": "„Als übergeordneter Begriff bezeichnet »Behördenpost« alle Sendungen kommunaler oder staatlicher Dienststellen mit postalischen Sonderrechten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
