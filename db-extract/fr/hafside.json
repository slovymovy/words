                        "glosses": [
                            "Relatif aux Hafsides, dynastie ayant régné sur la Tunisie du XIIIᵉ au XVIᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "100a3fa6-304a-4fd4-adea-34a92558896e",
                                "sense_id": "a22a5dc7-a7ff-36f6-90ec-38b0ad4cdf5b",
                                "text": "Après une longue période de prospérité, tout le long du XVe siècle, sous la domination de la dynastie hafside, dont le règne s’étendit de 1236 à 1574, le XVIe siècle fut une période funeste pour la ville de Tunis."
                            }
                        ]
                    }
