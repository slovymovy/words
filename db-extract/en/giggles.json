                    },
                    {
                        "translation_id": "52dbc561-47f9-4f7b-ba2d-48ca8885af5e",
                        "source_entry_id": "0f08c604-3044-333f-b51e-dd6e70ed1db1",
                        "source_sense_id": "0191c97d-2d3c-35b2-95ba-bd7a3ccd921f",
