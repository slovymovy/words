                "senses": [
                    {
                        "sense_id": "09a5b226-e245-3678-8a4a-0cdcf5906627",
                        "entry_id": "c4b87141-69a1-3d5e-bcf9-83c56cf3c6d2",
                        "glosses": [
                            "сосуд с двойными стенками и вакуумом между ними, в котором вещества долго сохраняют температуру"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e280c14-5bf3-4237-9a42-45507673f78d",
                                "sense_id": "09a5b226-e245-3678-8a4a-0cdcf5906627",
                                "text": "Дьюар подвешивали на такой высоте, чтобы удобно наклонять, приставляя свой термос к длинной горловине."
                            }
                        ]
                    },
                    {
                        "sense_id": "3319c0cf-2bc7-365b-b6a3-98c44ab6a027",
                        "entry_id": "c4b87141-69a1-3d5e-bcf9-83c56cf3c6d2",
                        "glosses": [
                            "английская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41d6839-ef44-47d6-969c-0b7c92ac1605",
                                "sense_id": "3319c0cf-2bc7-365b-b6a3-98c44ab6a027",
                                "text": "20 января 1893 года британский физик и химик Джеймс Дьюар продемонстрировал сосуд для хранения сжиженных газов."
                            }
                        ]
                    }
