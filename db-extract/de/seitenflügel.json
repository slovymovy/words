                        "form": "den Seitenflügel"
                    },
                    {
                        "form_id": "4cd86af9-b9f5-4fd7-84ba-969fb91aa07c",
                        "entry_id": "4c125e48-d7c0-3c38-b423-06766e3befb1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Seitenflügel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "583596b1-217d-3557-8516-6efbf60f3926",
                        "entry_id": "4c125e48-d7c0-3c38-b423-06766e3befb1",
                        "glosses": [
                            "Gebäude an der Seite eines Gebäudekomplexes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4350656-7aea-4ed0-a5aa-0448b5e4f6bf",
                                "sense_id": "583596b1-217d-3557-8516-6efbf60f3926",
                                "text": "„Sie werden in die Stille eines Zimmers im Seitenflügel geführt.“"
                            },
                            {
                                "example_id": "60af433f-2a49-4185-96ff-e81731ee173f",
                                "sense_id": "583596b1-217d-3557-8516-6efbf60f3926",
                                "text": "„Die Gräfin hatte durch die Stubenmädchen sofort erfahren, was im Seitenflügel vorgefallen war.“"
                            },
                            {
                                "example_id": "6b2593d4-8c16-4fb4-a5d0-f1fb6c9a2359",
                                "sense_id": "583596b1-217d-3557-8516-6efbf60f3926",
                                "text": "„Dabei deutete sie durch das Fenster auf ein Zimmer, das an ihr Schlafzimmer angrenzte und im Seitenflügel lag, so daß ich, um in das Innere ihres Zimmers zu blicken, nicht einmal an das Fenster treten mußte.“"
                            },
                            {
                                "example_id": "4711b88b-b74d-40d8-bb24-9bc6a5108d53",
                                "sense_id": "583596b1-217d-3557-8516-6efbf60f3926",
                                "text": "„Gordon verneigte sich, und einen Augenblick später traten beide nach Passierung eines schon im Seitenflügel gelegenen und mit Philodendron und anderen Blattpflanzen fast überfüllten Raumes auf einen Vorbau hinaus, der, aus Stein aufgeführt, mehr einem nach vorn hin offenen Zimmer als einem Balkon glich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39b651ea-d45f-3ad5-b7c5-ba03f09a2e78",
                        "entry_id": "4c125e48-d7c0-3c38-b423-06766e3befb1",
                        "glosses": [
                            "seitlicher Flügel eines Gemäldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb6deb5-caf9-42d3-aa8a-6e4648f68911",
                                "sense_id": "39b651ea-d45f-3ad5-b7c5-ba03f09a2e78",
                                "text": "„So sieht der Teufelspakt auf einem Seitenflügel vom »Garten der Lüste« aus, einem um 1500 entstandenen Triptychon des Hieronymus Bosch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e9d1b0e-0a40-4896-9859-de33729a0588",
                        "source_entry_id": "4c125e48-d7c0-3c38-b423-06766e3befb1",
                        "source_sense_id": "583596b1-217d-3557-8516-6efbf60f3926",
                        "source_sense_description": "Gebäude an der Seite eines Gebäudekomplexes",
                        "target_lang_word": "aile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45e75b51-c99f-3ac6-a981-5c52fca66b1d",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Partie du corps d’un animal, tel qu’un oiseau, un insecte ou un chiroptère, lui permettant de voler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32d5e13-dd67-42ef-89a7-fe5a36598adf",
                                                "sense_id": "45e75b51-c99f-3ac6-a981-5c52fca66b1d",
                                                "text": "Ce sont les larves des pucerons […]. Complètement développées, ces larves deviennent de jolis insectes, pourvus de quatre ailes diaphanes, presque deux fois plus longues et plus larges que le corps entier, et soutenues par quelques rares nervures."
                                            },
                                            {
                                                "example_id": "92d8130f-6d6a-475b-be48-0c1cd98ee580",
                                                "sense_id": "45e75b51-c99f-3ac6-a981-5c52fca66b1d",
                                                "text": "Ses ailes de géant l’empêchent de marcher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e8b12f6-3d14-3d51-b5fa-9f4e48e61a04",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Cette partie d’une volaille préparée pour être mangée, qui comprend l’aile proprement dite et la portion charnue du haut de l’estomac au-dessus de la cuisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52672bf6-0bde-498f-8024-f837a2480b16",
                                                "sense_id": "5e8b12f6-3d14-3d51-b5fa-9f4e48e61a04",
                                                "text": "Servir une aile de perdreau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67e8868e-90ce-3701-a9dd-bd26ee9ef834",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Élément d’un avion destiné à assurer sa portance dans l’air ; grand châssis garni de toile d’un moulin à vent ; branche d’une hélice ou pale de l’hélicoptère."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19cae52a-1870-445e-82d6-d363838cdce7",
                                                "sense_id": "67e8868e-90ce-3701-a9dd-bd26ee9ef834",
                                                "text": "Un moulin à vent se compose essentiellement d'un arbre porté sur un petit bâtiment en bois, […]. Dans certains cas, le corps du moulin est fixe et forme une tour en maçonnerie, sur laquelle peut tourner la toiture en entraînant avec elle l'arbre et les ailes."
                                            },
                                            {
                                                "example_id": "fca33440-f977-4a8c-a119-45bdc48b4bd5",
                                                "sense_id": "67e8868e-90ce-3701-a9dd-bd26ee9ef834",
                                                "text": "Les ailes du ventilateur, ce hanneton, chassent comme des feuilles les cartes du mort étalées sur la table, […]."
                                            },
                                            {
                                                "example_id": "cefa7857-d66f-49c2-aab7-a0bc954386b1",
                                                "sense_id": "67e8868e-90ce-3701-a9dd-bd26ee9ef834",
                                                "text": "Dans le choc très brutal de l’amerrissage, un croisillonnage céda et l'extrémité de l’aile gauche baignait dans l'écume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e141aa-7ce6-366d-8357-9b05640ed21d",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Extension d’un édifice, généralement en deux parties jointes de chaque côté au corps principal du bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76ad28ff-85de-4637-ae67-931421232145",
                                                "sense_id": "00e141aa-7ce6-366d-8357-9b05640ed21d",
                                                "text": "Ces bois, étendus sur une centaine d’hectares, rejoignaient les deux ailes du château, une ancienne demeure, de style Louis XIII, à l’allure de ce qu’on appelle encore dans certaines campagnes une « maison de noblesse »."
                                            },
                                            {
                                                "example_id": "9aa6f912-6247-4735-a133-3176b35245c3",
                                                "sense_id": "00e141aa-7ce6-366d-8357-9b05640ed21d",
                                                "text": "De l’autre côté du mur, dans l’aile réservée aux femmes, il y a des jeunes filles dont nul n’a parlé : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c5a0f9-e244-383a-b228-590a9f5232d0",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Élément de carrosserie d’une voiture qui masque le haut des roues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c682d461-c53c-4cc6-b3c6-df43e528374f",
                                                "sense_id": "26c5a0f9-e244-383a-b228-590a9f5232d0",
                                                "text": "À la suite d'un accident, l’aile de ma voiture doit être changée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7336f7ff-d124-30b0-87d4-ae83430e9785",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Dent d’un pignon."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0964dc1f-0be2-3855-ae47-b2fff304d18f",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Chacune des extrémités d’une formation disposées à droite et à gauche du centre, face à l’adversaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ea9a59-697f-4a57-935a-42e5893cb989",
                                                "sense_id": "0964dc1f-0be2-3855-ae47-b2fff304d18f",
                                                "text": "L’aile droite d’une armée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea942ba8-1605-3317-9e99-932de8ddd914",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Élan."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ad8591f-e888-4a09-8a9b-c665a54b02de",
                                                "sense_id": "ea942ba8-1605-3317-9e99-932de8ddd914",
                                                "text": "C'est contre sa bigoterie, sa stupidité, la stupidité mesquine des médiocres qui veulent briser les ailes du génie, que Thea Kronborg devra livrer la plus dure des luttes qui la mèneront finalement au succès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea043c10-39b8-3407-a557-84cbd2c2464d",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Selon le contexte."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42858640-e2d8-3dd2-adc4-8f5fed4de57a",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Selon le contexte.",
                                            "Membrane bordant un organe ou le prolongeant."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c55d94-f4de-4cdc-9182-e914afb7e2b7",
                                                "sense_id": "42858640-e2d8-3dd2-adc4-8f5fed4de57a",
                                                "text": "samares à ailes convergentes, restant attachées sur l'arbre une partie de l'hiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f8bf6d-0c11-3686-98df-0c37b90d3855",
                                        "entry_id": "244a5391-c0f0-3e22-a2d4-eddf0d03309f",
                                        "glosses": [
                                            "Selon le contexte.",
                                            "Pétale latéral des fabacées, ou encore sépale latéral des polygalacées."
                                        ],
