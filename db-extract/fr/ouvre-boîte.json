                                        "entry_id": "9732e89b-93b0-3b8b-b3e6-b0aff2f6b18b",
                                        "glosses": [
                                            "ein Küchengerät, mit dem man Konservendosen öffnen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30b0c75-5c46-491c-82b8-9193a1f4cf03",
                                                "sense_id": "6c7be9e8-7710-3a29-965e-a5a6a1271fda",
                                                "text": "Hast du einen Dosenöffner?"
                                            },
                                            {
                                                "example_id": "44198bdd-61d4-4200-91d1-84a4f274c17a",
                                                "sense_id": "6c7be9e8-7710-3a29-965e-a5a6a1271fda",
                                                "text": "„Es war ein vielleicht längst ausrangierter Dosenöffner, aber durchaus noch brauchbar.“"
                                            },
                                            {
                                                "example_id": "cd4d53fe-2a51-48ed-9765-d88a987b1d4d",
                                                "sense_id": "6c7be9e8-7710-3a29-965e-a5a6a1271fda",
                                                "text": "„Er haute den Dosenöffner in die Bierdose, ruckelte ein wenig damit und versuchte, das Bier aus der kleinen gezackten Öffnung in ein Glas zu gießen.“"
                                            },
                                            {
                                                "example_id": "e586e99b-0b45-44c8-b46b-ed50f6ecbbcb",
                                                "sense_id": "6c7be9e8-7710-3a29-965e-a5a6a1271fda",
                                                "text": "„Bobby stopfte alles in eine leere Sporttasche und vergaß auch nicht, einen Dosenöffner mitzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
