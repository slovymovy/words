                        "glosses": [
                            "Détruire avec une grande efficacité et de manière brutale des soldats ou du matériel militaire adverses."
                        ],
                        "tags": [
                            "broadly",
                            "neologism"
                        ],
                        "note": "Terme utilisé principalement par les personnes soutenant l'Ukraine",
