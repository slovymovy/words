                ],
                "senses": [
                    {
                        "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                        "entry_id": "79fd063c-7360-3e4a-9162-70d560a1a9d2",
                        "glosses": [
                            "eine oder mehrere Aufnahmen (einer Kamera) oder ein Video, die man beispielsweise auf einem Monitor sehen kann"
                        ],
                        "tags": [
                            "Plural häufig"
                        ],
                        "examples": [
                            {
                                "example_id": "425cec1f-f1f9-44c8-bc80-d1782f67e952",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "Kamerabilder haben in der Coronapandemie wegen der Videokonferenzen Einzug in den Arbeitsalltag gefunden."
                            },
                            {
                                "example_id": "cccd75f0-51b7-45eb-8bae-12ff9272e68e",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "Eine Webcam aktualisiert die Kamerabilder regelmäßig, beispielsweise alle 15 Sekunden, jede Minute oder alle 5 Minuten."
                            },
                            {
                                "example_id": "c96679e6-b9dd-459c-84bd-766d56bef56d",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Bei der Gesichtserkennung werden zur Identifizierung einzelner Menschen Kamerabilder mit Datenbanken abgeglichen.“"
                            },
                            {
                                "example_id": "2dc7944a-2a96-46ec-b4db-12066d52e64e",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Der Unbekannte, der durch einen Ausgang in falscher Richtung in den Sicherheitsbereich gelangt war, konnte deshalb nicht identifiziert werden, weil die Kamerabilder von der Sicherheitsschleuse nicht aufgezeichnet wurden.“"
                            },
                            {
                                "example_id": "b7fd4b42-521b-4475-bb49-bcf7734a7972",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Kurz nach dem Anschlag waren zwei Männer aufgrund von Aussagen von Augenzeugen und Kamerabildern festgenommen worden.“"
                            },
                            {
                                "example_id": "73468f89-f820-4780-8e60-2237051de24a",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Die Auflösung des Kamerabildes ist mit 640 x 480 Pixel etwas minimalistisch ausgefallen.“"
                            },
                            {
                                "example_id": "7ceb9991-f05e-4f31-ba9b-35396714b36a",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "[Katzen:] „Die Kamerabilder bringen auch zu Tage, mit welcher Geschicklichkeit die Räuber nachts auf die Jagd gehen.“"
                            },
                            {
                                "example_id": "4a0860fa-231c-44ee-8d4f-301003f42ea1",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "[Wölfe in Dänemark:] „Als Anfang Juli die ersten Kamerabilder gleich acht Welpen zeigten, brach in vielen Medien Wolfsfieber aus.“"
                            },
                            {
                                "example_id": "88ffd03a-ac36-4ff8-b60d-8275ce77211c",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Die Stadt Vilshofen kann sich mit einem einzigartigen Bauwerk schmücken: Einer Haselmausbrücke über die neue Umgehungsstraße“ […] „Nun zeigen Kamerabilder aus dem Inneren der Brücke, dass sie tatsächlich von keiner Haselmaus genutzt wird.“"
                            },
                            {
                                "example_id": "43941503-90cf-40c1-89d2-fa80e6d3460a",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Das Grafiksystem muss Verzerrungen, die durch die verschiedenen Perspektiven, Kameraeinstellungen und auch Kamerabewegungen entstehen, in Echtzeit korrigieren, um das Kamerabild immer korrekt darzustellen.“"
                            },
                            {
                                "example_id": "e7990372-a2d2-463c-955f-70da9492e87e",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Alex Hirl wechselt zwischen Fotokamera und Computer hin und her. Er macht die Kamerabilder und fügt sie in einer Animationssoftware aneinander.“"
                            },
                            {
                                "example_id": "02c94339-a8f4-4fe7-8f5b-377ebe5335d5",
                                "sense_id": "9d27fe15-68c4-3de6-a289-7f619488ff50",
                                "text": "„Im Rennen Computer gegen Pilot unterlag erstmals der Mensch, die autonome Drohne war schneller.“ […] „Möglich machen das Algorithmen, die sehr schnell Kamerabilder auswerten und der Drohne im Bruchteil einer Sekunde ihre Position vermitteln können, sodass sie Hindernissen rechtzeitig ausweichen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
