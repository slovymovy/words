                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c7b3f9a-af23-389e-a262-64f8df59092d",
                        "entry_id": "c635a22f-ea5f-3965-b650-9155b812ba8b",
                        "glosses": [
                            "Druckverlust oder auch ungewollter Luftverlust, durch undichte Stellen in einem technischen System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139f5db3-da35-4de6-a97b-b933fd3b8075",
                                "sense_id": "2c7b3f9a-af23-389e-a262-64f8df59092d",
                                "text": "„Das nicht separate Ausweisen der Leckluft stellt eine Unzulänglichkeit dar, die den Anlagenbauer nach Anlagenerrichtung in Schwierigkeiten bringen kann, wenn die nach DIN EN 13779 geforderten Funktionsprüfungen nach DIN EN 12599 nicht die Erfüllung der Anforderungen bestätigt bzw. der SFP zu hoch ist.“"
                            },
                            {
                                "example_id": "849b1df6-33cd-41a1-bc63-5363cf87cefc",
                                "sense_id": "2c7b3f9a-af23-389e-a262-64f8df59092d",
                                "text": "„Der weitere Nachteil ergibt sich aus dem Problem der Leckluft.“"
                            },
                            {
                                "example_id": "0cb16ad5-80c1-4d3d-83c3-b455ddfea4b0",
                                "sense_id": "2c7b3f9a-af23-389e-a262-64f8df59092d",
                                "text": "„Sowohl die dabei entweichende Luft, als auch die Fluidisierungsluft und die Leckluft werden über den integrierten druckluftabgereinigten Filter ins Freie geführt.“"
                            },
                            {
                                "example_id": "4935d54f-8e72-438d-b1bb-065b871c65d4",
                                "sense_id": "2c7b3f9a-af23-389e-a262-64f8df59092d",
                                "text": "„Durch die gezielte Eindüsung der Förderluft mit hoher Geschwindigkeit durch den Injektor, parallel zur Achse des Zellenrades, können die Leckluft minimiert und die Förderluft praktisch vollständig für die pneumatische Förderung genutzt werden.“"
                            },
                            {
                                "example_id": "30678d5a-4193-41c4-81c2-ebb92378cce6",
                                "sense_id": "2c7b3f9a-af23-389e-a262-64f8df59092d",
                                "text": "„Die neue Baureihe überzeugt wie gewohnt durch die robuste und zuverlässige Bauweise mit geringer Leckluft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
