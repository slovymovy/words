                    {
                        "translation_id": "f16a6e5b-6748-4eb9-949c-f8b4a3fbed67",
                        "source_entry_id": "89d98b53-7db7-3b3d-99e9-4027f044f4fd",
                        "source_sense_id": "2d58d18a-0379-3747-aef1-89d01e554d0a",
                        "target_lang_word": "chewing-gum",
