                                        "glosses": [
                                            "A medieval mercenary."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "freelance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39c2a8af-1bb5-3cf1-9231-2e50e87fd34a",
                                        "entry_id": "be57ea1c-97dd-394a-aac7-97e334be5276",
                                        "glosses": [
                                            "Of, or relating to a freelance; without employment contract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a8ef0b5-fb65-4486-89ca-5ee46ccef92c",
                                                "sense_id": "39c2a8af-1bb5-3cf1-9231-2e50e87fd34a",
                                                "text": "He was a freelance writer for several magazines."
                                            },
                                            {
                                                "example_id": "b3ada980-d8ef-4a44-8f33-bdc1123a2f5d",
                                                "sense_id": "39c2a8af-1bb5-3cf1-9231-2e50e87fd34a",
                                                "text": "Both work -- Jenny as a freelance writer from home, Marc full-time-plus as a civil engineer with a long commute. Jenny also takes care of their four sons, ages 20 months to 9 years, and homeschools the two oldest."
                                            }
                                        ]
                                    }
                                ]
