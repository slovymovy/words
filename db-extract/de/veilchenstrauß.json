                ],
                "senses": [
                    {
                        "sense_id": "6cd9da5f-fca6-3940-bc12-5b143bcc970e",
                        "entry_id": "dac43724-8f85-3153-ac37-2d08cfbf0fa8",
                        "glosses": [
                            "Blumenstrauß aus Veilchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343ff756-85a5-4b86-a1d3-a54ba533423a",
                                "sense_id": "6cd9da5f-fca6-3940-bc12-5b143bcc970e",
                                "text": "„[…] und bei der Beerdigung von Lawrence tauchte plötzlich ein unbekanntes, etwa zwölfjähriges Mädchen auf und warf einen Veilchenstrauß ins Grab.“"
                            },
                            {
                                "example_id": "d3dc0e4b-54de-4cd9-8a7a-d97677fd6187",
                                "sense_id": "6cd9da5f-fca6-3940-bc12-5b143bcc970e",
                                "text": "„Denn sie hab es wohl gesehen, daß Victoire neben dem großen, für die Mama bestimmten Veilchenstrauß auch noch einen kleinen Strauß in der Hand gehalten hätte, den habe sie dem lieben Bräutigam, dem Herrn von Schach, in der Kürchentüre präsentieren wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
