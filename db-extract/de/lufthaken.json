                                    {
                                        "sense_id": "6ac3d808-d1b8-3c7a-b6fd-5493265c4fe1",
                                        "entry_id": "51836f8f-8dd7-351b-a53b-b3c69bb220c4",
                                        "glosses": [
                                            "A futile search, a fruitless errand; a useless and often lengthy task whose execution is inordinately complex relative to the value of the outcome."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c39e6d9b-a8e7-4401-906e-382b86377b11",
                                                "sense_id": "6ac3d808-d1b8-3c7a-b6fd-5493265c4fe1",
                                                "text": "I went on a wild-goose chase all over the town looking for that adapter until I discovered they no longer make them."
                                            },
                                            {
                                                "example_id": "24a38c01-aa5d-4218-b7e2-7f1c7c9381e5",
                                                "sense_id": "6ac3d808-d1b8-3c7a-b6fd-5493265c4fe1",
                                                "text": "Diagnosing this software application's problems is a wild-goose chase because it is built in an environment that has poor debugging tools."
                                            },
                                            {
                                                "example_id": "ba94ede4-8b01-4b0e-93c7-30e751945274",
                                                "sense_id": "6ac3d808-d1b8-3c7a-b6fd-5493265c4fe1",
                                                "text": "From the beginning he has never concealed his belief that Professor Challenger is an absolute fraud, that we are all embarked upon an absurd wild-goose chase and that we are likely to reap nothing but disappointment and danger in South America, and corresponding ridicule in England."
                                            }
                                        ]
                                    }
                                ]
                            }
