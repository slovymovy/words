    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                "word": "Semitic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00d48b85-23f6-39d4-96f1-5566fe7de1f8",
                        "entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "glosses": [
                            "Of or pertaining to a subdivision of Afroasiatic Semitic languages: Amharic, Arabic, Aramaic, Syriac, Akkadian, Hebrew, Maltese, Tigrigna, Phoenician etc."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2169b7ab-8054-3844-b29a-40a50fc3387c",
                        "entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "glosses": [
                            "Of or pertaining to the Semites; of or pertaining to one or more Semitic peoples."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "558f36c6-a21f-4ed4-ab2a-f2c36e62cc4e",
                                "sense_id": "2169b7ab-8054-3844-b29a-40a50fc3387c",
                                "text": "On the other hand, scholars say that the Philistines were an Indo-European people not related to the Semitic Palestinians."
                            },
                            {
                                "example_id": "11b25bc4-a7d7-427c-8c73-5c17aadbef40",
                                "sense_id": "2169b7ab-8054-3844-b29a-40a50fc3387c",
                                "text": "For quotations using this term, see Citations:Semitic."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d19d147-3527-34b5-b913-838903523dba",
                        "entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "glosses": [
                            "Of or pertaining to the Semites; of or pertaining to one or more Semitic peoples.",
                            "Of or pertaining to the descendants of Shem, the eldest of three sons of Noah."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "de83fe72-612c-3da4-84d8-7381fa5fd14a",
                        "entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "glosses": [
                            "Of or pertaining to the Semites; of or pertaining to one or more Semitic peoples.",
                            "Of or pertaining to the Israeli, Jewish, or Hebrew people."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e5143d6c-1edb-3ad8-816b-eea0427cb246",
                        "entry_id": "7a69e8e8-c07a-3b22-88e9-87bc6be4f541",
                        "glosses": [
                            "Of or pertaining to the Semites; of or pertaining to one or more Semitic peoples.",
                            "Of or pertaining to any of the religions which originated among the Semites; Abrahamic."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6e25b859-073b-4b99-8922-5d92ba353d59",
                                "sense_id": "e5143d6c-1edb-3ad8-816b-eea0427cb246",
                                "text": "Thus we trace ever and again the similarities which are to be found among the Semitic religions."
                            },
                            {
                                "example_id": "35697fa2-7c89-42c4-b2a9-03be8ea97066",
                                "sense_id": "e5143d6c-1edb-3ad8-816b-eea0427cb246",
                                "text": "The Semitic religions (Christianity and Islam) are nationally honored in much of Africa."
                            },
                            {
                                "example_id": "1b871158-bd92-42e4-95e0-d18f5c28a9fe",
                                "sense_id": "e5143d6c-1edb-3ad8-816b-eea0427cb246",
                                "text": "In contrast to these Semitic religions some religions of Indian origin like Buddhism and Jainism, are pacifist to the extent of banning the killing of animals even for food."
                            }
                        ]
                    }
                ],
