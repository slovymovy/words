                                "target_senses": [
                                    {
                                        "sense_id": "49d96a0c-faae-35ef-a7ce-e64620dff69d",
                                        "entry_id": "ee687fc0-66e4-3f06-aecf-3915adff2325",
                                        "glosses": [
                                            "Inoculación de vacunas para proteger de una enfermedad o cepa de una enfermedad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
