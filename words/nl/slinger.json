{
    "word_family": [
        "slingeren",
        "slingering",
        "slingeraap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e238575-bcba-36d1-a7c1-095a18733af1",
                    "sense_definition": "feestelijke decoratie in de vorm van een lang lint of een snoer van vlaggetjes",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "decoratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor zijn verjaardag hingen we een kleurrijke <w>slinger</w> in de woonkamer.",
                            "target_lang_translations": {
                                "en": "For his birthday, we hung a colorful <w>garland</w> in the living room."
                            }
                        },
                        {
                            "text": "Zij kocht een lange <w>slinger</w> met vlaggetjes voor het tuinfeest.",
                            "target_lang_translations": {
                                "en": "She bought a long <w>bunting</w> for the garden party."
                            }
                        }
                    ],
                    "synonyms": [
                        "guirlande"
                    ],
                    "common_phrases": [
                        "slingers ophangen"
                    ],
                    "target_lang_definitions": {
                        "en": "festive decoration in the form of a long ribbon, garland, or string of bunting/streamers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "garland",
                                "target_lang_sense_clarification": "decorative hanging chain of ribbons, greenery, or flowers"
                            },
                            {
                                "target_lang_word": "streamer",
                                "target_lang_sense_clarification": "long ribbon of paper used as party decoration"
                            },
                            {
                                "target_lang_word": "bunting",
                                "target_lang_sense_clarification": "string of small decorative flags"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ecdaac5-7f4a-3455-959c-c26f0e87e7b3",
                    "sense_definition": "hangend voorwerp dat regelmatig heen en weer beweegt, zoals in een klok",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>slinger</w> van de oude klok tikt rustig heen en weer.",
                            "target_lang_translations": {
                                "en": "The <w>pendulum</w> of the old clock ticks quietly back and forth."
                            }
                        },
                        {
                            "text": "Als de <w>slinger</w> stopt, loopt het hele uurwerk niet meer.",
                            "target_lang_translations": {
                                "en": "When the <w>pendulum</w> stops, the whole clock mechanism stops running."
                            }
                        }
                    ],
                    "synonyms": [
                        "pendule"
                    ],
                    "common_phrases": [
                        "de slinger van de klok"
                    ],
                    "target_lang_definitions": {
                        "en": "hanging object that swings regularly back and forth, such as inside a clock"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pendulum",
                                "target_lang_sense_clarification": "swinging weight in a clock mechanism"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0524660-7bcc-3437-8c30-c7311cedc949",
                    "sense_definition": "krachtige zwaaiende beweging",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een flinke <w>slinger</w> gooide hij de bal over het hek.",
                            "target_lang_translations": {
                                "en": "With a powerful <w>fling</w>, he threw the ball over the fence."
                            }
                        },
                        {
                            "text": "Hij gaf een harde <w>slinger</w> aan het touw om het los te maken.",
                            "target_lang_translations": {
                                "en": "He gave a hard <w>yank</w> to the rope to untangle it."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaai"
                    ],
                    "common_phrases": [
                        "een slinger geven"
                    ],
                    "target_lang_definitions": {
                        "en": "powerful swinging or sweeping movement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "sweeping or throwing motion"
                            },
                            {
                                "target_lang_word": "fling",
                                "target_lang_sense_clarification": "forceful throw or movement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17155e08-0969-3484-9952-d499f7849618",
                    "sense_definition": "historisch wapen waarmee men projectielen zoals stenen wegslingert",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "David versloeg de reus Goliath met een steen uit zijn <w>slinger</w>.",
                            "target_lang_translations": {
                                "en": "David defeated the giant Goliath with a stone from his <w>sling</w>."
                            }
                        },
                        {
                            "text": "Soldaten gebruikten vroeger een leren <w>slinger</w> om vijanden op afstand te bestrijden.",
                            "target_lang_translations": {
                                "en": "Soldiers in the past used a leather <w>sling</w> to fight enemies at a distance."
                            }
                        }
                    ],
                    "synonyms": [
                        "werptuig"
                    ],
                    "target_lang_definitions": {
                        "en": "historical weapon used to hurl projectiles such as stones"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sling",
                                "target_lang_sense_clarification": "strap weapon for hurling stones"
                            },
                            {
                                "target_lang_word": "slingshot",
                                "target_lang_sense_clarification": "projectile weapon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92e10086-4dd0-3cf5-bce3-0f596271205c",
                    "sense_definition": "kronkelende of golvende lijn",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rivier maakt een opvallende <w>slinger</w> door het groene landschap.",
                            "target_lang_translations": {
                                "en": "The river makes a striking <w>bend</w> through the green landscape."
                            }
                        },
                        {
                            "text": "Met een sierlijke <w>slinger</w> tekende hij een patroon op papier.",
                            "target_lang_translations": {
                                "en": "With a graceful <w>flourish</w>, he drew a pattern on paper."
                            }
                        }
                    ],
                    "synonyms": [
                        "kronkel",
                        "bocht"
                    ],
                    "target_lang_definitions": {
                        "en": "winding, meandering, or curving line or bend"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "curve in a road or river"
                            },
                            {
                                "target_lang_word": "meander",
                                "target_lang_sense_clarification": "winding curve"
                            },
                            {
                                "target_lang_word": "swirl",
                                "target_lang_sense_clarification": "curling line or flourish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e4e79db-afbb-31d0-82ac-59d60a1b3eb5",
                    "sense_definition": "handvat of hefboom waarmee men een mechanisme of oude motor handmatig aandraait",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De chauffeur draaide aan de <w>slinger</w> om de oude auto te starten.",
                            "target_lang_translations": {
                                "en": "The driver turned the <w>crank</w> to start the old car."
                            }
                        },
                        {
                            "text": "Met een losse <w>slinger</w> bracht men vroeger de motor op gang.",
                            "target_lang_translations": {
                                "en": "In the past, people used a detachable <w>starting handle</w> to get the engine running."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwengel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verouderd onderdeel voor voertuigen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "handle or lever used to manually turn a mechanism or start an old engine"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crank",
                                "target_lang_sense_clarification": "rotating handle for starting an engine or turning a machine"
                            },
                            {
                                "target_lang_word": "starting handle",
                                "target_lang_sense_clarification": "manual handle used to start early motor vehicles"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e35b5e51-ccb7-35d3-aea4-c03dee2d9889",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>slingeren</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>slinger</w> de oude jas meteen in de wasmand.",
                            "target_lang_translations": {
                                "en": "I <w>fling</w> the old jacket straight into the laundry basket."
                            }
                        },
                        {
                            "text": "Wanneer ik moe ben, <w>slinger</w> ik soms een beetje op de fiets.",
                            "target_lang_translations": {
                                "en": "When I am tired, I sometimes <w>swerve</w> a bit on my bike."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'slingeren': to swing, fling, or swerve"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fling",
                                "target_lang_sense_clarification": "first-person present of fling/throw"
                            },
                            {
                                "target_lang_word": "swerve",
                                "target_lang_sense_clarification": "first-person present of swerve/zigzag"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "first-person present of swing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1d82204-a242-3d5d-84ae-4ded8d728514",
                    "sense_definition": "gebiedende wijs van <w>slingeren</w>",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Slinger</w> die bal nu eindelijk eens naar de overkant!",
                            "target_lang_translations": {
                                "en": "<w>Hurl</w> that ball over to the other side already!"
                            }
                        },
                        {
                            "text": "<w>Slinger</w> niet zo wild heen en weer op die schommel!",
                            "target_lang_translations": {
                                "en": "Don't <w>swing</w> back and forth so wildly on that swing!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'slingeren': swing, fling, or swerve"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fling",
                                "target_lang_sense_clarification": "imperative: throw forcefully"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "imperative: move back and forth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24cfa6ab-5433-32e7-8dfc-8ddc18a3ea00",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd (inversie) van <w>slingeren</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>slinger</w> je zo vreemd over de weg?",
                            "target_lang_translations": {
                                "en": "Why are you <w>swerving</w> so strangely across the road?"
                            }
                        },
                        {
                            "text": "<w>Slinger</w> je die tas even naar mij toe?",
                            "target_lang_translations": {
                                "en": "Can you <w>toss</w> that bag over to me?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversievorm van de tweede persoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present tense (inverted) of 'slingeren': swing, fling, or swerve"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swerve",
                                "target_lang_sense_clarification": "second-person present (inverted)"
                            },
                            {
                                "target_lang_word": "toss",
                                "target_lang_sense_clarification": "second-person present (inverted)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}