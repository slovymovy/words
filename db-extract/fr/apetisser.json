                "senses": [
                    {
                        "sense_id": "9f988e09-96e1-3be1-8f56-9b42d2897134",
                        "entry_id": "4fe0cab4-814f-3838-8f5a-7abb2da1b1fb",
                        "glosses": [
                            "Rendre plus petit."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "471ed8ac-fb06-4588-9593-e2710abb7dcf",
                                "sense_id": "9f988e09-96e1-3be1-8f56-9b42d2897134",
                                "text": "Je crois avec La Fontaine, meilleur philosophe que Descartes, que les animaux, surtout à l’état de nature, sont ingénieux et pleins d’art. En les domestiquant, nous apetissons, nous dépravons leur coeur et leur esprit."
                            }
                        ]
                    },
                    {
                        "sense_id": "52ff1239-bbd7-3205-83a5-272ba25aac28",
                        "entry_id": "4fe0cab4-814f-3838-8f5a-7abb2da1b1fb",
                        "glosses": [
                            "Devenir plus petit."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "73fc3553-9ca8-4cb9-8c93-d3fdcfcc9813",
                                "sense_id": "52ff1239-bbd7-3205-83a5-272ba25aac28",
                                "text": "Après le solstice d’été, les jours apetissent."
                            },
                            {
                                "example_id": "9bc4eef1-82a1-418e-83ed-d3849326edc5",
                                "sense_id": "52ff1239-bbd7-3205-83a5-272ba25aac28",
                                "text": "Le sable, ça change de place... ça fait que La Pointe apetissait tout le temps."
                            }
                        ]
                    }
                ],
