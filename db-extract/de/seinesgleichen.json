                "forms": [],
                "senses": [
                    {
                        "sense_id": "0056ef2b-961f-30e3-b1e0-11090e9541e3",
                        "entry_id": "a58a6218-000a-3618-b927-528d4a2e9ce8",
                        "glosses": [
                            "jemand/etwas von gleicher Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c8a2ab-9e9e-4075-b065-e7750b5306a1",
                                "sense_id": "0056ef2b-961f-30e3-b1e0-11090e9541e3",
                                "text": "Alexander von Humboldt ist diesen Morgen für einige Stunden bei mir gewesen. Was ist das für ein Mann! Ich kenne ihn so lange und bin doch von neuem über ihn in Erstaunen. Man kann sagen, er hat an Kenntnissen und lebendigem Wissen nicht seinesgleichen."
                            },
                            {
                                "example_id": "4572ff1a-db92-4442-bfb4-08650f19d552",
                                "sense_id": "0056ef2b-961f-30e3-b1e0-11090e9541e3",
                                "text": "„Wenn man die Umstände für sich hat, so hat man nicht seinesgleichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab912475-fad6-4268-beef-5d7f6258d7af",
                        "source_entry_id": "a58a6218-000a-3618-b927-528d4a2e9ce8",
                        "source_sense_id": "0056ef2b-961f-30e3-b1e0-11090e9541e3",
                        "source_sense_description": "jemand/etwas von gleicher Art",
                        "target_lang_word": "semblable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semblable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58809119-3a15-3e61-82bf-81e8085d1548",
                                        "entry_id": "bd8820ec-9af8-3252-be76-f62701a0e115",
                                        "glosses": [
                                            "Qui est pareil, ressemblant, qui est de même nature, de même qualité, qui a des caractères communs, similaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbbc26d-ba8c-4581-b180-59f2c4eaec16",
                                                "sense_id": "58809119-3a15-3e61-82bf-81e8085d1548",
                                                "text": "Semblable au déplorable malade d’Edgar Poë, Durtal entendait avec terreur des frôlements de pas dans les escaliers, des cris plaintifs derrière les portes."
                                            },
                                            {
                                                "example_id": "d2b0cd1e-6016-40fc-ac1f-1ccc3c262bf4",
                                                "sense_id": "58809119-3a15-3e61-82bf-81e8085d1548",
                                                "text": "Quant au seul motif de la tête du Christ, il montre des similitudes significatives avec celui de la Pietà de Souain-Perthes-lès-Hurlus, dans le département de la Marne ; il s'agit là d'une tête d'un volume très semblable, au visage structuré par les mêmes rapports de proportions, et caractérisé par le même abandon et une semblable dispersion de la chevelure, glissant sur le côté gauche du cou et chutant sur l'épaule et le bras droits."
                                            },
                                            {
                                                "example_id": "935cb7dc-f7d5-4a0a-8e55-caefdc0b5fc3",
                                                "sense_id": "58809119-3a15-3e61-82bf-81e8085d1548",
                                                "text": "Des paroles semblables,"
                                            },
                                            {
                                                "example_id": "a0f83630-73b7-4346-bbfd-31f74af2d16c",
                                                "sense_id": "58809119-3a15-3e61-82bf-81e8085d1548",
                                                "text": "De semblables discours, de semblables projets, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6359f3ca-782b-3c71-a581-3cb6ec705e06",
                                        "entry_id": "bd8820ec-9af8-3252-be76-f62701a0e115",
                                        "glosses": [
                                            "Qualifie deux ou plusieurs figures géométriques qui ont leurs angles égaux, chacun à chacun, et dans lesquelles, en outre, les côtés qui comprennent ces angles sont proportionnels."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5a6c560-121f-4879-884c-a6e0d6d28045",
                                                "sense_id": "6359f3ca-782b-3c71-a581-3cb6ec705e06",
                                                "text": "Triangles semblables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semblable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5130f00-4640-345a-9b26-5e5e5b80e89f",
                                        "entry_id": "5861ec11-351d-367d-bdbb-44096a0e3edf",
                                        "glosses": [
                                            "Humain qui partage la même humanité, la même dignité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0619d4b1-3390-45c5-9efc-cf8a4bd15d5b",
                                                "sense_id": "b5130f00-4640-345a-9b26-5e5e5b80e89f",
                                                "text": "Je suis un petit V.R.P. Avec mes modestes semblables, je hante de modestes hôtels incroyables de cambrousse, à Ciron, à Scoury, à Migné et j'en passe !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1b4f1fb-3bc0-3c94-a85f-bda98bc3e50e",
                                        "entry_id": "5861ec11-351d-367d-bdbb-44096a0e3edf",
                                        "glosses": [
                                            "Les autres hommes, sans distinction de race et de civilisation."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a2f4b3-6672-42c7-b5e1-b4278c27560b",
                                                "sense_id": "d1b4f1fb-3bc0-3c94-a85f-bda98bc3e50e",
                                                "text": "L’humanité nous oblige à avoir pitié de nos semblables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f5b8a3d-c2e5-44de-9c05-a323c638ef71",
                        "source_entry_id": "a58a6218-000a-3618-b927-528d4a2e9ce8",
                        "source_sense_id": "0056ef2b-961f-30e3-b1e0-11090e9541e3",
                        "source_sense_description": "jemand/etwas von gleicher Art",
                        "target_lang_word": "pair",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9033ed5-b1e8-3dd8-a4f2-57567bdbf02c",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Personne de même condition et de même rang dans l’état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d3cca2-8403-4434-8398-6ecdb0ae067b",
                                                "sense_id": "c9033ed5-b1e8-3dd8-a4f2-57567bdbf02c",
                                                "text": "Le trisaïeul de son trisaïeul était l’égal, le compagnon, le pair du roi ; à ce titre il est lui-même d’une classe privilégiée, celle des gentilshommes […]"
                                            },
                                            {
                                                "example_id": "80997b6f-4504-44b4-a740-569545a2eb2a",
                                                "sense_id": "c9033ed5-b1e8-3dd8-a4f2-57567bdbf02c",
                                                "text": "Elle ne répond pas ; elle ne se penche point : c’est la duchesse. Je la tiens donc, celle qui ne veut embrasser que ses pairs et refusa, le jour où elle eut trente ans, à la dernière Assomption, de serrer la main du paysan qui lui offrait le bouquet des métayers. Si je les vengeais, et la dénonçais soudain, au beau milieu de la fête."
                                            },
                                            {
                                                "example_id": "7ddc8452-1c29-4c27-b6c6-db4bd0842e55",
                                                "sense_id": "c9033ed5-b1e8-3dd8-a4f2-57567bdbf02c",
                                                "text": "Elle l’appelait « chef » pour la première fois, entrevoyant que la substitution des contrats lui ouvrait la voie à une position nouvelle, où elle traiterait désormais avec lui de pair à compagnon."
                                            },
                                            {
                                                "example_id": "1c87a110-2a7b-435d-905a-1f4a8ab25656",
                                                "sense_id": "c9033ed5-b1e8-3dd8-a4f2-57567bdbf02c",
                                                "text": "Être jugé par ses pairs. — Ses pairs ont approuvé sa décision."
                                            },
                                            {
                                                "example_id": "98bd64f5-d783-40f2-b032-e7bf2bc46860",
                                                "sense_id": "c9033ed5-b1e8-3dd8-a4f2-57567bdbf02c",
                                                "text": "Les pirates s'entendoient & partageoient leurs rapines avec les juges, et diſoient qu'ils étoient jugés par leurs pairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73819a30-154a-36df-aa30-01949c7f81a1",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Titre de dignité porté au Moyen Âge par les grands vassaux du roi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c1a4f8d-01d6-4ef1-9600-2a3c11d3fa5c",
                                                "sense_id": "73819a30-154a-36df-aa30-01949c7f81a1",
                                                "text": "Il y avait six pairs ecclésiastiques. — Les douze pairs de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e819427-949f-3155-bb18-9ec3d12041c9",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Seigneur qui possédait des terres érigées en pairies et qui avaient droit de séance au parlement de Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a56893-edf8-41b7-8a8a-14d2a0af3e9e",
                                                "sense_id": "9e819427-949f-3155-bb18-9ec3d12041c9",
                                                "text": "La cour des pairs. — Le roi fit tel seigneur duc et pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf42fe25-85d8-3b6f-887c-51622ad940be",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Membre de la Chambre des pairs en France de 1815 à 1848."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed7ddf4-0730-4156-a11b-d19bd65e75b6",
                                                "sense_id": "cf42fe25-85d8-3b6f-887c-51622ad940be",
                                                "text": "Je vais aller prendre des leçons près d’elle : elle a su faire d’un mari bien médiocre un pair de France, d’un homme nul une capacité politique."
                                            },
                                            {
                                                "example_id": "2ba0eefa-65f7-45fc-ab37-c3556594b8d4",
                                                "sense_id": "cf42fe25-85d8-3b6f-887c-51622ad940be",
                                                "text": "[…] l’assassinat de la duchesse de Praslin, par son mari, pair de France, accrurent l’irritation publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3934ea-4bf2-3bc1-925b-65a2a6c33a3f",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Membre de la Chambre des Lords en Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84f6753-852d-401b-b7f4-2ad3c0a5cac9",
                                                "sense_id": "fe3934ea-4bf2-3bc1-925b-65a2a6c33a3f",
                                                "text": "Aussi l’Angleterre admet-elle les majorats dans les grandes familles, chez les pairs du royaume, tandis que la France défend aux parents d’exhéréder leurs enfants, ne leur laisse la libre disposition de ce qu’ils possèdent que dans de certaines limites […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "152bf90a-cd82-32c6-8a82-31094942bf99",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Mâle ou femelle de certains oiseaux, et particulièrement de la tourterelle, en parlant de l’un par rapport à l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12faa0e4-5986-4f53-ab09-4ef8e5906387",
                                                "sense_id": "152bf90a-cd82-32c6-8a82-31094942bf99",
                                                "text": "Quand la tourterelle a perdu son pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d36c29b-3016-3250-b773-0560b7223558",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Parité de change qui résulte de la comparaison du prix d’une espèce dans un pays avec le prix de la même espèce dans un autre pays."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3f76cdd-395e-49b6-bf43-785f945bc563",
                                                "sense_id": "3d36c29b-3016-3250-b773-0560b7223558",
                                                "text": "Le change est au pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeac9ef3-14a6-3d0a-9e7d-a129e681cd2f",
                                        "entry_id": "137b5ce5-a436-35de-8058-153cc9372daf",
                                        "glosses": [
                                            "Personne faisant le même métier, occupant la même profession, une fonction similaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9355ab9-d301-446b-b726-f716d466af78",
                                                "sense_id": "aeac9ef3-14a6-3d0a-9e7d-a129e681cd2f",
                                                "text": "Leurs recherches, qui n'ont pas encore été évaluées par les pairs, se fondent sur une étude menée entre avril et novembre 2020 auprès de 12 180 soignants employés dans les hôpitaux universitaires d'Oxford."
                                            },
                                            {
                                                "example_id": "7156457d-7919-4260-aeb3-de066c04d743",
                                                "sense_id": "aeac9ef3-14a6-3d0a-9e7d-a129e681cd2f",
                                                "text": "Dr Chaïmaa Abdel-Illah a toujours cru dans le rôle de la Femme et s’est battue pour l’autonomisation de ses paires, soulignant qu’Eve est capable d’assumer n’importe quelle responsabilité ou fonction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c064cdaa-e7ab-3b8b-ae68-f004a24724cd",
                                        "entry_id": "e7ecf240-c44a-3104-b7b2-0a7f6a6ba504",
                                        "glosses": [
                                            "Qui est égal, semblable, pareil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77e0473-3e41-4b7b-bfa7-8964e96132dd",
                                                "sense_id": "c064cdaa-e7ab-3b8b-ae68-f004a24724cd",
                                                "text": "C’est un homme sans pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c640262a-164b-384d-a479-8ed72350f47e",
                                        "entry_id": "e7ecf240-c44a-3104-b7b2-0a7f6a6ba504",
                                        "glosses": [
                                            "Dont la division par deux résulte en un nombre entier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419e663a-bd86-4884-b18a-1af13c86c0ce",
                                                "sense_id": "c640262a-164b-384d-a479-8ed72350f47e",
                                                "text": "Le nombre deux est le seul nombre pair qui soit premier."
                                            },
                                            {
                                                "example_id": "5fe80745-9531-4534-98a1-416612fcd16a",
                                                "sense_id": "c640262a-164b-384d-a479-8ed72350f47e",
                                                "text": "La série paire, la série impaire des numéros."
                                            },
                                            {
                                                "example_id": "93e00cda-870b-49c1-a0a9-e7ad1af4ab99",
                                                "sense_id": "c640262a-164b-384d-a479-8ed72350f47e",
                                                "text": "Années paires."
                                            },
                                            {
                                                "example_id": "f5b3be9c-b444-44d7-9bd4-2335d4b4dd3a",
                                                "sense_id": "c640262a-164b-384d-a479-8ed72350f47e",
                                                "text": "ARGAN : Monsieur, combien est-ce qu’il faut mettre de grains de sel dans un œuf ?\nMONSIEUR DIAFOIRUS : Six, huit, dix, par les nombres pairs, comme dans les médicaments, par les nombres impairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206633e5-df31-38df-ad9c-a82569c0c6a9",
                                        "entry_id": "e7ecf240-c44a-3104-b7b2-0a7f6a6ba504",
                                        "glosses": [
                                            "Un nombre entier est dit pair quand il est divisible par deux. Par exemple, dix est un nombre pair."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "874999e0-0479-3257-90fa-7a715b9b8d70",
                                        "entry_id": "e7ecf240-c44a-3104-b7b2-0a7f6a6ba504",
                                        "glosses": [
                                            "Se dit d’une fonction à variable réelle qui prend la même valeur en un réel donné qu’en l’opposé de ce réel donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e0bc672-87a0-4928-85cd-9dbb04368ad0",
                                                "sense_id": "874999e0-0479-3257-90fa-7a715b9b8d70",
                                                "text": "La fonction cosinus est paire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40989d1a-cbcf-393c-b207-0b82bbe6885e",
                                        "entry_id": "e7ecf240-c44a-3104-b7b2-0a7f6a6ba504",
                                        "glosses": [
                                            "Qui présente une symétrie bilatérale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "539cca7e-8aa4-4639-9697-6b5c5118b96e",
                                                "sense_id": "40989d1a-cbcf-393c-b207-0b82bbe6885e",
                                                "text": "Le cerveau, constitué de deux hémisphères peu ou prou identiques, est un organe pair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
