                    },
                    {
                        "form_id": "da8ffc3d-e64c-4cc1-933e-98e1d02afd0c",
                        "entry_id": "5d450719-bd70-3b34-a5f5-969a887d4329",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\u.blɔ.njɛʁ\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                        "entry_id": "5d450719-bd70-3b34-a5f5-969a887d4329",
                        "glosses": [
                            "Champ planté de houblon."
                        ],
                        "tags": [
                            "Agronomie",
                            "Ethnobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2beb3548-0509-4257-8cd3-c5f5d304c4e8",
                                "sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                                "text": "Ceci, mon brave homme, est une houblonnière, et la maison que tu vois là-bas une brasserie."
                            },
                            {
                                "example_id": "610d331a-8b1b-4fea-a8fe-2944946c03f2",
                                "sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                                "text": "Lecture, par le président, du mémoire de M. Gascon, sociétaire, président du Comice agricole de Fontaine-Française (Côte-d'Or), sur la culture du houblon, sur le mode d'installation d'une houblonnière, avec indication des frais par hectare, enfin sur l'entretien de cette plante et les soins divers à lui donner."
                            },
                            {
                                "example_id": "08de0a1c-06d1-434a-953e-ad2153af4b67",
                                "sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                                "text": "Il était Anglais, du comté de Kent, et cela impliquait les houblonnières, les églantines dans les haies, la bière et la clarté du soleil, toutes choses qui n’avaient pas leurs pareilles au monde."
                            },
                            {
                                "example_id": "1f6ceafe-a480-4d39-af9c-459263f18a97",
                                "sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                                "text": "Un peu plus loin, il admire les guirlandes vertes des houblonnières qui festonnent la route comme elles le font au bas du Mont-Noir."
                            },
                            {
                                "example_id": "bee52d2a-d738-4437-9fc9-dd1e4747d0d4",
                                "sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                                "text": "En France, 96 % de la production nationale (environ 740 tonnes) est réalisée en Alsace sur 44 houblonnières, le reste poussant dans les Flandres françaises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c087536-f8cd-468d-9495-38f52b319e56",
                        "source_entry_id": "5d450719-bd70-3b34-a5f5-969a887d4329",
                        "source_sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                        "target_lang_word": "Hopfenfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hopfenfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a98c2f9-d4b8-34e8-b030-489a28c00447",
                                        "entry_id": "d2284850-0b8d-3354-b20e-377eb96c2246",
                                        "glosses": [
                                            "Feld, auf dem Hopfen angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cb4c9f-0f70-4c31-9135-ae1a9d7a7423",
                                                "sense_id": "6a98c2f9-d4b8-34e8-b030-489a28c00447",
                                                "text": "„Aber eine Anwohnerin hat sich gerade beschwert, dass ein Mann mit Motorrad und mehrere andere Personen ein Hopfenfeld in ihrer Nachbarschaft verwüsten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7432fb4b-ecdc-4df9-8a47-c188ff7c9ac8",
                        "source_entry_id": "5d450719-bd70-3b34-a5f5-969a887d4329",
                        "source_sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                        "target_lang_word": "hop garden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hop garden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bdef6f4-bade-39d5-9cd4-e0e357317fb0",
                                        "entry_id": "9a2f90c5-c709-3ba1-8e6d-c55880e384e6",
                                        "glosses": [
                                            "A field, fields or farm where hops are grown."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "814f0e0d-c4a0-40ed-ab5e-d864a5a97bfc",
                                                "sense_id": "1bdef6f4-bade-39d5-9cd4-e0e357317fb0",
                                                "text": "On leaving Wye, we find the country changing character; the Downs come closer to the line, and grazing gives way to orchards and hop-gardens, with pleasant farm buildings, including oasthouses, another characteristic Kentish sight."
                                            },
                                            {
                                                "example_id": "258c145d-aa98-435c-91a4-a90efc7a7d3c",
                                                "sense_id": "1bdef6f4-bade-39d5-9cd4-e0e357317fb0",
                                                "text": "The line is now well into the Wealden hills. Running along the Teise valley, the slopes of which are covered in hop gardens, it falls at gradients of 1 in 106 and 213 to Goudhurst, 6⅜ miles out, [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "377f1b36-05c7-49c9-838c-f684b2337c32",
                        "source_entry_id": "5d450719-bd70-3b34-a5f5-969a887d4329",
                        "source_sense_id": "0a9e9d6a-0378-3cca-bad3-8ef0da9b6c07",
                        "target_lang_word": "hop field",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hop field",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ccf750b-75a6-3606-bb78-c9877b5f4937",
                                        "entry_id": "a71506e3-b7b8-3d0d-be9b-fb076787fcd1",
                                        "glosses": [
                                            "A field in which hops are grown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962fce48-4828-4055-9056-5f1f21c41142",
                                                "sense_id": "4ccf750b-75a6-3606-bb78-c9877b5f4937",
                                                "text": "The country is flat grazing-land, with plenty of sheep, and on the north side a hop field, to remind us that we are in Kent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
