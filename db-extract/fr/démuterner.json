                        "glosses": [
                            "Débarrasser des taupinières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e00763-1c6d-4bf0-af95-02652af1d28d",
                                "sense_id": "cbdfea8c-2691-3de3-84a5-5f92327723b4",
                                "text": "Dans le Laonnois, une clause des baux concernant les prés, porte que le fermier sera tenu de démuterner."
                            },
                            {
                                "example_id": "88ff3952-98c8-4c7a-8ed1-739cc9301455",
                                "sense_id": "cbdfea8c-2691-3de3-84a5-5f92327723b4",
                                "text": "L’homme assure le passage des bêtes d’une pâture à une autre, brûle les mauvaises herbes, et selon les termes de contrats ancestraux « débousine » et « démuterne » les prairies."
                            }
                        ]
                    }
