                "senses": [
                    {
                        "sense_id": "08d4a296-a7c7-356c-9e72-09ad13e7e54d",
                        "entry_id": "0a6d2439-2d72-30a8-8f2d-c57aba601d47",
                        "glosses": [
                            "weibliche Person, die eine andere Person durch bestimmte Lebensbereiche oder Unternehmungen begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ef14b9-2da3-4119-8a7e-22bcaaaa6e2e",
                                "sense_id": "08d4a296-a7c7-356c-9e72-09ad13e7e54d",
                                "text": "Sie waren lange Jahre Genossinnen, die viele Erfolge, aber auch Rückschläge teilten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9e69b91-3828-3e33-93b6-99c5961c5e55",
                        "entry_id": "0a6d2439-2d72-30a8-8f2d-c57aba601d47",
                        "glosses": [
                            "parteioffizielle Anrede und Bezeichnung in politisch links orientierten Parteien, Vereinen, Gruppierungen und so weiter; in Österreich im parlamentarischen Gebrauch für Abgeordnete aller Parteien, wenn bei Anträgen nicht alle Namen genannt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8a8704-f3b1-4855-834b-a06761091266",
                                "sense_id": "e9e69b91-3828-3e33-93b6-99c5961c5e55",
                                "text": "Danke Genossin, Sie können jetzt gehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dc7e5bb3-8562-3b68-a4bc-4ad62c639007",
                        "entry_id": "0a6d2439-2d72-30a8-8f2d-c57aba601d47",
                        "glosses": [
                            "bis 1990 offizielle Anrede in der NVA, der Volkspolizei, des MfS und Ähnlichem in der ehemaligen DDR"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21917ea-87df-4818-85d6-157a2dbfad75",
                                "sense_id": "dc7e5bb3-8562-3b68-a4bc-4ad62c639007",
                                "text": "„Gestatten Sie, dass ich eintrete, Genossin?“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "55342676-cc1c-34e6-bdfa-6d5a2d69cd91",
                        "entry_id": "0a6d2439-2d72-30a8-8f2d-c57aba601d47",
                        "glosses": [
                            "offizielle Anrede in einigen realsozialistischen (ehemalige Sowjetunion, Bulgarien unter anderem) sowie anderen sozialistischen Staaten (China) und in deren bewaffneten Organen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404cf24b-718b-4bcc-844f-9e32f6ce0df0",
                                "sense_id": "55342676-cc1c-34e6-bdfa-6d5a2d69cd91",
                                "text": "Genossin Mitrov, kommen Sie bitte einmal hier herüber."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "54d3fa59-63e2-3f53-860d-0e24b6ec1df5",
                        "entry_id": "0a6d2439-2d72-30a8-8f2d-c57aba601d47",
                        "glosses": [
                            "Mitglied einer Genossenschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc92c5a2-92bd-45c9-b87d-3b8d7d85bc82",
                                "sense_id": "54d3fa59-63e2-3f53-860d-0e24b6ec1df5",
                                "text": "Genossen und Genossinnen, hier kommt der Rechenschaftsbericht."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
