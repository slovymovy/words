                ],
                "senses": [
                    {
                        "sense_id": "dfbd214e-93dc-314c-9d2f-bdc937ec8b1c",
                        "entry_id": "29fc08be-310b-36e9-a9e4-498aaebab89f",
                        "glosses": [
                            "Menge der Druckwerke, die jemand lesen muss/zu lesen beabsichtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fb05269-e8ff-4f27-979f-1cd893de8c16",
                                "sense_id": "dfbd214e-93dc-314c-9d2f-bdc937ec8b1c",
                                "text": "„Neben dem Buchhändler sorgte auch er für meinen Lesestoff.“"
                            },
                            {
                                "example_id": "2dea4e3c-2931-4b8c-bae0-bcaf498df921",
                                "sense_id": "dfbd214e-93dc-314c-9d2f-bdc937ec8b1c",
                                "text": "„Er war nicht der einzige Buchhändler, der die Nachfrage nach jüdischen Lesestoffen durch Übersetzungen hebräischer Literatur zu bedienen versuchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1fd4c01-5a60-4211-a143-d317a6c0d782",
                        "source_entry_id": "29fc08be-310b-36e9-a9e4-498aaebab89f",
                        "source_sense_id": "dfbd214e-93dc-314c-9d2f-bdc937ec8b1c",
                        "source_sense_description": "Menge der Druckwerke, die jemand lesen muss/zu lesen beabsichtigt",
                        "target_lang_word": "lecture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lecture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4138d1c4-7ee2-3a9e-a8e1-fb87af3dce32",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Action d’une personne qui lit à haute voix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3968697e-35eb-433e-9cb3-2dc95993770b",
                                                "sense_id": "4138d1c4-7ee2-3a9e-a8e1-fb87af3dce32",
                                                "text": "Sa lecture est parfaite. Sa lecture est monotone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1803bf5a-0ef9-3e43-941d-af379a8c3f8c",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Reproduction par la voix d’un texte écrit ou imprimé."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82ec984-f41b-4205-9c90-973c6533e5f0",
                                                "sense_id": "1803bf5a-0ef9-3e43-941d-af379a8c3f8c",
                                                "text": "On fit la lecture du contrat de mariage en présence de tous les parents."
                                            },
                                            {
                                                "example_id": "0e8042ba-9c3c-4b28-a98c-e7baca06fd67",
                                                "sense_id": "1803bf5a-0ef9-3e43-941d-af379a8c3f8c",
                                                "text": "J’ai assisté hier à la lecture d’une belle pièce."
                                            },
                                            {
                                                "example_id": "569e0053-1c6c-4a95-9374-2ea60b374fa9",
                                                "sense_id": "1803bf5a-0ef9-3e43-941d-af379a8c3f8c",
                                                "text": "Ce discours est moins intéressant à la lecture qu’à l’audition."
                                            },
                                            {
                                                "example_id": "2adb0fbd-9d9b-4a61-81e1-13bf2d49fa79",
                                                "sense_id": "1803bf5a-0ef9-3e43-941d-af379a8c3f8c",
                                                "text": "Cette pièce est de celles qui gagnent à la lecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Action, habitude de lire seul et des yeux, pour son instruction ou pour son plaisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e13830f-6e56-47bc-a9c9-787862f6e06e",
                                                "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                                "text": "Aristote n'a connu que le bras hectocotylisé des octopus, comme on peut s'en convaincre facilement par la lecture attentive des passages en question, mais il l'a connu fort exactement."
                                            },
                                            {
                                                "example_id": "bff2aa54-30bf-4ebb-b7fb-22f770445f92",
                                                "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                                "text": "Toute l’action, dans la lecture, est le fait de celui qui lit. Voilà pourquoi les liseurs les plus attentifs, les moins lassables, se recrutent parmi les gens habituellement environnés de repos, les gens qui ne voient pas beaucoup remuer le monde autour d’eux."
                                            },
                                            {
                                                "example_id": "2e08d9eb-3c73-4bce-a65c-ae967e82b0eb",
                                                "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                                "text": "Ce canapé restera pour moi celui de Guerre et Paix : on se souvient de la date et du lieu d’une lecture, quand elle a été une grande joie."
                                            },
                                            {
                                                "example_id": "5f0d7390-d5e4-4eb5-b763-8422d08c5497",
                                                "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                                "text": "Les longs étés à Nollet, et les lectures dans la fraîcheur du salon, sur le canapé de Guerre et Paix, les lectures aussi de l’automne devant un grand feu, et les nuits tôt venues de l’hiver où dans un lit calfeutré on n’en finit plus de lire, tandis que le vent passe et tourne autour de la maison."
                                            },
                                            {
                                                "example_id": "61d2f628-2bfb-4d4c-a374-aabe36592d18",
                                                "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                                "text": "Sur le canapé du salon, qui serait plus tard celui de Guerre et Paix, commencèrent mes premières longues lectures de l’été, qui ont une saveur si particulière dans une pièce fraîche aux volets clos."
                                            },
                                            {
                                                "example_id": "f55e252e-e26f-4739-93a5-f3507e738a1c",
                                                "sense_id": "60fa3a09-6a96-3efa-a1b3-7d1b343d78c3",
                                                "text": "Comme la lecture est l’acte le plus individuel qui soit (bien plus encore que l’acte sexuel), on comprend qu’elle soit un « horrible danger » pour toute inquisition réelle ou virtuelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3add633-5c23-3832-8fe4-eee84402c25b",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "S’emploie surtout au pluriel pour désigner ce qu’on lit, ce qu’on a lu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a61a7f-f6a4-4171-ac13-7d327bc1be61",
                                                "sense_id": "c3add633-5c23-3832-8fe4-eee84402c25b",
                                                "text": "Les bonnes lectures, les mauvaises lectures."
                                            },
                                            {
                                                "example_id": "6a4fdffd-8dae-4df7-a52b-8aa526e91948",
                                                "sense_id": "c3add633-5c23-3832-8fe4-eee84402c25b",
                                                "text": "Il a bien profité de ses lectures."
                                            },
                                            {
                                                "example_id": "d74d19fc-5ad7-4cc3-8f3b-133d4189bb04",
                                                "sense_id": "c3add633-5c23-3832-8fe4-eee84402c25b",
                                                "text": "Elle a toujours trois lectures en route, une en espagnol, une en anglais, une en français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17fcf684-7aa1-3fc2-ada4-aa4e421bdc4c",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Instruction qui résulte de la lecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b92d33-6709-482b-916f-f494a544183e",
                                                "sense_id": "17fcf684-7aa1-3fc2-ada4-aa4e421bdc4c",
                                                "text": "C’est un homme qui n’a point de lecture, qui n’a aucune lecture, qui a beaucoup de lecture, qui est d’une prodigieuse lecture."
                                            },
                                            {
                                                "example_id": "e75c7359-4b30-4111-bab7-593c48417f8a",
                                                "sense_id": "17fcf684-7aa1-3fc2-ada4-aa4e421bdc4c",
                                                "text": "Il est rempli, nourri de la lecture des anciens."
                                            },
                                            {
                                                "example_id": "cb2460ac-718c-4e90-b104-26e3c16177b7",
                                                "sense_id": "17fcf684-7aa1-3fc2-ada4-aa4e421bdc4c",
                                                "text": "Au moins, un amoureux ordinaire, s’il a quelque lecture, peut toujours se distraire en se récitant des vers empruntés à tel ou tel poète."
                                            },
                                            {
                                                "example_id": "0edfdc2a-a7c9-433f-9528-33e5fa320e03",
                                                "sense_id": "17fcf684-7aa1-3fc2-ada4-aa4e421bdc4c",
                                                "text": "Cette remarque pose, d’ailleurs, à l’historien, un problème. L’analyse qui est la sienne s’appuie sur SA lecture, véritable relecture dans un contexte parfaitement différent."
                                            },
                                            {
                                                "example_id": "72ce2b0f-d12b-42ec-8b0e-9e431e48f8d3",
                                                "sense_id": "17fcf684-7aa1-3fc2-ada4-aa4e421bdc4c",
                                                "text": "Non, ce dernier fut simplement effaré à la lecture des chiffres fournis par les grouillots du ministère de l’Éducation nationale qui, en bons subordonnés, travaillent, eux, et en plus font plaisir au chef !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10bc7aa0-b392-3435-9f50-e3ddc440fa3c",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Enseignement qui rend les enfants ou les illettrés capables de lire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653503f9-8f2d-42ba-9be5-c03118ea1bd1",
                                                "sense_id": "10bc7aa0-b392-3435-9f50-e3ddc440fa3c",
                                                "text": "Nouvelle méthode de lecture."
                                            },
                                            {
                                                "example_id": "f4f9034a-d443-4816-85de-a648a16a8f3e",
                                                "sense_id": "10bc7aa0-b392-3435-9f50-e3ddc440fa3c",
                                                "text": "Cette mère a appris à ses enfants la lecture et l’écriture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7562248-8904-3c13-a321-7b1ae4e2a885",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Se dit de textes particulièrement choisis pour développer l’art et le goût de la lecture chez les enfants."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45cf1f33-5ecb-4948-a78f-6acf9770c139",
                                                "sense_id": "e7562248-8904-3c13-a321-7b1ae4e2a885",
                                                "text": "Premier livre de lecture."
                                            },
                                            {
                                                "example_id": "fd544457-7b26-4339-94c6-db28043a0b6a",
                                                "sense_id": "e7562248-8904-3c13-a321-7b1ae4e2a885",
                                                "text": "Lectures enfantines."
                                            },
                                            {
                                                "example_id": "57ad03a8-b4ad-4b23-ade7-5e6ec8e256e9",
                                                "sense_id": "e7562248-8904-3c13-a321-7b1ae4e2a885",
                                                "text": "Lectures pour les adolescents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487c003b-6315-36e2-8568-c294fd8edbd4",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Observation visuelle."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea1f2db-2ef8-4871-bbdc-9d07f720d0bc",
                                                "sense_id": "487c003b-6315-36e2-8568-c294fd8edbd4",
                                                "text": "Cela tient de l’astrologie, de la tarologie, de la divination, des tables tournantes, de la chiromancie, ou de la lecture des viscères. Et pourtant, pendant ces trente dernières années, les dirigeants du monde occidental n'ont eu d'autre solution que de recourir à la kremlinologie pour tenter de comprendre les ressorts de la politique soviétique […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c706cc-5ec2-3817-bb86-d5b13dfc0f19",
                                        "entry_id": "2abba22a-edc6-352a-b40e-63127578fd0c",
                                        "glosses": [
                                            "Interprétation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
