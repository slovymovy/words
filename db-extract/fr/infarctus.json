                                        "entry_id": "715de7b7-dc56-30cf-9cc8-43183f36f37d",
                                        "glosses": [
                                            "Gewebsuntergang durch eine Unterversorgung mit Sauerstoff als Folge einer unzureichenden oder unterbrochenen Durchblutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea1b19c-b7b9-43d6-a64e-9007bdaec754",
                                                "sense_id": "bd877a58-085c-3976-9724-34b5af2dde32",
                                                "text": "„Die Implantation von körpereigenen Muskelzellen könnte auch beim Menschen eine erfolgversprechende Therapieform bei Infarkten sein, hoffen die Wissenschaftler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
