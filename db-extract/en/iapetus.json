    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8d02065a-0765-349c-8d45-e968186e02c5",
                "word": "Iapetus",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d909c9a0-7e84-3e6a-a6ef-195997cee98f",
                        "entry_id": "8d02065a-0765-349c-8d45-e968186e02c5",
                        "glosses": [
                            "A Titan, the son of Uranus and Gaia, and father of Atlas, Prometheus, Epimetheus, and Menoetius."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5fc5bc5a-17bf-3a42-8087-235fbc0595d7",
                        "entry_id": "8d02065a-0765-349c-8d45-e968186e02c5",
                        "glosses": [
                            "A moon in Saturnian system, Solar System: The third largest moon of Saturn"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ecfe9863-d3d0-37e2-81bb-6d0c4035159b",
                        "entry_id": "8d02065a-0765-349c-8d45-e968186e02c5",
                        "glosses": [
                            "A former ocean between former continent of Laurentia (North America) and former continent of Baltica (Europe): An ancient ocean which existed between 600 and 400 million years ago."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f2c2d02-3afc-4148-933e-cf4ee92290c3",
                                "sense_id": "ecfe9863-d3d0-37e2-81bb-6d0c4035159b",
                                "text": "So, in the early Ordovician, Iapetus was wide enough to have one side in high latitudes and the other in the tropics: a massive ocean, indeed."
                            }
                        ]
                    },
                    {
                        "sense_id": "660a3af3-0c35-33c4-bc19-ca93390c2dda",
                        "entry_id": "8d02065a-0765-349c-8d45-e968186e02c5",
                        "glosses": [
                            "Alternative form of Japheth."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7774bf66-63d9-4eb7-91cb-d5d7b2348da3",
                        "source_entry_id": "8d02065a-0765-349c-8d45-e968186e02c5",
                        "source_sense_description": "the Titan",
                        "target_lang_word": "Japet",
