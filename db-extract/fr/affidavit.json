                                "target_senses": [
                                    {
                                        "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                        "entry_id": "d3ac098c-0761-3d2c-91cf-ea688e24c8d8",
                                        "glosses": [
                                            "A signed document wherein an affiant makes a sworn statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b0caaf-0982-4d83-bab4-1aefc38d53ce",
                                                "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                                "text": "He submitted his affidavit rather than appearing to testify in court."
                                            },
                                            {
                                                "example_id": "c2bdf334-162d-4ee8-95dd-4923e36a312f",
                                                "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                                "text": "Lee's case is urgent. He has to file an immediate affidavit that he is suffering from bubonic plague to avoid eviction from the house he has occupied ten years without paying the rent."
                                            },
                                            {
                                                "example_id": "a33dfbe0-99ac-4b79-9ec2-c0623cc63d42",
                                                "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                                "text": "All lifters were certified by affidavit and polygraph to be steroid free."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affidavit",
                                "target_lang_code": "en",
