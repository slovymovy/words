                        "glosses": [
                            "Extrêmement important."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e38a375-2006-482e-bb10-e7ac8766864c",
                                "sense_id": "08bd470c-5e8c-3758-90fa-6a0474581078",
                                "text": "Pas que les séries, les représentations en général, c’est hyperimportant."
                            },
                            {
                                "example_id": "122c2105-3bd9-4542-bd59-da989ed6e21d",
                                "sense_id": "08bd470c-5e8c-3758-90fa-6a0474581078",
                                "text": "Cette étape est hyperimportante, car elle lui donne le « contrôle » sur la situation : il ne subit plus le fait d’aller se coucher, c’est lui et lui seul qui décide quand il est prêt à s’endormir."
                            },
                            {
                                "example_id": "f789b81a-457f-4823-a056-40db455919a3",
                                "sense_id": "08bd470c-5e8c-3758-90fa-6a0474581078",
                                "text": "Réglez les questions hyperimportantes en début de journée pour ne plus avoir à y penser et être sûrs qu’elles seront traitées."
                            }
                        ]
                    }
