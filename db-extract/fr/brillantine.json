        "fr-extract.jsonl": [
            {
                "entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                "word": "brillantine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "80d6c2e8-ba8e-44ef-8e2a-3d81f04e416d",
                        "entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "brillantines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                        "entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                        "glosses": [
                            "Composition (pommade ou liquide) odorante permettant de lustrer les cheveux et la barbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7413fef-6366-40aa-810e-9dba1c703eb4",
                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                "text": "Ses cheveux blonds, généralement pommadés, étaient en désordre. Et, comme la brillantine les rendait raides, ils se dressaient sur sa tête."
                            },
                            {
                                "example_id": "ef9b5550-73e7-478b-90ae-729ccf208338",
                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                "text": "Un parfum d’étoffe teinte et de brillantine venait de ta robe de deuil, de tes cheveux."
                            },
                            {
                                "example_id": "19e084fc-ef2a-40e5-a344-3eb65a214937",
                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                "text": "Lavinia avait pensé à tout et à une petite boîte de brillantine à la violette dont Angelo se lissa la moustache."
                            },
                            {
                                "example_id": "6091f067-2748-4fb0-82e9-0bd6758cff22",
                                "sense_id": "513111cc-1f6d-30d0-b7b6-10d1044b5d18",
                                "text": "Le style chanteur de charme, col blanc ouvert sur une médaille pieuse, cheveu rare plaqué par la brillantine."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1cf7319-f3d8-3d1d-9867-653087277c89",
                        "entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                        "glosses": [
                            "Étoffe de soie utilisée pour la confection de robes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c7aab5-88b9-49bc-98af-0484df82843f",
                                "sense_id": "b1cf7319-f3d8-3d1d-9867-653087277c89",
                                "text": "Brillantine : Tissu où il y a des flottés chaîne sur fond de taffetas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74ec4937-ee18-43a9-93e5-e02438a9d590",
                        "source_entry_id": "89de742d-0d42-3818-bfe0-d9210ef0c4c4",
                        "target_lang_word": "brilliantine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brilliantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87f986b1-7e03-3f72-be9e-368425698781",
                                        "entry_id": "687d7e48-2385-3ddc-8c73-f5a0f3727d20",
                                        "glosses": [
                                            "A hair pomade, making the hair shine brilliantly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93aeca22-0334-4e69-9d84-2c349d81ae18",
                                                "sense_id": "87f986b1-7e03-3f72-be9e-368425698781",
                                                "text": "The hairdresser's shop was warm and glittering. It smelled of soap and burnt paper and wallflower brilliantine."
                                            },
                                            {
                                                "example_id": "a1715c29-67f4-4b36-8e6c-3bf25297191f",
                                                "sense_id": "87f986b1-7e03-3f72-be9e-368425698781",
                                                "text": "\"I wouldn't regret it,\" said Linda, \"if I took Eileen by the shoulders and shook her till I shook the rouge off her cheek, and the brilliantine off her hair, and a million mean little subterfuges out of her soul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93a8789-0cb7-3277-9062-5173f87d7d20",
                                        "entry_id": "687d7e48-2385-3ddc-8c73-f5a0f3727d20",
                                        "glosses": [
                                            "A smooth shiny, luxurious fabric, often of alpaca or vicuña."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae183d30-06c3-41c2-8b62-bb10a544a22c",
                                                "sense_id": "d93a8789-0cb7-3277-9062-5173f87d7d20",
                                                "text": "Bathing Suit of Brilliantine in Navy Blue and Black, trimmed with white mohair braid and buttons (no bloomers). Special 3.95"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brilliantine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36c6e548-6095-322b-b1dc-33da9766a73c",
                                        "entry_id": "5b2563f0-bd79-3e22-80bf-b53846bb7c7c",
                                        "glosses": [
                                            "To apply brilliantine to the hair."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139c726f-16b3-488b-89c7-d078d9952d6f",
                                                "sense_id": "36c6e548-6095-322b-b1dc-33da9766a73c",
                                                "text": "And the waiter, of course, dips his fingers into the gravy—his nasty, greasy fingers which he is for ever running through his brilliantined hair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
