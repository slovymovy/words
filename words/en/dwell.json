{
    "word_family": [
        "dweller",
        "dwelling",
        "indwell"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb0b3fd3-ed47-30fe-a546-c9ee2bbbfe52",
                    "sense_definition": "To live or reside in a specified place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poor man <w>dwells</w> in a humble cottage near the hall where the lord of the domain resides.",
                            "target_lang_translations": {
                                "ru": "Бедняк <w>обитает</w> в скромной хижине рядом с залом, где проживает лорд этих владений."
                            }
                        },
                        {
                            "text": "Many rare species of birds <w>dwell</w> deep within the tropical rainforest where humans rarely venture.",
                            "target_lang_translations": {
                                "ru": "Многие редкие виды птиц <w>обитают</w> глубоко в тропических лесах, куда редко заходит человек."
                            }
                        }
                    ],
                    "synonyms": [
                        "live",
                        "reside",
                        "inhabit",
                        "abide"
                    ],
                    "common_phrases": [
                        "dwell in",
                        "dwell among"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить или находиться в определенном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обитать",
                                "target_lang_sense_clarification": "постоянно жить в каком-либо месте"
                            },
                            {
                                "target_lang_word": "проживать",
                                "target_lang_sense_clarification": "жить по определенному адресу или в определенных условиях"
                            },
                            {
                                "target_lang_word": "жить",
                                "target_lang_sense_clarification": "использовать место как жилище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1f9c6c-a40b-39f1-863c-6510b6556270",
                    "sense_definition": "To think, speak, or write at length about a particular subject, especially something unpleasant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not healthy to <w>dwell</w> on the past when you should be focusing on your future goals.",
                            "target_lang_translations": {
                                "ru": "Вредно <w>зацикливаться</w> на прошлом, когда нужно сосредоточиться на будущих целях."
                            }
                        },
                        {
                            "text": "The manager chose not to <w>dwell</w> on the mistake and instead looked for a solution.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил не <w>заострять внимание</w> на ошибке и вместо этого занялся поиском решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "linger",
                        "harp",
                        "elaborate"
                    ],
                    "antonyms": [
                        "ignore",
                        "disregard"
                    ],
                    "common_phrases": [
                        "dwell on",
                        "dwell upon",
                        "not to dwell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долго и подробно думать, говорить или писать о чем-то, особенно о чем-то неприятном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зацикливаться",
                                "target_lang_sense_clarification": "постоянно возвращаться к одной и той же мысли"
                            },
                            {
                                "target_lang_word": "подробно останавливаться",
                                "target_lang_sense_clarification": "уделять много внимания теме в речи или письме"
                            },
                            {
                                "target_lang_word": "размусоливать",
                                "target_lang_sense_clarification": "излишне долго обсуждать что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3d14c1a-143a-328b-9604-9e25e1d13c66",
                    "sense_definition": "To remain or continue in a specific state or condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mind <w>dwelt</w> in a state of constant anxiety until the news finally arrived.",
                            "target_lang_translations": {
                                "ru": "Его разум <w>пребывал</w> в состоянии постоянной тревоги, пока наконец не пришли новости."
                            }
                        },
                        {
                            "text": "The poet described a soul that <w>dwelt</w> apart from the noise of the modern world.",
                            "target_lang_translations": {
                                "ru": "Поэт описал душу, которая <w>жила</w> вдали от шума современного мира."
                            }
                        }
                    ],
                    "synonyms": [
                        "abide",
                        "remain",
                        "stay"
                    ],
                    "common_phrases": [
                        "dwell in peace",
                        "dwell apart"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться или продолжать находиться в определенном состоянии или условии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пребывать",
                                "target_lang_sense_clarification": "находиться в каком-либо состоянии"
                            },
                            {
                                "target_lang_word": "находиться",
                                "target_lang_sense_clarification": "быть в определенном положении или состоянии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4813307-d384-317c-b9e1-e403c06d0373",
                    "sense_definition": "A period of time in which a system or component remains in a given state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer adjusted the <w>dwell</w> to ensure the chemical reaction had enough time to complete.",
                            "target_lang_translations": {
                                "ru": "Инженер отрегулировал <w>время выдержки</w>, чтобы химическая реакция успела завершиться."
                            }
                        },
                        {
                            "text": "A longer <w>dwell</w> time in the furnace results in a harder surface for the metal parts.",
                            "target_lang_translations": {
                                "ru": "Более длительное <w>время пребывания</w> в печи приводит к получению более твердой поверхности металлических деталей."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "delay",
                        "interval"
                    ],
                    "common_phrases": [
                        "dwell time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого система или компонент остается в заданном состоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время выдержки",
                                "target_lang_sense_clarification": "продолжительность нахождения в процессе"
                            },
                            {
                                "target_lang_word": "время пребывания",
                                "target_lang_sense_clarification": "длительность нахождения компонента в зоне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e98f12b-da45-3328-b390-ad895622c3d9",
                    "sense_definition": "In a petrol engine, the period of time the ignition points are closed to allow current flow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the <w>dwell</w> is set incorrectly, the engine will misfire at high speeds.",
                            "target_lang_translations": {
                                "ru": "Если <w>угол замкнутого состояния</w> установлен неправильно, двигатель будет давать перебои на высоких скоростях."
                            }
                        },
                        {
                            "text": "He used a specialized meter to check the <w>dwell</w> angle of the distributor.",
                            "target_lang_translations": {
                                "ru": "Он использовал специальный прибор для проверки <w>угла замкнутого состояния</w> контактов распределителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwell angle"
                    ],
                    "common_phrases": [
                        "dwell angle",
                        "dwell meter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В бензиновом двигателе — период времени, в течение которого контакты прерывателя замкнуты для прохождения тока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угол замкнутого состояния",
                                "target_lang_sense_clarification": "параметр системы зажигания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}