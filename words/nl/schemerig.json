{
    "word_family": [
        "schemer",
        "schemeren"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b357cc45-a816-3337-8dd6-371cf558f1cf",
                    "sense_definition": "Met weinig licht, zoals vlak voor het invallen van de avond.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen het <w>schemerig</w> werd, konden we de eerste vleermuizen zien.",
                            "target_lang_translations": {
                                "en": "When it started to get <w>dim</w>, we could see the first bats."
                            }
                        },
                        {
                            "text": "In de <w>schemerige</w> kamer was het moeilijk om nog een boek te lezen.",
                            "target_lang_translations": {
                                "en": "In the <w>dimly lit</w> room, it was difficult to read a book."
                            }
                        }
                    ],
                    "synonyms": [
                        "halfdonker"
                    ],
                    "common_phrases": [
                        "schemerig licht"
                    ],
                    "target_lang_definitions": {
                        "en": "Having little light, as in the time just before nightfall or in a dimly lit space."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dim",
                                "target_lang_sense_clarification": "lacking brightness or clarity"
                            },
                            {
                                "target_lang_word": "dusk",
                                "target_lang_sense_clarification": "referring to the time of day with fading light"
                            },
                            {
                                "target_lang_word": "twilight",
                                "target_lang_sense_clarification": "the soft glowing light from the sky when the sun is below the horizon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb9c7a43-ec36-3859-b5f5-c72626aeced3",
                    "sense_definition": "Niet helemaal eerlijk of legaal, waardoor het verborgen moet blijven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onduidelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onze buurman heeft een wat <w>schemerig</w> handeltje in tweedehands auto's.",
                            "target_lang_translations": {
                                "en": "Our neighbor has a somewhat <w>shady</w> business in second-hand cars."
                            }
                        },
                        {
                            "text": "De politicus raakte betrokken bij een <w>schemerige</w> zakelijke transactie.",
                            "target_lang_translations": {
                                "en": "The politician became involved in a <w>shady</w> business transaction."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaag",
                        "onduidelijk",
                        "schimmig"
                    ],
                    "common_phrases": [
                        "schemerig handeltje"
                    ],
                    "target_lang_definitions": {
                        "en": "Not entirely honest or legal, implying something that is suspicious or needs to be kept hidden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shady",
                                "target_lang_sense_clarification": "dishonest or illegal"
                            },
                            {
                                "target_lang_word": "dodgy",
                                "target_lang_sense_clarification": "suspicious or unreliable"
                            },
                            {
                                "target_lang_word": "sketchy",
                                "target_lang_sense_clarification": "informal term for something questionable or unsafe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}