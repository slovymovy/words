                "senses": [
                    {
                        "sense_id": "e4008063-1009-3b25-9ea6-db92f2cd9a31",
                        "entry_id": "0260aa6d-def0-305e-9687-284d266f4eef",
                        "glosses": [
                            "an Kinder gerichtete Abteilung, Abteilung mit Sachen für Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a75230-5900-4264-add7-26c036b98891",
                                "sense_id": "e4008063-1009-3b25-9ea6-db92f2cd9a31",
                                "text": "„Aus dem ersten Stock am Seward Park, der Kinderabteilung, war er zu den Erwachsenen ins Erdgeschoss gewechselt und schließlich in den Lesesaal des Bildungsbundes.“"
                            },
                            {
                                "example_id": "7e3a9f05-af34-4896-80f6-0c60737a9b04",
                                "sense_id": "e4008063-1009-3b25-9ea6-db92f2cd9a31",
                                "text": "„Tabbi ist in der Kinderabteilung, und deine Frau ist in ihrem eigenen Koma: bei den Kunstbüchern.“"
                            },
                            {
                                "example_id": "49456c97-b73b-47a3-923c-bc5105541742",
                                "sense_id": "e4008063-1009-3b25-9ea6-db92f2cd9a31",
                                "text": "„Sogar als kleines Kind hatte sie es geliebt, während der Sommerferien mit Keith in die Kinderabteilung der Santa Ana Public Library zu gehen und sich große Stapel von zehn oder zwölf Büchern herauszusuchen, von denen sie vielleicht drei oder vier tatsächlich lasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
