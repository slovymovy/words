                    {
                        "translation_id": "1a21e5da-8b05-4998-a5d1-11b62505b90b",
                        "source_entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                        "source_sense_description": "long, slender pasta",
                        "target_lang_word": "mihoen",
