                "senses": [
                    {
                        "sense_id": "49e5c47a-43d4-3d66-9db3-5b98d32a66c8",
                        "entry_id": "53e78916-7a3e-3f1d-9bfe-967afa7eb5ca",
                        "glosses": [
                            "Ort, an dem Schiffswracks liegen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5f2148d1-4e24-4872-8243-1cf136515ca6",
                                "sense_id": "49e5c47a-43d4-3d66-9db3-5b98d32a66c8",
                                "text": "„Die Ostsee ist ein wahrer Schiffsfriedhof: Nirgends sonst liegen die Wracks so dicht an dicht wie hier.“"
                            },
                            {
                                "example_id": "dadfbe6e-d546-440e-9fbd-0048b24c146c",
                                "sense_id": "49e5c47a-43d4-3d66-9db3-5b98d32a66c8",
                                "text": "„Rund um das legendäre Kap Hoorn schlummert einer der größten Schiffsfriedhöfe der Welt.“"
                            },
                            {
                                "example_id": "108b7ae0-9ac7-4aa3-9574-863ca33a1ddc",
                                "sense_id": "49e5c47a-43d4-3d66-9db3-5b98d32a66c8",
                                "text": "„Nach Süden hin, wo Stiller Ozean und Atlantik an den Klippen von Kap Hoorn ineinander übergehen, war das Klima subarktisch mit gewaltigen Stümen, die das Kap in den folgenden Jahrhunderten zu einem der größten Schiffsfriedhöfe der Erde machten.“"
                            },
                            {
                                "example_id": "2308e8c7-4cd5-432c-ba9f-84bc3d109592",
                                "sense_id": "49e5c47a-43d4-3d66-9db3-5b98d32a66c8",
                                "text": "„Ein Schiffsfriedhof liegt am nördlichen Ende der Bucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
