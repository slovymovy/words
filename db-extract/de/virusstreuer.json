                ],
                "senses": [
                    {
                        "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                        "entry_id": "b63a6b2c-d218-30e1-b004-45bccdceda0b",
                        "glosses": [
                            "persistent durch einen selbständig nicht zur Vermehrung fähigen Erreger infiziertes Lebewesen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "495a5fe3-675f-47fb-b984-bf2d55181018",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„In der Steiermark gibt es derzeit keine sogenannten Virusstreuer.“"
                            },
                            {
                                "example_id": "26650c89-3db4-41ee-9c30-6f2d72581b33",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„Schließlich wird eine Bestandsuntersuchung auf Virusstreuer durchgeführt.“"
                            },
                            {
                                "example_id": "7871e590-4711-44a1-83e8-745cdfebd013",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„Die Aufdeckung der Virusstreuer erfolgt durch Bestandsuntersuchungen, und nach Entfernung der Reagenten erfolgt eine zweimalige Nachuntersuchung aller nachgeborenen Kälber zwischen zwölf Wochen und neun Monaten.“"
                            },
                            {
                                "example_id": "1d6fccd3-1a42-4035-a182-f1d2c9364a76",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„Virusstreuer können kümmern oder auch völlig normal erscheinen.“"
                            },
                            {
                                "example_id": "6d7e0a7c-1a96-444b-a793-d6ddf97f7ee2",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„Denn gerade die Leichterkrankten, die oft ihrer Beschäftigung weiter nachgehen, müssen als gefährlichste Virusstreuer gelten.“"
                            },
                            {
                                "example_id": "a7319900-676c-474a-be53-b42347e3d7e2",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„In jedem Falle aber wird dieses Verhältnis je nach den doch ganz individuell mehr oder weniger begrenzten Kontaktmöglichkeiten der Virusstreuer ganz unterschiedlich sein müssen.“"
                            },
                            {
                                "example_id": "fa20c303-d733-48cb-b637-32160a4892b8",
                                "sense_id": "bf934dff-13d6-365e-b3ee-dd0a4d5fdb8c",
                                "text": "„Von besonderer Bedeutung dürfte die Tatsache sein, daß die Tiere direkt nach der Impfung für 3 Wochen Virusstreuer sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
