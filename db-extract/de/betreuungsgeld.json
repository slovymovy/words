                "senses": [
                    {
                        "sense_id": "9fff14e2-2359-30ce-b4d8-be1715bca60d",
                        "entry_id": "fea97f8f-26f8-3cab-80af-0796c3374701",
                        "glosses": [
                            "finanzielle, staatliche Unterstützung für Eltern, die ihr Kind zu Hause betreuen, anstatt es in eine Krippe zu schicken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af99772-f462-4a4e-8595-911660a6fd77",
                                "sense_id": "9fff14e2-2359-30ce-b4d8-be1715bca60d",
                                "text": "„Merkel ist indes fest entschlossen, den seit Monaten schwelenden Streit über das Betreuungsgeld jetzt zu beenden: Noch in diesem Monat soll ein Gesetz auf den Weg gebracht werden, dass Mütter und Väter, die ihre Kleinstkinder nicht in eine Krippe geben, mit zunächst 100 Euro im Monat unterstützt werden.“"
                            },
                            {
                                "example_id": "1c65275c-e9a9-4a17-bbeb-242cff50ef9f",
                                "sense_id": "9fff14e2-2359-30ce-b4d8-be1715bca60d",
                                "text": "„Wir haben das Betreuungsgeld, das Kindergeld, Rechtsansprüche, und sogar der Unterhalt ist in einer Tabelle festgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
