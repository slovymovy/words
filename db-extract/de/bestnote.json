                "senses": [
                    {
                        "sense_id": "46bcbc79-84f8-3c62-9fda-f9c2760f27f1",
                        "entry_id": "819f0c5c-acca-3203-b0fe-885359db94c3",
                        "glosses": [
                            "in einem Bewertungssystem am meisten gewünschte Bewertung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec882341-ef1c-45bd-abb9-d8973238ebae",
                                "sense_id": "46bcbc79-84f8-3c62-9fda-f9c2760f27f1",
                                "text": "„Statt der Bestnote AAA müssen sich die Vereinigten Staaten bei einer der US-Agenturen, die Schuldner bewerten, mit der Note »AA+« begnügen, gleichsam einer Eins minus.“"
                            },
                            {
                                "example_id": "63a39b33-61fa-45f7-b680-8cf24ec5a255",
                                "sense_id": "46bcbc79-84f8-3c62-9fda-f9c2760f27f1",
                                "text": "„Roth liebte den Unterricht, bekam Bestnoten und zog nacheinander jedes seiner Fächer – auch Biologie – als Hauptfach in Erwägung.“"
                            }
                        ],
