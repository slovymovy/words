                "senses": [
                    {
                        "sense_id": "2e3644dc-d30e-3c10-9ff5-5af09e184b60",
                        "entry_id": "7527c5b1-9333-3d33-bf52-6a1eec1ad2d2",
                        "glosses": [
                            "Linguistik: Gesamtheit der von ein und demselben Grundwort/-lexem durch Wortbildung entwickelten Wörter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77602022-e144-41dd-9ac0-807c1234e603",
                                "sense_id": "2e3644dc-d30e-3c10-9ff5-5af09e184b60",
                                "text": "„Immerhin: Im Rahmen der Debatte um die politische Korrektheit sind sich alle Sendungen dahingehend einig, dass die betroffene Gruppe als Flüchtlinge zu bezeichnen ist, was sich an dem ausgeprägten Wortbildungsnest um diesen Begriff herum ablesen lässt.“"
                            },
                            {
                                "example_id": "73ab74e2-f0d1-474e-89f5-7ce4a3755049",
                                "sense_id": "2e3644dc-d30e-3c10-9ff5-5af09e184b60",
                                "text": "„Die Entfaltung der Wortbildungsnester wird mitbestimmt von der Bedeutung der Kernwörter und der sich daraus ergebenden Position in den entsprechenden onomasiologischen Gruppierungen.“"
                            },
                            {
                                "example_id": "4474aa4e-ff0e-4eef-ab5b-422d7985a2fc",
                                "sense_id": "2e3644dc-d30e-3c10-9ff5-5af09e184b60",
                                "text": "„Zum Wortbildungsnest von ziehen würde man Zeuge nicht mehr zählen, es wäre vielmehr Kernwort eines eigenen Wortbildungsnestes (Zeuge, bezeugen, Zeugnis, Belastungszeuge, Zeugenaussage).“"
                            },
                            {
                                "example_id": "fc749dfb-d996-4adf-b81d-b2dabd5152db",
                                "sense_id": "2e3644dc-d30e-3c10-9ff5-5af09e184b60",
                                "text": "„Begrifflich kann das Wortbildungsnest als eine endliche Menge abstrakter (genotypischer) und konkreter (phänotypischer) Wortbildungsstrukturen mit gleichen Operanden definiert werden.“"
                            },
                            {
                                "example_id": "fcb86586-f148-41b6-b9d3-5de0ad792b4a",
                                "sense_id": "2e3644dc-d30e-3c10-9ff5-5af09e184b60",
                                "text": "„Die im Titel des Beitrags angekündigten Termini Wortbildungsnest und Frame sowie ihre Handhabung in der vorliegenden Untersuchung sollen zunächst kurz erläutert und in der Forschungsgeschichte verortet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
