                        "entry_id": "03a6dfe8-90fd-3464-bb16-f97ff1640689",
                        "glosses": [
                            "Bouton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080e0161-12b1-460d-be4a-5449cd10160e",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "Op de knop (van de bel) drukken.",
                                "translation": "Appuyer sur le bouton (de la sonnette)."
                            },
                            {
                                "example_id": "694f20ec-a732-4a20-be48-e34528ccccff",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "Thermostaatknop voor het kiezen van de gewenste temperatuur (van de oven).",
                                "translation": "Commande thermostat pour choisir la température (du four)."
                            },
                            {
                                "example_id": "bedfc0aa-a02d-4c7d-a991-8b65a727fb62",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "De knop Start (van Windows).",
                                "translation": "Le bouton Démarrer (de Windows)."
                            },
                            {
                                "example_id": "9212e442-5f0c-4d7e-bbda-fb6e369d8309",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "De knop van een paraplu.",
                                "translation": "Le pommeau d’un parapluie."
                            },
                            {
                                "example_id": "8cbc759c-3f75-4c2e-be97-eaea494b4571",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "De knop van een deur.",
                                "translation": "La béquille / le bouton d’une porte."
                            },
                            {
                                "example_id": "7e19ba10-23c3-46ff-b611-ffeb2e4969de",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "De knop van een speld.",
                                "translation": "La tête d’une épingle."
                            },
                            {
                                "example_id": "ba0ca268-d77e-4876-93ab-f47c94b93bde",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "De knop omdraaien.",
                                "translation": "Tourner la page."
                            },
                            {
                                "example_id": "590e07cd-5665-4232-ac45-9842846d438a",
                                "sense_id": "398099c4-1f90-3a03-a970-0c76ef6d5e1e",
                                "text": "Het is alsof ik een knop heb omgedraaid.",
                                "translation": "C’est comme si j’avais tourné un bouton."
                            }
                        ]
                    },
                    {
