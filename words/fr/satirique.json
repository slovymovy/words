    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41dd81cb-1cb1-3add-b9cd-f4b45839526f",
                    "sense_definition": "Qui relève de la satire, qui critique ou dénonce les travers de quelqu'un ou de la société par la moquerie et l'ironie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce journal <w>satirique</w> publie chaque semaine des caricatures amusantes pour dénoncer l'actualité politique."
                        },
                        {
                            "text": "Le roman adopte un ton <w>satirique</w> pour souligner les absurdités de la vie administrative contemporaine."
                        }
                    ],
                    "synonyms": [
                        "ironique",
                        "mordant",
                        "sarcastique",
                        "caustique"
                    ],
                    "antonyms": [
                        "élogieux",
                        "laudatif"
                    ],
                    "common_phrases": [
                        "journal satirique",
                        "dessin satirique",
                        "ton satirique"
                    ]
                },
                {
                    "sense_id": "e84bdaa3-cd39-32d2-a33b-d9da133b3057",
                    "sense_definition": "Qui a un esprit mordant, porté à la raillerie blessante ou à la critique moqueuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doté d'un esprit <w>satirique</w>, il ne manquait jamais une occasion de tourner ses collègues en dérision."
                        },
                        {
                            "text": "Sa nature un peu trop <w>satirique</w> finissait par blesser même ses amis les plus fidèles."
                        }
                    ],
                    "synonyms": [
                        "caustique",
                        "mordant",
                        "railleur"
                    ],
                    "antonyms": [
                        "bienveillant"
                    ],
                    "common_phrases": [
                        "esprit satirique"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d91951cd-a667-30a8-bbd3-8a1090a460c2",
                    "sense_definition": "Auteur ou autrice d'ouvrages satiriques, personne qui pratique la satire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les grands <w>satiriques</w> de l'Antiquité ont su dénoncer les vices de leurs contemporains avec brio."
                        },
                        {
                            "text": "En tant que <w>satirique</w> engagé, il maniait la plume pour bousculer les certitudes du public."
                        }
                    ],
                    "synonyms": [
