                "senses": [
                    {
                        "sense_id": "cb0e8a62-9e69-3c00-8df3-01c3d6e1be78",
                        "entry_id": "35ec75f8-ea89-3b81-8630-ebd68bf7fa5a",
                        "glosses": [
                            "Décrit un croisement en X."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e6c8b1-01aa-43b3-9e0f-cfab5633ff0a",
                                "sense_id": "cb0e8a62-9e69-3c00-8df3-01c3d6e1be78",
                                "text": "Les nerfs optiques sont décussés : ils se croisent au niveau du chiasma et renseignent les aires visuelles de l'hémisphère cérébral opposé à l'œil dont ils sont issus. De même pour les nerfs du faisceau pyramidal qui décussent au niveau du bulbe."
                            }
                        ]
                    },
                    {
                        "sense_id": "a849e4c6-b984-3eb2-b67b-b8b365262971",
                        "entry_id": "35ec75f8-ea89-3b81-8630-ebd68bf7fa5a",
                        "glosses": [
                            "Se dit de structures, disposées par paires opposées, dont les axes centraux se croisent à angle droit d’un nœud à l’autre tout le long de la tige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2947dfed-ecce-4e33-8b45-40368061700b",
                                "sense_id": "a849e4c6-b984-3eb2-b67b-b8b365262971",
                                "text": "[T]iges couchées (portant des racines adventices), puis redressées, rondes, avec 2 lignes de poils longitudinales opposées décussées d’un entre-nœud au suivant […]."
                            },
                            {
                                "example_id": "e22055c0-dcd9-427d-8234-9f57e111797c",
                                "sense_id": "a849e4c6-b984-3eb2-b67b-b8b365262971",
                                "text": "[F]euilles opposées décussées, pétiolées, ovales cordées à triangulaires, terminées en pointe, à fortes dents […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a15abd7a-8268-3c4b-85c5-f7aaf83f1f8b",
                        "entry_id": "35ec75f8-ea89-3b81-8630-ebd68bf7fa5a",
                        "glosses": [
                            "Se dit d’emblèmes passées en sautoir."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b68761-ed9c-483b-80ad-5fd369948e6e",
                                "sense_id": "a15abd7a-8268-3c4b-85c5-f7aaf83f1f8b",
                                "text": "L’écu bleu est surmonté par les symboles de la dignité pontificale, identiques à ceux voulus par son prédécesseur Benoît XVI (mitre placée entre des clés décussées d’or et d’argent, reliées par un cordon rouge)"
                            }
                        ]
                    }
