                "senses": [
                    {
                        "sense_id": "8b45d33b-fee4-3cfd-8822-ddc72d1630a1",
                        "entry_id": "7ade938d-4da0-3dcc-924b-4cfaf5f5e00b",
                        "glosses": [
                            "biologisches, chemisches oder technisches System, zur Reinigung von Luft, in einem Innen- oder Außenraum"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "55b33cf5-4122-4406-af56-dab50bdd81c5",
                                "sense_id": "8b45d33b-fee4-3cfd-8822-ddc72d1630a1",
                                "text": "„Außerdem musste auch das überlastete Luftreinigungssystem umgebaut werden, um mit dem CO2-Filter der ‚Odyssey‘ arbeiten zu können, […]“"
                            },
                            {
                                "example_id": "76f4d2c8-a33d-4b09-bf9a-354f6416cb45",
                                "sense_id": "8b45d33b-fee4-3cfd-8822-ddc72d1630a1",
                                "text": "„Aufatmen im All: Das Luftreinigungssystem im US-Segment der Internationalen Raumstation ISS ist nach seinem Ausfall am Samstag wieder hergestellt worden.“"
                            },
                            {
                                "example_id": "a2f1958a-25c7-490a-82bb-f9089297cd87",
                                "sense_id": "8b45d33b-fee4-3cfd-8822-ddc72d1630a1",
                                "text": "„Nachdem bepflanzte Luftreinigungssysteme in den 90er Jahren stark propagiert und als mögliche Lösung zur Verminderung von Luftschadstoffen angesehen wurden, ist es um solche Systeme inzwischen auffällig ruhig geworden.“"
                            },
                            {
                                "example_id": "8be8dc04-05ca-4e35-81d4-04b1f921cbc2",
                                "sense_id": "8b45d33b-fee4-3cfd-8822-ddc72d1630a1",
                                "text": "„Das Biologische Luftreinigungssytem nutzt die Entgiftungsleistung speziell konditionierter Bakterienstaemme fuer den Schadstoffabbau in der Raumluft aus. “"
                            },
                            {
                                "example_id": "27617044-6e24-42f0-9b19-58b7bbdd0b9a",
                                "sense_id": "8b45d33b-fee4-3cfd-8822-ddc72d1630a1",
                                "text": "„Ein Luftreinigungssystem, das Yogi Goswami von der University of Florida in Gainesville bereits im Jahr 1990 vorstellte, kann vermutlich auch die Sporen des Milzbranderregers (Bacillus anthracis) aus der Raumluft filtern und zerstören“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
