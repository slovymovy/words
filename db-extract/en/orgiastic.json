                        "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                        "entry_id": "693b57ed-e871-3625-8dda-65d06e43ccca",
                        "glosses": [
                            "Relating to an orgy; uncontrolled, wild."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b160914-1a08-426b-b7de-1c70f36d912d",
                                "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                "text": "1919, Sax Rohmer, Dope\nDancing was in progress, or, rather, one of those orgiastic ceremonies which passed for dancing during this pagan period."
                            },
                            {
                                "example_id": "4e0cc8a7-0733-466d-be5f-6ee96316d201",
                                "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                "text": "Gatsby believed in the green light, the orgiastic future that year by year recedes before us. It eluded us then, but that's no matter—tomorrow we will run faster, stretch out our arms farther … And one fine morning—"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94d586d1-19df-41dd-aeb7-95e6ecd6c704",
                        "source_entry_id": "693b57ed-e871-3625-8dda-65d06e43ccca",
                        "source_sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                        "source_sense_description": "relating to an orgy",
                        "target_lang_word": "orgiastique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgiastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95a2706c-9db0-3950-b723-effdc87f3edc",
                                        "entry_id": "4215b021-7dfb-3c99-abee-d690f6f8aa19",
                                        "glosses": [
                                            "Relatif aux orgies."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c7c933-d1bd-44a7-800c-aff66c0481e0",
                                                "sense_id": "95a2706c-9db0-3950-b723-effdc87f3edc",
                                                "text": "La civilisation du continent blanc a pu croître en sublimant en des formes de moins en moins nocives cette nécessité orgiastique de l’homme et des foules."
                                            },
                                            {
                                                "example_id": "7a468c12-d99f-430a-b6d5-2d77ddd33632",
                                                "sense_id": "95a2706c-9db0-3950-b723-effdc87f3edc",
                                                "text": "La répudiation de toute pratique orgiastique et sanglante semblait donc se combiner avec celle du panthéon ancien comportant des sacrifices animaux, dont les textes ne font pas mystère ; l'action de Zarathuštra se présentait ainsi comme une revendication des éléments de paix et de conversion agraire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7200c8f6-003a-4f17-8c26-d14e0c88154a",
                        "source_entry_id": "693b57ed-e871-3625-8dda-65d06e43ccca",
                        "source_sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                        "source_sense_description": "relating to an orgy",
                        "target_lang_word": "orgiastyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
