                                        "glosses": [
                                            "To be conveyed through the air, waft."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d13862-f661-43ef-addb-a6c6457238aa",
                                                "sense_id": "0c559bd6-9513-3a29-8649-670d93453c16",
                                                "text": "[…] thumping guns and pattering musket-shots, the long big boom of surgent hosts, and the muffled voluming and crash of storm-bells, proclaimed that the insurrection was hot."
                                            },
                                            {
                                                "example_id": "469b9f1d-1214-4b95-adf3-191874a1db25",
                                                "sense_id": "0c559bd6-9513-3a29-8649-670d93453c16",
                                                "text": "[…] the Colonel, before he sat down, went about shutting the registers, through which a welding heat came voluming up from the furnace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca792ac0-c370-3e2c-b430-27e9ca31055c",
                                        "entry_id": "c2093bc0-8048-3534-be22-d016b14542a5",
                                        "glosses": [
                                            "To cause to move through the air, waft."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cdfafc-19d8-4488-ac19-94533adf4dba",
                                                "sense_id": "ca792ac0-c370-3e2c-b430-27e9ca31055c",
                                                "text": "We lay leaning over the bows, now looking up at the mist blown in never-ending volumed sheets, now at the sail swelling in the wind before which it fled, and again down at the water through which our boat was ploughing its evanescent furrow."
                                            },
                                            {
                                                "example_id": "84ca651b-569b-4106-ba3b-84930a04bddc",
                                                "sense_id": "ca792ac0-c370-3e2c-b430-27e9ca31055c",
                                                "text": "The censer, voluming upwards its ash-gray smoke, was now passed from hand to hand three times round the patient, and finally deposited on the floor at his feet."
                                            },
                                            {
                                                "example_id": "a7f9c7de-ec79-48af-b8d4-432af9a48ddc",
                                                "sense_id": "ca792ac0-c370-3e2c-b430-27e9ca31055c",
                                                "text": "The record player on the first floor volumed up Lonnie Johnson singing, “Tomorrow night, will you remember what you said tonight?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7816b488-95dd-33a3-a9ec-66a41310830f",
                                        "entry_id": "c2093bc0-8048-3534-be22-d016b14542a5",
                                        "glosses": [
                                            "To swell."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
