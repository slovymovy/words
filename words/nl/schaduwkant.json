{
    "word_family": [
        "schaduw",
        "kant",
        "schaduwzijde",
        "schaduwrijk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0b15bcb-546f-3f1c-8521-1fecc2bc13a5",
                    "sense_definition": "de minder plezierige of negatieve kant van een zaak of situatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "negatieve aspecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elk groot succes heeft helaas ook een <w>schaduwkant</w> die mensen vaak vergeten.",
                            "target_lang_translations": {
                                "en": "Every great success unfortunately also has a <w>downside</w> that people often forget."
                            }
                        },
                        {
                            "text": "De <w>schaduwkant</w> van deze nieuwe technologie is dat onze privacy minder goed beschermd is.",
                            "target_lang_translations": {
                                "en": "The <w>dark side</w> of this new technology is that our privacy is less well protected."
                            }
                        }
                    ],
                    "synonyms": [
                        "keerzijde",
                        "nadeel",
                        "minpunt",
                        "tekortkoming"
                    ],
                    "antonyms": [
                        "voordeel",
                        "pluspunt",
                        "lichtpunt"
                    ],
                    "common_phrases": [
                        "de schaduwkant van",
                        "een duidelijke schaduwkant"
                    ],
                    "target_lang_definitions": {
                        "en": "the less pleasant or negative side of a matter or situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "downside",
                                "target_lang_sense_clarification": "a negative aspect of something otherwise positive"
                            },
                            {
                                "target_lang_word": "dark side",
                                "target_lang_sense_clarification": "the negative or hidden part of something"
                            },
                            {
                                "target_lang_word": "shadow side",
                                "target_lang_sense_clarification": "the less visible, often negative aspect"
                            },
                            {
                                "target_lang_word": "seamy side",
                                "target_lang_sense_clarification": "the most unpleasant or sordid aspect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cce063b-0f18-3289-80dc-07c311bb09bc",
                    "sense_definition": "de zijde van een object of plek die zich in de schaduw bevindt of van het licht afgekeerd is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke zijde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer zitten we liever aan de <w>schaduwkant</w> van het terras om koel te blijven.",
                            "target_lang_translations": {
                                "en": "In the summer, we prefer to sit on the <w>shady side</w> of the terrace to stay cool."
                            }
                        },
                        {
                            "text": "De bloemen aan de <w>schaduwkant</w> van het huis groeien veel minder snel dan die in de zon.",
                            "target_lang_translations": {
                                "en": "The flowers on the <w>shady side</w> of the house grow much slower than those in the sun."
                            }
                        }
                    ],
                    "antonyms": [
                        "zonzijde",
                        "lichtzijde"
                    ],
                    "common_phrases": [
                        "aan de schaduwkant"
                    ],
                    "target_lang_definitions": {
                        "en": "the side of an object or place that is in the shade or turned away from the light"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shady side",
                                "target_lang_sense_clarification": "the side that is in the shade"
                            },
                            {
                                "target_lang_word": "shadowy side",
                                "target_lang_sense_clarification": "the side characterized by shadows"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
