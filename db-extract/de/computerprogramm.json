                "senses": [
                    {
                        "sense_id": "ef830f63-ce58-3b9e-9266-68969905a85f",
                        "entry_id": "3e60af75-884c-31fa-815c-e03038c1ab18",
                        "glosses": [
                            "Folge von Anweisungen für einen Computer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e825d03-8a54-45a5-b7ab-6962f5ca6061",
                                "sense_id": "ef830f63-ce58-3b9e-9266-68969905a85f",
                                "text": "Hast du schon dieses neue Computerprogramm getestet?"
                            },
                            {
                                "example_id": "ea1a66fd-fe2b-4349-a570-af063b27e417",
                                "sense_id": "ef830f63-ce58-3b9e-9266-68969905a85f",
                                "text": "„Fakt oder Fake heißt ein neues Computerprogramm, das Fake News automatisiert erkennen soll.“"
                            },
                            {
                                "example_id": "4b229cd1-2ef7-4f49-98f0-0d31ff78591f",
                                "sense_id": "ef830f63-ce58-3b9e-9266-68969905a85f",
                                "text": "„Der Bundeswahlleiter Dieter Sarreither geht davon aus, dass die Mängel bei dem Computerprogramm für die Bundestagswahl bis zum 24. September behoben werden können.“"
                            },
                            {
                                "example_id": "1e2361dd-834f-4880-804d-c906360a57b7",
                                "sense_id": "ef830f63-ce58-3b9e-9266-68969905a85f",
                                "text": "„Das bedeutet also moderne gesellschaftliche Freiheit: Ein Computerprogramm sagt uns, wer zu uns passt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
