                ],
                "senses": [
                    {
                        "sense_id": "992198f1-eff3-3f5b-b0fc-75d9c9b69437",
                        "entry_id": "40abc787-31e4-3dcf-a0d8-089a65259b5b",
                        "glosses": [
                            "A child born to Jewish parents whose relationship is incestuous or otherwise forbidden by Jewish law (e.g. an unmarried man and a married woman), or the descendant of such a person."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "390b6cbb-1fde-4f8e-b219-9202ee8f9b3d",
                                "sense_id": "992198f1-eff3-3f5b-b0fc-75d9c9b69437",
                                "text": "No descendant of a mamzer may ever enter the assembly, no matter how many generations later."
                            }
                        ]
                    },
                    {
                        "sense_id": "25ae8bb2-5dfc-3907-9aa7-02b8265ad7ec",
                        "entry_id": "40abc787-31e4-3dcf-a0d8-089a65259b5b",
                        "glosses": [
                            "A child who is born from an incestuous or adulterous relationship; a bastard."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a1c59553-80d7-39ed-90e7-9269df46c718",
                        "entry_id": "40abc787-31e4-3dcf-a0d8-089a65259b5b",
                        "glosses": [
                            "A contemptible person; a jerk."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
