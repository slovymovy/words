                ],
                "senses": [
                    {
                        "sense_id": "ab8e2028-f90f-37cc-a537-ccdf53a53a4a",
                        "entry_id": "ac63f65f-a8fc-301c-ab3f-8e597fb24ca0",
                        "glosses": [
                            "een chemische stof die sterk op de traanklieren werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ed0b75-69e7-420c-a549-eddc4fbda93f",
                                "sense_id": "ab8e2028-f90f-37cc-a537-ccdf53a53a4a",
                                "text": "In Bahrein sloeg de politie 's nachts op de slapende betogers in met stokken, en gebruikte traangas en kogels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56157f16-4bd5-4c29-8210-43054f072a50",
                        "source_entry_id": "ac63f65f-a8fc-301c-ab3f-8e597fb24ca0",
                        "source_sense_id": "ab8e2028-f90f-37cc-a537-ccdf53a53a4a",
                        "target_lang_word": "Tränengas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tränengas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "892bccbd-25ae-39d7-981c-c9af634fe2c8",
                                        "entry_id": "a1aaec1d-e7b9-3679-94cf-4f8b85d58c7c",
                                        "glosses": [
                                            "chemische Waffe, die die Schleimhäute reizt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f9f64e-9821-484f-bacc-ba94bb45018b",
                                                "sense_id": "892bccbd-25ae-39d7-981c-c9af634fe2c8",
                                                "text": "Die Polizei ging mit Tränengas gegen die Demonstranten vor."
                                            },
                                            {
                                                "example_id": "091c7750-ac87-4952-9241-8da9994e9d3f",
                                                "sense_id": "892bccbd-25ae-39d7-981c-c9af634fe2c8",
                                                "text": "„Proteste gibt es in Istanbul tagtäglich gegen alles und jeden, aber die Unverfrorenheit, friedliche Bürger im Schutznebel von Tränengas krankenhausreif zu prügeln, war der sprichwörtliche Tropfen, der das Fass zum Überlaufen brachte.“"
                                            },
                                            {
                                                "example_id": "ac1fadfa-35e3-4ae3-a3ce-10a077e866e2",
                                                "sense_id": "892bccbd-25ae-39d7-981c-c9af634fe2c8",
                                                "text": "„Die Polizisten feuerten Tränengas in die Menge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2af38b4b-5633-4d33-aabc-b36484c80c47",
                        "source_entry_id": "ac63f65f-a8fc-301c-ab3f-8e597fb24ca0",
                        "source_sense_id": "ab8e2028-f90f-37cc-a537-ccdf53a53a4a",
                        "target_lang_word": "tear gas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tear gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "807691b7-da9e-317d-8b43-65c57ad9c113",
                                        "entry_id": "836359fb-618a-343b-9000-4bea4241187f",
                                        "glosses": [
                                            "Any lachrymatory, non-lethal chemical compound that causes the eyes to sting and water and/or irritates the respiratory system, mostly used for controlling crowds during riots or as self-defense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb7fd89-1634-49cb-b26a-06914c5512c0",
                                                "sense_id": "807691b7-da9e-317d-8b43-65c57ad9c113",
                                                "text": "The dispatches […] also exposed the blatant discrepancy between the west's professed values and actual foreign policies. Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tear gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a6d221f-ed50-3ac5-a1a1-2473ee4d2720",
                                        "entry_id": "74aade35-5f68-3cb0-9afd-4ecbd98f7666",
                                        "glosses": [
                                            "To use tear gas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade4d6dc-d52a-42c7-a954-b07018c57e91",
                                                "sense_id": "9a6d221f-ed50-3ac5-a1a1-2473ee4d2720",
                                                "text": "The riot squad tear gassed the mob."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06b38149-64cc-4d8a-a0ff-d5a7aa42c3f4",
                        "source_entry_id": "ac63f65f-a8fc-301c-ab3f-8e597fb24ca0",
                        "source_sense_id": "ab8e2028-f90f-37cc-a537-ccdf53a53a4a",
                        "target_lang_word": "gaz lacrymogène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaz lacrymogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee081ca2-bfa8-3cc1-afb1-db558ba93c24",
                                        "entry_id": "42e7bfbb-8801-325f-918c-4b664f8a8ea0",
                                        "glosses": [
                                            "Substance chimique provoquant une irritation des muqueuses et un écoulement lacrymal (larmes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811720bc-1b7a-46c6-8eca-1f8d41f3f3e9",
                                                "sense_id": "ee081ca2-bfa8-3cc1-afb1-db558ba93c24",
                                                "text": "L’usage de ces gaz lacrymogènes a été interdit en temps de guerre par la Convention internationale sur les armes chimiques de Genève, en 1993."
                                            },
                                            {
                                                "example_id": "74d6e3cb-58f4-4a38-9e4f-fcb3181336b6",
                                                "sense_id": "ee081ca2-bfa8-3cc1-afb1-db558ba93c24",
                                                "text": "La préfecture de police de Paris a annoncé hier avoir saisi l’Inspection générale de la police nationale (IGPN), après la diffusion sur les réseaux sociaux d’une vidéo montrant des policiers aspergeant un homme de gaz lacrymogène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
