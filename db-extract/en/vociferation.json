                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e1d188-d0f4-48a9-a4ee-6a30a00881ec",
                                                "sense_id": "a20d714a-c8aa-3aa9-a9a6-eedf429719db",
                                                "text": "Krzyk ptaków nie pozwalał mi usnąć."
                                            }
                                        ],
