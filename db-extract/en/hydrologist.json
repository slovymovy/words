                    {
                        "sense_id": "0943fdf6-aba4-3d5d-81cd-96e000c88cd8",
                        "entry_id": "d8256627-6db3-3cfb-ae5f-6125506d5359",
                        "glosses": [
                            "Someone who is skilled in or practises hydrology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0762752-5533-411a-89f5-c44a0062b493",
                                "sense_id": "0943fdf6-aba4-3d5d-81cd-96e000c88cd8",
                                "text": "Some experts see today’s action as only a short-term fix. While the USBR is “very focused on just getting through this to next year”, any cuts would probably need to be in place far longer, University of Oxford hydrologist Kevin Wheeler said."
                            }
                        ]
                    }
