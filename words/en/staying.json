                                "target_lang_sense_clarification": "指在旅馆或某人家中暂时居住"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84a38ddb-59e8-3b4d-bd6a-34551976cb0f",
                    "sense_definition": "A specific instance of visiting or remaining in a place for a period of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her frequent <w>stayings</w> at the country estate were always a source of joy for the family.",
                            "target_lang_translations": {
                                "ru": "Её частые <w>пребывания</w> в загородном поместье всегда были источником радости для семьи.",
                                "zh": "她频繁在乡间别墅的<w>逗留</w>总是给家人带来欢乐。"
                            }
                        },
                        {
                            "text": "The journal detailed the comings and <w>stayings</w> of various guests throughout the summer.",
                            "target_lang_translations": {
                                "ru": "В журнале подробно описывались приезды и <w>пребывания</w> различных гостей в течение всего лета.",
                                "zh": "日志详细记录了整个夏天不同客人的来访与<w>逗留</w>情况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visit",
                        "sojourn",
                        "stay"
                    ],
                    "antonyms": [
                        "departure",
                        "leaving"
                    ],
                    "common_phrases": [
                        "comings and stayings"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный случай посещения или нахождения в каком-либо месте в течение определенного времени.",
                        "zh": "指在某地停留或居住一段时间的经历。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пребывание",
                                "target_lang_sense_clarification": "нахождение в определенном месте"
