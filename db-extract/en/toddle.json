                        "glosses": [
                            "To walk unsteadily, as a small child does."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "afc2f219-ba0a-3cb1-80fb-0b901c92e368",
                        "entry_id": "0daf809e-7a27-3aa9-89f2-e91b22a9cc92",
                        "glosses": [
                            "To walk or travel in a carefree manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2778bc1-11e1-4d1b-913b-42c6117b79c6",
                                "sense_id": "afc2f219-ba0a-3cb1-80fb-0b901c92e368",
                                "text": "There he was, just toddling along."
                            },
                            {
                                "example_id": "ce96b1be-2820-45c4-b77f-df8b25025764",
                                "sense_id": "afc2f219-ba0a-3cb1-80fb-0b901c92e368",
                                "text": "So off we toddled, Marjorie, Holt, and I, in a growler, — spotted the crib in less than no time, — invited ourselves in by the kitchen window — house seemed empty."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9c5dcec-1a47-4095-a9bb-8cd62aa78038",
                        "source_entry_id": "0daf809e-7a27-3aa9-89f2-e91b22a9cc92",
                        "source_sense_description": "walk unsteadily",
                        "target_lang_word": "chanceler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanceler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ddde023-0949-30d3-9c4d-3a4838fb6a61",
                                        "entry_id": "24d872c3-841c-3432-8cfd-81f2948b96b6",
                                        "glosses": [
                                            "Être peu ferme sur ses pieds ; pencher de côté et d’autre, comme si on allait tomber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953b45d3-2884-4d06-94ab-7172548cd350",
                                                "sense_id": "6ddde023-0949-30d3-9c4d-3a4838fb6a61",
                                                "text": "Quand Victor eut fermé la porte, la marquise tomba sur un siège ; ses jambes chancelèrent, elle fondit en larmes."
                                            },
                                            {
                                                "example_id": "8f5f3db3-c067-4dee-9b1d-853818d20d08",
                                                "sense_id": "6ddde023-0949-30d3-9c4d-3a4838fb6a61",
                                                "text": "Bon Dieu de bon Dieu ! Une sueur froide le fit chanceler sur ses jambes flageolantes comme si elles eussent été bourrées de coton."
                                            },
                                            {
                                                "example_id": "ae125ae4-84cc-4ce0-bb48-d22a4c6b68e6",
                                                "sense_id": "6ddde023-0949-30d3-9c4d-3a4838fb6a61",
                                                "text": "La marmule donna un coup de boule au Sensi, qui chancela puis s'effondra dans les bras de Fauve. Cette dernière hurla de frayeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15f3b158-ffd2-351d-b3da-92691b1e4f98",
                                        "entry_id": "24d872c3-841c-3432-8cfd-81f2948b96b6",
                                        "glosses": [
                                            "Ne pas être ferme ; vaciller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a67b87-e7fb-4d54-9284-1a02e7805f46",
                                                "sense_id": "15f3b158-ffd2-351d-b3da-92691b1e4f98",
                                                "text": "Puis, ne percevant aucun bruit, il introduisit dans une serrure une grosse clef qui grinça et ouvrit une porte mal assujettie sur ses gonds, qui tourna en chancelant sur elle-même comme un homme ivre."
                                            },
                                            {
                                                "example_id": "6c8e9784-2d2f-42b4-bdd5-58162aed5fc2",
                                                "sense_id": "15f3b158-ffd2-351d-b3da-92691b1e4f98",
                                                "text": "Écoute Paul, tu es très sympa mais tu chancelles pour un rien. Je voudrais pas être à ta place le jour où tu rencontreras une coccinelle sans taches noires."
                                            },
                                            {
                                                "example_id": "1f5cc958-3832-43b5-83ac-4fb5e383b3f0",
                                                "sense_id": "15f3b158-ffd2-351d-b3da-92691b1e4f98",
                                                "text": "Il varie, il chancèle dans ses réponses, dans ses résolutions, dans sa foi, dans ses opinions."
                                            },
                                            {
                                                "example_id": "eddc1570-aeee-4b68-a3fe-94efa1540c69",
                                                "sense_id": "15f3b158-ffd2-351d-b3da-92691b1e4f98",
                                                "text": "Sa fortune chancèle."
                                            },
                                            {
                                                "example_id": "3dbadf0f-b800-45ea-9cb2-e30e595da16e",
                                                "sense_id": "15f3b158-ffd2-351d-b3da-92691b1e4f98",
                                                "text": "Sa mémoire chancèle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc44e316-387e-4eee-a3b1-ce82ba564f74",
                        "source_entry_id": "0daf809e-7a27-3aa9-89f2-e91b22a9cc92",
