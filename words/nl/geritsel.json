    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2464610d-dc2d-3ee5-927b-226d6563ea2c",
                    "sense_definition": "een zacht, herhaald geluid zoals van bewegende bladeren of papier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde een zacht <w>geritsel</w> tussen de droge bladeren in de tuin.",
                            "target_lang_translations": {
                                "en": "I heard a soft <w>rustle</w> among the dry leaves in the garden."
                            }
                        },
                        {
                            "text": "Het <w>geritsel</w> van papier in de stille bibliotheek was erg storend.",
                            "target_lang_translations": {
                                "en": "The <w>rustling</w> of paper in the quiet library was very distracting."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zacht geritsel",
                        "geritsel van bladeren",
                        "geritsel van papier"
                    ],
                    "target_lang_definitions": {
                        "en": "a soft, repeated sound such as that of moving leaves or paper"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rustle",
                                "target_lang_sense_clarification": "the sound of leaves or paper"
                            },
                            {
                                "target_lang_word": "rustling",
                                "target_lang_sense_clarification": "the continuous soft sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "155925e0-b831-3dc9-95d9-29b7da1d82f9",
                    "sense_definition": "het op een onduidelijke of geheimzinnige manier regelen van zaken, vaak achter de schermen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "handelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was veel politiek <w>geritsel</w> nodig om dit wetsvoorstel erdoor te krijgen.",
                            "target_lang_translations": {
                                "en": "A lot of political <w>wheeling and dealing</w> was needed to get this bill passed."
                            }
                        },
                        {
                            "text": "Na al het <w>geritsel</w> achter de schermen kreeg hij eindelijk de felbegeerde baan.",
                            "target_lang_translations": {
                                "en": "After all the <w>maneuvering</w> behind the scenes, he finally got the coveted job."
                            }
                        }
                    ],
                    "synonyms": [
                        "gesjacher",
                        "gerommel"
                    ],
                    "common_phrases": [
                        "politiek geritsel",
                        "geritsel achter de schermen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in een politieke of zakelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "arranging matters in an unclear or mysterious way, often behind the scenes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wheeling and dealing",
                                "target_lang_sense_clarification": "shrewd political or business maneuvering"
                            },
                            {
                                "target_lang_word": "maneuvering",
                                "target_lang_sense_clarification": "devious or strategic planning"
                            },
                            {
                                "target_lang_word": "scheming",
                                "target_lang_sense_clarification": "secretive planning"
                            }
                        ]
                    }
                }
            ]
        }
    ]
