                        "zh": "缺乏快乐、明亮或兴趣；阴郁或沉闷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серый",
                                "target_lang_sense_clarification": "унылый, безынтересный"
