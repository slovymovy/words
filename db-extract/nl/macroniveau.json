                        "examples": [
                            {
                                "example_id": "f9bb3453-7e0b-4cf3-ad73-e61532665e30",
                                "sense_id": "7cb2e1b4-c1e0-31f9-8965-1e051a5ad809",
                                "text": "Nu heeft het vermogen van mensen om microdeeltjes op macroniveau te manipuleren een hoogtepunt bereikt: we hebben computers en nanomateriaal."
                            },
                            {
                                "example_id": "d3c7e196-5596-48a5-b9ee-0d0315a02d4f",
                                "sense_id": "7cb2e1b4-c1e0-31f9-8965-1e051a5ad809",
                                "text": "Op een macroniveau houdt dit in dat iedereen zich eerst druk moet maken om de essentiële morele kwaliteit van de samenleving, en dan pas om de practicalia."
                            },
                            {
                                "example_id": "baba32f1-4838-44f5-a458-d3910192066b",
                                "sense_id": "7cb2e1b4-c1e0-31f9-8965-1e051a5ad809",
                                "text": "Het pad naar Vlaamse onafhankelijkheid moet volgens de N-VA geleidelijk verlopen. De partij hoopt door het overdragen van Belgische bevoegdheden naar de deelstaten geleidelijk een onafhankelijk Vlaanderen te bereiken. De partij is echter niet anti-Europees. De N-VA ziet in de Europese Unie een politieke unie, die overigens niet mag uitgroeien tot superstaat. In de ogen van de partij is Vlaanderen \"het meest geschikte microniveau, de Europese Unie het macroniveau\""
                            }
                        ]
                    }
