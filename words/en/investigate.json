{
    "word_family": [
        "investigation",
        "investigator",
        "investigative",
        "investigatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d8fc36e-fbdb-3ac6-b7bb-a28953a7c773",
                    "sense_definition": "To inquire into or study something systematically in order to discover facts or information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police need to <w>investigate</w> the cause of the accident before making a report.",
                            "target_lang_translations": {
                                "ru": "Полиции необходимо <w>расследовать</w> причину аварии, прежде чем составлять отчет."
                            }
                        },
                        {
                            "text": "Scientists will <w>investigate</w> the effects of the new drug on patients over the next year.",
                            "target_lang_translations": {
                                "ru": "Ученые будут <w>исследовать</w> воздействие нового препарата на пациентов в течение следующего года."
                            }
                        }
                    ],
                    "synonyms": [
                        "underseek"
                    ],
                    "antonyms": [
                        "ignore",
                        "overlook"
                    ],
                    "common_phrases": [
                        "investigate the cause",
                        "investigate the matter",
                        "thoroughly investigate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематически изучать или исследовать что-либо для выяснения фактов или получения информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исследовать",
                                "target_lang_sense_clarification": "систематически изучать"
                            },
                            {
                                "target_lang_word": "изучать",
                                "target_lang_sense_clarification": "внимательно рассматривать"
                            },
                            {
                                "target_lang_word": "расследовать",
                                "target_lang_sense_clarification": "выяснять обстоятельства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81fd7aba-ffbd-33c8-a69e-022f1c05ca97",
                    "sense_definition": "To examine or scrutinize something closely in order to discover something hidden, secret, or illegal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Detectives were assigned to <w>investigate</w> an unsolved murder from twenty years ago.",
                            "target_lang_translations": {
                                "ru": "Детективам поручили <w>расследовать</w> нераскрытое убийство двадцатилетней давности."
                            }
                        },
                        {
                            "text": "The committee was formed to <w>investigate</w> allegations of corruption within the company.",
                            "target_lang_translations": {
                                "ru": "Комитет был сформирован для того, чтобы <w>расследовать</w> обвинения в коррупции внутри компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "underseek"
                    ],
                    "common_phrases": [
                        "investigate a crime",
                        "investigate a murder",
                        "investigate allegations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно проверять или изучать что-либо с целью обнаружения скрытых, секретных или незаконных действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расследовать",
                                "target_lang_sense_clarification": "проводить следствие"
                            },
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "контролировать на предмет нарушений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef918cec-3da6-3d42-8b78-9e3edb65ec47",
                    "sense_definition": "To conduct a formal inquiry or examination without a specific object mentioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the alarm went off, the security guard went downstairs to <w>investigate</w>.",
                            "target_lang_translations": {
                                "ru": "Когда сработала сигнализация, охранник спустился вниз, чтобы <w>выяснить</w>, в чем дело."
                            }
                        },
                        {
                            "text": "If you hear a strange noise in the attic, you should probably <w>investigate</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы услышите странный шум на чердаке, вам, вероятно, стоит <w>проверить</w>, что там такое."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go to investigate",
                        "refuse to investigate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить формальную проверку или осмотр без указания конкретного объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выяснить",
                                "target_lang_sense_clarification": "разузнать обстановку"
                            },
                            {
                                "target_lang_word": "проверить",
                                "target_lang_sense_clarification": "посмотреть, что происходит"
                            },
                            {
                                "target_lang_word": "разузнать",
                                "target_lang_sense_clarification": "собрать информацию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}