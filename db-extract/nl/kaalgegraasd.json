                                            {
                                                "example_id": "0f2958c3-f0c9-4a3d-a37a-06b5ad72fa96",
                                                "sense_id": "dcbcdacd-8025-3864-a5a4-bcd799335a70",
                                                "text": "Minutes later, several more close-cropped fellows passed by in an evident hurry."
                                            },
                                            {
                                                "example_id": "113d8f04-4e9f-4221-8afe-a01053d0dff7",
                                                "sense_id": "dcbcdacd-8025-3864-a5a4-bcd799335a70",
                                                "text": "Bradly could see the livid mark of scars on the close-cropped sandy skull. They were recent, and still showed contused edges[.]"
