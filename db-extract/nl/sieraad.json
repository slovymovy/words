                "senses": [
                    {
                        "sense_id": "06a7404b-0b4f-30e0-b3e1-68732fa62812",
                        "entry_id": "5443c94f-b0b9-349a-8d20-35422f3e3432",
                        "glosses": [
                            "een voorwerp, meestal van edele metalen en edelstenen, dat bedoeld is het menselijk lichaam te tooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027233cc-5038-4fd2-b6ce-ff6b7197f9a2",
                                "sense_id": "06a7404b-0b4f-30e0-b3e1-68732fa62812",
                                "text": "En ja.... sta me toe'Hij maakte het pakje open en legde het sieraad snel om de hals van Christa, deed het slotje dicht en zette een paar passen naar achteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "527b31f4-d8c9-42ef-b15b-cab10a81db76",
                        "source_entry_id": "5443c94f-b0b9-349a-8d20-35422f3e3432",
                        "source_sense_id": "06a7404b-0b4f-30e0-b3e1-68732fa62812",
                        "source_sense_description": "een voorwerp, meestal van edele metalen en edelstenen, dat bedoeld is het menselijk lichaam te tooien",
                        "target_lang_word": "Schmuck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmuck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32e112de-667c-3632-9eaa-7d5e794fbe34",
                                        "entry_id": "f2628c4b-5fe0-37c3-b5ef-4c28564fa3a2",
                                        "glosses": [
                                            "Objekte oder Elemente, die der Verschönerung oder Verzierung eines Gegenstandes oder eines Lebewesens dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae850f3-3ffc-4150-9596-49c7ea80220c",
                                                "sense_id": "32e112de-667c-3632-9eaa-7d5e794fbe34",
                                                "text": "Man sollte bei Bildern nicht den Rahmen beachten, der ist meist nur Schmuck."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ceecd9a7-d8f1-3c8e-b278-1d148da62001",
                                        "entry_id": "f2628c4b-5fe0-37c3-b5ef-4c28564fa3a2",
                                        "glosses": [
                                            "Objekte, die zur Zierde von Personen oder deren Kleidung dienen, wie zum Beispiel Tattoos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3db0d3-8027-4076-8ecb-90f64aa66b0e",
                                                "sense_id": "ceecd9a7-d8f1-3c8e-b278-1d148da62001",
                                                "text": "Manche Personen zeigen gerne ihren Schmuck."
                                            },
                                            {
                                                "example_id": "c8127a2b-2458-4dc5-8784-bf65534a70c0",
                                                "sense_id": "ceecd9a7-d8f1-3c8e-b278-1d148da62001",
                                                "text": "„Mykenische Waffen, Schmuck und Keramik sind dagegen weniger ausdrucksvoll, stilistisch einfacher und von geringerer Farbqualität.“"
                                            },
                                            {
                                                "example_id": "3cc6aee0-b116-4b6f-9ecf-2ab5208b69fa",
                                                "sense_id": "ceecd9a7-d8f1-3c8e-b278-1d148da62001",
                                                "text": "„Sonst hatte er keinen Schmuck an sich, und selbst die Kugeltasche, die an seiner rechten Seite hing, war aller Glasperlen und bunten Lederstreifen bar, mit denen die Eingeborenen sonst so gern ihre Jagdgerätschaften schmücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b78d00-61cd-4341-88f0-604040ca14ce",
                        "source_entry_id": "5443c94f-b0b9-349a-8d20-35422f3e3432",
                        "source_sense_id": "06a7404b-0b4f-30e0-b3e1-68732fa62812",
                        "source_sense_description": "een voorwerp, meestal van edele metalen en edelstenen, dat bedoeld is het menselijk lichaam te tooien",
                        "target_lang_word": "Schmuckstück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmuckstück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                        "entry_id": "79633e49-d14f-32fa-9b48-91a8d1c84cc3",
                                        "glosses": [
                                            "kostbarer (zur Zierde am Körper getragener) Gegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcdee7f2-b1e8-4c20-b2e1-a2f2be86c593",
                                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                                "text": "Pass auf auf dieses Schmuckstück."
                                            },
                                            {
                                                "example_id": "217f0147-b6f5-4f55-95d0-bb8a3e0bd3d8",
                                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                                "text": "„Lässt man die Wissenschaft außer Acht, dann handelt es sich bei Perlen um die wohl schönsten, zeitlosesten Schmuckstücke, die die Natur hervorbringt.“"
                                            },
                                            {
                                                "example_id": "5e2a9d4b-070b-4b20-8919-4f2d9b232ab6",
                                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                                "text": "„Insgesamt erbeuten sie 20 Schmuckstücke im Wert von mehr als 6,1 Millionen Dollar.“"
                                            },
                                            {
                                                "example_id": "19e9a6df-5be2-41bd-8f97-9b2f6ac7e9ab",
                                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                                "text": "„Sie holte hierauf aus ihrer Stube zwei Schmuckstücke und reichte sie dem blinden Schelm.“"
                                            },
                                            {
                                                "example_id": "dce011bb-8494-4db1-b323-18aa5fde1ed4",
                                                "sense_id": "d823d6a2-aec6-3e08-af32-ed9cad7af988",
                                                "text": "„Er kam gegen Mitte Juni an, und da ich in der Zwischenzeit dem Bassettespiel verfiel, hatte ich bis zu diesem Zeitpunkt mein ganzes Geld verloren und alle meine Schmuckstücke verkauft oder verpfändet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4590eec-29aa-33c5-abf4-a7b3c6e40d7c",
                                        "entry_id": "79633e49-d14f-32fa-9b48-91a8d1c84cc3",
                                        "glosses": [
                                            "besonders gelungener oder geschätzter Gegenstand (unter anderen)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b59b254-1ecb-4645-9801-34775f16fbe5",
                                                "sense_id": "e4590eec-29aa-33c5-abf4-a7b3c6e40d7c",
                                                "text": "Dieses Haus ist ja ein wahres Schmuckstück!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e90ae874-c5ed-3e2c-8d08-c1af2c320229",
                                        "entry_id": "79633e49-d14f-32fa-9b48-91a8d1c84cc3",
                                        "glosses": [
                                            "Liebste(r)"
                                        ],
                                        "tags": [
                                            "casual",
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
