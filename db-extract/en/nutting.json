                ],
                "senses": [
                    {
                        "sense_id": "faab693b-6b93-3a47-b8e3-d217de72d035",
                        "entry_id": "4e3f7002-81e7-3976-b7d0-bcc53982a819",
                        "glosses": [
                            "An outing to gather nuts."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "660005cd-7fe1-4b1a-bcb2-ecc8bc46251d",
                                "sense_id": "faab693b-6b93-3a47-b8e3-d217de72d035",
                                "text": "The younger people had their berrying frolics, sleigh-rides, kitchen dances, nuttings, and the like, and their elders their huskings, apple bees, and sewing societies, but against all these the deacon set his hard face."
                            }
                        ]
                    },
                    {
                        "sense_id": "164997f7-0f28-3aff-b3c5-1c94a854adbe",
                        "entry_id": "4e3f7002-81e7-3976-b7d0-bcc53982a819",
                        "glosses": [
                            "Gaining favor or subjugating oneself."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72f1e368-88b9-420f-b2e9-1edf40e4f690",
                                "sense_id": "164997f7-0f28-3aff-b3c5-1c94a854adbe",
                                "text": "Now another drop genius is planted upon you, to turn you up, as they call it: He tells you that he is going to receive fifty pounds of an uncle, and if you will go with him he will let you have ten or twenty pounds, and meet the squire at such a house in such a street and play with him, himself and you shall go halves, if you will persuade the squire to come to this place appointed; this is called nutting of you."
                            }
                        ]
                    },
                    {
                        "sense_id": "0594de85-56d0-31ae-a71d-3c35480de0b8",
                        "entry_id": "4e3f7002-81e7-3976-b7d0-bcc53982a819",
                        "glosses": [
                            "Thinking very hard or puzzling over something."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "371fec35-8fc4-44df-82bd-6de48a488bff",
                                "sense_id": "0594de85-56d0-31ae-a71d-3c35480de0b8",
                                "text": "After the party had wound up, I did a bit of hard nutting over my plans for trotting."
                            }
                        ]
                    }
                ],
