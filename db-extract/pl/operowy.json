                                            {
                                                "example_id": "55f23edd-8bbe-4034-b919-935f0ada8075",
                                                "sense_id": "35c19fd6-83dc-35f1-be63-32dc685798bd",
                                                "text": "The politician's address was so flamboyant as to be operatic."
                                            },
                                            {
                                                "example_id": "f5e7c7ce-9581-409c-89b6-bbbe629ec050",
                                                "sense_id": "35c19fd6-83dc-35f1-be63-32dc685798bd",
                                                "text": "She had stormed dramatically off and got on the first train she saw at Waterloo station and rode it the whole way down to Brighton, taking a room in a seedy B and B. But then, after a nap, still feeling wobbly and also wallowingly sorry for herself, Diantha climbed off the bed and sat down at the desk to write Charles some operatic note of farewell."
                                            }
                                        ]
                                    }
