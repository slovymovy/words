                {
                    "sense_id": "ac8675f1-222c-334e-bda9-cf0c83903348",
                    "sense_definition": "rustig en beheerst, zonder sterke emoties of opwinding",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet proberen <w>kalm</w> te blijven tijdens het examen.",
                            "target_lang_translations": {
                                "en": "You should try to stay <w>calm</w> during the exam.",
                                "ru": "Тебе нужно постараться сохранять <w>спокойствие</w> во время экзамена."
                            }
                        },
                        {
                            "text": "Zijn <w>kalme</w> manier van optreden bracht de angstige kinderen wat tot rust.",
                            "target_lang_translations": {
                                "en": "His <w>calm</w> manner of acting put the anxious children at ease.",
                                "ru": "Его <w>спокойная</w> манера поведения немного успокоила напуганных детей."
                            }
                        }
                    ],
                    "synonyms": [
