                                    {
                                        "sense_id": "717f4563-7a6e-34a7-9f82-f876dab5ece2",
                                        "entry_id": "a4b622b5-4cbf-3e94-b9d6-378bad00f812",
                                        "glosses": [
                                            "auf dem neuesten Stand, aktuell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8044d03-34db-4f5e-8a8e-6a7f8e75c86f",
                                                "sense_id": "717f4563-7a6e-34a7-9f82-f876dab5ece2",
                                                "text": "Im Interesse des Überblicks sollten die Daten jedoch im Zuge der Einführung sukzessive erfasst und fortan à jour gehalten werden."
                                            }
