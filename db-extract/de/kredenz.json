                ],
                "senses": [
                    {
                        "sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                        "entry_id": "737cc105-2860-37eb-ac74-85f4240e7b03",
                        "glosses": [
                            "Möbelstück mit Ablagefläche und Kästchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47a7862-ddeb-464a-96e9-e882efc12dc2",
                                "sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                                "text": "Die Speisen stehen auf der Kredenz."
                            },
                            {
                                "example_id": "0c746963-92c6-40ca-8a39-b58ceff1ed10",
                                "sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                                "text": "„Es gab auch einen runden Tisch, ein samtüberzogenes Kanapee, dazu Stühle ähnlicher Bauweise, eine sehr lange Kredenz, auf der ein großes Radio stand, und an der Stirnseite des Raumes noch ein riesiges Sofa, zwei kleine Tischchen, einen Ohrensessel und einen Hocker.“"
                            },
                            {
                                "example_id": "6ec0a9e4-192f-47f2-8276-e31310586051",
                                "sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                                "text": "„Im mittleren Zimmer entschloß er sich, in der Kredenz nachzusehen.“"
                            },
                            {
                                "example_id": "fdd53cb8-0651-4677-8867-cde48e4684f0",
                                "sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                                "text": "„Elisabeth Mattner lehnt gegen die Kredenz, das Flackern der niederbrennenden Kerze zeichnet einen grotesken Schatten an die Wand.“"
                            },
                            {
                                "example_id": "c399ef9f-0225-4be3-b598-1bf8445b92e9",
                                "sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                                "text": "„Mit geröteten Wangen trabte sie selig von Gast zu Gast, bot diesem eine Schachtel Zündhölzchen an, jenem eine Zigarre, einem dritten Obst von einer der enormen vergoldeten Schüsseln, die auf der Kredenz standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8c601f4-cc60-4555-84fe-63081b374bce",
                        "source_entry_id": "737cc105-2860-37eb-ac74-85f4240e7b03",
                        "source_sense_id": "bd0bfa1b-084a-3d8d-a044-0f1e51fece9c",
                        "source_sense_description": "Möbelstück mit Ablagefläche und Kästchen",
                        "target_lang_word": "cupboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cupboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2fb50c5-29ba-30fe-8cf2-d3cfddb973d4",
                                        "entry_id": "691a5093-cf6e-39ff-93df-b61026637370",
                                        "glosses": [
                                            "A board or table used to openly hold and display silver plate and other dishware; a sideboard; a buffet."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ba0f61-97d8-4985-97a1-6118f619499b",
                                                "sense_id": "e2fb50c5-29ba-30fe-8cf2-d3cfddb973d4",
                                                "text": "Cupboꝛde of plate or to ſette plate upon buffet z ma."
                                            },
                                            {
                                                "example_id": "1e7a2a60-3db1-4d07-be11-b3367e5521e2",
                                                "sense_id": "e2fb50c5-29ba-30fe-8cf2-d3cfddb973d4",
                                                "text": "from the cobbarde byſyde owr dyninge table"
                                            },
                                            {
                                                "example_id": "e3d23742-61c5-4780-996e-1e5d23871983",
                                                "sense_id": "e2fb50c5-29ba-30fe-8cf2-d3cfddb973d4",
                                                "text": "Now when the maids and pages all were gone, / One onely lampe upon the cubbard burning[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca6b81b-e6b6-3e2b-9e9f-e90dc0ad2b69",
                                        "entry_id": "691a5093-cf6e-39ff-93df-b61026637370",
                                        "glosses": [
                                            "Things displayed on a sideboard; dishware, particularly valuable plate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa60279f-8762-40ef-839a-053b049ce17a",
                                                "sense_id": "1ca6b81b-e6b6-3e2b-9e9f-e90dc0ad2b69",
                                                "text": "But howe comme to pas, / Your cupbord that was / Is tourned to glasse, / From syluere to brasse, / From golde to pewter, / Or els to a newter, / To copper, to tyn, / To lede, or alcumyn?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                        "entry_id": "691a5093-cf6e-39ff-93df-b61026637370",
                                        "glosses": [
                                            "A cabinet, closet, or other piece of furniture with shelves intended for storing cookware, dishware, or food; similar cabinets or closets used for storing other items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848073dd-5e1b-41f6-9e4a-f800bf6f7eb5",
                                                "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                                "text": "Put the cups back into the cupboard."
                                            },
                                            {
                                                "example_id": "32c79f5c-2a87-47c4-9373-85200b116e96",
                                                "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                                "text": "Cupborde to putte meate in – dressover s, m."
                                            },
                                            {
                                                "example_id": "a872ad83-37e3-4983-b347-7ef6a907c439",
                                                "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                                "text": "Old Mother Hubbard / Went to the cupboard, / To give the poor dog a bone; / When she came there, / The cupboard was bare, / And so the poor dog had none."
                                            },
                                            {
                                                "example_id": "427d8e91-f2be-40cd-9455-40da92cd7736",
                                                "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                                "text": "A cupboard with shelves for music-books."
                                            },
                                            {
                                                "example_id": "3576cec1-e6d1-4a89-bc6f-b34df30c6e30",
                                                "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                                "text": "As he had figured it out so far, the cupboard, or the key, or both together, brought plastic things to life, or if they were already alive, turned them into plastic. There were a lot of questions to be answered, though. Did it only work with plastic? Would, say, wooden or metal figures also come to life if shut up in the cupboard?"
                                            },
                                            {
                                                "example_id": "50b80466-2b9a-4e23-81cb-2bd48ee08a9c",
                                                "sense_id": "1d1d6acd-48cf-38af-b602-4c94640deb87",
                                                "text": "Harry was used to spiders, because the cupboard under the stairs was full of them, and that was where he slept."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154bba75-2de7-38c7-8c41-eab3ef8a7740",
                                        "entry_id": "691a5093-cf6e-39ff-93df-b61026637370",
                                        "glosses": [
                                            "Things stored in a cupboard; particularly food."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "315118ab-169f-45a0-bd72-835d73cd77ef",
                                                "sense_id": "154bba75-2de7-38c7-8c41-eab3ef8a7740",
                                                "text": "Some men they [make] love for what they can get, / And 'tis certain there's many a Lubbard; / Will sigh and will pant, seeming ready to faint, / And all for the love of the cubbard, brave boys! / And all [for the love of the Cup-board]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b18880-8b1d-3023-adfc-2794aa834b76",
                                        "entry_id": "691a5093-cf6e-39ff-93df-b61026637370",
                                        "glosses": [
                                            "A closet for storing coats."
                                        ],
                                        "tags": [
                                            "Pennsylvania",
                                            "UK",
                                            "Western"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2bf9be-6d7b-48a8-b4f2-94066b96d77d",
                                                "sense_id": "b6b18880-8b1d-3023-adfc-2794aa834b76",
                                                "text": "I hung the coat in the cupboard and bided my time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cupboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fedd9b5-664f-3739-9107-d7e41583e483",
                                        "entry_id": "e458d967-afec-3d69-8a94-f83e5c662853",
                                        "glosses": [
                                            "To collect, as into a cupboard; to hoard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c87cca7-0143-49e8-8d7b-dd81c6420d72",
                                                "sense_id": "5fedd9b5-664f-3739-9107-d7e41583e483",
                                                "text": "There was a time, when all the bodies members / Rebell'd againſt the Belly; thus accus'd it: / That onely like a Gulfe it did remaine / I'th midd'ſt a th'body, idle and vnactiue, / Still cubbording the Viand, neuer bearing / Like labour with the reſt, where th'other Inſtruments / Did ſee, and heare, deuiſe, inſtruct, walke, feele, / And mutually participate, did miniſter / Vnto the appetite; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
