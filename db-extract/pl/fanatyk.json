                        ]
                    },
                    {
                        "translation_id": "d052f624-01c5-4dcc-82d5-0512ac9a1699",
                        "source_entry_id": "462e7f8f-fe81-350e-b731-092108928a0c",
                        "source_sense_id": "dd0462d6-525c-324e-97cc-cb1632be05ee",
                        "target_lang_word": "Fanatiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fanatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                        "entry_id": "349479bf-3862-3c9b-95de-5ef2bcf42944",
                                        "glosses": [
                                            "jemand, der an einer Idee oder ideologischen Vorgabe unbedingt festhält, weitgehend ohne Rücksicht auf praktische Konsequenzen für ihn oder andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8dcc4da-ffad-441f-9c87-abfa9bfeea98",
                                                "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                                "text": "Er redet wie besessen: das ist ein echter Fanatiker!"
                                            },
                                            {
                                                "example_id": "c59fbbf2-14dc-4695-b6ef-1a054f880fae",
                                                "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                                "text": "Es gibt Fanatiker mit dem Koran in der Hand und solche, die auf die Bibel verweisen."
                                            },
                                            {
                                                "example_id": "6b02b124-8f7f-45d1-806e-c0fb6c0f5ae2",
                                                "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                                "text": "„Wer Europas Werte leben und verteidigen will, darf dem Unwohlsein nicht nachgeben, das der medial verbreitete Terror einzelner Fanatiker hervorruft.“"
                                            },
                                            {
                                                "example_id": "0112849f-9b22-45bb-9181-88606c7b4e13",
                                                "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                                "text": "„Auch junge Fanatiker schwammen im Strom, zu erkennen an ihren Zauselbärten und dem stechenden Blick.“"
                                            },
                                            {
                                                "example_id": "2c1e1c45-d8e9-4ee7-b157-ea76a557a6a0",
                                                "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                                "text": "„Aber bevor ich irgendetwas unternehmen konnte, hatten die beiden Fanatiker schon zu raufen begonnen.“"
                                            },
                                            {
                                                "example_id": "fbe6e58d-5b30-4749-834d-95090efa7e88",
                                                "sense_id": "f7676ec2-e9a2-3c73-90b2-2a6c194ff014",
                                                "text": "„Das kann sich kein Fanatiker leisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
