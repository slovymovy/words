{
    "word_family": [
        "complicated",
        "complication",
        "uncomplicated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c53c3382-8299-3b0e-be52-8ab0b4e95a1e",
                    "sense_definition": "To make something more intricate, complex, or difficult to deal with.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "make_complex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unexpected changes in the weather can seriously <w>complicate</w> our travel plans.",
                            "target_lang_translations": {
                                "ru": "Неожиданные перемены погоды могут серьезно <w>осложнить</w> наши планы на поездку."
                            }
                        },
                        {
                            "text": "Try not to <w>complicate</w> matters by adding unnecessary details to the report.",
                            "target_lang_translations": {
                                "ru": "Старайся не <w>усложнять</w> дело, добавляя в отчет ненужные подробности."
                            }
                        }
                    ],
                    "synonyms": [
                        "complexify"
                    ],
                    "antonyms": [
                        "simplify",
                        "uncomplicate"
                    ],
                    "common_phrases": [
                        "complicate matters",
                        "complicate things",
                        "complicate the issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо более сложным, запутанным или трудным для решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усложнять",
                                "target_lang_sense_clarification": "делать более трудным или многосоставным"
                            },
                            {
                                "target_lang_word": "усложнить",
                                "target_lang_sense_clarification": "совершенный вид к «усложнять»"
                            },
                            {
                                "target_lang_word": "осложнять",
                                "target_lang_sense_clarification": "привносить трудности, делать ситуацию проблематичной"
                            },
                            {
                                "target_lang_word": "осложнить",
                                "target_lang_sense_clarification": "совершенный вид к «осложнять»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c744b9f-26d0-3090-b6c3-7a5dd103f182",
                    "sense_definition": "To involve or entangle someone in an intricate or difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "involve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to <w>complicate</w> herself in office politics that did not concern her.",
                            "target_lang_translations": {
                                "ru": "Она отказалась <w>ввязываться</w> в офисные интриги, которые ее не касались."
                            }
                        },
                        {
                            "text": "The latest evidence seems to <w>complicate</w> the suspect in the ongoing scandal.",
                            "target_lang_translations": {
                                "ru": "Последние улики, похоже, еще сильнее <w>замешивают</w> подозреваемого в текущем скандале."
                            }
                        }
                    ],
                    "synonyms": [
                        "embroil",
                        "entangle",
                        "involve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впутывать или втягивать кого-либо в сложное, неприятное положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "втягивать",
                                "target_lang_sense_clarification": "вовлекать во что-либо неприятное или запутанное"
                            },
                            {
                                "target_lang_word": "впутывать",
                                "target_lang_sense_clarification": "делать причастным к неприятному делу"
                            },
                            {
                                "target_lang_word": "замешивать",
                                "target_lang_sense_clarification": "вовлекать в интриги или скандалы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f48e44ba-f4a9-3224-89b2-7f5cd36de706",
                    "sense_definition": "Consisting of many interconnected parts; complex or intricate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complex_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher reflected on how <w>complicate</w> the human spirit truly is.",
                            "target_lang_translations": {
                                "ru": "Философ размышлял о том, насколько воистину <w>сложен</w> человеческий дух."
                            }
                        },
                        {
                            "text": "Such <w>complicate</w> structures require careful examination under a microscope.",
                            "target_lang_translations": {
                                "ru": "Такие <w>сложные</w> структуры требуют тщательного изучения под микроскопом."
                            }
                        }
                    ],
                    "synonyms": [
                        "complex",
                        "intricate"
                    ],
                    "traits": [
                        {
