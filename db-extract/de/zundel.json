                ],
                "senses": [
                    {
                        "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                        "entry_id": "28450f51-275b-3c35-b485-aa7164737ad7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4143fa3f-64dc-4f0e-9a9a-5631b7f46a2c",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Frau Zundel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7388cec3-fd0f-4fc1-b9c2-fdb9d6fe5615",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Herr Zundel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4bc550ca-cc83-4218-80aa-a52ee636e030",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Die Zundels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c50f836c-da31-42e2-ad4f-5467f8f65ec1",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Der Zundel trägt nie die Schals, die die Zundel ihm strickt."
                            },
                            {
                                "example_id": "72b31643-3a5d-4f0c-83fd-ac8579624f50",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zundel kommt, geht der Herr Zundel.“"
                            },
                            {
                                "example_id": "bc5478e3-aee1-4634-89a8-558dd47d4833",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Zundel kommt und geht."
                            },
                            {
                                "example_id": "a55acdd8-7573-4adf-87ca-f674c0fc415c",
                                "sense_id": "7b9d64eb-4f82-3387-8ad4-3752db8f17a7",
                                "text": "Zundels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
