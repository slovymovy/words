                "senses": [
                    {
                        "sense_id": "1d9e18cb-e1aa-397e-b109-d4aa5a1741f3",
                        "entry_id": "177d2efa-7437-3563-8e12-9155ff5da200",
                        "glosses": [
                            "Zweikampf, der mit Degen ausgetragen wird (gemäß einem festgelegten Kodex)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "560fb0d9-ed71-4248-a69f-597b413e4e30",
                                "sense_id": "1d9e18cb-e1aa-397e-b109-d4aa5a1741f3",
                                "text": "„Wenn das Pistolenduell erfolglos geblieben wäre, hätte der Verabredung gemäß demselben ein Degenduell folgen sollen.“"
                            },
                            {
                                "example_id": "6798fbdd-5d05-41b8-8ecb-5e2325fbd52d",
                                "sense_id": "1d9e18cb-e1aa-397e-b109-d4aa5a1741f3",
                                "text": "„Hier ein bißchen Karibikkulisse, da Kannibalenkokolores, dort eine Seeschlacht, ein paar Degenduelle, tolldreiste Stunts und dazwischen immer die Stars: Fertig ist das Piratenschaschlik.“"
                            },
                            {
                                "example_id": "ed227bae-19da-46a4-b050-26fda73f104f",
                                "sense_id": "1d9e18cb-e1aa-397e-b109-d4aa5a1741f3",
                                "text": "„Das Degenduell zwischen Power und Basil Rathbone gilt als eines der besten der Filmgeschichte.“"
                            },
                            {
                                "example_id": "44122d68-1acd-42b3-892e-518e0d0c81e3",
                                "sense_id": "1d9e18cb-e1aa-397e-b109-d4aa5a1741f3",
                                "text": "„Wer zu Shakespears Zeit auf der Bühne in aller Ruhe ein Degenduell bewundert hatte, konnte sich, kaum hatte er das Theater verlassen, selbst in einen Kampf verwickelt sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
