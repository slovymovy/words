                },
                {
                    "sense_id": "5df7b2ea-f46b-3c91-a8b3-744847c91b24",
                    "sense_definition": "Describing a rock layer that is strong enough to resist deformation or flow under pressure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sandstone layer acted as a <w>competent</w> bed during the folding of the mountain range.",
                            "target_lang_translations": {
                                "ru": "Слой песчаника действовал как <w>компетентный</w> пласт во время складкообразования горного хребта.",
                                "tr": "Kumtaşı tabakası, dağ sırasının kıvrımlanması sırasında <w>dayanıklı</w> bir katman olarak işlev gördü."
                            }
                        },
                        {
                            "text": "Geologists identified the limestone as a <w>competent</w> formation compared to the surrounding shale.",
                            "target_lang_translations": {
                                "ru": "Геологи определили известняк как <w>устойчивую</w> формацию по сравнению с окружающим сланцем.",
                                "tr": "Jeologlar, kireç taşını çevredeki şeyle kıyasla <w>dayanıklı</w> bir oluşum olarak tanımladılar."
                            }
