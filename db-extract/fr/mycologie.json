                "senses": [
                    {
                        "sense_id": "e106c7b8-5054-3f7d-ab38-5772b6a547b3",
                        "entry_id": "2a3f1c63-7638-33ff-9dac-f930aeb9a319",
                        "glosses": [
                            "Science qui étudie les champignons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab042cc-3247-420c-bdf4-0be455d3b9af",
                                "sense_id": "e106c7b8-5054-3f7d-ab38-5772b6a547b3",
                                "text": "L’étude scientifique des champignons porte le nom de mycologie, un terme qui apparut vers la fin du 18ᵉ siècle devant la nécessité de plus en plus évidente de distinguer l'étude des champignons de celle des plantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "024e008b-46db-4c4d-a1d8-92727b41b9b0",
                        "source_entry_id": "2a3f1c63-7638-33ff-9dac-f930aeb9a319",
                        "source_sense_id": "e106c7b8-5054-3f7d-ab38-5772b6a547b3",
                        "target_lang_word": "Mykologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mykologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "050cd661-17ec-3c7b-8610-e769f97c9d02",
                                        "entry_id": "ef08fdf9-0b67-3a2d-b984-cf504cdc48d4",
                                        "glosses": [
                                            "Wissenschaft von den Pilzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71dd874c-65ec-4c87-a511-b5987bf82754",
                                                "sense_id": "050cd661-17ec-3c7b-8610-e769f97c9d02",
                                                "text": "„Collar oder Kollar […] bezeichnet in der Mykologie einen im Hutfleisch eines Pilzes liegenden ringförmigen Kragen, der die Lamellen vom Stiel trennt.“"
                                            },
                                            {
                                                "example_id": "f71d46d0-8d2c-4aef-891c-aa510f0613a8",
                                                "sense_id": "050cd661-17ec-3c7b-8610-e769f97c9d02",
                                                "text": "„Einen Sporenabdruck zu erstellen ist in der Mykologie ein übliches Verfahren, um die sichere Identifikation von (Pilzen) über ihre Fruchtkörper zu unterstützen.“"
                                            },
                                            {
                                                "example_id": "675c1f47-29db-466a-b493-155b98985ff7",
                                                "sense_id": "050cd661-17ec-3c7b-8610-e769f97c9d02",
                                                "text": "Die Mykologie ist ein interessantes Forschungsgebiet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99dd981c-af12-4b0e-9291-866a48ccc837",
                        "source_entry_id": "2a3f1c63-7638-33ff-9dac-f930aeb9a319",
