                        "examples": [
                            {
                                "example_id": "03fa589a-e8ec-45f4-9f2d-d26936a6ade9",
                                "sense_id": "29b05ab1-d002-3f5c-a296-c6b3fef3bde5",
                                "text": "Kapitan z pompą zameldował, że cała sześćdziesiątka marynarzy jest gotowa do rejsu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ee1da3fe-259d-3bfa-9316-a0e75b53ad89",
