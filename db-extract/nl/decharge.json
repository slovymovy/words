                "senses": [
                    {
                        "sense_id": "fd3d7bef-d0bc-3030-bfa4-372b5c9a2383",
                        "entry_id": "29052cc0-f616-3c0b-92dc-eaf3cde624a3",
                        "glosses": [
                            "kwijting van een bepaalde verantwoordelijkheid vooral in het geval van bestuursleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfafefd0-df84-43d7-8304-401f1f265739",
                                "sense_id": "fd3d7bef-d0bc-3030-bfa4-372b5c9a2383",
                                "text": "Bestuursvoorzitter Ton Büchner en president-commissaris Antony Burgmans weigeren na drie overnamebiedingen van de Amerikaanse concurrent PPG nog steeds te praten, laat staan te onderhandelen met de Amerikanen. Op de aandeelhoudersvergadering van AkzoNobel reageerde een deel van de beleggers vorige week venijnig. Bij de stemming over het gevoerde beleid (zogeheten decharge) stemden beleggers met 28 procent van de aandelen tegen. Vervolgens nam Causeway Capital uit Los Angeles afgelopen vrijdag de ongebruikelijke stap om zijn ongenoegen publiekelijk te herhalen in een brief aan het bestuur en de commissarissen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d54f313-d188-3e0f-83c5-0ffabadf94b4",
                        "entry_id": "29052cc0-f616-3c0b-92dc-eaf3cde624a3",
                        "glosses": [
                            "ontlasting van schuld vaak in de combinatie van: getuige à decharge een getuige die de verdachte vrijpleit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ea1976-d343-46e7-ad45-0a224a9c5df9",
                                "sense_id": "1d54f313-d188-3e0f-83c5-0ffabadf94b4",
                                "text": "De Haagse rechtbank heeft de hoogleraren Paul Cliteur en Tom Zwart opgeroepen om volgende week donderdag en vrijdag als getuige-deskundigen te worden gehoord in de strafzaak tegen Geert Wilders, partijleider van de PVV. Het horen van deze twee rechtsgeleerden als getuige à décharge is door Wilders zelf verzocht. Dit is door verscheidene bronnen bevestigd aan NRC."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "449658df-3b56-4548-81a7-2534effb3739",
                        "source_entry_id": "29052cc0-f616-3c0b-92dc-eaf3cde624a3",
                        "source_sense_id": "fd3d7bef-d0bc-3030-bfa4-372b5c9a2383",
                        "source_sense_description": "kwijting van een bepaalde verantwoordelijkheid",
                        "target_lang_word": "discharge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discharge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "981f6a2c-68b7-3b3f-a71c-501ccd5d2ac9",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To accomplish or complete, as an obligation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90d81b8-f26a-46e3-9ae5-9506a293b07e",
                                                "sense_id": "981f6a2c-68b7-3b3f-a71c-501ccd5d2ac9",
                                                "text": "O most dear mistress, / The sun will set before I shall discharge / What I must strive to do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c186e870-752a-33d5-9f09-8cdcf5a8fea4",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To free of a debt, claim, obligation, responsibility, accusation, etc.; to absolve; to acquit; to forgive; to clear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18e9c10-8a46-4e12-8126-deed88c10f5a",
                                                "sense_id": "c186e870-752a-33d5-9f09-8cdcf5a8fea4",
                                                "text": "But in deede, the ſecret cauſe that brought Ageſilaus to conſent vnto this practiſe, was the greatnes of his dette which he ought, of the which he hoped to be diſcharged by chaunging of the ſtate and common wealth."
                                            },
                                            {
                                                "example_id": "54fcfc83-435d-46b7-90e2-8ba153ffddec",
                                                "sense_id": "c186e870-752a-33d5-9f09-8cdcf5a8fea4",
                                                "text": "For if One Man's Faults could Discharge Another Man of his Duty,there would be no longer any Place left for the Common Offices of Society."
                                            },
                                            {
                                                "example_id": "d0c7f025-f4f9-4ba7-b0b7-498822b6ad5f",
                                                "sense_id": "c186e870-752a-33d5-9f09-8cdcf5a8fea4",
                                                "text": "How happy is his low degree, / How rich in humble poverty, is he, / Who leads a quiet country life; / Diſcharg'd of buſineſs, void of ſtrife, / And from the griping ſcrivener free?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f9f55e-2c52-35c9-b635-a063d7d89bb9",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To send away (a creditor) satisfied by payment; to pay one's debt or obligation to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb0101f-15c7-4a92-9658-8bd70356006e",
                                                "sense_id": "07f9f55e-2c52-35c9-b635-a063d7d89bb9",
                                                "text": "If he had / The present money to discharge the Jew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378b6b10-24c2-313a-acdf-73f88c14ee1e",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To set aside; to annul; to dismiss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476990b7-b56c-43c0-99a3-c733aaf0960f",
                                                "sense_id": "378b6b10-24c2-313a-acdf-73f88c14ee1e",
                                                "text": "The order for Daly's attendance was discharged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853955cf-4ec1-33ff-b965-6d0d64401076",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To expel or let go."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716b9992-78d6-4331-bfc2-9630819d3dbd",
                                                "sense_id": "853955cf-4ec1-33ff-b965-6d0d64401076",
                                                "text": "Feeling in other cases discharges itself in indirect muscular actions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824201b2-6617-3194-9a6c-829096c2e339",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To let fly, as a missile; to shoot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118fe611-764b-490d-be74-68438651e2fa",
                                                "sense_id": "824201b2-6617-3194-9a6c-829096c2e339",
                                                "text": "They do discharge their shot of courtesy."
                                            },
                                            {
                                                "example_id": "caf46019-c92a-4d0d-9869-92946bcc07ab",
                                                "sense_id": "824201b2-6617-3194-9a6c-829096c2e339",
                                                "text": "Mrs Partridge, upon this, immediately fell into a fury, and discharged the trencher on which she was eating, at the head of poor Jenny […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1273876-24ea-38a6-8b83-83f4e7ac1acc",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To release (an accumulated charge)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54402d5-375f-4b8e-85d0-42d8ffaaa0ea",
                                                "sense_id": "d1273876-24ea-38a6-8b83-83f4e7ac1acc",
                                                "text": "GWR plans to use it on the Greenford branch in west London, making use of a fast charger at West Ealing that will charge the batteries in just three and a half minutes. This fast charger is essentially a battery installed at the lineside which is trickle-charged from the electricity grid. It can then discharge quickly into the train's batteries through charging rails and then start recharging itself while the train is running in service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2ae8e45-4314-37d3-8149-e97b3a4eb79c",
                                        "entry_id": "427bc0ad-4b10-3c32-ad8e-a6507e75efd5",
                                        "glosses": [
                                            "To relieve of an office or employment; to send away from service; to dismiss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae4e631-148d-4466-97a9-175944c5a783",
                                                "sense_id": "b2ae8e45-4314-37d3-8149-e97b3a4eb79c",
                                                "text": "Discharge the common sort / With pay and thanks."
                                            },
                                            {
                                                "example_id": "933ab6b8-59b6-4849-8039-99abfb19d828",
                                                "sense_id": "b2ae8e45-4314-37d3-8149-e97b3a4eb79c",
                                                "text": "Grindal […] was discharged the government of his see."
