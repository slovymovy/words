                                    {
                                        "sense_id": "2455d674-951b-3fb0-9251-ed24500e2b7d",
                                        "entry_id": "9c0f0d70-2ad2-3f9e-aa0a-d35adc9ebe16",
                                        "glosses": [
                                            "Wahrnehmung der Lebewesen über innerorganische Veränderungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf08369-4c04-4912-a890-42c3e17bbadd",
                                                "sense_id": "2455d674-951b-3fb0-9251-ed24500e2b7d",
                                                "text": "Nur ein kleiner Ausschnitt dieser Afferenzen ist unter normalen Bedingungen als Interozeption körperlicher Veränderungen (\"Wahrnehmung\" von Körperprozessen) bewußtseinsfähig, doch beeinflußt die Interozeption wahrscheinlich das Befinden, die Stimmung und globale Gefühle körperlicher Spannung bzw. Entspannung, Frische bzw. Müdigkeit usw."
                                            },
                                            {
                                                "example_id": "874f50f7-298f-4c58-ae06-babfb1db547b",
                                                "sense_id": "2455d674-951b-3fb0-9251-ed24500e2b7d",
                                                "text": "Wie bei der Introspektion können auch bei der Interozeption körperlicher Vorgänge und Funktionsunregelmäßigkeiten verschiedene Verzerrungen der Informationsverarbeitung auftreten, u.a. durch Selektion, naive und implizite Konzepte bzw. Schemata und Kausaldeutungen."
                                            },
                                            {
                                                "example_id": "fc568eb5-6799-448d-a2bd-bbd0b51447d3",
                                                "sense_id": "2455d674-951b-3fb0-9251-ed24500e2b7d",
                                                "text": "Unter Interozeption versteht man den Prozess, mit dem das Nervensystem Signale vom Körperinneren wahrnimmt, interpretiert und integriert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
