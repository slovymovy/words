                        "translation_id": "417046bb-9676-468c-a94f-ece5999e97d6",
                        "source_entry_id": "e97ed64d-3784-32b9-b818-dff1bae4dccf",
                        "source_sense_id": "7e6dee82-2b5c-31c7-9920-126f3f3509b9",
                        "target_lang_word": "selve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b722687-cf19-3d96-805e-e573089a1960",
                                        "entry_id": "709713be-38df-3b60-9f8c-1d62ec814b27",
                                        "glosses": [
                                            "Forêt vierge des régions équatoriales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a85b8b11-c8e1-487a-aba1-f451cf232fde",
                                                "sense_id": "4b722687-cf19-3d96-805e-e573089a1960",
                                                "text": "Tout me reviendra, demain sur la route, pensais-je. Les parfums, les miaulements dans la selve, les couleurs, la lumière du Congo."
                                            },
                                            {
                                                "example_id": "8820858d-cc4a-4aa2-a35f-816713e53a47",
                                                "sense_id": "4b722687-cf19-3d96-805e-e573089a1960",
                                                "text": "À présent, le moindre arpent de terre jusqu’au cœur de la selve amazonienne, jusqu’aux canyons gelés de l’Antarctique, a été examiné, photographié, analysé par l’œil froid du satellite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996a8a83-f42b-31d9-9661-05bccd4cf920",
                                        "entry_id": "709713be-38df-3b60-9f8c-1d62ec814b27",
                                        "glosses": [
                                            "Foisonnement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274afe20-8938-40df-b08b-ca5bd22fee31",
                                                "sense_id": "996a8a83-f42b-31d9-9661-05bccd4cf920",
                                                "text": "Mieux vaut renoncer à ces enjambées formidables et avancer à petits pas dans la forêt obscure, la selve des destins humains s’entrecroisant à l’infini pour faire la grande Histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
