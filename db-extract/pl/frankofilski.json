                                        "entry_id": "88e5e2ba-fd8f-3601-8910-611ee7ece24e",
                                        "glosses": [
                                            "One who loves France, the French people, or French culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e85a58-582e-4cdd-8875-49ca3d3cd23d",
                                                "sense_id": "d1938d62-82c3-3eec-963a-ebc0c0dab6cc",
                                                "text": "What respectable Francophile can resist a crêpe?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Francophile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd31797e-ea4c-3ab1-bf6c-dbbdfd1668cc",
                                        "entry_id": "1fab77b8-ae1d-3058-945a-3146d9e99604",
                                        "glosses": [
                                            "Loving France, the French people, or French culture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49b66223-49ca-49a0-8baa-48e94d95a2da",
                        "source_entry_id": "545808b8-8cba-3859-9d5b-d531035cf9a1",
                        "source_sense_id": "ad7ed59e-49a4-3b08-8e5f-fcf859b60cd2",
                        "target_lang_word": "francophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "francophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc90cda8-e4b0-36bf-83af-b18afe629618",
                                        "entry_id": "cfcb3682-036a-3c7a-bf23-99d798d69266",
                                        "glosses": [
                                            "Qui aime la France, sa culture, son histoire et/ou son peuple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717dc917-cd27-45df-b896-cab0f555cba1",
                                                "sense_id": "cc90cda8-e4b0-36bf-83af-b18afe629618",
                                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui."
                                            },
                                            {
                                                "example_id": "66206a5b-3406-495b-8518-3e41d4007793",
                                                "sense_id": "cc90cda8-e4b0-36bf-83af-b18afe629618",
                                                "text": "[…] dans une rue proche de la Madeleine, où je la rencontrai en compagnie d’un diplomate balkanique, « grand francophile » à chapeau melon et élégance étriquée."
                                            },
                                            {
                                                "example_id": "eb894244-cbbd-4323-af01-84393746a9bc",
                                                "sense_id": "cc90cda8-e4b0-36bf-83af-b18afe629618",
                                                "text": "Enfin, en dépit de la prédominance du répertoire allemand, les fonctionnaires d’outre-Rhin ainsi que les militaires de la garnison stationnée à Strasbourg ne compensent guère l’absence de la bourgeoisie alsacienne francophile."
                                            },
                                            {
                                                "example_id": "83132023-4fb6-469f-bf66-75d90ef0c4bf",
                                                "sense_id": "cc90cda8-e4b0-36bf-83af-b18afe629618",
                                                "text": "Cette comparaison entre francophilie tchèque et polonophilie française nous paraît judicieuse et le caractère démagogique des manifestations francophiles sera souvent dénoncé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
