                    {
                        "sense_id": "75863858-5a90-3734-97c7-adce870e30a9",
                        "entry_id": "f6f353a2-ab7b-3870-8884-c0a1b392ce21",
                        "glosses": [
                            "eines der Elemente, das im Periodensystem auf die Actinoide folgt, also ab der Ordnungszahl 104, dem Rutherfordium"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "b2f284e1-7cdf-4771-a536-b060bf0f9b57",
                                "sense_id": "75863858-5a90-3734-97c7-adce870e30a9",
                                "text": "„Für die ab 1996 synthetisierten äußerst kurzlebigen Transactinoide 112 – 116 und 118 gibt es noch keine Namen und Symbole.“"
                            },
                            {
                                "example_id": "b28d20d3-3763-41fd-a3bb-1ba765166b2e",
                                "sense_id": "75863858-5a90-3734-97c7-adce870e30a9",
                                "text": "„Die Transactinoide können durch Kernreaktionen erzeugt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
