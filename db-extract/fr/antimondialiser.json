                "senses": [
                    {
                        "sense_id": "bbf49b37-3100-3b39-922d-61fb556aa81b",
                        "entry_id": "564e265a-9ca6-3794-9134-4297df277c6d",
                        "glosses": [
                            "Donner un caractère antimondialiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e4da8e0-d5f7-4e01-9663-9d0159f8bebb",
                                "sense_id": "bbf49b37-3100-3b39-922d-61fb556aa81b",
                                "text": "Nous le savons, elle a bénéficié d'un double phénomène de normalisation : grâce au renouveau droitiste de la droite (depuis la charte du collectif de la Droite populaire) ; et grâce au fait d'« antimondialiser » ses fondamentaux."
                            },
                            {
                                "example_id": "7a8622b1-f1ef-45d6-b070-abda7318148a",
                                "sense_id": "bbf49b37-3100-3b39-922d-61fb556aa81b",
                                "text": "allez antimondialiste, va antimondialiser, continue à suivre le troupeau rassurant mené par la bergère ..."
                            },
                            {
                                "example_id": "4c72d657-19b5-4db8-8e90-6dee15a9143c",
                                "sense_id": "bbf49b37-3100-3b39-922d-61fb556aa81b",
                                "text": "… comme parfait raté d'un monde parfaitement raté , je pourrais au contraire concourir pour le titre de parfait antimondialisé, à conjuguer d'ores et déjà le futur par-dessus le plus qu'imparfait du présent, …"
                            },
                            {
                                "example_id": "8b2c301c-9210-4b51-8ff0-10ced50e6d41",
                                "sense_id": "bbf49b37-3100-3b39-922d-61fb556aa81b",
                                "text": "Nous le savons, elle a bénéficié d’un double phénomène de normalisation : grâce au renouveau droitiste de la droite (depuis la charte du collectif de la Droite populaire) ; et grâce au fait d’« antimondialiser » ses fondamentaux."
                            }
                        ]
                    }
