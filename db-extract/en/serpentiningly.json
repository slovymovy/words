                        "glosses": [
                            "With serpentine twistings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31ba16e-6401-4793-ae2a-0cada51d81e7",
                                "sense_id": "11837ae4-80dc-3eb2-a4f5-184eb67c39ed",
                                "text": "What if my words wind in and out the stone\nAs yonder ivy, the God's parasite?\nThough they leap all the way the pillar leads,\nFestoon about the marble, foot to frieze,\nAnd serpentiningly enrich the roof,\nToy with some few bees and a bird or two,—\nWhat then? The column holds the cornice up."
                            }
                        ]
                    }
