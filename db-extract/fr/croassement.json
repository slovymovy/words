                                        "glosses": [
                                            "To make the harsh cry of a crow, rook, or raven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300302e0-a260-46e2-8b7b-90c4517a56a4",
                                                "sense_id": "d3f452df-f07e-376f-aa25-deb6debf221e",
                                                "text": "Rising and cawing at the gun's report."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b280744f-0c9b-35df-9d07-8bcdc33edc58",
                                        "entry_id": "fbadf71a-3441-3f45-95a2-c99d1f7c21ec",
                                        "glosses": [
                                            "A rendering of the vocalisation of a crow or other corvid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "966dde10-7ab0-456e-9c0f-e29c51ad61a1",
                                                "sense_id": "b280744f-0c9b-35df-9d07-8bcdc33edc58",
                                                "text": "\"Amen,\" said M., in a grave and solemn tone. \"Caw,\" croaked the jackdaw immediately, and with such a sonorous effect, that it disturbed our pious mien and upset our gravity."
                                            }
                                        ]
                                    }
