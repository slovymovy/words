                                        "glosses": [
                                            "古代鮮卑、突厥、回紇、蒙古等族对其最高統治者的称呼。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5025f850-1f50-4cab-8cad-434637ca10fd",
                                                "sense_id": "369515ee-0465-35ca-9b74-5d2662986cd7",
                                                "text": "昨夜見軍帖，可汗大點兵，軍書十二卷，卷卷有爺名。"
                                            },
                                            {
                                                "example_id": "eb489e7d-7285-4aff-be57-f9d621e70dd5",
                                                "sense_id": "369515ee-0465-35ca-9b74-5d2662986cd7",
                                                "text": "昨夜见军帖，可汗大点兵，军书十二卷，卷卷有爷名。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
