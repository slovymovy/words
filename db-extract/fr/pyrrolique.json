                        "sense_id": "0a69960b-d610-3871-be63-f24c63f7ee6b",
                        "entry_id": "21cc208c-9c80-366f-aa47-2d365329a088",
                        "glosses": [
                            "Relatif au pyrrole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811e4a4e-94a4-4713-994f-aad7fdfbee26",
                                "sense_id": "0a69960b-d610-3871-be63-f24c63f7ee6b",
                                "text": "Le noyau pyrrolique des porphyrines est constitué par 4 noyaux de pyrroles."
                            },
                            {
                                "example_id": "193e23d6-9ed7-4a94-9173-90da2ebccbf9",
                                "sense_id": "0a69960b-d610-3871-be63-f24c63f7ee6b",
                                "text": "Le noyau pyrrolique peut se transformer par une réaction particulièrement intéressante en noyau pyridique (v. ce nom)."
                            },
                            {
                                "example_id": "e5c8fb56-b33b-4fa0-8ef1-3627bd3d89fc",
                                "sense_id": "0a69960b-d610-3871-be63-f24c63f7ee6b",
                                "text": "On ne connaît pas le pyrrylcarbinol mais l'action de l’aldéhyde formique sur le pyrrole conduit à un glycol pyrrolique : composé relativement stable, et très soluble dans l'eau."
                            }
                        ]
                    }
