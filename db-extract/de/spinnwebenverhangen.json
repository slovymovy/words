                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f652a9-cc53-4f4a-adee-58d7de9304e2",
                                "sense_id": "6c10d5a5-d717-3739-bdb5-818c7f8a9a51",
                                "text": "„Dort unten, wo das Üble am dichtesten lauerte, suchte und stöberte ich lange Nachmittage herum, während das Sonnenlicht durch die Ritzen der spinnwebenverhangenen, ebenerdigen Tür sickerte, die mich wenige Meter entfernt mit der ruhigen Straße verband.“"
                            }
                        ],
