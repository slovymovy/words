                                                "example_id": "bd5f338a-db3d-43a6-9193-31dd7f66bdc5",
                                                "sense_id": "39871b59-7860-3836-812c-1e158703b510",
                                                "text": "Nejsem tvůj poskok, abych skákal jak si pískneš!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b11915cd-9565-335e-a2d8-90e1ed1da3db",
                                        "entry_id": "a3ee9514-184e-3579-99ca-efbf5e5bb4e3",
                                        "glosses": [
                                            "Isotoma, Anurophorus, Folsomia a Agrenia; rody hmyzu z čeledi poskokovitých"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c732396-14f3-49c3-a7ba-73ca6730b808",
                                                "sense_id": "b11915cd-9565-335e-a2d8-90e1ed1da3db",
                                                "text": "Mezi chvostoskoky, půdní živočichy významné pro tvorbu humusu, patří např. poskok škodlivý nebo mákovka vodní."
                                            }
                                        ]
                                    }
                                ]
                            },
