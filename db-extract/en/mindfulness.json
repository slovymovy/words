                        "examples": []
                    },
                    {
                        "sense_id": "e258680a-87f3-3bc1-a7b8-34589c00595b",
                        "entry_id": "4a4c2dee-8978-302a-b751-3a953a6732cb",
                        "glosses": [
                            "Paying attention on purpose, in the present moment, and non-judgementally."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4e128293-08f0-33a7-a1a9-08b8b4ddb56e",
                        "entry_id": "4a4c2dee-8978-302a-b751-3a953a6732cb",
                        "glosses": [
                            "A form of secular meditation practice with roots in Buddhist meditation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f7f2a462-362f-4fb9-940e-62ecb0009683",
                                "sense_id": "4e128293-08f0-33a7-a1a9-08b8b4ddb56e",
                                "text": "Thich Nhat Hanh, the Vietnamese Buddhist leader who introduced mindfulness to Westerners (Google got first dibs on him as a guest speaker), once said, “The most precious gift we can offer anyone is our attention.”"
                            },
                            {
                                "example_id": "fe0b3149-ac73-41e5-8136-de1d32022069",
                                "sense_id": "4e128293-08f0-33a7-a1a9-08b8b4ddb56e",
                                "text": "This vogue is in part due to the real benefits of mindfulness, a form of attention and awareness often (but not always) achieved through meditation or yoga. It’s a trend for a reason. But its increasing application to every situation under the sun has some people concerned."
                            }
                        ]
                    }
