                        ],
                        "examples": [
                            {
                                "example_id": "7b7072e2-ddb6-4bf2-9567-3b2d476e3663",
                                "sense_id": "c7a10d47-00fe-3a66-9164-a8c425a7ef87",
                                "text": "Sur le plan extérieur, son activité le porte à mettre fin aux prétentions saoudies sur l’archipel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f73ca29-cd59-46d9-ac32-0272ad5a4691",
                        "source_entry_id": "95c3f381-0642-387f-a215-851bfd8b819a",
                        "source_sense_id": "c7a10d47-00fe-3a66-9164-a8c425a7ef87",
                        "target_lang_word": "saudisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saudisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b7fb0a7-f705-33ac-ae2c-40e8e7472b8e",
                                        "entry_id": "348fdc97-0f3a-3e89-8e12-345df1f4b931",
                                        "glosses": [
                                            "zu Saudi-Arabien gehörend, Saudi-Arabien betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7d2a34-7a3b-42a1-b5a4-1aee2569ba36",
                                                "sense_id": "7b7fb0a7-f705-33ac-ae2c-40e8e7472b8e",
                                                "text": "„Ohne Zweifel wurden einschlägige Erkenntnisse auch an die saudische Regierung weitergeleitet, aber das war etwas, das nicht die Agenten vor Ort zu entscheiden hatten.“"
                                            },
                                            {
                                                "example_id": "71fce99e-1cf0-48c8-96fe-8c55f4918715",
                                                "sense_id": "7b7fb0a7-f705-33ac-ae2c-40e8e7472b8e",
                                                "text": "„Zwischen 1824 und 1891 darf mit einiger Berechtigung von einem zweiten saudischen Staat gesprochen werden, auch wenn dieser nie die Ausmaße des ersten erreichte und sich verschiedene Familienflügel in der Herrschaft ablösten.“"
                                            },
                                            {
                                                "example_id": "3a7d164e-a2c1-420b-bdbb-461251e4325b",
                                                "sense_id": "7b7fb0a7-f705-33ac-ae2c-40e8e7472b8e",
                                                "text": "„Der typische saudische Konsument ist männlich, zwischen 20 und 30 Jahre alt, frustriert von der Verbotskultur seines Landes und gut bei Kasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f81b4507-6afd-45cd-8353-5015e4fdc612",
                        "source_entry_id": "95c3f381-0642-387f-a215-851bfd8b819a",
                        "source_sense_id": "c7a10d47-00fe-3a66-9164-a8c425a7ef87",
                        "target_lang_word": "saudi-arabisch",
