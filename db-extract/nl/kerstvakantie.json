                            {
                                "example_id": "36fe89f8-a149-494f-82a2-a17b8eaf6dcd",
                                "sense_id": "68f3e860-f0b8-3ecf-9a38-a69aab2692a2",
                                "text": "Veel gezinnen zoeken de sneeuw op tijdens de kerstvakantie."
