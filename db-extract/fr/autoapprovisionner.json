                "senses": [
                    {
                        "sense_id": "27a012d6-d6b7-3ef8-8bf9-ddc2cab65de1",
                        "entry_id": "1a69bdbd-c411-3f9c-9424-8a284181a064",
                        "glosses": [
                            "Approvisionner en utilisant ses propres ressources."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697f99a5-b8ee-41d3-a76d-3ebe45523224",
                                "sense_id": "27a012d6-d6b7-3ef8-8bf9-ddc2cab65de1",
                                "text": "Il est indispensable pour les insulaires de s’autoapprovisionner en bétail, puisque les communications avec l’extérieur sont difficiles."
                            },
                            {
                                "example_id": "b8102a32-13d8-43a1-b4c5-6de3772e570f",
                                "sense_id": "27a012d6-d6b7-3ef8-8bf9-ddc2cab65de1",
                                "text": "Parce qu’il possédait d'importantes réserves d’uranium à Elliot Lake en Ontario, le Canada pouvait s’autoapprovisionner en combustible."
                            }
                        ]
                    }
