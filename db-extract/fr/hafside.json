                        "glosses": [
                            "Membre de la dynastie d’origine berbère qui régna sur le territoire de l’actuelle Tunisie entre 1207 et 1574."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "467707f1-795a-436e-a65b-a5602906bcf5",
                                "sense_id": "1640c4db-3d4c-3fb3-b583-0b5b6b88b494",
                                "text": "Après les Almohades, trois autres dynasties berbères dominèrent le Maghreb. Les Hafsides (ou Hafçides) régnèrent à Tunis de 1229 à 1574, les Zianides (ou Abd elWadides) à Tlemcen de 1235 à 1554 et les Mérinides au Maroc de 1258 à 1420."
                            }
                        ]
                    }
