            "senses": [
                {
                    "sense_id": "ee56d4ca-13aa-3b81-8b19-993916c6fb38",
                    "sense_definition": "The process of creating a plan for how to spend money over a specific period.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Careful <w>budgeting</w> helped the family save enough money for their summer vacation.",
                            "target_lang_translations": {
                                "ru": "Тщательное <w>планирование бюджета</w> помогло семье накопить достаточно денег на летний отпуск."
                            }
                        },
                        {
                            "text": "The company is focusing on better <w>budgeting</w> to reduce unnecessary expenses this year.",
                            "target_lang_translations": {
                                "ru": "В этом году компания сосредоточена на более эффективном <w>бюджетировании</w>, чтобы сократить ненужные расходы."
                            }
                        }
                    ],
                    "synonyms": [
                        "financial planning"
                    ],
                    "common_phrases": [
                        "strict budgeting",
                        "personal budgeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс составления плана расходов денежных средств на определенный период."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюджетирование",
                                "target_lang_sense_clarification": "процесс планирования доходов и расходов"
                            },
                            {
                                "target_lang_word": "составление бюджета",
                                "target_lang_sense_clarification": "действие по разработке финансового плана"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8796a5a-30f1-3975-8a0d-5c6b5c1a0f0b",
                    "sense_definition": "Present participle and gerund of <w>budget</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are currently <w>budgeting</w> for the new project to ensure all costs are covered.",
                            "target_lang_translations": {
                                "ru": "В настоящее время они <w>закладывают в бюджет</w> средства на новый проект, чтобы покрыть все расходы."
                            }
                        },
                        {
                            "text": "She spends her weekends <w>budgeting</w> her monthly income to pay off her student loans.",
                            "target_lang_translations": {
                                "ru": "Она проводит выходные, <w>распределяя бюджет</w> своего ежемесячного дохода, чтобы выплатить студенческие кредиты."
                            }
                        }
                    ],
                    "traits": [
                        {
