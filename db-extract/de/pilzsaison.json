                ],
                "senses": [
                    {
                        "sense_id": "b5d5ff90-23f9-3398-bd25-d1640af983ca",
                        "entry_id": "ab4de520-5b42-3dc5-97f3-8faff9480bc4",
                        "glosses": [
                            "Zeitraum im Herbst, in dem Speisepilze gesammelt und verarbeitet werden (meist im September und Oktober)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f816015-9d34-4837-b6f2-d3359f49a2ba",
                                "sense_id": "b5d5ff90-23f9-3398-bd25-d1640af983ca",
                                "text": "In diesem Jahr ist die Pilzsaison aufgrund des Wetters ungewöhnlich früh angelaufen: Eine Kombination aus viel Regen und Wärme in den oberen Bodenschichten lässt die Pilze wachsen."
                            },
                            {
                                "example_id": "b63d5e3c-df23-4957-b289-9df2395aa999",
                                "sense_id": "b5d5ff90-23f9-3398-bd25-d1640af983ca",
                                "text": "Auch außerhalb der Pilzsaison können Sie verschiedene Pilzsorten finden, um ein leckeres Gericht zu zaubern."
                            },
                            {
                                "example_id": "95ef9de3-a040-438a-81ea-f2e9a00d7dcd",
                                "sense_id": "b5d5ff90-23f9-3398-bd25-d1640af983ca",
                                "text": "„Zunächst einmal hat sich die Länge der Pilzsaison seit 1950 verdoppelt. In den 50er Jahren dauerte sie durchschnittlich 32 Tage, sie beschränkte sich also im Wesentlichen auf den September und Anfang Oktober. Heute sind es 75 Tage: Die Pilzsaison beginnt früher.“"
                            },
                            {
                                "example_id": "e344b9fb-6d57-4559-9e56-d117cb7ac36a",
                                "sense_id": "b5d5ff90-23f9-3398-bd25-d1640af983ca",
                                "text": "In Deutschland beginnt die Pilzsaison. Und da droht Verwechslungsgefahr. Gerade Einwanderer und Flüchtlinge verwechseln häufig Giftpilze mit ihnen bekannten Speisepilzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
