                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a passé la nuit au <w>dépôt</w> avant de voir le magistrat."
