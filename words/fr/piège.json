            "senses": [
                {
                    "sense_id": "48422678-dfdd-35dc-aaa2-1bcf2f15794b",
                    "sense_definition": "Dispositif ou instrument conçu pour capturer des animaux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde forestier a trouvé un <w>piège</w> métallique dissimulé sous un tas de feuilles."
                        },
                        {
                            "text": "Nous avons installé un <w>piège</w> à souris dans le cellier pour protéger les provisions."
                        }
                    ],
                    "common_phrases": [
