                "senses": [
                    {
                        "sense_id": "7014bc45-caf0-3d8f-a0d7-2565c90c7915",
                        "entry_id": "2b2affb4-5150-3a36-ab7e-3e2833098d70",
                        "glosses": [
                            "borstel waarmee men vuil kan verwijderen van iets"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "1710df78-056b-40f5-9cf7-f0331a05f59b",
                                "sense_id": "7014bc45-caf0-3d8f-a0d7-2565c90c7915",
                                "text": "En het was allemaal zo goed bedoeld. Voor een programma rond stadsverfraaiing stuurde Melbourne een team schoonmakers uit. Gewapend met schrobbers, borstels en verf zouden ze het straatbeeld weer fatsoeneren. Een witte tornado was er niets bij, Mister Proper een sukkel."
                            }
                        ]
                    },
                    {
                        "sense_id": "f34b620a-885e-333c-8576-6eac864b9b0e",
                        "entry_id": "2b2affb4-5150-3a36-ab7e-3e2833098d70",
                        "glosses": [
                            "persoon die met een borstel iets schoonmaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f4630a-fb69-4ee0-ba4e-28a278adc2b4",
                                "sense_id": "f34b620a-885e-333c-8576-6eac864b9b0e",
                                "text": "En zo stond ik een ochtend al vroeg te schrobben. De hele nacht had hij geweekt, terwijl ik woelig sliep. Hij is een oude ovenschotel. Dit keer was hij zo zwart als nooit voorheen geworden. Wij vreesden dat we hem na al die jaren moesten opgeven. Van alle keukendingen bezorgen ovenschotels de schrobber de meeste voldoening. de Standaard 12 MAART 2016 OM 03:00 UUR"
                            }
                        ]
                    }
                ],
