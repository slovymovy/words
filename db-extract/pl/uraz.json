                            {
                                "example_id": "ce33ca6e-5217-4c4b-ab47-1bb8e1e6e007",
                                "sense_id": "26cf0f94-f06a-34b1-917c-0c60ab085e3a",
                                "text": "Uraz nogi przeszkadza mi w chodzeniu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "49e6324a-e4f0-3b36-b880-4348e43fbcfb",
                        "entry_id": "aa786c2b-b29c-36f9-a26b-ffe19be21898",
                        "glosses": [
                            "niechęć w stosunku do osoby, obiektu lub zjawiska będąca konsekwencją krzywdy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a07137-449b-463f-9d21-f684466e8a4c",
                                "sense_id": "49e6324a-e4f0-3b36-b880-4348e43fbcfb",
                                "text": "Od kiedy pani Jola przycięła mu ucho, ma uraz do wszystkich fryzjerek."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "558d1073-bc32-426c-8f5b-1bc16d9da829",
                        "source_entry_id": "aa786c2b-b29c-36f9-a26b-ffe19be21898",
                        "source_sense_id": "26cf0f94-f06a-34b1-917c-0c60ab085e3a",
                        "target_lang_word": "injury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Damage to the body of a living thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d881574b-745c-4761-ba88-a369f841f0d6",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "The passenger sustained a severe injury in the car accident."
                                            },
                                            {
                                                "example_id": "bad00ff5-d366-4560-8eb9-5b01cf170aa6",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "He got a shoulder injury in the nets three days before the match."
                                            },
                                            {
                                                "example_id": "f26e7d62-2470-4b86-9ed9-1b8c71c2966b",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "Whether you need to recover from a stressful day, a strenuous workout or even an injury or surgery, restorative yoga may be just the thing for you."
                                            },
                                            {
                                                "example_id": "de62401f-9efc-4700-af95-907c6e74017b",
                                                "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                                                "text": "Soft tissue injuries are the bane of any physically active person. They are the most common injuries in sport, can be difficult to heal and often reoccur, according to Sports Medicine Australia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e25a621-09c5-370b-9835-34a3c7cf17c6",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Other forms of damage sustained by a living thing, e.g. psychologically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "The violation of a person's reputation, rights, property, or interests."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a9ed25-bb33-4923-8cfe-ee07bab601c7",
                                                "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                                                "text": "Slander is an injury to the character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fd8eb1-68cc-3430-8d21-b3b24adfe98a",
                                        "entry_id": "b03b68aa-5b39-3de5-8b4e-caee450f34fd",
                                        "glosses": [
                                            "Injustice."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "injury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9599ebd9-4a04-3c84-b780-4abb8bb03b26",
                                        "entry_id": "c99678e0-b79d-3e01-a149-4852f88e54c1",
                                        "glosses": [
                                            "To wrong, to injure."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87796690-5750-4d8f-9056-715bd69a3b3c",
                                                "sense_id": "9599ebd9-4a04-3c84-b780-4abb8bb03b26",
                                                "text": "The best of us doth not so much feare to wrong him, as he doth to injurie his neighbour, his kinsman, or his master."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c8f27b-7544-41b1-9028-63ac95f4dc42",
                        "source_entry_id": "aa786c2b-b29c-36f9-a26b-ffe19be21898",
                        "source_sense_id": "26cf0f94-f06a-34b1-917c-0c60ab085e3a",
                        "target_lang_word": "trauma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trauma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "Any serious injury to the body, often resulting from violence or an accident."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff17aa2-d0b8-4c3e-a291-ef58d0390d8c",
                                                "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                                                "text": "Repeated trauma or shaking to the brain can be even worse, leading to chronic traumatic encephalopathy, or CTE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "An emotional wound leading to psychological injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a38e053-0fdc-47c8-9406-0d81113336dd",
                                                "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                                "text": "Jailing her on Wednesday, magistrate Liz Clyne told Robins: \"You have shown little remorse either for the death of the kitten or the trauma to your former friend Sarah Knutton.\" She was also banned from keeping animals for 10 years."
                                            },
                                            {
                                                "example_id": "a7ae946b-cb5a-49ee-ac41-6c1d3cc13e37",
                                                "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                                "text": "And although it doesn’t mean acting like an infant again, it does require recognizing that many of the thoughts and behaviors you’d like to change come from lingering feelings of childhood traumas or your inner child, said Dr. Avigail Lev, a licensed clinical psychologist at the Bay Area CBT Center in San Francisco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430edc1e-4d14-321f-a4a3-aed0542f87b6",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "An event that causes great distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
