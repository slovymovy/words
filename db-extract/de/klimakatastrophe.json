                "senses": [
                    {
                        "sense_id": "9097db20-15ed-34ca-9dfd-0cc9c4749731",
                        "entry_id": "d1385f83-8cb4-3d42-a389-3c9328eb8843",
                        "glosses": [
                            "starke negative Veränderungen als Folge des Klimawandels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e360a400-d75c-46c4-a3ac-3b52842a2c86",
                                "sense_id": "9097db20-15ed-34ca-9dfd-0cc9c4749731",
                                "text": "Viele Wissenschaftler befürchten, dass die Erderwärmung zu einer Klimakatastrophe führt."
                            },
                            {
                                "example_id": "c6926057-7fb0-4b6f-a26e-a307caada785",
                                "sense_id": "9097db20-15ed-34ca-9dfd-0cc9c4749731",
                                "text": "„Wir werden aufgeklärt, wie sehr diese Energieverschwendung zur Klimakatastrophe beiträgt.“"
                            },
                            {
                                "example_id": "bf31162a-2ea4-44f6-94c4-ca5b2bdbdb19",
                                "sense_id": "9097db20-15ed-34ca-9dfd-0cc9c4749731",
                                "text": "„Während die Meeresspiegel fast unmerklich um etwa 3,4 Millimeter pro Jahr steigen, sind andere Klimakatastrophen weit auffälliger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
