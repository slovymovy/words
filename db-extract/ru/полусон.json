                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somnolence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bad8274-3116-3521-9dc0-985d963a12f4",
