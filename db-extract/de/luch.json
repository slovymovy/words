                                "example_id": "c72bdf1f-99da-4541-b894-d7dde18ef66a",
                                "sense_id": "b1f4142f-1198-396a-8d47-59798321c452",
                                "text": "„Das Luch ist eine sumpfig-morastige Senke.“"
                            },
                            {
                                "example_id": "8aff00a3-f9d0-4861-b775-1d3af98d47bd",
                                "sense_id": "b1f4142f-1198-396a-8d47-59798321c452",
                                "text": "„Das Rote Luch ist der höchstgelegene Teil der eiszeitlichen Rinne, die das Berliner Urstromtal bei Erkner mit dem Oderbruch verbindet.“"
                            }
