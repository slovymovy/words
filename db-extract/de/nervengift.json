                                        "glosses": [
                                            "Toxine agissant sur le système nerveux, généralement en perturbant ou en inhibant l’influx nerveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2cc4e24-8130-42b0-8b83-2c76fc2b51f7",
                                                "sense_id": "a87cb2d4-ac25-30bf-a586-b0311e56e302",
                                                "text": "Ils possèdent une peau souvent verruqueuse pourvue de nombreuses glandes à venin qui sécrètent chez beaucoup d’espèces néotropicales une neurotoxine : la bufotoxine."
                                            }
