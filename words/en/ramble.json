{
    "word_family": [
        "rambler",
        "rambling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f8a05a0-685e-38d4-9db7-abc1b0395e49",
                    "sense_definition": "To talk or write at length in a confused or inconsequential way, often with many digressions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor began to <w>ramble</w> about his childhood instead of finishing the lecture on physics.",
                            "target_lang_translations": {
                                "ru": "Профессор начал <w>разглагольствовать</w> о своем детстве вместо того, чтобы закончить лекцию по физике."
                            }
                        },
                        {
                            "text": "I tend to <w>ramble</w> on when I am nervous during a job interview.",
                            "target_lang_translations": {
                                "ru": "Я склонен <w>болтать</w> без умолку, когда нервничаю на собеседовании."
                            }
                        }
                    ],
                    "synonyms": [
                        "drivel"
                    ],
                    "common_phrases": [
                        "ramble on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать долго, бессвязно или непоследовательно, часто отвлекаясь от темы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "говорить пространно и бессвязно"
                            },
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "говорить много и не по делу"
                            },
                            {
                                "target_lang_word": "пустословить",
                                "target_lang_sense_clarification": "вести пустые разговоры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90b96b12-780d-3328-87cc-712bb1a4a144",
                    "sense_definition": "To walk for pleasure, typically in the countryside and without a specific destination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On Sundays, we like to <w>ramble</w> through the woods and enjoy the fresh air.",
                            "target_lang_translations": {
                                "ru": "По воскресеньям нам нравится <w>бродить</w> по лесу и наслаждаться свежим воздухом."
                            }
                        },
                        {
                            "text": "They spent the whole afternoon deciding to <w>ramble</w> across the hills.",
                            "target_lang_translations": {
                                "ru": "Они провели весь день, решив <w>прогуляться</w> по холмам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ramble through the woods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гулять ради удовольствия, обычно за городом и без определенного маршрута."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "медленно ходить без цели"
                            },
                            {
                                "target_lang_word": "прогуливаться",
                                "target_lang_sense_clarification": "совершать прогулку"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "странствовать пешком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b86ccd93-1750-3f8c-99e3-deefb2d25dd2",
                    "sense_definition": "To follow a winding or irregular path or course, such as a river or a climbing plant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow stream <w>rambled</w> through the valley before reaching the sea.",
                            "target_lang_translations": {
                                "ru": "Узкий ручей <w>петлял</w> по долине, прежде чем впасть в море."
                            }
                        },
                        {
                            "text": "Ivy began to <w>ramble</w> over the old stone walls of the garden.",
                            "target_lang_translations": {
                                "ru": "Плющ начал <w>виться</w> по старым каменным стенам сада."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Следовать извилистым или нерегулярным путем (о реке или вьющемся растении)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виться",
                                "target_lang_sense_clarification": "о растении или тропинке"
                            },
                            {
                                "target_lang_word": "петлять",
                                "target_lang_sense_clarification": "о реке или дороге"
                            },
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "следовать неровным курсом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0423c5c4-f517-31a1-afa5-f67defa32332",
                    "sense_definition": "To lead the life of a vagabond or to move about with no fixed home.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his youth <w>rambling</w> from town to town with no money in his pocket.",
                            "target_lang_translations": {
                                "ru": "Свою юность он провел, <w>скитаясь</w> из города в город без гроша в кармане."
                            }
                        },
                        {
                            "text": "The old traveler had a <w>rambling</w> itch that kept him from staying in one place for long.",
                            "target_lang_translations": {
                                "ru": "У старого путешественника была тяга к <w>бродяжничеству</w>, которая не давала ему долго оставаться на одном месте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rambling itch"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in a literary or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести жизнь бродяги или переезжать с места на место без постоянного дома."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродяжничать",
                                "target_lang_sense_clarification": "вести жизнь бездомного"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "странствовать без цели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc606548-39ef-3ca7-b0fa-3d30f2d780ef",
                    "sense_definition": "A long, leisurely walk taken for pleasure, especially in the countryside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a long <w>ramble</w> across the downs after lunch.",
                            "target_lang_translations": {
                                "ru": "После обеда мы отправились на долгую <w>прогулку</w> по холмистой местности."
                            }
                        },
                        {
                            "text": "She enjoyed her solitary <w>rambles</w> through the lanes near her house.",
                            "target_lang_translations": {
                                "ru": "Ей нравились одинокие <w>прогулки</w> по переулкам рядом с домом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "country ramble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная, неспешная прогулка ради удовольствия, особенно на природе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "пешее путешествие ради отдыха"
                            },
                            {
                                "target_lang_word": "странствие",
                                "target_lang_sense_clarification": "длительное перемещение пешком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61998616-6274-3151-9df1-b36a27ab4a16",
                    "sense_definition": "A long, confused, or disconnected speech or piece of writing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His latest blog post was a long <w>ramble</w> about nothing in particular.",
                            "target_lang_translations": {
                                "ru": "Его последний пост в блоге был длинной <w>болтовней</w> ни о чем конкретном."
                            }
                        },
                        {
                            "text": "I apologize for that <w>ramble</w>; I haven't had much sleep lately.",
                            "target_lang_translations": {
                                "ru": "Прошу прощения за это <w>пустословие</w>; я мало спал в последнее время."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная, запутанная или бессвязная речь или текст."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "бессодержательный разговор"
                            },
                            {
                                "target_lang_word": "пустословие",
                                "target_lang_sense_clarification": "бесплодные разговоры"
                            },
                            {
                                "target_lang_word": "бессвязная речь",
                                "target_lang_sense_clarification": "поток слов без четкой структуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50e501d2-9b4a-37b9-8e40-bf558fa8adc9",
                    "sense_definition": "A layer of shale or stone located immediately above a coal seam.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners had to be careful of the loose <w>ramble</w> above the coal.",
                            "target_lang_translations": {
                                "ru": "Шахтерам нужно было опасаться рыхлой <w>кровли</w> над углем."
                            }
                        },
                        {
                            "text": "A thick bed of <w>ramble</w> made the excavation process much more difficult.",
                            "target_lang_translations": {
                                "ru": "Толстый слой <w>породы</w> значительно усложнил процесс раскопок."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in mining contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой сланца или камня, расположенный непосредственно над угольным пластом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложная кровля",
                                "target_lang_sense_clarification": "горный термин для неустойчивой породы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}