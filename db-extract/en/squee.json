                        "sense_id": "3cf2d3a1-2ca1-32d8-bad4-a25579dd41aa",
                        "entry_id": "2a8f96b7-d39d-367d-bfaf-8c278d862fe1",
                        "glosses": [
                            "To squeal with excitement or delight."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "cd688d7a-a818-42b7-8dd7-3d10a80c025d",
                                "sense_id": "3cf2d3a1-2ca1-32d8-bad4-a25579dd41aa",
                                "text": "Meanwhile on Usenet, a couple of anti-choicers are racing to out-stupid each other, squeeing like school children over something someone said."
                            },
                            {
                                "example_id": "6934327c-1af7-4c1a-8316-50a60c4a88f2",
                                "sense_id": "3cf2d3a1-2ca1-32d8-bad4-a25579dd41aa",
                                "text": "On Tuesday, Reddit user lern41 got the Reddit community squeeing when he posted a few photos of his pet cats, Artemis and Apollo."
                            }
                        ]
                    }
