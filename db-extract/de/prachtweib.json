                "senses": [
                    {
                        "sense_id": "15c1ee5e-3dfa-3d8a-9a8c-34aabcc1063c",
                        "entry_id": "e319abb7-97a3-3b34-a4a7-e134fcd60be3",
                        "glosses": [
                            "Frau mit allen/vielen erwünschten weiblichen Eigenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda8d853-eade-4a22-801c-aa53a378529a",
                                "sense_id": "15c1ee5e-3dfa-3d8a-9a8c-34aabcc1063c",
                                "text": "„Und vor allem wusste er nichts von meiner Orangenbaumoase, in der vier Prachtweiber am Rosenbrunnen auf ihn warteten.“"
                            },
                            {
                                "example_id": "b0c40246-b012-4fda-b804-1a43bea47b1c",
                                "sense_id": "15c1ee5e-3dfa-3d8a-9a8c-34aabcc1063c",
                                "text": "„Lisa ist das, was man ein Prachtweib nennt, und ich kenne einen Haufen Leute, die gern ein paar Millionen zahlen würden, um jeden Morgen einen solchen Anblick zu genießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
