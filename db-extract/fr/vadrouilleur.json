                                        "entry_id": "0576db45-09b0-3906-8b00-48c003d20855",
                                        "glosses": [
                                            "An idle, worthless fellow, without any visible means of support; a dissipated sponger."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11bb8fd2-a2c6-49cd-9b44-39a4b3c21e0b",
                                                "sense_id": "57a07b59-db22-3b80-8445-b9362619cdfb",
                                                "text": "“If I get away I sha’n’t be here,” I says, “to prove these rapscallions ain’t your uncles, and I couldn’t do it if I was here. I could swear they was beats and bummers, that’s all, though that’s worth something."
                                            }
                                        ]
                                    },
