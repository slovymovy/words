                                            {
                                                "example_id": "9e062cd7-dcfa-407d-aeb6-c153f2538a03",
                                                "sense_id": "64976c7b-2e66-3c92-908a-20213078387d",
                                                "text": "Your Grace shall understand that at the receipt of your letter I am very sick"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7a28ef-17f0-340b-a89c-ecee734f2a4c",
                                        "entry_id": "49ffe91a-4104-3d9c-8016-7e72da3994b2",
                                        "glosses": [
                                            "The fact of having received a blow, injury etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
