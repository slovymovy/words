                                        "entry_id": "69b68a4f-4f04-3c64-8969-eb870cde4bb3",
                                        "glosses": [
                                            "einem System oder einer Systematik folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c991c6-959e-40b6-96bd-f58eaf37c10d",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "Ich werde mich systematisch von A bis Z durch alle Einträge des Wiktionary arbeiten und alle Rechtschreibfehler verbessern."
                                            },
                                            {
                                                "example_id": "ccd418f2-1bc8-40b1-91d3-f3f0ff91ca03",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "„Sie gehört zu den systematischsten Datenquellen zur öffentlichen Meinung über dieses Thema.“"
                                            },
                                            {
                                                "example_id": "0fbf8187-a274-43c4-a242-a7e4e331dd37",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "„In den wissenschaftlichen Unternehmungen Alexander von Humboldts kam der Besteigung hoher Berge eine zugleich systematische wie ästhetische Schlüsselstellung zu.“"
                                            },
                                            {
                                                "example_id": "9f9f3f91-c548-4689-9a2b-c039c8ad1615",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "„Der Streit um Bilder von Fototapeten hatte in den vergangenen Jahren zahlreiche Gerichte beschäftigt, insbesondere weil ein einzelner Fotograf systematisch gegen die Käufer besonders billig angebotener Fototapeten vorging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
