                        ],
                        "form": "den Gastsprecher"
                    },
                    {
                        "form_id": "c1e33e7f-086d-480d-8ecd-774b9c897c9e",
                        "entry_id": "60d2b1cb-c059-3179-a979-6ffddb3fe19d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gastsprecher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                        "entry_id": "60d2b1cb-c059-3179-a979-6ffddb3fe19d",
                        "glosses": [
                            "geladener Gast, der über ein bestimmtes Thema eine Rede halten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a204f6-b5f9-43e3-94c2-12b8af6c1f98",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Der deutsche Verteidigungsminister Schröder stellte als zweiter Gastsprecher fest, die sowjetischen Streitkräfte seien näher an die Bundesrepublik herangerückt und befänden sich in höherer Einsatzbereitschaft denn je zuvor.“"
                            },
                            {
                                "example_id": "0da63948-9ca3-4bd1-ba89-64d956705a77",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Ministerpräsident a. D. Theodor Steltzer — einer der drei Ueberlebenden des Kreisauer (Widerstands)-Kreises, war der nächste Gastsprecher.“"
                            },
                            {
                                "example_id": "d1d1a156-e5bc-4022-a9ac-f1ccbfe8b62f",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Unter den Gastsprechern hob die Bundestagsabgeordnete Professor Roswitha Wiesniewski (CDU) den Einklang ihrer Partei in der Unterstützung der Vermögensbildung vor allem für die Familie hervor; schon in Kürze seien entsprechende Gesetze zu erwarten.“"
                            },
                            {
                                "example_id": "ddbd42a3-8a75-40ef-94a5-1ac4fe826161",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Die Frohnauer Kiwanis treffen sich jeden ersten und dritten Dienstag im Monat, hören Gastsprecher und Referenten, die die verschiedenen Projekte vorstellen.“"
                            },
                            {
                                "example_id": "ce36ff9e-8d8f-4d73-a7b1-33ad0367d37f",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Benedikt ist nicht der erste Papst, der in der TV-Sendung spricht: Johannes Paul II. war 1987 Gastsprecher beim Wort am Sonntag.“"
                            },
                            {
                                "example_id": "aaf38dce-93a8-4964-9109-c91824927443",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Gastsprecher bei der Debatte wird Bruno Poncelet sein, ein belgischer Gewerkschaftler der FGTB (‚Fédération générale du travail de Belgique‘), Autor und Betreiber einer Plattform, die sich gegen die transatlantischen Abkommen einsetzt.“"
                            },
                            {
                                "example_id": "5f3fbcb2-d09b-487d-a6d9-bf0964a25bf0",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Verschiedene Gastsprecher skizzierten ihre Ansichten über diese lokale, aber sehr strittige Frage der Landreform.“"
                            },
                            {
                                "example_id": "561ed8e8-52ec-4e28-9105-7c297326d272",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Zahlreiche Farmer waren gestern zugegen, um den unterschiedlichsten Gastsprechern zuzuhören, darunter auch der in Namibia geborene und aufgewachsene Dr. Japie van Zyl, einer der Direktoren des Jet Propulsion Laboratory der NASA.“"
                            },
                            {
                                "example_id": "07075597-b196-4172-a93e-14286b3d9ab4",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Gastsprecher auf der Jahreshauptversammlung war Minister Tom Alweendo, Generaldirektor der Nationalen Planungskommission.“"
                            },
                            {
                                "example_id": "5dc505b6-180f-47f8-aafd-d3c5e6c82222",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Der vielleicht prominenteste Gastsprecher der Oracle Open World heißt Steve Jobs.“"
                            },
                            {
                                "example_id": "fb198cd7-5142-4731-ba50-878f77d82650",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Dazu haben sicherlich auch die Gastsprecher von einigen deutschen Universitäten beigetragen, die vor allem den überregionalen Aspekt einbrachten.“"
                            },
                            {
                                "example_id": "05b40c90-a510-4107-b531-ab205cd193af",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„‚Die unmittelbare Kommunikation mit Schulklassen und Gastsprechern von allen Kontinenten bietet den Schülern die Gelegenheit, ihr im Unterricht erworbenes Wissen in authentischen Kommunikationssituationen anzuwenden und zu festigen‘, sagt Zablatnik.“"
                            },
                            {
                                "example_id": "6e87c64e-adb3-452f-9cb5-00dc23f6e38c",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Dasselbe hat auch der Gastsprecher mit anderen Worten ausgedrückt und hinterließ dem Publikum drei Gebote zur Verbesserung des Verhältnisses zur Welt und den Mitmenschen: ‚Sei direkt‘, ‚Habe Mut‘ und ‚Traue dich, Fehler zu machen‘, gemäß dem Sprichwort ‚Fehler machen und daraus lernen ist Erfahrung‘.“"
                            },
                            {
                                "example_id": "180a10e4-3cc7-4869-a45f-289101a01768",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Überall auf der Welt treffen sich die Mitglieder monatlich, wobei Gastsprecher sich zu tourismusnahen, aber auch allgemein wichtigen Themen äussern.“"
                            },
                            {
                                "example_id": "26fb1162-2724-41c0-b46e-2d604b5be2d0",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Am 14. März 1977 hielt Margaret Thatcher, damals britische Oppositionsführerin, in Zürich eine Rede. Als «erster weiblicher Gastsprecher», wie die NZZ damals frei von politisch korrektem Sprachgebrauch notierte, sprach sie vor der renommierten Zürcher Volkswirtschaftlichen Gesellschaft.“"
                            },
                            {
                                "example_id": "edebff59-6b1d-457f-893a-5379e1e4c82b",
                                "sense_id": "477d95d9-ae4b-352a-9f8b-6f3bb5b0e165",
                                "text": "„Aber die Qualität der Kurse ist hoch, und es kommen viele interessante Gastsprecher an unsere Uni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
