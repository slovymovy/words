                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2732a48c-f539-4f0c-91aa-b5826484f9ed",
                                "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                "text": "Der historische Treidelpfad entlang des Kanals ist heute ein beliebter Rad- und Wanderweg."
                            },
                            {
                                "example_id": "4043b405-640f-488a-ab89-9fa55e674460",
                                "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                "text": "„Das Pferd trottete den holprigen Treidelpfad in Richtung Bath entlang.“"
                            },
                            {
                                "example_id": "878f2a10-8382-4376-84c5-06ded3898b59",
                                "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                "text": "\"Lein- oder Treidelpfad hieß der Uferweg an schiffbaren Flüssen. Auf ihm zogen Menschen oder Zugtiere Schiffe mit Seilen stromauf.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
