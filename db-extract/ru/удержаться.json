                "senses": [
                    {
                        "sense_id": "d1cc34e0-0180-3177-ad55-8c197fabae87",
                        "entry_id": "efcb4039-3e8b-32eb-8994-9419bb24ddeb",
                        "glosses": [
                            "to keep, to remain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387d14a3-3652-40c9-b82a-69d0e3a3ee7e",
                                "sense_id": "d1cc34e0-0180-3177-ad55-8c197fabae87",
                                "text": "удержа́ться на нога́х",
                                "translation": "to keep one's feet; remain on one's feet",
                                "english": "to keep one's feet; remain on one's feet"
                            },
                            {
                                "example_id": "79f53079-d162-4f99-8a25-5c1184ae5990",
                                "sense_id": "d1cc34e0-0180-3177-ad55-8c197fabae87",
                                "text": "удержа́ться в седле́",
                                "translation": "to keep/stay in the saddle",
                                "english": "to keep/stay in the saddle"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a3de35c-85cb-3b47-9629-ba5b95b0ede0",
                        "entry_id": "efcb4039-3e8b-32eb-8994-9419bb24ddeb",
                        "glosses": [
                            "to hold one's ground, to hold out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f395c23-1f31-45b0-9a86-2ee6c9108064",
                                "sense_id": "5a3de35c-85cb-3b47-9629-ba5b95b0ede0",
                                "text": "неприя́тель стара́лся удержа́ться на реке́",
                                "translation": "the enemy tried to hold out [make a stand] on the river",
                                "english": "the enemy tried to hold out [make a stand] on the river"
                            }
                        ]
                    },
                    {
                        "sense_id": "0a659536-106b-3693-8552-4110eac96b62",
                        "entry_id": "efcb4039-3e8b-32eb-8994-9419bb24ddeb",
                        "glosses": [
                            "to keep (from), to refrain (from)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e7834d-18cb-45ac-93c4-a10015c0e586",
                                "sense_id": "0a659536-106b-3693-8552-4110eac96b62",
                                "text": "удержа́ться от собла́зна",
                                "translation": "to resist the temptation",
                                "english": "to resist the temptation"
                            },
                            {
                                "example_id": "c88d2eaf-a96f-4218-83f8-54a163e14054",
                                "sense_id": "0a659536-106b-3693-8552-4110eac96b62",
                                "text": "уде́рживаться от куре́ния",
                                "translation": "refrain from smoking",
                                "english": "refrain from smoking"
                            },
                            {
                                "example_id": "83edd0b6-9d66-4b38-a187-14b3fcb61672",
                                "sense_id": "0a659536-106b-3693-8552-4110eac96b62",
                                "text": "нельзя́ удержа́ться (от)",
                                "translation": "one cannot help",
                                "english": "one cannot help"
                            },
                            {
                                "example_id": "57004fdc-5183-4bad-b2c6-1d74813de526",
                                "sense_id": "0a659536-106b-3693-8552-4110eac96b62",
                                "text": "он не мог удержа́ться от сме́ха",
                                "translation": "he couldn't help [refrain from] laughing",
                                "english": "he couldn't help [refrain from] laughing"
                            }
                        ]
                    },
