                    {
                        "sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
                        "entry_id": "b50588cb-936d-382b-87f4-538a12d94f24",
                        "glosses": [
                            "In a diligent manner, with appropriate effort, carefully."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c468452d-2faf-40f4-9de0-1ea01608e265",
                                "sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
                                "text": "Instead, empty bags were folded diligently into the corners of underpacked suitcases, waiting to be jammed full with the familiar objects of home."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c472e5cb-589f-4590-a142-89d382c1be17",
                        "source_entry_id": "b50588cb-936d-382b-87f4-538a12d94f24",
                        "source_sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
                        "source_sense_description": "in a diligent manner",
                        "target_lang_word": "diligemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diligemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75e42a3c-72d4-30c5-b2e5-c0f9ed5ef29c",
                                        "entry_id": "4d307b08-f3b8-3153-ad98-6b01c3b7cfc5",
                                        "glosses": [
                                            "Avec soin, attention."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2841f4a-1421-4495-809e-4c911dc0ab6b",
                                                "sense_id": "75e42a3c-72d4-30c5-b2e5-c0f9ed5ef29c",
                                                "text": "Nous avons bien souvent à mespris une chose,\nIgnorans la vertu qui est en elle enclose,\nFaute de rechercher diligemment le pris\nQui pourroit estonner en apres noz esprits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8714f033-05eb-3747-a467-97c7c5f3498b",
                                        "entry_id": "4d307b08-f3b8-3153-ad98-6b01c3b7cfc5",
                                        "glosses": [
                                            "Avec diligence, avec promptitude."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b81913b7-884c-4deb-bb24-5510d3ec82cc",
                                                "sense_id": "8714f033-05eb-3747-a467-97c7c5f3498b",
                                                "text": "Allez diligemment vous saisir de ce traître."
                                            },
                                            {
                                                "example_id": "f7d1f8ba-4a07-4c61-920d-ca94c2ca241e",
                                                "sense_id": "8714f033-05eb-3747-a467-97c7c5f3498b",
                                                "text": "Le duc le ramassa diligemment."
                                            },
                                            {
                                                "example_id": "b9fa525d-68d7-470e-b6ad-da09cfb25766",
                                                "sense_id": "8714f033-05eb-3747-a467-97c7c5f3498b",
                                                "text": "Les ordres de l’amirauté furent diligemment exécutés et avec une exactitude qui accompagne rarement la diligence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5be86d96-9f96-4b6b-870d-4a25ac7ae54d",
                        "source_entry_id": "b50588cb-936d-382b-87f4-538a12d94f24",
                        "source_sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
