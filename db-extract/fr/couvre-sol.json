                ],
                "senses": [
                    {
                        "sense_id": "e9004b98-c3d4-39b0-a5b9-28d94430bb7d",
                        "entry_id": "fc39221d-b068-331a-a745-bca7c2cf54c7",
                        "glosses": [
                            "Se dit d’une plante qui pousse en s’étalant sur le sol et non en hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9d626c-e7d3-4306-85e9-656ecf5ff4ae",
                                "sense_id": "e9004b98-c3d4-39b0-a5b9-28d94430bb7d",
                                "text": "Pensez aussi aux vivaces couvre-sol pour les zones trop difficiles à enherber."
                            },
                            {
                                "example_id": "0ec19330-6bfe-49b6-94fb-f5c1f7edc6af",
                                "sense_id": "e9004b98-c3d4-39b0-a5b9-28d94430bb7d",
                                "text": "L'utilisation des plantes couvre-sol au jardin permet de limiter l'entretien des zones les plus difficiles d'accès comme les talus ou le dessous des arbres et arbustes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ed718334-5e00-3b7a-bca7-e68e3177eada",
                "word": "couvre-sol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c447ee3-30ff-4768-8213-7ad946d006a5",
                        "entry_id": "ed718334-5e00-3b7a-bca7-e68e3177eada",
                        "tags": [
                            "plural"
                        ],
                        "form": "couvre-sols"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21c1681c-61a4-3711-bb1e-f4f102a10cfc",
                        "entry_id": "ed718334-5e00-3b7a-bca7-e68e3177eada",
                        "glosses": [
                            "Plante qui pousse en s’étalant sur le sol et non en hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb78658c-6613-455c-a5f7-12e3d3f4c7b0",
                                "sense_id": "21c1681c-61a4-3711-bb1e-f4f102a10cfc",
                                "text": "Avec ces couvre-sols, vous habillerez d'une manière originale le sol de votre jardin."
                            }
                        ]
                    },
                    {
                        "sense_id": "27e24fac-7964-30a6-96dc-35c7e2b0f505",
                        "entry_id": "ed718334-5e00-3b7a-bca7-e68e3177eada",
                        "glosses": [
                            "Plante cultivée en intercalaire, pour protéger les sols, sans intention de récolte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd4b8c8-cfa0-4027-8ee4-c54acd23a332",
                                "sense_id": "27e24fac-7964-30a6-96dc-35c7e2b0f505",
                                "text": "Les couvre-sol préviennent l’érosion en retenant la terre à sa place dans les régions ventées et les zones de ruissellement."
                            },
                            {
                                "example_id": "d1738b0e-5da5-443a-b273-73018fb738b9",
                                "sense_id": "27e24fac-7964-30a6-96dc-35c7e2b0f505",
                                "text": "Les couvre-sol étouffent les mauvaises herbes en leur faisant de l'ombre ou en se montrant encore plus agressifs qu’elles."
                            }
                        ]
                    }
                ],
