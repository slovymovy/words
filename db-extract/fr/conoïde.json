                "senses": [
                    {
                        "sense_id": "884377ef-e60f-3d26-8334-8992cd530f9a",
                        "entry_id": "a479b3c6-4c29-3ad3-8e25-3d1df4483088",
                        "glosses": [
                            "Qui a la forme d’un cône."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "5538997c-6e89-435b-a505-6d600a700923",
                                "sense_id": "884377ef-e60f-3d26-8334-8992cd530f9a",
                                "text": "La petite dame du type « conoïde » tristement inexpressif, que l’absence de menton fait comiquement grimacer alors qu’elle s’imagine gracieusement sourire, se proclame volontiers reine de beauté, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "6946f72a-82d4-3d92-af60-a4f6b9e00c56",
                        "entry_id": "a479b3c6-4c29-3ad3-8e25-3d1df4483088",
                        "glosses": [
                            "Qualifie les ligaments qui servent à attacher la clavicule à la scapula."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e118bbf4-570e-4aee-b7a1-a93dafd35479",
                                "sense_id": "6946f72a-82d4-3d92-af60-a4f6b9e00c56",
                                "text": "La face inférieure porte, dans sa partie moyenne, le sillon du muscle subclavier et, dans sa partie latérale, le tubercule conoïde et la ligne trapézoïde."
                            },
                            {
                                "example_id": "1967213d-6877-4560-948d-b80303751044",
                                "sense_id": "6946f72a-82d4-3d92-af60-a4f6b9e00c56",
                                "text": "Il comprend deux parties, le ligament conoïde et le ligament trapézoïde. Le ligament conoïde à un aspect de cône inversé, et s'étend du coude formé par l'apophyse coracoïde au tubercule conoïde de la clavicule."
                            }
                        ]
                    }
                ],
