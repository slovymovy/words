                    {
                        "sense_id": "b070b4c1-103c-3ef0-a7e4-77407c9fae7d",
                        "entry_id": "d4bbf31a-ec6d-3e92-b3dd-a4b60adcf836",
                        "glosses": [
                            "Industrie du transport de marchandises par bateaux sur les fleuves, rivières, canaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd385d50-4ae5-4663-932a-d1c29c8bd06b",
                                "sense_id": "b070b4c1-103c-3ef0-a7e4-77407c9fae7d",
                                "text": "Sous la protection de la tour romane de l’église Saint-Sauveur, gens de mer et gens de terre se réuniront pour revivre la grande époque de la batellerie locale."
                            },
                            {
                                "example_id": "c57c81dc-e99a-48fd-9aea-008b7f7e8f37",
                                "sense_id": "b070b4c1-103c-3ef0-a7e4-77407c9fae7d",
                                "text": "Je tiens aussi à visiter, avant de partir, le port de Vitry, haut lieu de la batellerie où le commissaire Maigret, épuisé par sa course à vélo, finit par trouver la solution de l’énigme."
                            }
                        ]
                    },
                    {
                        "sense_id": "17bf136a-304d-35f7-88b7-63e51ac2eb00",
                        "entry_id": "d4bbf31a-ec6d-3e92-b3dd-a4b60adcf836",
                        "glosses": [
                            "Ensemble de bateaux qui servent à cette industrie."
