        "nl-extract.jsonl": [
            {
                "entry_id": "670d6205-82ee-33c6-8444-e7b27fc00cf5",
                "word": "iedere",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8101849e-6142-3e7c-868d-7e63b7f9fe58",
                        "entry_id": "670d6205-82ee-33c6-8444-e7b27fc00cf5",
                        "glosses": [
                            "verbogen vorm van ieder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1332fbca-92c6-4e29-8ed2-76da6497ccd6",
                                "sense_id": "8101849e-6142-3e7c-868d-7e63b7f9fe58",
                                "text": "Hij gaat iedere dag een stuk wandelen."
                            },
                            {
                                "example_id": "74a21106-4b27-488d-b3c2-06518fc6ff33",
                                "sense_id": "8101849e-6142-3e7c-868d-7e63b7f9fe58",
                                "text": "Het was alsof er meerdere mensen in mijn hoofd meeliepen, iedere stem met een eigen motivatie: soms vanuit mijn ego, soms vanuit mijn verstand en soms vanuit pure angst."
                            },
                            {
                                "example_id": "f037447f-eb0a-43b7-a41a-05ef6662bf20",
                                "sense_id": "8101849e-6142-3e7c-868d-7e63b7f9fe58",
                                "text": "'Dat geldt voor iedere schrijver."
                            },
                            {
                                "example_id": "eea321a5-4b09-4d82-8dbd-a59f39709e16",
                                "sense_id": "8101849e-6142-3e7c-868d-7e63b7f9fe58",
                                "text": "En nu kan ik die klote-Gerry niet eens meer aankijken, want iedere keer dat we elkaar zien, weet ik dat hij denkt: wat als je beter je best had gedaan? En ik denk precies hetzelfde van hem."
                            },
                            {
                                "example_id": "154d993e-58f1-4f11-aa4d-701f67e3d978",
                                "sense_id": "8101849e-6142-3e7c-868d-7e63b7f9fe58",
                                "text": "'Met zijn Angelsaksischem' 'Zijn wat?' 'Met zijn rijtjeshuis, met een raam waar ze nooit echt door naar buiten kijken, omdat ze denken dat ze iedere struik, iedere bloem, de bast van elke boom, de stemming van elke wolk, al kennen."
                            }
                        ]
                    }
                ],
