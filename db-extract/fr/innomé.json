                ],
                "senses": [
                    {
                        "sense_id": "59a789c1-b50a-310a-949f-44ea39c72ab6",
                        "entry_id": "1fe09737-4714-3c77-b78c-cd29f36a2d38",
                        "glosses": [
                            "Variante de innommé."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c449f4e3-2838-40ef-a6d3-a2380e614d43",
                                "sense_id": "59a789c1-b50a-310a-949f-44ea39c72ab6",
                                "text": "Il y a sur la boule terrestre une foule innombrable, innomée, dont le sommeil n’endormirait pas suffisamment les souffrances."
                            },
                            {
                                "example_id": "7b2aaf4e-e747-4696-ad61-adb84ea8e218",
                                "sense_id": "59a789c1-b50a-310a-949f-44ea39c72ab6",
                                "text": "Par la nature, la forme et l'esprit de la prévention, on remonte à la pensée mère, à l'élément substantiel de ce procès innomé et stupide, où la suprématie gouvernementale, l’interprétation intolérable de l’ordre public, violent et criminalisent le droit privé et le droit commun sous le couvert de la justice."
                            },
                            {
                                "example_id": "c16c92e2-ca46-4714-b0d2-218c2a0f81fb",
                                "sense_id": "59a789c1-b50a-310a-949f-44ea39c72ab6",
                                "text": "Ce jour-là, sur la feuille sabrée à grands coups de crayon noir, c’était une pluie d’étoiles pâles, tout un ruissellement de pétales infiniment doux ; tandis que, dans un coin, un épanouissement innomé, un bouton aux chastes voiles, s’ouvrait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e7e02ed-bad5-4850-944d-0f845de74679",
                        "source_entry_id": "1fe09737-4714-3c77-b78c-cd29f36a2d38",
                        "source_sense_id": "59a789c1-b50a-310a-949f-44ea39c72ab6",
                        "target_lang_word": "nameless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nameless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0664a1-5836-3f5e-a4a3-bd8046bda12f",
                                        "entry_id": "bd719c23-35f4-3c25-bc03-38939f7dd993",
                                        "glosses": [
                                            "Not having a name."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7056fb8c-6643-4d8b-991f-32c09dfdb2df",
                                                "sense_id": "ab0664a1-5836-3f5e-a4a3-bd8046bda12f",
                                                "text": "Environmental DNA analysis suggests that the number of species of bacteria that remain nameless to date may well be on the order of many thousands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c7e298b-ce99-3191-bbf6-259823915aee",
                                        "entry_id": "bd719c23-35f4-3c25-bc03-38939f7dd993",
                                        "glosses": [
                                            "Whose name is unknown; unidentified or obscured."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14be27f7-f52f-4866-96f1-6087d129d5c6",
                                                "sense_id": "4c7e298b-ce99-3191-bbf6-259823915aee",
                                                "text": "The culprits shall remain nameless here, as some names have been changed to protect the guilty; just don't let it happen again."
                                            },
                                            {
                                                "example_id": "9d42dfe7-82bd-481a-8657-966024abea72",
                                                "sense_id": "4c7e298b-ce99-3191-bbf6-259823915aee",
                                                "text": "Victims of rug pulls are often left with little recourse against nameless thieves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0533a3b-08de-3ecd-9f3d-2180ab35d8c7",
                                        "entry_id": "bd719c23-35f4-3c25-bc03-38939f7dd993",
                                        "glosses": [
                                            "Unable to be described or expressed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3ddb32-235b-4677-8d8c-6e2251934fde",
                                                "sense_id": "b0533a3b-08de-3ecd-9f3d-2180ab35d8c7",
                                                "text": "a nameless unease"
                                            },
                                            {
                                                "example_id": "d6a9ff07-a3dc-4441-89dc-4d6bec957a38",
                                                "sense_id": "b0533a3b-08de-3ecd-9f3d-2180ab35d8c7",
                                                "text": "a nameless fear"
                                            },
                                            {
                                                "example_id": "e8ddd46d-9eed-4d2b-90f1-4c9baebc5f74",
                                                "sense_id": "b0533a3b-08de-3ecd-9f3d-2180ab35d8c7",
                                                "text": "Minute grew into minute, and still there was no sign of life, nor did the curtain move; but I felt the gaze of the unknown being sinking through and through me, and filling me with a nameless terror, till the perspiration stood in beads upon my brow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f6f3cff-e919-3bc8-8b49-b58d4c71ad4d",
                                        "entry_id": "bd719c23-35f4-3c25-bc03-38939f7dd993",
                                        "glosses": [
                                            "Illegitimate."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26b66ac-df43-43b9-96b1-79ab1176a779",
                                                "sense_id": "5f6f3cff-e919-3bc8-8b49-b58d4c71ad4d",
                                                "text": "He said that he would cherish her until the grave, and that he would love her nameless son as though he were his own flesh."
                                            }
                                        ]
                                    }
                                ]
                            },
