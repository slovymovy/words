                "forms": [],
                "senses": [
                    {
                        "sense_id": "026e95a2-e7c3-3404-8518-568c30bab5db",
                        "entry_id": "eef6d62e-b826-3ebf-8286-a89dfe1782d6",
                        "glosses": [
                            "Nom usuel de plusieurs plantes grimpantes à fleurs en entonnoir du genre Ipomoea, aussi nommée liseron bleu ou ipomée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a87f413-81d4-4e06-aa84-cfd88ce408a0",
                                "sense_id": "026e95a2-e7c3-3404-8518-568c30bab5db",
                                "text": "Les yeux, chargés de langueur, se levèrent sur lui à mesure qu’il s’approchait, comme s’ouvrent les tournesols et les volubilis au premier rayon du soleil levant."
                            },
                            {
                                "example_id": "4223dc03-928a-4700-93fa-935e3ee89092",
                                "sense_id": "026e95a2-e7c3-3404-8518-568c30bab5db",
                                "text": "Des volubilis élargissaient le cœur découpé de leurs feuilles, sonnaient de leurs milliers de clochettes un silencieux carillon de couleurs exquises.."
                            },
                            {
                                "example_id": "c426e8a1-b73d-46c2-acd2-4fb40ad7a2b7",
                                "sense_id": "026e95a2-e7c3-3404-8518-568c30bab5db",
                                "text": "Le bleu fluorescent des enseignes au néon me rappelait les volubilis de mon enfance."
                            },
                            {
                                "example_id": "aa5180c8-5833-48ca-9456-2388b9794c99",
                                "sense_id": "026e95a2-e7c3-3404-8518-568c30bab5db",
                                "text": "Puis, comme le volubilis qui s'ouvrait le matin au soleil, qui spiralait autour d’un porteur, elle s’était enroulée autour de lui."
                            }
                        ]
                    }
                ],
