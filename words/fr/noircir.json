    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                    "sense_definition": "Rendre noir ou plus sombre en appliquant une couleur, de la suie ou par l'effet du feu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fumée du feu de bois a complètement <w>noirci</w> les murs du salon."
                        },
                        {
                            "text": "Elle utilise un crayon spécial pour <w>noircir</w> ses sourcils le matin."
                        }
                    ]
                },
                {
                    "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                    "sense_definition": "Prendre une couleur noire ou sombre sous l'effet de l'air, du temps ou de la chaleur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les morceaux de pomme coupés ont tendance à <w>noircir</w> à l'air libre."
                        },
                        {
                            "text": "Le bois exposé à la pluie finit par <w>noircir</w> avec les années."
                        }
                    ]
                },
                {
                    "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                    "sense_definition": "Diffamer quelqu'un, ternir sa réputation ou le présenter sous un jour défavorable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses ennemis ont répandu des rumeurs pour <w>noircir</w> sa réputation avant le vote."
                        },
                        {
                            "text": "Il refuse de <w>noircir</w> son rival pour remporter cette élection locale."
                        }
                    ],
                    "common_phrases": [
                        "noircir la réputation",
                        "noircir le tableau"
                    ]
                },
                {
                    "sense_id": "d0246cc0-c301-3cdd-9750-926bcda57cf3",
                    "sense_definition": "Devenir sombre et menaçant, en se couvrant de nuages épais.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel a commencé à se <w>noircir</w> juste avant le début de l'orage."
                        },
                        {
                            "text": "Quand l'horizon se <w>noircit</w> ainsi, il vaut mieux vite rentrer à la maison."
