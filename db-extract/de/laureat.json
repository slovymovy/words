                                        "glosses": [
                                            "Crowned, or decked, with laurel."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "postpositional",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c038b74-fee5-4418-bbd7-556b9a6b9028",
                                                "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                                "text": "To strew the laureate hearse where Lycid lies."
                                            },
                                            {
                                                "example_id": "9aedd582-7c37-40ff-9303-22f444dca8bb",
                                                "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                                "text": "Soft on her lap her laureate son reclines."
                                            },
                                            {
                                                "example_id": "ae927201-5b7f-40ef-a5a7-b89396b630e2",
                                                "sense_id": "0b5ef05c-75c0-3de3-bc0e-53a2a55ead67",
                                                "text": "Although the post of poet laureate as we know it was not established until John Dryden's appointment in 1668,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laureate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2a98ba-14ea-36a3-9889-ccc5acd2fac4",
                                        "entry_id": "c472f1a6-369a-3727-8125-b531ba782149",
                                        "glosses": [
                                            "One crowned with laurel, such as a poet laureate or Nobel laureate."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb92c4e-4221-417f-8a62-78f85f3176ac",
                                                "sense_id": "cb2a98ba-14ea-36a3-9889-ccc5acd2fac4",
                                                "text": "a learn'd laureate"
                                            },
                                            {
                                                "example_id": "adb51daf-82c3-4c86-8445-093eb6968af8",
                                                "sense_id": "cb2a98ba-14ea-36a3-9889-ccc5acd2fac4",
                                                "text": "Maria Ressa, the chief executive and cofounder of Rappler, and Dmitry Muratov, the editor-in-chief of Novaya Gazeta, were named as this year’s laureates by Berit Reiss-Andersen, the chair of the Norwegian Nobel committee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbab257-b9dc-3442-b3ff-6ac0e537e497",
                                        "entry_id": "c472f1a6-369a-3727-8125-b531ba782149",
                                        "glosses": [
                                            "A graduate of a university."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laureate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eedd9e77-86ee-37fc-ad52-5db881205536",
                                        "entry_id": "edb7a0b0-b095-35ca-8d1a-452fc692fede",
                                        "glosses": [
                                            "To honor with a wreath of laurel, as formerly was done in bestowing a degree at English universities."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
