{
    "word_family": [
        "attainable",
        "attainment",
        "unattainable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8f3f657-fde9-38d7-9b5c-1b28ff3ed40e",
                    "sense_definition": "To succeed in getting or achieving something, especially after a lot of effort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>attain</w> such a high level of proficiency requires hours of practice each day.",
                            "target_lang_translations": {
                                "ru": "Чтобы <w>достичь</w> такого высокого уровня мастерства, требуются часы практики каждый день."
                            }
                        },
                        {
                            "text": "The company worked hard to <w>attain</w> its goals by the end of the fiscal year.",
                            "target_lang_translations": {
                                "ru": "Компания усердно работала, чтобы <w>добиться</w> своих целей к концу финансового года."
                            }
                        }
                    ],
                    "synonyms": [
                        "achieve",
                        "accomplish",
                        "reach"
                    ],
                    "antonyms": [
                        "fail",
                        "lose",
                        "forfeit"
                    ],
                    "common_phrases": [
                        "attain a goal",
                        "attain a level",
                        "attain success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно получить или достичь чего-либо, особенно после больших усилий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достичь",
                                "target_lang_sense_clarification": "цели или результата"
                            },
                            {
                                "target_lang_word": "добиться",
                                "target_lang_sense_clarification": "успеха или желаемого"
                            },
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "процесс достижения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8237a1fe-b275-393a-879c-e0e72ca58677",
                    "sense_definition": "To reach a particular age, level, or condition through natural growth or progression.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaching_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most people do not <w>attain</w> their full height until they are in their late teens.",
                            "target_lang_translations": {
                                "ru": "Большинство людей не <w>достигают</w> своего полного роста до позднего подросткового возраста."
                            }
                        },
                        {
                            "text": "It is rare for a wild animal to <w>attain</w> old age due to various environmental threats.",
                            "target_lang_translations": {
                                "ru": "Дикие животные редко <w>доживают</w> до старости из-за различных угроз окружающей среды."
                            }
                        }
                    ],
                    "synonyms": [
                        "reach",
                        "get"
                    ],
                    "common_phrases": [
                        "attain maturity",
                        "attain old age",
                        "attain full growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь определенного возраста, уровня или состояния в процессе естественного роста или развития."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "возраста или зрелости"
                            },
                            {
                                "target_lang_word": "достичь",
                                "target_lang_sense_clarification": "определенного предела или состояния"
                            },
                            {
                                "target_lang_word": "доживать",
                                "target_lang_sense_clarification": "до определенного возраста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a0e9b6-2bb4-321c-abf8-ebcc9d7b14ab",
                    "sense_definition": "To reach a specific standard of excellence or a high degree of quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new restaurant strives to <w>attain</w> excellence in every dish they serve.",
                            "target_lang_translations": {
                                "ru": "Новый ресторан стремится <w>достичь</w> совершенства в каждом подаваемом блюде."
                            }
                        },
                        {
                            "text": "Few modern poets can <w>attain</w> the same degree of fame as the classics.",
                            "target_lang_translations": {
                                "ru": "Немногие современные поэты могут <w>добиться</w> такой же степени славы, как классики."
                            }
                        }
                    ],
                    "synonyms": [
                        "equal",
                        "reach"
                    ],
                    "common_phrases": [
                        "attain excellence",
                        "attain a degree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достичь определенного стандарта мастерства или высокого уровня качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достичь",
                                "target_lang_sense_clarification": "высокого уровня или мастерства"
                            },
                            {
                                "target_lang_word": "добиться",
                                "target_lang_sense_clarification": "превосходства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89bb43e5-270f-31e0-b0fe-953ba9f49e2e",
                    "sense_definition": "To catch up with or reach someone who is ahead.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_reach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pursuers hoped to <w>attain</w> the fleeing soldiers before they reached the border.",
                            "target_lang_translations": {
                                "ru": "Преследователи надеялись <w>настигнуть</w> бегущих солдат до того, как они достигнут границы."
                            }
                        },
                        {
                            "text": "Despite his speed, he was not <w>attaining</w> the lead runner in time to win.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свою скорость, он не <w>догонял</w> лидера вовремя, чтобы победить."
                            }
                        }
                    ],
                    "synonyms": [
                        "overtake",
                        "catch up with"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Догнать или настичь кого-либо, кто находится впереди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настигнуть",
                                "target_lang_sense_clarification": "догнать кого-либо"
                            },
                            {
                                "target_lang_word": "догнать",
                                "target_lang_sense_clarification": "поравняться с кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa979f59-7bd7-3e41-8dd4-bc8a546c719d",
                    "sense_definition": "To grasp or understand a specific piece of knowledge or meaning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student struggled to <w>attain</w> the true meaning of the complex philosophical text.",
                            "target_lang_translations": {
                                "ru": "Студент изо всех сил пытался <w>постичь</w> истинный смысл сложного философского текста."
                            }
                        },
                        {
                            "text": "He suspected himself of not well <w>attaining</w> the author's original intent.",
                            "target_lang_translations": {
                                "ru": "Он подозревал, что не совсем верно <w>уяснил</w> первоначальный замысел автора."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascertain",
                        "get"
                    ],
                    "common_phrases": [
                        "attain knowledge",
                        "attain meaning"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts regarding the acquisition of knowledge."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознать или понять определенное знание или смысл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постичь",
                                "target_lang_sense_clarification": "смысл или истину"
                            },
                            {
                                "target_lang_word": "уяснить",
                                "target_lang_sense_clarification": "суть или значение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}