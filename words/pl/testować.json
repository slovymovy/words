    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78cf5b31-114d-3aa7-9a47-1665f2d26b02",
                    "sense_definition": "sprawdzać jakość, prawdziwość lub działanie czegoś poprzez przeprowadzanie prób lub eksperymentów",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sprawdzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naukowcy muszą dokładnie <w>testować</w> nowy lek przed wprowadzeniem go do aptek.",
                            "target_lang_translations": {
                                "ru": "Ученые должны тщательно <w>тестировать</w> новое лекарство перед его внедрением в аптеки."
                            }
                        },
                        {
                            "text": "Zanim kupisz ten samochód, powinieneś <w>testować</w> go na drodze przez co najmniej godzinę.",
                            "target_lang_translations": {
                                "ru": "Прежде чем купить эту машину, тебе стоит <w>испытать</w> её на дороге в течение как минимум часа."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprawdzać"
                    ],
                    "common_phrases": [
                        "testować nowy produkt",
                        "testować rozwiązanie",
                        "testować cierpliwość"
                    ],
                    "target_lang_definitions": {
                        "ru": "проверять качество, подлинность или работу чего-либо путем проведения испытаний или экспериментов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тестировать",
                                "target_lang_sense_clarification": "проверять работоспособность или качество"
                            },
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "проверять в действии"
                            },
                            {
                                "target_lang_word": "проверять",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d453dc7-55e2-368d-96ba-679a6e83018a",
                    "sense_definition": "poddawać produkt lub urządzenie trudnym warunkom w celu sprawdzenia jego wytrzymałości",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sprawdzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inżynierowie będą <w>testować</w> wytrzymałość materiałów w ekstremalnie niskich temperaturach.",
                            "target_lang_translations": {
                                "ru": "Инженеры будут <w>тестировать</w> прочность материалов при экстремально низких температурах."
                            }
                        },
                        {
                            "text": "Firma zaczęła <w>testować</w> prototyp w górach, aby sprawdzić, jak radzi sobie w trudnym terenie.",
                            "target_lang_translations": {
                                "ru": "Компания начала <w>испытывать</w> прототип в горах, чтобы проверить, как он справляется в трудной местности."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprawdzać"
                    ],
                    "common_phrases": [
                        "testować prototyp",
                        "testować wytrzymałość",
                        "testować w terenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "подвергать продукт или устройство тяжелым условиям для проверки его прочности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "на прочность или в сложных условиях"
                            },
                            {
                                "target_lang_word": "тестировать",
                                "target_lang_sense_clarification": "проводить технические испытания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d952d95a-1664-30dd-9fc1-9e52e674ba84",
                    "sense_definition": "poddawać się badaniom diagnostycznym lub testom medycznym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu pacjentów decyduje się regularnie <w>testować</w> się na obecność wirusów.",
                            "target_lang_translations": {
                                "ru": "Многие пациенты решают регулярно <w>тестироваться</w> на наличие вирусов."
                            }
                        },
                        {
                            "text": "Sportowcy muszą <w>testować</w> się przed każdymi zawodami, aby wykluczyć obecność niedozwolonych substancji.",
                            "target_lang_translations": {
                                "ru": "Спортсмены должны <w>проходить проверку</w> перед каждыми соревнованиями, чтобы исключить наличие запрещенных веществ."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprawdzać"
                    ],
                    "common_phrases": [
                        "testować się na obecność",
                        "regularnie się testować"
                    ],
                    "target_lang_definitions": {
                        "ru": "проходить диагностические исследования или медицинские тесты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тестироваться",
                                "target_lang_sense_clarification": "проходить медицинский тест"
                            },
                            {
                                "target_lang_word": "сдавать анализы",
                                "target_lang_sense_clarification": "на наличие вирусов или веществ"
                            },
                            {
                                "target_lang_word": "проходить проверку",
                                "target_lang_sense_clarification": "медицинскую или допинг-контроль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722ad44e-79c2-392a-acee-e9f9bbf43ab3",
                    "sense_definition": "przekazywać majątek komuś w testamencie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Właściciel ziemski postanowił <w>testować</w> cały swój majątek na rzecz lokalnej fundacji.",
                            "target_lang_translations": {
                                "ru": "Землевладелец решил <w>завещать</w> всё своё имущество в пользу местного фонда."
                            }
                        },
                        {
                            "text": "Zgodnie z prawem, można swobodnie <w>testować</w> swoje dobra wybranym spadkobiercom.",
                            "target_lang_translations": {
                                "ru": "Согласно закону, можно свободно <w>отписывать</w> свои блага выбранным наследникам."
                            }
                        }
                    ],
