                    },
                    {
                        "translation_id": "4a4664f5-52a9-4125-a46a-826fc6c08adb",
                        "source_entry_id": "05441821-a632-34d6-850e-99c5f2eda07e",
                        "source_sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                        "source_sense_description": "Medizin: defekte Vene, in der das Blut nicht mehr zurückfließt (meist äußerlich sichtbar)",
                        "target_lang_word": "varice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "varice",
