                        "examples": [
                            {
                                "example_id": "dc1dd2d2-25b0-4f88-80d4-ce01f5a4efa0",
                                "sense_id": "9cccc877-656c-37b6-b2b0-aaacfe45d9ad",
                                "text": "Ze schonk de rode wijn in het grote wijnglas.",
                                "translation": "She poured the red wine into the large wine glass.",
                                "english": "She poured the red wine into the large wine glass."
                            },
                            {
                                "example_id": "eb0f8703-3a6f-4795-831d-eb985e3e8f54",
                                "sense_id": "9cccc877-656c-37b6-b2b0-aaacfe45d9ad",
                                "text": "Hij hief zijn wijnglas en bracht een toost uit op het bruidspaar.",
                                "translation": "He raised his wine glass and proposed a toast to the newlyweds.",
                                "english": "He raised his wine glass and proposed a toast to the newlyweds."
                            },
                            {
                                "example_id": "dd6d661d-6317-4f79-ab82-2c9324f2f393",
                                "sense_id": "9cccc877-656c-37b6-b2b0-aaacfe45d9ad",
                                "text": "De ober bracht nieuwe wijnglazen voor de gasten die wijn wilden drinken.",
                                "translation": "The waiter brought new wine glasses for the guests who wanted to drink wine.",
                                "english": "The waiter brought new wine glasses for the guests who wanted to drink wine."
                            }
                        ]
                    }
