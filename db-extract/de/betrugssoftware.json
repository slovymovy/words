                    {
                        "sense_id": "1976d5a6-fc15-3316-9ac0-a051d88f7535",
                        "entry_id": "a10a9582-0f00-3eb4-b8e7-1503d0a9da1d",
                        "glosses": [
                            "technische Vorrichtung, mit der (besonders bei Fahrzeugmotoren) etwas manipuliert werden kann"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "729679d4-f8c0-4e6b-9c9c-f2cd11751587",
                                "sense_id": "1976d5a6-fc15-3316-9ac0-a051d88f7535",
                                "text": "„Als Chef der Umweltabteilung von VW in den Vereinigten Staaten sei er von seinen Vorgesetzten nicht über die Existenz der später aufgedeckten Betrugssoftware in Dieselmotoren informiert worden.“"
                            },
                            {
                                "example_id": "7860f4a9-a1f8-4d3f-ab77-fc3987266d05",
                                "sense_id": "1976d5a6-fc15-3316-9ac0-a051d88f7535",
                                "text": "„Denn die ‚geforderte Weiterentwicklung‘ der Motorsteuerung werde dazu führen, ‚dass Daten möglicherweise als defeat device (Betrugssoftware) eingesetzt werden‘.“"
                            }
                        ],
