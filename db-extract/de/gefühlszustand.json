                ],
                "senses": [
                    {
                        "sense_id": "c31e8643-19ad-3706-bd04-ce2479ab2ebc",
                        "entry_id": "23bc5564-0a12-358b-b7df-c37ae942d1e2",
                        "glosses": [
                            "Art der Stimmung, des Gemüts, worin sich jemand befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22cc000e-317d-44bb-92b0-7006223f5f9b",
                                "sense_id": "c31e8643-19ad-3706-bd04-ce2479ab2ebc",
                                "text": "„Anschließend ist es wichtig, sich über den Gefühlszustand des Patienten zu erkundigen, seinen Geisteszustand.“"
                            },
                            {
                                "example_id": "db18e98a-fa12-479c-9498-95e7b0d7c059",
                                "sense_id": "c31e8643-19ad-3706-bd04-ce2479ab2ebc",
                                "text": "„Unser ‚aktueller‘ Gefühlszustand ist die reale emotionale Reaktion auf eine bestimmte Situation.“"
                            },
                            {
                                "example_id": "1297e3b3-dfa5-4d14-ba53-0e977fa69bd1",
                                "sense_id": "c31e8643-19ad-3706-bd04-ce2479ab2ebc",
                                "text": "„Um den neuen Weg zu gehen, dürfen wir lernen, auch in schwierigen Zeiten in einem guten Energie- und Gefühlszustand zu sein.“"
                            },
                            {
                                "example_id": "13ec98e7-5026-45f6-91c4-ad3a6cbf2366",
                                "sense_id": "c31e8643-19ad-3706-bd04-ce2479ab2ebc",
                                "text": "„Der internale Gefühlszustand kann sich positiv oder negativ auf die Medikamenteneffekte auswirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
