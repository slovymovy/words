                ],
                "senses": [
                    {
                        "sense_id": "a2829a37-5e83-384b-9051-dbf8eccb95d6",
                        "entry_id": "e044fe0e-0a58-3101-b7c0-b720bce13aa4",
                        "glosses": [
                            "nördlicher Teil des Pazifiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3614658-f14e-415f-bec0-eeb004c44e5a",
                                "sense_id": "a2829a37-5e83-384b-9051-dbf8eccb95d6",
                                "text": "„Bartrobben leben im Nordatlantik und Nordpazifik sowie an den Küsten Europas, Asiens und Amerikas.“"
                            },
                            {
                                "example_id": "cc7025e0-0372-4a54-ba27-f9b29c761529",
                                "sense_id": "a2829a37-5e83-384b-9051-dbf8eccb95d6",
                                "text": "„Im Vorfeld eines japanischen Landungsversuchs auf den Midwayinseln im Nordpazifik erleidet ein japanischer Flottenverband eine vernichtende Niederlage gegen US-amerikanische Seestreitkräfte in einer See-Luftschlacht.“"
                            },
                            {
                                "example_id": "22619d37-b6c9-4d6d-aa43-75da65a6c6e4",
                                "sense_id": "a2829a37-5e83-384b-9051-dbf8eccb95d6",
                                "text": "„Im Nordpazifik treibt ein Müllteppich von der Größe Westeuropas - der sichtbarste Ausdruck eines Problems, das zunehmend die Meere gefährdet.“"
                            },
                            {
                                "example_id": "f89f11c2-cd06-4d16-ade5-465d3ef08386",
                                "sense_id": "a2829a37-5e83-384b-9051-dbf8eccb95d6",
                                "text": "„Die Bestände an Seehunden, Seelöwen und Seeottern gingen im Nordpazifik in den letzten Jahrzehnten stark zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
