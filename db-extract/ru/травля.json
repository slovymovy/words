                                "target_senses": [
                                    {
                                        "sense_id": "56d603d3-a249-3bee-be08-5d5196e8d883",
                                        "entry_id": "9d0888ac-c19a-37cc-a3a9-1413cf9c6852",
                                        "glosses": [
                                            "An act of intimidating a person to do something, especially such repeated coercion."
                                        ],
                                        "tags": [
                                            "countable",
