                "senses": [
                    {
                        "sense_id": "af8536ef-f3d2-3551-b484-6e5e41c258df",
                        "entry_id": "28b22d24-ff8e-3d2f-9d51-8a822b7ba915",
                        "glosses": [
                            "Gerippe von Geflügel und anderen Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a73d8b-3d55-4280-b97a-073fd58e61c1",
                                "sense_id": "af8536ef-f3d2-3551-b484-6e5e41c258df",
                                "text": "Für einen hellen Fond geben Sie die Karkasse zusammen mit Porree, Zwiebeln, Sellerie und Knoblauch in einen Topf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "244aad4d-0050-3069-ab47-2fd91902961b",
                        "entry_id": "28b22d24-ff8e-3d2f-9d51-8a822b7ba915",
                        "glosses": [
                            "tragendes Textil- oder Drahtgewebe von Reifen und Fördergurten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ec0944-0618-4279-8f01-76a188cffccb",
                                "sense_id": "244aad4d-0050-3069-ab47-2fd91902961b",
                                "text": "„Ein weiterer Grund, warum manche Reifen besser rollen als andere, ist die Beschaffenheit der Karkasse, also des eigentlichen Reifenkörpers.”"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b8cdd7cb-463f-36cf-9d0c-690b8b4c011e",
                        "entry_id": "28b22d24-ff8e-3d2f-9d51-8a822b7ba915",
                        "glosses": [
                            "Brandgeschoss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca26a52-7feb-45b3-8358-b2bb4513d43f",
                                "sense_id": "b8cdd7cb-463f-36cf-9d0c-690b8b4c011e",
                                "text": "Die Karkassebestand aus einem eisernen Gerippe und einer Brandsatzfüllung."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc26f5b9-83d0-4a3d-97a4-f8ce6064a11a",
                        "source_entry_id": "28b22d24-ff8e-3d2f-9d51-8a822b7ba915",
                        "source_sense_id": "af8536ef-f3d2-3551-b484-6e5e41c258df",
                        "source_sense_description": "Gerippe von Geflügel und anderen Tieren",
                        "target_lang_word": "carcasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carcasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "246c0523-d34d-3438-9e8a-971d9a023746",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Ossements du corps d’un animal, lorsqu’il n’y a plus guère de chair et qu’ils tiennent encore ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99a4c76-13e7-4083-8b42-66ae7329d97c",
                                                "sense_id": "246c0523-d34d-3438-9e8a-971d9a023746",
                                                "text": "Il ne reste maintenant plus grand chose de sa carcasse blanchie, dispersée par les chacals."
                                            },
                                            {
                                                "example_id": "73379e8f-98b7-4d0d-8b4c-2bbbd4a52618",
                                                "sense_id": "246c0523-d34d-3438-9e8a-971d9a023746",
                                                "text": "Il atteignit une vallée étroite. Prise entre deux collines aux contreforts abrupts, elle faisait penser à une immense carcasse pourrissante, abandonnée là par quelque prédateur monstrueux. Il vit des vautours qui tournoyaient par dizaines dans le ciel lavé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47beb959-89c7-3a83-8858-cce4a5a81df9",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Corps d’un défunt."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb98168-1b0c-412a-a615-7a9954012876",
                                                "sense_id": "47beb959-89c7-3a83-8858-cce4a5a81df9",
                                                "text": "C’est la cloche qui tinte aux murs d’une ville, sous l’horizon, et la carcasse d’un pendu que rougit le soleil couchant."
                                            },
                                            {
                                                "example_id": "e6400e65-016a-49db-9b57-0db1d2162937",
                                                "sense_id": "47beb959-89c7-3a83-8858-cce4a5a81df9",
                                                "text": "Il sera pendu au sommet de ce château de Coningsburg, dans sa chape et son étole ; et, si les escaliers sont trop étroits pour laisser passer son énorme carcasse, je le ferai hisser du dehors au moyen d’une poulie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6377ac3e-e09b-319b-95ab-dcbd61da4cf0",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "La chair et les os d'un animal abattu, dépouillé et vidé , tel qu'il sort de l'abattoir et destiné à la boucherie."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "826c3147-cebc-42a7-b0e6-3683398de322",
                                                "sense_id": "6377ac3e-e09b-319b-95ab-dcbd61da4cf0",
                                                "text": "Les infections subcliniques, révélées uniquement par l’inspection sanitaire des carcasses, ne seraient pas rares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e9aa1a-bfb2-3d38-bb44-ba1ba5e3a623",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Ce qui reste du corps d’une volaille lorsqu’on en a ôté les cuisses et les ailes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fe48d4-eaba-40a8-a824-109fc700f96a",
                                                "sense_id": "32e9aa1a-bfb2-3d38-bb44-ba1ba5e3a623",
                                                "text": "Ce plat est très facile à réaliser et a l'avantage dans ma version personnelle d'utiliser la carcasse du poulet, même si on peut le réaliser avec des morceaux plus nobles."
                                            },
                                            {
                                                "example_id": "f2422144-751d-4ace-a6a6-08322f64889f",
                                                "sense_id": "32e9aa1a-bfb2-3d38-bb44-ba1ba5e3a623",
                                                "text": "Avez-vous déjà pris le temps de décortiquer et déguster une carcasse de canard ? C'est l'occasion, surtout quand c'est la carcasse de canard royal, spécialité de la maison accompagnée de pommes de terre aux cèpes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e5cef24-4b98-35d5-8bf9-152f24e7f3a8",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Personne ou animal d’une extrême maigreur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c515b65b-56f3-48d2-9cde-f3614393fd09",
                                                "sense_id": "9e5cef24-4b98-35d5-8bf9-152f24e7f3a8",
                                                "text": "Puis, s'appuyant sur les accoudoirs de cuir usé, Gérard sortit sa grande carcasse du confortable fauteuil et se redressa."
                                            },
                                            {
                                                "example_id": "6858f496-1b30-4612-b526-4e890fb17359",
                                                "sense_id": "9e5cef24-4b98-35d5-8bf9-152f24e7f3a8",
                                                "text": "Nu, il regarde sa carcasse longiligne, ses muscles secs, tendus sur ses os saillants. Rassuré que ça tienne encore debout."
                                            },
                                            {
                                                "example_id": "92033793-2b77-433d-aa15-79deb616b949",
                                                "sense_id": "9e5cef24-4b98-35d5-8bf9-152f24e7f3a8",
                                                "text": "Le cheval, une grande carcasse blanche, marchait au pas avec une dépense de force extraordinaire, le cou branlant, les jambes hautes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2000857c-cc6d-3b80-8a30-f419f7f3cf07",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Arbre dépouillé de ses feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff9d43e-ea3d-43e5-89d0-47bd3b7163e8",
                                                "sense_id": "2000857c-cc6d-3b80-8a30-f419f7f3cf07",
                                                "text": "Le jardin est si dépouillé que rien ne cache plus l'insignifiance de ce qui est, ici, concédé à l'agrément : les carcasses des charmilles, les bosquets maigres grelottent sous la pluie éternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a948d082-e234-3f2b-bb80-dbb474eb335d",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Navire dont il n’y a encore que la charpente de faite."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8c24919-fe71-4c19-afd3-e358a17f8902",
                                                "sense_id": "a948d082-e234-3f2b-bb80-dbb474eb335d",
                                                "text": "Le chêne croît aussi en Toscane: on en tire le bois le plus estimé en Europe pour la carcasse des bâtiments, car il est très-compacte de sa nature et par conséquent propre à durer longtemps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53476e75-d96f-3d45-bd60-a8bc6bed7509",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Vieux navire en démolition ou bâtiment qui a péri à la côte et que la mer a dépecé en partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a17457-e37a-4aee-a07e-596fdee5264e",
                                                "sense_id": "53476e75-d96f-3d45-bd60-a8bc6bed7509",
                                                "text": "Mais une épave, un reste de carcasse, le tronçon d’un mât, une hune brisée, quelques planches, cela résiste, cela surnage, cela ne peut fondre!"
                                            },
                                            {
                                                "example_id": "56658843-676f-4b66-9437-f3a09f982f5c",
                                                "sense_id": "53476e75-d96f-3d45-bd60-a8bc6bed7509",
                                                "text": "Ce matin-là, nous étions allés avec des bicyclettes à un endroit voisin de Willemstad, et où se trouve une vieille carcasse de bateau. J'ai vu une fois dans la Méditerranée un bateau coulé qui offrait un aspect vraiment romantique. Mais cette vieille carcasse, sur la côte sud de Curaçao, n'est pas autre chose qu'une énorme et laide boîte de fer, qui, couchée entre les récifs de coraux, surgit, avec ses parois rouillées, des eaux assez basses en cet endroit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb149ee-c9da-3abb-87e6-e604f6d1f335",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Véhicule démantelé ou partiellement détruit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b3e114-8a4d-4771-a272-a3804c5d7a81",
                                                "sense_id": "aeb149ee-c9da-3abb-87e6-e604f6d1f335",
                                                "text": "Yvon n'a pas perdu de temps pour dégueulasser le décor. Une carcasse de bagnole, des débris variés s'entassent près de l'ancien puits."
                                            },
                                            {
                                                "example_id": "1aa06344-99ea-4526-a810-4d0956251c25",
                                                "sense_id": "aeb149ee-c9da-3abb-87e6-e604f6d1f335",
                                                "text": "Ce sujet s'avère aussi brûlant qu'une carcasse de Méhari calcinée. Comment se positionner entre angélisme et tout-répressif ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee17d706-3b4f-36e9-8e32-e6b146f271e3",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Plan, armature ou charpente d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed1e379e-4065-49c4-adc4-2cd8b3be4360",
                                                "sense_id": "ee17d706-3b4f-36e9-8e32-e6b146f271e3",
                                                "text": "La pièce lança deux obus avant que la carcasse de l’immeuble se disloquât, […]."
                                            },
                                            {
                                                "example_id": "45c3163b-c8b6-4728-ad23-dfedc65b778a",
                                                "sense_id": "ee17d706-3b4f-36e9-8e32-e6b146f271e3",
                                                "text": "Le chef de bande fumait une cigarette […]. Les autres sniffaient de la colle à l'ombre des carcasses de frigo."
                                            },
                                            {
                                                "example_id": "96d565c6-d6c7-4fd4-9a10-b7940bf33703",
                                                "sense_id": "ee17d706-3b4f-36e9-8e32-e6b146f271e3",
                                                "text": "Aurai-je du succès pour la défense comme j’en ai eu pour l’attaque ? […]. Mon fils et le petit Coffe me feront les carcasses de mes discours de défense… Tout cela peut être fort plat, je crois bien… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2153b472-8753-31e4-aeb1-ac1af66c4aa0",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Plan, armature ou charpente d’une chose.",
                                            "Fers intérieurs d’un édifice, d’une machine, d’un moule, d’un modèle, d’une pièce d’artifice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08d4ef04-cf8c-35f8-8084-efca0ba8e76f",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Plan, armature ou charpente d’une chose.",
                                            "Branches de fil de fer couvertes de cordonnet dont les modistes se servent pour monter les chapeaux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0363a76b-2a8c-433b-be46-a5d99c9f4b07",
                                                "sense_id": "08d4ef04-cf8c-35f8-8084-efca0ba8e76f",
                                                "text": "Cette carcasse est comme une charpente sur laquelle on applique une sorte de calotte en peluche de soie ou de coton, et dont les pièces, cousues très proprement ensemble , ont exactement les mêmes proportions que la carcasse sur laquelle on doit les coller, - Il y a de ces sortes de chapeaux dont la carcasse est en carton verni ; ils sont d'un assez bon usage, eu égard à la modicité de leur prix (5 francs et même au-dessous )."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0118736a-11be-3ae1-8150-df6345ad9786",
                                        "entry_id": "782bcbb2-c912-3fda-988b-8dc711ef4ecb",
                                        "glosses": [
                                            "Corps humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e78248-8b23-4c12-9e6a-0ba04adad020",
                                                "sense_id": "0118736a-11be-3ae1-8150-df6345ad9786",
                                                "text": "« Tu trembles, carcasse, mais tu tremblerais bien davantage si tu savais où je vais te mener ! » (mot attribué à Turenne, 1667)"
                                            },
                                            {
                                                "example_id": "c6539f23-416b-437a-a071-50478d4e6e11",
                                                "sense_id": "0118736a-11be-3ae1-8150-df6345ad9786",
                                                "text": "Il nous a été impossible d’ignorer ce que nous valions devant la mort. Nous n’avons pu l’oublier depuis, mais il ne se peut pas que les moins réfléchis, plusieurs fois, n’en aient eu la révélation subite. Ils ont su ce que contenait leur carcasse."
                                            },
                                            {
                                                "example_id": "377ced62-1bd5-4e98-ba82-0c7c4ec3878e",
                                                "sense_id": "0118736a-11be-3ae1-8150-df6345ad9786",
                                                "text": "Cette grande carcasse, hier encore veule, inerte, vide, combien elle était soudain devenue sensible, maniable !"
                                            },
                                            {
                                                "example_id": "e8f64429-1bfd-4ffb-8d6c-ea2d7a5ba8c9",
                                                "sense_id": "0118736a-11be-3ae1-8150-df6345ad9786",
                                                "text": "Plus petit que son jeune subordonné, il était puissant comme un taureau et sa carcasse ne se décatissait que lentement et à contrecœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59061879-8a34-4043-bb66-607c46ba2a5b",
                        "source_entry_id": "28b22d24-ff8e-3d2f-9d51-8a822b7ba915",
                        "source_sense_id": "244aad4d-0050-3069-ab47-2fd91902961b",
                        "source_sense_description": "tragendes Textil- oder Drahtgewebe von Reifen und Fördergurten",
                        "target_lang_word": "carcass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carcass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a dead animal, especially a vertebrate or other animal having flesh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d96aa1d-d02b-4531-b84c-ec70c3d37899",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "The forest was covered in dog carcass."
                                            },
                                            {
                                                "example_id": "0340f0de-6529-4e18-bd3f-687ed076c69f",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "Plate 31, figure B shows a desiccated carcass in the ventral position with a sharp S curvature in the vertebral column. Such pronounced drying-out of a carcass probably happens only when it is quickly carried to a dry place and exposed to the strong rays of the sun."
                                            },
                                            {
                                                "example_id": "2fead4c5-11dd-406e-a03f-eaa74f173faa",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "Despite all of the groups' experiences with leopards and carcasses in trees, neither the vervets nor the baboons gave alarm calls at the sight of the carcass alone."
                                            },
                                            {
                                                "example_id": "df8bed54-2fd6-4a7c-9c2f-5680895c11c8",
                                                "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                                                "text": "Instead, the majority of studies involve freezing the carcasses until time permits the analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a slaughtered animal, stripped of unwanted viscera, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9c91a7-7c40-41d6-aeaa-b714c7c60bf6",
                                                "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                                "text": "1961, D. M. Doty, John C. Pierce, Beef Muscle Characteristics as Related to Carcass Grade, Carcass Weight, and Degree of Aging, US Department of Agriculture, Technical Bulletin No. 1231, page 33,\nLean flavor scores for this muscle were lower than those for ribeye, especially in Prime grade carcasses."
                                            },
                                            {
                                                "example_id": "a537770b-1ca7-4355-9c29-6dde866505ea",
                                                "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                                "text": "The most important is the carcass but the liver, kidneys and, to a limited extent, various other visceral components also have value as food items.[…]For example, the carcasses from sheep and cattle have the head removed immediately after slaughter but in pigs this may be delayed until after chilling and further butchery."
                                            },
                                            {
                                                "example_id": "85b75246-9de0-4e29-9ced-1133e326fe24",
                                                "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                                                "text": "In some countries, there is still a significant trade in chicken carcasses that have been plucked, but not eviscerated, by the producer. Subsequently, the carcass may be eviscerated by a butcher or in the kitchen of the consumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a dead human, a corpse or cadaver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4415586-ea74-4a15-8e86-56de9e3b9729",
                                                "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                                "text": "He saw a human carcass while digging a hole and ran away screaming."
                                            },
                                            {
                                                "example_id": "87050c0f-2b9a-4b89-b440-c9db5bc3b77f",
                                                "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                                "text": "And when their ſcattered armie is ſubdu’d: / And you march on their ſlaughtered carkaſſes, / Share equally the gold that bought their liues, / And liue like Gentlmen in Perſea, […]"
                                            },
                                            {
                                                "example_id": "38f5d4ff-6e02-4530-92e3-b05c6843c3e1",
                                                "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                                                "text": "And the carkeiſes of this people ſhall be meate for the fowles of the heauen, and for the beaſts of the earth, and none ſhall fray them away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The body of a live person or animal."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b443fa92-2c0c-457a-a520-28aabcce420b",
                                                "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                                                "text": "A Churliſh Envious Curr vvas gotten into a Manger, and there lay Growling and Snarling to keep the Horſes from their Provender. The Dog Eat None himſelf, and yet rather Ventur'd the Starving his Own Carcaſe then he would ſuffer any thing elfe to be the Better for't."
                                            },
                                            {
                                                "example_id": "59b5ea8a-f524-4ccd-97fa-f49f124bdc4c",
                                                "sense_id": "64950bad-20b0-39c9-9ffc-5b6cfc96b036",
                                                "text": "\"If you saw the care she takes over hoisting her beastly old carcass up and down those stairs, you could make a sure bet against her having another accident there.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d5d1cf-7a3a-3ac4-a838-354b28e06d8b",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "The framework of a structure, especially one not normally seen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38573fec-9b5a-4328-b0a1-0540a4f969b3",
                                                "sense_id": "97d5d1cf-7a3a-3ac4-a838-354b28e06d8b",
                                                "text": "The tyres used on DC-8s have a tread portion that contains three fabric re-enforcing layers. These layers protect the tyre carcass to some extent against foreign object damage. A tyre tread, however, does not contribute to the carcass integrity^([sic]); even when a tyre is worn to the third fabric layer, the normal change point, it does not lose any structural integrity. The mandatory change point for a tyre is when it is worn to the carcass layer; however, at this point, the tyre could not undergo a retread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e688647f-9e06-3784-b020-18af21f5a9aa",
                                        "entry_id": "83b9f987-08c4-3a0e-af32-fbe3f543754d",
                                        "glosses": [
                                            "An early incendiary ship-to-ship projectile consisting of an iron shell filled with saltpetre, sulphur, resin, turpentine, antimony and tallow with vents for flame."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9beb45b7-2677-4094-8a58-a398024b7bca",
                        "source_entry_id": "28b22d24-ff8e-3d2f-9d51-8a822b7ba915",
                        "source_sense_id": "244aad4d-0050-3069-ab47-2fd91902961b",
                        "source_sense_description": "tragendes Textil- oder Drahtgewebe von Reifen und Fördergurten",
                        "target_lang_word": "carcase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carcase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                        "entry_id": "b646f8bb-6b1f-32c7-bbc4-0cca5f05e764",
                                        "glosses": [
                                            "Alternative form of carcass."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42b46f6-f532-4b0a-86a6-1c7711abe836",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "Oꝛ if a ſoule touch any vncleane thing, whether it be a carcaſe of an vncleane beaſt, oꝛ a carcaſe of vncleane cattell, oꝛ the carcaſe of vncleane creeping things, and if it be hidden from him, he alſo ſhall be vncleane, and guilty: […]"
                                            },
                                            {
                                                "example_id": "ef426c6d-7579-4c42-b968-a280d4771801",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "So he took for him all these and divided them in halves and placed the halves opposite to one another, but the birds he did not divide; but the birds alighted on the carcases, on the two halves of them, and Abram sat down with them."
                                            },
                                            {
                                                "example_id": "479f78c8-65da-4e8a-940e-c28ec3fc082a",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "But sometimes, especially upon the Line in the Pacific, this plan will not answer at all; because such incalculable hosts of sharks gather round the moored carcase, that were he left so for six hours, say, on a stretch, little more than the skeleton would be visible by morning."
                                            },
                                            {
                                                "example_id": "c93f62bb-7d9e-4ab8-98ac-0092eacf8ed3",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "Silence has sometimes a remarkable power of showing itself as the disembodied soul of feeling wandering without its carcase, and it is then more impressive than speech."
                                            },
                                            {
                                                "example_id": "66454ca9-f367-4e7d-a0c3-57f4390cd070",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "I’m wonderin’ what Sidoli will do when she gets close to him. I bet he knows a trick or two. He’ll probably grab her an’ hold her in front of his measley carcase."
                                            },
                                            {
                                                "example_id": "5b27b3d9-9000-4f03-a878-c6f32fe1e40f",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "Pilton Yard, the Lynton & Barnstaple headquarters, has been taken over by a fur trading firm, and would-be trespassers to the old engine-shed are turned back by the pungent odour of heaps of carcases."
                                            },
                                            {
                                                "example_id": "375f6989-2761-4463-adb5-df7ebd1081da",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "2005, N. M. Fogerty, V. Ingham, L. McLeod, G. Gaunt, L. Cummins, Variation among maternal sires for lamb and wool gross margin performance of their crossbred daughters, Association for the Advancement of Breeding Genetics, Proceedings of the 16th Conference: Application of New Genetic Technologies to Animal Breeding, page 61,\nIn each year lambs were weaned at 3 months and slaughtered as a group at a target average carcase weight of 22kg."
                                            },
                                            {
                                                "example_id": "2942f42b-4621-40c7-923f-227dead6a1a8",
                                                "sense_id": "2daf3166-a921-378d-8086-1e3fb5104482",
                                                "text": "Also, scribe lines across the side panels to locate the dado for the bottom piece of the carcase."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
