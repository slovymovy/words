                "translations": [
                    {
                        "translation_id": "92cba9e7-bfc8-477d-ad3e-fe193c1bb348",
                        "source_entry_id": "c5a5be1a-6fc8-394f-9b5a-86b97e4a282c",
                        "source_sense_id": "d46f04e8-7a17-3a21-8f50-37f364e948be",
                        "source_sense_description": "een boeket",
                        "target_lang_word": "Blumenstrauß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blumenstrauß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8111bdb3-0829-37d5-9410-6a6b382b200a",
                                        "entry_id": "7634da5a-02a0-3219-aa6e-c12662c36f5e",
                                        "glosses": [
                                            "eine Zusammenstellung mehrerer Schnittblumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32144544-175c-4454-a518-4d12f8dfd428",
                                                "sense_id": "8111bdb3-0829-37d5-9410-6a6b382b200a",
                                                "text": "Sie ließ sich scheiden, weil er ihr seit zwanzig Jahren keinen Blumenstrauß mehr geschenkt hatte."
                                            },
                                            {
                                                "example_id": "52c59ca4-d063-434a-b735-2d138b2540b8",
                                                "sense_id": "8111bdb3-0829-37d5-9410-6a6b382b200a",
                                                "text": "„Der Blumenstrauß ist aus dem Alltag heute nicht mehr wegzudenken.“"
                                            },
                                            {
                                                "example_id": "8befcfc3-df96-49b5-a573-52a4ea488ca3",
                                                "sense_id": "8111bdb3-0829-37d5-9410-6a6b382b200a",
                                                "text": "„Ich bin der junge Kellner, der ihr Blumensträuße schickt.“"
                                            },
                                            {
                                                "example_id": "66f01dc9-42e0-4058-a40a-07b34e648bd9",
                                                "sense_id": "8111bdb3-0829-37d5-9410-6a6b382b200a",
                                                "text": "„Im Abschnitt zwischen den Grabreihen befindet sich ein Holzkreuz, an das ein Blumenstrauß gelehnt ist.“"
                                            },
                                            {
                                                "example_id": "f44cb5df-6038-4a78-b144-39686d89e573",
                                                "sense_id": "8111bdb3-0829-37d5-9410-6a6b382b200a",
                                                "text": "„Kurz bevor es passiert sein muss, kurz bevor er, der größte Zyniker von allen, mit einem Blumenstrauß vor der Wohnungstür ihrer Eltern stand und sie ihm mit zittrigen Händen Tee servierte, hatten wir uns gestritten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4b5fc1f-df31-40e3-815e-98d47a6a8f20",
                        "source_entry_id": "c5a5be1a-6fc8-394f-9b5a-86b97e4a282c",
