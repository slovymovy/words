                "senses": [
                    {
                        "sense_id": "09064495-79d7-3429-be1c-f4a841389a87",
                        "entry_id": "9a0e3630-42c3-3f7d-860e-4788a9a382cc",
                        "glosses": [
                            "charakteryzujący się dysfunkcją, nieprzystosowany do pełnienia określonych funkcji lub pełniący je nieprawidłowo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba86a6f-8381-4a6a-97e8-12f1ed8edd0c",
                                "sense_id": "09064495-79d7-3429-be1c-f4a841389a87",
                                "text": "(…) wspieranie rozwoju dziecka z rodziny dysfunkcyjnej trzeba wzbogacić poprzez podejmowanie czynności społecznych zorientowanych na tworzenie instytucji, które prowadziłyby działania socjalne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d940706-a574-44c3-bccb-f68dd1b6417c",
                        "source_entry_id": "9a0e3630-42c3-3f7d-860e-4788a9a382cc",
                        "source_sense_id": "09064495-79d7-3429-be1c-f4a841389a87",
                        "target_lang_word": "dysfunctional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysfunctional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa4f9f8-1608-32c0-94db-cf5e6fbe2c72",
                                        "entry_id": "77de96fa-9a5e-3e2f-b373-a1095d84875d",
                                        "glosses": [
                                            "Not performing its proper or intended function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3834ef78-d60f-34bc-81c3-90b5df07e668",
                                        "entry_id": "77de96fa-9a5e-3e2f-b373-a1095d84875d",
                                        "glosses": [
                                            "Functioning incorrectly or abnormally; especially, designating of a business, family or social group with harmful, aberrant, strange or abnormal behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce71c4d8-54b1-414b-b786-3f3114681c30",
                                                "sense_id": "3834ef78-d60f-34bc-81c3-90b5df07e668",
                                                "text": "Never trust in the partly unscrupulous and partly dysfunctional state apparatus."
                                            },
                                            {
                                                "example_id": "cdd9c44e-38a7-45b4-86da-daef03ce8ce0",
                                                "sense_id": "3834ef78-d60f-34bc-81c3-90b5df07e668",
                                                "text": "A former chief of staff of the Israel Defence Forces said that Netanyahu should “resign now”, while a former intelligence official described the government as “dysfunctional”."
                                            },
                                            {
                                                "example_id": "8bf0c8fe-6254-4cfa-b1d6-60f6ac0fa681",
                                                "sense_id": "3834ef78-d60f-34bc-81c3-90b5df07e668",
                                                "text": "It is difficult to find the right words for what has happened in the five years since the May 2018 timetable changes exposed the very dysfunctional nature of the franchise system set up by the privatisation process of the 1990s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5386bcf-9055-46a1-a19e-f41a5d8afc09",
                        "source_entry_id": "9a0e3630-42c3-3f7d-860e-4788a9a382cc",
                        "source_sense_id": "09064495-79d7-3429-be1c-f4a841389a87",
                        "target_lang_word": "dysfonctionnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysfonctionnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                                        "entry_id": "bdf7145d-8143-353d-9d00-b80170905ab0",
                                        "glosses": [
                                            "Qui a un fonctionnement troublé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affe5ccf-cfc4-4b9d-a8c1-95a7d275da9f",
                                                "sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                                                "text": "Le BIXI, en effet, est non seulement le symbole urbain par excellence, c’est aussi celui des rapports dysfonctionnels qu’entretiennent Québec et Montréal."
                                            },
                                            {
                                                "example_id": "8a48aa4e-13b3-4c4f-861b-409938da3ffb",
                                                "sense_id": "d2969638-6fff-3d5b-9376-b5272ae5f8b2",
                                                "text": "L’apport de Freud à la psychiatrie a été, notamment, de montrer que névrose et psychose ne définissent pas des anormaux, mais des êtres qui ont tenté de trouver des solutions - certes dysfonctionnelles -, à des problèmes profondément humain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32688444-40ed-41d1-958e-cf4d22b0e461",
                        "source_entry_id": "9a0e3630-42c3-3f7d-860e-4788a9a382cc",
                        "source_sense_id": "09064495-79d7-3429-be1c-f4a841389a87",
