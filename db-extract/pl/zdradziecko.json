                                        "glosses": [
                                            "In a traitorous manner; treacherously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "755fecea-5426-4ba4-b3ac-6b80e9e835f7",
                                                "sense_id": "5e365322-300e-301a-a88a-6c0e48dabc32",
                                                "text": "The vizier traitorously revealed the location of the hiding princess in order to save himself."
                                            }
