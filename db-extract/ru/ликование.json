                "senses": [
                    {
                        "sense_id": "fa56b384-6a78-30c8-b62e-fd26162a1a0b",
                        "entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                        "glosses": [
                            "действие по значению гл. ликовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e07dd5-95a8-4f4e-b425-447e419fd808",
                                "sense_id": "fa56b384-6a78-30c8-b62e-fd26162a1a0b",
                                "text": "Старший же сын его был на поле; и, возвращаясь, когда приблизился к дому, услышал пение и ликование …"
                            }
                        ]
                    },
                    {
                        "sense_id": "3633b4e5-5d2e-3b1c-8496-fa055af20e6b",
                        "entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                        "glosses": [
                            "результат такого действия"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffa479af-2d82-4bbc-9fa8-2b05707b25ed",
                        "source_entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                        "source_sense_description": "действие по значению гл. ликовать",
                        "target_lang_word": "exultation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exultation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c33b661e-0393-385f-8841-039967ee1eff",
                                        "entry_id": "3e47d104-8d15-38bb-9ea5-e87a13bc64e5",
                                        "glosses": [
                                            "The act of exulting; great joy at success or victory, or at any advantage gained; rapturous delight"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0cefead-8151-443f-a25d-9d1de1fca1e1",
                                                "sense_id": "c33b661e-0393-385f-8841-039967ee1eff",
                                                "text": "Strange that this idea carried with it something of exultation! so much does the pride of man rejoice in aught that marks him from his fellows, and little does it seem to matter whether that mark be for good or for evil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e32435d8-fec4-454d-bacf-d00ec0a577fa",
                        "source_entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                        "source_sense_description": "действие по значению гл. ликовать",
                        "target_lang_word": "jubilation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubilation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                                        "entry_id": "4dab03cc-bbcf-305d-9c48-3dc89d7ba382",
                                        "glosses": [
                                            "A triumphant shouting; rejoicing; exultation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b94fa1-d769-42a9-bb2b-b04adb0d526f",
                                                "sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                                                "text": "The final whistle triggered scenes of wild jubilation at Eden Park as a nation celebrated a repeat of the outcome from the very first World Cup final in 1987."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99e8c007-076f-430a-86bb-aadb85badea4",
                        "source_entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                        "source_sense_description": "действие по значению гл. ликовать",
                        "target_lang_word": "giubilazione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "giubilazione",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "0d590002-d684-3569-a18d-18628afd7208",
                                        "entry_id": "9314cbee-ff1a-32fc-b5f4-4c78eaf63411",
                                        "glosses": [
                                            "l'atto con cui si manda a riposo, con diritto alla pensione, un funzionario o con cui gli si conferisce una carica squisitamente rappresentativa dopo averlo esonerato da un impiego di responsabilità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa1cee8-d191-479f-bf00-11f3d3e1654f",
                                                "sense_id": "0d590002-d684-3569-a18d-18628afd7208",
                                                "text": "\"Mi sono anche chiesto, chissà se Longstaff lo sapeva, quando inviò quella lettera, che era ormai vicino alla giubilazione. Eh?\"\n\"Non posso crederci\" dissi io. \"Longstaff sarà magari malizioso, ma meschino no di certo.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "651dfe58-a3fe-3b90-bf0a-7ee4362996f2",
                                        "entry_id": "9314cbee-ff1a-32fc-b5f4-4c78eaf63411",
                                        "glosses": [
                                            "atteggiamento o sensazione di giubilo"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d08f5c57-6fec-4386-a1d4-a12c60d54414",
                        "source_entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                        "source_sense_description": "действие по значению гл. ликовать",
                        "target_lang_word": "jubilation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubilation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddcf40f3-066f-3374-bf94-71f5348a2240",
                                        "entry_id": "04d70add-6699-3abd-945c-eb1de035c9fa",
                                        "glosses": [
                                            "Réjouissance, joie expansive."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4733816-6093-4266-8af3-4786fa66cf97",
                                                "sense_id": "ddcf40f3-066f-3374-bf94-71f5348a2240",
                                                "text": "[…] : il attendait, près du portant de gauche, le moment de se diriger du pas d'un homme qui rêve dans la direction de Jimmy, son partenaire, dont la mimique exprimait aussitôt une singulière jubilation."
                                            },
                                            {
                                                "example_id": "c82443c7-3ccc-43c7-9595-6ab5adc7e450",
                                                "sense_id": "ddcf40f3-066f-3374-bf94-71f5348a2240",
                                                "text": "Puis, il se renversa sur sa chaise, épanoui, les prunelles chargées de jubilation, le ventre ballotté de remous."
                                            },
                                            {
                                                "example_id": "36b6575a-cbe6-49c9-b54c-86bc6d8919ca",
                                                "sense_id": "ddcf40f3-066f-3374-bf94-71f5348a2240",
                                                "text": "J’éprouvais une jubilation intellectuelle quasi-permanente, cette forme de jouissance en vérité supérieure à toutes les autres et qui, fort heureusement, nous reste accessible jusqu’au bout de la vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
