{
    "word_family": [
        "binder",
        "binding",
        "unbound",
        "rebind",
        "bookbinding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da143cea-4c5d-3ca1-b856-cb0aaccc9d6d",
                    "sense_definition": "To tie or fasten something tightly with a rope, string, or band so that it cannot move or separate.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The robbers <bound> the guard to the chair with strong rope.",
                            "target_lang_translations": {
                                "ru": "Грабители <привязали> охранника к стулу крепкой веревкой.",
                                "zh": "强盗用粗绳子把警卫<w>捆</w>在椅子上。"
                            }
                        },
                        {
                            "text": "Please <bind> these sticks together so they are easier to carry.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <свяжи> эти палки вместе, чтобы их было легче нести.",
                                "zh": "请把这些棍子<w>捆</w>在一起，这样更容易携带。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tie",
                        "fasten",
                        "secure",
                        "strap"
                    ],
                    "antonyms": [
                        "untie",
                        "release",
                        "loosen",
                        "unbind"
                    ],
                    "common_phrases": [
                        "bind together",
                        "bind hand and foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко связывать или скреплять что-либо веревкой, лентой или другим материалом, чтобы оно не могло двигаться или распадаться.",
                        "zh": "用绳子、带子等将某物紧紧捆住或固定，使其无法移动或散开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "скреплять веревкой"
                            },
                            {
                                "target_lang_word": "связать",
                                "target_lang_sense_clarification": "скрепить узлом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捆绑",
                                "target_lang_sense_clarification": "用绳索固定"
                            },
                            {
                                "target_lang_word": "系",
                                "target_lang_sense_clarification": "用绳子连接或固定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21561b2b-872b-38e9-84a5-4718d3890fd5",
                    "sense_definition": "To fasten the pages of a book together and put them inside a cover.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher decided to <bind> the special edition in leather.",
                            "target_lang_translations": {
                                "ru": "Издатель решил <переплести> специальное издание в кожу.",
                                "zh": "出版商决定用皮革<w>装订</w>这本特别版。"
                            }
                        },
                        {
                            "text": "They <bound> the report with a simple plastic cover to keep it organized.",
                            "target_lang_translations": {
                                "ru": "Они <переплели> отчет в простую пластиковую обложку, чтобы держать его в порядке.",
                                "zh": "他们用简单的塑料封皮把报告<w>装订</w>好，以便整理。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiral bound",
                        "leather bound",
                        "hard bound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скреплять страницы книги вместе и помещать их в обложку.",
                        "zh": "将书页装订在一起并加上封面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переплетать",
                                "target_lang_sense_clarification": "книги"
                            },
                            {
                                "target_lang_word": "переплести",
                                "target_lang_sense_clarification": "сделать переплет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装订",
                                "target_lang_sense_clarification": "书籍制作工艺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5c446c2-c2b7-3933-895b-73216de13b53",
                    "sense_definition": "To force someone to do something because of a law, promise, duty, or agreement.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract <binds> the company to pay the employees on time.",
                            "target_lang_translations": {
                                "ru": "Контракт <обязывает> компанию выплачивать зарплату сотрудникам вовремя.",
                                "zh": "合同<w>约束</w>公司必须按时向员工支付工资。"
                            }
                        },
                        {
                            "text": "I feel <bound> by my promise to help him finish the project.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя <связанным> обещанием помочь ему закончить проект.",
                                "zh": "我感到受承诺的<w>约束</w>，必须帮他完成这个项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obligate",
                        "compel",
                        "require"
                    ],
                    "antonyms": [
                        "free",
                        "exempt"
                    ],
                    "common_phrases": [
                        "legally binding",
                        "bound by law",
                        "bind to secrecy",
                        "bound by duty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принуждать кого-либо к действию законом, обещанием, долгом или соглашением.",
                        "zh": "因法律、承诺、职责或协议而强制某人履行义务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязывать",
                                "target_lang_sense_clarification": "принуждать"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "ограничивать свободу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "约束",
                                "target_lang_sense_clarification": "限制行为"
                            },
                            {
                                "target_lang_word": "有义务",
                                "target_lang_sense_clarification": "受责任限制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5e7aa3f-1699-326b-91ff-c0ef1a4a60fc",
                    "sense_definition": "To wrap a long piece of cloth around a body part to protect, support, or cover a wound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor had to <bind> the broken leg to keep it straight.",
                            "target_lang_translations": {
                                "ru": "Врачу пришлось <зафиксировать> сломанную ногу, чтобы она оставалась прямой.",
                                "zh": "医生必须把骨折的腿<w>包扎</w>好以保持平直。"
                            }
                        },
                        {
                            "text": "She gently <bound> the cut with a clean cloth to stop the bleeding.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <перевязала> порез чистой тканью, чтобы остановить кровотечение.",
                                "zh": "她用干净的布轻轻地<w>包扎</w>伤口以止血。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bandage",
                        "dress",
                        "swathe"
                    ],
                    "common_phrases": [
                        "bind up a wound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обматывать часть тела длинным куском ткани для защиты, поддержки или закрытия раны.",
                        "zh": "用长布条缠绕身体部位以保护、支撑或覆盖伤口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевязывать",
                                "target_lang_sense_clarification": "рану"
                            },
                            {
                                "target_lang_word": "бинтовать",
                                "target_lang_sense_clarification": "накладывать повязку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包扎",
                                "target_lang_sense_clarification": "处理伤口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d798dd-623e-3840-af70-6c3f777c9b94",
                    "sense_definition": "To stick together or cause to stick together in a solid mass, often used in cooking or chemistry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cohesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should add an egg to the mixture to help <bind> the ingredients.",
                            "target_lang_translations": {
                                "ru": "Вам следует добавить в смесь яйцо, чтобы <связать> ингредиенты.",
                                "zh": "你应该在混合物里加个鸡蛋，帮助把配料<w>粘合</w>在一起。"
                            }
                        },
                        {
                            "text": "The sauce will <bind> the vegetables together into a rich filling.",
                            "target_lang_translations": {
                                "ru": "Соус <свяжет> овощи вместе в густую начинку.",
                                "zh": "酱汁会把蔬菜<w>粘合</w>在一起，做成浓郁的馅料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "cohere"
                    ],
                    "common_phrases": [
                        "binding agent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склеивать или заставлять слипаться в плотную массу, часто используется в кулинарии или химии.",
                        "zh": "使物质粘合在一起形成固体块，常用于烹饪或化学。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "соединять компоненты"
                            },
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "соединять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘合",
                                "target_lang_sense_clarification": "使物质结合"
                            },
                            {
                                "target_lang_word": "凝结",
                                "target_lang_sense_clarification": "形成整体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "505e7860-07bd-3220-affc-1e7d9e4b0cb8",
                    "sense_definition": "A difficult or annoying situation that is hard to escape from.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Losing his wallet put him in a real <bind> while traveling abroad.",
                            "target_lang_translations": {
                                "ru": "Потеря кошелька поставила его в действительно <затруднительное положение> во время поездки за границу.",
                                "zh": "在国外旅行时丢了钱包，让他陷入了真正的<w>困境</w>。"
                            }
                        },
                        {
                            "text": "We are in a bit of a <bind> regarding the schedule for next week.",
                            "target_lang_translations": {
                                "ru": "У нас небольшое <затруднение> с расписанием на следующую неделю.",
                                "zh": "关于下周的日程安排，我们遇到了一点<w>窘境</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "predicament",
                        "dilemma",
                        "fix",
                        "jam",
                        "pickle"
                    ],
                    "common_phrases": [
                        "in a bind",
                        "in a real bind"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in the phrase 'in a bind'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная или неприятная ситуация, из которой сложно выбраться.",
                        "zh": "难以摆脱的困境或麻烦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затруднительное положение",
                                "target_lang_sense_clarification": "ситуация"
                            },
                            {
                                "target_lang_word": "тупик",
                                "target_lang_sense_clarification": "безвыходность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "艰难处境"
                            },
                            {
                                "target_lang_word": "窘境",
                                "target_lang_sense_clarification": "尴尬或困难的局面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}