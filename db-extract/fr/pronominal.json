                "senses": [
                    {
                        "sense_id": "99175696-1822-3a1b-a1cd-16a2011d4278",
                        "entry_id": "736474a2-f529-3bed-878e-bdbbfab864fb",
                        "glosses": [
                            "Relatif au pronom, qui est de la nature du pronom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda9be12-3d72-4afb-a3af-b69a5c0f12df",
                                "sense_id": "99175696-1822-3a1b-a1cd-16a2011d4278",
                                "text": "Verbe pronominal."
                            },
                            {
                                "example_id": "442cde3b-ea82-4e29-a194-118657b68f93",
                                "sense_id": "99175696-1822-3a1b-a1cd-16a2011d4278",
                                "text": "Le Premier ministre le déclare sans ambages : «Nous avons concerté. Concerter, ce n’est pas négocier.» La franchise d’Edouard Philippe est d’autant plus éloquente qu’il rompt avec l’usage pronominal du verbe par cet emploi… absolu."
                            },
                            {
                                "example_id": "61e85826-e629-4dec-83dc-75c9e22d4158",
                                "sense_id": "99175696-1822-3a1b-a1cd-16a2011d4278",
                                "text": "Mais il y a des règles beaucoup plus difficiles que seuls les spécialistes maîtrisent, comme l'accord du participe passé de verbes pronominaux suivis d'un infinitif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f24a92df-04ba-47b2-a0de-fc667caa92b5",
                        "source_entry_id": "736474a2-f529-3bed-878e-bdbbfab864fb",
                        "source_sense_id": "99175696-1822-3a1b-a1cd-16a2011d4278",
                        "target_lang_word": "reflexiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflexiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d33530-d9fc-3113-b3a5-3e099eea951b",
                                        "entry_id": "2318100b-70da-3c0f-8132-caad537824fa",
                                        "glosses": [
                                            "rückbezüglich auf das Subjekt"
                                        ],
                                        "tags": [
                                            "in Bezug auf ein Verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3be0e37-0ade-4cc4-97c4-d828d7bdcd93",
                                                "sense_id": "e8d33530-d9fc-3113-b3a5-3e099eea951b",
                                                "text": "Folgende Verben sind zum Beispiel rein reflexiv: „sich erholen“, „sich freuen“, „sich schämen“, „sich wundern“."
                                            },
                                            {
                                                "example_id": "e0051d2f-fc30-485d-8248-12d2590cb8e7",
                                                "sense_id": "e8d33530-d9fc-3113-b3a5-3e099eea951b",
                                                "text": "Transitive Verben können oft auch reflexiv gebraucht werden: „töten“ – „sich töten“."
                                            },
                                            {
                                                "example_id": "c6ca88be-4943-4263-a61d-1bf2e554863c",
                                                "sense_id": "e8d33530-d9fc-3113-b3a5-3e099eea951b",
                                                "text": "Transitive Verben erhalten durch reflexiven Gebrauch oft eine andere Bedeutung: „zusammennehmen“ – „sich zusammennehmen“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "348405fc-b6e2-3bcc-af2c-b4e26075936c",
                                        "entry_id": "2318100b-70da-3c0f-8132-caad537824fa",
                                        "glosses": [
                                            "für jedes x∈A das Tupel (x,x) enthaltend"
                                        ],
                                        "tags": [
                                            "von zweistelligen Relationen auf einer Menge A"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04967675-f1fa-4f1a-916c-9453f1a921dd",
                                                "sense_id": "348405fc-b6e2-3bcc-af2c-b4e26075936c",
                                                "text": "„Die gewöhnliche Gleichheit = auf den reellen Zahlen ist reflexiv, da stets x=x gilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
