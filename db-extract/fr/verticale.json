                        ],
                        "examples": [
                            {
                                "example_id": "d857d6f6-1b3f-442e-930c-bf0733e1d533",
                                "sense_id": "cc7b350d-9020-3e2b-8ef2-6a29c0d283ff",
                                "text": "La calme et verticale chute de neige devenait oblique, un faible ronflement de mer lointaine se levait sur ma tête encapuchonnée, tandis que j’arpentais le jardin, happant la neige volante..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5080265a-eccb-44d1-8134-69827aeb7218",
                        "source_entry_id": "cacf93d2-bb31-3e14-b10e-3135957a515b",
                        "source_sense_id": "cc7b350d-9020-3e2b-8ef2-6a29c0d283ff",
                        "target_lang_word": "lotrecht",
