                "senses": [
                    {
                        "sense_id": "84c72426-889c-3220-a02f-5355351a250c",
                        "entry_id": "5c424f17-c048-3912-829e-588a022657f8",
                        "glosses": [
                            "Bahre, auf der man jemanden tragen/transportieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c5dbc8-09f6-432b-937a-d4c0c9889732",
                                "sense_id": "84c72426-889c-3220-a02f-5355351a250c",
                                "text": "„Ich liege auf einer Tragbahre.“"
                            },
                            {
                                "example_id": "287f9672-c193-4d36-b0a3-f10d8c144d27",
                                "sense_id": "84c72426-889c-3220-a02f-5355351a250c",
                                "text": "„Rostow dachte nicht darüber nach, was dieser Ruf nach den Tragbahren zu bedeuten hatte; er rannte vorwärts, und sein einziger Gedanke war der, alle anderen zu überholen und als erster an der Brücke zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d08496a8-fd3e-4303-8287-475f2072b90e",
                        "source_entry_id": "5c424f17-c048-3912-829e-588a022657f8",
                        "source_sense_id": "84c72426-889c-3220-a02f-5355351a250c",
