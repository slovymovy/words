                "senses": [
                    {
                        "sense_id": "92f42764-1909-3f3d-817f-b39b59fb22dd",
                        "entry_id": "1c55aa2d-0ed0-3f65-9b06-29b8e78068d2",
                        "glosses": [
                            "Prinzip der Lüftung von einem Raum oder einem ganzen Gebäude; auch andere Einrichtungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e751bf8b-7999-4e17-9579-2f47337f885d",
                                "sense_id": "92f42764-1909-3f3d-817f-b39b59fb22dd",
                                "text": "„Es ist zu empfehlen, in einem gut gedämmten Gebäude ein Lüftungssystem mit Wärmerückgewinnung zu installieren.“"
                            },
                            {
                                "example_id": "12e2b37b-c5dc-4d96-8953-9b23f7635f86",
                                "sense_id": "92f42764-1909-3f3d-817f-b39b59fb22dd",
                                "text": "„Als Hersteller dezentraler Lüftungssysteme ist es unser Anliegen, dass sich unsere Kunden wohl fühlen.“"
                            },
                            {
                                "example_id": "08d2917e-078c-46f0-a9b2-749417dff550",
                                "sense_id": "92f42764-1909-3f3d-817f-b39b59fb22dd",
                                "text": "„Die „Technische Bildpreisliste“ hilft Ihnen ein Lüftungssystem mit Wärmerückgewinnung zügig zu planen, zu kalkulieren und schließlich auch auszuführen.“"
                            },
                            {
                                "example_id": "81a8ea72-5559-47de-adaa-89cbfb4788de",
                                "sense_id": "92f42764-1909-3f3d-817f-b39b59fb22dd",
                                "text": "„Bei der zentralen Lüftungsanlage existiert für die gesamte Wohnung ein einziges Lüftungssystem.“"
                            },
                            {
                                "example_id": "81ab1e35-13e9-46d9-a207-05b5dba11f12",
                                "sense_id": "92f42764-1909-3f3d-817f-b39b59fb22dd",
                                "text": "„Sorgen Sie mit dem Lüftungssystem für frische, wohltemperierte und gesunde Luft im ganzen Haus - bestens geeignet auch bei zu Allergien neigenden Personen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
