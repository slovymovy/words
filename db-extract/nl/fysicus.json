        "nl-extract.jsonl": [
            {
                "entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
                "word": "fysicus",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "22cba5a6-f634-4bd6-bc80-7b0f3b150ca0",
                        "entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
                        "tags": [
                            "plural"
                        ],
                        "form": "fysici"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f40f92c0-cf9a-372f-8411-c9251d54dd66",
                        "entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
                        "glosses": [
                            "wetenschapper die de fysica of natuurkunde beoefent."
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "12f4beb8-ae78-4f37-98b8-ef79c61dd478",
                                "sense_id": "f40f92c0-cf9a-372f-8411-c9251d54dd66",
                                "text": "Zijn grootste succes kende de LHC in 2012, toen fysici in de versneller het langgezochte higgsdeeltje ontdekten. Dat deeltje wordt breed beschouwd als het laatste ontbrekende puzzelstukje van het zogeheten standaardmodel, de natuurkundetheorie die alle deeltjes en hun gedrag in een enkele wiskundige formule giet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49541e34-7c73-4fdc-b1b9-bd99172c9082",
                        "source_entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
                        "source_sense_id": "f40f92c0-cf9a-372f-8411-c9251d54dd66",
                        "target_lang_word": "Physiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Physiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "245659ad-db99-37a5-b334-070ff6535a0e",
                                        "entry_id": "7876fc39-c88e-3032-8ecf-fca6bb2331dd",
                                        "glosses": [
                                            "Wissenschaftler, der in der Physik tätig ist"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd8e7cc-c75c-4822-bdda-0e27e2794ef8",
                                                "sense_id": "245659ad-db99-37a5-b334-070ff6535a0e",
                                                "text": "Newton, Maxwell, Einstein und Feynman waren bedeutende Physiker."
                                            },
                                            {
                                                "example_id": "45bb92a8-9d37-408c-9ce0-630b36500864",
                                                "sense_id": "245659ad-db99-37a5-b334-070ff6535a0e",
                                                "text": "„Ironischerweise fielen seine Studienjahre in Göttingen und Cambridge in eine Periode, in der die führenden Physiker der Welt diesen schönen Traum allmählich aufgaben.“"
                                            },
                                            {
                                                "example_id": "9cff8c91-1798-42b3-bcef-bf7982510a27",
                                                "sense_id": "245659ad-db99-37a5-b334-070ff6535a0e",
                                                "text": "„Hier gelangte er in den Dienst des englischen Königs Jacob I. (1566-1625) und pflegte enge Freundschaft zum berühmten Physiker und Naturforscher Robert Boyle und zu Bischof John Wilkins, der 1648 selbst über Unterwasserboote berichtete.“"
                                            },
                                            {
                                                "example_id": "3e845851-b836-4221-b4c9-7834e78ddae4",
                                                "sense_id": "245659ad-db99-37a5-b334-070ff6535a0e",
                                                "text": "„Unter dem Physiker Igor Kurtschakow arbeiteten die Sowjets seit Anfang 1943 an ihrer eigenen Atombombe.“"
                                            },
                                            {
                                                "example_id": "ef20f3de-5400-496a-af7e-202cb2f1b895",
                                                "sense_id": "245659ad-db99-37a5-b334-070ff6535a0e",
                                                "text": "„Zum einen ist der wissenschaftliche Werdegang dieses Physikers darzustellen, der Verlauf des Weges mit allen seinen Biegungen, seinen Steigungen, dem Gefälle, den Meilensteinen und den Hindernissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12830c74-27b8-4f9a-855a-86c59573f324",
                        "source_entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
                        "source_sense_id": "f40f92c0-cf9a-372f-8411-c9251d54dd66",
                        "target_lang_word": "physicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff9193e-0518-3ea7-8a95-1b71b309cafb",
                                        "entry_id": "ca982837-9370-3509-b964-94192f1442a6",
                                        "glosses": [
                                            "A person whose occupation specializes in the science of physics, especially at a professional level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc765d5-26d3-4a3b-8055-36cfe531bf58",
                                                "sense_id": "eff9193e-0518-3ea7-8a95-1b71b309cafb",
                                                "text": "Thus we may say, that while the Naturalist employs principally the ideas of resemblance and life, the Physicist proceeds upon the ideas of force, matter, and the properties of matter."
                                            },
                                            {
                                                "example_id": "28822c7e-1234-4fb3-bbfe-b04f8d345f02",
                                                "sense_id": "eff9193e-0518-3ea7-8a95-1b71b309cafb",
                                                "text": "Physicists find themselves called in to deal with such varied problems as the reduction of noise in diesel railcars, investigation of the Hertzian stresses set up by wheel-rail contact and improvement of the insulation of fish and banana vans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354c56e1-b712-335e-bb72-e44fe3cbd5b6",
                                        "entry_id": "ca982837-9370-3509-b964-94192f1442a6",
                                        "glosses": [
                                            "A believer in the theory that the fundamental phenomena of life are to be explained upon purely chemical and physical principles (opposed to vitalist)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c42a152a-ce27-4963-a019-41353b36cdf6",
                        "source_entry_id": "b5e6e68b-d2ef-3148-b325-183143a98984",
