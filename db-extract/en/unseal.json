                    },
                    {
                        "sense_id": "6f509d66-3c06-3c45-b60c-293e1d4e4b10",
                        "entry_id": "d6953fdc-43ae-333d-878c-952f74aeafa6",
                        "glosses": [
                            "To open by having a seal broken."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a51018f2-8466-41b0-bc5c-e72cbe4110c0",
                                "sense_id": "6f509d66-3c06-3c45-b60c-293e1d4e4b10",
                                "text": "But it's just the equalising of pressure as the vault door unseals."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d835706-f7c4-42f5-9c10-7ff1840581b4",
                        "source_entry_id": "d6953fdc-43ae-333d-878c-952f74aeafa6",
                        "source_sense_description": "to break the seal of (something) in order to open it",
                        "target_lang_word": "décacheter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décacheter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "793a9870-5d63-33a6-8b2b-b55ef09ca0e4",
                                        "entry_id": "53c2d7ee-e624-3d70-b691-fc70e3d934d8",
                                        "glosses": [
                                            "Ouvrir ce qui est cacheté, briser un cachet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826d38f9-7e3f-4431-b355-c9d1b0891200",
                                                "sense_id": "793a9870-5d63-33a6-8b2b-b55ef09ca0e4",
                                                "text": "Il prend la lettre, la tourne, la retourne, la décachette."
                                            },
                                            {
                                                "example_id": "039cf102-f255-451a-a471-e54e25199d43",
                                                "sense_id": "793a9870-5d63-33a6-8b2b-b55ef09ca0e4",
                                                "text": "[…], elle aperçut Catherine rajeunie par l’action, […], écrivant, recevant des lettres, les décachetant, donnant des ordres, adressant à ceux-ci un mot, à ceux-là un sourire, […]."
                                            },
                                            {
                                                "example_id": "b9e47def-f63b-40eb-a733-c9b3a56e3ec8",
                                                "sense_id": "793a9870-5d63-33a6-8b2b-b55ef09ca0e4",
                                                "text": "À huit heures, on nous remit le courrier. Il y avait une lettre de M. de Nièvres. Madeleine, en la décachetant, changea de couleur."
                                            },
                                            {
                                                "example_id": "c1fa2b53-dc8d-452c-9d8a-cee7487c9c0d",
                                                "sense_id": "793a9870-5d63-33a6-8b2b-b55ef09ca0e4",
                                                "text": "— Tu sais cela ? toi, dit Félicité devenue sérieuse et méfiante. Eh bien, tu es alors moins bête que je ne croyais. Est-ce que tu décachetterais les lettres, comme quelqu’un de ma connaissance ?"
                                            },
                                            {
                                                "example_id": "09450102-751f-4557-beec-bcde3e9529d2",
                                                "sense_id": "793a9870-5d63-33a6-8b2b-b55ef09ca0e4",
                                                "text": "Ils décachetteraient leur courrier, ils ouvriraient les journaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8429fde0-b409-4a12-b5d6-b0ab2f68cd07",
                        "source_entry_id": "d6953fdc-43ae-333d-878c-952f74aeafa6",
                        "source_sense_description": "to break the seal of (something) in order to open it",
                        "target_lang_word": "desceller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desceller",
