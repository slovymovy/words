                {
                    "sense_id": "c6eabfaa-c2d2-3345-90f2-a68f83dadaf1",
                    "sense_definition": "Simple past tense and past participle of <w>penalize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was heavily <w>penalized</w> for committing too many fouls during the second half.",
                            "target_lang_translations": {
                                "ru": "Команда была строго <w>наказана</w> за совершение слишком большого количества фолов во втором тайме."
                            }
                        },
                        {
                            "text": "The company was <w>penalized</w> for late submission of their annual financial reports.",
                            "target_lang_translations": {
                                "ru": "Компания была <w>оштрафована</w> за несвоевременную подачу годовой финансовой отчетности."
                            }
                        }
                    ],
                    "synonyms": [
                        "punished",
                        "disciplined"
                    ],
                    "antonyms": [
                        "rewarded"
                    ],
                    "common_phrases": [
                        "heavily penalized",
                        "penalized for late submission"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола penalize (наказывать, оштрафовать)."
                    },
                    "translations": {
                        "ru": [
                            {
