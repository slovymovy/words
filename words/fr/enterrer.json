                        "enterrer le dossier",
                        "enterrer une réforme"
                    ]
                },
                {
                    "sense_id": "c73af037-ad5c-367a-bb85-09a0298a4675",
                    "sense_definition": "Célébrer la fin d'une étape importante ou d'un état, en particulier le célibat avant un mariage.",
