                                                "sense_id": "f666a3d6-029c-30b0-ad7c-e6b93b94beb0",
                                                "text": "Another difficulty which causes literature in braille to remain scarce is the cumbersomeness of the process of producing braille books."
                                            }
                                        ]
                                    }
