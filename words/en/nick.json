    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cffeed04-0608-3611-94bc-15d5cefcaf95",
                    "sense_definition": "The exact critical moment or point in time, usually just before it is too late.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambulance arrived in the <w>nick</w> of time to save the patient.",
                            "target_lang_translations": {
                                "ru": "Скорая помощь прибыла в самый последний <w>момент</w>, чтобы спасти пациента.",
                                "zh": "救护车在<w>最后关头</w>赶到，救了病人。"
                            }
                        },
                        {
                            "text": "We managed to catch the train in the <w>nick</w> of time before the doors closed.",
                            "target_lang_translations": {
                                "ru": "Мы успели на поезд в самый последний <w>момент</w>, перед тем как закрылись двери.",
                                "zh": "我们在车门关闭前的<w>最后关头</w>赶上了火车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the nick of time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Критический момент или точка во времени, обычно непосредственно перед тем, как станет слишком поздно.",
                        "zh": "指关键时刻或最后关头，通常指在为时已晚之前。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последний момент",
                                "target_lang_sense_clarification": "в идиоме 'in the nick of time'"
                            },
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "мгновение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后关头",
                                "target_lang_sense_clarification": "用于短语 in the nick of time"
                            },
                            {
                                "target_lang_word": "千钧一发",
                                "target_lang_sense_clarification": "形容极其危急的时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c77767-611f-3463-9737-b9ac18793769",
                    "sense_definition": "A small cut, notch, or chip on the surface of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a small <w>nick</w> on the rim of the glass.",
                            "target_lang_translations": {
                                "ru": "На ободке стакана была маленькая <w>щербина</w>.",
                                "zh": "玻璃杯边缘有一个小<w>缺口</w>。"
                            }
                        },
                        {
                            "text": "He covered the shaving <w>nick</w> on his chin with a small piece of tissue.",
                            "target_lang_translations": {
                                "ru": "Он заклеил <w>порез</w> от бритья на подбородке маленьким кусочком салфетки.",
                                "zh": "他用一小片纸巾盖住了下巴上刮胡子时留下的<w>小伤口</w>。"
                            }
