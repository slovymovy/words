        "fr-extract.jsonl": [
            {
                "entry_id": "0c8aa1e0-0290-3238-b126-f494430b8431",
                "word": "réceptionniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6069ccbf-86b3-48f6-9d32-f9938b244ff4",
                        "entry_id": "0c8aa1e0-0290-3238-b126-f494430b8431",
                        "tags": [
                            "plural"
                        ],
                        "form": "réceptionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0665339a-3da4-31ca-b2fa-c485eb0a1d2f",
                        "entry_id": "0c8aa1e0-0290-3238-b126-f494430b8431",
                        "glosses": [
                            "Employé travaillant à l'accueil d'un établissement tel qu'un hôtel, ou un restaurant, afin d'accueillir la clientèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed7bad8-b967-4b4e-961f-8421dffc046a",
                                "sense_id": "0665339a-3da4-31ca-b2fa-c485eb0a1d2f",
                                "text": "Dans le hall, le réceptionniste voulut me tirer les cartes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d384849-0fb2-4a63-a1dd-1743450189fb",
                        "source_entry_id": "0c8aa1e0-0290-3238-b126-f494430b8431",
                        "source_sense_id": "0665339a-3da4-31ca-b2fa-c485eb0a1d2f",
                        "target_lang_word": "Rezeptionist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rezeptionist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                        "entry_id": "9e93e710-6b3e-3f55-9d00-8d0ff90ac2be",
                                        "glosses": [
                                            "jemand, der an der Rezeption (dem Empfang) arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ee8c5b-f0ad-4bc0-be7e-f9e1dd106b3f",
                                                "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                                "text": "„Ich stand an der aus dunklem Holz verkleideten Rezeption des Danube Plaza in Russe, dem teuersten Hotel in der bulgarischen Kulturhauptstadt, und blickte dem jungen Rezeptionisten in die Augen.“"
                                            },
                                            {
                                                "example_id": "ddd6535d-997d-4a17-8829-6a647cbde292",
                                                "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                                "text": "„Der Rezeptionist ruft den Real-Madrid-Fan an, der fünfzehn Minuten später hupend vor der Tür steht.“"
                                            },
                                            {
                                                "example_id": "3e670a3d-8586-4674-a4d1-02b95dce7caf",
                                                "sense_id": "a798377d-8f05-30a5-a3ee-368e4aedf675",
                                                "text": "„Schließlich fand der Rezeptionist heraus, wo meine Tante lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a379032f-084b-4918-8dd2-5f3656c28925",
                        "source_entry_id": "0c8aa1e0-0290-3238-b126-f494430b8431",
                        "source_sense_id": "0665339a-3da4-31ca-b2fa-c485eb0a1d2f",
                        "target_lang_word": "Rezeptionistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rezeptionistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "591f53d1-c4b5-3748-a11a-b8e749fb34af",
                                        "entry_id": "68f6112d-a9ae-3865-8f90-e8530d59509e",
                                        "glosses": [
                                            "weibliche Person, die an der Rezeption (dem Empfang) arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a87e10d-5ee4-4e30-9bd1-45da5079583c",
                                                "sense_id": "591f53d1-c4b5-3748-a11a-b8e749fb34af",
                                                "text": "„Die Rezeptionistin sagt, dass Toni in seiner Pause sei.“"
                                            },
                                            {
                                                "example_id": "81471ce5-1651-4b75-9f1b-414447a7c4c1",
                                                "sense_id": "591f53d1-c4b5-3748-a11a-b8e749fb34af",
                                                "text": "„Also blieb ich sitzen und sah den Rezeptionistinnen zu, die hinter ihren Tresen fleißig an der Arbeit waren, die telefonierten und neue Gäste empfingen, die mit erwartungsvollen Gesichtern zur Tür hereinkamen.“"
                                            },
                                            {
                                                "example_id": "562cec8e-ff53-40d6-8603-49703d8b44c1",
                                                "sense_id": "591f53d1-c4b5-3748-a11a-b8e749fb34af",
                                                "text": "„Die Rezeptionistin versprach, sich früh am Morgen um unsere ungewöhnliche Busreise nach Kaliningrad zu kümmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c4c35cd-df9f-49ba-b36f-35be1b254742",
                        "source_entry_id": "0c8aa1e0-0290-3238-b126-f494430b8431",
                        "source_sense_id": "0665339a-3da4-31ca-b2fa-c485eb0a1d2f",
