                        "examples": [
                            {
                                "example_id": "a65e3328-fb01-4280-8b7d-ded8fa512bc6",
                                "sense_id": "7a250c2c-8b1e-3280-86fd-7072ac29bfd8",
                                "text": "De Nederlandse hockeyvrouwen stonden voor de zesde keer op een rij in de olympische finale. Op de vorige Spelen stond Oranje nog onder leiding van Annan, die door de Nederlandse hockeybond werd ontslagen om een ongezond topsportklimaat."
                            },
                            {
                                "example_id": "f6c72b72-9ca0-469a-8b09-afe915d09bda",
                                "sense_id": "7a250c2c-8b1e-3280-86fd-7072ac29bfd8",
                                "text": "Paul van Ass is niet langer de bondscoach van de hockeyvrouwen. Dat meldt de Koninklijke Nederlandse Hockey Bond (KNHB). Na onderling overleg hebben beide partijen besloten om niet verder met elkaar te gaan. Daardoor is de gouden olympische finale vooralsnog de laatste interland geweest voor de bondscoach, die zelf eerder aangaf niet ‘zomaar weg te lopen’."
                            }
                        ]
                    }
