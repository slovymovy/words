                        "source_sense_id": "3d07d88f-02f9-3df6-b1ab-9ca573a72fc1",
                        "source_sense_description": "Vertreter einer Gruppe schlanker, hochbeiniger Hunderassen",
                        "target_lang_word": "борзая",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "борзая",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7a2a8533-e779-304d-b0e2-6cbc35ae6c90",
                                        "entry_id": "bc903e4d-14b3-3df9-b0df-3e8c16c951ac",
                                        "glosses": [
                                            "кинол. порода охотничьих собак с длинным поджарым туловищем и с длинной острой мордой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78c8697-48ad-40bd-9ee4-8e5bf00dc9c2",
                                                "sense_id": "7a2a8533-e779-304d-b0e2-6cbc35ae6c90",
                                                "text": "Борзых нет, охотиться в ноябре не с чем; но наступает зима, начинается «работа» с гончими."
                                            },
                                            {
                                                "example_id": "2e76fbcb-121f-41a2-8465-f79070b091f9",
                                                "sense_id": "7a2a8533-e779-304d-b0e2-6cbc35ae6c90",
                                                "text": "Охотники, увидя косого врага своего, закричали: «Ату его!» ― и помчалися вслед за борзыми. Только снежная пыль поднялася."
                                            }
