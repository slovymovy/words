                ],
                "senses": [
                    {
                        "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                        "entry_id": "8a498c25-32fa-3765-a504-da91adf72fa7",
                        "glosses": [
                            "dumme Handlung, deren Absicht nicht funktioniert oder deren Zweck komplett verfehlt wird; heute häufig auf Fehlplanungen der öffentlichen Hand bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0554b8f-52df-49c8-9226-8bfb6e28f0cc",
                                "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                                "text": "Es klingt wie ein Schildbürgerstreich, wenn Präsident Trump undichte Stellen im Weißen Haus abstellen will genau durch diese undichten Stellen."
                            },
                            {
                                "example_id": "78ee26bf-e290-4393-a375-05c4c1f1728f",
                                "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                                "text": "Es klingt wie ein Schildbürgerstreich, ist aber Realität und empört Frankreich: Weil die Staatsbahn SNCF zu breite Regionalzüge bestellt hat, müssen rund 1300 der 8700 Bahnsteige verkleinert werden. Kostenpunkt: für 50 Millionen Euro."
                            },
                            {
                                "example_id": "4708aeeb-9e74-4124-a033-48c954385194",
                                "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                                "text": "Dass hierzulande 20 regionale Filmförderungen existieren, jede mit einem eigenen Verwaltungsapparat, ist ein Schildbürgerstreich des Föderalismus."
                            },
                            {
                                "example_id": "2fee7f84-c62c-4c00-b526-a9ce1e3817ba",
                                "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                                "text": "Kritik an den Plänen kommt auch von Familienministerin Renate Schmidt (SPD): „Es wäre ein Schildbürgerstreich, die Beitragsfreiheit für nicht erwerbstätige Familienmitglieder abschaffen zu wollen“. Das würde vom Verfassungsgericht \"garantiert\" für nichtig erklärt."
                            },
                            {
                                "example_id": "8e3c630a-4fba-4f0f-86b4-36b3f31dcb0f",
                                "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                                "text": "Es wäre in meinen Augen ein Schildbürgerstreich, wenn hier eine Schneise durch den Wald geschlagen wird und es dann heißt, das Gros der Baufahrzeuge fährt trotzdem durch die Ortschaften."
                            },
                            {
                                "example_id": "632a0c3a-5692-4e41-9f34-969c9f264fa3",
                                "sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                                "text": "Wie ein Schildbürgerstreich mutet an, dass die Landwirte nun für Auswirkungen von Wetterphänomenen entschädigt werden sollen, die sie durch ihre Art der Viehhaltung und des Ackerbaus mitverschuldet haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba20c209-afbd-4691-9cd7-a2e730c39517",
                        "source_entry_id": "8a498c25-32fa-3765-a504-da91adf72fa7",
                        "source_sense_id": "11056fba-f3b5-3142-99e4-b6a390aa5d08",
                        "source_sense_description": "dumme Handlung, deren Zweck komplett verfehlt wird",
                        "target_lang_word": "folly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b002d450-f5c1-356b-9828-a35a0c67aa0d",
                                        "entry_id": "97e799f0-4912-3533-91ef-d2dc69bbf8e9",
                                        "glosses": [
                                            "Foolishness that results from a lack of foresight or lack of practicality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a356419-8fd1-4ac8-9881-1efe5704f706",
                                                "sense_id": "b002d450-f5c1-356b-9828-a35a0c67aa0d",
                                                "text": "It would be folly to walk all that way, knowing the shops are probably shut by now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3760c16b-c0d6-3692-a96f-22d8b96715be",
                                        "entry_id": "97e799f0-4912-3533-91ef-d2dc69bbf8e9",
                                        "glosses": [
                                            "Thoughtless action resulting in tragic consequence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ca86af-cdcd-47cd-b0c2-d504c4aed1a6",
                                                "sense_id": "3760c16b-c0d6-3692-a96f-22d8b96715be",
                                                "text": "The purchase of Alaska from Russia was termed Seward's folly."
                                            },
                                            {
                                                "example_id": "3fc670c1-8def-46af-b131-c6e6649c1a88",
                                                "sense_id": "3760c16b-c0d6-3692-a96f-22d8b96715be",
                                                "text": "Thames Water has become the latest object lesson in the predictable and predicted folly of privatised monopolies, aided by a regulator that’s an even bigger wet wipe than the fatbergs bunging up the sewers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                        "entry_id": "97e799f0-4912-3533-91ef-d2dc69bbf8e9",
                                        "glosses": [
                                            "A fanciful building built for purely ornamental reasons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4a1053-f24b-4f4f-a40b-6533173f3553",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "A luncheonette in the shape of a coffee cup is particularly conspicuous, as is intended of an architectural duck or folly."
                                            },
                                            {
                                                "example_id": "2f9bba73-4691-4657-9cb0-55eaf44ba88b",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "“The Villa Straylight,” said a jeweled thing on the pedestal, in a voice like music, “is a body grown in upon itself, a Gothic folly. […]”"
                                            },
                                            {
                                                "example_id": "9d596ead-af70-4755-9c05-f38c75102afe",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "It has been a long time since new follies were springing up across the great estates of Britain. But the owners of Doddington Hall, in Lincolnshire, have brought the folly into the 21st century, by building a 30ft pyramid in the grounds of the Elizabethan manor."
                                            },
                                            {
                                                "example_id": "477d50e2-1a42-4672-82a5-a44cb22ec3bc",
                                                "sense_id": "fadcf703-bf50-302a-960f-ba3fb7d12f98",
                                                "text": "A great deal of eccentricity was expressed through the trend for ruin follies. But it wasn’t only the madness of paranoid earls and fashionable landowners that was encoded in them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "folly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                        "entry_id": "68944239-5d58-3481-be59-2783a20328f5",
                                        "glosses": [
                                            "To follow."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7a1126-653c-40fd-a23e-9cf2cb55ccce",
                                                "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                                "text": "\"You got any money?\" he said to me. ¶ \"Hell no, maybe enough for a pint of whisky till I get to Denver. What about you?\" ¶ \"I know where I can get some.\" ¶ \"Where?\" \"Anywhere. You can always folly a man down an alley, can't you?\""
                                            },
                                            {
                                                "example_id": "cd019caf-2837-47a0-8dac-424c76ec5e90",
                                                "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                                "text": "\"Anybody got the makin's?\" he said. \"That's one hell of a thick bunch of canvas, but I follied the seam.\""
                                            },
                                            {
                                                "example_id": "b056c5fd-f354-445c-8596-4061045acccf",
                                                "sense_id": "165cddf4-6931-3295-b592-ac3ceee80a9e",
                                                "text": "Howandever, at the selfsame time, there was a gang of fellas from the valley of kings follying the very same pointy star. And didn't that pointy star point them king-fellas in the direction of Mary's cowstable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "folly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                        "entry_id": "7b353de9-a524-3e74-b306-24049cf80aba",
                                        "glosses": [
                                            "A clump of trees, particularly one on the crest of a hill (or sometimes on a stretch of open ground)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d61ac2-59f2-4f48-939c-c2de872d7d5f",
                                                "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                                "text": "'Every hill seems to have a Folly' [...] 'I mean a clump of trees on the top.'"
                                            },
                                            {
                                                "example_id": "8e5e65e3-7a06-4c06-8df2-74d9ed1a61a4",
                                                "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                                "text": "Folly Beach, the next island to the south (batik 3.7), bears the name given it by mariners, who looked for the island's tree-crested dune ridge, a volley or folly of trees, as a navigation guide [...] Probably a lot of East Coast islands bore the temporary name of Folly Beach."
                                            },
                                            {
                                                "example_id": "8a1b5e6b-040d-4132-ad43-17fdf6ccd80a",
                                                "sense_id": "ce357eb4-600e-3346-b172-f2ced219dd24",
                                                "text": "During the 1920s and 1930s, Folly Farms (above) [referencing a photograph of a farmhouse surrounded by large trees] was owned by Mrs. Samuel Pennington Rotan of Pennsylvania, who was involved in the effort to improve medical care for the indigent people around Ways Station. … Folly Farms was originally known as Myrtle Grove …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
