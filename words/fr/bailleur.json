                {
                    "sense_id": "69a27f63-75d5-3833-9815-843dee6d5575",
                    "sense_definition": "Personne ou organisme qui donne un bien immobilier à loyer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le locataire doit envoyer un préavis écrit à son <w>bailleur</w> avant de quitter le logement."
                        },
                        {
                            "text": "Cette agence immobilière met directement en relation les <w>bailleurs</w> et les futurs locataires."
                        }
                    ],
                    "synonyms": [
                        "loueur",
                        "propriétaire"
                    ],
                    "antonyms": [
                        "locataire",
                        "preneur"
                    ],
                    "common_phrases": [
                        "bailleur social",
                        "bailleur privé"
                    ]
                },
                {
                    "sense_id": "7e14eff9-8ad0-3d05-960d-9cf5009a1353",
                    "sense_definition": "Personne, organisme ou État qui fournit des capitaux pour un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les principaux <w>bailleurs</w> de fonds se sont réunis pour financer la construction du nouvel hôpital."
                        },
                        {
                            "text": "Ce projet humanitaire dépend entièrement de l'aide financière apportée par un <w>bailleur</w> international."
                        }
                    ],
                    "synonyms": [
                        "financeur",
                        "commanditaire"
                    ],
                    "common_phrases": [
                        "bailleur de fonds",
                        "bailleurs internationaux"
                    ]
                },
                {
                    "sense_id": "e1e66469-ce84-376e-9ada-efd1fd2eb40c",
                    "sense_definition": "Au Moyen Âge, propriétaire foncier qui concédait des terres incultes à un exploitant contre redevance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au début du Moyen Âge, le <w>bailleur</w> confiait des parcelles incultes à des paysans en échange d'une rente."
                        },
                        {
                            "text": "Ce régime agraire permettait au grand <w>bailleur</w> d'étendre la mise en valeur de ses domaines ruraux."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme historique médiéval"
                        }
                    ]
                }
            ]
        },
