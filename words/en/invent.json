{
    "word_family": [
        "invention",
        "inventor",
        "inventive",
        "inventiveness",
        "reinvent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b677810-2bdc-3a52-8f2c-d7d21ff03bce",
                    "sense_definition": "To design or create a new process, mechanism, or device that did not exist before.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thomas Edison worked for many years to <w>invent</w> a practical light bulb.",
                            "target_lang_translations": {
                                "ru": "Томас Эдисон работал много лет, чтобы <w>изобрести</w> практичную лампочку."
                            }
                        },
                        {
                            "text": "The scientist managed to <w>invent</w> a new device to measure air quality in cities.",
                            "target_lang_translations": {
                                "ru": "Ученому удалось <w>изобрести</w> новое устройство для измерения качества воздуха в городах."
                            }
                        }
                    ],
                    "synonyms": [
                        "conceive"
                    ],
                    "common_phrases": [
                        "invent a device",
                        "invent a system",
                        "invent a method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проектировать или создавать новый процесс, механизм или устройство, которых раньше не существовало."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобретать",
                                "target_lang_sense_clarification": "создавать что-то новое, техническое"
                            },
                            {
                                "target_lang_word": "изобрести",
                                "target_lang_sense_clarification": "создать что-то новое (совершенный вид)"
                            },
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "делать существующим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c5a7f06-ee57-3651-a06c-b3be3cf9b6a9",
                    "sense_definition": "To create a fictional story, excuse, or piece of information for a specific purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fabrication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>invent</w> an excuse because he forgot to do his homework.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>выдумать</w> оправдание, потому что он забыл сделать домашнее задание."
                            }
                        },
                        {
                            "text": "The author likes to <w>invent</w> a story for every character in her book.",
                            "target_lang_translations": {
                                "ru": "Автору нравится <w>придумывать</w> историю для каждого персонажа в своей книге."
                            }
                        }
                    ],
                    "synonyms": [
                        "make up",
                        "manufacture",
                        "spin"
                    ],
                    "common_phrases": [
                        "invent an excuse",
                        "invent a story",
                        "invent a name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать вымышленную историю, оправдание или информацию для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдумывать",
                                "target_lang_sense_clarification": "сочинять небылицы или оправдания"
                            },
                            {
                                "target_lang_word": "придумывать",
                                "target_lang_sense_clarification": "создавать в воображении"
                            },
                            {
                                "target_lang_word": "сочинять",
                                "target_lang_sense_clarification": "говорить неправду или писать текст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc1d1059-b9f4-36cb-8c0f-632c31318e02",
                    "sense_definition": "To come upon, find, or discover something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, the explorer sought to <w>invent</w> the hidden path through the mountains.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи исследователь стремился <w>найти</w> скрытую тропу через горы."
                            }
                        },
                        {
                            "text": "The poet used the word to describe how one might <w>invent</w> a secret truth in nature.",
                            "target_lang_translations": {
                                "ru": "Поэт использовал это слово, чтобы описать, как можно <w>обрести</w> тайную истину в природе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наткнуться, найти или обнаружить что-либо (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находить",
                                "target_lang_sense_clarification": "обнаруживать (устар.)"
                            },
                            {
                                "target_lang_word": "обретать",
                                "target_lang_sense_clarification": "находить скрытое (книжн.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}