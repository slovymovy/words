                    {
                        "translation_id": "3de4e986-ad17-43d0-82d9-174bf0673bdb",
                        "source_entry_id": "314bae49-c7de-39e0-ab6a-eff34cbad407",
                        "source_sense_description": "to laugh or giggle in a somewhat subdued manner",
                        "target_lang_word": "ricaner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ricaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3d3a0d-1f4e-3172-94e2-10373ef775dd",
                                        "entry_id": "9f59f68a-4642-3119-8971-ba9c62134ed5",
                                        "glosses": [
                                            "Rire avec une affectation d’impertinence et dans une intention de moquerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b4a239-d93e-45f6-9c3b-2ad4ddd543a0",
                                                "sense_id": "bc3d3a0d-1f4e-3172-94e2-10373ef775dd",
                                                "text": "Elle avait pris avec elle son baisenville, le tenant fermement sous le bras, bourré à souhait et elle ricanait, peut-être d'elle-même, mais ça on l'ignorera longtemps, de toutes ses dents pointues et noires, en regardant tantôt Chérubin, tantôt Nhiburec."
                                            },
                                            {
                                                "example_id": "7d34f830-1965-48b3-ab2d-73615bf03cce",
                                                "sense_id": "bc3d3a0d-1f4e-3172-94e2-10373ef775dd",
                                                "text": "Pourtant, il ne fit rien pour la tourmenter, en raison sans doute de son aversion pour elle. Il me demandait souvent des nouvelles de l’enfant quand il me rencontrait ; lorsqu’il apprit le prénom qu’on lui avait donné, il ricana un sourire et me dit : …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b02200-10a5-3162-a014-513f82d1ab81",
                                        "entry_id": "9f59f68a-4642-3119-8971-ba9c62134ed5",
                                        "glosses": [
                                            "Faire un rictus."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d77f7ebb-6868-4f46-b9e8-f16a8ae8aa4d",
                                                "sense_id": "28b02200-10a5-3162-a014-513f82d1ab81",
                                                "text": "Un cadavre, visage blême, ricanait là, sous la lune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
