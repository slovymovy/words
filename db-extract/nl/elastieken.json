                                                "sense_id": "5b2bdfc7-1a3e-3a30-9c32-2b48aaf64aec",
                                                "text": "Demand for entertainment is more elastic than demand for energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbf026d-5e36-3da0-a899-c58bc30eef24",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "springy; bouncy; vivacious"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ef226c-7d43-4c98-adf8-32fc0ee471d2",
                                                "sense_id": "9bbf026d-5e36-3da0-a899-c58bc30eef24",
                                                "text": "He could see that she was tastefully, though not richly, dressed, and that she walked with an elastic step that revealed a light heart and the vigor of perfect health. Her face, of course, he could not analyze, since he had caught only the one brief but convincing glimpse of it."
                                            }
                                        ]
                                    },
