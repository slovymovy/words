                "senses": [
                    {
                        "sense_id": "2bc769c7-4d74-3b88-87d5-7b1a5157ef77",
                        "entry_id": "3f76e1ce-6e59-3d19-a737-a02aa86ebc9d",
                        "glosses": [
                            "разг. после долгой бессонницы или сильного утомления восстановить силы продолжительным сном, выспаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af578f2-2fbd-46db-a1db-c87fd706b517",
                                "sense_id": "2bc769c7-4d74-3b88-87d5-7b1a5157ef77",
                                "text": "― Отоспался на три года вперёд. А вам как отдохнулось, гражданин начальник?"
                            },
                            {
                                "example_id": "14d28e97-89f7-43e6-b3e1-c3b7b10e3887",
                                "sense_id": "2bc769c7-4d74-3b88-87d5-7b1a5157ef77",
                                "text": "Мне надо сутки подряд спать, чтобы отоспаться как следует."
                            }
                        ]
                    }
