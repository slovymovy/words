                "senses": [
                    {
                        "sense_id": "5783ba53-2563-3de8-9c1f-153096a23d66",
                        "entry_id": "bda593d7-3982-3279-8972-dfe19655ad9f",
                        "glosses": [
                            "Astéracée annuelle pouvant atteindre un mètre de haut, aux fleurs bleues ou mauves. → voir Ageratum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d5e1fc-f968-4390-8351-9a336fff90ee",
                                "sense_id": "5783ba53-2563-3de8-9c1f-153096a23d66",
                                "text": "[…] des ageratums à houppettes bleu céleste ; des aspérules, d’une délicate odeur de musc ; des mimulus, montrant des gorges cuivrées, ponctuées de cinabre."
                            },
                            {
                                "example_id": "519af720-7ec9-48f9-9e90-04cec55e9de5",
                                "sense_id": "5783ba53-2563-3de8-9c1f-153096a23d66",
                                "text": "L’agératum colorie certains champs aussi complètement que le glaçage un gâteau. L’herbe ondoyante de juin a des couleurs d’aquarelle comme du grain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e70de8a-193a-4400-b316-c349de075421",
                        "source_entry_id": "bda593d7-3982-3279-8972-dfe19655ad9f",
                        "source_sense_id": "5783ba53-2563-3de8-9c1f-153096a23d66",
