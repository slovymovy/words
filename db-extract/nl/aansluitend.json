        "nl-extract.jsonl": [
            {
                "entry_id": "7f3f3b47-60fd-383b-b08b-dca7174eb8f7",
                "word": "aansluitend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5806ab6-7869-3fe0-9519-0166dca668a3",
                        "entry_id": "7f3f3b47-60fd-383b-b08b-dca7174eb8f7",
                        "glosses": [
                            "direkt ergens op volgend zonder tussenruimte of tussentijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f86744-bd51-494f-8dce-c6e49284292d",
                                "sense_id": "b5806ab6-7869-3fe0-9519-0166dca668a3",
                                "text": "Passagiers die forse vertraging oplopen tijdens een rechtstreeks aansluitende vlucht buiten de EU, hebben recht op compensatie. De vluchten moeten wel in één enkele boeking zijn gekocht. De luchtvaartmaatschappij die de eerste vlucht heeft uitgevoerd draait op voor de kosten. Het Hof van Justitie van de Europese Unie heeft dat bepaald."
                            },
                            {
                                "example_id": "664a951f-78c1-47e7-8e45-6189c2f4b9e7",
                                "sense_id": "b5806ab6-7869-3fe0-9519-0166dca668a3",
                                "text": "Aansluitend zocht ze contact met haar ouders."
                            },
                            {
                                "example_id": "2d38fc40-529e-49a8-a418-25e466b75e04",
                                "sense_id": "b5806ab6-7869-3fe0-9519-0166dca668a3",
                                "text": "Vier deuren boden toegang tot de andere vertrekken: tegenover de voordeur bevond zich de woonkamer met aansluitend de ruime studeerkamer. Aan de linkerkant van de hal waren de badkamer en de slaapkamer, rechts de kleine keuken die Van Lohuijzen bij bezoek altijd om een mysterieuze reden op slot deed."
                            }
                        ]
                    },
                    {
                        "sense_id": "620e4f38-216e-3dec-9949-647375dad4a4",
                        "entry_id": "7f3f3b47-60fd-383b-b08b-dca7174eb8f7",
                        "glosses": [
                            "precies passend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a592a3c-9d66-421c-b108-c3f0887a4eae",
                                "sense_id": "620e4f38-216e-3dec-9949-647375dad4a4",
                                "text": "Wat blijkt? Een op de vijf is daadwerkelijk in een aansluitende bedrijfstak gaan werken. Dat geldt vooral voor meisjes die met kinderen wilden werken, of jongens die timmerman wilden worden."
                            }
                        ]
                    }
                ],
