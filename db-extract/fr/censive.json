                        "examples": [
                            {
                                "example_id": "022333bd-2e82-4486-8b56-f1aaab503373",
                                "sense_id": "04a23a9d-b1dc-39a1-aa2c-4d26dde67cd8",
                                "text": "Lorsque la censive et l’héritage qui en relève, ont été l’un et l’autre acquis durant la communauté des deux conjoints par mariage, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "af2d47ed-d023-3da1-84f8-c27d893785bc",
                        "entry_id": "c4557b67-f26b-35c8-b010-75385c69ab33",
                        "glosses": [
                            "Redevance due à un seigneur féodal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed01b2e-8221-413c-a212-b5d85319ba34",
                                "sense_id": "af2d47ed-d023-3da1-84f8-c27d893785bc",
                                "text": "Procès entre le chapitre de Mende, les habitants de Vimenet et d’Orbanbac et le collège de Rodez, pour raison de la censive, champarts et autres droits dus audit collège par les habitants susdits."
                            }
                        ]
                    },
                    {
                        "sense_id": "a27edf8a-c13f-3fca-a177-1d58307dabbd",
                        "entry_id": "c4557b67-f26b-35c8-b010-75385c69ab33",
                        "glosses": [
                            "Terre concédée contre la redevance d’un cens annuel au seigneur censier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c0079c-1e5f-44a3-a9e7-a17015bcbff1",
                                "sense_id": "a27edf8a-c13f-3fca-a177-1d58307dabbd",
                                "text": "Il prend ses censives au milieu de l’hiver, trop tard pour semer, il faudra patienter jusqu’aux blés de printemps, sarrasin ou avoine."
                            },
                            {
                                "example_id": "996c78d0-639a-4ec0-8e81-2f0eb21c9276",
                                "sense_id": "a27edf8a-c13f-3fca-a177-1d58307dabbd",
                                "text": "Cette formalité à laquelle le preneur devait tenir afin d’être à même de repousser les troubles qui pouvaient survenir comme possesseur civil et pour user de l’action en complainte, était considérée comme tellement importante que lors de la cession d’une censive le vendeur demandait au propriétaire de le désensaisiner, et l’acheteur, au contraire, de l’ensaisiner."
                            }
                        ]
                    }
