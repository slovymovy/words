                        "glosses": [
                            "een verhaal over spoken of het bovennatuurlijke, om mensen te laten griezelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ef7d59-4f52-4c69-a228-d5b1a938bde7",
                                "sense_id": "35e987c3-4d9b-30ba-b4cf-07accf5570e5",
                                "text": "Bij het kampvuur vertelden we elkaar spookverhalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ed19e76-2082-3bb0-8625-2fb5c4e456ad",
                        "entry_id": "645715db-cbdf-3936-a0b1-45337e25563a",
                        "glosses": [
                            "bewering die niet gebaseerd is op feiten, maar toch als waar zijnde wordt rondverteld"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5f2d0137-599c-4281-9e94-d837233f8369",
                                "sense_id": "3ed19e76-2082-3bb0-8625-2fb5c4e456ad",
                                "text": "Tijdens de bijeenkomst worden vragen van bewoners beantwoord en worden spookverhalen uit de wereld geholpen."
                            },
                            {
                                "example_id": "f3eec7e5-2990-48f5-a8fa-fa2cd7ec4db8",
                                "sense_id": "3ed19e76-2082-3bb0-8625-2fb5c4e456ad",
                                "text": "Er doen veel spookverhalen de ronde over vaccinaties."
                            }
                        ]
                    }
