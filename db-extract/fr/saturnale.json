                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5f3f88be-c98d-4665-b5be-0fbfc05bc477",
                                "sense_id": "1cd1d5c4-930a-3633-aaa9-0315b2ad738b",
                                "text": "Cette fête tourne à la saturnale."
                            },
                            {
                                "example_id": "737e6787-8892-450c-96d2-58a8b789d572",
                                "sense_id": "1cd1d5c4-930a-3633-aaa9-0315b2ad738b",
                                "text": "C’était leur jour, leur fête des fous, leur saturnale, l’orgie annuelle de la basoche et de l’école."
                            },
                            {
                                "example_id": "52f49533-f07c-470d-b95f-a0d2e2e889d9",
                                "sense_id": "1cd1d5c4-930a-3633-aaa9-0315b2ad738b",
                                "text": "Qu’admirons-nous dans le Télémaque ? […] c’est cette politique si morale et si rationnelle devinée par miracle au milieu des saturnales du pouvoir absolu."
                            },
                            {
                                "example_id": "6849ebe7-1ff4-4561-8543-65306e613721",
                                "sense_id": "1cd1d5c4-930a-3633-aaa9-0315b2ad738b",
                                "text": "Une consigne de mollesse permit aux apaches, qui s’étaient donné rendez-vous là, de mener impunément leur ignoble saturnale."
                            },
                            {
                                "example_id": "e1087b9e-ed31-400b-8e79-afd6402ac3d6",
                                "sense_id": "1cd1d5c4-930a-3633-aaa9-0315b2ad738b",
                                "text": "Martial, si ennemi du vol et du meurtre, se montrait assez indifférent à ces immondes saturnales."
                            }
                        ]
                    }
