                    "synonyms": [
                        "unimpeded"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от преград; беспрепятственный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспрепятственный",
                                "target_lang_sense_clarification": "свободный от помех"
                            },
                            {
                                "target_lang_word": "свободный",
                                "target_lang_sense_clarification": "открытый для движения"
