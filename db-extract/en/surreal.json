                            },
                            {
                                "example_id": "a86046ed-8ece-41f8-a0ee-a686d4876bec",
                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                "text": "a surreal experience"
                            },
                            {
                                "example_id": "ecdfe2a2-654f-4753-97b8-77aab2a01483",
                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                "text": "surreal picture"
                            },
                            {
                                "example_id": "fffebe5a-da03-46d3-8a71-feddb7dbd8c9",
                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                "text": "surreal sound"
                            },
                            {
                                "example_id": "2beb329a-3532-4172-8d03-12acac73530b",
                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                "text": "Walking through the empty city at night was a surreal experience."
                            },
                            {
                                "example_id": "2463665c-4e16-4d6d-9783-3345a02f1e8b",
                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                "text": "The movie had a dreamlike, surreal atmosphere."
                            },
                            {
                                "example_id": "dd5ec3cc-46e1-4310-ac61-06971805e43e",
                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                "text": "It felt surreal to meet her favorite author in person."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad814030-879c-4e45-9220-bc7e5dea5884",
                        "source_entry_id": "58df8ab7-84bc-3524-a11c-fa8eefef68c2",
                        "source_sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                        "source_sense_description": "fantastic and incongruous",
                        "target_lang_word": "surreëel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surreëel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ff57fce1-a498-3762-b3c5-6b984f01542b",
                                        "entry_id": "8093f060-38a3-3240-a312-005609890fb0",
                                        "glosses": [
                                            "echt, maar tegelijkertijd onmogelijk lijkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e4a21a-2601-4eb2-9832-2acd35d14485",
                                                "sense_id": "ff57fce1-a498-3762-b3c5-6b984f01542b",
                                                "text": "Dat de teams onder haar leiding zoveel succes boeken is surreëel voor de lerares. „Wauw, mijn tactiek werkt gewoon. Ik ben best trots op mezelf en vooral heel dankbaar dat ik dit mag meemaken.”"
                                            },
                                            {
                                                "example_id": "a860ee98-ded6-43a5-8b9a-0df69098bc2a",
                                                "sense_id": "ff57fce1-a498-3762-b3c5-6b984f01542b",
                                                "text": ",,In dat verlaten park zijn voelde aan als een griezelige Disney-ervaring\", vertelt de fotograaf uit Ohio. ,,Het was surreëel en echt knap.\""
                                            },
                                            {
                                                "example_id": "4916dd5e-e670-4616-9a5a-4f3b64434fd2",
                                                "sense_id": "ff57fce1-a498-3762-b3c5-6b984f01542b",
                                                "text": "Zo eindigde de US Open-finale curieus en surreëel. Osaka kon niet echt genieten van haar primeur en dat was een domper op een perfect toernooi en een bijna foutloze finale tegen haar grote idool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd8e8a2a-9aad-48fb-ab90-3a0453e206f1",
                        "source_entry_id": "58df8ab7-84bc-3524-a11c-fa8eefef68c2",
                        "source_sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
