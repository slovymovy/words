{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "012e4168-0af1-3591-a308-075aa9056ecc",
                    "sense_definition": "To grow, develop, or expand rapidly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "burgeon_grow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gradually, the small town <w>burgeoned</w> into a thriving commercial city.",
                            "target_lang_translations": {
                                "zh": "渐渐地，这座小镇<w>蓬勃发展</w>成一座繁荣的商业城市。"
                            }
                        },
                        {
                            "text": "The local software industry began to <w>burgeon</w> after the tax reforms.",
                            "target_lang_translations": {
                                "zh": "税改之后，当地软件业开始<w>迅速发展</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expand",
                        "grow"
                    ],
                    "common_phrases": [
                        "burgeoning market",
                        "burgeoning demand",
                        "burgeoning industry"
                    ],
                    "target_lang_definitions": {
                        "zh": "迅速发展；蓬勃兴旺；激增"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蓬勃发展",
                                "target_lang_sense_clarification": "指经济、行业、事业等迅速壮大"
                            },
                            {
                                "target_lang_word": "迅速发展",
                                "target_lang_sense_clarification": "指规模、数量或程度等快速增长"
                            },
                            {
                                "target_lang_word": "激增",
                                "target_lang_sense_clarification": "指需求、市场等急剧增加"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dca22789-c9a7-396b-8e65-bb3acc6332e3",
                    "sense_definition": "To put forth new buds, sprouts, or leaves; to begin to bloom.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "burgeon_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When spring arrived, the apple trees in the garden started to <w>burgeon</w>.",
                            "target_lang_translations": {
                                "zh": "春天来临时，花园里的苹果树开始<w>抽芽</w>。"
                            }
                        },
                        {
                            "text": "Delicate green shoots <w>burgeon</w> from the moist soil after the rain.",
                            "target_lang_translations": {
                                "zh": "雨后，娇嫩的青绿幼芽从湿润的土壤中<w>萌发</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blossom",
                        "bud",
                        "sprout"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（植物）发芽；抽条；绽放"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发芽",
                                "target_lang_sense_clarification": "指植物长出嫩芽"
                            },
                            {
                                "target_lang_word": "抽芽",
                                "target_lang_sense_clarification": "指植物生出新芽（多用于书面语）"
                            },
                            {
                                "target_lang_word": "萌发",
                                "target_lang_sense_clarification": "指植物种子或枝桠开始生长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a00b284d-0688-3bea-8266-9a34f5669900",
                    "sense_definition": "To swell almost to the point of bursting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river banks seemed to <w>burgeon</w> under the weight of floodwaters.",
                            "target_lang_translations": {
                                "zh": "在洪水的重压下，河堤似乎都要<w>膨胀</w>开裂了。"
                            }
                        },
                        {
                            "text": "Her veins would <w>burgeon</w> with tension during moments of great distress.",
                            "target_lang_translations": {
                                "zh": "在极度痛苦的时刻，她的青筋会因紧绷而<w>鼓胀</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "肿胀；膨胀；鼓胀到近乎爆裂"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鼓胀",
                                "target_lang_sense_clarification": "指物体或血管等饱满膨出"
                            },
                            {
                                "target_lang_word": "膨胀",
                                "target_lang_sense_clarification": "指体积或规模变大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f1e893e-9c79-3840-89bf-42df4ab309d1",
                    "sense_definition": "A bud, sprout, or new shoot of a plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burgeon_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener inspected each tiny green <w>burgeon</w> along the rose stems.",
                            "target_lang_translations": {
                                "zh": "园丁仔细检查了玫瑰花茎上的每一个绿色小<w>嫩芽</w>。"
                            }
                        },
                        {
                            "text": "Frost damaged the tender <w>burgeons</w> that had appeared earlier in the week.",
                            "target_lang_translations": {
                                "zh": "严霜冻坏了本周早些时候冒出的娇嫩<w>新芽</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（植物的）嫩芽；花蕾；新芽"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嫩芽",
                                "target_lang_sense_clarification": "指植物新长出的幼芽"
                            },
                            {
                                "target_lang_word": "新芽",
                                "target_lang_sense_clarification": "指刚萌发的枝芽"
                            },
                            {
                                "target_lang_word": "花蕾",
                                "target_lang_sense_clarification": "指尚未开放的花朵幼芽"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}