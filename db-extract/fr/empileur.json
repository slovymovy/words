                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b53d4a92-0c79-41be-8bdf-0e679e610fbc",
                                "sense_id": "cc52c368-fc46-3e30-82c8-73382bf459d8",
                                "text": "Leur génie [des Grecs] ne les conduit jamais à devenir des maçons. Ce sont des appareilleurs, c'est-à-dire des assembleurs et des empileurs de pierres."
                            }
                        ]
                    },
                    {
                        "sense_id": "9686cc08-a783-3b68-a6ab-7d3862699631",
                        "entry_id": "c0fc20e5-8caf-3291-9f35-26946e2d0a38",
                        "glosses": [
                            "Machine qui empile."
                        ],
                        "tags": [],
                        "examples": [
                            {
