{
    "word_family": [
        "increment",
        "incrementally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33cc38a4-4bff-3f44-ad89-269312fafc61",
                    "sense_definition": "Happening or moving forward in a series of small, gradual steps or additions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to make <w>incremental</w> improvements to the software every month. \n",
                            "target_lang_translations": {
                                "de": "Wir müssen jeden Monat <w>schrittweise</w> Verbesserungen an der Software vornehmen."
                            }
                        },
                        {
                            "text": "The team made <w>incremental</w> progress toward completing the complex project. ",
                            "target_lang_translations": {
                                "de": "Das Team machte <w>kontinuierliche</w> Fortschritte beim Abschluss des komplexen Projekts."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradual"
                    ],
                    "antonyms": [
                        "decremental"
                    ],
                    "common_phrases": [
                        "incremental progress",
                        "incremental change",
                        "incremental steps"
                    ],
                    "target_lang_definitions": {
                        "de": "In einer Reihe von kleinen, allmählichen Schritten oder Ergänzungen erfolgend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schrittweise",
                                "target_lang_sense_clarification": "Schritt für Schritt, in kleinen Etappen"
                            },
                            {
                                "target_lang_word": "stufenweise",
                                "target_lang_sense_clarification": "in aufeinanderfolgenden Stufen oder Schritten"
                            },
                            {
                                "target_lang_word": "graduell",
                                "target_lang_sense_clarification": "allmählich, dem Grad nach"
                            },
                            {
                                "target_lang_word": "inkrementell",
                                "target_lang_sense_clarification": "den schrittweisen Zuwachs betreffend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8179ccb5-a6ab-3b91-8e5d-09fe3213ef6c",
                    "sense_definition": "Relating to or describing a formal increase or addition to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company introduced an <w>incremental</w> cost to cover the extra services. ",
                            "target_lang_translations": {
                                "de": "Das Unternehmen führte eine <w>zusätzliche</w> Gebühr ein, um die Extra-Services abzudecken."
                            }
                        },
                        {
                            "text": "Each stage of production incurs an <w>incremental</w> fee for the client. ",
                            "target_lang_translations": {
                                "de": "Jede Produktionsstufe verursacht eine <w>weitere</w> Gebühr für den Kunden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incremental cost",
                        "incremental value"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich auf eine formelle Erhöhung, einen Zuwachs oder einen Zusatz zu etwas beziehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "inkrementell",
                                "target_lang_sense_clarification": "zusätzlich entstehend, den Zuwachs betreffend"
                            },
                            {
                                "target_lang_word": "zusätzlich",
                                "target_lang_sense_clarification": "weiterhin hinzukommend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}