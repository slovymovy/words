                        "form": "das Menschenopfer"
                    },
                    {
                        "form_id": "5e91a8f3-9822-4a19-9501-2cca47ea7d5f",
                        "entry_id": "2bc4979f-0045-3433-a4f5-bf01e4dcd594",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Menschenopfer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dec5d161-6f9c-3441-a549-4e83f40f8e40",
                        "entry_id": "2bc4979f-0045-3433-a4f5-bf01e4dcd594",
                        "glosses": [
                            "Tötung einer Person aus kultischen Gründen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d7da79e-f7de-4ea1-942e-da1b67685bae",
                                "sense_id": "dec5d161-6f9c-3441-a549-4e83f40f8e40",
                                "text": "„Menschenopfer kamen als Dank-, Sühn- und Gelübdeopfer bei vielen alten Völkern vor […]. Geopfert wurden Kinder, Jünglinge, Mädchen, junge Frauen, dann Kriegsgefangene, Verbrecher und Sklaven.“"
                            },
                            {
                                "example_id": "7b273d16-c2a0-466f-b13e-07eab2a370c9",
                                "sense_id": "dec5d161-6f9c-3441-a549-4e83f40f8e40",
                                "text": "„Das Illerup Ådal ist nicht nur ein Naturschutzgebiet, sondern auch die größte bekannte Stätte für Menschenopfer in Nordeuropa.“"
                            },
                            {
                                "example_id": "9aa47be6-e5d0-420c-b9a5-e446e1469c54",
                                "sense_id": "dec5d161-6f9c-3441-a549-4e83f40f8e40",
                                "text": "„Wenn wir Caesar Glauben schenken dürfen, so waren die Gallier (Kelten) nicht nur in hohem Maße religiös, sondern brachten auch Menschenopfer dar.“"
                            },
                            {
                                "example_id": "52426970-acf7-469f-93dc-ed3e6f7b3925",
                                "sense_id": "dec5d161-6f9c-3441-a549-4e83f40f8e40",
                                "text": "„Er erzählte angewidert von ihrer Religion und den Menschenopfern.“"
                            },
                            {
                                "example_id": "9e3a4785-2d0f-4a14-bdb7-14ad51a282a8",
                                "sense_id": "dec5d161-6f9c-3441-a549-4e83f40f8e40",
                                "text": "„Dort, wo nach tausend Jahren Menschenopfer und Regen die Seife im Fluss landete, sagt Tyler, fanden die Menschen des Altertums heraus, dass ihre Kleidung sauberer wurde, wenn sie sie an dieser Stelle wuschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "62acd313-eff0-3561-bb35-0449a65ea4b4",
                        "entry_id": "2bc4979f-0045-3433-a4f5-bf01e4dcd594",
                        "glosses": [
                            "Verlust an Personen durch Gewalt-/Waffeneinwirkung oder andere Ursachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758e42f4-04bd-40bd-a464-3be939b09e5d",
                                "sense_id": "62acd313-eff0-3561-bb35-0449a65ea4b4",
                                "text": "Viele Menschenopfer sind Folgen von Kriegen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
