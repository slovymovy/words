                                "target_senses": [
                                    {
                                        "sense_id": "71d0042c-9eaa-301b-8dad-6ef3ff2d67ee",
                                        "entry_id": "6b38c191-54e6-32db-a8b3-1c95343361b0",
                                        "glosses": [
                                            "Personne ne possédant pas de pouvoirs magiques."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Univers de Harry Potter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7aec261-1d5c-4a8c-8bdc-99fe38ab4ac9",
                                                "sense_id": "71d0042c-9eaa-301b-8dad-6ef3ff2d67ee",
                                                "text": "Chaque année, c’est pareil ! La gare est pleine de moldus !"
                                            },
                                            {
                                                "example_id": "493772a8-f40f-49b8-89e1-bc1ce1c8d9d0",
                                                "sense_id": "71d0042c-9eaa-301b-8dad-6ef3ff2d67ee",
                                                "text": "Avis aux Moldus, fans de la saga Harry Potter : l’école de magie bretonne du Rocher-Portail, située à Maen Roch (Ille-et-Vilaine), rouvre ses portes pour la saison estivale dès aujourd’hui"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
