                "translations": [
                    {
                        "translation_id": "c0eb0301-9f50-4612-b56a-77be49ce8203",
                        "source_entry_id": "6079e010-f115-3d57-adf0-13ee8284dc0f",
                        "source_sense_description": "действие по значению гл. обветшать",
                        "target_lang_word": "délabrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délabrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                        "entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                                        "glosses": [
                                            "Action de ce qui se délabre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0527dd53-4ef4-4737-9bd1-9757f01f4b8b",
                                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                                "text": "Elle se sent déjà engloutie dans le délabrement d'une caravane qui, à chaque kilomètre, se détraquera un peu plus."
                                            },
                                            {
                                                "example_id": "adae2043-6fb2-4d1b-9338-d9baae5427c0",
                                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                                "text": "Savourer encore quarante pages de Mustang, c’est un meilleur rapport qualité-prix que pour tant d’œuvres littéraires qu’on se doit de lire sous peine de délabrement intellectuel."
                                            },
                                            {
                                                "example_id": "787a57cd-4fe9-4fa3-8c92-64aff3772b83",
                                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                                "text": "Le délabrement de ses affaires."
                                            },
                                            {
                                                "example_id": "422eb991-f741-4c8f-9041-9a79ea6e201e",
                                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                                "text": "Le délabrement de sa santé."
                                            },
                                            {
                                                "example_id": "7dc3ad46-efd6-431a-9e4f-1cd967a56252",
                                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                                "text": "On avait reproché à Zola d’avoir noté que se rendant à Sedan pour y signer sa capitulation devant Bismarck, Napoléon III s’était maquillé pour masquer le délabrement de sa santé inscrit sur son visage. Schöndorfer rappelle qu’à Diên Biên Phu le général de Lattre de Tassigny se maquillait lui aussi pour les mêmes raisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "984a531b-5cef-3cde-a569-3833864695bb",
                                        "entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                                        "glosses": [
                                            "État de ce qui est délabré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b2e83f-3f7f-459d-be46-d6f6579092cb",
                                                "sense_id": "984a531b-5cef-3cde-a569-3833864695bb",
                                                "text": "La tuberculose, la sous-alimentation décimaient ces victimes de la guerre et elles nous arrivaient dans un état de délabrement, de dénuement total."
                                            },
                                            {
                                                "example_id": "9370fce0-75ad-4132-9230-dedc94395758",
                                                "sense_id": "984a531b-5cef-3cde-a569-3833864695bb",
                                                "text": "D'autres seront déportés pour fait de résistance : Benoît Jean, Bombardier Gabriel, Vouaux Jean. Souvent, dans un état de délabrement physique à leur retour, ils retrouveront leur village meurtri, par l’occupation et les luttes qui y eurent lieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f504200-1a0a-4eb8-80c7-17edc65f785e",
                        "source_entry_id": "6079e010-f115-3d57-adf0-13ee8284dc0f",
                        "source_sense_description": "действие по значению гл. обветшать",
                        "target_lang_word": "dégradation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégradation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Destitution, privation infamante du grade, de la dignité que l’on a."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb27cf6-2540-4ea2-a5d5-6c3132b61186",
                                                "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                                                "text": "Je ne veux pas encourir la sentence de la dégradation, ni même perdre mon office pour l’amour d’une poupée juive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Avilissement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7eb989d-d02c-4715-bae8-0affb6c5dfca",
                                                "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                                                "text": "La dégradation des âmes est une suite de la servitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Dégât, détérioration plus ou moins considérable qu’on fait dans une propriété publique ou privée, dans une maison, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aad5447-ffd5-4d24-ad9e-0d0ef9ad8b67",
                                                "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                                                "text": "Il fit faire un procès-verbal des dégradations qui avaient été commises dans son domaine. - Le locataire de cet appartement y a fait beaucoup de dégradations. - La dégradation des monuments publics est punie par la loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Dépérissement où est une chose, dommage qu’elle a éprouvé par l’effet de la vétusté ou d'un accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29995ef-778f-48a5-9e8f-556274915bb1",
                                                "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                                "text": "Parmi les facteurs locaux, nous citerons d'abord la dégradation des pâturages causée par les abus de la transhumance, d'immenses troupeaux ayant été amenés des pays du Sud por y trouver, pendant l'été, leur pâture."
                                            },
                                            {
                                                "example_id": "9a90541d-8d9e-4fed-ae08-f9bed7c2c0f4",
                                                "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                                "text": "Les relations entre écoulement et surface des bassins dépendent largement de l'état de dégradation des réseaux hydrographiques et des endoréismes locaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Affaiblissement graduel de la lumière, des ombres, des couleurs dans un dégradé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63cf3378-488c-4628-9a42-e6b9b3bae09f",
                                                "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                                "text": "Elle portait à la main une petite lampe de la forme de celles qu’on met dans les tombeaux, dont la lueur donnait à ses doigts effilés une transparence rose qui se prolongeait par une dégradation insensible jusque dans la blancheur opaque et laiteuse de son bras nu."
                                            },
                                            {
                                                "example_id": "c5dc8adf-f190-4ac5-bc4c-98dcf67c9300",
                                                "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                                "text": "En ce moment de la journée, les lentes dégradations de la lumière semblent réveiller les sentiments doux ; …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
