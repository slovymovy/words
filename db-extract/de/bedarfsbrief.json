                "senses": [
                    {
                        "sense_id": "fe2e23a7-7952-3106-b812-4dc4108dba1d",
                        "entry_id": "f0c9360e-b77d-35ed-8fef-f1c64fd8dfe7",
                        "glosses": [
                            "Brief, der aufgrund des Mitteilungsbedürfnisses des Absenders verfasst und verschickt wird/wurde (und nicht etwa für Sammlerzwecke)"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "2e018233-af6f-45a1-92de-5cd62121bf26",
                                "sense_id": "fe2e23a7-7952-3106-b812-4dc4108dba1d",
                                "text": "„Da es sich hier zumeist um Bedarfsbriefe ohne Sammlerhintergrund handelt, ist der Erhaltungszustand von »gemachten« Ersttagsbriefen natürlich nicht zu erwarten.“"
                            },
                            {
                                "example_id": "8aba99d4-e514-4ec2-b63e-38eef8786d38",
                                "sense_id": "fe2e23a7-7952-3106-b812-4dc4108dba1d",
                                "text": "„In Estland und Litauen entstanden auch Lokalposten: echte Bedarfsbriefe sind jedoch nur wenige bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
