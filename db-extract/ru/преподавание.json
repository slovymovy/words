                    {
                        "translation_id": "4b714bcb-a3d9-486a-9a37-2bdb0ce7af10",
                        "source_entry_id": "b3608f5d-5dd4-3aa9-8035-813fac1cdc2d",
                        "source_sense_id": "3c0c0aff-9e40-39ed-8d9a-a7fe4a82b66d",
                        "target_lang_word": "Unterricht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterricht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3765d8e-fda7-3bea-bd47-ddd2a5558da2",
                                        "entry_id": "6d69247e-dfe5-3f29-8c6d-791ff02fb082",
                                        "glosses": [
                                            "regelmäßige und planvolle Weitergabe von Wissen, Information und Fähigkeiten von einem oder mehreren Lehrern an einen oder mehr Schüler"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8cc13b4-7067-461f-bb64-ca6bf2eeec75",
                                                "sense_id": "e3765d8e-fda7-3bea-bd47-ddd2a5558da2",
                                                "text": "Der Unterricht in Hauswirtschaft ist bei den Jungen meist nicht sehr beliebt."
                                            },
                                            {
                                                "example_id": "30b27d80-2820-4310-8dfa-521a12c43974",
                                                "sense_id": "e3765d8e-fda7-3bea-bd47-ddd2a5558da2",
                                                "text": "„Ohne weitere Störung beendeten sie den Unterricht.“"
                                            },
                                            {
                                                "example_id": "2bdc8c8f-0b9c-49c1-874e-0c517687f015",
                                                "sense_id": "e3765d8e-fda7-3bea-bd47-ddd2a5558da2",
                                                "text": "„Sie gerät dann in den Unterricht Hainstocks.“"
                                            },
                                            {
                                                "example_id": "362ab988-70ae-4174-86df-bcec25e0b81d",
                                                "sense_id": "e3765d8e-fda7-3bea-bd47-ddd2a5558da2",
                                                "text": "„Er freut sich über das erste Geld, das er mit dem Unterricht verdient hat, und sie fahren nach Avallon.“"
                                            },
                                            {
                                                "example_id": "e4f62ae3-af28-474b-b606-6852521e5c05",
                                                "sense_id": "e3765d8e-fda7-3bea-bd47-ddd2a5558da2",
                                                "text": "„In der Literatur bisher weniger beachtet wurden die in den siebziger Jahren entwickelten Curricula […] zu einem mehrperspektivischen Unterricht […], in denen Lernen in Projekten und Kursen das grundlegende Vermittlungsverfahren ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b732281e-3d6d-4136-9f3d-c502e4ec8d30",
                        "source_entry_id": "b3608f5d-5dd4-3aa9-8035-813fac1cdc2d",
                        "source_sense_id": "3c0c0aff-9e40-39ed-8d9a-a7fe4a82b66d",
                        "target_lang_word": "Lehre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60c9c6f2-c0e0-37d6-9a0e-83532dfc6f94",
                                        "entry_id": "1e9c9656-a8bf-3ce3-8d26-df49cbe64c84",
                                        "glosses": [
                                            "sprachliche Darstellung eines Wissensgebietes in Lehrbüchern oder Vorträgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cb75944-fc87-474d-bb20-9cbb32b0283f",
                                                "sense_id": "60c9c6f2-c0e0-37d6-9a0e-83532dfc6f94",
                                                "text": "„Jede Lehre unterliegt nun aber, wie man weiß, auf Seiten der Benutzer solcher Stilbücher dem nicht immer mühelosen Zwang des Lernens.“"
                                            },
                                            {
                                                "example_id": "54c3ca2e-1531-4010-83b2-5d0a42ce0f0a",
                                                "sense_id": "60c9c6f2-c0e0-37d6-9a0e-83532dfc6f94",
                                                "text": "Die Lehre der Astrophysik ist ein Wissenszweig mit Zukunft."
                                            },
                                            {
                                                "example_id": "e6c664d4-6bc1-409b-97c9-bb0f6612c42d",
                                                "sense_id": "60c9c6f2-c0e0-37d6-9a0e-83532dfc6f94",
                                                "text": "„Es mag sein, daß Galilei auch jetzt noch nicht die volle Tragweite der Verurteilung der kopernikanischen Lehre erfaßt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc6123db-07d6-35ee-85a7-9b6c0d89630c",
                                        "entry_id": "1e9c9656-a8bf-3ce3-8d26-df49cbe64c84",
                                        "glosses": [
                                            "Ausbildung, in der man durch Anleitung und Unterweisung Wissen und Können erwirbt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de953520-b224-434e-aa14-51c6c48ce4ff",
                                                "sense_id": "bc6123db-07d6-35ee-85a7-9b6c0d89630c",
                                                "text": "Hans beginnt seine Lehre zum KFZ-Mechaniker im Frühjahr."
                                            },
                                            {
                                                "example_id": "807ddd03-f6b0-47cd-b470-565111dc5d3f",
                                                "sense_id": "bc6123db-07d6-35ee-85a7-9b6c0d89630c",
                                                "text": "„Oft handelt es sich um kontrastive Darstellungen, die zur Erhöhung der kommunikativen Kompetenz der Deutschlehrer und -studenten in der Lehre, im Studium und im Alltag beitragen.“"
                                            },
                                            {
                                                "example_id": "95bdb61f-8523-445d-b4aa-6d2076f47598",
                                                "sense_id": "bc6123db-07d6-35ee-85a7-9b6c0d89630c",
                                                "text": "„Der Vater, davon war er fest überzeugt, wusste nicht, dass man ihn nicht in die Lehre ließ.“"
                                            },
                                            {
                                                "example_id": "5b4c1422-f0ee-4425-95c3-35a4463f6965",
                                                "sense_id": "bc6123db-07d6-35ee-85a7-9b6c0d89630c",
                                                "text": "„Meine Kriterien für die Aufnahme von Texten resultierten aus meiner Eigenschaft als Erzählforscher und einer durch Lehre und Forschung erzielten langen Vertrautheit mit den humoristichen Gattungen der Volksliteratur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ede53f5a-ece4-342e-a8b5-740c43e6e7a9",
                                        "entry_id": "1e9c9656-a8bf-3ce3-8d26-df49cbe64c84",
                                        "glosses": [
                                            "Erfahrung meist negativer Art, aus der man etwas gelernt hat oder zumindest etwas hätte lernen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b4f034-241d-41e9-8779-d4a6e611b1ce",
                                                "sense_id": "ede53f5a-ece4-342e-a8b5-740c43e6e7a9",
                                                "text": "Das soll mir eine Lehre sein."
                                            },
                                            {
                                                "example_id": "d11324e2-ea78-4c83-b9c1-799bd2360db8",
                                                "sense_id": "ede53f5a-ece4-342e-a8b5-740c43e6e7a9",
                                                "text": "Aus dem Vorfall habe ich eine Lehre gezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lehre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf178f0-3f51-32fe-834e-60cebfe8641f",
                                        "entry_id": "17ac06b1-4142-3fe8-9488-ee19aed058b5",
                                        "glosses": [
                                            "Werkzeug zum Vermessen"
