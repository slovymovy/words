                                "target_senses": [
                                    {
                                        "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                        "entry_id": "edb6e241-f4ce-3989-bcc5-c7f93acefc77",
                                        "glosses": [
                                            "Rinne, Kanal entlang einer Landstraße zum Abfluss von Regenwasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2ca798-a6b2-4751-a09a-3e6fea03d4ce",
                                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                                "text": "„Als er in einem Straßengraben gefunden wurde, schwebte der Mann nach Angaben der Polizei in Lebensgefahr.“"
                                            },
                                            {
                                                "example_id": "47d7fe0f-ebcd-4edc-9b36-5252e837449e",
                                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                                "text": "„Im Straßengraben fanden wir ein dunkelgrünes Buch.“"
                                            },
                                            {
                                                "example_id": "449a72d7-7d78-4144-9a42-8480a874ccb3",
                                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                                "text": "„Ich legte mich in dem flachen Straßengraben auf den Tornister.“"
                                            },
                                            {
                                                "example_id": "a298ce17-b5f2-4be4-9e5c-96a3f12da747",
                                                "sense_id": "4280ce67-8c5e-343b-ba4d-0c1b37b9d1f0",
                                                "text": "„Im Straßengraben schaufelten sie eine Grube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1a43450-c688-4df9-9f82-a1d0d1d05b81",
                        "source_entry_id": "e2a35f33-c56c-36bf-a298-3ffa2ee6c361",
                        "source_sense_id": "44e66622-5c12-37a4-bda7-76329e9e75e3",
                        "source_sense_description": "een smalle, ondiepe uitgraving in de grond voor de afvoer van teveel water",
                        "target_lang_word": "Wassergraben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wassergraben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8023f63a-8bbc-3b8f-bf15-74fc90143269",
                                        "entry_id": "7d2ff059-c56b-3cba-957d-935d8313ec30",
                                        "glosses": [
                                            "mit Wasser gefüllter Graben, als Hindernis oft um ein Schloss oder eine Burg herumgebaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecb2943-dc87-4fd5-9910-958c2e003b23",
                                                "sense_id": "8023f63a-8bbc-3b8f-bf15-74fc90143269",
                                                "text": "Um den Wassergraben noch unüberwindlicher zu machen, wurden darin Krokodile ausgesetzt."
                                            },
                                            {
                                                "example_id": "79de6d18-49d0-4a09-9069-d1785966d1c5",
                                                "sense_id": "8023f63a-8bbc-3b8f-bf15-74fc90143269",
                                                "text": "„Damals wurden auch die Stadtmauern als Murus Gallicus mit vorgelagertem Wassergraben angelegt.“"
                                            },
                                            {
                                                "example_id": "4a5bb40e-ff2b-41bf-822f-462304964079",
                                                "sense_id": "8023f63a-8bbc-3b8f-bf15-74fc90143269",
                                                "text": "„Weil die Wasserleitungen zerbombt waren, bildeten sich überall Eimerketten, mit denen das Wasser aus dem Hallenbad und dem örtlichen Wassergraben herangeschafft wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b74e1b79-5b57-3d82-8648-77c56bc22f5f",
                                        "entry_id": "7d2ff059-c56b-3cba-957d-935d8313ec30",
                                        "glosses": [
                                            "Erdaushub, um aus der Fläche Wasser abzuleiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79dbd57c-de70-40fa-b63c-178d342b84f2",
                                                "sense_id": "b74e1b79-5b57-3d82-8648-77c56bc22f5f",
                                                "text": "In der Marsch dienen Wassergräben der Entwässerung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "39fff00d-0924-3c3a-bc35-c5f50a74f630",
                                        "entry_id": "7d2ff059-c56b-3cba-957d-935d8313ec30",
                                        "glosses": [
                                            "Hindernis beim Springreiten oder Hindernislauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59972724-9890-40ea-ba8c-8862f2a78022",
                                                "sense_id": "39fff00d-0924-3c3a-bc35-c5f50a74f630",
                                                "text": "Beim Sport sind Wassergräben als künstliche Hindernisse vorgesehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46ae7506-c093-4425-8850-d6e8ee6842ba",
                        "source_entry_id": "e2a35f33-c56c-36bf-a298-3ffa2ee6c361",
                        "source_sense_id": "44e66622-5c12-37a4-bda7-76329e9e75e3",
                        "source_sense_description": "een smalle, ondiepe uitgraving in de grond voor de afvoer van teveel water",
                        "target_lang_word": "канава",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "канава",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                        "entry_id": "2f2b7b99-176c-31d5-bb28-22f201b97045",
                                        "glosses": [
                                            "протяжённая неглубокая выемка в грунте, обычно предназначенная для направления потока воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ac6d1b-82bd-4b79-ae3a-a28a9857b3b8",
                                                "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                                "text": "В мае сточную канаву засыпают: прибыль воды прекращается."
                                            },
                                            {
                                                "example_id": "e1ac15f3-ca2e-43b3-b77b-1b1f06767d53",
                                                "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                                "text": "И не зря: здесь кустарник подходил вплотную к дороге, а от трубы тянулась канава, и была эта канава, похоже, достаточно глубока, чтобы меня скрыть."
                                            },
                                            {
                                                "example_id": "a05b7404-4559-460c-913e-e46f522e0831",
                                                "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                                "text": "Землянка была устроена следующим, вошедшим тогда в моду, способом: прорывалась канава в полтора аршина ширины, два — глубины и три с половиной длины. С одного конца канавы делались ступеньки, и это был сход, крыльцо; сама канава была комната, в которой у счастливых, как у эскадронного командира, в дальней, противуположной ступеням стороне, лежала на кольях, доска — это был стол."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb5aebc-c56a-3106-a8b6-2f7732967fa0",
                                        "entry_id": "2f2b7b99-176c-31d5-bb28-22f201b97045",
                                        "glosses": [
                                            "ров, вырытый для обозначения границ земельных участков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bfbfa1c-0a57-44a5-abf3-a6f1bae82294",
                                                "sense_id": "beb5aebc-c56a-3106-a8b6-2f7732967fa0",
                                                "text": "Ещё осенью землекопы рыли около Прогонной межевую канаву и прохарчили в трактире 18 рублей, и теперь нужно было застать в Шутейкине их подрядчика и получить с него эти деньги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                        "entry_id": "2f2b7b99-176c-31d5-bb28-22f201b97045",
                                        "glosses": [
                                            "устар. наполненное водой искусственное русло, устраиваемое в грунте для судоходной связи между отдельными водоёмами, а также для водоснабжения, орошения, осушения болот и т. п.; канал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c1922c-6896-4eb4-a020-cd11bcbe215f",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "Вот, идем мы теперь мимо адмиралтейской крепостцы: небось не перемахнешь чрез валики, даром что водица в канавах заморожена."
                                            },
                                            {
                                                "example_id": "bf8c9ed7-e253-4a46-b2e7-0fb843c844e3",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "Работы производятся следующим образом: сперва запружают исток канала и прерывают сообщение его с Нилом; затем, чрез каждые 150 или 200 фут, устраивают поперек русла невысокие земляные плотинки; и наконец, вдоль и параллельно берегу канала, проводят узкую канаву."
                                            },
                                            {
                                                "example_id": "01745cf0-d3f4-4ada-9f84-4da05add7a15",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "С обеих сторон сих аллей было по три острова, четвероугольных, равной величины, разделенных между собою вновь прокопанными канавами, наполненными тогда ещё чистой, проточной водой и соединёнными деревянными мостиками."
                                            },
                                            {
                                                "example_id": "fdeda042-b173-4ae5-9a0e-7e8c6cd80722",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "До недавнего времени не знали, как возвращать здоровье таким полянам; но теперь открыто средство; это ― дренаж: лишняя вода сбегает по канавам, остается воды сколько нужно, и она движется, и поляна получает реальность."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24be7765-4a09-48e1-b2f0-6fa3e696c0f5",
                        "source_entry_id": "e2a35f33-c56c-36bf-a298-3ffa2ee6c361",
