                    {
                        "translation_id": "0bbd7c42-aa4a-4cde-8c15-af84ddf7073b",
                        "source_entry_id": "90140dc3-6983-3e39-8ed4-8bd2062ab641",
                        "source_sense_id": "c2ec713e-6d05-3151-94c0-c46b15842913",
                        "source_sense_description": "Wirtschaft: eine vom Staat zur Banknotenausgabe ermächtigte Bank",
                        "target_lang_word": "banque centrale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banque centrale",
