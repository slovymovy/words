                                "target_senses": [
                                    {
                                        "sense_id": "314c0590-d96b-32f1-a500-4b4da48d2ba9",
                                        "entry_id": "958b6a05-a38a-385e-b4dc-796438702d9f",
                                        "glosses": [
                                            "Monnaie de la Hongrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3bed68-7375-4d45-8179-7cfd08b7d756",
                                                "sense_id": "314c0590-d96b-32f1-a500-4b4da48d2ba9",
                                                "text": "Mille forints, c’est combien d’euros ?"
                                            },
                                            {
                                                "example_id": "91f2be3e-862a-436d-87b1-b2fd1f0b4e35",
                                                "sense_id": "314c0590-d96b-32f1-a500-4b4da48d2ba9",
                                                "text": "Le forint hongrois est totalement convertible avec les autres devises depuis 2001."
                                            },
                                            {
                                                "example_id": "da813fcd-12b7-4aa6-8136-0ba362e264a9",
                                                "sense_id": "314c0590-d96b-32f1-a500-4b4da48d2ba9",
                                                "text": "Un argent dont la Hongrie, en proie à une inflation galopante et une monnaie, le forint, en chute libre, a plus que jamais besoin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
