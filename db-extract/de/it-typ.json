                "senses": [
                    {
                        "sense_id": "6aa9eb7a-71be-330d-8cd2-fe7c56fef88c",
                        "entry_id": "611801df-88fb-3f08-955f-fa18f5c367b3",
                        "glosses": [
                            "für Informatik zuständige, mit Informatik arbeitende Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "79e64436-5a91-49c3-87e2-dae0f24b0224",
                                "sense_id": "6aa9eb7a-71be-330d-8cd2-fe7c56fef88c",
                                "text": "„Seine Assistenten und Helfer hatten in der Telefonzentrale und bei den IT-Typen nachgefragt: Die Telefone und Server funktionierten einwandfrei.“"
                            },
                            {
                                "example_id": "a919e289-f175-4893-8ba9-ae6f1ada327a",
                                "sense_id": "6aa9eb7a-71be-330d-8cd2-fe7c56fef88c",
                                "text": "„\"Ich war der erste IT-Typ in Leipzig\", sagt er.“"
                            },
                            {
                                "example_id": "5f5a37a5-8515-4c0d-8d1f-588712051d82",
                                "sense_id": "6aa9eb7a-71be-330d-8cd2-fe7c56fef88c",
                                "text": "„Das klassische Bild vom nerdigen IT-Typ hat sich geändert, dennoch bleibt das Stereotyp.“"
                            },
                            {
                                "example_id": "204b76c2-d547-438b-95c7-8c813df07b77",
                                "sense_id": "6aa9eb7a-71be-330d-8cd2-fe7c56fef88c",
                                "text": "„Mustafa ist ein IT-Typ, Mitte 20, Bart, Mütze, Typus Hipster.“"
                            },
                            {
                                "example_id": "e64d7f5a-7067-4c03-9c3b-74f36160c85e",
                                "sense_id": "6aa9eb7a-71be-330d-8cd2-fe7c56fef88c",
                                "text": "„Kannst du dich daran erinnern, dass ich dir gestern gesagt habe, dass ich ein IT-Typ bin?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
