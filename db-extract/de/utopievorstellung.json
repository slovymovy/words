                "senses": [
                    {
                        "sense_id": "b1ad0870-06a8-3e56-8b18-cfa2167cb39a",
                        "entry_id": "07768327-7edf-37ea-9a1e-b9a1d021f372",
                        "glosses": [
                            "Vorstellung einer fiktiven Lebens- oder Gesellschaftsform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9014ca73-1c47-4861-90e1-8ebc9840e624",
                                "sense_id": "b1ad0870-06a8-3e56-8b18-cfa2167cb39a",
                                "text": "„Er erarbeitet die darin angelegte neue Konzeption und Praxis von Utopievorstellungen gegenüber tradierten aus der Moderne stammenden Darstellungen von Utopien.“"
                            },
                            {
                                "example_id": "8602339a-394e-43f4-9e9c-e620582e9dda",
                                "sense_id": "b1ad0870-06a8-3e56-8b18-cfa2167cb39a",
                                "text": "„Utopievorstellungen, Paradoxa und Leugnungen sind dabei keine guten Lösungsansätze.“"
                            },
                            {
                                "example_id": "a86be1e2-bfa3-4bfd-ad4b-1017cd11b6df",
                                "sense_id": "b1ad0870-06a8-3e56-8b18-cfa2167cb39a",
                                "text": "„Sie versuchen ihn als einen Psychologen zu deuten, Parallelen zwischen ihm und seinem Romanheld zu ziehen und seine Utopievorstellung zu demonstrieren.“"
                            },
                            {
                                "example_id": "17430643-5e41-4688-8b65-2c098590a733",
                                "sense_id": "b1ad0870-06a8-3e56-8b18-cfa2167cb39a",
                                "text": "„Dabei spielen mitunter (gesellschaftliche) Visionen und Utopievorstellungen eine Rolle.““"
                            },
                            {
                                "example_id": "ed0e0195-ffdc-410c-9af9-5956e3a15a71",
                                "sense_id": "b1ad0870-06a8-3e56-8b18-cfa2167cb39a",
                                "text": "„Utopievorstellungen einer Gesellschaft werden regelmäßig soziologisch oder psychologisch untersucht und zum Beispiel statistisch mit SPSS ausgewertet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
