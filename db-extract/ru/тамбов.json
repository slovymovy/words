                                "sense_id": "8e5ed1a1-a3b9-3709-8026-0ff3422915c8",
                                "text": "Тамбов на карте генеральной // Кружком означен не всегда"
                            },
                            {
                                "example_id": "47136210-8a52-42ff-9036-5e7755f631db",
                                "sense_id": "8e5ed1a1-a3b9-3709-8026-0ff3422915c8",
                                "text": "Я родом из Тамбова."
                            },
                            {
                                "example_id": "86d7a962-4616-4e51-8e0e-52a922a29b16",
                                "sense_id": "8e5ed1a1-a3b9-3709-8026-0ff3422915c8",
                                "text": "Он завтра уедет в Тамбов."
                            }
                        ]
