    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "935e46b9-df5d-353d-85b6-bf240926971f",
                    "sense_definition": "actie ondernemen om iets of iemand uit een gevaarlijke situatie of uit de moeilijkheden te halen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hulp verlenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweerman kon het kleine kind net op tijd uit het brandende huis <w>redden</w>.",
                            "target_lang_translations": {
                                "en": "The firefighter was able to <w>rescue</w> the small child from the burning house just in time."
                            }
                        },
                        {
                            "text": "De kustwacht moest uitrukken om de bemanning van het zinkende schip te <w>redden</w>.",
                            "target_lang_translations": {
                                "en": "The coast guard had to go out to <w>save</w> the crew of the sinking ship."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevrijden",
                        "verlossen",
                        "helpen"
                    ],
                    "common_phrases": [
                        "iemand redden",
                        "het leven redden"
                    ],
                    "target_lang_definitions": {
                        "en": "to take action to get someone or something out of a dangerous situation or difficulty"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "save",
                                "target_lang_sense_clarification": "to help someone survive or prevent harm"
                            },
                            {
                                "target_lang_word": "rescue",
                                "target_lang_sense_clarification": "to free from danger or confinement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "385a5197-426d-361d-81ab-ae04469b3163",
                    "sense_definition": "zichzelf kunnen helpen in een bepaalde situatie; het alleen aankunnen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zelfstandigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Maak je geen zorgen over mij, ik <w>red</w> me wel alleen in de grote stad.",
                            "target_lang_translations": {
                                "en": "Don't worry about me, I will <w>manage</w> just fine on my own in the big city."
                            }
                        },
                        {
                            "text": "Zal je het alleen <w>redden</w> met al die zware tassen of moet ik even helpen?",
                            "target_lang_translations": {
                                "en": "Will you <w>cope</w> alone with all those heavy bags, or should I help for a moment?"
                            }
                        }
                    ],
                    "synonyms": [
                        "rondkomen",
                        "bolwerken",
                        "behelpen"
                    ],
                    "antonyms": [
                        "bezwijken",
                        "falen"
                    ],
                    "common_phrases": [
                        "zich redden",
                        "het wel redden"
                    ],
                    "target_lang_definitions": {
                        "en": "to be able to help oneself in a certain situation; to manage on one's own"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manage",
                                "target_lang_sense_clarification": "to cope or handle a situation alone"
                            },
                            {
                                "target_lang_word": "cope",
                                "target_lang_sense_clarification": "to deal effectively with something difficult"
                            },
                            {
                                "target_lang_word": "get by",
                                "target_lang_sense_clarification": "to survive or manage with limited resources"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be09511a-fdb0-33df-ab23-9be2279745ff",
                    "sense_definition": "meervoud verleden tijd van <w>redden</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de storm vorig jaar uitbrak, <w>redden</w> de buren al onze spullen uit de tuin.",
                            "target_lang_translations": {
                                "en": "When the storm broke out last year, the neighbors <w>saved</w> all our things from the garden."
                            }
                        },
                        {
                            "text": "Wij <w>redden</w> het vorig jaar financieel alleen dankzij een extra lening van de bank.",
                            "target_lang_translations": {
                                "en": "We only <w>managed</w> financially last year thanks to an extra loan from the bank."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural past tense of 'redden' (to save/manage)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saved",
                                "target_lang_sense_clarification": "past tense of rescuing or preserving"
                            },
                            {
                                "target_lang_word": "managed",
                                "target_lang_sense_clarification": "past tense of handling a situation"
                            }
                        ]
                    }
                }
            ]
