                        "entry_id": "48e74c35-ab05-313e-b969-5146ad37a766",
                        "glosses": [
                            "rodzaj miękkiej w dotyku, nasiąkliwej skóry z delikatnym meszkiem (często owczej lub jeleniej)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309858b7-b90a-4eb7-ac3f-188cbc968edd",
                                "sense_id": "7e35ace9-7785-3843-891b-9525dc0f1072",
                                "text": "Postawny, dobrze zbudowany młody mężczyzna, którego można by posądzić o lekką nadwagę, na nogach miał mokasyny z brązowego zamszu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
