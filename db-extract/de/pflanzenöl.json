                        "source_sense_id": "b58e2316-646f-38c8-b7a7-5e08a6e53660",
                        "source_sense_description": "Öl, das aus bestimmten Pflanzenteilen, wie Samen und Früchten, gewonnen wird",
                        "target_lang_word": "растительное масло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "растительное масло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6ccf56-6c14-3322-a89a-f8ce1e703784",
                                        "entry_id": "c116e477-95ad-3996-bbf0-99ddb4c6993e",
                                        "glosses": [
                                            "масло, получаемое из семян, плодов или коры некоторых видов растений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e2a9c9-9c37-4317-8d78-b209aa5da183",
                                                "sense_id": "ae6ccf56-6c14-3322-a89a-f8ce1e703784",
                                                "text": "Чернила для печатания выделываются из древесной сажи, смешанной с растительным маслом."
                                            },
                                            {
                                                "example_id": "adc9fd3d-8f4d-451a-b47f-2b1381a5d401",
                                                "sense_id": "ae6ccf56-6c14-3322-a89a-f8ce1e703784",
                                                "text": "В земле ашантиев растёт дерево, похожее на наш клён, выделяющее из коры растительное масло, весьма вкусное и прекрасно сохраняющееся, несмотря на жару."
                                            },
                                            {
                                                "example_id": "fbb682b8-71b4-4c01-a23e-012e34c1c6d4",
                                                "sense_id": "ae6ccf56-6c14-3322-a89a-f8ce1e703784",
                                                "text": "Ян Ван Эйк не был первым человеком, попытавшимся использовать в живописи растительное масло."
                                            },
                                            {
                                                "example_id": "bd0810f7-0f35-4cf3-aed0-ee18e141e4dc",
                                                "sense_id": "ae6ccf56-6c14-3322-a89a-f8ce1e703784",
                                                "text": "Возьми любое растительное масло (подсолнечное, оливковое или кукурузное) и смешай с молотым геркулесом либо с манной крупой или панировочными сухарями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
