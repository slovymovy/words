                        "glosses": [
                            "The absence (or loss) of pigmentation in the hair."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5af21918-6666-48f6-a352-7eb6644a85e3",
                                "sense_id": "e6fcd8dc-c031-3505-9c72-7dcf4189ec2a",
                                "text": "Severe achromotrichia (graying) and alopecia (loss of hair) were produced in weanling and adult black mice […]"
                            },
                            {
                                "example_id": "dfbb2568-a654-46b9-a355-bbe84bc3aa93",
                                "sense_id": "e6fcd8dc-c031-3505-9c72-7dcf4189ec2a",
                                "text": "Most pantothenic acid-deficient laboratory animals exhibit dermatitis, achromotrichia, and nasal porphyrin excretion."
                            },
                            {
                                "example_id": "60ae1330-e0a5-4b12-881b-5dff10abf666",
                                "sense_id": "e6fcd8dc-c031-3505-9c72-7dcf4189ec2a",
                                "text": "Clinical signs of biotin deficiency include accumulation of salivary, nasal, and lachrymal secretions, progressive alopecia, achromotrichia, dermatitis, body weight loss, and diarrhea in the terminal stages of the deficiency."
                            }
                        ]
                    }
