                        "target_lang_word": "meublé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meublé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac23ee6d-960c-3309-a15c-c03367f785dd",
                                        "entry_id": "7eb35a07-65c1-355c-a3f4-1402ae1e9c8b",
                                        "glosses": [
                                            "Garni de meubles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213c9d7e-97cd-4fdb-9e8c-fe5d7398ec53",
                                                "sense_id": "ac23ee6d-960c-3309-a15c-c03367f785dd",
                                                "text": "Ils nous conseillèrent d’aller en face « juste en face, où il y a un écriteau » et ils nous apprirent que les chambres meublées étaient pour les gens qui n’en avaient pas."
                                            },
                                            {
                                                "example_id": "80ad6abe-af2d-4118-b844-58962b949876",
                                                "sense_id": "ac23ee6d-960c-3309-a15c-c03367f785dd",
                                                "text": "Comme tout bistro qui se respecte, celui-ci réservait aux habitués une arrière-salle et deux étages de chambres meublées […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meublé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14daeed2-da3f-36ec-8232-408fb9a12e1e",
                                        "entry_id": "f71a86a1-66a4-3d97-b95c-9accda58c8df",
                                        "glosses": [
                                            "Appartement loué avec du mobilier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdcf2f22-3659-4d1b-b7e3-3a6be4697991",
                                                "sense_id": "14daeed2-da3f-36ec-8232-408fb9a12e1e",
                                                "text": "Ma voisine habite dans un meublé."
                                            },
                                            {
                                                "example_id": "3c263df5-a426-463c-ac45-3e15015c6204",
                                                "sense_id": "14daeed2-da3f-36ec-8232-408fb9a12e1e",
                                                "text": "Cela aurait pu prendre encore du temps, mais, aux « garnis », Janvier avait retrouvé le nom d’Emile Paulus, de Limoges, inscrit depuis quatre mois dans un meublé de la rue Lhomond."
                                            },
                                            {
                                                "example_id": "0afc86b1-0ef9-4f9f-8682-d3c30f445c84",
                                                "sense_id": "14daeed2-da3f-36ec-8232-408fb9a12e1e",
                                                "text": "– Il faut sous-louer cet appartement en meublé. Cela peut être d’un très bon rapport."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meublé",
                                "target_lang_code": "fr",
                                "target_senses": [
