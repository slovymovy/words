                "senses": [
                    {
                        "sense_id": "2fb07245-c3c8-3cb2-98f8-f7d06e1db61b",
                        "entry_id": "62d5398f-623e-37f3-83bf-71ee96ada244",
                        "glosses": [
                            "grammatisches Morphem, das in seiner Form einem Lexem gleicht, aber nicht die Bedeutung dieses Lexems hat und wie ein Affix für die Ableitung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f7f98a3-cd99-459e-b030-45cab32d2d19",
                                "sense_id": "2fb07245-c3c8-3cb2-98f8-f7d06e1db61b",
                                "text": "In dem Lexem „Laubwerk“ ist „-werk“ ein Affixoid; es sieht aus wie das Substantiv „Werk“ (Fabrik), hat aber nicht diese Bedeutung. Es bedeutet stattdessen hier „Menge von (Laub)“."
                            },
                            {
                                "example_id": "02f6e7cd-a830-430a-8113-9fb27f92cc0e",
                                "sense_id": "2fb07245-c3c8-3cb2-98f8-f7d06e1db61b",
                                "text": "„Der Oberbegriff von Suffixoid und Präfixoid ist Affixoid.“"
                            },
                            {
                                "example_id": "06e082d5-58e8-4a69-8f6f-a42b744203d2",
                                "sense_id": "2fb07245-c3c8-3cb2-98f8-f7d06e1db61b",
                                "text": "„Die Bedeutung der Affixoide ist verallgemeinert und tritt nur in der gebundenen Morphemvariante auf.“"
                            },
                            {
                                "example_id": "7e7db75a-3227-4d84-bbc3-1d019b685079",
                                "sense_id": "2fb07245-c3c8-3cb2-98f8-f7d06e1db61b",
                                "text": "„Außer der semantischen Spezifik werden als weitere, im einzelnen unterschiedlich ausgeprägte Merkmale der Affixoide Reihenbildung, eine charakteristische Distribution, komplementäres Zusammenwirken mit Wortbildungsmorphemen und ein besonderes ‚phonologisches Verhalten‘ genannt(…)“"
                            },
                            {
                                "example_id": "6bc2acfb-e898-4500-891a-acdfd2cf2b22",
                                "sense_id": "2fb07245-c3c8-3cb2-98f8-f7d06e1db61b",
                                "text": "Bei den Suffixoiden tritt häufig die Schwierigkeit auf, eine ausreichende Bedeutungsdistanz zum Ausgangswort bzw. Kompositionsglied zu finden, was Voraussetzung für die Bestimmung eines Affixoides ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
