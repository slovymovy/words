                    },
                    {
                        "translation_id": "ab2750da-3251-4bbd-ba3b-332313e75c88",
                        "source_entry_id": "f7ae582d-97d1-3a2a-832d-0e24e294ab53",
                        "source_sense_id": "9b2663a6-9790-3238-91e6-64bd8abff296",
                        "source_sense_description": "small boat that is rowed",
                        "target_lang_word": "barque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Petit bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b4b398-e528-4e69-bc66-7c249dc50a63",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "Ayant acquis la preuve des relations qui existaient entre Césaire et les assiégeants, les habitants décidèrent de déposer l’évêque dans une barque et de le lâcher sur le Rhône."
                                            },
                                            {
                                                "example_id": "3abb9dd9-5aa5-4f7f-a630-fa080187e41b",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "Pendant que sous la mer profonde\nLes cachalots et les requins\nCes écumeurs géants de l’onde\nLibres dévorent le fretin\nNous autres cloués à la rive\nOù la bourrasque a rejeté\nNotre barque un instant rétive\nNous pleurons notre liberté."
                                            },
                                            {
                                                "example_id": "c3eb3f87-eda0-4706-a1dc-d440e56332d9",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "À Mogador, nouvelle relâche, mais la barque envoyée à terre pour rapporter de l’eau fraîche faillit être capturée par les Arabes."
                                            },
                                            {
                                                "example_id": "3dad7d74-df26-4779-b142-b3fe8038bd26",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "Le Vieux-Port, où je me rappelle avoir vu naguère des rangées serrées de goélettes et de tartanes, le Vieux-Port n’est plus qu’un grand bassin des Tuileries où flotte, mais rigoureusement alignée, toute une poussière de yachts et de barques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8454fc6-cc9a-3b45-a3cd-4fb3a021a8ef",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Type de grand voilier dont tous les mâts, sauf celui situé à l’arrière, sont gréés à voiles carrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4476ec-a6a9-47a0-92db-11c01c255ae6",
                                                "sense_id": "a8454fc6-cc9a-3b45-a3cd-4fb3a021a8ef",
                                                "text": "Le trois-mâts barque porte des voiles carrées uniquement au grand mât et au mât de misaine. C’est le plus répandu des gréements équipant la flotte marchande du XIXème siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a05dbed-3264-3d3b-84f2-efc7152cd64d",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Cette sorte de gréement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b04667e4-f7bf-30aa-a8cf-b56d65ee41fd",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "La nacelle dans laquelle les anciens poètes supposaient qu’après la mort les âmes traversaient le Styx pour entrer dans les enfers."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cb1da38-cdde-4cfa-875d-51d18775ad39",
                                                "sense_id": "b04667e4-f7bf-30aa-a8cf-b56d65ee41fd",
                                                "text": "Dans la deuxième partie sont tous les coupables, qui s’empressent de passer le fleuve Achéron dans la barque du nautonier des Enfers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd41e8d-3c4c-3708-a12b-77dc20b2d125",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Grande cuve métallique (parfois en bois) de forme parallélépipédique utilisée par les teinturiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e6e7a6-9b7e-49f9-8935-7d5f236ed0ac",
                                                "sense_id": "2cd41e8d-3c4c-3708-a12b-77dc20b2d125",
                                                "text": "La teinture des tricots en pièce à haute température sur barque à tourniquet et sur machine à jet est comparée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e29eba9f-b2e5-4a77-8b19-43ff8d7cd683",
                        "source_entry_id": "f7ae582d-97d1-3a2a-832d-0e24e294ab53",
                        "source_sense_id": "9b2663a6-9790-3238-91e6-64bd8abff296",
                        "source_sense_description": "small boat that is rowed",
                        "target_lang_word": "Ruderboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruderboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                        "entry_id": "04324a9b-fde8-3ae8-b769-d83a4d8c095d",
                                        "glosses": [
                                            "ein schmales Boot, das mit Rudern, Riemen oder Skulls fortbewegt und gesteuert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd6dd5c-fb69-41aa-b011-9cd27e56c164",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "Die Schwestern fuhren mit dem Ruderboot auf den See hinaus."
                                            },
                                            {
                                                "example_id": "ceed8e00-fd87-401d-82d6-b5409c6c8a66",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "Er vermietet Ruderboote an Touristen."
                                            },
                                            {
                                                "example_id": "e96c4d2d-0bf9-4185-91bb-a7519126225b",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "„Auf jeden Fall trafen die Invasoren, die in langen Ruderbooten aus Eiche kamen, auf eine Hochkultur im Niedergang.“"
                                            },
                                            {
                                                "example_id": "035f6d4b-4f65-4228-a3d2-ad0592e1114f",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "„Papa ist auf einem Hof am Wasser aufgewachsen, wo es viele Ruderboote gibt.“"
                                            },
                                            {
                                                "example_id": "18897220-5a1d-49ef-b2e4-74ff0008bb7f",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "„Ich wurde mit einem kleinen Ruderboot von der Müggenburger Bodden-Brücke zum Kirr übergesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
