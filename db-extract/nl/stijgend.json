                            {
                                "example_id": "ed64caa4-4dea-400d-8b27-53883a239cd3",
                                "sense_id": "34babf70-3a0a-3cb3-87a8-0adc998da530",
                                "text": "Het pad loopt licht stijgend door het bos."
                            },
                            {
                                "example_id": "f431ea01-15bc-4204-aed8-0f3d7a77f333",
                                "sense_id": "34babf70-3a0a-3cb3-87a8-0adc998da530",
