                                    },
                                    {
                                        "sense_id": "e020f325-e95e-3a47-85b8-2ecfcfdb3be6",
                                        "entry_id": "b87d1e2e-11da-3ed3-9ddf-848e1d8fe546",
                                        "glosses": [
                                            "Hilfeleisten zur vorsätzlichen rechtswidrigen, aber nicht zwingend schuldhaften Haupttat eines anderen"
                                        ],
                                        "tags": [
                                            "Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65899d7c-c42e-448a-a256-2de741db22d2",
                                                "sense_id": "e020f325-e95e-3a47-85b8-2ecfcfdb3be6",
                                                "text": "Er wurde wegen Beihilfe zum Mord verurteilt."
                                            },
                                            {
                                                "example_id": "c2cce1f9-0107-4e26-a633-9ae1f4978250",
                                                "sense_id": "e020f325-e95e-3a47-85b8-2ecfcfdb3be6",
                                                "text": "Die versuchte Beihilfe ist in Deutschland nicht strafbar."
                                            }
