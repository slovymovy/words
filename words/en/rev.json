{
    "word_family": [
        "revver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3232e1f8-c3fb-3495-a743-83d72a01a905",
                    "sense_definition": "To increase the speed of a motor, or to operate at a higher speed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "engine_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>revved</w> the engine to warm it up before driving.",
                            "target_lang_translations": {
                                "ru": "Он <w>погазовал</w>, чтобы прогреть двигатель перед поездкой.",
                                "pl": "Kierowca <w>przygazował</w>, aby rozgrzać silnik przed jazdą."
                            }
                        },
                        {
                            "text": "You could hear the cars <w>revving</w> loudly at the starting line.",
                            "target_lang_translations": {
                                "ru": "Было слышно, как машины громко <w>газуют</w> на стартовой линии.",
                                "pl": "Słychać było, jak samochody głośno <w>gazują</w> na linii startu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rev up",
                        "rev the engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать скорость работы двигателя или работать на повышенных оборотах.",
                        "pl": "Zwiększać prędkość obrotową silnika lub pracować na wyższych obrotach."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газовать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "увеличивать обороты",
                                "target_lang_sense_clarification": "двигателя"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gazować",
                                "target_lang_sense_clarification": "potocznie o zwiększaniu obrotów"
                            },
                            {
                                "target_lang_word": "wchodzić na obroty",
                                "target_lang_sense_clarification": "o silniku"
                            },
                            {
                                "target_lang_word": "przygazować",
                                "target_lang_sense_clarification": "krótkie zwiększenie obrotów"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cdf84c5-0288-37d0-9fed-146f4ef9f2d0",
                    "sense_definition": "Clipping of <w>revolution</w> (of something spinning).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "engine_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to keep the <w>revs</w> high to get enough power.",
                            "target_lang_translations": {
                                "ru": "Нужно держать высокие <w>обороты</w>, чтобы получить достаточную мощность.",
                                "pl": "Musisz utrzymywać wysokie <w>obroty</w>, aby uzyskać wystarczającą moc."
                            }
                        },
                        {
                            "text": "The driver watched the <w>revs</w> drop as he shifted gears.",
                            "target_lang_translations": {
                                "ru": "Водитель смотрел, как падают <w>обороты</w> при переключении передач.",
                                "pl": "Kierowca obserwował, jak <w>obroty</w> spadają podczas zmiany biegów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high revs",
                        "low revs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от 'revolutions' (обороты вращения двигателя).",
                        "pl": "Skrót od 'revolutions' (obroty silnika)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обороты",
                                "target_lang_sense_clarification": "двигателя"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obroty",
                                "target_lang_sense_clarification": "prędkość obrotowa silnika"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6b6d116-011e-33d9-bab9-1c13e6dfd72e",
                    "sense_definition": "Clipping of <w>revenue</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking for ways to increase ad <w>rev</w> this quarter.",
                            "target_lang_translations": {
                                "ru": "Компания ищет способы увеличить рекламный <w>доход</w> в этом квартале.",
                                "pl": "Firma szuka sposobów na zwiększenie <w>przychodów</w> z reklam w tym kwartale."
                            }
                        },
                        {
                            "text": "We need to analyze the monthly <w>rev</w> figures immediately.",
                            "target_lang_translations": {
                                "ru": "Нам нужно немедленно проанализировать показатели ежемесячной <w>выручки</w>.",
                                "pl": "Musimy natychmiast przeanalizować miesięczne dane o <w>przychodach</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ad rev"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business jargon"
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от 'revenue' (доход, выручка).",
                        "pl": "Skrót od 'revenue' (przychód, dochód)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доход",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "выручка",
                                "target_lang_sense_clarification": "финансы"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przychód",
                                "target_lang_sense_clarification": "finanse"
                            },
                            {
                                "target_lang_word": "dochód",
                                "target_lang_sense_clarification": "finanse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac0637b-d91d-3a2b-84e3-05eec0693953",
                    "sense_definition": "Clipping of <w>reverend</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clergy_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rev</w> gave a very moving sermon at the church today.",
                            "target_lang_translations": {
                                "ru": "<w>Преподобный</w> произнес сегодня в церкви очень трогательную проповедь.",
                                "pl": "<w>Wielebny</w> wygłosił dziś w kościele bardzo poruszające kazanie."
                            }
                        },
                        {
                            "text": "Everyone in the village knows and respects the <w>rev</w>.",
                            "target_lang_translations": {
                                "ru": "Все в деревне знают и уважают <w>преподобного</w>.",
                                "pl": "Wszyscy w wiosce znają i szanują <w>wielebnego</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от 'reverend' (преподобный).",
                        "pl": "Skrót od 'reverend' (tytuł duchownego)."
                    },
                    "translations": {
                        "ru": [
