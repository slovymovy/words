                "senses": [
                    {
                        "sense_id": "c50db791-b6d8-358e-8c45-034fa0588eaa",
                        "entry_id": "c6e9fcac-a732-3240-876e-0c7ea48ff8e7",
                        "glosses": [
                            "Gruppe von Konsonanten in einer Silbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e0b23e-d308-4118-8f36-bfac1d000d62",
                                "sense_id": "c50db791-b6d8-358e-8c45-034fa0588eaa",
                                "text": "„Zumindest auf der Ebene der festlandsskandinavischen Hochsprachen kann man mit folgender Faustregel operieren, daß die dem vokalischen Silbenkern folgende Konsonanz die Länge des vorangehenden Vokals bestimmt.“"
                            },
                            {
                                "example_id": "85f90c59-935d-43e4-ac4c-1204b6f13c4a",
                                "sense_id": "c50db791-b6d8-358e-8c45-034fa0588eaa",
                                "text": "„Wir unterscheiden zunächst Konsonanz am Wortanfang und -ende (initiale und finale Konsonanz).“"
                            }
                        ],
