                        "cross_references": [
                            {
                                "target_word": "quinine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61c069c1-797a-3ab8-b9f4-4a01f004fc78",
                                        "entry_id": "f6896cd9-f587-3385-8e0f-b1c879fad733",
                                        "glosses": [
                                            "Alcaloïde végétal extrait en particulier du quinquina jaune (Cinchona calisaya). On l'utilise ainsi que ses dérivés pour lutter contre le paludisme, l’industrie alimentaire l'’utilise aussi."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3df8abd0-a494-47a2-b1b1-7ec48f3dd2e3",
                                                "sense_id": "61c069c1-797a-3ab8-b9f4-4a01f004fc78",
                                                "text": "— Elle m’a donné une drogue et j’ai eu le délire toutes les nuits, elle disait que c’était de la quinine ; je l’aurais bien retenue, seulement la poigne m’a manqué."
                                            },
                                            {
                                                "example_id": "cdfde1a1-8459-4429-9ed7-adb13c98aa0f",
                                                "sense_id": "61c069c1-797a-3ab8-b9f4-4a01f004fc78",
                                                "text": "La poudre de quinquina mélangée de chaux, est agitée avec des huiles lourdes de pétrole qui dissolvent la quinine."
                                            },
                                            {
                                                "example_id": "d6922b23-41aa-47e0-b80e-7966273b8121",
                                                "sense_id": "61c069c1-797a-3ab8-b9f4-4a01f004fc78",
                                                "text": "Ils affirment aussi, sur nos observations, qu’elles n’ont pas non plus de pyramidon, ni de quinine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
