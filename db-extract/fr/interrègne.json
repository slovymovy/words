        "fr-extract.jsonl": [
            {
                "entry_id": "47fc5b39-2638-31c9-9908-0aae1b25946d",
                "word": "interrègne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98bf113f-5a4e-4078-9d70-f20cdb9b88d0",
                        "entry_id": "47fc5b39-2638-31c9-9908-0aae1b25946d",
                        "tags": [
                            "plural"
                        ],
                        "form": "interrègnes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65035045-3532-3173-9a8f-3d4551354a99",
                        "entry_id": "47fc5b39-2638-31c9-9908-0aae1b25946d",
                        "glosses": [
                            "Intervalle de temps pendant lequel il n’y a pas de roi, en parlant d’une royauté (ou d’empereur pour un empire), soit héréditaire, soit élective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6f3e6d-ff0e-406c-9c25-fe3d4b16d33d",
                                "sense_id": "65035045-3532-3173-9a8f-3d4551354a99",
                                "text": "…à la fin du règne de Richard Ier, lorsque le retour de sa longue captivité était devenu un événement plutôt désiré qu’attendu par ses sujets désespérés, lesquels, pendant cet interrègne, étaient assujettis à toute espèce d’oppressions secondaires."
                            },
                            {
                                "example_id": "45d8cf91-17b0-449a-aa72-350d7fee18e2",
                                "sense_id": "65035045-3532-3173-9a8f-3d4551354a99",
                                "text": "Sa destitution ouvre un interrègne (1610-1613) pendant lequel un conseil de sept boïards forme un gouvernement provisoire appelé a diriger le pays jusqu'à ce qu'un accord se fasse sur le choix d'un nouveau tsar."
                            },
                            {
                                "example_id": "25008470-72f9-46da-9516-837cb5ea9fb8",
                                "sense_id": "65035045-3532-3173-9a8f-3d4551354a99",
                                "text": "Raymond Poincaré le prenait à son compte en déclarant comme il le fit en ma présence durant l'interrègne ministériel, qu'appeler, soit Millerand, soit Viviani, au gouvernement « c'était tout ce qu'il y avait de plus dangereux » (sic)."
                            }
                        ]
                    },
                    {
                        "sense_id": "214dd94b-4bb6-34c8-8ffa-0cd463298e1e",
                        "entry_id": "47fc5b39-2638-31c9-9908-0aae1b25946d",
                        "glosses": [
                            "Intervalle de temps pendant lequel tout poste de direction demeure vacant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2316a284-17bc-462d-a2e8-53b358320975",
                                "sense_id": "214dd94b-4bb6-34c8-8ffa-0cd463298e1e",
                                "text": "L’interrègne de l’archevêché de Lyon, resté vacant de 1268 à 1273, offrit aux Lyonnais l’occasion propice pour, une fois de plus, essayer de secouer le joug abhorré des chanoines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f8fb3d3-863b-40e0-8498-923f67c3570f",
                        "source_entry_id": "47fc5b39-2638-31c9-9908-0aae1b25946d",
                        "target_lang_word": "Interregnum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interregnum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c65eb98-18b5-3b1d-9eed-cb543a752821",
                                        "entry_id": "078362ac-d1d2-37fc-8007-5cd5203cdee7",
                                        "glosses": [
                                            "Übergangsregierung, vorläufige Regierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e9e8ef7-121c-4578-b011-cd1b47b59b71",
                                                "sense_id": "0c65eb98-18b5-3b1d-9eed-cb543a752821",
                                                "text": "Das Interregnum wurde von einem Interrex geführt."
                                            },
                                            {
                                                "example_id": "1711133f-c4f9-45bf-a0f4-8e0f1edbaf6f",
                                                "sense_id": "0c65eb98-18b5-3b1d-9eed-cb543a752821",
                                                "text": "„Auf ihn folgte ein turbulentes Interregnum, das nur durch wenige Jahre der Herrschaft von Iltutmishs sehr fähiger Tochter Raziyya unterbrochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76906ac2-9c02-3310-89eb-fad24029206d",
                                        "entry_id": "078362ac-d1d2-37fc-8007-5cd5203cdee7",
                                        "glosses": [
                                            "der Zeitraum, währenddessen eine solche Regierung herrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a109d157-8594-438f-8ca5-b5a2bbff4652",
                                                "sense_id": "76906ac2-9c02-3310-89eb-fad24029206d",
                                                "text": "Während des Interregnums war das Reich ohne Kaiser."
                                            },
                                            {
                                                "example_id": "083fa79f-77d8-4c21-ad3f-b9c5b8d4f1e3",
                                                "sense_id": "76906ac2-9c02-3310-89eb-fad24029206d",
                                                "text": "„Die Fürsten bestimmen für die nächsten 20 Jahre schwache Zwischenkönige bis die Habsburger das Interregnum beenden […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72091bc2-f5f8-4af6-ac5c-565ca045084b",
                        "source_entry_id": "47fc5b39-2638-31c9-9908-0aae1b25946d",
                        "target_lang_word": "interregnum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interregnum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c944f2a-859a-365c-bbcb-4d9584a16a24",
                                        "entry_id": "13ba91a9-59a8-3514-96be-4b92bc4a1c38",
                                        "glosses": [
                                            "The period of time between the end of a sovereign or political leader's reign and the accession of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785afbf3-0b3f-49ae-bc58-3abdb8d81665",
                                                "sense_id": "2c944f2a-859a-365c-bbcb-4d9584a16a24",
                                                "text": "The Sasanian Interregnum of 628–632"
                                            },
                                            {
                                                "example_id": "017694aa-5af8-4541-8203-f46959b7880b",
                                                "sense_id": "2c944f2a-859a-365c-bbcb-4d9584a16a24",
                                                "text": "It was not till the kings had been shorn of power and the interregnum of sham democracy had set in, leaving no virile force in the state or the world to resist the money power, that the opportunity for a world-wide plutocratic despotism arrived."
                                            },
                                            {
                                                "example_id": "d66f013b-22af-46fd-8b67-5f030a1d1023",
                                                "sense_id": "2c944f2a-859a-365c-bbcb-4d9584a16a24",
                                                "text": "Darker questions still emerge in these dusky final weeks of our interregnum."
                                            },
                                            {
                                                "example_id": "06094f6c-48d9-4df4-9689-1919b11c70c6",
                                                "sense_id": "2c944f2a-859a-365c-bbcb-4d9584a16a24",
                                                "text": "Another element leading to the quick-out-of-the-gate second Trump term took place during the four-year interregnum of President Joe Biden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44b6dac-0dbd-3df8-a13d-082a9f7c5420",
                                        "entry_id": "13ba91a9-59a8-3514-96be-4b92bc4a1c38",
                                        "glosses": [
                                            "A period of time during which normal executive leadership is suspended or interrupted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1ea200f-7f46-3993-8f6e-df6eaf5d7630",
                                        "entry_id": "13ba91a9-59a8-3514-96be-4b92bc4a1c38",
                                        "glosses": [
                                            "An intermission in any order of succession; any breach of continuity in action or influence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c6c940-0ccb-464c-9047-60b9457ca959",
                                                "sense_id": "a1ea200f-7f46-3993-8f6e-df6eaf5d7630",
                                                "text": "Is it not Pelham who wonders what becomes of servants when they are not wanted;—whether, like the tones of an instrument, they exist but when called for? About servants we will not decide; but that some such interregnum certainly occurs in female existence on rising from table, no one can doubt who ever noted the sound of the dining and the silence of the drawing-room."
                                            },
                                            {
                                                "example_id": "b0afe1e5-62f0-47a4-9a45-115ba9806767",
                                                "sense_id": "a1ea200f-7f46-3993-8f6e-df6eaf5d7630",
                                                "text": "This was in that strange pause of the storm which is its most remarkable feature in the South—that singular interregnum of the winds, when, after giving repeated notice of their most terrific action, they seem almost to forget their purpose, and for a few moments appear to slumber in their inactivity."
                                            },
                                            {
                                                "example_id": "f91d553c-16bd-4121-8c49-f38c26d4e1bb",
                                                "sense_id": "a1ea200f-7f46-3993-8f6e-df6eaf5d7630",
                                                "text": "Between the end of the Fowler régime in 1931 and the advent of Stanier in 1932, there was a short interregnum during which Ernest Lemon was in charge, with Ernest Beames as his principal aide-de-camp."
                                            },
                                            {
                                                "example_id": "f24ba439-4e1f-4c3e-9e1e-84417d266ae8",
                                                "sense_id": "a1ea200f-7f46-3993-8f6e-df6eaf5d7630",
                                                "text": "All I know is that you could, if you wanted to, find the answers to all sorts of difficult questions buried in that terrible war-torn interregnum between the first pubic hair and the first soiled Durex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4189173c-a35f-3c18-98f3-25e309bc8fe6",
                                        "entry_id": "13ba91a9-59a8-3514-96be-4b92bc4a1c38",
                                        "glosses": [
                                            "the period of time between when a minister or pastor leaves a church and when a new one is installed"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
