                                "sense_id": "32c60765-8c07-3bdf-85ec-82de7ee7514f",
                                "text": "My mother was always doubly careful when winding the grandfather clock."
                            },
                            {
                                "example_id": "4b3710e5-b525-410e-a31a-45ce2a890379",
                                "sense_id": "32c60765-8c07-3bdf-85ec-82de7ee7514f",
                                "text": "Time is an illusion. Lunchtime doubly so."
