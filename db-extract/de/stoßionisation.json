                ],
                "senses": [
                    {
                        "sense_id": "979d2ac3-faff-3c19-a46d-070920ac1f9f",
                        "entry_id": "80e85faa-ee39-391c-90f2-223228bae754",
                        "glosses": [
                            "das Herausschlagen von Elektronen durch energiereiche Stoßpartner aus Atomen oder Molekülen, wodurch ein Ion geladen zurückbleibt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "9e0c03b0-a06c-4e49-b0fa-221265d75de7",
                                "sense_id": "979d2ac3-faff-3c19-a46d-070920ac1f9f",
                                "text": "„Theorie der Stoßionisation durch Elektronen in isolierenden Kristallen“"
                            },
                            {
                                "example_id": "8fdd6677-3363-4bf8-9e77-82471836eda9",
                                "sense_id": "979d2ac3-faff-3c19-a46d-070920ac1f9f",
                                "text": "„Unter Stoßionisation versteht man die Freisetzung eines gebundenen Elektrons, das einem Atomrumpf aufgrund einer Kollision mit einem hochenergetischen Elektrons weggeschlagen wird.“"
                            },
                            {
                                "example_id": "ec7960c4-44a9-4e93-b753-4f0378a616e9",
                                "sense_id": "979d2ac3-faff-3c19-a46d-070920ac1f9f",
                                "text": "„Durch diese Stoßionisation entstehen also freie Elektronen und Ionen, somit wird das Gas leitend.“"
                            },
                            {
                                "example_id": "30bc5dae-5bd2-4c47-8f1d-a0e414573b3d",
                                "sense_id": "979d2ac3-faff-3c19-a46d-070920ac1f9f",
                                "text": "„Werden die angelegten Feldstärken weiter erhöht, so tritt bei rund 400 kV/cm ein völlig neues Phänomen auf: die Stoßionisation.“"
                            },
                            {
                                "example_id": "7322b765-107b-40a4-b3fc-401f79e8fe3e",
                                "sense_id": "979d2ac3-faff-3c19-a46d-070920ac1f9f",
                                "text": "„Das Heliumatom „sieht“ entweder eine kohärente oder eine inkohärente Welle auf sich zukommen“, ergänzt Katharina Schneider, die für ihre Dissertation an den Stoßionisationen forschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
