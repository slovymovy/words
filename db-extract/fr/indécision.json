                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96c1bd5c-21a9-4bba-9774-971c54015930",
                        "entry_id": "b9f708ad-ec5b-382d-8df5-4dc4451990b4",
                        "tags": [
                            "plural"
                        ],
                        "form": "indécisions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                        "entry_id": "b9f708ad-ec5b-382d-8df5-4dc4451990b4",
                        "glosses": [
                            "Caractère d’un homme indécis, d'une femme indécise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c3485b-2191-45f9-9ce2-d0d6ce9e5931",
                                "sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                                "text": "Toby s’arrêta à l’endroit où cette dernière rue tourne dans Knight’s Place. Puis il se mit à courir en avant, en arrière, avec une de ses oreilles dressée et l’autre traînante : exactement l’image de l’indécision canine ! Enfin, il se mit à trottiner en rond, levant la tête vers nous de temps en temps, comme pour demander que l’on veuille bien comprendre son embarras."
                            },
                            {
                                "example_id": "cc7ceebb-d38e-476d-8e03-8c44bb1a16ca",
                                "sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                                "text": "L’abstraction devient la puissance de réflexion, l’inaction une capacité à formuler les problèmes, l’inadaptation une polyvalence, l’indécision la certitude de l'incertain, la rhétorique un agir communicationnel, la complication la conscience de la complexité et l’achiffrisme s'évanouit dans l'usage commune d'une règle de trois appliquée à une langue des affaires qu'on apprend comme n'importe quelle langue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd14ee3c-8a41-4bf7-8485-e3bbce930070",
                        "source_entry_id": "b9f708ad-ec5b-382d-8df5-4dc4451990b4",
                        "source_sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                        "target_lang_word": "indecisiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indecisiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f548c7cb-ad4e-3920-b0b5-71dba0d91203",
                                        "entry_id": "f0b4933c-c37b-3490-8481-2514d1e3beeb",
                                        "glosses": [
                                            "The condition of being indecisive."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed9b31f-3cff-40b1-b306-ab49c8832a33",
                                                "sense_id": "f548c7cb-ad4e-3920-b0b5-71dba0d91203",
                                                "text": "It is a picture of dither, delay, unrealistic costings - and Department for Transport indecisiveness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21f31425-ca0b-43d5-83c9-8494f7c3e60f",
                        "source_entry_id": "b9f708ad-ec5b-382d-8df5-4dc4451990b4",
                        "source_sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                        "target_lang_word": "indecision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indecision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "effb7c75-89e5-3335-afe1-32c6d9d83ed3",
                                        "entry_id": "2692b6c4-646d-3c8d-ae58-5aeb287f16b3",
                                        "glosses": [
                                            "The inability to decide on a course of action, especially if two or more possibilities exist."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a51dd6e7-04fd-4961-9198-7f3fb1decd5f",
                                                "sense_id": "effb7c75-89e5-3335-afe1-32c6d9d83ed3",
                                                "text": "Billy Toad has shown extreme indecision in all aspects when it comes to his jeep. Whether it's how to modify it, or if he will sell it."
                                            },
                                            {
                                                "example_id": "7836a240-b02c-4ad3-a772-e490a164148a",
                                                "sense_id": "effb7c75-89e5-3335-afe1-32c6d9d83ed3",
                                                "text": "There was no indecision or delay in the establishment of their relations; Rebecca's heart flew like an arrow to its mark, and her mind, meeting its superior, settled at once into an abiding attitude of respectful homage."
                                            },
                                            {
                                                "example_id": "522cf652-5d74-4c2d-ae6f-94e60794dbc4",
                                                "sense_id": "effb7c75-89e5-3335-afe1-32c6d9d83ed3",
                                                "text": "Moreover, in view of the lamentable present indecision of the Government in regard to electrification, the large-scale building of diesel power may prove to have been a farseeing move after all."
                                            },
                                            {
                                                "example_id": "ed198b6f-7e7b-4bfb-b8d5-5366ead62f61",
                                                "sense_id": "effb7c75-89e5-3335-afe1-32c6d9d83ed3",
                                                "text": "I can't stand this indecision\nMarried with a lack of vision\nEverybody wants to rule the—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
