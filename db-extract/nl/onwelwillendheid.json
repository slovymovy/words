                                    {
                                        "sense_id": "c206f093-e4cc-39ba-82a9-fc0edcb2d7a8",
                                        "entry_id": "6cdcdcff-fe4c-374b-a347-cf32aaa4ae36",
                                        "glosses": [
                                            "The collective noun for ravens"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "007954b7-837a-4f1c-852c-6be3a62090eb",
                                                "sense_id": "c206f093-e4cc-39ba-82a9-fc0edcb2d7a8",
                                                "text": "All Olwynne could remember, though, was her father falling away from her into some deep pit, his black wings bent over his face, and then hundreds of ravens, an unkindness of ravens, plummeting from the sky to peck out her eyes."
                                            },
                                            {
                                                "example_id": "d69f7871-c530-4e18-bcb8-e4a6a30ac7d6",
                                                "sense_id": "c206f093-e4cc-39ba-82a9-fc0edcb2d7a8",
                                                "text": "\"There's an unkindness of ravens that roosts on top of the guild. Their numbers are growing by the day. Aren't they spectacular?"
                                            },
                                            {
                                                "example_id": "662a3955-320c-487d-a436-a601dcac45bc",
                                                "sense_id": "c206f093-e4cc-39ba-82a9-fc0edcb2d7a8",
                                                "text": "A raven cawed somewhere up ahead, and its cry was answered by others, an unkindness of ravens on all sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
