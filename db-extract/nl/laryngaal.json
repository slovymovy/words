                        "cross_references": [
                            {
                                "target_word": "laryngeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8293e235-8021-3492-b49f-3d9264134b3b",
                                        "entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                                        "glosses": [
                                            "Of or pertaining to the larynx."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d613061-d37a-45cc-b3b1-6689ccd789c3",
                                                "sense_id": "8293e235-8021-3492-b49f-3d9264134b3b",
                                                "text": "At sight of it there commenced a series of laryngeal spasms, with clutchings at his throat, far more violent than any I had heretofore seen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d364a65-5604-310a-a38e-ae702781524a",
                                        "entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                                        "glosses": [
                                            "(of a speech sound) Made by or with constriction of the larynx with only the front part of the vocal cords vibrating, giving a very low frequency and producing what is known as \\\"creaky voice.\\"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laryngeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea2110a6-c763-30ec-b121-b593d93fc14e",
                                        "entry_id": "b9507620-e5fc-39db-8e29-885c93126b59",
                                        "glosses": [
                                            "An anatomical part (such as a nerve or artery) that supplies or is associated with the larynx."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9212a4ef-ea14-3487-a827-30d352699784",
                                        "entry_id": "b9507620-e5fc-39db-8e29-885c93126b59",
                                        "glosses": [
                                            "A sound uttered by using the larynx."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                        "entry_id": "b9507620-e5fc-39db-8e29-885c93126b59",
                                        "glosses": [
                                            "In Proto-Indo-European, one of the typically three reconstructed consonants usually marked as ⟨h₁⟩, ⟨h₂⟩ and ⟨h₃⟩."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef194937-b5d1-4bf9-8606-f8889820341e",
                                                "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                                "text": "The vowel-coloring effects of the IH laryngeals cannot be considered apart from the vowel-reducing effect of the IH stress accent[…]"
                                            },
                                            {
                                                "example_id": "ed8fd6c9-9a6e-4ce9-abef-73cc72da971d",
                                                "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                                "text": "[…]it is not only different from Buck's in the linguistics (laryngeals have seen to that); it is very different in scope and aim."
                                            },
                                            {
                                                "example_id": "c52883d0-f52b-45d2-931c-49c6884fe7fd",
                                                "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                                "text": "Finally, it should be noted that laryngeals not adjacent to syllabics were apparently deleted by three different rules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698acd07-92b4-48e7-a066-29e9d80630c3",
                        "source_entry_id": "8849ef6f-8974-3c13-92f1-cbf70ca4ff86",
                        "source_sense_id": "6fc17a80-6c20-34dd-b578-cc25a758c959",
