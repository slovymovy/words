                    },
                    {
                        "translation_id": "c62ae8f5-c200-4abe-b8ac-08c4324285e2",
                        "source_entry_id": "ad8b7610-b11f-3907-bf7f-2e47e12532ea",
                        "source_sense_id": "392db253-81ad-3569-9f5e-d0723572b34a",
                        "target_lang_word": "Übersetzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
