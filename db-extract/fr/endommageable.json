                        "examples": [
                            {
                                "example_id": "dc0eea90-a50e-4ace-9f94-abab32966f71",
                                "sense_id": "c8b1c949-a470-3aee-af66-52fbb86cfd9f",
                                "text": "il y a alors avec eau basse, un bout de fossé sec, depuis le Dodane jusques à l’embouchure, endommageable à la Fortification de la Ville."
                            },
                            {
                                "example_id": "69b34759-c30d-45ae-956d-6d80a1b6c93e",
                                "sense_id": "c8b1c949-a470-3aee-af66-52fbb86cfd9f",
                                "text": "Quel parti donc prendre en si difficile occurrence ? celui d’être le moins dupe possible, parce que rien n’est plus endommageable que de devenir par sa faute la risée des fourbes et de leurs partisans."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c7ca731-0d28-333f-ada1-b2bf6bb111a0",
                        "entry_id": "76bceceb-7086-346f-b059-798d833d30bb",
                        "glosses": [
                            "Qui peut être endommagé, subir des dommages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa181f7-ea45-419b-a97f-df710fbfd11c",
                                "sense_id": "9c7ca731-0d28-333f-ada1-b2bf6bb111a0",
                                "text": "Le reste du matériel nécessaire pour l’éclairage électrique intérieur coûte un peu plus que le matériel ordinaire, mais il est d’un service plus prompt, d’un entretien plus facile et plus difficilement endommageable."
                            },
                            {
                                "example_id": "c4114d79-b372-41cf-abb1-02983663679a",
                                "sense_id": "9c7ca731-0d28-333f-ada1-b2bf6bb111a0",
                                "text": "Un plan de travail cuisine en bois n’est pourtant pas le choix le plus pratique au monde. Ce matériau classique, sensible à l’eau et à la chaleur, est facilement endommageable."
                            },
                            {
                                "example_id": "4496526a-cbea-4e92-9c9b-63656d728b6c",
                                "sense_id": "9c7ca731-0d28-333f-ada1-b2bf6bb111a0",
                                "text": "Beaucoup de pièces sont soudées à la carte mère et l’écran du dessus est facilement endommageable si vous êtes négligent."
                            }
                        ]
                    }
