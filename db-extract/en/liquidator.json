                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a8fcc36b-3a72-47fa-a025-44d1a6b1194a",
                        "source_entry_id": "c17b4f14-9d66-37ce-b5af-d07105b2b981",
                        "source_sense_description": "one who liquidates",
                        "target_lang_word": "Liquidator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liquidator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08a56ca6-d4b0-3931-874a-55ffe53ad5a3",
                                        "entry_id": "6374dbf7-82cd-38f9-9d8b-f14dc36a9421",
                                        "glosses": [
                                            "Person, die ein Unternehmen (oder auch andere wirtschaftliche Einheiten, zum Beispiel einen Fond) auflöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae183b69-9233-4d99-ad42-9ba722da0648",
                                                "sense_id": "08a56ca6-d4b0-3931-874a-55ffe53ad5a3",
                                                "text": "„Der neubestallte Liquidator hat eine Bilanzsumme von 220 Millionen Mark abzuwickeln, den Rest des einstmals größten deutschen Industrie-Unternehmens: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21dd2a46-5fdf-35e5-ad88-7982e92f8345",
                                        "entry_id": "6374dbf7-82cd-38f9-9d8b-f14dc36a9421",
                                        "glosses": [
                                            "Person, die jemanden auftragsgemäß töten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe50cd8f-2d0d-4269-a4c4-7ebc44a12b9d",
                                                "sense_id": "21dd2a46-5fdf-35e5-ad88-7982e92f8345",
                                                "text": "„Kommunismus und Nationalsozialismus, sind sie nicht Zwillinge? Roter und brauner Terror, sind sie nicht vom selben Schlag? Stalin und Hitler, hat nicht einer vom anderen gelernt - der Liquidator Bucharins zum Beispiel vom Liquidator Röhms?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41613ae5-af4a-401d-9ef1-09d56e9fde7f",
                        "source_entry_id": "c17b4f14-9d66-37ce-b5af-d07105b2b981",
                        "source_sense_description": "one who liquidates",
                        "target_lang_word": "Liquidatorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liquidatorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f6df1d2-4dc8-3d71-9adb-f5f03d306a4c",
                                        "entry_id": "ef3035fe-0ce5-35de-bfb2-0d6d4d90f7e6",
                                        "glosses": [
                                            "weibliche Person, die ein Unternehmen (oder auch andere wirtschaftliche Einheiten, zum Beispiel einen Fond) auflöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "616263a3-4917-4b1f-8dfa-706ba4d9b1a4",
                                                "sense_id": "9f6df1d2-4dc8-3d71-9adb-f5f03d306a4c",
                                                "text": "„Dabei ist doch der Betrag identisch mit der Flugrechnung von 1995, und die 96er Rechnung gab es nach Auskunft der Liquidatorin noch gar nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0c4b30b-f3e7-3689-8107-07201ec66f1c",
                                        "entry_id": "ef3035fe-0ce5-35de-bfb2-0d6d4d90f7e6",
                                        "glosses": [
                                            "weibliche Person, die jemanden auftragsgemäß tötet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf6adb6-b9d9-4377-aa6a-8684248b8eb4",
                                                "sense_id": "a0c4b30b-f3e7-3689-8107-07201ec66f1c",
                                                "text": "Als Liquidatorin verdiente sie gutes Geld und sie hatte es sich zur Regel gemacht, keine Aufträge anzunehmen, die Frauen oder Kinder betrafen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
