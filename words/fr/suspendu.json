    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a168b17-8420-348f-876b-9abde727a620",
                    "sense_definition": "Qui est accroché par le haut et pend dans l'air sans reposer sur le sol.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une magnifique lampe est <w>suspendue</w> au-dessus de la grande table du salon."
                        },
                        {
                            "text": "Les piétons traversent la gorge sur un pont <w>suspendu</w> très impressionnant."
                        }
                    ],
                    "synonyms": [
                        "accroché",
                        "pendant"
                    ],
                    "antonyms": [
                        "posé"
                    ],
                    "common_phrases": [
                        "pont suspendu",
                        "jardins suspendus"
                    ]
                },
                {
                    "sense_id": "2f6bc33a-78a3-32c2-a872-a465cf826780",
                    "sense_definition": "Qui est temporairement interrompu, arrêté ou différé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison du mauvais temps, plusieurs vols restent <w>suspendus</w> jusqu'à nouvel ordre."
                        },
                        {
                            "text": "Le directeur a annoncé que les négociations syndicales étaient <w>suspendues</w> pour la semaine."
                        }
                    ],
                    "synonyms": [
                        "ajourné",
                        "différé",
                        "interrompu"
                    ],
                    "antonyms": [
                        "maintenu",
                        "poursuivi"
                    ],
                    "common_phrases": [
                        "vol suspendu",
                        "délai suspendu"
                    ]
                },
                {
                    "sense_id": "8bd1a96d-5d95-33fc-9e91-a40c5633db16",
                    "sense_definition": "Qui est temporairement interdit d'exercer ses fonctions professionnelles ou de participer à une compétition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent municipal a été <w>suspendu</w> de ses fonctions à la suite d'une faute grave."
                        },
                        {
                            "text": "Après avoir reçu un carton rouge, l'attaquant est <w>suspendu</w> pour deux rencontres."
                        }
                    ],
                    "synonyms": [
                        "écarté",
                        "relevé"
                    ],
                    "antonyms": [
                        "réintégré"
                    ],
                    "common_phrases": [
                        "suspendu de ses fonctions"
                    ]
                },
                {
                    "sense_id": "3b6e10d9-68ac-3867-b5e5-86f15548301b",
                    "sense_definition": "Qui semble flotter ou s'immobiliser, comme arrêté dans le temps ou dans l'espace.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant quelques secondes d'émotion, le temps semblait totalement <w>suspendu</w> dans la pièce."
                        },
                        {
                            "text": "La cabine d'observation est restée <w>suspendue</w> dans le vide au-dessus de la falaise."
                        }
                    ],
                    "synonyms": [
                        "figé"
                    ],
                    "common_phrases": [
                        "suspendu dans le vide",
                        "temps suspendu"
                    ]
                },
                {
                    "sense_id": "63983e26-c900-35da-94ff-54e54eb2b751",
                    "sense_definition": "Muni d'un système de suspension mécanique, en parlant d'un véhicule.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne berline est particulièrement bien <w>suspendue</w> pour rouler sur les pavés."
                        },
                        {
                            "text": "Sur une route de campagne, un véhicule mal <w>suspendu</w> fatigue rapidement les passagers."
                        }
                    ],
                    "common_phrases": [
                        "bien suspendu"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
