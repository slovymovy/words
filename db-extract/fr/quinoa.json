        "fr-extract.jsonl": [
            {
                "entry_id": "e87cd6c7-7235-3433-917a-35563368cf77",
                "word": "quinoa",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4d83a14-e182-4c5d-909b-d48b5af1e0a1",
                        "entry_id": "e87cd6c7-7235-3433-917a-35563368cf77",
                        "tags": [
                            "plural"
                        ],
                        "form": "quinoas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f82e95b3-0e28-3e84-ab32-08e50fd02e4e",
                        "entry_id": "e87cd6c7-7235-3433-917a-35563368cf77",
                        "glosses": [
                            "Nom usuel de Chenopodium quinoa, plante de la famille des Amaranthaceae (Amaranthacées), originaire de la Cordillère des Andes, cultivée pour ses graines comestibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4abb8565-13fc-4574-a8e0-6a03695e583d",
                                "sense_id": "f82e95b3-0e28-3e84-ab32-08e50fd02e4e",
                                "text": "Le quinoa est une des trois céréales anciennes que les Incas cultivaient en altitude — le kaniwa (Chenopodium pallidicaule), le kiwicha, l’amarante queue de renard (Amaranthus caudatus) et le quinoa (Chenopodium quinoa)."
                            },
                            {
                                "example_id": "c92cfd29-2fe7-4bad-bec9-59d4c91b78fb",
                                "sense_id": "f82e95b3-0e28-3e84-ab32-08e50fd02e4e",
                                "text": "M. Lambert, agriculteur français, a été plus heureux dans ses expériences sur le quinoa en Angleterre."
                            },
                            {
                                "example_id": "077f3801-e8be-4d31-9dea-ff8e3e90169f",
                                "sense_id": "f82e95b3-0e28-3e84-ab32-08e50fd02e4e",
                                "text": "Nous passons sous silence les espèces exotiques : Quinoa, dont les semences servent de nourriture aux Chiliens."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6ef2146-5f09-325c-b915-d058798c019f",
                        "entry_id": "e87cd6c7-7235-3433-917a-35563368cf77",
                        "glosses": [
                            "Graines de cette plante cultivée à l'origine en Amérique du Sud, elles se mangent cuites et sont riches en protéines."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "66085adc-ae87-4eba-8a23-40f962478e92",
                                "sense_id": "b6ef2146-5f09-325c-b915-d058798c019f",
                                "text": "Mais plus typiquement péruviens sont, en revanche, le aji de gallina (émincé de blanc de poulet cuit, avec une sauce au fromage un peu relevée) ou le porc cuit au four avec de la quinoa (« blé » des Andes) à choisir après un pisco sour, l’apéritif national !"
                            },
                            {
                                "example_id": "9d171c5a-448c-44df-b198-070417dbe199",
                                "sense_id": "b6ef2146-5f09-325c-b915-d058798c019f",
                                "text": "La quinoa se mange cuite à l’eau, comme le riz."
                            },
                            {
                                "example_id": "1eb506c9-394a-491f-ad75-e364cbeaab2b",
                                "sense_id": "b6ef2146-5f09-325c-b915-d058798c019f",
                                "text": "Les raisons du déclin du quinoa ne pas connues avec certitude. Il est toutefois probable que le « petit riz », comme l’appelaient les Espagnols, soit entré en compétition avec le « vrai » riz dont ils ont introduit la culture."
                            },
                            {
                                "example_id": "1a783a8f-37b2-45ed-a481-ef91096bd9fc",
                                "sense_id": "b6ef2146-5f09-325c-b915-d058798c019f",
                                "text": "Le quinoa est reconnu, d’une part, pour sa grande diversité génétique comme facteur d’adaptation et, d’autre part, pour ses qualités nutritionnelles."
                            },
                            {
                                "example_id": "ca763bcb-9d03-49e1-88c7-085dc672cae3",
                                "sense_id": "b6ef2146-5f09-325c-b915-d058798c019f",
                                "text": "Outre le quinoa, on trouve aussi des saponines dans le thé, la réglisse, les tomates, les pommes de terre, le ginseng, l’ail, de nombreux animaux marins…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "654bf4dd-3514-4e1e-8362-18366fbc445a",
                        "source_entry_id": "e87cd6c7-7235-3433-917a-35563368cf77",
                        "target_lang_word": "Quinoa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quinoa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b51728-ef71-3243-8eb1-e939f78ec1c2",
                                        "entry_id": "e9d9d622-8f5f-3855-b4ab-c31bdcd262d6",
                                        "glosses": [
                                            "zur Familie der Fuchsschwanzgewächse gehörende, einjährige krautige Pflanze, die als Pseudogetreide als ein vollwertiger Getreideersatz dienen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a2d1e03-230e-44e2-baa6-8ebc04a50f95",
                                                "sense_id": "c2b51728-ef71-3243-8eb1-e939f78ec1c2",
                                                "text": "„Auch Quinoa stammt ursprünglich aus Südamerika, kommt aber im Vergleich zu Amarant mit geringeren Mindesttemperaturen zurecht und ist begrenzt frosttolerant.“"
                                            },
                                            {
                                                "example_id": "18677a0d-1833-464d-96ac-1a09f7c9df21",
                                                "sense_id": "c2b51728-ef71-3243-8eb1-e939f78ec1c2",
                                                "text": "Sie verfeinerten durch gezielte, genetische Auswahl das Andengras zu Quinoa, bauten Kiwicha, Chocha, Oca und Olluca an - lauter nahrhafte, resistente andine Lupinen- und Knollengewächse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be52a75-3ffd-4df6-8626-5826baf89aff",
                        "source_entry_id": "e87cd6c7-7235-3433-917a-35563368cf77",
                        "target_lang_word": "quinoa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quinoa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e86d9cdb-3ee3-3223-8ab9-16355e646073",
                                        "entry_id": "afae82f8-ee0e-3a60-94ca-90b9d8fb226c",
                                        "glosses": [
                                            "A goosefoot (Chenopodium quinoa) native to the Andes and cultivated for its edible seeds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edd475b4-2b19-4377-8e4a-27403c104cc2",
                                                "sense_id": "e86d9cdb-3ee3-3223-8ab9-16355e646073",
                                                "text": "Chenopodium quinoa Will, (quinoa) is native to the Andes, and the seeds are a staple grain in parts of South America. The newly formed Canadian Quinoa Association anticipated growing about 400 ha of quinoa annually (Anonymous 1992e)."
                                            },
                                            {
                                                "example_id": "77602cd2-423f-43aa-9e47-9afdd2b86ddc",
                                                "sense_id": "e86d9cdb-3ee3-3223-8ab9-16355e646073",
                                                "text": "Quinoa was cultivated about 3,000 years ago in the Andes mountain region, and was the favored crop of the Incas, who used it as a sacred plant in rituals."
                                            },
                                            {
                                                "example_id": "7907e487-4cf6-434d-b49f-d799ddc4f0d3",
                                                "sense_id": "e86d9cdb-3ee3-3223-8ab9-16355e646073",
                                                "text": "The oldest archeological remains of domesticated quinoa date to 5000 BC (Tapia 1979)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7da9050-3401-3afa-a52f-a2343e6e64ec",
                                        "entry_id": "afae82f8-ee0e-3a60-94ca-90b9d8fb226c",
                                        "glosses": [
                                            "The high-protein dried fruits and seeds of this plant, used as a food staple and ground into flour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4913c988-df7e-4819-a0e8-d5ddde9d4d17",
                                                "sense_id": "a7da9050-3401-3afa-a52f-a2343e6e64ec",
                                                "text": "Turn the heat up to medium-high, add the quinoa, and sprinkle with salt and pepper."
                                            },
                                            {
                                                "example_id": "0a3e0fc8-1a49-47cb-b62a-5168daf4d2ce",
                                                "sense_id": "a7da9050-3401-3afa-a52f-a2343e6e64ec",
                                                "text": "Quinoa is another of those foods that keeps getting miscategorized—everyone thinks it′s a grain, everyone uses it like a grain, but it′s actually a seed."
                                            },
                                            {
                                                "example_id": "d2f3852d-e41e-41c4-9e56-0ed3596f61f2",
                                                "sense_id": "a7da9050-3401-3afa-a52f-a2343e6e64ec",
                                                "text": "To use quinoa in a salad, spread it on a platter or baking sheet after cooking to allow it to cool and, more importantly, dry. Cooked quinoa can be stored in an airtight container in the refrigerator for up to 5 days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
