                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ff02fe6-3420-41f4-bb76-b012bfdd9f4b",
                        "source_entry_id": "c953ef79-e8a1-3019-bca9-b838313ae721",
                        "source_sense_description": "melon",
