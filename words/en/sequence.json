{
    "word_family": [
        "sequential",
        "sequencer",
        "subsequent",
        "consequence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8b7aa21-aab9-3297-927a-fdb3bf4b4104",
                    "sense_definition": "A set of things next to each other in a set order; a series.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The numbers follow a specific <w>sequence</w>.",
                            "target_lang_translations": {
                                "ru": "Числа следуют в определенной <w>последовательности</w>.",
                                "tr": "Sayılar belirli bir <w>sırayı</w> takip ediyor.",
                                "zh": "这些数字遵循特定的<w>序列</w>。"
                            }
                        },
                        {
                            "text": "He memorized the <w>sequence</w> of events perfectly.",
                            "target_lang_translations": {
                                "ru": "Он идеально запомнил <w>последовательность</w> событий.",
                                "tr": "Olayların <w>sırasını</w> mükemmel bir şekilde ezberledi.",
                                "zh": "他完美地记住了事件的<w>顺序</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "series",
                        "chain",
                        "string",
                        "succession"
                    ],
                    "antonyms": [
                        "hodgepodge"
                    ],
                    "common_phrases": [
                        "logical sequence",
                        "number sequence",
                        "sequence of events"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор вещей, следующих друг за другом в определенном порядке; серия.",
                        "tr": "Belirli bir sıra içindeki şeylerin oluşturduğu küme; dizi, sıra.",
                        "zh": "一组按特定顺序排列的事物；一系列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последовательность",
                                "target_lang_sense_clarification": "порядок следования чего-либо"
                            },
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "совокупность предметов, расположенных друг за другом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sıra",
                                "target_lang_sense_clarification": "ardışık düzen"
                            },
                            {
                                "target_lang_word": "dizi",
                                "target_lang_sense_clarification": "birbiri ardına gelen nesne veya olaylar"
                            },
                            {
                                "target_lang_word": "ardışıklık",
                                "target_lang_sense_clarification": "birbirini takip etme durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "序列",
                                "target_lang_sense_clarification": "按特定顺序排列的集合"
                            },
                            {
                                "target_lang_word": "顺序",
                                "target_lang_sense_clarification": "事物排列的先后次序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c0004b6-a145-31f5-9957-65edb562c390",
                    "sense_definition": "The state of being sequent or following; order of succession.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please complete the listed tasks in <w>sequence</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выполняйте перечисленные задачи по <w>порядку</w>.",
                                "tr": "Lütfen listelenen görevleri <w>sırayla</w> tamamlayın.",
                                "zh": "请按<w>次序</w>完成列出的任务。"
                            }
                        },
                        {
                            "text": "The pages of the book were out of <w>sequence</w>.",
                            "target_lang_translations": {
                                "ru": "Страницы книги были не по <w>порядку</w>.",
                                "tr": "Kitabın sayfaları <w>sırasızdı</w>.",
                                "zh": "书页的<w>顺序</w>乱了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "succession"
                    ],
                    "common_phrases": [
                        "in sequence",
                        "out of sequence",
                        "chronological sequence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние следования или нахождения позади; порядок преемственности.",
                        "tr": "Arka arkaya gelme veya takip etme durumu; sıralama düzeni.",
                        "zh": "事物跟随或排列的状态；先后次序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порядок",
                                "target_lang_sense_clarification": "правильное расположение, последовательный ход"
                            },
                            {
                                "target_lang_word": "очерёдность",
                                "target_lang_sense_clarification": "последовательность в очереди"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sıra",
                                "target_lang_sense_clarification": "düzen, sıralama"
                            },
                            {
                                "target_lang_word": "silsile",
                                "target_lang_sense_clarification": "birbirine bağlı olaylar sırası"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "次序",
                                "target_lang_sense_clarification": "排列的先后顺序"
                            },
                            {
                                "target_lang_word": "顺序",
                                "target_lang_sense_clarification": "事物排列的先后"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9265ed27-cb44-37b5-892e-431407931dc5",
                    "sense_definition": "A series of shots that depict a single action or style in a film or television show.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie features a thrilling car chase <w>sequence</w>.",
                            "target_lang_translations": {
                                "ru": "В фильме есть захватывающий <w>эпизод</w> с погоней на машинах.",
                                "tr": "Filmde heyecan verici bir araba takibi <w>sekansı</w> yer alıyor.",
                                "zh": "这部电影有一个惊险的汽车追逐<w>片段</w>。"
                            }
                        },
                        {
                            "text": "The director filmed the dream <w>sequence</w> in black and white.",
                            "target_lang_translations": {
                                "ru": "Режиссер снял <w>сцену</w> сна в черно-белом цвете.",
                                "tr": "Yönetmen rüya <w>sahnesini</w> siyah beyaz çekti.",
                                "zh": "导演用黑白镜头拍摄了梦境<w>场景</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dream sequence",
                        "action sequence",
                        "opening sequence"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Film"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия кадров, изображающих одно действие или стиль в фильме или телешоу.",
                        "tr": "Sinema veya televizyonda tek bir eylemi veya tarzı gösteren çekimler dizisi.",
                        "zh": "电影或电视节目中表现单一动作或风格的一系列镜头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эпизод",
                                "target_lang_sense_clarification": "часть фильма"
                            },
                            {
                                "target_lang_word": "сцена",
                                "target_lang_sense_clarification": "часть действия в фильме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sekans",
                                "target_lang_sense_clarification": "sinema terimi, olaylar dizisi"
                            },
                            {
                                "target_lang_word": "sahne",
                                "target_lang_sense_clarification": "film veya dizideki bölüm"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "片段",
                                "target_lang_sense_clarification": "电影中连续的场景"
                            },
                            {
                                "target_lang_word": "场景",
                                "target_lang_sense_clarification": "电影中表现特定动作的段落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82275777-853d-31d2-b578-1940fc5ede03",
                    "sense_definition": "An ordered list of objects, typically indexed with natural numbers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Fibonacci <w>sequence</w> appears often in nature.",
                            "target_lang_translations": {
                                "ru": "<w>Последовательность</w> Фибоначчи часто встречается в природе.",
                                "tr": "Fibonacci <w>dizisi</w> doğada sıkça karşımıza çıkar.",
                                "zh": "斐波那契<w>数列</w>在自然界中经常出现。"
                            }
                        },
                        {
                            "text": "Calculate the next number in the <w>sequence</w>.",
                            "target_lang_translations": {
                                "ru": "Вычислите следующее число в <w>последовательности</w>.",
                                "tr": "<w>Dizideki</w> bir sonraki sayıyı hesaplayın.",
                                "zh": "计算该<w>数列</w>中的下一个数字。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упорядоченный список объектов, обычно пронумерованных натуральными числами.",
                        "tr": "Genellikle doğal sayılarla indekslenen, nesnelerin sıralı listesi.",
                        "zh": "一个有序的对象列表，通常用自然数索引。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последовательность",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dizi",
                                "target_lang_sense_clarification": "matematiksel terim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数列",
                                "target_lang_sense_clarification": "数学中按一定规律排列的数"
                            },
                            {
                                "target_lang_word": "序列",
                                "target_lang_sense_clarification": "数学中元素的有序排列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f916f510-6fa4-36aa-b6c3-dc38fe6c7794",
                    "sense_definition": "A series of musical phrases where a theme or melody is repeated, with some change each time, such as in pitch or length.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer used a melodic <w>sequence</w> to build tension.",
                            "target_lang_translations": {
                                "ru": "Композитор использовал мелодическую <w>секвенцию</w> для нагнетания напряжения.",
                                "tr": "Besteci gerilimi tırmandırmak için melodik bir <w>sekans</w> kullandı.",
                                "zh": "作曲家使用旋律<w>模进</w>来营造紧张感。"
                            }
                        },
                        {
                            "text": "Beethoven's Fifth Symphony opens with a famous <w>sequence</w>.",
                            "target_lang_translations": {
                                "ru": "Пятая симфония Бетховена открывается знаменитой <w>секвенцией</w>.",
                                "tr": "Beethoven'ın Beşinci Senfonisi ünlü bir <w>sekansla</w> başlar.",
                                "zh": "贝多芬的第五交响曲以一段著名的<w>模进</w>开场。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия музыкальных фраз, где тема или мелодия повторяется с некоторыми изменениями, например, по высоте или длительности.",
                        "tr": "Müzikte bir temanın veya melodinin perde ya da uzunluk gibi değişikliklerle tekrarlandığı dizilim.",
                        "zh": "一种音乐短句系列，其中主题或旋律在每次重复时会有音高或长度等方面的变化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "секвенция",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sekans",
                                "target_lang_sense_clarification": "müzik terimi"
                            },
                            {
                                "target_lang_word": "dizi",
                                "target_lang_sense_clarification": "müzikal motif dizilimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模进",
                                "target_lang_sense_clarification": "音乐术语，指旋律在不同音高上的重复"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "076df78a-da41-3906-85b7-c23f7a3fea5b",
                    "sense_definition": "A meld consisting of three or more cards of successive ranks in the same suit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She won the game with a <w>sequence</w> of hearts.",
                            "target_lang_translations": {
                                "ru": "Она выиграла игру с <w>последовательностью</w> червей.",
                                "tr": "Oyunu kupa <w>serisiyle</w> kazandı.",
                                "zh": "她凭借一副红桃<w>顺子</w>赢得了比赛。"
                            }
                        },
                        {
                            "text": "You need a <w>sequence</w> of at least three cards to score points.",
                            "target_lang_translations": {
                                "ru": "Чтобы набрать очки, нужна <w>последовательность</w> как минимум из трех карт.",
                                "tr": "Puan kazanmak için en az üç kartlık bir <w>seriye</w> ihtiyacınız var.",
                                "zh": "你需要至少三张牌的<w>顺子</w>才能得分。"
                            }
                        }
