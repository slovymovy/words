                "senses": [
                    {
                        "sense_id": "a00d66f5-f8a2-3390-903e-b1c0954c3aa1",
                        "entry_id": "157beded-0230-35c2-b2ff-7c8edb179746",
                        "glosses": [
                            "Form/Gestaltung der Schriftzeichen, charakteristische Merkmale der Schrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d943041-7355-45b9-8e7a-88d62b9f2384",
                                "sense_id": "a00d66f5-f8a2-3390-903e-b1c0954c3aa1",
                                "text": "Die Graphie ist Gegenstand der Graphemik."
                            },
                            {
                                "example_id": "b8d67422-1a8c-43b5-acaa-16ebb234b80a",
                                "sense_id": "a00d66f5-f8a2-3390-903e-b1c0954c3aa1",
                                "text": "„Für die Graphemik ist die Unterscheidung von Graphie und Typographie nur insofern wichtig, als sie bei der Bestimmung des Graphems - der kleinsten distinktiven Einheit - und seiner Varianten von Bedeutung ist.“"
                            },
                            {
                                "example_id": "2733989a-3b9f-4889-9c5d-789a2b380b08",
                                "sense_id": "a00d66f5-f8a2-3390-903e-b1c0954c3aa1",
                                "text": "„…unter dem Gesichtspunkt der Funktionsweise der Schrift, d.h. der perzeptuellen und kognitiven Verarbeitung schriftlicher Dokumente ist diese Vielfalt in der Abbildungsrelation zwischen Graphie und Phonie ein Vorzug…“"
                            },
                            {
                                "example_id": "ee8f8d1e-836b-477d-93a8-9fbe33c557b2",
                                "sense_id": "a00d66f5-f8a2-3390-903e-b1c0954c3aa1",
                                "text": "„Vergleicht man die Graphie des Isländischen mit der des Deutschen wie mit der der skandinavischen Sprachen des Kontinents, stellt man fest, daß es Buchstaben gibt, die in keiner anderen Sprache vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
