                "senses": [
                    {
                        "sense_id": "68ee9ee5-3be8-3de2-8ac4-65fca11941e4",
                        "entry_id": "498301b4-f9ce-3aa6-9d71-972ac4f029cf",
                        "glosses": [
                            "Stopp von Atomwaffentests für militärische und zivile Zwecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb403aa-3bc1-45a0-b7a1-73dfe861b7bf",
                                "sense_id": "68ee9ee5-3be8-3de2-8ac4-65fca11941e4",
                                "text": "Ein Teststopp, heißt es in Washington, liege weder im Interesse der Vereinigten Staaten noch ihrer Verbündeten, basta."
                            },
                            {
                                "example_id": "fe2f95d1-9fbf-4240-94f1-6d011926b516",
                                "sense_id": "68ee9ee5-3be8-3de2-8ac4-65fca11941e4",
                                "text": "Verkehrte Welt: Da hatten die Vereinigten Staaten jahrzehntelang auf einen atomaren Teststopp gedrängt, waren aber immer wieder an der sowjetischen Weigerung gescheitert, ein solches Abkommen hinreichend überwachen zu lassen."
                            },
                            {
                                "example_id": "f1fe472d-7507-40f7-8af2-fe32969de604",
                                "sense_id": "68ee9ee5-3be8-3de2-8ac4-65fca11941e4",
                                "text": "Amerikaner und Franzosen lehnten es ab, die auf der vorigen RevCon im Jahr 2000 mit ihren Stimmen beschlossenen \"13 Schritte der nuklearen Abrüstung\" auch nur in irgendeinem Dokument zu erwähnen – nuklearer Teststopp, Beschränkung der Raketenabwehr, das alles sollte plötzlich kein Thema mehr sein."
                            },
                            {
                                "example_id": "ab5400bb-c0e8-40f1-b6e9-5b2cad9a5294",
                                "sense_id": "68ee9ee5-3be8-3de2-8ac4-65fca11941e4",
                                "text": "Vollkommen ungewiss ist dagegen, ob und wann der US-Senat das schon 1996 vereinbarte Teststopp-Abkommen ratifizieren wird."
                            },
                            {
                                "example_id": "90149da7-ab29-4eb6-add9-1c4f83c1c3e2",
                                "sense_id": "68ee9ee5-3be8-3de2-8ac4-65fca11941e4",
                                "text": "Zwar heißt es in Neu-Delhi, dass die Regierung nachgeben könne, falls es Obama wirklich ernst mit der Ratifizierung des Teststopp-Vertrages meine."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
