                                "example_id": "dd401e40-a23e-437a-b8e8-3366ed657fbd",
                                "sense_id": "7f77f2a3-e02d-34da-a126-fa84a09c742e",
                                "text": "„Auf ihrem Sonderparteitag will die FDP mit der Konzentration auf aktuelle Themen wieder bei den Bundesbürgern punkten und aus ihrem Umfragetief herauskommen.“"
                            },
                            {
                                "example_id": "fb99912a-b997-4932-a380-e23a079b3cf7",
                                "sense_id": "7f77f2a3-e02d-34da-a126-fa84a09c742e",
                                "text": "„Offiziell wurde Glogo erst am 10. Oktober 1998 - zwei Wochen nach der Bundestagswahl - auf einem Sonderparteitag für das Amt des Ministerpräsidenten nominiert.“"
                            }
