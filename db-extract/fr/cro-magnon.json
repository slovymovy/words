                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "00774e47-1a7c-4c43-8818-294cb83aaf29",
                        "source_entry_id": "588b6dae-4d12-3882-a3ed-548d49e1e62d",
