            {
                "entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                "word": "penicillin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5f7aa5f3-86ae-4460-bc73-68f16b2f9c13",
                        "entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "tags": [
                            "plural"
                        ],
