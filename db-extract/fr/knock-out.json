                                                "example_id": "3b78f949-bfc6-4d41-ae0c-ac3696959a38",
                                                "sense_id": "2db7c876-b28a-3706-b81b-b1768040c890",
                                                "text": "Tottenham were knocked out of the Europa League, despite a comfortable victory over Shamrock Rovers in Dublin."
                                            }
