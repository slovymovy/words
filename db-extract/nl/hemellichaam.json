                        "source_sense_id": "0ef72920-c6db-3865-a5b9-3a0a3eb17b5e",
                        "target_lang_word": "Himmelskörper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Himmelskörper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16a5aaa0-029e-3006-840b-68dfb3e6fe51",
                                        "entry_id": "ffc1f82b-d9fc-3d1a-a9c4-83d62ec5bbad",
                                        "glosses": [
                                            "kosmisches Objekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ebea55-2a3d-424a-aae8-7b891321273d",
                                                "sense_id": "16a5aaa0-029e-3006-840b-68dfb3e6fe51",
                                                "text": "Benannt wurde der Himmelskörper nach dem Ehemann der Entdeckerin."
                                            },
                                            {
                                                "example_id": "3f97bd0d-f012-48a8-a298-1aa34db2d0d8",
                                                "sense_id": "16a5aaa0-029e-3006-840b-68dfb3e6fe51",
                                                "text": "„Der wissenschaftlichen Welt war durchaus bewußt, was sich ereignet hatte: zum erstenmal war die Wissenschaft über die Theorie Newtons von der Bewegung der Himmelskörper hinausgegangen.“"
                                            },
                                            {
                                                "example_id": "df1c7eb8-56d3-4e7a-adc9-0a9b58af3c8a",
                                                "sense_id": "16a5aaa0-029e-3006-840b-68dfb3e6fe51",
                                                "text": "„Sieben allegorische Frauenfiguren verkörpern zugleich die sieben Wochentage, die sieben freien Künste, sieben Tugenden, sieben Farben, sieben Himmelskörper und sieben Metalle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8546cb8f-c48f-4adc-86bc-e4228ed77978",
                        "source_entry_id": "5e729f08-ff23-3868-b8b5-75ee0f1e5b7d",
