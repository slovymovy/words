            "senses": [
                {
                    "sense_id": "1ba4ba38-bde3-37a3-ab1c-90d5f2e9d54d",
                    "sense_definition": "beschikbaar komen voor gebruik of vervulling",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beschikbaarheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegens een onverwachte afzegging is er een <w>plaats</w> <w>vrijgekomen</w> bij mijn workshop.",
                            "target_lang_translations": {
                                "en": "Due to an unexpected cancellation, a spot has <w>become available</w> at my workshop."
                            }
                        },
                        {
                            "text": "Zodra er een <w>woning</w> <w>vrijkomt</w> in dit gebouw, laten we het je weten.",
                            "target_lang_translations": {
                                "en": "As soon as a home <w>becomes vacant</w> in this building, we will let you know."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschikbaar komen",
                        "leegkomen"
                    ],
                    "antonyms": [
                        "bezet raken"
                    ],
                    "common_phrases": [
                        "plaats vrijkomen",
                        "woning vrijkomen",
                        "functie vrijkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To become available for use, occupancy, or fulfillment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to become available",
                                "target_lang_sense_clarification": "general availability"
                            },
                            {
                                "target_lang_word": "to open up",
                                "target_lang_sense_clarification": "for positions or opportunities"
                            },
                            {
                                "target_lang_word": "to become vacant",
                                "target_lang_sense_clarification": "for housing or seats"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ee0f1f5-50c5-38f0-87b0-94dfced92ee9",
                    "sense_definition": "uit gevangenschap of hechtenis worden ontslagen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vrijlating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na twintig jaar in de gevangenis te hebben gezeten <w>kwam</w> de man eindelijk <w>vrij</w>.",
                            "target_lang_translations": {
                                "en": "After spending twenty years in prison, the man was finally <w>released</w>."
                            }
                        },
                        {
                            "text": "De advocaat hoopt dat zijn cliënt volgende week <w>vrij</w> zal <w>komen</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer hopes that his client will <w>be set free</w> next week."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijgelaten worden"
                    ],
                    "antonyms": [
                        "vastzitten",
                        "opgesloten worden"
                    ],
                    "common_phrases": [
                        "voorwaardelijk vrijkomen",
                        "uit gevangenschap vrijkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be released from prison, custody, or detention"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be released",
                                "target_lang_sense_clarification": "from custody"
                            },
                            {
                                "target_lang_word": "to get out",
                                "target_lang_sense_clarification": "informal, from prison"
                            },
                            {
                                "target_lang_word": "to be set free",
                                "target_lang_sense_clarification": "regaining liberty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de58801e-5b70-335e-acfc-61b486b03d0c",
                    "sense_definition": "beschikbaar worden voor uitbetaling of gebruik van financiële middelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financiën",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Volgend jaar <w>komt</w> de <w>lijfrente</w> <w>vrij</w> en kunnen we de reis maken.",
                            "target_lang_translations": {
                                "en": "Next year the annuity will <w>mature</w> and we can go on the trip."
                            }
                        },
                        {
                            "text": "Er moet meer <w>geld</w> <w>vrijkomen</w> voor het onderhoud van de wegen.",
                            "target_lang_translations": {
                                "en": "More money must <w>be made available</w> for road maintenance."
                            }
                        }
                    ],
                    "synonyms": [
                        "loskomen"
                    ],
                    "antonyms": [
                        "vaststaan"
                    ],
                    "common_phrases": [
                        "geld vrijkomen",
                        "lijfrente vrijkomen",
                        "budget vrijkomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in zakelijke of financiële context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become available for payout or use (regarding financial resources)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be released",
                                "target_lang_sense_clarification": "of funds or budgets"
                            },
                            {
                                "target_lang_word": "to become available",
                                "target_lang_sense_clarification": "financial means"
                            },
                            {
                                "target_lang_word": "to mature",
                                "target_lang_sense_clarification": "of an insurance policy or annuity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cd95a69-bc4f-3b9d-94cb-956adf8e17e4",
                    "sense_definition": "ontstaan of ontsnappen als gevolg van een proces of reactie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wetenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kernenergie is energie die <w>vrijkomt</w> met behulp van de brandstof uranium.",
                            "target_lang_translations": {
                                "en": "Nuclear energy is energy that <w>is released</w> using uranium fuel."
                            }
                        },
                        {
                            "text": "Bij deze chemische reactie <w>komt</w> een grote hoeveelheid <w>warmte</w> <w>vrij</w>.",
                            "target_lang_translations": {
                                "en": "In this chemical reaction, a large amount of heat <w>is given off</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsnappen"
                    ],
                    "common_phrases": [
                        "energie vrijkomen",
                        "warmte vrijkomen",
                        "stoffen vrijkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be generated or escape as a result of a process or reaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be released",
                                "target_lang_sense_clarification": "of energy, heat, or substances"
                            },
                            {
                                "target_lang_word": "to be emitted",
                                "target_lang_sense_clarification": "scientific context"
                            },
                            {
                                "target_lang_word": "to be given off",
                                "target_lang_sense_clarification": "of heat or gas"
                            }
                        ]
                    }
                }
