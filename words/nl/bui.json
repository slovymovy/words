                        {
                            "text": "Hij was in een slechte <w>bui</w> toen hij om drie uur 's nachts gebeld werd.",
                            "target_lang_translations": {
                                "en": "He was in a bad <w>mood</w> when he was called at three o'clock at night.",
                                "ru": "Он был в плохом <w>настроении</w>, когда ему позвонили в три часа ночи.",
                                "pl": "Był w złym <w>humorze</w>, kiedy zadzwoniono do niego o trzeciej w nocy.",
                                "de": "Er war in einer schlechten <w>Laune</w>, als er nachts um drei Uhr angerufen wurde.",
                                "fr": "Il était de mauvaise <w>humeur</w> quand on l'a appelé à trois heures du matin.",
                                "it": "Era di cattivo <w>umore</w> quando è stato chiamato alle tre di notte.",
                                "cs": "Měl špatnou <w>náladu</w>, když mu ve tři hodiny ráno volali.",
                                "tr": "Gece saat üçte arandığında kötü bir <w>ruh halindeydi</w>.",
                                "es": "Estaba de mal <w>humor</w> cuando lo llamaron a las tres de la mañana."
                            }
                        },
                        {
                            "text": "Als mijn moeder in een goede <w>bui</w> is, zingt ze de hele dag.",
                            "target_lang_translations": {
                                "en": "When my mother is in a good <w>mood</w>, she sings all day.",
                                "ru": "Когда моя мама в хорошем <w>настроении</w>, она поет весь день.",
                                "pl": "Kiedy moja mama jest w dobrym <w>humorze</w>, śpiewa przez cały dzień.",
                                "de": "Wenn meine Mutter in einer guten <w>Laune</w> ist, singt sie den ganzen Tag.",
                                "fr": "Quand ma mère est de bonne <w>humeur</w>, elle chante toute la journée.",
                                "it": "Quando mia madre è di buon <w>umore</w>, canta tutto il giorno.",
                                "cs": "Když má moje matka dobrou <w>náladu</w>, zpívá celý den.",
                                "tr": "Annemin <w>keyfi</w> yerinde olduğunda bütün gün şarkı söyler.",
                                "es": "Cuando mi madre está de buen <w>humor</w>, canta todo el día."
