                        "glosses": [
                            "восхваление, панегирик; победная песнь, хвалебная песнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff639a5-2347-4346-8cb0-cc3b2a3687ab",
                                "sense_id": "fbcf2e6b-7207-3b3a-adae-1e21e4d5592b",
                                "text": "Ignosi bound the diadem upon his brows, and advancing placed his foot upon the broad chest of his headless foe and broke out into a chant, or rather a pæan of triumph, so beautiful, and yet so utterly savage, that I despair of being able to give an adequate idea of it."
