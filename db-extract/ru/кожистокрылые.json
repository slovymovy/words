                        ]
                    },
                    {
                        "translation_id": "d3527fad-608d-426f-a500-cebef7f3aac7",
                        "source_entry_id": "bb66cadd-abc0-35d4-bf2e-7a889b041ba4",
                        "source_sense_id": "70b3f29c-71e8-3ad2-a429-f63aff588ef5",
                        "target_lang_word": "Ohrwurm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrwurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7698b6e1-ddaa-3d6c-a5a5-66958b1b7dc8",
                                        "entry_id": "dc59fd8e-9dd4-3f65-a377-7c75c1261ede",
                                        "glosses": [
                                            "kleines meist geflügeltes Insekt, das beispielsweise in Ritzen oder Spalten lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499d3238-dc5f-4eb8-8772-9e8eb62fd315",
                                                "sense_id": "7698b6e1-ddaa-3d6c-a5a5-66958b1b7dc8",
                                                "text": "„Ohrwürmer verzehren große Mengen von Blattläusen.“"
                                            },
                                            {
                                                "example_id": "7145497a-82d2-4129-b95c-225696f1f8ea",
                                                "sense_id": "7698b6e1-ddaa-3d6c-a5a5-66958b1b7dc8",
                                                "text": "Ohrwürmer repräsentieren innerhalb der Insekten systematisch die Ordnung der Dermaptera und treten mit Schwerpunkt in den Tropen weltweit mit ca. 1400 Arten auf. In Europa leben ca. 34 Arten und von den in Mitteleuropa lebenden 7-9 Arten ist der Gemeine Ohrwurm Forficula auricularia der häufigste. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "f79cfe5c-bb7c-4a64-b466-26d2b8b55f3f",
                                                "sense_id": "7698b6e1-ddaa-3d6c-a5a5-66958b1b7dc8",
                                                "text": "Der Ohrwurm kriecht nicht in die Ohren wie fälschlich oft angenommen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9f85567-bfc8-3569-a5aa-4f795f08a614",
                                        "entry_id": "dc59fd8e-9dd4-3f65-a377-7c75c1261ede",
                                        "glosses": [
                                            "sich anbiedernde Person"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c22375-cd45-4cab-bcac-24e72132b9e6",
                                                "sense_id": "f9f85567-bfc8-3569-a5aa-4f795f08a614",
                                                "text": "Jetzt war Lobedanz wieder ganz Ohrwurm. (Hans Fallada, Der Trinker, 1944)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b11eba87-9678-38de-ba9c-906c513b1eaf",
                                        "entry_id": "dc59fd8e-9dd4-3f65-a377-7c75c1261ede",
                                        "glosses": [
                                            "eingängige Melodie, die einem nicht mehr aus dem Kopf geht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881385ca-ad57-4f89-a705-21a0d531fc78",
                                                "sense_id": "b11eba87-9678-38de-ba9c-906c513b1eaf",
                                                "text": "Alle Lieder sind potentielle Hits, welche sich gerne als Ohrwurm bei den Zuhörern einmieten. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "6e891c99-b39d-4eae-8e25-ed486ce05b4c",
                                                "sense_id": "b11eba87-9678-38de-ba9c-906c513b1eaf",
                                                "text": "Da fragt man sich doch, wie diese vermeintlich untalentierten Jungs so einen Ohrwurm fabrizieren können. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "deea8368-c252-47b4-af06-0dd5a9f0cfcd",
                                                "sense_id": "b11eba87-9678-38de-ba9c-906c513b1eaf",
                                                "text": "Die Mathematik in der Musiktheorie hat gezeigt, dass begnadete Musiker und Komponisten ihre Melodien um einen oder mehrere Referenztöne organisieren. Wenn dabei ein Ohrwurm herauskommt, ist es für den Hörer etwas Rekursives: Die Melodie will und will nicht aus dem Kopf gehen, solange sich daran Erinnerungen klammern. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "f5765828-809b-43de-a059-a7c36228292c",
                                                "sense_id": "b11eba87-9678-38de-ba9c-906c513b1eaf",
                                                "text": "„Vergnügt wie lange nicht mehr sprang sie die Treppen des teilrenovierten WBS 70 hinunter, den neuesten Ohrwurm aus dem Morgenradio auf ihren Lippen.“"
                                            },
                                            {
                                                "example_id": "f3f73466-0e87-4053-86b2-988d355c5238",
                                                "sense_id": "b11eba87-9678-38de-ba9c-906c513b1eaf",
                                                "text": "„Wieland nun schließt eine eigene Erzählung dieser Episode an, sie wird eine kleine Studie über Massenbegeisterung, Gassenhauer, Ohrwürmer und so weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f9ab73fa-1306-3704-b848-a2298c6179a2",
                                        "entry_id": "dc59fd8e-9dd4-3f65-a377-7c75c1261ede",
                                        "glosses": [
                                            "Erkrankung der Ohren bei Jagdhunden"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414d522c-e86a-4f48-874b-7da9a9880e88",
                                                "sense_id": "f9ab73fa-1306-3704-b848-a2298c6179a2",
                                                "text": "In den wenigen an ein gemischtes Publikum gerichteten Büchern, die sich zu Beginn des 19. Jahrhunderts speziell mit Erkrankungen des Hundes befassten, fanden als Hautkrankheiten lediglich die Räude und der “Ohrwurm” bzw. “Ohrkrebs” Erwähnung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28ce9351-a901-439c-be8f-da7d6f3c62fe",
                        "source_entry_id": "bb66cadd-abc0-35d4-bf2e-7a889b041ba4",
                        "source_sense_id": "70b3f29c-71e8-3ad2-a429-f63aff588ef5",
                        "target_lang_word": "perce-oreille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perce-oreille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a24dcd85-01eb-39c9-a870-28faa0f1c342",
                                        "entry_id": "00c21bd2-ec40-3480-9f81-1449aa640d2a",
                                        "glosses": [
                                            "Nom vernaculaire de Forficula auricularia, insecte dont l’abdomen se termine par deux crochets ou cerques en forme de tenaille, mais bien incapables de percer une oreille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1e7bc5-c383-4fe9-933e-d74b9e38d779",
                                                "sense_id": "a24dcd85-01eb-39c9-a870-28faa0f1c342",
                                                "text": "A regarder un perce-oreille, on n’imagine pas qu’il puisse voler !"
                                            },
                                            {
                                                "example_id": "259fd714-1283-4b7b-a003-2aa6f5790066",
                                                "sense_id": "a24dcd85-01eb-39c9-a870-28faa0f1c342",
                                                "text": "Il y a des perce-oreilles dans les chantiers des Ursulines, il y a des mille-pieds au Panthéon, il y a des têtards dans les fossés du Champ de Mars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdd2a51d-bba2-4902-92cf-c0c37c4c04d9",
                        "source_entry_id": "bb66cadd-abc0-35d4-bf2e-7a889b041ba4",
                        "source_sense_id": "70b3f29c-71e8-3ad2-a429-f63aff588ef5",
                        "target_lang_word": "forficule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
