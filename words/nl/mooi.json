                    "examples": [
                        {
                            "text": "Zij heeft een heel <w>mooi</w> gezicht en prachtige ogen.",
                            "target_lang_translations": {
                                "en": "She has a very <w>beautiful</w> face and lovely eyes.",
                                "ru": "У неё очень <w>красивое</w> лицо и прекрасные глаза.",
                                "pl": "Ona ma bardzo <w>ładną</w> twarz i piękne oczy.",
                                "de": "Sie hat ein sehr <w>schönes</w> Gesicht und wunderschöne Augen.",
                                "fr": "Elle a un très <w>beau</w> visage et des yeux magnifiques.",
                                "it": "Ha un viso davvero <w>bello</w> e degli occhi meravigliosi.",
                                "cs": "Má velmi <w>krásný</w> obličej a nádherné oči.",
                                "tr": "Onun çok <w>güzel</w> bir yüzü ve harika gözleri var.",
                                "es": "Ella tiene una cara muy <w>bonita</w> y unos ojos hermosos."
                            }
                        },
                        {
                            "text": "Wat een <w>mooi</w> schilderij hangt daar aan de muur.",
                            "target_lang_translations": {
                                "en": "What a <w>beautiful</w> painting is hanging on the wall there.",
                                "ru": "Какая <w>красивая</w> картина висит там на стене.",
                                "pl": "Co za <w>piękny</w> obraz wisi tam na ścianie.",
                                "de": "Was für ein <w>schönes</w> Bild hängt dort an der Wand.",
                                "fr": "Quel <w>beau</w> tableau est accroché là sur le mur.",
                                "it": "Che <w>bel</w> quadro è appeso lì alla parete.",
                                "cs": "To je ale <w>krásný</w> obraz, co tam visí na zdi.",
                                "tr": "Duvarda ne <w>güzel</w> bir tablo asılı duruyor.",
                                "es": "Qué cuadro tan <w>hermoso</w> cuelga allí en la pared."
                            }
                        }
