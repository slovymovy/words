                    {
                        "translation_id": "96cbe108-37b3-4ceb-a418-d411fc53f8ee",
                        "source_entry_id": "828ce3e7-9d08-3af3-8d68-8806bf64805c",
                        "source_sense_description": "physical comedy",
                        "target_lang_word": "буффона́да",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "буффона́да",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "df31766d-1d5d-3f9f-a7d6-e8bacfc325f4",
                                        "entry_id": "8ab3efaa-8b18-3a5f-8281-1e32931958ab",
                                        "glosses": [
                                            "резкое преувеличение комического, окарикатуривание персонажей, их действий, поступков и т. п. в сценическом произведении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956e51eb-ef8e-4eab-9a54-92a0ecf39b10",
                                                "sense_id": "df31766d-1d5d-3f9f-a7d6-e8bacfc325f4",
                                                "text": "Режиссёр ценил тонкий юмор в пьесе и в актёрской игре, и не одобрял грубой буффонады. У нас театр, а не цирк, говорил он актёрам, а вы артисты, а не клоуны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd8a7e42-4e2a-3d3c-96c3-b1927a086d15",
                                        "entry_id": "8ab3efaa-8b18-3a5f-8281-1e32931958ab",
                                        "glosses": [
                                            "театр., цирк. сценическое или цирковое представление, построенное на преувеличенно-комических, шутовских положениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886bf13e-7738-403a-bd14-eb1a0cc291b7",
                                                "sense_id": "cd8a7e42-4e2a-3d3c-96c3-b1927a086d15",
                                                "text": "До какой же степени неверия и нигилизма дошла наша золотая молодежь, чтобы даже из собственной смерти устраивать буффонаду?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc9cd6fb-3a41-3569-b659-3b8e6f514b4f",
                                        "entry_id": "8ab3efaa-8b18-3a5f-8281-1e32931958ab",
                                        "glosses": [
                                            "перен. неуместное, нелепое, грубое шутовство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880d6060-4a0e-4154-9160-c88ccb2c13e1",
                                                "sense_id": "fc9cd6fb-3a41-3569-b659-3b8e6f514b4f",
                                                "text": "Прекратите эту буффонаду!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "266c5175-0a15-4821-b2a0-c3d90e7ab7c3",
                        "source_entry_id": "828ce3e7-9d08-3af3-8d68-8806bf64805c",
