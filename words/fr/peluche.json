                    "frequency": "High",
                    "semantic_group_id": "jouet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant serre fort sa <w>peluche</w> préférée pour s'endormir paisiblement."
                        },
                        {
                            "text": "Elle a reçu un grand ours en <w>peluche</w> pour son anniversaire."
                        }
                    ],
                    "synonyms": [
                        "toutou"
                    ],
                    "common_phrases": [
                        "ours en peluche",
                        "animal en peluche"
                    ]
                },
                {
                    "sense_id": "0bfab1f8-079b-304a-be40-a0d61085f3f4",
                    "sense_definition": "Petites boules ou fils textiles qui se détachent d'un tissu par frottement ou usure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux pull en laine perd de la matière et fait des <w>peluches</w>."
                        },
                        {
                            "text": "Il utilise une brosse adhésive pour enlever chaque <w>peluche</w> collée sur son manteau."
                        }
                    ],
                    "common_phrases": [
