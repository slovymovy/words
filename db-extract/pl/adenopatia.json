                                    {
                                        "sense_id": "c601d274-17f1-3249-ad26-8c3aacecb907",
                                        "entry_id": "3436bef9-972e-3952-bc59-392319a33671",
                                        "glosses": [
                                            "Erkrankung endokriner oder exokriner Drüsen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3ad813-49a0-4f72-bf19-9062c1d5c394",
                                                "sense_id": "c601d274-17f1-3249-ad26-8c3aacecb907",
                                                "text": "Bei jungen Erwachsenen ist die Ursache der Adenopathie meist infektiös oder reaktiv, bei älteren Menschen oft eine Neoplasie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b66c12e-9781-3d46-9c47-bcca123b11e6",
                                        "entry_id": "3436bef9-972e-3952-bc59-392319a33671",
                                        "glosses": [
                                            "Erkrankung der Lymphknoten, ganz besonders die der Bronchial-Drüse"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "867408ac-9407-4835-8ed0-acf502293616",
                                                "sense_id": "3b66c12e-9781-3d46-9c47-bcca123b11e6",
                                                "text": "Dieses Zeichen ist für den Spezialisten interessant, insoferne, als es bei der tracheo-bronchialen Adenopathie vorkommt, die eine so grosse Bedeutung in der Diagnose der Krankheiten der oberen Luftwege hat."
                                            },
                                            {
                                                "example_id": "18116b85-c714-4093-ae42-741b6110e638",
                                                "sense_id": "3b66c12e-9781-3d46-9c47-bcca123b11e6",
                                                "text": "Das Sekundärstadium beginnt mit einer schmerzhaften inguinalen Adenopathie."
                                            }
                                        ],
