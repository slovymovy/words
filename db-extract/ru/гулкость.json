                    {
                        "translation_id": "5eeb7f8c-2582-4095-9711-1e8fd27ef00d",
                        "source_entry_id": "b842166c-9dcb-30e2-a318-b579859d4674",
                        "source_sense_id": "912daac3-13c1-3aa3-abdd-378429cc0bff",
                        "target_lang_word": "sonorité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonorité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a94e0ac-cd6c-370e-8f31-efbfabf585bd",
                                        "entry_id": "dd2beb2f-15f0-3bc1-9a98-465648170b56",
                                        "glosses": [
                                            "Qualité de ce qui est sonore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08943a3-b1ff-4f5f-b022-5f4a3667e4b6",
                                                "sense_id": "8a94e0ac-cd6c-370e-8f31-efbfabf585bd",
                                                "text": "La gelée avait si bien purifié l’air, durci la terre et saisi les pavés, que tout avait cette sonorité sèche dont les phénomènes nous surprennent toujours."
                                            },
                                            {
                                                "example_id": "43079913-8049-4023-b375-e61e0ac2b426",
                                                "sense_id": "8a94e0ac-cd6c-370e-8f31-efbfabf585bd",
                                                "text": "Le gavioli des chevaux de bois de la fête nous envoie par la porte grande ouverte ses sonorités criardes, parodie désagréable des orgues."
                                            },
                                            {
                                                "example_id": "23b2b795-ab0a-4f43-9afb-89c232ec3792",
                                                "sense_id": "8a94e0ac-cd6c-370e-8f31-efbfabf585bd",
                                                "text": "L’argent ! ce mot retentissait à mes oreilles, toutes les minutes. Je n’entendais jamais que le tintement de ce mot qui, à la fin, avait pris comme une sonorité d’écus remués."
                                            },
                                            {
                                                "example_id": "8258ad93-4106-4502-9b34-ce7979dbe88a",
                                                "sense_id": "8a94e0ac-cd6c-370e-8f31-efbfabf585bd",
                                                "text": "Né le 21 mai 1933 à Bab El-Oued, il est le fils de Lili Labassi, l’un des maîtres du chaâbi, musique aux sonorités arabo-andalouses et aux rythmes berbères, typique de ce quartier populaire d’Alger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06d0779-80f0-3387-b224-a4556654907b",
                                        "entry_id": "dd2beb2f-15f0-3bc1-9a98-465648170b56",
                                        "glosses": [
                                            "Intensité relative d’un phonème qui détermine la structure syllabique d’une langue. La sonorité diminue dans l’ordre suivant : voyelle, semi-voyelle, liquide, nasale, fricative et occlusive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
