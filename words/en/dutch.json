    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "607f8694-7e95-3512-babe-5543449cd3d4",
                    "sense_definition": "The Germanic language spoken in the Netherlands, Flanders (northern Belgium), and Suriname.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "language_sense",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Dutch</w> before moving to Amsterdam.",
                            "target_lang_translations": {
                                "ru": "Она учится говорить на <w>голландском</w> перед переездом в Амстердам.",
                                "zh": "在搬到阿姆斯特丹之前，她正在学习说<w>荷兰语</w>。"
                            }
                        },
                        {
                            "text": "Many documents are available in English, French, and <w>Dutch</w>.",
                            "target_lang_translations": {
                                "ru": "Многие документы доступны на английском, французском и <w>нидерландском</w>.",
                                "zh": "许多文件都有英语、法语和<w>荷兰语</w>版本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Dutch",
                        "learn Dutch",
                        "in Dutch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Германский язык, на котором говорят в Нидерландах, Фландрии (северная Бельгия) и Суринаме.",
                        "zh": "在荷兰、佛兰德（比利时北部）和苏里南使用的日耳曼语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нидерла́ндский",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "голла́ндский",
                                "target_lang_sense_clarification": "язык (разговорное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荷兰语",
                                "target_lang_sense_clarification": "通用名称"
                            },
                            {
                                "target_lang_word": "尼德兰语",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07d3f35f-8c80-32f7-962d-15086a948575",
                    "sense_definition": "Relating to the Netherlands, its people, or its language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought some delicious <w>Dutch</w> cheese at the market.",
                            "target_lang_translations": {
                                "ru": "Мы купили вкусный <w>голландский</w> сыр на рынке.",
                                "zh": "我们在市场上买了一些美味的<w>荷兰</w>奶酪。"
                            }
                        },
                        {
                            "text": "The <w>Dutch</w> economy has remained strong despite global challenges.",
                            "target_lang_translations": {
                                "ru": "<w>Нидерландская</w> экономика оставалась сильной, несмотря на глобальные проблемы.",
                                "zh": "尽管面临全球挑战，<w>荷兰</w>经济依然保持强劲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Dutch cheese",
                        "Dutch oven",
                        "Dutch tulip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Нидерландам, их народу или языку.",
                        "zh": "与荷兰、荷兰人或荷兰语相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голла́ндский",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "нидерла́ндский",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荷兰的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8bd204d-a7e0-3f0e-8c0d-bd995eeafcbe",
                    "sense_definition": "Relating to German-speaking communities in the United States, specifically the Pennsylvania Dutch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regional_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Pennsylvania <w>Dutch</w> community maintains many traditional customs.",
                            "target_lang_translations": {
                                "ru": "Община пенсильванских <w>немцев</w> сохраняет многие традиционные обычаи.",
                                "zh": "<w>宾夕法尼亚德语</w>社区保留了许多传统习俗。"
                            }
                        },
                        {
                            "text": "We visited a market selling traditional <w>Dutch</w> crafts from the local German settlers.",
                            "target_lang_translations": {
                                "ru": "Мы посетили рынок, где продавались традиционные ремесла <w>пенсильванских немцев</w> от местных немецких поселенцев.",
                                "zh": "我们参观了一个市场，那里出售当地<w>宾夕法尼亚德裔</w>定居者的传统手工艺品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Pennsylvania Dutch"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "USA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к немецкоязычным общинам в США, в частности к пенсильванским немцам.",
                        "zh": "与美国德语社区相关的，特别是宾夕法尼亚荷兰人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пенсильванско-немецкий",
                                "target_lang_sense_clarification": "диалект или культура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾夕法尼亚德语",
                                "target_lang_sense_clarification": "指宾夕法尼亚荷兰人所说的德语方言"
                            },
                            {
                                "target_lang_word": "宾夕法尼亚德裔",
                                "target_lang_sense_clarification": "指宾夕法尼亚荷兰人这一群体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6972469b-8236-335f-9ee2-3c0abad78ba2",
                    "sense_definition": "The people of the Netherlands collectively.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Dutch</w> are famous for their extensive use of bicycles.",
                            "target_lang_translations": {
                                "ru": "<w>Голландцы</w> славятся своим широким использованием велосипедов.",
                                "zh": "<w>荷兰人</w>以广泛使用自行车而闻名。"
                            }
                        },
                        {
                            "text": "Historically, the <w>Dutch</w> were great explorers and traders.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>голландцы</w> были великими исследователями и торговцами.",
                                "zh": "从历史上看，<w>荷兰人</w>曾是伟大的探险家和商人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Dutch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жители Нидерландов как нация.",
                        "zh": "荷兰的全体国民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голла́ндцы",
                                "target_lang_sense_clarification": "народ"
                            },
                            {
                                "target_lang_word": "нидерла́ндцы",
                                "target_lang_sense_clarification": "народ (официально)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荷兰人",
                                "target_lang_sense_clarification": "指代荷兰国民"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70ce7815-76e3-3de5-844b-7f28bcfad656",
                    "sense_definition": "To treat cocoa beans or powder with an alkali solution to darken the color and reduce bitterness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cocoa_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer <w>Dutched</w> the cocoa to give it a milder flavor.",
                            "target_lang_translations": {
                                "ru": "Производитель <w>алкализировал</w> какао, чтобы придать ему более мягкий вкус.",
                                "zh": "制造商对可可进行了<w>碱化</w>处理，使其口感更温和。"
                            }
                        },
                        {
                            "text": "You should use <w>Dutched</w> cocoa powder for this specific cake recipe.",
                            "target_lang_translations": {
                                "ru": "Для этого рецепта торта следует использовать <w>алкализованный</w> какао-порошок.",
                                "zh": "做这个特定的蛋糕食谱时，你应该使用<w>碱化</w>可可粉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Dutch process",
                        "Dutched cocoa"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать какао щелочным раствором для изменения цвета и уменьшения горечи.",
                        "zh": "用碱溶液处理可可豆或可可粉，以加深颜色并降低苦味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алкализировать",
                                "target_lang_sense_clarification": "какао"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碱化",
                                "target_lang_sense_clarification": "指可可加工工艺"
                            }
                        ]
                    }
                }
            ]
        }
    ]
