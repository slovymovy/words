        "fr-extract.jsonl": [
            {
                "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                "word": "plâtrage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fac53861-2d1d-46a3-85f1-4bc19ff176d4",
                        "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "plâtrages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1248e0ae-3648-38fb-96f4-e7f68e462cb6",
                        "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                        "glosses": [
                            "Action de plâtrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "442e866c-0734-4357-9007-02dbdde4f6cd",
                                "sense_id": "1248e0ae-3648-38fb-96f4-e7f68e462cb6",
                                "text": "Fracture du pied, souffrance, urgences hospitalières, soins inappropriés, mauvais plâtrage, replâtrage, béquilles, il fallut douze semaines avant qu’on prononçât ma guérison."
                            }
                        ]
                    },
                    {
                        "sense_id": "180e4c69-b102-315f-9bc4-cc51a65dae39",
                        "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                        "glosses": [
                            "Action d'apporter du plâtre ou du gypse pour fertiliser les terres."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6a8a4438-0874-446b-90cd-a9a25e16a52f",
                                "sense_id": "180e4c69-b102-315f-9bc4-cc51a65dae39",
                                "text": "En 1802, la Société centrale d'Agriculture (…) fit une enquête sur l'efficacité du plâtrage des légumineuses. Il en résulta que, sur 43 opinions émises, il y en eu 40 qui affirmèrent sa bonne action."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b53c390-3568-34a5-9acf-3d9e29ed9cc0",
                        "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                        "glosses": [
                            "Action d'ajouter du plâtre, au vin ; sulfatage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c7526892-0d13-41d9-8fad-79a9f502f669",
                                "sense_id": "0b53c390-3568-34a5-9acf-3d9e29ed9cc0",
                                "text": "La conclusion du mémoire de M. Lancereaux est « qu'il y a lieu de diminuer, sinon de prohiber le plâtrage ou sulfatage des vins et de toute autre boisson, en tout cas de chercher un moyen nouveau de conservation »."
                            }
                        ]
                    },
                    {
                        "sense_id": "73eeb926-5b3e-3181-99ef-57706ec874cc",
                        "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                        "glosses": [
                            "Ouvrage fait de plâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "316cfea4-151c-4f56-a459-1a047b663c39",
                                "sense_id": "73eeb926-5b3e-3181-99ef-57706ec874cc",
                                "text": "Ce n’est pas de la maçonnerie, c’est du plâtrage."
                            }
                        ]
                    },
                    {
                        "sense_id": "39b804a7-744f-3fc1-9e8b-a59e51a23c61",
                        "entry_id": "97460768-109b-35cd-bf66-52c60da527e7",
                        "glosses": [
                            "Action d'amender un sol par un apport de plâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b060bb7a-0f40-4c87-858c-eff131c645b3",
                                "sense_id": "39b804a7-744f-3fc1-9e8b-a59e51a23c61",
                                "text": "Quelques-unes des expériences de M. Deherain ont montré que la potasse devenait soluble presque immédiatement après le plâtrage."
                            }
                        ]
                    }
                ],
