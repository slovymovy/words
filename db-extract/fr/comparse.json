                                    {
                                        "sense_id": "b00912f8-75e3-31be-a2d7-b971869c5b66",
                                        "entry_id": "1c6bbd70-2015-3368-b339-a6f6b19f2a09",
                                        "glosses": [
                                            "weibliche Person, die an einem Ereignis oder einer Veranstaltung beteiligt ist"
