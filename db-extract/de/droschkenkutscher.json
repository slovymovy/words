                "senses": [
                    {
                        "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                        "entry_id": "7636d6f3-df29-3038-97a7-e4f8f64d9eb2",
                        "glosses": [
                            "Person, die eine Droschke lenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f20f73-ee88-41bf-adfa-899a46512f97",
                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                "text": "„Denn aufgeregt waren die Droschkenkutscher an diesem Abend.“"
                            },
                            {
                                "example_id": "a3e3c5cb-0547-46f6-ad68-1d6d89d3d4f3",
                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                "text": "„Es regnete an diesem Abend, und der Droschkenkutscher mußte das Verdeck hochziehen.“"
                            },
                            {
                                "example_id": "eb8ede0b-0482-4284-a4ed-1aa8ed47ca5f",
                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                "text": "„Er mußte mehrmals seine Erzählung unterbrechen, um mit schneidender Stimme einen einäugigen Droschkenkutscher anzufahren, der alle Viertelstunden, triefend wie eine Dachrinne, hereinkam, um ihn zu einer nächtlichen Fahrt nach dem »schiefen Turm« aufzufordern.“"
                            },
                            {
                                "example_id": "d36d4e5d-1b03-495c-bd6b-59002477e46a",
                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                "text": "„Vor zwei Wochen noch pflegten die beiden Herren wie Droschkenkutscher zu fluchen, auf den Boden zu spucken, knallgelbe Schuhe und Jacken mit übertrieben auswattierten Schultern zu tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
