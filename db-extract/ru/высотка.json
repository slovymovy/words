                    {
                        "form_id": "8599b5e9-8988-4256-a4a9-aa59533c10d3",
                        "entry_id": "50ae62f6-b65c-334f-b64c-f0f371a1b2ae",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "высо́тках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "014c6767-ae18-30fa-848e-ac8223394b7c",
                        "entry_id": "50ae62f6-b65c-334f-b64c-f0f371a1b2ae",
                        "glosses": [
                            "уменьш. к высота (в знач. «возвышенное место»); небольшая возвышенность, холм, горка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f339cbd7-823d-48e1-a966-6b6aea42f06d",
                                "sense_id": "014c6767-ae18-30fa-848e-ac8223394b7c",
                                "text": "В лощине, на пустом месте, тоже рвались снаряды, но реже, зато на высотке с тремя домиками, над позициями соседних взводов, стоял сплошной дым."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf58d55b-c5ab-4b2d-9749-014a78960651",
                        "source_entry_id": "50ae62f6-b65c-334f-b64c-f0f371a1b2ae",
                        "source_sense_id": "014c6767-ae18-30fa-848e-ac8223394b7c",
                        "target_lang_word": "hillock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hillock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                        "entry_id": "ac377b6a-db08-34fc-81a8-6f895d6e84e4",
                                        "glosses": [
                                            "A small hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befee3e6-3019-45fb-8c7c-9d1573c1ce34",
                                                "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                                "text": "As he rounded a hillock, he perceived that the roadway was now a crying mass of wagons, teams, and men."
                                            },
                                            {
                                                "example_id": "6ab28da0-0ee7-44f6-bed8-bbd29af82b3d",
                                                "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                                "text": "With the setting sun sending long shadows loping ahead of them over the smooth hillocks of the downs, they came up with the lagoon; a contentful return home, with appetite brisked up by a ten-mile walk, and plenty of food to satisfy it."
                                            },
                                            {
                                                "example_id": "63433fe7-b29a-42cd-9f24-05e71f8c8ad2",
                                                "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                                "text": "Just upstream of Dryburgh Abbey, a reproduction of a classical Greek temple stands at the top of a wooded hillock on the river’s north bank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
