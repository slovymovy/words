                    {
                        "form_id": "718840e9-2c7f-4516-a4aa-f3545403d2c0",
                        "entry_id": "e2c791cb-1857-33db-b5c3-5528b727d312",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Phantomzahlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                        "entry_id": "e2c791cb-1857-33db-b5c3-5528b727d312",
                        "glosses": [
                            "Zahl, die nicht belegt, sachlich nicht gerechtfertigt oder lediglich eingebildet ist, oder die nicht mit einer anerkannten Methode ermittelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8213620-4ef1-4612-9c75-c99aa3e5a1bb",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "Selbst wenn die bis heute immer wieder genannte Phantomzahl von 2500 Mitgliedern eines fernen Tages zustande kommen sollte, so kann ich mir schwer vorstellen, wie es gelingen soll, deren elitäre Struktur zu gewährleisten."
                            },
                            {
                                "example_id": "916f926c-a967-4508-9d89-ab4ef07b2009",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "Auf welcher nachvollziehbaren Grundlage halten Sie an einem Friedensumfang von 370 000 Mann fest, einer politischen Phantomzahl am Ende des Kalten Krieges?"
                            },
                            {
                                "example_id": "a1f52cb1-df3e-49da-9e93-f3855314d184",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "Diese 67 Prozent sind eine reine Phantomzahl, die von interessierter Seite zur Beruhigung der Bevölkerung gestreut wird."
                            },
                            {
                                "example_id": "326b1f1d-08c2-4c39-a825-18cd93e210b2",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "Ohnehin ist die nun ausgehandelte Summe eine Phantomzahl. Von den für die Jahre 2000 bis 2007 eingeplanten 690 Milliarden wurden nämlich nur 555 Milliarden ausgegeben."
                            },
                            {
                                "example_id": "ca625e17-fde7-4c6e-81ad-8fc7c94ecb44",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "„Die von der Kostenrechnung ermittelten Produktgewinne sind allesamt Phantomzahlen, die nicht verifizierbar sind.“"
                            },
                            {
                                "example_id": "8b38b8e8-9eb0-461c-9887-e57920df3b65",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "„Wenn überhaupt, dann gab es nur eine marginale CO2-Reduktion im Straßenverkehr, die neun Prozent sind eine Phantomzahl: Denn Deutschland hat einen Gutteil seiner Emissionen schlicht ins grenznahe Ausland exportiert.“"
                            },
                            {
                                "example_id": "0eb19c3c-c3d4-43fc-a5d2-1f66101407d3",
                                "sense_id": "46f20ad6-79e3-3ddf-9940-2ffa0d1cff52",
                                "text": "„Und als er am vergangenen Montag seine Ideen zum Personalabbau ventilierte, da war die Phantomzahl zur unumstößlichen Richtgröße gereift. 90 Redakteure seien genug, so Depenbrock, mehr brauche sein Blatt nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
