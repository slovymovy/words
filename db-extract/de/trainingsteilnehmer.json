                                "example_id": "ac1f6919-5ee5-40a3-8206-90ae120754f1",
                                "sense_id": "927d4a3c-67c1-3fa1-bbf3-3633341da872",
                                "text": "„Die Trainingsteilnehmer spielen mit Paul Szenarien durch, die vordefinierten Lernzielen entsprechen.“"
                            },
