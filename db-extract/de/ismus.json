                ],
                "senses": [
                    {
                        "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                        "entry_id": "58415706-3511-3a98-8df6-e0eaaee8b39f",
                        "glosses": [
                            "bloße Theorie, theoretisches Gedankengebäude"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d2b460ce-7e8d-4677-b357-8dbdb2c627b7",
                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                "text": "Doch das wäre doch das wahre Ziel jeder (auch politischen) Aufklärung: Der Verzicht auf jeden „-Ismus“. Denn der „Ismus“ ist es doch, der eine vernünftige Idee ins Unvernünftige übertreibt."
                            },
                            {
                                "example_id": "19c8b4f6-b43a-4a82-bcbf-87660a5c4be3",
                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                "text": "Die hiervon abgeleiteten Ismen sind im Gegensatz zu einer wissenschaftlichen Theorie starr und nicht wandlungsfähig, sie verharren auf dem einmal angenommenen Erkenntnisstand."
                            },
                            {
                                "example_id": "27a066c8-0f09-496a-a7ed-cbb45d398de4",
                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                "text": "„Er hat sich von allen Parteien, Kulten, Ismen, Ideologien losgelöst.“"
                            },
                            {
                                "example_id": "dba02bb2-be09-4148-a78d-fd63f6ee92c0",
                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                "text": "„Wilfried Hasselmann war ihm als Typus näher als irgendwelche Ex-68er, die sich mit Theoriesystemen oder Ismen beschäftigt hatten, mochten sie von Mao, Tito, Enver Hodscha oder Lenin stammen.“"
                            },
                            {
                                "example_id": "16962d08-ccf3-40f3-a1a0-f8f0e7d3099d",
                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                "text": "„Vielmehr wurde ihm klar, dass es weder Anglikanismus noch andere Ismen neben dem Kommunismus geben würde, wenn dessen Zeit erst gekommen war.“"
                            },
                            {
                                "example_id": "ab2fe46e-c045-4261-9713-01dc0ff8ee3f",
                                "sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                                "text": "„Zu den Leitmotiven von Canettis Leben gehört schließlich sein Freiheitsdrang, der sich nicht nur in der Systemlosigkeit und der Distanz zu allen Ismen des 20. Jahrhunderts zeigt, sondern auch in der Verweigerung einer erkennbaren aktiven Mitgliedschaft in den Religionen des Judentums oder des Christentums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17db3029-6ac6-4d82-a44d-d332f833a37c",
                        "source_entry_id": "58415706-3511-3a98-8df6-e0eaaee8b39f",
                        "source_sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                        "source_sense_description": "abwertend: bloße Theorie, theoretisches Gedankengebäude",
                        "target_lang_word": "ism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                        "entry_id": "3f7c13ef-c4a2-3d10-bcd5-2e9f301a047d",
                                        "glosses": [
                                            "An ideology, system of thought, or practice that can be described by a word ending in -ism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbba3255-95f6-4604-91ed-60ab54c59e86",
                                                "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                                "text": "[…] his religion, his worship was like his daily bread to him; — which he did not take the trouble to talk much about; which he merely ate at stated intervals, and lived and did his work upon! This is Abbot Samson’s Catholicism of the Twelfth Century; — something like the Ism of all true men in all true centuries, I fancy! Alas, compared with any of the Isms current in these poor days, what a thing!"
                                            },
                                            {
                                                "example_id": "44d175d0-53b1-4b87-9ffa-9e7e7332d535",
                                                "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                                "text": "If it gives way to sentimentalism, or sensibility, or political mysticism, or adopts an affectation of radicalism, or any other ism, or molds its institutions so as to round out to a more complete fulfillment somebody's theory of the universe, it may fall into an era of revolution and political insecurity […]"
                                            },
                                            {
                                                "example_id": "59ea6902-fcc4-446d-b514-6444d18258a7",
                                                "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                                "text": "An ism does not have to possess the fearful implements of state power to cut off a deviant or heretical member."
                                            },
                                            {
                                                "example_id": "80f0c6b9-fb7a-4240-ab1a-178b41a3d075",
                                                "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                                "text": "In his exposition, he has failed to achieve the identification of situation, theory, and policy necessary to create an ism."
                                            },
                                            {
                                                "example_id": "8547e367-950a-42b9-866d-a33b17549a89",
                                                "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                                "text": "Isms in my opinion are not good. A person should not believe in an ism – he should believe in himself."
                                            },
                                            {
                                                "example_id": "803576d5-a0c7-4b60-80df-f519659eef3d",
                                                "sense_id": "4b3d476d-20b0-30cd-af79-05731432ab77",
                                                "text": "It is important to distinguish between an ism and a mere generalization about group differences. Generalizations that have statistical validity are not isms. An ism assumes that the generalization applies to an individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d597001-ef70-32f5-83b1-62b882a499b0",
                                        "entry_id": "3f7c13ef-c4a2-3d10-bcd5-2e9f301a047d",
                                        "glosses": [
                                            "An ideology, system of thought, or practice that can be described by a word ending in -ism.",
                                            "A form of discrimination, such as racism or sexism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0380520-f55c-4e04-b7e8-f691508cc1d7",
                                                "sense_id": "5d597001-ef70-32f5-83b1-62b882a499b0",
                                                "text": "Parents and educators play a critical role in helping children of all ages navigate current events and talk openly about the historical roots of the various ‘isms in our country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4a8c322-416a-4349-89b0-01c0cf03f314",
                        "source_entry_id": "58415706-3511-3a98-8df6-e0eaaee8b39f",
                        "source_sense_id": "592fd8ae-6927-3cdf-a37d-2cea07bd85b3",
                        "source_sense_description": "abwertend: bloße Theorie, theoretisches Gedankengebäude",
                        "target_lang_word": "isme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2166b55a-e3bc-3ff3-8f0c-9edefd63ce0e",
                                        "entry_id": "72ce4324-2af6-3d68-9d12-347741a8778b",
                                        "glosses": [
                                            "Toute doctrine nommée par un mot se terminant par le suffixe -isme, en tant qu'approche absolue et dogmatique."
                                        ],
                                        "tags": [],
                                        "note": "Souvent entre guillemets pour la clarté typographique",
                                        "examples": [
                                            {
                                                "example_id": "9d663fa5-f007-4393-af09-f5be04b01553",
                                                "sense_id": "2166b55a-e3bc-3ff3-8f0c-9edefd63ce0e",
                                                "text": "Gauchisme, environnementalisme, socialisme, individualisme, étatisme, wokisme, alter-mondialisme, indigénisme, marxisme, nationalisme, tous ces « ismes » sont les lieux par lesquels nous poursuivons l'œuvre entamée par les ultramontains utopistes. Sortir de notre dogmatisme …, tel est l'esprit qui doit aujourd'hui nous animer plus que jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
