                        "tags": [
                            "dative",
                            "plural"
                        ],
                        "form": "den Kaufleuten"
                    },
                    {
                        "form_id": "6238bc7a-55f0-49bd-a4b0-49e7707b685b",
                        "entry_id": "eb34be5f-86a4-33b7-a33f-de257e311dad",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kaufleute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49a3d8b9-0af1-3363-a4bd-706ae44db7ad",
                        "entry_id": "eb34be5f-86a4-33b7-a33f-de257e311dad",
                        "glosses": [
                            "Handeltreibende beiderlei Geschlechts; Kauffrauen/Kaufmänner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0d1f70d-9b62-4b49-a921-a3b7d428b419",
                                "sense_id": "49a3d8b9-0af1-3363-a4bd-706ae44db7ad",
                                "text": "„Unter den Beklagten finden sich aber auch sechs weibliche Kaufleute, die in zwei Fällen wegen unterlassener Kündigung und in einem Fall wegen einer Lohnzahlung verklagt wurden.“"
                            },
                            {
                                "example_id": "d89be6f2-6761-441c-8c9d-551c852b1ab1",
                                "sense_id": "49a3d8b9-0af1-3363-a4bd-706ae44db7ad",
                                "text": "„Für alle Kaufleute besteht nach dem Handelsgesetzbuch (HGB) die Pflicht zur doppelten Buchführung.“"
                            },
                            {
                                "example_id": "e05904e2-67a1-416d-bf56-46193e77574d",
                                "sense_id": "49a3d8b9-0af1-3363-a4bd-706ae44db7ad",
                                "text": "„Die Kaufleute erholen sich nach den Kriegs- und Hungerjahren am raschesten.“"
                            },
                            {
                                "example_id": "de82e34d-ad3f-4862-853e-725b7fa3773a",
                                "sense_id": "49a3d8b9-0af1-3363-a4bd-706ae44db7ad",
                                "text": "„Die Lagerhäuser wurden geleert und die Kaufleute verließen Helgoland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b40e4c3-0646-309e-ba56-00725ce7d9e4",
                        "entry_id": "eb34be5f-86a4-33b7-a33f-de257e311dad",
                        "glosses": [
                            "nicht geschlechtsspezifischer Zusatzplural von Kaufmann und Kauffrau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570fd877-fa0c-4229-b13e-31bbe9b6c6f8",
                                "sense_id": "6b40e4c3-0646-309e-ba56-00725ce7d9e4",
                                "text": "„Sie werden von privaten Kaufleuten betrieben, die Staaten beteiligen sich an der Finanzierung und statten sie mit Handelsmonopolen aus.“"
                            },
                            {
                                "example_id": "71f8ce78-5a9a-4c4e-9cd9-d0ee1a657475",
                                "sense_id": "6b40e4c3-0646-309e-ba56-00725ce7d9e4",
                                "text": "„Die Ehemänner waren als Produzenten tätig, die Frauen als Kaufleute, die die Rohstoffe besorgten und die Fertigwaren auf den Markt brachten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
