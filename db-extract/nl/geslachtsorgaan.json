                                        "entry_id": "ebba06ae-272b-3853-8d71-385f97e8d50f",
                                        "glosses": [
                                            "äußere und innere Organe, die das Geschlecht einer Person oder eines Tieres erkennen lassen und primär der geschlechtlichen (Befriedigung und) Fortpflanzung dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e782ba1a-bfe2-4eb4-900a-e77b0d88924d",
                                                "sense_id": "b3367fee-6f1a-38f3-bf35-7f70063492d8",
                                                "text": "Das äußere Geschlechtsorgan des Mannes ist der Penis, die inneren sind die Hoden."
                                            },
                                            {
                                                "example_id": "903e6e3d-998c-4523-bd46-fa1dc7cc044b",
                                                "sense_id": "b3367fee-6f1a-38f3-bf35-7f70063492d8",
                                                "text": "„Und was hat es eigentlich damit auf sich, dass sich alles, alles um das männliche Geschlechtsorgan dreht? Und das im Jahr 2011 vulgo 5772.“"
                                            },
                                            {
                                                "example_id": "2d17a81a-b446-4e6d-8067-823f46fcb5bd",
                                                "sense_id": "b3367fee-6f1a-38f3-bf35-7f70063492d8",
                                                "text": "„Er hatte ganz das Aussehen eines Geschlechtsorgans verloren.“"
                                            },
                                            {
                                                "example_id": "b99104b9-0c2b-42e3-9841-bf706dfa53d2",
                                                "sense_id": "b3367fee-6f1a-38f3-bf35-7f70063492d8",
                                                "text": "„Weder das äußere Erscheinungsbild eines Menschen noch die Beschaffenheit seiner Geschlechtsorgane oder die Akrobatik des Aktes verursachen unsere Orgasmen, sondern die Phantasie.“"
                                            },
                                            {
                                                "example_id": "ac56b3b1-d3df-495d-b66c-f966bcd6a386",
                                                "sense_id": "b3367fee-6f1a-38f3-bf35-7f70063492d8",
                                                "text": "„Wichtig waren hier vor allem die Geschlechtsorgane und alles, was mit ihnen zusammenhing.“"
                                            }
                                        ],
