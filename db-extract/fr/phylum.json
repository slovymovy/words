                                        "sense_id": "902f411c-2cb5-3690-9b94-99a1621af626",
                                        "entry_id": "639550de-9c27-3571-8397-57c9e23b80d9",
                                        "glosses": [
                                            "A rank in the classification of organisms, below kingdom and above class; also called a divisio or a division, especially in describing plants; a taxon at that rank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c0d5956-1842-4e26-a6f5-7a27b166e0d3",
                                                "sense_id": "902f411c-2cb5-3690-9b94-99a1621af626",
                                                "text": "Mammals belong to the phylum Chordata."
                                            },
                                            {
                                                "example_id": "ee6fb68c-b93b-41e3-95e8-3b93d4dc16f1",
                                                "sense_id": "902f411c-2cb5-3690-9b94-99a1621af626",
                                                "text": "While biologists are perpetually finding new species, they can almost always fit the organism into one of the existing taxonomic pigeonholes by which scientists classify life forms. The discovery of an organism so unusual that it needs its own phylum is an extremely rare event."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32fe41b8-25a6-3a03-a20e-80201ba0da5e",
                                        "entry_id": "639550de-9c27-3571-8397-57c9e23b80d9",
                                        "glosses": [
                                            "A large division of possibly related languages, or a major language family which is not subordinate to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
