                ],
                "senses": [
                    {
                        "sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                        "entry_id": "3f4ba5d3-f28f-3b14-8b99-a1ef6f65edbb",
                        "glosses": [
                            "kleinste europäische Art aus der Familie der Schwalben (Hirundinidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a28fb8d-5b00-49cb-9d04-41e71ec11e0f",
                                "sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                                "text": "Die Uferschwalbe brütet in Kolonien in Kiesgruben, früher hingegen in Steilufern von unverbauten Flüssen."
                            },
                            {
                                "example_id": "e46c6560-a093-4ce7-86cf-e34a06962643",
                                "sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                                "text": "Meist ist die Luft von den Rufen zahlreicher Uferschwalben erfüllt, die sich geschwätzig unterhalten oder zu ihren Nesteingängen fliegen."
                            },
                            {
                                "example_id": "d7b58709-cb80-4faa-bfc0-7f8d1c22a1d8",
                                "sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                                "text": "Uferschwalben, die als kleinste aller einheimischen Schwalbenarten gilt und zu den gefährdeten Arten der Brutvögel in Deutschland gehört, haben die Sandruine als Brut- und Nistplatz auserkoren, wie die Veranstalter des Sandskulpturen-Festivals am Dienstag mitteilten."
                            },
                            {
                                "example_id": "ed9dc6c0-e4df-4f6a-934b-7d929502b2df",
                                "sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                                "text": "Seinen harschen Vorwurf kann der Chef der Naturschutzstation Wanninchen belegen: Der Bestand an bedrohten Arten wie Brachpiepern, Uferschwalben und Flußregenpfeifern geht in den stillgelegten Tagebauen dramatisch zurück, seit die Baggerfahrer Muttererde auftragen und Sprengmeister Steilwände abflachen."
                            },
                            {
                                "example_id": "ac61d484-a68c-4925-aae6-3872faaf32a8",
                                "sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                                "text": "Im Salzlandkreis ist in einem gemeinsamen Projekt eines Unternehmens und Naturschützern eine neue Brutmöglichkeit für Uferschwalben geschaffen worden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18466b76-792b-4a09-9ef5-ee0d6bbc1776",
                        "source_entry_id": "3f4ba5d3-f28f-3b14-8b99-a1ef6f65edbb",
                        "source_sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                        "source_sense_description": "Ornithologie: kleinste europäische Art aus der Familie der Schwalben (Hirundinidae)",
                        "target_lang_word": "sand martin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sand martin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                        "entry_id": "c9b1ea41-311a-3ac1-a25e-bf1f42d6c094",
                                        "glosses": [
                                            "A migratory passerine bird of the swallow family, Riparia riparia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad6d407-9c69-4b27-b9e7-baca089a8204",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "1668, John Wilkins, An Essay Towards a Real Character, and a Philosophical Language, London: Sa. Gellibrand and John Martyn, Part 2, Chapter 5, p. 151,\nSAND-MARTIN, Shore-bird."
                                            },
                                            {
                                                "example_id": "cc317de6-c558-446a-8901-131c8514a6fe",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "1774, Gilbert White, Letter 20 in The Natural History and Antiquities of Selborne, London: B. White & Son, 1789, p. 175,\nThe only instance I ever remember where this species haunts any building is at the town of Bishop’s Waltham, in this county, where many sand-martins nestle and breed in the scaffold-holes of the back-wall of William of Wykeham’s stables:"
                                            },
                                            {
                                                "example_id": "1af3f0c1-b910-4697-b3dd-63a73a754711",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "The position was perched on a sort of razor-back of limestone with dug-outs driven horizontally into the cliff like sand-martins’ nests."
                                            },
                                            {
                                                "example_id": "bb371cb5-31cf-439e-bec1-3ee35cedf178",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "The sandmartins’ nests were loopholes of darkness in the riverbank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5acda21-4b5e-49aa-acf9-6dd5c770a8e7",
                        "source_entry_id": "3f4ba5d3-f28f-3b14-8b99-a1ef6f65edbb",
                        "source_sense_id": "8d7424c5-ce2a-339e-b8e8-269286fa63c3",
                        "source_sense_description": "Ornithologie: kleinste europäische Art aus der Familie der Schwalben (Hirundinidae)",
