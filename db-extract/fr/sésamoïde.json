                        "entry_id": "1737f71f-73e2-3757-b70c-cf8771fdfca6",
                        "glosses": [
                            "En forme de grain de sésame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba27745-8013-430a-9702-45886d97450c",
                                "sense_id": "369d99d3-8b63-3ef1-b42b-81651eab2dc0",
                                "text": "En 1936, elle fut opérée pour la troisième fois du pied droit : on lui retira les os sésamoïdes et on lui pratiqua une sympathectomie."
                            },
                            {
                                "example_id": "87a08158-94d4-4bec-8890-b2b636cc87b4",
                                "sense_id": "369d99d3-8b63-3ef1-b42b-81651eab2dc0",
                                "text": "L’os sésamoïde."
                            }
                        ]
                    }
                ],
