                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce526c3-65d3-46d9-bee9-ff1bb8f70830",
                                "sense_id": "b9eace1f-ba53-3ec3-864f-dd9cc92adc39",
                                "text": "„Den Finger sanft im über einen im Metallgehäuse eingelassenen Scanner - im Türeingangsbereich angebracht – gleiten lassen, schon öffnet sich die Tür.“"
                            },
                            {
                                "example_id": "5f3f1021-9165-4770-9b09-f275cba0977a",
                                "sense_id": "b9eace1f-ba53-3ec3-864f-dd9cc92adc39",
                                "text": "„Bei der Verarbeitung gleicht es stark dem One M8, das abgerundete Metallgehäuse sieht edel aus und liegt gut in der Hand.“"
                            },
                            {
                                "example_id": "7a06311b-a1d7-4449-b880-f2811f5a15ce",
                                "sense_id": "b9eace1f-ba53-3ec3-864f-dd9cc92adc39",
                                "text": "„Beschädigte Kabel könnten dazu führen, dass das Metallgehäuse der Leuchtenfüße unter Strom stehe, teilte das Unternehmen mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
