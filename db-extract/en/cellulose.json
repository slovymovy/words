                    {
                        "translation_id": "fc75076e-03c0-455d-b231-182826371957",
                        "source_entry_id": "42e670b1-d4b9-3dfa-a914-e17170a16015",
                        "source_sense_description": "the polysaccharide cellulose",
                        "target_lang_word": "cellulose",
                        "target_lang_code": "fr",
