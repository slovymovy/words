                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d55594e-a859-45f5-9f6d-b5833b7ee431",
                                                "sense_id": "f08192e7-8c50-3a8a-8cdd-46f588ae2dcf",
                                                "text": "'Slender' West Lake lies on the western outskirts of Yangzhou. In the early years of the Manchu Emperor Kangxi, the area beside the lake, known as the Alley of Chiming Jade, was famed for its high concentration of houses of pleasure, and for the beauty of its singsong-girls (whose skills extended to a great deal more than bel canto)."
                                            },
                                            {
                                                "example_id": "d2ae96c7-4718-4b27-b900-e36474959a66",
                                                "sense_id": "f08192e7-8c50-3a8a-8cdd-46f588ae2dcf",
                                                "text": "Bel canto, or the art of beautiful singing, in 17th- and 18th-century Italy cultivated embellishment through ornaments such as cadenzas, scales, and trills which declined as the size, power, and volume of the orchestra increased."
                                            }
                                        ]
                                    }
