        "fr-extract.jsonl": [
            {
                "entry_id": "8df7f39c-d15e-33ff-be24-63199ae4da6b",
                "word": "solennellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                        "entry_id": "8df7f39c-d15e-33ff-be24-63199ae4da6b",
                        "glosses": [
                            "D’une manière solennelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb1820d-ddbd-4303-b715-f1b0f4cb1e05",
                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                "text": "Le lendemain, Leurs Majestés font prier Dieu solennellement pour tous les rois et reines qui sont là [à l’Escurial], […]"
                            },
                            {
                                "example_id": "cc1fe02d-c64a-48aa-a55d-3b0250bbff20",
                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                "text": "Richelieu, ayant fait déclarer solennellement la guerre à toute la maison d’Autriche, […]"
                            },
                            {
                                "example_id": "782d57b7-006b-4ce8-9079-5731cd045d63",
                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                "text": "Des circonstances dont il [le P. Bouhier] ne fut pas le maître, ne lui permirent pas d’exécuter la promesse qu’il avait donnée solennellement, […]"
                            },
                            {
                                "example_id": "52454c78-edb7-4280-a819-3e5dc04a23e6",
                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                "text": "Amen ! répondirent les précepteurs placés autour du grand maître, et le mot fut répété solennellement par toute l’assistance."
                            },
                            {
                                "example_id": "71bc2d8d-a0fb-497d-9b15-03072e1e0981",
                                "sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                                "text": "La difficulté, la longueur des voyages d’autrefois donnaient quelque chose de solennellement triste aux séparations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "640598db-1d4e-4d1b-aa4d-79387e8c4d23",
                        "source_entry_id": "8df7f39c-d15e-33ff-be24-63199ae4da6b",
                        "source_sense_id": "195eeadc-6b81-3a2c-8e4a-6cb73964b704",
                        "target_lang_word": "solemnly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
