                        ],
                        "examples": [
                            {
                                "example_id": "91c7db4d-14e3-4e4f-a4ba-efaf6e801725",
                                "sense_id": "f282b186-1bf7-3ca0-a0a7-25604490d197",
                                "text": "влепля́ть кому́-либо по спине́",
                                "translation": "to slap someone on the back",
                                "english": "to slap someone on the back"
                            },
                            {
                                "example_id": "717946e8-0c84-4034-974a-7143fa1e1a13",
                                "sense_id": "f282b186-1bf7-3ca0-a0a7-25604490d197",
                                "text": "влепля́ть кому́-либо в че́люсть",
                                "translation": "to give someone a smack on the jaw",
                                "english": "to give someone a smack on the jaw"
                            },
                            {
                                "example_id": "a47a361b-76ec-4ef8-a608-d470cabb57e5",
                                "sense_id": "f282b186-1bf7-3ca0-a0a7-25604490d197",
                                "text": "влепля́ть кому́-либо пу́лю в лоб",
                                "translation": "to put a bullet in someone's brain",
                                "english": "to put a bullet in someone's brain"
                            },
                            {
                                "example_id": "5ac50a29-ffdf-4b0d-aa0c-6e2c9dd8fbb2",
