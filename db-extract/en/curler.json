                                "target_senses": [
                                    {
                                        "sense_id": "18e15d1e-1e31-316e-b34a-83734d00546f",
                                        "entry_id": "307901cf-ca5b-33c5-97f2-47cb3f2eff21",
                                        "glosses": [
                                            "hráč curlingu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee93e6cb-c0b0-45e8-a922-297ace0b2ded",
                                                "sense_id": "18e15d1e-1e31-316e-b34a-83734d00546f",
                                                "text": "[Na soustředění] nás trénují různí světoví curleři, ať už muži nebo ženy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f2ae229-cec6-4b1c-9cdc-7619d016867d",
                        "source_entry_id": "39b95075-d55e-3112-aefa-3accd32cf0f8",
