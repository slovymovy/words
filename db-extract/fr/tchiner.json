                "senses": [
                    {
                        "sense_id": "f58a76bb-083d-37bc-8f61-79c81149c5f5",
                        "entry_id": "e0526c8f-b4c0-33d1-a24c-761d71311ced",
                        "glosses": [
                            "Trinquer, cogner les verres en signe de joie, pour marquer son amitié ou pour faire un vœu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96dbe02-710f-42b4-b68c-58c31e48fdd5",
                                "sense_id": "f58a76bb-083d-37bc-8f61-79c81149c5f5",
                                "text": "Tout d’abord, il faut savoir que la tradition de «tchiner» / trinquer n’est pas née de la dernière goutte de vin mais bien au Moyen-Age."
                            },
                            {
                                "example_id": "211111d6-8d9b-4e63-a1c4-9a26a60fcab7",
                                "sense_id": "f58a76bb-083d-37bc-8f61-79c81149c5f5",
                                "text": "Je sais c’est l’hiver, le froid, le covid, les masque, la politique liberticide, les jalou(ses)x, mais bon ça réchauffe de \"tchiner\" ensemble."
                            },
                            {
                                "example_id": "24bdfffc-2a16-4e8f-aa22-e2ecb8f73892",
                                "sense_id": "f58a76bb-083d-37bc-8f61-79c81149c5f5",
                                "text": "Juste pour le plaisir de tchiner avec vous, je vous invite à un apéro !"
                            },
                            {
                                "example_id": "a976dce8-91bc-4eb3-bf44-ec2a383e7b50",
                                "sense_id": "f58a76bb-083d-37bc-8f61-79c81149c5f5",
                                "text": "Tchinez ensemble et pensez aux glaçons!"
                            }
                        ]
                    }
