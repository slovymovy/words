                "translations": [
                    {
                        "translation_id": "5afe88fa-70f7-477d-bbe3-d8a20579a2cf",
                        "source_entry_id": "86b4c5c8-9262-3d93-a470-51a68a93285f",
                        "source_sense_id": "8c0aa885-fc96-330d-abd3-286138508278",
                        "target_lang_word": "verächtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verächtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                        "entry_id": "d8173dfb-5597-37bb-aab0-2147a7e29052",
                                        "glosses": [
                                            "jemanden missachtend, verachtend; keinen Respekt einem anderen gegenüber zeigend; Verachtung hegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c398cd6-02a9-44b4-b113-4e9b979e0b10",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "Er machte dazu nur eine verächtliche Bemerkung."
                                            },
                                            {
                                                "example_id": "e9f89b78-b36d-45e5-a151-e7138f49a8fb",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Sollte der böse Geist zurückkehren, sollte er wieder verächtlich werden – verächtlich, wie er gewesen war?“"
                                            },
                                            {
                                                "example_id": "14b43f5f-27cd-40d7-8995-82ddab028299",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Die Schusterfrau, die Schlächtermeisterin, alle wandten sich verächtlich von ihm ab.“"
                                            },
                                            {
                                                "example_id": "687aa9ad-83b7-4ebe-9a64-db8da86ddb50",
                                                "sense_id": "96617997-2525-3dc8-b8c1-b6f907ffc918",
                                                "text": "„Du hast Glück, dass deine Eltern dich nicht schon längst losgeworden sind«, sagte Fausta verächtlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e7e7237-1301-4544-a9c7-47f226e7684e",
                        "source_entry_id": "86b4c5c8-9262-3d93-a470-51a68a93285f",
                        "source_sense_id": "8c0aa885-fc96-330d-abd3-286138508278",
                        "target_lang_word": "anmaßend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anmaßend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                        "entry_id": "7060b6e7-ba82-3bfb-a6ee-e574eba4f62a",
                                        "glosses": [
                                            "überheblich, arrogant, übertrieben selbstbewusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2e3b947-bf5d-4ab0-8799-e1a9d097123d",
                                                "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                                "text": "Sein anmaßendes Verhalten bringt ihm keine Freunde."
                                            },
                                            {
                                                "example_id": "2e8f2b54-bc67-4876-b03f-ed081c529778",
                                                "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                                "text": "„Ich finde es anmaßend, wenn Sie im Namen aller Juden und Jüdinnen das jüdische Leben einfach mal so zur Disposition stellen, nur weil Ihnen der Zickzackkurs einer Debatte nicht konveniert.“"
                                            },
                                            {
                                                "example_id": "f12a81ac-81a7-4ebb-b984-80dc004e5ee5",
                                                "sense_id": "ed9721ca-f895-395a-92c4-36cba1cc4189",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "anmaßend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05b1e875-fc22-3340-994d-092fe6b82033",
                                        "entry_id": "ada01e12-c2b6-30f9-ac69-f753748dd390",
                                        "glosses": [
                                            "Partizip Präsens des Verbs anmaßen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d62bb58-c5ab-4581-8008-8749b432e963",
                        "source_entry_id": "86b4c5c8-9262-3d93-a470-51a68a93285f",
                        "source_sense_id": "8c0aa885-fc96-330d-abd3-286138508278",
                        "target_lang_word": "geringschätzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geringschätzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                        "entry_id": "c80bff19-128b-34cc-92f0-fe2760225479",
                                        "glosses": [
                                            "jemanden oder etwas wenig Bedeutung und/oder Respekt beimessend; abwertend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbbfe19-bbf9-4c07-a56e-69a7e2c2249c",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Bemerkenswert ist, wie geringschätzig in dem Papier über die Kirchengemeinden gesprochen wird, während kirchensoziologische Studien deren bleibende Bedeutung unterstreichen.“"
                                            },
                                            {
                                                "example_id": "3b77afd7-a90d-426c-8f15-a6f32089674f",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„‚Sie versucht, mich genauso geringschätzig zu betrachten wie Ali meinen Vater‘, beklagte sich die Rechtsanwältin, die im Ring ohne Chance blieb.“"
                                            },
                                            {
                                                "example_id": "e576ae0a-43af-45f9-8704-3265e7a7b180",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Das ‚glaubhaft‘ in diesem Zusammenhang ist nicht nur ein geringschätziges, sondern ein böses, hämisches Wort.“"
                                            },
                                            {
                                                "example_id": "7de4647c-dcaf-490a-8c75-73c7c675cc10",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Teilweise entwickelte sich die Rückmeldung so zu einem Wettkampf zwischen den Jungen, mit dem Ziel, sich gegenseitig durch immer geringschätzigere Kommentare zu überbieten.“"
                                            },
                                            {
                                                "example_id": "fd940f18-5f6e-4226-af32-f81731a780af",
                                                "sense_id": "e68e903c-57c2-3f05-a17d-b4280e01e27c",
                                                "text": "„Er lehnte sich gelassen auf seinem Stuhl zurück und zeigte seinen blasiertesten und geringschätzigsten Gesichtsausdruck und grinste auch noch dabei. Weil er ja der große Zampano ist und alle anderen sind dumme, kleine Arschlöcher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8e361e6-1294-4aaa-8082-2ecbc9f0bc55",
                        "source_entry_id": "86b4c5c8-9262-3d93-a470-51a68a93285f",
                        "source_sense_id": "8c0aa885-fc96-330d-abd3-286138508278",
                        "target_lang_word": "gleichgültig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichgültig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0ee582-eecf-36b9-a193-3bf64692e332",
                                        "entry_id": "03ee396b-c715-37d1-a539-3979502134bd",
                                        "glosses": [
                                            "ohne Interesse, Teilnahme an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb5f1ef-04dd-434a-a748-70f9413e72f8",
                                                "sense_id": "9c0ee582-eecf-36b9-a193-3bf64692e332",
                                                "text": "Er ist dem gegenüber völlig gleichgültig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                        "entry_id": "03ee396b-c715-37d1-a539-3979502134bd",
                                        "glosses": [
                                            "nicht wichtig; unbedeutend"
                                        ],
                                        "tags": [
                                            "nicht adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb896668-afa7-4438-a4f0-ddad09755c90",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "„Es ist auf der Albrechtsstraße, jener Verkehrsader der Residenz, die den Albrechtsplatz und das Alte Schloß mit der Kaserne der Garde-Füsiliere verbindet, – um Mittag, wochentags, zu einer gleichgültigen Jahreszeit.“ (1909)"
                                            },
                                            {
                                                "example_id": "8591ecd9-e517-4ec3-a9f5-bf4d61398aff",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "„Tue alles so, als sei es das Einzige auf der Welt, was zählt, gleichzeitig aber mit dem Wissen, dass es letztlich völlig gleichgültig ist.“"
                                            },
                                            {
                                                "example_id": "2f4a57c1-f3b5-4ada-8f58-16a4052701dc",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "„Der Anhängerschaft scheint es gleichgültig, wer die Partei führt.“"
                                            },
                                            {
                                                "example_id": "73c5bccf-d296-4a29-8acd-dd01f0fd31c6",
                                                "sense_id": "56580597-c8ee-3b94-a79d-28ea1349c64f",
                                                "text": "Das ist mir gleichgültig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "136781f1-4abf-430e-b77d-5df3720f7300",
                        "source_entry_id": "86b4c5c8-9262-3d93-a470-51a68a93285f",
                        "source_sense_id": "8c0aa885-fc96-330d-abd3-286138508278",
                        "target_lang_word": "gönnerhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gönnerhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1079d208-30ab-3b7b-9ddd-971a14387c98",
                                        "entry_id": "6e774051-650f-3e24-bf2d-69aeeb3bfd3c",
                                        "glosses": [
                                            "in der Art eines Gönners, in herablassender Weise"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc73752-4027-4a12-a850-ac87a409a6ad",
                                                "sense_id": "1079d208-30ab-3b7b-9ddd-971a14387c98",
                                                "text": "Gönnerhaft verteilten die Angehörigen der Militärjunta die Hilfsgüter des Internationalen Roten Kreuzes."
                                            },
                                            {
                                                "example_id": "ca6cc6e9-9a03-43c1-812a-9c7f8e2ae246",
                                                "sense_id": "1079d208-30ab-3b7b-9ddd-971a14387c98",
                                                "text": "„Nordström mimt den unkonventionellen Motivationscoach, während Fischer im Sitzen den bedächtigen Staatsmann verkörpert: den Kopf leicht seitlich nach unten geneigt, lässt er sich vereinzelt zu einem gönnerhaften Schmunzeln über seinen Vorredner hinreißen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d998d5-2c37-4c3d-b7ae-5561444a955f",
                        "source_entry_id": "86b4c5c8-9262-3d93-a470-51a68a93285f",
                        "source_sense_id": "8c0aa885-fc96-330d-abd3-286138508278",
                        "target_lang_word": "herablassend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herablassend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                        "entry_id": "ac2cf83d-d941-3023-833f-01c4d32c538c",
                                        "glosses": [
                                            "betont gnädig, seinen vermeintlich oder tatsächlich höheren Rang herausstellend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328b2bb6-61c5-42d0-816e-3b822c2d8b81",
                                                "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                                "text": "Mit seiner herablassenden Art machte sich Klaus bei allen Mitschülern äußerst unbeliebt."
                                            },
                                            {
                                                "example_id": "a6fb4cc5-230c-4ca9-af28-5e5a9ed85dbf",
                                                "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                                "text": "„Als Anna im edlen Restaurant und in der Patisserie im 1. Bezirk arbeitete, da fühlte sie, wie es ist, wenn die feinen Damen der Gesellschaft einen herablassend behandeln – ‚sie wussten ja nicht, dass ich eine Gymnasiastin bin‘.“"
                                            },
                                            {
                                                "example_id": "3006e44c-07bc-4c4b-9d89-8c9a8631bc2b",
                                                "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                                "text": "„Gegenseitige Toleranz ist die Basis des Zusammenlebens, unabhängig davon, ob diese Toleranz sich als gegenseitiger Respekt, als herablassende Duldung oder gar als Ignoranz der Anderen ausdrückt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fea83bd8-4e43-3e51-b0ae-feb5508bdaec",
                                        "entry_id": "ac2cf83d-d941-3023-833f-01c4d32c538c",
                                        "glosses": [
                                            "sich respektvoll auf jemanden von geringerem Stand einlassend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0e9de7-95e0-48c5-87c7-facda4375279",
                                                "sense_id": "fea83bd8-4e43-3e51-b0ae-feb5508bdaec",
                                                "text": "„Ludwig Viktor ist den Salzburgern auch seines herablassenden Wesens halber eine beliebte Persönlichkeit.“"
                                            },
                                            {
                                                "example_id": "2696ccc4-60e8-447a-8a7c-c4dbe4774c42",
                                                "sense_id": "fea83bd8-4e43-3e51-b0ae-feb5508bdaec",
                                                "text": "„Der Baron Siegmund von Auffenberg war von München zurückgekehrt, wo er eine Konferenz mit dem Minister gehabt hatte. Er hatte außerdem mit vielen andern Leuten gesprochen und sich beständig herablassend, jovial und witzig gezeigt, denn seine Liebenswürdigkeit im Umgang war beinahe sprichwörtlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "herablassend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2c5559-2523-35e8-aad3-9813a3645435",
                                        "entry_id": "46ad213e-c35f-3d09-be58-db80b8ec1daf",
