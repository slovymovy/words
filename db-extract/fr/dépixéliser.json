                        "examples": [
                            {
                                "example_id": "b1824609-e34b-49a8-9d4e-b06b39f7325e",
                                "sense_id": "aaba8799-b51c-3052-bb9c-8ed35b5c8feb",
                                "text": "Tout au fond de la pièce aux proportions gigantesques, elle reconnut la moitié d’un énorme vaisseau spatial qui semblait se dématérialiser ou, plutôt, se dépixéliser peu à peu, donnant l’impression à l’observateur du phénomène que la réalité n’existait pas."
                            },
