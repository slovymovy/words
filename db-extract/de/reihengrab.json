                ],
                "senses": [
                    {
                        "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                        "entry_id": "0e89be5b-e24d-3c6c-b074-8a9c6d8a0d6f",
                        "glosses": [
                            "einzelnes Grab, das in einer Reihe mit anderen Gräbern angeordnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0493a3-74c0-4c5d-8764-dea0401a46a4",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„In seinen letzten Lebensjahren war Hieronymus Jaegen schwer krank. 1919 starb er 77-jährig; beigesetzt wurde er in einem einfachen Reihengrab, wie er es verfügt hatte.“"
                            },
                            {
                                "example_id": "54d739ba-ce46-4af5-8400-59bc800c0964",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Nichts ist so endgültig wie der Tod, dennoch verändern sich gerade unsere Friedhöfe rasant: Die Reihengräber bekommen immer mehr Lücken, alte Grabsteine verschwinden.“"
                            },
                            {
                                "example_id": "1b20f6b2-2bc5-4e95-9e7c-f1ef67d07430",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Die Zahl der traditionellen Reihengräber ist in letzter Zeit zurückgegangen.“"
                            },
                            {
                                "example_id": "c0d5055f-0d92-456e-be34-2bd1a2859af6",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Die günstigste Variante ist meist ein anonymes Reihengrab für eine Urne. Dies kostet etwa in Hannover rund 650 Euro für die Laufzeit von 20 Jahren.“"
                            },
                            {
                                "example_id": "2cc849b6-33a5-4451-af82-b7f5d6052cf0",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Nutzer können sich entscheiden, ob sie Sarg oder Urne in einem Wahl- oder Reihengrab unter die Erde bringen lassen. Reihengräber sind Einzelgräber, deren Lage beim Kauf nicht vorher bestimmt werden kann.“"
                            },
                            {
                                "example_id": "470ad145-65d3-43f6-87df-753b54b97acd",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Bei Reihengräbern ist das Nutzungsrecht in der Regel nicht verlängerbar. Läuft das Nutzungsrecht aus, wird das Grab eingeebnet.“"
                            },
                            {
                                "example_id": "9634cbe1-68d8-4451-96b4-1c2871f21231",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Meret Tobler glaubt nicht, dass der Grabstein aussterben wird, sondern, dass es neue Formen geben wird. «Ich hoffe, dass wir wegkommen von Reihengräbern und freiere Grabanlagen zulassen», sagt sie.“"
                            },
                            {
                                "example_id": "2dfe1cd3-5ae3-49a4-9686-d26d93522351",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„In der nachnapoleonischen Zeit wich der Gleichheitsgedanke der einheitlichen Reihengräber allerdings wieder einem Standesdenken über den Tod hinaus.“"
                            },
                            {
                                "example_id": "56e14956-80a2-48e7-8d1f-ab7ae6f59e75",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„[…] die reichen Bodenfunde aus alemannischen und fränkischen Reihengräbern des 6. bis 8.Jh. sind beachtlich.“"
                            },
                            {
                                "example_id": "b276beca-f89f-4a09-8c2a-e749e90a750c",
                                "sense_id": "5bfae3f9-9787-3973-9e61-997c253fe61d",
                                "text": "„Reihengräber aus dem 6. und 7. Jahrhundert weisen darauf hin, dass der Platz schon sehr früh alemannischen Siedlern gefallen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
