                        "entry_id": "786a819e-e205-3c9c-8fe0-5372c7560225",
                        "glosses": [
                            "A clear, intense, self-contained argument or verbal description of an object, especially of an artwork."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8ec045e4-751e-4852-9098-ec75a8b6a7c3",
                                "sense_id": "078420c0-1a05-3882-97d0-92fa2a7037f9",
                                "text": "One [trope] is ekphrasis, the literary description of a work of art, the most famous example of which may be the careful depiction of the shield of Achilles in book 18 of the Iliad."
                            }
                        ]
                    }
