                "senses": [
                    {
                        "sense_id": "6485d796-5a05-32ca-b382-6cd4c6b94615",
                        "entry_id": "166c9869-90b6-3aeb-8c78-a8cb5f803785",
                        "glosses": [
                            "Bouder."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "62b0b6a2-9ffc-4e3e-9eff-97d2be80a573",
                                "sense_id": "6485d796-5a05-32ca-b382-6cd4c6b94615",
                                "text": "Bon anniversaire mon Elvinou ! […] plein de tout ce que tu veux tonton et on supprime pas le post, parce qu’on lui souhaite déjà ailleurs ! sinon il va boudouiller"
                            },
                            {
                                "example_id": "389f4791-5c16-4c06-bac1-ba99ce166e88",
                                "sense_id": "6485d796-5a05-32ca-b382-6cd4c6b94615",
                                "text": "Alors, chipi, comment ça s’est fini ? Tu as boudé quand il est rentré ?? (moi je m’énerve pas, je boudouille personnellement !)"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5c5f4e3-2aea-3d31-8c87-d8aeed364408",
                        "entry_id": "166c9869-90b6-3aeb-8c78-a8cb5f803785",
                        "glosses": [
                            "Bidouiller."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "74213c77-247f-4be7-8340-17d37b676038",
                                "sense_id": "a5c5f4e3-2aea-3d31-8c87-d8aeed364408",
                                "text": "Merci pour ta cogitation Misfit, mais j’ai déjà essayé de boudouiller l’affichage du bureau sans succès."
                            }
                        ]
                    }
                ],
