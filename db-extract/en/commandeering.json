                        ],
                        "examples": [
                            {
                                "example_id": "b20af1f7-1d4f-4bb8-9880-1d460144ce91",
                                "sense_id": "28d9439f-9912-3030-8d23-4b307cc051f8",
                                "text": "As the commandeering was in the majority of cases carried out by the official local commandant or the veld kornet, or other duly appointed officer of the local rifle association, it was not always easy to distinguish between the commandeering orders on behalf of the Government (which was mobilizing its own commandos at the time) and those on behalf of the rebel leaders."
                            },
                            {
                                "example_id": "6168202c-2a77-4ae9-91a6-48e0cf157f6a",
                                "sense_id": "28d9439f-9912-3030-8d23-4b307cc051f8",
                                "text": "This category includes all forms of attack on general aviation or charter aviation aircraft and facilities, with 27 hijackings, 21 commandeerings, nine destroyed aircraft, and one airport bombing occurring in the 1986 to 1995 period."
                            }
                        ]
                    }
