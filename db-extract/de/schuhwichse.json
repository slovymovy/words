                "senses": [
                    {
                        "sense_id": "6dc3bc38-a327-36ce-9642-b5cd2303632d",
                        "entry_id": "ade15097-f42d-3e9d-9ca1-c96597c3dea2",
                        "glosses": [
                            "Creme zur Pflege des Oberleders von Schuhen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ad9498-7b39-4180-b0d9-e3bd476632bc",
                                "sense_id": "6dc3bc38-a327-36ce-9642-b5cd2303632d",
                                "text": "„Das Haar der Schnösel sah aus, als wäre es mit schwarzer Schuhwichse angeklatscht.“"
                            },
                            {
                                "example_id": "1cdcd7f6-a61c-4167-a847-77c9bca599c9",
                                "sense_id": "6dc3bc38-a327-36ce-9642-b5cd2303632d",
                                "text": "„Sein Haar war schwarz wie Schuhwichse, und er trug einen schmalen Oberlippenbart, vermutlich um sein weiches, fast noch jugendliches Gesicht älter wirken zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
