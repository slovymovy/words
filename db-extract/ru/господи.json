                                        "glosses": [
                                            "Oh my God; expression of surprise."
                                        ],
                                        "tags": [
                                            "dated",
                                            "euphemistic",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c0ccd12-f189-4930-bdcd-c2b93ed7dc15",
                                                "sense_id": "144bc6df-6d30-3260-9510-9a0443876d37",
                                                "text": "\"Good gracious no, I hope not!\""
                                            },
                                            {
                                                "example_id": "2c4b0a70-24c6-4e6e-b189-a8f17cb862c9",
                                                "sense_id": "144bc6df-6d30-3260-9510-9a0443876d37",
                                                "text": "The Silver Shoes took but three steps, and then she stopped so suddenly that she rolled over upon the grass several times before she knew where she was.\nAt length, however, she sat up and looked about her.\n\"Good gracious!\" she cried."
                                            }
                                        ]
