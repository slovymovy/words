                ],
                "translations": [
                    {
                        "translation_id": "829a17b6-cad3-47e8-a805-89f66eb972bf",
                        "source_entry_id": "f4fffd0e-3162-3b0b-8881-6837ef7b3fb4",
                        "source_sense_id": "6992ba29-0d5c-300b-87b1-6d447d6c4291",
                        "target_lang_word": "носовой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "носовой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc283c4-665a-3f41-b191-8dbc9f07e060",
                                        "entry_id": "82bc2ba8-0881-3552-9d65-3d73ee57bc3a",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным нос"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46076143-3173-4606-b6df-e92b852f3db4",
                                                "sense_id": "3cc283c4-665a-3f41-b191-8dbc9f07e060",
                                                "text": "Как только дети начинают ходить, они тотчас поднимают с пола разные предметы и кладут их в рот. Клочки бумаги, кусочки сургуча, носовая слизь, — всё кажется им пригодной пищей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d72bac20-d11e-3dc8-ac47-8074459ecd53",
                                        "entry_id": "82bc2ba8-0881-3552-9d65-3d73ee57bc3a",
                                        "glosses": [
                                            "свойственный носу, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdd889c-b81e-4118-b21a-94d4d994a4fd",
                                                "sense_id": "d72bac20-d11e-3dc8-ac47-8074459ecd53",
                                                "text": "Тут Григорий Григорьевич ещё вздохнул раза два и пустил страшный носовой свист по всей комнате, всхрапывая по временам так, что дремавшая на лежанке старуха, пробудившись, вдруг смотрела в оба глаза на все стороны, но, не видя ничего, успокоивалась и засыпала снова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c90453a-87c3-35aa-b9fd-281e72dbd663",
                                        "entry_id": "82bc2ba8-0881-3552-9d65-3d73ee57bc3a",
                                        "glosses": [
                                            "принадлежащий носу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd588de-9909-42c5-a8e4-8dadcbda5c32",
                                                "sense_id": "0c90453a-87c3-35aa-b9fd-281e72dbd663",
                                                "text": "Носовая перегородка."
                                            },
                                            {
                                                "example_id": "93cc1229-5b07-4eb7-b2d7-778f7ed6bc5d",
                                                "sense_id": "0c90453a-87c3-35aa-b9fd-281e72dbd663",
                                                "text": "Носовой хрящ."
                                            },
                                            {
                                                "example_id": "b3a5065b-8981-416e-9f57-6fa9343c8f2a",
                                                "sense_id": "0c90453a-87c3-35aa-b9fd-281e72dbd663",
                                                "text": "Насколько мускульные движения в глазах и во рту важны в мимическом отношении, настолько мускулы носовые не представляют почти никакого значения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73dc2359-b234-3a66-aa0e-753059ad9716",
                                        "entry_id": "82bc2ba8-0881-3552-9d65-3d73ee57bc3a",
                                        "glosses": [
                                            "расположенный в носу, в передней части чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa20f57-8d8c-4b7f-aed1-cff1269d1fba",
                                                "sense_id": "73dc2359-b234-3a66-aa0e-753059ad9716",
                                                "text": "Мощный удар — и носовой обтекатель как будто проходит сквозь стену."
                                            },
                                            {
                                                "example_id": "0b0397e6-a7ba-4269-a2c7-e662c8498070",
                                                "sense_id": "73dc2359-b234-3a66-aa0e-753059ad9716",
                                                "text": "Все наше внимание приковал обзорный экран носового локатора."
                                            },
                                            {
                                                "example_id": "27946ea4-c348-40a3-8856-5b8d4208adfb",
                                                "sense_id": "73dc2359-b234-3a66-aa0e-753059ad9716",
                                                "text": "А во второй половине, носовой, помещались матросы со своими капралами и боцманами, а также кондукторы — всего около девятисот человек."
                                            },
                                            {
                                                "example_id": "334a4494-a6f5-40a7-a33b-4c418a2178ba",
                                                "sense_id": "73dc2359-b234-3a66-aa0e-753059ad9716",
                                                "text": "И в то самое время, как колокол бил восемь ударов, брам-реи, заранее поднятые, были моментально повернуты, и оба флага, кормовой и носовой, взвились на флагштоках."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca4db338-d0bf-3cd8-a242-1db239fba959",
                                        "entry_id": "82bc2ba8-0881-3552-9d65-3d73ee57bc3a",
                                        "glosses": [
                                            "субстантивир. лингв. звук, при произнесении которого выдыхаемая струя воздуха проходит через полость носа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435aac61-221e-4991-83e5-480cff3e9fe8",
                                                "sense_id": "ca4db338-d0bf-3cd8-a242-1db239fba959",
                                                "text": "Снова и снова она показывала, как произносятся носовые, сочетания гласных, просила повторить — я терялся, язык у меня во рту деревенел и не двигался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f199c173-a41e-3780-80fd-c432932dba62",
                                        "entry_id": "82bc2ba8-0881-3552-9d65-3d73ee57bc3a",
                                        "glosses": [
                                            "· такой, при произнесении которого выдыхаемая струя воздуха проходит через полость носа"
                                        ],
                                        "tags": [
                                            "о тембре звука"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54002140-9293-4fda-9ba3-ed587faee898",
                                                "sense_id": "f199c173-a41e-3780-80fd-c432932dba62",
                                                "text": "Он и воспитывался на юге, где в его говор въелся на всю жизнь провансальский акцент. От него он не мог отделаться до самой смерти, хотя с годами стал менее сильно отбивать как русское н все носовые звуки."
                                            },
                                            {
                                                "example_id": "770571b3-9a3d-42a0-9ace-85fdb0260699",
                                                "sense_id": "f199c173-a41e-3780-80fd-c432932dba62",
                                                "text": "Впрочем, Иван Матвеич редко рассказывал о том времени; но раза два или три в год произносил, обращаясь к кривому старичку-эмигранту, которого держал на хлебах и называл, бог знает почему, «М. le Commandeur», произносил своим неспешным, носовым голосом экспромпт, некогда сказанный им на вечере у герцогини Полиньяк."
                                            },
                                            {
                                                "example_id": "03402be9-3baa-4f2d-b45c-2ba7e090d81c",
                                                "sense_id": "f199c173-a41e-3780-80fd-c432932dba62",
                                                "text": "Могут быть изменения фонации, причём голос принимает носовой оттенок (главным образом в случаях пареза мышц нёбной занавески), становится монотонным, лишенным каких бы то ни было модуляций (прогрессивный паралич и вообще органические заболевания, в особенности эпидемический энцефалит)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
