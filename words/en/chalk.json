                            "target_lang_translations": {
                                "ru": "Мистер <w>Чок</w> работает в компании уже более двадцати лет.",
                                "zh": "<w>查尔克</w>先生在这家公司工作已经超过二十年了。"
                            }
                        }
                    ],
