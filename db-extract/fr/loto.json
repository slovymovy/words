                                        "entry_id": "ee59dfab-827b-3be0-8e28-328aa2652d51",
                                        "glosses": [
                                            "Glücksspiel Lotto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44c15be-9d33-41e6-be63-0ccb5a2d9f7e",
                                                "sense_id": "bbcec5c6-f267-35d7-8d18-cca1ae5bcd71",
                                                "text": "„Am Lottospiel beteiligt sie sich nicht oder vielmehr nur indirekt, aus der Ferne.“"
                                            },
                                            {
                                                "example_id": "7cf3a268-974b-438a-b9bb-f2f47a35cd60",
                                                "sense_id": "bbcec5c6-f267-35d7-8d18-cca1ae5bcd71",
                                                "text": "„So können einzelne Kinder zum Lottospiel angeregt werden, und die Erzieherin wird dafür sorgen, daß ein zurückhaltendes Kind Spielführer wird, und andere Kinder, die sonst führen, sich unterordnen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1da7ab92-0548-431e-ba27-3581cd140636",
