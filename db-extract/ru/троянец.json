                                    },
                                    {
                                        "sense_id": "e1367d21-6524-3155-8c60-330c5dbad70b",
                                        "entry_id": "c70bb47a-57c9-3f47-84d5-9c1431d64e64",
                                        "glosses": [
                                            "A student (especially an athlete) of the University of Southern California."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7515d230-9da7-3820-a122-50e61a512bab",
                                        "entry_id": "c70bb47a-57c9-3f47-84d5-9c1431d64e64",
                                        "glosses": [
                                            "A Trojan asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddc7876c-6a68-31d6-a400-5286ce61ced9",
                                        "entry_id": "c70bb47a-57c9-3f47-84d5-9c1431d64e64",
                                        "glosses": [
                                            "An object residing at a Trojan point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1e98cd9-716c-3cdd-8698-46c095028c71",
                                        "entry_id": "c70bb47a-57c9-3f47-84d5-9c1431d64e64",
                                        "glosses": [
                                            "Ellipsis of Trojan horse."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34aaa5ed-53c6-346e-8586-1c22f9335909",
                                        "entry_id": "c70bb47a-57c9-3f47-84d5-9c1431d64e64",
                                        "glosses": [
                                            "One who shows great pluck, endurance, strength, etc."
                                        ],
                                        "tags": [
                                            "in similes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6cf885a-2767-4ba0-bb30-655a75792a54",
                                                "sense_id": "34aaa5ed-53c6-346e-8586-1c22f9335909",
                                                "text": "to study like a Trojan"
                                            },
                                            {
                                                "example_id": "5d9474c7-352c-4071-add2-8966c00c62b5",
                                                "sense_id": "34aaa5ed-53c6-346e-8586-1c22f9335909",
                                                "text": "Farewell he, he was a kinde good fellow, a true Troyan: and it euer be my lucks to meete him at more leaſure, Ile make him full amendes with a Cup full of Canarie."
                                            },
                                            {
                                                "example_id": "34b61a16-382c-49e9-85ac-7cfb946cf8a7",
                                                "sense_id": "34aaa5ed-53c6-346e-8586-1c22f9335909",
                                                "text": "Mortified as he was at this suspension of his plan, he had, at any rate, the full satisfaction of knowing not only that he himself had discharged his duty, but that every one under him had done the same, from Jim Bell, who fought like a Trojan, to little Dewhurst, his aide-de-camp, whose first smell of powder this was."
                                            },
                                            {
                                                "example_id": "ef35254b-d96a-4e89-83f6-bec37322c428",
                                                "sense_id": "34aaa5ed-53c6-346e-8586-1c22f9335909",
                                                "text": "We have twice had all we wanted in the way of squalls: once, as I came on deck, I found the green sea over the cockpit coamings and running down the companion like a brook to meet me; at that same moment the foresail sheet jammed and the captain had no knife; this was the only occasion on the cruise that ever I set hand to a rope, but I worked like a Trojan, judging the possibility of haemorrhage better than the certainty of drowning."
                                            },
                                            {
                                                "example_id": "94ac237c-e5d9-4967-89d9-9f20b44b843a",
                                                "sense_id": "34aaa5ed-53c6-346e-8586-1c22f9335909",
                                                "text": "Leave all to me, and I'll bring you through it like a Trojan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trojan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb0777f-9544-3d43-88f4-3027a982d6e2",
                                        "entry_id": "a68ecdf9-e7af-3045-9c26-18b9a9001ed3",
                                        "glosses": [
                                            "Of, or relating to, the famed city of Troy or its inhabitants."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f03cee2-bcbb-3e46-8daf-36d961aa8540",
                                        "entry_id": "a68ecdf9-e7af-3045-9c26-18b9a9001ed3",
                                        "glosses": [
                                            "Involving great strength or endurance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eda4dd2-e8ed-4199-889d-08b72ebeeacd",
                                                "sense_id": "5f03cee2-bcbb-3e46-8daf-36d961aa8540",
                                                "text": "You know you should get up but the thought of making your way to the bathroom to wash is like a trojan task. Why bother?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "910c6fc2-5598-3638-a017-e78bcdd19c9c",
                                        "entry_id": "a68ecdf9-e7af-3045-9c26-18b9a9001ed3",
                                        "glosses": [
                                            "Of, or relating to, a Trojan point."
