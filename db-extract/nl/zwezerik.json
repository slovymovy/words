                    },
                    {
                        "translation_id": "0d16a125-58ad-459d-aa4f-f8345ecff4be",
                        "source_entry_id": "b781541e-bcfe-3e43-916e-d7b5edf05068",
                        "source_sense_id": "051ea4a0-7b94-3f6b-831e-a1b1cc3afb17",
                        "source_sense_description": "klierachtig, hormoonvormend orgaan",
                        "target_lang_word": "thymus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thymus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61bbfaa5-ae69-35ec-a8bd-2448d79c1e69",
                                        "entry_id": "b778188b-fe3e-370c-baa9-12a69d4ad68b",
                                        "glosses": [
                                            "Organe lymphoïde situé dans le médiastin, entre le sternum et la trachée, qui sert de lieu de maturation aux lymphocytes T et joue un rôle dans la protection contre l’auto-immunité. Très développé pendant l’enfance, son volume décroît après la deuxième année de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602fd4f0-f347-4035-883e-28810cab9941",
                                                "sense_id": "61bbfaa5-ae69-35ec-a8bd-2448d79c1e69",
                                                "text": "On a rencontré […] des thymus anormaux par leur persistance et leur volume chez des tuberculeux et des syphilitiques […]"
                                            },
                                            {
                                                "example_id": "261c3dec-fd55-4702-b0a3-d177f6aa2a3e",
                                                "sense_id": "61bbfaa5-ae69-35ec-a8bd-2448d79c1e69",
                                                "text": "Le thymus, qui est formé chez le nouveau-né et le jeune enfant de deux lobes aplatis débordant en haut du sternum, s’atrophie avec la progression de l’âge […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b2c981-6638-3b91-8989-6785e17e73f9",
                                        "entry_id": "b778188b-fe3e-370c-baa9-12a69d4ad68b",
                                        "glosses": [
                                            "Ris de veau ou d’agneau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "710556bc-b41c-4977-a1d3-02819ba4f485",
                        "source_entry_id": "b781541e-bcfe-3e43-916e-d7b5edf05068",
                        "source_sense_id": "051ea4a0-7b94-3f6b-831e-a1b1cc3afb17",
                        "source_sense_description": "klierachtig, hormoonvormend orgaan",
                        "target_lang_word": "ris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8f7bff-7f41-3d8a-8cfb-d4cf366bb060",
                                        "entry_id": "03a51f10-7a20-3821-94e5-25465b6c9dcd",
                                        "glosses": [
                                            "Action de rire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0675fe92-29d5-464e-a944-76427d51398b",
                                                "sense_id": "fe8f7bff-7f41-3d8a-8cfb-d4cf366bb060",
                                                "text": "C'est une joie de malade et de frénétique, qui ne vient pas de la santé de son âme, mais de son dérèglement; c'est un ris de folie et d'illusion."
                                            },
                                            {
                                                "example_id": "bb84c830-ea9c-445d-9f7c-8188ae6d82f2",
                                                "sense_id": "fe8f7bff-7f41-3d8a-8cfb-d4cf366bb060",
                                                "text": "– Les jeux, les ris, les grâces..."
                                            },
                                            {
                                                "example_id": "b510975b-b172-417a-93e9-bc35f8767ef4",
                                                "sense_id": "fe8f7bff-7f41-3d8a-8cfb-d4cf366bb060",
                                                "text": "Ne l’ai-je pas vu partir de sa tour à hiboux en compagnie de cette péronnelle, de cette bohémienne qui joue les ingénues d’un air si confit, ajouta-t-elle avec un ris un peu forcé, et n’était-il pas en votre château à la suite des comédiens ?"
                                            },
                                            {
                                                "example_id": "27982cc2-4adb-475d-b308-0230cf5da05f",
                                                "sense_id": "fe8f7bff-7f41-3d8a-8cfb-d4cf366bb060",
                                                "text": "Son ris était charmant, son teint de lis et de rose, joint à la vivacité de ses yeux, annonçaient celle de son esprit et donnait une énergie peu commune à ce qu'elle disait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09944a84-bdcf-3646-b9e5-2063b74c3e6a",
                                        "entry_id": "03a51f10-7a20-3821-94e5-25465b6c9dcd",
                                        "glosses": [
                                            "Plaisirs."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f682c49e-73dc-4f63-9cb8-13a7133522ad",
                                                "sense_id": "09944a84-bdcf-3646-b9e5-2063b74c3e6a",
                                                "text": "À la fin de la récréation, je m’avance vers eux, en frappant des mains, pour leur indiquer que c’en est fini des jeux et des ris. Je leur crie : Et nunc erudimini ! À cet appel, chacun devrait ouïr la voix de sa conscience. Bienheureux ceux à qui les pures délices de l’étude sont permises ! Ils devraient crier : Hosannah ! Ils répondent : La barbe !"
                                            },
                                            {
                                                "example_id": "6d54c8cd-af03-46ed-af26-7ad7b4e95d95",
                                                "sense_id": "09944a84-bdcf-3646-b9e5-2063b74c3e6a",
                                                "text": "Ses petits-enfants soufflottaient sur le divan ; elle grattait doucement la plante de leurs pieds roses pour améliorer les ris de leurs rêves enfantins."
                                            },
                                            {
                                                "example_id": "6c62953d-525f-4444-9eb3-91e5d68eef3f",
                                                "sense_id": "09944a84-bdcf-3646-b9e5-2063b74c3e6a",
                                                "text": "Les amours, les ris et les jeux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b371d8e6-d9ef-32ef-a41e-358d3002b795",
                                        "entry_id": "7cae906f-6d3e-35a6-b4bc-3e2b49bcfcc8",
                                        "glosses": [
                                            "Réduction de la surface d’une voile, obtenue en enserrant une partie de cette voile dans des garcettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a583d824-16b4-42f4-82ce-d085e0d8e9b7",
                                                "sense_id": "b371d8e6-d9ef-32ef-a41e-358d3002b795",
                                                "text": "Soudain, sans raison, Bradmer donne l'ordre d'amener les focs et les voiles d'étai, et de prendre des ris."
                                            },
                                            {
                                                "example_id": "48826bc9-039a-4de2-885d-e58235ca13f7",
                                                "sense_id": "b371d8e6-d9ef-32ef-a41e-358d3002b795",
                                                "text": "[…] il n’évoluait pas, et continuait de courir, bâbord amures, sous son hunier au bas ris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ris",
                                "target_lang_code": "fr",
                                "target_senses": [
