                        "glosses": [
                            "A peasant or agricultural labourer in South Asia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49464a74-81ed-47dc-bf72-e2de8d77a279",
                                "sense_id": "81a8df53-49f4-364a-ab7b-ae38b386c589",
                                "text": "In Ireland Paddy makes riots, in Bengal raiyats make paddy; and in this lies the difference between the paddy of green Bengal and Paddy of the Emerald Isle."
                            },
                            {
                                "example_id": "0385d6b1-89d8-4a57-96d4-7fb3f5c7cd02",
                                "sense_id": "81a8df53-49f4-364a-ab7b-ae38b386c589",
                                "text": "They are simply the rank-and-file—the food for fever—sharing with the ryot and the plough-bullock the honor of being the plinth on which the State rests."
                            }
                        ]
                    }
