                "translations": [
                    {
                        "translation_id": "1897ea8d-e3b5-40f1-9f51-e348b63c978d",
                        "source_entry_id": "c498fc92-dc26-38cf-9abd-1fec2957bc9c",
                        "source_sense_id": "f8a306d0-573d-3375-bd85-68e79093fc62",
                        "source_sense_description": "beschoeide of gemetselde oeverstrook waaraan de schepen kunnen aanleggen",
                        "target_lang_word": "Kai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                        "entry_id": "7e502996-e3bc-36a4-ae38-ca0d0e1acb6c",
                                        "glosses": [
                                            "befestigtes Ufer in einem Hafen als Schiffsanlegeplatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f088e340-f65f-4868-a68d-1a2f4d962b9d",
                                                "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                                "text": "Im Lied singt „das Mädchen von Piräus“: und ich steh' jeden Abend hier am Kai."
                                            },
                                            {
                                                "example_id": "3d5e53e4-fc96-416d-b410-fa8d37c2e05a",
                                                "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                                "text": "Das Frachtschiff ist am Kai vertäut."
                                            },
                                            {
                                                "example_id": "e313e9bc-7f6b-421e-981b-8d6986074903",
                                                "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                                "text": "„Indem er auf eigene Kosten einen 28 Meter langen Kai hatte bauen lassen, von dem aus Korn in kleine Leichter verladen werden kann, hatte Robert Billy dokumentiert, wie sehr ihm daran gelegen war, dass der Getreidehandel der Stadt Vannes weiter expandierte.“"
                                            },
                                            {
                                                "example_id": "3950c07e-b9bc-489e-b5fb-1dd1bc28e77e",
                                                "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                                "text": "„Während sich die beiden unterhielten, sah ich zu, wie die Seeleute den Trawler am Kai festmachten.“"
                                            },
                                            {
                                                "example_id": "561b9ecc-3734-4b17-b5fd-d40235de8a8f",
                                                "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                                "text": "„Unsere Segel waren bereits angeschlagen, als am Kai der Konsignator, gefolgt von einem anderen Kaufmann, erschien, der wiederum in Begleitung eines Jünglings war, welcher anscheinend ebenfalls aufs Schiff kommen wollte.“"
                                            },
                                            {
                                                "example_id": "930bff09-f254-4bb8-82e3-e9d69194c62d",
                                                "sense_id": "fdf479de-ec9c-36d9-a9f5-a419c4491a15",
                                                "text": "„Dann ging er raus, runter zum Kai und manchmal bis zum Leuchtturm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
