                                        "sense_id": "56862543-dd9d-3f23-bb67-080be2234def",
                                        "entry_id": "748fcc66-7076-3062-acc3-402518ed2fe7",
                                        "glosses": [
                                            "Féminin singulier de con."
                                        ],
