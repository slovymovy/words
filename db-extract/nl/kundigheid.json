                "translations": [
                    {
                        "translation_id": "ba102bcd-9d81-4ed2-8d10-fc3894a04afd",
                        "source_entry_id": "985ca4ff-0033-32fd-86d7-9dad00d231c0",
                        "source_sense_id": "cb7c30cc-7813-3614-a06c-a88cee8f6f7d",
                        "target_lang_word": "ability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
