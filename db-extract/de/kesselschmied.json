                "senses": [
                    {
                        "sense_id": "9a67c9f1-3276-3c90-aefd-4c762801ca2c",
                        "entry_id": "e8f39e37-060c-398e-8587-13c850a85856",
                        "glosses": [
                            "Handwerker, der vor allem Gefäße aus Messing oder Kupfer herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55b54440-5c75-454e-b53d-607dd6e41109",
                                "sense_id": "9a67c9f1-3276-3c90-aefd-4c762801ca2c",
                                "text": "„Es ist zweckmäßig, wenn der Kesselschmied neben den eigentlichen Kesselschmiedearbeiten die Bearbeitung des Kupfers in der Kupferschmiede sowie das Reinigen, Abschneiden und Vorschuhen von Heizrohren in der Heizrohrwerkstatt kennen lernt.“"
                            },
                            {
                                "example_id": "984dfe61-db99-4a14-bcfa-c36668ee0f8c",
                                "sense_id": "9a67c9f1-3276-3c90-aefd-4c762801ca2c",
                                "text": "„Nach dem Besuch beim Seifensieder führten die Jungen Christopher zum Kesselschmied.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
