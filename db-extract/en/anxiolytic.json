                                    {
                                        "sense_id": "1c768db8-3c9e-387b-82ed-e74c5a021903",
                                        "entry_id": "abc26701-fa8e-3c75-b4e1-6681b66e3f66",
                                        "glosses": [
                                            "Medikament, das zur Verminderung übermäßiger oder krankhafter Ängste (Anxiolyse) verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d1c84c-871a-431f-86c7-9211e94754a7",
                                                "sense_id": "1c768db8-3c9e-387b-82ed-e74c5a021903",
                                                "text": "„Das älteste Benzodiazepin, Chlordiazepoxid, wurde 1960 in den USA als Anxiolytikum in die Therapie eingeführt.“"
                                            },
                                            {
                                                "example_id": "47d1ef52-1e5e-4886-982a-43ddf2b97d10",
                                                "sense_id": "1c768db8-3c9e-387b-82ed-e74c5a021903",
                                                "text": "„Er hatte eine psychotherapeutische Beratungsstelle aufgesucht und war später von einer Nervenärztin mit einem Neuroleptikum mit sedierendem Wirkungsprofil und mit einem Anxiolytikum behandelt worden.“"
                                            },
                                            {
                                                "example_id": "4a95611a-098b-479d-b87b-8505857ab6cd",
                                                "sense_id": "1c768db8-3c9e-387b-82ed-e74c5a021903",
                                                "text": "„Buspiron, als neues Anxiolytikum ohne Abhängigkeitsprofil eingeführt, benötigt eine gewisse Zeit, bis die anxiolytische Wirkung einsetzt.“"
                                            }
                                        ],
