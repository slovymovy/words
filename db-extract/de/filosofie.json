                            {
                                "example_id": "2382f3c0-c815-43eb-bc21-66835db48746",
                                "sense_id": "e929cee4-41cf-3562-9cbf-a8a16a650739",
                                "text": "Der bisherige gemessene Gang der Filosofie muss ein rascherer werden, je klarer ihr die eigene Geschichte wird."
                            },
                            {
                                "example_id": "03b6c4f5-3a78-4b8f-a8de-107a079aa3b9",
                                "sense_id": "e929cee4-41cf-3562-9cbf-a8a16a650739",
                                "text": "Denn die Aufgabe, deren Lösung die Filosofie anstrebt, ist die höchste, welche für das menschliche Denken möglich ist, nämlich die, den göttlichen Gedanken der Weltschöpfung nachzudenken, […]"
                            }
                        ]
