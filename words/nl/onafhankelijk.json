            "senses": [
                {
                    "sense_id": "00d48423-4e9c-3b8b-a824-61f42f44fe6e",
                    "sense_definition": "Op een zelfstandige manier; zonder hulp of invloed van buitenaf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De commissie opereert volledig <w>onafhankelijk</w> van de regering.",
                            "target_lang_translations": {
                                "en": "The commission operates completely <w>independently</w> of the government.",
                                "ru": "Комиссия действует полностью <w>независимо</w> от правительства.",
                                "fr": "La commission opère de manière totalement <w>indépendante</w> du gouvernement."
                            }
                        },
                        {
                            "text": "Hij woont nu <w>onafhankelijk</w> en regelt zijn eigen zaken.",
                            "target_lang_translations": {
                                "en": "He now lives <w>independently</w> and manages his own affairs.",
                                "ru": "Теперь он живет <w>самостоятельно</w> и сам ведет свои дела.",
                                "fr": "Il vit désormais de façon <w>indépendante</w> et gère ses propres affaires."
                            }
                        }
                    ],
                    "synonyms": [
                        "zelfstandig",
                        "autonoom"
                    ],
                    "antonyms": [
                        "afhankelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "In a self-reliant manner; without outside help or influence.",
                        "ru": "Самостоятельным образом; без помощи или влияния извне.",
                        "fr": "De manière autonome ; sans aide ni influence extérieure."
                    },
