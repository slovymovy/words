                "senses": [
                    {
                        "sense_id": "44a8bc99-6f9f-3e56-a454-48c743506098",
                        "entry_id": "44b2e7e8-fc1f-384c-93ad-8e30eab0681c",
                        "glosses": [
                            "kurz für Justizvollzugsanstalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8bc5b4-343f-4dac-acf8-df5bea4945e4",
                                "sense_id": "44a8bc99-6f9f-3e56-a454-48c743506098",
                                "text": "„Als gewöhnlicher Aufenthalt im Sinne der Abschnitte 8 und 9 gelten nicht der Aufenthalt in einer Einrichtung der in § 97 Abs. 2 genannten Art und der auf richterlich angeordneter Freiheitsentziehung beruhende Aufenthalt in einer Vollzugsanstalt.“"
                            },
                            {
                                "example_id": "8acc419c-cc5d-4124-8b72-00a3a902e70d",
                                "sense_id": "44a8bc99-6f9f-3e56-a454-48c743506098",
                                "text": "„Die Tatsache, dass die Angestellten der Vollzugsanstalt schlecht und oft mit Verspätung bezahlt werden führt außerdem dazu, dass Inhaftierte vom wachhabenden Personal erpresst werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
