                                        "entry_id": "8d728546-f5c2-3731-9221-c1569ed9fc20",
                                        "glosses": [
                                            "mit einer Auszeichnung versehen, sehr häufig mit einer ehrenden Absicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d33e3d-6e0b-431b-85de-02fc99d703e4",
                                                "sense_id": "d86562c2-42b6-3ffa-bd0d-a9f5be636fc7",
                                                "text": "Alle mit dem Sportabzeichen ausgezeichneten Sportler sind zum Empfang geladen."
                                            },
                                            {
                                                "example_id": "24d6f58b-f943-4e8e-a47f-14a72ebfb556",
                                                "sense_id": "d86562c2-42b6-3ffa-bd0d-a9f5be636fc7",
                                                "text": "Die letztes Jahr mit dem Bachmann-Preis ausgezeichnete Schriftstellerin hat jetzt ihr neues Werk veröffentlicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4c52d6d-0c1c-3d3a-9c7a-e047ba88a577",
                                        "entry_id": "8d728546-f5c2-3731-9221-c1569ed9fc20",
                                        "glosses": [
                                            "sich positiv abhebend, hervorragend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb7a070-7a42-4435-bd7d-ed646501c1fd",
                                                "sense_id": "c4c52d6d-0c1c-3d3a-9c7a-e047ba88a577",
                                                "text": "„Gerade Romney, derzeit Gouverneur von Massachusetts, hat sich im Olympiabusiness als Krisenmanager einen ausgezeichneten Ruf erworben.“"
                                            },
                                            {
                                                "example_id": "c7491e92-f003-435d-bc8c-8abbae83a35c",
                                                "sense_id": "c4c52d6d-0c1c-3d3a-9c7a-e047ba88a577",
                                                "text": "Das Kleid steht ihr ausgezeichnet."
                                            },
                                            {
                                                "example_id": "1a243f40-84c0-45e0-86a8-4153c8b7cf77",
                                                "sense_id": "c4c52d6d-0c1c-3d3a-9c7a-e047ba88a577",
                                                "text": "Danke der Nachfrage, es schmeckt ausgezeichnet!"
                                            },
                                            {
                                                "example_id": "12052907-3166-45ef-94fe-b6bf1de34c47",
                                                "sense_id": "c4c52d6d-0c1c-3d3a-9c7a-e047ba88a577",
                                                "text": "Ein ausgezeichneter Wein!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "11c829fc-44d4-3965-9bb7-c1f0b7c84217",
                                        "entry_id": "8d728546-f5c2-3731-9221-c1569ed9fc20",
                                        "glosses": [
                                            "mit einer informativen Markierung versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83fbbb5-fa14-4179-8c6f-fb5e369f7f04",
                                                "sense_id": "11c829fc-44d4-3965-9bb7-c1f0b7c84217",
                                                "text": "Die ausgezeichneten Waren können Sie jetzt im Schaufenster hübsch anordnen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
