        "fr-extract.jsonl": [
            {
                "entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                "word": "crépine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "56446248-79da-488a-b7f5-3d9bf21f11cb",
                        "entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "crépines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9de1f54a-31d2-32c2-9c3e-2653352364bc",
                        "entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                        "glosses": [
                            "Passementerie travaillée à jours, sorte de frange qui est tissée et ouvragée par le haut et pendant en grands filets ou franges en bas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493c78d6-7bb7-4022-854f-271568e360a1",
                                "sense_id": "9de1f54a-31d2-32c2-9c3e-2653352364bc",
                                "text": "On couvrit la façade de l’Hôtel de Ville de grandes draperies rouges à crépines d’or ; […]."
                            },
                            {
                                "example_id": "222a8101-3b34-4201-8a79-6314a84c597c",
                                "sense_id": "9de1f54a-31d2-32c2-9c3e-2653352364bc",
                                "text": "Et le grand dais de velours pourpre, garni de crépines d’or, eut quelque peine à sortir par une des baies de la porte."
                            },
                            {
                                "example_id": "0c9d881e-9e76-4e5b-aa79-ea5aab3e57d7",
                                "sense_id": "9de1f54a-31d2-32c2-9c3e-2653352364bc",
                                "text": "Sur le tapis, le cheval de bois, emprunté au manège, était couché, énorme, harnaché de velours et de crépines d’or, la tête couronnée d’une poignée de cuivre, figé dans son immobile galop."
                            },
                            {
                                "example_id": "ec43face-70c5-4361-86c0-712999ab138d",
                                "sense_id": "9de1f54a-31d2-32c2-9c3e-2653352364bc",
                                "text": "Et comme nous courions à la promesse de nos songes, sur un très haut versant de terre rouge chargé d'offrandes et d'aumaille, et comme nous foulions la terre rouge du sacrifice, parée de pampres et d'épices, tel un front de bélier sous les crépines d'or et sous les ganses, nous avons vu monter au loin cette autre face de nos songes ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "f287aff7-f598-34c4-8931-17911fdc9e79",
                        "entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                        "glosses": [
                            "Enveloppe graisseuse (épiploon) des rognons du mouton, du veau, du porc, qui est utilisée en cuisine."
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "81bb6097-b32a-347c-a6cf-d10a1d497d4d",
                        "entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                        "glosses": [
                            "Plat qui en est entouré."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ed863be8-7897-4abf-8c38-530a138353b1",
                                "sense_id": "81bb6097-b32a-347c-a6cf-d10a1d497d4d",
                                "text": "J’ai accompagné d’une demi-bouteille de champigny de la mousse de pintadeau au genièvre, une crépine de pied de porc aux lentilles, un sorbet."
                            }
                        ]
                    },
                    {
                        "sense_id": "50a24fce-4133-3f01-810d-b4b2c4d3f4ef",
                        "entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                        "glosses": [
                            "Filtre qui sert à arrêter les grosses impuretés à l’extrémité d’une canalisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd63c644-e69b-49f3-a674-bc05abe38231",
                                "sense_id": "50a24fce-4133-3f01-810d-b4b2c4d3f4ef",
                                "text": "Un filtre intéressant est le filtre-crépine autonettoyant qui est placé sur l’aspiration de la pompe.",
                                "translation": "L. Vermeiren, G. A. Jobling, L’irrigation localisée, 1983, éditions Rome, page 135"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f7ef0b5-6c47-4b93-a368-d466cb7e53ef",
                        "source_entry_id": "d63b56d0-6ef9-3a67-8a16-373cfb7c7e0b",
                        "source_sense_id": "f287aff7-f598-34c4-8931-17911fdc9e79",
                        "source_sense_description": "boucherie",
                        "target_lang_word": "Netz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Netz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b6e39c-829c-3af1-a3f5-a4b450a76b74",
                                        "entry_id": "3e93a775-27a9-300a-ae9f-d7561501ab63",
                                        "glosses": [
                                            "geknüpftes maschiges Gebilde, mit Knoten verbunden"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2a0bb54-3978-47ce-9ae3-f63d5bbd9dba",
                                                "sense_id": "e6b6e39c-829c-3af1-a3f5-a4b450a76b74",
                                                "text": "Fischer fangen mit riesigen Netzen Fische in großer Zahl."
                                            },
                                            {
                                                "example_id": "e4fe233b-836c-493d-b35e-29bfe7b3e6a4",
                                                "sense_id": "e6b6e39c-829c-3af1-a3f5-a4b450a76b74",
                                                "text": "„Netze trockneten auf Leinen.“"
                                            },
                                            {
                                                "example_id": "4a4e1071-725b-4581-94a1-72beeb6c5c66",
                                                "sense_id": "e6b6e39c-829c-3af1-a3f5-a4b450a76b74",
                                                "text": "„Außerdem waren Fischreusen vorgesehen, Netze für den Fang.“"
                                            },
                                            {
                                                "example_id": "a0def04b-ad42-4056-8ab1-05d66289f772",
                                                "sense_id": "e6b6e39c-829c-3af1-a3f5-a4b450a76b74",
                                                "text": "„Kein Mensch kümmerte sich um die Sonne über dem Meer, um die Zinnen der Kirche Saint-Victor, um die Netze, die auf der ganzen Länge des Hafendamms zum Trocknen lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e345e70b-e741-3a65-b271-9f9300e7e1bb",
                                        "entry_id": "3e93a775-27a9-300a-ae9f-d7561501ab63",
                                        "glosses": [
                                            "Strukturen, die einen netzartigen Aufbau aufweisen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e497d4a-388c-459e-a8cf-56fb2b28cf61",
                                                "sense_id": "e345e70b-e741-3a65-b271-9f9300e7e1bb",
                                                "text": "In Deutschland bilden Autobahnen ein Netz, das nicht nur Großstädte verbindet."
                                            },
                                            {
                                                "example_id": "ceff53f6-b1db-445d-b2ad-153befda2055",
                                                "sense_id": "e345e70b-e741-3a65-b271-9f9300e7e1bb",
                                                "text": "„Für die flächendeckende Nutzung von Wasserstoff als Treibstoff müsste ein dichtes Netz an Wasserstofftankstellen vorhanden sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0291d0d7-3d98-3df7-950a-08e2b143324d",
                                        "entry_id": "3e93a775-27a9-300a-ae9f-d7561501ab63",
                                        "glosses": [
                                            "Kurzform für Netzwerk"
                                        ],
                                        "tags": [
                                            "Informationstechnik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6fa5e3d2-beef-32d5-9ac2-748da89af920",
                                        "entry_id": "3e93a775-27a9-300a-ae9f-d7561501ab63",
                                        "glosses": [
                                            "Internet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40ad474-2b82-4c26-b6f0-7b60ca9255cc",
                                                "sense_id": "6fa5e3d2-beef-32d5-9ac2-748da89af920",
                                                "text": "Zur Verwendung anonymer Nutzerkennzeichnungen: „Für die einen ist genau sie eine der großen Stärken des Netzes, ein Garant für Meinungsfreiheit und Privatsphäre.“"
                                            },
                                            {
                                                "example_id": "cd194e3d-7b78-4cc0-88d2-3f940dc1b308",
                                                "sense_id": "6fa5e3d2-beef-32d5-9ac2-748da89af920",
                                                "text": "„Im Netz war ich auf Hila gestoßen, sie war mit der Vergangenheit der Stadt vertraut, eine Historikerin, dachte ich, eine offizielle Vertreterin der jüdischen Geschichte.“"
                                            },
                                            {
                                                "example_id": "08c6374e-6fa6-4ee3-8201-8672ebe04b97",
                                                "sense_id": "6fa5e3d2-beef-32d5-9ac2-748da89af920",
                                                "text": "„Das Bundeskriminalamt (BKA) und die Generalstaatsanwaltschaft Frankfurt am Main gehen einen Tag vor dem internationalen Frauentag gegen Frauenfeindlichkeit im Netz vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "590e252d-372e-4e14-ab6b-fb1487abad8f",
