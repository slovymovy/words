                        "target_lang_word": "jenseits",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jenseits",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27e3784c-e29f-3895-9827-3a4244d014a2",
                                        "entry_id": "9c78d185-57e2-30e5-a307-46403e6be6b8",
                                        "glosses": [
                                            "auf der anderen Seite von"
                                        ],
                                        "tags": [
                                            "genitive prepositional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b4492f-a8c5-4f17-b7cf-07d47576b4ab",
                                                "sense_id": "27e3784c-e29f-3895-9827-3a4244d014a2",
                                                "text": "„Jenseits der Gräber wuchern deine Schmerzen.“"
                                            },
                                            {
                                                "example_id": "f5b6805a-33ca-415c-a025-ad2f1aebbbff",
                                                "sense_id": "27e3784c-e29f-3895-9827-3a4244d014a2",
                                                "text": "„Jetzt lächelt er jenseits der Sterne.“"
                                            },
                                            {
                                                "example_id": "0986a90b-bba1-4840-a76f-681f6ea70d9e",
                                                "sense_id": "27e3784c-e29f-3895-9827-3a4244d014a2",
                                                "text": "Die Frage wird dringlicher, wenn frau bereits jenseits der 30 ist und damit schon in die Gruppe der späten Erstgebärenden fallen [sic]."
                                            },
                                            {
                                                "example_id": "dac270e3-5c2e-42de-a620-757c01402271",
                                                "sense_id": "27e3784c-e29f-3895-9827-3a4244d014a2",
                                                "text": "„Jenseits der linken Leitplanke endet hier Georgiens Hoheitsgebiet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "jenseits",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e76022-2630-34aa-9b7f-6cea52399e5c",
                                        "entry_id": "8083cb9c-be8e-37d4-9933-f0067155bbbb",
                                        "glosses": [
                                            "auf der anderen Seite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2933d6c2-ba15-4f14-b6a9-d8466c1c8b63",
                                                "sense_id": "d3e76022-2630-34aa-9b7f-6cea52399e5c",
                                                "text": "„Die Unwahrheit als Lebensbedingung zugestehn: das heisst freilich auf eine gefährliche Weise den gewohnten Werthgefühlen Widerstand leisten; und eine Philosophie, die das wagt, stellt sich damit allein schon jenseits von Gut und Böse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
