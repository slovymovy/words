                    {
                        "form_id": "00ac5e3d-17ea-4d11-8c96-ca773b44d4c8",
                        "entry_id": "68f54608-eb8c-3600-a970-42154f5f62b7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kriegsdienste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                        "entry_id": "68f54608-eb8c-3600-a970-42154f5f62b7",
                        "glosses": [
                            "Wahrnehmung bestimmter Aufgaben in einer kriegerischen Auseinandersetzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f1a92b-b3b3-4887-b2a4-389d0e41398e",
                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                "text": "„Sie besaßen keinen Stolz mehr wie die Holländer und die Norweger, sprachen viel mehr von ihren Familien und Häusern als von dem Kriegsdienst, den sie leisteten, sehnten sich ganz unverhüllt nach Hause, nur nach Hause, um jeden Preis, auch als Geschlagene, falls kein Sieg sie wieder aufrichten sollte.“"
                            },
                            {
                                "example_id": "34f74c91-896e-473c-9413-17ec5ef55097",
                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                "text": "„Im Verlaufe des Ersten Weltkriegs stieg zwar die Zahl der Fahrgäste stark an, dafür fehlte es aber an Material und vor allem auch an Mitarbeitern, die zum Kriegsdienst einberufen waren und nicht immer durch Frauen ersetzt werden konnten.“"
                            },
                            {
                                "example_id": "0e8b5a63-2589-4aba-aa7b-aa679436c6c6",
                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                "text": "„Seine beiden Söhne Flavus und Arminius hatten als Legionäre Kriegsdienst geleistet.“"
                            },
                            {
                                "example_id": "667eb51d-a229-41fb-9af3-f5cd8eaedeb7",
                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                "text": "„Grundsätzlich sollte zwar jeder Mann zwischen 17 und 60 Jahren, der nicht zum Kriegsdienst eingezogen war, der Dienstpflicht unterliegen.“"
                            },
                            {
                                "example_id": "1457334e-b6a9-4d02-aa5e-1955bc4408a5",
                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                "text": "„Die rhodesische Armee musste nun alle Männer unter 38 Jahren zum Kriegsdienst einberufen, ein klares Zeichen, wie wirkungsvoll die Offensive der ZANLA war: Die Initiative war auf die Guerillas übergegangen.“"
                            },
                            {
                                "example_id": "0fcc2a6a-f867-41b6-921a-fefaef322bfd",
                                "sense_id": "d82960ae-a22b-3375-958c-4266355fa9e4",
                                "text": "Grundgesetz für die Bundesrepublik Deutschland, Art 4 (3): „Niemand darf gegen sein Gewissen zum Kriegsdienst mit der Waffe gezwungen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
