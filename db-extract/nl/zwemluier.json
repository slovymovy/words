                "senses": [
                    {
                        "sense_id": "23860c29-dec0-37c7-a5eb-779875a7b246",
                        "entry_id": "9b359940-321f-343e-9dc0-59289c9edfef",
                        "glosses": [
                            "incontinentie materiaal dat geschikt is om mee te zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb84cfcf-07ae-4049-abd5-f2e20a3c8112",
                                "sense_id": "23860c29-dec0-37c7-a5eb-779875a7b246",
                                "text": "Gebruik de juiste hulpmiddelen. Let op leeftijd en gewicht van het kind. Gebruik voor de allerkleinsten altijd een zwemluier."
                            },
                            {
                                "example_id": "8063d9e3-84ad-49cf-96ed-590d014aecec",
                                "sense_id": "23860c29-dec0-37c7-a5eb-779875a7b246",
                                "text": "Kim Haaksman: „Mijn oudste zoon heeft tot zijn tweede jaar wel eens in zijn blootje op het strand gespeeld, mijn jongste droeg al snel een zwemluiertje. Ik vind dat je in de huidige tijd, waarin iedereen met een smartphone ongemerkt kan filmen en fotograferen, je kinderen niet naakt rond kunt laten lopen. Treurig, maar aan de andere kant: met een zwembroekje aan hebben die kids echt niet minder plezier.”"
                            },
                            {
                                "example_id": "b6bfee96-d159-4592-bbc7-201a9723124d",
                                "sense_id": "23860c29-dec0-37c7-a5eb-779875a7b246",
                                "text": "\"Iedereen moet onbezorgd kunnen zwemmen, ook mensen met een incontinentieprobleem\", zo is de gedachte achter Incontinentiezwemkleding.nl. De webshop is opgezet door Michelle Maij die jarenlang in de zorg werkte. In 2011 nam ze de webwinkel Bij Izzy over, waar ze biologische kinderkleding, waaronder zwemluiers, verkocht. Door de toenemende vraag van klanten én haar achtergrond en betrokkenheid in de zorg, heeft ze de nieuwe webwinkel opgezet."
                            }
                        ]
                    }
