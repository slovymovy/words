                                                "sense_id": "c6690303-faee-357c-8f1d-3cb410ed7707",
                                                "text": "\"Look,\" said Crabbe, warm orange crush in his hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92e77a62-e087-36e8-aa0e-3d9680fc3704",
                                        "entry_id": "0073a0fe-5303-32ec-96a9-d21fae4af721",
                                        "glosses": [
                                            "An infatuation with somebody one is not dating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "364b31b4-b98a-405a-88da-4ff5f374ae0d",
                                                "sense_id": "92e77a62-e087-36e8-aa0e-3d9680fc3704",
                                                "text": "I've had a huge crush on her since we met many years ago."
                                            },
                                            {
                                                "example_id": "aab43085-bfac-4e76-9163-7ebe43ef3f9a",
                                                "sense_id": "92e77a62-e087-36e8-aa0e-3d9680fc3704",
                                                "text": "He took his crush out for dinner."
                                            },
                                            {
                                                "example_id": "cf349f15-0254-4888-939e-f43c0793dbde",
                                                "sense_id": "92e77a62-e087-36e8-aa0e-3d9680fc3704",
                                                "text": "And I needed to get my schoolgirl crush under control. There was no way Brín felt anything anywhere near what I felt for him. He saw me as a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52beb41c-9944-316e-beca-1cf14ab80873",
                                        "entry_id": "0073a0fe-5303-32ec-96a9-d21fae4af721",
                                        "glosses": [
                                            "An infatuation with somebody one is not dating.",
                                            "The human object of such infatuation or affection."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e67cf42f-0d7f-474e-b715-e4d6bfd290c7",
                                                "sense_id": "52beb41c-9944-316e-beca-1cf14ab80873",
                                                "text": "It had taken nine years from the evening that Truman first showed up with a pie plate at her mother's door, but his dogged perseverance eventually won him the hand of his boyhood Sunday school crush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d3d3cd7-1cbd-3292-807e-36e716c2ed8f",
                                        "entry_id": "0073a0fe-5303-32ec-96a9-d21fae4af721",
                                        "glosses": [
                                            "A standing stock or cage with movable sides used to restrain livestock for safe handling."
                                        ],
