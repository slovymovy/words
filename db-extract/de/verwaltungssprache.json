                ],
                "senses": [
                    {
                        "sense_id": "d2451075-4e10-30d4-84cb-91973b8dc898",
                        "entry_id": "be888be8-d7f4-3bdb-a511-07a1436dc6aa",
                        "glosses": [
                            "spezielle Sprachform, die in der Verwaltung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642d4cec-0309-47e8-b17d-e742b8d7bcba",
                                "sense_id": "d2451075-4e10-30d4-84cb-91973b8dc898",
                                "text": "„Diese soll hier als Oberbegriff für die beiden zentralen Kategorien Sprache der rechtlichen Normen (Gesetze, Verordnungen, Kommentare etc.) und Verwaltungssprache (Umsetzung der Gesetze) verwendet werden.“"
                            },
                            {
                                "example_id": "ac8c0418-ffd5-433d-a670-fbf4b6abeb21",
                                "sense_id": "d2451075-4e10-30d4-84cb-91973b8dc898",
                                "text": "„Die Konvergenz linguistischer Neuansätze erweist sich dabei als wichtig für die künftige Erforschung und Gestaltung der Rechts- und Verwaltungssprache.“"
                            },
                            {
                                "example_id": "ccd6d9b5-e411-4cda-b8a3-12847d53ddf4",
                                "sense_id": "d2451075-4e10-30d4-84cb-91973b8dc898",
                                "text": "„Es gibt noch einige Straßen- und Häuserschilder in jiddischer Schrift, aber längst keine jiddischen Schulen, und auch die Verwaltungssprache ist neuerdings nur noch Russisch.“"
                            },
                            {
                                "example_id": "e50baf78-5fc2-4224-b210-b603375f3db1",
                                "sense_id": "d2451075-4e10-30d4-84cb-91973b8dc898",
                                "text": "„Der sogenannte Schachtelsatz, also ein Satzgefüge aus einem Hauptsatz und mehreren ineinander »verkeilten« Nebensätzen, findet sich meist nur noch in (im Übrigen schlechten) Wissenschaftstexten und in der Verwaltungssprache.“"
                            },
                            {
                                "example_id": "46d8bbe9-ea06-4b92-ac14-18d2cb1e5130",
                                "sense_id": "d2451075-4e10-30d4-84cb-91973b8dc898",
                                "text": "„Die Meißener Kanzleisprache hatte sich seit dem späten 13. Jahrhundert herausgebildet, lag seit 1490 den Reichstagsbeschlüssen zugrunde und normierte auch die Verwaltungssprachen in Prag und Wien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
