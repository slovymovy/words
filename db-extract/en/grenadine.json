                                    },
                                    {
                                        "sense_id": "7fe544fa-c7ec-3523-bc7e-3dd00cfb8f2c",
                                        "entry_id": "8c83183c-9751-3360-ade9-c7e7d088a02a",
                                        "glosses": [
