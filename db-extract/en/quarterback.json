                                                "sense_id": "f1885ec1-6123-33de-904a-46f69cccf295",
                                                "text": "Deux quarts-arrières en mission pour ajouter une couche de gloire à leur héritage personnel. Le 55e Super Bowl promet son lot d’intrigues fascinantes."
                                            },
                                            {
                                                "example_id": "d062b8f4-1513-444c-a4f3-ce6dd0d7f3c0",
                                                "sense_id": "f1885ec1-6123-33de-904a-46f69cccf295",
                                                "text": "Ces joueurs sont les meilleurs quarts-arrières du championnat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
