                        "examples": [
                            {
                                "example_id": "f7a199f4-5eb9-407c-a049-355f22ecf963",
                                "sense_id": "8928bc93-01ac-3aba-ac04-5f00b0a2307c",
                                "text": "Starting around 2006, power-usage effectiveness (PUE) has been the metric of choice for the data-center industry. PUE is a ratio created by the Green Grid Association, a consortia of IT industry professionals dedicated to “accountable, effective, resource-efficient, end-to-end ICT ecosystems.”"
                            },
                            {
                                "example_id": "5a354a8b-77d6-4a0a-927d-b311a9300793",
                                "sense_id": "8928bc93-01ac-3aba-ac04-5f00b0a2307c",
                                "text": "But China has big time ambitions around driving down the energy use of its data centers. According to one report, the power usage effectiveness (PUE) for data centers globally has fallen to about 1.56 on average and essentially plateaued. A press release on a Chinese government website last year stated that by the end of 2025, China will drive down its own average PUE to 1.5."
                            }
                        ]
                    }
