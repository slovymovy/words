                            {
                                "example_id": "4fc87f0b-0459-4146-b19a-5456a91ef1c1",
                                "sense_id": "0deb890c-f36a-3cb5-824a-f734cc1ba3f6",
                                "text": "In Classical Athens, there were six obols to one drachma."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e88cfe5-1340-3e05-a7d5-0fff69fd3bc3",
                        "entry_id": "e36b45aa-f7be-3adc-8056-0f4b2aa68c19",
                        "glosses": [
                            "A weight, equivalent to one sixth of a drachma."
                        ],
                        "tags": [
