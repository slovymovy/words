    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b9bc51d-becf-3d67-8e9e-b97ffbf9de2f",
                    "sense_definition": "The present participle and gerund of <w>pop</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>popping</w> the balloons with a pin.",
                            "target_lang_translations": {
                                "ru": "Она <w>лопает</w> воздушные шары булавкой.",
                                "nl": "Ze is de ballonnen aan het <w>laten knappen</w> met een speld."
                            }
                        },
                        {
                            "text": "He kept <w>popping</w> in to check on us throughout the day.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>заглядывать</w> к нам в течение всего дня, чтобы проверить, как мы.",
                                "nl": "Hij bleef de hele dag <w>even langskomen</w> om te kijken hoe het met ons ging."
                            }
                        }
                    ],
                    "common_phrases": [
                        "popping up",
                        "popping out",
                        "popping in"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола pop.",
                        "nl": "Het tegenwoordig deelwoord en gerundium van het werkwoord 'pop'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопать",
                                "target_lang_sense_clarification": "взрывать (шары, пузыри)"
                            },
                            {
                                "target_lang_word": "заскакивать",
                                "target_lang_sense_clarification": "ненадолго заходить (фразовый глагол pop in)"
                            },
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "издавать резкий звук"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "laten knappen",
                                "target_lang_sense_clarification": "iets doen ontploffen (zoals ballonnen)"
                            },
                            {
                                "target_lang_word": "even langskomen",
                                "target_lang_sense_clarification": "kort op bezoek gaan (pop in)"
                            },
                            {
                                "target_lang_word": "even binnenvallen",
                                "target_lang_sense_clarification": "onverwacht of kort ergens naar binnen gaan"
                            }
                        ]
