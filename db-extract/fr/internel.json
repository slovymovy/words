                                        "entry_id": "0cca5cf6-1e82-3b10-9175-6b3c28823945",
                                        "glosses": [
                                            "Not superficially obvious, inner, not expressed, especially relating to mental or spiritual faculties as opposed to external ones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0546616-ae35-4319-a3fd-055053ad1e22",
                                                "sense_id": "c748a0ad-57b1-36ca-8a07-e55d18480970",
                                                "text": "Noble and milde this Perſean ſeemes to be,\nIf outward habit Iudge the inward man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d172229-b66c-3ae0-9fa9-37f8ec49cc6e",
                                        "entry_id": "0cca5cf6-1e82-3b10-9175-6b3c28823945",
                                        "glosses": [
