                                "example_id": "c26781ce-2827-4583-9d11-216cf892b053",
                                "sense_id": "e4939578-13b7-3f6a-9249-994874125dd6",
                                "text": "„Franck Ribéry hat erst jetzt verlauten lassen, gerne bis zum Karriereende in München bleiben zu wollen.“"
                            },
                            {
                                "example_id": "b13972b6-89fb-4ec3-8902-b98be831437c",
                                "sense_id": "e4939578-13b7-3f6a-9249-994874125dd6",
                                "text": "„Der Körper spielt nicht mehr mit, ein schwerer Knorpelschaden in der linken Schulter zwingt die erfolgreichste deutsche Handballspielerin zum Karriereende.“"
                            }
