                "senses": [
                    {
                        "sense_id": "c1edfda9-738e-3b19-8021-33bf3b7974a6",
                        "entry_id": "57a8a227-3e7d-3fee-b259-cdd0d0b8ef3a",
                        "glosses": [
                            "Qualifie une laie, une tranchée, etc., qui aboutissent à ce chemin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b28aba-7cda-4951-845e-43bda9f3bd98",
                                "sense_id": "c1edfda9-738e-3b19-8021-33bf3b7974a6",
                                "text": "Pourquoi ces chemins, qui dans une route sommière, par exemple, ou dans tout autre cas semblable, ne doivent durer qu'autant d'années qu'il y a de coupes à exploiter, ne seraient-ils pas produits par ces coupes elles- mêmes ?"
                            },
                            {
                                "example_id": "24f42ad2-18e2-4b61-b4ef-66592c69f292",
                                "sense_id": "c1edfda9-738e-3b19-8021-33bf3b7974a6",
                                "text": "L'espacement d'une laie sommière à une autre laie, d'une route à une laie sommière ou à une autre route, sera établi selon les circonstances."
                            },
                            {
                                "example_id": "52dc0115-e1c4-45f4-9e54-9e99e1678c20",
                                "sense_id": "c1edfda9-738e-3b19-8021-33bf3b7974a6",
                                "text": "[…], nous battions en tous sens un espace donné, habituellement le grand rectangle compris entre une tranchée sommière et deux tranchées transversales, […]."
                            },
                            {
                                "example_id": "c951852e-3605-48a7-9f66-023dbbb551c8",
                                "sense_id": "c1edfda9-738e-3b19-8021-33bf3b7974a6",
                                "text": "Le principal est au carrefour de la Croix-de-Pierre, sur la voie sommière de la Haute-Chevauchée, aux lisières des forêts domaniale de La Chalade et communale de Neuvilly-en-Argonne."
                            }
                        ]
                    }
                ],
