                "senses": [
                    {
                        "sense_id": "df885445-9d0a-3f61-b3f8-3c59f229c543",
                        "entry_id": "94fe450b-5756-3ec1-b94f-84230d19b2d0",
                        "glosses": [
                            "Hure mit gehobenen Angeboten und Ansprüchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d701f6e-3321-4f31-bce3-b1a9cc5a94df",
                                "sense_id": "df885445-9d0a-3f61-b3f8-3c59f229c543",
                                "text": "„Möglicherweise war sie eine Agentin, vielleicht auch eine Luxushure – oder auch schlicht ein Flittchen.“"
                            },
                            {
                                "example_id": "c06d2ff1-3f98-4938-835e-dc282c75e330",
                                "sense_id": "df885445-9d0a-3f61-b3f8-3c59f229c543",
                                "text": "„Der aufhaltsame Abstieg der Herzogin Assy zur Luxushure, das ‚ernste Leben‘ der Tagelöhnerstochter Marie Lehning, die ‚Jagd nach Liebe‘, die Leiden der Lola Gabriel ‚zwischen den Rassen‘ – das müssen nur noch Literaturhistoriker lesen.“"
                            },
                            {
                                "example_id": "dfbf5737-89e1-4f5e-9665-9290fbaaa2d6",
                                "sense_id": "df885445-9d0a-3f61-b3f8-3c59f229c543",
                                "text": "„Luhrmann treibt die tragische Klischee-Liebe zwischen einer todkranken Luxushure und einem armen Dichter fast ausschließlich durch die Texte eigenwillig interpretierter Popsongs von Madonna, Elton John, U2 oder den Beatles durch Höhen und Tiefen.“"
                            },
                            {
                                "example_id": "e646214e-197e-4bf8-8f0f-923e145e6cb6",
                                "sense_id": "df885445-9d0a-3f61-b3f8-3c59f229c543",
                                "text": "„Dabei hilft ihm - wie passend - die Luxushure Chantal, eine dank der Schauspielkunst von Christiane Paul gänzlich unpeinliche Attraktion dieser Komödie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
