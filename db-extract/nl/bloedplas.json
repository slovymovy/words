                    {
                        "sense_id": "bc5a19fb-9999-3867-be5d-fe9830b44de6",
                        "entry_id": "88bfd1fc-df5a-30cd-9d28-45d6e502f52a",
                        "glosses": [
                            "verzameling bloed (die meestal is ontstaan door een bloeding)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b8da53-21ea-418d-9c00-e1b19edf646d",
                                "sense_id": "bc5a19fb-9999-3867-be5d-fe9830b44de6",
                                "text": "Ooit was zij zo overspannen dat ze achter haar bureau neerstortte, haar sleutelbeen brak en wakker werd in een bloedplas. In haar pleidooi voor rust ontdekte ik waarom mijn gastgezin zo langzaam thee dronk."
                            },
                            {
                                "example_id": "ecdb39e1-66ed-430d-8478-5ed9afc5314b",
                                "sense_id": "bc5a19fb-9999-3867-be5d-fe9830b44de6",
                                "text": "Terwijl er een flinke bloedplas ontstond en een collega flauwviel, werd de politie gebeld. Mahmoud: 'Door een miscommunicatie begreep de meldkamer van de politie dat een collega mij had neergestoken. De politie benaderde ons daarom redelijk agressief.'"
                            },
                            {
                                "example_id": "b17135d0-3e85-41c7-9725-65262ee430a9",
                                "sense_id": "bc5a19fb-9999-3867-be5d-fe9830b44de6",
                                "text": "Aan het eind van de ochtend lag het lijk er nog steeds. Naakt, met alleen een zwarte onderbroek aan, op een glanzend witte vloer met een rode bloedplas erom heen."
                            }
                        ]
                    }
