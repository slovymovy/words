                        "glosses": [
                            "Lacking mirth; devoid of joy; sad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee43115-1ff2-4dec-bf92-9d58a618bab9",
                                "sense_id": "d8398e8c-b39c-3d79-9422-f3a9c72e117f",
                                "text": "The laughter of man is more terrible than his tears, and takes more forms: hollow, heartless, mirthless, maniacal..."
                            },
                            {
                                "example_id": "ec6a4905-999f-4ce4-abbd-d7654dbc6665",
                                "sense_id": "d8398e8c-b39c-3d79-9422-f3a9c72e117f",
                                "text": "In life, David Lodge was surprisingly mirthless. Luckily, his wife was a hoot [title]"
                            }
                        ]
                    }
