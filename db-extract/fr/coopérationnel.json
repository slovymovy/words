                        "glosses": [
                            "Qui est fondé sur la coopération, l'association et la collaboration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9599fae-2410-4e77-9ad8-a569ac768048",
                                "sense_id": "e534aa8b-5b9c-3a57-9561-684afc22df07",
                                "text": "Le directeur du projet dans lequel je me suis engagée souhaiterait que nous travaillions de manière coopérationnelle afin nous atteignions nos objectifs plus rapidement."
                            },
                            {
                                "example_id": "2cb4c638-7e32-4584-92f2-616c774c6a25",
                                "sense_id": "e534aa8b-5b9c-3a57-9561-684afc22df07",
                                "text": "Le processus coopérationnel requis pour notre travail n'est pas toujours évident car nos avis divergent sur de nombreux points."
                            }
                        ]
