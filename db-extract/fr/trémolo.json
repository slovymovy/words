                                        "sense_id": "922d6ed2-4b3f-3987-b18c-a3993a027301",
                                        "entry_id": "2b88ae64-1db4-3784-9cbb-048b675e1364",
                                        "glosses": [
                                            "The device in an organ that produces a tremolo effect."
                                        ],
