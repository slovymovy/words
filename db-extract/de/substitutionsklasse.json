                "senses": [
                    {
                        "sense_id": "ed8c5e3c-4d2a-3ca8-b0a6-c2c7b7195419",
                        "entry_id": "de7a6302-9922-3d47-8d52-0635b7d01c8a",
                        "glosses": [
                            "Menge der sprachlichen Ausdrücke, die man in gleicher lautlicher oder syntaktischer Umgebung gegeneinander austauschen kann, ohne dass die Äußerungen grammatisch falsch werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53a4bd4-5a00-4f24-8303-a6aa70965e75",
                                "sense_id": "ed8c5e3c-4d2a-3ca8-b0a6-c2c7b7195419",
                                "text": "Aus einem Satz wie \"Der Tisch ist alt\" kann man eine Substitutionsklasse all der Wörter gewinnen, die das Wort \"Tisch\" ersetzen können. Man erhält so einen großen Teil der Wörter, die zu den Substantiven zählen."
                            },
                            {
                                "example_id": "a93d5d5b-5489-4f44-ba4c-03a8e0f9a1ad",
                                "sense_id": "ed8c5e3c-4d2a-3ca8-b0a6-c2c7b7195419",
                                "text": "Die Bildung von Substitutionsklassen ist ein wichtiges Verfahren des Distributionalismus, einer Richtung der strukturalistischen Linguistik."
                            }
                        ],
                        "sense_index_json": "\"1\""
