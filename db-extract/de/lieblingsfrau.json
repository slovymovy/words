                "senses": [
                    {
                        "sense_id": "ea8fc95f-6cd0-3163-9579-2c83368d3492",
                        "entry_id": "0e7f45c0-9e7d-3794-8d1b-1cc55b3d5bc1",
                        "glosses": [
                            "Frau, die (zum Beispiel im Falle eines Harems) allen anderen vorgezogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce6af408-50cf-4ee1-a4be-48460ffcbecd",
                                "sense_id": "ea8fc95f-6cd0-3163-9579-2c83368d3492",
                                "text": "„Selim II., Sohn von Süleyman dem Prächtigen und seiner Lieblingsfrau Roxelane, war zwar kein Kiffer, sondern ein Trunkenbold und ließ sich selten außerhalb seines Harems sehen.“"
                            },
                            {
                                "example_id": "1988cd4d-81d5-4e75-a87d-e6b337a1e116",
                                "sense_id": "ea8fc95f-6cd0-3163-9579-2c83368d3492",
                                "text": "„Selbst Zinat Mahal, die Lieblingsfrau des Großmoguls, betätigte sich als Spionin.“"
                            },
                            {
                                "example_id": "eb6bd3ab-2708-4697-9715-3aeb990e455f",
                                "sense_id": "ea8fc95f-6cd0-3163-9579-2c83368d3492",
                                "text": "„Da wurde ich ängstlich und warf noch einmal einen Blick auf das Dach hinauf, ich sah nur mit halbgeschlossenen Augen, daß die Lieblingsfrau dort oben auf den Ellenbogen lag und mich flehend ansah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
