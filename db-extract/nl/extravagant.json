                ],
                "senses": [
                    {
                        "sense_id": "5f64e23a-0e30-3650-b7c7-a8e553f59fd0",
                        "entry_id": "2efce67e-1526-3e8e-9faa-042846d6866a",
                        "glosses": [
                            "ver buiten het alledaagse vallend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07aba717-3eb9-4feb-89b8-ecd54d759a9e",
                                "sense_id": "5f64e23a-0e30-3650-b7c7-a8e553f59fd0",
                                "text": "Een extravaganter feest kan ik me nauwelijks voorstellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4e86108-d5ad-4bbf-a370-059acfe0a5e8",
                        "source_entry_id": "2efce67e-1526-3e8e-9faa-042846d6866a",
                        "source_sense_id": "5f64e23a-0e30-3650-b7c7-a8e553f59fd0",
                        "target_lang_word": "extravagant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b40cfb55-462a-38f2-a5cb-5249df08f0a3",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Exceeding the bounds of something; roving; hence, foreign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633e3966-3082-4b23-aaeb-bf8bbf76ede0",
                                                "sense_id": "b40cfb55-462a-38f2-a5cb-5249df08f0a3",
                                                "text": "The extravagant and erring spirit hies / To his confine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Extreme; wild; excessive; unrestrained."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4e24cb-efd9-4a6d-badc-658278580194",
                                                "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                                "text": "extravagant acts, praise, or abuse"
                                            },
                                            {
                                                "example_id": "15cbfc31-8e31-48eb-909b-b43e9ff7660e",
                                                "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                                "text": "There appears something nobly wild and extravagant in great natural geniuses."
                                            },
                                            {
                                                "example_id": "7ebcf61b-4eed-4dff-bad6-6f58e8e92012",
                                                "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923c975b-b48e-348c-b166-78a1da09f195",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Exorbitant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa3765b-6a39-4271-b613-057063046264",
                                                "sense_id": "923c975b-b48e-348c-b166-78a1da09f195",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                        "entry_id": "b071f3ff-edfe-3054-9c7f-e5326e7ca782",
                                        "glosses": [
                                            "Profuse in expenditure; prodigal; wasteful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ddbefb-534b-4646-b68d-69726337934f",
                                                "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                                "text": "an extravagant man"
                                            },
                                            {
                                                "example_id": "7ca541ec-47cf-4279-8ad4-b24a42c66310",
                                                "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                                "text": "extravagant expense"
                                            },
                                            {
                                                "example_id": "d44bf513-e135-4105-b613-83728b3dc29e",
                                                "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                                                "text": "some of the Quakers were extravagant and foolish"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54e28f42-cb03-403f-9abe-1764dcade8ea",
                        "source_entry_id": "2efce67e-1526-3e8e-9faa-042846d6866a",
                        "source_sense_id": "5f64e23a-0e30-3650-b7c7-a8e553f59fd0",
                        "target_lang_word": "extravagant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fedabd3e-62ef-340f-b635-101d42ad62aa",
                                        "entry_id": "13c28736-5e44-3965-a2df-c6312b4bd12b",
                                        "glosses": [
                                            "Qui est bizarre ou fantasque ; qui est contre le bon sens ou contre la raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8879d0e7-8ba8-490f-a49c-c0676a9ec760",
                                                "sense_id": "fedabd3e-62ef-340f-b635-101d42ad62aa",
                                                "text": "Il s’allongea de nouveau, s’ingéniant à rédiger des clauses testamentaires en faveur d’Edna, pour la plupart, […] et à stipuler divers menus legs, avec des codicilles de plus en plus fantasques et extravagants…."
                                            },
                                            {
                                                "example_id": "119268ea-9a9c-4ae0-8eb0-ed2adec5b18f",
                                                "sense_id": "fedabd3e-62ef-340f-b635-101d42ad62aa",
                                                "text": "Dès 1818, le vélocipède du baron Karl Drais von Sauerbroom avait été le support d’une mode éphémère et extravagante parmi les dandys et les aristocrates de Paris et de Londres."
                                            },
                                            {
                                                "example_id": "c9591dfc-8341-4724-a818-82ebb1968ad1",
                                                "sense_id": "fedabd3e-62ef-340f-b635-101d42ad62aa",
                                                "text": "On connaît ses fringues extravagantes, la veste en lézard et le costume de 2 000 dollars en poulain mort-né, qu’il jeta un jour dans la poubelle d’un aéroport, son chapeau orné d’une superbe tête de mort, tibias croisés."
                                            },
                                            {
                                                "example_id": "7f6b87d1-0c83-403c-a328-90d7f94ea3cb",
                                                "sense_id": "fedabd3e-62ef-340f-b635-101d42ad62aa",
                                                "text": "Tableaux et sculptures étaient interdits, mais l’architecture était baroque, les moulures extravagantes et la décoration recherchée."
                                            },
                                            {
                                                "example_id": "ad7cdd3d-133f-4cae-a7f6-f136884c9b54",
                                                "sense_id": "fedabd3e-62ef-340f-b635-101d42ad62aa",
                                                "text": "Le populationnisme de Petty culmine ainsi au milieu des années 1680 dans cet extravagant projet de « multiplication de l'espèce humaine »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extravagant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5581bb5-19ce-3d80-861c-cc0d720f70b4",
                                        "entry_id": "7d688732-6f6c-31c1-9d6e-7ea219a04061",
                                        "glosses": [
                                            "Celui qui est bizarre ou fantasque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a79abf9-e7b7-4a9a-ba36-7d8e9742133f",
                                                "sense_id": "d5581bb5-19ce-3d80-861c-cc0d720f70b4",
                                                "text": "C’est un extravagant."
                                            },
                                            {
                                                "example_id": "db8bee54-bf9e-4a33-8296-e4996f9c55cb",
                                                "sense_id": "d5581bb5-19ce-3d80-861c-cc0d720f70b4",
                                                "text": "Le docteur avait de la considération pour les goûts saugrenus d’Alain. N’admirant spontanément que les extravagants du passé, de Byron à Jarry, il comprenait confusément que l’éloignement du temps l’aidait beaucoup à vanter des choses qui, à brûle-pourpoint, l’auraient déconcerté comme le troupeau vulgaire des contemporains d’alors. Aussi s’interdisait-il, pour ne jamais être pris au dépourvu, de jeter la pierre sur rien de ce que lui offrait son époque."
                                            },
                                            {
                                                "example_id": "3af78de0-6a7f-4f4c-8f00-18522b0c1e12",
                                                "sense_id": "d5581bb5-19ce-3d80-861c-cc0d720f70b4",
                                                "text": "Simplement, il y a une erreur sur le personnage, on en fait un hurluberlu, un extravagant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
