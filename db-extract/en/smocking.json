    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e66e6f62-10b5-39e7-807b-74ab7ca85ef8",
                "word": "smocking",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "51ff11ee-3bea-4f16-a110-a956178f7b5f",
                        "entry_id": "e66e6f62-10b5-39e7-807b-74ab7ca85ef8",
                        "tags": [
                            "plural"
                        ],
                        "form": "smockings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                        "entry_id": "e66e6f62-10b5-39e7-807b-74ab7ca85ef8",
                        "glosses": [
                            "An embroidery technique in which the fabric is gathered and then embroidered with decorative stitches to hold the gathers in place; the product of the use of this embroidery technique."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "62832fd8-38e3-440e-b234-83b294ac2bc4",
                                "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                                "text": "Mr. Hudson […] preaches in his surplice. We see no reason why all clergymen should not do likewise. This donning and undonning, this white dressing and black smocking which one sees in so many churches, is a piece of stale nonsense; […]"
                            },
                            {
                                "example_id": "1f4090cf-5e97-4dc2-b69e-33a05a712f1e",
                                "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                                "text": "Smocking forms an effective trimming for ladies' dresses, either as a waistcoat or yoke, and looks well for the crown of a small toque with a velvet brim. The great difficulty in smocking is to gather the material regularly, or the embroidery will look crooked."
                            },
                            {
                                "example_id": "e3647e80-9dda-4793-aa89-cb07d6b70ee1",
                                "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                                "text": "Smocking is not in the least difficult once the method has been thoroughly grasped. For some reason it is much more popular in England than in the United States. […] Smocking done in colors on fine white batiste, silk mull, or nainsook makes pretty guimpes and dresses for children and very smart blouses for women."
                            },
                            {
                                "example_id": "4043aded-e237-4f40-a8cc-f4d2dc4d3311",
                                "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                                "text": "Such decoration should be chosen for these as can be designed to follow the threads of the material; that is, tucks, plaits, shirrings, and smockings."
                            },
                            {
                                "example_id": "19f24226-a057-4343-9420-0a4153c547ec",
                                "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                                "text": "An English countryman of the late eighteenth or early nineteenth century would be amazed to see how smocking has changed today. The early traditional smock, with its geometric smocking and embroidered motifs, […] originally adorned the clothing of men who toiled in the fields, tended flocks of sheep, cut wood or led wagons or carts."
                            },
                            {
                                "example_id": "3a735382-8ade-423f-b8e3-2586aecd1033",
                                "sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                                "text": "Her stitching was fine and regular, her smocking came out even, and the plaids of her jackets met invisibly at the seams."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d24f44e0-0578-45b1-aef4-abd7ce9126f3",
                        "source_entry_id": "e66e6f62-10b5-39e7-807b-74ab7ca85ef8",
                        "source_sense_id": "11cba279-c97a-32a3-8542-27d86906afe5",
                        "source_sense_description": "embroidery technique in which the fabric is gathered and embroidered with decorative stitches",
                        "target_lang_word": "smokwerk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smokwerk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d57c9c0-eaa3-3ef1-b643-aa9725704007",
                                        "entry_id": "0cdac8d3-4069-3970-87ff-be87f85b49e3",
                                        "glosses": [
                                            "met stiksels plooien aanbrengen als versiering op kleding; borduursel met plooien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d058d6cd-569b-40fd-b1e1-66330e1df4c9",
                                                "sense_id": "7d57c9c0-eaa3-3ef1-b643-aa9725704007",
                                                "text": "Owens weet zichzelf nog steeds te vernieuwen. Afgelopen donderdag liet hij voor zijn doen opvallend lichte kleding zien. Veel tule, smokwerk en lichte kleuren zoals grijs en beige dankzij de asymmetrische rokken en wijde tops nog steeds herkenbaar als typisch Owens."
                                            }
                                        ]
                                    }
                                ]
                            }
