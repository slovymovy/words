                "senses": [
                    {
                        "sense_id": "a3133854-2f98-3960-9ba1-5d2b61b59326",
                        "entry_id": "554eaf88-e09a-30ae-bbde-6b70f22981b7",
                        "glosses": [
                            "befestigtes Ufer in einem Hafen als Schiffsanlegeplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ec4b4e-1978-48a0-ab06-f88882969fc6",
                                "sense_id": "a3133854-2f98-3960-9ba1-5d2b61b59326",
                                "text": "„Bevor die Kaianlage 1928 gebaut wurde, hatte es bereits einige Fährmänner in der Familie gegeben, die viel zum Musikleben der Stadt beigetragen hatten.“"
                            },
                            {
                                "example_id": "4f221c3b-8a01-4feb-aa23-f1b979e6e8e1",
                                "sense_id": "a3133854-2f98-3960-9ba1-5d2b61b59326",
                                "text": "„Die Kaianlagen in Unterland waren größeren Schiffen vorbehalten, die Boote der Fischer wurden nach den Ausfahrten jeweils wieder auf den Strand gezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71ed7ccc-e494-4d61-8406-cd2a6f145347",
                        "source_entry_id": "554eaf88-e09a-30ae-bbde-6b70f22981b7",
                        "source_sense_id": "a3133854-2f98-3960-9ba1-5d2b61b59326",
                        "source_sense_description": "befestigtes Ufer in einem Hafen als Schiffsanlegeplatz",
                        "target_lang_word": "quai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d49498c2-1d59-32fd-b4f9-3c7202d2d031",
                                        "entry_id": "e60482fb-c42d-35ce-a333-7e0dceda0fa5",
                                        "glosses": [
                                            "Levée ordinairement revêtue de pierres de taille et faite le long d’une rivière ou d’un canal, pour rendre le chemin praticable et pour empêcher le débordement de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dcdd0be-5c58-4201-80d7-29d9e36384f0",
                                                "sense_id": "d49498c2-1d59-32fd-b4f9-3c7202d2d031",
                                                "text": "Un quai revêtu de pierres de taille."
                                            },
                                            {
                                                "example_id": "d359108f-3262-4abc-9385-2f82e54f7e9c",
                                                "sense_id": "d49498c2-1d59-32fd-b4f9-3c7202d2d031",
                                                "text": "Les quais de Paris."
                                            },
                                            {
                                                "example_id": "16434435-8b8f-48be-8e7f-47b27d8103bc",
                                                "sense_id": "d49498c2-1d59-32fd-b4f9-3c7202d2d031",
                                                "text": "Se promener sur les quais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806bd950-a747-3a7e-8532-c93de8e73b8b",
                                        "entry_id": "e60482fb-c42d-35ce-a333-7e0dceda0fa5",
                                        "glosses": [
                                            "Rivage d’un port de mer, qui sert pour le chargement et le déchargement des marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "925827c3-b503-4de9-b721-6cb3a8459767",
                                                "sense_id": "806bd950-a747-3a7e-8532-c93de8e73b8b",
                                                "text": "Le 22, au point du jour, la cité entière, entassée sur les quais du port et sur les côtes voisines, guettait d’un œil avide et colère le steamer qui amenait à Copenhague la députation du meeting de Rendsbourg."
                                            },
                                            {
                                                "example_id": "986252f5-7e83-4004-99be-803664693095",
                                                "sense_id": "806bd950-a747-3a7e-8532-c93de8e73b8b",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff951381-2eab-3f1c-8bd2-f6c4f55323a7",
                                        "entry_id": "e60482fb-c42d-35ce-a333-7e0dceda0fa5",
                                        "glosses": [
                                            "Trottoir d’embarquement dans une gare de chemin de fer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee4b511-901a-4df7-b69b-ba0064289f42",
                                                "sense_id": "ff951381-2eab-3f1c-8bd2-f6c4f55323a7",
                                                "text": "On me délivre un billet de première classe, valable jusqu’à Bakou. Je descends sur le quai qui donne accès aux voitures."
                                            },
                                            {
                                                "example_id": "16144b2f-1f1d-4548-9c50-a9de8e734522",
                                                "sense_id": "ff951381-2eab-3f1c-8bd2-f6c4f55323a7",
                                                "text": "À toute allure les autobus, les omnibus et les charrettes de commissionnaires voituraient malles et valises vers la gare ; sur les quais envahis, l’exode des hiverneurs d’élite se heurtait à la bousculade des voyageurs de toute espèce."
                                            },
                                            {
                                                "example_id": "ed5a2b42-fd99-473c-b5c7-b8c2ab32263c",
                                                "sense_id": "ff951381-2eab-3f1c-8bd2-f6c4f55323a7",
                                                "text": "On ne voyait pas les tramways. […]. Pourtant les quais où ils roulaient, avec des piaulements plaintifs, n’étaient guère éloignés, car la rue, quelquefois, tremblait à leur passage […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
