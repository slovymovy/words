                "translations": [
                    {
                        "translation_id": "10dc3197-4854-4479-ad64-572defdcae31",
                        "source_entry_id": "026a3844-cd6e-3435-8349-3079349d867c",
                        "source_sense_id": "f2aade21-7142-3227-8fb8-45e40f449f41",
                        "target_lang_word": "china",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "china",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cbb4e94-c7bb-339c-88d5-a9c293e2dad8",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Synonym of porcelain, a hard white translucent ceramic made from kaolin, now (chiefly US) sometimes distinguished in reference to tableware as fine or good china."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4e1c1d-bc0f-4e34-b07c-dd5e7058209f",
                                                "sense_id": "2cbb4e94-c7bb-339c-88d5-a9c293e2dad8",
                                                "text": "It's a china doll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e60e7f82-8f46-36c2-a4a5-fd6bfeae4582",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Chinaware: porcelain tableware."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2758ee25-37b3-4ad7-bbf0-3c8d8395488b",
                                                "sense_id": "e60e7f82-8f46-36c2-a4a5-fd6bfeae4582",
                                                "text": "They sell Callicoes, Cheney Sattin, Cheney ware."
                                            },
                                            {
                                                "example_id": "310f3586-cafb-4bb7-9d5e-3f87bc163004",
                                                "sense_id": "e60e7f82-8f46-36c2-a4a5-fd6bfeae4582",
                                                "text": "...a Present of certain very rich Pieces of China."
                                            },
                                            {
                                                "example_id": "089d2e8c-45dc-4a9c-ac17-29ac64a27977",
                                                "sense_id": "e60e7f82-8f46-36c2-a4a5-fd6bfeae4582",
                                                "text": "He set the table with china, cloth napkins, and crystal stemware."
                                            },
                                            {
                                                "example_id": "6798e10c-8f76-4536-8348-88e066c5e0f9",
                                                "sense_id": "e60e7f82-8f46-36c2-a4a5-fd6bfeae4582",
                                                "text": "The traditional 20th anniversary gift is china."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dacc692-7c74-37d7-9450-836690e2cb0e",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Cheaper and lower-quality ceramic and ceramic tableware, distinguished from porcelain."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1442570-06b2-4c73-ac21-f91d8b490211",
                                                "sense_id": "9dacc692-7c74-37d7-9450-836690e2cb0e",
                                                "text": "What is porcelain? A fine earthenware differing from china in being harder, whiter, harder to fuse and more translucent than ordinary pottery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414ce666-e7a8-3af0-b931-ccdf85856475",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Synonym of China root, the root of Smilax china (particularly) as a medicine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd91db78-594d-4701-9035-ec64ccb67dc9",
                                                "sense_id": "414ce666-e7a8-3af0-b931-ccdf85856475",
                                                "text": "China, saith Manardus, makes a good colour in the face, takes away melancholy, and all infirmities proceeding from cold […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ccb9154-2f75-3ecb-b474-9c10ae0c1008",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Synonym of cheyney: worsted or woolen stuff."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1fc1613-4e63-49d3-a175-4a39ae3a5841",
                                                "sense_id": "1ccb9154-2f75-3ecb-b474-9c10ae0c1008",
                                                "text": "...And then the last boon I'll implore,\nIs to bless us with China so tight..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9721851e-a4d4-3ac8-a349-61a51b6aea4b",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Synonym of China rose, in its various senses."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab13a2e-0e64-45ba-995c-cdcb4df9d052",
                                                "sense_id": "9721851e-a4d4-3ac8-a349-61a51b6aea4b",
                                                "text": "Rosa indica (the common China); Rosa semperflorens (the monthly China)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340b1143-2275-3fae-8cc7-c6deddb1ff2b",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Synonym of mate (rhyme of china-plate)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Cockney",
                                            "South-Africa",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8d9d93-11e3-4437-b6e9-c943f116a110",
                                                "sense_id": "340b1143-2275-3fae-8cc7-c6deddb1ff2b",
                                                "text": "All right, me old china?"
                                            },
                                            {
                                                "example_id": "38d3f58c-3476-4782-b452-e0dc22761be7",
                                                "sense_id": "340b1143-2275-3fae-8cc7-c6deddb1ff2b",
                                                "text": "‘Now, then, my china-plate...’ This is essentially a brick~layer's phrase. If for ‘china-plate’ you substitute ‘mate’,[…] the puzzle is revealed."
                                            },
                                            {
                                                "example_id": "3bcedeb8-7401-4724-a990-087d817a651b",
                                                "sense_id": "340b1143-2275-3fae-8cc7-c6deddb1ff2b",
                                                "text": "China, or Old China: chum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1b6ea2-3a72-3241-ba47-b5ebd4c3a682",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "Tea from China, (particularly) varieties cured by smoking or opposed to Indian cultivars."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "554f8d88-6ca5-4a0f-b0c7-164767f8eed1",
                                                "sense_id": "0b1b6ea2-3a72-3241-ba47-b5ebd4c3a682",
                                                "text": "Tea... Finest China, Plain (Moning)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ea12e0-f198-31a0-932f-5c9237190910",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "A glazed china marble."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b8aa6ff-5952-4738-a661-425c52fd03f3",
                                                "sense_id": "f6ea12e0-f198-31a0-932f-5c9237190910",
                                                "text": "The marbles, in those days, had their primitive names. The unglazed china ones were called plasters because they looked like plaster; the glazed china marbles were called chinas. I remember how charming were the partly colored lines which encircled them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7e4133-1ab4-33aa-8a38-e0d6fe5c6fa9",
                                        "entry_id": "b6a5de1a-399a-3fc5-8b3d-f6154bc14af3",
                                        "glosses": [
                                            "A kind of drum cymbal approximating a Chinese style of cymbal, but usually with Turkish influences."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "918bced9-0b7d-43b8-bf75-9096f2ed7c6a",
                                                "sense_id": "5f7e4133-1ab4-33aa-8a38-e0d6fe5c6fa9",
                                                "text": "China cymbals are a type of short sound cymbal. [Brand X] makes chinas with really short sounds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
