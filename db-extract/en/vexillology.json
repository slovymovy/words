                        ],
                        "examples": [
                            {
                                "example_id": "e03dd620-0515-4e2b-b60e-8b75ccc032e5",
                                "sense_id": "5f4b08a9-48b2-3d3f-b6e4-4dc9262bda00",
                                "text": "Vexillology can help us to delve into national and global history."
                            },
                            {
                                "example_id": "d516af92-0a39-412f-a0d4-fd7bf656c4ae",
                                "sense_id": "5f4b08a9-48b2-3d3f-b6e4-4dc9262bda00",
                                "text": "Sheldon: Over the next few 52 weeks, you and I are going to explore the dynamic world of vexillology."
                            }
                        ]
