                        "entry_id": "958ff648-5ba4-3760-a316-2417696a2353",
                        "glosses": [
                            "Relatif, appartenant aux Morisques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f136411-fcba-4645-90a1-e9bdf0473a66",
                                "sense_id": "c64a4f50-dd92-3149-b597-59ea7779f1eb",
                                "text": "Mais ceux-là font pitié. Ils devraient nous donner au moins une danse morisque, ou quelque autre momerie !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c340248-1070-44b9-ba59-39b9eab2381f",
                        "source_entry_id": "958ff648-5ba4-3760-a316-2417696a2353",
                        "source_sense_id": "c64a4f50-dd92-3149-b597-59ea7779f1eb",
