                "senses": [
                    {
                        "sense_id": "c04d159e-5365-3b7e-836d-d237af27642b",
                        "entry_id": "db022089-7b23-31de-af41-3f02f92edf47",
                        "glosses": [
                            "het in een min of meer strakke structuur van ritme, maat en klank verwoorden van een gedachte of een verhaal"
                        ],
                        "tags": [
                            "cultuur"
                        ],
                        "examples": [
                            {
                                "example_id": "19af55ca-d3d4-40c1-8d90-34de87fbc525",
                                "sense_id": "c04d159e-5365-3b7e-836d-d237af27642b",
                                "text": "De indeling in verzen valt bij schriftelijke weergave van dichtkunst meestal meteen op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cc48f73-08ef-471f-8f41-31ab24dc1c40",
                        "source_entry_id": "db022089-7b23-31de-af41-3f02f92edf47",
                        "source_sense_id": "c04d159e-5365-3b7e-836d-d237af27642b",
                        "source_sense_description": "in ritme, maat, en klank verwoorden",
                        "target_lang_word": "Dichtkunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dichtkunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "127fd476-a360-3389-a13f-214abf1af14c",
                                        "entry_id": "cecc0917-423c-3b8e-aebd-cc72e751d214",
                                        "glosses": [
                                            "Fähigkeit, künstlerische dichterische Werke hervorzubringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e66ba125-e739-4212-ab73-44ccc547833e",
                                                "sense_id": "127fd476-a360-3389-a13f-214abf1af14c",
                                                "text": "Heidemarie verblüffte uns mit ihrer Dichtkunst."
                                            },
                                            {
                                                "example_id": "424e0a96-4781-4a4b-9682-f0652f58bdb2",
                                                "sense_id": "127fd476-a360-3389-a13f-214abf1af14c",
                                                "text": "„Ich las die Verse so, daß der Kardinal ganz entzückt war; und da, wo ich die Schilderung gewisser Schönheiten gab, die man der Dichtkunst zu loben erlaubt, die ich aber nicht gesehen haben konnte, wurde die Marchesa rot.“"
                                            },
                                            {
                                                "example_id": "c43178f5-3be4-451c-8b7e-67ff7409e41f",
                                                "sense_id": "127fd476-a360-3389-a13f-214abf1af14c",
                                                "text": "„Aber es wird hier auch ein Wandel in der Auffassung, worauf es ankomme in der Dichtkunst, deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6c2bc8b-fbc4-3b5f-a3cb-ec3153689409",
                                        "entry_id": "cecc0917-423c-3b8e-aebd-cc72e751d214",
                                        "glosses": [
                                            "Werke, die aufgrund von ^([1]) zustande kommen/gekommen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c968d19-1722-4c9a-8083-54382c1bb9f8",
                                                "sense_id": "b6c2bc8b-fbc4-3b5f-a3cb-ec3153689409",
                                                "text": "„Auf Island beginnt die Dichtkunst mit den ersten Siedlern.“"
                                            },
                                            {
                                                "example_id": "e78f0313-cc47-48b1-80d1-f8d9db81af23",
                                                "sense_id": "b6c2bc8b-fbc4-3b5f-a3cb-ec3153689409",
                                                "text": "„Sie sind nicht hier, um deiner Dichtkunst zu lauschen.“"
                                            },
                                            {
                                                "example_id": "bd03f81b-f27c-4821-bfd8-ea7158fec40b",
                                                "sense_id": "b6c2bc8b-fbc4-3b5f-a3cb-ec3153689409",
                                                "text": "„Zuletzt entschuldigte er sich, wobei er einige Worte über die Dichtkunst einflocht.“"
                                            },
                                            {
                                                "example_id": "e19c0083-733c-4930-a958-6bdb304ec1b8",
                                                "sense_id": "b6c2bc8b-fbc4-3b5f-a3cb-ec3153689409",
                                                "text": "„Erst 1926 beschloss man, Dichter dazuzuholen und eine Abteilung für Dichtkunst einzurichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
