                    {
                        "translation_id": "3411f064-a15d-43a0-a10f-03e22bbf1998",
                        "source_entry_id": "7462d1b6-37c7-3a5e-8341-579b4e364563",
                        "source_sense_id": "bae4191e-cc7a-306a-a7bc-2b0954f51792",
                        "target_lang_word": "hypocondriaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocondriaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d80b0250-45cb-3849-a6cf-6d712ea9e3bc",
                                        "entry_id": "b5efc81b-e9d4-3cba-8560-cb866b723232",
                                        "glosses": [
                                            "Relatif aux hypocondres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c211ee-1320-4750-9860-37fd52f97c6e",
                                                "sense_id": "d80b0250-45cb-3849-a6cf-6d712ea9e3bc",
                                                "text": "Le corps de la victime gisait à la renverse sur les dalles, « […]. Il portait à la région hypocondriaque gauche une plaie ronde formée par une balle sortie au milieu de la colonne vertébrale, à la région lombaire. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a3066c-d9f9-3e3f-95ba-0490c24a4751",
                                        "entry_id": "b5efc81b-e9d4-3cba-8560-cb866b723232",
                                        "glosses": [
                                            "Relatif à l'hypocondrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987632be-7d5c-4c51-8abd-7a31a8f3fc0b",
                                                "sense_id": "60a3066c-d9f9-3e3f-95ba-0490c24a4751",
                                                "text": "Quand il est amené dans notre clinique, on constate mouvement subfébrile à 37,8 ; albuminurie légère. Au point de vue psychique, dépression avec anxiété et préoccupations hypocondriaques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440b9202-3de1-3d29-97d7-2e452ae7c9d9",
                                        "entry_id": "b5efc81b-e9d4-3cba-8560-cb866b723232",
                                        "glosses": [
                                            "Qui est atteint d’hypocondrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6d4d92-4f0d-41d9-9137-4d649f8d2033",
                                                "sense_id": "440b9202-3de1-3d29-97d7-2e452ae7c9d9",
                                                "text": "La trop grande solitude peut rendre hypocondriaque. Il est hypocondriaque."
                                            },
                                            {
                                                "example_id": "8e41bc92-7c06-4d7c-b0d4-31bd29f53289",
                                                "sense_id": "440b9202-3de1-3d29-97d7-2e452ae7c9d9",
                                                "text": "De telles rêvasseries conviennent aux bilieux hypocondriaques et non point à ces joyeux qui ont la joue vermeille et l’oreille rouge."
                                            },
                                            {
                                                "example_id": "2f0c27cc-c242-447d-8cf3-98e72aeea6a2",
                                                "sense_id": "440b9202-3de1-3d29-97d7-2e452ae7c9d9",
                                                "text": "Cet appartement : elle en avait été si fière ! Elle avait pris en grippe celui de la rue de Rennes que mon père vieillissant, devenu hypocondriaque, remplissait des éclats de sa mauvaise humeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hypocondriaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b055c30a-7238-3121-939c-34e7ccbb4ad3",
                                        "entry_id": "9ebee526-0e0b-3a31-9da2-2addc5d9403a",
                                        "glosses": [
                                            "Personne qui se préoccupe abusivement de sa santé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425ff944-1c54-41ad-bafe-4be7e2adeb85",
                                                "sense_id": "b055c30a-7238-3121-939c-34e7ccbb4ad3",
                                                "text": "Quelques sermons de quelques hypocondriaques sont-ils à ce point, parvenus à déconcilier l’Algérien avec sa santé ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aec4fc3-8d92-3380-b7fd-76f7ec9a509c",
                                        "entry_id": "9ebee526-0e0b-3a31-9da2-2addc5d9403a",
                                        "glosses": [
                                            "Personne ayant constamment l’impression qu’elle est ou va tomber malade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfbde0ea-b9a4-4ce6-be61-aee21f00abab",
                                                "sense_id": "6aec4fc3-8d92-3380-b7fd-76f7ec9a509c",
                                                "text": "Étant donc établi que l’hypocondrie est une maladie, en voilà au moins une que l’hypocondriaque ne fait pas naître de son imagination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
