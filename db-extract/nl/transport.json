                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transport",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c307b3bb-03b3-3929-8bf7-b737202020ec",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Action de porter d’un lieu à un autre sur une certaine distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "894fd6e7-9d77-4856-82ec-fd36a30d2b96",
                                                "sense_id": "c307b3bb-03b3-3929-8bf7-b737202020ec",
                                                "text": "J’avais laissé Reykjavik, un grand village […] des poneys et une ou deux mauvaises carrioles assuraient le transport."
                                            },
                                            {
                                                "example_id": "03fe9805-093c-4394-b6f0-4264fbf8eea5",
                                                "sense_id": "c307b3bb-03b3-3929-8bf7-b737202020ec",
                                                "text": "Autre secteur où la baisse séculaire des prix favorise la production et la productivité : celui des transports."
                                            },
                                            {
                                                "example_id": "3ab13129-171d-4e03-979e-541deaa3a24f",
                                                "sense_id": "c307b3bb-03b3-3929-8bf7-b737202020ec",
                                                "text": "Le transport de ses meubles lui a coûté cher. - Le transport de ces marchandises se fait par bateau. - Payer les frais de transport. - Le transport de l’énergie électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db8e9bab-8efc-370e-81c0-0308cd59fba8",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "La chose transportée, elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab36e04-f7bf-4549-9644-aa94267b9ae6",
                                                "sense_id": "db8e9bab-8efc-370e-81c0-0308cd59fba8",
                                                "text": "Le pain était arrivé, non sans peine et sans perte: en venant à nous de Grandpré, où se trouvait la boulangerie, plusieurs chariots étaient restés embourbés, d’autres étaient tombés dans les mains de l’ennemi ; d’ailleurs une partie du transport était immangeable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9eee187-f97d-3e91-bea3-2ae61e2d92b7",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Action d’une personne qui, par autorité de justice, se rend, se transporte sur les lieux où sont les choses sujettes à un examen, à une vérification, à une visite."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4971828d-d671-449b-a1e9-4f867f21efff",
                                                "sense_id": "e9eee187-f97d-3e91-bea3-2ae61e2d92b7",
                                                "text": "Transport d’un juge, d’un commissaire, d’un expert sur les lieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c94cab9-d7ac-33f4-8fef-30cfff19731c",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Bâtiment chargé de transporter des troupes, des munitions, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f599f7-a07f-4d3d-800b-53df95d3a4f2",
                                                "sense_id": "3c94cab9-d7ac-33f4-8fef-30cfff19731c",
                                                "text": "Le lundi 20, le contre-torpilleur l’Audacieux et le transport Aude mouillaient devant la capitale."
                                            },
                                            {
                                                "example_id": "cf904ef5-5413-41b6-a952-814aec6c88e8",
                                                "sense_id": "3c94cab9-d7ac-33f4-8fef-30cfff19731c",
                                                "text": "À Eupatoria, dont la rade présentait un spectacle effrayant, quinze transports, tant français qu’anglais, furent jetés à la côte […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c239271-2cf7-3c15-b00e-5b49ad80bfd3",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Cession d’un droit qu’on a sur quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0deaa133-9501-420a-9d85-857046bce235",
                                                "sense_id": "7c239271-2cf7-3c15-b00e-5b49ad80bfd3",
                                                "text": "Il m’a fait transport de ce qui lui est dû par un tel. - Faire le transport d’un billet, d’une rente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Mouvement passionné, élan qui nous met en quelque sorte hors de nous-mêmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91a0ccb-df4f-4b1c-b2f9-c3af93bd8a45",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "Il n'y avait que trois heures qu'elle m'avait accablé de ses plus tendres caresses, et qu'elle avait reçu les miennes avec transport;…."
                                            },
                                            {
                                                "example_id": "d4783d04-f077-4760-ba11-faa615a3b1e3",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "Il trouva le templier dans un transport de colère causé par un nouveau refus qu’il venait d’essuyer de la part de la belle juive."
                                            },
                                            {
                                                "example_id": "5ccfae46-22ff-413a-bfe7-81ebee0dffe7",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "La glorieuse défense de Mazagran a excité, dans toute la France, des transports unanimes d'admiration."
                                            },
                                            {
                                                "example_id": "247c5bdf-f462-4868-806d-26d2f149721d",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "— Je ne sais, dit cette voix, ce qui excite vos transports ; mais j’aime à les entendre."
                                            },
                                            {
                                                "example_id": "2256072b-1a18-478a-8293-dbdf1ebeb12f",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "La récolte de grain fut médiocre ; mais les foins avaient été beaux, de sorte que l’année dans son ensemble ne méritait ni transports de joie ni doléances."
                                            },
                                            {
                                                "example_id": "c3492b57-f3d3-4beb-ab97-68e150e278db",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "Gasbieha se précipita dans la chambre de sa sœur de lait avec des transports de joie."
                                            },
                                            {
                                                "example_id": "fdcc3b3b-af20-4c23-bb6b-dd6b820aa8a4",
                                                "sense_id": "c132335f-2466-3b94-8a73-4e6842bd6ddf",
                                                "text": "Aux abords de Bab Segma, toute la population du mellah nous accueillit avec des transports d’allégresse, et plusieurs orchestres israélites nous gratifièrent de l’air de « la Mère Michel », qui passait alors pour notre hymne national."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4292e89-587a-307d-a958-031f0e200d59",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Transports en commun."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84f4d9a-42e1-4a72-9999-08fffcd22828",
                                                "sense_id": "b4292e89-587a-307d-a958-031f0e200d59",
                                                "text": "Aujourd’hui je suis venu en transports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbec6859-9ed3-3e0c-8583-54c92e963d41",
                                        "entry_id": "9c78e7c3-6260-3d72-b204-70bb0c5a63ea",
                                        "glosses": [
                                            "Mouvement d'une molécule à travers une barrière, généralement la membrane cellulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67f6a05-8e8b-4541-aa0a-667b774e6bd4",
                                                "sense_id": "dbec6859-9ed3-3e0c-8583-54c92e963d41",
                                                "text": "Les carnitines aident au transport des acides gras à longue chaîne du cytoplasme aux mitochondries, ce qui peut augmenter la production d'énergie dans les cellules et combattre la fatigue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
