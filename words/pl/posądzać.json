                    "frequency": "Middle",
                    "semantic_group_id": "oskarżanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie można <w>posądzać</w> go o kłamstwo bez posiadania twardych dowodów.",
