                                        "entry_id": "04c43135-c59c-3342-a40b-6299dad9dbba",
                                        "glosses": [
                                            "als etwas Göttliches zugleich Schauer hervorrufend und anziehend wirkend"
                                        ],
                                        "tags": [
                                            "Religionswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9d0a1a-1f31-4f5b-9c38-8414b142e588",
                                                "sense_id": "4b2c30e0-1728-35ed-9108-503f77f1409b",
                                                "text": "„Nach Otto erinnert die numinose Erfahrung an Begriffe und Prinzipien wie Liebe, Übermacht und Güte, so dass das Numinose zwar nicht beschrieben, jedoch mit dem Denken und Handeln verbunden ist.“"
                                            }
                                        ],
