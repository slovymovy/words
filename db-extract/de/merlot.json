                ],
                "senses": [
                    {
                        "sense_id": "cc5e6270-6b56-3e67-9533-6354e879e004",
                        "entry_id": "3b6d3648-8d81-3a18-b2b5-3399fc06cb52",
                        "glosses": [
                            "eine rote Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028716b2-a7a1-4da4-a841-4051082fa9a7",
                                "sense_id": "cc5e6270-6b56-3e67-9533-6354e879e004",
                                "text": "„Der Merlot ist im Weinberg kein unkomplizierter Pflegling: Er treibt früher aus als der Cabernet Sauvignon und ist daher stärker frostgefährdet als dieser, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a720497f-0bb5-340b-a04e-ffffefd1acf5",
                        "entry_id": "3b6d3648-8d81-3a18-b2b5-3399fc06cb52",
                        "glosses": [
                            "der eher selten als reiner Sortenwein aus Merlot-Reben hergestellte Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7697754-0e29-4fc4-906a-6f574ca9740a",
                                "sense_id": "a720497f-0bb5-340b-a04e-ffffefd1acf5",
                                "text": "„Der Merlot ist weich, schmeckt ein wenig nach Pflaumen, hat einen mittleren bis hohen Alkohol-Gehalt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "167acdb4-2c82-4c80-b8d1-e7c5525f8b7c",
                        "source_entry_id": "3b6d3648-8d81-3a18-b2b5-3399fc06cb52",
                        "source_sense_id": "cc5e6270-6b56-3e67-9533-6354e879e004",
                        "source_sense_description": "Weinbau: eine rote Rebsorte",
                        "target_lang_word": "merlot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merlot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b02a8cb-e821-3578-877d-64f924889a5c",
                                        "entry_id": "30f31a12-a4a6-3fc2-baa0-da36b728643f",
                                        "glosses": [
                                            "Cépage donnant des raisins sphériques d'un noir bleuté, cultivé entre autre dans le Bordelais, et dont le nom officiel international est merlot noir."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50a041a7-9e01-4315-bc62-e26af19506c0",
                                                "sense_id": "9b02a8cb-e821-3578-877d-64f924889a5c",
                                                "text": "Les vins issus des cépages merlot, cabernet-franc et cabernet-sauvignon sont puissants, colorés, riches en sève et en parfums."
                                            },
                                            {
                                                "example_id": "a2c6158a-43b2-4033-afdd-b11b1ec412c9",
                                                "sense_id": "9b02a8cb-e821-3578-877d-64f924889a5c",
                                                "text": "On cultive la vigne depuis la fin du IIIᵉ siècle dans l’île d'Oléron et ses vins, sous l’indication géographique protégée Vins de Pays charentais-île d’Oléron, sont élaborés à partir de sauvignon, colombard, chardonnay, cabernet ou merlot."
                                            },
                                            {
                                                "example_id": "e61bb099-48f8-4667-808f-7ac2b0f5aa7c",
                                                "sense_id": "9b02a8cb-e821-3578-877d-64f924889a5c",
                                                "text": "Morton ouvrit une bouteille de merlot et en servit deux verres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74ce9d2-366a-33fa-8113-70775bbd38a9",
                                        "entry_id": "30f31a12-a4a6-3fc2-baa0-da36b728643f",
                                        "glosses": [
                                            "Jeune merle."
                                        ],
                                        "tags": [
                                            "Patois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27fb9bd5-8b6f-4e47-a0ea-fceb7e8c5db9",
                                                "sense_id": "f74ce9d2-366a-33fa-8113-70775bbd38a9",
                                                "text": "L’arbre, plein d’oiseaux, chantait. Il ruisselait de chants, comme une grappe de raisin qu’on presse entre ses mains. Guillaumet le pinson, Marie Godrée la rouge-gorge, et la limeuse de scie, et la grise Sylvie, fauvette qui babille, et Merlot mon compère, celui que je préfère, parce que rien ne lui fait, ni froid, ni vent, ni pluie, et que toujours il rit, toujours de bonne humeur, le premier à chanter dès l’aube, et le dernier, et parce qu’il a, comme moi, le pif enluminé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "merlot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a453b3be-0e01-3875-845f-e0ec616742ea",
                                        "entry_id": "3a999b46-c18a-3791-9bc4-3270e75429b7",
                                        "glosses": [
                                            "Relatif à Merles-sur-Loison, commune française située dans le département de la Meuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
