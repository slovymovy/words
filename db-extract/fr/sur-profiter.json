                "senses": [
                    {
                        "sense_id": "745e25e1-f829-3aa0-9422-d9a75d2bbc24",
                        "entry_id": "fd8cabeb-b32e-3aa7-b8cf-2feb38261854",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de surprofiter (profiter de façon excessive, ou plus que la normale)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0431b4-4f87-4f63-8584-a7839b95983c",
                                "sense_id": "745e25e1-f829-3aa0-9422-d9a75d2bbc24",
                                "text": "On évite donc juste qu'il \"sur-profite\" d'une situation abusive à laquelle son compatriote vivant au pays n'a pas accès."
                            },
                            {
                                "example_id": "992382e5-751e-458e-9998-c4d02e5fab06",
                                "sense_id": "745e25e1-f829-3aa0-9422-d9a75d2bbc24",
                                "text": "Alors que nous sur-profitons des réserves énergétiques, d'autres se chauffent encore au bois ou au charbon…"
                            },
                            {
                                "example_id": "51e362d2-9a6d-480f-af6c-549ee25b825f",
                                "sense_id": "745e25e1-f829-3aa0-9422-d9a75d2bbc24",
                                "text": "La profitabilité des entreprises du secteur a tant augmenté que leurs dividendes ont atteint des sommets historiques. On peut donc dire qu'elles sur-profitent."
                            }
                        ]
                    }
                ],
