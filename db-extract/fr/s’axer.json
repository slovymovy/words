                "senses": [
                    {
                        "sense_id": "dca5b049-2f85-3c54-b9cc-cfcf9d4dcb83",
                        "entry_id": "d8e76cf6-50c5-3f0c-8aac-262cb8c3bf15",
                        "glosses": [
                            "S’orienter suivant un axe, une direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4ed355-f045-4df9-9da7-b4023807436b",
                                "sense_id": "dca5b049-2f85-3c54-b9cc-cfcf9d4dcb83",
                                "text": "Par exemple si l’enfant révèle une anxiété ou une dépression, le traitement changera de forme pour s’axer sur le trouble psychopathologique ainsi révélé."
                            },
                            {
                                "example_id": "b45c8cc4-3ff9-4a43-ad2a-a60f50a34ad8",
                                "sense_id": "dca5b049-2f85-3c54-b9cc-cfcf9d4dcb83",
                                "text": "Pour autant que cet enseignement vise à former ceux qui désirent s’axer sur l’agriculture ou qui veulent y retourner, il y aura un dernier principe à respecter, à savoir le lien avec le milieu agraire."
                            }
                        ]
                    }
