                        "sense_id": "5e29014e-03a7-322f-814d-793b68f96726",
                        "entry_id": "7b03c228-6618-3b12-a052-be34b1d53116",
                        "glosses": [
                            "een sieraad dat om de pols gedragen wordt en bestaat uit losse onderdelen die in elkaar gehaakt zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64df435c-afa5-47c3-8ae9-3d79cc48761d",
                                "sense_id": "5e29014e-03a7-322f-814d-793b68f96726",
                                "text": "Kijk naar de digitale horloges van Casio, die modellen met goud- of zilverkleurige schakelarmbanden. Wie jong was in de eighties, vond ze stom. Sinds een paar jaar zitten ze aan elke hippe pols."
                            },
                            {
                                "example_id": "9291b75d-38bd-4a3f-b717-86a9e8d035b6",
                                "sense_id": "5e29014e-03a7-322f-814d-793b68f96726",
                                "text": "Aan de meeste sieraden hangt wel een emotie. Een geelgouden ring die ik van mijn ouders heb gekregen toen ik 18 werd. Een schakelarmband met negen bedeltjes die ons leven symboliseert en een zilveren collier, nog gekregen van mijn ouders,’’ zegt de gepensioneerde Almelose."
                            }
                        ]
                    }
