                        "entry_id": "6f0a60e7-677b-31fa-a018-01130bae68bf",
                        "glosses": [
                            "Pièce de poésie ou de musique écrite ou exécutée entre des ouvrages plus importants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66dccd70-c1fe-4f15-947c-1953d74388bb",
                                "sense_id": "55949989-d653-366c-93d5-8fa62bab2dce",
                                "text": "Le programme comprendra une conférence et des interludes."
                            }
                        ]
                    },
                    {
                        "sense_id": "93aee753-8942-3ede-925d-b4e228be949a",
                        "entry_id": "6f0a60e7-677b-31fa-a018-01130bae68bf",
                        "glosses": [
                            "Court programme inséré entre deux émissions plus importantes, ou lors d'une panne."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "782cc572-b501-3b33-93ad-32e62c5a8701",
                        "entry_id": "6f0a60e7-677b-31fa-a018-01130bae68bf",
                        "glosses": [
                            "Période transitoire."
