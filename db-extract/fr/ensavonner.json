                                        "glosses": [
                                            "Restregar un objeto (vajilla, ropa, etc.) con jabón y agua para limpiarlo o ablandarlo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "facaaa43-4314-46fd-95ca-89854c83d135",
                                                "sense_id": "7895c2c1-d892-3809-b54f-b6b23028e32a",
                                                "text": "Se lavaban la cara por las fiestas, y el cuerpo nunca, a pesar de que tenían a orgullo llevar muy limpios sus pañuelos, sus faldas, sus corpiños, lo cual hacíalas pasarse enjabonando ropas todo el día."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "100eda7f-8061-3ddc-a01a-fffa2c1ae4ea",
                                        "entry_id": "e20bc9b7-dee0-3cf9-be04-58f3420ed91c",
                                        "glosses": [
                                            "Frotar la piel o el cabello con jabón y agua."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1282eb3b-c233-4658-9f08-91f3711afbbb",
                                                "sense_id": "100eda7f-8061-3ddc-a01a-fffa2c1ae4ea",
                                                "text": "se frotaba las manos con fuerza y como si se las estuviera enjabonando en seco"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
