        "nl-extract.jsonl": [
            {
                "entry_id": "27fb1e1d-acd3-3ea2-826b-fc531fabffb8",
                "word": "gnoom",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8c20e6fa-2610-483d-b222-9290babe3342",
                        "entry_id": "27fb1e1d-acd3-3ea2-826b-fc531fabffb8",
                        "tags": [
