                                    },
                                    {
                                        "sense_id": "4d49513e-a4ca-3361-b183-5ea7ae1f5d19",
                                        "entry_id": "6bf026d5-c8c9-3485-bde9-c379b92f73ad",
                                        "glosses": [
                                            "The capital city of Saudi Arabia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734a786b-7793-4435-b1a0-e5173ef99c78",
                                                "sense_id": "4d49513e-a4ca-3361-b183-5ea7ae1f5d19",
                                                "text": "U.S. President Donald Trump delighted his Saudi hosts in Riyadh on May 13, telling them America wouldn’t be giving “lectures on how to live” under his watch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a8f67f-3246-3646-998f-439fb6a0a604",
                                        "entry_id": "6bf026d5-c8c9-3485-bde9-c379b92f73ad",
                                        "glosses": [
                                            "The government of Saudi Arabia."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1536b8ec-0b16-415c-ad39-22ba3b2867ac",
                                                "sense_id": "29a8f67f-3246-3646-998f-439fb6a0a604",
                                                "text": "Notable in the delegation was a significant contingent of cultural bodies, a move which immediately drew criticism that the Gulf state was “art-washing” – using Britain’s venerable institutions to improve its international image even as concerns over Riyadh’s human rights record continue to mount."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73cf4d67-bf19-4c08-98ee-73991ebb5baa",
                        "source_entry_id": "6a5e65f6-50f0-3f66-955b-f22bb1fa481b",
                        "source_sense_id": "0edd46ff-efbe-36dd-a906-54bef8520a7b",
