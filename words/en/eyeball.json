    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ceb68b7d-c385-334b-9878-b95c817c3d12",
                    "sense_definition": "The ball-shaped part of the eye, enclosed by the socket and eyelids.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dust got into his <w>eyeball</w> during the storm, causing painful irritation.",
                            "target_lang_translations": {
                                "es": "Le entró polvo en el <w>globo ocular</w> durante la tormenta, causándole una dolorosa irritación."
                            }
                        },
                        {
                            "text": "The optometrist carefully examined the back of each <w>eyeball</w> for damage.",
                            "target_lang_translations": {
                                "es": "El optometrista examinó minuciosamente el fondo de cada <w>globo ocular</w> en busca de daños."
                            }
                        }
                    ],
                    "synonyms": [
                        "eye-apple"
                    ],
                    "target_lang_definitions": {
                        "es": "Parte esférica del ojo encerrada por la cuenca ocular y los párpados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "globo ocular",
                                "target_lang_sense_clarification": "órgano de la visión"
                            },
                            {
                                "target_lang_word": "ojo",
                                "target_lang_sense_clarification": "órgano de la visión"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50d86787-88ed-357c-9a5a-f44669b8219b",
                    "sense_definition": "Viewers, readers, or visitors considered as an audience for media or advertising.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "audience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing department needs creative ideas to attract more <w>eyeballs</w> to our website.",
                            "target_lang_translations": {
                                "es": "El departamento de marketing necesita ideas creativas para atraer más <w>visitas</w> a nuestro sitio web."
                            }
                        },
                        {
                            "text": "Popular streaming services compete intensely to draw millions of <w>eyeballs</w> every evening.",
                            "target_lang_translations": {
                                "es": "Las plataformas populares de streaming compiten intensamente para captar millones de <w>espectadores</w> cada noche."
                            }
                        }
                    ],
                    "common_phrases": [
                        "attract eyeballs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used especially in business and marketing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Espectadores, lectores o visitantes considerados como público para medios o publicidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "visitas",
                                "target_lang_sense_clarification": "en sitios web o medios digitales"
                            },
                            {
                                "target_lang_word": "espectadores",
                                "target_lang_sense_clarification": "audiencia de medios"
                            },
                            {
                                "target_lang_word": "ojos",
                                "target_lang_sense_clarification": "audiencia metafórica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d9cf5f9-cf3a-378f-bf37-3203a212c2f6",
                    "sense_definition": "A person's focus of attention or concentrated gaze.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presenter managed to keep every <w>eyeball</w> fixed on the main stage throughout the conference.",
                            "target_lang_translations": {
                                "es": "El presentador logró mantener cada <w>mirada</w> fija en el escenario principal durante toda la conferencia."
                            }
                        },
                        {
                            "text": "All <w>eyeballs</w> turned toward the entrance as soon as the president arrived.",
                            "target_lang_translations": {
                                "es": "Todos los <w>ojos</w> se volvieron hacia la entrada tan pronto como llegó el presidente."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Centro de atención o mirada concentrada de una persona."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mirada",
                                "target_lang_sense_clarification": "dirección de la vista"
                            },
                            {
                                "target_lang_word": "ojos",
                                "target_lang_sense_clarification": "atención visual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ccdcf40-0d3d-3356-b2d5-e17857015cb8",
                    "sense_definition": "Visual surveillance or monitoring of a person or place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was instructed to keep an <w>eyeball</w> on the suspect until reinforcements arrived.",
                            "target_lang_translations": {
                                "es": "El equipo recibió instrucciones de mantener un <w>ojo</w> sobre el sospechoso hasta que llegaran los refuerzos."
                            }
                        },
                        {
                            "text": "Without a continuous <w>eyeball</w> on the perimeter, security cannot guarantee complete safety.",
                            "target_lang_translations": {
                                "es": "Sin una <w>vigilancia</w> constante en el perímetro, la seguridad no puede garantizar una protección total."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in intelligence, military, or law enforcement contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Vigilancia visual o monitoreo de una persona o lugar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ojo",
                                "target_lang_sense_clarification": "vigilancia o atención constante"
                            },
                            {
                                "target_lang_word": "vigilancia",
                                "target_lang_sense_clarification": "control visual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5143f76b-059c-3624-bfa8-ebc80f08130b",
                    "sense_definition": "A direct, face-to-face meeting or encounter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two managers scheduled an <w>eyeball</w> to resolve their differences in person.",
                            "target_lang_translations": {
                                "es": "Los dos gerentes programaron una <w>reunión cara a cara</w> para resolver sus diferencias en persona."
                            }
                        },
                        {
                            "text": "After weeks of phone calls, they finally had an <w>eyeball</w> in a quiet café downtown.",
                            "target_lang_translations": {
                                "es": "Tras semanas de llamadas telefónicas, finalmente tuvieron un <w>cara a cara</w> en un tranquilo café del centro."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or jargon usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Encuentro o reunión directa cara a cara."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "reunión cara a cara",
                                "target_lang_sense_clarification": "encuentro presencial"
                            },
                            {
                                "target_lang_word": "cara a cara",
                                "target_lang_sense_clarification": "reunión directa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47fb84f9-2000-31e5-a885-00613897f2c1",
                    "sense_definition": "A favorite person or pet; someone cherished above all others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "favorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The youngest granddaughter was clearly the <w>eyeball</w> of the old man.",
                            "target_lang_translations": {
                                "es": "La nieta más joven era claramente el <w>ojito derecho</w> del anciano."
                            }
                        },
                        {
                            "text": "That spoiled puppy is the absolute <w>eyeball</w> of the entire family.",
                            "target_lang_translations": {
                                "es": "Ese cachorro consentido es sin duda la <w>niña de los ojos</w> de toda la familia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Persona o animal favorito; alguien sumamente querido."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ojito derecho",
                                "target_lang_sense_clarification": "persona consentida o favorita"
                            },
                            {
                                "target_lang_word": "niña de los ojos",
                                "target_lang_sense_clarification": "persona muy querida"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb26d338-3063-34d5-829d-968bfe3f2a94",
                    "sense_definition": "To estimate, measure, or judge by eye without using precise tools.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An experienced carpenter can often <w>eyeball</w> the distance accurately.",
                            "target_lang_translations": {
                                "es": "Un carpintero experimentado a menudo puede <w>calcular a ojo</w> la distancia con precisión."
                            }
                        },
                        {
                            "text": "Rather than using a measuring cup, she decided to <w>eyeball</w> the amount of milk needed.",
                            "target_lang_translations": {
                                "es": "En lugar de usar una taza medidora, decidió <w>medir a ojo</w> la cantidad de leche necesaria."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal estimation"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Calcular, medir o juzgar a ojo sin emplear instrumentos de precisión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "calcular a ojo",
                                "target_lang_sense_clarification": "estimar sin medir"
                            },
                            {
                                "target_lang_word": "medir a ojo",
                                "target_lang_sense_clarification": "estimar visualmente"
                            },
                            {
                                "target_lang_word": "ojear",
                                "target_lang_sense_clarification": "estimar aproximadamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f2d6e71-eef4-371f-9fe3-ad7331697393",
                    "sense_definition": "To stare at someone or something intently or suspiciously.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard started <w>eyeballing</w> the customer near the expensive jewelry counter.",
                            "target_lang_translations": {
                                "es": "El guardia de seguridad comenzó a <w>mirar de arriba abajo</w> al cliente que estaba cerca del mostrador de joyas caras."
                            }
                        },
                        {
                            "text": "He felt very uncomfortable because a stranger was <w>eyeballing</w> him from across the street.",
                            "target_lang_translations": {
                                "es": "Se sintió muy incómodo porque un desconocido lo estaba <w>fichando</w> desde el otro lado de la calle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Mirar a alguien o algo fijamente o con recelo y sospecha."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mirar de arriba abajo",
                                "target_lang_sense_clarification": "examinar visualmente con recelo"
                            },
                            {
                                "target_lang_word": "echar el ojo",
                                "target_lang_sense_clarification": "observar fijamente"
                            },
                            {
                                "target_lang_word": "fichar",
                                "target_lang_sense_clarification": "vigilar a alguien con la mirada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "245a4286-3fd5-3d0f-943c-f3df95a8d01f",
                    "sense_definition": "To express disbelief, irritation, or exasperation by rolling one's eyes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She responded to his absurd complaint by simply <w>eyeballing</w> him in sheer disbelief.",
                            "target_lang_translations": {
                                "es": "Ella respondió a su queja absurda simplemente <w>mirándolo con incredulidad</w> absoluta."
                            }
                        },
                        {
                            "text": "The manager kept <w>eyeballing</w> whenever the assistant proposed another unrealistic project timeline.",
                            "target_lang_translations": {
                                "es": "El gerente no paraba de <w>poner los ojos en blanco</w> cada vez que el asistente proponía otro calendario de proyecto poco realista."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Expresar incredulidad o irritación poniendo los ojos en blanco o clavando la mirada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "poner los ojos en blanco",
                                "target_lang_sense_clarification": "en señal de exasperación"
                            },
                            {
                                "target_lang_word": "mirar con incredulidad",
                                "target_lang_sense_clarification": "mirar mostrando asombro o molestia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}