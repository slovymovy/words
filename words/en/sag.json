                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The actor joined <w>Sag</w> as soon as he got his first professional role.",
                            "target_lang_translations": {
                                "ru": "Актер вступил в <w>SAG</w>, как только получил свою первую профессиональную роль."
                            }
