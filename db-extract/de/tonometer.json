                "senses": [
                    {
                        "sense_id": "b82ae3f7-f35b-382a-9aa3-3fdaa0fa5d39",
                        "entry_id": "6e32e82c-721c-35ea-96f8-c4183b51b1eb",
                        "glosses": [
                            "Gerät zur Messung des Augeninnendrucks"
                        ],
                        "tags": [
                            "Augenheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "c63943bb-c0ee-448b-a49d-45538f05f514",
                                "sense_id": "b82ae3f7-f35b-382a-9aa3-3fdaa0fa5d39",
                                "text": "„Der Augeninnendruck stabilisiert die Form des Auges und kann deshalb nichtinvasiv mit dem Tonometer gemessen werden Augeninnendruck und Tonometrie.“"
                            },
                            {
                                "example_id": "ea6f986d-d228-4e40-8773-09eeb1ff9c79",
                                "sense_id": "b82ae3f7-f35b-382a-9aa3-3fdaa0fa5d39",
                                "text": "„Der Durchbruch der instrumentellen Impressionstonometrie gelingt 1905 mit dem Tonometer nach Schiøtz [59].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c023c648-b929-3458-bb83-123f3594ca48",
                        "entry_id": "6e32e82c-721c-35ea-96f8-c4183b51b1eb",
                        "glosses": [
                            "Gerät zur Messung des Blutdrucks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "244433d0-e809-4305-8cc6-c989bb2bbe8a",
                                "sense_id": "c023c648-b929-3458-bb83-123f3594ca48",
                                "text": "„Sie ist zurückzuführen auf geringgradige Änderungen der O2-Sättigung während der Überführung der Blutproben aus dem Tonometer in die Meßeinheit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
