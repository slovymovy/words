{
    "word": "conjuncture",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                "word": "conjuncture",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "90c27c0c-d10c-4ad2-8b33-070daba6a993",
                        "entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "conjunctures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad78e4c3-9292-355b-bddb-8a08513302a2",
                        "entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "glosses": [
                            "A combination of events or circumstances; a conjunction; a union."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21c15f1-d34f-4b45-8813-16be7910e079",
                                "sense_id": "ad78e4c3-9292-355b-bddb-8a08513302a2",
                                "text": "To be sitting, at so pleasant a conjuncture of one's courses, in oneself, by oneself, that I think it will freely be admitted is a way no worse than another, and better than some, of whiling away an instant of leisure."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bdc4733-e58d-3ae6-9957-80a80c0aeb86",
                        "entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "glosses": [
                            "A set of circumstances causing a crisis; a juncture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7def0c6a-1a3a-458a-b3fa-633b56918b51",
                                "sense_id": "7bdc4733-e58d-3ae6-9957-80a80c0aeb86",
                                "text": "[I]n his later years, he [James II of England] repeatedly, at conjunctures such as have often inspired timorous and delicate women with heroic courage, showed a pusillanimous anxiety about his personal safety."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2251a022-7f97-4109-95f5-1fb2b2a355df",
                        "source_entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "source_sense_description": "combination of events or circumstances",
                        "target_lang_word": "shoda okolností",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1d80b385-ab1b-4cf5-a01e-efa15ff3d8d6",
                        "source_entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "source_sense_description": "combination of events or circumstances",
                        "target_lang_word": "conjunctuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjunctuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6669258b-c544-3833-9cca-f0627329c426",
                                        "entry_id": "70374407-2c17-357f-a956-ee001cec3f3a",
                                        "glosses": [
                                            "de verandering van het groeipercentage van de economie of de productie op de korte termijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac017f3e-997f-429b-ab21-221d0c6ed2c7",
                                                "sense_id": "6669258b-c544-3833-9cca-f0627329c426",
                                                "text": "Aandacht voor de conjunctuur in de media en de academische wereld schommelt net zo sterk als de conjunctuur zelf."
                                            },
                                            {
                                                "example_id": "2cb08a1d-a994-4f8d-a052-232a9a4ecf57",
                                                "sense_id": "6669258b-c544-3833-9cca-f0627329c426",
                                                "text": "De vastgoedmaatschappij was dus in de huidige conjunctuur een enorm verborgen kapitaal, een vergeten en slapende goudmijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86276303-deb4-4c54-a917-a5c96026ed04",
                        "source_entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "source_sense_description": "combination of events or circumstances",
                        "target_lang_word": "conjoncture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjoncture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                                        "glosses": [
                                            "État, disposition, résultat d’une rencontre de circonstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6939a1-193e-4e73-a1d8-f012590a700c",
                                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                                "text": "Se trouver dans des conjonctures difficiles."
                                            },
                                            {
                                                "example_id": "fb3fc749-14d6-4c82-96be-db8b0d2908a2",
                                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                                "text": "Dans les différentes conjonctures de la vie."
                                            },
                                            {
                                                "example_id": "920a1da4-bde5-4a88-b686-0b12cde05e44",
                                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                                "text": "Heureuse, triste, fatale conjoncture."
                                            },
                                            {
                                                "example_id": "14fc3398-3644-4e72-8a81-c382c9f28e5b",
                                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                                "text": "La conjoncture est favorable."
                                            },
                                            {
                                                "example_id": "40ba4b2e-8470-4306-9bc9-60aa7af0194a",
                                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                                "text": "Cela est arrivé dans une fâcheuse conjoncture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                                        "glosses": [
                                            "Situation économique à un certain moment, et son évolution à court terme, de quelques mois à un an."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb5a470-f3c2-4d0c-8f77-e8f00275940d",
                                                "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                                "text": "Le ministre du Travail, Olivier Dussopt, a annoncé sur France 3 que la concertation sur la réforme de l’assurance-chômage, qui doit faire varier les indemnités versées en fonction de la conjoncture, sera ouverte « dans une dizaine de jours »."
                                            },
                                            {
                                                "example_id": "9577f387-005e-4407-bbf2-0c6407a207d7",
                                                "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                                "text": "[Le] ralliement [au Général De Gaulle en 1958] était donné du bout des lèvres et en fonction d'une conjoncture passagère."
                                            },
                                            {
                                                "example_id": "969170e9-89e4-4c80-afbd-502447304857",
                                                "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                                "text": "De toute manière, « les marchés font leurs propres évaluations et peuvent décider d’eux-mêmes d’augmenter ou non les taux. Ce sont eux qui ont la décision finale », rappelle Christophe Blot, économiste à l’Observatoire français des conjonctures économiques et spécialiste des crises financières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bdc55f5-2dee-354f-b70d-1badeec34eda",
                                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                                        "glosses": [
                                            "Bière de 48 ou 43 cl."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf1a6b3-1394-421a-9156-d723a8b6d6b0",
                                                "sense_id": "8bdc55f5-2dee-354f-b70d-1badeec34eda",
                                                "text": "Pour éviter une hausse des prix, liée aux difficultés économiques, les brasseurs ont maintenu, au même niveau, les prix des bières, en réduisant la contenance des bouteilles. Le consommateur ivoirien, pas dupe, commande désormais une « conjoncture » !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9972246-2d9e-4e19-86d5-983c6e2ac7e3",
                        "source_entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
                        "source_sense_description": "combination of events or circumstances",
                        "target_lang_word": "Konjunktur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konjunktur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd929a92-4aac-36b1-a0e9-a7dae99f1139",
                                        "entry_id": "01f6ed5b-77d9-32ba-9867-6a65323c4c35",
                                        "glosses": [
                                            "wirtschaftliche Gesamtlage, die auch Tendenzen für die Zukunft einschließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a65be64e-481f-4e01-a64b-bd680d7dace4",
                                                "sense_id": "fd929a92-4aac-36b1-a0e9-a7dae99f1139",
                                                "text": "Da jede Maßnahme der Konjunkturpolitik das Wachstum beeinflußt und jede Maßnahme der Wachstumspolitik Rückwirkungen auf die Konjunktur hat, muß notwendigerweise eine Koordinierung der Maßnahmen vorgenommen werden."
                                            },
                                            {
                                                "example_id": "f7ce0ec2-af13-4489-babf-aed4b1d93d97",
                                                "sense_id": "fd929a92-4aac-36b1-a0e9-a7dae99f1139",
                                                "text": "Die gute Konjunktur sorgt für mehr Arbeitsplätze."
                                            },
                                            {
                                                "example_id": "3f2c4d82-4e67-4200-b6d9-51485299fad5",
                                                "sense_id": "fd929a92-4aac-36b1-a0e9-a7dae99f1139",
                                                "text": "„1948 war eine Währungsreform fällig, und die Konjunktur stockte heftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3ed6dae-a672-3725-86ec-0a25223c001a",
                                        "entry_id": "01f6ed5b-77d9-32ba-9867-6a65323c4c35",
                                        "glosses": [
                                            "gute Geschäftslage für einzelne Bereiche oder auch die Gesamtwirtschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7189726-4a67-4a3a-abd6-d879f4ddce55",
                                                "sense_id": "e3ed6dae-a672-3725-86ec-0a25223c001a",
                                                "text": "Die Anbauflächen von Koka und Marihuana stagnierten während des vergangenen Jahres – illegale Goldminen dagegen haben Konjunktur."
                                            },
                                            {
                                                "example_id": "067fad37-1eea-466e-84d8-3ba6d08df3de",
                                                "sense_id": "e3ed6dae-a672-3725-86ec-0a25223c001a",
                                                "text": "Eichels Haushaltsentwurf fürs kommende Jahr verdorrt bereits in der andauernden Trockenheit: ohne Konjunktur kein Steuerzuwachs, sondern nur steigende Sozialkosten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d246412c-21db-41ea-87ef-454af07f091f",
                        "source_entry_id": "11d4436c-2593-3373-a3db-e225549df2cb",
