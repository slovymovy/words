                        "target_lang_word": "Pfandbrief",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfandbrief",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb7d22b-b5fd-3abc-832b-9c78573daad0",
                                        "entry_id": "9acca72b-3720-3d6a-89b2-52a0d35a1155",
                                        "glosses": [
                                            "von einer Pfandbriefbank ausgegebene verzinsliche Schuldverschreibung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad16c26c-892b-4ca3-a26d-fee28fe8d5d6",
                                                "sense_id": "6cb7d22b-b5fd-3abc-832b-9c78573daad0",
                                                "text": "Bei Pfandbriefen kann der Investor auch auf die sogenannte Deckungsmasse zurückgreifen."
                                            },
                                            {
                                                "example_id": "5bb8e57b-8184-4997-84f9-173209d6d75a",
                                                "sense_id": "6cb7d22b-b5fd-3abc-832b-9c78573daad0",
                                                "text": "„Die restlichen siebzig Prozent allerdings – das bemerkten die Nazis erst viel später – bezahlte der Strohmann mit den deutschen Pfandbriefen, die auf diese Weise die Heimat wiedersahen, in der sie ihren normalen Wert besaßen, also den fünffachen dessen, zu dem »Marlock & Lieven« sie in Zürich erworben hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9768945-5f7c-346d-9ea6-2c64c7cb158c",
                                        "entry_id": "9acca72b-3720-3d6a-89b2-52a0d35a1155",
                                        "glosses": [
                                            "verzinsliche Schuldverschreibung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b53e9164-d6b5-4a9d-945f-26e5206515c7",
                        "source_entry_id": "64383074-069d-3742-bac2-c99481d3f5fe",
                        "source_sense_id": "9a669256-91d9-3f43-b482-f69b1c0f82c3",
                        "source_sense_description": "Schuldverschreibung, Pfandbrief, Anleihe",
                        "target_lang_word": "Anleihe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anleihe",
