                                        "glosses": [
                                            "A simple vessel used to produce light continuously for a period of time from a liquid fuel source, especially lamp oil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b095c9e4-2f5e-47b7-b14b-85d1c8e4d77c",
                                                "sense_id": "533d16c3-8774-3600-aadf-b1287ee78243",
                                                "text": "Meronym: lampwick"
                                            },
