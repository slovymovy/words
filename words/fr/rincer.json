                        {
                            "text": "Le bandit a menacé de <w>rincer</w> quiconque oserait révéler son identité.",
                            "target_lang_translations": {
                                "en": "The bandit threatened to <w>thrash</w> anyone who dared to reveal his identity.",
                                "ru": "Бандит пригрозил <w>отколотить</w> любого, кто осмелится раскрыть его личность.",
                                "de": "Der Bandit drohte, jeden zu <w>verprügeln</w>, der es wagen würde, seine Identität preiszugeben.",
                                "es": "El bandido amenazó con <w>apalear</w> a cualquiera que se atreviera a revelar su identidad.",
                                "zh": "这个歹徒威胁说，谁敢泄露他的身份，就<w>揍</w>谁。"
                            }
                        },
                        {
                            "text": "Les brutes du quartier voulaient le <w>rincer</w> pour lui donner une bonne leçon.",
                            "target_lang_translations": {
                                "en": "The neighbourhood thugs wanted to <w>thrash</w> him to teach him a good lesson.",
                                "ru": "Местные хулиганы хотели его <w>отколотить</w>, чтобы преподать ему хороший урок.",
                                "de": "Die Schläger aus dem Viertel wollten ihn <w>verprügeln</w>, um ihm eine gute Lektion zu erteilen.",
                                "es": "Los matones del barrio querían <w>zurrar</w> a él para darle una buena lección.",
                                "zh": "街区里的那些恶棍想<w>揍</w>他一顿，给他一个教训。"
                            }
