                                "target_senses": [
                                    {
                                        "sense_id": "d11cc1b7-fb8b-3b48-9c28-369c37234b92",
                                        "entry_id": "67d0aa03-ae2f-3ae7-9223-df58b40cecc8",
                                        "glosses": [
                                            "Personne qui manipule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33ecd72-98ad-4b45-aa04-a87c82d3b01a",
                                                "sense_id": "d11cc1b7-fb8b-3b48-9c28-369c37234b92",
                                                "text": "Par bonheur, au bout d'un certain temps, il trouva une place de manipulateur au laboratoire d’Oustimovitch, professeur de physiologie à l'institut vétérinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b21b2d6d-fa03-33cc-b48c-117de8f548c7",
                                        "entry_id": "67d0aa03-ae2f-3ae7-9223-df58b40cecc8",
                                        "glosses": [
                                            "Personne qui fait usage de techniques de manipulation mentale ou qui est enclin à en faire usage habituellement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3cdc9cb-1a71-4ba7-9e6b-d5756f2967de",
                                                "sense_id": "b21b2d6d-fa03-33cc-b48c-117de8f548c7",
                                                "text": "Les naïfs ou les manipulateurs demanderont peut-être : et le respect de l’enseignante voilée ? Rappelons une autre évidence : l’école existe pour les enfants, pas pour les profs, libres de s’habiller comme elles le veulent partout ailleurs."
                                            },
                                            {
                                                "example_id": "8cdf397f-71f0-474e-b339-5d3c17c5db04",
                                                "sense_id": "b21b2d6d-fa03-33cc-b48c-117de8f548c7",
                                                "text": "Avec le personnage de Justin (Bart Edwards), qui tente de reconquérir Tiffany (Jessica Brown Findlay), la série britannique détricote les fils de cette stratégie bien connue des manipulateurs."
                                            }
                                        ]
                                    }
                                ]
