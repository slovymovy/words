                ],
                "senses": [
                    {
                        "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                        "entry_id": "11cfa709-654d-3659-9bd7-e7e4e0a03b0e",
                        "glosses": [
                            "Handlung oder Einstellung, jemanden oder sich selbst viel Gutes zukommen zu lassen, auf bestimmte Art und Weise zufriedenzustellen, oft so, dass dies negative Auswirkungen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d736332a-bfe3-49ec-9e47-fad6e0052216",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„Jede Art der Verwöhnung hat eine Gewohnheit zu folge. Ein gesundes Maß an Strenge hat noch niemanden geschadet.“"
                            },
                            {
                                "example_id": "402c0226-3e23-491e-83aa-af66e184b546",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„Eine rigide, enge symbiotische Verwöhnung der Kinder schwächt diese in ihrem Streben nach Autonomie.“"
                            },
                            {
                                "example_id": "38d5a32d-627d-4f02-bd23-ada1494af2c7",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„Jeder Drogenkonsum, auch die Verwöhnung durch Incentives und Prämien, ist nichts anderes als Selbstzerstörung.“"
                            },
                            {
                                "example_id": "c3633bf9-83b9-463d-8ee9-0008d7873a4a",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„Die Verwöhnung mit Zuckerwaren und anderen Leckerbissen ist eine Unsitte, welche nicht nur die Erziehung schädigt, sondern auch durch Herbeiführung von Zahnkrankheiten und Verdauungsstörungen die Gesundheit der Kinder untergräbt […].“"
                            },
                            {
                                "example_id": "0d4f3c39-c98c-49d1-9758-544958332880",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„Wir waren schließlich doch froh, die Gastfreundschaft unseres liebenswürdigen Wirtes nicht länger mehr in Anspruch nehmen zu müssen im Hinblick auf die Zunahme unseres Körpergewichtes und die schädliche Verwöhnung mit allerhand seltenen europäischen Genüssen.“"
                            },
                            {
                                "example_id": "914aa241-35f9-4ce5-a762-424f71d5ac48",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„Im Gegensatz zu dem freilebenden Tiere und auch noch zu dem freilebenden Menschen ist in den Fesseln der Kultur und des sozialen Beisammenlebens entsprechend der Verwöhnung durch Kleidung und Haus die freie Bewegung des Menschen im Sinne eines naturgemäßen Sichauslebens gehindert, vermindert, verkümmert, versteift, mehr und mehr abhanden gekommen.“"
                            },
                            {
                                "example_id": "cf94f3ad-a8a9-4dd0-be46-315b94baf640",
                                "sense_id": "b1e4c9d8-5f43-3e35-8e5c-68042ab4a4b4",
                                "text": "„An einer Stelle seiner Diatribe gegen die Verwöhnung durch zeitgenössische Eltern führt er eine Statistik an, der zufolge das durchschnittliche Taschengeld bei 362 Euro pro Jahr liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
