                        "form": "sie sind melaninarm"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9cb2502-65c4-3675-9b0a-8da61e5010d5",
                        "entry_id": "0239ffb1-e72e-318d-83ee-a476fb73b551",
                        "glosses": [
                            "wenig Melanin enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc710772-84c2-435d-887c-aa15b2c06c33",
                                "sense_id": "f9cb2502-65c4-3675-9b0a-8da61e5010d5",
                                "text": "„Die melaninarm gewordenen Federzellen der Federoberseite liegen somit auf einem dunklen Untergrund und reflektieren so einen erhöhten Anteil blauen Lichtes (ähnlich wie bei einem Spiegel).“"
                            },
                            {
                                "example_id": "537e47ed-d2d0-48de-9afc-6a9346196fff",
                                "sense_id": "f9cb2502-65c4-3675-9b0a-8da61e5010d5",
                                "text": "„Die melaninarme Haut der Lippen erhält ihre natürliche Farbe, das Lippenrot, durch das stark durchblutete, oberflächliche Papillargebiet.“"
                            },
                            {
                                "example_id": "5c7ec178-4c30-4c13-80bd-38073b5729f6",
                                "sense_id": "f9cb2502-65c4-3675-9b0a-8da61e5010d5",
                                "text": "„Doch finden sich geschrumpfte, melaninarme Ganglienzellen bei reichlicher Melaninabwanderung in die gewucherte Glia und die Gefäßlymphscheiden.“"
                            },
                            {
                                "example_id": "a39399c2-8b88-4069-b2e8-d671c247813b",
                                "sense_id": "f9cb2502-65c4-3675-9b0a-8da61e5010d5",
                                "text": "„Die Substantianigra läßt schwerere Entartungen vermissen, doch finden sich auch in ihr zahlreiche geschrumpfte und melaninarme Ganglienzellen bei reichlicherer Melaninabwanderung in die gewucherte Glia - und in die Gefäß- Abb.“"
                            },
                            {
                                "example_id": "29f8c938-ae5b-4ea6-80d0-da3e4dd07b4e",
                                "sense_id": "f9cb2502-65c4-3675-9b0a-8da61e5010d5",
                                "text": "„Typische Melanome werden gut erkannt, untypische, kleine oder gar melaninarme Melanome jedoch nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
