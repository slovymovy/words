                ],
                "senses": [
                    {
                        "sense_id": "aa3a617b-9265-34c4-a268-ea69c976c4df",
                        "entry_id": "f9746002-e79d-315b-b86b-35faae6dc338",
                        "glosses": [
                            "człowiek porywczy, gwałtowny, wybuchowy"
                        ],
                        "tags": [],
