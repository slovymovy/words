                "senses": [
                    {
                        "sense_id": "bee1b359-23b1-3f38-a15b-f1c4afaffbe2",
                        "entry_id": "beff8e3a-56ae-34af-a7e0-8a6d16a24e15",
                        "glosses": [
                            "feest waarbij men viert dat men niet meer overheerst wordt door een vreemde mogendheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4064d44-147e-433a-8f44-2bd9f58f5e4d",
                                "sense_id": "bee1b359-23b1-3f38-a15b-f1c4afaffbe2",
                                "text": "De tien mensen die zijn opgepakt voor de dodelijke schietpartij in Dordrecht zitten nog altijd vast. Een 38-jarige Dordtenaar werd gisteren tijdens een bevrijdingsfeest op straat doodgeschoten. Volgens de politie was een ruzie de aanleiding voor de schietpartij."
                            },
                            {
                                "example_id": "48fbdf35-c355-4968-b571-ba5732b69fe4",
                                "sense_id": "bee1b359-23b1-3f38-a15b-f1c4afaffbe2",
                                "text": "Ook op andere plaatsen gaat het Bevrijdingsfeest gewoon door, zoals in Zwolle en Den Bosch. De organisatoren houden de weerberichten in de gaten."
                            },
                            {
                                "example_id": "b71ba695-3a2c-405c-a3a3-168ca8c592fc",
                                "sense_id": "bee1b359-23b1-3f38-a15b-f1c4afaffbe2",
                                "text": "Als beulen sloegen ze uit Groningen op de vlucht voor de bevrijders. Op zondag 15 april 1945 staken Duitse SD'ers over naar Schiermonnikoog, daags na de definitieve aanval van de Canadese troepen. Op het Waddeneiland hebben ze zich nog zes weken verscholen gehouden. Het is een van de verborgen bevrijdingsverhalen bij het komende bevrijdingsfeest van Groningen."
                            }
                        ]
                    }
