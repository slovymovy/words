                                            {
                                                "example_id": "30e89381-cfc5-43a8-b74e-94d9e9a019da",
                                                "sense_id": "7985e5eb-91d3-30c8-96c6-779a8d6261f2",
                                                "text": "Ce Carlo est connu, vous devez le savoir, un maffioso de haute voltige, un tueur, pas un simple exécutant, non, « persona gratta » dans la maffia."
                                            },
                                            {
                                                "example_id": "12cab145-e7ca-4b69-805e-d1833a3514ea",
                                                "sense_id": "7985e5eb-91d3-30c8-96c6-779a8d6261f2",
                                                "text": "Il approuve hautement le comité de vigilance de la Nouvelle-Orléans qui en 1890 pendit, « à la grande satisfaction de tous les honnêtes gens », des maffiosi acquittés par le jury."
                                            }
                                        ]
                                    }
                                ]
                            }
