        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                "word": "hutong",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "779709cc-bcf3-46fc-a8ad-fa24bd20ae8c",
                        "entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                        "tags": [
                            "plural"
                        ],
                        "form": "hutongs"
                    },
                    {
                        "form_id": "25edc7e0-4630-4c55-b6ac-d7f05b3a5bd6",
                        "entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                        "tags": [
                            "plural"
                        ],
                        "form": "hutong"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                        "entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                        "glosses": [
                            "A narrow alley or street in a traditional residential district of a city in China, especially Beijing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4450c4d-f65a-4f27-91e6-5a513058f33c",
                                "sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                                "text": "The fish-bone-like transportation network is also present, especially in large neighbourhoods, where a series of major hutong (usually running east-west) are either joined by smaller transverse hutong or lead to even smaller dead-end hutong that occasionally run between housing plots."
                            },
                            {
                                "example_id": "ce7e3448-8b57-47ab-9e58-a9436b4a3343",
                                "sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                                "text": "'I spent my childhood in those old hutong courtyards. Relationships were warmer then.' His mouth puckered, as if hunting a lost taste."
                            },
                            {
                                "example_id": "57670ffc-aa1a-4e63-a00e-bca3f9ab7255",
                                "sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                                "text": "In Beijing, near the Forbidden City, a winding maze of hutongs, or narrow alleyways, is home to one of the world’s most exotic markets."
                            },
                            {
                                "example_id": "6f4b367b-18c5-4a10-a761-e65c3599562b",
                                "sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                                "text": "Today, just 1,300 hutong remain, and many more neighborhoods, like the colorful Qianmen district just south of Tiananmen Square, are scheduled for renewal."
                            },
                            {
                                "example_id": "7e61838c-8bf8-40a4-ba1d-00fdb0ac35b3",
                                "sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                                "text": "He led me along a dog-legging route through the fifteenth-century alleyways that were the lacework holding old Beijing together. Hutongs, as they were called, defined China's old capital, their grey stone walls pierced at intervals by weathered wooden doors that opened onto four-sided courtyard houses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1d8cdbd-12db-4e4b-b96e-4d547f51d999",
                        "source_entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                        "source_sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                        "source_sense_description": "narrow alley or street in a traditional residential district of a Chinese city",
                        "target_lang_word": "chu-tchung",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5248f672-9bd7-48ae-bf35-c16069aa78c7",
                        "source_entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                        "source_sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                        "source_sense_description": "narrow alley or street in a traditional residential district of a Chinese city",
                        "target_lang_word": "hutong",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hutong",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                        "entry_id": "2672e236-838b-3725-88ec-8af7d77b3a7d",
                                        "glosses": [
                                            "Série de petite venelles en Chine, en particulier dans le vieux Pékin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d85f62-487b-490d-9087-5113a4b62813",
                                                "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                                "text": "Les hutong sont le cœur de la capitale chinoise."
                                            },
                                            {
                                                "example_id": "c927c898-15bb-406e-a58e-2d5938b8f13e",
                                                "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                                "text": "Il faut se promener dans les hutongs autour des lacs Houhai et Qianhai."
                                            },
                                            {
                                                "example_id": "43104f08-2739-4ce2-9aa2-0cd1f53bc553",
                                                "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                                "text": "À l’aube, un jour, vers cinq heures du matin, je marche avec ma traductrice, une jeune femme sans grâce, dans un hutong, une de ces rues de Pékin grossièrement pavées où s’alignent de chaque côté des maisons basses, sans étage, avec une cour intérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
