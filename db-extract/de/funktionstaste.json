                        "entry_id": "4a7c1002-1640-34d8-b62d-5296104ebed0",
                        "glosses": [
                            "eine der mit F1 bis F12 bezeichneten Tasten auf der Tastatur eines PCs oder eines Laptops, die mit speziellen Funktionen belegt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e86a4b49-eab5-4af0-b880-93f9a7e3cb14",
                                "sense_id": "41c1b52d-ff28-3d09-b640-68cb68682410",
                                "text": "In vielen Softwaresystemen ist die Funktionstaste F1 mit einer Hilfefunktion belegt."
                            },
                            {
                                "example_id": "e5ef8a99-ab8c-4ae2-ba36-a65140327301",
                                "sense_id": "41c1b52d-ff28-3d09-b640-68cb68682410",
                                "text": "„Etwas Gossip für den Stammtisch: der F5 ist nicht nach einer Funktionstaste auf der Computer-Tastatur, sondern nach der Klassifikation für einen sehr, sehr intensiven Tornado benannt.“"
                            },
                            {
                                "example_id": "c0b2bdd3-7c5e-4c57-8679-693f20362318",
                                "sense_id": "41c1b52d-ff28-3d09-b640-68cb68682410",
                                "text": "„F6: Ins Eingabefeld springen: Kaum Beachtung dürfte die Funktionstaste F6 finden, die jedoch vieles beschleunigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
