            "senses": [
                {
                    "sense_id": "8ca76f34-aae6-3f55-b6f6-213feb0496b1",
                    "sense_definition": "W każdym miejscu; w całej dostępnej przestrzeni.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W twoim pokoju <w>wszędzie</w> leżą śmieci i ubrania.",
                            "target_lang_translations": {
                                "ru": "В твоей комнате <w>везде</w> валяются мусор и одежда.",
                                "en": "There are trash and clothes lying <w>everywhere</w> in your room."
                            }
                        },
                        {
                            "text": "Szukałem moich okularów <w>wszędzie</w>, ale ich nie znalazłem.",
                            "target_lang_translations": {
                                "ru": "Я искал свои очки <w>везде</w>, но не нашёл их.",
                                "en": "I looked <w>everywhere</w> for my glasses, but I didn't find them."
                            }
                        }
                    ],
                    "synonyms": [
                        "wzdłuż i wszerz",
                        "w każdym miejscu"
                    ],
                    "antonyms": [
                        "nigdzie"
                    ],
                    "common_phrases": [
                        "szukać wszędzie",
                        "być wszędzie",
                        "wszędzie pełno"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любом месте; во всём доступном пространстве.",
                        "en": "In every place; throughout the entire available space."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "везде",
                                "target_lang_sense_clarification": "в любом месте"
                            },
                            {
                                "target_lang_word": "всюду",
                                "target_lang_sense_clarification": "во всех местах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "everywhere",
                                "target_lang_sense_clarification": "in all places"
                            },
                            {
                                "target_lang_word": "all over",
                                "target_lang_sense_clarification": "covering the whole area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a2b1913-1065-334c-81e5-126256cac947",
                    "sense_definition": "Do każdego miejsca; w dowolnym kierunku.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Obiecuję, że pójdę z tobą <w>wszędzie</w>.",
                            "target_lang_translations": {
                                "ru": "Я обещаю, что пойду с тобой <w>куда угодно</w>.",
                                "en": "I promise I will go <w>anywhere</w> with you."
                            }
                        },
                        {
                            "text": "W te wakacje chcemy pojechać <w>wszędzie</w>, gdzie jest ciepło.",
                            "target_lang_translations": {
                                "ru": "В эти каникулы мы хотим поехать <w>куда угодно</w>, где тепло.",
                                "en": "This vacation we want to go <w>everywhere</w> that is warm."
                            }
                        }
                    ],
                    "antonyms": [
                        "nigdzie"
                    ],
                    "common_phrases": [
                        "pójść wszędzie",
                        "pojechać wszędzie"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любое место; в любом направлении.",
                        "en": "To every place; in any direction."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куда угодно",
                                "target_lang_sense_clarification": "в любое место"
                            },
                            {
                                "target_lang_word": "повсюду",
                                "target_lang_sense_clarification": "во все места"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "everywhere",
                                "target_lang_sense_clarification": "to all locations"
                            },
                            {
                                "target_lang_word": "anywhere",
                                "target_lang_sense_clarification": "to any place at all"
                            }
                        ]
                    }
                }
            ]
        }
    ]
