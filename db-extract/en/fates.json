                        "examples": [
                            {
                                "example_id": "50b14467-c6f4-40d4-83ab-9ada6712a4c0",
                                "sense_id": "bc6b1d6b-a5b2-3fd3-a866-32ec788af5ab",
                                "text": "\"Oh, no!\" said he, with a most imperturbable air, \"I always make allowance for feminine weakness; I do not expect your mind to follow mine!\"\n\"Now, the Fates forbid that it should!\" thought Henrietta."
                            },
                            {
                                "example_id": "0646a023-e1dc-4a40-9e58-e11c890aa2d8",
                                "sense_id": "bc6b1d6b-a5b2-3fd3-a866-32ec788af5ab",
                                "text": "1944, Ralph Blane, “Have Yourself a Merry Little Christmas”, Meet Me in St. Louis, Metro-Goldwyn-Mayer\nThrough the years we all will be together / If the Fates allow"
                            }
                        ]
