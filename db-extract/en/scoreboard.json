    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "49e61988-5ada-360a-b1ee-7745ef054a8b",
                "word": "scoreboard",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8fb3a61a-614f-3ac5-8e19-ef07281a28d0",
                        "entry_id": "49e61988-5ada-360a-b1ee-7745ef054a8b",
                        "glosses": [
                            "A taunt which reminds someone that they are losing or have lost."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7209929a-6a4a-4d4a-a474-abf82e2a7d36",
                                "sense_id": "8fb3a61a-614f-3ac5-8e19-ef07281a28d0",
                                "text": "Glenn Quagmire: And there's the Vietnam War memorial.\nPeter Griffin: Hey, check out that Vietnamese guy giving the business to those Vietnam vets.\nVietnamese Civilian: [to a pair of Vietnam veterans] Scoreboard! Scoreboard! Aw, what happened to your friend? Hey, I know that guy. I kill him. He cry like a bitch! Vietnam! Undefeated!"
                            },
                            {
                                "example_id": "4114c2ce-4a96-4858-8bbb-a98feb3d7625",
                                "sense_id": "8fb3a61a-614f-3ac5-8e19-ef07281a28d0",
                                "text": ".\"Scoreboard, baby! Scoreboard!\" Bella taunted, pocketing her winnings as a red X went over K. C. Mack's mug shot."
                            },
                            {
                                "example_id": "eb516f2c-18f3-4cf0-8b74-f32674b614ff",
                                "sense_id": "8fb3a61a-614f-3ac5-8e19-ef07281a28d0",
                                "text": "When Neuheisel learned of Bellotti's comments, he offered a simple rebuttal: \"Scoreboard, baby.\" Two words to end all arguments, two words to silence any complaint. Scoreboard, baby."
                            },
                            {
                                "example_id": "08d47e90-f996-4322-9e49-04b9dab2a695",
                                "sense_id": "8fb3a61a-614f-3ac5-8e19-ef07281a28d0",
                                "text": "For the rest of the game, all I would say to him when he taunted me was \"scoreboard.\" Every single word that came out of his mouth was met with my response of \"scoreboard.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "bc0691eb-28f7-3739-a60f-fae96441a1a3",
