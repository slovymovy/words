                    {
                        "translation_id": "f5013b63-be49-4d51-ac80-dd462ba68c23",
                        "source_entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                        "source_sense_description": "dried sap of the myrrha tree",
                        "target_lang_word": "mirre",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirre",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "843e9186-1f52-3dd4-98a2-779da6a5a298",
                                        "entry_id": "33861218-9ac0-3ee0-b14f-bdb146db4a6d",
                                        "glosses": [
                                            "welriekende maar bitter smakende stof gemaakt van gom en hars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b230229-bc8e-46a6-bfbe-e060a3e80a35",
                                                "sense_id": "843e9186-1f52-3dd4-98a2-779da6a5a298",
                                                "text": "De geur van wierook en mirre. Je ruikt het maar zelden, behalve als ze het op begrafenissen in de kerk met zo’n vaatje rondstrooien. Het is bijna fout om er tijdens zulke trieste gelegenheden van te genieten, maar de geur is fantastisch."
                                            },
                                            {
                                                "example_id": "09607a2c-fa13-4117-9424-59811bf4b16a",
                                                "sense_id": "843e9186-1f52-3dd4-98a2-779da6a5a298",
                                                "text": "Erica Terpstra gaat in haar positieve reisprogramma (vanaf vanavond in de herhaling op vrijdag) voor omroep MAX op zoek naar geluk en spiritualiteit. In deze aflevering reist ze naar Oman, „het land van 1001 nacht”. Terpstra bezoekt markten waar kamelen, wierook en mirre worden verhandeld die rechtstreeks uit de Middeleeuwen lijken te stammen. Ze spreekt een Arabische prinses en reist dwars door de woestijn, langs oases en bedoeïenenkampen. Ze geniet met volle teugen: „Zit ik hier nu op het mooiste plekje van de wereld?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faba7a79-d1b2-376f-abd0-9bdd3858c5f7",
                                        "entry_id": "33861218-9ac0-3ee0-b14f-bdb146db4a6d",
                                        "glosses": [
                                            "Commiphora myrrha plant waar men mirre uit kan winnen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "306a9aa4-4dd7-410b-8077-d69680985801",
                        "source_entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                        "source_sense_description": "dried sap of the myrrha tree",
                        "target_lang_word": "myrrhe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myrrhe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                        "entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                                        "glosses": [
                                            "Gomme-résine aromatique qui vient de l’Arabie, produite par une burséracée du genre Commiphora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41f48a30-38e9-4456-a2de-78baff899e74",
                                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                                "text": "Mais je sens une odeur de myrrhe qui est à donner la nausée."
                                            },
                                            {
                                                "example_id": "00cb161d-798f-49f5-81c0-4c34b4573fb9",
                                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                                "text": "J’ai vu Constantinople étant petite fille,\nJe m’en souviens un peu,\nJe me souviens d’un vase où la myrrhe grésille\nEt d’un minaret bleu."
                                            },
                                            {
                                                "example_id": "680e3413-9591-4347-a1f9-ef5aee534fc5",
                                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                                "text": "Et je me soûlerai de nard, d'encens, de myrrhe..."
                                            },
                                            {
                                                "example_id": "48f62b00-df51-4709-93d3-44f2aa155f18",
                                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                                "text": "Adonis par l’escorce d'un arbre de myrrhe ?"
                                            },
                                            {
                                                "example_id": "949e4849-9bf5-4157-89af-86ad3f6d28c4",
                                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                                "text": "On m’ouvrit la pierre qui fermait son tombeau et je pénétrai dans la cavité creusée dans la roche.\nLe parfum ravageur de la myrrhe empoissait l’air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75ea8968-6a93-4e71-a8dc-7b30ef2ca468",
                        "source_entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                        "source_sense_description": "dried sap of the myrrha tree",
