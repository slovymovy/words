                "senses": [
                    {
                        "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                        "entry_id": "54d02f4d-2367-309b-8ce6-e7a78c86c81a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16cfa03e-15f0-44ac-bed8-2ceb1905a2df",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Frau Visser ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d4c3826b-dc98-42b0-b296-8deffb941884",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Herr Visser wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aebe8bd2-9bf3-4cfc-97b1-d1d0b3e6d237",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Die Vissers fahren heute nach Essen."
                            },
                            {
                                "example_id": "02973eb2-fcc3-439e-a8d0-6456e9496130",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Der Visser trägt nie die Schals, die die Visser ihm strickt."
                            },
                            {
                                "example_id": "65c77b45-464e-439f-80a6-0631c4ca5f2a",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Visser kommt, geht der Herr Visser.“"
                            },
                            {
                                "example_id": "bfc0cb20-4c9a-41ac-88fb-532b40073d68",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Visser kommt und geht."
                            },
                            {
                                "example_id": "d65e071a-2f04-42bc-ae31-92563ac8ff89",
                                "sense_id": "6449ed2c-0c23-3e8e-8c9f-327f9657f310",
                                "text": "Vissers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
