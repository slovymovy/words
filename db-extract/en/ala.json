                "translations": [
                    {
                        "translation_id": "99d76826-4955-44a9-b08e-a5a027ab5891",
                        "source_entry_id": "e890f754-8117-38ff-9e59-c688b4422f15",
                        "source_sense_description": "side petal of certain flowers",
                        "target_lang_word": "весло́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "весло́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "83f4e61c-8e56-380c-be93-614c8bdc001f",
                                        "entry_id": "c73fa249-7c96-37d0-bc46-cc9d3302ad53",
                                        "glosses": [
                                            "приспособление для гребли на плавучих средствах, шест, заканчивающийся плоской лопастью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a731630a-60c3-48ea-8444-ad718af8e540",
                                                "sense_id": "83f4e61c-8e56-380c-be93-614c8bdc001f",
                                                "text": "Широкое весло"
                                            },
                                            {
                                                "example_id": "4ed6f66d-ffa0-41fd-b2d0-034cd2d64e35",
                                                "sense_id": "83f4e61c-8e56-380c-be93-614c8bdc001f",
                                                "text": "Байдарочное весло"
                                            },
                                            {
                                                "example_id": "bdf29220-0278-4c0f-a204-e5eff8314645",
                                                "sense_id": "83f4e61c-8e56-380c-be93-614c8bdc001f",
                                                "text": "В несколько взмахов индеец доплыл до лодки, выловил плавающее весло и влез в лодку."
                                            },
                                            {
                                                "example_id": "3a58ef84-634b-4754-98f1-7085efa8d1a0",
                                                "sense_id": "83f4e61c-8e56-380c-be93-614c8bdc001f",
                                                "text": "Он вынул свой нож и взял его в зубы, а затем, схватив весло, ткнул его со всего размаха лопастью в полураскрытую пасть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "165f741f-7300-3db3-ac2d-02540bf5ebec",
                                        "entry_id": "c73fa249-7c96-37d0-bc46-cc9d3302ad53",
                                        "glosses": [
                                            "ботан., мн. ч. то же, что крыло; один из лепестков в венчике мотылькового типа"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43709437-9f24-3faa-98d0-c2551f61738c",
                                        "entry_id": "c73fa249-7c96-37d0-bc46-cc9d3302ad53",
                                        "glosses": [
                                            "воен. жарг. длинноствольное ручное огнестрельное оружие с прикладом"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa08b4cb-0723-393f-9360-333e26a99c16",
                                        "entry_id": "c73fa249-7c96-37d0-bc46-cc9d3302ad53",
                                        "glosses": [
                                            "муз. жарг. то же, что гитара"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c814582-5fb0-4bd6-8c9f-c9510a56d751",
                        "source_entry_id": "e890f754-8117-38ff-9e59-c688b4422f15",
                        "source_sense_description": "side petal of certain flowers",
                        "target_lang_word": "крыло́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крыло́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9cea92fb-784c-3319-b758-5acd597b6061",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "анат. парный о́рган у птиц, насекомых и ряда других животных, обычно используемый для полёта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115c632f-3ec3-4b1c-9cca-4a636bed0a3c",
                                                "sense_id": "9cea92fb-784c-3319-b758-5acd597b6061",
                                                "text": "Махать крыльями."
                                            },
                                            {
                                                "example_id": "ce5c48f1-728a-4b1f-9108-61b7f89c322f",
                                                "sense_id": "9cea92fb-784c-3319-b758-5acd597b6061",
                                                "text": "Взмахи крыльев."
                                            },
                                            {
                                                "example_id": "ce5418ab-a5bb-45a7-8eac-8067892fedd5",
                                                "sense_id": "9cea92fb-784c-3319-b758-5acd597b6061",
                                                "text": "Голубь сломал крыло."
                                            },
                                            {
                                                "example_id": "97b97894-79e8-448c-95bb-467e4a4c2d99",
                                                "sense_id": "9cea92fb-784c-3319-b758-5acd597b6061",
                                                "text": "Монах ещё более внимательно пригляделся и увидел, как человек ловко схватил рыжую курицу за крыло и свернул ей одним движением шею."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f1079f9-ec20-34b9-8148-858cc480f21b",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "техн. авиац. аэродинамическая или гидродинамическая поверхность для создания подъёмной силы, несущая плоскость летательного аппарата или судна на подводных крыльях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b775a0-971d-46cf-a6d0-239e99ae4c08",
                                                "sense_id": "8f1079f9-ec20-34b9-8148-858cc480f21b",
                                                "text": "Джеффри Пиватски, бывший пилот, дважды с перерывом в три минуты приметил, как самолет ложился на правое крыло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ac7e31-4dfa-3ab8-b2d4-be91ec0c6fbc",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "техн. лопасть колеса ветряной мельницы или пароходного винта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67bfc943-4bcb-4a9f-a362-fb26b0a1bced",
                                                "sense_id": "a7ac7e31-4dfa-3ab8-b2d4-be91ec0c6fbc",
                                                "text": "Взблескивая гусеницами, надвигался вырвавшийся вперед танк, и крыло мельницы с оторванным полотнищем, опускаясь сверху, отделяло его от остальных."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8115409d-4889-3c00-81c4-afe4896ecf75",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "техн. ограждающее сверху покрытие над колесом автомобиля и ряда других транспортных средств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abbbd900-a821-4c2a-80a6-3905f88b7a27",
                                                "sense_id": "8115409d-4889-3c00-81c4-afe4896ecf75",
                                                "text": "Крыло велосипеда защищает седока от грязи."
                                            },
                                            {
                                                "example_id": "3cec2433-671b-4cf2-a6c4-573b6155a449",
                                                "sense_id": "8115409d-4889-3c00-81c4-afe4896ecf75",
                                                "text": "Оказывается, я этого «Москвича» изуродовала, процарапала крыло, сорвала зеркало."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6452ed9f-b39e-376a-9495-1a6ec5b8ac66",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "архит. боковая пристройка, флигель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83e7e09d-917f-4e28-80fb-06fdae793368",
                                                "sense_id": "6452ed9f-b39e-376a-9495-1a6ec5b8ac66",
                                                "text": "В старом многоподъездном доме одно крыло занимали офисы, и Варвара взобралась на третий этаж."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3a03d4c-e343-3fd6-9735-6f48c3248ca7",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "воен., устар. крайняя справа или слева часть боевого построения; прежнее название фланга (флангов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7027c874-7064-4599-9cfa-14a82b799f0c",
                                                "sense_id": "b3a03d4c-e343-3fd6-9735-6f48c3248ca7",
                                                "text": "Персы стремительно атаковали правое крыло римской армии и обратили его в бегство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1495c6d-496a-3969-a00d-1a9d02e2ef9e",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "перен., полит. сравнительно обособленная часть организации, группировки, партии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd8f6ee-4a66-438f-8290-cca05c86a592",
                                                "sense_id": "f1495c6d-496a-3969-a00d-1a9d02e2ef9e",
                                                "text": "После Февральской революции 1917 г. левое крыло партии эсеров, объединившееся вокруг газеты «Земля и воля», выступило с антивоенными лозунгами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b229cb30-1fff-39b5-8a90-3265f01c2072",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "воен. в ряде западных стран — то же, что эскадрилья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f7336f-eb9e-4845-bdbf-22d4bbde0328",
                                                "sense_id": "b229cb30-1fff-39b5-8a90-3265f01c2072",
                                                "text": "Местом постоянного базирования 509-го крыла стала авиабаза Нью-Хемпшир на Британских островах, а 380-го — авиабаза Платтсбург, штат Нью-Йорк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf49d5a-b7cd-3f1f-9db1-2baae7f03c4a",
                                        "entry_id": "9e96bdb6-6985-35d8-b486-68282a6f7cc4",
                                        "glosses": [
                                            "воен. жарг. беспилотный летательный аппарат самолётного типа, то есть оборудованный неподвижным крылом [2] для создания подъёмной силы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ca0b9d-81c4-411c-bb08-6e89e290d25d",
                                                "sense_id": "fcf49d5a-b7cd-3f1f-9db1-2baae7f03c4a",
                                                "text": "Недавно один из таких атаковал соседние позиции, а наводили его с «крыла» — так на военном сленге называют крупные дроны-разведчики самолётного типа."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "крыло́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ce40bf68-bb5a-3dd5-a5a1-6c531afd0250",
                                        "entry_id": "9c06d58b-105e-3793-bd34-5f85ebd980a6",
                                        "glosses": [
                                            "форма прошедшего времени среднего рода единственного числа изъявительного наклонения глагола крыть"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
