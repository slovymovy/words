{
    "word_family": [
        "instillation",
        "instilment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9bda1a5-1d08-357c-b3ba-d2f9d269055a",
                    "sense_definition": "To gradually cause someone to have a particular attitude, feeling, or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to <w>instill</w> discipline in a child at an early age.",
                            "target_lang_translations": {
                                "tr": "Bir çocuğa erken yaşta disiplin <w>aşılamak</w> önemlidir."
                            }
                        },
                        {
                            "text": "The coach tried to <w>instill</w> confidence into every member of the team.",
                            "target_lang_translations": {
                                "tr": "Antrenör, takımın her bir üyesine öz güven <w>aşılamaya</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "implant",
                        "ingrain",
                        "impress"
                    ],
                    "common_phrases": [
                        "instill confidence",
                        "instill values",
                        "instill discipline"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine belirli bir tutum, duygu veya niteliği zamanla benimsetmek, kazandırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aşılamak",
                                "target_lang_sense_clarification": "düşünce veya duygu kazandırmak"
                            },
                            {
                                "target_lang_word": "telkin etmek",
                                "target_lang_sense_clarification": "bir fikri veya tutumu benimsetmek"
                            },
                            {
                                "target_lang_word": "kazandırmak",
                                "target_lang_sense_clarification": "nitelik veya alışkanlık edindirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7947537d-f93f-31db-a419-d71693fa4238",
                    "sense_definition": "To introduce a liquid into a body cavity drop by drop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse will <w>instill</w> two drops of medication into your eye.",
                            "target_lang_translations": {
                                "tr": "Hemşire gözünüze iki damla ilaç <w>damlatacak</w>."
                            }
                        },
                        {
                            "text": "He learned how to <w>instill</w> the ear drops properly without touching the ear.",
                            "target_lang_translations": {
                                "tr": "Kulağa temas etmeden kulak damlasını düzgünce nasıl <w>damlatacağını</w> öğrendi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "instill drops"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vücuttaki bir boşluğa veya göze, kulağa damla damla sıvı ilaç vermek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "damlatmak",
                                "target_lang_sense_clarification": "damlalıkla ilaç koymak"
                            },
                            {
                                "target_lang_word": "damla damla akıtmak",
                                "target_lang_sense_clarification": "sıvıyı damla halinde vermek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}