                                                "example_id": "65e76f97-1d12-4b5a-a2f9-9064575e7ba7",
                                                "sense_id": "44ee28f7-5c47-33c5-ad1e-0779f9efda8e",
                                                "text": "Es gibt eine Akkumulation von Schadstoffen im Wasser."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9ff717f-5354-348f-81e5-1c88c39ca200",
                                        "entry_id": "dd0fcb9e-7741-3bd0-8272-69cad19624d2",
                                        "glosses": [
                                            "Anhäufung von Produktionsmitteln oder Vermögen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "117de14f-61c0-4d6d-a7c0-e2e8634331d8",
                                                "sense_id": "b9ff717f-5354-348f-81e5-1c88c39ca200",
                                                "text": "Man kann eine Akkumulation von Reichtum in einem kleinen Teil der Bevölkerung feststellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df1617b7-1dd5-35b4-9d54-5dd83cc42072",
                                        "entry_id": "dd0fcb9e-7741-3bd0-8272-69cad19624d2",
                                        "glosses": [
                                            "Ansammlung, Anhäufung von Ablagerungen, Sedimenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc94587-7a2c-4988-8e3a-073d5664ba92",
                                                "sense_id": "df1617b7-1dd5-35b4-9d54-5dd83cc42072",
                                                "text": "„Da die vorliegende Arbeit die Weitergabe und Akkumulation der umweltbelastenden Schwermetalle Cadmium, Blei, Zink und Kupfer behandelt, wurden zunächst Standorte ausgewählt, bei denen erhöhte Konzentrationen der angesprochenen Elemente im Boden vermutet wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bee1cd1f-5e20-3494-95de-d65b5a77506b",
                                        "entry_id": "dd0fcb9e-7741-3bd0-8272-69cad19624d2",
                                        "glosses": [
                                            "Anhäufung von Stilmitteln"
                                        ],
                                        "tags": [
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcf24c2-1bf8-4270-a237-47c716d91ecc",
                                                "sense_id": "bee1cd1f-5e20-3494-95de-d65b5a77506b",
                                                "text": "„Rhetorisch betrachtet war McQueens Zugang also der einer Akkumulation von Stilelementen aller drei Ebenen, wobei er sich auf jeder dieser Ebenen um Elaboration bemühte und das primär prä-ikonische Grundensemble schließlich durch ikonisch-symbolische und narrative Zusätze radikal brach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
