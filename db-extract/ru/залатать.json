                "translations": [
                    {
                        "translation_id": "4f48e921-7943-49dd-a15d-5f311168eeb9",
                        "source_entry_id": "024899f7-9b29-3e11-93cc-5bcf0179ca12",
                        "source_sense_id": "ff64e236-c206-34b9-b462-08142bdc94c9",
                        "target_lang_word": "patch up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patch up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9de3add2-c86a-33cf-b048-d9470fb79fdd",
                                        "entry_id": "d0ed3cd6-75dd-3d1b-bb7b-0c38c6980e2f",
                                        "glosses": [
                                            "To repair by adding a patch."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "827e6f44-430d-4386-920e-935c40a3d6cb",
                                                "sense_id": "9de3add2-c86a-33cf-b048-d9470fb79fdd",
                                                "text": "I needed to patch up my trousers after ripping them on the brambles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0205071e-3b2c-3349-bd44-1a03e1b65bab",
                                        "entry_id": "d0ed3cd6-75dd-3d1b-bb7b-0c38c6980e2f",
                                        "glosses": [
                                            "To mend quickly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e14a6fa1-669e-3e80-9208-c19a5dae89c4",
                                        "entry_id": "d0ed3cd6-75dd-3d1b-bb7b-0c38c6980e2f",
                                        "glosses": [
                                            "To repair relations; to improve relations."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39315ac0-2210-41c1-b6ad-e5301511f08e",
                                                "sense_id": "e14a6fa1-669e-3e80-9208-c19a5dae89c4",
                                                "text": "You need to patch things up with your sister after that horrible argument."
                                            },
                                            {
                                                "example_id": "6552c630-4dd6-4f75-aa14-fbd74c2bddb8",
                                                "sense_id": "e14a6fa1-669e-3e80-9208-c19a5dae89c4",
                                                "text": "But capital was proving difficult to raise; rumours were in the air that the G.W.R. and L.S.W.R. were about to patch up their quarrel, and the people of Southampton, who twelve months earlier had staged a torch-light procession to celebrate the passing of the D.N.S.R. Act, were increasingly loath to part with their cash."
                                            },
                                            {
                                                "example_id": "78cfde67-c5bc-429f-bd5c-44837ae3f756",
                                                "sense_id": "e14a6fa1-669e-3e80-9208-c19a5dae89c4",
                                                "text": "Nixon was very curious about developments on the Chinese mainland. He particularly wanted to know whether the Vice-Premier saw any possibility of Peking and Moscow patching up their feud in the foreseeable future. Chiang Ching-kuo answered in the negative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b91b2a2-5f20-35df-b8d1-35c5e01a0225",
                                        "entry_id": "d0ed3cd6-75dd-3d1b-bb7b-0c38c6980e2f",
                                        "glosses": [
                                            "To overlay."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
