                ],
                "senses": [
                    {
                        "sense_id": "76677bcf-7843-3ac1-a85e-c51ed7b880ad",
                        "entry_id": "1f73d54f-046e-3d8d-82ea-52b03841e03b",
                        "glosses": [
                            "die Sprache, aus der ein Wort oder eine sonstige sprachliche Einheit in eine andere übernommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71248b10-7e66-4ca9-bc0a-899a57b7289b",
                                "sense_id": "76677bcf-7843-3ac1-a85e-c51ed7b880ad",
                                "text": "Die wichtigste Gebersprache für Fremd- und Lehnwörter im Deutschen ist das Lateinische."
                            },
                            {
                                "example_id": "ac8d5ebd-2f5d-42bc-badd-bf82fd62ba84",
                                "sense_id": "76677bcf-7843-3ac1-a85e-c51ed7b880ad",
                                "text": "„Obwohl es mit dem Thema eigentlich nichts zu tun hat, möchte ich doch an dieser Stelle nicht unerwähnt lassen, dass auch das Deutsche als Gebersprache nicht zu unterschätzen ist.“"
                            },
                            {
                                "example_id": "50746f00-8266-4cc1-a2c1-b7c4805a83e8",
                                "sense_id": "76677bcf-7843-3ac1-a85e-c51ed7b880ad",
                                "text": "„Eine Scheinentlehnung ist eine Entlehnung aus dem Gut einer fremden Sprache, wobei die Gebersprache den scheinbar entlehnten Wert nicht bereithält.“"
                            },
                            {
                                "example_id": "9c7e6d82-8a1d-4512-9ccc-2359a1d099db",
                                "sense_id": "76677bcf-7843-3ac1-a85e-c51ed7b880ad",
                                "text": "„Mit einer solchen Sehweise werden die Besonderheiten der Gebersprachen notwendig in die Fremdwortdiskussion einbezogen.“"
                            },
                            {
                                "example_id": "90ff6ce0-20ee-47e1-9d37-ef12ed4a86bf",
                                "sense_id": "76677bcf-7843-3ac1-a85e-c51ed7b880ad",
                                "text": "„Erfasst wird einerseits die Zeit zu Beginn des 20. Jahrhunderts, in der das Englische seinen Einfluss auf Kosten des Französischen ausbaut, und andererseits die Zeit am Übergang zum 21. Jahrhundert mit dem Englischen als dominanter Gebersprache für das Deutsche wie für viele andere Sprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
