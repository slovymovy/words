                        "entry_id": "67d5ecdc-16d3-3bb2-ae1e-72274f37beb5",
                        "glosses": [
                            "Raum mit gelagerten Werkzeugen oder Werkzeugspeicher einer Werkzeugmaschine, aus dem je nach Bedarf Werkzeuge in eine Arbeitsspindel oder einen Werkzeughalter eingewechselt werden können"
                        ],
                        "tags": [
                            "Maschinenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "b696c072-425d-4dbb-bba7-b6fef2a93008",
                                "sense_id": "91023e1e-7bbb-3a4b-87c4-59af9b72869b",
                                "text": "„Darüber hinaus brachen sie auf dem Hof ein Werkzeugmagazin auf und entwendeten hochwertige Elektrowerkzeuge.“"
                            },
                            {
                                "example_id": "914b932e-602a-4920-b463-900f1b2bd61d",
                                "sense_id": "91023e1e-7bbb-3a4b-87c4-59af9b72869b",
                                "text": "„Völlig neuartig und vielbeachtet ist das an der Maschine angeordnete Werkzeugmagazin.“"
                            }
                        ],
