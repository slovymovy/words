    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a18bae97-875a-37ec-bdf6-ecb9e6efa61f",
                "word": "cramble",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b9e27a24-5e07-4a9a-a857-066c012bfd23",
                        "entry_id": "a18bae97-875a-37ec-bdf6-ecb9e6efa61f",
                        "tags": [
                            "plural"
                        ],
                        "form": "crambles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3da82c46-ced0-3333-ac6d-275ac417865f",
                        "entry_id": "a18bae97-875a-37ec-bdf6-ecb9e6efa61f",
                        "glosses": [
                            "A branch that has been broken and blown onto the ground by the wind."
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "ab481046-a160-41c2-a18e-af75de0fdbdd",
                                "sense_id": "3da82c46-ced0-3333-ac6d-275ac417865f",
                                "text": "These were not your ordinary crambles Boughs and branches broken by the wind."
                            },
                            {
                                "example_id": "cfc9578b-75a7-4d04-ac3e-d2fca92ac280",
                                "sense_id": "3da82c46-ced0-3333-ac6d-275ac417865f",
                                "text": "After the wind-tempest, when branches lie in crambles upon the clearings and neighbors at far distances phone down the foothills under the mountains to ask if all is well still, the answer is “Yes”"
                            },
                            {
                                "example_id": "0f730564-7fc3-42a4-a24c-9d87c87530a3",
                                "sense_id": "3da82c46-ced0-3333-ac6d-275ac417865f",
                                "text": "I shoved into the bottom of the brush pile two large grocery bags holding chainsaw chaff well-soaked in old gasoline gone sticky— a kind of homemade napalm, except, of course, without victims, other than boughs, stumps, broken boards, vines, crambles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b1ec885f-7137-3b79-8d0d-45a0a5d2878a",
                "word": "cramble",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7ec5a8a9-3bec-4320-804a-99a3154db19d",
                        "entry_id": "b1ec885f-7137-3b79-8d0d-45a0a5d2878a",
                        "tags": [
                            "present",
                            "singular",
