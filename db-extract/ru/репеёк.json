                                    {
                                        "sense_id": "739133d2-feb1-3b2c-94db-ae00be3de058",
                                        "entry_id": "8fbaa663-1a9d-3ea8-b5c3-a3b6d06f9c13",
                                        "glosses": [
                                            "To apply the spur to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd21985-bcfa-4229-8335-cd4d0c87c8d9",
                                                "sense_id": "739133d2-feb1-3b2c-94db-ae00be3de058",
                                                "text": "to rowel a horse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc782203-9cf2-3db8-a607-3d2814a72647",
                                        "entry_id": "8fbaa663-1a9d-3ea8-b5c3-a3b6d06f9c13",
                                        "glosses": [
                                            "To incite; to goad."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dc977cb-4430-49a6-aae3-784ca34410e2",
                                                "sense_id": "cc782203-9cf2-3db8-a607-3d2814a72647",
                                                "text": "He would have been completely ignorant of what was going on if Frank, periodically roweled by the viciously anti-labor stand of the Pittsburgh newspapers, hadn't felt the need of an audience."
                                            }
                                        ]
                                    }
                                ]
