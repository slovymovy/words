                    }
                ],
                "senses": [
                    {
                        "sense_id": "0081b960-43f5-3f90-bc74-0903d5877430",
                        "entry_id": "2489ca04-0dc8-3cbd-9ae4-46fb0da9a0b5",
                        "glosses": [
                            "An addictive alkaloid narcotic derived from opium and used as a hypnotic, analgesic and antitussive; often mixed with aspirin etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cba4f5fc-2332-4f2b-9b40-7bfcf6b874b1",
                        "source_entry_id": "2489ca04-0dc8-3cbd-9ae4-46fb0da9a0b5",
                        "source_sense_id": "0081b960-43f5-3f90-bc74-0903d5877430",
                        "source_sense_description": "addictive alkaloid narcotic",
                        "target_lang_word": "codéine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codéine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                        "entry_id": "a9d5511e-5fde-354f-841a-564ac7871432",
                                        "glosses": [
                                            "Alcaloïde que l’on tire de l’opium. Cette molécule est utilisée en pharmacie pour sa propriété antitussive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10337847-b116-489b-9e24-7d0012c35949",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "Ils disent : \"Madame la comtesse est grosse, il est probable que sa délivrance déterminera une crise favorable. Qu'on la tienne en bon air, à la campagne, du petit-lait, de la codéine…\""
                                            },
                                            {
                                                "example_id": "d9ff3105-a557-42d0-b917-f76adf501b23",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "Ces substances, comme la codéine qui se transforme en acétylcodéine par exemple, peuvent également subir des modifications structurelles lors des différentes étapes d’extraction, de transformation et de purification du stupéfiant."
                                            },
                                            {
                                                "example_id": "7113811c-6e44-4959-9337-a307d11ec233",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "Je dois encore juste prendre un Dafalgan Forte vers midi et un Dafalgan codéine le soir."
                                            },
                                            {
                                                "example_id": "293de52d-3fb6-4a3f-9a2e-50c3e427d476",
                                                "sense_id": "7bf99169-6cc3-307d-82cd-9ade421a711c",
                                                "text": "À huit heures, comme un ressort, il tendit un sac à du Lac : « Il y a ce qu’il vous faut : codéine, opioïdes, buprénorphine, morphine. Si vous êtes blessés, vous mélangez tout, c’est explosif : de-la-bombe-a-to-mique ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f77ae84d-c5e7-42e4-b35d-d48f5764674a",
                        "source_entry_id": "2489ca04-0dc8-3cbd-9ae4-46fb0da9a0b5",
