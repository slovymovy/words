{
    "word_family": [
        "sacrificial",
        "sacrificially",
        "sacrificer",
        "self-sacrifice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec83be39-cf77-33ce-8c41-b2ca8d4915a0",
                    "sense_definition": "To destroy or surrender something for the sake of something else regarded as more urgent or valuable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many parents <w>sacrifice</w> their own comfort to provide a better education for their children.",
                            "target_lang_translations": {
                                "ru": "Многие родители <w>жертвуют</w> собственным комфортом, чтобы дать детям лучшее образование."
                            }
                        },
                        {
                            "text": "He had to <w>sacrifice</w> sleep to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>пожертвовать</w> сном, чтобы закончить проект вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "save"
                    ],
                    "common_phrases": [
                        "sacrifice sleep",
                        "sacrifice quality",
                        "sacrifice everything"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уничтожить или отказаться от чего-либо ради чего-то другого, считающегося более важным или ценным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертвовать",
                                "target_lang_sense_clarification": "отказываться от чего-либо ради цели"
                            },
                            {
                                "target_lang_word": "пожертвовать",
                                "target_lang_sense_clarification": "совершить акт отказа от чего-либо"
                            },
                            {
                                "target_lang_word": "приносить в жертву",
                                "target_lang_sense_clarification": "отдавать что-то ценное ради другого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31a60240-9b88-3db8-82eb-223fbe1c004a",
                    "sense_definition": "To offer a human being, an animal, or an object to a deity as a religious act.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_offering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, people would <w>sacrifice</w> a goat to ensure a good harvest.",
                            "target_lang_translations": {
                                "ru": "В древние времена люди <w>приносили в жертву</w> козла, чтобы обеспечить хороший урожай."
                            }
                        },
                        {
                            "text": "The priest prepared to <w>sacrifice</w> an animal at the altar.",
                            "target_lang_translations": {
                                "ru": "Жрец приготовился <w>принести в жертву</w> животное у алтаря."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacrifice an animal",
                        "sacrifice to gods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносить человека, животное или предмет в дар божеству в качестве религиозного акта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приносить в жертву",
                                "target_lang_sense_clarification": "совершать религиозный обряд"
                            },
                            {
                                "target_lang_word": "жертвовать",
                                "target_lang_sense_clarification": "приносить ритуальный дар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b0b7261-a055-321b-aa5b-7222a7ce581d",
                    "sense_definition": "To kill an animal for a scientific experiment or test.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers had to <w>sacrifice</w> the mice to examine their brain tissue.",
                            "target_lang_translations": {
                                "ru": "Исследователям пришлось <w>умертвить</w> мышей, чтобы изучить ткани их мозга."
                            }
                        },
                        {
                            "text": "Ethical guidelines dictate how and when a scientist may <w>sacrifice</w> a laboratory animal.",
                            "target_lang_translations": {
                                "ru": "Этические нормы диктуют, как и когда ученый может <w>принести в жертву</w> лабораторное животное."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacrifice laboratory animals"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерщвлять животное для научного эксперимента или теста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умерщвлять",
                                "target_lang_sense_clarification": "в научных целях"
                            },
                            {
                                "target_lang_word": "приносить в жертву",
                                "target_lang_sense_clarification": "эвфемизм в лабораторной практике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "912157dd-5c96-38ce-8cd2-10cd7beca131",
                    "sense_definition": "To intentionally allow a piece to be captured by the opponent in order to improve one's position in a game like chess.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster decided to <w>sacrifice</w> his queen to set up a checkmate.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер решил <w>пожертвовать</w> ферзя, чтобы подготовить мат."
                            }
                        },
                        {
                            "text": "It is often worth it to <w>sacrifice</w> a pawn for better control of the center.",
                            "target_lang_translations": {
                                "ru": "Часто стоит <w>пожертвовать</w> пешку ради лучшего контроля над центром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacrifice a pawn",
                        "sacrifice the queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно позволить противнику взять фигуру, чтобы улучшить свою позицию в игре (например, в шахматах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертвовать",
                                "target_lang_sense_clarification": "отдавать фигуру в игре"
                            },
                            {
                                "target_lang_word": "пожертвовать",
                                "target_lang_sense_clarification": "совершить тактическую отдачу фигуры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b987e898-8c05-3051-a96d-576516ebb405",
                    "sense_definition": "The destruction or surrender of anything for the sake of something else regarded as more urgent or valuable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Success in professional sports often requires a great deal of personal <w>sacrifice</w>.",
                            "target_lang_translations": {
                                "ru": "Успех в профессиональном спорте часто требует огромных личных <w>жертв</w>."
                            }
                        },
                        {
                            "text": "The <w>sacrifice</w> of one's spare time is necessary when starting a new business.",
                            "target_lang_translations": {
                                "ru": "<w>Жертва</w> свободным временем необходима при открытии нового дела."
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal sacrifice",
                        "ultimate sacrifice",
                        "make a sacrifice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказ от чего-либо или потеря чего-либо ради более важной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "добровольный отказ или отречение"
                            },
                            {
                                "target_lang_word": "самопожертвование",
                                "target_lang_sense_clarification": "отказ от собственных интересов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a1f90fa-cfa7-30bf-9635-898b8067d7d4",
                    "sense_definition": "The killing of a human being or an animal as an offering to a deity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_offering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tribe performed a ritual <w>sacrifice</w> to appease the mountain spirits.",
                            "target_lang_translations": {
                                "ru": "Племя совершило ритуальное <w>жертвоприношение</w>, чтобы задобрить горных духов."
                            }
                        },
                        {
                            "text": "Archaeologists found evidence of animal <w>sacrifice</w> at the ancient temple site.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили следы <w>жертвоприношения</w> животных на месте древнего храма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "human sacrifice",
                        "animal sacrifice",
                        "ritual sacrifice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерщвление человека или животного в качестве подношения божеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертвоприношение",
                                "target_lang_sense_clarification": "религиозный обряд"
                            },
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "существо или предмет, приносимый в дар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a595e0f8-8b34-3998-8b16-ed7b8a241b04",
                    "sense_definition": "A monetary loss incurred by selling something at less than its value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store is selling off its old stock at a <w>sacrifice</w> to make room for new items.",
                            "target_lang_translations": {
                                "ru": "Магазин распродает старые запасы в <w>убыток</w> себе, чтобы освободить место для новых товаров."
                            }
                        },
                        {
                            "text": "He had to sell his car at a <w>sacrifice</w> because he needed the cash immediately.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось продать машину с большой <w>уступкой</w> в цене, так как ему срочно нужны были наличные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "at a sacrifice",
                        "selling at a sacrifice"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежный убыток, понесенный при продаже чего-либо ниже его стоимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убыток",
                                "target_lang_sense_clarification": "продажа по заниженной цене"
                            },
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "финансовая уступка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2de9a020-a72f-317e-a8a9-715cbbab6dd5",
                    "sense_definition": "An act of intentionally allowing one's piece to be captured by the opponent in a game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His brilliant knight <w>sacrifice</w> led to an unavoidable checkmate.",
                            "target_lang_translations": {
                                "ru": "Его блестящая <w>жертва</w> коня привела к неизбежному мату."
                            }
                        },
                        {
                            "text": "The commentator praised the player for a bold <w>sacrifice</w> early in the game.",
                            "target_lang_translations": {
                                "ru": "Комментатор похвалил игрока за смелую <w>жертву</w> в начале игры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knight sacrifice",
                        "queen sacrifice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренная отдача своей фигуры противнику в игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертва",
                                "target_lang_sense_clarification": "тактический прием в шахматах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}