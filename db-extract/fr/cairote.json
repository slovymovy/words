                        "sense_id": "81f7b979-1cc1-385f-a03e-c43cb2a8b3bb",
                        "entry_id": "15e6294f-ca19-3757-8553-85fb9ef2ca91",
                        "glosses": [
                            "Du Caire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0f0bbd7-34ec-4363-8aea-30a3b84b7b54",
                                "sense_id": "81f7b979-1cc1-385f-a03e-c43cb2a8b3bb",
                                "text": "Dans le passé, on était musulman, cairote, damascène, saïdaoui, beyrouthin, bagdadi. Avec le nationalisme, on devint égyptien, syrien, libanais, irakien."
                            }
                        ]
                    },
                    {
                        "sense_id": "214a055f-d75b-3b90-bbc0-91229f75b7e4",
                        "entry_id": "15e6294f-ca19-3757-8553-85fb9ef2ca91",
                        "glosses": [
                            "Relatif au Caire, à ses habitants, les Cairotes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "106de168-5b6c-416f-873c-32ac9397f584",
                                "sense_id": "214a055f-d75b-3b90-bbc0-91229f75b7e4",
                                "text": "L’« Immeuble Yacoubian » et son adaptation cinématographique décrivent la vie d’un immeuble cairote."
                            }
                        ]
                    }
                ],
