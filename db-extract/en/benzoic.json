                "translations": [
                    {
                        "translation_id": "f3129b6d-85ee-46e0-baa1-d5dd7e58f29f",
                        "source_entry_id": "208b22e3-9d36-3da3-9589-b666c469694a",
                        "source_sense_description": "pertaining to, or obtained from, benzoin",
                        "target_lang_word": "benzoïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benzoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "148653f7-18ee-3728-9516-fbe1bb15dd62",
                                        "entry_id": "e007576b-d27b-3948-b896-f21e042a26fc",
                                        "glosses": [
                                            "Qui est extrait du benjoin ou d’autres substances analogues."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d3bea3c-07ef-4f80-9d88-5b8f91c5af36",
                                                "sense_id": "148653f7-18ee-3728-9516-fbe1bb15dd62",
                                                "text": "Distillé avec précaution, il fournit un liquide composé principalement d’acides gras saturés : acides acétique, caprique, caprylique et une certaine quantité d'acide sébacique C₈H₁₆(COOH)₂ qui, en se refroidissant, forme des cristaux analogues à ceux de l'acide benzoïque."
                                            },
                                            {
                                                "example_id": "25416b66-cf00-401d-a555-ceee355be3e0",
                                                "sense_id": "148653f7-18ee-3728-9516-fbe1bb15dd62",
                                                "text": "L’essence d’amandes amères contient de l’acide prussique qui est toxique et qu’on enlève, et de l’aldéhyde benzoïque presque pure."
                                            },
                                            {
                                                "example_id": "a08bc9a7-de61-4cf0-a0ea-21fd4656d676",
                                                "sense_id": "148653f7-18ee-3728-9516-fbe1bb15dd62",
                                                "text": "On trouve des exemples d'une telle persistance dans la plante en ce qui concerne les acides benzoïques, tels que le 2,3,6-TBA, et les acides picoliniques, tels que le piclorame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0722c3aa-15cf-3a4d-8b5d-2db5f82962ec",
                                        "entry_id": "e007576b-d27b-3948-b896-f21e042a26fc",
                                        "glosses": [
                                            "qui contient de l'acide benzo"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
