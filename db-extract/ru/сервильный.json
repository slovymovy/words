                "senses": [
                    {
                        "sense_id": "d6c71f3b-fd82-38a0-a25c-b342fd229090",
                        "entry_id": "31241416-7046-3cc8-beee-b5c9948299f5",
                        "glosses": [
                            "книжн., неодобр. рабски угодливый; раболепный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f35d5fe-a5b9-46d6-b905-de63cb35d79b",
                                "sense_id": "d6c71f3b-fd82-38a0-a25c-b342fd229090",
                                "text": "Что за разговоры о сервильности членов жюри? В него входили достойные, независимые люди, никакой необходимости быть сервильными у них не было."
                            }
                        ]
                    }
                ],
