                "senses": [
                    {
                        "sense_id": "baabf6f4-e41c-3c96-83e9-e56150476024",
                        "entry_id": "0b4cc676-9380-3d6f-9772-dc13f2c865b7",
                        "glosses": [
                            "Körperhaltung, die an einen Embryo im Mutterleib erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9afd0be8-c483-4d74-b1d5-804a37706e8f",
                                "sense_id": "baabf6f4-e41c-3c96-83e9-e56150476024",
                                "text": "„Kolt Raynor kroch auf den malträtierten Händen und Knien zur Schlafrolle zurück, wickelte das zerrissene Tarp wie eine Decke um seinen Körper, rollte sich in Embryonalhaltung zusammen und stöhnte.“"
                            },
                            {
                                "example_id": "dcd934a2-375c-4d1f-b518-6a1149e6738f",
                                "sense_id": "baabf6f4-e41c-3c96-83e9-e56150476024",
                                "text": "„Neal hob den Wischmopp hoch über den Kopf und rammte Colin das hintere Ende so punktgenau in den Schritt, als wollte er eine Flagge auf den Mount Everest pflanzen. Wodurch sich Colins Schmerzverständnis grundlegend wandelte und er sich stöhnend in Embryonalhaltung auf dem Boden wälzte.“"
                            },
                            {
                                "example_id": "608b359d-0078-454e-b2e7-dfa6d1a6c75e",
                                "sense_id": "baabf6f4-e41c-3c96-83e9-e56150476024",
                                "text": "„Court warf sich auf den Boden, nahm eine Embryonalhaltung ein, schloss fest die Augen und deckte sein C4OPS-Earpiece mit den Händen ab.“"
                            },
                            {
                                "example_id": "9a14654a-b1e4-4ab6-94b1-d7f8e053de2b",
                                "sense_id": "baabf6f4-e41c-3c96-83e9-e56150476024",
                                "text": "„Karim kauerte sich in Embryonalhaltung zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
