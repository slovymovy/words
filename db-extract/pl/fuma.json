                ],
                "senses": [
                    {
                        "sense_id": "939ab436-b876-3bb7-97a9-fbd8f62ec48a",
                        "entry_id": "87dc0dd6-cc46-3f6e-8458-b9204386996a",
                        "glosses": [
                            "próżność, pycha"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "49a3e446-21ff-4fbe-ab16-5960b1dc25e9",
                                "sense_id": "939ab436-b876-3bb7-97a9-fbd8f62ec48a",
                                "text": "(…) w chłopskiej chatce albo pod warsztatem się to rodzi, od czyszczenia bucików poczyna, szlachcie bakę świeci i tumani przez całe życie, a na koniec i herb się skądeś tam bierze, i szabelka przy boku, i dziedzictwo nie małe: a już fuma potem i pogarda dla drugich, że w kąt i szlachcic od Bolesławów i Senator mu za nic!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "12e5962e-3ccd-3d61-85a6-c29fdf599e5d",
                        "entry_id": "87dc0dd6-cc46-3f6e-8458-b9204386996a",
                        "glosses": [
                            "grymas, foch, dąs"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2da52b4d-8c7a-41c2-9656-a3372ebcbabc",
                                "sense_id": "12e5962e-3ccd-3d61-85a6-c29fdf599e5d",
                                "text": "Imć Zug tyle już nadoświadczał fąfrów od jenerałowej Elżbiety Grabowskiej, już oficjalnej metresy królewskiej a także niejednej fumie księżnej marszałkowej Izabelli Lubomirskiej przy budowie Mon Coteau, że komenderowania księżnej Heleny Radziwiłłowej już rajem mu się zdawały."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "389040b1-8def-3062-aff1-58a10b7ab783",
                        "entry_id": "87dc0dd6-cc46-3f6e-8458-b9204386996a",
                        "glosses": [
                            "motocykl marki WFM"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "febdfcd4-6710-4967-994b-0759236ee0db",
                                "sense_id": "389040b1-8def-3062-aff1-58a10b7ab783",
                                "text": "Ja ze swoją fumą nie mam problemów: wiadomo, że nie będę jechał ciągle 70 ani 60 km/h, ale to 40-45 jest osiągalne."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
