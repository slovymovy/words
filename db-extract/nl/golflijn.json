                    },
                    {
                        "translation_id": "32e0e480-5f74-426d-b1ce-e5be991d463d",
                        "source_entry_id": "3d56bbec-bbe1-3e65-a9f7-04224528a1ef",
                        "source_sense_id": "e9c67727-6e94-369c-aa5b-f9ba9cf9d701",
                        "target_lang_word": "wave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "effd5347-0cf5-3cbf-83d0-11dd67963937",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A moving disturbance in the level of a body of liquid; an undulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8e6064f-3197-4089-bd8f-b548fa168dde",
                                                "sense_id": "effd5347-0cf5-3cbf-83d0-11dd67963937",
                                                "text": "The wave traveled from the center of the lake before breaking on the shore."
                                            },
                                            {
                                                "example_id": "6e75134e-604e-48e9-8a62-db5a5e1a2263",
                                                "sense_id": "effd5347-0cf5-3cbf-83d0-11dd67963937",
                                                "text": "O God! can I not save / One from the pitiless wave? / Is all that we see or seem / But a dream within a dream?"
                                            },
                                            {
                                                "example_id": "fa5e797c-8b2f-4580-963e-d5bb4627566a",
                                                "sense_id": "effd5347-0cf5-3cbf-83d0-11dd67963937",
                                                "text": "The new sea wall may stop the waves from the sea, but not from the children who enthusiastically greet our train as it passes. It's great to see this ages-old habit is still going strong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f64e120-9c92-3864-bb60-a35c9e5beb41",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "The ocean."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e764f21-b5ab-497f-82b2-24c68b44f074",
                                                "sense_id": "8f64e120-9c92-3864-bb60-a35c9e5beb41",
                                                "text": "1895, Fiona Macleod (William Sharp), The Sin-Eater and Other Tales\n[…] your father Murtagh Ross, and his lawful childless wife, Dionaid, and his sister Anna—one and all, they lie beneath the green wave or in the brown mould."
                                            },
                                            {
                                                "example_id": "c5c58210-0098-4fe0-8ae3-508539306734",
                                                "sense_id": "8f64e120-9c92-3864-bb60-a35c9e5beb41",
                                                "text": "Whoever rules the waves rules the world..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5d362c-221a-35f2-b4ee-e794b3b0056a",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A moving disturbance in the energy level of a field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e643ca0-a9d1-4060-bb83-08f7dfdab9a1",
                                                "sense_id": "3d5d362c-221a-35f2-b4ee-e794b3b0056a",
                                                "text": "Gravity waves, while predicted by theory for decades, have been notoriously difficult to detect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6a1e1ab-903b-39ac-a730-026b093dfb4f",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A shape that alternatingly curves in opposite directions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300d7c06-409f-4bb2-9786-58de4c29c740",
                                                "sense_id": "e6a1e1ab-903b-39ac-a730-026b093dfb4f",
                                                "text": "Her hair had a nice wave to it."
                                            },
                                            {
                                                "example_id": "5f0b923d-b66a-4fb2-810e-1d7dbac88430",
                                                "sense_id": "e6a1e1ab-903b-39ac-a730-026b093dfb4f",
                                                "text": "sine wave"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d294be18-4952-39ac-af6f-7a7ce7a7cf15",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "Any of a number of species of moths in the geometrid subfamily Sterrhinae, which have wavy markings on the wings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68394903-ed92-30c1-b7a9-6076908c184b",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A loose back-and-forth movement, as of the hands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a53c88c-1b4b-42b3-9b7e-87ff018c3c18",
                                                "sense_id": "68394903-ed92-30c1-b7a9-6076908c184b",
                                                "text": "He dismissed her with a wave of the hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605b71eb-f08d-31f5-a447-8781957db996",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A sudden, but temporary, uptick in something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8920cc9e-38d7-497e-9551-be1018e10da2",
                                                "sense_id": "605b71eb-f08d-31f5-a447-8781957db996",
                                                "text": "A wave of shoppers stampeded through the door when the store opened for its Christmas discount special."
                                            },
                                            {
                                                "example_id": "f152a1f3-f72e-42cd-a3e5-b9f567ecd206",
                                                "sense_id": "605b71eb-f08d-31f5-a447-8781957db996",
                                                "text": "A wave of retirees began moving to the coastal area."
                                            },
                                            {
                                                "example_id": "82aa0129-ee24-4b7e-a21d-c193e604701d",
                                                "sense_id": "605b71eb-f08d-31f5-a447-8781957db996",
                                                "text": "A wave of emotion overcame her when she thought about her son who was killed in battle."
                                            },
                                            {
                                                "example_id": "7c0e8d68-8e28-48d1-9638-3d4e1dbb76b3",
                                                "sense_id": "605b71eb-f08d-31f5-a447-8781957db996",
                                                "text": "Foster had been left unsighted by Scott Dann's positioning at his post, but the goalkeeper was about to prove his worth to Birmingham by keeping them in the game with a series of stunning saves as West Ham produced waves after wave of attack in their bid to find a crucial second goal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e7e80c5-15ae-382f-a3b8-b89d173a8112",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "Any of a series of orders to be fulfilled in one short interval of time, planned as part of wave picking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a647e4b5-04c2-3b51-95bf-1b071608f7ca",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A movement or trend in popular culture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a8d7d7-9d16-47cf-9dd3-b049db4e99ab",
                                                "sense_id": "a647e4b5-04c2-3b51-95bf-1b071608f7ca",
                                                "text": "New Wave"
                                            },
                                            {
                                                "example_id": "cbc74197-52e6-4a6b-9b81-e3f83796eb9a",
                                                "sense_id": "a647e4b5-04c2-3b51-95bf-1b071608f7ca",
                                                "text": "Korean Wave"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e1c2aab-22bf-322d-90b6-521d22d40e6f",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "One of the successive swarms of enemies sent to attack the player in certain games."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78dc3976-617d-44af-a712-e236484d91d2",
                                                "sense_id": "9e1c2aab-22bf-322d-90b6-521d22d40e6f",
                                                "text": "As the player eliminates each wave of 55 aliens, the next wave begins lower than the one previous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b560f09-3b7b-34de-bcde-93d4ec9403fa",
                                        "entry_id": "5c6e48c6-34a2-3d38-a543-f5713a1deb0f",
                                        "glosses": [
                                            "A group activity in a crowd imitating a wave going through water, where people in successive parts of the crowd stand and stretch upward, then sit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56e2a411-92bb-3d79-803a-ce7e35191f0f",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To move back and forth repeatedly and somewhat loosely."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50a53bbc-6f40-4656-b2f6-1b6f3e93b45f",
                                                "sense_id": "56e2a411-92bb-3d79-803a-ce7e35191f0f",
                                                "text": "The flag waved in the gentle breeze."
                                            },
                                            {
                                                "example_id": "d526cb23-661d-4ffa-b584-dc1fd925d817",
                                                "sense_id": "56e2a411-92bb-3d79-803a-ce7e35191f0f",
                                                "text": "But the World Cup winning veteran's left boot was awry again, the attempt sliced horribly wide of the left upright, and the saltires were waving aloft again a moment later when a long pass in the England midfield was picked off to almost offer up a breakaway try."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "288f7896-5181-300e-8d13-ac390fc65eb0",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To move one's hand back and forth (generally above the shoulders) in greeting or departure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b471ef-e681-4579-9c2d-b7cf8bd6a1dd",
                                                "sense_id": "288f7896-5181-300e-8d13-ac390fc65eb0",
                                                "text": "I raised my arms in a final salute. I smiled. I waved goodbye. I turned into the helicopter, the door was closed, the red carpet was rolled up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efcba8c8-c10b-330b-9370-379c9e1e8ee1",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To call attention to, or give a direction or command to, by a waving motion, as of the hand; to signify by waving; to beckon; to signal; to indicate."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db900e4f-38d7-41c1-a021-b98a7b65250f",
                                                "sense_id": "efcba8c8-c10b-330b-9370-379c9e1e8ee1",
                                                "text": "I waved goodbye from across the room."
                                            },
                                            {
                                                "example_id": "f44ee8af-a387-45a1-ac1f-6c347cad51ae",
                                                "sense_id": "efcba8c8-c10b-330b-9370-379c9e1e8ee1",
                                                "text": "Look, with what courteous action / It waves you to a more removed ground."
                                            },
                                            {
                                                "example_id": "2cca6a7c-bc43-48c4-abc5-4a066ad5188d",
                                                "sense_id": "efcba8c8-c10b-330b-9370-379c9e1e8ee1",
                                                "text": "She spoke, and bowing waved / Dismissal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e46f34-f114-3797-986e-8ce9865a7759",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To have an undulating or wavy form."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82be0b90-c5e4-3e35-8806-9b1693e89445",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To raise into inequalities of surface; to give an undulating form or surface to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b7a007-0fb4-4ef4-b3b1-7e93fa75ea80",
                                                "sense_id": "82be0b90-c5e4-3e35-8806-9b1693e89445",
                                                "text": "horns whelked and waved like the enridged sea"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a568c8-dc88-3655-b3d3-94ad7e05f225",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To style (the hair) so as to produce a wavy texture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d414de-0c4f-44b3-adb3-704556ed858f",
                                                "sense_id": "41a568c8-dc88-3655-b3d3-94ad7e05f225",
                                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c30c388e-f28d-3a2c-92af-e0691e53ae6c",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To swing and miss at a pitch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6b248b8-69ba-4f1e-89e4-13f80dfcf550",
                                                "sense_id": "c30c388e-f28d-3a2c-92af-e0691e53ae6c",
                                                "text": "Jones waves at strike one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb4ca17-0974-3725-82df-9444d85abd2f",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To cause to move back and forth repeatedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5741fd94-d260-4bce-94ba-93d555ddad88",
                                                "sense_id": "edb4ca17-0974-3725-82df-9444d85abd2f",
                                                "text": "The starter waved the flag to begin the race."
                                            },
                                            {
                                                "example_id": "1358b3e4-96ff-47da-9c0e-e279bd93f27c",
                                                "sense_id": "edb4ca17-0974-3725-82df-9444d85abd2f",
                                                "text": "His father has waved bills in front of face and said to him — see what you've cost me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10f1a4c-5e22-34b4-810c-7c34c7002aa0",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To signal (someone or something) with a waving movement."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e498fdb-0de2-37d3-acec-33a39fed1bcf",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To fluctuate; to waver; to be in an unsettled state."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3378f00a-76a2-4cd0-9eb9-efa57bef2763",
                                                "sense_id": "6e498fdb-0de2-37d3-acec-33a39fed1bcf",
                                                "text": "He waved indifferently 'twixt doing them neither good nor harm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                        "entry_id": "503a8e16-d00c-308b-a07c-c96545cfd547",
                                        "glosses": [
                                            "To move like a wave, or by floating; to waft."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5801d2-bb0b-4070-9523-dc87b192ac7e",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "But in the last, this dotted line, by the twisting as well as the bending of the horn, is changed from the waving into the serpentine line"
                                            },
                                            {
                                                "example_id": "484452b1-776b-4d47-98b4-41edf450fb4b",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "the flowers will not bloom less brightly, nor the grass be less green and fresh because it is waving over the head of one who loved to look upon their tender beauty while living."
                                            },
                                            {
                                                "example_id": "f3916d5b-c575-46a8-99c8-696ee6131d3b",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "The cypresslike ferns were not waving over these, as they waved over the corals in the wood, but the little spleenwort, called Wall-rue, was resolved that their tomb should not be without verdure."
                                            },
                                            {
                                                "example_id": "6e5d1f40-12b2-409d-982e-1c6346af1b18",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "The moonlight fell into the room, and the shadows waved over him"
                                            },
                                            {
                                                "example_id": "55bd7ae2-c85b-4bba-88d1-1cc79503bd94",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "Walking through the fields, where the maize was now waving over his head, pale gold with a froth of white, the sharp dead leaves scything crisply against the wind, he could see nothing but that black foetid hut"
                                            },
                                            {
                                                "example_id": "3837c4fb-682d-45c1-85c7-0f8ae493e59a",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "A chill waved over my consciousness as my worst nightmare erupted into reality."
                                            },
                                            {
                                                "example_id": "e37ec3c1-d8eb-4187-a7cb-db4a64f554d2",
                                                "sense_id": "7d7cff67-daf3-3383-af26-ec0d2ec68f84",
                                                "text": "The two stood in the window peering down where parents moved across grass, pointing tongues of colour waving over them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75167846-53c3-335b-a444-30c3371bb3ac",
                                        "entry_id": "4422674e-c535-3259-891a-67f4e0c0b55f",
                                        "glosses": [
                                            "To generate a wave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b9f041-55ab-4866-b781-2d205b1b46f9",
                                                "sense_id": "75167846-53c3-335b-a444-30c3371bb3ac",
                                                "text": "If the electron had wavelike properties, then what was disturbing the medium in which the wave existed? What was waving?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fcfaa6c-f771-397a-8af9-dad00198b0fc",
                                        "entry_id": "f235c056-ceb5-37d3-a119-f9473bf16ac3",
                                        "glosses": [
                                            "Obsolete spelling of waive."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617229ff-bb0b-4d43-ae05-6bd0c31995f0",
                                                "sense_id": "5fcfaa6c-f771-397a-8af9-dad00198b0fc",
                                                "text": "Ladies and gentlemen—I am ordered by Miss Woodhouse to say, that she waves her right of knowing exactly what you may all be thinking of, and only requires something very entertaining from each of you, in a general way."
                                            }
                                        ]
