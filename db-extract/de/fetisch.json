                                            "obiekt, sytuacja lub działanie wzmacniające satysfakcję seksualną"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c96b9fe4-1d9c-4cb9-963b-712bf81a2d64",
                                                "sense_id": "0c0d6cfe-4918-34c5-b147-865bd161417b",
                                                "text": "Jak sam stwierdził, jego fetyszem są męskie sutki, więc widok czterech nagich klat sprawił, że czuł się jak w niebie"
                                            }
                                        ],
