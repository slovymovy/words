                "entry_id": "9ee80440-1566-3b5e-a0f7-560570fbd212",
                "word": "replicator",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4579ff8e-a5aa-441d-9100-586ba535b751",
                        "entry_id": "9ee80440-1566-3b5e-a0f7-560570fbd212",
                        "tags": [
