                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abd3974-1405-449a-9f8e-46790bb2756d",
                                                "sense_id": "564aeb4b-f0c8-3252-826b-7435998fa5ad",
                                                "text": "De man noemde het groenachtig terwijl zijn kleurgevoelige vrouw het toch echt meer bruinachtig vond."
