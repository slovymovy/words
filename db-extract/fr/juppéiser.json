                "senses": [
                    {
                        "sense_id": "1b290762-4bb5-370b-9cda-ffdea072bee7",
                        "entry_id": "32f710c8-5d61-3ec4-a90e-f3e82273e049",
                        "glosses": [
                            "Donner un caractère rappelant Alain Juppé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fcc1690-3f66-46fa-add9-ef1d9c81bb76",
                                "sense_id": "1b290762-4bb5-370b-9cda-ffdea072bee7",
                                "text": "Elle voulait en finir avec les déchirements présidentiels, entreprenant de chiraquiser aux forceps toutes les droites républicaines pour mieux les juppéiser ensuite."
                            },
                            {
                                "example_id": "05509504-11a9-4b82-bc6c-ea869cad5f69",
                                "sense_id": "1b290762-4bb5-370b-9cda-ffdea072bee7",
                                "text": "Lionel Jospin assure ne pas se « balladuriser » ou se « juppéiser », mais n'est-il pas en train de se « mitterrandiser » ?"
                            },
                            {
                                "example_id": "6859da21-411e-49a6-b0c9-3228c260c046",
                                "sense_id": "1b290762-4bb5-370b-9cda-ffdea072bee7",
                                "text": "Il considère que face à l'opposition populaire ça ne sert à rien de se juppéiser ou bien est-il contre le principe du CPE ???"
                            }
                        ]
                    }
