                "senses": [
                    {
                        "sense_id": "316b2274-e917-3886-9527-a0f696f08590",
                        "entry_id": "229aa635-e193-3041-a910-686c48fde177",
                        "glosses": [
                            "Annahme/Einstellung, dass man sich auf etwas Bestimmtes verlassen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d4ea46-4502-449e-b3dd-4e6fab3aa497",
                                "sense_id": "316b2274-e917-3886-9527-a0f696f08590",
                                "text": "„Durch den Rückgriff auf mathematische Methoden und Strukturen haben kryptographische Systeme einen viel höheren Grad an Vertrauenswürdigkeit erlangt.“"
                            },
                            {
                                "example_id": "2b9df8e6-6b8f-4caf-8518-1d8f2d2a0b02",
                                "sense_id": "316b2274-e917-3886-9527-a0f696f08590",
                                "text": "„Tja, ich würde sagen, der Zweck meines Besuchs besteht schlicht darin, meine Vertrauenswürdigkeit unter Beweis zu stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1ece5a0-9f27-4888-9df0-6636af18a80a",
