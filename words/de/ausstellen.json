                {
                    "sense_id": "2eb27f8c-7284-3115-a0e5-34743eb0698a",
                    "sense_definition": "Kunstwerke, Waren oder andere Gegenstände öffentlich zeigen und präsentieren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "praesentieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Galerie <w>stellt</w> diesen Monat Gemälde aus Privatbesitz <w>aus</w>."
                        },
                        {
                            "text": "Viele junge Künstler möchten ihre Kunstwerke in einer berühmten Galerie <w>ausstellen</w>."
                        }
                    ],
                    "common_phrases": [
                        "Bilder ausstellen",
                        "im Museum ausstellen"
                    ]
                },
                {
                    "sense_id": "10d0b575-9b57-37e0-afe5-585f7520fb96",
                    "sense_definition": "ein offizielles Dokument, eine Urkunde oder einen Beleg anfertigen und aushändigen",
