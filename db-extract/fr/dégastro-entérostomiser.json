                "senses": [
                    {
                        "sense_id": "f29edd75-8908-3d77-803f-fc5ad250f863",
                        "entry_id": "af1847cc-e43e-38d3-9a27-66bf8b9dd974",
                        "glosses": [
                            "Défaire la liaison entre l’estomac et l’intestin grêle de quelqu’un (liaison qui avait par exemple été réalisée par une gastro-entérostomie antérieure)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328d54dd-3d82-45e6-a99f-e8b0d3b988e7",
                                "sense_id": "f29edd75-8908-3d77-803f-fc5ad250f863",
                                "text": "On ne voit aucune indication à « dégastro-entérostomiser » la malade (…)"
                            },
                            {
                                "example_id": "d6c191bf-9dcc-4c7b-baaa-fb2d18feecfa",
                                "sense_id": "f29edd75-8908-3d77-803f-fc5ad250f863",
                                "text": "APPELMANS (Louvain, Belgique). — N’a pas opéré de gastrite, mais a dégastro-entérostomisé et opéré des gastrites sans ulcère avec gastro-entérostomie."
                            }
                        ]
                    }
