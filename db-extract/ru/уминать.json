                        "form": "умина́вши"
                    },
                    {
                        "form_id": "c891e33b-f6e9-4f87-bdc4-a374e1174f6f",
                        "entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… умина́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee9e2dcf-4fc9-30b8-bb2c-fdbb8db8bf0c",
                        "entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "glosses": [
                            "разг. мять, разминать тщательно, как следует, доводя до нужного состояния"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7338d7f6-26fc-40bf-b58b-191691c53c9e",
                                "sense_id": "ee9e2dcf-4fc9-30b8-bb2c-fdbb8db8bf0c",
                                "text": "И действительно, Иван Иванович только курил, едва-едва забирая дым и не доводя его далее передней полости рта; пускает дымок и время от времени уминает большим пальцем содержимое трубки."
                            },
                            {
                                "example_id": "76ecba19-3ecb-48ca-986a-d55b78b60716",
                                "sense_id": "ee9e2dcf-4fc9-30b8-bb2c-fdbb8db8bf0c",
                                "text": "Стифей уминал ложкой куски хлеба, помогая им набухнуть."
                            }
                        ]
                    },
                    {
                        "sense_id": "c88ce424-28a7-3bb8-bfe9-5037e158b528",
                        "entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "glosses": [
                            "разг. складывать, укладывать, плотно приминая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d63a31a-6e31-4269-a710-323c6f92dbbc",
                                "sense_id": "c88ce424-28a7-3bb8-bfe9-5037e158b528",
                                "text": "Привозят целый воз плохо сколоченных гробов и сваливают в яму, трупы вываливаются, торчат руки, ноги, их лопатами уминают, засыпают землей."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b15cbe0-b5e0-38c1-a6d2-5ea3cf3ed25a",
                        "entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "glosses": [
                            "разг. приминать, уплотнять ходьбой, ездой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdeea04c-7b02-4839-8583-1d6814f2d6a0",
                                "sense_id": "1b15cbe0-b5e0-38c1-a6d2-5ea3cf3ed25a",
                                "text": "Когда всё это, кое-как затопленное, стало выше поверхности воды, человек двадцать крестьян, дюжих и ловких, вскочили на верх запруды и начали утаптывать и уминать её ногами."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4d35273-0493-3c98-a790-667048ad3db0",
                        "entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "glosses": [
                            "перен., разг., сниж. съедать много и с удовольствием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab29f4b0-213d-4822-9ac0-729e9fb1836c",
                                "sense_id": "f4d35273-0493-3c98-a790-667048ad3db0",
                                "text": "Молчит Иван-дурак, только знай, что за обе щёки каравай уминает."
                            },
                            {
                                "example_id": "7fc10216-0ce5-4960-8527-f641a7c67009",
                                "sense_id": "f4d35273-0493-3c98-a790-667048ad3db0",
                                "text": "В тумане ― одни рты: чавкают, уминают; похрустывают на зубах кости."
                            },
                            {
                                "example_id": "999c9c5c-199c-44ca-8a99-0117942f0a14",
                                "sense_id": "f4d35273-0493-3c98-a790-667048ad3db0",
                                "text": "За чаем тяжёлая сцена: он себе отрезал фунт ситного, забрал всё масло, положил полчашки сахара и затем уминал это, попивая, с нескрываемым «систематическим упоением»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daaeb2cc-881e-48c7-907b-13a94bb153b0",
                        "source_entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "source_sense_description": "мять, разминать тщательно",
                        "target_lang_word": "knead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76fe7178-3875-37cc-84ec-0f3cbea84c25",
                                        "entry_id": "42730eeb-c391-340c-a684-727b47066ffe",
                                        "glosses": [
                                            "To work and press into a mass, usually with the hands; especially, to work, as by repeated pressure with the knuckles, into a well mixed mass, the materials of bread, cake, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c954c969-285e-4e3d-a707-78ebaa8e5a17",
                                                "sense_id": "76fe7178-3875-37cc-84ec-0f3cbea84c25",
                                                "text": "Knead the dough by pressing down on it with the heels of both your palms and pushing it forward to stretch it, then pulling it back toward you..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b393933-0bb9-36a0-8679-0a6b02938601",
                                        "entry_id": "42730eeb-c391-340c-a684-727b47066ffe",
                                        "glosses": [
                                            "To treat or form as if by kneading; to beat."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d2e9e2-bd87-4bce-8680-93f906bc78a8",
                                                "sense_id": "8b393933-0bb9-36a0-8679-0a6b02938601",
                                                "text": "I will knead him: I'll make him supple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa82ffee-8315-3e49-a984-97c41bfae2df",
                                        "entry_id": "42730eeb-c391-340c-a684-727b47066ffe",
                                        "glosses": [
                                            "Of cats, to make an alternating pressing motion with the two front paws."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a805f0b2-200f-4c88-a5c8-f87e2e72f9c1",
                                                "sense_id": "fa82ffee-8315-3e49-a984-97c41bfae2df",
                                                "text": "Cats knead with their paws when happy, just as they kneaded when feeding from their mothers as kittens."
                                            },
                                            {
                                                "example_id": "70324149-154d-4524-8a50-f3a12e7a892f",
                                                "sense_id": "fa82ffee-8315-3e49-a984-97c41bfae2df",
                                                "text": "One of the most characteristic things that cats do is ”knead,” pushing their paws alternately against any invitingly soft area of their human friends' bodies like a baker kneading dough."
                                            },
                                            {
                                                "example_id": "5a2a2d6b-3466-40ac-97e1-3022c7fada08",
                                                "sense_id": "fa82ffee-8315-3e49-a984-97c41bfae2df",
                                                "text": "Why do cats knead? When kittens are nursing, they knead against their mothers' bellies to draw out milk. A relaxed adult cat kneads your leg or a couch cushion to show that he's happy and content, as he was when he was a nursing baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669fd8e3-e443-3612-8d57-5a33052b9f22",
                                        "entry_id": "42730eeb-c391-340c-a684-727b47066ffe",
                                        "glosses": [
                                            "To mix thoroughly; form into a homogeneous compound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34b03862-95a3-3b70-b51d-7806b1e957cb",
                                        "entry_id": "08defaf8-4a42-3043-9843-fe89b3610800",
                                        "glosses": [
                                            "The act of kneading something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f28a102-75bf-465b-bc2d-d5f471a55a34",
                                                "sense_id": "34b03862-95a3-3b70-b51d-7806b1e957cb",
                                                "text": "Do not expect the dough to be very manageable even after a good knead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b59856c-c05f-4955-b2d7-63f92dd02f76",
                        "source_entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "source_sense_description": "мять, разминать тщательно",
                        "target_lang_word": "thumb down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thumb down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "344511aa-a46c-3de8-b971-8944d79d66ac",
                                        "entry_id": "67b7e4cc-516e-30b8-8f64-fa73c2995215",
                                        "glosses": [
                                            "to get (a passing vehicle) to stop and give one a ride, signalling to the driver by holding out one's thumb (as a hitchhiker)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7715c7-770f-4f15-939f-6d5af10f660e",
                                                "sense_id": "344511aa-a46c-3de8-b971-8944d79d66ac",
                                                "text": "I was stranded in the middle of nowhere, but luckily I managed to thumb down a passing car."
                                            },
                                            {
                                                "example_id": "1ef88f34-278c-4b0e-bd89-0beeb1f6e569",
                                                "sense_id": "344511aa-a46c-3de8-b971-8944d79d66ac",
                                                "text": "Bobby thumbed a diesel down, just before it rained / It rode us all the way to New Orleans'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa028c3-3e39-3e6a-86e9-6c44c6de14b7",
                                        "entry_id": "67b7e4cc-516e-30b8-8f64-fa73c2995215",
                                        "glosses": [
                                            "to disapprove or reject"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5fd335c-5084-431b-b14a-1a7d97567e39",
                        "source_entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
                        "source_sense_description": "приминать, уплотнять ходьбой, ездой",
                        "target_lang_word": "press down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "press down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "202bac9d-e65e-3925-b0c9-fd288c5642c2",
                                        "entry_id": "7c4c08e8-509e-3784-a301-d1e5b71bb8ee",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see press, down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a042ba7-b07b-4868-b2e0-0f52839a82ea",
                                                "sense_id": "202bac9d-e65e-3925-b0c9-fd288c5642c2",
                                                "text": "Giue, and it shall bee giuen vnto you, good measure, preassed downe, and shaken together, and running ouer, shall men giue into your bosome: for with the same measure that ye mete withall, it shall bee measured to you againe.",
                                                "translation": "Give, and it shall be given unto you; good measure, pressed down, and shaken together, and running over, shall men give into your bosom. For with the same measure that ye mete withal it shall be measured to you again.",
                                                "english": "Give, and it shall be given unto you; good measure, pressed down, and shaken together, and running over, shall men give into your bosom. For with the same measure that ye mete withal it shall be measured to you again."
                                            },
                                            {
                                                "example_id": "11c88d00-6501-4292-aad0-da5037cbc790",
                                                "sense_id": "202bac9d-e65e-3925-b0c9-fd288c5642c2",
                                                "text": "You shall not press down upon the brow of labor this crown of thorns, you shall not crucify mankind upon a cross of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81d035e5-e44c-3af6-adf0-d0d4d53b616e",
                                        "entry_id": "7c4c08e8-509e-3784-a301-d1e5b71bb8ee",
                                        "glosses": [
                                            "To exert an oppressive influence."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d20a564-006a-4c2a-8809-a67bc4f77e97",
                                                "sense_id": "81d035e5-e44c-3af6-adf0-d0d4d53b616e",
                                                "text": "Or, as the same poet goes on, \"when awful old age pressed down upon him, she put him away in an inner room of the house and shut the shining doors\"."
                                            },
                                            {
                                                "example_id": "0ddbdbc2-bdb4-466e-b221-cc662852aef3",
                                                "sense_id": "81d035e5-e44c-3af6-adf0-d0d4d53b616e",
                                                "text": "Time is pressing down on us, fastening each moment to the railroad of our lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a869632-f22c-3576-b5b0-bee4a086ef8c",
                                        "entry_id": "7c4c08e8-509e-3784-a301-d1e5b71bb8ee",
                                        "glosses": [
                                            "To press or push, especially for a long time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d75ddd9-68cc-48cd-9f96-eb04b666cdc3",
                        "source_entry_id": "a9880bf4-649c-383d-812b-bd9d2f9b8924",
