                        "sense_id": "0f96bdd1-3521-3527-ba99-3bd5ecac096f",
                        "entry_id": "807854c2-45e6-3c46-892d-298928f40751",
                        "glosses": [
                            "een tijdelijke oplossing voor een probleem die men maar accepteert omdat er op dat moment geen betere oplossing voor handen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795a3587-f433-43fc-aa8d-d4477629c0cb",
                                "sense_id": "0f96bdd1-3521-3527-ba99-3bd5ecac096f",
                                "text": "In totaal speelde De Munt honderd voorstellingen in een tent op Tour Taxis. Een noodoplossing, omdat technische aanpassingen aan de Muntschouwburg telkens weer nieuwe vertragingen opliepen."
                            },
                            {
                                "example_id": "2ebaea8b-742d-4fdf-95ff-2820b9b2aeca",
                                "sense_id": "0f96bdd1-3521-3527-ba99-3bd5ecac096f",
                                "text": "Het treinverkeer liep daardoor vertraging op, en dat leidde weer tot extra drukte op de stations. Wie als noodoplossing de taxi nam, kan contact opnemen met de NS voor een vergoeding: de vervoerder heeft de plicht om vervangend vervoer te regelen als de treinen geen uitkomst bieden."
                            }
                        ]
                    }
