                                    {
                                        "sense_id": "cd262946-7756-3f34-bd90-c58906ba1658",
                                        "entry_id": "a3b0920c-6bdc-3fe4-b371-ba3a591da7eb",
                                        "glosses": [
                                            "A passive or submissive male fictional character in a same-sex relationship; a bottom."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b728636-94e0-498f-9b91-1f7f6b8d2678",
                                                "sense_id": "cd262946-7756-3f34-bd90-c58906ba1658",
                                                "text": "Yaoi uke in fanfics often bear the brunt of stereotypical \"negative female characteristics\" such as passivity, helplessness, and masochism."
                                            },
                                            {
                                                "example_id": "ace68646-2094-4121-ba6c-2b45b3659ef6",
                                                "sense_id": "cd262946-7756-3f34-bd90-c58906ba1658",
                                                "text": "You'd rather have Sebas be an uke?"
                                            },
                                            {
                                                "example_id": "a3975575-618c-4085-a6a5-2e1d91234429",
                                                "sense_id": "cd262946-7756-3f34-bd90-c58906ba1658",
                                                "text": "Shizuku is so, so, so cute! I love him as an uke so much I can't stand it!"
                                            }
                                        ]
                                    }
                                ]
                            }
