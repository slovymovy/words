                        "source_entry_id": "d4452fb8-bdf5-38b6-b23c-9fb80cca81a8",
                        "source_sense_id": "4851f10d-9eb3-365a-a985-d8e383e91206",
                        "source_sense_description": "samengaand, gelijktijdig, vergezellend, accessoir",
                        "target_lang_word": "concomitant",
