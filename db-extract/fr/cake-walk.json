                ],
                "senses": [
                    {
                        "sense_id": "88968714-66fd-39b1-942d-be94f24f3164",
                        "entry_id": "f4bca5b9-f7d1-3fb1-b690-602b35f8ac4d",
                        "glosses": [
                            "Danse originaire de Virginie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e19234cc-8059-4e18-b9cd-59f61f9058e7",
                                "sense_id": "88968714-66fd-39b1-942d-be94f24f3164",
                                "text": "Le cake-walk a d’abord été introduit en France dans des revues…"
                            },
                            {
                                "example_id": "dd711662-4f17-4199-9847-c6f9bc24e0f5",
                                "sense_id": "88968714-66fd-39b1-942d-be94f24f3164",
                                "text": "Ensuite quatre girls anglaises, des sisters quelconques, vinrent danser un pas de gigue, compliqué de cake-walk et de matchiche."
                            },
                            {
                                "example_id": "3dac2bce-ca2b-4d26-98e1-a83467fead56",
                                "sense_id": "88968714-66fd-39b1-942d-be94f24f3164",
                                "text": "Ah ! le bateau peut bien continuer son cake-walk hystérique, cela peut bien l’homme et l’huile chaude des machines, Jérôme va."
                            },
                            {
                                "example_id": "55e64b68-e068-41e9-9ad2-e54de635f1ad",
                                "sense_id": "88968714-66fd-39b1-942d-be94f24f3164",
                                "text": "Tandis qu’elle s’obstinait à les traiter de « vieilles baignoires », la salle spacieuse et grise, où méditent tant de dieux de granit, fut envahie soudain par plusieurs petites Anglaises, danseuses de music-hall ou de cirque, qui chantaient en chœur un air de cake-walk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9261c02-a9c7-4654-b9cf-d821f8ffff6e",
                        "source_entry_id": "f4bca5b9-f7d1-3fb1-b690-602b35f8ac4d",
                        "source_sense_id": "88968714-66fd-39b1-942d-be94f24f3164",
                        "target_lang_word": "cake walk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cake walk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6872d279-61ef-355d-8e2b-e8c1b8709b57",
                                        "entry_id": "793687cc-d48b-3663-996d-61ecab426798",
                                        "glosses": [
                                            "A type of dance originating in the United States in the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf15e47c-e55f-4f1d-b44d-f1e1164b6f42",
                                                "sense_id": "6872d279-61ef-355d-8e2b-e8c1b8709b57",
                                                "text": "It is called the cake-walk. A large cake is prepared for the occasion, and, when the invited guests arrive on the gala evening, each young man selects a partner for the walk. After a great deal of merriment and confusion, the couples take their places on the floor and begin to march around the room singing a hymn (for the church-members are not allowed to indulge in secular music) to a good marching tune, while the matrons and married men look on and criticise the promenaders, join in the chorus, and beat time with hands and feet. When tired at last of the walking-match, the cake is duly awarded to the most graceful couple, by whom it is carried home after the supper which closes the entertainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e824c56-3f53-3b66-a414-45b12d570de0",
                                        "entry_id": "793687cc-d48b-3663-996d-61ecab426798",
                                        "glosses": [
                                            "From the mid 1900s, a game at a fair or party in which people walk around a numbered circle along to music. When the music is stopped, the caller draws a number from a jar and whoever is standing on or closest to that number wins a cake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe7522b-bfb5-401f-a1fb-b5ec3a38c0e2",
                                                "sense_id": "3e824c56-3f53-3b66-a414-45b12d570de0",
                                                "text": "... each of the marchers took his place beside the number nearest to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01ebd1df-767f-328b-85e8-8159906b92fb",
                                        "entry_id": "793687cc-d48b-3663-996d-61ecab426798",
                                        "glosses": [
                                            "Something extremely easy."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c2ca95-11b9-41a6-a1e1-c522ec647ce0",
                                                "sense_id": "01ebd1df-767f-328b-85e8-8159906b92fb",
                                                "text": "The three mile run was a cake walk for \"Blondy\" Romig, of Penn State."
                                            }
                                        ]
                                    }
                                ]
                            }
