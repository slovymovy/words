                "translations": [
                    {
                        "translation_id": "2363be5c-5f56-4546-a2c3-6104d6cf1265",
                        "source_entry_id": "47e3fed9-19fc-371e-9a40-946397d4e1c0",
                        "source_sense_id": "8f0835e8-7804-36d0-a098-6936221f6407",
                        "target_lang_word": "passable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70bc4e3a-1960-3863-b0da-288c50d2514e",
                                        "entry_id": "6a28a303-5a4f-3964-9471-a9c86d7a73a3",
                                        "glosses": [
                                            "That may be passed or traversed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f71bb76-34e9-358c-b715-b922de85e7dd",
                                        "entry_id": "6a28a303-5a4f-3964-9471-a9c86d7a73a3",
                                        "glosses": [
                                            "Tolerable; adequate; no more than satisfactory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea253eb6-316a-4f22-81d1-01594d8abfc4",
                                                "sense_id": "4f71bb76-34e9-358c-b715-b922de85e7dd",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            },
                                            {
                                                "example_id": "09e25b72-26fd-4f00-9adf-032ac373e4e2",
                                                "sense_id": "4f71bb76-34e9-358c-b715-b922de85e7dd",
                                                "text": "AIs are no longer just producing passable five-paragraph essays. Now they’re excelling at the SAT, “earning” a score of 1410."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c58ea19d-5dc7-32e4-98db-679f52b15038",
                                        "entry_id": "6a28a303-5a4f-3964-9471-a9c86d7a73a3",
                                        "glosses": [
                                            "able to \\\"pass\\\", or be accepted as a member of a race, sex or other group to which society would not otherwise regard one as belonging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "853e9810-72b0-4d91-9ed0-4f6c769855f2",
                                                "sense_id": "c58ea19d-5dc7-32e4-98db-679f52b15038",
                                                "text": "The idea of something, or someone, being unusual and sexual is intoxicating. I concluded that if I ever met a very passable transsexual and we were attracted to one another, I'd go bisexual and pursue the relationship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58642612-a831-4e2a-b8d6-278c95cf5e8b",
                        "source_entry_id": "47e3fed9-19fc-371e-9a40-946397d4e1c0",
                        "source_sense_id": "8f0835e8-7804-36d0-a098-6936221f6407",
                        "target_lang_word": "practicable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "practicable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                        "entry_id": "73a615cb-5eb8-3af0-a580-19962e32b6ef",
                                        "glosses": [
                                            "Capable of being accomplished; feasible."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e49735-8841-4821-837b-ec5685e2a071",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "Those who have concerned themselves exclusively with what seemed practicable in the existing state of opinion have constantly found that even this has rapidly become politically impossible as the result of changes in a public opinion which they have done nothing to guide."
                                            },
                                            {
                                                "example_id": "cc2bc982-c59c-4120-81c0-347d61fa114c",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "The law in most states says that cyclists must ride as far to the right as is practicable."
                                            },
                                            {
                                                "example_id": "f93dea53-1452-4f58-b0c1-460c2dfa94cc",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "This sober and unflinching analysis should be read and reckoned with by anyone concerned with practicable change in the long-suffering region."
                                            },
                                            {
                                                "example_id": "700d4b37-31ad-4457-8270-071028e48243",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "“The player should usually be able to play more quickly than that and is encouraged to do so,” the guidelines state, with golfers that exceed 40 seconds – AKA “bad time” – “informed as soon as practicable” by a tournament official."
                                            },
                                            {
                                                "example_id": "6f1fe804-1ca7-436a-9e14-20ed64092666",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "Monday’s executive order called on the secretary of state and director of the Office of Management and Budget to pause funding “with all practicable speed.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c9366c-afd1-35dd-aaab-1250fb2bd95b",
                                        "entry_id": "73a615cb-5eb8-3af0-a580-19962e32b6ef",
                                        "glosses": [
                                            "Serving a useful function; useful, functional or handy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19803396-a20b-385d-a2a6-48d5a42b40c3",
                                        "entry_id": "73a615cb-5eb8-3af0-a580-19962e32b6ef",
                                        "glosses": [
                                            "Available for use; accessible or employable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f10b83-ff18-40f4-964e-780431926c12",
                                                "sense_id": "19803396-a20b-385d-a2a6-48d5a42b40c3",
                                                "text": "I glanced up, — there was no trap door which led to the roof. No practicable nook or cranny, in which a living being could lie concealed, was anywhere at hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
