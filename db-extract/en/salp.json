                "senses": [
                    {
                        "sense_id": "a1a7599a-7a7f-3082-82c8-377a7ac52e5e",
                        "entry_id": "7ba2902b-e924-3a28-b151-bef72d7f1363",
                        "glosses": [
                            "Any of the free-swimming tunicates of the order Salpida and its single family Salpidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f219e14-e4c3-44b4-bc1b-ad309d6f4030",
                                "sense_id": "a1a7599a-7a7f-3082-82c8-377a7ac52e5e",
                                "text": "Salps are capable of self-propulsion, but for the most part, these translucent, gelatinous-looking animals float in mid-water going wherever the prevailing currents take them.[…]At times a number of buds are attached to one another in linked chains commonly called salp chains."
                            },
                            {
                                "example_id": "7666274d-b2b1-41e6-b55a-dd980fc9ae01",
                                "sense_id": "a1a7599a-7a7f-3082-82c8-377a7ac52e5e",
                                "text": "Observations of some species suggest that salps form spawning aggregations near the surface in the early morning, and that spawning is synchronized with chain release to maximize fertilization success."
                            },
                            {
                                "example_id": "806eb567-bf85-4de0-bcc9-4555e98ece39",
                                "sense_id": "a1a7599a-7a7f-3082-82c8-377a7ac52e5e",
                                "text": "Lampetia has a rather undifferentiated larval stage (called Gastrodes) that parasitizes salps (Mortensen 1912; Komai 1922)."
                            }
                        ]
                    }
                ],
                "translations": [
