                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4685b46-321e-436f-aa59-85d42c9f71e6",
                                                "sense_id": "14922264-ea98-33a6-a5b5-48a17a2802da",
                                                "text": "Spices reached Europe after being carried over the Asiatic caravan routes by the Radanite merchants, to be re-distributed among traders and apothecaries, pilgrims and princelings."
                                            },
                                            {
                                                "example_id": "def94eb6-f970-4baa-8c33-3970808895bf",
                                                "sense_id": "14922264-ea98-33a6-a5b5-48a17a2802da",
                                                "text": "Speaking of the guest list, though, it is most disappointing to find some of the third tier European princelings unable to hide their bitterness at being NFI."
                                            }
                                        ]
