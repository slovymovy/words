{
    "word_family": [
        "determination",
        "determine",
        "determiner",
        "determinism",
        "deterministic",
        "indeterminable",
        "undetermined"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9dcec7a0-4e7d-3c45-9db5-1defde69f071",
                    "sense_definition": "Having made a firm decision and being resolved not to change it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resolute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>determined</w> to finish the marathon despite her injury.",
                            "target_lang_translations": {
                                "ru": "Она <w>полна решимости</w> закончить марафон, несмотря на травму."
                            }
                        },
                        {
                            "text": "The <w>determined</w> student spent every evening in the library to pass the exam.",
                            "target_lang_translations": {
                                "ru": "<w>Решительно настроенный</w> студент проводил каждый вечер в библиотеке, чтобы сдать экзамен."
                            }
                        },
                        {
                            "text": "He remained <w>determined</w> to succeed even after several failures.",
                            "target_lang_translations": {
                                "ru": "Он сохранял <w>решимость</w> добиться успеха даже после нескольких неудач."
                            }
                        }
                    ],
                    "synonyms": [
                        "robust"
                    ],
                    "antonyms": [
                        "hesitant",
                        "indecisive",
                        "irresolute"
                    ],
                    "common_phrases": [
                        "determined to succeed",
                        "determined effort",
                        "grimly determined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принявший твердое решение и полный решимости не менять его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решительный",
                                "target_lang_sense_clarification": "о человеке или его действиях"
                            },
                            {
                                "target_lang_word": "непреклонный",
                                "target_lang_sense_clarification": "твердый в своем решении"
                            },
                            {
                                "target_lang_word": "целеустремленный",
                                "target_lang_sense_clarification": "направленный на достижение цели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93c5cdc8-2249-3694-a6ec-a559fa34178e",
                    "sense_definition": "Simple past and past participle of <w>determine</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>determined</w> that the project was too expensive to continue.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>определил</w>, что проект слишком дорог для продолжения."
                            }
                        },
                        {
                            "text": "The exact cause of the accident has not yet been <w>determined</w> by the police.",
                            "target_lang_translations": {
                                "ru": "Точная причина аварии еще не была <w>установлена</w> полицией."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола determine (определять, устанавливать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определил",
                                "target_lang_sense_clarification": "установил факт или причину"
                            },
                            {
                                "target_lang_word": "установленный",
                                "target_lang_sense_clarification": "выясненный в ходе исследования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}