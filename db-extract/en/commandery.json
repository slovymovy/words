                                                "sense_id": "881d740f-a946-3e84-ac32-5f4dc50c297a",
                                                "text": "„Mehrere Kommenden des Deutschritterordens wurden in einer Ballei, einer Ordensprovinz, zusammengeschlossen.“"
                                            },
                                            {
                                                "example_id": "db63feda-dc99-4e1c-8ba2-f8ed2b3ad731",
                                                "sense_id": "881d740f-a946-3e84-ac32-5f4dc50c297a",
                                                "text": "„Die Männer zogen zur Kommende der Templer und fanden diese gänzlich unvorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
