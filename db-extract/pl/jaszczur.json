                        ],
                        "examples": [],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "7f0c8ae8-e541-35f9-97b8-3f1ea61e06e7",
                        "entry_id": "45e3a489-75f1-3dca-bf05-a2a39d80e104",
