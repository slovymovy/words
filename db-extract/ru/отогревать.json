                                        "sense_id": "76b3b1a4-68f5-33d4-80dc-8c4615925059",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To give emotional warmth to a person."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db4560f-2dc9-43f4-8c56-a1c888bc0738",
                                                "sense_id": "76b3b1a4-68f5-33d4-80dc-8c4615925059",
                                                "text": "That is just the way God tells me this book is His Word. I read it, and it warms me and gives me light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed88bb6d-f3a4-32f7-b642-66b362dc3ba6",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To beat or spank."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57c28aef-d5db-4e78-979f-c0c445d0e7dc",
                                                "sense_id": "ed88bb6d-f3a4-32f7-b642-66b362dc3ba6",
                                                "text": "Not bothering to turn around and not missing a mouthful, Myrtle comforted her with threats of \"I'll warm your bottom\"; \"I'll turn you over to your dad\"; \"I'll lock you in the truck\"; \"I'll send for the bogey man\" — all of which Darleen ignored […]"
                                            }
                                        ]
