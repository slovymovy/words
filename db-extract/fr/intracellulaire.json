                        "glosses": [
                            "Qui est à l’intérieur des cellules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "572e274c-a9b4-498b-a4d8-e6c4b69600f9",
                                "sense_id": "26fd0b7a-7a78-3491-88d2-8eef94a7aff4",
                                "text": "L’hyperaccumulation reposerait quant à elle sur la synthèse de chélateurs intracellulaires, molécules capables de se lier aux métaux et de les immobiliser."
                            },
                            {
                                "example_id": "6d27ee5e-686c-43f4-95dc-4ccc7cb92284",
                                "sense_id": "26fd0b7a-7a78-3491-88d2-8eef94a7aff4",
                                "text": "Cette vitamine soluble dans l’eau a pour effet de désélectroniser, neutralisant les radicaux libres et protégeant les structures intracellulaires du stress oxydatif."
                            }
                        ]
                    }
