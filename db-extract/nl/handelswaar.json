                "translations": [
                    {
                        "translation_id": "dac55ea5-d47a-4fab-a1f5-0dc11bb83840",
                        "source_entry_id": "eee31e94-ca24-3003-9241-d59f9f724733",
                        "source_sense_id": "855b3931-f0b7-3dc6-885e-c44d08210d0b",
                        "target_lang_word": "Handelsware",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handelsware",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                        "entry_id": "3fc65ec8-76fa-393e-a878-a5eba3d90f21",
                                        "glosses": [
                                            "gehandelte Ware"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922d5644-e2cd-4727-8d68-1cc2af9b8a48",
                                                "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                                "text": "„Sie hatten oft aber auch große Mengen Lebensmittel in ihrem Gepäck, teils als Handelsware, teils als Reiseproviant.“"
                                            },
                                            {
                                                "example_id": "0c22aa2f-af22-4a4e-aa65-de4ef62b28cd",
                                                "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                                "text": "„Für die Hersteller dieser Handelswaren sind das gerade in Corona-Zeiten empfindliche Nadelstiche, die einige von ihnen – etwa die Hummer-Fischer – an den Rand des Ruins treiben.“"
                                            },
                                            {
                                                "example_id": "a4ae748f-3df2-4684-a038-205462d6878b",
                                                "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                                "text": "„Das Theater sei eine Handelsware wie jede andere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd4a1c7e-ba6a-4cc0-aff7-6027b7d8a316",
                        "source_entry_id": "eee31e94-ca24-3003-9241-d59f9f724733",
                        "source_sense_id": "855b3931-f0b7-3dc6-885e-c44d08210d0b",
                        "target_lang_word": "merchandise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merchandise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae704d8f-15ea-3f8f-941b-033a95dec709",
                                        "entry_id": "269519ce-bd1b-3da1-9bfa-9e1c189ca89a",
                                        "glosses": [
                                            "Goods which are or were offered or intended for sale."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb270f6-068f-4a78-96ba-9b141388759b",
                                                "sense_id": "ae704d8f-15ea-3f8f-941b-033a95dec709",
                                                "text": "Good business depends on having good merchandise."
                                            },
                                            {
                                                "example_id": "c5325f94-f43b-4872-91d5-005d4e522b0a",
                                                "sense_id": "ae704d8f-15ea-3f8f-941b-033a95dec709",
                                                "text": "So, if a Sonne that is by his Father ſent about Merchandize, doe ſinfully miſcarry vpon the Sea; the imputation of his vvickedneſſe, by your rule, ſhould be impoſed vpon his Father that ſent him: […]"
                                            },
                                            {
                                                "example_id": "94b90579-de11-4f67-bb43-abcfadcdb1fe",
                                                "sense_id": "ae704d8f-15ea-3f8f-941b-033a95dec709",
                                                "text": "The custom of giving away merchandise for advertising purposes is greatly on the increase in this country. More goods are now distributed in one year as advertising novelties and as premiums than in a decade 10 or 15 years ago."
                                            },
                                            {
                                                "example_id": "2e9f5381-5255-4490-a506-ab856a686176",
                                                "sense_id": "ae704d8f-15ea-3f8f-941b-033a95dec709",
                                                "text": "It has been stated that Fred Beers is giving free merchandise to this store and I believe you will find that one of your inspectors obtained a bottle of milk free when he purchased some groceries on Thursday Nov. 23rd [1933]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a774cb50-a259-34b4-9811-7bd1d1eda6b8",
                                        "entry_id": "269519ce-bd1b-3da1-9bfa-9e1c189ca89a",
                                        "glosses": [
                                            "Commercial goods connected (branded) with an entity such as a team, band, company, charity, work of fiction, festival, or meme. (Commonly shortened to merch.)"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b0529ad-b5d2-3124-8548-1fb8fe69c908",
                                        "entry_id": "269519ce-bd1b-3da1-9bfa-9e1c189ca89a",
                                        "glosses": [
                                            "A commodity offered for sale; an article of commerce; a kind of merchandise."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c96858-2e5d-4db2-a954-83c81bdb2256",
                                                "sense_id": "3b0529ad-b5d2-3124-8548-1fb8fe69c908",
                                                "text": "Would we then see in what sence heavenly things may be called a merchandise, and in what sence not; this is easy to him that will understand."
                                            },
                                            {
                                                "example_id": "cca667ad-5602-4c98-b2f0-0eaee55e57bc",
                                                "sense_id": "3b0529ad-b5d2-3124-8548-1fb8fe69c908",
                                                "text": "What security was there that she might not be a very unfit person, one who had made a merchandise of her charms, the child itself being the offspring of some accidental connexion?"
                                            },
                                            {
                                                "example_id": "e4766c0d-9f6e-454d-8c3e-a1e8f584c66a",
                                                "sense_id": "3b0529ad-b5d2-3124-8548-1fb8fe69c908",
                                                "text": "Who feeds a flock, and makes not a merchandise of the sheep?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7d927b-6f46-3c57-8797-ce0db4c1bcce",
                                        "entry_id": "269519ce-bd1b-3da1-9bfa-9e1c189ca89a",
                                        "glosses": [
                                            "The act or business of trading; trade; traffic."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "merchandise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8d0906-9d36-3e1f-845e-91248c34380c",
                                        "entry_id": "32db02a3-453d-36a8-a8b9-77af127d2478",
                                        "glosses": [
                                            "To engage in trade; to carry on commerce."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6c69b17-6ab6-30e8-93fe-fd48eec35daf",
                                        "entry_id": "32db02a3-453d-36a8-a8b9-77af127d2478",
                                        "glosses": [
                                            "To engage in in-store promotion of the sale of goods, as by display and arrangement of goods."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f04708b2-c707-40da-ae8f-c846aa22aa4b",
                                                "sense_id": "a6c69b17-6ab6-30e8-93fe-fd48eec35daf",
                                                "text": "He started his career merchandising in a small clothing store chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a400e51-a55b-375f-bf93-2aec5c87adf4",
                                        "entry_id": "32db02a3-453d-36a8-a8b9-77af127d2478",
                                        "glosses": [
                                            "To engage in the trade of."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8397bac4-1ddd-3982-ac31-8426ef79c5b1",
                                        "entry_id": "32db02a3-453d-36a8-a8b9-77af127d2478",
                                        "glosses": [
                                            "To engage in in-store promotion of the sale of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0decec7d-7097-4c76-ab81-6e832a7ec7ff",
                                                "sense_id": "8397bac4-1ddd-3982-ac31-8426ef79c5b1",
                                                "text": "He got hired to merchandise some new sporting goods lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d13b525b-c54e-3e1f-8698-7e18100f526f",
                                        "entry_id": "32db02a3-453d-36a8-a8b9-77af127d2478",
                                        "glosses": [
                                            "To promote as if for sale."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a69bd3b-fca3-4c8f-ac47-0429d492659c",
                                                "sense_id": "d13b525b-c54e-3e1f-8698-7e18100f526f",
                                                "text": "The record companies don't get as good a return on merchandising artists under contract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dabea7a3-0ca4-4c83-af96-7c4901ea8848",
                        "source_entry_id": "eee31e94-ca24-3003-9241-d59f9f724733",
