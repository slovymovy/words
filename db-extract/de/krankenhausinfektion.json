                "senses": [
                    {
                        "sense_id": "c01b30ee-efa2-32d6-98d5-f72fa6eb4dd7",
                        "entry_id": "fbdce960-0b9c-38ca-b697-9b766d3e650b",
                        "glosses": [
                            "Ansteckung mit einem Erreger in einer medizinischen Einrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38aba358-1bd8-4d15-a166-cf66c7aa175b",
                                "sense_id": "c01b30ee-efa2-32d6-98d5-f72fa6eb4dd7",
                                "text": "„Mit einem Hygiene-Förderprogramm sollen gefährliche Krankenhausinfektionen eingedämmt werden.“"
                            },
                            {
                                "example_id": "1b99c9ba-ed0f-4abe-93d8-141ba882a76e",
                                "sense_id": "c01b30ee-efa2-32d6-98d5-f72fa6eb4dd7",
                                "text": "„Ein weiterer Schwerpunkt des Kongresses wird die Bekämpfung von Krankenhausinfektionen sein. Die zunehmende Ausbreitung von Krankheitserregern, die gegen Antibiotika resistent sind, erfordert neue Antiinfektiva und eine effektive Eindämmung resistenter Bakterien.“"
                            },
                            {
                                "example_id": "bab5538a-5ab3-4b2d-a598-847b6ece976c",
                                "sense_id": "c01b30ee-efa2-32d6-98d5-f72fa6eb4dd7",
                                "text": "„Sie erlitten dreimal so häufig Krankenhausinfektionen, Schlaganfälle, Herzinfarkte oder Nierenversagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
