{
    "word_family": [
        "mud",
        "muddiness",
        "muddily",
        "mudder"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e1c92dc-b994-31cc-89dd-a15a9b984b0f",
                    "sense_definition": "Covered or splashed with, or full of, mud.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dirtiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take off your <w>muddy</w> boots before you walk on the clean carpet.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сними свои <w>грязные</w> ботинки, прежде чем идти по чистому ковру."
                            }
                        },
                        {
                            "text": "The dog ran through a <w>muddy</w> field and now needs a bath.",
                            "target_lang_translations": {
                                "ru": "Собака пробежала через <w>грязное</w> поле, и теперь её нужно искупать."
                            }
                        }
                    ],
                    "synonyms": [
                        "dirty",
                        "filthy"
                    ],
                    "antonyms": [
                        "clean"
                    ],
                    "common_phrases": [
                        "muddy boots",
                        "muddy field",
                        "muddy water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый или забрызганный грязью, или полный грязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "покрытый грязью"
                            },
                            {
                                "target_lang_word": "заляпанный",
                                "target_lang_sense_clarification": "в брызгах грязи"
                            },
                            {
                                "target_lang_word": "испачканный",
                                "target_lang_sense_clarification": "в грязи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd71e9e6-3160-36fd-9dbd-6febc5aed277",
                    "sense_definition": "Of a liquid: containing sediment in suspension; cloudy or turbid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river became <w>muddy</w> after the heavy rain stirred up the silt.",
                            "target_lang_translations": {
                                "ru": "Река стала <w>мутной</w> после того, как сильный дождь поднял ил со дна."
                            }
                        },
                        {
                            "text": "It is difficult to see the fish when the pond water is so <w>muddy</w>.",
                            "target_lang_translations": {
                                "ru": "Трудно увидеть рыбу, когда вода в пруду такая <w>мутная</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloudy",
                        "turbid",
                        "opaque"
                    ],
                    "antonyms": [
                        "clear",
                        "limpid",
                        "transparent"
                    ],
                    "common_phrases": [
                        "muddy river",
                        "muddy liquid"
                    ],
                    "target_lang_definitions": {
                        "ru": "О жидкости: содержащая осадок во взвешенном состоянии; непрозрачная или мутная."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "о воде или жидкости"
                            },
                            {
                                "target_lang_word": "непрозрачный",
                                "target_lang_sense_clarification": "из-за осадка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df18b345-2f16-32f9-ba1e-d6c740d24494",
                    "sense_definition": "Not clear; difficult to understand or perceive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker's explanation was <w>muddy</w> and left the audience feeling confused.",
                            "target_lang_translations": {
                                "ru": "Объяснение оратора было <w>неясным</w> и оставило аудиторию в замешательстве."
                            }
                        },
                        {
                            "text": "We need to clarify the <w>muddy</w> points of the contract before signing it.",
                            "target_lang_translations": {
                                "ru": "Нам нужно прояснить <w>туманные</w> пункты контракта перед его подписанием."
                            }
                        }
                    ],
                    "synonyms": [
                        "unclear",
                        "vague",
                        "muddled"
                    ],
                    "antonyms": [
                        "clear",
                        "lucid",
                        "distinct"
                    ],
                    "common_phrases": [
                        "muddy point",
                        "muddy thinking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неясный; трудный для понимания или восприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "о смысле или объяснении"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "нечетко сформулированный"
                            },
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "сложный для понимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26132dc0-a03f-35ca-8627-427ee114589e",
                    "sense_definition": "Of a colour: not bright; dirty or dull.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mixing too many different paints together resulted in a <w>muddy</w> brown color.",
                            "target_lang_translations": {
                                "ru": "Смешивание слишком большого количества разных красок привело к <w>грязному</w> коричневому цвету."
                            }
                        },
                        {
                            "text": "The old photograph had faded into <w>muddy</w> tones of grey and yellow.",
                            "target_lang_translations": {
                                "ru": "Старая фотография выцвела до <w>тусклых</w> оттенков серого и желтого."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "dingy",
                        "drab"
                    ],
                    "antonyms": [
                        "bright",
                        "vibrant",
                        "vivid"
                    ],
                    "common_phrases": [
                        "muddy color",
                        "muddy complexion"
                    ],
                    "target_lang_definitions": {
                        "ru": "О цвете: не яркий; грязный или тусклый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "о цвете или оттенке"
                            },
                            {
                                "target_lang_word": "тусклый",
                                "target_lang_sense_clarification": "невыразительный"
                            },
                            {
                                "target_lang_word": "землистый",
                                "target_lang_sense_clarification": "о цвете лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a24662c-ca83-3f9a-a77f-fe99781b7087",
                    "sense_definition": "Of sound: indistinct, muffled, or lacking clarity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recording was so <w>muddy</w> that I could barely hear the lyrics.",
                            "target_lang_translations": {
                                "ru": "Запись была такой <w>глухой</w>, что я едва мог разобрать слова песни."
                            }
                        },
                        {
                            "text": "The bass in the speakers is too heavy, making the overall sound <w>muddy</w>.",
                            "target_lang_translations": {
                                "ru": "Басы в колонках слишком сильные, из-за чего общий звук становится <w>нечетким</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "indistinct",
                        "muffled",
                        "fuzzy"
                    ],
                    "antonyms": [
                        "crisp",
                        "clear",
                        "sharp"
                    ],
                    "common_phrases": [
                        "muddy sound",
                        "muddy recording"
                    ],
                    "target_lang_definitions": {
                        "ru": "О звуке: нечеткий, приглушенный или лишенный ясности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "нечеткий",
                                "target_lang_sense_clarification": "о записи или звучании"
                            },
                            {
                                "target_lang_word": "смазанный",
                                "target_lang_sense_clarification": "о звуковом сигнале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5460a461-ceca-3c0d-9c5b-32897b0df159",
                    "sense_definition": "Slightly drunk; tipsy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After two glasses of wine, he felt a bit <w>muddy</w> and decided to stop drinking.",
                            "target_lang_translations": {
                                "ru": "После двух бокалов вина он почувствовал себя слегка <w>хмельным</w> и решил прекратить пить."
                            }
                        },
                        {
                            "text": "He wasn't fully intoxicated, just slightly <w>muddy</w> from the afternoon cocktails.",
                            "target_lang_translations": {
                                "ru": "Он не был мертвецки пьян, просто немного <w>навеселе</w> после дневных коктейлей."
                            }
                        }
                    ],
                    "synonyms": [
                        "tipsy",
                        "fuddled",
                        "buzzed"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe a mild state of drunkenness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка пьяный; подшофе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмельной",
                                "target_lang_sense_clarification": "слегка пьяный"
                            },
                            {
                                "target_lang_word": "навеселе",
                                "target_lang_sense_clarification": "в состоянии легкого опьянения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc7879fa-976f-319b-aacd-bc338d7150db",
                    "sense_definition": "To cover or splash someone or something with mud.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passing car managed to <w>muddy</w> my new white coat.",
                            "target_lang_translations": {
                                "ru": "Проезжавшая мимо машина умудрилась <w>испачкать</w> моё новое белое пальто."
                            }
                        },
                        {
                            "text": "Be careful not to <w>muddy</w> the floor when you come in from the garden.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>заляпай</w> пол, когда будешь заходить из сада."
                            }
                        }
                    ],
                    "synonyms": [
                        "soil",
                        "dirty",
                        "bespatter"
                    ],
                    "antonyms": [
                        "clean",
                        "wash"
                    ],
                    "common_phrases": [
                        "muddy the floor",
                        "muddy one's clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрыть или забрызгать кого-либо или что-либо грязью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испачкать",
                                "target_lang_sense_clarification": "грязью"
                            },
                            {
                                "target_lang_word": "заляпать",
                                "target_lang_sense_clarification": "брызгами грязи"
                            },
                            {
                                "target_lang_word": "загрязнить",
                                "target_lang_sense_clarification": "сделать грязным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10a63566-3648-3bcc-9eba-a4be4ca001a5",
                    "sense_definition": "To make a matter or situation more complicated or unclear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding unnecessary details will only <w>muddy</w> the issue further.",
                            "target_lang_translations": {
                                "ru": "Добавление ненужных деталей только сильнее <w>запутает</w> вопрос."
                            }
                        },
                        {
                            "text": "The lawyer's intervention served to <w>muddy</w> the waters of the investigation.",
                            "target_lang_translations": {
                                "ru": "Вмешательство адвоката послужило тому, чтобы <w>замутить</w> воду в расследовании."
                            }
                        }
                    ],
                    "synonyms": [
                        "complicate",
                        "obscure",
                        "confuse"
                    ],
                    "antonyms": [
                        "clarify",
                        "simplify"
                    ],
                    "common_phrases": [
                        "muddy the waters",
                        "muddy the issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать вопрос или ситуацию более сложной или неясной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутать",
                                "target_lang_sense_clarification": "ситуацию или вопрос"
                            },
                            {
                                "target_lang_word": "затуманить",
                                "target_lang_sense_clarification": "сделать менее ясным"
                            },
                            {
                                "target_lang_word": "омрачить",
                                "target_lang_sense_clarification": "усложнить понимание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b175c881-50d8-373d-a091-d6ca2fe3cece",
                    "sense_definition": "The edible mud crab or mangrove crab (Scylla serrata).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the coast to catch some <w>muddies</w> for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на побережье, чтобы наловить <w>грязевых крабов</w> на ужин."
                            }
                        },
                        {
                            "text": "The <w>muddy</w> is a popular seafood delicacy in many tropical regions.",
                            "target_lang_translations": {
                                "ru": "<w>Грязевой краб</w> — популярный деликатес из морепродуктов во многих тропических регионах."
                            }
                        }
                    ],
                    "synonyms": [
                        "mud crab",
                        "mangrove crab"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Australia and Southeast Asia"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal name for the mud crab"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобный грязевой краб или мангровый краб (Scylla serrata)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязевой краб",
                                "target_lang_sense_clarification": "вид краба"
                            }
                        ]
                    }
                }
            ]
        }
    ]
