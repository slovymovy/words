                                    }
                                ]
                            },
                            {
                                "target_word": "sprießen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2007cc77-6433-3187-bef1-552ce5516a3e",
                                        "entry_id": "1e6ccb4d-5ff0-3321-8150-14b2e03a96bd",
                                        "glosses": [
                                            "senkrecht stehende Teile seitlich abstützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457e1786-00ae-4f97-94d2-1c0391223cc7",
                                                "sense_id": "2007cc77-6433-3187-bef1-552ce5516a3e",
                                                "text": "Die Gräben müssen fachgerecht gespriesst, in Schichten von max. 40 cm aufgefüllt und maschinell verdichtet werden."
                                            },
                                            {
                                                "example_id": "40978dab-f1d2-400b-8f3d-87265ff876cd",
                                                "sense_id": "2007cc77-6433-3187-bef1-552ce5516a3e",
