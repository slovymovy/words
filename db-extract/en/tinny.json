                        "entry_id": "8f3711c1-9b20-3942-8dbf-99aadb14a90d",
                        "glosses": [
                            "Of or pertaining to or resembling tin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b995afb1-1664-4ac5-8936-f472e7b8468c",
                                "sense_id": "0527d79f-478e-3551-b4c9-205c23f7c481",
                                "text": "The object had a tinny appearance."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fb51cd8-3204-377e-befc-378edd1e9f11",
                        "entry_id": "8f3711c1-9b20-3942-8dbf-99aadb14a90d",
                        "glosses": [
                            "Pertaining to the thinness and cheapness of tin or similar-looking metals, in contrast to a heavier, more valuable metal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6804e1d9-8023-4cf1-9ab9-e5488d40662f",
                                "sense_id": "7fb51cd8-3204-377e-befc-378edd1e9f11",
                                "text": "The shop was filled with tinny tourist geegaws."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7bf6542-129b-3a06-af65-e045a75ce3e9",
                        "entry_id": "8f3711c1-9b20-3942-8dbf-99aadb14a90d",
                        "glosses": [
                            "Pertaining to a thin, unpleasant sound recalling that of tin being rapped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc812a8-ba69-4f65-b5d7-b3394b935f94",
                                "sense_id": "a7bf6542-129b-3a06-af65-e045a75ce3e9",
                                "text": "The piano was not simply out of tune, but had become downright tinny."
                            },
                            {
                                "example_id": "6053565c-bdde-4357-88f8-afbe4cbce1db",
                                "sense_id": "a7bf6542-129b-3a06-af65-e045a75ce3e9",
                                "text": "You might find yourself listening to the sound your car door makes when it shuts. Is it a cheap tinny sound or a strong clunky sound like the VW?"
                            },
                            {
                                "example_id": "6a38e745-04ff-4039-ab25-6b885916244e",
                                "sense_id": "a7bf6542-129b-3a06-af65-e045a75ce3e9",
                                "text": "The wails of the injured and the roars of the dead-on-the-march overwhelmed the tinny speakers in the cell, and they all watched as nearly one thousand people reduced themselves to a few frantic hundred in less than an hour, then settled into a sustained orgy of battery, rapine and rape with no end in sight but the total depopulation of the entire facility."
                            }
                        ]
                    }
