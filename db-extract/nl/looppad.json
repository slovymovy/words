                "senses": [
                    {
                        "sense_id": "b2ec3899-402c-3d8a-8b17-6ab66bf02a12",
                        "entry_id": "cfb45401-0280-3e5e-9d3e-8dbd35f84ed1",
                        "glosses": [
                            "een pad waarover je kunt lopen, een pad dat ongeschikt is voor andere vervoersmiddelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abb27b17-3f65-4022-b5e1-4f38db87600c",
                                "sense_id": "b2ec3899-402c-3d8a-8b17-6ab66bf02a12",
                                "text": "Opvallend is dat de kajuit een beetje excentrisch is geplaatst. Dat houdt in dat je aan stuurboord via het gangboord prima naar voren kunt lopen, maar aan bakboord wordt dit vanwege het smalle looppad lastig."
                            },
                            {
                                "example_id": "703a0fd7-4020-4dda-9fd3-0045d18d6c68",
                                "sense_id": "b2ec3899-402c-3d8a-8b17-6ab66bf02a12",
                                "text": "Op verzoek van de gemeente werkt het Leger des Heils aan huisregels die ervoor moeten zorgen dat de scholieren zo min mogelijk worden geconfronteerd met de 24 bewoners van de opvang. Zo komen de twee groepen niet gelijktijdig buiten en gebruiken ze een ander looppad op het terrein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eae3033a-1708-4f66-8569-fa976d43926e",
                        "source_entry_id": "cfb45401-0280-3e5e-9d3e-8dbd35f84ed1",
                        "source_sense_id": "b2ec3899-402c-3d8a-8b17-6ab66bf02a12",
                        "target_lang_word": "walkway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walkway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4121244-550d-3a46-9502-624f52d7c9a4",
                                        "entry_id": "e921cb4f-6bb3-3f6b-b744-903ffa8a5c7b",
                                        "glosses": [
                                            "A clearly defined path for pedestrians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86de4f7e-5ae9-4b34-9be1-2688315d096c",
                                                "sense_id": "d4121244-550d-3a46-9502-624f52d7c9a4",
                                                "text": "The slope [at Bank station, Waterloo & City] was always resented, especially on Monday morning, and it was supplemented by the installation of the Underground's first Trav-o-lator - or moving walkway - in 1960."
                                            },
                                            {
                                                "example_id": "88ab06b5-0eab-4baa-8dc2-7658036b727b",
                                                "sense_id": "d4121244-550d-3a46-9502-624f52d7c9a4",
                                                "text": "SDCC is crowded enough without a few hundred more chuds in rascal scooters cutting in line and taking up space on the public walkways because they heard the cast of The Big Bang Theory was going to be here or something."
                                            },
                                            {
                                                "example_id": "a3eb0f9a-b3d8-4f80-a7e3-d3e15995f758",
                                                "sense_id": "d4121244-550d-3a46-9502-624f52d7c9a4",
                                                "text": "Walkways and handrails were also upgraded during the work, to improve safety for maintenance staff."
                                            },
                                            {
                                                "example_id": "41511e47-4f33-4521-9588-9dd5878a1e96",
                                                "sense_id": "d4121244-550d-3a46-9502-624f52d7c9a4",
                                                "text": "The funding will allow state and city officials to devise a community-driven plan to cap parts of the 6.5-mile expressway with structures that could reduce traffic noise and contain green space, pedestrian walkways and air filtration systems."
                                            },
                                            {
                                                "example_id": "a07a5ed1-838b-40aa-85f5-cb7bf5a858cd",
                                                "sense_id": "d4121244-550d-3a46-9502-624f52d7c9a4",
                                                "text": "For now, the walkway will remain bare, although there are plans for it to be used to exhibit art and relics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
