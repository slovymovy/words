                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "67b7a918-e7f3-473f-8c65-091370ac3661",
                                "sense_id": "29f18c04-09f4-369c-8fe9-cb1f685d2efa",
                                "text": "Сия азбука, называемая Кирилловскою, доныне употребляется с некоторыми переменами в России, Валахии, Молдавии, Болгарии, Сервии и проч."
                            },
                            {
                                "example_id": "84c326ec-3c35-4244-9c11-60599e97e4d2",
                                "sense_id": "29f18c04-09f4-369c-8fe9-cb1f685d2efa",
                                "text": "Втиральники бывают с косой нарезкой и с прямой, плоские и круглые, употребляются от крупных до величины с иголку."
                            }
                        ]
                    }
