                        "examples": [
                            {
                                "example_id": "95a393b8-07ca-4a83-9a5f-03e6622acd50",
                                "sense_id": "9097a97c-c200-37a4-8abb-85ccac314bd6",
                                "text": "Vader bekeek nooit mijn rapport, maar af en toe vroeg hij heel stillekes ‘speel j'altemets nog ne keer klarinette?’"
                            }
                        ]
                    },
                    {
                        "sense_id": "2c084a3e-6b71-3e66-a43c-40616d7eeaad",
                        "entry_id": "dfcadca3-b9eb-38ac-828e-9b52df17fdcb",
                        "glosses": [
                            "af en toe, zo nu en dan"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "287242cd-2f2e-4206-bd55-ce2492c45461",
                                "sense_id": "2c084a3e-6b71-3e66-a43c-40616d7eeaad",
                                "text": "Maar dezen onverlet, zo blijven onze gronden,\nAl wordt er altemets een kloeke maagd gevonden,\nEén bloeme, zo men zeit, en maakt geen rozenkrans,\nEén snare geen gespel, één vrijster genen dans.\nGod heeft dan aan den man een hoger aard gegeven,\nEn aan het wijf gelast om onder hem te leven."
                            }
                        ]
                    }
