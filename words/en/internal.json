                        "zh": [
                            {
                                "target_lang_word": "内部的",
                                "target_lang_sense_clarification": "机构或组织内部使用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc478e8-b426-31db-91b8-55e7bec97641",
                    "sense_definition": "Concerned with the domestic affairs of a country rather than foreign relations.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to resolve the country's <w>internal</w> conflicts peacefully.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается мирным путем разрешить <w>внутренние</w> конфликты в стране.",
                                "zh": "政府正试图和平解决该国的<w>国内</w>冲突。"
                            }
                        },
                        {
                            "text": "She works for the ministry of <w>internal</w> affairs.",
                            "target_lang_translations": {
                                "ru": "Она работает в министерстве <w>внутренних</w> дел.",
                                "zh": "她在<w>内政</w>部工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interior"
                    ],
                    "antonyms": [
                        "external",
                        "exterior"
                    ],
                    "common_phrases": [
                        "internal affairs",
                        "internal security",
                        "internal market",
                        "internal conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с делами внутри страны, а не с международными отношениями.",
                        "zh": "涉及国家国内事务而非外交关系的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "внутригосударственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "国内的",
                                "target_lang_sense_clarification": "国家内部事务的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "229ca09d-4149-357f-8982-dbff09a8918a",
                    "sense_definition": "Existing or experienced in the mind; not expressed to others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She fought an <w>internal</w> battle between her duty and her desires.",
                            "target_lang_translations": {
                                "ru": "Она вела <w>внутреннюю</w> борьбу между долгом и желаниями.",
                                "zh": "她在责任与欲望之间进行了<w>内心</w>挣扎。"
                            }
                        },
                        {
                            "text": "His calm face hid his <w>internal</w> feelings of panic.",
                            "target_lang_translations": {
                                "ru": "Его спокойное лицо скрывало <w>внутреннее</w> чувство паники.",
                                "zh": "他平静的面容掩盖了<w>内心</w>的恐慌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inner"
                    ],
                    "antonyms": [
                        "external"
                    ],
                    "common_phrases": [
                        "internal monologue",
                        "internal struggle",
                        "internal thoughts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в мыслях или чувствах; не выраженный внешне.",
                        "zh": "存在于思想或情感中，未向他人表达的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "душевный, скрытый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内心的",
                                "target_lang_sense_clarification": "心理或精神层面的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a619caa-5d29-3491-bdd6-9949e0e8c38d",
                    "sense_definition": "Relating to the essential nature or inherent character of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intrinsic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theory was criticized for lacking <w>internal</w> consistency.",
                            "target_lang_translations": {
                                "ru": "Теорию критиковали за отсутствие <w>внутренней</w> согласованности.",
                                "zh": "该理论因缺乏<w>内在</w>一致性而受到批评。"
                            }
                        },
                        {
                            "text": "We must understand the <w>internal</w> logic of the system before changing it.",
                            "target_lang_translations": {
                                "ru": "Мы должны понять <w>внутреннюю</w> логику системы, прежде чем менять её.",
                                "zh": "在修改系统之前，我们必须理解其<w>内在</w>逻辑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intrinsic",
                        "inherent"
                    ],
                    "antonyms": [
                        "external"
                    ],
                    "common_phrases": [
                        "internal logic",
                        "internal consistency",
                        "internal contradiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к самой сути или неотъемлемому характеру чего-либо.",
                        "zh": "与事物的本质或固有特征有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "сущностный, присущий чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内在的",
                                "target_lang_sense_clarification": "事物固有的逻辑或本质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}