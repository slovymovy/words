        "fr-extract.jsonl": [
            {
                "entry_id": "a7422e78-53d1-3a3b-b3d6-3c7c252c65e5",
                "word": "galuchat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0dc10efd-582f-4ec0-a1b6-1e6ccd561e41",
                        "entry_id": "a7422e78-53d1-3a3b-b3d6-3c7c252c65e5",
                        "tags": [
                            "plural"
                        ],
                        "form": "galuchats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                        "entry_id": "a7422e78-53d1-3a3b-b3d6-3c7c252c65e5",
                        "glosses": [
                            "Peau de certains squales, qu’on emploie pour couvrir des boîtes, des étuis, des fourreaux d’épée, pour faire des sacs de dames, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0736cc2e-c565-493a-8626-d6feb39f7b17",
                                "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                                "text": "Galuchat à gros grains. — Galuchat à petits grains."
                            },
                            {
                                "example_id": "768c009a-aa80-44e8-b348-867c53473c81",
                                "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                                "text": "Le chagrin est fort ancien ! Aujourd’hui les gaîniers préfèrent se servir de galuchat."
                            },
                            {
                                "example_id": "d55b0651-60d2-43ee-96c8-118895287606",
                                "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                                "text": "Après avoir cherché quelque temps, je découvris un petit coffret de galuchat, soigneusement dissimulé sous du linge."
                            },
                            {
                                "example_id": "f9640f5f-b3ba-4a60-a757-1cb7fdede127",
                                "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                                "text": "6 mai 43 – Il est vrai qu’elle aura le lit de galuchat, puisque nous n’avons pas mérité de coucher dans une conque marine. Papa nous a commandé un lit comme tout le monde chez Darrac."
                            },
                            {
                                "example_id": "84e6897a-520b-4c7b-8766-36f364de4e7e",
                                "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                                "text": "… cette paire de gants … qu'il a sortie d'une boîte en galuchat …."
                            },
                            {
                                "example_id": "0651ca01-cd59-43f9-960f-1346a96ffe3a",
                                "sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                                "text": "En contemplant, plus souvent qu'il ne faudrait, cette photographie noir et blanc qui trône toujours dans son cadre de galuchat sur l'une des étagères de ma bibliothèque …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13a0a5de-3fa5-420c-b969-e4208023c7eb",
                        "source_entry_id": "a7422e78-53d1-3a3b-b3d6-3c7c252c65e5",
                        "source_sense_id": "5d286792-458e-3a44-9919-e9f92fab5a41",
                        "target_lang_word": "shagreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shagreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                        "entry_id": "2ae9d273-dbe4-35f0-8174-91eb804880b7",
                                        "glosses": [
                                            "An untanned leather, often dyed green; originally made from horse skin, today mostly made from the skin of a shark or ray."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d5ef2b-1332-4043-b174-149c324200fd",
                                                "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                                "text": "The following day the treasures of the mysterious tower came pouring in: pictures, statues, gems, shells, china, stuffed beasts and birds, tables, vases, petrifactions, arms, mandarins, &c. &c.; and among them the shagreen skin, with the injunction, \"Sell it for any thing—nothing—give it away; only, get rid of it.\""
                                            },
                                            {
                                                "example_id": "4f091c9b-b677-4060-85ac-0d7466ad58b3",
                                                "sense_id": "3e2ec98d-83ae-3d9e-a348-e661f8ac9622",
                                                "text": "On the old lecturn or reading-stand which he used for his heavier tomes, The Testaments of Carnamagos, in its covers of shagreen with hasps of human bone, lay open at the very page which had frightened him so unreasonably with its eldritch intimations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                        "entry_id": "2ae9d273-dbe4-35f0-8174-91eb804880b7",
                                        "glosses": [
                                            "A rough or spiny surface of an insect's cuticle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7801cd88-2d05-4ca7-b4f9-6938bd556fee",
                                                "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                                "text": "If the shagreen dots be carefully observed they will be found to possess an annular arrangement."
                                            },
                                            {
                                                "example_id": "58a0e3d1-11c7-42fb-9d12-4caf43e505a6",
                                                "sense_id": "56b99a07-3c12-3878-a088-f28109c0be93",
                                                "text": "The shagreen of the abdominal tergites generally consists of small spinules, singly or in caudally convex arcs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shagreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223e80a3-415f-33d4-a509-80d4d3f7d2af",
                                        "entry_id": "c671890c-f6ea-3ac3-a2f9-dc2b5eaf98ac",
                                        "glosses": [
                                            "To give a texture resembling shagreen leather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
