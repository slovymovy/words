                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d272010-7b6a-4472-a27a-5dba8637a7d5",
                                                "sense_id": "d3c7dcef-7728-3a82-9a12-b420d4c4b9bf",
                                                "text": "Prosiłam go, żeby przestał, ale on nie posłuchał i dalej głośno rozmawiał."
                                            },
                                            {
                                                "example_id": "c739443f-3949-4b22-aea0-c2ad6032f801",
                                                "sense_id": "d3c7dcef-7728-3a82-9a12-b420d4c4b9bf",
                                                "text": "Eksperci twierdzą, że ceny benzyny będą dalej rosły i mogą wkrótce pobić kolejny rekord."
                                            },
                                            {
                                                "example_id": "9021c251-52d2-456d-b027-54a8a164c86b",
                                                "sense_id": "d3c7dcef-7728-3a82-9a12-b420d4c4b9bf",
                                                "text": "Przeczytałem ten tekst trzy razy, ale dalej go nie rozumiem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
