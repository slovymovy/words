                ],
                "senses": [
                    {
                        "sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                        "entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                        "glosses": [
                            "kleiner Stand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26b6d10-939b-4859-985c-17dbc7bfa95e",
                                "sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                                "text": "Jeden Samstag verkauft sie an einem Ständchen auf dem Wochenmarkt ihre selbstgemachten Marmeladen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                        "entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                        "glosses": [
                            "kleines Musikstück, das jemandem zu Ehren auf einer Feier oder vor seinem Haus gespielt oder gesungen wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "0faff0f0-95e9-4b5a-8558-f35f7d4fd565",
                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                "text": "Zu Opas 80. Geburtstag haben wir ihn im Krankenhaus mit einem Ständchen überrascht."
                            },
                            {
                                "example_id": "88d51d6c-ec6c-4d26-b050-f785feb5d8aa",
                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                "text": "„Zwar geschah es an diesem Neujahrstag sozusagen vor der falschen Verwandtschaft, der Verwandtschaft mütterlicherseits, doch ich holte das missglückte Ständchen zum Geburtstag des falschen Großvaters in Rüpprich nun in Dondorf nach.“"
                            },
                            {
                                "example_id": "a5775f18-a09c-49b2-b4c2-108f9e0bc276",
                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                "text": "„Sie glaubt, das Ständchen gelte ihr.“"
                            },
                            {
                                "example_id": "d32a935a-a513-4d50-b96a-acd4659dfdc9",
                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                "text": "„Ich schlummere süß und werde mit Blockflötentönen geweckt – Heinrike spielt ein Ständchen vor der Tür.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27678c17-5738-4dff-aff1-b8b75ed8b51d",
                        "source_entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                        "source_sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                        "source_sense_description": "kleiner Stand",
                        "target_lang_word": "serenade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serenade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a55612d4-be10-33b6-8d1a-04df1a1ac147",
                                        "entry_id": "1fb01ba3-a5cb-39ca-92f9-a2072a3151f9",
                                        "glosses": [
                                            "A love song that is sung directly to one's love interest, especially one performed below the window of a loved one in the evening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38fb16fa-ba1f-4a90-9aa3-14f4569beb90",
                                                "sense_id": "a55612d4-be10-33b6-8d1a-04df1a1ac147",
                                                "text": "From me to thee glad serenades, / Dances for thee I propose saluting thee, adornments and feastings for thee, / And the sights of the open landscape and the high-spread sky are fitting, / And life and the fields, and the huge and thoughtful night."
                                            },
                                            {
                                                "example_id": "1000066d-bd88-44bb-81e1-11c3d473c728",
                                                "sense_id": "a55612d4-be10-33b6-8d1a-04df1a1ac147",
                                                "text": "A lovestruck Romeo sings the streets a serenade / Laying everybody low with a love song that he made"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d37919af-fcc2-3009-a6af-a928e9c5cc3a",
                                        "entry_id": "1fb01ba3-a5cb-39ca-92f9-a2072a3151f9",
                                        "glosses": [
                                            "An instrumental composition in several movements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a128cda1-d44c-407c-9372-d9d808d95d14",
                                                "sense_id": "d37919af-fcc2-3009-a6af-a928e9c5cc3a",
                                                "text": "“Eine kleine Nachtmusik” is a well-known serenade written by Mozart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serenade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d91814a-5fcc-341e-8805-08ef3e74f761",
                                        "entry_id": "18facc85-a139-3c78-8033-6c85c8aa62d0",
                                        "glosses": [
                                            "To sing or play a serenade for (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d7610da-2c2a-4dc3-916d-b1c3aeef38c9",
                                                "sense_id": "0d91814a-5fcc-341e-8805-08ef3e74f761",
                                                "text": "The Southampton striker, who also struck a post late on, was being serenaded by the Wembley crowd before the end and should probably brace himself for some Lambert-mania over the coming days but, amid the eulogies, it should not overlook the deficiencies that were evident in another stodgy England performance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a87704fa-6f28-47d3-b07d-3d74b2a73643",
                        "source_entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                        "source_sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                        "source_sense_description": "kleiner Stand",
                        "target_lang_word": "sérénade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérénade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "feb12435-2faa-3c50-83f6-8770d033cbfd",
                                        "entry_id": "d2ddf9f3-2dc8-3057-b37c-5c91be560827",
                                        "glosses": [
                                            "Concert de voix ou d’instruments, que l’on donne le soir, la nuit, dans la rue sous les fenêtres de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c615fa6-5ea5-4050-acd7-39c21aeed195",
                                                "sense_id": "feb12435-2faa-3c50-83f6-8770d033cbfd",
                                                "text": "À quoi pouvait-il s’attendre, si ce n’est à trouver sa maîtresse agréablement engagée avec un rival à son retour, et à voir sa sérénade, comme on l’appelle, aussi mal reçue que le miaulement d’un chat dans la gouttière ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae1132f2-a8e5-3b1d-91bd-3665ea2f29ce",
                                        "entry_id": "d2ddf9f3-2dc8-3057-b37c-5c91be560827",
                                        "glosses": [
                                            "Composition musicale, le plus souvent instrumentale, de forme libre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e23fcae-f016-43cd-82b8-3532554d3707",
                                                "sense_id": "ae1132f2-a8e5-3b1d-91bd-3665ea2f29ce",
                                                "text": "Les sérénades de Mozart, de Beethoven."
                                            }
                                        ]
                                    }
                                ]
                            },
