                                    },
                                    {
                                        "sense_id": "f48ddcc6-4827-3eaa-ae7b-f8dbaf56197d",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "A feeling of completeness; the experience of an emotional conclusion, usually to a difficult period."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a6abd1-e722-4fa7-8e8a-1b50d2206cbc",
                                                "sense_id": "f48ddcc6-4827-3eaa-ae7b-f8dbaf56197d",
                                                "text": "In crowded rooms, and I keep lookin' for closeness / Maybe I'll never get closure"
                                            },
                                            {
                                                "example_id": "1369d093-c84e-4af4-8cd8-8c2bbdba1ca6",
                                                "sense_id": "f48ddcc6-4827-3eaa-ae7b-f8dbaf56197d",
                                                "text": "to find emotional closure"
                                            },
                                            {
                                                "example_id": "c23397d0-d228-42f7-8077-af97ddb82f88",
                                                "sense_id": "f48ddcc6-4827-3eaa-ae7b-f8dbaf56197d",
                                                "text": "In Israel, a state commission of inquiry is not merely a judicial instrument or a means of settling facts. It’s a ritual of national closure that allows people to put events in order and move on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c173fe-d2ca-30f3-9f6b-31b1bf677a5b",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "A device to facilitate temporary and repeatable opening and closing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76502102-58a8-3208-af15-cfc85c6bfca1",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "An abstraction that represents a function within an environment, a context consisting of the variables that are both bound at a particular time during the execution of the program and that are within the function's scope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c9bb06d-4a5e-4502-8655-0dfbc04213cb",
                                                "sense_id": "76502102-58a8-3208-af15-cfc85c6bfca1",
                                                "text": "Instead, make f and g input arguments, and use the closure around the inner function so that this code works with any two functions that you provide. Closures are important features that work amazingly well with higher-order functions; I’ll review them in section 4.4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6050714d-e68e-3bae-be38-8b563ed3f1cd",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The smallest set that both includes a given subset and possesses some given property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2463efdf-bac0-3ed8-b8c0-fccab3f41519",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The smallest closed set which contains the given set."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68871454-3e91-45a8-9224-d4254af70b37",
                                                "sense_id": "2463efdf-bac0-3ed8-b8c0-fccab3f41519",
                                                "text": "7 THEOREM The closure of any set is the union of the set and the set of its accumulation points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25dcec8b-4dda-3830-a66f-2fe2db08c006",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The act of shutting; a closing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbe38779-9326-4bcb-bdc6-f525ab321fd9",
                                                "sense_id": "25dcec8b-4dda-3830-a66f-2fe2db08c006",
                                                "text": "the closure of a door, or of a chink"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07307a31-2cc3-3b3f-8b03-b8302cc9970e",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The act of shutting or closing something permanently or temporarily."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87874224-a58c-430c-93fd-6d549f3f4d5f",
                                                "sense_id": "07307a31-2cc3-3b3f-8b03-b8302cc9970e",
                                                "text": "The closure of Hammersmith Bridge means road traffic has to use Chiswick and Putney Bridges instead."
                                            },
                                            {
                                                "example_id": "2d36a16a-1792-4330-80c7-e9ffb407ab2e",
                                                "sense_id": "07307a31-2cc3-3b3f-8b03-b8302cc9970e",
                                                "text": "Those who have advocated the closure of the G.C. have so far failed to say by which alternative route this North-to-West traffic could be carried."
                                            },
                                            {
                                                "example_id": "005946f4-9b10-48d3-a585-5051a8ca3789",
                                                "sense_id": "07307a31-2cc3-3b3f-8b03-b8302cc9970e",
                                                "text": "Despite the line proving to be a useful strategic route for men and supplies to the British naval fleets stationed at Scapa Flow in both world wars, the Duke's legacy looked to have passed into history when it was listed for closure in the infamous Beeching report."
                                            },
                                            {
                                                "example_id": "52cd0507-874b-4c2c-b2a2-2cbe11b4fbda",
                                                "sense_id": "07307a31-2cc3-3b3f-8b03-b8302cc9970e",
                                                "text": "Schrinner has since said the closures are needed to assess storm damage and to build the case for a major bridge restoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92d540b0-e615-3079-948c-5144433016d5",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "That which closes or shuts; that by which separate parts are fastened or closed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abf1a47-b309-44db-b598-9055e7e007a8",
                                                "sense_id": "92d540b0-e615-3079-948c-5144433016d5",
                                                "text": "1729 November 28, Alexander Pope, Letter to Jonathan Swift, 1824, The Works of Jonathan Swift: Containing Additional Letters, Volume 17, 2nd Edition, page 284,\nI admire on this consideration your sending your last to me quite open, without a seal, wafer, or any closure whatever, manifesting the utter openness of the writer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c312bca4-526c-3a41-9ca3-3c2c6d79b051",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "That which encloses or confines; an enclosure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131ad92a-2022-471d-84f9-cc513130e7d6",
                                                "sense_id": "c312bca4-526c-3a41-9ca3-3c2c6d79b051",
                                                "text": "O thou bloody prison […] / Within the guilty closure of thy walls / Richard the Second here was hacked to death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6448234c-f3bb-3de6-bcff-3efe1b49a0e5",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "A method of ending a parliamentary debate and securing an immediate vote upon a measure before a legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4cd7b3b-f55c-33bb-8d23-4f2aa2adff2c",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The phenomenon by which a group maintains its resources by the exclusion of others based on various criteria. ᵂᵖ"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "606aa5ca-940e-336d-b9b4-71d20b86554c",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The process whereby the reader of a comic book infers the sequence of events by looking at the picture panels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bfc39b2-b37f-4519-9d43-cb1b0d927f3c",
                                                "sense_id": "606aa5ca-940e-336d-b9b4-71d20b86554c",
                                                "text": "The comic book reader performs closure within each panel, between panels, and among panels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "475e9476-e31f-3966-a849-9532000da80c",
                                        "entry_id": "147e995c-1bbe-35a2-97a4-03402055a351",
                                        "glosses": [
                                            "The element of packaging that closes a container."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "closure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "657839d5-c3dc-3ea7-a061-9b662d7356ec",
                                        "entry_id": "5469b0d2-87f9-3251-96ee-6747fdcefee3",
                                        "glosses": [
                                            "To end the parliamentary debate on (an issue) by closure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bbe9928-87b3-4100-b951-c1c25368c5e3",
                                                "sense_id": "657839d5-c3dc-3ea7-a061-9b662d7356ec",
                                                "text": "At any time they could have stopped discussion by closuring amendments and by closuring the clause under discussion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
