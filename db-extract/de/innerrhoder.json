                "senses": [
                    {
                        "sense_id": "b65024b9-b6fa-3de7-9222-7bfc7d1152ab",
                        "entry_id": "ce2e92b3-f511-3bc1-8952-890a8575a08c",
                        "glosses": [
                            "jemand, der dem (Halb-)Kanton Appenzell Innerrhoden angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4820710-4019-41fb-89fa-56d95bf5ef7b",
                                "sense_id": "b65024b9-b6fa-3de7-9222-7bfc7d1152ab",
                                "text": "„Das sehen die Innerrhoder anders: ‹Nacktwandern widerspricht den grundlegenden Sitten, da auch viele Goofen (Innerrhoder Dialekt für Kinder) damit konfrontiert werden›, sagte ein Ratsherr.“"
                            },
                            {
                                "example_id": "ce98da6d-b603-4340-b237-a6b1bd69226d",
                                "sense_id": "b65024b9-b6fa-3de7-9222-7bfc7d1152ab",
                                "text": "„Den stärksten Aufschlag haben die Innerrhoder zu verkraften, nicht nur bei den Erwachsenen, sondern auch bei den jungen Leuten und bei den Kinderprämien.“"
                            },
                            {
                                "example_id": "13fd6277-6d67-431b-9907-077dabe7f3d2",
                                "sense_id": "b65024b9-b6fa-3de7-9222-7bfc7d1152ab",
                                "text": "„Mit diesem rhetorischen Stossseufzer eröffnete der Innerrhoder Carlo Schmid im Dezember 1999 im Ständerat eine neue Legislaturperiode.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
