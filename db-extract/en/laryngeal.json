            {
                "entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                "word": "laryngeal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8293e235-8021-3492-b49f-3d9264134b3b",
                        "entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                        "glosses": [
                            "Of or pertaining to the larynx."
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "6d613061-d37a-45cc-b3b1-6689ccd789c3",
                                "sense_id": "8293e235-8021-3492-b49f-3d9264134b3b",
                                "text": "At sight of it there commenced a series of laryngeal spasms, with clutchings at his throat, far more violent than any I had heretofore seen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d364a65-5604-310a-a38e-ae702781524a",
                        "entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                        "glosses": [
                            "(of a speech sound) Made by or with constriction of the larynx with only the front part of the vocal cords vibrating, giving a very low frequency and producing what is known as \\\"creaky voice.\\"
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9776937c-673e-45de-8611-fbf63ad3bd56",
                        "source_entry_id": "c8f01e17-a22d-3b3f-86c8-a8316f494277",
                        "source_sense_description": "of or pertaining to larynx",
                        "target_lang_word": "hrtanový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hrtanový",
