                                        "entry_id": "57893c7f-78a6-351f-8e8b-c7bcbf0a9ad4",
                                        "glosses": [
                                            "een bord waarop de score van een wedstrijd vermeld wordt, zichtbaar voor iedereen die bij het evenement aanwezig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3bdee7a-d184-4521-b53b-92b8e2465f19",
                                                "sense_id": "23429872-2543-3e44-aa6e-f79499d7b79f",
                                                "text": "Nederland begon goed aan de wedstrijd en nam in de eerste inning meteen een 2-0 voorsprong, onder meer dankzij een homerun van Jurickson Profar. Startwerper Rick van den Hurk wist in de eerste vier innings Zuid-Korea van scoren af te houden, waardoor bij de tegenstander de 0 op het scorebord bleef staan. Ondertussen scoorde Nederland in het tweede bedrijf nog een punt, waardoor het na 2 innings al op een 3-0 voorsprong stond."
                                            }
                                        ]
                                    }
                                ]
                            }
