                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ea6753b-3bdd-4248-b52c-9ba0f0398558",
                        "source_entry_id": "f03bd8a8-120f-38cd-a485-d511f0127509",
                        "source_sense_id": "39ea6615-a247-35d4-99de-3eb4ceb6ddec",
                        "target_lang_word": "sharpener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharpener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "827dade0-86fb-3846-ab56-a135a46cd655",
                                        "entry_id": "62986551-2581-313d-b6d9-536e880c49d1",
                                        "glosses": [
                                            "A device for making things sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133e8d99-c39f-4754-b9c7-4d721b0a6501",
                                                "sense_id": "827dade0-86fb-3846-ab56-a135a46cd655",
                                                "text": "There was a pencil sharpener at the front of the classroom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61c0914-cb19-3532-a3d2-062d3cc13d52",
                                        "entry_id": "62986551-2581-313d-b6d9-536e880c49d1",
                                        "glosses": [
                                            "That which makes something sharp."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d08f36-ce32-46e5-a98f-152fc0867b26",
                                                "sense_id": "d61c0914-cb19-3532-a3d2-062d3cc13d52",
                                                "text": "“Sir,” said the shepherd, “poverty is a great sharpener of the wits. […]"
                                            },
                                            {
                                                "example_id": "44f7fe0b-fba2-4950-9cd8-e673485cd18b",
                                                "sense_id": "d61c0914-cb19-3532-a3d2-062d3cc13d52",
                                                "text": "The snuff-box, knife, and chicken-bones were again in requisition, and a pen was successfully formed. The ink, or at least its substitute, was rather more difficult, but necessity is always a sharpener of intellect, and even this was accomplished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1134d66-b4d3-36f6-9fd9-9ab5d4e292d6",
                                        "entry_id": "62986551-2581-313d-b6d9-536e880c49d1",
                                        "glosses": [
                                            "An alcoholic drink taken at the start of the day, or just before a meal."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "659961c0-65b0-47a3-a26e-2f647b1fe37a",
                        "source_entry_id": "f03bd8a8-120f-38cd-a485-d511f0127509",
                        "source_sense_id": "39ea6615-a247-35d4-99de-3eb4ceb6ddec",
                        "target_lang_word": "pencil sharpener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pencil sharpener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f346dacd-18a8-361a-b0fe-5162d0448332",
                                        "entry_id": "2bcda1a2-06b9-31d6-80fd-a6e7641ba10a",
                                        "glosses": [
                                            "A device used to sharpen pencils by shaving the wood at one end."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae7e9510-726b-4b2d-81e7-5df1c6a24bdc",
                        "source_entry_id": "f03bd8a8-120f-38cd-a485-d511f0127509",
                        "source_sense_id": "39ea6615-a247-35d4-99de-3eb4ceb6ddec",
                        "target_lang_word": "ořezávátko",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ořezávátko",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ba37d27e-306c-3e61-b310-cc529b858d78",
                                        "entry_id": "dab3b3d3-9976-3035-b148-6e23e8ed3726",
                                        "glosses": [
                                            "jednoduchý mechanický nástroj sloužící k zašpičatění tužky nebo pastelky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8ffd2b-71c8-4468-8ffe-88fd1340f2af",
                                                "sense_id": "ba37d27e-306c-3e61-b310-cc529b858d78",
                                                "text": "Všimla si, že se Myšák na břiše páře. Situace vyžadovala okamžitou anestezi. Ořezala tužku v ořezávátku, až byla tenká jak jehla, a vbodla ji plyšákovi do místa vedle otevřené rány. Operace mohla začít."
                                            },
                                            {
                                                "example_id": "cfb5cc8c-21c0-4bf3-9a36-4226ab17a6c0",
                                                "sense_id": "ba37d27e-306c-3e61-b310-cc529b858d78",
                                                "text": "A podlehla, podlehla, vidím vám to na vočích, jak se tam blejská chtíč na kominický tělíčko! ― A co kdybych? ― Tak je s vámi oběma utrum. Vás bych nechal zaštepovat a kominíka bych si svázal a ořezávátkem na tužky bych mu okrouhal ten jeho hříšný úd... ― To že byste mohl...? ― A to já zase jo! Proč taky ne, když vy byste se mi mohla s ním zčubčit.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec88469-e56e-35d6-a966-b0f36f0681f4",
                                        "entry_id": "dab3b3d3-9976-3035-b148-6e23e8ed3726",
                                        "glosses": [
                                            "(zpravidla predikativně, v záporných frazémech) člověk, který neprojevuje silnou vůli, asertivitu, nechává sebou příliš snadno manipulovat nebo je jinak charakterově slabý"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9de03d9-4485-4a62-8d7f-5922fd1e6f76",
                                                "sense_id": "5ec88469-e56e-35d6-a966-b0f36f0681f4",
                                                "text": "„Sebranko jedna zatracená, přestanete už s těma sprosťárnama?“ Jenže sprosťárnám není zdaleka konec a alkohol táhne z huby. Jak je tak posloucháš žvástat páté přes deváté, uvědomuješ si, že to nejsou žádná ořezávátka, jinak by to ostatně na vesnické kádry dotáhnout ani nemohli."
                                            },
                                            {
                                                "example_id": "f1d52019-4faa-4b05-9f9f-de385f7e63ae",
                                                "sense_id": "5ec88469-e56e-35d6-a966-b0f36f0681f4",
                                                "text": "Považovat duel za předem vyhraný by však bylo chybou. Na stadion v Jiráskově ulici nepřijedou žádná ořezávátka. Jihočeši aktuálně počítají sérii osmi zápasů v řadě bez porážky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88add821-76e2-4f4a-a809-dc4e276f0485",
                        "source_entry_id": "f03bd8a8-120f-38cd-a485-d511f0127509",
                        "source_sense_id": "39ea6615-a247-35d4-99de-3eb4ceb6ddec",
                        "target_lang_word": "taille-crayon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taille-crayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45518008-e005-3f91-b3d7-011d2dd260c8",
                                        "entry_id": "3e29d7cd-0ce2-3ea3-a208-fedd31e65ab0",
                                        "glosses": [
                                            "Petit instrument qui sert à tailler les crayons, c'est à dire à en rendre la mine pointue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f50c812-240d-494b-893c-079630be24da",
                                                "sense_id": "45518008-e005-3f91-b3d7-011d2dd260c8",
                                                "text": "Encore ce matin il a fait reposer sa règle par le milieu sur sa gomme. La règle s’est inclinée quand il a posé son taille-crayon à une extrémité. Mais elle est redevenue horizontale quand le taille-crayon du voisin, qui est de la même marque que le sien, a été placé à l’autre extrémité. Voilà de quoi être surpris."
                                            },
                                            {
                                                "example_id": "d257ffe0-d709-4680-9f6c-be5901541355",
                                                "sense_id": "45518008-e005-3f91-b3d7-011d2dd260c8",
                                                "text": "Dans la Terrasse, d’Ettore Scola, Trintignant joue le concocteur professionnel de scénarios hilarants et se passe — moins marrant — le doigt en entier dans le taille-crayon électrique que lui a offert son producteur-manager-pompeur de rigolo-esclavagiste."
                                            },
                                            {
                                                "example_id": "333f4d3f-43be-4414-9179-ad362e595f30",
                                                "sense_id": "45518008-e005-3f91-b3d7-011d2dd260c8",
                                                "text": "J’ai pris mes livres à colorier, mes livres à raconter, mes feuilles à dessiner, tous mes crayons, toutes mes gommes, tous mes taille-crayons, tous mes marqueurs."
                                            },
                                            {
