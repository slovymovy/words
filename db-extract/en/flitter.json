    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                "word": "flitter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7e4c1dca-1856-44ad-bf5a-06eea6b2bc27",
                        "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                        "tags": [
                            "plural"
                        ],
                        "form": "flitters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f919b07-222e-320e-aaea-2cac3c3f6043",
                        "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                        "glosses": [
                            "A fluttering movement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f1b405-04bd-42d3-b597-92d19743fb52",
                                "sense_id": "0f919b07-222e-320e-aaea-2cac3c3f6043",
                                "text": "A waxing moon riding high in the sky and a flitter of bats about the rooftops, dipping and swerving as they gathered up the gnats that danced there in ephemeral clouds."
                            }
                        ]
                    },
                    {
                        "sense_id": "742440f5-e725-3b43-abbe-101bb39b1129",
                        "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                        "glosses": [
                            "A rag; a tatter; a small piece or fragment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169a1646-cbc9-4bd4-8039-3df6096b6e7f",
                                "sense_id": "742440f5-e725-3b43-abbe-101bb39b1129",
                                "text": "Without a flitter of a blanket o'er me"
                            },
                            {
                                "example_id": "69212c26-a3ca-4bfb-b8fe-5601dbafd620",
                                "sense_id": "742440f5-e725-3b43-abbe-101bb39b1129",
                                "text": "But to return to where we left her, I see her still, propped up in a kind of stupor against one of the walls in which this wretched edifice abounds, her long grey greasy hair framing in its cowl of scrofulous mats a face where pallor, languor, hunger, acne, recent dirt, immemorial chagrin and surplus hair seemed to dispute the mastery. Flitters of perforated starch entwine an ear."
                            }
                        ]
                    },
                    {
                        "sense_id": "c261032b-d4aa-3951-a67d-6a76f23ada67",
                        "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                        "glosses": [
                            "Any of various hesperiid butterflies of the genus Hyarotis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "172829d7-f3fa-3466-8ec6-cba5992e03a6",
                        "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                        "glosses": [
                            "A small aircraft or spacecraft."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f388212-2bcf-4ba5-8eb4-3c195dbaedf9",
                                "sense_id": "172829d7-f3fa-3466-8ec6-cba5992e03a6",
                                "text": "Then all three went out to the flitter. A tiny speedster, really; a torpedo bearing stubby wings and the ludicrous tail-surfaces, the multifarious driving-, braking-, side-, top-, and under-jets so characteristic of the tricky, cranky, but ultra-maneuverable breed."
                            },
                            {
                                "example_id": "e3f82c49-0178-40a3-b393-c557c9768ff9",
                                "sense_id": "172829d7-f3fa-3466-8ec6-cba5992e03a6",
                                "text": "Small flitters were powered and made ready, and everything that carried manual controls was inspected and cleared for action."
                            },
                            {
                                "example_id": "a5f09e02-1616-4587-957c-1b1eac05443a",
                                "sense_id": "172829d7-f3fa-3466-8ec6-cba5992e03a6",
                                "text": "The small flitters carried by the Queen for exploration work held with comfort a two-man crew—with crowding, three."
                            },
                            {
                                "example_id": "be0f85b2-1ad5-4c27-9182-96d8e0af54fb",
                                "sense_id": "172829d7-f3fa-3466-8ec6-cba5992e03a6",
                                "text": "The flitter tumbled from the shimmering throat of the wormhole transit route from Port Sol to Earthport."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8b41083-9ba8-3706-8a79-2344e43a029f",
                        "entry_id": "70467003-842b-3f02-8bfd-1803e6b7ae04",
                        "glosses": [
                            "A small perceptible feeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3aa1d58-e922-4b0c-ad1d-0f4a0c26e04d",
                                "sense_id": "e8b41083-9ba8-3706-8a79-2344e43a029f",
                                "text": "Hannah couldn't stop a flitter of panic at the thought."
                            },
                            {
                                "example_id": "15c4e700-8435-44f2-a718-884f425b271f",
                                "sense_id": "e8b41083-9ba8-3706-8a79-2344e43a029f",
                                "text": "He sensed Wheeler tensing, the slightest of tremors in the stillness of the ruined chapel, a flitter of irritation."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
