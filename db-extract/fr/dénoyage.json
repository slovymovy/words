        "fr-extract.jsonl": [
            {
                "entry_id": "40f53bc5-d82e-30f5-aadd-b4c08b67239e",
                "word": "dénoyage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d9fb4014-9e8f-47fd-a8e3-af68d5b35ba3",
                        "entry_id": "40f53bc5-d82e-30f5-aadd-b4c08b67239e",
                        "tags": [
                            "plural"
                        ],
                        "form": "dénoyages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c74ac0f2-a8ff-3436-94c1-eeceeb44cc44",
                        "entry_id": "40f53bc5-d82e-30f5-aadd-b4c08b67239e",
                        "glosses": [
                            "Action ou résultat de dénoyer, de retirer de l’eau qui ennoie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdca7e05-5205-4a8f-be27-459246fa72cc",
                                "sense_id": "c74ac0f2-a8ff-3436-94c1-eeceeb44cc44",
                                "text": "Les rigoles d’évacuation des eaux de dénoyage que la Société se propose de rétablir prochainement ne nécessitent pas de travaux importants."
                            },
                            {
                                "example_id": "41854052-3429-417d-80e1-3a3641c8a074",
                                "sense_id": "c74ac0f2-a8ff-3436-94c1-eeceeb44cc44",
                                "text": "Il suffisait d’emprunter aux mines voisines, par exemple à Valdonne qui n’en manquait pas, une pompe de dénoyage assez puissante, de monter rapidement une tuyauterie du quartier inondé aux albraques et on en sortirait en quelques jours."
                            },
                            {
                                "example_id": "98452b61-cdca-45d7-afaa-8ed4d9d2138f",
                                "sense_id": "c74ac0f2-a8ff-3436-94c1-eeceeb44cc44",
                                "text": "Un scénario-catastrophe qui se joue dans les 48 heures. « Un dénoyage complet du réacteur pourrait survenir d’ici un jour ou deux, avec des rejets massifs dans le jour qui suit », précise-t-il."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a7164f0-f61f-457c-ba5c-bd4a2d08f2e3",
                        "source_entry_id": "40f53bc5-d82e-30f5-aadd-b4c08b67239e",
                        "source_sense_id": "c74ac0f2-a8ff-3436-94c1-eeceeb44cc44",
                        "target_lang_word": "drainage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drainage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A natural or artificial means for the removal of fluids from a given area by its draining away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f677bd-6796-4fcf-b1d6-3d7843e0accb",
                                                "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                                "text": "It should move NR away from previous examples of repairs that have treated the symptoms (fixing the landslip) but not fixed the underlying cause (poor drainage), with the result that a second slip followed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89583c24-9dab-30d1-8d1d-7ff36c3d5ef4",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A system of drains."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A downward wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ebc4d8-22f6-404d-81a0-a624ab2dda2e",
                                                "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                                "text": "In the forward part of the cyclone, drainage katabasis is checked; but its highest intensity is observed in the rear part of the cyclone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f2c34dd-e41a-46e4-8809-a8d36637f85b",
                        "source_entry_id": "40f53bc5-d82e-30f5-aadd-b4c08b67239e",
                        "source_sense_id": "c74ac0f2-a8ff-3436-94c1-eeceeb44cc44",
                        "target_lang_word": "draining",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
