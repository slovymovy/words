                "senses": [
                    {
                        "sense_id": "275e6a6f-9f14-3b09-b4c7-79c093f849f3",
                        "entry_id": "c4d9b2de-2611-3209-8d38-97c07544029a",
                        "glosses": [
                            "ein Versammlungsgebäude einer Glaubensgemeinschaft; Holzgebäude, mit waagerechten Balken, dass zum Abhalten von Ritualen vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512e87f6-cdc3-41e1-abc3-aaeb0c9906f8",
                                "sense_id": "275e6a6f-9f14-3b09-b4c7-79c093f849f3",
                                "text": "„Das älteste Bauwerk der Erde ist eine chinesische Blockkirche und steht bereits 3000 Jahre.“"
                            },
                            {
                                "example_id": "626c20d6-2bb3-46d2-b192-2bab3e78a3a7",
                                "sense_id": "275e6a6f-9f14-3b09-b4c7-79c093f849f3",
                                "text": "„Sie ist die einzige Blockkirche in Niederbayern, gebaut für die vielen evangelischen Flüchtlinge nach dem zweiten Weltkrieg.“"
                            },
                            {
                                "example_id": "44edad56-207b-4e68-853d-7273c1dbe12b",
                                "sense_id": "275e6a6f-9f14-3b09-b4c7-79c093f849f3",
                                "text": "„Als das wertvollste Exponat gilt die griechisch-katholische Blockkirche des Hl. Michael – Erzengel aus Matysovská aus dem Jahr 1883.“"
                            },
                            {
                                "example_id": "23bb669f-baba-41a8-adff-bb84c3a6844c",
                                "sense_id": "275e6a6f-9f14-3b09-b4c7-79c093f849f3",
                                "text": "„Im Januar desselben Jahres kaufte man 15 Acker Land für 60 Dollar und setzte eine Blockkirche und ein Blockpfarrhaus darauf.“"
                            },
                            {
                                "example_id": "a95a3dcf-8117-417e-9b63-396e6c5ab287",
                                "sense_id": "275e6a6f-9f14-3b09-b4c7-79c093f849f3",
                                "text": "„Korejovce. – Die dreiräumige Blockkirche des Schutzes der Gottesmutter wurde im Jahr 1764 auf einer flachen Steinunterlage gebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
