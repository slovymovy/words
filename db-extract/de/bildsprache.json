                        "glosses": [
                            "Wirkung, die von den Bildern eines Künstlers ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9b471e-aa11-43a6-844d-93c587ce1ca6",
                                "sense_id": "3930c2e0-7f16-3d60-baab-4e369b338f6d",
                                "text": "„›Gestalten war ihm stets Erfinden‹, schrieb 1927 Max J. Friedländer, der Boschs Bildsprache als ›unmittelbaren künstlerischen Ausdruck‹ erklärte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61dde066-410d-3368-b774-7418c943c848",
                        "entry_id": "0fc10409-2760-3732-ad50-4c2ecdb3b1c9",
                        "glosses": [
                            "Art zu sprechen, die viele Sinnbilder/Metaphern verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704d108d-55f7-4980-a711-9902edd159f3",
                                "sense_id": "61dde066-410d-3368-b774-7418c943c848",
                                "text": "„Liest man die überlieferten Lieder, hört ihre Kadenz und bestaunt ihre kraftvolle Bildsprache, so wird deutlich, dass die Möglichkeiten für eine erotisch aufgeladene literarische Begegnung nahezu unbegrenzt waren.“"
                            }
                        ],
