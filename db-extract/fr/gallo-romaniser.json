                "senses": [
                    {
                        "sense_id": "310d6178-a24a-31f2-a05d-88b438f7d291",
                        "entry_id": "e041d262-b4bc-33b2-81e1-d29d9022f063",
                        "glosses": [
                            "Donner un caractère gallo-romain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9c905d-534e-48ec-9b21-2c346efbbec8",
                                "sense_id": "310d6178-a24a-31f2-a05d-88b438f7d291",
                                "text": "Lors de l'invasion romaine, la péninsule armoricaine (actuelle Bretagne) s'est progressivement gallo-romanisé, mais pas entièrement."
                            },
                            {
                                "example_id": "36a90011-54fb-4287-8f91-82694d38521c",
                                "sense_id": "310d6178-a24a-31f2-a05d-88b438f7d291",
                                "text": "Aussi, une idée de génie lui vient en aide, avec le projet de contruire^([sic]) une ville romaine aux portes du village afin de les gallo-romaniser."
                            },
                            {
                                "example_id": "9a2bebdb-3862-4ca7-b4c9-fd6d0afbf211",
                                "sense_id": "310d6178-a24a-31f2-a05d-88b438f7d291",
                                "text": "Il va aider et pousser César à mettre son plan à exécution : construire le Domaine des dieux à côté du village, sorte de complexe immobilier pour gallo-romaniser le village d'irréductibles Gaulois."
                            }
                        ]
                    }
