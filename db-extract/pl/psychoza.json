                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3c474cf-fb4d-4c86-80e0-ff37860b5508",
                        "source_entry_id": "8fd80ad5-2f11-374e-9dd1-6fcc38f39856",
                        "source_sense_id": "476a157d-e2bb-3d68-8242-efcd1eb0271d",
                        "target_lang_word": "Psychose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3820af-e2f6-346e-8029-072b8ef79846",
                                        "entry_id": "995529fe-adb6-3e24-ad23-7deb62e68669",
                                        "glosses": [
                                            "psychische Störung, die gekennzeichnet ist durch den Verlust des Realitätsbezuges. Die Erkrankten empfinden die Umwelt statt sich selbst als verändert."
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07669f4-e76c-4983-97cb-b634fc012240",
                                                "sense_id": "fb3820af-e2f6-346e-8029-072b8ef79846",
                                                "text": "Er ist an einer schweren Psychose erkrankt."
                                            },
                                            {
                                                "example_id": "8d15fc80-4990-42c1-a4d2-055e221530ea",
                                                "sense_id": "fb3820af-e2f6-346e-8029-072b8ef79846",
                                                "text": "„Die Psychose grenzte an Meuterei.“"
                                            },
                                            {
                                                "example_id": "fff82a41-41b3-4c95-9cae-af29e828c4d1",
                                                "sense_id": "fb3820af-e2f6-346e-8029-072b8ef79846",
                                                "text": "„Ein Arzt erklärte Ingvald, dass es sich um eine recht gewöhnliche Folge einer Apoplexie handelte, die von den Psychiatern als akute Psychose bezeichnet wird.“"
                                            },
                                            {
                                                "example_id": "2d3e2dd8-e651-40c8-8630-3e52e9692e6f",
                                                "sense_id": "fb3820af-e2f6-346e-8029-072b8ef79846",
                                                "text": "„Als Kriegsgeschädigte durfte keine laute Musik in ihrer Nähe gespielt werden, denn alles über 90 Dezibel könnte bei ihnen zu traumatischen Psychosen führen, wie ein mafianaher Psychiater bestätigte.“"
                                            },
                                            {
                                                "example_id": "cedb4da9-6213-401f-b32b-f5610fc9eda8",
                                                "sense_id": "fb3820af-e2f6-346e-8029-072b8ef79846",
                                                "text": "„Britische Mediziner wollen sogar herausgefunden haben, dass Stadtbewohner ein deutlich höheres Risiko besitzen, an Psychosen zu erkranken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "422c4657-5f71-483f-872e-6e6dcff8a554",
                        "source_entry_id": "8fd80ad5-2f11-374e-9dd1-6fcc38f39856",
                        "source_sense_id": "476a157d-e2bb-3d68-8242-efcd1eb0271d",
                        "target_lang_word": "психоз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "психоз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "553ed8a5-37d6-3090-a0fb-6b44c7b44eb6",
                                        "entry_id": "61b1960d-a627-311f-ace5-4300b751839c",
                                        "glosses": [
                                            "устар. общее психическое состояние человека в определенный момент"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3020949-880d-3032-ab4a-05c01918bde4",
                                        "entry_id": "61b1960d-a627-311f-ace5-4300b751839c",
                                        "glosses": [
                                            "психиатр. многовариантное болезненное расстройство психики, проявляющееся целиком или преимущественно неадекватным отражением реального мира с нарушением поведения, изменением различных сторон психической деятельности, обычно с возникновением несвойственных нормальной психике явлений (психомоторные и аффективные расстройства, галлюцинации, бред)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "817afe74-2960-42dc-8cec-f28300758c15",
                                                "sense_id": "e3020949-880d-3032-ab4a-05c01918bde4",
                                                "text": "В настоящее время установлено, что психозы поражают не только представителей культурного человечества, но встречаются и среди примитивных племён."
                                            },
                                            {
                                                "example_id": "8d175377-4923-45c4-b85c-d4b9dc782f69",
                                                "sense_id": "e3020949-880d-3032-ab4a-05c01918bde4",
                                                "text": "Во время революции 1870 г. французские психиатры описывали особый психоз folie patriotique, содержание которого черпалось из волнующих политических мотивов того времени."
                                            },
                                            {
                                                "example_id": "94ade96c-6eec-4952-89aa-c3d2782809ea",
                                                "sense_id": "e3020949-880d-3032-ab4a-05c01918bde4",
                                                "text": "Некоторые психиатры, изучая сущность шизофрении, обращают внимание, что психике таких больных свойственна известная архаичность, преобладание в общей структуре психоза более примитивных и более старых в филогенетическом отношении элементов и установок. Можно считать, что это относится не к одной шизофрении, в особенности если иметь в виду не психоз в целом, а бредовые концепции, отчасти и галлюцинации."
                                            }
                                        ]
