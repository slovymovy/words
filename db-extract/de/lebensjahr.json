                        ],
                        "form": "die Lebensjahre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e000dad4-d589-3578-a6e9-07139688e213",
                        "entry_id": "290df9bf-b469-356a-83a9-1429820bc6e0",
                        "glosses": [
                            "Jahr im Leben einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08d8c14b-ede7-457e-bd53-966e442828da",
                                "sense_id": "e000dad4-d589-3578-a6e9-07139688e213",
                                "text": "„Ab dem 50. Lebensjahr jedoch steigt die Anzahl der Neuerkrankungen sprunghaft an.“"
                            },
                            {
                                "example_id": "c0a59577-8634-4128-b32d-48ac9d848bfb",
                                "sense_id": "e000dad4-d589-3578-a6e9-07139688e213",
                                "text": "„Alicias Eltern, beide 1943 in Königsberg geboren, verbrachten ihre ersten zwei Lebensjahre überwiegend in Luftschutzkellern und auf der Flucht.“"
                            },
                            {
                                "example_id": "e5ebe8b2-1b2f-46d7-b387-546e56e74a23",
                                "sense_id": "e000dad4-d589-3578-a6e9-07139688e213",
                                "text": "„Dort schrieb er in den letzten Lebensjahren sein Hauptwerk nieder.“"
                            },
                            {
                                "example_id": "8ca4056b-05f0-4c8c-b1e4-fc4b72439bca",
                                "sense_id": "e000dad4-d589-3578-a6e9-07139688e213",
                                "text": "„Im Augenblick jedoch, in dem ich diese Annäherung beschreiben will, fühle ich, daß ich im Dunkeln tappe wie jemand, der den Schwarzen Mann beschreiben soll, von dem er jedoch in seinem dritten Lebensjahre eine Vorstellung besaß.“"
                            },
                            {
                                "example_id": "c17ef256-4efd-40b0-946c-b1d63cbf21ca",
                                "sense_id": "e000dad4-d589-3578-a6e9-07139688e213",
                                "text": "Das 13. Lebensjahr beginnt bereits am 12. Geburtstag, und nicht erst am 13. Geburtstag. Trotzdem ist man während dieses Lebensjahres 12 Jahre alt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
