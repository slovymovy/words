                "senses": [
                    {
                        "sense_id": "6cbffcd9-f4e9-3478-aff9-1ef432921ab0",
                        "entry_id": "7280c7a8-3423-3ff6-b304-52caa28a1ba3",
                        "glosses": [
                            "Donner un caractère mesquin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48802942-1ef8-4edb-b8a5-ecd3af28afe6",
                                "sense_id": "6cbffcd9-f4e9-3478-aff9-1ef432921ab0",
                                "text": "On pourrait appeler cette tendance à mesquiniser la musique : l’école du Léché !"
                            },
                            {
                                "example_id": "6f732193-37ab-418f-9c81-fc8c6b9f0059",
                                "sense_id": "6cbffcd9-f4e9-3478-aff9-1ef432921ab0",
                                "text": "Sans mesquiniser même sa lecture, on la comprend mieux, lorsqu’on la relie à ses préoccupations pastorales."
                            },
                            {
                                "example_id": "c6ebe4fe-dbdd-493e-a966-a67c7c0a79be",
                                "sense_id": "6cbffcd9-f4e9-3478-aff9-1ef432921ab0",
                                "text": "Toutes les vertus que l’on m’avait prêchées durant mon enfance s’appauvrirent, se mesquinisèrent, si humbles, si grêles à côté des splendeurs, de l’opulence, de la frénésie de certaines fautes…"
                            }
                        ]
                    }
