                "senses": [
                    {
                        "sense_id": "e6e5102b-1440-3592-8b78-4a0e188374a2",
                        "entry_id": "fec90f6e-b002-3ff9-9014-780abd2af45c",
                        "glosses": [
                            "„Bratpfanne mit einem meist nach außen gezogenen, hohen Rand“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104ab290-1214-4516-bde6-3d03be704bd4",
                                "sense_id": "e6e5102b-1440-3592-8b78-4a0e188374a2",
                                "text": "„Kurzgebratenes ist in einer Sauteuse bestens aufgehoben.“"
                            },
                            {
                                "example_id": "8dc58b3f-3128-4fa5-825f-37072d4b5d64",
                                "sense_id": "e6e5102b-1440-3592-8b78-4a0e188374a2",
                                "text": "„Die Sauteuse ist dazu gedacht, das Gargut entweder kurz in Fett zu schwenken oder als Kurzgebratenes zuzubereiten (Sautieren).“"
                            },
                            {
                                "example_id": "fe94ec30-cc6c-4e5f-ad39-87d2ca9798b4",
                                "sense_id": "e6e5102b-1440-3592-8b78-4a0e188374a2",
                                "text": "„Eine Sauteuse mit gewölbtem Rand wird meist einfach wie eine Kasserolle verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af045a1b-6962-4eb2-857e-633c9d754576",
                        "source_entry_id": "fec90f6e-b002-3ff9-9014-780abd2af45c",
