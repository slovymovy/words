                        "glosses": [
                            "Rendre réversible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ecdd36-2e11-47e7-b1f5-8a6e3ebcc0b3",
                                "sense_id": "63b5d5bc-0c70-3989-8fc3-034924703c88",
                                "text": "Ou plutôt tout veut s’échanger, se réversibiliser, s’abolir dans un cycle (c’est pourquoi en effet il n’y a ni refoulement ni inconscient, car la réversibilité est toujours déjà là)."
                            },
                            {
                                "example_id": "88283272-3ae9-4da4-808f-2858a2654356",
                                "sense_id": "63b5d5bc-0c70-3989-8fc3-034924703c88",
                                "text": "Ce triomphe de l’écrivain dans l’agonistique a pour effet de réversibiliser la relation bourreau/victime."
                            }
                        ]
                    }
