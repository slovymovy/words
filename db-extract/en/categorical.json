                    {
                        "sense_id": "a91b978d-5895-3921-bade-909bf9a796d2",
                        "entry_id": "5b2ed718-c62e-317c-b7e6-f33818077498",
                        "glosses": [
                            "Absolute; having no exception."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8964c6c7-82cc-4c10-9424-c447ce1b7db4",
                                "sense_id": "a91b978d-5895-3921-bade-909bf9a796d2",
                                "text": "We now see that they [propositions] are either conditional or unconditional, or, as the logicians say, hypothetical (conditional) or categorical (unconditional)."
                            },
                            {
                                "example_id": "e4191f4d-45d3-4f27-9ca6-09f94ef335fc",
                                "sense_id": "a91b978d-5895-3921-bade-909bf9a796d2",
                                "text": "Daytime interests are clearly not such far-reaching psychical sources of dreams as might have been expected from the categorical assertions that everyone continues to carry on his daily business in his dreams."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f6ef6d2-2089-389e-abd9-fef4f7b98ff1",
