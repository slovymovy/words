{
    "word_family": [
        "abandon",
        "abandonment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1dc770b-2787-399c-94d0-b2d4c684dea1",
                    "sense_definition": "No longer maintained by its former owners, residents, or caretakers; forsaken, deserted.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deserted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They explored an <w>abandoned</w> factory on the edge of town.",
                            "target_lang_translations": {
                                "ru": "Они исследовали <w>заброшенную</w> фабрику на окраине города."
                            }
                        },
                        {
                            "text": "The city council decided to demolish the <w>abandoned</w> building.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил снести <w>заброшенное</w> здание."
                            }
                        }
                    ],
                    "synonyms": [
                        "deserted",
                        "forsaken",
                        "derelict"
                    ],
                    "antonyms": [
                        "maintained",
                        "owned",
                        "possessed"
                    ],
                    "common_phrases": [
                        "abandoned building",
                        "abandoned property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не обслуживаемый бывшими владельцами, жильцами или смотрителями; покинутый, оставленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заброшенный",
                                "target_lang_sense_clarification": "о месте или здании, которое больше не используется"
                            },
                            {
                                "target_lang_word": "покинутый",
                                "target_lang_sense_clarification": "о месте, которое оставили люди"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58f155d1-5d00-3b63-a2b6-91463f2022b9",
                    "sense_definition": "Free from constraint; uninhibited.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uninhibited",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer moved with an <w>abandoned</w> energy that captivated the entire audience.",
                            "target_lang_translations": {
                                "ru": "Танцор двигался с <w>необузданной</w> энергией, которая покорила всю аудиторию."
                            }
                        },
                        {
                            "text": "She laughed with <w>abandoned</w> joy during the celebration.",
                            "target_lang_translations": {
                                "ru": "Она смеялась с <w>безудержной</w> радостью во время праздника."
                            }
                        }
                    ],
                    "synonyms": [
                        "uninhibited",
                        "unrestrained",
                        "wild"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от ограничений; несдержанный, неистовый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необузданный",
                                "target_lang_sense_clarification": "о поведении или эмоциях, не знающих границ"
                            },
                            {
                                "target_lang_word": "безудержный",
                                "target_lang_sense_clarification": "о проявлении чувств, которые невозможно сдержать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b81dfef4-7944-3edb-88f4-f735e694eb84",
                    "sense_definition": "Having given oneself up to vice; immoral; extremely wicked, or sinning without restraint.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "immoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel depicts the life of an <w>abandoned</w> criminal who shows no remorse for his actions.",
                            "target_lang_translations": {
                                "ru": "В романе описывается жизнь <w>распутного</w> преступника, который не проявляет раскаяния в своих поступках."
                            }
                        },
                        {
                            "text": "He lived an <w>abandoned</w> lifestyle, ignoring all social and moral rules.",
                            "target_lang_translations": {
                                "ru": "Он вел <w>распутный</w> образ жизни, игнорируя все социальные и моральные правила."
                            }
                        }
                    ],
                    "synonyms": [
                        "immoral",
                        "depraved",
                        "wicked"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предавшийся пороку; аморальный, крайне развратный или грешащий без ограничений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распутный",
                                "target_lang_sense_clarification": "о человеке, ведущем аморальный образ жизни"
                            },
                            {
                                "target_lang_word": "падший",
                                "target_lang_sense_clarification": "о человеке, утратившем моральные принципы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63bd3a70-b1d8-31b1-9c8b-af3365fffc7b",
                    "sense_definition": "No longer being acted upon by the geologic forces that formed it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists studied the <w>abandoned</w> river channel to understand ancient water patterns.",
                            "target_lang_translations": {
                                "ru": "Геологи изучили <w>заброшенное</w> русло реки, чтобы понять древние водные пути."
                            }
                        },
                        {
                            "text": "The <w>abandoned</w> mine shaft is no longer affected by shifting tectonic plates.",
                            "target_lang_translations": {
                                "ru": "На <w>заброшенную</w> шахту больше не влияют сдвиги тектонических плит."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не подвергающийся воздействию геологических сил, которые его сформировали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заброшенный",
                                "target_lang_sense_clarification": "о геологическом объекте, который больше не активен"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "094171d4-e3ae-3fae-9a79-c04ac77a4015",
                    "sense_definition": "Simple past and past participle of <w>abandon</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain <w>abandoned</w> the sinking ship after everyone else had escaped.",
                            "target_lang_translations": {
                                "ru": "Капитан <w>покинул</w> тонущий корабль после того, как все остальные спаслись."
                            }
                        },
                        {
                            "text": "They have <w>abandoned</w> their plans to travel due to the bad weather.",
                            "target_lang_translations": {
                                "ru": "Они <w>бросили</w> свои планы на путешествие из-за плохой погоды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb abandon."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «покидать» (abandon)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покинул",
                                "target_lang_sense_clarification": "глагол в прошедшем времени"
                            },
                            {
                                "target_lang_word": "бросил",
                                "target_lang_sense_clarification": "глагол в прошедшем времени, часто в значении оставить что-то"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}