                        "entry_id": "724cc579-e7a5-39da-85fa-1db8e657d034",
                        "glosses": [
                            "Characterised or marked by frolicking; playful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd89e2e-f7fe-47cd-9b74-4e498badef77",
                                "sense_id": "992a837b-5c6f-3fb9-ab5f-b70ecc8c1e16",
                                "text": "A rollicksome frolicsome rare old cock / As ever did nothing was our dog Jock; / A gleesome fleasome affectionate beast, / As slow at a fight, as swift at a feast […]"
                            },
                            {
                                "example_id": "c78be76b-e36d-4777-b97a-89c8940ef64d",
                                "sense_id": "992a837b-5c6f-3fb9-ab5f-b70ecc8c1e16",
                                "text": "To some, the very word \"playsuit\", with its frolicsome associations, will induce the conviction that this is not an item of clothing to be seen alive in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75a4ac3b-e26d-40f9-9c2a-402aec5a92d3",
                        "source_entry_id": "724cc579-e7a5-39da-85fa-1db8e657d034",
                        "source_sense_id": "992a837b-5c6f-3fb9-ab5f-b70ecc8c1e16",
                        "source_sense_description": "given to frolicking",
                        "target_lang_word": "espiègle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espiègle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "351afc77-96da-344b-b785-bedd0f5a9f6a",
                                        "entry_id": "abe9d29e-2f61-3242-b777-04484b74b093",
                                        "glosses": [
                                            "Qui est vif et malicieux mais sans méchanceté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a334c9-c832-46de-a7d6-3038b4a4c182",
                                                "sense_id": "351afc77-96da-344b-b785-bedd0f5a9f6a",
                                                "text": "Mon oncle avait lui aussi l’œil sur Margarida, qui laissait voir des seins hauts et blancs, avec un visage d’enfant espiègle."
                                            },
                                            {
                                                "example_id": "58b80930-ae6f-4fdb-8b51-53fa47eec6e2",
                                                "sense_id": "351afc77-96da-344b-b785-bedd0f5a9f6a",
                                                "text": "Une jeune fille espiègle."
                                            },
                                            {
                                                "example_id": "8df00503-c0c5-4aac-9536-f40a03139294",
                                                "sense_id": "351afc77-96da-344b-b785-bedd0f5a9f6a",
                                                "text": "Caractère, humeur espiègle."
                                            },
                                            {
                                                "example_id": "abd0f7c3-6a77-4545-ad04-eef88851ac73",
                                                "sense_id": "351afc77-96da-344b-b785-bedd0f5a9f6a",
                                                "text": "La figure enfantine de Suleïma, la petite fille, repasse dans mon esprit, pour la première fois depuis tant d’années : Suleïma, mangeant ses morceaux de sucre avec un petit air de singe espiègle et charmant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "espiègle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "262755fb-1a63-3250-84dc-585ceb9eae17",
                                        "entry_id": "eaf3e6f7-0928-3867-8f78-b0554952285b",
                                        "glosses": [
                                            "Celui, celle qui est vif et malicieux, sans méchanceté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c3851a-21a0-4276-acca-fed1421d2795",
                                                "sense_id": "262755fb-1a63-3250-84dc-585ceb9eae17",
                                                "text": "Caradou, le clairon, incorrigible espiègle, lance sur un ton de commandement :\n— « L’ennemi est en fuite. […] »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fc33631-e7be-4d85-8694-d20756b6922d",
                        "source_entry_id": "724cc579-e7a5-39da-85fa-1db8e657d034",
                        "source_sense_id": "992a837b-5c6f-3fb9-ab5f-b70ecc8c1e16",
                        "source_sense_description": "given to frolicking",
                        "target_lang_word": "badin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "badin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47bf6629-042f-3511-bfbe-e699ed1a9651",
                                        "entry_id": "ea95985d-dd96-3042-8e04-f3f689dee85d",
                                        "glosses": [
                                            "Manomètre, qui associé au tube de Pitot sert d’anémomètre aux avions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ca61a4-aec7-44ea-affc-9e66f47a211b",
                                                "sense_id": "47bf6629-042f-3511-bfbe-e699ed1a9651",
                                                "text": "A trente-cinq kilomètres à l'heure je décolle et l'indicateur de vitesse, le « Badin », m'indique bientôt que ma vitesse de croisière oscille entre quatre-vingt-quinze et cent kilomètres à l'heure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "badin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                        "entry_id": "fe4f2b51-9d4d-3acc-905d-dc71f0900426",
                                        "glosses": [
                                            "Qui aime à badiner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4417ed0-236b-46da-87f7-e86922cf63ba",
                                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                                "text": "Manon, qui était badine, fut sur le point, plusieurs fois, de gâter tout par ses éclats de rire."
                                            },
                                            {
                                                "example_id": "67c2d6a9-6b32-4089-ba8c-33630abcbd31",
                                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                                "text": "Akaki Akakiévitch avançait plein d’une humeur badine, il voulut même courir, d’un coup, Dieu seul savait pourquoi, après une dame qui, tel un éclair, passa devant lui et dont toutes les parties du corps étaient animées d’un mouvement extraordinaire."
                                            },
                                            {
                                                "example_id": "44a6e4cf-de3a-42ad-af1a-c4bac4e4035d",
                                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                                "text": "Cet homme est badin."
                                            },
                                            {
                                                "example_id": "bb4874a2-d0f2-4845-8b2f-bec59d6d579f",
                                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                                "text": "Esprit badin."
                                            },
                                            {
                                                "example_id": "b17d4f27-ac9a-42dc-a6cd-b6c4477a551e",
                                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                                "text": "Il a l’humeur badine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                        "entry_id": "fe4f2b51-9d4d-3acc-905d-dc71f0900426",
                                        "glosses": [
                                            "Qualifie le ton, les manières, le style, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016190b1-345d-4794-b2f5-c9803772a568",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Air badin."
                                            },
                                            {
                                                "example_id": "e8742314-246a-499a-b36d-973eccd65913",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Ton badin."
                                            },
                                            {
                                                "example_id": "cc2221bc-02e0-4921-af43-0a156481f211",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Épître badine."
                                            },
                                            {
                                                "example_id": "066bbde6-85a7-4268-83a4-79c187512ca8",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Des vers badins."
                                            },
                                            {
                                                "example_id": "29853020-55e3-4436-ab04-a5916bdb53f8",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Trait badin",
                                                "translation": "trait facile, léger."
                                            },
                                            {
                                                "example_id": "06dd8211-cfc9-4898-9e6b-f9cc40c7b6c7",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Jeune Aurore, il est déjà dans les boucles de vos beaux cheveux ; comme il s’y joue avec un souffle badin d’une épaule à l’autre !"
                                            },
                                            {
                                                "example_id": "f956fb48-fd46-45b9-b44a-7ef761054d71",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "Le capitaine badin jusqu’au bout de sa badine passa son doigt ganté de chevreau blanc sur la culasse luisante de graisse de son pistolet-mitrailleur démonté et le considéra souillé en demandant d’un ton où l’insolence le disputait à la perplexité : « C’est ça que vous appeler un pistolet-mitrailleur propre ? »"
                                            },
                                            {
                                                "example_id": "2274a844-2d7d-4e4f-b457-62c7d1192501",
                                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                                "text": "La question était posée sur un ton trop badin pour être totalement innocente"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "badin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c740b1e2-7423-3fe3-adfd-6f9665882046",
                                        "entry_id": "897e72d1-fc46-3d26-853d-927869160891",
                                        "glosses": [
                                            "Personnage qui badine."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e6b945d-75f6-4245-9e63-e577932cd5c1",
                                                "sense_id": "c740b1e2-7423-3fe3-adfd-6f9665882046",
                                                "text": "C’est un badin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cda28ea1-ad9a-45b9-928a-bcee2ae03d8d",
                        "source_entry_id": "724cc579-e7a5-39da-85fa-1db8e657d034",
                        "source_sense_id": "992a837b-5c6f-3fb9-ab5f-b70ecc8c1e16",
