        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "26c147c1-cc9b-3240-ae48-843df92da015",
                "word": "reticule",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e6480c3-2c9b-491a-9ae3-df32da0d0de5",
                        "entry_id": "26c147c1-cc9b-3240-ae48-843df92da015",
                        "tags": [
                            "plural"
                        ],
                        "form": "reticules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56ed4d9e-1c02-36d0-b7af-cdcaeb21e405",
                        "entry_id": "26c147c1-cc9b-3240-ae48-843df92da015",
                        "glosses": [
                            "A reticle; a grid in the eyepiece of an instrument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe99f9d7-4b5c-42dc-a963-d40d76fecd43",
                                "sense_id": "56ed4d9e-1c02-36d0-b7af-cdcaeb21e405",
                                "text": "[H]er hair had been used to create the reticule in the famous Norden bombsight—a top-secret WWII targeting device."
                            }
                        ]
                    },
                    {
                        "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                        "entry_id": "26c147c1-cc9b-3240-ae48-843df92da015",
                        "glosses": [
                            "A small women's bag made of a woven net-like material."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e203f7c5-f40e-43b6-891e-88b64e887433",
                                "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                                "text": "When reading the note, and arriving at an assurance of Helen's absence, Lady Anne had indignantly crushed it in her hand, and thrust it into her reticule, but, on her return home, whilst Fanchette was industriously employed upon her hair with the invaluable liquid dye, she drew out the rumpled paper, and read the concluding paragraph."
                            },
                            {
                                "example_id": "87e621b0-7f5c-4155-b1d7-4865720287d6",
                                "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                                "text": "Major Arthur Pendennis, arrived in due time at Fairoaks, after a dreary night passed in the mail-coach, … where a widow lady, opposite, had not only shut out the fresh air by closing all the windows of the vehicle, but had filled the interior with fumes of Jamaica rum and water, which she sucked perpetually from a bottle in her reticule […]"
                            },
                            {
                                "example_id": "e88c2f7e-9c7b-465e-8921-c5d0c032d453",
                                "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                                "text": "She carries some small litter in a reticule which she calls her documents, principally consisting of paper matches and dry lavender."
                            },
                            {
                                "example_id": "98498d3c-d7ee-409b-bf06-0e5de74017ee",
                                "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                                "text": "Miss Pross, exploring the depths of her reticule through her tears with great difficulty, paid for her wine."
                            },
                            {
                                "example_id": "c111d80e-8e3f-4c04-904f-810bafa5ed46",
                                "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                                "text": "Eleanor wore a green silk dress to bring out here eyes, with an ivory tatted collar and reticule to match."
                            },
                            {
                                "example_id": "382abbe4-d2ca-46b0-b9b4-f9834152aa15",
                                "sense_id": "c55606e9-cee4-36a8-87ab-a1b68a98a131",
                                "text": "Pléiade […] lingered through another bottle of wine before producing from her reticule a Vacheron & Constantin watch […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c99c61a3-ddae-4e9d-934b-58cf7bbaf53c",
                        "source_entry_id": "26c147c1-cc9b-3240-ae48-843df92da015",
                        "source_sense_description": "bag made of net-like material",
                        "target_lang_word": "reticuul",
