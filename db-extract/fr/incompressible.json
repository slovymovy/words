                    {
                        "sense_id": "df532007-52b7-3a94-8aaf-f825a76392b3",
                        "entry_id": "ad1504a1-126f-3af3-88a3-43c5cb7dec86",
                        "glosses": [
                            "Qui ne peut être comprimé."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "e19189eb-7b64-4d3e-b28d-180bcd0f4333",
                                "sense_id": "df532007-52b7-3a94-8aaf-f825a76392b3",
                                "text": "Aucun corps matériel n’est absolument incompressible."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0f13194-bbcf-3310-bb42-6b96c4651b8f",
                        "entry_id": "ad1504a1-126f-3af3-88a3-43c5cb7dec86",
                        "glosses": [
                            "Qualifie une peine qui ne peut faire l’objet d’aucune réduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a3b823d-95bf-4bad-bd13-b2e942cb54e9",
                                "sense_id": "b0f13194-bbcf-3310-bb42-6b96c4651b8f",
                                "text": "Deux points sont apparus comme particulièrement difficiles: les peines incompressibles et la réforme de l’organisation judiciaire, a-t-on appris."
                            }
                        ]
                    },
                    {
                        "sense_id": "5205bcf5-61b9-3f72-a59b-50fdfbdd1c94",
                        "entry_id": "ad1504a1-126f-3af3-88a3-43c5cb7dec86",
                        "glosses": [
                            "Irréductible, irrépressible."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "97c381a6-3c29-429c-ad47-eb59c1b46185",
                                "sense_id": "5205bcf5-61b9-3f72-a59b-50fdfbdd1c94",
                                "text": "La quarantaine, après une jeunesse étourdie, l’avait dotée d’un incompressible embonpoint."
                            },
                            {
                                "example_id": "e1dee8ad-33fc-45aa-95a1-e4844fe030aa",
                                "sense_id": "5205bcf5-61b9-3f72-a59b-50fdfbdd1c94",
                                "text": "Elle aurait voulu, pour la millième fois, se convaincre de son incompressible envie de cajoler un enfant."
                            }
                        ]
                    }
                ],
