                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108eb5f2-0d59-40c1-bb6b-7adf2d852eee",
                                                "sense_id": "13782f3c-c1f0-3846-8a00-88ca6408561d",
                                                "text": "Ondanks alle rijkdom is er toch nog een hoop ongenoegen in de samenleving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf17708-1612-3114-82eb-43badc868399",
                                        "entry_id": "6e1e5edb-b236-3a08-91d4-16a637d1a064",
                                        "glosses": [
                                            "ruzie, onenigheid, boosheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86786344-d1da-40d9-ae1c-48675565bec0",
                                                "sense_id": "3cf17708-1612-3114-82eb-43badc868399",
                                                "text": "Er was altijd ongenoegen tussen de kinderen die het nooit mel elkaar eens waren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a39f09af-74e6-4f0d-bb07-594a3633a429",
                        "source_entry_id": "aef6d105-eb80-316b-8afa-2d4b2c70f932",
                        "source_sense_description": "state of feeling unwell, unhappy, restless or depressed",
                        "target_lang_word": "neerslachtigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neerslachtigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "534c3309-3391-3f75-9926-228440d83409",
                                        "entry_id": "b86da03e-6c49-300e-a7b2-f7806809a4b0",
                                        "glosses": [
                                            "droeve, depressieve stemming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fffade76-d277-48f7-9be1-1035ab14db63",
                                                "sense_id": "534c3309-3391-3f75-9926-228440d83409",
                                                "text": "Bloeddruk, temperatuur en spierspanning worden hoger en de gebruiker kan gaan zweten en tandenknarsen en ook een droge mond en grote pupillen krijgen. Gebruikers kunnen verder onder meer verschijnselen als hoofdpijn, verwarring, misselijkheid, angst, neerslachtigheid, hartkloppingen, uitputting, uitdroging, oververhitting en spierspasmes ervaren. Ook een epileptische aanval, delier of drugspsychose is niet uitgesloten."
                                            },
                                            {
                                                "example_id": "03e4bd95-f33d-4d0c-9f5c-8377ab373d6a",
                                                "sense_id": "534c3309-3391-3f75-9926-228440d83409",
                                                "text": "Hij zat voorovergebogen, ellebogen op zijn knieën, zijn handen tegen de zijkant van zijn hoofd gedrukt het toonbeeld van neerslachtigheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a7bdce9-b9e8-4097-9769-0ff9dd40e9aa",
                        "source_entry_id": "aef6d105-eb80-316b-8afa-2d4b2c70f932",
                        "source_sense_description": "state of feeling unwell, unhappy, restless or depressed",
                        "target_lang_word": "onrust",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onrust",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b46490f4-6883-3212-9cf7-95e766136683",
                                        "entry_id": "7e4720cf-1193-3b86-ae68-02ce1e43701e",
                                        "glosses": [
                                            "het verstoord zijn van de maatschappelijke of sociale orde, verstoord zijn van de rust in een bepaalde groep mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c5c2ea4-672a-4745-b08d-4717cbaa36d2",
                                                "sense_id": "b46490f4-6883-3212-9cf7-95e766136683",
                                                "text": "Een aantal incidenten zorgde voor onrust in de wijk."
                                            },
                                            {
                                                "example_id": "87922785-7500-4837-b0fd-409b7dda7919",
                                                "sense_id": "b46490f4-6883-3212-9cf7-95e766136683",
                                                "text": "In de partij is onrust ontstaan over het voorstel."
                                            },
                                            {
                                                "example_id": "ff88dece-8c4e-4cb5-81f8-aaef367eb52b",
                                                "sense_id": "b46490f4-6883-3212-9cf7-95e766136683",
                                                "text": "De illegalen komen uit het dorpje Nieuw Koffiekamp, niet ver van de goudmijn. Ze vinden dat ook zij recht hebben om te mijnen in het concessiegebied van Iamgold. De leiding van bedrijf heeft nog niet op de onrust in het gebied gereageerd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de82153-215e-3775-812a-09d24ccec2f9",
                                        "entry_id": "7e4720cf-1193-3b86-ae68-02ce1e43701e",
                                        "glosses": [
                                            "het niet kalm of rustig zijn van het gemoed van iemand, het opgewonden zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7506fd3-0256-4a0d-adbc-1a7b0201d747",
                                                "sense_id": "0de82153-215e-3775-812a-09d24ccec2f9",
                                                "text": "Hij had al een tijdje een vreemde, nog nooit eerder beleefde onrust in zijn hart gevoeld."
                                            },
                                            {
                                                "example_id": "39005122-c5bf-45bb-8ef2-21f5cabcd46d",
                                                "sense_id": "0de82153-215e-3775-812a-09d24ccec2f9",
                                                "text": "Die 18-jarige Goldie had helemaal gelijk, waarom kon ik niet gewoon van het moment genieten? Waar kwam die onrust toch vandaan? Ik sjokte verder en zag de rivier af en toe ver onder mij in de kloof liggen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc78ac7b-3c62-394e-b65b-83eaf60da26e",
                                        "entry_id": "7e4720cf-1193-3b86-ae68-02ce1e43701e",
                                        "glosses": [
                                            "wieltje in een mechanisch uurwerk dat ervoor zorgt dat het uurwerk blijft lopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bc33fd-e7d8-4a90-9f42-1029ef0421d3",
                                                "sense_id": "dc78ac7b-3c62-394e-b65b-83eaf60da26e",
                                                "text": "De onrust bepaalt de snelheid waarmee een mechanisch uurwerk loopt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84d42089-a2d0-413c-9b14-37db35409476",
