                        "sense_id": "174f2722-e7f0-3fc9-a447-3d0e9b7c03ad",
                        "entry_id": "41e1051b-7789-3d8c-af62-10a7b77fd510",
                        "glosses": [
                            "перен. характерный для провинции, старомодный, отсталый"
                        ],
                        "tags": [],
