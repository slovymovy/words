                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8699c8ab-e9a3-4bd5-9b90-82f821860adf",
                        "source_entry_id": "3b0bfa68-77e4-383d-8665-c0b6cd43a05d",
                        "source_sense_id": "6450b6d7-ad56-31d7-b3be-8cae6db1f3d5",
                        "source_sense_description": "een mannelijk iemand die kan toveren",
                        "target_lang_word": "sorcerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                        "entry_id": "b8a3cb3a-5338-3514-9425-9ccf36257571",
                                        "glosses": [
                                            "A magician or wizard. Sometimes specifically male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298215e-0bc5-4c17-aa36-2200e2e9168e",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "Pope Joan, who once occupied the throne of the Vatican, was reputed to be the blackest sorcerer of them all."
                                            },
                                            {
                                                "example_id": "e7a46346-c9b2-4598-9e25-03c2001fb7ac",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47984b4c-ff08-4674-be1b-123c5ee738b0",
                        "source_entry_id": "3b0bfa68-77e4-383d-8665-c0b6cd43a05d",
                        "source_sense_id": "6450b6d7-ad56-31d7-b3be-8cae6db1f3d5",
                        "source_sense_description": "een mannelijk iemand die kan toveren",
                        "target_lang_word": "sorcier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8658439f-379f-3045-9f26-dbafabd1a912",
                                        "entry_id": "564184c5-30bf-3088-9e34-ab66276d9ebe",
                                        "glosses": [
                                            "Difficile, mystérieux, ésotérique."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d81fce27-c483-402e-8f41-e257a3dfe19e",
                                                "sense_id": "8658439f-379f-3045-9f26-dbafabd1a912",
                                                "text": "C’est quand même pas sorcier d’arriver à l’heure."
                                            },
                                            {
                                                "example_id": "2ce24480-9e6f-43c7-854b-e52a6cb4419c",
                                                "sense_id": "8658439f-379f-3045-9f26-dbafabd1a912",
                                                "text": "C'était le photographe. Il fit son entrée avec les instruments de son art sorcier : […]"
                                            },
                                            {
                                                "example_id": "60901be3-b754-49d4-8884-a285b0e4ce9c",
                                                "sense_id": "8658439f-379f-3045-9f26-dbafabd1a912",
                                                "text": "Il importe de faire savoir ce qu’on veut puisqu’on parle à un fétiche, plutôt à une personne sorcière qui se cache derrière le fétiche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sorcier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75c16d64-09a7-3160-9ac8-d54fe4b57b89",
                                        "entry_id": "265faf29-fb7d-3e5d-ab29-25292e07e2de",
                                        "glosses": [
                                            "Personne à qui on attribue le pouvoir surnaturel de lancer des sorts, des sortilèges."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53bc26c0-70d3-4e44-baa7-3507c2340ea4",
                                                "sense_id": "75c16d64-09a7-3160-9ac8-d54fe4b57b89",
                                                "text": "D’ici furent dirigés ces inquisiteurs qui allèrent brûler Vaudois, cathares, fraticelles, béguins, sorciers, envoûteurs, magiciens, flagellants, ou juifs convertis, mais soupçonnés de sortilèges."
                                            },
                                            {
                                                "example_id": "f82a0c33-4c3e-4f3e-95f6-486adcbed406",
                                                "sense_id": "75c16d64-09a7-3160-9ac8-d54fe4b57b89",
                                                "text": "Les personnes bien disposées envers elle sont prêtes à croire qu’elle est sorcière, qu’elle a le pouvoir de jeter des sorts, de fasciner « par le seul regard »."
                                            },
                                            {
                                                "example_id": "17e9a96b-94cd-4d91-89d6-3e5912931907",
                                                "sense_id": "75c16d64-09a7-3160-9ac8-d54fe4b57b89",
                                                "text": "La Saint-Jean joue un grand rôle dans la sorcellerie; c’est ce jour-là que Messieurs les sorciers et Mesdames les sorcières allaient cueillir les herbes destinées à leurs maléfices."
                                            },
                                            {
                                                "example_id": "a4f9e721-a3ef-40f8-95d8-1d319e7de54c",
                                                "sense_id": "75c16d64-09a7-3160-9ac8-d54fe4b57b89",
                                                "text": "Car par avant elle s’appelait Ophnissa, Asteria, Aethræa, Trinacria, Corymbia, Pœcessa, Atabyria, puis Macria, & Oloessa. Encores Strabo auteur grave ajoute deux autres noms Staclia, & Telchinia, des Telchins, qui jadis tindrent Rhodes, laquelle ils nommaient pour lors lalisos: lesquels (descenduz du Soleil ou de Minerve, ou bien selon l'opinion d'aucuns, de Saturne, & d'Aliope) furerent adonnés à toute méchanceté, comme sortilèges, incantations, enchantements & tous autres genres de déceptions: tellement qu'ils tuaient les hommes de leur regard, changeaient, & transformaient tout ce qui se trouvait devant eux: combien d'aucuns disent qu'ils étaient gens de grand esprit, & que pour l'envie qu'on avoit conçue sur eux, on avoit semé ce bruit, qu'ils étaient Sorciers ou enchanteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e6fe9f3-6839-38e4-9f42-97a3be802f4b",
                                        "entry_id": "265faf29-fb7d-3e5d-ab29-25292e07e2de",
                                        "glosses": [
                                            "Personne qui prétend pratiquer une magie, soit pour guérir, soit pour envoûter."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d92974d1-6d5b-4885-8c04-e3908522eddf",
                                                "sense_id": "9e6fe9f3-6839-38e4-9f42-97a3be802f4b",
                                                "text": "Rabalan était le dernier représentant d’une famille de sorciers qui, durant plus d’un siècle, régnèrent dans Trélotte. Son arrière-grand-père, son grand-père, son père, tous ses oncles et tous ses cousins avaient été sorciers, et l’on racontait d’eux des choses terribles et merveilleuses."
                                            },
                                            {
                                                "example_id": "bba61125-4a48-43f4-bd22-3e9b8c18babd",
                                                "sense_id": "9e6fe9f3-6839-38e4-9f42-97a3be802f4b",
                                                "text": "Les Groenlandais danois sont devenus de bons chrétiens ; ils persistent toutefois, à témoigner leur confiance à l’« Angakok ». Ce personnage important peut être comparé au rebouteux ou sorcier de nos campagnes."
                                            },
                                            {
                                                "example_id": "adb5fc5a-04c6-4b8c-86d0-a333c045959b",
                                                "sense_id": "9e6fe9f3-6839-38e4-9f42-97a3be802f4b",
                                                "text": "« Le plus grand pouvoir d’un sorcier, c’est de savoir qu’il n’en a pas. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c58b2824-fd04-3dff-b84e-8df6011b4b19",
                                        "entry_id": "265faf29-fb7d-3e5d-ab29-25292e07e2de",
                                        "glosses": [
                                            "Personne méchante."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b226c4-cf44-455e-a2f0-982b5810ac84",
                                                "sense_id": "c58b2824-fd04-3dff-b84e-8df6011b4b19",
                                                "text": "La sorcière leva la tête à l’entrée de Rébecca, et regarda la belle juive avec cette envie méchante dont la vieillesse et la laideur unies à de mauvais penchants ont coutume de gratifier la jeunesse et la beauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
