                        ],
                        "form": "die Spielgefährten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89d50fc2-0c4a-3959-9813-d5996343bc4a",
                        "entry_id": "ca3060c1-ade2-3d84-9182-0b744eced4f6",
                        "glosses": [
                            "Spielpartner wie Mensch, Tier, Puppe oder Stofftier, die beim Spielen begleiten, als Mitspieler und Impulsgeber fungieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f10855-2f67-47ad-a9c3-94543ce1d687",
                                "sense_id": "89d50fc2-0c4a-3959-9813-d5996343bc4a",
                                "text": "„Auch die Wahl des liebsten Spielgefährten fällt überwiegend zugunsten des eigenen Geschlechts aus.“"
                            },
                            {
                                "example_id": "4381dc3b-de1b-4fc4-b46a-66df96df3284",
                                "sense_id": "89d50fc2-0c4a-3959-9813-d5996343bc4a",
                                "text": "„Sie können sich dabei ganz nach ihren eigenen Bedürfnissen und Impulsen richten, weil die Interaktionspartner keine realen Spielgefährten sind, sondern u. a. Puppen und Stofftiere, über die sie verfügen können.“"
                            },
                            {
                                "example_id": "d6dfca4e-2b6c-4219-88c3-3839fcdebd52",
                                "sense_id": "89d50fc2-0c4a-3959-9813-d5996343bc4a",
                                "text": "„Meine erste Reaktion ist, sie zu ermuntern, selbst zu experimentieren und zusammen mit ihren Spielgefährten neue Ideen zu entwickeln.“"
                            },
                            {
                                "example_id": "ee340ebf-0198-4da1-b821-2fc98b559ed0",
                                "sense_id": "89d50fc2-0c4a-3959-9813-d5996343bc4a",
                                "text": "„Puppen und Stofftieren sind bei Mädchen wie Buben beliebte Spielgefährten.“"
                            },
                            {
                                "example_id": "aee3c6ad-493d-4e6f-bc46-39d59c66c49a",
                                "sense_id": "89d50fc2-0c4a-3959-9813-d5996343bc4a",
                                "text": "„Deshalb winken die Tierpfleger ab, wenn Erwachsene Spielgefährten für ihre Kinder suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
