                                "example_id": "a8463c52-b650-485e-9506-3aac88e263dc",
                                "sense_id": "6a48cd83-adfd-3bc4-9942-12026be640f0",
                                "text": "Then he held up his hands and let out a weak ghost-howl. \"Whoo?\" he moaned, in a tiny voice."
                            }
