                "entry_id": "656cf84a-12b7-3abf-8379-fb6d6b00f22e",
                "word": "ordinarité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "70b2c542-963a-4168-90d1-f8ab59bcc195",
                        "entry_id": "656cf84a-12b7-3abf-8379-fb6d6b00f22e",
                        "tags": [
                            "plural"
                        ],
                        "form": "ordinarités"
