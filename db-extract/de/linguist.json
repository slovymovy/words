                    {
                        "form_id": "8c0cfb1c-45d5-4133-ac61-05c32c35c5dd",
                        "entry_id": "a7e81d4d-eb57-3212-8dad-4beb7c7d8108",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Linguisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                        "entry_id": "a7e81d4d-eb57-3212-8dad-4beb7c7d8108",
                        "glosses": [
                            "Person, die sich wissenschaftlich mit Sprache befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21630e5b-c31c-40ea-b0d8-9e0dc142c455",
                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                "text": "Die meisten Beiträge im Wiktionary werden nicht von Linguisten, sondern von Laien verfasst."
                            },
                            {
                                "example_id": "65866a4b-a17e-4c33-8b12-c2de02529076",
                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                "text": "„Keine andere Sprache, haben Linguisten festgestellt, vermittelt im Schnitt mehr Sinn pro Buchstabe als das Finnische.“"
                            },
                            {
                                "example_id": "39785dd7-556f-4b4a-996c-46e2aacc6293",
                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                "text": "„Linguisten sind darauf angewiesen, viele Vergleichsmöglichkeiten zu haben.“"
                            },
                            {
                                "example_id": "d275de13-ffe4-4226-92df-15df3d09666f",
                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                "text": "„Alarmiert von Studien, die einen erschreckenden Verfall der Orthografie bei deutschen Schülern offenbaren, warnen Linguisten und Didaktiker, Pädagogen und Hirnforscher: Vor allem Risikokinder, die in einer spracharmen Umgebung oder mit Deutsch als zweiter Sprache aufwachsen, lernen so möglicherweise niemals richtig schreiben.“"
                            },
                            {
                                "example_id": "041f2e25-61ca-4709-a6a6-50f7f38dad30",
                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                "text": "„Linguistinnen und Linguisten verfügen idealerweise über vielfältige sprachliche Register und Stile, die es ihnen ermöglichen, fachliche Inhalte adressatengerecht zu kommunizieren, und sie wissen, welche Form welchem Adressatenkreis gegenüber angemessen ist.“"
                            },
                            {
                                "example_id": "f8d86db1-98ce-412b-92be-44e107d214ec",
                                "sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                                "text": "„Die Linguisten haben herausgefunden, welche Sprachen miteinander verwandt sind und nach welchen Gesetzmäßigkeiten sich Aussprache und Grammatik im Lauf der Zeit verändert haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a1a67c8-b115-47dc-bdc9-aa935ddc8c4b",
                        "source_entry_id": "a7e81d4d-eb57-3212-8dad-4beb7c7d8108",
                        "source_sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                        "source_sense_description": "Person, die sich wissenschaftlich mit Sprache befasst",
                        "target_lang_word": "linguist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e8b132-d66f-36c6-87b4-dd8791cb8abb",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "One who studies linguistics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b62db118-d369-3d56-9a6a-d3a6ae5facea",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "One who studies linguistics.",
                                            "One who studies modern-day linguistics, that is, linguistic science."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88ea51d-17d7-41c5-a40e-a4fe1604e1db",
                                                "sense_id": "b62db118-d369-3d56-9a6a-d3a6ae5facea",
                                                "text": "President Donald Trump has \"turned words into weapons\" -- and journalists are providing additional ammunition.\nThat's according to Trump critic George Lakoff, a renowned linguist and professor emeritus at the University of California at Berkeley."
                                            },
                                            {
                                                "example_id": "be9080ce-95d0-45cf-847b-e06d3bbfcae4",
                                                "sense_id": "b62db118-d369-3d56-9a6a-d3a6ae5facea",
                                                "text": "The internet serves as an accelerant to fanilects. Because song lyrics are readily available online, they have a characteristic linguists call \"persistence,\" meaning anyone can refer to them and reuse them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8590fd-b9ec-34b7-8937-b1ade7b33d99",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "A person skilled in languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7e05f8-dbf6-4c98-919f-d2eec26c8432",
                                                "sense_id": "4e8590fd-b9ec-34b7-8937-b1ade7b33d99",
                                                "text": "The words of these songs were either without meaning, or derived from an idiom with which Watt, a very fair linguist, had no acquaintance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa8c2ce-fd61-387a-848e-db093c77f272",
                                        "entry_id": "d9fada07-48c0-32a8-af0c-fa98061672df",
                                        "glosses": [
                                            "A human translator; an interpreter, especially in the armed forces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00e10efa-2453-40cb-8c7b-5733b63708ef",
                        "source_entry_id": "a7e81d4d-eb57-3212-8dad-4beb7c7d8108",
                        "source_sense_id": "790ea135-cc21-3536-83e7-82ebb17359e2",
                        "source_sense_description": "Person, die sich wissenschaftlich mit Sprache befasst",
                        "target_lang_word": "linguiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b15ba30-9164-380b-8f90-66db8bf4d4e1",
                                        "entry_id": "5ff3e8d1-5720-36ab-9dfd-8cc530cb5164",
                                        "glosses": [
                                            "Spécialiste de la linguistique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d5ead5-dc67-43d5-9e48-bdea274896d8",
                                                "sense_id": "6b15ba30-9164-380b-8f90-66db8bf4d4e1",
                                                "text": "C’est le linguiste américain George Lakoff (né en 1941), un ancien adepte de Chomsky, dont les intérêts ont changé, qui a favorisé le développement de la linguistique cognitive."
                                            },
                                            {
                                                "example_id": "478ee768-8c08-4cbe-9fe9-f8fb7ffd3ff7",
                                                "sense_id": "6b15ba30-9164-380b-8f90-66db8bf4d4e1",
                                                "text": "Ces divers travaux mettant en rapport des linguistes, des phonéticiens et des informaticiens a permis la synthétisation de la parole qui conduit des machines à « dialoguer » entres elles sans intervention humaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48badddb-c9b6-3ea6-b02d-a642587c56da",
                                        "entry_id": "5ff3e8d1-5720-36ab-9dfd-8cc530cb5164",
                                        "glosses": [
                                            "Spécialiste des langues."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cad73412-cecf-46dd-b172-f147fc119cb8",
                                                "sense_id": "48badddb-c9b6-3ea6-b02d-a642587c56da",
                                                "text": "Son ami, Thévenot, le célèbre voyageur et publicateur de voyages, réunissait chez lui, à Issy, diverses classes de savants, linguistes, orientalistes, et surtout, comme on disait alors, les curieux de la nature."
                                            },
                                            {
                                                "example_id": "8ef00093-bd9e-46ee-8af1-7251cc7d887d",
                                                "sense_id": "48badddb-c9b6-3ea6-b02d-a642587c56da",
                                                "text": "Si l’on met à part les simples témoignages d’argotiers proprement dits ou de personnes les fréquentant professionnellement (policiers, magistrats), ce qui frappe c’est le caractère relativement tardif des études consacrées aux argots. On sera étonné aussi d’apprendre que les premières études sont œuvres non de linguistes, mais d’hommes de lettres : Charles Nodier, Victor Hugo, Marcel Schwob."
                                            },
                                            {
                                                "example_id": "cce9a23e-0426-412e-a4d1-18bdf5372de5",
                                                "sense_id": "48badddb-c9b6-3ea6-b02d-a642587c56da",
                                                "text": "Et comme ces parlers indigènes appartiennent à la famille austroasiatique, certains linguistes ont pensé que le cam et les langues apparentées avaient été influencés par ce contact et qu'on devait les classer dans cette même famille […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91e8820b-d46e-3efe-8c4e-e490587fe4b9",
                                        "entry_id": "5ff3e8d1-5720-36ab-9dfd-8cc530cb5164",
                                        "glosses": [
                                            "Traducteur et/ou instructeur en langues étrangères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27df23fd-991a-49dc-ac1d-e116cd4f541f",
                                                "sense_id": "91e8820b-d46e-3efe-8c4e-e490587fe4b9",
                                                "text": "Mon quotidien en tant que linguiste : je suis le spécialiste à l'écoute de la moindre information cruciale. J'intercepte, j'écoute et je traduis simultanément des communications émises par radio dans différentes langues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96e8f732-9660-417c-acdd-d3d8e2ea65ea",
