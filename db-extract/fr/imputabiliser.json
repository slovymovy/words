                        "glosses": [
                            "Imputer la responsabilité de quelque chose à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "effd51a5-64d7-4aa3-afbe-e559b06db81d",
                                "sense_id": "27911c8d-bacf-3e35-aebe-f6aba84a40d9",
                                "text": "Imputabiliser les autres."
                            },
                            {
                                "example_id": "68d85389-5aed-4778-8c18-7371587dc0e8",
                                "sense_id": "27911c8d-bacf-3e35-aebe-f6aba84a40d9",
                                "text": "Devons-nous imputabiliser ce joueur et uniquement lui pour les dernières défaites de Canadien ?"
                            },
                            {
                                "example_id": "77e8428f-f25c-4e59-a9a4-823db071561f",
                                "sense_id": "27911c8d-bacf-3e35-aebe-f6aba84a40d9",
                                "text": "Ce n'est pas évident pourtant, parce que puisqu'il est question d'énergie et de blocage, il est difficile d'imputabiliser quoi ce soit;"
                            }
                        ]
