                "senses": [
                    {
                        "sense_id": "b7b52f8d-1db3-3f4f-9c81-6c08b58b2297",
                        "entry_id": "03915788-88bd-31ca-be6d-60acb4a76d16",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным геомагнетизм; связанный с магнитным полем Земли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb97ff0-c9da-428a-9464-e77f0485d444",
                                "sense_id": "b7b52f8d-1db3-3f4f-9c81-6c08b58b2297",
                                "text": "При ядерном взрыве геомагнитный эффект, независимо от силы взрыва, изменяется минутами, максимум до часа, а у Тунгусского метеорита он продолжался 5 часов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "573d5ada-bea2-4225-8080-4f9795a85359",
                        "source_entry_id": "03915788-88bd-31ca-be6d-60acb4a76d16",
                        "source_sense_id": "b7b52f8d-1db3-3f4f-9c81-6c08b58b2297",
                        "target_lang_word": "geomagnetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geomagnetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6c20b8-fad1-371a-925e-1516d3cf068e",
                                        "entry_id": "40b92d92-cad4-3728-bb6b-fb74b456fb54",
                                        "glosses": [
                                            "Of or pertaining to geomagnetism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aaa88c4-0345-4469-a728-20cce276b6d7",
                                                "sense_id": "0f6c20b8-fad1-371a-925e-1516d3cf068e",
                                                "text": "One of the earliest (and biggest) space weather events on record occurred in September 1859, when a massive solar eruption crashed into the Earth's magnetosphere, triggering a geomagnetic storm that lasted for days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
