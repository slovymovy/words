                ],
                "senses": [
                    {
                        "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                        "entry_id": "2b9276e9-7e90-326a-aefb-9fa0edfca278",
                        "glosses": [
                            "Täuschung von Behörden bei der Einhaltung von Abgasgrenzwerten in einer technischen Anlage, beispielsweise Autos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab95baad-4caf-47d6-bb41-8b5849a1a618",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "Es war Freitag, der 18. September 2015, als die amerikanischen Behörden eine zunächst dürre Presseerklärung vorbereiteten, in der Volkswagen Abgasmanipulation vorgewurfen wurde."
                            },
                            {
                                "example_id": "f9005f4f-59f9-4526-a425-eb193296f148",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "[Schlagzeile:] Mehr Tote durch Abgasmanipulation"
                            },
                            {
                                "example_id": "74018cc7-c413-47cc-90c6-66d1e2bc8101",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "Martin Winterkorn war im September 2015 von seinem Amt zurückgetreten, nachdem die US-Behörden die Abgasmanipulation mit Schummelsoftware in Zigtausenden von Dieselmodellen aufgedeckt hatten."
                            },
                            {
                                "example_id": "68167364-40d0-4d86-8f97-5bd48f2c6136",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "Die Höhe der Kfz-Steuer richtet sich auch nach den Emissionswerten. Durch Abgasmanipulation der Autohersteller entgehen den EU-Ländern Steuereinnahmen in Milliardenhöhe."
                            },
                            {
                                "example_id": "4d697955-4875-4ff1-aed5-a51aecea60d4",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "Im Weltmaßstab sind 4,1 Milliarden Euro nicht viel. Es ist die Summe, die VW in den USA als Strafe für seine Abgasmanipulation zahlt […]."
                            },
                            {
                                "example_id": "a0b19034-9333-46c1-b9d9-af3499ead969",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "[…] der Audi-Chef [Rupert Stadler steht] unter besonderer Beobachtung, weil die Abgasmanipulationen bei der Ingolstädter VW-Tochter ihren Ausgangspunkt hatten."
                            },
                            {
                                "example_id": "d780390f-dceb-4cad-8121-b9bf81e2371f",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "Die Ermittler gehen davon aus, dass Winterkorn bereits im Mai 2014 über die Abgasmanipulation informiert worden sei und dann mit anderen Teilen der Führungsspitze des Konzerns entschieden habe, die illegale Praxis fortzusetzen."
                            },
                            {
                                "example_id": "581930d4-3bf3-4e72-b2f8-7efe149dc88f",
                                "sense_id": "2a78eb47-962f-3684-bb85-a9143be91747",
                                "text": "Das Gericht kam zu dem Schluss, dass die Kläger nicht nachvollziehbar dargelegt hätten, dass Mitglieder des Vorstands oder Aufsichtsrates schon vor dem September 2015 Kenntnis von der Abgasmanipulation bei VW gehabt hätten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
