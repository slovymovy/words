                "senses": [
                    {
                        "sense_id": "426b0e59-7ea3-3175-9430-e01f92b5f804",
                        "entry_id": "7ba1db09-fa01-3509-8b6a-489f6ca30ea4",
                        "glosses": [
                            "Ancien nom du camphène, composant volatil d'une des deux huiles qui constituent l'huile de térébenthine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "afcbb6d4-12fa-4165-ab0a-3a904c74eca5",
                                "sense_id": "426b0e59-7ea3-3175-9430-e01f92b5f804",
                                "text": "S’il en est ainsi, il me semble évident que, tout comme on ne peut pas envisager la combinaison chlorhydrique, qui n’est pas acide, comme composée de dadyle et d’acide chlorhydrique, on ne peut pas mieux envisager celle-ci comme une combinaison de dadyle et d’eau."
                            },
                            {
                                "example_id": "5deabb75-5de4-440f-b485-3656b17b1b0e",
                                "sense_id": "426b0e59-7ea3-3175-9430-e01f92b5f804",
                                "text": "DADYLE. — Nom donné par Blanchet et Sell au camphène de Dumas (terébène de Soubeiran et Capitaine, terébilène de H. Deville."
                            }
                        ]
                    }
