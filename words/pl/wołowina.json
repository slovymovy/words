{
    "word_family": [
        "wół",
        "wołowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "735209b0-fbe6-369b-b995-da4879d67596",
                    "sense_definition": "mięso z bydła domowego, zwłaszcza z krowy lub wołu",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na niedzielny obiad kupiłem kilogram świeżej <w>wołowiny</w> w zaufanym sklepie mięsnym.",
                            "target_lang_translations": {
                                "ru": "К воскресному обеду я купил килограмм свежей <w>говядины</w> в проверенной мясной лавке."
                            }
                        },
                        {
                            "text": "Dobra <w>wołowina</w> musi być odpowiednio długo duszona, aby była miękka i soczysta.",
                            "target_lang_translations": {
                                "ru": "Хорошая <w>говядина</w> должна тушиться достаточно долго, чтобы получиться мягкой и сочной."
                            }
                        }
                    ],
                    "synonyms": [
                        "wołowe"
                    ],
                    "common_phrases": [
                        "świeża wołowina",
                        "duszona wołowina",
                        "kilogram wołowiny",
                        "mielona wołowina"
                    ],
                    "target_lang_definitions": {
                        "ru": "мясо крупного рогатого скота, в частности коровы или вола"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говядина",
                                "target_lang_sense_clarification": "мясо крупного рогатого скота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a54243dd-ddf2-331b-adc1-431b43e9e140",
                    "sense_definition": "danie lub potrawa przygotowana z mięsa wołowego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej tradycyjnej restauracji podają wyśmienitą <w>wołowinę</w> w sosie grzybowym.",
                            "target_lang_translations": {
                                "ru": "В этом традиционном ресторане подают превосходную <w>говядину</w> в грибном соусе."
                            }
                        },
                        {
                            "text": "Dzisiaj w porze obiadowej przygotuję <w>wołowinę</w> na ostro z warzywami.",
                            "target_lang_translations": {
                                "ru": "Сегодня к обеду я приготовлю острую <w>говядину</w> с овощами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pieczona wołowina",
                        "wołowina w sosie"
                    ],
                    "target_lang_definitions": {
                        "ru": "кушанье, блюдо, приготовленное из говяжьего мяса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говядина",
                                "target_lang_sense_clarification": "блюдо из говяжьего мяса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}