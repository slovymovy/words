                ],
                "senses": [
                    {
                        "sense_id": "506a8ee6-2c1c-39dd-bf12-530bba5f70af",
                        "entry_id": "07ffe89d-3795-3bdc-b5bb-99b2eb54a76c",
                        "glosses": [
                            "vorderster Bereich einer Zunge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf89ce8-2a86-430b-928d-505161438175",
                                "sense_id": "506a8ee6-2c1c-39dd-bf12-530bba5f70af",
                                "text": "„Die Berührung mit der Zungenspitze durchfuhr sie wie ein elektrischer Schlag.“"
                            },
                            {
                                "example_id": "0bdc8567-a4ea-41fa-8ef0-eed7192c7fdd",
                                "sense_id": "506a8ee6-2c1c-39dd-bf12-530bba5f70af",
                                "text": "„Mit der Zungenspitze suchte ich meine Schneidezähne ab.“"
                            },
                            {
                                "example_id": "183736c9-600a-4669-bca8-cd400b0117f9",
                                "sense_id": "506a8ee6-2c1c-39dd-bf12-530bba5f70af",
                                "text": "„Ihre Zungenspitze war eiskalt.“"
                            },
                            {
                                "example_id": "6a299105-4ec0-47b8-9cba-31459e19321e",
                                "sense_id": "506a8ee6-2c1c-39dd-bf12-530bba5f70af",
                                "text": "„Die Zungenspitze glitt über die hellroten Lippen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
