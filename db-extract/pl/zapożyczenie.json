                                        "examples": [
                                            {
                                                "example_id": "020b352c-077f-40cd-acba-e4beedef3de2",
                                                "sense_id": "86ef2af2-2e86-396e-861f-10523d5a2494",
                                                "text": "She is borrowing my pen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3783349f-5ea1-3ee4-b2a6-9523205ff3e9",
                                        "entry_id": "a6043ff8-c85d-346b-968a-505b2eb4c312",
