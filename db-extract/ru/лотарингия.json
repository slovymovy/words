                                        "sense_id": "83506874-5473-3834-b352-cb7429508b7d",
                                        "entry_id": "01fc6872-0c5e-3c6f-859a-36ab59c7a32f",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
