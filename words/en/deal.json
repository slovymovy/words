                },
                {
                    "sense_id": "dc0005d6-4b28-352e-939f-d06518e074d5",
                    "sense_definition": "A purchase or transaction that is financially beneficial; a bargain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trade_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I got a really good <w>deal</w> on my new laptop.",
                            "target_lang_translations": {
                                "ru": "Я нашел отличное <w>предложение</w> на мой новый ноутбук.",
                                "pl": "Trafiła mi się naprawdę dobra <w>okazja</w> przy zakupie nowego laptopa."
                            }
                        },
                        {
                            "text": "The store offers a special <w>deal</w> for students every Tuesday.",
                            "target_lang_translations": {
                                "ru": "Магазин предлагает специальную <w>акцию</w> для студентов каждый вторник.",
                                "pl": "Sklep oferuje specjalną <w>ofertę</w> dla studentów w każdy wtorek."
                            }
                        }
