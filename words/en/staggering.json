{
    "word_family": [
        "stagger",
        "staggered",
        "staggeringly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3de34e01-d7d7-3cac-baba-c17399fc60a0",
                    "sense_definition": "Incredible, overwhelming, or deeply amazing; difficult to believe or comprehend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astonishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a <w>staggering</w> profit of ten billion dollars this quarter.",
                            "target_lang_translations": {
                                "ru": "Компания сообщила об <w>ошеломляющей</w> прибыли в размере десяти миллиардов долларов в этом квартале."
                            }
                        },
                        {
                            "text": "The army suffered a <w>staggering</w> defeat that changed the course of the war.",
                            "target_lang_translations": {
                                "ru": "Армия потерпела <w>сокрушительное</w> поражение, изменившее ход войны."
                            }
                        }
                    ],
                    "synonyms": [
                        "astounding",
                        "overwhelming",
                        "mind-boggling",
                        "stunning"
                    ],
                    "antonyms": [
                        "unremarkable",
                        "ordinary"
                    ],
                    "common_phrases": [
                        "staggering amount",
                        "staggering defeat",
                        "staggering sum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невероятный, ошеломляющий или глубоко поразительный; такой, в который трудно поверить или который трудно осознать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошеломляющий",
                                "target_lang_sense_clarification": "вызывающий крайнее изумление или шок"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "поразительный по своей силе или масштабу"
                            },
                            {
                                "target_lang_word": "поразительный",
                                "target_lang_sense_clarification": "вызывающий сильное удивление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e2e2ad5-5175-3ea8-b82e-a693c23bacea",
                    "sense_definition": "Lurching, unsteady, or floundering in movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unsteady_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>staggering</w> attempt to walk home after the long and exhausting race.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>шатающуюся</w> попытку дойти до дома после долгого и изнурительного забега."
                            }
                        },
                        {
                            "text": "The <w>staggering</w> drunkard tried to hold onto the lamppost to keep his balance.",
                            "target_lang_translations": {
                                "ru": "<w>Шатающийся</w> пьяница пытался удержаться за фонарный столб, чтобы сохранить равновесие."
                            }
                        }
                    ],
                    "synonyms": [
                        "lurching",
                        "unsteady",
                        "tottering"
                    ],
                    "antonyms": [
                        "steady",
                        "stable"
                    ],
                    "common_phrases": [
                        "staggering gait",
                        "staggering steps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шатающийся, неустойчивый или колеблющийся при движении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатающийся",
                                "target_lang_sense_clarification": "неуверенно держащийся на ногах"
                            },
                            {
                                "target_lang_word": "неверный",
                                "target_lang_sense_clarification": "о шагах или походке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b643270-ac04-3b9f-8150-da0a398c93af",
                    "sense_definition": "The spacing out of various actions, events, or schedules over a period of time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheduling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>staggering</w> of working hours helped reduce traffic congestion during rush hour.",
                            "target_lang_translations": {
                                "ru": "<w>Смещение</w> рабочих часов помогло снизить заторы на дорогах в час пик."
                            }
                        },
                        {
                            "text": "We need a careful <w>staggering</w> of release dates to avoid market saturation.",
                            "target_lang_translations": {
                                "ru": "Нам нужно тщательное <w>распределение</w> дат релизов во времени, чтобы избежать перенасыщения рынка."
                            }
                        }
                    ],
                    "synonyms": [
                        "phasing",
                        "spacing"
                    ],
                    "common_phrases": [
                        "staggering of hours",
                        "staggering of shifts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределение различных действий, событий или графиков по времени во избежание совпадений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составление скользящего графика",
                                "target_lang_sense_clarification": "распределение по времени"
                            },
                            {
                                "target_lang_word": "чередование",
                                "target_lang_sense_clarification": "распределение с интервалами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb88d9d9-3e48-33c1-98d2-3f6f483ea9a7",
                    "sense_definition": "The physical motion or act of one who staggers or walks unsteadily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unsteady_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>staggerings</w> alarmed the doctor, who suspected a neurological issue.",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>пошатывание</w> встревожило врача, заподозрившего неврологическую проблему."
                            }
                        },
                        {
                            "text": "Through dizzy <w>staggerings</w>, the exhausted climber finally reached the safety of the camp.",
                            "target_lang_translations": {
                                "ru": "Сквозь головокружительное <w>шатание</w> изможденный альпинист наконец добрался до безопасного лагеря."
                            }
                        }
                    ],
                    "synonyms": [
                        "tottering",
                        "lurching"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое движение или действие того, кто шатается или идет неуверенно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатание",
                                "target_lang_sense_clarification": "неуверенная походка"
                            },
                            {
                                "target_lang_word": "пошатывание",
                                "target_lang_sense_clarification": "неустойчивые движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "950c0483-9d19-37bf-a641-1298baaef947",
                    "sense_definition": "The state or condition of being amazed, hesitant, or filled with doubt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astonishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his inner doubts and <w>staggerings</w>, he resolved to complete the difficult mission.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свои внутренние сомнения и <w>колебания</w>, он решил довести сложную миссию до конца."
                            }
                        },
                        {
                            "text": "These intellectual <w>staggerings</w> are common when facing such complex philosophical questions.",
                            "target_lang_translations": {
                                "ru": "Подобные интеллектуальные <w>метания</w> обычны при столкновении с такими сложными философскими вопросами."
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitation",
                        "wavering",
                        "vacillation"
                    ],
                    "antonyms": [
                        "certainty",
                        "resoluteness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly found in older literary or theological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние изумления, нерешительности или сомнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "неуверенность или сомнение"
                            },
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "растерянность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "083915bb-87a7-3706-8c9e-da4c4de6d0c9",
                    "sense_definition": "In animation, the technique of repeating a sequence of frames to depict struggling effort or vibration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animation_techniques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animator used <w>staggering</w> to emphasize the heavy weight the character was lifting.",
                            "target_lang_translations": {
                                "ru": "Аниматор использовал <w>стэггеринг</w>, чтобы подчеркнуть тяжелый вес, который поднимал персонаж."
                            }
                        },
                        {
                            "text": "By applying <w>staggering</w> to the frames, the impact of the explosion felt much more violent.",
                            "target_lang_translations": {
                                "ru": "Благодаря применению <w>стэггеринга</w> к кадрам, эффект от взрыва казался гораздо более мощным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical term in animation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В анимации: техника повторения последовательности кадров для изображения тяжелого усилия или вибрации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стэггеринг",
                                "target_lang_sense_clarification": "технический термин в анимации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3828f319-b836-31a6-b2af-a03f1f8f01f5",
                    "sense_definition": "Present participle and gerund of <w>stagger</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>staggering</w> down the street as if he were about to collapse.",
                            "target_lang_translations": {
                                "ru": "Он <w>шатался</w> по улице, как будто вот-вот упадет."
                            }
                        },
                        {
                            "text": "The bad news was <w>staggering</w> the entire community, leaving everyone in shock.",
                            "target_lang_translations": {
                                "ru": "Плохая новость <w>потрясла</w> все сообщество, повергнув всех в шок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола stagger."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатающийся",
                                "target_lang_sense_clarification": "причастие от шататься"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "причастие от потрясать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
