                "senses": [
                    {
                        "sense_id": "9d3ca39e-fbe1-39fb-8547-2410fbfd6ebf",
                        "entry_id": "bdc0eb0c-bf57-34da-9324-cb2b1fe5bdc1",
                        "glosses": [
                            "Procéder à l'ablation du foie chez (un être humain ou un animal)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0630807-7686-40fe-b67d-b6fc38e5f572",
                                "sense_id": "9d3ca39e-fbe1-39fb-8547-2410fbfd6ebf",
                                "text": "(...) depuis Kunde qui, en 1850, hépatectomise des grenouilles sans observer d'ictère, depuis Stern, puis Minkowski et Naunyn qui, en 1886, opèrent sur des oies et des canards (...)"
                            },
                            {
                                "example_id": "40ae1a7d-189f-4208-9c9b-c62691bf3bec",
                                "sense_id": "9d3ca39e-fbe1-39fb-8547-2410fbfd6ebf",
                                "text": "La vasopressine. comme l'insuline, réduit le taux sanguin du galactose administré par voie intraveineuse chez le chien hépatectomisé, éviscéré et néphrectomisé."
                            }
                        ]
                    }
