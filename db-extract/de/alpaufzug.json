                        "entry_id": "daff48c7-34ea-35fd-86bf-986b7520e8ea",
                        "glosses": [
                            "der feierlich und festlich begangene Aufzug der Kühe im Frühjahr auf die Hochgebirgsweiden"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "1c7a015c-a201-4da9-9b57-8c38f8af800e",
                                "sense_id": "92368483-54e9-3f10-a33a-098fe9a3fc6a",
                                "text": "\"Der Alpaufzug ist für die Bauern in Appenzell ein ganz besonders hoher Festtag.\""
                            },
                            {
                                "example_id": "ab76c836-64e0-49c4-b940-8b2d1bd75261",
                                "sense_id": "92368483-54e9-3f10-a33a-098fe9a3fc6a",
                                "text": "\"Als Almauftrieb, Alpaufzug oder Alpauffahrt bezeichnet man das Verbringen von Weidevieh auf Bergweiden, die sogenannten Almen oder Sömmern.\""
                            }
                        ],
