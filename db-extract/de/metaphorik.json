                "senses": [
                    {
                        "sense_id": "3afa21f6-4ee4-36d8-89d5-c90d6d9ac1c9",
                        "entry_id": "e64ee1d8-3ec4-3f38-b2a8-a0df1dd246a6",
                        "glosses": [
                            "Verwendung von Metaphern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b75835-7a7d-4524-a32e-6577bcd7e5e1",
                                "sense_id": "3afa21f6-4ee4-36d8-89d5-c90d6d9ac1c9",
                                "text": "„Hinter Paarreim und Lautmalerei, hinter Alliterationen und Metaphorik spürt man die mit Konsequenz geführte Feder eines Insiders, der das, was er berichtet, selbst erlebt hat.“"
                            },
                            {
                                "example_id": "0a39cde9-bb2b-4e84-9161-b1dad5cba1ef",
                                "sense_id": "3afa21f6-4ee4-36d8-89d5-c90d6d9ac1c9",
                                "text": "„Zur Analyse milieuspezifischer Metaphoriken und ihren Implikationen für Handlungsweisen liegen mehrere Arbeiten im Bereich des professionellen psychosozialen Helfens vor:…“"
                            },
                            {
                                "example_id": "5e7a152e-8eb6-42a8-b932-3b762fd8d0bf",
                                "sense_id": "3afa21f6-4ee4-36d8-89d5-c90d6d9ac1c9",
                                "text": "„Zwar dominiert das Negative, die negative Metaphorik, insgesamt aber ist das Bild eher schwankend, ambivalent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
