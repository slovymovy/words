                    {
                        "translation_id": "31328d86-094c-4092-a613-b27ccb334392",
                        "source_entry_id": "f996ba4d-cbea-3cfb-8db5-c6217389b0db",
                        "source_sense_id": "3fd85dbd-31a6-351d-bb89-1773cd6ced35",
                        "target_lang_word": "Teilnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teilnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55734af9-8cee-3202-99b4-bb3f9095b614",
                                        "entry_id": "3a4b790e-cd56-3f65-98e7-aa363ba7b4a2",
                                        "glosses": [
                                            "das Beteiligtsein, die Betätigung an etwas, das Mitmachen"
                                        ],
                                        "tags": [
                                            "entsprechend teilnehmen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c59ef9-7c33-41c7-855e-3afd00359d99",
                                                "sense_id": "55734af9-8cee-3202-99b4-bb3f9095b614",
                                                "text": "Die Teilnahme an dieser Lehrveranstaltung ist freiwillig."
                                            },
                                            {
                                                "example_id": "e45c04cd-5ab2-433f-a7bf-69f4158a0073",
                                                "sense_id": "55734af9-8cee-3202-99b4-bb3f9095b614",
                                                "text": "„Die Teilnahme an dem Projekt soll dazu beitragen, Hemmschwellen vor Hochschulen abzubauen und die Perspektive eines Studiums zu eröffnen.“"
                                            },
                                            {
                                                "example_id": "a74b2bc0-7bbc-41a5-990e-957ee9f659ce",
                                                "sense_id": "55734af9-8cee-3202-99b4-bb3f9095b614",
                                                "text": "„Im Schloss hatte an diesem Tage unter Teilnahme aller Hofkriegsratsmitglieder und beider Kaiser ein Kriegsrat stattgefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5bbd24f-3f4a-3fa4-bb65-cd1ab2788166",
                                        "entry_id": "3a4b790e-cd56-3f65-98e7-aa363ba7b4a2",
                                        "glosses": [
                                            "das Mitfühlen, das Mitempfinden"
                                        ],
                                        "tags": [
                                            "entsprechend teilnehmen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e6114b-745a-4b7e-8dae-fddbfa63bd4f",
                                                "sense_id": "f5bbd24f-3f4a-3fa4-bb65-cd1ab2788166",
                                                "text": "Vielen Dank für deine Teilnahme! Ich hätte das alleine nicht bewältigt."
                                            },
                                            {
                                                "example_id": "54e4f4e3-59b5-4f3e-b243-81091769d9c2",
                                                "sense_id": "f5bbd24f-3f4a-3fa4-bb65-cd1ab2788166",
                                                "text": "„Nikolai erkannte Prinzessin Marja augenblicks, nicht so sehr an ihrem Profil, das zum Teil von ihrem Hut verborgen wurde, als vielmehr an einem Gefühl von behutsamer Teilnahme, von Mitleid und Fürsorglichkeit, das sofort über ihn gekommen war.“"
                                            },
                                            {
                                                "example_id": "da384f53-6583-4da1-9eff-ad4628720c13",
                                                "sense_id": "f5bbd24f-3f4a-3fa4-bb65-cd1ab2788166",
                                                "text": "„Eine andere und sozusagen berufsmäßige Eigenart Pauls bestand darin, daß seine ganze Teilnahme und Arbeitskraft nur den Verwundeten in seinem Lazarett galt, so daß der sterbende Brussaroff in Gurna ihn weniger interessierte als ein beliebiger Soldat, den er am Tag vorher operiert hatte.“"
                                            },
                                            {
                                                "example_id": "f6a46bce-7c79-4150-a329-574ec65e0e11",
                                                "sense_id": "f5bbd24f-3f4a-3fa4-bb65-cd1ab2788166",
                                                "text": "„Die Indianerin hatte ihm seine Mahle regelmäßig jeden Morgen und Abend gebracht, hatte jedoch kein Wort weiter gesprochen, und ein ruhig forschender Blick, während sie seinen Puls untersuchte, war alles gewesen, was einigermaßen nähere Teilnahme beurkundete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "beb91a9a-6e52-3754-92c7-e2b9a9001b60",
                                        "entry_id": "3a4b790e-cd56-3f65-98e7-aa363ba7b4a2",
                                        "glosses": [
                                            "geistige Beteiligung, Interesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa460ee-5197-40a3-9e53-38876ab8caef",
                                                "sense_id": "beb91a9a-6e52-3754-92c7-e2b9a9001b60",
                                                "text": "Hast du den Vortrag gestern auch mit Teilnahme verfolgt?"
                                            },
                                            {
                                                "example_id": "347247e4-9b10-42c0-9784-61b2146941b5",
                                                "sense_id": "beb91a9a-6e52-3754-92c7-e2b9a9001b60",
                                                "text": "„Rosa, deren Wißbegier auf ganze Säle voll Rubens und Snyders, Wouvermanns und Potters rechnete, hielt sich selbstverständlich unausgesetzt in der Nähe des Kastellans und mühte sich, durch allerlei klug gestellte Fragen seine besondere Teilnahme zu wecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3724b597-beb1-4e1a-b721-2d76fa6d19b5",
                        "source_entry_id": "f996ba4d-cbea-3cfb-8db5-c6217389b0db",
                        "source_sense_id": "3fd85dbd-31a6-351d-bb89-1773cd6ced35",
                        "target_lang_word": "Partizipation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Partizipation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2cab6060-9fc0-3ea6-96bd-b94f55d87b8a",
                                        "entry_id": "7d086df7-06bd-3f38-8f44-fce171c2f0da",
                                        "glosses": [
                                            "Teilhabe oder Teilnahme an einer gemeinsamen Angelegenheit"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f94ace2-c915-4963-9e17-f67984961918",
                                                "sense_id": "2cab6060-9fc0-3ea6-96bd-b94f55d87b8a",
                                                "text": "Wahlen sind ein wesentliches Element der Partizipation an einer demokratischen Gesellschaft."
                                            },
                                            {
                                                "example_id": "1a6f8a6f-668e-4fe2-86e4-ff68b0f53c62",
                                                "sense_id": "2cab6060-9fc0-3ea6-96bd-b94f55d87b8a",
                                                "text": "„Geringes Einkommen und geringe Partizipation perpetuieren so den Ausschluss.“"
                                            },
                                            {
                                                "example_id": "db273e4b-3c4a-47bf-a5ad-ea58d9afc15d",
                                                "sense_id": "2cab6060-9fc0-3ea6-96bd-b94f55d87b8a",
                                                "text": "„Wie wenig man an der Partizipation an der Mehrheitsgesellschaft interessiert ist, wird auch für den Normalbürger am sichtbarsten an den fest installierten Parallelstrukturen, die die Mehrheitsgesellschaft für das eigene Leben komplett überflüssig machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
