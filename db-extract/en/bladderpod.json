                    {
                        "sense_id": "96957e9e-cbea-382b-9aed-e6781ff74dcf",
                        "entry_id": "826fb828-a651-3b32-8830-82e7b3a545ae",
                        "glosses": [
                            "Any of various flowering plants, including Cleome isomeris (= Isomeris arborea), Peritoma arborea, Lobelia inflata, and species of Physaria (= Lesquerella) and Paysonia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb52bb3f-0efe-4a72-ba11-a92b279a5ca5",
                                "sense_id": "96957e9e-cbea-382b-9aed-e6781ff74dcf",
                                "text": "c. 1977-1989, Donald W. (Hank) Nicol, Notes from the Naturalist, page 50,\nThe bladderpod (Isomeris arborea) is a pretty bush. It has loads of bright yellow flowers and the punching bag seed pods that give it its name. But, to be honest, it stinks!"
                            },
                            {
                                "example_id": "e15a4729-b4a0-416a-b53d-567ef0dffd29",
                                "sense_id": "96957e9e-cbea-382b-9aed-e6781ff74dcf",
                                "text": "As early as February, the ground between creosote bushes begins to turn yellow as masses of bladderpod^([Lesquerella gordoni]) start to bloom."
                            },
                            {
                                "example_id": "8e821a69-74d0-4dd7-8a7d-30bd8720d273",
                                "sense_id": "96957e9e-cbea-382b-9aed-e6781ff74dcf",
                                "text": "Bladderpod^([Isomeris arborea]) is fast growing, and the yellow flowers and blue-green foliage are attractive in mass plantings."
                            }
                        ]
                    }
                ],
