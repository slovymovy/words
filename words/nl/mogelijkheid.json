                    "sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
                    "sense_definition": "iets wat gedaan kan worden of kan gebeuren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "optie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een <w>mogelijkheid</w> om tijdelijk afstand te nemen van de constante druk in de stad.",
                            "target_lang_translations": {
                                "en": "There is a <w>possibility</w> to temporarily distance oneself from the constant pressure in the city.",
                                "ru": "Есть <w>возможность</w> временно отстраниться от постоянного давления города."
                            }
                        },
                        {
                            "text": "De soldaten zaten vast op de kuststrook zonder <w>mogelijkheid</w> om zich te verdedigen.",
                            "target_lang_translations": {
                                "en": "The soldiers were stuck on the coastal strip without any <w>way</w> to defend themselves.",
                                "ru": "Солдаты застряли на прибрежной полосе без <w>возможности</w> защищаться."
                            }
                        }
                    ],
                    "synonyms": [
