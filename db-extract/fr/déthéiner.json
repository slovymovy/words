                "senses": [
                    {
                        "sense_id": "cba0017c-7e38-3366-89e3-4722982bd0be",
                        "entry_id": "37a0dda1-b7ea-3eb7-ae4f-a66b9f4a75cb",
                        "glosses": [
                            "Traiter pour supprimer la théine (du thé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71dc813-10d2-4e9f-a7c4-fc8249be271b",
                                "sense_id": "cba0017c-7e38-3366-89e3-4722982bd0be",
                                "text": "Il est préférable de déthéiner soi-même son thé, plutôt que d’acheter un thé déthéiné dans le commerce (cela est fait la plupart du temps de façon industrielle et souvent approximative)."
                            },
                            {
                                "example_id": "0299872a-14d5-4ef9-9496-2f240a1cd38f",
                                "sense_id": "cba0017c-7e38-3366-89e3-4722982bd0be",
                                "text": "Pour déthéiner le thé rien de plus facile, il faut tout simplement jeter la première infusion après 1 à 2 minutes puis refaire infuser à nouveau avec une nouvelle eau, la théine se diffuse très rapidement dans l’eau lors des toutes premières secondes de l’infusion."
                            }
                        ]
                    }
