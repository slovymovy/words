                        "glosses": [
                            "Initiatrice : personne de genre féminin prenant l’initiative de toute entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e404c5e-4493-461e-8359-a48653fa7be7",
                                "sense_id": "bb84f888-596f-3a5e-9acc-c3724efb23b3",
                                "text": "Unzählige Opfer sexueller Übergriffe schildern unter dem Hashtag #Metoo ihre Erfahrungen. Nun hat sich die Initiatorin der Bewegung geäußert: Alles begann lange vor dem Weinstein-Skandal - mit der Geschichte eines kleinen Mädchens.",
                                "translation": "D’innombrables victimes d’agressions sexuelles décrivent leurs expériences sous le hashtag #Metoo. À présent, l’initiatrice du mouvement s’est exprimée : tout a commencé bien avant l’affaire Weinstein - avec l’histoire d'une petite fille."
                            }
                        ]
                    }
