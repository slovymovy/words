                "senses": [
                    {
                        "sense_id": "549e86d9-1699-3417-9bab-9ea5f96e8249",
                        "entry_id": "df608884-7a85-3cce-b218-00cde229a260",
                        "glosses": [
                            "Struktur der Verbindungen mehrerer Geräte in einem Computernetz zueinander"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "5904499b-3c5d-463f-86d6-bdadb9ef87b4",
                                "sense_id": "549e86d9-1699-3417-9bab-9ea5f96e8249",
                                "text": "„Wie bereits in den Vorgänger-XC-Modellen setzt Cray auf sein Aries Interconnect. Dabei handelt es sich um ein System-on-a-Chip (SoC) mit vier Network Interface Controllern (NIC) und einem integrierten Router. Darüber hinaus verwendet Cray die sogenannte Dragonfly-Netzwerktopologie.“"
                            },
                            {
                                "example_id": "1386161d-a8f6-400a-b901-681a7138f993",
                                "sense_id": "549e86d9-1699-3417-9bab-9ea5f96e8249",
                                "text": "„Bei diesem arbeiten große Provider mit P2P-Betreibern zusammen. P2P-Verbindungen sollen anhand von Informationen über die Netzwerktopologie optimiert werden, die von den Providern gestellt wird.“"
                            },
                            {
                                "example_id": "e18c801c-550a-401f-8a8b-bf5d8981de30",
                                "sense_id": "549e86d9-1699-3417-9bab-9ea5f96e8249",
                                "text": "„Flussdiagramme und Schemazeichnungen sorgen für Überblick bei komplexen Netzwerktopologien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
