                        "source_sense_id": "f8666252-6e4a-3ad4-a2ea-225f8657a193",
                        "source_sense_description": "Gastronomie, italienische Küche: sämige Soße (besonders auf der Basis von Tomaten)",
                        "target_lang_word": "sauce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
