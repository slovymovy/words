                                                "sense_id": "fcca8381-1109-30c0-b953-ce5e99e1e9e2",
                                                "text": "I met someone with whom there was instantly a perfect, almost lock and key snugness between our hearts and minds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "708cf0d8-7461-34e1-a9bb-edc3f84bc5d1",
