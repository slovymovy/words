                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bfb50ba-ede3-44ed-8057-0a6f923abe39",
                                                "sense_id": "6317cf94-842a-3862-a8eb-8a235bfead63",
                                                "text": "Vavřínový list je artefakt, který byl používán jako hlavice kopí nebo oštěpu zhruba před 20 tisíci lety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf9e19c-b46b-4626-b12f-dcd60bc8f5ea",
                        "source_entry_id": "2acbf8a2-75a6-34dc-91d3-bd23efe5667f",
                        "source_sense_id": "7f9d9f3c-9b1a-3cf9-82c7-3c5e7427f9fc",
                        "target_lang_word": "лавровый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лавровый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d87df11e-000c-3acc-8cf3-29f53fcb253c",
                                        "entry_id": "086496d8-cac3-39df-9c95-4f50a12ef060",
                                        "glosses": [
                                            "относящийся к лавру"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6da117-a7ad-4226-977e-051e4d6aa9ac",
                                                "sense_id": "d87df11e-000c-3acc-8cf3-29f53fcb253c",
                                                "text": "Тут меня посадили под лавровое дерево и дали мне в руки золотое яблоко."
                                            },
                                            {
                                                "example_id": "8709e3e7-5275-4528-983a-c1a8a914bf19",
                                                "sense_id": "d87df11e-000c-3acc-8cf3-29f53fcb253c",
                                                "text": "Из числа изобретённых им кушаний обоим понравилось в особенности одно, приготовляемое из риса, тёртого сыра, яиц и сока пережаренного мяса. В эту еду входит много перца и лаврового листа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a14696-1cd8-30ee-a1d4-377605174c9c",
                                        "entry_id": "086496d8-cac3-39df-9c95-4f50a12ef060",
                                        "glosses": [
                                            "добываемый из лавра"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fdf680d-224c-36ff-877c-420751233e38",
                                        "entry_id": "086496d8-cac3-39df-9c95-4f50a12ef060",
                                        "glosses": [
                                            "изготовленный из веток лавра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c7d161-b704-452b-9c10-7a41fd6b1dab",
                                                "sense_id": "1fdf680d-224c-36ff-877c-420751233e38",
                                                "text": "Лавровый венок."
                                            }
                                        ]
                                    }
