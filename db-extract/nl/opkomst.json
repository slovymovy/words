                        ],
                        "examples": [
                            {
                                "example_id": "0c0cfd9c-6bd6-4cff-8e0d-1c55315f22ff",
                                "sense_id": "f5c5b2ca-380c-35cf-a867-8f8793a5d7da",
                                "text": "De opkomst voor het evenement was hoger dan verwacht.",
                                "translation": "The turnout for the event was higher than expected.",
                                "english": "The turnout for the event was higher than expected."
                            },
                            {
                                "example_id": "148ec432-9585-407f-bebb-ef8746b30863",
                                "sense_id": "f5c5b2ca-380c-35cf-a867-8f8793a5d7da",
                                "text": "De lage opkomst bij de vergadering was teleurstellend.",
                                "translation": "The low attendance at the meeting was disappointing.",
                                "english": "The low attendance at the meeting was disappointing."
                            },
                            {
                                "example_id": "87c66789-e77d-4143-981f-5f3633527c6e",
                                "sense_id": "f5c5b2ca-380c-35cf-a867-8f8793a5d7da",
                                "text": "De opkomst bij de verkiezingen was aanzienlijk.",
                                "translation": "The turnout at the elections was significant.",
                                "english": "The turnout at the elections was significant."
                            }
                        ]
                    }
