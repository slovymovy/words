                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6049f455-115d-4a41-8ad2-23700ed52b59",
                        "source_entry_id": "81ffebf9-d429-36f8-9bea-eb071c872be8",
                        "target_lang_word": "wreath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wreath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c53bb62-1f97-346c-ab80-f262c89f660f",
                                        "entry_id": "c4fdf9bb-c9b7-331d-ade8-f2d472f9f969",
                                        "glosses": [
                                            "Something twisted, intertwined, or curled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24470492-8640-446d-89aa-c2dd950b1798",
                                                "sense_id": "9c53bb62-1f97-346c-ab80-f262c89f660f",
                                                "text": "a wreath of smoke    a wreath of clouds"
                                            },
                                            {
                                                "example_id": "0462ee46-ea31-44cd-9dbf-975dd7d381c6",
                                                "sense_id": "9c53bb62-1f97-346c-ab80-f262c89f660f",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom. Whirling wreaths and columns of burning wind, rushed around and over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c8b88e-c2ff-3099-88fc-a59b626a8836",
                                        "entry_id": "c4fdf9bb-c9b7-331d-ade8-f2d472f9f969",
                                        "glosses": [
                                            "An ornamental circular band made, for example, of plaited flowers and leaves, and used as decoration; a garland or chaplet, especially one given to a victor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8549b4f-662a-4e80-9a60-9a69b25c73d1",
                                                "sense_id": "07c8b88e-c2ff-3099-88fc-a59b626a8836",
                                                "text": "So, after a spell, he decided to make the best of it and shoved us into the front parlor. 'Twas a dismal sort of place, with hair wreaths, and wax fruit, and tin lambrekins, and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab96eb26-2383-368f-8046-094042b7080c",
                                        "entry_id": "c4fdf9bb-c9b7-331d-ade8-f2d472f9f969",
                                        "glosses": [
                                            "A defect in glass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "087b34f8-30bb-3e0f-bdf0-ca7254264775",
                                        "entry_id": "c4fdf9bb-c9b7-331d-ade8-f2d472f9f969",
                                        "glosses": [
                                            "An appendage to the shield, placed above it, and supporting the crest; an orle, a torse. It generally represents a twist of two cords of silk, one tinctured like the principal metal, the other like the principal color in the coat of arms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wreath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                        "entry_id": "563e4bc0-3211-3cf9-ab2e-9a7f68ce74db",
                                        "glosses": [
                                            "Alternative spelling of wreathe."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e3b178-53be-4fd9-ae0d-8ab54969f674",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "Sale) or Salovv a kind of vvoodde like VVyllovv, fit to vvreath and bynde in leapes to catch fiſh vvithall."
                                            },
                                            {
                                                "example_id": "2d20899f-38e4-44f6-a379-30a6e950caf0",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "[T]o wreſt the will of man, or to wreath his hearte to our humours, it is not in the compaſſe of Arte, but in the power of the moſt higheſt."
                                            },
                                            {
                                                "example_id": "813595a1-dd5f-4a0a-aab4-84f9aec7ea0b",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "[F]or griefe his hart did grate, / And from ſo heauie ſight his head did vvreath, / Accuſing fortune, and too cruell fate, / VVhich plonged had faire Lady in ſo vvretched ſtate."
                                            },
                                            {
                                                "example_id": "b7d3050f-c743-4791-a528-b720fb491b46",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "[Y]ou haue learn'd (like Sir Protheus) to vvreath your Armes like a Male-content: […]"
                                            },
                                            {
                                                "example_id": "67980e88-e245-4f72-aa9d-29158a82b843",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "The bitings of lyons and ſuch like beaſtes are ſo dangerous, in regard of their ſtrength and fierceneſſe, for they doe not onely bite, but alſo vvreath and teare the vvounds vvhich they make vvith their teeth, or nailes: […]"
                                            },
                                            {
                                                "example_id": "7fca1308-59c2-4da1-a284-c32ff9a695ed",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "[T]he Beards of vvilde Oates, and thoſe of divers other vvilde Plants; […] almoſt continually vvreath and unvvreath themſelves according to, even, the light variations of the temperature of the ambient Air."
                                            },
                                            {
                                                "example_id": "b53e66c9-092f-41b9-bc72-f305e9550f87",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "And forasmuch as by their frequent passing under the Roller, they [blankets for printing] are squezed together and become stubburne, and churlish: you shall doe well to spread and extend them at night; and the morning (ere you employ them) to wreath, rub, slap and smooth them till you have rendred them very soft and gentle: […]"
                                            },
                                            {
                                                "example_id": "fdd532d4-6bdf-46e6-b4fe-a17ca36eb02e",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "[W]ith Laurels vvreath your poſts, / And ſtrovv vvith Flovv'rs the Pavement; […]"
                                            },
                                            {
                                                "example_id": "36aa9237-252b-447d-8fa6-9566e4262ac9",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "But hovv ſhould I avoid to be her ſlave, / VVhoſe ſubtle art inviſibly can vvreath / My fetters of the very air I breathe?"
                                            },
                                            {
                                                "example_id": "15718538-b2e0-4767-9de5-3008eccb2bf1",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "Death's Harbingers, lye latent in the Draught: / And in the Flovv'rs that vvreath the ſparkling Bovvl, / Fell Adders hiſs, and poys'nous Serpents roll."
                                            },
                                            {
                                                "example_id": "224400c4-6618-4ac6-b33f-61af23da6398",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "Eſcap'd the flaſhing of the noontide hours / VVith one freſh garland of Pierian flovvers / (Ere from thy zephyr-haunted brink I turn) / My languid hand ſhall vvreath thy moſſy urn."
                                            },
                                            {
                                                "example_id": "81c56ef3-d436-4c56-8f8c-ad8ffc572674",
                                                "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                                                "text": "Tho' wit may flash from fluent lips, and mirth distract the breast, / Through midnight hours that yield no more their former hope of rest; / 'Tis but as ivy-leaves around the ruin'd turret wreath, / All green and wildly fresh without, but worn and grey beneath."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
