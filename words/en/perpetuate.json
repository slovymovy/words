{
    "word_family": [
        "perpetuity",
        "perpetual",
        "perpetuation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "297cf4ed-68ce-3d55-bd5f-269f3ae6a78f",
                    "sense_definition": "To cause something to continue indefinitely or to preserve it from being forgotten.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monument was built to <w>perpetuate</w> the memory of the soldiers who died in the war."
                        },
                        {
                            "text": "These outdated laws only serve to <w>perpetuate</w> inequality in our society."
                        }
                    ],
                    "synonyms": [
                        "immortalize",
                        "preserve",
                        "sustain"
                    ],
                    "common_phrases": [
                        "perpetuate a myth",
                        "perpetuate a cycle",
                        "perpetuate a stereotype"
                    ]
                },
                {
                    "sense_id": "be46b3e8-ef88-380c-ac7d-c8dc5f67cd05",
                    "sense_definition": "To make something last longer by repeating it or reinforcing it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By ignoring the problem, the manager only <w>perpetuated</w> the confusion among the staff."
                        },
                        {
                            "text": "The media often <w>perpetuates</w> negative stereotypes through biased reporting."
                        }
                    ],
                    "synonyms": [
                        "reinforce",
                        "prolong",
                        "maintain"
                    ],
                    "common_phrases": [
                        "perpetuate a problem",
                        "perpetuate a lie"
                    ]
                },
                {
                    "sense_id": "6497ec2c-c94a-35da-adca-75b8d22d70cb",
                    "sense_definition": "To formally record testimony or evidence that might otherwise be lost before a legal trial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer filed a motion to <w>perpetuate</w> the testimony of the elderly witness."
                        },
                        {
                            "text": "They needed to <w>perpetuate</w> the evidence before the key witness moved abroad."
                        }
                    ],
                    "synonyms": [
                        "record",
                        "document"
                    ],
                    "common_phrases": [
                        "perpetuate testimony"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in legal contexts."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab1cee92-316f-381b-84aa-5d726e2330d2",
                    "sense_definition": "Continuing for an indefinite or very long time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins stood as a <w>perpetuate</w> reminder of a lost civilization."
                        },
                        {
                            "text": "He sought a <w>perpetuate</w> legacy through his charitable foundations."
                        }
                    ],
                    "synonyms": [
                        "perpetual",
                        "endless",
                        "everlasting"
                    ],
                    "antonyms": [
                        "eternal",
                        "lasting",
                        "perennial",
                        "persistent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in modern English."
                        }
                    ]
                }
            ]
        }
    ]
