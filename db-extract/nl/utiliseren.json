                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb910c29-14c7-46b5-9fbd-44291d638185",
                                                "sense_id": "d884e28b-7640-3e0d-b3df-4771f77c04e9",
                                                "text": "The scientists utilized advanced technology in their research."
                                            },
                                            {
                                                "example_id": "ca0ec2b5-bb7f-4e5a-a77e-699dadc5dbe9",
                                                "sense_id": "d884e28b-7640-3e0d-b3df-4771f77c04e9",
                                                "text": "We must utilize our resources more efficiently."
                                            },
                                            {
                                                "example_id": "ad07c7e9-7fc1-42c8-85f7-7c18de1d6df3",
                                                "sense_id": "d884e28b-7640-3e0d-b3df-4771f77c04e9",
                                                "text": "The program can be utilized for educational purposes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9497840f-4084-4931-b96e-a91c36f66fcb",
                        "source_entry_id": "7f9cddc2-71d7-35c8-a845-271587259d12",
                        "source_sense_id": "6f588f4c-8bba-3e0b-a0e3-b2f3f3a8738e",
                        "target_lang_word": "employ",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "employ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27643eb3-6ac7-32ad-a99e-958d8b3c7b35",
                                        "entry_id": "8cbd256e-394e-3c87-9585-f24ea6c84664",
                                        "glosses": [
                                            "To retain (someone) as an employee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070eb29a-14a4-48bc-84d2-e7a83a3d28bd",
                                                "sense_id": "27643eb3-6ac7-32ad-a99e-958d8b3c7b35",
                                                "text": "Our company employs hundreds of people."
                                            },
                                            {
                                                "example_id": "7b119978-5b9a-4fd3-9e2a-7d9242b5433b",
                                                "sense_id": "27643eb3-6ac7-32ad-a99e-958d8b3c7b35",
                                                "text": "Andrew Houſtoun and Adam Muſhet, being Tackſmen of the Excize, did Imploy Thomas Rue to be their Collector, and gave him a Sallary of 30. pound Sterling for a year."
                                            },
                                            {
                                                "example_id": "0ee63fe8-7672-4dfa-ab1a-9d4fe65d6fe0",
                                                "sense_id": "27643eb3-6ac7-32ad-a99e-958d8b3c7b35",
                                                "text": "Charles had not been employed above six months at Darracott Place, but he was not such a whopstraw as to make the least noise in the performance of his duties when his lordship was out of humour."
                                            },
                                            {
                                                "example_id": "3b3f6406-555a-4761-9219-19f4df5eab77",
                                                "sense_id": "27643eb3-6ac7-32ad-a99e-958d8b3c7b35",
                                                "text": "The site—which was established in its current form in 2009—employs 60 people and says it gets 12 million visitors a month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e7dc07-a9e1-3935-a033-532b05fd5c6c",
                                        "entry_id": "8cbd256e-394e-3c87-9585-f24ea6c84664",
                                        "glosses": [
                                            "To provide (someone) with a new job; to hire."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691f3bd0-90b0-4400-9144-03ec909ccca0",
                                                "sense_id": "a9e7dc07-a9e1-3935-a033-532b05fd5c6c",
                                                "text": "Yesterday our local garage employed a new mechanic."
                                            },
                                            {
                                                "example_id": "0b6db3de-1c7a-4129-8c56-523f46c2b886",
                                                "sense_id": "a9e7dc07-a9e1-3935-a033-532b05fd5c6c",
                                                "text": "The management, who were close personal friends, had just employed a new chef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                        "entry_id": "8cbd256e-394e-3c87-9585-f24ea6c84664",
                                        "glosses": [
                                            "To use (someone or something) for a job or task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07fb8b41-02d3-4dc3-82c2-c2a9f566739c",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "The burglar employed a jemmy to get in."
                                            },
                                            {
                                                "example_id": "c13393be-d77e-47ae-a8b7-a46780a20374",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "Valiant Othello, we muſt straight employ you, / Againſt the generall Enemy Ottoman."
                                            },
                                            {
                                                "example_id": "b125f35d-a904-4b6b-9057-0dc19a86ee7c",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "This is a day in which the thoughts[…]ought to be employed on serious subjects."
                                            },
                                            {
                                                "example_id": "7f54efc1-8c1c-442d-91fc-76434e9dc57a",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "As to eleemoſynary corporations, by the dotation the founder and his heirs are of common right the legal viſitors, to ſee that that property is rightly employed, which would otherwiſe have deſcended to the viſitor himſelf: […]"
                                            },
                                            {
                                                "example_id": "d7bd84b1-bbb8-44bc-9fa4-a91ebdf52eae",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            },
                                            {
                                                "example_id": "ddf61b7e-a145-41b4-99a5-aaba15cb4b6d",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                                            },
                                            {
                                                "example_id": "996e6cb9-ddcf-4426-8c61-c755768ab70d",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "That insight may not seem surprising, given war's dampening effects on economic activity. But the research employed a new tool for recognizing the effects."
                                            },
                                            {
                                                "example_id": "047e728e-7855-4bb8-b396-8f14b2fc31f6",
                                                "sense_id": "73abe879-06ed-316c-bc6e-bea730d51e85",
                                                "text": "Whatever they employ, I’ll exploit, make null and void!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f30b4a-784f-322f-a3a8-1a661c4279c4",
                                        "entry_id": "8cbd256e-394e-3c87-9585-f24ea6c84664",
                                        "glosses": [
                                            "To make busy; to preoccupy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5269c52d-c280-4f8e-b7f6-e567aac4bfd2",
                                                "sense_id": "b2f30b4a-784f-322f-a3a8-1a661c4279c4",
                                                "text": "Let it not enter in your minde of loue: / Be merry, and imploy your chiefeſt thoughts / To courtſhip, and ſuch faire oſtents of loue / As ſhall conueniently become you there;"
                                            },
                                            {
                                                "example_id": "b729639f-b61b-47c8-ba85-cdfd0f685faf",
                                                "sense_id": "b2f30b4a-784f-322f-a3a8-1a661c4279c4",
                                                "text": "I heard the woods, and distant waters, roar; / Or heard them not, as happy as a Boy: / The pleasant season did my heart employ:"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "employ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b61057-8919-37bb-85fe-cf4c5204983c",
                                        "entry_id": "c8822a15-e8d5-3fd8-b0a4-e7193a21274f",
                                        "glosses": [
                                            "The state of being an employee; employment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddebbb72-1323-4d77-a30c-4e38d9b3c5c5",
                                                "sense_id": "41b61057-8919-37bb-85fe-cf4c5204983c",
                                                "text": "The school district has six thousand teachers in its employ."
                                            },
                                            {
                                                "example_id": "d71a01a4-ebf5-409c-9dfe-da7492cc3ad8",
                                                "sense_id": "41b61057-8919-37bb-85fe-cf4c5204983c",
                                                "text": "If Siamese in the employ of British subjects offend against the laws of their country,"
                                            },
                                            {
                                                "example_id": "9a91c097-7112-439e-a824-863a953f1d51",
                                                "sense_id": "41b61057-8919-37bb-85fe-cf4c5204983c",
                                                "text": "“And so you see, sir,” said I, “there is something to be said upon my side; and this gambling is a very poor employ for gentlefolks. But I am still waiting your opinion.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b25a4874-c864-3540-bd22-1a4ca00c98fe",
                                        "entry_id": "c8822a15-e8d5-3fd8-b0a4-e7193a21274f",
                                        "glosses": [
                                            "An occupation."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277c4fd3-fba0-4d13-9699-acc4e71ccff5",
                                                "sense_id": "b25a4874-c864-3540-bd22-1a4ca00c98fe",
                                                "text": "Still he wrote on. He was too much engrossed in his own charmed employ not to be insensible for a time to all external influences: he might suffer afterwards, but now his mind was his kingdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f5a2ae6-fd3d-31cd-936f-c50b83e3f3b1",
                                        "entry_id": "c8822a15-e8d5-3fd8-b0a4-e7193a21274f",
                                        "glosses": [
                                            "The act of employing someone or making use of something; employment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e1e4f16-5ac8-47f6-b7df-b548d5a59e08",
                                                "sense_id": "7f5a2ae6-fd3d-31cd-936f-c50b83e3f3b1",
                                                "text": "Notwithstanding the employ of general and local bleeding, blisters, &c., the patient died on the fourth day after entrance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e74a94a-29dc-4ed1-a483-7f2c4829d744",
                        "source_entry_id": "7f9cddc2-71d7-35c8-a845-271587259d12",
                        "source_sense_id": "6f588f4c-8bba-3e0b-a0e3-b2f3f3a8738e",
                        "target_lang_word": "apply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36b4922c-e3c8-3eb5-ab09-317e25003b3e",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To lay or place; to put (one thing to another)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc82f83-b3fc-4eeb-9525-1c4cab260a3a",
                                                "sense_id": "36b4922c-e3c8-3eb5-ab09-317e25003b3e",
                                                "text": "to apply cream to a rash"
                                            },
                                            {
                                                "example_id": "88dc26a6-7062-4ded-8edb-2bbf99505259",
                                                "sense_id": "36b4922c-e3c8-3eb5-ab09-317e25003b3e",
                                                "text": "He said, and to the sword his throat applied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8e25d0-ab79-3f3f-960d-c8d0bffd7c80",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To put to use; to use or employ for a particular purpose, or in a particular case"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b7118e6-da80-4033-bc0e-0eada8e845d1",
                                                "sense_id": "ed8e25d0-ab79-3f3f-960d-c8d0bffd7c80",
                                                "text": "to apply funds to the repayment of a debt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b7e0b6b-4348-39ad-a815-aee3d9f26df2",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To make use of, declare, or pronounce, as suitable, fitting, or relevant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d94e17-23cb-42f3-9fa2-5a84c09e6b1c",
                                                "sense_id": "8b7e0b6b-4348-39ad-a815-aee3d9f26df2",
                                                "text": "We need to apply the skills we’ve learned to solve this problem."
                                            },
                                            {
                                                "example_id": "90569c91-3ed7-4ad7-b0a0-44ae94d3f329",
                                                "sense_id": "8b7e0b6b-4348-39ad-a815-aee3d9f26df2",
                                                "text": "Yet God at last To Satan, first in sin, his doom applied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fceef609-f416-30c0-be8a-c1d96d7dbb44",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To put closely; to join; to engage and employ diligently or with attention."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b19ba5e-952f-4d03-a3bb-12064b3a420d",
                                                "sense_id": "fceef609-f416-30c0-be8a-c1d96d7dbb44",
                                                "text": "Apply thine heart unto instruction, and thine ears to the words of knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f53ec282-0b5e-311c-ad8c-72312ad04778",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To work diligently and attentively."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5487218c-a097-4af4-ac16-3625592efb76",
                                                "sense_id": "f53ec282-0b5e-311c-ad8c-72312ad04778",
                                                "text": "My parents say I could do well in school if I would apply myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad89c5d-0433-3acd-9b2d-5e2f29b3d3dd",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To address oneself; to refer."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00b63183-958e-41fe-a920-651a0c3a85ce",
                                                "sense_id": "3ad89c5d-0433-3acd-9b2d-5e2f29b3d3dd",
                                                "text": "sacred vows […] applied to grisly Pluto"
                                            },
                                            {
                                                "example_id": "3942e516-9e95-4a62-960f-84ee2c2edec9",
                                                "sense_id": "3ad89c5d-0433-3acd-9b2d-5e2f29b3d3dd",
                                                "text": "On applying to the assessors, I am surprised to learn that they cannot at once name a dozen in the town who own their farms free and clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dda29c01-a217-35f6-88d8-09b3dbab1186",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To submit oneself as a candidate (with the adposition \\\"to\\\" or \\\"at\\\" designating the recipient of the submission, and the adposition \\\"for\\\" designating the position)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68e4b637-b80a-46ef-8e1a-8e7da052233a",
                                                "sense_id": "dda29c01-a217-35f6-88d8-09b3dbab1186",
                                                "text": "I recently applied to the tavern for a job as a bartender."
                                            },
                                            {
                                                "example_id": "021faf51-b570-49b5-9984-cd428594568c",
                                                "sense_id": "dda29c01-a217-35f6-88d8-09b3dbab1186",
                                                "text": "Most of the colleges she applied to were ones she thought she had a good chance of getting into."
                                            },
                                            {
                                                "example_id": "6a2de320-bf9d-4b1f-9eae-a3f63a00a57e",
                                                "sense_id": "dda29c01-a217-35f6-88d8-09b3dbab1186",
                                                "text": "Many of them don't know it, but almost a third of the inmates are eligible to apply for parole or work-release programs."
                                            },
                                            {
                                                "example_id": "da52aa81-5bd4-4429-a2ec-9dc4ac0c3f73",
                                                "sense_id": "dda29c01-a217-35f6-88d8-09b3dbab1186",
                                                "text": "Southern Pacific Communications Co. (SP) has applied to the FCC for approval of the first coast-to-coast digital data transmission service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ffeb46-8289-3cfb-a1b7-79f6478a097e",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To pertain or be relevant."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaac149f-84ce-4bfd-a7fe-b33f0d3e5ca0",
                                                "sense_id": "13ffeb46-8289-3cfb-a1b7-79f6478a097e",
                                                "text": "That rule only applies to foreigners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e28d55c1-f5d5-3a28-bc2f-d862b1877208",
                                        "entry_id": "40cff17b-e055-31b9-9629-e9457a9ca744",
                                        "glosses": [
                                            "To busy; to keep at work; to ply."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
