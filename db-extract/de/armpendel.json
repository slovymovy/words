                "senses": [
                    {
                        "sense_id": "5b864bd1-fd64-3918-8a2f-06c893519964",
                        "entry_id": "cd3ca7f5-edf0-35a7-b2a3-323fd21a26a4",
                        "glosses": [
                            "schwingende Bewegung der Arme (natürliche, pendelartige Bewegung der Arme beim Gehen oder Laufen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc5b1b0-c3f4-409f-b3d1-6d384ec9c97d",
                                "sense_id": "5b864bd1-fd64-3918-8a2f-06c893519964",
                                "text": "„Beim Laufen kann sich ein Spannungsverlust auch über die Hand ausdrücken. Dies ist nicht nur optisch ungünstig, sondern kann sich auch negativ auf die Armspannung und den Armpendel auswirken.“"
                            },
                            {
                                "example_id": "7f11170b-edd4-4b28-ba72-b45ac011257f",
                                "sense_id": "5b864bd1-fd64-3918-8a2f-06c893519964",
                                "text": "„Der Armpendel ist oftmals ein guter Indikator für kontrollierte Mobilität am Schultergelenk und am oberen Rumpf.“"
                            },
                            {
                                "example_id": "bb6b68cd-fd22-4911-9616-70754450ed6b",
                                "sense_id": "5b864bd1-fd64-3918-8a2f-06c893519964",
                                "text": "„Wenn die Schrittfrequenz auf mehr als 140 Schritte pro Minute ansteigt, wird der Gang hyperaktiv und der Armpendel aktiv. Die Schritte verlieren an Ökonomie und Reaktivität, d.h., die Ermüdung tritt früher ein, die Schritte werden kürzer, und auf Dauer wird die zurückgelegte Wegstrecke geringer.“"
                            },
                            {
                                "example_id": "170fddf5-5ca1-4fee-ac0b-5504fc36ddcf",
                                "sense_id": "5b864bd1-fd64-3918-8a2f-06c893519964",
                                "text": "„Mit steigendem Schritttempo verstärkt sich das Armpendel, das in sagittaler Ebene frei schwingen kann, wenn der Schultergürtel in Retroposition auf dem Thorax ruht.“"
                            },
                            {
                                "example_id": "cdb742f9-842d-421e-9b94-8c8a0e2a389b",
                                "sense_id": "5b864bd1-fd64-3918-8a2f-06c893519964",
                                "text": "„Je größer die Schritte, desto größer ist der reaktiv erzeugte Armpendel. Der Armpendel erfolgt mit extendiertem Ellenbogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
