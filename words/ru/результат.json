                },
                {
                    "sense_id": "197cb1ef-e4d1-3877-89be-da1e88f0fd39",
                    "sense_definition": "Количественный показатель мастерства, успеха или производительности (часто в спорте или учёбе).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спортсмен показал лучший <w>результат</w> в этом сезоне.",
                            "target_lang_translations": {
                                "en": "The athlete showed the best <w>result</w> this season.",
                                "zh": "这位运动员在本赛季展现出了最好的<w>成绩</w>。"
                            }
                        },
                        {
                            "text": "Ученик добился высоких <w>результатов</w> в изучении математики.",
                            "target_lang_translations": {
                                "en": "The student achieved high <w>results</w> in the study of mathematics.",
                                "zh": "这名学生在数学学习上取得了优异的<w>成绩</w>。"
                            }
                        },
                        {
                            "text": "Нам нужно улучшить <w>результат</w> продаж в следующем месяце.",
                            "target_lang_translations": {
                                "en": "We need to improve the sales <w>result</w> next month.",
                                "zh": "我们需要在下个月提高销售<w>表现</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "показатель",
                        "достижение"
                    ],
                    "common_phrases": [
