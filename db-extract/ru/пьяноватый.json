                "senses": [
                    {
                        "sense_id": "0ed4dad2-a197-3300-9d19-b7e2ac689202",
                        "entry_id": "ba321f93-8d91-3429-8294-a0ca217a4a62",
                        "glosses": [
                            "somewhat drunk, tipsy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b528727e-8323-45a4-b4b9-a62aa46cc5ae",
                                "sense_id": "0ed4dad2-a197-3300-9d19-b7e2ac689202",
                                "text": "Когда в половине одиннадцатого позолоченные двери распахнулись и в зал вошёл пьяноватый потомок римского легата, Варя обрадовалась ему как родному, вскочила и с неподдельной сердечностью замахала рукой.",
                                "translation": "When the gilt-wood doors finally swung open at half-past ten and the Roman legate’s descendant entered the hall in a somewhat tipsy condition, Varya felt as delighted as if he were her closest friend.",
                                "english": "When the gilt-wood doors finally swung open at half-past ten and the Roman legate’s descendant entered the hall in a somewhat tipsy condition, Varya felt as delighted as if he were her closest friend."
                            }
                        ]
                    }
