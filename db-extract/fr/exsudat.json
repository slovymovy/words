                ],
                "senses": [
                    {
                        "sense_id": "de51a4ff-1e1e-3daa-97e2-1009130acd4e",
                        "entry_id": "76269b79-18d2-3439-8d11-b766eed203e5",
                        "glosses": [
                            "Blastème produit en des conditions pathologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fac17af-0b4e-4589-9743-d1e12772c1be",
                                "sense_id": "de51a4ff-1e1e-3daa-97e2-1009130acd4e",
                                "text": "La fibrine prédomine dans tous les exsudats du tissu conjonctif; chaque tissu fournit quelques éléments qui détruisent l’uniformité de ces épanchements."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5a28350-9570-32f9-915f-6034a5ad9e33",
                        "entry_id": "76269b79-18d2-3439-8d11-b766eed203e5",
                        "glosses": [
                            "Liquide suintant d’un végétal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58e14ab-da4e-47a4-b451-eaf7c6dd060f",
                                "sense_id": "d5a28350-9570-32f9-915f-6034a5ad9e33",
                                "text": "La pomme de terre, par l’émission de ses exsudats racinaires, fait germer la menthe."
                            },
                            {
                                "example_id": "0eac8f0b-ac18-49c4-b9e2-a5aaf17b8540",
                                "sense_id": "d5a28350-9570-32f9-915f-6034a5ad9e33",
                                "text": "Appelée aussi gomme arabique, la gomme d’acacia provient de l’exsudat de l’acacia, un arbre qui pousse à l’état sauvage en Afrique, dans le sud du Sahel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f3837f-1cb0-4228-8d3c-2b9678c8cc8c",
                        "source_entry_id": "76269b79-18d2-3439-8d11-b766eed203e5",
                        "target_lang_word": "exudation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exudation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f29c95cb-f21c-3163-b896-909c24930e87",
                                        "entry_id": "b66e6f4f-a6f0-320d-bd0e-2a23e9d4cbb7",
                                        "glosses": [
                                            "The act or process of exuding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5de18ec-e4a9-4b2c-be2e-153cb76566f5",
                                                "sense_id": "f29c95cb-f21c-3163-b896-909c24930e87",
                                                "text": "In severe burns, the body loses large amounts of nitrogen, in the urine and by exudation from the burned body surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "405b8fef-b245-3780-9617-ed506ad9dfcc",
                                        "entry_id": "b66e6f4f-a6f0-320d-bd0e-2a23e9d4cbb7",
                                        "glosses": [
                                            "Something that is exuded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b191828-618c-4380-b175-085117896a41",
                                                "sense_id": "405b8fef-b245-3780-9617-ed506ad9dfcc",
                                                "text": "Major Pendennis, having read with difficulty his nephew’s name under Mr. Warrington’s on the wall of No. 6, found still greater difficulty in climbing the abominable black stairs, up the banisters of which, which contributed their damp exudations to his gloves, he groped painfully until he came to the third story."
                                            },
                                            {
                                                "example_id": "da2b78d4-fae5-45ba-8103-137c7f560200",
                                                "sense_id": "405b8fef-b245-3780-9617-ed506ad9dfcc",
                                                "text": "The car was parked in close to the rustic fence, under the lime trees, and their sticky exudations had already stippled the windscreen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
