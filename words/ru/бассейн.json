    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "830e72b1-71c6-35ac-80ad-398c0490f9f1",
                    "sense_definition": "искусственный водоём для купания, занятий водными видами спорта или содержания водных животных",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "водоем",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы часто ходим в <w>бассейн</w> по выходным.",
                            "target_lang_translations": {
                                "en": "We often go to the <w>swimming pool</w> on weekends."
                            }
                        },
                        {
                            "text": "Дети учатся плавать в большом <w>бассейне</w>.",
                            "target_lang_translations": {
                                "en": "The children are learning to swim in a large <w>swimming pool</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "плавательный бассейн"
                    ],
                    "common_phrases": [
                        "посещать бассейн",
                        "крытый бассейн"
                    ],
                    "target_lang_definitions": {
                        "en": "An artificial body of water used for swimming, water sports, or keeping aquatic animals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swimming pool",
                                "target_lang_sense_clarification": "a structure filled with water for swimming"
                            },
                            {
                                "target_lang_word": "pool",
                                "target_lang_sense_clarification": "a common short form for a swimming pool"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "692bde23-4c2e-3f9c-b16a-77db27221f4f",
                    "sense_definition": "совокупность рек, озёр и других водоёмов, питающих основной водоём",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "география",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Река Волга имеет огромный <w>бассейн</w>.",
                            "target_lang_translations": {
                                "en": "The Volga River has a huge <w>basin</w>."
                            }
                        },
                        {
                            "text": "Экологи следят за чистотой воды в <w>бассейне</w> реки.",
                            "target_lang_translations": {
                                "en": "Ecologists monitor the water quality in the river <w>basin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "водосборный бассейн"
                    ],
                    "common_phrases": [
                        "бассейн реки"
                    ],
                    "target_lang_definitions": {
                        "en": "The area of land from which water drains into a particular river, lake, or other body of water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "basin",
                                "target_lang_sense_clarification": "a geographical area drained by a river and its tributaries"
                            },
                            {
                                "target_lang_word": "watershed",
                                "target_lang_sense_clarification": "the region or area drained by a river or stream"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d6f3d34-16c4-3d64-a36d-853c80b93a83",
                    "sense_definition": "обширная территория, где залегают полезные ископаемые",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "геология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Донецкий <w>бассейн</w> богат залежами угля.",
                            "target_lang_translations": {
                                "en": "The Donetsk <w>basin</w> is rich in coal deposits."
                            }
                        },
                        {
                            "text": "Разработка месторождений в этом <w>бассейне</w> требует новых технологий.",
                            "target_lang_translations": {
                                "en": "Developing deposits in this <w>basin</w> requires new technologies."
                            }
                        }
                    ],
                    "common_phrases": [
                        "угольный бассейн"
                    ],
                    "target_lang_definitions": {
                        "en": "A large geographical area containing significant deposits of minerals or fossil fuels."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "basin",
                                "target_lang_sense_clarification": "a large depression in the earth's surface containing mineral deposits"
                            },
                            {
                                "target_lang_word": "coalfield",
                                "target_lang_sense_clarification": "specifically for areas rich in coal deposits"
                            }
                        ]
                    }
                }
            ]
        }
