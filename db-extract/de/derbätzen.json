                "senses": [
                    {
                        "sense_id": "d5396f06-a41f-3fba-aeb3-e10f0f73b690",
                        "entry_id": "9f1c2eaf-5249-3dd0-95b6-004d4ac0697a",
                        "glosses": [
                            "zu Brei oder Matsch zerquetschen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "b59ba415-e666-46f5-a5d0-a65d16972307",
                                "sense_id": "d5396f06-a41f-3fba-aeb3-e10f0f73b690",
                                "text": "„…weils ma die ganze Ant'n, mit eanane boanane Finger scho ganz dadruckt, u dabatzt hab'n…“",
                                "translation": "„weil sie mir die Ente mit ihren knöchrigen Fingern schon ganz zerdrückt und zermatchst haben“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09ac6c59-4024-3643-88f5-16b286de7af8",
                        "entry_id": "9f1c2eaf-5249-3dd0-95b6-004d4ac0697a",
                        "glosses": [
                            "tödlich verunglücken, indem man zu Brei zerquetscht wird"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "ad5599bd-62c0-4cc3-bed3-dad8f26dfed4",
                                "sense_id": "09ac6c59-4024-3643-88f5-16b286de7af8",
                                "text": "„Ich war zwar nicht dabei, aber einen hat’s derbatzt, der war tot, als eine Mauer auf ihn gefallen ist.“"
                            },
                            {
                                "example_id": "5f1f1c33-7cbc-450e-ba63-9b066668ae3d",
                                "sense_id": "09ac6c59-4024-3643-88f5-16b286de7af8",
                                "text": "„»Heid hods oan dabaazt, beim Schnapper vorn« erzählt von einem Mann, der in die Wirtschaft kommt und von einem schweren Verkehrsunfall berichtet.“"
                            },
                            {
                                "example_id": "a1b2288f-73bc-42f3-a174-9188b04b9883",
                                "sense_id": "09ac6c59-4024-3643-88f5-16b286de7af8",
                                "text": "„Es gibt a paar Bergbauern bei uns, die pfuschen jetzt nebenbei als Bergrettung. Die sind natürlich billiger. Aber sie sind auch viel schlechter ausgerüstet. Oan hat es unlängst derbatzt. Dem is des Seil gerissen. Des war a alter Kälberstrick.“"
                            },
                            {
                                "example_id": "29d02447-7c7e-464d-9a8f-6a5cfc1f879e",
                                "sense_id": "09ac6c59-4024-3643-88f5-16b286de7af8",
                                "text": "„Auf solchen Strecken dabatzt es — wie man bei uns sagt — ja auch heute noch gerne betrunkene Discoheimfahrer, deren Gedenkkreuze dann den Wegesrand säumen.“"
                            },
                            {
                                "example_id": "e9f93cb1-a0de-4770-8a04-9a9df164eaaf",
                                "sense_id": "09ac6c59-4024-3643-88f5-16b286de7af8",
                                "text": "„Da had ma nimma seng kina wos des fia ra Audo gwen is, en Fahra den had s dodal dabatzd khad.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d598eb24-4cfa-407a-8048-9465aee26824",
                        "source_entry_id": "9f1c2eaf-5249-3dd0-95b6-004d4ac0697a",
                        "source_sense_id": "d5396f06-a41f-3fba-aeb3-e10f0f73b690",
                        "source_sense_description": "bairisch: zu Brei oder Matsch zerquetschen",
                        "target_lang_word": "zermatschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zermatschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6b14c1-cf97-36b4-87ac-717a83b65083",
                                        "entry_id": "6ab1de74-b0e3-3c00-a534-3c1db95c5fd9",
                                        "glosses": [
                                            "etwas zu Brei zerdrücken oder zerstampfen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c37a721-ebb4-48d0-a2bc-d9baf6ff47d3",
                                                "sense_id": "ac6b14c1-cf97-36b4-87ac-717a83b65083",
                                                "text": "Hunde essen wir nicht. Nacktschnecken zerschneiden wir mit Gartenscheren, Weinbergschnecken zermatschen wir vor dem Essen."
                                            },
                                            {
                                                "example_id": "0db4bfa7-0791-42ab-aeef-cb9a7b19b2ab",
                                                "sense_id": "ac6b14c1-cf97-36b4-87ac-717a83b65083",
                                                "text": "Mit einem Nagel zwischen den Fingern seiner Faust fuchtelt er vor dem Gesicht seines Opfers herum, droht, ihm damit das Gesicht zu zermatschen."
                                            },
                                            {
                                                "example_id": "e8367f42-afa1-42ba-a35e-88326f920f77",
                                                "sense_id": "ac6b14c1-cf97-36b4-87ac-717a83b65083",
                                                "text": "Kondom mit dem Ring auf die Eichel, also die Bananenspitze, setzen und mit nicht zu festem Druck nach unten streifen. Natürlich zermatschen sieben die Bananen, zerstechen drei die Kondome, fordern zwei, dies sei doch Frauensache."
                                            },
                                            {
                                                "example_id": "f2d8042d-435a-4470-aaab-678c68bee9d4",
                                                "sense_id": "ac6b14c1-cf97-36b4-87ac-717a83b65083",
                                                "text": "Dann wirbeln Beine in Camouflage-Leggins durch die Luft, rotleuchtende Sneaker schlagen krachend in Koksfressen ein, weibliche Fäuste zermatschen Männerfleisch."
                                            },
                                            {
                                                "example_id": "5b97e87f-56f4-40e0-a3b0-7f6bd4871bd6",
                                                "sense_id": "ac6b14c1-cf97-36b4-87ac-717a83b65083",
                                                "text": "Verurtheilte aus dem geistlichen Gelehrtenstande wurden in einem großen Mörser langsam zermatscht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "459dfba2-9097-47b9-9ffb-09e096d6e544",
                        "source_entry_id": "9f1c2eaf-5249-3dd0-95b6-004d4ac0697a",
                        "source_sense_id": "d5396f06-a41f-3fba-aeb3-e10f0f73b690",
                        "source_sense_description": "bairisch: zu Brei oder Matsch zerquetschen",
                        "target_lang_word": "zerquetschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerquetschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9598d9b-1d5e-3044-8be3-57e31c954d24",
                                        "entry_id": "f7cae3fc-56d5-385d-8dd5-f91c943b0d67",
                                        "glosses": [
                                            "etwas oder jemanden durch große Krafteinwirkung zerdrücken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d4afb11-c909-40f5-931b-dd375cfc895d",
                                                "sense_id": "e9598d9b-1d5e-3044-8be3-57e31c954d24",
                                                "text": "In New York ist ein Mann von einem Aufzug zerquetscht worden."
                                            },
                                            {
                                                "example_id": "bc22b23d-ba7b-4d9b-aff1-2577b2606d97",
                                                "sense_id": "e9598d9b-1d5e-3044-8be3-57e31c954d24",
                                                "text": "Mehr als 700 Menschen wurden zerquetscht und zertreten und über 800 weitere verletzt, als die Menge vor der Dschamarat-Brücke bei Minā plötzlich außer Kontrolle geriet."
                                            },
                                            {
                                                "example_id": "e66e77de-46be-40c4-a4af-d6916a5ee2d5",
                                                "sense_id": "e9598d9b-1d5e-3044-8be3-57e31c954d24",
                                                "text": "Es [Europa] muss aufpassen, dass es in diesem Sandwich nicht zerquetscht wird."
                                            },
                                            {
                                                "example_id": "7f912c88-3c61-47fd-af6a-32d15bcb5237",
                                                "sense_id": "e9598d9b-1d5e-3044-8be3-57e31c954d24",
                                                "text": "Mit einer Handprothese lassen sich sogar Weintrauben und Kirschen abzupfen, ohne die Früchte zu zerquetschen."
                                            },
                                            {
                                                "example_id": "950e37fb-bd80-4159-9597-a6754d602fe2",
                                                "sense_id": "e9598d9b-1d5e-3044-8be3-57e31c954d24",
                                                "text": "Sobald die Kartoffeln gesotten sind, zerquetscht man sie so vollkommen, als man kann, zwischen zwei hölzernen Walzen, wovon jede an ihrem einen Ende ein gezahntes Rad hat, und mittels einer Kurbel bewegt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8016e3e-f021-4689-8441-fbeac0e2d604",
                        "source_entry_id": "9f1c2eaf-5249-3dd0-95b6-004d4ac0697a",
