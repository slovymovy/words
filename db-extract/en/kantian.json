                                "target_senses": [
                                    {
                                        "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                        "entry_id": "8fb8ed4c-c22a-365a-bfbe-65144f2d2356",
                                        "glosses": [
                                            "die Schüler und Denker im Sinne Kants betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7621450-b1df-4026-bf60-a72b80f3d3bd",
                                                "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                                "text": "„Das politische Engagement von Karl Jaspers und von Werner Mathofer scheint mir kantianisch motiviert gewesen sein.“"
                                            },
                                            {
                                                "example_id": "14457349-1f04-4f77-8a33-05942d2b5050",
                                                "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                                "text": "„Vor diesem Hintergrund hat jüngst Michael Winkler […] nahe gelegt, das Projekt der Kritik in der Sozialen Arbeit als eine […] eher kantianisch angelegte Kritik an der Kritik weiter zu verfolgen […]“"
                                            },
                                            {
                                                "example_id": "5a536d03-9e10-47a1-88fc-f7feaf694418",
                                                "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                                "text": "„Dabei drängt sich die Frage auf, wie es möglich sein kann, zugleich kantianisch zu leben […] und gleichzeitig zu solch schrecklichen Taten fähig zu sein […]?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
