                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bcb998fc-8ccd-4bca-baea-782f3ba2566e",
                                "sense_id": "17a26961-2afb-3a54-9f51-36af6cc130a3",
                                "text": "La chambre de Corbeau était la seule de l'étage encore nantie d'une porte."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3a3a485-b254-35cd-be71-69724c7be119",
