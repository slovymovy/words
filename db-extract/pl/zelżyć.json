                        "source_sense_id": "3e760d2a-14e8-359b-9799-de6872c3d500",
                        "target_lang_word": "beschimpfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beschimpfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc2a09b0-77bf-303d-bd92-3b5e9f45506b",
                                        "entry_id": "1022df00-d260-389b-a50e-4609afff5f09",
                                        "glosses": [
                                            "jemanden durch Schimpfworte oder Schmähungen beleidigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d353021a-5953-49a9-b5f6-df72585518b1",
                                                "sense_id": "bc2a09b0-77bf-303d-bd92-3b5e9f45506b",
                                                "text": "Ich muss mich von Ihnen nicht als Spießbürger beschimpfen lassen!"
                                            },
                                            {
                                                "example_id": "ac214dc3-7d52-4a5c-88aa-192f0ad867c1",
                                                "sense_id": "bc2a09b0-77bf-303d-bd92-3b5e9f45506b",
                                                "text": "Für Aufsehen sorgte Lothar Tietge, Mitglied der SPD-Fraktion und der Kleinpartei Tierschutzpartei, der nach Angaben der Magdeburger Volksstimme seine Politikerkollegen beschimpfte und ihnen mangelnde Bürgernähe vorwarf."
                                            },
                                            {
                                                "example_id": "4eb57614-4f4f-457d-9689-0fe46c68188a",
                                                "sense_id": "bc2a09b0-77bf-303d-bd92-3b5e9f45506b",
                                                "text": "Nach der Ansprache wurde der Mann von den beiden zunächst bespuckt und beschimpft, woraufhin sich das Opfer in einen anderen Waggon entfernte."
                                            },
                                            {
                                                "example_id": "ccad6214-5af7-4e09-9417-a1013ef1e72c",
                                                "sense_id": "bc2a09b0-77bf-303d-bd92-3b5e9f45506b",
                                                "text": "„Wenn also die Fassaden unserer anerzogenen Höflichkeit wanken, kann es auch mal richtig befreiend sein, einen derben Fluch auszustoßen oder jemanden nach Herzenslust zu beschimpfen.“"
                                            },
                                            {
                                                "example_id": "c3ccc233-f407-47b7-a172-93ee8fb2ae68",
                                                "sense_id": "bc2a09b0-77bf-303d-bd92-3b5e9f45506b",
                                                "text": "Sie brüllen und pöbeln, sie beschimpfen nicht nur andere Spieler, Trainer und Schiedsrichter, sondern sogar ihre eigenen Kinder. Aggressive Eltern am Spielfeldrand werden für den Berliner Fußballverband zu einem immer größeren Problem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
