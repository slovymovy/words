                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5edf2ed-5e4a-31c2-9daa-effa72d20478",
                        "entry_id": "b762dfc1-3f67-3b55-9946-f875f37e26c6",
                        "glosses": [
                            "Nom donné à une région d’Asie Mineure, au nord-ouest de l’Iran actuel, entre la mer Caspienne et le Golfe Persique, qui était habitée par les Mèdes."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "e8fa9ecf-957c-4787-ab12-f21b39a3711b",
                                "sense_id": "a5edf2ed-5e4a-31c2-9daa-effa72d20478",
                                "text": "On trouva dans le château d’Ecbatane dans la Médie, l’Original de la permission que Cyrus avoit accordée aux Juifs de s’en retourner dans leur pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dff44f4-56f9-3562-9b7e-8b1c318a3d2d",
                        "entry_id": "b762dfc1-3f67-3b55-9946-f875f37e26c6",
                        "glosses": [
                            "Nom de l’empire des Mèdes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c5c2e5-a130-4caf-bf1f-d03ab2b11bf0",
                                "sense_id": "2dff44f4-56f9-3562-9b7e-8b1c318a3d2d",
                                "text": "L’étude de la Médie aborde notamment la question des relations culturelles entre les Mèdes et les Perses."
                            }
                        ]
                    }
                ],
