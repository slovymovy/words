                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fcc8ce7-3324-44eb-8510-97791e8ad197",
                                                "sense_id": "75c1cde8-27a6-3653-bb23-2393c2b90ca6",
                                                "text": "Alaunstein war schon zu alten Zeiten und ist noch jetzt Gegenstand bedeutenden Bergbaues."
                                            }
