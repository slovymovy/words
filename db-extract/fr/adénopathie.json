            {
                "entry_id": "d1a41975-fc16-37e4-842c-4d8cb2106f7f",
                "word": "adénopathie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "15bb8018-27de-4f07-b130-8d4fd61eef1f",
                        "entry_id": "d1a41975-fc16-37e4-842c-4d8cb2106f7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "adénopathies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                        "entry_id": "d1a41975-fc16-37e4-842c-4d8cb2106f7f",
                        "glosses": [
                            "État pathologique d’un ganglion lymphatique dont l’inflammation peut avoir plusieurs origines étiologiques."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e60ad616-e7d2-40da-9b30-8028deee5a46",
                                "sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                                "text": "En pratique, la recherche directe du tréponème pâle se fera essentiellement au niveau du chancre, des adénopathies, des plaques muqueuses et des syphilides cutanées."
                            },
                            {
                                "example_id": "35960958-eee4-4490-a68b-241bf35e2245",
                                "sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                                "text": "Des anomalies majeures radiologiques (atélectasie, épanchement pleural, pneumonie et/ou adénopathies) sont peu probables en l'absence de tout signe respiratoire (sensibilité de 80 %)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bea24bd7-a804-416c-ad31-8b161869b598",
                        "source_entry_id": "d1a41975-fc16-37e4-842c-4d8cb2106f7f",
                        "source_sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                        "target_lang_word": "Adenopathie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adenopathie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c601d274-17f1-3249-ad26-8c3aacecb907",
                                        "entry_id": "3436bef9-972e-3952-bc59-392319a33671",
                                        "glosses": [
                                            "Erkrankung endokriner oder exokriner Drüsen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3ad813-49a0-4f72-bf19-9062c1d5c394",
                                                "sense_id": "c601d274-17f1-3249-ad26-8c3aacecb907",
                                                "text": "Bei jungen Erwachsenen ist die Ursache der Adenopathie meist infektiös oder reaktiv, bei älteren Menschen oft eine Neoplasie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b66c12e-9781-3d46-9c47-bcca123b11e6",
                                        "entry_id": "3436bef9-972e-3952-bc59-392319a33671",
                                        "glosses": [
                                            "Erkrankung der Lymphknoten, ganz besonders die der Bronchial-Drüse"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "867408ac-9407-4835-8ed0-acf502293616",
                                                "sense_id": "3b66c12e-9781-3d46-9c47-bcca123b11e6",
                                                "text": "Dieses Zeichen ist für den Spezialisten interessant, insoferne, als es bei der tracheo-bronchialen Adenopathie vorkommt, die eine so grosse Bedeutung in der Diagnose der Krankheiten der oberen Luftwege hat."
                                            },
                                            {
                                                "example_id": "18116b85-c714-4093-ae42-741b6110e638",
                                                "sense_id": "3b66c12e-9781-3d46-9c47-bcca123b11e6",
                                                "text": "Das Sekundärstadium beginnt mit einer schmerzhaften inguinalen Adenopathie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
