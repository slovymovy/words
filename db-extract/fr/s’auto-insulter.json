                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87283c5a-215c-4b57-b59e-cfb9debcb899",
                                "sense_id": "8979658f-44d7-368f-b004-a6631340bfa3",
                                "text": "Je pourrais m’auto-insulter à perte de vulve."
                            },
                            {
