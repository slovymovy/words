                                    {
                                        "sense_id": "34aea484-1c19-36a7-92a6-7d4eea639fbd",
                                        "entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                                        "glosses": [
                                            "A commoner; a member of the lower class of a society."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14c2278a-be0a-3d6d-8962-29e3e1bc593e",
                                        "entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                                        "glosses": [
                                            "A common person; an unsophisticated or cultureless person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d1ae00d-ccb5-44f9-9db0-01aa8c1006bd",
                                                "sense_id": "14c2278a-be0a-3d6d-8962-29e3e1bc593e",
                                                "text": "You're under my roof, you pleb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f934fa50-9131-3efa-9b16-c91db54d24b8",
                                        "entry_id": "21e165de-8fdf-3809-936e-44f6c666e25b",
                                        "glosses": [
                                            "A freshman cadet at a military academy."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1718c65-b7fc-478a-9d45-e8f9f739cd68",
                                                "sense_id": "f934fa50-9131-3efa-9b16-c91db54d24b8",
                                                "text": "I found some of the novices, plebs they are called, home-sick, and weary with their discipline."
                                            },
                                            {
                                                "example_id": "1d42972c-63f3-43c0-af9a-44c642574fac",
                                                "sense_id": "f934fa50-9131-3efa-9b16-c91db54d24b8",
                                                "text": "At Annapolis, the natives are crabs, the freshmen plebs, the sophomores youngsters."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pleb",
                                "target_lang_code": "en",
