                                        "entry_id": "cf162ff0-e180-3631-92f9-5cd490fa0d67",
                                        "glosses": [
                                            "An outcrop that is mined for the ore it contains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b126d12-6336-47c3-b182-368869d25298",
                                                "sense_id": "a1fb9af6-220a-3b3c-a75b-991f0cf42f5b",
                                                "text": "Their croppings are either entirely barren or contain only a moderate amount of copper, but much richer ore is ordinarily found just above the chalcocite zone."
                                            },
                                            {
                                                "example_id": "155d399c-ba8f-4a23-8a8e-28e8ffc3bec6",
                                                "sense_id": "a1fb9af6-220a-3b3c-a75b-991f0cf42f5b",
                                                "text": "The cropping of the Quincy ore-bearing bed, the equivalent of the Daly West bed, is stated to have been found at the east end of the present mine and just below the present wagon road."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
