                    {
                        "translation_id": "8bb18bcc-d21e-4fca-8775-74b31f3273e5",
                        "source_entry_id": "4421a95b-8d39-3e5a-b283-3e9f64017db6",
                        "target_lang_word": "бивак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бивак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "40d554e0-fe96-30a9-86f3-efd11eda229e",
                                        "entry_id": "ccca437c-68d1-3833-8e44-96776dabb5ad",
                                        "glosses": [
                                            "устар., воен. стоянка войск для ночлега или отдыха под открытым небом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899684aa-516e-4873-b5f5-86e438ff9857",
                                                "sense_id": "40d554e0-fe96-30a9-86f3-efd11eda229e",
                                                "text": "Но тих был наш бивак открытый // Кто кивер чистил весь избитый, // Кто штык точил, ворча сердито, // Кусая длинный ус."
                                            },
                                            {
                                                "example_id": "422397aa-872e-4fde-b9b7-6bd103247735",
                                                "sense_id": "40d554e0-fe96-30a9-86f3-efd11eda229e",
                                                "text": "Порою рисовалось моему юношескому воображению зарево биваков, опасное участие в ночном пикете, к которому ветерок доносит жуткий говор неприятеля, жаркая схватка, отважная выручка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385969ad-9cea-32db-91d2-057b1e11bf69",
                                        "entry_id": "ccca437c-68d1-3833-8e44-96776dabb5ad",
                                        "glosses": [
                                            "временное месторасположение путешественников"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "982cad07-899b-4e41-87aa-d96d6ca63082",
                                                "sense_id": "385969ad-9cea-32db-91d2-057b1e11bf69",
                                                "text": "В поле разбили бивак, ужинали с водкой, а потом без музыки танцевали польку-кокетку."
                                            },
                                            {
                                                "example_id": "1fdedbed-1aba-45dd-98f5-929f7e435515",
                                                "sense_id": "385969ad-9cea-32db-91d2-057b1e11bf69",
                                                "text": "Естественно, не стоит злоупотреблять гостеприимством местных жителей ― бивак за собой надо оставить чистым."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5eded5d-1a04-43b1-826e-2bcd5d52d7df",
                        "source_entry_id": "4421a95b-8d39-3e5a-b283-3e9f64017db6",
                        "target_lang_word": "bivak",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "973f97bd-94be-4da0-ada0-e83e0a4ab14a",
                        "source_entry_id": "4421a95b-8d39-3e5a-b283-3e9f64017db6",
                        "source_sense_id": "9bda1298-80d4-3314-929e-48676728c605",
                        "source_sense_description": "Lieu de campement en plein air",
                        "target_lang_word": "Nachtlager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtlager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                        "entry_id": "188bc243-b725-376f-85c8-075cf139369a",
                                        "glosses": [
                                            "Ort zum Schlafen in der Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "890c7457-48f5-4b76-a1b4-51fd08bbf8e6",
                                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                                "text": "Sie schlugen ihr Nachtlager am See auf."
                                            },
                                            {
                                                "example_id": "5491c152-1130-4f8d-9ef4-ec1fea3b9241",
                                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                                "text": "„Erst als alle ihr klägliches Nachtlager bezogen hatten, sprach Lea in die Dunkelheit hinein.“"
                                            },
                                            {
                                                "example_id": "f5718dad-1a61-402d-9567-65c068c8f35d",
                                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                                "text": "„In Marseille schlug ich mein Nachtlager in einem angenehm heruntergekommenen Hotel an der Corniche auf, der Küstenstraße, die sich am Mittelmeer entlang schlängelt.“"
                                            },
                                            {
                                                "example_id": "4365eadf-d237-476e-b5dc-cd55e20a93a2",
                                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                                "text": "„Ein Trompeter blies die Sonne in ihr Nachtlager, die Soldaten sangen Lieder und schwärmten von Fischen und gebratenem Ochsenfleisch.“"
                                            },
                                            {
                                                "example_id": "044226fb-e8a2-4f28-b87d-3af28a5d6e45",
                                                "sense_id": "d0e752cd-5c17-3cd1-8c7a-a6a34ca0d66b",
                                                "text": "„Der Vogt hatte einen Boten zu seinen Dienern geschickt, daß sie der Tochter des Richters ihr Nachtlager bereiteten und sie bedienten, und sie kamen mit Braten und Wein, als der Richter Abschied von seiner Tochter nahm und zu seiner Thingbude und seinen Gästen zurückging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2aa4f1ed-5f57-497f-8530-5f6505c2108f",
                        "source_entry_id": "4421a95b-8d39-3e5a-b283-3e9f64017db6",
                        "source_sense_id": "9bda1298-80d4-3314-929e-48676728c605",
                        "source_sense_description": "Lieu de campement en plein air",
                        "target_lang_word": "Biwak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biwak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77fc6576-4f4b-37dc-93ca-f05450d2fdcb",
                                        "entry_id": "d520917e-a30c-351d-9231-6f18699ad08c",
                                        "glosses": [
                                            "Lager im Freien, in Hütten oder Zelten (vor allem von Soldaten oder Bergsteigern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c47593-50df-4cad-a84b-f9b88680038e",
                                                "sense_id": "77fc6576-4f4b-37dc-93ca-f05450d2fdcb",
                                                "text": "Sie mussten ihr Biwak wegen des Wetters früher als geplant aufschlagen."
                                            },
                                            {
                                                "example_id": "faf010a0-a24b-4fc5-8d8a-a2173bfae8a7",
                                                "sense_id": "77fc6576-4f4b-37dc-93ca-f05450d2fdcb",
                                                "text": "„Abends schlugen sie unweit der Gräber ihr Biwak auf.“"
                                            },
                                            {
                                                "example_id": "822a84b6-b29e-4b00-b551-fa883eff6a64",
                                                "sense_id": "77fc6576-4f4b-37dc-93ca-f05450d2fdcb",
                                                "text": "„Er liess sich sein Pferd satteln und ritt vom Biwak seines Regiments aus zum väterlichen Gut, auf welchem er geboren war und seine Kindheit verlebt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
