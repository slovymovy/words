{
    "word_family": [
        "bot",
        "botheid",
        "botuit"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "da514307-518f-3936-a6e6-280754bcaf97",
                    "sense_definition": "op een onbeleefde, directe en kortaf manier zonder rekening te houden met anderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbeleefdheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik hem om hulp vroeg, weigerde hij <w>botweg</w> om ook maar iets te doen.",
                            "target_lang_translations": {
                                "en": "When I asked him for help, he <w>flatly</w> refused to do anything at all."
                            }
                        },
                        {
                            "text": "Het fatsoensmens in je weigert dit <w>botweg</w> te geloven ondanks alle bewijzen.",
                            "target_lang_translations": {
                                "en": "The decent person in you <w>flatly</w> refuses to believe this despite all the evidence."
                            }
                        }
                    ],
                    "antonyms": [
                        "vriendelijk",
                        "beleefd"
                    ],
                    "common_phrases": [
                        "botweg weigeren",
                        "botweg ontkennen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a rude, direct, and abrupt manner without consideration for others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bluntly",
                                "target_lang_sense_clarification": "without delicacy or civility"
                            },
                            {
                                "target_lang_word": "flatly",
                                "target_lang_sense_clarification": "in a firm and final manner, especially when refusing"
                            },
                            {
                                "target_lang_word": "curtly",
                                "target_lang_sense_clarification": "rudely brief or abrupt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7bff2c0-b711-3199-9b29-825ff5548cf3",
                    "sense_definition": "zonder enige nuance of omhaal van woorden; ronduit",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "directheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur zei <w>botweg</w> dat er geen geld meer was voor nieuwe projecten.",
                            "target_lang_translations": {
                                "en": "The director said <w>bluntly</w> that there was no more money for new projects."
                            }
                        },
                        {
                            "text": "Je kunt niet <w>botweg</w> beweren dat alles de schuld van de overheid is.",
                            "target_lang_translations": {
                                "en": "You cannot simply <w>bluntly</w> claim that everything is the government's fault."
                            }
                        }
                    ],
                    "antonyms": [
                        "omzichtig",
                        "genuanceerd"
                    ],
                    "common_phrases": [
                        "botweg zeggen",
                        "botweg beweren"
                    ],
                    "target_lang_definitions": {
                        "en": "without any nuance or beating around the bush; straightforwardly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bluntly",
                                "target_lang_sense_clarification": "straightforwardly and without nuance"
                            },
                            {
                                "target_lang_word": "point-blank",
                                "target_lang_sense_clarification": "directly and without explanation"
                            },
                            {
                                "target_lang_word": "outright",
                                "target_lang_sense_clarification": "completely and without reservation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
