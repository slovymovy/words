                ],
                "senses": [
                    {
                        "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                        "entry_id": "fe4dfd6c-2828-3b80-9ded-a04ee2d4d4fb",
                        "glosses": [
                            "in unterschiedlichen Sprachen vorkommender Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06fee648-0b96-468a-aede-651dc53f37e0",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Frau Kais ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "de4c34a0-81ea-4bbe-ae32-c785a96ab7dc",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Herr Kais wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "13e11cd2-c1c0-4d5e-8de4-f344cf3ee93b",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Die Kais fliegen heute nach Kapstadt."
                            },
                            {
                                "example_id": "aeace7a4-8b16-41a5-a48d-10557fd7998a",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Der Kais trägt nie die Pullover, die die Kais ihm strickt."
                            },
                            {
                                "example_id": "202fcf1c-bb19-49b0-93c9-122f69a23841",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kais kommt, geht der Herr Kais.“"
                            },
                            {
                                "example_id": "b6828421-1b87-4b12-9131-e0806fa257f1",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Kais kommt und geht."
                            },
                            {
                                "example_id": "9efd5928-cb26-4fa1-bdc9-5ef118dbea15",
                                "sense_id": "c6b76c9e-2dd0-3478-8f47-5c9a96576fc6",
                                "text": "Kais kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
