                "senses": [
                    {
                        "sense_id": "b6606675-4c26-339f-a3cf-2de8704fcc20",
                        "entry_id": "ddebec3b-148c-397b-ad8e-60cf73da1704",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным манка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c26cce-b48d-4dfd-9970-e9f23f4288d6",
                                "sense_id": "b6606675-4c26-339f-a3cf-2de8704fcc20",
                                "text": "Собственноручно вскопал на огороде две грядки и посеял на них манную крупу."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fb3ac96-ead9-3b34-a892-34e29066e8b7",
                        "entry_id": "ddebec3b-148c-397b-ad8e-60cf73da1704",
                        "glosses": [
                            "кулин. приготовленный из манки (мелкой крупы из пшеницы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7aad75-0aca-434e-b393-2ff4abc0896c",
                                "sense_id": "5fb3ac96-ead9-3b34-a892-34e29066e8b7",
                                "text": "Есть ей ничего нельзя, кроме манной каши и киселя из свежих фруктов."
                            }
                        ]
                    }
                ],
