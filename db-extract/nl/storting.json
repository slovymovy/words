                                        "sense_id": "3a4a3ad1-8bba-31da-94aa-2aa0977fcd0c",
                                        "entry_id": "ee1b2924-b8b3-3c13-8bfc-575b7be3d20d",
                                        "glosses": [
                                            "Vorgang des Einzahlens von Geld auf ein Bankkonto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eea7a95-f36c-4e4f-90b1-f8b0e2150b99",
                                                "sense_id": "3a4a3ad1-8bba-31da-94aa-2aa0977fcd0c",
                                                "text": "Meine Einzahlung gestern ist irrtümlicherweise auf einem fremden Konto eingegangen."
                                            },
