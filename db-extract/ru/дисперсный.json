                "senses": [
                    {
                        "sense_id": "63cd2546-ece2-3877-9431-6244e3ea9124",
                        "entry_id": "908be6ac-9d71-3c6c-bbdd-6eb3fb9009a3",
                        "glosses": [
                            "физ. связанный, соотносящийся по значению с существительным дисперсия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1197e24-8e60-4a02-a1cb-a51b2bdc0439",
                                "sense_id": "63cd2546-ece2-3877-9431-6244e3ea9124",
                                "text": "Замедленная киносъёмка показывает, как со временем шарики дисперсной фазы сливаются и размер их увеличивается."
                            }
                        ]
                    },
                    {
                        "sense_id": "00569656-67fa-31ff-bda6-20e5d0d1bec9",
                        "entry_id": "908be6ac-9d71-3c6c-bbdd-6eb3fb9009a3",
                        "glosses": [
                            "книжн. рассеянный, раздробленный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d3da227-523c-47b3-976f-6582010f3b7a",
                                "sense_id": "00569656-67fa-31ff-bda6-20e5d0d1bec9",
                                "text": "Официально к коренным малочисленным народам Российского Севера отнесены 30 народов, проживающих на территориях 27 субъектов Российской Федерации, их расселение имеет дисперсный характер, а историческая территория их проживания занимает 64 % территории страны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ac6b94a-587f-4018-8139-412c3afabd78",
                        "source_entry_id": "908be6ac-9d71-3c6c-bbdd-6eb3fb9009a3",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным «дисперсия»",
                        "target_lang_word": "disperse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disperse",
