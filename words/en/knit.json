    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b18bc69-1bd6-3d42-9cf8-0e85ff7d0d90",
                    "sense_definition": "To make clothing or fabric by interlocking loops of wool or yarn with needles or a machine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "create_fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother taught me how to <w>knit</w> a warm scarf.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка научила меня <w>вязать</w> теплый шарф.",
                                "zh": "我祖母教我怎么<w>织</w>一条暖和的围巾。",
                                "es": "Mi abuela me enseñó a <w>tejer</w> una bufanda cálida."
                            }
                        },
                        {
                            "text": "She likes to <w>knit</w> socks for her family during the winter.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>вязать</w> носки для своей семьи зимой.",
                                "zh": "她喜欢在冬天为家人<w>编织</w>袜子。",
                                "es": "A ella le gusta <w>tejer</w> calcetines para su familia durante el invierno."
                            }
                        }
                    ],
                    "antonyms": [
                        "unravel"
                    ],
                    "common_phrases": [
                        "knit a sweater",
                        "knit by hand",
                        "knit a scarf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать одежду или ткань, переплетая петли шерсти или пряжи спицами или на машине.",
                        "zh": "通过使用针或机器将毛线或纱线交织成环来制作衣物或织物。",
                        "es": "Crear ropa o tejido entrelazando bucles de lana o hilo con agujas o una máquina."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязать",
                                "target_lang_sense_clarification": "изготавливать из пряжи"
                            },
                            {
                                "target_lang_word": "связать",
                                "target_lang_sense_clarification": "закончить вязание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编织",
                                "target_lang_sense_clarification": "制作织物或衣物的过程"
                            },
                            {
                                "target_lang_word": "织",
                                "target_lang_sense_clarification": "用针线制作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tejer",
                                "target_lang_sense_clarification": "hacer tejido cruzando hilos o fibras"
                            },
                            {
                                "target_lang_word": "hacer punto",
                                "target_lang_sense_clarification": "tejer a mano prendas con agujas"
                            },
                            {
                                "target_lang_word": "tricotar",
                                "target_lang_sense_clarification": "término técnico para tejer con agujas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98d1137b-c7dd-346f-9d89-9a0a63b3f872",
                    "sense_definition": "To join people or things closely and firmly together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shared tragedy <w>knitted</w> the small community together.",
                            "target_lang_translations": {
                                "ru": "Общая трагедия <w>сплотила</w> маленькую общину.",
                                "zh": "共同的悲剧将这个小社区<w>凝聚</w>在了一起。",
                                "es": "La tragedia compartida <w>unió</w> a la pequeña comunidad."
                            }
                        },
                        {
                            "text": "Common interests can help to <w>knit</w> a group of strangers into a team.",
                            "target_lang_translations": {
                                "ru": "Общие интересы могут помочь <w>сплотить</w> группу незнакомцев в команду.",
                                "zh": "共同的兴趣有助于将一群陌生人<w>团结</w>成一个团队。",
                                "es": "Los intereses comunes pueden ayudar a <w>unir</w> a un grupo de desconocidos en un equipo."
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "bond",
                        "connect",
                        "join"
                    ],
                    "antonyms": [
                        "separate",
                        "divide"
                    ],
                    "common_phrases": [
                        "knit together",
                        "closely knit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесно и прочно соединять людей или вещи вместе.",
                        "zh": "将人或事物紧密且牢固地结合在一起。",
                        "es": "Unir a personas o cosas de manera estrecha y firme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплачивать",
                                "target_lang_sense_clarification": "объединять людей"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "соединять в целое"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "соединять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "团结",
