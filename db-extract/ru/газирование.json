                                        "sense_id": "fa7079d8-2dc0-3d6b-b62f-6be55a6fd5b6",
                                        "entry_id": "fbbf47e9-59b6-36e2-83d3-e2cc1187d923",
                                        "glosses": [
                                            "Behandlung mit (giftigem) Gas (etwa zur Schädlingsbekämpfung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86375afd-a1bc-4c25-80f4-135bcfdb4821",
                                                "sense_id": "fa7079d8-2dc0-3d6b-b62f-6be55a6fd5b6",
                                                "text": "„Am Wochenende sind die Planen wieder weg, die Kirche in Kirchseeon ist dann nach einer mehrtägigen Begasung mit einem Schädlingsbekämpfungsmittel wieder frei zugänglich – und holzwurmfrei.“"
                                            },
                                            {
                                                "example_id": "90cb8b6b-8e8b-4fb0-b2c1-0b4caeb8cd2c",
                                                "sense_id": "fa7079d8-2dc0-3d6b-b62f-6be55a6fd5b6",
                                                "text": "„Weil der Apfel aber selbst das Reifungshormon Ethylen produziert und daher weiter reift, hat sich in den letzten Jahren die Begasung mit 1-Methylcyclopropen (1-MCP) verbreitet.“"
                                            },
                                            {
                                                "example_id": "d9f983c4-0007-4705-a55a-8b9daea954a7",
                                                "sense_id": "fa7079d8-2dc0-3d6b-b62f-6be55a6fd5b6",
                                                "text": "„Der Hamburger Jurist plädiert schon lange für eine Jagdreform und gewann auch bereits einen Musterprozess gegen die Begasung von Fuchsbauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
