    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27f630ae-94d5-3a8e-b85f-da3b311249ec",
                    "sense_definition": "iets wegnemen van iemand en het zich wederrechtelijk toe-eigenen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "diefstal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bleek dat zijn mobieltje <w>gestolen</w> was door Ronald.",
                            "target_lang_translations": {
                                "en": "It turned out that his mobile phone had been <w>stolen</w> by Ronald."
                            }
                        },
                        {
                            "text": "Je mag nooit geld <w>stelen</w> uit de portemonnee van je ouders.",
                            "target_lang_translations": {
                                "en": "You must never <w>steal</w> money from your parents' wallet."
                            }
                        }
                    ],
                    "synonyms": [
                        "jatten",
                        "ontvreemden",
                        "pikken",
                        "gappen",
                        "dieven",
                        "weghalen"
                    ],
                    "antonyms": [
                        "geven",
                        "schenken"
                    ],
                    "common_phrases": [
                        "geld stelen",
                        "een fiets stelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to take something from someone and illegally claim it as one's own"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "steal",
                                "target_lang_sense_clarification": "to take illegally without permission"
                            },
                            {
                                "target_lang_word": "pilfer",
                                "target_lang_sense_clarification": "to steal in small quantities"
                            },
                            {
                                "target_lang_word": "thieve",
                                "target_lang_sense_clarification": "to commit theft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "548494f1-f11b-3110-b23f-416f2dd6f1d8",
                    "sense_definition": "van de <w>steel</w> ontdoen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "steel-bewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de kersen eerst <w>stelen</w> voordat je ze in de pot doet.",
                            "target_lang_translations": {
                                "en": "You must <w>destem</w> the cherries first before putting them in the pot."
                            }
                        },
                        {
                            "text": "De tuinman was de hele middag bezig met het <w>stelen</w> van de geoogste vruchten.",
                            "target_lang_translations": {
                                "en": "The gardener spent the whole afternoon <w>stemming</w> the harvested fruits."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to remove the stem from a fruit or plant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "destem",
                                "target_lang_sense_clarification": "to remove the stems from fruit"
                            },
                            {
                                "target_lang_word": "stem",
                                "target_lang_sense_clarification": "to remove the stem from"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0911a03-a8fa-30cc-aa61-b39486d39732",
                    "sense_definition": "van een <w>steel</w> voorzien",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "steel-bewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De smid moet de nieuwe bijl nog <w>stelen</w> met een stevig stuk hout.",
                            "target_lang_translations": {
                                "en": "The blacksmith still has to <w>haft</w> the new axe with a sturdy piece of wood."
                            }
                        },
                        {
                            "text": "Het gereedschap werd zorgvuldig <w>gesteeld</w> voor een betere grip.",
                            "target_lang_translations": {
                                "en": "The tool was carefully <w>fitted with a handle</w> for a better grip."
                            }
                        }
                    ],
                    "target_lang_definitions": {
