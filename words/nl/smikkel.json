                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "smikkelen_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>smikkel</w> je zo stiekem van die koekjes voor het avondeten?",
