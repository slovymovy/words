                    ]
                },
                {
                    "sense_id": "aa69fcb9-de35-325f-9583-ef31d1989cdf",
                    "sense_definition": "Période de déclin progressif ou de vieillissement d'une chose, d'une institution.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vieillesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce royaume entrait lentement dans son <w>automne</w>, perdant peu à peu sa puissance passée."
                        },
                        {
                            "text": "L'écrivain décrit avec mélancolie l'<w>automne</w> d'un empire qui semblait autrefois invincible."
