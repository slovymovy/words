                    {
                        "sense_id": "f49b23c7-868f-35a0-93e8-8c2261d3a70a",
                        "entry_id": "1ee08995-c0a7-3d9e-9819-8848e143709a",
                        "glosses": [
                            "A title of a friar or monk: brother."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55549af-3b3f-4327-b050-2e190c3991cb",
                                "sense_id": "f49b23c7-868f-35a0-93e8-8c2261d3a70a",
                                "text": "You have at Naples your Fra Bernardino; / And I at Fondi have my Fra Bastiano, / The famous artist, who has come from Rome / To paint my portrait."
                            },
                            {
                                "example_id": "99c61468-83da-421d-b818-f9f9d95c4bc0",
                                "sense_id": "f49b23c7-868f-35a0-93e8-8c2261d3a70a",
                                "text": "The writer has spoken to his two companions, Fathers Eliseus and Elias, desiring them to go, if only to gather intelligence about those parts; but both are of one mind that the basis of operations, as laid down by Fra Simon, is not substantiated […]"
                            },
                            {
                                "example_id": "4005020d-841d-425c-bc77-24398fea2f90",
                                "sense_id": "f49b23c7-868f-35a0-93e8-8c2261d3a70a",
                                "text": "\"She is in the hands of Mrs. Coulter,\" said Fra Pavel."
                            }
                        ]
                    }
                ],
