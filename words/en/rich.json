    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "888beeee-3772-33c2-93c8-829389bb29e5",
                    "sense_definition": "Having a great deal of money, assets, or valuable possessions.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>richest</w> person in the world saw their net worth hit a new record today.",
                            "target_lang_translations": {
                                "ru": "Самый <w>богатый</w> человек в мире увидел сегодня, как его состояние достигло нового рекорда."
                            }
                        },
                        {
                            "text": "He became <w>filthy</w> <w>rich</w> after selling his technology company to a major corporation.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>сказочно</w> <w>богат</w> после продажи своей технологической компании крупной корпорации."
                            }
                        }
                    ],
                    "synonyms": [
                        "wealthy",
                        "well-to-do",
                        "moneyed",
                        "loaded",
                        "filthy rich",
                        "well-heeled"
                    ],
                    "antonyms": [
                        "poor"
                    ],
                    "common_phrases": [
                        "filthy rich",
                        "rich and famous",
                        "stinking rich"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий большим количеством денег, активов или ценного имущества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "имеющий большое состояние"
                            },
                            {
                                "target_lang_word": "состоятельный",
                                "target_lang_sense_clarification": "обеспеченный, имеющий достаток"
                            },
                            {
                                "target_lang_word": "зажиточный",
                                "target_lang_sense_clarification": "имеющий хороший доход и имущество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36477923-82b7-39a8-8631-aff6819df467",
                    "sense_definition": "Containing a large amount of fat, sugar, eggs, or cream, often resulting in an intense flavor.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This chocolate cake is very <w>rich</w> and creamy, so I can only eat a small piece.",
                            "target_lang_translations": {
                                "ru": "Этот шоколадный торт очень <w>сытный</w> и кремовый, поэтому я могу съесть только маленький кусочек."
                            }
                        },
                        {
                            "text": "The chef prepared a <w>rich</w> <w>sauce</w> using heavy cream and several types of cheese.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил <w>насыщенный</w> соус, используя жирные сливки и несколько видов сыра."
                            }
                        }
                    ],
                    "antonyms": [
                        "plain"
                    ],
                    "common_phrases": [
                        "rich sauce",
                        "rich dessert",
                        "rich food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий большое количество жира, сахара, яиц или сливок, что часто дает насыщенный вкус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "о пище с высоким содержанием жиров"
                            },
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "об интенсивном вкусе"
                            },
                            {
                                "target_lang_word": "сытный",
                                "target_lang_sense_clarification": "питательный и калорийный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                    "sense_definition": "Existing in large quantities; plentiful or abundant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The region is <w>rich</w> <w>in</w> <w>natural</w> <w>resources</w> like oil and minerals.",
                            "target_lang_translations": {
                                "ru": "Регион <w>богат</w> природными ресурсами, такими как нефть и минералы."
                            }
                        },
                        {
                            "text": "The city has a <w>rich</w> history that dates back to the Roman Empire.",
                            "target_lang_translations": {
                                "ru": "Город имеет <w>богатую</w> историю, которая восходит к временам Римской империи."
                            }
                        }
                    ],
                    "synonyms": [
                        "wealthy"
                    ],
                    "antonyms": [
                        "scarce"
                    ],
                    "common_phrases": [
                        "rich in natural resources",
                        "rich history",
                        "rich tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в больших количествах; обильный или многочисленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "обильный чем-либо"
                            },
                            {
                                "target_lang_word": "обильный",
                                "target_lang_sense_clarification": "имеющийся в избытке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c31d310-8bd9-393b-9132-32c7cf0759fc",
                    "sense_definition": "Producing or yielding large amounts of crops or returns; fertile.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "productivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers moved to the valley because of the <w>rich</w> <w>soil</w> found near the river.",
                            "target_lang_translations": {
                                "ru": "Фермеры переехали в долину из-за <w>плодородной</w> почвы у реки."
                            }
                        },
                        {
                            "text": "The <w>rich</w> farmland produced a record-breaking harvest this year.",
                            "target_lang_translations": {
                                "ru": "<w>Богатые</w> сельхозугодья дали в этом году рекордный урожай."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rich soil",
                        "rich farmland"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий или дающий большой урожай или отдачу; плодородный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодородный",
                                "target_lang_sense_clarification": "о почве или земле"
                            },
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "дающий обильный урожай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "657501d1-95ba-3fd4-aca2-4855b0bbd540",
                    "sense_definition": "Strong, deep, and vivid in color or sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset filled the sky with <w>rich</w> <w>colors</w> of orange and purple.",
                            "target_lang_translations": {
                                "ru": "Закат наполнил небо <w>насыщенными</w> оттенками оранжевого и фиолетового."
                            }
                        },
                        {
                            "text": "The singer has a <w>rich</w> voice that resonates throughout the entire concert hall.",
                            "target_lang_translations": {
                                "ru": "У певца <w>глубокий</w> голос, который разносится по всему концертному залу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rich colors",
                        "rich voice",
                        "rich tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, глубокий и яркий (о цвете или звуке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "о цвете или звуке"
                            },
                            {
                                "target_lang_word": "густой",
                                "target_lang_sense_clarification": "о глубоком звуке или цвете"
                            },
                            {
                                "target_lang_word": "сочный",
                                "target_lang_sense_clarification": "о ярком цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8138ec02-c7e1-30f5-9aaf-e02ab6839079",
                    "sense_definition": "Made of expensive or high-quality materials; luxurious and sumptuous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "luxury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen wore a <w>rich</w> gown made of the finest silk and gold thread.",
                            "target_lang_translations": {
                                "ru": "Королева была одета в <w>роскошное</w> платье из тончайшего шелка и золотых нитей."
                            }
                        },
                        {
                            "text": "The room was decorated with <w>rich</w> fabrics and antique furniture.",
                            "target_lang_translations": {
                                "ru": "Комната была украшена <w>дорогими</w> тканями и антикварной мебелью."
                            }
                        }
                    ],
                    "antonyms": [
                        "cheap"
                    ],
                    "common_phrases": [
                        "rich fabrics",
                        "rich materials"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из дорогих или высококачественных материалов; роскошный и пышный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "роскошный, дорогой"
                            },
                            {
                                "target_lang_word": "роскошный",
                                "target_lang_sense_clarification": "пышный и дорогостоящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "785de463-9942-3f50-84d5-6efbe375be95",
                    "sense_definition": "Used to describe a comment or situation that is absurd or hypocritical.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "irony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is <w>a</w> <w>bit</w> <w>rich</w> coming from someone who is never on time themselves.",
                            "target_lang_translations": {
                                "ru": "Это довольно <w>нагло</w> слышать от того, кто сам никогда не приходит вовремя."
                            }
                        },
                        {
                            "text": "It is <w>rich</w> that he is lecturing us about honesty after what he did.",
                            "target_lang_translations": {
                                "ru": "Просто <w>смешно</w>, что он читает нам лекции о честности после того, что он натворил."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a bit rich",
                        "that is rich"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used sarcastically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания комментария или ситуации, которые кажутся абсурдными или лицемерными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешно",
                                "target_lang_sense_clarification": "иронично об абсурдности"
                            },
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "о лицемерии в словах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49599760-00a1-37de-a1cd-1bc2b2c5c6b3",
                    "sense_definition": "Containing complex formatting, multimedia, or high levels of detail and interaction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application provides a <w>rich</w> <w>user</w> <w>experience</w> with interactive maps and videos.",
                            "target_lang_translations": {
                                "ru": "Приложение предлагает <w>полноценный</w> пользовательский опыт с интерактивными картами и видео."
                            }
                        },
                        {
                            "text": "You should save the document as <w>rich</w> <w>text</w> to preserve the bold and italic formatting.",
                            "target_lang_translations": {
                                "ru": "Вам следует сохранить документ как <w>форматированный</w> текст, чтобы сохранить жирный шрифт и курсив."
                            }
                        }
                    ],
                    "antonyms": [
                        "unformatted",
                        "plain"
                    ],
                    "common_phrases": [
                        "rich text",
                        "rich media",
                        "rich user experience"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in computing and media contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий сложное форматирование, мультимедиа или высокий уровень детализации и взаимодействия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширенный",
                                "target_lang_sense_clarification": "с дополнительными возможностями"
                            },
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "насыщенный функциями или контентом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5952e581-5b8a-3043-a8c4-7aebd4c1e33f",
                    "sense_definition": "Having a high concentration of a substance, especially fuel in a fuel-air mixture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine is running <w>rich</w>, which means it is using too much fuel and not enough air.",
                            "target_lang_translations": {
                                "ru": "Двигатель работает на <w>богатой</w> смеси, что означает избыток топлива и нехватку воздуха."
                            }
                        },
                        {
                            "text": "A <w>rich</w> <w>mixture</w> can cause the spark plugs to become fouled over time.",
                            "target_lang_translations": {
                                "ru": "<w>Обогащенная</w> смесь со временем может привести к загрязнению свечей зажигания."
                            }
                        }
                    ],
                    "antonyms": [
                        "lean#Adjective"
                    ],
                    "common_phrases": [
                        "rich mixture",
                        "running rich"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical usage in engineering or chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий высокую концентрацию вещества, особенно топлива в топливно-воздушной смеси."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащенный",
                                "target_lang_sense_clarification": "о топливной смеси"
                            },
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "с избытком топлива"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8143638e-4e1c-31a1-851c-af516e29a0a7",
                    "sense_definition": "Wealthy people considered as a collective group or social class.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is considering new taxes that would primarily affect <w>the</w> <w>rich</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство рассматривает новые налоги, которые в первую очередь затронут <w>богатых</w>."
                            }
                        },
                        {
                            "text": "There is a growing gap between <w>the</w> <w>rich</w> and the poor in many developed nations.",
                            "target_lang_translations": {
                                "ru": "Во многих развитых странах растет разрыв между <w>богатыми</w> и бедными."
                            }
                        }
                    ],
                    "antonyms": [
                        "poor"
                    ],
                    "common_phrases": [
                        "the rich",
                        "eat the rich"
                    ],
                    "target_lang_definitions": {
                        "ru": "Богатые люди, рассматриваемые как коллективная группа или социальный класс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатые",
                                "target_lang_sense_clarification": "социальный класс"
                            },
                            {
                                "target_lang_word": "богачи",
                                "target_lang_sense_clarification": "состоятельные люди"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7e7c350e-c296-3dd8-8bf5-8e14cc71e550",
                    "sense_definition": "A short or informal form of the male name <w>Richard</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Most of his friends call him <w>Rich</w> instead of using his full name.",
                            "target_lang_translations": {
                                "ru": "Большинство друзей зовут его <w>Рич</w> вместо полного имени."
                            }
                        },
                        {
                            "text": "My uncle <w>Rich</w> is coming over for dinner this weekend.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Рич</w> придет к нам на ужин в эти выходные."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Diminutive form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая или неформальная форма мужского имени Ричард."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рич",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45991a39-7499-3137-8ca6-c66198e2075a",
                    "sense_definition": "A family name derived from the given name Richard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a woman named Sarah <w>Rich</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — женщина по имени Сара <w>Рич</w>."
                            }
                        },
                        {
                            "text": "There are several families with the surname <w>Rich</w> living in this town.",
                            "target_lang_translations": {
                                "ru": "В этом городе живут несколько семей с фамилией <w>Рич</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от имени Ричард."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рич",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72c6a848-48ef-3c5c-b2f0-6416fce166b9",
                    "sense_definition": "The name of various geographical locations, such as townships or communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in <w>Rich</w> Township, which is located in Cook County.",
                            "target_lang_translations": {
                                "ru": "Он вырос в тауншипе <w>Рич</w>, который находится в округе Кук."
                            }
                        },
                        {
                            "text": "The small community of <w>Rich</w> is located in the state of Mississippi.",
                            "target_lang_translations": {
                                "ru": "Небольшая община <w>Рич</w> расположена в штате Миссисипи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specific to the United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных географических объектов, таких как поселения или общины в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рич",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43053248-1bb6-336f-ae5d-b6850c915222",
                    "sense_definition": "To make someone or something wealthy or more abundant; to <w>enrich</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enrichment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sought to <w>rich</w> his kingdom through trade and conquest.",
                            "target_lang_translations": {
                                "ru": "Король стремился <w>обогатить</w> свое королевство через торговлю и завоевания."
                            }
