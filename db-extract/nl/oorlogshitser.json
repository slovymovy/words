                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e737af-cbc1-4b57-b6a0-2ba3697d1460",
                                "sense_id": "fd61026d-eb47-3dd6-9be7-3c10ca078a59",
                                "text": "Eerstgenoemde, die bekwamer is dan de meeste leden van zijn huis, was de laatste jaren de ziel van de pan-Slavische beweging, de oorloghitser tegen Duitschland, die ook deelnam aan de Fransche intriges in Lotharingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3f323ae-eb13-4e7b-8122-30206ffa8923",
                        "source_entry_id": "79f2195a-b70a-3e74-99b1-46100a49a03f",
                        "source_sense_id": "fd61026d-eb47-3dd6-9be7-3c10ca078a59",
                        "target_lang_word": "Kriegshetzer",
