                "senses": [
                    {
                        "sense_id": "ea1f96c4-fd84-39d7-a2b8-72c1094d2991",
                        "entry_id": "9d1c8ae0-f2b8-323b-bf09-080cbb3adfb8",
                        "glosses": [
                            "tot het belangrijkste en noodzakelijkste teruggebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1fb38b4-4ab7-4bf5-b8ff-f02aa2f6a4a9",
                                "sense_id": "ea1f96c4-fd84-39d7-a2b8-72c1094d2991",
                                "text": "Hij gaf de beknoptste uiteenzetting van het probleem en eindelijk begreep ik het."
                            },
                            {
                                "example_id": "c2c3b05b-8338-4c44-9f7f-9bb38aa8bff7",
                                "sense_id": "ea1f96c4-fd84-39d7-a2b8-72c1094d2991",
                                "text": "De dood van mijn vrouw is, helaas, slechts een van de tientallen drama’s (dit is een ruwe schatting, het echte getal ligt waarschijnlijk veel hoger) die zich de afgelopen jaren in all-inclusive resorts hebben afgespeeld. Een beknopt overzicht hiervan staat op deze site."
                            },
                            {
                                "example_id": "69c9cf29-4ba9-4d15-9e93-b9d2fb168bec",
                                "sense_id": "ea1f96c4-fd84-39d7-a2b8-72c1094d2991",
                                "text": "‘Dat heb ik zeker verkeerd verstaan,’ zei ze jolig, helemaal in de geest van de beknopte conversatie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0580e4c3-d79c-4f29-9e2e-07638dad5dd6",
                        "source_entry_id": "9d1c8ae0-f2b8-323b-bf09-080cbb3adfb8",
                        "source_sense_id": "ea1f96c4-fd84-39d7-a2b8-72c1094d2991",
