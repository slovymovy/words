                        "cross_references": [
                            {
                                "target_word": "лишение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ef59d263-a9ec-3542-8cd2-dfac54827491",
                                        "entry_id": "3b976d69-504b-3bbe-8edc-48ab6f18abc5",
                                        "glosses": [
                                            "действие по значению гл. лишать, лишить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e01cd190-6863-4fa1-9456-f1c5ea0abe90",
                                                "sense_id": "ef59d263-a9ec-3542-8cd2-dfac54827491",
                                                "text": "Его родная мать издала указ о лишении его престола и отлучении."
                                            },
                                            {
                                                "example_id": "2499dd65-46d7-465f-ba31-4e57ee9097eb",
                                                "sense_id": "ef59d263-a9ec-3542-8cd2-dfac54827491",
                                                "text": "Уголовное наказание в виде лишения свободы исполняется уголовно-исполнительной системой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e471434c-735c-3edd-b892-fb282a34a8c0",
                                        "entry_id": "3b976d69-504b-3bbe-8edc-48ab6f18abc5",
                                        "glosses": [
                                            "перен. недостаток, нужда, жизненное затруднение"
                                        ],
                                        "tags": [
                                            ", обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd67c794-5f36-470a-9ed9-76e352dd43bd",
                                                "sense_id": "e471434c-735c-3edd-b892-fb282a34a8c0",
                                                "text": "С самого младенчества приученные к лишениям всякого рода и в них закалённые, якуты с величайшим терпением противостоят всем житейским нуждам, неразлучным с суровым климатом их земли."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
