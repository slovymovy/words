                    },
                    {
                        "translation_id": "39635590-9464-46d2-bdff-1082265b344d",
                        "source_entry_id": "35de4f15-434b-33ed-b0a1-c3a36878c072",
                        "source_sense_id": "d6dbc995-ff15-3a73-bd91-22a9cfe40daf",
                        "target_lang_word": "neutron star",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutron star",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "738b606d-7e77-3f72-bc50-8f159bdfa8c9",
                                        "entry_id": "2449bd89-d70c-38eb-9542-7307b7e4a15d",
                                        "glosses": [
                                            "A degenerate star that has been so collapsed by gravity that its electrons and protons have been merged into neutrons by the intense pressure. The solid mass of neutrons is sometimes called neutronium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e60b652-8ded-425c-b2f6-d8b4bd65e0de",
                        "source_entry_id": "35de4f15-434b-33ed-b0a1-c3a36878c072",
                        "source_sense_id": "d6dbc995-ff15-3a73-bd91-22a9cfe40daf",
                        "target_lang_word": "étoile à neutrons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étoile à neutrons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69cb46e2-8e33-38b5-962f-747cdf602b38",
                                        "entry_id": "7a9f3eb3-2b66-3ca7-a130-ca04d8d25ff8",
                                        "glosses": [
                                            "Petite étoile très dense issue de l’effondrement d’une étoile massive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb6989d-df6d-4085-9e5f-e5c8ad16c724",
                                                "sense_id": "69cb46e2-8e33-38b5-962f-747cdf602b38",
                                                "text": "Certaines étoiles à neutrons avec un mouvement de rotation élevé sont nommées « pulsars », d’autres, dotées d’un champ magnétique très intense (qui dépasse 100 millions de teslas), sont nommées « magnétars »."
                                            },
                                            {
                                                "example_id": "a8cce787-44ea-4589-b8c9-43b472aed1b6",
                                                "sense_id": "69cb46e2-8e33-38b5-962f-747cdf602b38",
                                                "text": "En 1967, âgée de 24 ans, la Nord-Irlandaise met en évidence le premier pulsar, étoile à neutrons émettant un fort rayonnement électromagnétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
