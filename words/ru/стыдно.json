                                "target_lang_sense_clarification": "suçluluk veya utanç hissetmek"
                            },
                            {
                                "target_lang_word": "mahcup olmak",
                                "target_lang_sense_clarification": "sosyal olarak rahatsız veya mahcup hissetmek"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "avergonzado",
                                "target_lang_sense_clarification": "sentir vergüenza o culpa personal"
                            },
                            {
                                "target_lang_word": "darse vergüenza",
                                "target_lang_sense_clarification": "sentir pena o incomodidad"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir honte",
                                "target_lang_sense_clarification": "éprouver un sentiment de honte ou de culpabilité"
                            },
                            {
                                "target_lang_word": "être gêné",
                                "target_lang_sense_clarification": "se sentir mal à l'aise ou embarrassé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09522303-4233-30cf-848e-3fed95b77d92",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>стыдный</w>; позорный, заслуживающий осуждения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Обманывать близких людей — это <w>стыдно</w>.",
                            "target_lang_translations": {
                                "en": "Deceiving close people is <w>shameful</w>.",
                                "tr": "Yakın insanları aldatmak <w>utanç vericidir</w>.",
                                "es": "Engañar a los seres queridos es <w>vergonzoso</w>.",
                                "fr": "Tromper ses proches, c'est <w>honteux</w>."
                            }
                        },
                        {
                            "text": "Просить помощи в трудной ситуации совсем не <w>стыдно</w>.",
                            "target_lang_translations": {
                                "en": "Asking for help in a difficult situation is not <w>shameful</w> at all.",
                                "tr": "Zor bir durumda yardım istemek hiç de <w>ayıp</w> değildir.",
                                "es": "Pedir ayuda en una situación difícil no es para nada <w>vergonzoso</w>.",
                                "fr": "Demander de l'aide dans une situation difficile n'est pas du tout <w>honteux</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "бесстыдно"
                    ],
                    "common_phrases": [
                        "ничего не стыдно"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular of стыдный"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Describing an action or situation as shameful or deserving of condemnation.",
                        "tr": "Utanç verici, kınanmayı hak eden eylem veya durumları tanımlamak için kullanılır.",
                        "es": "Forma corta neutra del adjetivo «стыдный»; vergonzoso, digno de condena.",
                        "fr": "Qualifie une action ou une situation comme honteuse ou blâmable."
                    },
                    "translations": {
