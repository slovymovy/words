                            {
                                "example_id": "a8b4c537-674a-4e53-8d04-0bdf387e1a46",
                                "sense_id": "80656580-5fb4-3dff-90f3-02f7cfe29655",
                                "text": "Ik heb zoooo geen zin in handarbeid vandaag."
                            }
                        ]
