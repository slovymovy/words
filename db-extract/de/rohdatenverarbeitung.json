                "senses": [
                    {
                        "sense_id": "c994b0f4-76cb-3818-81a9-56d2ec3cdc08",
                        "entry_id": "1c3d79de-5d52-3989-b841-0be1c54c086f",
                        "glosses": [
                            "Prüfung, Verarbeitung und Auswertung von Rohdaten, die bei einer Beobachtung, einer Messung oder einer Datenerhebung anfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd98b94-0eb2-4201-983b-753dfe71d4a9",
                                "sense_id": "c994b0f4-76cb-3818-81a9-56d2ec3cdc08",
                                "text": "„Das zur Rohdatenverarbeitung verwendete mathematische Modell zur Laserbeugung ist das.“"
                            },
                            {
                                "example_id": "6815a5ae-72a1-47e3-ba52-a16a76ff441f",
                                "sense_id": "c994b0f4-76cb-3818-81a9-56d2ec3cdc08",
                                "text": "„Letzteres enthält alle definierten Schritte, die von der Rohdatenverarbeitung bis hin zur Klassifikation nötig sind.“"
                            },
                            {
                                "example_id": "c8e0ecee-fd9b-48ea-a31b-cfc655033651",
                                "sense_id": "c994b0f4-76cb-3818-81a9-56d2ec3cdc08",
                                "text": "„Die Rohdatenverarbeitung der Sensoren und die Kommunikation ist in der Programmiersprache C++ implementiert.“"
                            },
                            {
                                "example_id": "8c9adf19-42ea-4e49-922a-ef851d3f56fe",
                                "sense_id": "c994b0f4-76cb-3818-81a9-56d2ec3cdc08",
                                "text": "„Dadurch, dass es aus gleichem Hause kommt, ist die Rohdatenverarbeitung perfekt auf die Eigenschaften des RAW- und CRAW-Formats der EOS R5 abgestimmt.“"
                            },
                            {
                                "example_id": "92027f65-55ae-4d55-bbd0-48f2fbdda0b1",
                                "sense_id": "c994b0f4-76cb-3818-81a9-56d2ec3cdc08",
                                "text": "„Die Rohdatenverarbeitung einerseits, etwa mit Silkypix oder Camera Raw Plug-ins, und die Gestaltung von Bildern mit besonders hohem Dynamikumfang (HDR wie High Dynamic Range) mit einem Programm wie Photomatix sind dabei Schwerpunkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
