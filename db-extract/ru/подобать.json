                "senses": [
                    {
                        "sense_id": "9a8249c7-0dd6-32c7-be28-7e0bd52d5fac",
                        "entry_id": "74c4a204-8e5c-3c90-a717-912a118ee3a9",
                        "glosses": [
                            "приличествовать кому-либо, чему-либо, соответствовать чьему-либо положению, достоинству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818c6977-becf-4b05-a0a0-c7163ba5fa8b",
                                "sense_id": "9a8249c7-0dd6-32c7-be28-7e0bd52d5fac",
                                "text": "Мне здесь не подобает быть."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f4eea42-215b-3579-b42f-9fff81a73388",
                        "entry_id": "74c4a204-8e5c-3c90-a717-912a118ee3a9",
                        "glosses": [
                            "надлежать, полагаться кому-либо (по праву, по заслугам)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1877875-31cd-4394-8207-a03ba9d2e584",
                                "sense_id": "4f4eea42-215b-3579-b42f-9fff81a73388",
                                "text": "Ему подобает выписать премию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfddd00d-64ea-4a5e-b68a-0233b0462822",
                        "source_entry_id": "74c4a204-8e5c-3c90-a717-912a118ee3a9",
                        "target_lang_word": "convenir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convenir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                        "entry_id": "5b0f0f73-4a92-3dbd-a791-0faade4bd255",
                                        "glosses": [
                                            "Être convenable, approprié ou adéquat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d5cf2ad-9576-49c1-8129-d9429fac1bc0",
                                                "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                                "text": "Puis, apercevant, sur le sentier du bas-côté, un caillou dont l’aspect lui convint, il le ramassa et le mit dans sa poche."
                                            },
                                            {
                                                "example_id": "f6384054-d5da-4f48-8cb2-3d21b37d84b4",
                                                "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                                "text": "De nombreuses expériences m’avaient convaincu que le régime végétarien était celui qui me convenait le mieux et me donnait la plus grande résistance physique."
                                            },
                                            {
                                                "example_id": "ee2b8110-d9b9-43ca-999b-09d390326220",
                                                "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                                "text": "Il est bien évident que les plantes vivent uniquement dans les milieux qui leur conviennent, […] : ainsi l’isotherme de 4°5 moyenne du mois de janvier concorde remarquablement avec la répartition de Rubia peregrina en Europe occidentale."
                                            },
                                            {
                                                "example_id": "6d9abe27-7c31-4fb5-b565-1e36af4b4104",
                                                "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                                "text": "Il redoutait probablement de ne plus lui convenir et de rentrer dans le rang, de reprendre le bissac du trimardeur."
                                            },
                                            {
                                                "example_id": "6fa3e01d-7d76-4dd7-8106-fd8ddab2e941",
                                                "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                                "text": "Et dans la foulée, si le raccourci cubi ne vous convient pas, n'hésitez pas davantage à faire usage d'un cubiteneur en remplacement du cubitainer. Aucune raison pour que le vin s'aigrisse davantage dans l'un que dans l'autre."
                                            },
                                            {
                                                "example_id": "8b62fffb-870a-4244-be30-5d7fad60a9f9",
                                                "sense_id": "a5a7ca64-c30b-3496-9c75-db0c07b19fa1",
                                                "text": "Ce style ne convient point au sujet que vous traitez. — Leurs opinions conviennent en tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3112cc2f-e3b5-33e9-b0ea-c69ad9faf0a3",
                                        "entry_id": "5b0f0f73-4a92-3dbd-a791-0faade4bd255",
                                        "glosses": [
                                            "Être conforme aux usages, aux conventions, aux nécessités ou besoins ; être utile ou à propos."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec76ca3-01e1-439a-96c7-8bddcb45eec3",
                                                "sense_id": "3112cc2f-e3b5-33e9-b0ea-c69ad9faf0a3",
                                                "text": "M. Bernard, notaire, sortait de chez lui, à pointe d’aube […]. Il était entièrement vêtu de casimir noir, ainsi qu’il convient à un notaire."
                                            },
                                            {
                                                "example_id": "94b8b127-c7c9-4171-a80b-60ebbb77a264",
                                                "sense_id": "3112cc2f-e3b5-33e9-b0ea-c69ad9faf0a3",
                                                "text": "Il fut non seulement poli, mais empressé, galant même plus qu’il ne convenait à son âge, et il fit si bien qu’il retint la marquise, prête à partir."
                                            },
                                            {
                                                "example_id": "eeb772f3-3d9a-49d6-a08b-856ac39c706b",
                                                "sense_id": "3112cc2f-e3b5-33e9-b0ea-c69ad9faf0a3",
                                                "text": "Il ne me convient pas d’agir ainsi. — On délibéra longtemps sur ce qu’il convenait de faire."
                                            },
                                            {
                                                "example_id": "cd21f67e-a6af-4134-a3d6-a148c8a7cb29",
                                                "sense_id": "3112cc2f-e3b5-33e9-b0ea-c69ad9faf0a3",
                                                "text": "Vous pouvez alléguer que mon peu de fortune autant que mes goûts m’interdisent de porter des bagatelles qui ne conviennent qu’à des reines ou à des courtisanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f92b6a1d-1777-30c2-9387-019c0a491557",
                                        "entry_id": "5b0f0f73-4a92-3dbd-a791-0faade4bd255",
                                        "glosses": [
                                            "Être souhaitable."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3833ef5c-34fd-458e-9219-2ce87858ab3f",
                                                "sense_id": "f92b6a1d-1777-30c2-9387-019c0a491557",
                                                "text": "Les jeunes femmes ont un sens aigu de ce qu'il convient de faire et de ne pas faire quand on a cessé d'être jeune. « Je ne comprends pas, disent-elles, que passé quarante ans on se teigne en blond ; qu'on s'exhibe en bikini ; qu'on coquette avec les hommes. Moi, quand j'aurai cet âge-là… »"
                                            },
                                            {
                                                "example_id": "c05c1c24-211b-4012-befe-fe36a4684054",
                                                "sense_id": "f92b6a1d-1777-30c2-9387-019c0a491557",
                                                "text": "Il convient que la raison entreprenne sur le sentiment."
                                            },
                                            {
                                                "example_id": "fc5d0765-06fb-45af-aead-c253d3ab42b5",
                                                "sense_id": "f92b6a1d-1777-30c2-9387-019c0a491557",
                                                "text": "C'est dans ce cercle de personnages politiques réservés et non de personnalités politiciennes et paradeuses qu'il convient de rechercher le profil du remplaçant que Paul Biya prépare pour le Cameroun », précise le politologue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287990f6-8304-379f-8fe5-bf9cf6cdc3cc",
                                        "entry_id": "5b0f0f73-4a92-3dbd-a791-0faade4bd255",
                                        "glosses": [
                                            "Être approprié l’un à l’autre, se plaire mutuellement."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18adfdb8-90b3-4c70-bfb4-3592c8137dcb",
                                                "sense_id": "287990f6-8304-379f-8fe5-bf9cf6cdc3cc",
                                                "text": "Ces deux-là ne se conviennent pas."
                                            },
                                            {
                                                "example_id": "c77e4b9c-1274-4ca6-b52e-37addf33e0ca",
                                                "sense_id": "287990f6-8304-379f-8fe5-bf9cf6cdc3cc",
                                                "text": "Ce jeune homme et cette jeune fille se conviennent très bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7cbb172-61d3-3984-8a5c-31e551fa98e2",
                                        "entry_id": "5b0f0f73-4a92-3dbd-a791-0faade4bd255",
                                        "glosses": [
                                            "Tomber d’accord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6874cc-b4a7-4848-a897-6270fa3a2dcc",
                                                "sense_id": "f7cbb172-61d3-3984-8a5c-31e551fa98e2",
                                                "text": "Enfin nous convînmes des heures régulières de 10h. 30 et 18 h. pour communiquer désormais journellement et nous nous quittâmes, sur des amabilités réciproques […]"
                                            },
                                            {
                                                "example_id": "e4a41b00-f9b2-4b7b-ad06-791bb42c1ff5",
                                                "sense_id": "f7cbb172-61d3-3984-8a5c-31e551fa98e2",
                                                "text": "Depuis une demi-heure, l’idée qu’il ne se trouvait pas seul entre ces murs le troublait sans qu’il voulût en convenir."
                                            },
                                            {
                                                "example_id": "c86a2111-a22c-4847-81eb-6227b1cd7184",
                                                "sense_id": "f7cbb172-61d3-3984-8a5c-31e551fa98e2",
                                                "text": "— Il a des dispositions, mais beaucoup de mauvaise volonté, il faut que j’en convienne."
                                            },
                                            {
                                                "example_id": "85964043-779b-487a-a386-4aa2ede16927",
                                                "sense_id": "f7cbb172-61d3-3984-8a5c-31e551fa98e2",
                                                "text": "Et bien, la mairie de Paris se contenta de m'indiquer les coordonnées d'une société de dépigeonnage et me raccrocha au nez sans autre forme de procès. Cavalière, cette attitude, vous en conviendrez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                        "entry_id": "5b0f0f73-4a92-3dbd-a791-0faade4bd255",
                                        "glosses": [
                                            "Faire un accord, une convention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e25cbb-dd4a-4281-b3a6-3fe051899451",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "Ils convinrent entre eux de faire telle chose."
                                            },
                                            {
                                                "example_id": "7fc79d9f-da36-434c-a605-3dce450e5984",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "Ils sont convenus de se trouver en tel lieu. (voir note)"
                                            },
                                            {
                                                "example_id": "d337c282-b092-4bfc-b3e4-51c551dc61f0",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "Convenir d’un arbitre, d’un article, du temps, du lieu."
                                            },
                                            {
                                                "example_id": "52147b65-fc22-4dd7-98f6-860c1583c265",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "Convenir du prix de quelque chose."
                                            },
                                            {
                                                "example_id": "fc380d14-e22a-4fa0-8d65-7c819b21ec62",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "Convenir des termes : S’entendre sur le sens de certains mots qui doivent être employés dans une discussion, un raisonnement."
                                            },
                                            {
                                                "example_id": "d29317e2-863e-425f-90e8-828d5811b4c1",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "C’est chose convenue."
                                            },
                                            {
                                                "example_id": "f72c8fc9-f2e7-49c3-b52e-ac83a15c67c7",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "C’est convenu."
                                            },
                                            {
                                                "example_id": "129cdbc2-efe3-4ba6-b6ea-a5ac8aeca65b",
                                                "sense_id": "1fa3c29e-2965-34c4-930a-b66a5ca25eec",
                                                "text": "Langage convenu : Langage d’exception, sur les termes duquel on s’est mis d’accord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
