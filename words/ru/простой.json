                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Механизм замка был настолько <w>простой</w>, что мы открыли его скрепкой.",
                            "target_lang_translations": {
                                "en": "The lock mechanism was so <w>simple</w> that we opened it with a paperclip.",
                                "tr": "Kilidin mekanizması o kadar <w>basitti</w> ki onu bir ataşla açtık."
                            }
