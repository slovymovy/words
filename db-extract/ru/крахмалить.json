                                "target_senses": [
                                    {
                                        "sense_id": "67c54ea3-0fbc-3345-9a82-d57906a0af93",
                                        "entry_id": "b511120e-7aea-3e8a-b6bd-8d6e716a4e3d",
                                        "glosses": [
                                            "A widely diffused vegetable substance, found especially in seeds, bulbs and tubers, as extracted (e.g. from potatoes, corn, rice, etc.) in the form of a white, glistening, granular or powdery substance, without taste or smell, and giving a very peculiar creaking sound when rubbed between the fingers. It is used as a food, in the production of commercial grape sugar, for stiffening linen in laundries, in making paste, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59fa7e87-73fd-418c-b914-82ab92b5e0e9",
                                                "sense_id": "67c54ea3-0fbc-3345-9a82-d57906a0af93",
                                                "text": "Meronym: saccharide"
                                            },
                                            {
                                                "example_id": "a6f686c7-dedb-4b09-820d-e449e8321375",
                                                "sense_id": "67c54ea3-0fbc-3345-9a82-d57906a0af93",
                                                "text": "The various elements found in food are the following: Starch, sugar, fats, albumen, mineral substances, indigestible substances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c381bf7-db90-34de-8805-949de9f420d7",
                                        "entry_id": "b511120e-7aea-3e8a-b6bd-8d6e716a4e3d",
                                        "glosses": [
                                            "Carbohydrates, as with grain and potato based foods."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4186fd9-a7df-34d6-9a43-1cfb07440e4d",
                                        "entry_id": "b511120e-7aea-3e8a-b6bd-8d6e716a4e3d",
                                        "glosses": [
                                            "A stiff, formal manner; formality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
