                "senses": [
                    {
                        "sense_id": "3864cc5c-5972-35b5-9459-eb0c79951f28",
                        "entry_id": "b11c43e4-85bd-3498-bb31-7d61608831a1",
                        "glosses": [
                            "mehrfache Änderung der Richtung bei der Fortbewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8616605-60b7-4ed6-b7f8-56230869d93f",
                                "sense_id": "3864cc5c-5972-35b5-9459-eb0c79951f28",
                                "text": "„Das Boot steuert jetzt Zickzackkurs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69675aed-70db-3481-b377-7a9f8065d3d3",
                        "entry_id": "b11c43e4-85bd-3498-bb31-7d61608831a1",
                        "glosses": [
                            "mehrfache Änderung von Maßnahmen/der Strategie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b2a41a9-162f-4d82-9087-bba0d45ff3e3",
                                "sense_id": "69675aed-70db-3481-b377-7a9f8065d3d3",
                                "text": "„Doch viele Studien beklagen die ineffiziente Bürokratie, die hohe Steuerlast und den Zickzackkurs der Regierung.“"
                            },
                            {
                                "example_id": "342487fd-75ce-46b4-a485-afe2207bd5ac",
                                "sense_id": "69675aed-70db-3481-b377-7a9f8065d3d3",
                                "text": "„Man werde seiner Partei in dem Zickzackkurs die Beweislast des Gegenteils auferlegen, was in diesem Fall eine besondere Schwierigkeit bedeute, weil man nicht wisse, wann der freundschaftliche Partner hier einmal einträfe, um sein eidliches Zeugnis anzubieten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
