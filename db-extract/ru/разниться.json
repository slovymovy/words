                "senses": [
                    {
                        "sense_id": "fef81ef1-428f-3340-8fdd-d5e2a3d9272a",
                        "entry_id": "1da5361a-7307-35bb-a0f4-e7e58abd790e",
                        "glosses": [
                            "нар.-поэт. то же, что отличаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e7ef46b-85ed-479b-8ca7-b2fccf89b95a",
                                "sense_id": "fef81ef1-428f-3340-8fdd-d5e2a3d9272a",
                                "text": "Не столько разнились между собой оживлённая и полная, в веснушках, с золотистыми локонами и голубыми глазами Ксения и задумчивая, черноволосая и сухощавая Аврора, сколько были несхожи видом и нравом близкие друг другу с детства Илья Тропинин и Базиль Перовский…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fd283dd-d0eb-44af-b205-4658d192523b",
                        "source_entry_id": "1da5361a-7307-35bb-a0f4-e7e58abd790e",
                        "source_sense_id": "fef81ef1-428f-3340-8fdd-d5e2a3d9272a",
                        "target_lang_word": "differ",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "differ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4924cf-579a-34bd-89fb-a90d2119b4a6",
                                        "entry_id": "5d3ace1f-bab0-33fe-95b5-7418b90c47c3",
                                        "glosses": [
                                            "Not to have the same traits or characteristics; to be unalike or distinct."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096f62c0-87e1-43d7-964a-a17274510fc7",
                                                "sense_id": "7b4924cf-579a-34bd-89fb-a90d2119b4a6",
                                                "text": "When we look to the individuals of the same variety or sub-variety of our older cultivated plants and animals, one of the first points which strikes us, is, that they generally differ much more from each other, than do the individuals of any one species or variety in a state of nature."
                                            },
                                            {
                                                "example_id": "d0caf02a-c4c8-4f2d-903c-24f0cf6450ce",
                                                "sense_id": "7b4924cf-579a-34bd-89fb-a90d2119b4a6",
                                                "text": "These shoes only differ from those ones in having slightly longer laces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4925364-6582-3770-9b47-ac2dc38c0d21",
                                        "entry_id": "5d3ace1f-bab0-33fe-95b5-7418b90c47c3",
                                        "glosses": [
                                            "Not to have the same traits or characteristics; to be unalike or distinct.",
                                            "To be separated in quantity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a39f69-a6e6-4955-8ef1-7345c5f528e0",
                                                "sense_id": "f4925364-6582-3770-9b47-ac2dc38c0d21",
                                                "text": "The numbers 3 and 21 differ by 18."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17678b66-7d52-34ab-a867-5a28ffb4f900",
                                        "entry_id": "5d3ace1f-bab0-33fe-95b5-7418b90c47c3",
                                        "glosses": [
                                            "Not to have the same traits or characteristics; to be unalike or distinct.",
                                            "To have diverging opinions, disagree."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c78d35-ba97-4862-8a5f-18336a4ff143",
                                                "sense_id": "17678b66-7d52-34ab-a867-5a28ffb4f900",
                                                "text": "May 11, 1827, George Canning, Changes in the Administration\nI differ from the honourable baronet on both these subjects"
                                            }
                                        ]
                                    }
                                ]
                            },
