                        ]
                    },
                    {
                        "translation_id": "73bbeacc-c7ca-4079-b300-757a15aa957a",
                        "source_entry_id": "92262a60-c24f-3822-9296-415d48b195af",
                        "source_sense_id": "39ca896a-7a37-3ea3-a3da-48cd3724dbbb",
                        "source_sense_description": "het iemand belachelijk maken",
                        "target_lang_word": "ridicule",
