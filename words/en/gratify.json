{
    "word_family": [
        "gratification",
        "gratifying",
        "ungratified",
        "gratified"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f218f981-7a8b-3790-81be-62d610ec588f",
                    "sense_definition": "To give pleasure or satisfaction to a person or their desires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician worked hard to <w>gratify</w> the voters before the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Политик усердно работал, чтобы <w>угодить</w> избирателям перед предстоящими выборами."
                            }
                        },
                        {
                            "text": "He decided to <w>gratify</w> his curiosity by exploring the abandoned house at the end of the street.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>удовлетворить</w> свое любопытство, исследовав заброшенный дом в конце улицы."
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfy",
                        "fulfill",
                        "indulge",
                        "content",
                        "appease"
                    ],
                    "antonyms": [
                        "discontent",
                        "dissatisfy"
                    ],
                    "common_phrases": [
                        "gratify a desire",
                        "gratify the senses",
                        "gratify one's curiosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доставлять удовольствие или удовлетворение человеку или его желаниям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворять",
                                "target_lang_sense_clarification": "исполнять желания или потребности"
                            },
                            {
                                "target_lang_word": "ублажать",
                                "target_lang_sense_clarification": "угождать, баловать"
                            },
                            {
                                "target_lang_word": "потакать",
                                "target_lang_sense_clarification": "снисходительно относиться к прихотям"
                            },
                            {
                                "target_lang_word": "насыщать",
                                "target_lang_sense_clarification": "полностью удовлетворять любопытство или аппетит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546c0aef-f7f2-398f-b5cd-e03d341cb88e",
                    "sense_definition": "To be a source of pleasure or satisfaction to someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would <w>gratify</w> me greatly to see my students succeed in their final exams.",
                            "target_lang_translations": {
                                "ru": "Меня бы очень <w>порадовало</w> увидеть, как мои студенты успешно сдают выпускные экзамены."
                            }
                        },
                        {
                            "text": "The positive feedback from the audience seemed to <w>gratify</w> the young performer.",
                            "target_lang_translations": {
                                "ru": "Положительные отзывы публики, казалось, <w>польстили</w> молодому исполнителю."
                            }
                        }
                    ],
                    "synonyms": [
                        "please",
                        "delight",
                        "gladden"
                    ],
                    "antonyms": [
                        "anger",
                        "disquiet",
                        "fluster"
                    ],
                    "common_phrases": [
                        "deeply gratify",
                        "gratify the heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть источником удовольствия или удовлетворения для кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радовать",
                                "target_lang_sense_clarification": "доставлять радость или удовольствие"
                            },
                            {
                                "target_lang_word": "льстить",
                                "target_lang_sense_clarification": "приносить удовлетворение самолюбию"
                            },
                            {
                                "target_lang_word": "удовлетворять",
                                "target_lang_sense_clarification": "вызывать чувство удовлетворения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}