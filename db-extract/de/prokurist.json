                        ],
                        "examples": [
                            {
                                "example_id": "8ca36d25-7eb7-4192-aa4c-0dcfa60e25e9",
                                "sense_id": "ac2963fa-9791-3c3e-92f2-ac37e04978f4",
                                "text": "Der Fabrikant beklagte sich, daß er beim Prokuristen so wenig Neigung für das Geschäft gefunden habe, und zeigte auf K., der sich unter dem Blick des Direktor-Stellvertreters wieder über die Papiere beugte.",
                                "translation": "The factory-owner complained that the senior accountant had shown little enthusiasm for the project, and pointed at K. who, feeling the deputy manager’s eyes on him, bent over the papers again.",
                                "english": "The factory-owner complained that the senior accountant had shown little enthusiasm for the project, and pointed at K. who, feeling the deputy manager’s eyes on him, bent over the papers again."
                            }
