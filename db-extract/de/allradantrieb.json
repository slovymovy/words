                "senses": [
                    {
                        "sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
                        "entry_id": "94f289f4-7d9c-3e76-a863-2edc66e8ecd8",
                        "glosses": [
                            "Funktionsweise beziehungsweise Art eines Antriebs (bezieht sich normalerweise auf Automobile), bei der alle (meist vier) Räder aktiv den Wagen fortbewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "266e9619-756d-486c-b25a-6eb2210e20c8",
                                "sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
                                "text": "Das Auto hat Allradantrieb."
                            },
                            {
                                "example_id": "03fd6674-7cce-4fa5-b6bc-d7dbf858e6da",
                                "sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
                                "text": "„Trotz des zugeschalteten Allradantriebs quält sich der Terrano nur noch mühsam die staubige Piste empor.“"
                            },
                            {
                                "example_id": "73cb57e3-34b7-4f69-af45-14371486aed0",
                                "sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
                                "text": "„Tony war außerdem unerschütterlich und hatte Zugang zu einem recht neuen Fahrzeug mit Allradantrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "205b4cb7-c734-4ae7-8145-eef5debe3596",
                        "source_entry_id": "94f289f4-7d9c-3e76-a863-2edc66e8ecd8",
                        "source_sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
                        "source_sense_description": "Art eines Antriebs, bei der alle Räder aktiv den Wagen fortbewegen",
                        "target_lang_word": "all-wheel drive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all-wheel drive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31ead5ea-c319-3944-aad0-10e9014c5aa8",
                                        "entry_id": "9166a721-bbe4-33e8-90d0-defb871e3b14",
                                        "glosses": [
                                            "A wheeled vehicle with a drivetrain that allows all wheels to receive torque from the engine simultaneously, particularly where power is directed to the wheels with the best contact with the ground."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea9f60a8-e18c-4ebc-b230-541ec9b19a42",
                                                "sense_id": "31ead5ea-c319-3944-aad0-10e9014c5aa8",
                                                "text": "The brave German car's all-wheel drive tackled and spun through almost eight inches of loosely plowed snow."
                                            },
                                            {
                                                "example_id": "937ac180-c55f-4e10-bced-d6b22ab54b42",
                                                "sense_id": "31ead5ea-c319-3944-aad0-10e9014c5aa8",
                                                "text": "So BMW has conjured a tweener — a roomier hatchback on platform shoes, with standard all-wheel drive — to attract customers who crave the 3 Series’ performance but need more utility to close the deal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b95d764-d149-45c9-ae02-883a6c6d9822",
                        "source_entry_id": "94f289f4-7d9c-3e76-a863-2edc66e8ecd8",
                        "source_sense_id": "c420ea0b-32c9-3c66-b790-2e20c017ee56",
