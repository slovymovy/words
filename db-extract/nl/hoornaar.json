                "senses": [
                    {
                        "sense_id": "26595100-6d9a-3997-95a5-da7da20cbaec",
                        "entry_id": "11246d85-ea96-34d7-949c-343e701a1bd0",
                        "glosses": [
                            "Vespa soort grote wesp, lid van een geslacht van eusociale wespachtigen. Sommige soorten kunnen tot 5,5 cm lang worden. De hoornaars vormen samen het geslacht Vespa en onderscheiden zich van de andere wespen door de grootte van hun vertex (het deel van het hoofd achter de ogen)"
                        ],
                        "tags": [
                            "vliesvleugeligen"
                        ],
                        "examples": [
                            {
                                "example_id": "bc33d771-5b96-4bed-8027-a8b4b7371e46",
                                "sense_id": "26595100-6d9a-3997-95a5-da7da20cbaec",
                                "text": "De Aziatische hoornaar steekt vanuit het niets en dat is behoorlijk pijnlijk, maar niet gevaarlijk voor een mens. Deze wesp is vooral berucht omdat hij honingbijen doodt. Hij kan een massaslachting onder bijen veroorzaken en dat kan weer gevolgen hebben voor de voedselproductie voor de mens. In Europa is er daarom een afspraak om het dier op te sporen en te vernietigen. Dit geldt niet voor de Europese hoornaar; dat is een beschermde diersoort en mag daarom niet worden doodgeslagen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a631c81d-c7d1-4011-afed-d523aefa155f",
                        "source_entry_id": "11246d85-ea96-34d7-949c-343e701a1bd0",
                        "source_sense_id": "26595100-6d9a-3997-95a5-da7da20cbaec",
                        "source_sense_description": "Vespa crabro, een soort grote wesp",
                        "target_lang_word": "Hornisse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hornisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Art der Faltenwespen, die der Gattung der Großwespen (siehe [2]) angehört"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f963c8c-5cb3-4440-bbf2-7111958ffa1c",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "Der Stich einer Hornisse ist nicht gefährlicher als derjenige einer Biene."
                                            },
                                            {
                                                "example_id": "6650826b-a9a5-4fe0-9685-8320d6bbd210",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Zwei Hornissen stachen ihn fast zu gleicher Zeit, er brüllte vor Entsetzen und warf sein Gewehr weg.“"
                                            },
                                            {
                                                "example_id": "f4f17b4a-d17b-40e9-8c95-b1002ed5b9cb",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Dann flog eine Hummel in den Hochstand, die so groß war, daß sie auch eine Hornisse sein konnte.“"
                                            },
                                            {
                                                "example_id": "29ca2752-b58a-4424-a94f-6a6dbcd94895",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Bald schwärmten Fliegen, Wespen und Hornissen um das tote Tier; sie mussten es in den Graben werfen und dem Ungeziefer überlassen.“"
                                            },
                                            {
                                                "example_id": "77f124ae-924e-4daa-93eb-259b8e5568be",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Drohnen, Hornissen, Schmetterlinge fliegen unsachlich herum und stossten gegen die Stockwände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Sammelbezeichnung für die Gattung Vespa oder Großwespen"
                                        ],
                                        "tags": [
                                            "Entomologie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508af155-d770-4495-b6d5-2451dba44341",
                                                "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                                "text": "Die Gattung der Hornissen zählt zu der Familie der Faltenwespen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a236f953-0a93-4b4c-8b75-5cf9a865e543",
                        "source_entry_id": "11246d85-ea96-34d7-949c-343e701a1bd0",
                        "source_sense_id": "26595100-6d9a-3997-95a5-da7da20cbaec",
