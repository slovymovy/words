                "senses": [
                    {
                        "sense_id": "9502a1c9-1d72-305f-9750-444c20422693",
                        "entry_id": "b8cbdf84-fea5-3f44-a308-b1fc744aa384",
                        "glosses": [
                            "heutige Zeitmessung mit Stunden konstanter Länge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f7fe64-0e96-44e6-847e-dc51f8e64e43",
                                "sense_id": "9502a1c9-1d72-305f-9750-444c20422693",
                                "text": "„Bei der Einteilung in Stunden ist in der Zeit vor den modernen Uhren zu bedenken, dass es zwei unterschiedliche Rechnungen gab, nämlich die aus der Antike übernommene sog. Temporalzeit und die sog. Äquinoktialzeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f355be65-68de-32f2-943b-8f25254456ac",
                        "entry_id": "b8cbdf84-fea5-3f44-a308-b1fc744aa384",
                        "glosses": [
                            "(mglw. veraltet) Die Zeit um die Tag-und-Nacht-Gleiche im Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae9d012f-308e-4ba3-883a-cdde85d50f4a",
                                "sense_id": "f355be65-68de-32f2-943b-8f25254456ac",
                                "text": "„Ich mache mir jetzt Hoffnung, dass das Übel, da es gerade in dieser schlimmen Äquinoktialzeit ausgeblieben ist, ganz fortbleiben […] wird.“"
                            },
                            {
                                "example_id": "cdec8dd0-e875-4534-bb37-5493d9f837cc",
                                "sense_id": "f355be65-68de-32f2-943b-8f25254456ac",
                                "text": "„Wer sich zur Zeit der schweren Stürme, im Winter oder zur Aequinoktialzeit, aufs Meer begiebt, kann in die Lage kommen, mit ihnen rechnen zu müssen, […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
