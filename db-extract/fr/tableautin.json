                "senses": [
                    {
                        "sense_id": "cfec4222-605f-3d82-a32e-2e0b2cb988c6",
                        "entry_id": "67c4fd0e-7928-320d-948b-4e77fbafbedb",
                        "glosses": [
                            "Petit tableau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394793e5-ee4b-4a4a-957a-0e09067b577f",
                                "sense_id": "cfec4222-605f-3d82-a32e-2e0b2cb988c6",
                                "text": "Les tableautins sautent contre les murs."
                            },
                            {
                                "example_id": "75aebf5f-0e97-4f96-847c-e828003d53aa",
                                "sense_id": "cfec4222-605f-3d82-a32e-2e0b2cb988c6",
                                "text": "Son regard, errant sur les murs jaunis, s’arrêtait à des pochades familières, à des tableautins sans cadres."
                            },
                            {
                                "example_id": "49beefbe-de67-4090-8a16-6aa9b6a3b7ea",
                                "sense_id": "cfec4222-605f-3d82-a32e-2e0b2cb988c6",
                                "text": "Alors il tire sa montre et découvre sous le cadran un tableautin animé : le mouvement du balancier entraîne l’un vers l’autre des amoureux à l’ombre d’un bosquet."
                            },
                            {
                                "example_id": "ec535fe8-3b5b-42e2-90e5-bac2a92da0dd",
                                "sense_id": "cfec4222-605f-3d82-a32e-2e0b2cb988c6",
                                "text": "- Regarde-moi ce tableautin, dit mon oncle. Tu sais ce que c’est ?…"
                            }
                        ]
                    },
                    {
                        "sense_id": "66250400-2d89-3e5b-a84c-1adc73c9e2dd",
