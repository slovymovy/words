                ],
                "senses": [
                    {
                        "sense_id": "b2ab75e8-d831-3ae8-94dd-8f3c0cf67289",
                        "entry_id": "70e96683-d040-3ebf-b103-ca8630c7af87",
                        "glosses": [
                            "Approcher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d7040f-1fba-4ebf-8443-0be8bd38ea16",
                                "sense_id": "b2ab75e8-d831-3ae8-94dd-8f3c0cf67289",
                                "text": "Il n'y aurait pas les précédents objets du ciel si de la terre n'advenaient ces regards, le bonheur parfois de leur reflet mental qui nous console d'être mortels - O toi qui ré-approchas les dieux - et le désir - fût-ce le tien, singulier - de les saisir, qui a goût néanmoins d'éternité si la Beauté consent."
                            },
                            {
                                "example_id": "8114c8d0-67e5-4151-a898-cf542e4930ac",
                                "sense_id": "b2ab75e8-d831-3ae8-94dd-8f3c0cf67289",
                                "text": "Il s'ébroua légèrement et se ré-approcha d'Elena…"
                            },
                            {
                                "example_id": "c0548999-8c7f-40de-a878-c97a0c5ba7fc",
                                "sense_id": "b2ab75e8-d831-3ae8-94dd-8f3c0cf67289",
                                "text": "Il se ré-approcha de moi et nous enferma dans la chambre de Louise."
                            }
                        ]
                    }
