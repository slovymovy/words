                ],
                "senses": [
                    {
                        "sense_id": "bc3c1a51-730f-3130-99b0-1c1ccc160fe7",
                        "entry_id": "99618f85-2800-35c9-9885-9223222b5440",
                        "glosses": [
                            "mit einer Störung der Nahrungszufuhr verbundene Krankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc103c14-e228-43c1-b995-398ef87d8d58",
                                "sense_id": "bc3c1a51-730f-3130-99b0-1c1ccc160fe7",
                                "text": "„Allerdings bewilligen nur wenige Krankenkassen eine Kur aufgrund von Medienabhängigkeit, unter einer ausgeprägten Ernährungsstörung oder körperlichen Defiziten wegen Bewegungsarmut geht bei den meisten Krankenkassen nichts.“"
                            },
                            {
                                "example_id": "f62303bd-fd2d-48bf-b9f0-a47fe76756fd",
                                "sense_id": "bc3c1a51-730f-3130-99b0-1c1ccc160fe7",
                                "text": "„Der an einer seltenen Ernährungsstörung leidende Junge war mit einer Schädelfraktur, Prellungen und Knochenbrüchen in die Klinik eingeliefert worden.“"
                            },
                            {
                                "example_id": "1a854cf2-f845-4b39-8f4a-962a6bd55243",
                                "sense_id": "bc3c1a51-730f-3130-99b0-1c1ccc160fe7",
                                "text": "„Beim Keratokonus verändert sich diese Form durch eine fortschreitende Ernährungsstörung der Hornhaut.“"
                            },
                            {
                                "example_id": "d511f4b5-0a80-4fb1-91f9-448022ad13a3",
                                "sense_id": "bc3c1a51-730f-3130-99b0-1c1ccc160fe7",
                                "text": "„Die Ernährungsstörung eines Teils des Herzmuskels, der sogenannte Herzinfarkt, führt oft zum Tode.“"
                            },
                            {
                                "example_id": "9da7b3c4-dc24-4ecc-abc9-36644b2f766b",
                                "sense_id": "bc3c1a51-730f-3130-99b0-1c1ccc160fe7",
                                "text": "„Alle diese Umstände machen es zusammengenommen höchst wahrscheinlich, dass der constitutionelle Charakter mancher Krankheitsformen durch eine abnorme Beschaffenheit der Gewebselemente bedingt wird, dass es somit allgemeine Ernährungsstörungen gibt, deren primäre Localisation weit weniger, oder gar nicht das Blut, sondern die Gesammtheit oder doch ein grösserer Theil der übrigen Körpergewebe ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
