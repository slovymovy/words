                "senses": [
                    {
                        "sense_id": "3475b7d8-ba0a-30c3-b078-1a7aab1d8f86",
                        "entry_id": "c1c41ed0-0e5b-3b58-aecd-5fc851933a19",
                        "glosses": [
                            "Erlaubnis, ein Produkt (Arzneimittel am Menschen) zu verwenden, obwohl (noch) nicht alle eigentlich notwendigen Voraussetzungen für eine reguläre Zulassung zum Einsatz erfüllt sind"
                        ],
                        "tags": [
                            "Arzneimittel",
                            "Pflanzenschutzmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "64791234-9192-4a0b-8bc5-8a154556ec1a",
                                "sense_id": "3475b7d8-ba0a-30c3-b078-1a7aab1d8f86",
                                "text": "„Am 1. Mai 2020 erteilte die FDA Remdesivir eine Notfallgenehmigung, nun hat die US-Behörde Veklury® zugelassen. Eingesetzt werden darf das erste COVID-19-Arzneimittel bei Patienten ab zwölf Jahren, die hospitalisiert sind.“"
                            },
                            {
                                "example_id": "f9c5dbe6-91b3-41be-a29a-7fb1a2d06f32",
                                "sense_id": "3475b7d8-ba0a-30c3-b078-1a7aab1d8f86",
                                "text": "„Auch Mexiko hat dem Impfstoff von Biontech und Pfizer eine Notfallgenehmigung erteilt.“"
                            },
                            {
                                "example_id": "e33b1dcc-a750-410e-a17d-cbc1afc9ef50",
                                "sense_id": "3475b7d8-ba0a-30c3-b078-1a7aab1d8f86",
                                "text": "„Über Notfallgenehmigungen wurden bereits in der Vergangenheit immer wieder gefährliche Pestizide zugelassen, und in etlichen Fällen hat die Europäische Lebensmittelbehörde Efsa später attestiert: Das war unnötig, es hätte ausreichend gefahrlose Alternativen gegeben.“"
                            },
                            {
                                "example_id": "c5eb7a69-4c73-436a-9df3-565be3370c61",
                                "sense_id": "3475b7d8-ba0a-30c3-b078-1a7aab1d8f86",
                                "text": "„Das polnische Landwirtschaftsministerium hat die Notfallgenehmigungen für zwei Rapsbeizen auf Basis von Neonicotinoiden veröffentlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
