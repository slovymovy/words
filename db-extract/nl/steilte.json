                        "glosses": [
                            "een helling met een hoog stijgingspercentage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d839e97-97d3-494e-8e97-e0ef813ce45e",
                                "sense_id": "0ed41bd4-f12c-3cf0-84e5-a89dd28c39d2",
                                "text": "Veel belles filles zijn er niet, die zich woensdag naar boven wagen. Zij is er wel, de jonge vrouw roept hogere machten aan als zij op haar fiets de laatste steilte ontwaart. ‘Mon Dieu! Non! NON!’ Ze was toch al aan het zwalken."
                            }
                        ]
                    },
                    {
