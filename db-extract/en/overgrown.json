                    }
                ],
                "senses": [
                    {
                        "sense_id": "a186a357-b221-3713-b2f6-588eab2841e0",
                        "entry_id": "d389521c-6419-33ea-b574-d2a8a241c08b",
                        "glosses": [
                            "Having large numbers of plants which have become too big, and are hence spoiling the picturesqueness of a garden."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "82f9ea72-de0b-3138-a7e6-a1367452f0ab",
                        "entry_id": "d389521c-6419-33ea-b574-d2a8a241c08b",
                        "glosses": [
                            "Having grown bigger without developing maturity or changing character."
                        ],
                        "tags": [
                            "attributive",
                            "derogatory",
                            "mildly"
                        ],
                        "examples": [
                            {
                                "example_id": "6c7d742d-948e-459c-83c4-6f7f1a80e3b5",
                                "sense_id": "82f9ea72-de0b-3138-a7e6-a1367452f0ab",
                                "text": "He spends so much money on new technology: he's like an overgrown schoolboy buying toys."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d43b2205-dba3-415d-967e-f231c7855773",
                        "source_entry_id": "d389521c-6419-33ea-b574-d2a8a241c08b",
                        "source_sense_description": "having large numbers of plants which have become too big",
                        "target_lang_word": "überwachsen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überwachsen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d691346f-9434-3827-a403-1a94cc51ecbc",
                                        "entry_id": "8d91fcb7-5138-3b31-a331-9bb304eddec3",
                                        "glosses": [
                                            "etwas wachsend bedecken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e76d6a4-674c-477f-89e3-b3ab4ed76760",
                                                "sense_id": "d691346f-9434-3827-a403-1a94cc51ecbc",
                                                "text": "Über einen längeren Zeitraum belassene zerstörte Zähne können auch vom Zahnfleisch überwachsen werden."
                                            },
                                            {
                                                "example_id": "85300dcd-1533-420f-b524-c35943444e64",
                                                "sense_id": "d691346f-9434-3827-a403-1a94cc51ecbc",
                                                "text": "Leider überwuchsen die Erlen buschartig während Jahren grosse Teile der Alp."
                                            },
                                            {
                                                "example_id": "e7be9670-c849-4feb-8409-40084d61693b",
                                                "sense_id": "d691346f-9434-3827-a403-1a94cc51ecbc",
                                                "text": "Oft wurden Steingräber zusätzlich mit Erde oder Sand bedeckt, was dazu führte, dass sie sich alle früher oder später der Natur anpassten und mit Gras, Büschen und Bäumen überwuchsen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a303d534-67b0-3495-9b3c-7ee70185eab1",
                                        "entry_id": "8d91fcb7-5138-3b31-a331-9bb304eddec3",
                                        "glosses": [
                                            "jemanden durch Wachsen an Größe übertreffen, überholen; über jemanden oder etwas hinauswachsen"
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd465d6a-f0a9-4828-8b94-13962d1f73f4",
                                                "sense_id": "a303d534-67b0-3495-9b3c-7ee70185eab1",
                                                "text": "Eine direkte Beobachtung ist vor allem bei den Organismen möglich, die krustenartig das Substrat überwachsen."
                                            },
                                            {
                                                "example_id": "6e2dc912-daf2-4496-8982-cefc9f22842c",
                                                "sense_id": "a303d534-67b0-3495-9b3c-7ee70185eab1",
                                                "text": "Der Polyp Dynamena pumilla war durch das Überwachsen nicht beeinträchtigt, da nur seine horizontalen Stolonen überwachsen wurden, die aufrechten Stolonen mit den Polypen konnten sich jedoch über die Krusten der Konkurrenten erheben."
                                            },
                                            {
                                                "example_id": "fc70d873-13b3-41ee-b5b6-ab98610539dd",
                                                "sense_id": "a303d534-67b0-3495-9b3c-7ee70185eab1",
                                                "text": "Die Weiden wucherten bislang zu stark und überwuchsen das Ried."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
