{
    "word_family": [
        "fluctuation",
        "fluctuating"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f76b3d55-022d-3951-8aa4-3a0bfcce5d04",
                    "sense_definition": "To change or vary irregularly in amount, level, or intensity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stock market prices often <w>fluctuate</w> throughout the trading day.",
                            "target_lang_translations": {
                                "tr": "Borsa fiyatları işlem günü boyunca sıklıkla <w>dalgalanır</w>."
                            }
                        },
                        {
                            "text": "Temperatures <w>fluctuate</w> wildly during the spring season.",
                            "target_lang_translations": {
                                "tr": "Bahar mevsiminde sıcaklıklar aşırı derecede <w>dalgalanır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vary",
                        "waver",
                        "oscillate"
                    ],
                    "antonyms": [
                        "stabilize"
                    ],
                    "common_phrases": [
                        "prices fluctuate",
                        "temperatures fluctuate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Miktar, seviye veya yoğunluk bakımından düzensiz bir şekilde değişmek veya farklılık göstermek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dalgalanmak",
                                "target_lang_sense_clarification": "Fiyat, sıcaklık veya miktar gibi değerlerin inişli çıkışlı bir seyir izlemesi."
                            },
                            {
                                "target_lang_word": "değişkenlik göstermek",
                                "target_lang_sense_clarification": "Bir durumun veya değerin sürekli farklılaşması."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33fe13df-8c99-3804-8e8e-f8ea7c6630c2",
                    "sense_definition": "To be uncertain or indecisive about a choice or opinion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>fluctuated</w> between accepting the job offer and staying at my current company.",
                            "target_lang_translations": {
                                "tr": "İş teklifini kabul etmek ile mevcut şirketimde kalmak arasında <w>kararsız kaldım</w>."
                            }
                        },
                        {
                            "text": "She <w>fluctuated</w> in her decision, unable to commit to a final plan.",
                            "target_lang_translations": {
                                "tr": "Nihai bir plana bağlı kalamayarak kararında <w>gidip geldi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "waver",
                        "hesitate",
                        "vacillate"
                    ],
                    "common_phrases": [
                        "fluctuate between"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir seçim veya fikir konusunda kararsız veya tereddütlü olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kararsız kalmak",
                                "target_lang_sense_clarification": "İki seçenek arasında gidip gelmek, net bir karar verememek."
                            },
                            {
                                "target_lang_word": "tereddüt etmek",
                                "target_lang_sense_clarification": "Bir konuda emin olamayıp fikir değiştirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c90d9c9c-aab4-3288-8849-35ac14ab2f39",
                    "sense_definition": "To move in a wavelike or rising and falling motion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seaweed was <w>fluctuating</w> in the gentle current of the tide.",
                            "target_lang_translations": {
                                "tr": "Deniz yosunu, gelgitin hafif akıntısında <w>dalgalanıyordu</w>."
                            }
                        },
                        {
                            "text": "Small particles were seen <w>fluctuating</w> within the liquid sample.",
                            "target_lang_translations": {
                                "tr": "Küçük parçacıkların sıvı numunesi içinde <w>çalkalandığı</w> görüldü."
                            }
                        }
                    ],
                    "synonyms": [
                        "undulate",
                        "wave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literal, physical sense of undulating motion."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Dalgalı veya yükselip alçalan bir hareketle hareket etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dalgalanmak",
                                "target_lang_sense_clarification": "Fiziksel olarak su veya benzeri bir ortamda dalga hareketi yapmak."
                            },
                            {
                                "target_lang_word": "çalkalanmak",
                                "target_lang_sense_clarification": "Sıvı içindeki parçacıkların hareketini tanımlamak için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}