            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc4e5e97-4bb2-360e-91da-ec3863bad0e2",
                    "sense_definition": "Разрешается, позволительно; нет запрета на совершение действия.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама сказала, что мне <w>можно</w> пойти гулять.",
                            "target_lang_translations": {
                                "en": "Mom said that I <w>can</w> go for a walk.",
                                "tr": "Annem yürüyüşe çıkmamın <w>serbest</w> olduğunu söyledi.",
                                "zh": "妈妈说我<w>可以</w>去散步。"
                            }
                        },
                        {
                            "text": "Извините, <w>можно</w> мне взять этот стул?",
                            "target_lang_translations": {
                                "en": "Excuse me, <w>may</w> I take this chair?",
                                "tr": "Affedersiniz, bu sandalyeyi almam <w>mümkün mü</w>?",
                                "zh": "请问，我<w>可以</w>拿走这把椅子吗？"
                            }
                        },
                        {
                            "text": "Здесь <w>можно</w> парковать машину только по выходным.",
                            "target_lang_translations": {
                                "en": "You <w>can</w> park the car here only on weekends.",
                                "tr": "Buraya sadece hafta sonları park etmek <w>serbesttir</w>.",
                                "zh": "这里只在周末<w>可以</w>停车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разрешено"
                    ],
                    "antonyms": [
                        "нельзя",
                        "непозволительно"
                    ],
                    "common_phrases": [
                        "можно войти",
                        "можно спросить",
                        "если можно"
                    ],
                    "target_lang_definitions": {
                        "en": "It is permitted or allowed; there is no prohibition against an action.",
                        "tr": "İzin verilir, serbesttir; bir eylemin yapılmasına engel yoktur.",
                        "zh": "指被允许或准许；做某事没有限制。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "can",
                                "target_lang_sense_clarification": "to have permission"
                            },
                            {
                                "target_lang_word": "may",
                                "target_lang_sense_clarification": "to have permission (formal)"
                            },
                            {
                                "target_lang_word": "allowed",
                                "target_lang_sense_clarification": "permitted"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "serbest",
                                "target_lang_sense_clarification": "izin verilmiş olma durumu"
                            },
                            {
                                "target_lang_word": "izin var",
                                "target_lang_sense_clarification": "müsaade edilmiş"
                            },
                            {
                                "target_lang_word": "-ebilir",
                                "target_lang_sense_clarification": "izin bildiren fiil eki"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可以",
                                "target_lang_sense_clarification": "表示许可"
                            },
                            {
                                "target_lang_word": "准许",
                                "target_lang_sense_clarification": "正式的许可"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01b9f636-3cb9-3b61-b8e0-6ad0bb431d02",
                    "sense_definition": "Имеется возможность, существуют условия для осуществления чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В библиотеке <w>можно</w> найти много интересных книг.",
                            "target_lang_translations": {
                                "en": "In the library, one <w>can</w> find many interesting books.",
                                "tr": "Kütüphanede pek çok ilginç kitap bulmak <w>mümkündür</w>.",
                                "zh": "在图书馆里<w>可以</w>找到很多有趣的书。"
                            }
                        },
                        {
                            "text": "Пожалуйста, позвони мне как <w>можно</w> скорее.",
                            "target_lang_translations": {
                                "en": "Please call me as soon as <w>possible</w>.",
                                "tr": "Lütfen beni <w>mümkün</w> olduğunca çabuk ara.",
                                "zh": "请尽快给我打电话。"
                            }
                        },
                        {
                            "text": "Эту проблему <w>можно</w> решить разными способами.",
                            "target_lang_translations": {
                                "en": "This problem <w>can</w> be solved in different ways.",
                                "tr": "Bu sorunu farklı yollarla çözmek <w>mümkündür</w>.",
                                "zh": "这个问题<w>可以</w>通过不同的方式解决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возможно",
                        "есть возможность",
                        "реально"
                    ],
                    "antonyms": [
                        "нельзя",
                        "невозможно"
                    ],
                    "common_phrases": [
                        "как можно скорее",
                        "можно подумать",
                        "можно сказать"
                    ],
                    "target_lang_definitions": {
                        "en": "It is possible; conditions exist to perform an action.",
                        "tr": "İmkân vardır, bir şeyin gerçekleşmesi için koşullar uygundur.",
                        "zh": "指有可能性；存在实现某事的条件。"
                    },
                    "translations": {
