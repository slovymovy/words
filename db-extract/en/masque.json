                "senses": [
                    {
                        "sense_id": "6078a4ca-0da0-31c1-9b47-6607eeec25fd",
                        "entry_id": "54fb3d71-8ede-37e2-8403-930959970665",
                        "glosses": [
                            "Archaic form of mask."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a5f5c2a3-6d02-4bab-a4b7-7d4ffbc2d717",
                                "sense_id": "6078a4ca-0da0-31c1-9b47-6607eeec25fd",
                                "text": "It is even masqued by that sort of good-humoured air that at heart he resents his impressment."
                            }
                        ]
                    }
