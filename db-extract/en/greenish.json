                                        "entry_id": "d424a045-cfbc-3209-877b-d48918887b22",
                                        "glosses": [
                                            "Un peu verdâtre."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cfb69f2-ffd0-446e-a938-e80e2d1c56e1",
                                                "sense_id": "a2c9dde1-0d66-3dc7-8aaf-5c541945449f",
                                                "text": "Son feutre verdouillard s'enfonçait sur un crâne qu'on devinait tondu de très près."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "108f6d12-07ee-49a6-8bb2-085f73437390",
                        "source_entry_id": "4bd619d6-0fb5-3f21-bd60-5fbfe095f270",
                        "source_sense_id": "8a2adc6d-c6f8-36b4-8622-b12a585feb5d",
