{
    "word_family": [
        "surrealism",
        "surrealist",
        "surreality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                    "sense_definition": "Resembling a dream; having a fantastic, bizarre, or incongruous quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dreamlike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Walking through the empty city at night was a <w>surreal</w> experience.",
                            "target_lang_translations": {
                                "zh": "深夜走在空荡荡的城市里，那是一种<w>超现实</w>的体验。"
                            }
                        },
                        {
                            "text": "The movie had a dreamlike, <w>surreal</w> atmosphere from the very first scene.",
                            "target_lang_translations": {
                                "zh": "这部电影从第一幕开始就营造出一种梦幻般、<w>超现实</w>的氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dreamlike",
                        "bizarre",
                        "fantastic"
                    ],
                    "antonyms": [
                        "realistic",
                        "normal"
                    ],
                    "common_phrases": [
                        "surreal experience",
                        "surreal atmosphere"
                    ],
                    "target_lang_definitions": {
                        "zh": "像梦境一样；具有奇幻、怪诞或不协调的特质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超现实",
                                "target_lang_sense_clarification": "形容事物具有梦幻般或超越现实的特质"
                            },
                            {
                                "target_lang_word": "离奇",
                                "target_lang_sense_clarification": "形容事物怪诞、不合常理"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f15f933-bff5-365b-be58-46a5d9a9d38e",
                    "sense_definition": "A type of mathematical number system that includes real numbers, infinitesimals, and infinite numbers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theory of <w>surreal</w> numbers was developed by John Conway.",
                            "target_lang_translations": {
                                "zh": "<w>超现实数</w>理论是由约翰·康威提出的。"
                            }
                        },
                        {
                            "text": "Mathematicians study the <w>surreal</w> number system to explore infinite values.",
                            "target_lang_translations": {
                                "zh": "数学家们研究<w>超现实数</w>系统以探索无穷大的数值。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "surreal number"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种包含实数、无穷小量和无穷大的数学数系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超现实数",
                                "target_lang_sense_clarification": "数学术语，指代包含实数及各种无穷大和无穷小量的数系"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}