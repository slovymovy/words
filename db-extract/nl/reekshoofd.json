                                        "sense_id": "94953377-fb94-3416-acad-a1e6506cfe5b",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "Offspring, descendants, progeny."
                                        ],
                                        "tags": [
