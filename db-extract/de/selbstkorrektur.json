                        "sense_id": "395f10f8-2ad8-36c7-ae47-0bb51b21e8f2",
                        "entry_id": "d5cb805c-448e-33cd-b672-81db4cbcb4b7",
                        "glosses": [
                            "Vorgang, bei dem sich der Autor/Verursacher von etwas Falschem selbst verbessert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f9306b-1ca1-49aa-8ad2-738ad6c1d62d",
                                "sense_id": "395f10f8-2ad8-36c7-ae47-0bb51b21e8f2",
                                "text": "„Und gelegentlich kommt es dann zu Korrekturen von seiten des Sprechers, sogenannten Selbstkorrekturen.“"
                            },
                            {
                                "example_id": "da248257-c9bd-4c39-afbf-13bf1524b6ab",
                                "sense_id": "395f10f8-2ad8-36c7-ae47-0bb51b21e8f2",
                                "text": "„Die Selbstkorrekturen können bei einigen Kindern sehr früh vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
