                                        "glosses": [
                                            "A board on which messages may be posted, especially one in a public space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5abc9f35-1f8e-41e4-881f-11a896505567",
                                                "sense_id": "403a1666-bf50-3527-bf13-c1c65b869d8f",
                                                "text": "Somewhere near Fillmore she found the symbol tacked to the bulletin board of a laundromat, among other scraps of paper offering cheap ironing and baby sitters."
                                            },
                                            {
                                                "example_id": "edc7082e-d61d-4e10-8d2f-5562f16bb9f7",
                                                "sense_id": "403a1666-bf50-3527-bf13-c1c65b869d8f",
                                                "text": "It should come as no surprise to see promotional material and bulletin boards in the department’s languages, though English is also present in the signage of this microcosm of the institution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2acdc56-47d4-3ede-9e67-9a8e645c2342",
                                        "entry_id": "a2d46b2e-69a2-305f-8c4f-2221a08745d0",
                                        "glosses": [
                                            "Ellipsis of bulletin board system."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b37ade-a765-4376-9f38-62c1f184d100",
                                                "sense_id": "e2acdc56-47d4-3ede-9e67-9a8e645c2342",
                                                "text": "Some bulletin board subscribers can now dial up displays for their IBM PC or PC XT in living color—and see the results in less than a second."
                                            }
                                        ]
