                "senses": [
                    {
                        "sense_id": "a47cec9e-d0d5-3f8b-85c0-a22775508174",
                        "entry_id": "9b276643-6c04-31a2-9c66-524403bd6a16",
                        "glosses": [
                            "Pavage en blocage ou blocaille, cailloutis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8de500-27a5-4e23-9294-c6b7bb5d6306",
                                "sense_id": "a47cec9e-d0d5-3f8b-85c0-a22775508174",
                                "text": "Moellons cassés et résidus de taille servirent en blocage à l’intérieur des murs, en rudération et garniture des mortiers."
                            },
                            {
                                "example_id": "be751e7e-6595-4b98-9aca-133ee2f19947",
                                "sense_id": "a47cec9e-d0d5-3f8b-85c0-a22775508174",
                                "text": "RUDÉRATION, s. f. terme d’Architecture, est employé par Vitruve pour signifier un pavement fait avec du cailloutage ou de petites pierres. Voyez Pavement."
                            },
                            {
                                "example_id": "359991ca-24bd-4f6d-8595-03f97b7635eb",
                                "sense_id": "a47cec9e-d0d5-3f8b-85c0-a22775508174",
                                "text": "Elle [la route] se compose souvent de quatre couches de maçonnerie, appelées la fondation, la rudération, le noyau, et la couverte ou l'endossement supérieur, formant une masse de trois pieds ou trois pieds et demi d'épaisseur."
                            }
                        ]
                    },
                    {
                        "sense_id": "a797bf9a-ec4f-30ad-bc23-7220965f170b",
                        "entry_id": "9b276643-6c04-31a2-9c66-524403bd6a16",
                        "glosses": [
                            "Enduit grossier fait sur un mur. Action d'appliquer cet enduit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8a7ed9-70dc-47ad-8e78-0dc45215a839",
                                "sense_id": "a797bf9a-ec4f-30ad-bc23-7220965f170b",
                                "text": "Je m'occuperai d'abord de la rudération , qui est principalement nécessaire pour faire de bons enduits ; …"
                            }
                        ]
                    }
                ],
