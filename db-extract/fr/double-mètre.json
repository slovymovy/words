                        "examples": [
                            {
                                "example_id": "821c966c-0142-4f23-b155-7c26d085691d",
                                "sense_id": "a41dfeee-b453-350a-b469-72c04782d866",
                                "text": "Si le demi-décamètre coûte 36 fr., que coûte le double-mètre ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b0038934-b675-36c8-9fd6-eab8db0bce14",
                        "entry_id": "7c8143bb-da0d-3358-8688-362cf7389ddc",
                        "glosses": [
                            "Instrument de mesure de longueur, gradué en centimètres et millimètres, long de deux mètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0f2085-98d2-4be8-be3a-52d17d515834",
                                "sense_id": "b0038934-b675-36c8-9fd6-eab8db0bce14",
                                "text": "Soudain apparaissait entre son pouce et son index le boîtier d’un double-mètre en métal élastique. Le ruban de métal filait le long du mur, puis rentrait brusquement, comme l’immense langue d’une bestiole."
                            },
                            {
                                "example_id": "a884efbf-351a-447c-a9eb-c526c609fa3f",
                                "sense_id": "b0038934-b675-36c8-9fd6-eab8db0bce14",
                                "text": "Emblématique de la menuiserie traditionnelle, le double-mètre pliant en bois de hêtre vous accompagnera dans la conception de vos plus belles créations bois."
                            }
                        ]
                    }
