                "senses": [
                    {
                        "sense_id": "b1d5affc-ad1e-39e6-980a-61e05b30dfe8",
                        "entry_id": "f312d71d-e64a-3209-81c4-55c81ef91d89",
                        "glosses": [
                            "Erlernen der Laute einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e86e33-a8d8-49df-a7f1-309196c1c1e3",
                                "sense_id": "b1d5affc-ad1e-39e6-980a-61e05b30dfe8",
                                "text": "„Als entscheidend für das Vorgehen von JAKOBSON läßt sich zusammenfassend sagen, daß er die Abfolge des Lauterwerbs als den schrittweisen Erwerb lautlicher Oppositionen betrachtet.“"
                            },
                            {
                                "example_id": "0929b431-e01f-46e2-93cb-d44ff8226780",
                                "sense_id": "b1d5affc-ad1e-39e6-980a-61e05b30dfe8",
                                "text": "„Hier finden Sie eine Lauttabelle, die Ihnen Normwerte für den Lauterwerb Ihres Kindes bietet.“"
                            },
                            {
                                "example_id": "daa60bab-5254-4daa-a2ac-45bf49f68a4d",
                                "sense_id": "b1d5affc-ad1e-39e6-980a-61e05b30dfe8",
                                "text": "„Abweichungen im Lauterwerb werden als kindliche Aussprachestörungen bezeichnet.“"
                            },
                            {
                                "example_id": "72c5cd1b-b3ef-4b3b-85dc-8ce52099e0ec",
                                "sense_id": "b1d5affc-ad1e-39e6-980a-61e05b30dfe8",
                                "text": "„Jakobson geht aber noch weiter – er bringt die von ihm dargelegten Gesetze des Lauterwerbs in einen größeren Zusammenhang: in den synchronischen Vergleich der Sprachen der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
