                "senses": [
                    {
                        "sense_id": "f3f42da3-1a81-393a-8f6d-6f48d6d57c8e",
                        "entry_id": "76a683b7-0e1c-3c8d-9686-12c3521b5f5c",
                        "glosses": [
                            "Menge der Wörter, dessen sich jemand bedient, Sprachraum für Gerüche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bda6f5-6d94-4250-a64c-0cfa1a6b0f1e",
                                "sense_id": "f3f42da3-1a81-393a-8f6d-6f48d6d57c8e",
                                "text": "„Doch ist das eigentliche Geruchsvokabular oft weniger entwickelt, als das Vokabular des Geschmacks.“"
                            },
                            {
                                "example_id": "cef9f0ad-86fc-4d2b-b52c-38c8d76a3419",
                                "sense_id": "f3f42da3-1a81-393a-8f6d-6f48d6d57c8e",
                                "text": "„Nijmegen - Sprecher der malayischen Volksgruppe der Jahai verfügen über ein viel präziseres Geruchsvokabular als Englischsprecher.“"
                            },
                            {
                                "example_id": "a14dee05-2d71-4a8c-8ace-ff0d49e509b9",
                                "sense_id": "f3f42da3-1a81-393a-8f6d-6f48d6d57c8e",
                                "text": "„Wissenschaftler bemühen sich fortan um ein ausgefeiltes Geruchsvokabular und man führt zahlreiche Experimente durch, anhand derer Auflistungen über zur Atmung tauglicher und untauglicher Luftarten erstellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aceefa1b-073f-3fc1-89d6-975c587511e5",
                        "entry_id": "76a683b7-0e1c-3c8d-9686-12c3521b5f5c",
                        "glosses": [
                            "Zuordnung oder auch Verzeichnis von Wörtern, Wortverzeichnis für Gerüche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3655ced-38aa-4a6d-9999-832f4954a3fb",
                                "sense_id": "aceefa1b-073f-3fc1-89d6-975c587511e5",
                                "text": "„Das Unvermögen des Geruchssinns zu abstrahieren manifestiert sich auch in der Unmöglichkeit ein Geruchsvokabular zu erstellen.“"
                            },
                            {
                                "example_id": "756875b9-24a0-45bf-8cfa-b85645b966ca",
                                "sense_id": "aceefa1b-073f-3fc1-89d6-975c587511e5",
                                "text": "„Wissenschaftler bemühen sich fortan um ein ausgefeiltes Geruchsvokabular und man führt zahlreiche Experimente durch, anhand derer Auflistungen über zur Atmung tauglicher und untauglicher Luftarten erstellt werden.“"
                            },
                            {
                                "example_id": "b12f101d-58f6-4f0b-a7e5-78d1c16befc0",
                                "sense_id": "aceefa1b-073f-3fc1-89d6-975c587511e5",
                                "text": "„Der Versuch, ein Geruchsvokabular zu entwickeln hat eine jahrhundertealte Tradition, konnte aber wie der Psychologe Jürgen Gschwind aufzeigt, nie befriedigend umgesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
